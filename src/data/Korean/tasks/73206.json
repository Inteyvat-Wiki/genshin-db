			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"아판"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060101,
					"content": "자네들 왔는가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060102
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732060102,
					"content": "씨앗은 어떻게 됐나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060103
					]
				},
				{
					"id": 732060103,
					"content": "그게, 씨앗이 하나도 안 자라고 있다 아이가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060104
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732060104,
					"content": "씨앗 표면을 살펴봤는데, 싹이 틀 기미도 없데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060105
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732060105,
					"content": "도대체 와 이라는 기가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060106
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732060106,
					"content": "씨앗은 분명 문제 없을 긴데. 망태 할아범의 노트에 적힌 대로 보관실에서 꺼내 왔거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060107
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732060107,
					"content": "아재의 기록에 따르면 씨앗의 보존 기간은 억수로 길어서 건조하게 유지만 하면 잘못될 리가 없다고 했데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060108
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732060108,
					"content": "심을 때도 문제가 없었을 기고, 물도 비료도 빠지지 않고 다 줬는데 도대체 문제가 뭐꼬?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060109
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732060109,
					"content": "아판 할아버지, 너무 조급해하지 말고 조금 더 기다려 보는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732060110,
					"content": "#나랑 {NICKNAME}도 밖에서 과일이나 꽃을 따고 나면 며칠을 기다려야 새로 다시 자라더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060111,
						732060112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732060111,
					"content": "인내심을 가지세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				},
				{
					"id": 732060113,
					"content": "휴, 기다리는 수밖에 없나. 자네들, 오늘도 물 주는 걸 좀 도와줄 수 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060114
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732060114,
					"content": "방금 모밭의 흙을 고르느라 반나절을 새빠지게 일했더니 물을 길어 올 힘도 없데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060115
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732060115,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060116
					]
				},
				{
					"id": 732060116,
					"content": "고맙데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아판"
				},
				{
