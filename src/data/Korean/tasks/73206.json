					"아판"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050501,
					"content": "♪장미야, 장미야. 내 소원을 들어주렴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050502
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050502,
					"content": "응? 자네들 아직 있었나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050503,
						732050513
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050503,
					"content": "왜 여기서 지내세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050504
					]
				},
				{
					"id": 732050504,
					"content": "허허, 내는 그냥 괴짜 영감일 뿐이다. 다들 「괴짜 영감이 하는 일에 무슨 이유가 있겠나」라고만 하지, 자네들처럼 그렇게 물어보는 사람은 없었데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050505
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050505,
					"content": "내는 기회가 생기면 밖에 나가서 뭐라도 하겠다고 한평생 생각했데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050506
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050506,
					"content": "결혼한 지 얼마 안 됐을 때 도금 여단을 따라 떠나려고 했다. 하지만 생각해 보니 아내를 버리고 떠나는 건 안 되겠더래이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050507
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050507,
					"content": "나중에 어떤 행상을 만난 뒤에는 나도 나가서 장사해보고 싶다고 생각했는데, 결국 밑천이 부족해서 못 했데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050508
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050508,
					"content": "나중에 아내가 떠나고 나서는 걱정할 건 없었지만, 내 나이가 너무 많아서 떠날 수 없었데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050509
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050509,
					"content": "오늘날까지 질질 끌다 보니 놓친 것들이 억수로 많다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050510
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050510,
					"content": "돌이켜 보니 나는 이 마을에도, 다른 그 어떤 곳에도 속하지 못했는 기다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050511
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050511,
					"content": "결국에는 마을 근처로 나와 혼자 사는 게 오히려 편한 상황이 됐데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050512
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050512,
					"content": "수십 년 뭐 별거 있나, 이게 다래이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050525,
					"content": "이 꽃들이 피면 자네들을 부를 기다. 내일이나 모레쯤이면 꼭 필 거래이, 올 수 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050526
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050526,
					"content": "물론이죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050527
					]
				},
				{
					"id": 732050527,
					"content": "하하하, 알겠데이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050528
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050528,
					"content": "♪장미야, 장미야. 내 소원을 들어주렴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아판"
				},
				{
					"id": 732050513,
					"content": "망태 할아범에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050514
					]
				},
				{
					"id": 732050514,
					"content": "다른 곳에서 온 사람들만 망태 할아범에 대해 물어본데이. 우리 마을 얼라들은 다 아는 이름이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050515
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050515,
					"content": "얼라들이 말을 안 들으면 부모들이 망태 할아범이 잡아간다고 겁을 주거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050516
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050516,
					"content": "젊은것들이란, 망태 할아범에 대해 잘 알지도 못하면서 오히려 그 이름은 잘 이용한다 아이가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050517
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050517,
					"content": "어렸을 때 내 눈으로 그 망태 할아범을 본 적 있는데, 얼라를 싫어한다는 소문은 사실이었지만 생긴 건 무섭지 않았데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050518
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050518,
					"content": "왜 망태 할아범이라 불리는지 모르겠지만 아마 본 적도 없는 사람들이 만들어 낸 헛소리인 듯싶데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050519
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050519,
					"content": "서로 친구 아닌가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050520
					]
				},
				{
					"id": 732050520,
					"content": "어릴 때는 아재의 작은 정원 근처에 가서 자주 놀았는데 아재는 내가 보이면 호미를 휘두르며 쫓아냈데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050521
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050521,
					"content": "아마 나를 사고나 치는 말썽꾸러기라고 생각했을 기다. 날 기억할 리 없다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050522
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050522,
					"content": "아재는 날 모르겠지만 난 아재와 아재의 작은 정원을 기억한데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050523
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050523,
					"content": "그러니 내 친구인 셈이다, 안 그러나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050524
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050524,
					"content": "내 기억 속의 작은 정원을 다시 보기 위해 이 꽃들을 피우고 싶은 기다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "아판"
				}
			]
		},
		{
