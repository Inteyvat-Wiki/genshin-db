			},
			"dialogs": [
				{
					"id": 726770301,
					"content": "엄청 커! 엄청 뜨거워! 이렇게 큰 불붙은 꽃이 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770302
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726770302,
					"content": "그치! 아, 참…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726770303,
					"content": "길법사, 잠깐만 기다려. 우리가 사진 찍어줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726770304,
					"content": "이렇게 더운 곳에서?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770305
					]
				},
				{
					"id": 726770305,
					"content": "더우니까 좋은 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726770306,
					"content": "우낭낭… 좋아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「길법사」"
				}
			]
