				"points": []
			},
			"dialogs": [
				{
					"id": 726771001,
					"content": "경치가 엄청 특별하지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771002
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771002,
					"content": "물이 한 겹, 한 겹. 색이 엄청 특별하다낭",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771003,
						726771008,
						726771011
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726771003,
					"content": "페이몬과 길법사는 둘 다 어휘량이 부족하네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771004
					]
				},
				{
					"id": 726771004,
					"content": "#하지만 진짜 특별해! {NICKNAME}, 넌 이 색을 어떻게 묘사할 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771005,
						726771006
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771005,
					"content": "얼음 원소 같아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771007
					]
				},
				{
					"id": 726771007,
					"content": "뭐야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771013
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771013,
					"content": "근데 여기 풍경이 정말 특별해. 보고 있으니까 그림 그리고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771014
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771014,
					"content": "페이몬, 그림 그릴 줄 알아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771015
					]
				},
				{
					"id": 726771015,
					"content": "배우면 되지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771016
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771016,
					"content": "그림… 근데 그림 어려워. 예전에 우타마로가 그리는 걸 봤는데 엄청 오래 걸렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771017
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726771017,
					"content": "인간은 왜 사진을 찍을 수 있는데 그림을 그리는 거야, 낭?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771018
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726771018,
					"content": "#음… 맞아, {NICKNAME}, 왜 그런 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771019,
						726771021
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771019,
					"content": "자신만의 물건을 창조해 내고 싶어서겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771020
					]
				},
				{
					"id": 726771020,
					"content": "엄청 일리 있는 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771024
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771024,
					"content": "게다가 자신이 그린 그림에는 정성이 담겨 있거든",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771025
					]
				},
				{
					"id": 726771025,
					"content": "응, 한 획, 한 획 마음속에서 생각한 걸 그려내는 건 정말 힘든 일이거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771026
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771026,
					"content": "음… 그럼 길법사한테 사진을 찍어주는 건 엄청 쉽고, 힘들지 않고, 그래서 마음이 담겨 있지 않는 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771027
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726771027,
					"content": "엣! 그런 거 아냐, 그건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771028
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771028,
					"content": "그림을 그리는 건 시간이 오래 걸려서 길법사가 힘들 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771029
					]
				},
				{
					"id": 726771029,
					"content": "맞아, 맞아! 그림 그리는 건 시간이 엄청 오래 걸리거든, 길법사도 같은 포즈를 유지하고 있으면 되게 힘들 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771030
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771030,
					"content": "봉인을 당해서 돌로 변했을 때 길법사는 계속 서 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771031
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726771031,
					"content": "그래서 봉인이 풀리고 나서 되게 오랫동안 발이 아팠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771032
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726771032,
					"content": "으앗, 듣기만 해도 힘들어 보여…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771033
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771033,
					"content": "그런데 페이몬은 슝슝할 수 있으니까 발이 아프지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771034
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726771034,
					"content": "야! 날려면 상상 속에서 온몸을 움직여야 해서 엄청 힘들다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771035
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771035,
					"content": "와! 불붙은 꽃이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771036
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726771036,
					"content": "사람이 말을 하면 좀 들어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771037
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771037,
					"content": "화염꽃?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771038
					]
				},
				{
					"id": 726771038,
					"content": "맞아, 그러고 보니 진수의 숲에서는 화염꽃을 본 적이 없네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771039
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771039,
					"content": "길법사, 갖고 싶어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771040
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771040,
					"content": "갖고 싶어! 따뜻해 보여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771041
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726771041,
					"content": "#그럼 {NICKNAME}한테 열심히 부탁해야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771042
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771042,
					"content": "#{NICKNAME}, 갖고 싶어, 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771043
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726771043,
					"content": "…엄청 진심인 것 같지도 않은데. 아니면 너구리 요괴는 다들 이런 말투인 걸까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771021,
					"content": "사진기는 엄청 비싸거든",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771022
					]
				},
				{
					"id": 726771022,
					"content": "응?! 사진기가 엄청 비싸? 우리 평소에 싸우고, 헤엄치고, 등반하고, 가끔은 높은 곳에서 떨어지기도 하는데, 사진기가 망가지는 건 아닐까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771023
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771023,
					"content": "으앗, 진짜 큰일이네. 이제부터 조심해야겠다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771024
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771006,
					"content": "바람 원소 같지 않아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771007
					]
				},
				{
					"id": 726771008,
					"content": "길법사의 어휘량은 페이몬처럼 풍부하네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771009
					]
				},
				{
					"id": 726771009,
					"content": "페이몬처럼 대단해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771010
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726771010,
					"content": "#음… {NICKNAME}은(는) 그 뜻이 아닌 거 같지만 어쨌든… 길법사는 엄청 똑똑해! 흥!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771013
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726771011,
					"content": "정말 특별하네!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726771012
					]
				},
				{
					"id": 726771012,
					"content": "#응? {NICKNAME}, 어휘량이 너무 부족한 거 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771013
					],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
}