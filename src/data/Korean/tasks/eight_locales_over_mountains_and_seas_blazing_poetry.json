			"dialogs": [
				{
					"id": 726770401,
					"content": "우낭낭… 너무 더워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770402
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726770402,
					"content": "흐흥, 길법사! 이제 알겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726770403,
					"content": "낭?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770404
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726770404,
					"content": "뭘?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770405
					]
				},
				{
					"id": 726770405,
					"content": "그림 그리는 건 시간이 더 걸린다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726770406,
					"content": "그래서 그림을 그리지 않고 사진을 찍는 거야. 정성을 담지 않은 게 아니라 배려라구! 배려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770407,
						726770408,
						726770409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726770407,
					"content": "그런 의미였구나!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770410
					]
				},
				{
					"id": 726770410,
					"content": "알겠어, 사진 좋아. 더워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770411
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726770411,
					"content": "열원을 처리하고 올게, 잠깐만 기다려",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770412
					]
				},
				{
					"id": 726770412,
					"content": "우낭낭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726770408,
					"content": "뜬금없어!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770410
					]
				},
				{
					"id": 726770409,
					"content": "일리 있긴 한데 정말 더워…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770410
					]
				}
			]
