			"dialogs": [
				{
					"id": 762130101,
					"content": "어라? 이쪽 방은 책으로 막혀 있는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762130102,
					"content": "책을 찾는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130103
					],
					"speakerTitle": "총심"
				},
				{
					"id": 762130103,
					"content": "으음… 책을 찾는 건 아니고, 그냥 이 안에 뭐가 있는지 좀 궁금해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762130104,
					"content": "옆으로 돌아 들어갈 수 있을 것 같은데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130105
					]
				},
				{
					"id": 762130105,
					"content": "그럼 못 들어가겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130106
					],
					"speakerTitle": "총심"
				},
				{
					"id": 762130106,
					"content": "책을 옮기게. 그러하지 않으면, 애초에 이르지도 못하느니라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130107,
						762130109
					],
					"speakerTitle": "총심"
				},
				{
					"id": 762130107,
					"content": "무슨 말이죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130108
					]
				},
				{
					"id": 762130108,
					"content": "책을 옮기게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "총심"
				},
				{
					"id": 762130109,
					"content": "그게 무슨 말씀이시지요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130110
					]
				},
				{
					"id": 762130110,
					"content": "책이 그 자리에 없으면, 곧 옮긴 것이지. 노승은 그저 지켜볼 뿐이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130111
					],
					"speakerTitle": "총심"
				},
				{
					"id": 762130111,
					"content": "그럼 오른쪽이로 한 번 해볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130112
					]
				},
				{
					"id": 762130112,
					"content": "곧장 가거라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "총심"
				}
			]
