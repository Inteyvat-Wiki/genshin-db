			"dialogs": [
				{
					"id": 762130201,
					"content": "꿈속의 환상과 헛된 꽃을 어찌 애써 잡으려 하는가? 천년을 탐구하여도, 한마음이 일지 않으면 깨닫지 못할 것이니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130202,
						762130212
					],
					"speakerTitle": "총심"
				},
				{
					"id": 762130202,
					"content": "그래서… 책을 찾고 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130203
					]
				},
				{
					"id": 762130203,
					"content": "여기 와 본 적이 있느냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130204,
						762130205,
						762130206
					],
					"speakerTitle": "총심"
				},
				{
					"id": 762130204,
					"content": "네?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130207,
					"content": "그럼 알게 될 거다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130208,
						762130209
					],
					"speakerTitle": "총심"
				},
				{
					"id": 762130208,
					"content": "뭘… 알게 된다는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130210,
					"content": "잠이 오면 잠들고, 깨달음이 이르면 깨닫는 것이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130211
					],
					"speakerTitle": "총심"
				},
				{
					"id": 762130211,
					"content": "지금은 돌아가거라. 세상이 무너질 때가 오면, 돌아감이 곧 길이니라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "총심"
				},
				{
					"id": 762130209,
					"content": "안다는 게 뭐죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130205,
					"content": "온 적 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130206,
					"content": "온 적 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130212,
					"content": "도무지 알아들을 수 가 없네요. 그럼 저는 이만",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130213
					]
				},
				{
					"id": 762130213,
					"content": "곧장 나아가거라",
					"roleType": "TALK_ROLE_NPC",
