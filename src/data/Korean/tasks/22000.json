			"dialogs": [
				{
					"id": 220000501,
					"content": "다 치웠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000502
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000502,
					"content": "아직이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000503
					]
				},
				{
					"id": 220000503,
					"content": "#어서 가서 치워요. 이건 {M#형이}{F#누나가} 개과천선할 수 있는 좋은 기회라구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000504
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000504,
					"content": "야, 청소만 한다고 어떻게 착한 사람이 되냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000505
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220000505,
					"content": "착한 일을 하면 착한 사람이 되는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000506
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000506,
					"content": "그건 너무 쉽잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000507
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220000507,
					"content": "착한 일을 하면 착한 사람이고, 나쁜 일을 하면 나쁜 사람인 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000508
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000508,
					"content": "흥, 말은 쉽지. 그렇게 쉽게 착한 사람이 된다면, 세상에 나쁜 사람이 어딨겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000509
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220000509,
					"content": "왜냐하면 세상 모든 일은 말보다 행동이 더 어려운 법이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000510
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000510,
					"content": "그리고 나쁜 일 하는 게 착한 일 하는 것보다 훨씬 쉬워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000511
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000511,
					"content": "이것도 북두 누나가 가르쳐준 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000512
					],
					"speakerTitle": "아비"
				},
