			},
			"dialogs": [
				{
					"id": 220000101,
					"content": "오늘은 뭐 하면서 놀까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000102
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000102,
					"content": "흥, 어차피 해적 역할을 할 사람이 없으면 오늘도 못 놀잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000103
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220000103,
					"content": "하지만 아무도 해적을 하고 싶어 하지 않잖아, 어쩌지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000104
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000104,
					"content": "여기서 뭐 해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000105
					]
				},
				{
					"id": 220000105,
					"content": "역할 놀이를 하려고 하는데, 해적 역할을 할 사람이 한 명 부족해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000106
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000106,
					"content": "아무도 해적을 안 하려고 해서, 시작도 못 하고 있어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000107
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000107,
					"content": "#맞다! {M#형이}{F#누나가} 해적 해주면 안 돼요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000108,
						220000110
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000108,
					"content": "내게 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000109
					]
				},
				{
					"id": 220000109,
					"content": "좋았어! 그럼 우리도 빨리 준비하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000115,
					"content": "#{M#형}{F#누나}! 준비됐으면 이리 와요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000110,
					"content": "이런 건 잘 모르는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000111
					]
				},
				{
					"id": 220000111,
					"content": "괜찮아요. 해적은… 음 막무가내로 다른 사람 물건을 빼앗아 가는 나쁜 놈이라고 생각하면 돼요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000112
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000112,
					"content": "저도 본 적은 없고 북두 누나한테 들어만 봤어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000113
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000113,
					"content": "하지만… 이런 사람을 연기하기 어렵진 않을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000114
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000114,
					"content": "#헤헤, 어쨌든 잘 부탁해요, {M#형}{F#누나}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "소몽"
				}
			]
		},
