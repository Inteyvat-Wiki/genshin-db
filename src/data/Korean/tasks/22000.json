			"dialogs": [
				{
					"id": 220000301,
					"content": "다 치웠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000302
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000302,
					"content": "응, 다 했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000303
					]
				},
				{
					"id": 220000303,
					"content": "수고했어요! 이거 줄게요. 우리랑 놀아줘서 고마워요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000304
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000304,
					"content": "#{M#형은}{F#누나는} 커서도 착한 사람이 돼야 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000305
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000305,
					"content": "야, 난 언제 선장 시켜 줄 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000306
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220000306,
					"content": "다음엔 네가 선장해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000307
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000307,
					"content": "흥, 저번에도 그렇게 말했으면서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아비"
				}
			]
		},
