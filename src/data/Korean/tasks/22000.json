			"dialogs": [
				{
					"id": 220000201,
					"content": "준비됐어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000202
					]
				},
				{
					"id": 220000202,
					"content": "그럼 바로 시작해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000203
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000203,
					"content": "어디서부터 시작하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000204
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000204,
					"content": "그… 강도질…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000205
					]
				},
				{
					"id": 220000205,
					"content": "으악! 해적이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000206
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220000206,
					"content": "룰루, 어서 여기로 와, 내가 널 지켜줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000207
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220000207,
					"content": "당신은 해적이죠? 왜 강도질을 하는 거예요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000208,
						220000209
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000208,
					"content": "난 해적이다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				},
				{
					"id": 220000210,
					"content": "좋은 해적도 있어요! 모든 해적이 다 강도질을 하는 건 아니라구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000211
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000211,
					"content": "북두 누나도 자기가 해적이라고 했어요. 근데 누나는 엄청 좋은 사람이에요. 저한테 맛있는 것도 주고, 모두 누나를 좋아해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000212
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000212,
					"content": "#왜 {M#형은}{F#누나는} 나쁜 해적을 하려는 거예요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000213
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000213,
					"content": "네가 아까 해적은 「막무가내」인 사람이라고 했잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000214,
						220000215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220000214,
					"content": "아니야, 내가 잘못했어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000216,
					"content": "흠, 개과천선하고 싶다는 건 바람직한 태도죠. 이것도 북두 누나가 알려줬어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000217
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000217,
					"content": "그럼 이 주변을 정리해주세요. 착한 일을 하면 착한 사람 또는 착한 해적이 될 수 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소몽"
				},
				{
					"id": 220000215,
					"content": "난 착한 해적이 되고 싶어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000209,
					"content": "해적이니까 당연히 강도질을 하는 거지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				}
			]
		},
