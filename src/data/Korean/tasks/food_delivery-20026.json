			"dialogs": [
				{
					"id": 200260101,
					"content": "식사 배달 주문",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260102
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200260102,
					"content": "여행자, 마침 잘 왔어요——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260103
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200260103,
					"content": "엥? 먹으러 왔다고요…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260104
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200260104,
					"content": "알, 알겠는데 그래도 좀 도와주세요. 내가 최고의 요리를 대접할게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260105
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200260105,
					"content": "다운 와이너리의 에르네스트 아저씨는 우리한테 종종 안주를 주문해요. 게다가 항상 이상한 재료를 추가해달라고 요구하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260106
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200260106,
					"content": "음… 이번에는 <color=#00E1FFFF>무완자 튀김</color>을 주문했지만 새알을 많이 넣어달라고 신신당부하셨어요. 그런데 새알이 다 떨어져서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260107
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200260107,
					"content": "그러니까 새알 2개를 구해주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260108,
						200260111
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200260108,
					"content": "알겠어요. 근데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260109
					]
				},
				{
					"id": 200260109,
					"content": "바람이 시작되는 곳에 새알이 많이 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260110
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200260110,
					"content": "그럼 부탁할게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사라"
				},
				{
					"id": 200260111,
					"content": "너무 배고파요. 난 그냥 밥 먹으러 온 건데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260112
					]
				},
				{
					"id": 200260112,
					"content": "바람이 시작되는 곳에 새알이 많이 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260113
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200260113,
					"content": "부탁을 들어주면, 내, 내가 디어 헌터의 스페셜 요리를 대접할게요. 제발 도와주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사라"
				}
			]
		},
