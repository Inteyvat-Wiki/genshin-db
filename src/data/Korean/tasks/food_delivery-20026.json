				{
					"id": 200260301,
					"content": "주문하신 요리 왔습니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260302
					]
				},
				{
					"id": 200260302,
					"content": "와! 내 요구에 맞춘 특제 <color=#00E1FFFF>무완자 튀김</color>이군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260303
					],
					"speakerTitle": "에르네스트"
				},
				{
					"id": 200260303,
					"content": "역시, 알이 들어가니까 맛과 향이 한층 더 풍부해졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260304
					],
					"speakerTitle": "에르네스트"
				},
				{
					"id": 200260304,
					"content": "하하하, 역시 난 센스쟁이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260305
					],
					"speakerTitle": "에르네스트"
				},
				{
					"id": 200260305,
					"content": "맞다, 식사비, 수고했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "에르네스트"
				}
