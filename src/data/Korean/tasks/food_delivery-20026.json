			"dialogs": [
				{
					"id": 200260201,
					"content": "다 찾았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260202
					]
				},
				{
					"id": 200260202,
					"content": "이제 재료는 충분해요. 잠시만 기다려주세요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260203
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200260203,
					"content": "됐다. 이 특제 <color=#00E1FFFF>무완자 튀김</color>을 에르네스트 아저씨에게 배달해 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260204
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200260204,
					"content": "그렇게 보지 마요. 배고픈 거 아니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260205
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200260205,
					"content": "돌아오면 디어헌터 레스토랑 특제 요리를 대접할게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사라"
				}
			]
		},
