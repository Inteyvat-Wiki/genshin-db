	"talks": [
		{
			"id": 7467101,
			"completionStepIds": [
				7467101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7467101",
							"2"
						],
						"stepId": 7467101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"마카델"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746710101,
					"content": "망할! 코어의 출력 주파수가 너무 불안정해. 이대로라면 내 프로젝트가 결딴나고 말 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710102
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710102,
					"content": "뭐 하세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710103
					]
				},
				{
					"id": 746710103,
					"content": "우왁! 노… 놀라게 하지 마! 지금 들고 있는 이 버튼을 누르기라고 했으면 큰일 났을지도 모른다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710104
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710104,
					"content": "보니까… 모험가 길드에서 보낸 사람은 아닌 것 같네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710105,
						746710107
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710105,
					"content": "길드 쪽에 뭔가를 의뢰한 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710106
					]
				},
				{
					"id": 746710106,
					"content": "아니, 애초에 그럴 돈도 없어…. 게다가 난 모험가들을 상대하는 게 어렵기도 하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710109
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710109,
					"content": "난 그냥 모험가 길드와 「협력」 중인 사람일 뿐이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710110
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710110,
					"content": "아차, 자기소개를 깜빡했군. 난 마카델이라고 해. 폰타인 과학원 소속 연구원이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710111
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710111,
					"content": "지금 진행 중인 프로젝트의 방향은 「소형 휴대용 프뉴무시아 에너지 저장 장치」를 연구하는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710112
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710112,
					"content": "모든 팀원들의 노력으로 연구는 순조롭게 진행됐고, 첫 번째 프로토타입 기계도 완성됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710113
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710113,
					"content": "그런데… 모두가 알다시피 폰타인 과학원에서 엄청난 대폭발이 일어났잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710114
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710114,
					"content": "그 폭발로 인해 우리 연구팀 팀장을 비롯한 팀원들 대부분이 변을 당했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710115
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710115,
					"content": "나를 제외하면 지금 연구를 계속 추진할 사람이 없는 상황이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710116
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710116,
					"content": "하지만… 현재 과학원 내부 상황으로 봤을 때, 이 프로젝트를 존속시키려면 한시라도 빨리 그 가치를 증명해야만 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710117
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710117,
					"content": "난 여기저기에 자문을 했고, 그 결과 모험가 길드와 협력하기로 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710118
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710118,
					"content": "나는 「소형 휴대용 프뉴무시아 에너지 저장 장치」 프로토타입을 코어로 삼아서 「초고압 충격기」를 만들 생각이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710119
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710119,
					"content": "「초고압 충격기」의 운행 상태를 통해 「소형 휴대용 프뉴무시아 에너지 저장 장치」의 신뢰성을 입증하는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710120
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710120,
					"content": "일단 장치를 만들고 가동하는 데까지는 문제가 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710121,
						746710123
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710121,
					"content": "잘 되어가고 있군요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710122
					]
				},
				{
					"id": 746710122,
					"content": "하하하… 그래. 이 「초고압 충격기」를 가동하기 전까지는 잘 되어가고 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710125
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710125,
					"content": "하아… 이 이야기를 할 때마다 머리가 아파",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710126
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710126,
					"content": "프로토타입 기계의 설계에 문제가 있는 건지, 아니면 내가 만든 「초고압 충격기」의 에너지 전송 방식에 결함이 있는 건지는 모르겠지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710127
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710127,
					"content": "「소형 휴대용 프뉴무시아 에너지 저장 장치」가 「초고압 충격기」에 공급하는 에너지의 양이 계속 오락가락하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710128
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710128,
					"content": "그것 때문에 「초고압 충격기」의 출력도… 오락가락하고 있고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710129
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710129,
					"content": "출력이 높을 때는 바위도 쉽게 부숴버리지만, 출력이 낮을 때는 진흙에 구멍을 뚫는 것조차 버거운 상황이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710130
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710130,
					"content": "현재 과학원의 상태로 봤을 때 돌아가서 「소형 휴대용 프뉴무시아 에너지 저장 장치」를 다시 개조하는 건 불가능에 가까워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710131
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710131,
					"content": "지금 할 수 있는 건 프로토타입 기계에 모니터링 장치를 추가로 부착해서 실시간으로 에너지 출력 강도를 확인하는 것뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710132
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710132,
					"content": "출력 강도가 높을 때 「초고압 충격기」를 가동하기만 하면 분명 최대 출력을 낼 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710133,
						746710135
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710133,
					"content": "너무 복잡해요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710134
					]
				},
				{
					"id": 746710134,
					"content": "그치만 이게 내가 생각해 낼 수 있는 가장 좋고 저렴한 방법이란 말이야. 이제 어떻게 해야 할지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710137
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710137,
					"content": "하아… 설마 모험가 길드도 그렇게 생각해서 아직까지 사람을 안 보내는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710138
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710138,
					"content": "어쩌지? 테스트 데이터가 없는데 보고서는 어떻게 올린담…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710139
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710139,
					"content": "여행자… 혹시 괜찮다면 나 좀 도와줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710140
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710140,
					"content": "이 장치의 신뢰성은 내가 보장할게! 각종 기능을 향상시켜 주는 추가 부품도 잔뜩 설치했다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710141,
						746710144
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710141,
					"content": "타이밍을 맞추지 못하면 어떻게 되나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710142
					]
				},
				{
					"id": 746710142,
					"content": "걱정 마. 기껏해야… 출력이 낮아지는 정도니까, 장치가 폭발하거나 하지는 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710143
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710143,
					"content": "그럴 때는 에너지 파동이 다시 최대치에 도달할 때까지 기다렸다가 작동시켜서 최대 출력을 내도록 하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710148
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710148,
					"content": "걱정 마, 여행자. 장치는 절대로 안전하니까. 그리고… 테스트가 끝나면 보수도 지불하도록 할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710149
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710149,
					"content": "그럼 부탁해! 내 미래와 이 장치의 미래가… 그리고 내 모든 프로젝트의 미래가 네 손에 달렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710144,
					"content": "갑자기 제 옆에서 폭발하는 건 아니겠죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710145
					]
				},
				{
					"id": 746710145,
					"content": "그럴 일은 절대 없어. 안전과 모니터링을 위한 장치를 잔뜩 붙여뒀거든. 기껏해야 출력이 낮아지는 것뿐이지, 폭발하거나 하지는 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710146
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710146,
					"content": "에너지 파동이 최대치에 도달하는 타이밍을 포착하지 못해도 상관없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710147
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710147,
					"content": "그럴 때는 에너지 파동이 다시 최대치에 도달할 때까지 기다렸다가 작동시켜서 최대 출력을 내도록 하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710148
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710135,
					"content": "전혀 써먹을 수가 없겠네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710136
					]
				},
				{
					"id": 746710136,
					"content": "안 돼! 이게 내가 떠올릴 수 있는 최선의 방법이라고! 분명 도움이 될 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710137
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710123,
					"content": "별문제 없는 것 같은데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710124
					]
				},
				{
					"id": 746710124,
					"content": "맞아. 이 장치 자체를 제외하면 그렇지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710125
					],
					"speakerTitle": "마카델"
				},
				{
					"id": 746710107,
					"content": "모험가를 고용해서 지켜달라고 한 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746710108
					]
				},
				{
					"id": 746710108,
					"content": "아니, 모험가들은 고용비가 너무 비싸거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746710109
					],
					"speakerTitle": "마카델"
				}
			]
		}
	]
}