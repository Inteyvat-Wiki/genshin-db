				]
			},
			"dialogs": [
				{
					"id": 760810201,
					"content": "당신과 겨루게 되어 영광이었습니다, 시구르드 님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810202
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 760810202,
					"content": "영웅의 말로가 이런 모습이라니, 안타깝습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810203
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 760810203,
					"content": "이 땅을 위해 모든 걸 바쳤음에도 결국 쓸쓸히 떠돌게 되다니, 혹시 등지기의 맹세를 하던 그 순간 이렇게 되리라 예상하셨습니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810204
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 760810204,
					"content": "예상했다 하더라도, 망설이지 않으셨겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810205
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 760810205,
					"content": "시구르드 님, 다음에 또 찾아오겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "플린스"
				}
			]
		},
