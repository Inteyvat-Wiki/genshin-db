			},
			"dialogs": [
				{
					"id": 760810401,
					"content": "감사합니다, 시구르드 님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810402
					],
					"speakerTitle": "일루가"
				},
				{
					"id": 760810402,
					"content": "안심하세요. 당신들의 희생 후 제 아버지 니키타가 등지기장이 되어 당신들이 구해낸 이들을 이끌고 다시 등지기 군단을 일으켜 세웠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810403
					],
					"speakerTitle": "일루가"
				},
				{
					"id": 760810403,
					"content": "그리고 이제 우리는 광란의 사냥의 그늘 아래서도 이 땅을 지켜낼 만큼 충분히 강해졌습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810404
					],
					"speakerTitle": "일루가"
				},
				{
					"id": 760810404,
					"content": "당신들의 희생은 헛된 것이 아니었어요. 당신들의 업적과 의지는 결코 잊히지 않을 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810405
					],
					"speakerTitle": "일루가"
				},
				{
					"id": 760810405,
					"content": "그럼 이만, 시구르드 님. 또 찾아뵙겠습니다. 부디 편히 쉬시길",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "일루가"
				}
			]
		},
		{
			"id": 7608199,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
