						"rawParams": [
							"49003",
							"2"
						],
						"stepId": 49003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"진"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4900301,
					"content": "진, 몸은 좀 괜찮아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4900302,
					"content": "응, 이제 괜찮아. 너희가 여기까지 올 줄은 몰랐어, 걱정해줘서 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900303
					],
					"speakerTitle": "진"
				},
				{
					"id": 4900303,
					"content": "정말? 하지만 방금 전의 진의 모습은… 여전히 지쳐 보이던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4900305,
					"content": "기사단에 좀 기대도 괜찮아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900306
					]
				},
				{
					"id": 4900306,
					"content": "저희에게 좀 기대도 괜찮아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900307
					]
				},
				{
					"id": 4900304,
					"content": "너무 무리하는 거 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4900307,
					"content": "응… 너희가 마음 써 준 덕분에 다 나은 거 같아, 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900308
					],
					"speakerTitle": "진"
				},
				{
					"id": 4900308,
					"content": "혼자서 이 정도도 견디지 못하면 어떻게 바네사 님처럼 몬드성을 수호할 수 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900309
					],
					"speakerTitle": "진"
				},
				{
					"id": 4900309,
					"content": "진은 바네사 님을 정말 동경하나 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4900310,
					"content": "응, 최초의 기사 단장인 바네사 님은 상냥하고 강인한 분이셨어, 난 줄곧 그분의 뒤를 쫓았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900311
					],
					"speakerTitle": "진"
				},
				{
					"id": 4900311,
					"content": "「라이언 기사」의 용맹함으로 귀족을 전복시키고 「민들레 기사」로서 페보니우스 기사단을 창설해 몬드에 은덕을 베푸셨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900312
					],
					"speakerTitle": "진"
				},
				{
					"id": 4900312,
					"content": "「민들레 기사」는… 진을 말하는 거 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4900313,
					"content": "「민들레 기사」나 「라이언 기사」 모두 기사 단장 대대로 전해져온 칭호야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900314
					],
					"speakerTitle": "진"
				},
				{
					"id": 4900314,
					"content": "그렇구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4900315,
					"content": "그렇다면 진은 상냥한 「민들레 기사」이자 위엄 있는 「라이언 기사」란 거네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4900316,
					"content": "맞아, 바네사 님의 칭호를 이어받은 일은 정말 영광스럽지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900317
					],
					"speakerTitle": "진"
				},
				{
					"id": 4900317,
					"content": "그만큼 책임이 막중하다는 뜻이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900318
					],
					"speakerTitle": "진"
				},
				{
