		},
		{
			"id": 49001,
			"completionStepIds": [
				49001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"49001",
							"2"
						],
						"stepId": 49001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"바바라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4900101,
					"content": "바바라, 우리 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4900102,
					"content": "어서 오세요, 수고했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900103
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 4900103,
					"content": "진은 좀 어때?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900104
					]
				},
				{
					"id": 4900104,
					"content": "바바라도 고생했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900105
					]
				},
				{
					"id": 4900105,
					"content": "괜찮아요, 환자를 돌보는 게 제 일인걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900106
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 4900106,
					"content": "진이 의식을 되찾았어요, 몸은 아직 허약한 상태이긴 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900107
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 4900107,
					"content": "정말?! 다행이다, 그럼 진을 보러 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4900108,
					"content": "진은 방금 성당을 떠났어요, 더 쉬어야 한다고 그렇게 말했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900109
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 4900109,
					"content": "…또 괜찮다면서 무거운 몸을 이끌고 좀 걷고 싶다면서 나갔어요. 아마 또 <color=#00E1FFFF>바네사 님이 계신 곳</color>으로 갔겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900110
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 4900110,
					"content": "「바네사 님이 계신 곳」?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4900111,
					"content": "아, 영웅 바네사의 상징, <color=#00E1FFFF>바람이 시작되는 곳에 있는 큰 나무</color>를 말한 거였어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900112
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 4900112,
					"content": "진은 막막함을 느낄 때면 거기로 가거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900113
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 4900113,
					"content": "바바라는 진 단장에 대해서 정말 잘 아는 것 같아, 이런 것도 다 알다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4900114,
					"content": "…그, 그건 진이 떠나기 전에 알려줘서 그래요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900115
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 4900115,
					"content": "진은 지금 많이 허약한 상태잖아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900116
					]
				},
				{
					"id": 4900116,
					"content": "이렇게 혼자 성을 나가게 내버려둬도 괜찮은 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4900117
					]
				},
				{
					"id": 4900117,
					"content": "저도 많이 걱정되지만, 아직 처리해야 할 일이 남아서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900118
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 4900118,
					"content": "알았어, 그럼 우리 둘이 진의 안전을 책임지러 갈게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4900119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4900119,
					"content": "네! 그럼 저도 이제 한숨 놓을 수 있겠네요, 바람의 신이 그대들과… 진을 지켜주길",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바바라"
				}
			]
		},
		{
			"id": 49003,
			"completionStepIds": [
				49003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
