					"nextDialogs": [
						4510502
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510502,
					"content": "늑대 무리만의 방법, 더 효율적이야. 하지만, 함정은 새로워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510503
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510503,
					"content": "설치해두고, 멧돼지를 거기로 몰면 돼. 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510504
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510504,
					"content": "폭발하진 않겠지…",
					"roleType": "TALK_ROLE_NPC",
