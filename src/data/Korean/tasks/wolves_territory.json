			"dialogs": [
				{
					"id": 4510101,
					"content": "여기가 바로 「울프 영지」야, 몬드 사람들이 여길 오는 일이 거의 없다고 들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510102,
					"content": "몬드성과 가까운데도 원시 생태를 유지하고 있어…. 자연의 법칙이 모든 걸 다스리는 곳이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510103,
					"content": "이른바 약육강식의 세계지, 슬라임마저도 거대하다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510104,
					"content": "봐, 저~~렇게나 커",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510105,
					"content": "…공격해 온다! 준비해!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 45103,
			"completionStepIds": [
				45104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
