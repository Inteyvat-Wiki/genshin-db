			"dialogs": [
				{
					"id": 4510601,
					"content": "봐 봐, 우리가 해냈어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510602,
					"content": "고마워. 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510603
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510603,
					"content": "우리가 나섰다면 대여섯 마리는 잡았을 텐데… 오늘 늑대 몇 마리는 굶겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510604
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510604,
					"content": "으음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510605
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510605,
					"content": "신경 쓰지 마, 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510606
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510606,
					"content": "너희가 기사단의 그 빨갛고 뜨거워 보이는 여자애, 친구보다 대단해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510607
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510607,
					"content": "그 애가 나섰으면, 산이 온통 불탔을 거야. 돼지는 한 마리도 못 잡고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510608
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510608,
					"content": "나는 가봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510609
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510609,
					"content": "요즘 여긴 위험해. 너희들 조심해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510610
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510610,
					"content": "정말 특이한 사람이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510611
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510611,
					"content": "방금 말한 그 기사단 친구 있잖아, 붉은색의 뜨거운 소녀——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510612
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510612,
					"content": "#{NICKNAME}, 누구인 것 같아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
