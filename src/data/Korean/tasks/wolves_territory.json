					"레이저"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4510301,
					"content": "고… 고마워——울프 영지의 늑대들이 왔다! 빨리 도망쳐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510303,
					"content": "걱정 마. 늑대는 내 친구야. 근데 너희는 누구지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510304
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510304,
					"content": "우리는 그냥 평범한 여행자야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510305,
					"content": "평범하지 않아, 너희들. 익숙한 냄새가 나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510306
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510306,
					"content": "익숙한 냄새라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510307,
					"content": "기사단, 맞지? 기사단에 친구가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510308,
						4510309
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510308,
					"content": "네 이름이 뭐야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510310
					]
				},
				{
					"id": 4510310,
					"content": "나는 레이저야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510311
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510311,
					"content": "너도 페보니우스 기사단인 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510312,
					"content": "기사단과는 아무 상관 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510314,
					"content": "으아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510315,
					"content": "늑대 무리라니… 대체 무슨 일이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510316
					]
				},
				{
					"id": 4510316,
					"content": "아… 늑대들, 내 가족이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510317
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510317,
					"content": "가족?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510318,
					"content": "가족. 날 길러주고 함께 생활해온 가족",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510319
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510319,
					"content": "아무래도 엄청 복잡한 사연이 있을 것 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510320
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510320,
					"content": "다들 날 탓하고 있어. 너희를 돕느라 위치가 노출돼서 멧돼지 놓쳤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510321
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510321,
					"content": "#그랬구나…. 그럼 {NICKNAME}이(가) 멧돼지 잡는 걸 도와줘야겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510322
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510322,
					"content": "#{NICKNAME}도 꽤 잘 잡거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510323,
					"content": "그, 그럴 필요 없어. 기사단의 친구가 나서면 늑대들은 굶게 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510324
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4510324,
					"content": "사양하지 말고 조금만 기다려봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4510309,
					"content": "너도 기사단의 사람이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510313
					]
				},
				{
					"id": 4510313,
					"content": "나는 레이저. 기사단과는 아무 상관 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "레이저"
				}
			]
		},
