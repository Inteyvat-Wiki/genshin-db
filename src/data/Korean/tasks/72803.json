					"코이치"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030401,
					"content": "안녕하세요… 무슨 일이세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030402
					],
					"speakerTitle": "코이치"
				},
				{
					"id": 728030402,
					"content": "감실 공양에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030403
					]
				},
				{
					"id": 728030403,
					"content": "아… 그건 저도 여러 번 해봤어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030404
					],
					"speakerTitle": "코이치"
				},
				{
					"id": 728030404,
					"content": "헤헤, 신이 절 보호해주시면 나중에 커서 바깥세상에 갈 수 있잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030405
					],
					"speakerTitle": "코이치"
				},
				{
					"id": 728030405,
					"content": "그래도 공양은 공양이고 전 평소에 열심히 공부하고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030406
					],
					"speakerTitle": "코이치"
				},
				{
					"id": 728030406,
					"content": "우리 엄마 아빠가 바깥세상을 여행하고 싶으면, 돈이 많아야 한다고 했어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030407
					],
					"speakerTitle": "코이치"
				},
				{
					"id": 728030407,
					"content": "맞아. 신이 지켜주시면, 다 성공할 거라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030408
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 728030408,
					"content": "아, 그래도 그건 아니지. 게다가 내가 여행을 다니면 이나즈마의 신이 외국에서까지 날 지켜줄 순 없잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030409
					],
					"speakerTitle": "코이치"
				},
				{
					"id": 728030409,
					"content": "우리 부모님이 신께 공양하는 건 마음을 편하게 해줄 뿐이래. 소원은 자기가 노력해야 한다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030410
					],
					"speakerTitle": "코이치"
				},
				{
					"id": 728030410,
					"content": "자세한 건 나도 잘 모르겠어. 알고 싶으면 나나츠키 누나한테 가서 물어봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030411
					],
					"speakerTitle": "코이치"
				},
				{
					"id": 728030411,
					"content": "#음… {F#누나}{M#형아}, 그럼 나나츠키 누나한테 가요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쇼타"
				}
			]
		},
		{
			"id": 7280305,
			"completionStepIds": [
				7280307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280307",
							"2"
						],
						"stepId": 7280307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"야요이 나나츠키"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030501,
					"content": "쇼타? 왜 그렇게 울상이야. 누가 괴롭혔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030502
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 728030502,
					"content": "나나츠키 누나, 누나는 사람들이 감실에 공양하면서 신의 가호를 바라는 거 알고 있죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030503
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 728030503,
					"content": "열심히 감실에 공양해서 신이 응답하시면 모든 소원이 다 이루어지는 거 맞죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030504
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 728030504,
					"content": "응? 갑자기 왜… 무슨 일 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030505
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 728030505,
					"content": "그게 사실은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030507
					]
				},
				{
					"id": 728030507,
					"content": "너 진짜, 그런 마음으로 열심히 감실 공양을 했구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030508
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 728030508,
					"content": "네! 성심껏 신을 공양했다고요. 근데 다른 사람이 제 공양품을 가져갔어요. 신은 분명 절 탓하면서 지켜주지 않을 거예요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030509
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 728030509,
					"content": "얘도 참, 걱정하지 마. 신은 그런 일로 화내지 않으시니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030510
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 728030510,
					"content": "진, 진짜요? 그럼 다행이네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030511
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 728030511,
					"content": "하지만 신도 공양품으로 누군갈 지키시진 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030512
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 728030512,
					"content": "네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030513
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 728030513,
					"content": "다들 감실 공양하면서 신의 보호를 바라는 건 소원을 이뤄주길 바란다기보다 강한 「믿음」을 가지는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030514
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 728030514,
					"content": "믿음이요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030515
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 728030515,
					"content": "「신에게 소원까지 말했으니까, 반드시 열심히 노력해야지」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030516
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 728030516,
					"content": "「신의 가호가 있으니, 노력하면 꼭 성공할 거야」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030517
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 728030517,
					"content": "이런 「믿음」을 가지고 자신의 소원을 향해 열심히 달려가는 거지. 그게 바로 감실을 공양하는 이유야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030518
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 728030518,
					"content": "뭐든지… 일은 하기 나름에 달렸으니까. 신의 도움만 바라고 행동하지 않는다면 신이 도와주고 싶어도 도울 기회가 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030519
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 728030519,
					"content": "하, 하지만! 전에 감실 공양하고, 신이 바로 도와줬는걸요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030520
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 728030520,
					"content": "저번 불난 것도 그렇고 강해지고 싶은 아저씨도 그렇고 내 만화책도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030521,
						728030522
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 728030521,
					"content": "(아직도 신 얘기네…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				},
				{
					"id": 728030523,
					"content": "음… 그 신은 소원을 이뤄주는 방법이 정말 직접적이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030524
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 728030524,
					"content": "하지만 이번 시험은 사라지지 않았고 절 괴롭히는 사람도 그대로예요. 자꾸 공부하라고 하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030525
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 728030525,
					"content": "음. 잠깐, 그럼 널 「괴롭히는」 사람의 이름이 뭐야? 언제 나타났어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030526
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 728030526,
					"content": "이름이… 이름… 응? 뭐더라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030527
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 728030527,
					"content": "나랑 같이 입학한 것 같은데… 아니아니, 나보다 일찍인가… 늦게인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030528
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 728030528,
					"content": "이상하다. 왜 하나도 기억이 안 나지? 공부하라고 하는 여자아이인 것만 기억나요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030529
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 728030529,
					"content": "음. 내가 보기엔 그 신이 이번에도 네 소원에 응답하시고 시험 대비를 도와주고 계신 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030530
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 728030530,
					"content": "그, 그 말은, 절 괴롭히는 사람이 실은 신이 저한테 공부하라고 보낸 사람이란 거예요?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030531
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 728030531,
					"content": "싫, 싫어요! 공부는 싫어요. 시험보기 싫어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030532
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 728030532,
					"content": "으악! 또 왔어요. 바로 저 사람이에요! 이쪽으로 오고 있어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030533,
						728030534
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 728030533,
					"content": "어디?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030535,
					"content": "#{F#누나}{M#형아}, 저거 안 보여요?! 시험지를 가득 안고 오잖아요! 으악! 싫어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030536
					],
					"speakerTitle": "쇼타"
				},
				{
					"id": 728030536,
					"content": "대단한 신이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030537,
						728030538
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 728030537,
					"content": "저 신도 참 대단하네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030539,
					"content": "어쨌든 신이 직접 숙제하라고 감시하니 시험은 무사히 통과하겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030540
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 728030540,
					"content": "감실 앞에서 하도 중얼거렸으니까, 아마 신도 못 참으셨을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030541
					],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 728030541,
					"content": "어, 잠깐만. 길에 웬 나뭇잎이? 좀 전엔 없었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야요이 나나츠키"
				},
				{
					"id": 728030538,
					"content": "저건 신이 할 일은 아닌 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030534,
					"content": "하나도 안 보이는데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030522,
					"content": "(말이 전혀 안 통해…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				}
			]
		}
	]
