				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"오토"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270801,
					"content": "안녕하세요, 전 페보니우스 기사단의 기사입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270802
					],
					"speakerTitle": "오토"
				},
				{
					"id": 4270802,
					"content": "와, 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270803
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4270803,
					"content": "비행 허가증을 보여주시죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270804,
						4270805
					],
					"speakerTitle": "오토"
				},
				{
					"id": 4270804,
					"content": "비, 비행 허가증은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				},
				{
					"id": 4270806,
					"content": "무허가 불법 비행이군. 몬드성의 치안 관리법 제7조 제20항에 따라 당신을 연행하겠습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270807
					],
					"speakerTitle": "오토"
				},
				{
					"id": 4270807,
					"content": "당신은 묵비권을 행사할 수 있지만, 바람은 당신이 한 모든 말을 기억할 것입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270808
					],
					"speakerTitle": "오토"
				},
				{
					"id": 4270808,
					"content": "잠깐! 우린 지금 비행 허가 시험 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270809
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4270809,
					"content": "아, 그런 거였습니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270810
					],
					"speakerTitle": "오토"
				},
				{
					"id": 4270810,
					"content": "이 시기에 비행 허가 시험이라… 좋은 타이밍은 아니군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270811
					],
					"speakerTitle": "오토"
				},
				{
					"id": 4270811,
					"content": "무슨 일이라도 생긴 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270812
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4270812,
					"content": "기사단으로 성당 수녀님의 신고가 들어왔습니다. 「괴조」가 또 바람의 날개를 써서 도망쳤다더군요. 그래서 방금 저 수험생분을 놈의 동료라 생각했습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270813
					],
					"speakerTitle": "오토"
				},
				{
					"id": 4270813,
					"content": "괴조? 그게 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270814
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4270814,
					"content": "몬드성의 상습범인데 매번 바람의 날개를 타고 범행을 저질러 「괴조」라는 별명이 붙었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270815
					],
					"speakerTitle": "오토"
				},
				{
					"id": 4270815,
					"content": "으음, 그 녀석이 그렇게 빨리 날아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270816
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4270816,
					"content": "아직까지… 붙잡아 본 적이 없습니다. 이번엔 성당의 문물을 미끼로 잡아보려 했지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270817
					],
					"speakerTitle": "오토"
				},
				{
					"id": 4270817,
					"content": "되려 유물만 내준 꼴이 되었네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270818
					],
					"speakerTitle": "오토"
				},
				{
					"id": 4270818,
					"content": "하지만 이번엔 수녀님께서 문물에 원소 마법으로 표시를 해뒀습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270819
					],
					"speakerTitle": "오토"
				},
				{
					"id": 4270819,
					"content": "다만 놈이 너무 빠른 탓에, 원소 흔적을 따라갔지만 붙잡지 못했습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270820
					],
					"speakerTitle": "오토"
				},
				{
					"id": 4270820,
					"content": "과연 비행 고수란 건가. 역시 이 엠버 님이 나서야겠군——흠, 녀석은 어느 방향으로 도망쳤어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270821
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4270821,
					"content": "마지막으로 나타난 곳이 샘물 마을 근처라고 하지만 그것도 이미 한참 전이라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270822
					],
					"speakerTitle": "오토"
				},
				{
					"id": 4270822,
					"content": "#걱정 말고 내게 맡겨, 마침 {NICKNAME}도 있고, 같이 가서 그 괴조 녀석을 잡아 올게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270823,
						4270824
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4270823,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270825,
					"content": "걱정 마, 괴조를 잡기만 하면 내가 바로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270826
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4270826,
					"content": "…진 단장님께 상황을 설명해줄게, 크흠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				},
				{
					"id": 4270824,
					"content": "그러면 비행 허가 시험은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270805,
					"content": "토, 토끼 백작한테 먹혔어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				}
			]
		},
