			},
			"dialogs": [
				{
					"id": 4270201,
					"content": "어이——여기야, 여기",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270202
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4270202,
					"content": "다 설치했으니 시험을 이어가 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270203
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4270203,
					"content": "방식은 저번 시험과 똑같아, 표식을 지나 결승점까지 한번에 날아가면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270204
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4270204,
					"content": "난 준비됐어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 42704,
			"completionStepIds": [
				42704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"42704",
