				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"엠버"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270401,
					"content": "바람의 날개로 비행하는 요령을 터득한 거 같네. 그럼 바로 마지막 코스를 시작해보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270402
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4270402,
					"content": "여긴 이미 한 번 날아본 코스니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4270403,
					"content": "그럼, 마지막 테스트야. 통과하면 비행 허가증을 받을 일만 남은 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270404
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4270404,
					"content": "비행 허가증을 향해, 준비…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270405
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4270405,
					"content": "…시작!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 42708,
			"completionStepIds": [
				42708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"42708",
							"2"
						],
						"stepId": 42708,
						"stateName": "QUEST_STATE_UNFINISHED"
