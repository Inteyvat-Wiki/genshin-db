			},
			"dialogs": [
				{
					"id": 200310501,
					"content": "헤헷, 사양하진 않을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200310502,
					"content": "그래, 받아 둬. 이건 모험가 길드가 감사를 표시하는 방식이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310503
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310503,
					"content": "너희 같은 모험가들의 도움이 없다면 길드에서도 매일같이 들어오는 이 수많은 의뢰들을 처리할 수 없었을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310504
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310504,
					"content": "매일 일정 수량의 의뢰를 완료하면 나한테 와서 보너스 선물을 받아 가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310505
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310505,
					"content": "「모험 핸드북」에 오늘 완료한 의뢰의 수량이 기록될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310506
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310506,
					"content": "당일에 선물을 수령하는 걸 잊지 마. 수량은 정해진 거라서 때를 놓치면 보충 수령을 할 수가 없거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310507,
						200310509
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310507,
					"content": "알았어요. 고마워요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310508
					]
				},
				{
					"id": 200310508,
					"content": "아니야, 내가 더 고맙지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310512,
					"content": "참, 네가 모험가 친구들을 도와 의뢰를 완료해도 선물 수령 횟수에 포함이 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310513
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310513,
					"content": "모험가 친구들이랑 서로 많이 협력하라구! 별과 심연을 향해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310509,
					"content": "하루에 한 개뿐인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310510
					]
				},
				{
					"id": 200310510,
					"content": "지금으로선 그래… 미안",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310511
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310511,
					"content": "안심해. 모험가들이 공정하고 적절한 보수를 받을 수 있도록 계속해서 본부랑 협상하고 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "캐서린"
				}
			]
		},
