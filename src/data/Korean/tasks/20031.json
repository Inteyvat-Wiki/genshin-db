			},
			"dialogs": [
				{
					"id": 200310101,
					"content": "또 만났네, 떠오르는 샛별 모험가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310102
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310102,
					"content": "어때, 요즘 모험은 할 만해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310103,
						200310105
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310103,
					"content": "할만해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310104
					]
				},
				{
					"id": 200310104,
					"content": "좋은 대답이야. 계속 유지하라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310107,
					"content": "경력도 충분히 쌓은 것 같은데 이제 너에게 모험가 길드의 주요 업무를 소개해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310108
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310108,
					"content": "모험가 길드는 매일 여러 곳에서 보내오는 <color=#00E1FFFF>의뢰</color>들을 정리해서 모험가들한테 맡기고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310109
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310109,
					"content": "모험가들의 주요 수입원이기도 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310110
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310110,
					"content": "모두 어떤 의뢰들이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200310111,
					"content": "뭐든 다 있어. 주민을 돕는 것부터 몬스터 처치까지, 잡일도 있고 위험한 의뢰도 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310112
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310112,
					"content": "듣기만 하는 것보다 직접 해보는 게 이해에 도움이 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310113
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310113,
					"content": "이건 오늘의 의뢰 내용이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310114
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310114,
					"content": "의뢰를 완료하면 나한테 알려줘. 푸짐한 보상을 지급할 테니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310115,
						200310117
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310115,
					"content": "내게 맡겨요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310116
					]
				},
				{
					"id": 200310116,
					"content": "역시 너야, 믿음직스러워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310119,
					"content": "#그럼 여기서 너의 좋은 소식을 기다리고 있을게, {NICKNAME}. 별과 심연을 향해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310117,
					"content": "얼마나 푸짐한데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310118
					]
				},
				{
					"id": 200310118,
					"content": "너무 급해 하지 마. 미리 알면 재미없잖아. 널 실망하게 하지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310105,
					"content": "약간 힘들어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310106
					]
				},
				{
					"id": 200310106,
					"content": "처음엔 다 그렇지, 모험 전에 미리 준비해두면 많이 쉬워질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "캐서린"
				}
			]
		},
