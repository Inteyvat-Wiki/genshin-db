			},
			"dialogs": [
				{
					"id": 200310401,
					"content": "#소문이 자자하던데? {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310402
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310402,
					"content": "모험가 길드에서 받은 <color=#00E1FFFF>의뢰</color>를 완성했다며? 의뢰인이 나보고 감사하단 말을 전해달라네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310403,
						200310406
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310403,
					"content": "의뢰? 그런 기억 없는데요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310404
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310404,
					"content": "네가 가던 길에서 도와준 일들 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310405
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310405,
					"content": "그들은 사실 길드에 의뢰를 맡겼던 사람들이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310408,
					"content": "어쨌든, 그래도 너한테 간단한 소개는 할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310409
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310409,
					"content": "모험가 길드는 매일 여러 곳에서 보내오는 의뢰들을 정리해서 모험가들한테 맡기고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310410
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310410,
					"content": "모험가들의 주요 수입원이기도 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310411
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310411,
					"content": "보수를 말하자면 길드에서 널 위해 준비한 서프라이즈를 빼먹을 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310406,
					"content": "가던 길에 마침 도와줬을 뿐이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310407
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310407,
					"content": "역시 모험가 길드의 떠오르는 샛별 모험가야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "캐서린"
				}
			]
		},
