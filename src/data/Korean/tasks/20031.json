			"dialogs": [
				{
					"id": 200310201,
					"content": "#훌륭해, {NICKNAME}. 처음 치고는 엄청 잘한 편이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310202
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310202,
					"content": "의뢰인도 나보고 고맙다고 전해달라 하더라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310203
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200310203,
					"content": "그럼 이제 내가 전에 했던 약속을 지킬 차례네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐서린"
				}
			]
		},
