			"dialogs": [
				{
					"id": 730280101,
					"content": "여기에도 거대한 로봇의 부품이 있네. 쟈자리가 보면 또 사진기를 꺼내 들겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730280102,
					"content": "비밀기지에 있던 큰 부품들 말이야… 전에 아란리캔이 옮겼다고 했잖아, 그거 설마 진짜는 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730280103,
					"content": "당연히 진짜지. 아란리캔은 나라를 속이지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280104,
						730280105
					],
					"speakerTitle": "아란리캔"
				},
				{
					"id": 730280104,
					"content": "역시…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280106
					]
				},
				{
					"id": 730280106,
					"content": "그때 아이들이랑 같이 비밀기지에서 놀던 아란나라가 아란리캔인가 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730280107,
					"content": "하지만 아란리캔은 다 잊어버렸어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280108,
						730280109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730280108,
					"content": "어쩌면 수첩에 있던 꽃과 관련이 있을지도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280110
					]
				},
				{
					"id": 730280110,
					"content": "응, 전에 마우티이마 숲의 아란나라도 우리에게 꽃을 준 뒤 모든 기억을 잃었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730280111,
					"content": "어쩌면 그 셋도 우리와 같은 모험을 했을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730280112,
					"content": "아란리캔은 너희가 무슨 말을 하는 건지 모르겠어. 기억도 안 나. 하지만 어린 나라랑 같이 노는 건 정말 즐거워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280113
					],
					"speakerTitle": "아란리캔"
				},
				{
					"id": 730280113,
					"content": "응. 항상 즐거워야 해, 아란리캔",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730280109,
					"content": "전에도 본 적 있잖아…",
