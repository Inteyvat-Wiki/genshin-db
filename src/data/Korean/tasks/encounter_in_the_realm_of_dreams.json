			"dialogs": [
				{
					"id": 120440201,
					"content": "음… 예전에 여기서 너구리를 쫓던 때가 떠오르네. 그리운 기분이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120440202,
					"content": "어라? 저게 뭐지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440203,
						120440204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120440203,
					"content": "너구리?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				},
				{
					"id": 120440205,
					"content": "아니지 않아? 설마 이나즈마에 또 새로운 요괴가 나타났나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120440206,
					"content": "음… 따라오라는 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120440204,
					"content": "아기 돼지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				}
			]
		},
