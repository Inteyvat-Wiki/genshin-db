			"dialogs": [
				{
					"id": 80120202,
					"content": "어떻게 된 거야, 카리베르트는?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120203,
						80120204
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80120203,
					"content": "방에 없어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120205
					]
				},
				{
					"id": 80120205,
					"content": "아니, 카리베르트가… 설마, 누가 왔었나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120206
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80120206,
					"content": "아니다. 문은 멀쩡하고, 주변에 누가 남긴 흔적도 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120207,
						80120208
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80120207,
					"content": "혼자 나간 걸까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120209
					]
				},
				{
					"id": 80120209,
					"content": "큰일이야. 카리베르트가 그 모습으로 숲의 순찰자나 모험가를 만나면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120210,
						80120211
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80120210,
					"content": "어서 카리베르트를 찾아야 해요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120212
					]
				},
				{
					"id": 80120212,
					"content": "잠깐만… 뭔가 건드린 흔적이 있는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120213
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80120213,
					"content": "설마…!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120214
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80120214,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120215
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80120215,
					"content": "거울이… 깨졌다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120216
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80120216,
					"content": "(거울? 그 거울은… 진작에 깨지지 않았나?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120217
					]
				},
				{
					"id": 80120217,
					"content": "거울이 깨진 게 왜요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120218
					]
				},
				{
					"id": 80120218,
					"content": "카리베르트는 분명 가면을 벗고… 자기 얼굴을 본 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120219
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80120219,
					"content": "망할! 말을 듣지 않는 아이로군…. 어서 쫓아가야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아이드"
				},
				{
					"id": 80120211,
					"content": "지체해선 안 돼요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120212
					]
				},
				{
					"id": 80120208,
					"content": "왜 갑자기…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120209
					]
				},
				{
					"id": 80120204,
					"content": "설마…",
					"roleType": "TALK_ROLE_PLAYER",
