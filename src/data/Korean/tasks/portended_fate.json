			"dialogs": [
				{
					"id": 80120101,
					"content": "무슨 일이지!? 아니, 어떻게 이럴 수가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120102,
						80120103
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80120102,
					"content": "사라졌네요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120104
					]
				},
				{
					"id": 80120104,
					"content": "경배하던 츄츄족도 사라지고 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120105
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80120105,
					"content": "설마… 다 환각이었나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120106,
						80120107
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80120106,
					"content": "그렇진 않을 거예요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120108
					]
				},
				{
					"id": 80120108,
					"content": "그래…. 환각일 리가 없지. 그 위대하고 신비로운 힘이 아직도 내 머리와 몸 안에서 맴돌고 있는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120109
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80120109,
					"content": "분명히 환각이나 우연이 아니고, 꿈도 아닌! 진짜로 존재하는 「신비」였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120110
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80120110,
					"content": "…가자, 여행자. 「그것」이 사라진 의미가 있겠지…. 언젠간 반드시 다시 보게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120111,
						80120112
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80120111,
					"content": "집착이 대단하네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120113
					]
				},
				{
					"id": 80120113,
					"content": "신이 아니라… 「죄인」이라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아이드"
				},
				{
					"id": 80120112,
					"content": "일단 돌아가죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120113
					]
				},
				{
					"id": 80120107,
					"content": "둘이 동시에 같은 환각을 볼 순 없을 테니까요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120108
					]
				},
				{
					"id": 80120103,
					"content": "분명 여기였는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120104
					]
				}
			]
		},
