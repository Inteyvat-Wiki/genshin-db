			"dialogs": [
				{
					"id": 401450201,
					"content": "#{NICKNAME} 님, 페이몬 님, 안녕하세요! 제 도움이 필요하신가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450202
					],
					"speakerTitle": "프레다"
				},
				{
					"id": 401450202,
					"content": "응, 요즘 우리 일손이 부족한데, 리사가 경영 효율을 높여 보라고 해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401450203,
					"content": "아, 안 그래도 그 일에 대해 리사 님과 상의해 봤어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450204
					],
					"speakerTitle": "프레다"
				},
				{
					"id": 401450204,
					"content": "현재 개선해 볼 만한 건 연금 공정, 재배 기술, 그리고 판매 규모예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450205
					],
					"speakerTitle": "프레다"
				},
				{
					"id": 401450205,
					"content": "효율을 높이면 경영도 한결 수월해질 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450206
					],
					"speakerTitle": "프레다"
				},
				{
					"id": 401450206,
					"content": "와, 듣기만 해도 뭔가 대단해… 우리 빨리 시도해 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450207,
						401450209,
						401450211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401450207,
					"content": "경영 효율을 높일래요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450208
					]
				},
				{
					"id": 401450208,
					"content": "효율을 높이는 데 필요한 건 다 준비해 뒀으니까, 많이 시도해 보세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "프레다"
				},
				{
					"id": 401450209,
					"content": "물자를 구매할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450210
					]
				},
				{
					"id": 401450210,
					"content": "최근에 새로운 물자가 들어왔어요. 필요한 게 있는지 확인해 보세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "프레다"
				},
				{
					"id": 401450211,
					"content": "이만 가볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450212
					]
				},
				{
					"id": 401450212,
					"content": "경영이 순조롭길 바랄게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "프레다"
				}
			]
		}
