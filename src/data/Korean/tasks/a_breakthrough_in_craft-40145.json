			"dialogs": [
				{
					"id": 401450101,
					"content": "일정 기간의 가오픈 기간을 거친 후, 연금술 가게는 사람들 사이에서 유명해지기 시작했다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401450102
					]
				},
				{
					"id": 401450102,
					"content": "후아, 손님이 갈수록 많아지네. 너무 바빠서 어지러울 정도야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450103,
						401450104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401450103,
					"content": "장사가 갈수록 잘돼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				},
				{
					"id": 401450105,
					"content": "이 정도 주문량을 우리 둘이서 처리하기는 힘들지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401450106,
					"content": "도와줄 사람을 찾아야 할 거 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401450107,
					"content": "귀염둥이, 쉬고 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450108
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401450108,
					"content": "방금 영업 수익 데이터를 확인해 봤는데, 역시 너희는 경영에 재능이 있나 봐. 포션을 정말 많이 팔았더라~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450109
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401450109,
					"content": "왔구나, 리사! 안 그래도 새 인력을 뽑을까 싶어서 얘기하는 중이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401450110,
					"content": "어머? 주문이 많아져서 둘이서는 감당이 안 되나 보네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450111
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401450111,
					"content": "응, 손님이 이렇게 많을지 처음엔 생각도 못 했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401450112,
					"content": "후후, 하지만 나는 다 예상했던 일이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450113
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401450113,
					"content": "실은 너희가 가게를 여는 동안 프레다와 경영 효율을 높일 방법을 상의해 봤거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450114
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401450114,
					"content": "너희 경영 상황을 관찰해 보니까, 연금 공정이랑 약재 재배, 판매 측면 모두 개선할 부분이 많이 보이더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450115
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401450115,
					"content": "와, 우리 몰래 그런 걸 관찰하고 있었던 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401450116,
					"content": "그냥 땡땡이나 치고 있을 줄 알았는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401450117,
					"content": "얘는, 나도 중요한 순간엔 믿음직한 사람이라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450118
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401450118,
					"content": "그래서 효율을 높이려면 구체적으로 어떻게 해야 하는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401450119,
					"content": "아, 그거? 구체적인 개선 방안은 프레다한테 말해뒀어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450120
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401450120,
					"content": "자세한 얘긴 직접 가서 들어보도록 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리사"
				},
				{
					"id": 401450104,
					"content": "유명해졌나 봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				}
			]
		},
