			"dialogs": [
				{
					"id": 726550301,
					"content": "왜, 준비 운동할 시간이라도 필요한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550302,
						726550303
					],
					"speakerTitle": "여진"
				},
				{
					"id": 726550302,
					"content": "유적에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				},
				{
					"id": 726550304,
					"content": "난 함대 기술자라, 육지에 대한 역사는 잘 몰라, 미안",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550305
					],
					"speakerTitle": "여진"
				},
				{
					"id": 726550305,
					"content": "하지만 이 유적들은 오백 년 전의 대재앙과 관련이 있는 거 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550306
					],
					"speakerTitle": "여진"
				},
				{
					"id": 726550306,
					"content": "노련한 뱃사람들한테 대재앙에 대해 들은 적이 있어, 바다와 육지 모두 심연의 피해를 받았대…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550307
					],
					"speakerTitle": "여진"
				},
				{
					"id": 726550307,
					"content": "하지만 나한텐 어린애 겁주는 귀신 이야기처럼 들리네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550308
					],
					"speakerTitle": "여진"
				},
				{
					"id": 726550308,
					"content": "직접 본 두려움이 정말 무서운 거니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "여진"
				},
				{
					"id": 726550303,
					"content": "신비한 기계에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550304
					]
				}
