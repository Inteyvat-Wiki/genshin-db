			},
			"dialogs": [
				{
					"id": 726550201,
					"content": "하하, 바로 여기야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550202
					],
					"speakerTitle": "여진"
				},
				{
					"id": 726550202,
					"content": "여기에도 지하 유적이 있었구나… 흠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550203,
						726550204
					],
					"speakerTitle": "여진"
				},
				{
					"id": 726550203,
					"content": "왜 그래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
				},
				{
					"id": 726550205,
					"content": "아, 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550206
					],
					"speakerTitle": "여진"
				},
				{
					"id": 726550206,
					"content": "응? 어디 아픈 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726550207,
					"content": "하하, 배에서만 지내서 그런지 유적 입구 같은 어마어마한 걸 보니까 좀 무서워서 그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550208
					],
					"speakerTitle": "여진"
				},
				{
					"id": 726550208,
					"content": "이건 전혀 어마어마하지 않다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726550209,
					"content": "좋아, 대장의 주문이 우릴 기다리고 있다구. 여행자 너도 유적에 숨겨진 비밀이 궁금하지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550210
					],
					"speakerTitle": "여진"
				},
				{
					"id": 726550210,
					"content": "그러니까, 탐험 경험이 풍부한 여행자가 먼저 가는 게 어떨까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726550211
					],
					"speakerTitle": "여진"
				},
				{
					"id": 726550211,
					"content": "정말 못 말리겠네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550212
					]
				},
				{
					"id": 726550212,
					"content": "으… 정말 못 말린다니까, 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726550204,
					"content": "뭐 알아낸 거라도 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726550205
					]
				}
			]
		},
