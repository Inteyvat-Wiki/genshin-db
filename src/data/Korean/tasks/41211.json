			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"알베도"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110201,
					"content": "우인단이라고? 게다가 보물 사냥단 야영지에서 우릴 기습하다니… 우릴 따라온 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110202
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110202,
					"content": "근데 왜 우릴 따라왔을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412110203,
					"content": "앗! 너, 우리 몰래 무슨 사고 친 거 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412110204,
					"content": "너 무슨 사고 쳤니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110205,
						412110206
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110205,
					"content": "말도 안 돼!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				},
				{
					"id": 412110207,
					"content": "음… 우린 잘못한 거 없는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412110208,
					"content": "우인단도 이 검을 찾는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110209
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110209,
					"content": "에엥? 이 검을 꼭꼭 숨겼잖아. 우인단에서 이 검의 존재를 어떻게 알았지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412110210,
					"content": "설산에서 네가 싸우는 모습을 봤을 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110211
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110211,
					"content": "눈썰미가 좋다면, 이 검이 특별하다는 걸 알아봤을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110212
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110212,
					"content": "우인단 놈들, 진짜 탐욕스럽다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412110213,
					"content": "꼭 그런 건 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110214
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110214,
					"content": "관련된 소식을 들은 적이 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110215
					]
				},
				{
					"id": 412110215,
					"content": "우인단은 신과 관련된 것들을 수집하고 있어. 너희들도 알고 있을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110216
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110216,
					"content": "아, 그러고 보니 다이루크 어르신이 했던 얘기네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412110217,
					"content": "두린은 바람 신의 적으로 꽤 큰 힘을 보유하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110218
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110218,
					"content": "두린은 「신에 필적할 존재」나 「신과 관련 있는 존재」라고 해도 지나치지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110219
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110219,
					"content": "우인단이 탐낼 만한 검이긴 하네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110220
					]
				},
				{
					"id": 412110220,
					"content": "그런 거였구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412110221,
					"content": "얼마 전에 근처에 스케치하러 왔다가 발견한 게 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110222
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110222,
					"content": "여기서 앞으로 가다 보면 특이한 곳이 있어. 그곳의 지맥 흐름은 다른 곳과 달라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110223
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110223,
					"content": "주변의 몬스터들은 그곳으로 빨려들어가서 영향을 받아. 그럼 동족들보다 몸이 훨씬 강해져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110224
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110224,
					"content": "귀가 솔깃해지는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110225
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412110225,
					"content": "이 검을 성장시켜달라고 했지? 이왕 여기까지 왔으니 가보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110226
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412110226,
					"content": "맞아. 그리고 이 검이 다양한 적들에게 미치는 영향도 관찰할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110206,
					"content": "난 절대 그런 짓 안 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				}
			]
		},
		{
			"id": 4121103,
