					"nextDialogs": [
						412110307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412110307,
					"content": "이 가설이 맞다면, 설산의 몬스터들도 두린의 유해와 공명을 일으킬 수 있겠지",
					"roleType": "TALK_ROLE_NPC",
