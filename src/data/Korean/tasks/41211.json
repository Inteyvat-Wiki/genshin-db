			},
			"dialogs": [
				{
					"id": 412110301,
					"content": "느낌 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110302,
						412110303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412110302,
					"content": "검의 힘이 더 강해졌어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110304
					]
				},
				{
					"id": 412110304,
					"content": "가설을 세워보지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110305
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110305,
					"content": "이 검이 적의 몸에서 힘을 흡수해 이 설산 깊은 곳에 숨겨진 두린의 유해와 공명을 일으키는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110306
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110306,
					"content": "와… 뭔가 엄청난데!",
