			"dialogs": [
				{
					"id": 412110101,
					"content": "알베도——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412110102,
					"content": "왔구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110103
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110103,
					"content": "검을 성장시킨다고 엄청 애썼다고. 한번 봐봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412110104,
					"content": "봐줘",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110105
					]
				},
				{
					"id": 412110105,
					"content": "음… 역시",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110106
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110106,
					"content": "생각했던 대로야. 이 검은 전투를 하면서 성장해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110107
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110107,
					"content": "인간도 아닌데 그럴 수가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412110108,
					"content": "그러니까 특별한 검이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110109
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110109,
					"content": "맞다, 중요한 일이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110110
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110110,
					"content": "근처의 설원을 조사하다가 이상한 흔적을 발견했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110111
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110111,
					"content": "어맛, 좀도둑은 아니겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110112,
						412110113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412110112,
					"content": "우리가 좀도둑 아니었어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				},
				{
					"id": 412110114,
					"content": "그건 그렇네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412110115,
					"content": "그 흔적, 심상치가 않아. 조사해볼 필요가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110116
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110116,
					"content": "좀도둑인지 아니면 다른 건지 조사해보면 알겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "알베도"
				},
				{
					"id": 412110113,
					"content": "보물 사냥단은 그렇게 생각하지 않을 걸",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				}
			]
		},
		{
			"id": 4121102,
			"completionStepIds": [
				4121109
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
