	"talks": [
		{
			"id": 1302301,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302304",
							"2"
						],
						"stepId": 1302304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"카베",
					"알하이탐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130230101,
					"content": "시라즈라는 이름은 들어본 적이 없는데, 너희 기수에 그런 사람이 있었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230102
					],
					"speakerTitle": "카베"
				},
				{
					"id": 130230102,
					"content": "기억에 남을 만한 사람이 아니었으니 기억 못 하는 게 정상이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230103
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 130230103,
					"content": "아카데미아는 걸핏하면 천재니 기인이니 이상한 타이틀이나 지위를 씌우고 학자를 부려 먹잖아, 난 그 점이 정말 마음에 안 들어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230104
					],
					"speakerTitle": "카베"
				},
				{
					"id": 130230104,
					"content": "아카데미아가 너에게 현자 대행 자리를 맡긴 건 잘못된 판단이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230105
					],
					"speakerTitle": "카베"
				},
				{
					"id": 130230105,
					"content": "그래도 네가 자신의 분수를 잘 알아서 다행이네. 아카데미아가 미치지만 않았다면 내가 너보다 더 현자에 어울린다는 걸 알겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230106
					],
					"speakerTitle": "카베"
				},
				{
					"id": 130230106,
					"content": "사람들에게 네 현자 생활이 저 브로마이드처럼 위태롭다는 걸 자랑하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230107
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 130230107,
					"content": "곧 사임할 녀석이 못 하는 말이 없네? 조만간 서류 정리나 하는 삶으로 돌아가게 생겼으면서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230108
					],
					"speakerTitle": "카베"
				},
				{
					"id": 130230108,
					"content": "하지만 봉급은 그대로니 아무 문제 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230109
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 130230109,
					"content": "뭐?! 어째서!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230110
					],
					"speakerTitle": "카베"
				},
				{
					"id": 130230110,
					"content": "게다가 난 건축 디자이너처럼 힘들게 의뢰인에게 잘 보이려고 노력할 필요도 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230111
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 130230111,
					"content": "너… 이 자식…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230126
					],
					"speakerTitle": "카베"
				},
				{
					"id": 130230126,
					"content": "역시 거실 청소 따위 해주는 게 아니었어! 나도 설계도 그리느라 바쁘거든?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230112
					],
					"speakerTitle": "카베"
				},
				{
					"id": 130230112,
					"content": "밀린 월세 내는 거 잊지 말고, 그걸로 가구를 좀 살까 생각 중이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230113
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 130230113,
					"content": "뭐… 너 지금 일부러 날 열받게 하려는 거지? 네 장식은 미적 감각이 전혀 없잖아, 영혼 없는 목각을 집에 두는 이유가 대체 뭔데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230114
					],
					"speakerTitle": "카베"
				},
				{
					"id": 130230114,
					"content": "경제적으로 여유가 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230115
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 130230115,
					"content": "이봐, 늘 자신의 장점을 남의 단점이랑 비교하는 것은 일종의 회피나 다름없잖아? 속물적인 가치 말고 더 고상한 것으로 비교해보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230116
					],
					"speakerTitle": "카베"
				},
				{
					"id": 130230116,
					"content": "네가 나보다 우위에 있는 게 뭔지 전혀 떠오르지 않는걸, 혹시 넌 떠오르는 게 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230117
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 130230117,
					"content": "예술성이 있잖아! 넌 실내 인테리어에 전혀 소질이 없어, 내 동행 없이는 가구 사는 거 금지야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230118
					],
					"speakerTitle": "카베"
				},
				{
					"id": 130230118,
					"content": "설마 동행을 빌미로 술을 얻어 마시려는 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230119
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 130230119,
					"content": "물론이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230120
					],
					"speakerTitle": "카베"
				},
				{
					"id": 130230120,
					"content": "술을 얻어 마셔 봤자 내게 진 빚만 늘어날 텐데? 일종의 대출이나 마찬가지잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230121
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 130230121,
					"content": "네가 선심 써서 빚을 면제해준다는 선택지는 없는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230122
					],
					"speakerTitle": "카베"
				},
				{
					"id": 130230122,
					"content": "남의 모라를 빌리면서 빚이 없는 척하는 건, 남의 집에 얹혀사는 것만큼 우스꽝스러운 일이지. 언젠간 다른 사람들한테 들킬 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230123
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 130230123,
					"content": "그나저나 오늘 온 녀석들이 떠벌리지는 않겠지? 비밀을 지켜달라고 꼭 좀 전해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230124
					],
					"speakerTitle": "카베"
				},
				{
					"id": 130230124,
					"content": "내 생각엔 이미 들켰을 거니까 숨기려고 하지 마. 네 하찮은 주량을 감안하면, 진작에 술집에서 술김에 다 털어놓았을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230125
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 130230125,
					"content": "에이, 설마? …아니야, 그럴 리 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카베"
				}
			]
		}
	]
}