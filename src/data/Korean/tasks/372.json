			"dialogs": [
				{
					"id": 3720501,
					"content": "에?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3720502,
					"content": "넌… 역시 불가사의한 힘을 가지고 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720503
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720503,
					"content": "너처럼 특별한 사람이라면 나중에 반드시 음유시인이 부르는 노래의 주인공이 되어 널리 울려 퍼질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720504
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720504,
					"content": "태양을 향한 곳에 서 있으면 영웅이 되고 태양을 등진 곳에 서 있으면 재앙을 초래하리…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720505
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720505,
					"content": "아… 하지만 지금은 너를 위해 노래를 만들 겨를이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720506
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720506,
					"content": "굳이 토벌하지 않아도 드발린의 생명력은 빠르게 소진될 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720507
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720508,
					"content": "나도 드발린이 불쌍해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720509
					]
				},
				{
					"id": 3720511,
					"content": "도움이 필요하면 말해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720512
					]
				},
				{
					"id": 3720514,
					"content": "기사로서 충고하는데 드래곤과 함께 자수해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720515
					]
				},
				{
					"id": 3720507,
					"content": "녀석은 분노로 자신을 불태우고 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720508,
						3720511,
						3720514
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720509,
					"content": "그렇게 생각해줘서 고마워. 눈물의 결정을 정화시켜준 것도 고맙고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720510
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720510,
					"content": "이제 내가 움직일 차례야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720512,
					"content": "눈물 결정을 정화시켜준 것만으로도 도움이 됐어, 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720513
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720513,
					"content": "하지만 내겐 나만의 계획이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720515,
					"content": "이봐, 그렇게 매정하게 굴지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720516
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720516,
					"content": "자수는 아직 일러…. 내겐 다른 계획이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720517,
					"content": "음? 그래서 그 계획이란 건 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720518
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3720518,
					"content": "드래곤의 눈물을 보고 있으니 옛 친구가 생각나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720519
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720519,
					"content": "옛 친구?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720520
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3720520,
					"content": "하하, 난 그럼 이만 실례할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720521
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720521,
					"content": "이봐, 어디 가는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720522
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3720522,
					"content": "—「몬드 건립의 상징」. 그럼 안녕",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720523
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720524,
					"content": "이상한 사람이야. 관찰이 필요해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720525
					]
				},
				{
					"id": 3720523,
					"content": "#으음… {NICKNAME}, 넌 어떻게 생각해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720524
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3720526,
					"content": "게다가…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720527
					]
				},
				{
					"id": 3720525,
					"content": "걔한테는 너도 이상한 사람일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720526
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3720528,
					"content": "왠지 목소리가 귀에 익어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3720527,
					"content": "게다가?",
