			"dialogs": [
				{
					"id": 3720101,
					"content": "어, 너희는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720102
					],
					"speakerTitle": "초록색 녀석"
				},
				{
					"id": 3720102,
					"content": "아… 하! 그때 드발린을 놀라게 해서 도망치게 만든 사람이구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720103
					],
					"speakerTitle": "초록색 녀석"
				},
				{
					"id": 3720103,
					"content": "드발린? 그게 누구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720104,
						3720105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3720104,
					"content": "풍마룡의 진짜 이름이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				},
				{
					"id": 3720106,
					"content": "음… 어! 생각났어. 하지만 사람들은 보통 「풍마룡」이라고 부르던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3720107,
					"content": "왜 그렇게 불러? 혹시 아는 사이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3720108,
					"content": "맞춰봐~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720109
					],
					"speakerTitle": "초록색 녀석"
				},
				{
					"id": 3720109,
					"content": "#이봐, {NICKNAME}. 얘 좀 이상해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720110,
						3720112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3720110,
					"content": "안녕. 궁금한 게 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720111
					]
				},
				{
					"id": 3720111,
					"content": "안녕, 이방인. 여기서 또 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720113
					],
					"speakerTitle": "초록색 녀석"
				},
				{
					"id": 3720113,
					"content": "난 음유시인 벤티라고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720114
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720114,
					"content": "정확히 말하자면 「몬드성에서 가장 인기 있는 음유시인 TOP 10」에서 3년 연속 1등을 차지한 사람이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720115
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720115,
					"content": "내게 무슨 볼일이 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720116
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720116,
					"content": "우리를 알아봤으니 척하면 딱이잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3720117,
					"content": "당근 풍마룡 일 때문이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3720118,
					"content": "음~~?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720119
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720119,
					"content": "이봐! 기억상실인 척하지 말라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3720120,
					"content": "#{NICKNAME}, 그걸 꺼내서 보여줘도 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3720121,
					"content": "오! 이건~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720122
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720122,
					"content": "응? 결정이 정화됐잖아? 언제 이렇게 됐지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720123,
						3720124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3720123,
					"content": "나도 몰라, 그냥 이렇게 됐어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720125,
					"content": "이건 드발린의…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720126
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720126,
					"content": "이건 풍마룡이 괴로워서 흘린 눈물이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720127
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3720127,
					"content": "눈… 물…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3720124,
					"content": "저번에 봤을 땐 이물질투성이였는데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720112,
					"content": "넌?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720113
					]
				},
				{
					"id": 3720105,
					"content": "벌써 잊은 거야? 리사가 말해줬잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				}
			]
		},
