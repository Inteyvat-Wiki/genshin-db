				"points": []
			},
			"dialogs": [
				{
					"id": 730391224,
					"content": "#그래. {NICKNAME}이(가) 도와줘야 해. 안 그럼 그전에 만들었던 거랑 비슷한 요리밖에 못 만들 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391201
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730391201,
					"content": "전에 페이몬이 생각했던 개선 방법대로 아란나라들은 새로운 요리를 만들어냈다.\\n아란나라들과 요리를 즐기는데…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730391202
					]
				},
				{
					"id": 730391202,
					"content": "어때? 나라 정통 요리가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730391203,
					"content": "#음… 아란파카티가 나라{NICKNAME}한테 오빠들을 가르쳐 달라고 하긴 했지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391204
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730391204,
					"content": "나라의 음식… 이, 이게 나라의 「즐거운 맛」이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391205
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730391205,
					"content": "있던 즐거움도 다 도망가겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391206
					],
					"speakerTitle": "아란사카"
				},
				{
					"id": 730391206,
					"content": "바나라나의 물… 틀림없이 「가장 맛있는 물」일 텐데… 어떻게 이런 맛이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391207
					],
					"speakerTitle": "아란파스"
				},
				{
					"id": 730391207,
					"content": "그래도 「가장 신선한 열매」는 맛있어… 응",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391208
					],
					"speakerTitle": "아란팔라"
				},
				{
					"id": 730391208,
					"content": "엥, 어떻게 된 거지? 아란나라들은 다 별로야? 페이몬은 맛있기만 한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730391209,
					"content": "「별로」가 뭔진 모르겠지만… 음… 아주 「충격」적인 맛이야. 엄청 빨리 뛰다가 나무에 부딪힌 느낌이랄까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391210
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730391210,
					"content": "와… 아, 아마… 나라 문화랑 아란나라 문화가 달라서 그런 걸 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730391211,
					"content": "#그런데 오빠들 진짜 못됐어. 나라{NICKNAME}한테 고맙다고 해야지, 어떻게 그런 말을 할 수 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391212
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730391212,
					"content": "흑흑… 미안…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391213
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730391213,
					"content": "그게 아니야! 고맙다고 해야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391214
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730391214,
					"content": "#고마워, 나라{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391215
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730391215,
					"content": "#그래도… 나라{NICKNAME}와(과) 페이몬이 맛있게 먹었으면 됐어! 저 멍청한 오빠들은 신경 쓰지 마, 나라 친구들이 기쁘다면 우리도 기뻐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391216
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730391216,
					"content": "#그런데 나라{NICKNAME}(이)랑 나라바루나는 좀 다르네. 나라바루나는 그때 「{M#오빠}{F#동생}」 얘기를 엄청 많이 했었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391217
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730391217,
					"content": "#그런데 나라{NICKNAME}(은)는 말수가 적네. 불편해서 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391218
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730391218,
					"content": "#음… {NICKNAME}, 말 좀 하는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391219,
						730391220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730391219,
					"content": "신경 써줘서 고마워",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391222
					]
				},
				{
					"id": 730391222,
					"content": "#그래? 나라{NICKNAME}이(가) 괜찮다면야. 아, 고마워. 이 꽃은 나랑 오빠들이 나라{NICKNAME}와(과) 페이몬에게 주는 선물이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391223
					],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730391223,
					"content": "#나라{NICKNAME}(이)랑 페이몬이 바나라나에서 더 많은 「즐거운 맛」을 얻으면 좋겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란파카티"
				},
				{
					"id": 730391220,
					"content": "(침묵을 지킨다)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391221
					]
				},
				{
					"id": 730391221,
					"content": "#…아무튼 걱정 마, 아란파카티! {NICKNAME} 멀쩡하대!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391222
