					"nextDialogs": [
						207010107
					],
					"speakerTitle": "지크프리야"
				},
				{
					"id": 207010107,
					"content": "정말 너무 맛있게 먹어서 그 맛을 잊을 수가 없었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010108
					],
					"speakerTitle": "지크프리야"
				},
				{
					"id": 207010108,
					"content": "그래서 나도 한번 만들어봤는데… 뭔가 좀 부족한 맛이더라구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010109
					],
					"speakerTitle": "지크프리야"
				},
				{
					"id": 207010109,
					"content": "몇 번만 더 먹어보면 그 맛을 재현해 낼 수 있을 것 같은데!",
