			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718020301,
					"content": "할 말 있으면 빨리하거라. 난 아직 할 일이 많으니 더 이상 지체할 시간이 없다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020302
					],
					"speakerTitle": "선인 거처 방문"
				},
				{
					"id": 718020302,
					"content": "안부를 전하러 온 것뿐이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020303
					]
				},
				{
					"id": 718020303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020304
					],
					"speakerTitle": "선인 거처 방문"
				},
				{
					"id": 718020304,
					"content": "희한한 녀석들이군…. 소원을 빌러 온 게 아니라 안부만 전하러 왔다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020305
					],
					"speakerTitle": "선인 거처 방문"
				},
				{
					"id": 718020305,
					"content": "됐다, 마음대로 하거라. 범인의 생각 따위 알고 싶지도 않으니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020306
					],
					"speakerTitle": "선인 거처 방문"
				},
				{
					"id": 718020306,
					"content": "그렇게 한가하면 차라리 내 부탁 하나 들어주는 건 어떤가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020307
					],
					"speakerTitle": "선인 거처 방문"
				},
				{
					"id": 718020307,
					"content": "예전에 기관술 연구에 약간 성과가 있었을 때 공중에 떠 있는 「구름 속의 선인 거처」라는 걸 지었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020308
					],
					"speakerTitle": "선인 거처 방문"
				},
				{
					"id": 718020308,
					"content": "이는 부유석을 재료로 하고 온갖 기교를 보태서 만들었지. 그중 가장 훌륭한 건 바로… 됐다, 말해도 너흰 모를 거다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020309
					],
					"speakerTitle": "선인 거처 방문"
				},
				{
					"id": 718020309,
					"content": "아무튼 「구름 속의 선인 거처」를 짓고 난 뒤 그 위에 도면도 남겨뒀어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020310
					],
					"speakerTitle": "선인 거처 방문"
				},
				{
					"id": 718020310,
					"content": "그곳에 약간의 봉인을 가해 인연이 닿는 자가 그걸 얻길 바랐지만, 오랜 시간이 지난 지금까지도 봉인이 그대로야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020311
					],
					"speakerTitle": "선인 거처 방문"
				},
				{
					"id": 718020311,
					"content": "이제 그 도면을 거기 두는 것도 번거로우니, 너희가 「구름 속의 선인 거처」에 가서 그 도면을 가져와 주게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020312,
						718020314
					],
					"speakerTitle": "선인 거처 방문"
				},
				{
					"id": 718020312,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020313
					]
				},
				{
					"id": 718020313,
					"content": "시원시원하군. 그럼 어서 가봐. 그걸 손에 넣으면 이곳으로 오거라, 기다리고 있을 테니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "선인 거처 방문"
				},
				{
					"id": 718020314,
					"content": "도면을 어디에 쓰시게요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020315
					]
				},
				{
					"id": 718020315,
					"content": "다 쓸 데가 있지. 넌 말해도 모를 거다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020316
					],
					"speakerTitle": "선인 거처 방문"
				},
				{
					"id": 718020316,
					"content": "어서 가봐. 손에 넣으면 이곳으로 와라, 기다리고 있을 테니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "선인 거처 방문"
				}
			]
		},
