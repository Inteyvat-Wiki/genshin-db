					"이브"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200301,
					"content": "맞아, 이게 바로 우리가 매일 건지고 있는 물건이야. 쓸모없는 쓰레기뿐이지. 하여간 구질구질한 짠돌이 녀석…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200302
					],
					"speakerTitle": "이브"
				},
				{
					"id": 240200302,
					"content": "도와줘서 고마워. 이건 골드만에게 가불 받은 급여인데 부디 받아줬으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200303
					],
					"speakerTitle": "이브"
				},
				{
					"id": 240200303,
					"content": "이 돈은 받을 수 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200304
					]
				},
				{
					"id": 240200304,
					"content": "네 몫이니 꼭 받아야만 해. 네가 사양하겠다면 이 돈주머니를 바다에 던져버릴 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200305
					],
					"speakerTitle": "이브"
				},
				{
					"id": 240200305,
					"content": "알겠어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200306
					]
				},
				{
					"id": 240200306,
					"content": "그래야지! 나중에 건질 물건이 있다면 언제든 날 찾아와. 어디에 있는 물건이든 확실하게 건져줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200307
					],
					"speakerTitle": "이브"
				},
				{
					"id": 240200307,
					"content": "잠깐 좀 쉬어야겠어… 휴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이브"
				}
			]
		},
		{
			"id": 2402004,
			"completionStepIds": [
				2402006
