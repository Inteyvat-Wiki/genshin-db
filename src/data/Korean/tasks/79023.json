			"dialogs": [
				{
					"id": 790230501,
					"content": "원래 이런 섬이 또 있었나… 이상하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230502
					],
					"speakerTitle": "체프카"
				},
				{
					"id": 790230502,
					"content": "예전에 우리가 조사할 때는 이런 섬이 없었던 걸로 기억하는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230503
					],
					"speakerTitle": "체프카"
				},
				{
					"id": 790230503,
					"content": "체프카… 왜 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230504,
					"content": "아니, 아무 것도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230505
					],
					"speakerTitle": "체프카"
				},
				{
					"id": 790230505,
					"content": "응, 야코프도 이 섬에 도착한 거 같네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230506,
					"content": "맞아, 야코프. 빨리 야코프를 찾아야 돼. 야코프——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230507
					],
					"speakerTitle": "체프카"
				},
				{
					"id": 790230507,
					"content": "와, 말했잖아. 갑자기 크게 말하지 않아도 된다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230508,
					"content": "미안…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230509
					],
					"speakerTitle": "체프카"
				},
				{
					"id": 790230509,
					"content": "#그렇게 긴장할 필요 없어. 여긴 정말 안전한 곳이야. {NICKNAME}, 먼저 야코프가 어디 있는지 찾아보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
