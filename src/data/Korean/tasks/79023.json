			"dialogs": [
				{
					"id": 790230301,
					"content": "근데, 저 사람이 찾는 휘장은 우리가 예전에 해변에서 주웠던 그 휘장이 아닐까… 약간 낡은 그 휘장!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230302,
					"content": "휘장을 보여줘 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230303
					],
					"speakerTitle": "페이몬"
				},
