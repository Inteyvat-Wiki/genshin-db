			"dialogs": [
				{
					"id": 790232101,
					"content": "#휴, 야코프. 야코프는 어떡하지… 왜, {NICKNAME}. 또 무슨 일 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790232102,
