			"dialogs": [
				{
					"id": 790231101,
					"content": "그 휘장을 찾아야 돼… 그 휘장을 찾아야 한다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790231102
					],
					"speakerTitle": "체프카"
				},
				{
					"id": 790231102,
					"content": "(휘장을 찾아서 다시 그와 얘기해 보자…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7902312,
			"completionStepIds": [
				7902313
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902313",
