			},
			"dialogs": [
				{
					"id": 790230801,
					"content": "다 나 때문이야… 나 때문에 그가 저렇게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230802
					],
					"speakerTitle": "체프카"
				},
				{
					"id": 790230802,
					"content": "안 돼, 나는… 나는 휘장을 찾아 그에게 줘야 돼… 휘장을 찾아야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230803
					],
					"speakerTitle": "체프카"
				},
				{
					"id": 790230803,
					"content": "어이, 너 여기서 뭐 하는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230804
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230804,
					"content": "휘장, 휘장…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230805
					],
					"speakerTitle": "체프카"
				},
				{
					"id": 790230805,
					"content": "우리를 완전히 무시하고 있잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230806
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230806,
					"content": "페이몬, 큰소리로 말해봐!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230807
					]
				},
				{
					"id": 790230807,
					"content": "내 말이 안 들리는 게 분명해. 아무리 소리 질러봤자 소용없을걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230808
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230808,
					"content": "아가피아와 처음 만났을 때랑 정말 똑같잖아. 그땐 회중시계 속 사진을 주니까 아가피아가 제정신으로 돌아왔었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230809
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230809,
					"content": "이 번개 해머 돌격대도 장치로부터 받은 영향에서 벗어날 수 있게 해줄 물건이 있지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230810
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230810,
					"content": "#보니까 계속 무슨 휘장을 찾는 거 같던데… {NICKNAME}, 쟤가 찾는 휘장을 찾아 줘야 될 거 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
