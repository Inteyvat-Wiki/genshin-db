				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790230101,
					"content": "다 나 때문이야… 나 때문에 그가 저렇게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230102
					],
					"speakerTitle": "체프카"
				},
				{
					"id": 790230102,
					"content": "안 돼, 나는… 나는 휘장을 찾아 그에게 줘야 돼… 휘장을 찾아야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230103
					],
					"speakerTitle": "체프카"
				},
				{
					"id": 790230103,
					"content": "이 우인단 녀석이 계속 뭐라는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230104,
					"content": "어이, 너 여기서 뭐 하는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230105,
					"content": "휘장, 휘장…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230106,
						790230107
					],
					"speakerTitle": "체프카"
				},
				{
					"id": 790230106,
					"content": "상태가 이상한데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230108
					]
				},
				{
					"id": 790230108,
					"content": "음, 좀 신경 쓰이는데. 왜 번개 해머 돌격대 혼자 여기 있는 거지. 설마 나쁜 짓을 하려는 건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230109,
					"content": "#{NICKNAME}, 넌 저 번개 해머 돌격대를 어떻게 생각해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230110,
					"content": "돌진 공격만 조심하면 괜찮을걸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230111
					]
				},
				{
					"id": 790230111,
					"content": "하긴, 번개 해머 돌격대의 돌진은 무섭지… 아니, 내 말은 그게 아니잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230112,
					"content": "내 말은, 쟤를 정신 차리게 해서 여기서 뭘 하는지 물어봐야 하느냐는 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230113,
					"content": "궁금하긴 해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230114
					]
				},
				{
					"id": 790230114,
					"content": "그치. 우인단 혼자 여기서 「휘장, 휘장…」 그러는데 뭔가 찾고 있는 것 같단 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230115,
					"content": "보기 드문 일이긴 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230116,
					"content": "그런데 얘는 어쩌다 이렇게 된 걸까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230117,
					"content": "그 장치 때문일걸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230118
					]
				},
				{
					"id": 790230118,
					"content": "그래. 우인단도 그 장치에 영향을 받았었지. 정신이 들게 하려면 도대체 무슨 방법을 써야 할까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230119,
					"content": "그 휘장을 찾아야 돼… 그 휘장을 찾아야 한다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790230120
					],
					"speakerTitle": "체프카"
				},
				{
					"id": 790230120,
					"content": "#보니까 계속 무슨 휘장을 찾는 거 같던데… {NICKNAME}, 쟤가 찾는 휘장을 찾아 줘야 될 거 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790230107,
					"content": "대화가 안 통해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790230108
					]
				}
			]
		},
