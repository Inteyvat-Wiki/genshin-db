	"talks": [
		{
			"id": 7370401,
			"completionStepIds": [
				7370401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370401",
							"2"
						],
						"stepId": 7370401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"란짓"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737040101,
					"content": "또다시 새로운 희망으로 가득한 하루가 시작되었군! 출발할 준비는 됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040102
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040102,
					"content": "새로운 희망이라…. 그건 아마 고대 바위 용 도마뱀과 친구가 되는 건 실패했다는 뜻이겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 737040103,
					"content": "실패라니. 서로 치고받는 것도 교류의 일종이라고 할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040104
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040104,
					"content": "그런 관점에서 보자면 우리는 솔직하고 깊은 교류를 했어. 그리고 그 과정에서 서로의 입장을 충분히 이해하게 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040105
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040105,
					"content": "왜 그런 말도 있잖아? 「싸우면서 정든다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040106,
						737040108
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040106,
					"content": "딱 그렇게 될 것 같더라니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737040107
					]
				},
				{
					"id": 737040107,
					"content": "그래도 뭐가 됐든 시도는 해봐야지 않겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040110
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040110,
					"content": "그래서 아직 포기하지 않겠다는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 737040111,
					"content": "솔직히 말하자면, 공포의 취령 버섯을 타고 수메르를 돌아다녀 보는 게 어릴 적 꿈이었거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040112
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040112,
					"content": "하지만 당시 어른들은 바보 같은 짓 하지 말라고 했어. 숲의 순찰관을 찾아가서 물어보기도 했는데, 걱정스러운 표정을 지으면서 위험한 행동은 자제하라더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040113
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040113,
					"content": "그래서 나는 비현실적인 꿈을 포기하고는 다른 아이들처럼 평범하게 자랐어. 내가 하는 유일한 모험은 식자재 선택할 때뿐이었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040114
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040114,
					"content": "가끔 생각이 나. 어렸을 땐 그런 꿈을 꿨었지 하고 말이야. 뭔가 아득하면서도 낯선 느낌… 마치 전설 속 아란나라처럼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040115
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040115,
					"content": "만약 그들이 정말로 존재하고, 나도 본 적이 있었다면… 언제부터 그들을 볼 수 없게 되어버린 걸까? 언제부터 그들을 잊게 된 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040116
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040116,
					"content": "나타에 있을 때 이런 이야기를 들었어. 쿤투르라는 어떤 불쌍한 녀석이 있었는데, 자기 아버지가 저지른 잘못 때문에 태양에게 버림받았다고 하더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040117
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040117,
					"content": "「태양에게 사랑받지 못하는 쿤투르」는 부족에서도 환영받지 못했어. 물론 용들도 동료가 되어주려고 하지 않았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040118
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040118,
					"content": "하지만 쿤투르는 낙담하지 않았고, 아버지나 운명을 원망하지 않았어. 대신 부단히 노력해 부족 최강의 전사조차 자기를 꺾을 수 없다는 것을 증명해냈지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040119
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040119,
					"content": "결국 쿤투르는 용기와 지혜로 놀라운 일을 해냈다고 해. 덕분에 명{RUBY#[D]익토미사우르스}시룡 동료의 인정을 받았을 뿐만 아니라, 일족의 영웅이 되었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040120
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040120,
					"content": "그 이야기를 들으니까 나도 어릴 적 꿈에 다시 도전해 볼 용기가 생겼어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040121
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040121,
					"content": "그런 이유가 있었구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 737040122,
					"content": "그러니까 공포의 취령 버섯과의 정면 「협상」은 너희에게 맡길게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040123
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040123,
					"content": "결국 우리한테 떠넘기는 거냐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 737040124,
					"content": "지금 내 실력으로는 공포의 취령 버섯의 상대가 안 돼… 대신 보조는 열심히 할 테니까 필요하면 언제든 말만 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040125
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040125,
					"content": "자, 그럼 슬슬 시작해 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040126,
						737040127
					],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040126,
					"content": "좋아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 737040127,
					"content": "지금 다른 일이 있어서, 나중에 할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737040128
					]
				},
				{
					"id": 737040128,
					"content": "그럼 그렇게 해. 난 여기서 기다리고 있을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "란짓"
				},
				{
					"id": 737040108,
					"content": "치고받은 건 전데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737040109
					]
				},
				{
					"id": 737040109,
					"content": "역시 진정한 모험가! 내가 봐도 전투 경험이 풍부해 보이더라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040110
					],
					"speakerTitle": "란짓"
				}
			]
		}
	]
}