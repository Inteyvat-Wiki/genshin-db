			},
			"dialogs": [
				{
					"id": 230100101,
					"content": "친구, 꽤 바빠 보이는데 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100102,
						230100105
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100102,
					"content": "아주 많은 일이 있었죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100103
					]
				},
				{
					"id": 230100103,
					"content": "아… 엄청 피곤해 보이는데 여전히 쉴 새 없이 바쁘게 움직이고 있네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100104
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100104,
					"content": "분명 고민거리가 있는 것 같은데 아마 빨리 해결 방법을 찾아야 하는 문제겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100109,
					"content": "조금 여유를 즐기는 게 어때? 잠깐 앉아서 나와 함께 맛있는 음식을 즐기지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100110
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100110,
					"content": "인생은 항상 바쁘게 돌아가지… 하지만 바쁘게 흘러가는 강물도 가끔 고요한 시냇물을 조용히 지나가기도 하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100111
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100111,
					"content": "아무리 바빠도 여유를 즐길 시간 정도는 있어야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100112
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100112,
					"content": "어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100113
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100113,
					"content": "함께 「완두콩 민트 수프」를 먹는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100114
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100114,
					"content": "나한테 모라를 지급할 필요는 없고, 대신 민트나 좀 구해다 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100115
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100115,
					"content": "아, 참, 너무 까다롭게 민트를 고를 필요 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100116
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100116,
					"content": "명심해. 문제를 찾는 게 아니라 그냥 평범한 민트를 찾는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자파"
				},
				{
					"id": 230100105,
					"content": "별거 아니에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100106
					]
				},
				{
					"id": 230100106,
					"content": "아, 그렇다면 다행이고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100107
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100107,
					"content": "하지만 이렇게 분주하게 움직이는 걸 보니 뭔가를 해결하기 위해 노력하고 있는 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100108
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100108,
					"content": "음, 무슨 일을 처리해야 하는지는 모르지만 조언을 하나 해줄게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "자파"
				}
			]
		},
