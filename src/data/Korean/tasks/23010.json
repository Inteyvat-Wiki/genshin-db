					"자파"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230100801,
					"content": "친구, 꽤 바빠 보이는데 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100802,
						230100805
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100802,
					"content": "아주 많은 일이 있었죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100803
					]
				},
				{
					"id": 230100803,
					"content": "아… 엄청 피곤해 보이는데 여전히 쉴 새 없이 바쁘게 움직이고 있네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100804
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100804,
					"content": "분명 고민거리가 있는 것 같은데 아마 빨리 해결 방법을 찾아야 하는 문제겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100809
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100809,
					"content": "조금 여유를 즐기는 게 어때? 잠깐 앉아서 나와 함께 맛있는 음식을 즐기지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100810
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100810,
					"content": "인생은 항상 바쁘게 돌아가지… 하지만 바쁘게 흘러가는 강물도 가끔 고요한 시냇물을 조용히 지나가기도 하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100811
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100811,
					"content": "아무리 바빠도 여유를 즐길 시간 정도는 있어야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100812
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100812,
					"content": "어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100813
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100813,
					"content": "함께 「샤와르마」를 먹는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100814
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100814,
					"content": "나한테 모라를 지급할 필요는 없고, 대신 짐승고기나 좀 구해다 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100815
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100815,
					"content": "짐승고기를 어떻게 구할지는 네 자유야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100816
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100816,
					"content": "명심해. 이건 어려운 일이 아니라 그저 짐승고기를 구하는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자파"
				},
				{
					"id": 230100805,
					"content": "별거 아니에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100806
					]
				},
				{
					"id": 230100806,
					"content": "아, 그렇다면 다행이고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100807
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100807,
					"content": "하지만 이렇게 분주하게 움직이는 걸 보니 뭔가를 해결하기 위해 노력하고 있는 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100808
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100808,
					"content": "음, 무슨 일을 처리해야 하는지는 모르지만 조언을 하나 해줄게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100809
					],
					"speakerTitle": "자파"
				}
			]
		},
