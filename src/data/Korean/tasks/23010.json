			"trigger": {
				"objectNames": [
					"자파"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230100701,
					"content": "매우 실한 감자네. 잠깐만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100703
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100702,
					"content": "자파는 다른 식자재를 꺼내더니 요리를 하기 시작했다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230100703,
					"content": "네가 가져온 식자재로 만든 「파니푸리」야. 맛 좀 봐봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100704
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100704,
					"content": "고맙습니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100705
					]
				},
				{
					"id": 230100705,
					"content": "천만에. 맛있는 음식을 즐기도록 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100706
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100706,
					"content": "난 맛있는 음식을 즐길 때면 피곤한 연구 과제 따위는 전부 잊어버리곤 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100707
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100707,
					"content": "내 생각이 고요한 시냇물처럼 조용하게 흐르게 두지… 이게 바로 내가 쉬는 방식이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100708
					],
					"speakerTitle": "자파"
				},
				{
					"id": 230100708,
					"content": "그래. 이 음식의 맛을 제대로 느껴보도록 해. 바쁜 일상에서 여유를 찾길 바랄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자파"
				}
			]
		},
		{
			"id": 2301008,
			"completionStepIds": [
				2301008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
