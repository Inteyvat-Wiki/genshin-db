			"dialogs": [
				{
					"id": 750050101,
					"content": "#{NICKNAME}, 이거 봐! 여기 봉인된 문이 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050102,
					"content": "흐흥, 방금 주변에서 얻은 이상한 물건으로 이 문을 열 수 있을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050103,
					"content": "과연 이 문은 어디로 통할까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050104,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050105,
						750050110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050105,
					"content": "마물의 소굴일지도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050106
					]
				},
				{
					"id": 750050106,
					"content": "오… 마물이 있는 곳에는 분명 보물이 있겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050107,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050108,
					"content": "글쎄?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050109
					]
				},
				{
					"id": 750050109,
					"content": "흥, 불길한 소리 그만 좀 하라구. 들어가 보면 알겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050115,
					"content": "어이, 두 이방인! 음… 그리고 손수건을 두르고 있는 꼬마 산룡아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050116
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050116,
					"content": "우웅?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050117,
					"content": "이런, 기운 넘치는 꼬마야. 여기는 「금지 구역」이라서 봉인됐다는 걸 저 녀석들한테 말 안 했니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050118
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050118,
					"content": "저 안에는 깊고 깊은 저주만 있을 뿐이야. 그 외에는 아무것도 찾을 수 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050119
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050119,
					"content": "우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050120
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050120,
					"content": "그러니까… 보물이 없다는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050121,
					"content": "보물이야… 아마 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050122
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050122,
					"content": "아마요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050123
					]
				},
				{
					"id": 750050123,
					"content": "하지만 이방인이 손댈 순 없어. 봉인된 문 뒤는 「금지 구역」이자 「성지」거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050124
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050124,
					"content": "평소엔 시련을 통과한 전달꾼만이 자격을 얻고 들어갈 수 있어. 전해지기로 안에는 고대 선조가 밤의 세계와 소통할 때 쓰던 매개체가 보관되어 있다는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050125
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050125,
					"content": "그러고 보니 내가 잠시 자리를 비운 사이에 시련을 완료하고 돌 열쇠 3개를 얻은 거야? 그건 정말 대단하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050126
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050126,
					"content": "헤헤, 사방을 돌아다니면서 물건을 찾는 건 우리 전문이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050127,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050128
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050128,
					"content": "부족의 전달꾼도 너희 같은 솜씨는 못 보일 거 같은데…. 음, 부족의 금지 구역에 들여보낼 순 없지만, 여기 근처에 내 야영지가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050129
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050129,
					"content": "내가 맛있는 요리를 대접해 줄 테니까 잠깐 쉬다 갈래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050130
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050130,
					"content": "우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050131,
						750050135
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050131,
					"content": "배 안 고파요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050132
					]
				},
				{
					"id": 750050132,
					"content": "나도…! 어, 난 좀 고프네…. 아니면 우리 잠깐 쉬었다 갈까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050133,
					"content": "정말 못 말린다니까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050134
					]
				},
				{
					"id": 750050134,
					"content": "헤헤… 난 아직 한창 자랄 때라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050139,
					"content": "푸흡… 사이가 정말 좋구나. 자, 내 야영지로 가서 잠깐 쉬자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050140
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050140,
					"content": "내가 따뜻한 음식을 준비해 줄게. 우리는 많은 이야기를 나눌 수 있을지도 몰라. 멀리서 온 손님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050135,
					"content": "이왕 왔으니까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050136
					]
				},
				{
					"id": 750050136,
					"content": "괜찮아. 넌 푹 쉬어 밤에 내가 망볼 테니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050137
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050137,
					"content": "넌 나보다 먼저 잠들게 뻔하잖아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050138
					]
				},
				{
					"id": 750050138,
					"content": "이봐——! 날 너무 얕보지 말라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050110,
					"content": "보물이 숨겨진 동굴일지도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050111
					]
				},
				{
					"id": 750050111,
					"content": "와! 내 직감도 그래. 분명히 보물이 숨겨진 동굴일 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050112,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050113
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050113,
					"content": "너무 흥분하지 마",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050114
					]
				},
				{
					"id": 750050114,
					"content": "안에 뭐가 있는지는 들어가 보면 알겠지! 일단 이 문부터 열어보자! 헤헤, 보물이여, 우리가 왔다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050115
					],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7500502,
			"completionStepIds": [
				7500505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7500505",
							"2"
						],
						"stepId": 7500505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"#{REALNAME[ID(2)|SHOWHOST(true)]}",
					"렉바"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2235.689,
							208.739,
							7959.164
						],
						"pointId": 8109
					},
					{
						"sceneId": 3,
						"position": [
							-2237.073,
							208.846,
							7958.869
						],
						"pointId": 8110
					},
					{
						"sceneId": 3,
						"position": [
							-2236.62,
							208.781,
							7958.013
						],
						"pointId": 9244
					}
				]
			},
			"dialogs": [
				{
					"id": 750050201,
					"content": "예의 차릴 거 없이 편하게 있어. 내가 만든 것 좀 먹어볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050202
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050202,
					"content": "직접 만들고 싶다면 저 상자에 레시피가 있어. 필요 없는 물건들도 있으니까 찾아봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050203
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050203,
					"content": "엥? 항상 레시피도 준비해두고 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050204,
					"content": "내가 직접 그린 거야. 누군가 쓸지도 몰라서 여러 장 그려뒀지. 위험에 처한 사람을 도와줄 수도 있고. 안 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050205
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050205,
					"content": "와, 정말 세심하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050206,
					"content": "부족 밖에선 자신의 힘으로 살아가야 하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050207
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050207,
					"content": "참, 당신은 이름이 뭐죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050208
					]
				},
				{
					"id": 750050208,
					"content": "내 이름? 하! 렉바라고 부르면 돼. 그럼 너희는?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050209
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050209,
					"content": "렉바에게 자기소개를 했다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050210
					]
				},
				{
					"id": 750050210,
					"content": "#페이몬, {NICKNAME}, 그리고 꼬마 산룡 {REALNAME[ID(2)|SHOWHOST(true)]}… 서로 나타에서 만났다니, 정말 신기한 인연이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050211
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050211,
					"content": "#그나저나 {NICKNAME}, 너희는 부족의 금지 구역에서 뭐 하고 있었어? 음, 보물찾기? 비밀 조사?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050212,
						750050215
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050212,
					"content": "당연히 보물찾기죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050213
					]
				},
				{
					"id": 750050213,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050214
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050214,
					"content": "응응! 이렇게 잘 보호된 곳에는 보물이 숨겨져 있을 수도 있잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050220,
					"content": "아무튼 외부인은 거기에 흑심을 품지 마. 난 너희들이 들어가게 두지 않을 거니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050221
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050221,
					"content": "거기는 고대 선조와 밤이 다시 연결된 곳이야. 그날 후로 더 많은 부족 사람들이 「밤의 신의 나라」의 문에 입장할 수 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050222
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050222,
					"content": "음?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050223
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050223,
					"content": "「밤의 신의 나라」는 대체 어떤 곳이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050224
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050224,
					"content": "하하, 그곳은 나타 사람들이 이 세상을 떠날 때 가는 곳이래…. 극소수의 사람들만 거기서 돌아왔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050225
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050225,
					"content": "그곳은 물이 형광처럼 빛나고 거대한 흑요석 비석이 세워져 있다고 해. 아무튼 부족의 금지 구역에 관심 갖지 마, 「밤의 신의 나라」에는 더더욱 관심 갖지 말고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050226
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050226,
					"content": "그러니까 아까 말한 그 밑에 있는 그… 밤의 세계랑 소통하는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050227
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050227,
					"content": "맞아, 매개체야. 옛날 사람들이 「대영혼」 그러니까… 「밤의 신의 나라」에서 온 사자와 접촉하던 도구였지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050228
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050228,
					"content": "우와, 정말 오래된 도구구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050229
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050229,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050230
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050230,
					"content": "내가 너무 많이 말했나… 아무튼 부족과 「밤의 신의 나라」가 안정적인 연결을 맺은 지금, 더 이상 매개체가 필요하지 않아. 게다가 내가 보기에 매개체로 연결하는 방법은 좀 조잡하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050231
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050231,
					"content": "그래도 인간 부족의 성물이긴 하니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050232
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050232,
					"content": "우웅… 웅!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050233
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050233,
					"content": "그래, 그렇구나… 알겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050234
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050234,
					"content": "그래, 금지 구역엔 가지 않는 게 정답이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050235
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050235,
					"content": "하! 하! 너희 동료는 정말 똑똑한 꼬마구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050236
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050236,
					"content": "나도 많은 동료가 있었지… 아주 똑똑한 꼬마들이었어. 하지만 지금 난 무리를 떠나 홀로 산지 꽤 됐지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050237
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050237,
					"content": "크흠… 아, 어느새 밤이 깊어졌네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050238
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050238,
					"content": "하암… 이해하기 어려운 말을 들어서 그런지 좀 졸리네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050239
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050239,
					"content": "아, 미안. 오래간만에 말이 통하는 사람을 만나니까 말이 많아졌네… 괜찮다면 여기서 하룻밤 묵고 가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050240
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050240,
					"content": "잠자리는 내가 준비해 둘게. 밤엔 내가 주변을 순찰하니까 안전 문제는 걱정할 거 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050241
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050241,
					"content": "와, 정말 친절하네! 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050242
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050242,
					"content": "우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050243
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050243,
					"content": "모닥불 옆에 있는 따뜻한 잠자리에 누운 당신은 곧 꿈나라로 빠져든다…\\n하지만 귓가에 들려오는 작고 시끄러운 소리 때문에 깊게 잠들지는 못했다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050244
					]
				},
				{
					"id": 750050244,
					"content": "이윽고——\\n얼굴에 닿은 차갑고 촉촉한 촉감이 당신을 검고 끈적한 꿈에서 깨웠다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050245
					]
				},
				{
					"id": 750050245,
					"content": "#눈을 뜨자, {REALNAME[ID(2)|SHOWHOST(true)]}의 친근한 얼굴이 보인다.\\n당신을 핥아서 깨우려고 한 것 같다.\\n좀 지나서야 녀석이 무언가를 보여주려 한다는 걸 눈치챈다. 독특한 흑요석 석상이다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050246
					]
				},
				{
					"id": 750050246,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050247,
						750050249
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050247,
					"content": "네가 찾은 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050248
					]
				},
				{
					"id": 750050248,
					"content": "꺄… 꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050252
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050252,
					"content": "으… 이거 너무 섬뜩하고 불길해 보여…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050253,
						750050255
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050253,
					"content": "페이몬, 너도 불운 같은 걸 믿어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050254
					]
				},
				{
					"id": 750050254,
					"content": "그냥 느낌을 말한 거야…. 딱 봐도 좋은 물건은 아닌 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050257
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050257,
					"content": "#그나저나 우리가 자는 틈을 타서 멋대로 돌아다녔지, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050258
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050258,
					"content": "우우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050259
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050259,
					"content": "곤란하네. 어디서 주워 온 물건일까…? 위험하거나 더러운 곳은 아니겠지?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050260
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050260,
					"content": "우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050261
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050261,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}? {NICKNAME}! 페이몬!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050262
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050262,
					"content": "우리 여기 있어. 왜 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050263
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050263,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}의 울음소리를 듣고 왔어. 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050264
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050264,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050265
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050265,
					"content": "이… 이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050266
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050266,
					"content": "세상에, 이건 봉인된 문 뒤편 금지 구역에 있는 흑요석 석상이잖아. 선조들이 「밤의 신의 나라」와 소통하는 매개체인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050267
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050267,
					"content": "너희가 파내라고 한 거야? 이 이방인들이… 내가 묵을 곳도 제공해 줬는데, 감히 부족의 성물을 노리다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050268,
						750050270,
						750050272
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050268,
					"content": "잠시만요. 저희가 설명할 수 있어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050269
					]
				},
				{
					"id": 750050269,
					"content": "일부러 그런 게 아니야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050274
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050274,
					"content": "우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050275
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050275,
					"content": "렉바에게 자초지종을 설명한다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750050276
					]
				},
				{
					"id": 750050276,
					"content": "그랬구나. 이 녀석이 여기저기 땅을 파고 다닌다는 걸 잊었네… 내가 너무 부주의했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050277
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050277,
					"content": "휴, 큰일이네. 어디 보자… 아주 오랫동안 사용하지 않았지만, 그래도 성물이니까 「대영혼」이 화낼지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050278
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050278,
					"content": "뭐? 그럼 어떡해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050279
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050279,
					"content": "아무튼 너희가 이 물건을 원래 자리로 돌려놔줬으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050280
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050280,
					"content": "우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050281
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050281,
					"content": "너 말하는 거잖아, 에휴 이 말썽꾸러기 꼬마 녀석! 됐어, 어서 출발하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050282
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050282,
					"content": "미리 말해두는데… 유적 안의 길은 구불구불하고 함정이 많으니까 조심해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050270,
					"content": "들켰다, 빨리 도망치자!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050271
					]
				},
				{
					"id": 750050271,
					"content": "무슨 소리하는 거야. 일부러 파낸 것도 아니잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050274
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050272,
					"content": "발각 됐으니까 어쩔 수 없이…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050273
					]
				},
				{
					"id": 750050273,
					"content": "아직 싸울 상황은 아니잖아. 제대로 설명이나 하라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050274
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050255,
					"content": "엄청 비싸 보이는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050256
					]
				},
				{
					"id": 750050256,
					"content": "흥… 이렇게 추한 물건이 비쌀 리가 없잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050257
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050249,
					"content": "네가… 뱉은 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050250
					]
				},
				{
					"id": 750050250,
					"content": "우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050251
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050251,
					"content": "아무리 봐도 뱉은 건 아니잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050252
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050215,
					"content": "그냥 궁금해서요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750050216
					]
				},
				{
					"id": 750050216,
					"content": "맞아, 봉인된 문을 보면 안 궁금해지는 사람이 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750050217,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050218
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750050218,
					"content": "정직한 사람은 그럴걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050219
					],
					"speakerTitle": "렉바"
				},
				{
					"id": 750050219,
					"content": "이봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750050220
					],
					"speakerTitle": "페이몬"
				}
			]
		},
