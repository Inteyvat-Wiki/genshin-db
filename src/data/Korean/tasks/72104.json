			"dialogs": [
				{
					"id": 721043801,
					"content": "겐도우 씨, 오늘 기분이 아주 좋아 보이네요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043802
					]
				},
				{
					"id": 721043802,
					"content": "응? 무슨 문제라도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043803
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721043803,
					"content": "평소랑 분위기가 좀 달라서요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043804
					]
				},
				{
					"id": 721043804,
					"content": "음, 그래? 신경 써야겠네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043805
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721043805,
					"content": "그건 아마 오늘 내가 「대길」을 뽑아서 그런 걸 거야! 기분이 아주 좋거든! 그리고 이 기분을 모두와 나누고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043806
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721043806,
					"content": "다만, 어떤 사람에겐 「대길」일 수도 있지만, 또 다른 누군가에겐 「대흉」일 수도 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043807
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721043807,
					"content": "「대흉」을 뽑은 사람에겐… 어떤 「점괘 걸이」가 그들을 기다리고 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043808
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721043808,
					"content": "운세라는 건 정말 재미있는 것 같아. 다음에 또 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "겐도우 링고"
				}
			]
		},
