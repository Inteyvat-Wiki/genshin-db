					"사라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708100201,
					"content": "몬드성의 특산품에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100202
					]
				},
				{
					"id": 708100202,
					"content": "몬드성의 특산품이요? 저희 가게의 모든 메뉴가 몬드의 특색 요리긴 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100203
					],
					"speakerTitle": "사라"
				},
				{
					"id": 708100203,
					"content": "오래 두면 안 돼서 먼 거리를 가지고 다닐 수 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100204
					],
					"speakerTitle": "사라"
				},
				{
					"id": 708100204,
					"content": "보관과 운송에 용이하도록 가공할 수는 있지만… 그러면 식감과 맛이 떨어질 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100205
					],
					"speakerTitle": "사라"
				},
				{
					"id": 708100205,
					"content": "괜찮아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100206
					]
				},
				{
					"id": 708100206,
					"content": "좋아요, 그렇게 원하신다면",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100207
					],
					"speakerTitle": "사라"
				},
				{
					"id": 708100207,
					"content": "근데 가게에 있는 음식은 만든 지 오래돼서 선물용이면 새로 만드는 게 좋겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100208
					],
					"speakerTitle": "사라"
				},
				{
					"id": 708100208,
					"content": "실례지만 그 친구분은 어디서 오셨나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100209,
						708100211
					],
					"speakerTitle": "사라"
				},
				{
					"id": 708100209,
					"content": "스네즈나야요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100210
					]
				},
				{
					"id": 708100210,
					"content": "스네즈나야? 엄청 먼 곳이네요. 무슨 요리를 할지 잘 생각해봐야겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "사라"
				},
				{
					"id": 708100213,
					"content": "음, 스네즈나야 사람들이 뭘 좋아하는진 모르지만, 그 메뉴라면 실패하지 않을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100214
					],
					"speakerTitle": "사라"
				},
				{
					"id": 708100214,
					"content": "「만족 샐러드」를 하나 만들어 주세요. 그럼 제가 가공해 드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100215
					],
					"speakerTitle": "사라"
				},
				{
					"id": 708100215,
					"content": "이런 작업을 하는 건 오랜만이라 도구를 찾아봐야겠어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사라"
				},
				{
					"id": 708100211,
					"content": "우인단이요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100212
					]
				},
				{
					"id": 708100212,
					"content": "우, 우인단이요? 스네즈나야에서 온 그… 발이 정말 넓네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "사라"
				}
			]
		},
