			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"베레나타",
					"페이몬"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2515.692,
							415.747,
							4528.094
						],
						"pointId": 4515
					},
					{
						"sceneId": 3,
						"position": [
							2515.588,
							415.68,
							4525.956
						],
						"pointId": 4563
					}
				]
			},
			"dialogs": [
				{
					"id": 740390801,
					"content": "여기, 여기가 바로 내 작업실이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390802
					],
					"speakerTitle": "베레나타"
				},
				{
					"id": 740390802,
					"content": "음, 그럼 이제 「진실 감지 물약」을 시험해 보자. 준비됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390803
					],
					"speakerTitle": "베레나타"
				},
				{
					"id": 740390803,
					"content": "준비됐어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390804
					]
				},
				{
					"id": 740390804,
					"content": "어… 조심해야 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390805
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740390805,
					"content": "베레나타에게 건네받은 물약에선 햇볕에 오랫동안 말린 썩은 해초 냄새가 난다. 그 때문에 속이 메스껍고 머리가 아파져 온다….\\n잠시 망설이다가 물약을 입 안에 털어 넣는다. 물약의 맛은 의외로 나쁘지 않다. 정확히는 느낄 수 있는 맛이란 게 존재하지 않는 것 같다….\\n그것 외에는 몸이 별다른 반응을 보이지 않는다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390806
					]
				},
				{
					"id": 740390806,
					"content": "베레나타의 지시에 따라 짧은 휴식을 취했지만 아무런 변화도 없다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390807
					]
				},
				{
					"id": 740390807,
					"content": "하지만 곧…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390808
					]
				},
				{
					"id": 740390808,
					"content": "딱히 변한 건 없는 것 같네…. 휴, 다행이다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390809
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740390809,
					"content": "#응, 근데… {NICKNAME}, 잠깐 멍 때린 것 같던데 뭔가 보인 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390810
					],
					"speakerTitle": "베레나타"
				},
				{
					"id": 740390810,
					"content": "…반 토막 난 반투명 배를 봤어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390811
					]
				},
				{
					"id": 740390811,
					"content": "뭐? 흥미로운데! 근데… 음… 더 자세한 정보는 없을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390812,
						740390815
					],
					"speakerTitle": "베레나타"
				},
				{
					"id": 740390812,
					"content": "거리가 너무 멀어서 자세히 못 봤어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390813
					]
				},
				{
					"id": 740390813,
					"content": "#재미있는걸! …하지만 약효를 증명할 순 없겠어…. {NICKNAME}이(가) 먼 곳의 바위나 배의 잔해를 「유령선」으로 착각한 걸지도 모르니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390814
					],
					"speakerTitle": "베레나타"
				},
				{
					"id": 740390814,
					"content": "그러니까… 휴, 이번 실험에서도 별 소득이 없었네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "베레나타"
				},
				{
					"id": 740390818,
					"content": "둘 다 고마워. 이번에 귀중한 데이터를 얻었어! 다음 물약을 만들 때 도움이 될 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390819
					],
					"speakerTitle": "베레나타"
				},
				{
					"id": 740390819,
					"content": "으음… 「비록 익숙한 이야기를 들었지만…」 좋아, 「다른 사람도 이런 현상을 겪었는지 계속 조사해 봐야겠어」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390820
					],
					"speakerTitle": "베레나타"
				},
				{
					"id": 740390820,
					"content": "어… 그러니까 다른 사람한테도 실험해 볼 거라는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390821
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740390821,
					"content": "응, 맞아. 왜냐하면… 음… 믿음직스러운 목격자가 두 명은 있어야 이 물약이 진짜로 「진실」을 보게 하는지 확인할 수 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390822
					],
					"speakerTitle": "베레나타"
				},
				{
					"id": 740390822,
					"content": "왜냐하면 「진실」이란 시야와 사고의 영향을 받거나 한 사람의 마음에 따라 왜곡되지 않고… 그냥 그곳에 그대로 존재하는 거니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390823
					],
					"speakerTitle": "베레나타"
				},
				{
					"id": 740390823,
					"content": "흠… 마치… 몇천 년은 산 신처럼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390824
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740390824,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390825
					],
					"speakerTitle": "베레나타"
				},
				{
					"id": 740390825,
					"content": "아니, 하얗고 고운 모래, 불가사리의 유해, 흔들리는 파도처럼… 그런 것들이 바로 「진실」이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390826
					],
					"speakerTitle": "베레나타"
				},
				{
					"id": 740390826,
					"content": "하지만 약제사님이 말씀하시길… 꿈과 추억으로도 새로운 「진실」을 창조할 수 있다고 하셨어. 모순되는 말이지만… 이해하려고 노력하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390827
					],
					"speakerTitle": "베레나타"
				},
				{
					"id": 740390827,
					"content": "우와… 주제가 갑자기 심오해졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390828
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740390828,
					"content": "하하, 그럼 심오한 얘기는 그만할게! 아무튼 도와줘서 고마워! 이걸 받아줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390829
					],
					"speakerTitle": "베레나타"
				},
				{
					"id": 740390829,
					"content": "음… 그리고, 다음 물약 테스트 때도 꼭 와줘야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베레나타"
				},
				{
					"id": 740390815,
					"content": "거대한 무언가에 의해 잘린 것처럼 보였어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390816
					]
				},
				{
					"id": 740390816,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390817
					],
					"speakerTitle": "베레나타"
				},
				{
					"id": 740390817,
					"content": "아, 미안! 방금… 딴생각 좀 했어. 하… 하지만 방금 정보는 베레나타가 다 기록했어. 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390818
					],
					"speakerTitle": "베레나타"
				}
			]
		},
