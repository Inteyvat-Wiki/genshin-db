	"talks": [
		{
			"id": 7601301,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7601301",
							"2"
						],
						"stepId": 7601301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"베르나츠카"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760130101,
					"content": "#아, 믿음직한 {NICKNAME}! 또 만났네! 역시, 이게 바로 달빛이 이어준 「운명」인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130102,
						760130106,
						760130141
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130102,
					"content": "처벌에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130103
					]
				},
				{
					"id": 760130103,
					"content": "후후, 라우마 님은 라헤타르 아줌마보다 훨씬 더 이성적이시더라고! 내가 사건이 일어난 이유를 설명해 드리니까 1분 정도 침묵하셨어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130104
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130104,
					"content": "그리고 나한테 서고에서 에른루트 씨의 문서 정리와 찬송가 필사를 맡기셨지. 내가 마음을 정리할 때까지는 나샤 마을에서 일하지 않아도 된대! 이것보다 더 좋은 보상이 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130105
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130105,
					"content": "#맞다! 그리고 요 며칠 동안 찬송가를 옮겨 적다 보니까 아일라 님이 하신 말씀이 무슨 뜻인지 이해하게 됐어! {NICKNAME}, 역시 넌 내 행운의 부적이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130106,
					"content": "지난번에 있었던 일에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130107
					]
				},
				{
					"id": 760130107,
					"content": "#응응! 뭘 물어보고 싶은 거야, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130108,
						760130137
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130108,
					"content": "아일라가 했던 말에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130109
					]
				},
				{
					"id": 760130109,
					"content": "후후! 좋은 질문이야! 아일라 님이 하신 말들은 언제 기록된 걸까? 또 그분이 말한 「독사」는 또 뭘까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130110
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130110,
					"content": "#며칠 동안 계속 생각해 봤는데, 이제 완전히 이해했어! {NICKNAME}, 아일라 님이 대화하던 상대가 「솔로베이」라고 했던 거 기억해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130111
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130111,
					"content": "그건 분명 등지기의 창시자, 스네즈나야 귀족 출신인 「솔로베이」 님이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130112
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130112,
					"content": "기록을 보면 아일라 님은 솔로베이의 요청으로 북쪽의 <color=#00E1FFFF>엠블라 기둥</color>에 가서 심연의 재앙을 잠재웠다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130113
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130113,
					"content": "「새로운 달의 여사자는 마치 그가 오리라는 것을 알고 있던 것처럼 어둠을 걷어낼 등불을 밝혔다」 음, 어쨌든 그를 도운 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130114
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130114,
					"content": "그러니까 아마 아일라 님이 말한 「독사」도 아마 심연을 비유한 거 아닐까? 어때, 완벽한 추리지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130115
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130115,
					"content": "#아일라 님이 말한 「로비아」는… 음, {NICKNAME}, 혹시 <color=#00E1FFFF>휘페르보레아</color>라는 이름 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130116,
						760130126
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130116,
					"content": "들어봤어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130117
					]
				},
				{
					"id": 760130117,
					"content": "#그렇구나, 역시 {NICKNAME}! 그럼 설명하기 쉽겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130118
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130118,
					"content": "「서리달 아이」는 휘페르보레아의 후예야. 500년 전까지——즉, 달의 {RUBY#[D]쿠타르}소녀가 태어나기 전까지는 휘페르보레아의 오래된 제사 의식이 이어져 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130119
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130119,
					"content": "「달을 읊는 사자」는 성녀 아일라 님이 처음 사용하셨던 호칭이야. 그전에는 제사를 주관하는 지도자를 「제사장」이라고 불렀어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130120
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130120,
					"content": "그리고 그 「로비아」는 아일라 님이 서리달 아이의 신앙을 개혁하기 전에 휘페르보레아의 유민들을 이끄는 마지막 「제사장」 이였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130121
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130121,
					"content": "당시 달의 {RUBY#[D]쿠타르}소녀는 아직 태어나지 않았고, 달빛의{RUBY#[S]달의 힘} 축복은 세월 속에서 점차 고갈되고 있었어. 그래서 그녀는 휘페르보레아의 오래된 의식을 유지하기 위해 신성을 모욕하는 죄를 저질렀지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130122
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130122,
					"content": "그녀는 기록이 말살됐기 때문에… 자세한 건 나도 잘 몰라. 하지만 그녀가 외부에 있는 나쁜 녀석들과 결탁해 수많은 무고한 사람들을 해쳤다는 건 알고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130123
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130123,
					"content": "아일라 님이 태어나기 전에 스네즈나야의 장교와 사랑에 빠진 신도가 몰래 도망쳤는데, 그녀가 사람을 보내서 그들을… 너무하지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130124
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130124,
					"content": "아일라 님은 그분의 손에서 「서리달 아이」를 이어받아 휘페르보레아의 의식을 폐지하고 정성을 다해 달빛을 숭배하라고 하셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130125
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130125,
					"content": "원칙적으로는 사제 이상의 신도만이 이 이름을 알 자격이 있지만… 넌 예외라고 생각해도 괜찮겠지? 응, 문제없을 거야! 아마도!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130126,
					"content": "잘 모르겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130127
					]
				},
				{
					"id": 760130127,
					"content": "좋아, 그럼 처음부터 얘기해줄게! 흠흠, 걱정 마. 난 믿음직한 사제이자 달의 질서를 부여받은… 음, 아무튼 난 제대로 설명해 줄 수 있어! 아마도!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130128
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130128,
					"content": "「휘페르보레아」는 이미 멸망한 고대 국가야. 우리 「서리달 아이」는 그 국가에서 이곳으로 옮겨온 유민의 후예지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130129
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130129,
					"content": "우리 조상들은 오래된 제사 의식을 많이 계승했어. 하지만 그 의식은 달빛의{RUBY#[S]달의 힘} 축복을 받아야만 효과가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130130
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130130,
					"content": "그 「로비아」는 아일라 님이 서리달 아이의 신앙을 개혁하기 전 서리달 아이를 이끌었던 악독한 대제사장이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130131
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130131,
					"content": "하지만 그때는 달의 {RUBY#[D]쿠타르}소녀가 아직 탄생하지 않았고, 달빛의{RUBY#[S]달의 힘} 축복도 매우 약했던 때라 대부분의 의식이 효과가 없었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130132
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130132,
					"content": "의식을 평소처럼 진행하기 위해, 그 악독한 대제사장은 셀 수 없이 많은 나쁜 짓을 저질렀어. 외부의 나쁜 세력과 손을 잡고 많은 사람들을 해쳤다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130133
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130133,
					"content": "정확하게 무슨 나쁜 짓을 했는지는 나도 잘 몰라. 그녀의 업적은 이미 역사에서 완전히 지워졌거든. 아무튼 아주 나쁜 사람이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130134
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130134,
					"content": "아일라 님이 태어나기 전에 스네즈나야의 장교와 사랑에 빠진 신도가 몰래 도망쳤는데, 그녀가 사람을 보내서 그들을… 너무하지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130135
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130135,
					"content": "훗날, 아일라 님이 그 악독한 대제사장에게서 「서리달 아이」를 이어받아, 고대의 의식을 폐지하고, 정성을 다해 달빛을 숭배라고 하셨대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130136
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130136,
					"content": "원칙적으로는 사제 이상의 신도만이 이 이름을 알 자격이 있지만… 넌 예외라고 생각해도 괜찮겠지? 응, 문제없을 거야! 아마도!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130137,
					"content": "그 검에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130138
					]
				},
				{
					"id": 760130138,
					"content": "아아, 걱정하지 마! 그 검에 관한 건 라우마 님에게 이미 말해뒀거든. 아일라 님이 너한테 준 거니까 편하게 사용해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130139
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130139,
					"content": "하지만——정말 너무 부러워! 전설에 따르면 아일라 님은 이 검으로 새로 태어난 달의 {RUBY#[D]쿠타르}소녀에게 첫 번째 은빛 피를 바치셨다고 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130140
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130140,
					"content": "#진정한 축복받은 순결한 검이야. 오직 순수한 자만이 사용할 수 있지… {NICKNAME}, 넌 신의 총애를 받은 사람이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130141,
					"content": "이만 가볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130142
					]
				},
				{
					"id": 760130142,
					"content": "#응응, 그럼 다음에 또 봐! 모험이 순조——크흠, 아니다. 달빛이 네 앞길을 비추기를, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르나츠카"
				}
			]
		},
		{
			"id": 7601302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7601301",
							"2"
						],
						"stepId": 7601301,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7609901",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"베르나츠카"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760130201,
					"content": "#아, 믿음직한 {NICKNAME}! 또 만났네! 역시, 이게 바로 달빛이 이어준 「운명」인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130202,
						760130206,
						760130240
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130202,
					"content": "처벌에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130203
					]
				},
				{
					"id": 760130203,
					"content": "후후, 라우마 님은 라헤타르 아줌마보다 훨씬 더 이성적이시더라고! 내가 사건이 일어난 이유를 설명해 드리니까 1분 정도 침묵하셨어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130204
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130204,
					"content": "그리고 나한테 서고에서 에른루트 씨의 문서 정리와 찬송가 필사를 맡기셨지. 내가 마음을 정리할 때까지는 나샤 마을에서 일하지 않아도 된대! 이것보다 더 좋은 보상이 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130205
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130205,
					"content": "#맞다! 그리고 요 며칠 동안 찬송가를 옮겨 적다 보니까 아일라 님이 하신 말씀이 무슨 뜻인지 이해하게 됐어! {NICKNAME}, 역시 넌 내 행운의 부적이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130206,
					"content": "지난번에 있었던 일에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130207
					]
				},
				{
					"id": 760130207,
					"content": "#응응! 뭘 물어보고 싶은 거야, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130208,
						760130236
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130208,
					"content": "아일라가 했던 말에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130209
					]
				},
				{
					"id": 760130209,
					"content": "후후! 좋은 질문이야! 아일라 님이 하신 말들은 언제 기록된 걸까? 또 그분이 말한 「독사」는 또 뭘까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130210
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130210,
					"content": "#며칠 동안 계속 생각해 봤는데, 이제 완전히 이해했어! {NICKNAME}, 아일라 님이 대화하던 상대가 「솔로베이」라고 했던 거 기억해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130211
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130211,
					"content": "그건 분명 등지기의 창시자, 스네즈나야 귀족 출신인 「솔로베이」 님이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130212
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130212,
					"content": "기록을 보면 아일라 님은 솔로베이의 요청으로 북쪽의 <color=#00E1FFFF>엠블라 기둥</color>에 가서 심연의 재앙을 잠재웠다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130213
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130213,
					"content": "「새로운 달의 여사자는 마치 그가 오리라는 것을 알고 있던 것처럼 어둠을 걷어낼 등불을 밝혔다」 음, 어쨌든 그를 도운 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130214
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130214,
					"content": "#아일라 님이 말한 「로비아」는… 음, {NICKNAME}, 혹시 <color=#00E1FFFF>휘페르보레아</color>라는 이름 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130215,
						760130225
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130215,
					"content": "들어봤어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130216
					]
				},
				{
					"id": 760130216,
					"content": "#그렇구나, 역시 {NICKNAME}! 그럼 설명하기 쉽겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130217
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130217,
					"content": "「서리달 아이」는 휘페르보레아의 후예야. 500년 전까지——즉, 달의 {RUBY#[D]쿠타르}소녀가 태어나기 전까지는 휘페르보레아의 오래된 제사 의식이 이어져 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130218
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130218,
					"content": "「달을 읊는 사자」는 성녀 아일라 님이 처음 사용하셨던 호칭이야. 그전에는 제사를 주관하는 지도자를 「제사장」이라고 불렀어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130219
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130219,
					"content": "그리고 그 「로비아」는 아일라 님이 서리달 아이의 신앙을 개혁하기 전에 휘페르보레아의 유민들을 이끄는 마지막 「제사장」 이였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130220
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130220,
					"content": "당시 달의 {RUBY#[D]쿠타르}소녀는 아직 태어나지 않았고, 달빛의{RUBY#[S]달의 힘} 축복은 세월 속에서 점차 고갈되고 있었어. 그래서 그녀는 휘페르보레아의 오래된 의식을 유지하기 위해 신성을 모욕하는 죄를 저질렀지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130221
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130221,
					"content": "그녀는 기록이 말살됐기 때문에… 자세한 건 나도 잘 몰라. 하지만 그녀가 외부에 있는 나쁜 녀석들과 결탁해 수많은 무고한 사람들을 해쳤다는 건 알고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130222
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130222,
					"content": "아일라 님이 태어나기 전에 스네즈나야의 장교와 사랑에 빠진 신도가 몰래 도망쳤는데, 그녀가 사람을 보내서 그들을… 너무하지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130223
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130223,
					"content": "아일라 님은 그분의 손에서 「서리달 아이」를 이어받아 휘페르보레아의 의식을 폐지하고 정성을 다해 달빛을 숭배하라고 하셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130224
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130224,
					"content": "원칙적으로는 사제 이상의 신도만이 이 이름을 알 자격이 있지만… 넌 예외라고 생각해도 괜찮겠지? 응, 문제없을 거야! 아마도!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130225,
					"content": "잘 모르겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130226
					]
				},
				{
					"id": 760130226,
					"content": "좋아, 그럼 처음부터 얘기해줄게! 흠흠, 걱정 마. 난 믿음직한 사제이자 달의 질서를 부여받은… 음, 아무튼 난 제대로 설명해 줄 수 있어! 아마도!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130227
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130227,
					"content": "「휘페르보레아」는 이미 멸망한 고대 국가야. 우리 「서리달 아이」는 그 국가에서 이곳으로 옮겨온 유민의 후예지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130228
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130228,
					"content": "우리 조상들은 오래된 제사 의식을 많이 계승했어. 하지만 그 의식은 달빛의{RUBY#[S]달의 힘} 축복을 받아야만 효과가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130229
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130229,
					"content": "그 「로비아」는 아일라 님이 서리달 아이의 신앙을 개혁하기 전 서리달 아이를 이끌었던 악독한 대제사장이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130230
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130230,
					"content": "하지만 그때는 달의 {RUBY#[D]쿠타르}소녀가 아직 탄생하지 않았고, 달빛의{RUBY#[S]달의 힘} 축복도 매우 약했던 때라 대부분의 의식이 효과가 없었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130231
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130231,
					"content": "의식을 평소처럼 진행하기 위해, 그 악독한 대제사장은 셀 수 없이 많은 나쁜 짓을 저질렀어. 외부의 나쁜 세력과 손을 잡고 많은 사람들을 해쳤다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130232
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130232,
					"content": "정확하게 무슨 나쁜 짓을 했는지는 나도 잘 몰라. 그녀의 업적은 이미 역사에서 완전히 지워졌거든. 아무튼 아주 나쁜 사람이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130233
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130233,
					"content": "아일라 님이 태어나기 전에 스네즈나야의 장교와 사랑에 빠진 신도가 몰래 도망쳤는데, 그녀가 사람을 보내서 그들을… 너무하지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130234
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130234,
					"content": "훗날, 아일라 님이 그 악독한 대제사장에게서 「서리달 아이」를 이어받아, 고대의 의식을 폐지하고, 정성을 다해 달빛을 숭배라고 하셨대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130235
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130235,
					"content": "원칙적으로는 사제 이상의 신도만이 이 이름을 알 자격이 있지만… 넌 예외라고 생각해도 괜찮겠지? 응, 문제없을 거야! 아마도!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130236,
					"content": "그 검에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130237
					]
				},
				{
					"id": 760130237,
					"content": "아아, 걱정하지 마! 그 검에 관한 건 라우마 님에게 이미 말해뒀거든. 아일라 님이 너한테 준 거니까 편하게 사용해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130238
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130238,
					"content": "하지만——정말 너무 부러워! 전설에 따르면 아일라 님은 이 검으로 새로 태어난 달의 {RUBY#[D]쿠타르}소녀에게 첫 번째 은빛 피를 바치셨다고 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760130239
					],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130239,
					"content": "#진정한 축복받은 순결한 검이야. 오직 순수한 자만이 사용할 수 있지… {NICKNAME}, 넌 신의 총애를 받은 사람이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르나츠카"
				},
				{
					"id": 760130240,
					"content": "이만 가볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760130241
					]
				},
				{
					"id": 760130241,
					"content": "#응응, 그럼 다음에 또 봐! 모험이 순조——크흠, 아니다. 달빛이 네 앞길을 비추기를, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르나츠카"
				}
			]
		}
	]
}