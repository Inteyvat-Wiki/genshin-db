			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"빅토리아"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030301,
					"content": "또 무슨 일이니? 바바라 님을 만나러 온 거라면 아직 돌아오지 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030302,
						190030303
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030302,
					"content": "울프 영지에서 바바라를 찾았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				},
				{
					"id": 190030304,
					"content": "그렇구나… 무사하셔서 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030305
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030305,
					"content": "그럼 한동안은 못 오시겠구나. 성당 일을 부탁할 사람을 찾아봐야겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030306
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030306,
					"content": "제가 도와드릴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030307
					]
				},
				{
					"id": 190030307,
					"content": "그래주면 정말 다행이지. 미안해, 귀찮은 일을 떠맡겨서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030308
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030308,
					"content": "흐음… 그럼 가서 성당 주변을 좀 청소해줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030309
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030309,
					"content": "성당 주변은 오가는 사람이 많아서 바닥이 항상 지저분하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030310
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030310,
					"content": "원래 바바라 부제님 혼자서 하시던 일인데, 자리를 비우시니 바로 더러워지더라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030311
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030311,
					"content": "이 넓은 곳을 바바라 혼자 청소한다구요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030312
					]
				},
				{
					"id": 190030312,
					"content": "응. 혼자서도 문제없다면서 아무도 못 돕게 하셔",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030313
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030313,
					"content": "근데 매번 청소가 끝날 때마다 엄청 지쳐 보이더라니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030314
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030314,
					"content": "그래서 바바라 부제님이 너한테 도와달라고 했다는 게, 좀 의외야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030315
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030315,
					"content": "이러면 그분의 부담도 좀 줄겠지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030316
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030316,
					"content": "어쨌든 청소는 너한테 맡길게, 「명예 기사」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030303,
					"content": "바바라는 터너 씨를 살펴보러 다운 와이너리에 갔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				}
			]
		},
