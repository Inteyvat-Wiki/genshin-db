			"dialogs": [
				{
					"id": 190030601,
					"content": "응? 이번엔 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030602
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030602,
					"content": "바바라의 휴가에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030603
					]
				},
				{
					"id": 190030603,
					"content": "아아, 맞아. 아까 바바라 님이 친구와 약속이 있다면서 반나절 휴가를 내셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030604
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030604,
					"content": "정말 의외야…. 바바라 님이 친구 때문에 일부러 휴가도 내시고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030605
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030605,
					"content": "아무튼, 그래서 나한테 무슨 볼일 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030606
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030606,
					"content": "「위대하고 몽환적인 센티멘털한 산호 스파클링 티」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030607
					]
				},
				{
					"id": 190030607,
					"content": "뭐? 바바라 님이 너랑 같이… 그 특별 음료를 사러 가기로 했다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030608
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030608,
					"content": "바바라 님이 말한 친구가 바로 너였어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030609
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030609,
					"content": "뭐… 너 같은 「명예 기사」라면 이상할 것도 없지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030610
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030610,
					"content": "대충 상황은 알겠어. 그럼 바바라 부제님을 잘 부탁해, 「명예 기사」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030611
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030611,
					"content": "왜 바바라는 휴가인데도 일정을 보고해야 되죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030612
					]
				},
				{
					"id": 190030612,
					"content": "그건… 너도 알다시피, 바바라 부제님은 몬드성에서 아주 인기가 많잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030613
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030613,
					"content": "다들 호의로 그러는 거긴 하지만, 그 수가 너무 많다 보니 바바라 님도 가끔 감당이 안 되는 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030614
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030614,
					"content": "근무 중엔 성당 사람들이 바로바로 도와줄 수 있지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030615
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030615,
					"content": "휴가 중엔… 바바라 님 혼자 헤쳐나가야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030616
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030616,
					"content": "근데 또 너무 착하셔서… 항상 근무일보다 더 힘들 정도로 주민들의 요청을 들어주시지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030617
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030617,
					"content": "그래서 휴가 일정을 보고해달라고 한 거야. 도움이 필요할 때 우리가 언제든 달려가 줄 수 있게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030618
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190030618,
					"content": "바바라 님이 너무 무리하지 않았으면 좋겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "빅토리아"
				}
			]
		},
