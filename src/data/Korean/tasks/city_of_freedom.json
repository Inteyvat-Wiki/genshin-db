					"엠버"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3560401,
					"content": "자, 아까 말한 선물은 바로——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560402
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3560402,
					"content": "<color=#00E1FFFF>바람의 날개</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560403
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3560403,
					"content": "정찰 기사들은 이걸 이용해 공중에서 이동해. 몬드의 시민들도 즐겨 사용하지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560404
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3560404,
					"content": "한시라도 빨리 좋은 점을 느껴보라고 널 여기로 불렀어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560405
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3560405,
					"content": "엄청 강추하는 분위긴데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3560406,
					"content": "「바람」은 몬드의 소울이니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560407
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3560407,
					"content": "이제 바람의 날개의 성능을 확인해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560408
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3560408,
					"content": "사용법이 쉽긴 해도 반드시 내 지시를 따라야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				}
			]
		}
	]
