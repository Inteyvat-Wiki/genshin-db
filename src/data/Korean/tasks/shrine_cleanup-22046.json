			},
			"dialogs": [
				{
					"id": 220460101,
					"content": "신사가 또 어지럽혀졌네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460102
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220460102,
					"content": "왜 그래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460103
					]
				},
				{
					"id": 220460103,
					"content": "음냥, 자네들이군, 마침 잘 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460104
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220460104,
					"content": "한동안 청소를 안 했더니, 신사의 주변에 더러운 게 잔뜩 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460105
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220460105,
					"content": "이 상태로는 신사에 참배하러 오는 인간들을 맞을 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460106
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220460106,
					"content": "자네들, 저번처럼 나를 도와 신사를 치워주겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460107,
						220460112
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220460107,
					"content": "타이유 씨와 에츠코 씨가 있지 않아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460108
					]
				},
				{
					"id": 220460108,
					"content": "이 몸이 직접 그 초록 초록한 인간들에게 말을 걸 순 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460109
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220460109,
					"content": "그 커다란 인간, 나를 보는 눈빛이 항상 이상하단 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460110
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220460110,
					"content": "또 다른 초록 초록한 인간도, 매일 맥 빠지는 얼굴을 하고 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460111
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220460111,
					"content": "야옹, 어떻게 생각해도 두 인간 다 믿음이 안 간단 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220460115,
					"content": "아무튼, 자네들한테 부탁을 좀 해야겠어. 저번과 같이, 길쭉한 막대기와 물로 「청소」해 줘, 자네들 알아들었지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460116,
						220460117
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220460116,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460118,
					"content": "아무튼, 이번 일은 자네들에게 맡길 테니, 나는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460119
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220460119,
					"content": "나는 여기서 자네들을 기다리지, 야옹",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220460117,
					"content": "대충 알겠어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460118
					]
				},
				{
					"id": 220460112,
					"content": "오오시마 씨에게 부탁하는 건…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460113
					]
				},
				{
					"id": 220460113,
					"content": "그 바위 인간은 계속 바빠, 뚱땅뚱땅 뭘 그리 두드리는 건지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460114
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220460114,
					"content": "이미 돌멩이는 두드려져 있는 건데, 도대체 왜 계속 뚱땅거리는 거야, 짜증 나게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460115
					],
					"speakerTitle": "「네코」"
				}
			]
		},
