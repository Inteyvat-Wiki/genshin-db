			"dialogs": [
				{
					"id": 220460301,
					"content": "오오, 자네들 이미 「청소」를 끝낸 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460302
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220460302,
					"content": "다 했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220460303
					]
				},
				{
					"id": 220460303,
					"content": "야옹, 그럼 됐어, 역시 자네들은 믿음직스럽군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460304
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220460304,
					"content": "신사도 꽤 그럴싸해졌다네. 히비키가 돌아오면, 분명 기뻐하겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220460305
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220460305,
					"content": "반드시 신사를 잘 정돈해 두어야 해… 야옹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「네코」"
