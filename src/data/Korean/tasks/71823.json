				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230901,
					"content": "왔구나! 약재는 다 따 왔니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230902
					],
					"speakerTitle": "지아"
				},
				{
					"id": 718230902,
					"content": "다 따 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230903
					]
				},
				{
					"id": 718230903,
					"content": "도와줘서 고마워. 나도 소백이한테 약재 좀 처리해달라고 했어. 이것들도 방앗간으로 가져가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "지아"
				}
			]
		},
		{
			"id": 7182310,
			"completionStepIds": [
				7182310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182310",
							"2"
						],
						"stepId": 7182310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"소백"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718231001,
					"content": "…흠, 이 약재도 같이 처리하면 되는 거지? 다 처리하면 너도 빨리 약을 만들 수 있을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231002
					],
					"speakerTitle": "소백"
				},
				{
					"id": 718231002,
					"content": "응, 고마워! 난 약을 어떻게 하면 달게 만들 수 있는지 생각 좀 해봐야겠어. 아니면 애들이 또 안 먹으려고 하겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231003
					],
					"speakerTitle": "지아"
				},
				{
					"id": 718231003,
					"content": "매년 이맘때면 항상 이렇게 바쁘신가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231004
					]
				},
				{
					"id": 718231004,
					"content": "네… 거의 그렇죠. 경책 산장엔 젊은이들이 몇 안 되잖아요. 저희가 도울 수 있는 일은 최대한 도와야죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231005
					],
					"speakerTitle": "소백"
				},
				{
					"id": 718231005,
					"content": "사실 이맘때 바짝 바쁜 거라 괜찮아. 게다가 올해는 네가 도와준 덕분에 우리도 아주 수월했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231006
					],
					"speakerTitle": "지아"
				},
				{
					"id": 718231006,
					"content": "몇 년 전까지만 해도 약초 캐는 데만 며칠이 걸렸거든. 약 만드는 건 말할 것도 없지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231007
					],
					"speakerTitle": "지아"
				},
				{
					"id": 718231007,
					"content": "암튼 도와줘서 고마워. 우리도 빨리 약재를 처리하고 소등을 준비하러 가봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231008
					],
					"speakerTitle": "지아"
				},
				{
					"id": 718231008,
					"content": "작년엔 소등 날리는 걸 잊을뻔했으니까 올해는 잊지 말아야지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231009
					],
					"speakerTitle": "지아"
				},
				{
					"id": 718231009,
					"content": "소원이 뭔데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231010
					]
				},
				{
					"id": 718231010,
					"content": "음… 경책 산장 사람들이 다 건강한 거? 헤헤 뭐 그런 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231011
					],
					"speakerTitle": "지아"
				},
				{
					"id": 718231011,
					"content": "근데 소원은 말하면 안 이뤄진다잖아. 자세한 건 말 안 할래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231012
					],
					"speakerTitle": "지아"
				},
				{
					"id": 718231012,
					"content": "이거 줄게. 오늘 정말 고마웠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "지아"
				}
			]
		},
