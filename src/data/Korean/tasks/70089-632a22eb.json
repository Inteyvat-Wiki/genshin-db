			"dialogs": [
				{
					"id": 700890101,
					"content": "어라, 여기에 왜 사람이 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700890102,
					"content": "이 바람 신의 신상도 아닌데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890103
					],
					"speakerTitle": "「마우키」"
				},
				{
					"id": 700890103,
					"content": "이봐, 뭐 하고 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700890104,
					"content": "돌아가는 길을 찾고 있어요. 바람 신의 신상을 찾아야 한다는 것까지는 기억나는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890105
					],
					"speakerTitle": "「마우키」"
				},
				{
					"id": 700890105,
					"content": "다른 건 전혀 기억이 안 나요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890106
					],
					"speakerTitle": "「마우키」"
				},
				{
					"id": 700890106,
					"content": "돌아가는 길?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700890107,
					"content": "고향으로 돌아가고 싶은 마음은 들지만, 아무것도 기억나지 않아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890108
					],
					"speakerTitle": "「마우키」"
				},
				{
					"id": 700890108,
					"content": "눈을 떴을 때 손에는 쪽지 하나만 있었고, 거기엔 「너는 『마우키』다」라고 적혀 있었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890109
					],
					"speakerTitle": "「마우키」"
				},
				{
					"id": 700890109,
					"content": "그래서 제 이름은 아마 「마우키」일 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890110
					],
					"speakerTitle": "「마우키」"
				},
				{
					"id": 700890110,
					"content": "그럼 전 이만 가볼게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890111
					],
					"speakerTitle": "「마우키」"
				},
				{
					"id": 700890111,
					"content": "참 이상한 사람이네. 그래도 나쁜 사람 같지는 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700890112,
					"content": "왜 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700890113,
					"content": "이상한 장면을 봤어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700890114
					]
				},
				{
					"id": 700890114,
					"content": "이상한 장면? 설마 아까 그 사람이 신상을 만져서 그런 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
