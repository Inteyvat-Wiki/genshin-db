						250190702
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250190702,
					"content": "야옹",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190703
					],
					"speakerTitle": "그로벨"
				},
				{
					"id": 250190703,
					"content": "죄송합니다, 회장님. 에스테와 메이콘턴 형제의 답장이 아직 오지 않았어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190704
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250190704,
					"content": "젠장… 대체 마을에 무슨 일이 생긴 거야… 지금 당장 돌아갈 수도 없고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190705
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250190705,
					"content": "당신은 나타 사람처럼 보이지 않네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250190706
					]
				},
				{
					"id": 250190706,
					"content": "너도 이곳 사람으로 보이지 않는걸. 안녕, 난 그리스판이야. 폰타인 공상 클럽의 회원이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190707
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250190707,
					"content": "이쪽은 우리 클럽의 회장… 부장? 음, 아무튼 우리 클럽의 수장인 그로벨 씨야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "그리스판"
				}
			]
