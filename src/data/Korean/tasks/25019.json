				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"그리스판"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250190201,
					"content": "야옹, 야옹야옹야옹, 야옹야옹야옹, 야옹",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190202
					],
					"speakerTitle": "그로벨"
				},
				{
					"id": 250190202,
					"content": "알겠습니다, 회장님. 간단하게 설명할게요… 그러니까 부디 제 입방정을 용서해주세요. 이 떠드는 입을 관리할 방법이 있었다면 좋았을 텐데 말이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190203
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250190203,
					"content": "#쉽게 말해 {NICKNAME}, 「열소」가 있는 물건을 수집해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190204
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250190204,
					"content": "어디 보자… 음, 난 지금까지 「촛불 버섯」에서 열소를 추출했거든, 우선 「촛불 버섯」을 가져다줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190206
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250190206,
					"content": "그런데 「잿불꽃」에도 열소가 많다고 들었어… 잿불꽃을 나한테 가져다줘도 좋을 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190205
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250190205,
					"content": "충분한 열소만 있으면, 여기서 바로 연구를 시작할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190206
					],
					"speakerTitle": "그리스판"
				}
			]
		},
		{
