				]
			},
			"dialogs": [
				{
					"id": 250191301,
					"content": "#{NICKNAME}, 또 만났네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191302
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250191302,
					"content": "저번에 네가 도와준 덕분에 연구에 큰 진전이 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191303
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250191303,
					"content": "이대로라면 곧 목표를 달성할 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191304,
						250191315
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250191304,
					"content": "목표가 뭔데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250191305
					]
				},
				{
					"id": 250191305,
					"content": "말하지 않았다고? 맙소사, 내 정신머리 좀 봐. 지금 간단하게 소개해줄게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191306
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250191306,
					"content": "야옹! 야옹야옹야옹야옹!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191307
					],
					"speakerTitle": "그로벨"
				},
				{
					"id": 250191307,
					"content": "크흠, 네, 회장님. 아주 간단하게 설명하겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191308
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250191308,
					"content": "간단히 말하자면, 난 「열에너지」로 「최면」을 걸려고 열소를 모으는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191309
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250191309,
					"content": "최면 장치를 갖고 오지 않아서 보여줄 순 없지만… 아무튼 사람이 앉을 수 있을 만한 크기의 상자라고 생각하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191310
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250191310,
					"content": "그 상자 안에 있는 증기 장치가 계속해서 열기를 생성해 상자를 특정 온도로 유지하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191311
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250191311,
					"content": "상자 속에서 머리만 내민 사람을 가열하는 방식으로… 더 빠르고 효과적으로 최면을 걸 수 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191312
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250191312,
					"content": "그건 그냥 열로 사람을 기절시키는 거잖아요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250191313
					]
				},
				{
					"id": 250191313,
					"content": "네 말도 맞긴 하는데, 「기절」에 대한 우리의 정의는 조금 다른 것 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191314
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250191314,
					"content": "하지만 그런 사소한 건 일단 내려두자고, 나한텐 네 도움이 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191317
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250191317,
					"content": "전과 마찬가지로 「열소」가 있는 물건을 수집해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191318
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250191318,
					"content": "어디 보자… 음, 「잿불꽃」을 좀 가져다줄래? 이 식물에는 열소가 많이 함유되어 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191319
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250191319,
					"content": "물론 「촛불 버섯」도 여전히 내 중요한 실험 재료야, 이거 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250191315,
					"content": "이번엔 또 뭘 부탁하실 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250191316
					]
				},
				{
					"id": 250191316,
					"content": "눈치가 빠르네! 역시 같이 일하기 좋은 착한 사람이라니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250191317
					],
					"speakerTitle": "그리스판"
				}
			]
		},
