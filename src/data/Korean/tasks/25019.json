				]
			},
			"dialogs": [
				{
					"id": 250190101,
					"content": "이건… 잿불꽃이네. 좋아, 좋아, 아주 유용하겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190102
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250190102,
					"content": "야옹야옹? 야옹?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190103
					],
					"speakerTitle": "그로벨"
				},
				{
					"id": 250190103,
					"content": "회장님, 이 꽃은 폰타인에서 기를 수 없을 거 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190104
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250190104,
					"content": "굳이 원하신다면… 음, 그냥 책갈피로 만드는 건 어떨까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "그리스판"
				}
			]
		},
		{
			"id": 2501902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
