					"그리스판"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250190301,
					"content": "같이 찾아보죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250190302
					]
				},
				{
					"id": 250190302,
					"content": "같이? 그럼 더 좋고! 난 늘 현장 조사를 하고 싶었는데, 네가 옆에 있어준다면 겁낼 거 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190303
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250190303,
					"content": "#자, 가자고. 친애하는 {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190304
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250190304,
					"content": "#회장님은… 여기 남아주세요. {NICKNAME}(이)가 있으니까 전 무조건 안전할 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190305
					],
					"speakerTitle": "그리스판"
				},
				{
					"id": 250190305,
					"content": "야옹… 야아옹… 야옹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250190306
					],
					"speakerTitle": "그로벨"
				},
				{
					"id": 250190306,
					"content": "아… 잊을 뻔했네. 조사할 장소를 지도에 표시해 줄게. 그쪽에 있는 촛불 버섯은 정말 훌륭하더라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "그리스판"
				}
			]
		},
