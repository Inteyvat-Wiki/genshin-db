			"dialogs": [
				{
					"id": 20200501,
					"content": "네가 졌어, 에이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200502
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200502,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200503
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200503,
					"content": "…그래, 내가 졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200504
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200504,
					"content": "왜 네 백성과 그들의 염원의 힘을 믿지 못하는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200505
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200505,
					"content": "그 염원들은 거리도, 공간도, 시간도 초월했어. 아무도 억누를 수 없는 것이 돼버렸다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200506,
						20200507,
						20200508
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200506,
					"content": "사람들이 전력을 다해 나아갈 때…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200509,
					"content": "리월에서 얻은 깨달음인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200510
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200510,
					"content": "맞아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200511
					]
				},
				{
					"id": 20200511,
					"content": "신을 뒤로 제쳐두고 인간은 앞으로 나아가는 나라라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200512
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200512,
					"content": "그럼 우리는 왜 멋대로… 나아가기를 포기하는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200513
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200513,
					"content": "…나아감으로써 잃은 것들을, 너와 내가 함께 목격했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200514
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200514,
					"content": "영원함, 오직 영원함만이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200515
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200515,
					"content": "천리… 내겐 도통 알 수 없는 것이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200516
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200516,
					"content": "어쨌든 네가 사랑하는 이나즈마를 영원히 지키고 싶을 뿐이란 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200517
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200517,
					"content": "그렇게 가볍게 말할 수 있는 게 아냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200518
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200518,
					"content": "이 나라가 영원히 존재할 가치가 있긴 해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200519
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200519,
					"content": "염원도, 변화도 잃고 존재하기만 하는 나라는 빈 껍데기에 불과해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200520
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200520,
					"content": "하, 그럼 파멸돼도 무방한 거 아닌가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200521
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200521,
					"content": "미코, 방금 그 망언 취소해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200522
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200522,
					"content": "천년만년 변하지 않는 영원은 내가 백성들에게 약속한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200523
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200523,
					"content": "하지만 네 백성이 원하는 건 네 약속이 아니라 너의 「주목」이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200524
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200524,
					"content": "…신의 눈?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200525
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200525,
					"content": "인간의 수명은 고작 100년. 그들은 그런 상실을 감당할 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200526
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200526,
					"content": "모든 걸 겪은 내가 그들을 올바른 「영원함」으로 인도할 수 있다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200527
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200527,
					"content": "휴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200528
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200528,
					"content": "…그렇지만 「영원함」은 너에게 너무 가혹하잖아, 에이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200529
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200529,
					"content": "나에게?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200530
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200530,
					"content": "넌 더 이상 인간뿐만 아니라, 너 자신도 주목하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200531
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200531,
					"content": "수백 년 동안 홀로 이곳에 있었으니 얼마나 외로웠겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200532
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200532,
					"content": "그건 어쩔 수 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200533
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200533,
					"content": "나아가지 않아도 많은 걸 놓치게 돼 있어… 여기서 영원할 때까지 멈춰있는 너도 잃어가고 있잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200534
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200534,
					"content": "이미 고독을 견디고 있으면서도 영원을 위해 그 고독의 시간을 무한대로 늘려가다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200535
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200535,
					"content": "말해봐, 캄캄하던 이곳의 하늘이… 왜 하필이면 이 순간에 빛났을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200536
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200536,
					"content": "여기는 너의 「일심정토」이고, 네 내면세계야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200537
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200537,
					"content": "사실은… 날 다시 봐서 기쁜 거지? 오래전부터 이곳의 고독을 견딜 수 없었던 거잖아, 안 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200538
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200538,
					"content": "난… 할 말이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200539
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200539,
					"content": "후후, 난 할 말이 아주 많은데? 그래, 지난 수백 년간 일어난 일을 들려줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200540
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200540,
					"content": "수백 년의 일을 얼마나 오랫동안 얘기하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200541
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200541,
					"content": "여우 신선이 기억력 하나는 끝내주잖아. 수백 년간 일어난 일을 아주 디테일하게 기억하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200542
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200542,
					"content": "다 얘기하려면 아마 수백 년은 걸릴 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200543
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200543,
					"content": "하… 하하… 미코, 다시는 너와 이렇게 만날 수 없을 줄 알았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200544
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200544,
					"content": "널 만난 건 영원함의 변수이자… 서프라이즈야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200545
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200545,
					"content": "후후, 솔직하게 인정했으니 계속 친구 해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200546
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200546,
					"content": "세상 유치한 대화네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200547
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200547,
					"content": "어쨌든 내가 졌으니, 너희의 뜻에 따라 안수령을 폐지할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200548
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200548,
					"content": "단, 「영원함」에 대해, 그리고 이 나라가 나아가야 할지는 더 고려해볼 필요가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200549
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 20200549,
					"content": "후후, 끝까지 유치한 건 너라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20200507,
					"content": "신의 예상을 뛰어넘곤 하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200508,
					"content": "신의 일을 대신하기도 해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				}
			]
