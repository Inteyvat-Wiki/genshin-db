						"pointId": 10443
					},
					{
						"sceneId": 3,
						"position": [
							2407.146,
							343.151,
							2391.287
						],
						"pointId": 10444
					}
				]
			},
			"dialogs": [
				{
					"id": 401870301,
					"content": "더 대단한 인물이라면, 나는 바람각을 읽는 영관을 택할래. 어쨌든 기문산술의 시조니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870302
					],
					"speakerTitle": "중운"
				},
				{
					"id": 401870302,
					"content": "응! 나도 내 선조님께 한 표 드릴래. 거기에 현조 선인도!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870303
					],
					"speakerTitle": "남연"
				},
				{
					"id": 401870303,
					"content": "그럼 나는 연산 이 현자를 택할래. 세외의 고수들은 항상 깊이 은거하는 법이지, 소설에는 다 그렇게 나오잖아. 안 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870304
					],
					"speakerTitle": "가명"
				},
				{
					"id": 401870304,
					"content": "만약 무협 소설이었다면, 나도 그랬을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870305
					],
					"speakerTitle": "행추"
				},
				{
					"id": 401870305,
					"content": "하지만 공교롭게도, 난 《죽림월야》를 읽어 봤거든. 내 생각에 가장 강한 자는 도도 삼 선인의 백마 선인이야. 그녀에겐 분명 비밀이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870306
					],
					"speakerTitle": "행추"
				},
				{
					"id": 401870306,
					"content": "어? 운래 낚시 노인은 아무도 안 고른 거야? 각청도 자기 검법이 운래 낚시 노인의 낚시 자세에서 유래했다고 하던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870307
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870307,
					"content": "그렇다고는 해도… 등장 분량이 좀 작지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870308
					],
					"speakerTitle": "가명"
				},
				{
					"id": 401870308,
					"content": "음… 하지만 낚시의 대가인 건 확실해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870309
					],
					"speakerTitle": "행추"
				},
				{
					"id": 401870309,
					"content": "헤헹, 다들 틀렸어! 가장 대단한 건 당연히 무망 어르신과 저승 나비 선인이지! 그들이 없었다면 오늘날의 왕생당도 없었다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870310
					],
					"speakerTitle": "호두"
				},
				{
					"id": 401870310,
					"content": "확실히 그것도 일리 있는 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870311
					],
					"speakerTitle": "중운"
				},
				{
					"id": 401870311,
					"content": "이야, 다들 이미 와 있었구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870312,
					"content": "#{NICKNAME}, 페이몬, 드디어 왔구나. 어서 와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870313
					],
					"speakerTitle": "호두"
				},
				{
					"id": 401870313,
					"content": "어? 호두, 너 모자가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870314,
					"content": "페이몬이 이번에는 눈썰미가 있는걸. 맞아, 매화 가지를 하나 더 만들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870315
					],
					"speakerTitle": "호두"
				},
				{
					"id": 401870315,
					"content": "#오~ 그럼 너 거랑 {NICKNAME} 거랑 한 쌍이 됐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870316,
					"content": "그건 그렇고, 너희는 여기서 뭐 해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870317,
					"content": "팔기 중 누가 더 강한지 얘기 중이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870318
					],
					"speakerTitle": "남연"
				},
				{
					"id": 401870318,
					"content": "하하하, 그냥 서로 자기가 하고 싶은 말을 할 뿐이지, 뭐. 결론은 안 날걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870319
					],
					"speakerTitle": "가명"
				},
				{
					"id": 401870319,
					"content": "음, 우리한테 라이트 노벨에 나오는 그런 안경이라도 있으면, 그걸로 모두의 전투력을 확인할 수 있을 텐데 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870320
					],
					"speakerTitle": "중운"
				},
				{
					"id": 401870320,
					"content": "하하, 중운 너 행추한테 라이트 노벨 배웠구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870321
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870321,
					"content": "#{NICKNAME}, 어서 와. 가족들한테 들었어, 너랑 호두가 무척 위험한 제례를 마쳐서 증조부의 병이 나은 거라더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870322
					],
					"speakerTitle": "행추"
				},
				{
					"id": 401870322,
					"content": "정말 큰 은혜를 입었어. 앞으로는 뭐든 문제가 생기면 우리 비운 상회를 찾아줘, 늘 환영할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870323
					],
					"speakerTitle": "행추"
				},
				{
					"id": 401870323,
					"content": "다 같이 힘내서 해낸 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870324
					]
				},
				{
					"id": 401870324,
					"content": "응, 알고 있어. 아버지와 형님도 조만간 한 명씩 찾아가 감사 인사를 하시겠대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870325
					],
					"speakerTitle": "행추"
				},
				{
					"id": 401870325,
					"content": "고마워할 게 뭐 있어. 행추, 아니면 그냥 얌전히 무망 어르신과 저승 나비 선인이 가장 대단하다고 인정하는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870326
					],
					"speakerTitle": "호두"
				},
				{
					"id": 401870326,
					"content": "어휴, 결론도 안 나는 얘기는 그만하고! 이제 모두 모였으니까 얼른 밥이나 먹자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870327
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870327,
					"content": "자, 페이몬, 네 좌우명을 설파할 때야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870328
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870328,
					"content": "내, 내가? 어… 그러니까… 이왕 사는 인생 마음껏 먹을지니, 금수저… 금수저 다음 뭐였더라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870329
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870329,
					"content": "금수저를 비운 채 달을 가리키지 마오",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870330
					]
				},
				{
					"id": 401870330,
					"content": "아 맞아 맞아, 바로 그거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870331
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870331,
					"content": "와, 페이몬, 자기 좌우명도 더듬는 거야? 그러다 인생도 더듬겠다, 야. 자, 힘내서! 크게 한 번 더 외쳐 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870332
					],
					"speakerTitle": "가명"
				},
				{
					"id": 401870332,
					"content": "이왕 사는 인생 마음껏 먹을지니! 금수저를 비운 채 달을 가리키지 마오!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870333
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870333,
					"content": "아주 좋아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870334
					]
				},
				{
					"id": 401870334,
					"content": "헤헤, 그럼 이제 먹어도 되는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870335
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870335,
					"content": "페이몬, 설마 잊었어? 오늘 특별한 손님이 한 명 있잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870336
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870336,
					"content": "맞다! 생각났어, 사실 누구인지 진작에 눈치챘지만, 나 말 안 할래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870337
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870337,
					"content": "어? 페이몬 말투가 자신감이 없는데, 사실 누구인지 모르는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870338
					],
					"speakerTitle": "호두"
				},
				{
					"id": 401870338,
					"content": "#아니야, 진짜 누구인지 안다니까. 그러니까 그 사람은… {NICKNAME}, 빨리 좀 도와줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870339
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870339,
					"content": "운근일 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870340
					]
				},
				{
					"id": 401870340,
					"content": "맞아! 바로 우리의 착한 운 선생이지. 너도 운 선생이 한 말을 잊지 않았나 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870341
					],
					"speakerTitle": "호두"
				},
				{
					"id": 401870341,
					"content": "봐, 운근이 무대에 올라왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870342
					],
					"speakerTitle": "호두"
				},
				{
					"id": 401870342,
					"content": "와! 저 사람 운한사 주인 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870343
					],
					"speakerTitle": "이흥"
				},
				{
					"id": 401870343,
					"content": "진짜 횡재했네, 운 선생님이 유롱항에 오시다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870344
					],
					"speakerTitle": "첩오"
				},
				{
					"id": 401870344,
					"content": "안녕하세요, 여러분",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870345
					],
					"speakerTitle": "운근"
				},
				{
					"id": 401870345,
					"content": "오늘 밤, 해등절을 놓친 친구들을 위해, 팔기연도도를 다시 한번 더 부를까 해요. 그날의 무대만큼은 못하겠지만, 너른 양해 부탁드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870346
					],
					"speakerTitle": "운근"
				},
				{
					"id": 401870346,
					"content": "우와! 운근이 너희가 놓친 노래를 다시 불러주겠대!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870347
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870347,
					"content": "쉿! 시작한다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870356
					],
					"speakerTitle": "호두"
				},
				{
					"id": 401870356,
					"content": "도도를 이야기를 떠올리니——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870348
					],
					"speakerTitle": "운근"
				},
				{
					"id": 401870348,
					"content": "요괴가 나무 아래에서 소동을 피우고, 정 깊은 귀신과 연 없는 자 내 명만 따르네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870349
					],
					"speakerTitle": "운근"
				},
				{
					"id": 401870349,
					"content": "이별의 슬픔은 속세에 원망의 불길 되고, 뼈는 칼이 피는 말이 되어 구천을 달리니, 그대의 야심은 가소롭구나——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870350
					],
					"speakerTitle": "운근"
				},
				{
					"id": 401870350,
					"content": "하늘을 메우고 세상을 구하며 등불 전하니, 창칼이 추는 그림자 아름답도다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870351
					],
					"speakerTitle": "운근"
				},
				{
					"id": 401870351,
					"content": "삶과 죽음, 음과 양을 어찌하리, 생명을 해치고 자신을 살찌우며 인과를 심는구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870352
					],
					"speakerTitle": "운근"
				},
				{
					"id": 401870352,
					"content": "천도는 공정하며, 탐욕이 넘치는 것은 그대의 그릇됨이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870353
					],
					"speakerTitle": "운근"
				},
				{
					"id": 401870353,
					"content": "마를 몰아내리라 맹세하는 자 내가 아니니, 도도는 팔문의 칼에 떨어지는구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870354
					],
					"speakerTitle": "운근"
				},
				{
					"id": 401870354,
					"content": "앞에서는 힘 다해 혼백 사라지면, 뒤에서는 절로 누군가 옳고 그름 가리리",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870355
					],
					"speakerTitle": "운근"
				},
				{
					"id": 401870355,
					"content": "버들가지 꺾어 눈물을 밭에 뿌리니, 다음 해의 제비는 가지를 물고 와 봄의 물결을 일으키네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "운근"
				}
			]
		},
		{
