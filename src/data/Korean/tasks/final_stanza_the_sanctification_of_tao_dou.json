				]
			},
			"dialogs": [
				{
					"id": 401870101,
					"content": "#얘들아! {NICKNAME}, 페이몬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870102
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870102,
					"content": "향릉이잖아! 무슨 일인데 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870103,
					"content": "하하, 뭐 특별한 일 있겠어? 당연히 배 채우는 일이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870104
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870104,
					"content": "마침내 밥을 먹을 때인가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870105
					]
				},
				{
					"id": 401870105,
					"content": "응! 지금 한가하지? 더 미루지 않기야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870106
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870106,
					"content": "맨날 시간 없다 한 건 우리가 아니고 호두야 호두!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870107,
					"content": "당주가 뭐라고, 유세라니까 정말! 여럿이 나서질 않으면 약속도 못 잡을 정도야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870108
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870108,
					"content": "하지만 안심해, 이번에는 약속을 잡아냈으니까. 핑계도 못 대게 아주 압박을 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870109
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870109,
					"content": "오? 또 누가 나선 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870110,
					"content": "헤헤, 행추가 손을 썼지. 전부터 다 같이 모이고 싶어 했는데 증조부님 일이 있었잖아, 그래서 지금까지는 힘들었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870111
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870111,
					"content": "근데 해등절 당일 밤에 행추의 증조부께서 깨어나셨대. 얼마나 기뻐하던지, 이 기회에 바로 의기투합한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870112
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870112,
					"content": "다행이다! 무사하대?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870113,
					"content": "응, 의사 선생님도 진료해 봤는데 완전 괜찮으시대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870114
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870114,
					"content": "게다가 깨어나자마자 식사를 거하게 하시는데, 꼭 페이몬처럼 식욕이 좋아지셨다나 봐. 그래서 이젠 탈 나실까 봐 걱정이라더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870115
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870115,
					"content": "나 같다는 게 왜 좋은 말로 안 들리지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870116,
					"content": "에이, 좋은 말이지. 페이몬의 배는 적극적인 인생 태도와도 같은걸. 이왕 사는 인생 마음껏 먹을지니, 금수저를 비운 채 달을 가리키지 마오!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870117
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870117,
					"content": "응응, 향릉 말이 맞아! 내가 그걸 좌우명으로 삼으면서 오늘까지 살아온 거잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870118,
					"content": "그랬었어? 나는 여태 몰랐네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870119
					]
				},
				{
					"id": 401870119,
					"content": "흥흥, 그렇다니까! 이왕 사는 인생 마음껏 먹을지니, 금수저를… 금수저 다음이 뭐였더라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870120,
					"content": "하하, 페이몬, 그 좌우명은 식탁에서 다시 말하기로 하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870121
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870121,
					"content": "헤헤, 문제없어! 그럼 우리 밥은 어디서 먹어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870122,
					"content": "오늘 저녁에 유롱항에서. 행추랑 다른 사람들도 다 거기에 있어. 참, 호두가 또 특별한 손님이 올 거라던데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870123
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870123,
					"content": "누구?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870124
					]
				},
				{
					"id": 401870124,
					"content": "저녁이 되면 너희도 알 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870125
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 401870125,
					"content": "아! 나 누군지 알 것 같아. 헤헤, 근데 말 안 할래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870126,
					"content": "나도 알 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870127
					]
				},
				{
					"id": 401870127,
					"content": "어? 누군데 누군데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401870128,
					"content": "말 안 할래",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870129
					]
				},
				{
					"id": 401870129,
					"content": "흥, 그럼 이따 밤에 누가 맞혔는지 한 번 보자구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
