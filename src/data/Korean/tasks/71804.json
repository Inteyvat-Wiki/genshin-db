				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718040301,
					"content": "새로운 영업허가증에 관한 공지사항을 찾았니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040302
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 718040302,
					"content": "적어뒀어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040303
					]
				},
				{
					"id": 718040303,
					"content": "고마워. 어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040304
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 718040304,
					"content": "출항 신청 허가 서류, 영업장 등록 및 영업 안전 서약서… 그리고 옛 영업허가증…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040305
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 718040305,
					"content": "휴, 다행이다. 이 서류들은 며칠 전에 다 준비해뒀거든. 힘들어 죽는 줄 알았다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040306
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 718040306,
					"content": "여행자, 미안한데 한 번만 더 고생해줄래? 이 서류들을 각 담당자에게 제출하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040307
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 718040307,
					"content": "크흠… 담당자가 좀 많지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040308
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 718040308,
					"content": "음, 먼저 <color=#00E1FFFF>출항 신청 허가 서류</color>는 소안한테, <color=#00E1FFFF>영업장 등록 및 영업 안전 서약서</color>는 천암군의 가의한테 좀 전해줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040309
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 718040309,
					"content": "그리고 <color=#00E1FFFF>옛 영업허가증</color>은 소소한테 전해주면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040310
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 718040310,
					"content": "그럼 한 번 더 부탁할게, 여행자. 보수는 섭섭지 않게 준비할 테니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040311
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 718040311,
					"content": "네네, 알았어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040312
					]
				},
				{
					"id": 718040312,
					"content": "제발 이번 절차가 마지막이었으면 좋겠군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040313
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 718040313,
					"content": "그건 저도 마찬가지예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040314
					]
				},
				{
					"id": 718040314,
					"content": "넌 이제 이런 절차를 밟으러 다닐 일이 없겠지만, 나야 뭐… 여기서 장사하려면 그럴 날이 또 오겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040315
					],
					"speakerTitle": "이바노비치"
				},
				{
					"id": 718040315,
					"content": "휴, 확실히 이런 꼼꼼한 방법이 안심되긴 하는데, 심플했으면 더 좋았을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이바노비치"
				}
			]
		},
