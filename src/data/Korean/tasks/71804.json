					],
					"speakerTitle": "가의"
				},
				{
					"id": 718040506,
					"content": "후, 정말 머리 아픈 업무군요…. 그래서 영업장 등록과 영업 안전 서약서는 가져오셨나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "가의"
				}
			]
