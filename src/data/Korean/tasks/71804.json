			"dialogs": [
				{
					"id": 718040201,
					"content": "비운 언덕 알림판입니다. 동네 소식, 점포 광고 등 모두 게시 가능합니다. 중요하지 않은 소식은 올리지 말아 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040202,
						718040205,
						718040208
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 718040202,
					"content": "총무부 인사이동에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040203
					]
				},
				{
					"id": 718040203,
					"content": "「총무부 인사이동에 관한 공지입니다…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040204
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 718040204,
					"content": "잠깐, 총무부 인사이동은 영업허가증이랑 관계없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 718040205,
					"content": "비운 언덕 수원지 오염에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040206
					]
				},
				{
					"id": 718040206,
					"content": "「최근 비운 언덕 수원지 오염에 관해선…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040207
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 718040207,
					"content": "이바노비치 씨가 기다리고 있잖아. 수원지 오염 같은 걸 신경 쓸 때가 아니라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 718040208,
					"content": "새로운 영업허가증 신청에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040209
					]
				},
				{
					"id": 718040209,
					"content": "「새로운 영업허가증을 신청하려면 아래의 절차가 필요합니다…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040210
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 718040210,
					"content": "이게 이바노비치 씨가 신청하려던 새로운 영업허가증 같지? 빨리 메모해두자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
