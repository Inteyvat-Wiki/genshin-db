						761180104
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761180104,
					"content": "콜롬비나 혼자 포식하고 있잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761180105,
					"content": "#{NICKNAME}, 페이몬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180106
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761180106,
					"content": "되게 맛있게 먹네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761180107,
					"content": "너희도 먹을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180108
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761180108,
					"content": "아냐, 너 많이 먹어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180109
					]
				},
				{
					"id": 761180109,
					"content": "여기서 뭘 먹는 모습은 거의 못 본 것 같은데, 밖에 나가서 사 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761180110,
					"content": "라우마가 보내줬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180111
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761180111,
					"content": "오! 역시 라우마가 잘 챙겨주는구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761180112,
					"content": "대신 여기서 나가지 말랬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180113
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761180113,
					"content": "그건 감금이잖아! 먹을 거에 매수당한 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761180114,
					"content": "재밌는 책이랑 예쁜 장난감도 줬는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180115
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761180115,
					"content": "꼭 일 나가는 엄마랑 집에 남겨진 아이 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761180116,
					"content": "라우마가 이유는 설명해 줬어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180117
					]
				},
				{
					"id": 761180117,
					"content": "라우마가 당분간 나가지 말아달래. 특히 서리달 아이 쪽으로는 절대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180118
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761180118,
					"content": "요리 배달 온 동물들한테 이유를 물어봤는데, 라우마가 신신당부를 했는지 아무도 말 안 해주더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180119
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761180119,
					"content": "그건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761180120,
					"content": "아마 나와 관련된 무언가를 준비하고 있는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180121
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761180121,
					"content": "걱정 마, 나 여기서 지내도 별로 안 심심해. 요리도 맛있고 내 입맛에 맞아서, 밖에 안 나가도 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180122
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761180122,
					"content": "그리고 서리달 아이 사람들이 뭔가를 준비하고 있는 거라면, 내 호기심으로 모두의 계획을 방해해선 안 되잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180123
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761180123,
					"content": "우리가 나가서 살짝 물어볼까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180124
					]
				},
				{
					"id": 761180124,
					"content": "그래, 나도 궁금해졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761180125,
					"content": "좋아. 하지만 마음의 준비 하고 가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180126
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761180126,
					"content": "너희가 날 만날 걸 알고, 아무것도 말 안 해줄 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「콜롬비나」"
				}
			]
		},
