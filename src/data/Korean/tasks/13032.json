				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320501,
					"content": "여기가 끝이겠지? 그런데 아란나라는 어디 가고 거대한 바위만 보이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320502,
					"content": "너무 신나요. 이런 기분은 거의 잊은 줄 알았는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320503
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320503,
					"content": "그거 알아요? 달리지 않으면 제 세상은 정말 좁아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320504
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320504,
					"content": "하지만 계속해서 달리면 새로운 풍경들이 보이면서 온 세상이 넓어지는 느낌이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320505
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320505,
					"content": "#어떻게 한 건지는 모르겠지만, {M#언니랑 오빠가}{F#언니들이} 도와준 덕이겠죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320506
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320506,
					"content": "아잇, 그건 중요하지 않아. 중요한 건 네가 많은 걸 떠올렸단 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320507
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320507,
					"content": "기억은 과거를 상징할 뿐만 아니라 미래를 밝힐 힘도 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320508
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320508,
					"content": "병만 낫는다면 이 즐거움들을 다 되찾을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320509
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320509,
					"content": "네! 다들 정말정말 고마워요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320510
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320510,
					"content": "그럼 계속 아란샤니를 찾아봐요. 여기엔 없는 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320511
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320511,
					"content": "그러게, 그런데 왜 우리를 여기까지 오게 한 걸까…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320512
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320512,
					"content": "이 바위, 뭔가 이상한 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320513
					]
				},
				{
					"id": 130320513,
					"content": "저도요. 뭔진 모르겠지만 익숙한 느낌이 나요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320514
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320514,
					"content": "마치 「이게」 제 일부인 것처럼요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320515
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320515,
					"content": "알겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320516
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320516,
					"content": "이 바위가 아빈의 「창송석」이 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320517
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320517,
					"content": "차, 창송석?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320518,
						130320519
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320518,
					"content": "(이야기를 정말 잘 짓네)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320519,
					"content": "(거의 잊고 있었는데)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320520
					]
				},
				{
					"id": 130320520,
					"content": "엄청 희귀한 광석인데, 초심과 꿈을 상징하는 물건이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320521
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320521,
					"content": "그걸 보게 되었다는 건 네가 잃어버렸던 걸 되찾았단 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320522
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320522,
					"content": "그렇구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320523
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320523,
					"content": "동화에 나오는 이야기랑 똑같네요. 동화는 더 이상 안 믿었는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320524
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320524,
					"content": "그래도 정말 좋아요. 제가 되찾았어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320525
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320525,
					"content": "엇! 너, 넘어갔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320526
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320526,
					"content": "우리도 따라가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320527
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320527,
					"content": "잠깐, 요이미야! 휴, 어쩔 수 없지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320528
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320528,
					"content": "넘어왔는데 딱히 변한 게 없어 보여…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320529
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320529,
					"content": "오랜만이야, 나라아빈. 참 오랜 시간이 지났네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320530
					],
					"speakerTitle": "아란샤니"
				},
				{
					"id": 130320530,
					"content": "아란샤니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320531
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320531,
					"content": "왜 슬픈 표정을 짓는 거야? 아, 알겠다. 기뻐서 그러는 거구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320532
					],
					"speakerTitle": "아란샤니"
				},
				{
					"id": 130320532,
					"content": "아란샤니! 흐아아아앙——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320533
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320533,
					"content": "하하하, 아란나라가 우리를 위해 정말 낭만 가득한 여행을 준비해줬구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320534
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320534,
					"content": "제일 중요한 친구를 되찾았고 「창송석」이 뭔지도 알려줬잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320535
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320535,
					"content": "이제 우리만의 「창송석」을 찾으러 가자. 제일 순도 높은 렌즈를 만들어 내고야 말겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320536
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320536,
					"content": "응! 왠지 모르겠지만 꼭 해낼 수 있을 것 같은 기분이 들어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320537,
						130320538
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320537,
					"content": "이게 바로 모험이지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320538,
					"content": "나도 정말 신나!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320539
					]
				},
				{
					"id": 130320539,
					"content": "그 전에 먼저 아빈을 수메르성으로 바래다주자. 어머니가 걱정하시겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320540,
					"content": "눈앞에 펼쳐진 꿈과 같은 광경들이 순식간에 사라지고 원래의 자리로 돌아온다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
