						130321131
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130321131,
					"content": "이 따스한 마음은 너희가 어딜 가든 항상 너희를 지지해주는 든든한 힘이 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321132
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130321132,
					"content": "그렇게 여행의 종착지까지, 세계의 끝자락까지 떠나봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321133
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130321133,
					"content": "그럼 안녕!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130321128,
					"content": "소중히 간직할게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321118,
					"content": "항상 즐겁게 지내",
