					"요이미야"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320901,
					"content": "으… 으음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320902
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320902,
					"content": "벌써 깼네. 더 보고 싶은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320903
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320903,
					"content": "우리가 소원으로 불러낸 유성이 땅에서 솟구친 거였다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320904
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320904,
					"content": "꼭 불꽃이랑 똑같잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320905
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320905,
					"content": "——흥이 좀처럼 안 가시네. 내가 꿨던 꿈 중에 제일 생생하고, 화려하고, 낭만적인 꿈이었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320906
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320906,
					"content": "나도 나도! 네가 우리를 데리고 그렇게 뛰어오를 줄은 생각도 못 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320907
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320907,
					"content": "헤헤, 사실 나도 별생각 없었어. 그냥 이 기회에 제대로 즐기지 않으면 아쉬울 것 같더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320908,
						130320909
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320908,
					"content": "요이미야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320909,
					"content": "사실 꿈속이라는 걸 알고 있었지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320910,
					"content": "알잖아. 난 꿈이든 현실이든 상관없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320911
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320911,
					"content": "그래도 두 사람 다 정말 고마워. 유성우를 보는 게 어려워서 너희가 특별히 준비해준 대비책이잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320912
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320912,
					"content": "응응, 너무너무 좋았어. 내가 지금까지 받았던 선물 중에 단연 최고였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320913
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320913,
					"content": "그럼 다행이고. 진실을 알게 되면 혹시라도 화날까 봐 걱정했었는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320914
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320914,
					"content": "그럴 리가! 꿈속에서 남을 잘 도와주는 착하고 귀여운 아란나라도 봤는걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320915
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320915,
					"content": "그리고 큰 버섯들 사이를 뛰고 날면서 생각지도 못했던 방식으로 「창송석」을 찾아냈고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320916
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320916,
					"content": "꿈이 깬 줄 알았는데 더 엄청난 일이 벌어졌잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320917
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320917,
					"content": "아빈이 가슴 한 켠에서 꺼낸 「창송석」이 안경으로 변해서 다 같이 땅에서 떠오르는 유성을 봤고, 또 유성우의 일부가 되었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320918,
						130320919
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320918,
					"content": "계속 꿈속이었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320919,
					"content": "우린 깬 적이 없었던 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320920,
					"content": "그래, 꿈은 현실이 아니지만, 유일무이하고 다시는 볼 수 없는 소중한 「경험」이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320921
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320921,
					"content": "진짜인지 가짜인지에 얽매이면 수많은 아름다움과 감동을 놓치게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320922
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320922,
					"content": "헤헤, 그렇게 말해주니 좋은데? 「페이몬의 친한 친구」 랭킹에서 한 단계 상승!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320923
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320923,
					"content": "그런 랭킹도 있었어…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320924
					]
				},
				{
					"id": 130320924,
					"content": "맞다, 그러고 보니 아란나라들은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320925
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320925,
					"content": "그래그래, 아란나라도 정말 귀여웠어. 정교하게 제작된 목각 장난감 덕분이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320926
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320926,
					"content": "응? 목각?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320927
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320927,
					"content": "응, 목각을 보지 못했다면 꿈에서 그렇게 생긴 아란나라를 보지도 못했겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320928
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320928,
					"content": "……?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320929,
						130320930
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320929,
					"content": "요이미야가 우리 뜻을 이해한 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320930,
					"content": "나도 목각보다 더 귀여웠던 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320931,
					"content": "히히, 걱정 마. 알고 있어. 나도 귀여운 아란나라를 지켜주고 싶거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320932
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320932,
					"content": "자, 시간이 다 됐으니 어서 집에 보내주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130321101,
					"content": "아빈을 집에 바래다준 후 요이미야와 수메르에서 며칠간 더 머물렀다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130321102
					]
				}
			]
		},
