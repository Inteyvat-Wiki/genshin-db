				"points": []
			},
			"dialogs": [
				{
					"id": 130321105,
					"content": "수메르는 참 좋은 곳이네요. 다음에 또 놀러 올게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321106
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130321106,
					"content": "언제든지 놀러 오렴. 아빈이 정말 좋아할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321107
					],
					"speakerTitle": "니우샤"
				},
				{
					"id": 130321107,
					"content": "약속한 거예요! 기다리고 있을게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321108
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130321108,
					"content": "헤헤헤, 당연하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321109
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130321109,
					"content": "언니, 언니한테 알려주고 싶은 게 있어요——저, 새로운 꿈이 생겼어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321110
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130321110,
					"content": "제 혼자 힘으로 이나즈마에 가서 이나즈마의 불꽃놀이를 보고 싶어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321111
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130321111,
					"content": "오, 대단한데! 하하, 여행 와서 가게에 새로운 손님이 생길 줄이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321112
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130321112,
					"content": "걱정 마. 널 위해 특별한 폭죽을 만들어 놓을게. 한 번 보면 못 잊을걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321113
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130321113,
					"content": "물론 너희도! 아무리 모험하느라 바빠도 이나즈마에 자주 놀러 와. 언제든지 환영이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321114
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130321114,
					"content": "이번 여행에서 얻은 수확은 꼭 너희가 보는 앞에서 하늘로 쏘아 올릴 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321115
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130321115,
					"content": "그래, 약속이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321116,
						130321118,
						130321120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130321116,
					"content": "조심히 가",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321117
					]
				},
				{
					"id": 130321117,
					"content": "응응, 넌 여전히 차분하네, 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130321122,
					"content": "아 맞다, 이게 뭐게?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321123
					],
