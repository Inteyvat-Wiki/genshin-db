				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320101,
					"content": "아까부터 묻고 싶었던 건데, 뭘 준비한다는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320102,
					"content": "나라아빈은 아직 전부 떠올리지 못했어. 기억과 꿈, 하나도 빠져서는 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320103
					],
					"speakerTitle": "아란푸르바"
				},
				{
					"id": 130320103,
					"content": "꿈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320104
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320104,
					"content": "하지만 전 다시 일어날 수 없는걸요. 회복된다 해도 전처럼 좋아질 수 있을지, 얼마나 걸릴지도 몰라요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320105
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320105,
					"content": "그런 걱정은 마. 나라아빈은 그저 꿈은 마음에 있는 것이지 몸과는 상관없다는 것만 기억하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320106
					],
					"speakerTitle": "아란푸르바"
				},
				{
					"id": 130320106,
					"content": "마음이요…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320107
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320107,
					"content": "안내는 여기까지 할게. 소중한 건 나라아빈이 직접 되찾는 게 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320108
					],
					"speakerTitle": "아란푸르바"
				},
				{
					"id": 130320108,
					"content": "어라? 사라져버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320109
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320109,
					"content": "주변 하늘도 약간 바뀐 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320110
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320110,
					"content": "마음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320111
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320111,
					"content": "……!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320112
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320112,
					"content": "으엥——?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320113,
					"content": "내가… 일어섰어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320114
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320114,
					"content": "전혀 힘이 들지도, 이상한 느낌이 나지도 않아요. 아프기 전과 똑같은 느낌이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320115
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320115,
					"content": "설마, 우리 지금…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320116,
					"content": "꿈속에 들어왔어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320117
					]
				},
				{
					"id": 130320117,
					"content": "응, 예전에도 이런 일이 있었지. 걱정 말라고 했던 이유가 있었구나. 꿈에서는 자유롭게 움직일 수 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320118,
					"content": "보세요, 제가 다시 일어섰어요! 헤헤, 일어섰다고요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320119
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320119,
					"content": "너무 잘됐다! 그럼 이제 같이 아란샤니를 찾으러 갈 수 있겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320120
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320120,
					"content": "우리 달리기 시합할까? 네 실력 좀 보여줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320121
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320121,
					"content": "아직 회복이 안 됐을 수도 있는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320122
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320122,
					"content": "에잇, 몰라. 시합해요! 어른들한테도 안 질 자신 있어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320123
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320123,
					"content": "아, 출발했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320124,
					"content": "생각보다 순조로운데? 적응할 시간이 더 필요할 줄 알았다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320125,
						130320126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320125,
					"content": "이런 게 재능이겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				},
				{
					"id": 130320127,
					"content": "헤헤, 맞아. 우리도 따라가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320126,
					"content": "이게 소원인 거겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				}
			]
		},
