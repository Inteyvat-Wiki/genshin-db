				"points": []
			},
			"dialogs": [
				{
					"id": 130320601,
					"content": "이, 이건… 끝난 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320602
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320602,
					"content": "정말 좋은 꿈을 꿨네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320603
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320603,
					"content": "그런 쓸쓸한 표정 짓지 마. 아직 네 옆에 있다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320604
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320604,
					"content": "아란샤니! 다행이야, 있었구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320605
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320605,
					"content": "아란샤니가 사과할게. 아란샤니가 나라아빈을 안 찾으러 간 게 아니라 시간을 잊은 거였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320606
					],
					"speakerTitle": "아란샤니"
				},
				{
					"id": 130320606,
					"content": "아란샤니는 성으로 가기가 무서웠어. 나라아빈이 안 보여서 새로운 친구를 사귄 줄 알았거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320607
					],
					"speakerTitle": "아란샤니"
				},
				{
					"id": 130320607,
					"content": "자주 있는 일이야. 어쩔 수 없는 일이지만 슬퍼할 필요는 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320608
					],
					"speakerTitle": "아란푸르바"
				},
				{
					"id": 130320608,
					"content": "괜찮아, 이해해. 다 내가 기운을 못 내서 그런 거니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320609
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320609,
					"content": "하지만 이젠 알겠어. 언니 말이 맞아. 운이 나쁜 상황은 누구에게나 생기지만, 중요한 건 서로 돕는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320610
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320610,
					"content": "모두 도와줘서 고마워요. 여러분들이 다시 찾아준 기억과 꿈을 소중히 여길게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320611
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320611,
					"content": "헤헤, 나도 많은 도움을 받았으니까 괜찮아. 「창송석」이 뭔지 감이 하나도 안 잡혔었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320612
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320612,
					"content": "이제 방향을 알았으니 금방 찾을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320613
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320613,
					"content": "언니는 유성우가 보고 싶은 거죠? 그래서 「창송석」이 필요한 거예요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320614
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320614,
					"content": "응! 참, 찾게 되면 너도 꼭 같이 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320615
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320615,
					"content": "그렇다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320616
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320616,
					"content": "제 「창송석」을 빌려줄게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320617
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320617,
					"content": "엥?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320618
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320618,
					"content": "어, 어떻게 된 거지? 갑자기 가슴팍에서… 안경을 꺼냈어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320619
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130320619,
					"content": "나도 모르겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320620
					]
				},
				{
					"id": 130320620,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320621
					],
					"speakerTitle": "아란푸르바"
				},
				{
					"id": 130320621,
					"content": "하하하, 내가 이게 필요한지 어떻게 알았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320622
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320622,
					"content": "모르겠어요. 그냥 언니가 제일 친한 친구를 찾아줬으니까 저도 제일 소중한 물건으로 보답하고 싶어서요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320623
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320623,
					"content": "그랬더니 빛이 이렇게 변했어요. 이게 언니가 필요한 물건이에요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320624
					],
					"speakerTitle": "아빈"
				},
				{
					"id": 130320624,
					"content": "고마워, 문제가 이렇게 해결될 줄은 몰랐네. 바로 시도해 볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320625
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320625,
					"content": "사용법을 잘 모르니 그냥 느낌대로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320626
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320626,
					"content": "어디지… 어디에 있으려나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320627
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320627,
					"content": "오! 보인다 보여! 꽤 잘 보이는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320628
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320628,
					"content": "가자, 내가 길을 안내할게. 유성우를 보고 집으로 돌아가는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320629
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320629,
					"content": "도와줘서 고마워요. 인사치레는 생략하고 진심으로 칭찬 한마디만 할게요——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320630
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320630,
					"content": "아란나라는 정말 타고난 이야기꾼이에요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320631
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 130320631,
					"content": "하하, 이런 우연이. 나도 붉은빛의 나라에게 똑같은 평가를 하고 싶군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란푸르바"
				}
			]
		},
		{
			"id": 1303209,
			"completionStepIds": [
				1303209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
