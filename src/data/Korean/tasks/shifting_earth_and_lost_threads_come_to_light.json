				"points": []
			},
			"dialogs": [
				{
					"id": 111220201,
					"content": "아, 발자국이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111220202,
					"content": "아무래도 성법 관문을 통과해 계속 앞으로 걸어간 모양이군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220203
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111220203,
					"content": "발자국을 따라가면 그들이 어디로 갔는지 알 수 있겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 1112204,
			"completionStepIds": [
				1112204,
				1112210,
				1112211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
