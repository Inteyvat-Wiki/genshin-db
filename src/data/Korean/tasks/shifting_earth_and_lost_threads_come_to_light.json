			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"완옥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220701,
					"content": "이 난폭한 마물들 같으니라고, 그냥 지나가던 길인데 발각돼서 꼼짝없이 당했네…. 덕분이야, 구해줘서 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220702
					],
					"speakerTitle": "완옥"
				},
				{
					"id": 111220702,
					"content": "난 완옥, 리월 성로청 소속으로 인문 유적에 대한 연구를 맡고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220703
					],
					"speakerTitle": "완옥"
				},
				{
					"id": 111220703,
					"content": "에엥? 광부 아냐…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220704
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111220704,
					"content": "광부?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220705
					],
					"speakerTitle": "완옥"
				},
				{
					"id": 111220705,
					"content": "응! 우린 광부를 찾고 있어! 채광 장비를 갖고 다니고 키가 큰 4명의 남정네들이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220706
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111220706,
					"content": "네가 말한 그 사람들, 본 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220707
					],
					"speakerTitle": "완옥"
				},
				{
					"id": 111220707,
					"content": "진짜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220708
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111220708,
					"content": "응, 그제 남천문에서 출발해 성법 관문 쪽으로 오던 도중에 아이 하나랑 같이 있는 성인 몇을 지나친 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220709
					],
					"speakerTitle": "완옥"
				},
				{
					"id": 111220709,
					"content": "자세하게 말해줄 수 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220710
					]
				},
				{
					"id": 111220710,
					"content": "급하게 오느라 자세히는 못 봐서 생김새 같은 건 도무지 기억이 나질 않네…. 미안",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220711
					],
					"speakerTitle": "완옥"
				},
				{
					"id": 111220711,
					"content": "그거면 충분해, 고맙네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220712
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111220712,
					"content": "도움이 됐다니 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220713
					],
					"speakerTitle": "완옥"
				},
				{
					"id": 111220713,
					"content": "그럼 난 학술회의에 참가해야 해서 먼저 가 볼게. 다들 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220714
					],
					"speakerTitle": "완옥"
				},
				{
					"id": 111220714,
					"content": "저 학자의 말대로라면 그들은 아마 남천문 쪽으로 간 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220715
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111220715,
					"content": "하지만 우리가 찾는 사람들인지 확실치 않잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220716
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111220716,
					"content": "어린아이와 성인의 조합은 그리 흔치 않잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220717
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111220717,
					"content": "흔한데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220718
					]
				},
				{
					"id": 111220718,
					"content": "으… 그, 그건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220719
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111220719,
					"content": "앗, 저기 광석이 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220720
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111220720,
					"content": "오오, 그런 방법이 있었지?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220721
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111220721,
					"content": "아마 읽어낼 수 있을 거야. 한번 해 볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220722
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111220722,
					"content": "흐음",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220723
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111220723,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220724
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111220724,
					"content": "맞아, 같은 사람들이고 이 길을 따라갔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220725
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111220725,
					"content": "곤균 씨가 광석의 기억을 읽는 장면은 몇 번을 봐도 질리지 않는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220726
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111220726,
					"content": "평상시엔 쓸모도 없는 능력인걸요. 종려 선생님께 소소한 즐거움이라도 드릴 수 있어 영광입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220727
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111220727,
					"content": "넌 우리의 나침반이야! 네가 있어서 우리가 방향을 정할 수 있다구~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220728
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111220728,
					"content": "하하하하, 그래? 내가 헛걸음한 건 아닌 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220729
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111220729,
					"content": "흠, 이 느낌… 사건을 처리하는 것처럼 재밌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220730
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111220730,
					"content": "재밌다고 느슨해지진 마시게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220731
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111220731,
					"content": "어른 넷이 멍한 얼굴로 아이 하나를 주야장천 따라다닌다는 게… 결코 간단한 문젠 아닐 걸세",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220732
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111220732,
					"content": "오옷! 그건 그렇죠. 종려 선생님은 정말 신중하시네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220733
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111220733,
					"content": "게다가 방금 그 학자를 공격한 새끼 바위 용 도마뱀은 원래 그렇게 공격적인 마물이 아니지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220734
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111220734,
					"content": "길을 따라 찾아온 많은 단서가 모두 연관돼있는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220735
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111220735,
					"content": "광부들이 그저께 남천문 쪽으로 갔고, 이곳을 지나면 험준한 산길이니, 남천문으로 가는 거라면 따라잡을 수 있을 것 같군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220736
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111220736,
					"content": "응응! 바로 출발하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220737
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111220737,
					"content": "방금 근처에 표시를 해뒀으니, 대웅 씨가 쫓아온다면 이걸 보고 우릴 찾을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220738
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111220738,
					"content": "역시 종려야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
