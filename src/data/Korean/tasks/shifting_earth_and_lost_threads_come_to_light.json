			"dialogs": [
				{
					"id": 111229901,
					"content": "잠깐만, 바닥에 단서가 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229902
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111229902,
					"content": "그 광부들이 남긴 걸 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229903
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111229903,
					"content": "성법 관문 출구로 가지. 발자국이 없으면 그들이 아직 안에 있다는 거고, 새로운 단서가 나오면 계속 추적하자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "종려"
				}
			]
		},
		{
			"id": 1112202,
			"completionStepIds": [
				1112202
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
