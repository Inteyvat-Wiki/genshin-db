					"nextDialogs": [
						250271310
					],
					"speakerTitle": "밀루·누이"
				},
				{
					"id": 250271310,
					"content": "…아니, 아니야! 그 소리보다 좀 더 평범한 것부터 시작하는 게 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "밀루·누이"
				},
				{
					"id": 250271305,
					"content": "평범한 편이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250271306
