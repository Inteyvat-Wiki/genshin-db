			"dialogs": [
				{
					"id": 250270701,
					"content": "손님들의 생각을 들어보는 거 어때요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270702
					]
				},
				{
					"id": 250270702,
					"content": "음… 반대하진 않을게. 전에 여러 사람들에게 물어본 적도 있고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270703
					],
					"speakerTitle": "밀루·누이"
				},
				{
					"id": 250270703,
					"content": "…하지만 날 보면 본능적으로 예의를 차리느라 진심을 말하지 못했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270704
					],
					"speakerTitle": "밀루·누이"
				},
				{
					"id": 250270704,
					"content": "#{NICKNAME}, 손님들의 의견을 물어봐 줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270705
					],
					"speakerTitle": "밀루·누이"
				},
				{
					"id": 250270705,
					"content": "네 앞이라면 분명히… 더 솔직한 의견을 말해줄 거야",
