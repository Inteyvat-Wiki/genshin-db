				"points": []
			},
			"dialogs": [
				{
					"id": 250270201,
					"content": "밀루 씨가 또 새로운 음반을 발매했네. 살까 말까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270202
					],
					"speakerTitle": "마히나·누이"
				},
				{
					"id": 250270202,
					"content": "밀루·누이의 음반에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270203
					]
				},
				{
					"id": 250270203,
					"content": "응? 밀루 씨의 음반은 아주 좋아. 할로아랑 아기 용도 좋아해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270204
					],
					"speakerTitle": "마히나·누이"
				},
				{
					"id": 250270204,
					"content": "애들이 장난치면서 자기 싫어할 때, 밀루 씨의 《봄의 찬가》를 틀어주거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270205
					],
					"speakerTitle": "마히나·누이"
				},
				{
					"id": 250270205,
					"content": "아이들은 그 노래를 들으면 얌전히 잠에 들어, 게다가 아주 푹 자는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270206
					],
					"speakerTitle": "마히나·누이"
				},
				{
					"id": 250270206,
					"content": "흐음… 하지만 할로아는 더 격렬한 곡을 좋아한다고 계속 얘기하긴 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270207
					],
					"speakerTitle": "마히나·누이"
				},
				{
					"id": 250270207,
					"content": "밀루 씨가 더 열정적인 노래를 작곡해 줬으면 좋겠어. 그럼 할로아도 분명 더 신나게 놀 수 있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마히나·누이"
				}
			]
		},
		{
			"id": 2502703,
			"completionStepIds": [
				2502703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
