			"dialogs": [
				{
					"id": 200620301,
					"content": "통나무를 찾았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620302
					],
					"speakerTitle": "허먼"
				},
				{
					"id": 200620302,
					"content": "찾았어요, 근데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620303
					]
				},
				{
					"id": 200620303,
					"content": "하… 너무 무자비한 거 아냐? 이렇게 단단한 통나무가 다 깨졌네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620304
					],
					"speakerTitle": "허먼"
				},
				{
					"id": 200620304,
					"content": "그래도 전투할 때 통나무 살피느라 힘을 빼는 사람은 없을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620305
					],
					"speakerTitle": "허먼"
				},
				{
					"id": 200620305,
					"content": "엘린에게 바로 줄 순 없지만… 그래도 재료는 이미 전부 다 있으니까 가공만 하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620306
					],
					"speakerTitle": "허먼"
				},
				{
					"id": 200620306,
					"content": "겨우 조립하긴 했는데, 봐봐. 음… 모습이 어느 정도 나오긴 하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620307
					],
					"speakerTitle": "허먼"
				},
				{
					"id": 200620307,
					"content": "아무튼 고마워. 네게 열정페이 같은 건 시키지 않는다고 했으니까, 보수는 여기 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620308
					],
					"speakerTitle": "허먼"
				},
				{
					"id": 200620308,
					"content": "난 더 이상 모험가가 아니지만, 그래도 모험가의 규칙을 어겨선 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "허먼"
				}
			]
		},
