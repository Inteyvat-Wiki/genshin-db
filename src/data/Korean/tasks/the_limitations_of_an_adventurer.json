			"dialogs": [
				{
					"id": 200620201,
					"content": "통나무를 찾았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620202
					],
					"speakerTitle": "허먼"
				},
				{
					"id": 200620202,
					"content": "찾았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620203
					]
				},
				{
					"id": 200620203,
					"content": "음… 하하, 질이 꽤나 좋아 보이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620204
					],
					"speakerTitle": "허먼"
				},
				{
					"id": 200620204,
					"content": "츄츄족의 훈련도 견뎌냈으니 엘린의 훈련도 견뎌낼 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620205
					],
					"speakerTitle": "허먼"
				},
				{
					"id": 200620205,
					"content": "고마워. 맞다, 모험가 규칙에 따라 이건 네 보수야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "허먼"
				}
			]
		},
		{
