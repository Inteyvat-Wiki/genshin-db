			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"파르바나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220220101,
					"content": "이 레시피의 조합은 아마 이거랑 이거겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220102
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220102,
					"content": "뭐 해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220103
					]
				},
				{
					"id": 220220103,
					"content": "레시피를 정리하고 있어. 음… 근데 기억이 안 나는 레시피들이 있네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220104,
						220220106
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220104,
					"content": "동욱한테 물어보면 되잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220105
					]
				},
				{
					"id": 220220105,
					"content": "동욱이라… 내가 레시피를 기억 못 하는 건, 동욱이 종일 연구해대는 「창작 요리」 때문이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220109,
					"content": "동욱은 매번 새로운 레시피를 손에 넣을 때마다, 정석대로 요리하는 건 기껏해서 하루 이틀뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220110
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220110,
					"content": "그리고는… 여러 가지 다양한 방법으로 레시피를 「개조」하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220111,
						220220113
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220111,
					"content": "동욱은 대체 왜 그러는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220112
					]
				},
				{
					"id": 220220112,
					"content": "요리의 원가를 낮추기 위해서라고는 하는데… 나도 대체 그 녀석이 왜 그러는지 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220118,
					"content": "결과만 놓고 보면, 동욱이 그 레시피들의 개조에 성공한 건 확실해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220119
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220119,
					"content": "맛은 오리지널과 비슷하면서도 원가는 엄청나게 낮거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220120
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220120,
					"content": "내가 동욱과 동행하기로 한 건 그 어처구니없는 조리법 때문이었어. 동욱이 내 제안을 받아들인 것도 아마 내 기술 때문이겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220121,
						220220123
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220121,
					"content": "그래서, 내가 뭘 도와주면 돼?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220122
					]
				},
				{
					"id": 220220122,
					"content": "아… 맞다! 동욱 얘기를 하느라 까먹을 뻔했네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220128,
					"content": "동욱이 종일 날 끌어들여 레시피들을 개조하는 바람에, 게다가 어떤 레시피에는 낙서를 하기도 해서… 레시피의 제조법이 뒤죽박죽이 돼 버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220129
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220129,
					"content": "대조해 보게 그 레시피들을 정확하게 복원해서 보관해두고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220130
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220130,
					"content": "여행자, 레시피를 기억하고 있다면, 떠올려봐 줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220131,
						220220132
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220131,
					"content": "맡겨줘",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220133,
					"content": "그럼 부탁할게. 먼저 내가 뒤죽박죽이 되어버린 레시피를 정리할게. 확실하지 않은 부분만 살짝 수정해줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220132,
					"content": "난 티바트 대륙의 미식을 섭렵한 사람이잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220123,
					"content": "파르바나의 기술?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220124
					]
				},
				{
					"id": 220220124,
					"content": "얘기 안 했었나? 내가 아카데미아에서 연구했던 과제는 「만능 조미료」였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220125
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220125,
					"content": "쉽게 말해, 넣기만 하면 그 어떤 요리도 맛있게 만들어주는 스페셜 조미료야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220126
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220126,
					"content": "그런 조미료를 연구해내기 위해 떠돌아다니면서 각종 미식 자료를 수집하기로 결심했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220127
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220127,
					"content": "크흠, 삼천포로 빠졌네, 레시피 얘기를 계속하자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220113,
					"content": "구체적으로 어떻게 개조하는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220114
					]
				},
				{
					"id": 220220114,
					"content": "흐음… 동욱의 개조 방법은 다른 요리사들과는 달라… 다른 요리사들이 레시피를 개조하는 이유는 대개 레시피를 풍부하게 해서 더욱 비싼 값에 팔기 위해서야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220115
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220115,
					"content": "그런데 동욱의 레시피 개조는, 완전 딴판이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220116
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220116,
					"content": "예를 들어, 분명 감자… 버섯… 그리고 다른 값싼 채소들로 만든 채식 요리지만, 먹을 땐 절운고추 치킨의 맛이 나지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220117
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220117,
					"content": "그리고 감자, 쌀, 연꽃받침, 절운고추, 밀가루 반죽과 짐승고기로 만든 간편식 「선도장」도 있지. 근데 정말 신기하게 맛이 오리지널 요리와 별다른 점이 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220106,
					"content": "너흰 「미식 어벤져스」아냐?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220107
					]
				},
				{
					"id": 220220107,
					"content": "제발 부탁인데, 그 이름 좀 그만 말해줄래? 내 논문에 그 여섯 글자만큼은 절대로 넣지 않을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220108
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220220108,
					"content": "다시 말하지만 내가 레시피를 기억 못 하는 건, 동욱이 종일 연구해대는 「창작 요리」 때문이라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "파르바나"
				}
			]
		},
		{
