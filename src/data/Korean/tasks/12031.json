				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"야에 미코",
					"페이몬",
					"오카자키 리쿠토"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310401,
					"content": "꼬마들, 왔구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310402
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120310402,
					"content": "미코, 우리가 오기도 전에 먹고 있었어?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120310403,
					"content": "응, 너희가 산다며",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310404
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120310404,
					"content": "비싼 요리랑 좋은 술을 공짜로 누릴 수 있다는 생각에 얼른 와버렸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310405
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120310405,
					"content": "아, 사장님, 여기 두 사람 봤죠? 이따 얘네가 계산할 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310406
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120310406,
					"content": "예!",
