				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310201,
					"content": "하산이요? 궁사님 명령인가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310202
					],
					"speakerTitle": "마키"
				},
				{
					"id": 120310202,
					"content": "응, 미코가 행하려는 의식이 너희 몸에 영향을 끼칠 수 있대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120310203,
					"content": "그렇군요… 바로 준비하겠습니다. 두 분은요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310204
					],
					"speakerTitle": "마키"
				},
				{
					"id": 120310204,
					"content": "미코한테 부탁받은 일을 끝내고 여기로 돌아와서 같이 의식을 진행할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310205,
						120310206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120310205,
					"content": "아무래도 걱정돼서요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				},
				{
					"id": 120310207,
					"content": "궁사님이 두 분을 많이 신뢰하시나 보네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310208
					],
					"speakerTitle": "마키"
				},
				{
					"id": 120310208,
					"content": "예전에 이런 중요한 의식을 행하실 땐 곁에 아무도 두지 않으셨거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310209
					],
					"speakerTitle": "마키"
				},
				{
					"id": 120310209,
					"content": "그럼 의식을 잘 부탁드리겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310210
					],
					"speakerTitle": "마키"
				},
				{
					"id": 120310210,
					"content": "우리 엄청 강하니까 걱정 붙들어 매!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120310206,
					"content": "요괴를 가까이서 보고 싶어서요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				}
			]
		},
		{
			"id": 1203104,
			"completionStepIds": [
				1203106
