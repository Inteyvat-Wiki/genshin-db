				"points": []
			},
			"dialogs": [
				{
					"id": 722720102,
					"content": "팔고 싶은 보물이 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720103
					]
				},
				{
					"id": 722720103,
					"content": "응? 우리 가게는 이미 고정 수입 루트가 있고, 평소 따로 구매하진 않는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720104
					],
					"speakerTitle": "미코시 겐이치로"
				},
				{
					"id": 722720104,
					"content": "근데 네 모습을 보아하니… 대단한 물건인가 봐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720105
					],
					"speakerTitle": "미코시 겐이치로"
				},
				{
					"id": 722720105,
					"content": "그렇다면… 일단 한번 보여줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720106
					],
					"speakerTitle": "미코시 겐이치로"
				},
				{
					"id": 722720106,
					"content": "용 뼈의 꽃 결정 이야기를 미코시 겐이치로에게 말한다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722720107
					]
				},
				{
					"id": 722720107,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720108
					],
					"speakerTitle": "미코시 겐이치로"
				},
				{
					"id": 722720108,
					"content": "솔직히… 이야기는 신기한데… 너무 신기한 감이 있단 말이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720109
					],
					"speakerTitle": "미코시 겐이치로"
				},
				{
					"id": 722720109,
					"content": "이런 물건은 이미 내 상상력의 한계를 뛰어넘어 버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720110
					],
					"speakerTitle": "미코시 겐이치로"
				},
				{
					"id": 722720110,
					"content": "비웃진 마. 난 수공예품이나 조금 만들 줄 아는 녀석일 뿐이니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720120
					],
					"speakerTitle": "미코시 겐이치로"
				},
				{
					"id": 722720120,
					"content": "그럼 이렇게 하자. 80000모라에 모둠 회 5인분, 이런 요리는 비싸다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "미코시 겐이치로"
				},
				{
					"id": 722720111,
					"content": "이 가격이 괜찮다면 내가 이 보물을 살게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720112,
						722720115,
						722720117
					],
					"speakerTitle": "미코시 겐이치로"
				},
				{
					"id": 722720112,
					"content": "이걸로 뭐 하려고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720113
					]
				},
				{
					"id": 722720113,
					"content": "아직은 얘기해줄 수 없어. 물건을 더 자세하게 살펴봐야 해서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720114
					],
					"speakerTitle": "미코시 겐이치로"
				},
				{
					"id": 722720114,
					"content": "상태가 괜찮으면 특별한 네쓰케로 가공할 수 있을지도 몰라. 그러면 더 비싸게 팔 수 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720111
					],
					"speakerTitle": "미코시 겐이치로"
				},
				{
					"id": 722720115,
					"content": "적당한 가격이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720116
					]
				},
				{
					"id": 722720116,
					"content": "그럼 모라 잘 넣어둬. 난 물건을 제대로 연구해봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "미코시 겐이치로"
				},
				{
					"id": 722720117,
					"content": "생각해 볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722720118
					]
				},
				{
					"id": 722720118,
					"content": "응… 마침 나도 더 생각해 봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722720119
					],
					"speakerTitle": "미코시 겐이치로"
				},
				{
					"id": 722720119,
					"content": "결정하면 다시 날 찾아와",
