				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751780501,
					"content": "이방의 용사, 어때? 「최강자」를 찾기 위한 여정은 순조로워?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780502,
						751780503
					],
					"speakerTitle": "로쉬츠"
				},
				{
					"id": 751780502,
					"content": "「최강자」의 위치에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780504
					]
				},
				{
					"id": 751780504,
					"content": "산으로 가면 「열기의 물」이 가득한 산간 지역에 도착하게 될 거야. 그곳에서 「최강자」를 만날 수 있을지도 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "로쉬츠"
				},
				{
					"id": 751780503,
					"content": "노력하고 있어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780505
					]
				},
				{
					"id": 751780505,
					"content": "좋아, 아주 좋아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "로쉬츠"
