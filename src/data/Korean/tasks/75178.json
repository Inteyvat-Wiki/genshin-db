					"nextDialogs": [
						751781009
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751781009,
					"content": "휴… 좀 더 현실적인 방법이 없으려나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781010
					],
					"speakerTitle": "페이몬"
				},
				{
