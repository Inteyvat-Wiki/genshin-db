					"nextDialogs": [
						223020502
					]
				},
				{
					"id": 223020502,
					"content": "응응! 딱 살짝만 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 223020503,
					"content": "그나저나 이 소년… 설마 상구야 씨 본인은 아니겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 223020504,
					"content": "마음은 아직 청춘인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 223020505,
					"content": "음, 역시 빨리 이 책을 <color=#00E1FFFF>비운상회</color>에 가져다 주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
