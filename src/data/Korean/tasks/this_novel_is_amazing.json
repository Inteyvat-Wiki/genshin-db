			},
			"dialogs": [
				{
					"id": 223020201,
					"content": "저 앞이 바로 <color=#00E1FFFF>비운상회</color>일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 223020202,
					"content": "책을 <color=#00E1FFFF>입구에 있는 저 사람</color>에게 전해주면 되겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 223020203,
					"content": "근데… 궁금하다, 대체 어떤 소설일까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 223020204,
					"content": "어때? 몰래 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
