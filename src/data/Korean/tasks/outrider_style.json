					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"엠버"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850601,
					"content": "괴조를 잡았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850602
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850602,
					"content": "사실, 공중에서만 발견할 수 있는 윈드 필드가 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850603
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850603,
					"content": "괴조가 도망친 방향은 완전히 막다른 길이었던 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850604
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850604,
					"content": "그러니까 괴조가 도망치려면 반드시 우리 쪽을 지나가야 했던 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850605
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850605,
					"content": "아——계속 허세를 부린 게 우릴 포기하게 만들고, 자긴 다시 날아와서 도망치려던 거구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4850606,
					"content": "하지만, 우리도 쉽게 속아주진 않지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850607
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4850607,
					"content": "#다 {NICKNAME}의 분석 덕이야. 「모든 오답을 제외하면 아무리 이상해도 그게 정답이다」라는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850608
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850608,
					"content": "어쨌든 비행에 숙달되려면 7%의 기술, 3%의 직감, 그리고 90%의 용기가 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850609
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850609,
					"content": "방금 건 99%의 용기인 걸로 보였는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850610
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4850610,
					"content": "에이, 이건 내가 처음 비행 면허 시험 볼 때랑 똑같지…. 많이 긴장하긴 했지만, 그래도 아슬아슬하게 통과했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850611
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850611,
					"content": "근데 다음 몇 번 시험은 그런 긴장감이 없더라고. 뭔가 빠진 느낌이랄까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850612
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850612,
					"content": "너… 잠깐, 이미 비행 허가증을 받았는데, 무슨 시험을 또 본 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850613
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4850613,
					"content": "아, 그거… 몬드성 안은 곳곳이 비행 금지에 착륙 금지여서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850614
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850614,
					"content": "내 비행 허가증이 자꾸 취소당했거든, 그래서 시험을 15번이나 다시 봤지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850615
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850615,
					"content": "하지만 재시험을 볼 때마다 바로 통과했어. 역시 내 가이드가 최고라니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850616
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850616,
					"content": "#…{NICKNAME}, 나중에 시간이 되면 진 단장에게 진짜 비행 가이드를 받으러 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850617,
						4850618
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4850617,
					"content": "그래…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850619
					]
				},
				{
					"id": 4850619,
					"content": "아무튼, 난 괴조를 몬드성으로 압송해야 해서, 먼저 가볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850620
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850620,
					"content": "몬드성으로 돌아오면 비행 허가증을 줄 테니까, 꼭 성당으로 날 찾아와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850618,
