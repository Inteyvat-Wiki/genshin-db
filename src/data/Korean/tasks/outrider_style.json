					"nextDialogs": [],
					"speakerTitle": "엠버"
				},
				{
					"id": 4851103,
					"content": "하지만 밑에 적이 너무 많은데, 이대로 날면 적에게 공격당할 거야",
					"roleType": "TALK_ROLE_NPC",
