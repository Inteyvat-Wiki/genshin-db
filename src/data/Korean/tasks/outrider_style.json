					"엠버"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850301,
					"content": "앞에 길도 없어 보이는데… 대체 어디에 숨은 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850302
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850302,
					"content": "엠버, 맞은 편을 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4850303,
					"content": "역시 쫓아온 건가, 어쩔 수 없군…. 엥? 꼬맹이잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850304
					],
					"speakerTitle": "「괴조」"
				},
				{
					"id": 4850304,
					"content": "네가 바로 「괴조」구나! 도망칠 생각은 버려라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850305
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850305,
					"content": "하하하, 도망갈 필요도 없어, 어차피 넌 여기에 오지도 못하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850306
					],
					"speakerTitle": "「괴조」"
				},
				{
					"id": 4850306,
					"content": "으——이 절벽은 확실히 높고 멀어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850307
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850307,
					"content": "꼬맹이, 차라리 돌아가서 단장을 불러와. 그럼 내가 항복할지도 모르지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850308
					],
					"speakerTitle": "「괴조」"
				},
				{
					"id": 4850308,
					"content": "페보니우스 기사단의 정찰 기사를 도발하는 거야? 지금 당장 날아가서 널 잡아주지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850309,
						4850310
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850309,
					"content": "일단 진정해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				},
				{
					"id": 4850311,
					"content": "우… 네 말이 맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850312
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850312,
					"content": "젠장, 맞은 편에 있는데. 바로 날아갈 수만 있었어도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850313
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850313,
					"content": "그런데 괴조는 어떻게 건너간 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850314,
						4850317,
						4850319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4850314,
					"content": "오갈 수 있는 장치라도 있는 걸까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850315
					]
				},
				{
					"id": 4850315,
					"content": "장치를 쓴 흔적은 없는 거 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850316
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850316,
					"content": "게다가 주변에는 장치를 설치할만한 암벽도 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850322,
					"content": "잘 있어라, 꼬맹아——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850323
					],
					"speakerTitle": "「괴조」"
				},
				{
					"id": 4850323,
					"content": "앗, 녀석이 도망친다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850324
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4850324,
					"content": "더는 미룰 수 없어. 절벽을 넘으려면 「비행」뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850325
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850325,
					"content": "하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850326
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4850326,
					"content": "걱정 마, 난 몬드성의 비행 챔피언이라고. 괴조가 날아갈 수 있다면, 나도 할 수 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850327
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850327,
					"content": "거기, 정찰 기사, 죽고 싶은 거라면 차라리 바람의 날개 없이 몬드성 바람의 신의 신상에서 뛰어내리라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850328,
						4850329
					],
					"speakerTitle": "「괴조」"
				},
				{
					"id": 4850328,
					"content": "엠버의 말이 무슨 뜻인지 알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850330,
					"content": "#맞는 말이야…. 비행 외의 가능성은 {NICKNAME}도 없다고 생각하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850331
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4850331,
					"content": "#{NICKNAME}, 내가 잘못 가져온… 그 가이드가 아닌 가이드 기억 나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850332
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850332,
					"content": "「최초에 새는 날지 못했어, 후에 날 수 있게 된 건 그들이 용감하게 협곡으로 뛰어든 보상이야」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850333
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850333,
					"content": "이제, 네 두 눈으로 확인할 차례야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850334
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850334,
					"content": "힘내! 정찰 기사!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850335
					]
				},
				{
					"id": 4850335,
					"content": "좋아! 저놈에게 정찰 기사의 용기를 보여주자고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850336
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850336,
					"content": "노, 농담 마라. 여긴 날아올 수 없어! 얌전히 돌아가라고, 꼬맹이!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850337
					],
					"speakerTitle": "「괴조」"
				},
				{
					"id": 4850337,
					"content": "괴조, 넌 그렇게 생각해? 하지만 잘 들어봐, 주변의 작은 소리를…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850338
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850338,
					"content": "바람이——날 수 있다고 말했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850329,
					"content": "용기가 필요하지만, 이건 자살이 아니야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850317,
					"content": "혹시 어떤 원소 마법을 활용한 건 아닐까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850318
					]
				},
				{
					"id": 4850318,
					"content": "혹시 원소 시야엔 흔적이 보여? …아, 역시 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4850319,
					"content": "고리나 가시못 같은 걸 사용했나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850320
					]
				},
				{
					"id": 4850320,
					"content": "날아가지도 못하는데, 이런 걸 던질 수도 없겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850321
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4850321,
					"content": "땅에도 못을 박은 흔적이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4850310,
					"content": "주위를 먼저 살펴…. 네가 가르쳐줬잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				}
			]
		},
		{
			"id": 48506,
			"completionStepIds": [
				48506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48506",
