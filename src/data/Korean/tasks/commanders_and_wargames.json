							222.824,
							320.688
						],
						"pointId": 310702021
					}
				]
			},
			"dialogs": [
				{
					"id": 711440301,
					"content": "#조각 같은 얼굴과 독보적인 아우라로 봤을 때… 당신이 바로 소문으로만 듣던 장군감 {NICKNAME} 님인가 보군요. 맞죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440302
					],
					"speakerTitle": "소정"
				},
				{
					"id": 711440302,
					"content": "당신의 명성은 익히 들었습니다. 안 그래도 가상 모의전에 참석해 달라고 모험가 길드에 부탁할 참이었는데, 눈치채고 직접 와주시다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440303,
						711440304
					],
					"speakerTitle": "소정"
				},
				{
					"id": 711440303,
					"content": "장군감요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440305
					]
				},
				{
					"id": 711440305,
					"content": "#엄청 진지하네! {NICKNAME}을(를)… 무슨 직업 군인이라도 되는 것처럼 대하잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711440306,
					"content": "군인 그 이상이죠! 5개국을 유랑하면서 수많은 마물과 강적을 상대한 당신의 업적은, 각국의 부대가 빠짐없이 기록하고 끊임없이 분석했답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440307
					],
					"speakerTitle": "소정"
				},
				{
					"id": 711440307,
					"content": "페보니우스 기사단에서부터 천암군, 막부 무사, 30인단, 법률 집행청까지——모든 부대가 당신의 전투력과 지략을 최상급으로 평가했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440308
					],
					"speakerTitle": "소정"
				},
				{
					"id": 711440308,
					"content": "#「{NICKNAME}의 재능이라면 최전선 전투 임무 수행부터 후방에서의 지휘통제까지 모든 역할을 맡을 수 있다. 가능하다면 적극적으로 협력 관계를 구축하라」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440309
					],
					"speakerTitle": "소정"
				},
				{
					"id": 711440309,
					"content": "그래서 천암군 참모부를 대표해, 당신을 정식으로 우리 5국 연합 모의전의 고급 고문 자격으로 초대하고 싶습니다. 어떻게 생각하십니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440310
					],
					"speakerTitle": "소정"
				},
				{
					"id": 711440310,
					"content": "고급 고문의 보수는 상당히 후한 편이라서, 모의전 기간 동안 천암군 교관 수준의 일당을 받을 수 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440311
					],
					"speakerTitle": "소정"
				},
				{
					"id": 711440311,
					"content": "누가 천암군 아니랄까 봐 정말 직설적이네… 하지만 교관급의 보수라면 구미가 당기는걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440312,
						711440313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711440312,
					"content": "저희는 아직 상황조차 파악하지 못했는걸요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440314
					]
				},
				{
					"id": 711440314,
					"content": "걱정하실 것 없습니다. 제가 다 설명해 드리죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440315
					],
					"speakerTitle": "소정"
				},
				{
					"id": 711440315,
					"content": "아시다시피 티바트의 황야에는 여전히 수많은 마물이 떠돌고 있습니다. 단기간에 녀석들을 뿌리 뽑기는 어렵죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440316
					],
					"speakerTitle": "소정"
				},
				{
					"id": 711440316,
					"content": "마물의 위협에 보다 효율적으로 대응하고자, 우방 국가의 부대와 협력해서 조사한 마물의 위험성을 상세하게 분석해 공유하고 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440317
					],
					"speakerTitle": "소정"
				},
				{
					"id": 711440317,
					"content": "그리고 천암군 참모부는 모의전 보드게임을 만들고 마물끼리 서로 모의 전투를 벌이게 해, 녀석들의 전투력을 분석하고 있죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440318
					],
					"speakerTitle": "소정"
				},
				{
					"id": 711440318,
					"content": "이번 「연합 모의전」의 목적은, 여러 전투원을 초대해 다양한 방식으로 게임을 진행하고 마물의 약점을 찾는 것입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440319
					],
					"speakerTitle": "소정"
				},
				{
					"id": 711440319,
					"content": "#{NICKNAME} 님은 어느 부대에도 속해있지 않은 전술 천재니까, 당신이라면 폭넓은 분석적 시각으로 모의전의 효율을 대폭 끌어올려 주실 것이라 생각하고 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440320
					],
					"speakerTitle": "소정"
				},
				{
					"id": 711440320,
					"content": "무슨 말인지 알 것 같아. 마물에 대응할 수 있는… 가장 쉽고 안전한 방법에 대해 논의하고 있다는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440321
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711440321,
					"content": "드디어 전문 분야가 나왔네! 우린 수많은 곳에서 위험한 녀석들을 만나 봤고, 보드게임도 많이 해봤거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440322
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711440322,
					"content": "보드게임을 하면 여러 나라의 치안을 개선하고 푸짐한 보수도 받을 수 있다니… 이런 걸 세 마리 토끼 잡기라고 해야겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440323,
						711440325
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711440323,
					"content": "가볍게 보드게임을 즐기면 큰 도움을 줄 수 있다니!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440324
					]
				},
				{
					"id": 711440324,
					"content": "바로 그 자세입니다. 여유롭게 도전에 응해, 자연스럽게 솜씨를 펼쳐서 문제를 해결하는 거죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440327
					],
					"speakerTitle": "소정"
				},
				{
					"id": 711440327,
					"content": "보드게임은 준비됐으니까 언제든지 모의전을 시작할 수 있습니다. 우리에게 장군감의 전략을 한 수 보여주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소정"
				},
				{
					"id": 711440325,
					"content": "진지하게 임해야 하나 보네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440326
					]
				},
				{
					"id": 711440326,
					"content": "긴장 푸세요. 평소에 마물을 상대할 때처럼 임하시면 됩니다. 다들 당신은 늘 평정심을 잃지 않는다고 하던걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440327
					],
					"speakerTitle": "소정"
				},
				{
					"id": 711440313,
					"content": "저희는 아직 모의전에 대해 전혀 몰라요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440314
					]
				},
				{
					"id": 711440304,
					"content": "모의전이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440305
					]
				}
			]
		}
	]
}