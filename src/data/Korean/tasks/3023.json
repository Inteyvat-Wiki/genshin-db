			"dialogs": [
				{
					"id": 30230401,
					"content": "요즘 처리한 일은 전부 다 어려운 일들이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230402
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 30230402,
					"content": "게다가 이렇게 어려운 일들을 처리했는데 수입이 하나도 없다니, 정말 믿기지 않는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230403
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 30230403,
					"content": "좋게 생각해, 일이 끝나고 대박 날지 누가 알아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30230404,
					"content": "맞아, 음, 만약 갑자기 부자가 된다면 뭘 하고 싶어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230405
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 30230405,
					"content": "맛있는 것들을 엄청 많이 사 먹고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30230406,
					"content": "그게 다야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230407
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 30230407,
					"content": "음… 마실 것도 좀 살까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30230408,
					"content": "하하하, 귀엽네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230409
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 30230409,
					"content": "그럼 아름다운 꿈을 위해… 나도 노력할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230410
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 30230410,
					"content": "앞으로 우리가 할 모든 일이 지금보다 더 나은 세상을 만들었으면 좋겠어",
