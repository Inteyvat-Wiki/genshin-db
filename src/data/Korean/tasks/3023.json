			"dialogs": [
				{
					"id": 30230201,
					"content": "조급해하지 마. 이렇게 큰일을 바로 준비하는 건 불가능해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230202
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 30230202,
					"content": "합리적인 계획을 세울 수 있도록 천천히 생각해보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230203
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 30230203,
					"content": "말하면서 또 책을 보다니. 이봐! 자꾸 그럴래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30230204,
					"content": "책 한 권 빌려줄까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230205
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 30230205,
					"content": "됐어, 네가 읽는 책들은 내 취향 아니거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30230206,
					"content": "농담이야. 내 책이 네 수준에 안 맞기는 하지. 빌려 달라고 해도 못 빌려줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230207
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 30230207,
					"content": "아——! 열받아…",
					"roleType": "TALK_ROLE_NPC",
