		},
		{
			"id": 7516504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516504",
							"2"
						],
						"stepId": 7516504,
						"stateName": "QUEST_STATE_UNFINISHED"
