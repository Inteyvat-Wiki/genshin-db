				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"이이마니"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650401,
					"content": "거기, 지나가던 용사! 그래, 바로 너",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650402
					],
					"speakerTitle": "이이마니"
				},
				{
					"id": 751650402,
					"content": "휴, 너 너무 마른 것 같은데… 밥은 잘 챙겨 먹고 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650406,
						751650404
					],
					"speakerTitle": "이이마니"
				},
				{
					"id": 751650406,
					"content": "가이드인 페이몬이 제 몫까지 다 먹어버렸어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650403
					]
				},
				{
					"id": 751650403,
					"content": "어떤 이유나 사정이 있든지 간에, 일단 밥을 잘 먹어야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "이이마니"
				},
				{
					"id": 751650408,
					"content": "테테오칸에 왔으니 「비옥한 터전」의 천하장사들은 만나 봤겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650409
					],
					"speakerTitle": "이이마니"
				},
				{
					"id": 751650409,
					"content": "양심상 충고 하나 하지. 절대로 근육을 찬양하는 녀석들을 믿어선 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650410
					],
					"speakerTitle": "이이마니"
				},
				{
					"id": 751650410,
					"content": "지방이야말로 신이 내린 귀중한 선물이라고. 하지만 보기 좋은 근육을 만들기 위해선 모든 맛있는 음식을 끊고 지방을 없애야 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650411
					],
					"speakerTitle": "이이마니"
				},
				{
					"id": 751650411,
					"content": "정말 바보 같은 짓이 아닐 수 없다니까. 숲멧돼지도 가엾게 여길걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650412
					],
					"speakerTitle": "이이마니"
				},
				{
					"id": 751650412,
					"content": "게다가 근육질 몸매를 찬양하는 분위기도 최근 몇십 년 사이의 일이라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650413
					],
					"speakerTitle": "이이마니"
				},
				{
					"id": 751650413,
					"content": "우리 할아버지가 그러셨는데, 할아버지가 젊으셨을 때는 다들 약간 통통한 체형을 좋아했다고 하셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650414
					],
					"speakerTitle": "이이마니"
				},
				{
					"id": 751650414,
					"content": "그러니까 다른 사람의 말만 듣고 체중 감량의 길로 들어서는 건 옳지 않아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650415
					],
					"speakerTitle": "이이마니"
				},
				{
					"id": 751650415,
					"content": "하지만 너도 언젠가 「비옥한 터전」의 내 친척들처럼 힘을 키우기 위해 체중 감량을 하게 될지도 모르지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650416
					],
					"speakerTitle": "이이마니"
				},
				{
					"id": 751650416,
					"content": "하지만 꼭 기억해 둬! 민첩함만 놓고 보면, 살집이 있는 전사들도 물고기처럼 유연하게 움직일 수 있고, 힘만 따지자면 빼빼 마른 녀석들은 우리의 상대가 안 된다는 사실을 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650417
					],
					"speakerTitle": "이이마니"
				},
				{
					"id": 751650417,
					"content": "증거가 있냐고? 이 훈련장에 있는 항아리가 바로 그 증거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650418
					],
					"speakerTitle": "이이마니"
				},
				{
					"id": 751650418,
					"content": "난 이 몸으로도 <color=#00E1FFFF>항아리를 쓰러뜨리지 않고 빠르게 통과할 수 있어</color>. 이 정도 수준의 민첩성은 빼빼 마른 녀석들이라도 쉽지 않을걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650419
					],
					"speakerTitle": "이이마니"
				},
				{
					"id": 751650419,
					"content": "보아하니 웃음을 참고 있는 모양인데…. 뭐, 됐어. 믿지 않을 줄 알았으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650420
					],
					"speakerTitle": "이이마니"
				},
				{
					"id": 751650420,
					"content": "자, 그럼 직접 해봐. 가장 빠른 속도로 이 훈련장을 통과하는 거야. 단, <color=#00E1FFFF>항아리를 부숴선 안 돼</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650421
					],
					"speakerTitle": "이이마니"
				},
				{
					"id": 751650421,
					"content": "과연 내 점수를 넘을 수 있는지 한번 확인해 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이이마니"
				},
				{
					"id": 751650404,
					"content": "와, 밥을 사주시는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650407
					]
				},
				{
					"id": 751650407,
					"content": "그런 뜻은 아니었지만…. 정 배가 고프면 내 배낭에 구운 고기가 있긴 해. 일단 이 얘긴 잠시 접어두고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "이이마니"
				}
			]
		},
