				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"수리키"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650201,
					"content": "안녕, 지나가던 용사. 테테오칸에 온 걸 보니, 너도 힘을 추구하는 모양이네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650202
					],
					"speakerTitle": "수리키"
				},
				{
					"id": 751650202,
					"content": "그럼 이미 「비옥한 터전」의 천하장사들을 봤겠구나. 흥, 다들 한 근육들 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650203
					],
					"speakerTitle": "수리키"
				},
				{
					"id": 751650203,
					"content": "몸집이 작은 걸 보니… 매일 무게나 치고 벤치 프레스나 하는 헬스광은 아닌 모양이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650204
					],
					"speakerTitle": "수리키"
				},
				{
					"id": 751650204,
					"content": "너한테만 알려주는 건데, 그거 다 사기니까 속지 않는 게 좋을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650205,
						751650206
					],
					"speakerTitle": "수리키"
				},
				{
					"id": 751650205,
					"content": "운동을 싫어하세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				},
				{
					"id": 751650207,
					"content": "꼭 그런 건 아니지만, 용사의 힘이 근육에서 나온다는 건 허무맹랑한 얘기야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650208
					],
					"speakerTitle": "수리키"
				},
				{
					"id": 751650208,
					"content": "고대 영웅의 몸에는 근육만 있을 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650209
					],
					"speakerTitle": "수리키"
				},
				{
					"id": 751650209,
					"content": "그들의 생존 환경은 지금보다 훨씬 열악했거든. 게다가 실전에서 생존과 방어가 중요하니까 분명 지방도 적당량 있었을 거라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650210
					],
					"speakerTitle": "수리키"
				},
				{
					"id": 751650210,
					"content": "그들의 체형은 아마 내 체형과 더 비슷하지 않았을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650211
					],
					"speakerTitle": "수리키"
				},
				{
					"id": 751650211,
					"content": "고대 영웅들은 나처럼 약간 살집이 있는 체형이었을 거야. 강력하면서도 민첩한 체형 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650212
					],
					"speakerTitle": "수리키"
				},
				{
					"id": 751650212,
					"content": "하지만 부족 사람들은 이 사실을 모르는 것 같더라고. 휴, 어리석기는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650213
					],
					"speakerTitle": "수리키"
				},
				{
					"id": 751650213,
					"content": "표정을 보아하니 너도 못 믿는 눈치네…. 음, 이렇게 하면 어떨까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650214
					],
					"speakerTitle": "수리키"
				},
				{
					"id": 751650214,
					"content": "내가 준비한 항아리 부수기 도전을 해 보는 거야! 여긴 내가 운동을 하려고 마련한 곳인데 너라면 써도 괜찮아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650215
					],
					"speakerTitle": "수리키"
				},
				{
					"id": 751650215,
					"content": "한번 해보면 알 거야. 몸집이 큰 게 실전에서 얼마나 도움이 되는지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "수리키"
				},
				{
					"id": 751650206,
					"content": "근육이 있는 게 싫으세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				}
			]
		},
		{
			"id": 7516503,
