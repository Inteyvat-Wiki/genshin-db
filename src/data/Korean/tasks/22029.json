				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290301,
					"content": "후… 후… 실력이 장난 아닌데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290302
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290302,
					"content": "많이… 배웠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290303,
						220290304
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290303,
					"content": "괜, 괜찮으세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				},
				{
					"id": 220290305,
					"content": "괜… 괜찮아, 숨 좀 돌리면 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290306
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290306,
					"content": "하지만 이렇게까지 강할 줄이야. 정말 드래곤을 쓰러뜨렸다 해도 믿겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290307
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290307,
					"content": "정말 드래곤을 쓰러뜨린 적이 있는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290308
					]
				},
				{
					"id": 220290308,
					"content": "하하하… 물론 믿어. 오늘 나랑 대련해줘서 고마워. 오늘의 비무를 가슴에 새길게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290309
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290309,
					"content": "괜찮다면 앞으로도 종종 대련하러 와줄래? 너처럼 대단한 실력자가 대련 상대가 되어준다면… 그 일을 해낼 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290310
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290310,
					"content": "그 일이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290311
					]
				},
				{
					"id": 220290311,
					"content": "크흠… 내 작은 소원일 뿐이야. 어쨌든 고마웠어. 이건 보수야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290312
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290312,
					"content": "난 돌아가서 좀 쉬어야겠다. 네… 네 기술들은 정말로 대단해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290304,
					"content": "미안해요, 힘 조절에 실패하는 바람에…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				}
			]
		},
