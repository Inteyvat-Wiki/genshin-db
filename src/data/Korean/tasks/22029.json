			"dialogs": [
				{
					"id": 220290201,
					"content": "혹시 아까 봐준 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290202
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290202,
					"content": "그럴 필요 없어! 전력으로 임해줘. 난… 난 반드시 강해져야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아사쿠라"
				}
			]
		},
		{
