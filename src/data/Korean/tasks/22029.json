				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290101,
					"content": "난 반드시! 반드시…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290102
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290102,
					"content": "응? 넌?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290103
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290103,
					"content": "당신의 의뢰를 받고 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290104
					]
				},
				{
					"id": 220290104,
					"content": "아, 그 수련 상대 의뢰구나. 맞아, 내가 벽보를 붙였지. 대련할 상대를 찾고 싶었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290105
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290105,
					"content": "네가 내 의뢰를 받은 거야? 하지만 성에서 널 본 적이 없었던 거 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290106
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290106,
					"content": "미안, 네 실력을 의심하는 건 아냐. 하지만 네 무예 실력이 어떤지 몰라서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290107,
						220290109
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290107,
					"content": "저는 드래곤을 처치한 적이 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290108
					]
				},
				{
					"id": 220290108,
					"content": "하하하… 정말? 어디서 드래곤을 찾았는지가 더 궁금한데, 난 소문으로만 들은 게 전부라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290112,
					"content": "저 싸움 좀 하거든요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290113
					]
				},
				{
					"id": 220290113,
					"content": "하하, 무예라는 건 말로는 알 수 없으니까 대결로 실력을 가늠해보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290114,
						220290115
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290114,
					"content": "같은 생각이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220290115,
					"content": "잠깐, 근데 왜 익명으로 의뢰를 게시한 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290116
					]
				},
				{
					"id": 220290116,
					"content": "그, 그건 사실… 좀 부끄러운 사정이 있어서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290117
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290117,
					"content": "크흠, 하지만 넌 내 의뢰를 받은 사람이니까 솔직하게 말할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290118
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290118,
					"content": "얼마 전, 동료들과 임무를 집행하고 복귀하는 길에 상단을 기습하려는 해란귀를 발견했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290119
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290119,
					"content": "우린 다급히 상단을 구조하러 갔지. 처음엔 우리가 우세였고 해란귀들도 금방 후퇴했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290120
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290120,
					"content": "그런데 막 한숨 돌리려고 하는 순간, 옆에서 또 해란귀 패거리가 나타났어. 두목으로 보이는 자가 그들을 통솔하고 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290121
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290121,
					"content": "우린 미처 손쓸 새도 없이 속수무책으로 당했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290122
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290122,
					"content": "불리해진 우리는 해란귀의 공세를 막으면서 상인들이 성안으로 후퇴하는 걸 엄호하는 수밖에 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290123
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290123,
					"content": "그런데 그 해란귀 두목과 싸울 때… 그자한테 무기를 빼앗겼어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290124
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290124,
					"content": "게다가 그놈은 내 무기를 빼앗아간 후, 그걸 들고 껄껄 웃는 거야. 정말 굴욕적이었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290125
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290125,
					"content": "상인들은 어떻게 됐어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290126
					]
				},
				{
					"id": 220290126,
					"content": "후퇴할 때 순찰하러 나온 다른 도신들을 만나게 됐어. 해란귀들도 우리 동료들을 보고 전부 후퇴했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290127
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290127,
					"content": "상인들은 성안으로 호송했지만, 상단의 화물들은… 휴, 전부 내 무예가 부족한 탓이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290128
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290128,
					"content": "돌아간 후 새로운 무기를 받긴 했지만 그 일이 자꾸 마음에 걸려서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290129
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290129,
					"content": "그래서 의뢰를 게시한 거야. 대련으로 무예를 연마하려고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290130
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290130,
					"content": "충분히 강해지면 직접 그 해란귀를 찾아가 무기를 회수할 거야! 이 굴욕을 갚아줘야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290109,
					"content": "저는 신의 죽음을 목격한 적이 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290110
					]
				},
				{
					"id": 220290110,
					"content": "엣, 그 말은… 리월에서 「청신의례」에 참여했구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290111
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220290111,
					"content": "하하하, 네 말대로라면 리월에는 「신의 죽음의 증인」이 많겠구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "아사쿠라"
				}
			]
		},
