			"dialogs": [
				{
					"id": 230360601,
					"content": "좋아요, 이제 낚시를 시작할게요. 이번에는 분명 큰 물고기를 낚을 수 있을 겁니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360602
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 230360602,
					"content": "케이반이 직접 만든 낚시용 미끼로 낚시를 시작한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230360603
					]
				},
				{
					"id": 230360603,
					"content": "한참이 흐른 뒤, 케이반이 축축하게 젖은 상자 하나를 낚았다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230360604
					]
				},
				{
					"id": 230360604,
					"content": "이건 뭐죠? 어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360605
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 230360605,
					"content": "응? 누군가 잃어버린 물건 같은데요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360606,
						230360607
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 230360606,
					"content": "역시 케이반 씨네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360608
					]
				},
				{
					"id": 230360608,
					"content": "음… 케이반 씨가 학자와 함께 낚시용 미끼를 보완한 뒤로 계속 야외에서 낚시를 하고 있어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360609
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 230360609,
					"content": "하지만 케이반 씨는 항상 이상한 물건만 낚았죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360610
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 230360610,
					"content": "누군가 잃어버린 물건, 강바닥에 있는 광석, 배에서 떨어진 짐들…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360611
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 230360611,
					"content": "물에 빠진 모험가까지 케이반 씨의 낚싯줄을 잡고 올라왔다니까요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360612
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 230360612,
					"content": "그런데 물고기는 단 한 마리도 낚을 수 없었어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360613
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 230360613,
					"content": "제 낚시 인생도 여기서 끝인가 봐요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360614
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 230360614,
					"content": "케, 케이반 씨! 기운 내세요. 이… 이것 좀 보세요. 물건의 주인은 아마 이걸 애타게 찾고 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360615
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 230360615,
					"content": "케이반 씨가 이걸 낚았다는 걸 알면 분명 기뻐할 거라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360616
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 230360616,
					"content": "물건을 모험가 길드에 돌려주면 보수를 받을 수 있을지도 몰라요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360617
					],
					"speakerTitle": "호베트"
				},
				{
					"id": 230360617,
					"content": "하지만! 전 진짜! 그냥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360618
					],
					"speakerTitle": "케이반"
				},
				{
					"id": 230360618,
					"content": "물고기를 낚고 싶다고요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "케이반"
				},
				{
					"id": 230360607,
					"content": "「또」?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360608
					]
				}
			]
		},
