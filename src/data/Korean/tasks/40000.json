				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400000201,
					"content": "어서 오세요! 「기관 디펜스」 하러 오셨나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000202
					],
					"speakerTitle": "서금"
				},
				{
					"id": 400000202,
					"content": "「기관 디펜스」요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000203
					]
				},
				{
					"id": 400000203,
					"content": "아, 잘 모르시나 보네요…. 「기관 디펜스」는 제가 발명한 보드게임이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000204
					],
					"speakerTitle": "서금"
				},
				{
					"id": 400000204,
					"content": "탁자 위에 있는 이 소품들 보이시죠? 전부 「기관 디펜스」에 필요한 도구들이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000205
					],
					"speakerTitle": "서금"
				},
				{
					"id": 400000205,
					"content": "엄청 복잡해 보여요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000206
					]
				},
				{
					"id": 400000206,
					"content": "보기엔 복잡해 보이지만, 실제로 해보면 되게 쉬워요. 몇 번만 해보면 바로 익히실 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000207
					],
					"speakerTitle": "서금"
				},
				{
					"id": 400000207,
					"content": "어때요? 한번 해보실래요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000208,
						400000209
					],
					"speakerTitle": "서금"
				},
				{
					"id": 400000208,
					"content": "한 판에 얼마죠…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				},
				{
					"id": 400000210,
					"content": "아니에요. 마침 해등절이라 사람들이 「기관 디펜스」에 대해 어떻게 평가하는지 확인도 할 겸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000211
					],
					"speakerTitle": "서금"
				},
				{
					"id": 400000211,
					"content": "지금은 「소등」 하나만 있으면 한 판 즐기실 수 있답니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000212
					],
					"speakerTitle": "서금"
				},
				{
					"id": 400000212,
					"content": "하고 싶다면 「소등」을 가져와 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000213
					],
					"speakerTitle": "서금"
				},
				{
					"id": 400000213,
					"content": "어때요? 한번 해보세요. 첫판은 소등도 안 받을게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "서금"
				},
				{
					"id": 400000209,
					"content": "꽤 비싸겠네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				}
			]
		},
