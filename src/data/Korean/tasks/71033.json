					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331005
					],
					"speakerTitle": "청주"
				},
				{
					"id": 710331005,
					"content": "여행자, 이 소등을 좀 높이 걸어줄 수 있나요?",
					"roleType": "TALK_ROLE_NPC",
