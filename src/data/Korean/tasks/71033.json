			},
			"dialogs": [
				{
					"id": 710331201,
					"content": "음? 무슨 일인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331202
					],
					"speakerTitle": "약심"
				},
				{
					"id": 710331202,
					"content": "청주와 베르메르의 대결에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331203
					]
				},
				{
					"id": 710331203,
					"content": "아, 그 둘? 괜찮아, 괜찮아. 아이들과 놀아준다니 좋지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331204
					],
					"speakerTitle": "약심"
				},
				{
					"id": 710331204,
					"content": "모처럼의 해등절인데 시끌벅적해야 좋지 않겠니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331205
					],
					"speakerTitle": "약심"
				},
				{
					"id": 710331205,
					"content": "너야말로 우리 경책 산장 때문에 왔다 갔다 하느라 고생 많았다, 얘야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331206,
						710331207
					],
					"speakerTitle": "약심"
				},
				{
					"id": 710331206,
					"content": "괜찮아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				},
				{
					"id": 710331208,
					"content": "정말 친절하구나…. 이건 고마움의 표시니 받아주게. 해등절 잘 보내렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331209
					],
					"speakerTitle": "약심"
				},
				{
					"id": 710331209,
					"content": "앞으로도 해등절 때마다 이렇게 시끌벅적했으면 좋겠구먼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "약심"
				},
				{
					"id": 710331207,
					"content": "별말씀을요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				}
