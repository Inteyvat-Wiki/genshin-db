					"약심"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330401,
					"content": "여행자구나. 덕분에 이 경책 산장에도 명절 분위기가 좀 나기 시작했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330402
					],
					"speakerTitle": "약심"
				},
				{
					"id": 710330402,
					"content": "음? 옆에 이 분은 처음 보는데 뉘신지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330403
					],
					"speakerTitle": "약심"
				},
				{
					"id": 710330403,
					"content": "청주 씨를 찾으러 온 화가예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330404
					]
				},
				{
					"id": 710330404,
					"content": "청주 씨를 찾으러 왔다고? 흠, 마침 잘됐네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330405
					],
					"speakerTitle": "약심"
				},
				{
					"id": 710330405,
					"content": "망아 아가씨가 며칠 전에 떠날 때 청주 씨는 여기 좀 더 있다 간다고 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330406
					],
					"speakerTitle": "약심"
				},
				{
					"id": 710330406,
					"content": "지금 아직 아이들이랑 소등 퀴즈를 하고 있을 거야. 흠… 아이들을 데리고 밖으로 나갔던 것 같군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330407
					],
					"speakerTitle": "약심"
				},
				{
					"id": 710330407,
					"content": "그를 찾고 싶다면 밖으로 나가보는 게 좋겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330408
					],
					"speakerTitle": "약심"
				},
				{
					"id": 710330408,
					"content": "정말 소등 퀴즈 하고 있네…. 여행자, 미안한데 네가 좀 갔다 와줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330409
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710330409,
					"content": "그 시인한테 내가 왔다고 전해줘. 난 여기서 준비하고 있을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330410
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710330410,
					"content": "오늘은 무슨 수가 있어도 결판을 내겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르메르"
				}
			]
		},
