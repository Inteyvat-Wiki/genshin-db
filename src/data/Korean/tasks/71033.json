				},
				{
					"id": 710331003,
					"content": "이번엔 잘 생각해야지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331004
					],
					"speakerTitle": "꼬마 우"
				},
				{
