				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330301,
					"content": "여기가 바로 경책 산장이지…? 그 시인은? 어디 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330302
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710330302,
					"content": "저번엔 아이들과 소등 퀴즈를 하고 있었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330303
					]
				},
				{
					"id": 710330303,
					"content": "소, 소등 퀴즈? 그게 대체 뭐야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330304
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710330304,
					"content": "결국 영감을 못 찾아서 항복할 생각 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330305
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710330305,
					"content": "됐어, 그가 뭘 하고 있든 상관없어. 해등절도 며칠 안 남았는데 더 이상 질질 끌 수 없다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330306
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710330306,
					"content": "여기 책임자한테 물어보자. 오늘 기필코 승부를 가르고 말겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르메르"
				}
			]
		},
		{
			"id": 7103304,
			"completionStepIds": [
				7103304
			],
