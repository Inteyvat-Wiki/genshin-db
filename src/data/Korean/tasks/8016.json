					"츄츄족"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2695.591,
							282.595,
							9928.808
						],
						"pointId": 351500004
					}
				]
			},
			"dialogs": [
				{
					"id": 80160201,
					"content": "어라? 츄츄족이 있어. 쉬고 있는 건가? 공격적으로 보이지는 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160202,
					"content": "왜 여기 숨어 있는 거지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160203,
					"content": "앗, 깨워버렸다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160204,
					"content": "어? 도망갔어…. 나타에서 우리의 명성은 츄츄족마저 위협을 느낄 정도인 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160205,
					"content": "뭔가 있는 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160206
					]
				},
				{
					"id": 80160206,
					"content": "저 반짝거리는 거 말이야? 아까 츄츄족이 도망치다 떨어뜨렸나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160207,
					"content": "음… 보물을 주웠다고 생각해서 여기에 숨겨두려던 거 아닐까? 그런데 미처 숨길 새도 없이 우리랑 마주친 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160208,
					"content": "어디 보자, 츄츄족의 지능을 생각하면 그렇게 좋은 물건일 것 같진 않지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160209,
					"content": "……!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160210
					]
				},
				{
					"id": 80160210,
					"content": "응? 왜 그래? 왜 갑자기 심각한 표정이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160211,
					"content": "그냥 평범한 열쇠잖아? 근데 모양이 좀 독특하네, 나타 스타일 같진 않은데…. 음… 어느 나라에서 만든 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160212,
						80160213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160212,
					"content": "이건…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				},
				{
					"id": 80160214,
					"content": "우주선 수면 장치? 우주선은 뭐고, 수면 장치는 또 뭐야…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160215,
					"content": "잠깐! 우주선 수면 장치…? 서, 설마! 네가 티바트에 올 때 탔다던 그거?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160216,
					"content": "맞아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160217
					]
				},
				{
					"id": 80160217,
					"content": "그게 갑자기 여기 나타났다고?! 네가 방금 떨어뜨린 거 아니고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160218,
						80160219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160218,
					"content": "내 건 여기 있어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160220,
					"content": "오, 완전 똑같이 생겼네…. 이게 네 게 아니라면, 남은 가능성은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160221,
						80160222
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160221,
					"content": "열쇠는 두 개뿐이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160223,
					"content": "역시 그렇구나…. 음, 네가 「외계인」… 아니, 「강림자」라는 게 문득 실감 나네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160224
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160224,
					"content": "그럼 이 상황을 논리적으로 정리해 보면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160225
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160225,
					"content": "#츄츄족이 이 열쇠를 주워서 숨겼다는 건, 네 {M#여동생이}{F#오빠가} 근처에서 열쇠를 떨어뜨렸다는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160226
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160226,
					"content": "#즉, 네 {M#여동생은}{F#오빠가} 최근 이 주변에 있었다는 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160227,
						80160228
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160227,
					"content": "그렇다면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160229,
					"content": "#응…. 얀사의 순찰을 도우려던 것뿐인데, 이런 엄청난 발견을 하다니. 네 {M#여동생}{F#오빠}에 관한 단서까지 찾고 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160230
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160230,
					"content": "주변에서 계속 단서를 찾아볼까? 아니면 일단 「비옥한 터전」으로 돌아가서 얀사를 만나볼까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160231
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160231,
					"content": "여기 있었구나. 수고했어, 잘 둘러봐 줬네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160232
					],
					"speakerTitle": "얀사"
				},
				{
					"id": 80160232,
					"content": "얀사! 왜 여기 있어? 「비옥한 터전」에서 만나기로 했잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160233
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160233,
					"content": "안 그래도 너한테 갈까 생각하던 참이었어! 방금 엄청난 걸 발견했거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160234
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160234,
					"content": "순찰을 그만해도 된다고 알려주러 온 거야. 방금 보디빌딩 대회가 취소돼서, 이제 순찰할 인력이 생겼거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160235
					],
					"speakerTitle": "얀사"
				},
				{
					"id": 80160235,
					"content": "엥? 갑자기 무슨 일이라도 생겼어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160236
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160236,
					"content": "「심연 교단」이 쳐들어왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160237
					],
					"speakerTitle": "얀사"
				},
				{
					"id": 80160237,
					"content": "뭐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160238
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160238,
					"content": "우리의 예상이 빨리도 들어맞았네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160239
					]
				},
				{
					"id": 80160239,
					"content": "#({M#루미네}{F#오빠}가 다시 움직이기 시작한 것 같아)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160240
					]
				},
				{
					"id": 80160240,
					"content": "#(이번에야말로 반드시 {M#루미네}{F#오빠}와 만나겠어)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160241
					]
				},
				{
					"id": 80160241,
					"content": "심연 교단이라는 이름은 나도 들어봤지만, 이렇게 대규모로 광범위한 움직임을 보이는 건 처음 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160242
					],
					"speakerTitle": "얀사"
				},
				{
					"id": 80160242,
					"content": "마치… 나타 전체와 전쟁이라도 벌이려는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160243
					],
					"speakerTitle": "얀사"
				},
				{
					"id": 80160243,
					"content": "고작 「교단」 하나가 「전쟁의 나라」와 전쟁을 벌이려 한다고? 말도 안 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160244
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160244,
					"content": "심연 교단은 보통 암암리에 움직이는 걸로 알고 있어. 이런 상황은 우리도 처음 봐…. 대체 뭘 하려는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160245
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80160245,
					"content": "「비옥한 터전」의 정보만으론 전황이 명확하게 파악되지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160246
					],
					"speakerTitle": "얀사"
				},
				{
					"id": 80160246,
					"content": "지금은 「비옥한 터전」의 방위에 큰 문제가 없으니, 난 성화 경기장으로 가서 마비카 님께 상황을 여쭤볼 생각이야. 어쨌든 그곳이 나타의 중추니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160247
					],
					"speakerTitle": "얀사"
				},
				{
					"id": 80160247,
					"content": "나랑 같이 갈래? 나타의 영웅이 함께해 준다면 다들 안심이 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160248,
						80160249
					],
					"speakerTitle": "얀사"
				},
				{
					"id": 80160248,
					"content": "나도 상황을 알아봐야겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160250,
					"content": "잘됐다, 그럼 같이 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "얀사"
				},
				{
					"id": 80160249,
					"content": "심연 교단에 대해서라면 나도 아는 게 좀 있고",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160228,
					"content": "「심연 교단」도 왔을 가능성이 커",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160222,
					"content": "#내 거 하나, {M#여동생}{F#오빠} 거 하나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160219,
					"content": "…늘 잊지 않고 챙겨 다니는걸",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160213,
					"content": "…우주선 수면 장치의 열쇠야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				}
			]
		},
