			"dialogs": [
				{
					"id": 750230701,
					"content": "꺄! 꺄꺄꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230702
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230702,
					"content": "그래 그래, 알았으니 이제 진정하자?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230703
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750230703,
					"content": "솔직히 난 꼬마가 다칠까 봐 잔뜩 긴장했어. 현실감을 위해서 나무통에 폭탄을 많이 넣어뒀거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230704,
						750230706
					],
					"speakerTitle": "아카탕가"
				},
				{
					"id": 750230704,
					"content": "고작 폭발일 뿐인데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230705
					]
				},
				{
					"id": 750230705,
					"content": "우꺄꺄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230708,
					"content": "어쨌든 이번 일을 통해 어떻게 개선해야 할지 알게 됐어. 도와줘서 고마워, 그럼 작품을 확인해 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230709
					],
					"speakerTitle": "아카탕가"
				},
				{
					"id": 750230709,
					"content": "뜻밖에도 화면에는 꼬리에 붉은 손수건을 단 구원자도 지직 소리를 내던 사악한 적도 없었으며, 놀라웠던 폭발 장면도 없었다. 그저 아카탕가의 다양한 표정만이 담겨 있을 뿐이었다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230710
					]
				},
				{
					"id": 750230710,
					"content": "내가 주인공이 됐잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230711,
						750230713
					],
					"speakerTitle": "아카탕가"
				},
				{
					"id": 750230711,
					"content": "축하드려요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230712
					]
				},
				{
					"id": 750230712,
					"content": "말도 안 돼! 설마 사진기가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230714
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750230714,
					"content": "그러고 보니 정식으로 사진기를 써보는 건 이번이 처음이네…. 이거 지금 거꾸로 놓은 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230715
					],
					"speakerTitle": "아카탕가"
				},
				{
					"id": 750230715,
					"content": "아무렇지도 않게 말하네? 방금 우리의 노력이 다 헛수고가 됐다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230716
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750230716,
					"content": "우… 우우… 우",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230717
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230717,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}도 기대하고 있었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230718
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750230718,
					"content": "정말 미안, 이게 다 나 때문이야! 아까는 그냥 리허설로 칠 테니까 정식으로 다시 촬영하자. 이번에야말로 최선을 다해 최고의 영화를 찍을게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230719
					],
					"speakerTitle": "아카탕가"
				},
				{
					"id": 750230719,
					"content": "우… 꺄꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230720
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230720,
					"content": "엄청 신났네. 그럼 얘는 찬성인 것 같고…. 이번엔 별일 없어야 할 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230721
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750230721,
					"content": "동일한 절차대로 촬영을 마치고 원하는 결과물을 거두었다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230722
					]
				},
				{
					"id": 750230722,
					"content": "좋아! 완벽해! 예상을 뛰어 넘었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230723,
						750230724
					],
					"speakerTitle": "아카탕가"
				},
				{
					"id": 750230723,
					"content": "식은 죽 먹기죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230725
					]
				},
				{
					"id": 750230725,
					"content": "약속했던 보수 외에도 이 사진을 기념으로 줄게. 이건 내 야심작이라고 할 수 있으니까. 물론, 너희의 도움이 컸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230726
					],
					"speakerTitle": "아카탕가"
				},
				{
					"id": 750230726,
					"content": "#와, {REALNAME[ID(2)|SHOWHOST(true)]}, 너 정말 멋지게 나왔다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230727
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750230727,
					"content": "꺄! 꺄꺄꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230728
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230728,
					"content": "#헤헤. {REALNAME[ID(2)|SHOWHOST(true)]}도 마음에 들어 하니 잘됐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750230724,
					"content": "감독님, 보수는요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230725
					]
				},
				{
					"id": 750230713,
					"content": "이거… 전에 써본 적은 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230714
					]
				},
				{
					"id": 750230706,
					"content": "너무 위험했다고 생각해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230707
					]
				},
				{
					"id": 750230707,
					"content": "맞아! 다치거나 불이라도 나면 큰일이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230708
					],
					"speakerTitle": "페이몬"
				}
			]
		},
