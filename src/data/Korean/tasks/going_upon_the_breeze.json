			"dialogs": [
				{
					"id": 3600101,
					"content": "휴, 식은 죽 먹기야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600102
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3600102,
					"content": "하지만 너, 아무 전투능력이 없는 여행자인 줄 알았는데… 꽤 하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600103
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3600103,
					"content": "도와줘서 고마워. 아까의 전투 어땠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600104,
						3600105
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3600104,
					"content": "아주 쉬웠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3600106
					]
				},
				{
					"id": 3600106,
					"content": "근데 「츄츄족」은 왜 여기에 나타난 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3600107,
					"content": "이런 생물은 보통 도시에서 이렇게 가까운 곳에 야영지를 짓진 않잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3600108,
					"content": "맞아. 원래는 황야에서만 돌아다녀",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600109
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3600109,
					"content": "하지만 바람 드래곤이 자주 출몰해 과수원이 무너지고 상로도 영향을 받고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600110
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3600110,
					"content": "폭풍이 몰아치면 또 구조활동을 해야 해서…. 기사단의 인력이 많이 부족한 상황이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600111
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3600111,
					"content": "그래서 이 녀석들의 활동 범위가 점점 성과 가까워지는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3600112,
					"content": "맞아. 하지만 오늘 야영지도 처리했으니 운이 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600113
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3600113,
					"content": "따라와! 책임감이 강하고 착한 기사가 성안까지 호송해줄 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				},
				{
					"id": 3600105,
					"content": "살짝 버거웠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3600106
					]
				}
			]
		}
