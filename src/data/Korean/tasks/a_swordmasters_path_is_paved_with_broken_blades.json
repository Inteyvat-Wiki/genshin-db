						20060602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20060602,
					"content": "그리고, 방금 뭔가 우리 쪽을 쳐다본 것 같지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060603
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20060603,
					"content": "잘못 본 거겠지… 우리랑은 처음 만나는 건데",
