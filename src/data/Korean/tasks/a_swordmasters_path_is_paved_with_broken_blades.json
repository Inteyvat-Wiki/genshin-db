			"trigger": {
				"objectNames": [
					"쥰야",
					"나나코"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20060101,
					"content": "세 번째로 「신의 눈」을 잃은 사람은 꽤 유명한 검객이었던 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20060102,
					"content": "「명경지수류」의 현임 수장이래, 엄청 대단한가 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20060103,
					"content": "여기가 그의 검도관이야. 저기 저 사람한테 한번 물어보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20060104,
					"content": "너무 상심하지 마, 사매. 사부님은 분명 무사하실 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060105
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060105,
					"content": "우리 검도관을 깨부수러 온 놈들이 얼마나 강했든 다 사부님에게 져선 꽁지 빠지게 도망쳤잖아, 안 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060106
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060106,
					"content": "그래도 걱정되는걸요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060107
					],
					"speakerTitle": "나나코"
				},
				{
					"id": 20060107,
					"content": "그전엔 아무리 위험한 상황이라도, 사부님은 흔들리지 않으셨잖아요. 근데 지금은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060108
					],
					"speakerTitle": "나나코"
				},
				{
					"id": 20060108,
					"content": "그건 사부님이 악령에 홀리셨기 때문이야! 퇴마 의식을 하면 분명 좋아지실 거라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060109
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060109,
					"content": "저, 무슨 일 생긴 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20060110,
					"content": "…너희는 누구지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060111
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060111,
					"content": "이 일과 무관한 사람이든, 이때를 틈타 소란을 피우려는 놈이든 다 꺼져!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060112
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060112,
					"content": "안 그러면 검을 꺼낼 수밖에 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060113
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060113,
					"content": "아니 그게 아니라, 우리는 사실… 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20060114,
					"content": "제자가 되고 싶어서 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060115
					]
				},
				{
					"id": 20060115,
					"content": "제자?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060116
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060116,
					"content": "맞아, 우린 「명경지수류」의 수장이 대단하다고 해서 제자가 되기 위해 아주 먼 곳에서 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20060117,
					"content": "근데 방금 「악령에 홀렸다」는 얘기를 들어서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20060118,
					"content": "옷을 보니 확실히 여기 사람은 아닌 것 같군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060119
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060119,
					"content": "실례했어…. 최근에 귀찮게 하는 사람이 워낙 많다 보니 우리도 조심할 수밖에 없거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060120
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060120,
					"content": "타이밍이 안 좋네. 사부님은 최근 귀신에 홀리셔서 몸이 아직 회복되지 않으셨어. 당분간은 너희를 제자로 받아주실 수 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060121,
						20060122
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060121,
					"content": "회복될 때까지 기다릴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060123
					]
				},
				{
					"id": 20060123,
					"content": "진심으로 제자가 되길 바라는구나. 그럼 이렇게 하자. 나랑 사매가 사부님의 상황을 말해줄 테니, 그걸 듣고 여기 남을지 떠날지 결정해 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060124
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060124,
					"content": "사부님의 성함은 도몬이야. 아마 너희도 들어봤겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060125
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060125,
					"content": "검술을 배우신 뒤 사부님은 유명한 검객들을 물리치시면서 단 한 번도 패하지 않으셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060126
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060126,
					"content": "사부님은 「천하제일」의 검객이 되는 게 목표라고 하셨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060127
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060127,
					"content": "우리를 지도해주시면서도 끊임없이 자신의 검술을 단련하셨어. 우리도 사부님의 열정에 감탄해서 본받고자 했고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060128
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060128,
					"content": "그런데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060129
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060129,
					"content": "그런데 얼마 전, 사부님은 「신의 눈」을 빼앗기시더니 전혀 다른 사람이 돼버리셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060130
					],
					"speakerTitle": "나나코"
				},
				{
					"id": 20060130,
					"content": "자꾸 이상한 말을 중얼거리시고, 검술 연습도 못하게 하셔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060131
					],
					"speakerTitle": "나나코"
				},
				{
					"id": 20060131,
					"content": "사형이랑 상의해본 결과, 사부님은 아무래도 악령에 홀리신 거 같아. 그래서 특별히 「나루카미 다이샤」의 무녀를 불러 악령을 쫓으려는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060132
					],
					"speakerTitle": "나나코"
				},
				{
					"id": 20060132,
					"content": "근데 솔직히 이걸로 사부님이 좋아지실지는 잘 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060133
					],
					"speakerTitle": "나나코"
				},
				{
					"id": 20060133,
					"content": "「나루카미 다이샤」는 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060134
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20060134,
					"content": "너네 나루카미 다이샤 몰라? 나루카미섬의 가장 큰 신사야. 신사를 관리하는 대무녀님은 라이덴 쇼군과 사이가 꽤 각별하다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060135
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060135,
					"content": "그 대무녀님을 부를 방법은 없지만… 나루카미 다이샤의 일반 무녀들도 악령을 쫓는 데엔 일가견이 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060136
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060136,
					"content": "그러니까 안심해 사매, 사부님은 괜찮으실 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060137
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060137,
					"content": "퇴마 의식은 밤에 열리니까, 관심 있다면 너희도 보러 와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060138
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060138,
					"content": "악령에게 홀리다니… 신의 눈을 빼앗기면 이런 문제까지 생기는 건가? 저녁에 다시 와보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20060122,
					"content": "제자가 못 되면 안 돌아갈 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060123
					]
				}
			]
		},
		{
			"id": 200602,
			"completionStepIds": [
				200603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200603",
							"2"
						],
						"stepId": 200603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"쥰야",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20060201,
					"content": "쉿… 왔어? 늦게 와서 다행이야. 방금 정말 난리였거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060202
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060202,
					"content": "방금 사매가 사부님을 부축하던 중에, 우연히 사부님이 중얼거리시는 이름을 들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060203
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060203,
					"content": "사매가 그 사람이 누구냐고 묻자, 사부님은 갑자기 공포에 질린 표정으로 사매를 밀어버리셨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060204
					],
					"speakerTitle": "쥰야"
				},
				{
					"id": 20060204,
					"content": "사부님은 아주 고통스러운 듯이 귀를 막고, 두 눈이 새빨개진 채로 사방을 두리번거리셨어",
