				]
			},
			"dialogs": [
				{
					"id": 755060201,
					"content": "#실로닌? {NICKNAME}(이)랑 페이몬도 있네? 안녕",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060202
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060202,
					"content": "올로룬? 여긴 무슨 일로 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060203
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 755060203,
					"content": "몸은 좀 괜찮아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060204
					]
				},
				{
					"id": 755060204,
					"content": "걱정해 줘서 고마워. 할머니한테 받은 쓴 것들을 먹고 강제로 며칠 쉬었더니 많이 좋아졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060205
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060205,
					"content": "안녕! 올로룬, 너도 실로닌이 꿀벌레 잡는 걸 도와주러 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 755060206,
					"content": "꿀벌레를 잡아? 아! 달달이를 잡아간 게 너희였구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060207
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060207,
					"content": "달콤이랑 달큰이도 안 보인다 했더니… 그런 거였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060208
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060208,
					"content": "음… 그거 혹시 꿀벌레 이름이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060209
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 755060209,
					"content": "응",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060210
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060210,
					"content": "그럼 구별하기 편하거든. 난 사실 꿀벌레들을 평가하지 않아, 설령 꿀을 만들지 못한다고 해도 이미 충분히 대단하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060211
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060211,
					"content": "그러니까… 그 꿀벌레들이 다 네가 키운 거라는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 755060212,
					"content": "사실 꿀벌레들의 일상에 간섭한 적은 없어. 우린 그냥 같은 장소에서 생활하다 보니 가까워진 것뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060213
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060213,
					"content": "아… 미안, 그런 줄 몰랐네. 꿀벌레들이 심연에 오염돼서 부족 사람들에게 악영향을 끼치는 바람에 처리할 수밖에 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060214
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 755060214,
					"content": "맞아 맞아…. 그래도 꿀벌레들 목숨에 위협이 되는 일은 안 했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 755060215,
					"content": "그럼 됐어… 괜찮아, 너무 신경 쓰지 마. 나도 원래 그 문제를 처리하러 온 거거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060216
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060216,
					"content": "하지만 한 가지 정정해줘야 할 일이 있어. 꿀벌레들은 아주 똑똑한 생명체야. 그 녀석들은 심연에 오염된 게 아니라 스스로 심연 에너지를 먹은 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060217
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060217,
					"content": "뭐? 스스로 먹은 거라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 755060218,
					"content": "맞아. 한 번에 아주 조금만 먹어. 그럼 몸집은 커지지만 죽지는 않거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060219
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060219,
					"content": "그 후에 아주 먼 곳으로 날아가서 오염물을 담은 열소 꿀 구슬을 만들어 내는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060220
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060220,
					"content": "꿀 구슬의 바깥쪽 부분이 오염을 어느 정도 막아주거든. 이런 방법을 사용하면 꿀벌레들의 집에서 심연 에너지를 천천히 분리할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060221
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060221,
					"content": "수도 없이 반복해야 하지만, 그 친구들은 인내심이 강하거든. 비가 온다고 해도 별문제 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060222
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060222,
					"content": "아… 집을 지키려고 했던 거구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060223
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 755060223,
					"content": "나도 처음 알았어. 꿀벌레들도 이 땅이 침략당했다는 걸 알고 있었구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060224
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 755060224,
					"content": "맞아, 달달이랑 다른 녀석들도 최선을 다해 싸우고 있지! 정말 대단한 꿀벌레들이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060225
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060225,
					"content": "역시 전쟁의 나라 나타답네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060226
					]
				},
				{
					"id": 755060226,
					"content": "그나저나 올로룬, 여긴 어떻게 찾은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060227
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 755060227,
					"content": "아, 꿀벌레에게 마비 열매 씨앗을 먹였거든. 꿀벌레들은 소화할 수 없어서 금방 배출돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060228
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060228,
					"content": "씨앗이 땅에 떨어지면 빠르게 자라서 작은 덤불이 되는데, 그걸 따라가다 보면 꿀벌레들이 있는 곳을 찾을 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060229
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060229,
					"content": "그리고 꿀벌레들이 만든 꿀 구슬을 모아 처리한 후에 다시 마비 열매를 써서 데리고 오는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060230
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060230,
					"content": "지금 보니까 나 대신 너희가 그 일을 해준 것 같네, 녀석들도 무사하고. 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060231
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 755060231,
					"content": "그래서 마비 열매가 있었던 거구나. 뭔가 숨겨진 음모가 있을까 봐, 열심히 머리를 굴렸는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060232
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 755060232,
					"content": "왜 그래? 혹시 내가 곤란하게 만든 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060233
