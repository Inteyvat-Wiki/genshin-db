			"dialogs": [
				{
					"id": 755060101,
					"content": "오, 왔구나. 여기가 심연 꿀벌레들이 출몰하는 마지막 장소야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060102
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 755060102,
					"content": "여기에 있는 꿀벌레만 잡으면 다 끝인 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 755060103,
					"content": "그래, 빠져나간 녀석들이 있더라도 큰 문제는 아냐. 그 녀석들은 내가 시간 내서 처리할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060104
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 755060104,
					"content": "부족 쪽 소식을 들었는데, 환자들 상태도 요 며칠 동안 많이 좋아졌대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060105
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 755060105,
					"content": "정말 좋은 소식이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 755060106,
					"content": "하지만 아쉽게도 페이몬이 경계하던 음모는 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060107
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 755060107,
					"content": "그 열매들은 자연적으로 꿀벌레의 집결지에 자랐던 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060108
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 755060108,
					"content": "음… 우인단이나 보물 사냥단 같은 전개를 예상한 건 아니지만… 이건 훌륭한 가이드가 가져야 할 경계심을 보여준 거라고 할 수 있지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 755060109,
					"content": "계속 그 마음 변치 않을 거라 믿어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060110
					]
				},
				{
					"id": 755060110,
					"content": "헤헤, 그야 당연하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 755060111,
					"content": "자, 그럼 빨리 마지막 임무를 처리해 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060112
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 755060112,
					"content": "오예! 벌레 포획팀, 마지막 출동!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
