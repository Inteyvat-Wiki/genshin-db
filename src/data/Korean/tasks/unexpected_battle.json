				"points": []
			},
			"dialogs": [
				{
					"id": 736860401,
					"content": "우와, 대회장이 엄청 멋있네…. 원국감사에 이런 곳도 있었구나. 전혀 몰랐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736860402,
					"content": "여긴 간조 봉행의 실내 훈련장이에요. 치사토 아가씨가 도와주신 덕분에 이곳을 빌릴 수 있었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860403
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736860403,
					"content": "천만에요, 아야카 아가씨. 도움이 되어서 저도 기뻐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860404
					],
					"speakerTitle": "히이라기 치사토"
				},
				{
					"id": 736860404,
					"content": "치사토, 저기 저건 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736860405,
					"content": "아, 저건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860406
					],
					"speakerTitle": "히이라기 치사토"
				},
				{
					"id": 736860406,
					"content": "여행자님, 지금… 잠깐 얘기 좀 나눌 수 있을까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860407
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736860407,
					"content": "물론이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860408
					]
				},
				{
					"id": 736860408,
					"content": "음, 어디서부터 얘기해야 좋을까요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860409
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736860409,
					"content": "「편지」에 대한 이야기를 하려는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860410
					]
				},
				{
					"id": 736860410,
					"content": "아… 역시 여행자님의 눈은 못 속이겠네요. 실은 조금 불안했어요. 다들 제가 「신시 대리」를 맡아주길 바라고 있을 때 말이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860411
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736860411,
					"content": "어렸을 때부터 수없이 대중 앞에 서 왔지만… 검도 대회에서 중책을 맡는 것도 모자라, 화려하게 차려입고 연무에 참여하는 건 처음이거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860412
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736860412,
					"content": "지금까지 「신시 대리」 역할을 맡았던 사람들은 모두 이나즈마 관아에서 검술이 제일 뛰어난 무인이었어요. 그들과 비교하면 전 아직 한참 멀었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860413
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736860413,
					"content": "저는 역할을 제대로 해내지 못할까 봐 걱정이 됐어요. 그래서 여행자님에게 의견을 물어보려고 편지를 쓴 거였어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860414,
						736860415
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736860414,
					"content": "우린 친구니까 자잘한 건 신경 쓰지 마",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860416
					]
				},
				{
					"id": 736860416,
					"content": "음… 네, 저도 알아요. 하지만 그걸 알고 있었기 때문에 오히려 그 편지를 보내지 않았어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860417
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736860417,
					"content": "이미 절 여러 번 도와주고, 제 고민을 많이 들어주셨잖아요. 하지만 계속 여행자님의 도움을 받다 보니까… 여행자님에게 「패배」한 것 같은 느낌이 들었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860418
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736860418,
					"content": "후후, 친구 사이인데도 이런 생각을 하는 게 이상하죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860419,
						736860420
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736860419,
					"content": "하나도 안 이상해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860421
					]
				},
				{
					"id": 736860421,
					"content": "고마워요. 하지만 오늘 대회에 참가한다는 걸 알게 돼서 정말 기뻤어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860422
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736860422,
					"content": "아야카… 어라? 둘이 무슨 얘기했어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860423
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736860423,
					"content": "여행자님이 대회에 참가한다는 걸 알게 돼서 기쁘다고 했어요. 여행자님은 이나즈마에서 유명하시니 대회에 화제성이 더해질 테죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860424
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736860424,
					"content": "헤헤, 여행자가 출전하면 정말 재밌는 대회가 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736860425
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736860425,
					"content": "페이몬 님의 말이 맞아요. 저도 기대하고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "히이라기 치사토"
				},
				{
					"id": 736860420,
					"content": "무슨 말인지 알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860421
					]
				},
				{
					"id": 736860415,
					"content": "네 상담을 받아주는 건 언제나 환영이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736860416
					]
				}
			]
