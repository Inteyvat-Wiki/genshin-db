				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102020101,
					"content": "앗, 클레도 여기 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102020102,
					"content": "난… 흑흑흑… 자수하러 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020103
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102020103,
					"content": "엥?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102020104,
					"content": "내… 내 폭탄 때문에… 사람이 다쳤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020105
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102020105,
					"content": "흑흑… 생존 수칙을 위반했으니 내일의 태양은 볼 수 없겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020106
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102020107,
					"content": "잠시만요. 뭔가 오해가 있는 것 같아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020108
					]
				},
				{
					"id": 102020106,
					"content": "클레, 일단 대답부터 해. 다친 사람은? 다친 사람은 어디 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020107
					],
					"speakerTitle": "진"
				},
				{
					"id": 102020109,
					"content": "클레가 폭파한 건 심연 메이지였어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020110
					]
				},
				{
					"id": 102020108,
					"content": "응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020109
					],
					"speakerTitle": "진"
				},
				{
					"id": 102020110,
					"content": "하… 하지만 보송보송이는 물건을 훔쳤을 뿐이잖아. 근데 내 폭탄이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020111
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102020111,
					"content": "아… 내가 심연 메이지를 「나쁜 사람」이라고 한 건, 일종의 비유였는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102020112,
					"content": "심연 메이지는 사람이 아니야. 녀석은… 음, 인류의 적인 악당이랄까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102020113,
					"content": "보송이가… 인류의 적이라고? 악당이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020114
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102020114,
					"content": "어, 어어?! 머… 머리가 혼잡해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020115
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102020115,
					"content": "그래, 이건 내 실수야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020116
					],
					"speakerTitle": "진"
				},
				{
					"id": 102020116,
					"content": "네가 너무 어리다고 이런 얘긴 안 했으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020117
					],
					"speakerTitle": "진"
				},
				{
					"id": 102020118,
					"content": "설마 「최강의 보물」 때문에?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020119
					]
				},
				{
					"id": 102020117,
					"content": "심연 교단은 몬드를 위협하는 세력이야. 최근 유달리 활발히 움직이고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020118
					],
					"speakerTitle": "진"
				},
				{
					"id": 102020119,
					"content": "맞아, 이제 알겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102020120,
					"content": "놈들은 보물에 대한 소문을 듣고 클레를 지켜보고 있었던 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102020121,
					"content": "내가 처음에 이 보물을 갖고 싶… 아니, 알고 싶어했던 것처럼 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102020122,
					"content": "그… 그럼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020123
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102020123,
					"content": "이번에 큰 공을 세웠으니까 다음 하르파스툼 축제에 참가하는 걸 허락할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020124
					],
					"speakerTitle": "진"
				},
				{
					"id": 102020125,
					"content": "내가 낚시하다 페이몬 잡은 격이네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020126,
					"content": "정말 축하해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020127
					]
				},
				{
					"id": 102020124,
					"content": "하르파스툼 축제! 와!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020125,
						102020126
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102020127,
					"content": "#{F#언니}{M#오빠}도 나중에 꼭 와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020128
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102020128,
					"content": "유후, 해피 엔딩이구만!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102020129,
					"content": "근데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "진"
				},
				{
					"id": 102020130,
					"content": "왜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102020131,
					"content": "클레, 원래 있던 「보물」은 어디에 숨겼어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020132
					],
					"speakerTitle": "진"
				},
				{
					"id": 102020132,
					"content": "으읏!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020133
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102020133,
					"content": "또 별이 떨어지는 호수의 물고기들에 사용하려던 건 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020134
					],
					"speakerTitle": "진"
				},
				{
					"id": 102020134,
					"content": "아, 아냐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020135
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102020136,
					"content": "(하지만 진 단장도 보고 있잖아…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020137
					]
				},
				{
					"id": 102020135,
					"content": "(필사적으로 눈빛을 보내는데…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020136
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102020137,
					"content": "클——레——?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020138
					],
					"speakerTitle": "진"
				},
				{
					"id": 102020138,
					"content": "윽! 지금 바로 <color=#00E1FFFF>감금실</color>로 갈게… 흑흑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020139
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102020139,
					"content": "클레 혼자 갇히면 심심하겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
