			},
			"dialogs": [
				{
					"id": 102020401,
					"content": "내가 누구게?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102020402,
					"content": "어, 페이몬 목소리다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020403,
						102020404
					],
					"speakerTitle": "감금실"
				},
				{
					"id": 102020403,
					"content": "우리가 밖으로 꺼내 줄까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				},
				{
					"id": 102020405,
					"content": "좋아, 그럼——아, 안 돼. 클레는 진심으로 반성하고 있다구! 날 유혹하지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020406
					],
					"speakerTitle": "감금실"
				},
				{
					"id": 102020406,
					"content": "감금 기간엔 여기에서 하르파스툼 축제 전용 「보물」을 만들 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020407
					],
					"speakerTitle": "감금실"
				},
				{
					"id": 102020407,
					"content": "「보물」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102020408,
					"content": "헤헤… 하르파스툼 모양으로 만들었어! 엄청 귀엽지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020409,
						102020410
					],
					"speakerTitle": "감금실"
				},
				{
					"id": 102020409,
					"content": "하르파스툼 모양…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020411,
					"content": "하르파스툼 축제가 되면 분명 모두가 좋아할 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020412
					],
					"speakerTitle": "감금실"
				},
				{
					"id": 102020412,
					"content": "아, 이 말을 진 단장이 들었다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102020413,
					"content": "감금 시간이 더 길어지겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102020410,
					"content": "그래도 폭탄이겠지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020404,
					"content": "먹을 것 좀 가져다줄까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				}
			]
		}
	]
}