					}
				]
			},
			"dialogs": [
				{
					"id": 160010201,
					"content": "두린 안녕~ 다음 힌트는 생겼어? 우리 다음 장에 들어갈 준비 다 됐어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 160010202,
					"content": "준비 다 됐어!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160010203
					]
				},
				{
					"id": 160010203,
					"content": "응, 생겼어. 마침 너희를 만나러 가려던 참이야. 같이 확인해 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010204
					],
					"speakerTitle": "두린"
				},
				{
					"id": 160010204,
					"content": "바람이 음악을 싣고 날아와, 이야기의 싹을 틔웠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010205
					],
					"speakerTitle": "마녀 M"
				},
				{
					"id": 160010205,
					"content": "음악은 바람을 타고 날아가, 아득한 과거로 사라졌다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010206
					],
					"speakerTitle": "마녀 M"
				},
				{
					"id": 160010206,
					"content": "바람과 이야기가 만나는 곳으로 가라. 세 개의 수수께끼를 시로 엮고, 세 단락의 악보를 노래로 이어라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010207
					],
					"speakerTitle": "마녀 M"
				},
				{
					"id": 160010207,
					"content": "음악 속의 시와 노래가, 이 이야기의 첫 새싹이 될 것이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010208
					],
					"speakerTitle": "마녀 M"
				},
				{
					"id": 160010208,
					"content": "이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010209
					],
					"speakerTitle": "두린"
				},
				{
					"id": 160010209,
					"content": "또 수수께끼인가? 바람이랑 음악이라… 이번 수수께끼는 뭘 가리키는 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 160010210,
					"content": "페이몬, 우리의 오랜 친구가 떠오르지 않아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160010211
					]
				},
				{
					"id": 160010211,
					"content": "음…? 아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 160010212,
					"content": "무슨 뜻이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010213
					],
					"speakerTitle": "두린"
				},
				{
					"id": 160010213,
					"content": "바람, 음악, 시, 이런 건 그 각설이한테 물어보는 게 제일 정확할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 160010214,
					"content": "바르바토스 님 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010215
					],
					"speakerTitle": "두린"
				},
				{
					"id": 160010215,
					"content": "너도 누군지 알아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160010216
					]
				},
				{
					"id": 160010216,
					"content": "내가 몬드에 처음 왔을 때, 알베도가 그분을 소개해 줬어. 나 같은 존재는 어차피 그분의 주의를 끌게 되기 마련이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010217
					],
					"speakerTitle": "두린"
				},
				{
					"id": 160010217,
					"content": "그렇구나…. 그나저나, 각설이를 어디 가서 찾지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 160010218,
					"content": "바르바토스 님은 이미 우리의 이야기를 들으셨을 거야. 바람을 따라가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010219
					],
					"speakerTitle": "두린"
				},
				{
					"id": 160010219,
					"content": "가끔은 걔가 신이라는 걸 깜빡 잊어버린다니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
