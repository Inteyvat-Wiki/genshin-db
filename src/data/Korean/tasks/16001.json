					},
					{
						"sceneId": 3,
						"position": [
							2361.06,
							223.99,
							-843.051
						],
						"pointId": 14458
					}
				]
			},
			"dialogs": [
				{
					"id": 160010301,
					"content": "#{NICKNAME}, 페이몬, 동화 세계에서 온 꼬마 용까지. 다들 오랜만이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010302
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010302,
					"content": "바람 속에서 날 부르는 소리가 들렸어. 수수께끼 때문에 골머리를 앓고 있는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010303
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010303,
					"content": "번거롭게 해드려서 죄송해요, 바르바토스 님…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010304
					],
					"speakerTitle": "두린"
				},
				{
					"id": 160010304,
					"content": "아니야, 나도 이 수수께끼가 꽤 관심이 가거든. 좀 보여줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010305
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010305,
					"content": "음… 하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010306
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010306,
					"content": "뭔가 알아낸 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 160010307,
					"content": "세 개의 수수께끼와 세 단락의 악보… 이걸 보니까 옛 생각이 나네. 너희가 원하는 답은 그 옛일에 숨겨져 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010308
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010308,
					"content": "역시 각설이를 찾아오길 잘했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 160010309,
					"content": "아주 오래전, 마녀들이 나와 승부를 겨루려고 몬드에 찾아왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010310
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010310,
					"content": "하지만 난 비무 대신 노래와 악기로 시를 연주해 분쟁을 끝내자고 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010311
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010311,
					"content": "나는 하프를 켜고 마녀들에게 이 시를 불렀어——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010312
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010312,
					"content": "「바람아, 바람아, 나를 대신해 손님을 맞이해다오」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010313
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010313,
					"content": "「푸른 초목 사이를 누비렴. 그곳에선 너도 형태를 가지니, 내 손님을 위해 춤을 선보일 수 있단다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010314
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010314,
					"content": "「바다 구름 옆에서 뛰놀렴. 그곳에서 방해꾼들이 네 노랫소리에 놀라 도망가면, 내 손님이 평온을 느낄 거란다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010315
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010315,
					"content": "「별빛 아래 훨훨 날아가렴. 그곳에서 네가 속세의 소란을 씻어 내리면, 내 손님이 속마음을 털어놓을 수 있을 거란다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010316
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010316,
					"content": "「그곳으로 가렴. 그곳은 내가 손님에게 약속한 장소」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010317
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010317,
					"content": "「그곳에는 다툼과 투쟁이 없고, 찻잔과 기분 좋은 시간만이 머문단다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010318
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010318,
					"content": "세 단락의 악보는 이미 연주해 보였어. 세 수수께끼의 답은… 충분히 짐작할 수 있겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010319
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010319,
					"content": "…숲속이랑 절벽가, 그리고 하늘 위?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010320
					],
					"speakerTitle": "두린"
				},
				{
					"id": 160010320,
					"content": "정답이야! 그러고 보니 그때도 이 수수께끼의 답을 제일 먼저 맞힌 건 네 엄마였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010321
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010321,
					"content": "이야기를 쓰는 사람과 이야기를 부르는 사람은 잘 통하는 구석이 있나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010322
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010322,
					"content": "숲, 절벽, 하늘… 아, 거기구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 160010323,
					"content": "이 답이 가리키는 장소가 바로 너희가 가야 할 곳일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010324
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010324,
					"content": "마녀들은 내 수수께끼를 풀고 내 제안을 받아들였어. 그때부터 마녀들은 그곳을 모임 장소로 정했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010325
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010325,
					"content": "이 책에 나온 힌트대로, 그 장소에서 내가 알려준 단락을 연주해 보면 어떨까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010326
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010326,
					"content": "진지하게 굴 때는 역시 믿음직스럽다니까, 바람 신 바르바토스",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010327
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 160010327,
					"content": "감사해요, 바르바토스 님. 저…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010328
					],
					"speakerTitle": "두린"
				},
				{
					"id": 160010328,
					"content": "보아하니, 아직 나한테 묻고 싶은 게 남았구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010329
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010329,
					"content": "음… 바르바토스 님은 음유시인으로서 수많은 이야기를 읽어보셨죠? 작가의 눈에 미완성으로 보이는 이야기는 어떤 거라고 생각하세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010330
					],
					"speakerTitle": "두린"
				},
				{
					"id": 160010330,
					"content": "글쎄, 이야기에 이루지 못한 염원이 남았거나… 이야기가 아직 끝나지 않은 경우겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010331
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010331,
					"content": "네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010332
					],
					"speakerTitle": "두린"
				},
				{
					"id": 160010332,
					"content": "방금 막 믿음직하다고 말한 참이었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010333
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 160010333,
					"content": "네가 원하는 답은 이 이야기 속에 있을 거야. 이건 네 엄마가 너에게 남긴 이야기니까, 나는 더 말하지 않을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010334
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 160010334,
					"content": "네… 그럼 출발하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "두린"
				}
			]
		},
