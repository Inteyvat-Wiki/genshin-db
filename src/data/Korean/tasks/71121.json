				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711210301,
					"content": "대, 대협! 사람 좀 살려주… 엥? 당신들이군요?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210302
					],
					"speakerTitle": "이상한 상인"
				},
				{
					"id": 711210302,
					"content": "당신은 전의 그!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210303
					]
				},
				{
					"id": 711210303,
					"content": "헤헤, 또 이런 우연이…. 하하, 그럼 볼일들 보세요. 전 먼저 갑니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210304
					],
					"speakerTitle": "이상한 상인"
				},
				{
					"id": 711210304,
					"content": "그 사람들이 어떤 보물을 남겨놨는지 한번 살펴보세요. 음… 제 걱정은 하지 마시고요. 기록은 전부 해뒀으니까… 돌려줘야 하는 물건만 제가 돌려주면 돼요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210305
					],
					"speakerTitle": "이상한 상인"
				},
				{
					"id": 711210305,
					"content": "잠깐만요…!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210306
					]
				},
				{
					"id": 711210306,
					"content": "괜찮아요, 우린 또 만나게 될 테니까요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이상한 상인"
				}
			]
		},
