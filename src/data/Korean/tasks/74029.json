	"talks": [
		{
			"id": 7402901,
			"completionStepIds": [
				7402901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7402901",
							"2"
						],
						"stepId": 7402901,
						"stateName": "QUEST_STATE_UNFINISHED"
