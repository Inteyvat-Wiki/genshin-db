				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"이아라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740290101,
					"content": "왜 이런 곳에 낚싯대를 둔 거야? 설마 낚시 중?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290102,
					"content": "물과 낚싯대가 있으니 당연히 낚시 중이지. 밖에서 왔으면서 이렇게 견식이 좁아서야, 이런 게 바로 「세상 말세」인가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290103,
						740290105
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290103,
					"content": "말세랑 상관없는 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290104
					]
				},
				{
					"id": 740290104,
					"content": "그래! 그리고 우리는 낚시를 모르는 문외한이 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290107,
					"content": "내가 하려던 말은… 멜뤼진이 낚싯대로 물고기를 잡을 줄은 전혀 몰랐어. 게다가… 뭔가 어색해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290108,
					"content": "뭐, 뭐가 어색한데? 난 바깥 사람이 알려준 대로 한 거야. 들라로슈는 내게 낚시하는 법을 알려주고, 낚싯대까지 선물해 줬다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290109
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290109,
					"content": "들라로슈의 낚싯대는 이것보다 멋져 보였지만, 걘 「전문가」고 난 「아마추어」니까 이걸로도 충분해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290110
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290110,
					"content": "음… 그나저나 한참을 기다렸는데도 왜 입질이 없지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290111
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290111,
					"content": "#헤헤, 그럼 {NICKNAME} 선생님과 페이몬 선생님이 문제의 원인을 분석해 줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290112,
					"content": "#{NICKNAME} 선생님과 페이몬 선생님이 들라로슈보다 대단하다고? 들라로슈는 멋진 낚싯대를 가진 전문가인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290113
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290113,
					"content": "흥, 이럴 때는 실력으로 증명해야겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290114,
					"content": "이곳에 물고기가 있기나 한 걸까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290115
					]
				},
				{
					"id": 740290115,
					"content": "앗! 그런 거였어…. 내가 처음에 이상하다고 느낀 이유가 바로 그거였어! 물고기 그림자조차 보이지 않잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290116,
					"content": "물고기라…. 들라로슈는 물에 있다고 다 수산물인 건 아니랬어. 으음, 그럼 「녀석」은 물고기로 칠 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290117
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290117,
					"content": "…혹시 「녀석」이 물고기가 아니라서 「물고기」를 낚는 방법으로는 낚을 수 없었던 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290118
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290118,
					"content": "#{NICKNAME} 선생님… 그리고 페이몬 선생님! 「녀석」을 낚는 방법을 알려줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290119
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290119,
					"content": "오, 오! 태도가 공손하군…. 당연히 알려줘야지. 그런데 「녀석」이 대체 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290120,
					"content": "물속에서 아주 빠르게 헤엄치고 매끈해서 잡기 힘든 녀석이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290121,
						740290123
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290121,
					"content": "물고기인 것 같은데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290122
					]
				},
				{
					"id": 740290122,
					"content": "다른 수중 생물일 가능성도 있지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290125,
					"content": "음… 아무튼 녀석이 수중 생물이라는 건 알겠네. 수면에서 그림자도 보이지 않는 걸 보니 물 깊숙한 곳에 숨은 걸지도?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290126,
					"content": "이럴 때는 「미끼」를 써서 유인해야겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290127,
					"content": "하지만 벌써 많이 먹어서… 미끼를 바꾼다고 효과가 있을지 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290128
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290128,
					"content": "음, 일단 물에 미끼를 뿌리고 낚싯대를 준비해서 녀석이 낚일 때까지 기다려보자. 녀석이 뭔지는 아직도 모르겠지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290129,
					"content": "#아름다운 낚시 기술… 좋아, 다시 시도해 봐야겠어. 미끼는 {NICKNAME} 선생님이랑 페이몬 선생님한테 맡기고 난 낚싯대를 지켜보고 있을게. 비록 전문가의 낚싯대만큼 멋진 낚싯대는 아니지만 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290130
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290130,
					"content": "좋아. 미끼를 뿌리는 간단한 일은 우리한테 맡겨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290123,
					"content": "멜뤼진인 것 같은데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290124
					]
				},
				{
					"id": 740290124,
					"content": "이아라가 다른 멜뤼진이랑 가짜 낚시 놀이를 하고 있다니… 그건 너무 이상하잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290105,
					"content": "페이몬은 낚시가 뭔지 아주 잘 알아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290106
					]
				},
				{
					"id": 740290106,
					"content": "#맞아, 난 {NICKNAME} 낚싯대에 낚여 올라온 거거든…. 아니지, 그런 얘기가 아니잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290107
					],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7402902,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
