				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"이아라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740290201,
					"content": "…녀석이 과연 미끼에 낚일까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이아라"
				}
			]
		},
		{
			"id": 7402903,
			"completionStepIds": [
				7402905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7402905",
							"2"
						],
						"stepId": 7402905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"이아라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740290301,
					"content": "이아라가 허약한 풍선 문어를 옆에 있는 통에 넣는다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740290302
					]
				},
				{
					"id": 740290302,
					"content": "아름다운 포획 기술을 사용했는데… 녀석은 더 이상 아름답지 않게 됐어. 어떻게 된 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290303
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290303,
					"content": "미안… 이아라가 말한 「녀석」이 풍선 문어인 줄 모르고 실수로 그만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290304,
						740290306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290304,
					"content": "탓하려면 날 탓해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290305
					]
				},
				{
					"id": 740290305,
					"content": "#{NICKNAME}, 너 너무 급했어! 물론 막지 않은 나한테도 잘못이 있지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290308,
					"content": "#{NICKNAME} 선생님도 페이몬 선생님도 사과할 거 없어. 녀석이 지금 통 속에 있는 걸로 충분해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290309
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290309,
					"content": "알았어…. 그나저나 풍선 문어가 왜 여기 있는 거지? 물살에 휩쓸려서 여기까지 오게 된 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290310,
					"content": "내가 밖에서 잡아 온 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290311
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290311,
					"content": "뭐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290312,
					"content": "낚싯대로 낚시하는 방법을 검증하고 싶어서… 「녀석」을 잡은 거야. 너희가 말하는 풍선 문어 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290313
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290313,
					"content": "녀석을 이곳에 풀어두면 언제든지 낚을 수 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290314
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290314,
					"content": "좋은 계획이라고 생각했는데, 아무리 기다려도 녀석이 입질을 하지 않는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290315
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290315,
					"content": "일부러 풍선 문어를 잡은 다음 연못에 풀어서 낚시 기술을 연습한다는 점이 좀 걸리긴 하는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290316,
					"content": "아까 미끼를 살짝 뿌린 것만으로 녀석을 수면으로 유인했잖아? 이아라, 미끼를 좀 더 많이 뿌려본다든지 그런 건 생각해 본 적 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740290317,
					"content": "여러 가지 미끼를 써봤지. 고기 조각, 빵 조각, 애벌레, 민트, 부품 등등…. 녀석이 먹고 다시는 오지 않길래 미끼는 소용없는 줄 알았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290318
					],
					"speakerTitle": "이아라"
				},
				{
					"id": 740290318,
					"content": "부, 부품?! 그건 미끼가 아닌 것 같은데…",
