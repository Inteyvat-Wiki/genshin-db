			"dialogs": [
				{
					"id": 705070101,
					"content": "조… 종려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705070102,
					"content": "오랜만이군. 잘 지냈나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070103
					],
					"speakerTitle": "종려"
				},
				{
					"id": 705070103,
					"content": "아니 아니… 종려가 어째서 여기 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705070104,
					"content": "눈앞에 보이는 곳만 다닐 필요는 없지. 바람의 나라는 자유롭고 풍요로워. 여행하기 좋은 곳이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070105
					],
					"speakerTitle": "종려"
				},
				{
					"id": 705070105,
					"content": "여기서 너희를 만나다니, 정말 반갑군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705070106,
						705070107
					],
					"speakerTitle": "종려"
				},
				{
					"id": 705070106,
					"content": "뭐 드실래요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070108
					]
				},
				{
					"id": 705070108,
					"content": "무성한 안개 한 잔 부탁하네. 차는 진할수록 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "종려"
				},
				{
					"id": 705070107,
					"content": "차 마시면서 수다 떨까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705070108
					]
				}
			]
		},
		{
			"id": 7050702,
			"completionStepIds": [
				7050703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
