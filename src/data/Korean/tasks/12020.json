				"points": []
			},
			"dialogs": [
				{
					"id": 120200101,
					"content": "네가 있어서 다행이야. 아니면 놓쳤을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200102
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200102,
					"content": "네가 들고 있는 게 바로 코코미의 묘책 모음집이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120200103,
					"content": "페이몬도 볼래… 와! 엄청 두껍네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120200104,
					"content": "사실… 이건 일부에 불과해. 나한테 다섯 권이나 더 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200105
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200105,
					"content": "그렇게나 많이?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120200106,
					"content": "산고노미야 님의 술책은 언제나 빈틈이 없지. 이건 「상비 묘책 모음집」이니 좀 많을 수밖에",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200107
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200107,
					"content": "그래도 이 묘책 모음집 덕분에 각종 상황에 대처할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200108
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200108,
					"content": "이 많은 걸 적으려면 엄청 오래 걸렸겠다. 모든 상황을 고려해야 한다니, 생각만 해도 머리 아파…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120200109,
					"content": "대장! 황새치 2번대를 다시 넘겨받으려고 와타츠미섬에 돌아온 건가요? 다들 보고 싶어 한다구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200110,
						120200111
					],
					"speakerTitle": "코토쿠"
				},
				{
					"id": 120200110,
					"content": "황새치 2번대가 아직 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200112
					]
				},
				{
					"id": 120200112,
					"content": "산고노미야 님께선 지금은 평화로운 시대라 군대 병력을 줄여서 사람들의 생산 회복을 도와야 한다고 하셨어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200113
					],
					"speakerTitle": "코토쿠"
				},
				{
					"id": 120200113,
					"content": "절반 정도의 병력은 아직 「별동대」 편성을 유지한 상태로 각 소대를 지원하고 있고, 나머지는 순찰이나 건축, 농경 일을 맡고 있죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200114
					],
					"speakerTitle": "코토쿠"
				},
				{
					"id": 120200114,
					"content": "며칠 전엔 주택 건축보단 전선에 남아서 싸우고 싶다며 투정을 부렸던 동료도 있었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200115
					],
					"speakerTitle": "코토쿠"
				},
				{
					"id": 120200115,
					"content": "저항군 사람들은 다들 여전하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120200116,
					"content": "참! 우린 코코미가 축하연에 초대해서 왔어. 고로, 코코미는?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120200117,
					"content": "산고노미야 님이라면 아마 보우로우 마을에 계실걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200118
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200118,
					"content": "거기에 문제가 좀 생겨서 친히 처리하러 가셨을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200119
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200119,
					"content": "#우리도 이제 가봐야겠다… 참, {NICKNAME}, 가면서 병사들을 좀 주의 깊게 봐줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200120
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200120,
					"content": "요즘 병사들이 좀 산만하던데 이유를 모르겠어. 다들 나한테 말하길 꺼리더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200121
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200121,
					"content": "전에는 고민이 있으면 나한테 얘기했는데, 지금은 다들 숨기니까… 무슨 문제라도 생긴 건지 걱정이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200122,
						120200123
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200122,
					"content": "내가 한번 알아볼게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200124
					]
				},
				{
					"id": 120200124,
					"content": "그래. 우리도 저항군 병사들이랑 얘기하고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120200125,
					"content": "#출발하자, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120200123,
					"content": "마침 예전 동료들을 보고 싶어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200124
					]
				},
				{
					"id": 120200111,
					"content": "다들 어떻게 지내요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200112
					]
				}
			]
		},
