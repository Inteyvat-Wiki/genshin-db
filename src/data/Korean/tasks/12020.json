				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120200301,
					"content": "하암… 평화가… 최고야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200302
					],
					"speakerTitle": "아리사와"
				},
				{
					"id": 120200302,
					"content": "응? 너 좀 낯이 익은데…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200303
					],
					"speakerTitle": "아리사와"
				},
				{
					"id": 120200303,
					"content": "어디서 봤더라… 기억이 안 나네. 근데 적은 아닌 거 같아. 무슨 일 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200304
					],
					"speakerTitle": "아리사와"
				},
				{
					"id": 120200304,
					"content": "최근에 일어난 일에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200305
					]
				},
				{
					"id": 120200305,
					"content": "다들 좀 산만하다고? 그런가, 난 모르겠는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200306
					],
					"speakerTitle": "아리사와"
				},
				{
					"id": 120200306,
					"content": "내가 평소에 사람들과 얘기하는 걸 안 좋아해서 그런가 봐. 내가 볼 때 그들은 항상 시끌벅적한 거 같거든",
