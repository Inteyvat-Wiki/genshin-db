			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"고로"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120200601,
					"content": "여기가 코코미랑 만나기로 약속한 장소 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120200602,
					"content": "#{NICKNAME}, 여기 기억나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200603
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120200603,
					"content": "저번에 와타츠미섬에 왔을 때 여길 지나쳤던 거 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120200604,
					"content": "그때 네가 「황새치 2번대」 대장도 했었잖아. 너무 오래전이라 저항군 병사들이 널 기억할지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200605
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120200605,
					"content": "와타츠미섬도 많이 변했겠지? 일단 근처를 좀 둘러볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200627
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120200627,
					"content": "어, 저기 고로 아냐? 가보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120200606,
					"content": "「적이 많고 아군이 적으면 돌파구를 찾아야 하고, 적이 적고 아군이 많으면 전면 승리를 거둬야 한다…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200607
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200607,
					"content": "「연해의 도적은 수송선이 있기 마련이니, 배를 불태우면 승리를 얻을 수 있을 것이다…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200608
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200608,
					"content": "고로 님, 결론이 나셨나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200609
					],
					"speakerTitle": "토시히코"
				},
				{
					"id": 120200609,
					"content": "응, 산고노미야 님이 남기신 묘책 모음집으로 우인단의 배가 근처에 정박해 있다는 걸 추측할 수 있어. 그래서 놈들이 그렇게 판을 쳤겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200610
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200610,
					"content": "두 팀으로 나뉘어서 한쪽이 그들의 주의를 끌고, 다른 쪽이 배를 태워버리면 도망갈 수 없을 거다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200611
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200611,
					"content": "하지만 산고노미야 님은 병력이 부족할 땐 병력을 나누지 말라고 하셨지. 만약 전부 패하면 단번에 붕괴되기 쉬우니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200612
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200612,
					"content": "그럼 제가 돌아가서 지원을 요청할까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200613
					],
					"speakerTitle": "코토쿠"
				},
				{
					"id": 120200613,
					"content": "시간이 없어. 움직임을 보니 놈들은 떠날 채비를 하고 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200614
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200614,
					"content": "산고노미야 님의 묘책 모음집에는 「섣불리 행동하지 말고 잠복해 있어야 한다」고 적혀있어. 병력이 부족하니 일단은 포기다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200615
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200615,
					"content": "놈들이 떠나는 걸 보고만 있으라뇨! 그럴 순 없습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200616
					],
					"speakerTitle": "토시히코"
				},
				{
					"id": 120200616,
					"content": "사실 산고노미야 님의 묘책 모음집에는 「궁지에 몰렸을 때 지원군이 나타날 수도 있다」는 말도 있어. 지원군? 누구지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200617
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200617,
					"content": "고로, 너희 여기서 뭐 해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200618
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120200618,
					"content": "대장! 와타츠미섬에 돌아온 겁니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200619
					],
					"speakerTitle": "코토쿠"
				},
				{
					"id": 120200619,
					"content": "도우러 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120200620
					]
				},
				{
					"id": 120200620,
					"content": "#다행이다! 역시 산고노미야 님의 말씀은 틀리지 않았군… {NICKNAME}, 마침 잘 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200621
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200621,
					"content": "최근 우인단의 잔당이 유달리 날뛰고 있어. 이번에 우린 그들의 움직임을 발견하고 미리 여기에 잠복했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200622
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200622,
					"content": "근데 병력이 부족해서 두 팀으로 나눌 수가 없어… 네가 놈들의 주의 좀 끌어줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200623
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200623,
					"content": "알았어. 우인단이 또 나쁜 짓을 꾸미고 있을지도 모르는데, 우리도 가만히 있을 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200624
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120200624,
					"content": "좋아! 시간이 없어, 난 사람들을 데리고 뒤로 가서 배를 불태울게. 나중에 합류하자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200625
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200625,
					"content": "조심해. 금방 돌아올게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120200626
					],
					"speakerTitle": "고로"
				},
				{
					"id": 120200626,
					"content": "저항군이 우릴 기억하고 있었네! 우리가 골치 아픈 문제를 해결해 주자구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
