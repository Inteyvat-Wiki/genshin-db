			"dialogs": [
				{
					"id": 221000101,
					"content": "아, 이걸 어쩌지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000102
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221000102,
					"content": "왜요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000103
					]
				},
				{
					"id": 221000103,
					"content": "어휴, 여기서 객잔을 여는 것도 쉽지 않네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000104
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221000104,
					"content": "여기 적화주엔 억새풀도 많고 보물도 많고 몬스터도 많거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000105
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221000105,
					"content": "그나마 천암군이 주변의 마물을 거의 다 처리해 줘서 망정이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000106
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221000106,
					"content": "근데 최근에 이상하게도 마물들이 하나둘 다시 나타나기 시작했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000107
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221000107,
					"content": "마물들이 객잔 근처까진 다가오진 못해도 매일 그놈들을 보고 있자니 눈에 거슬려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000108
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221000108,
					"content": "만약 시간 있으면 객잔 주변의 몬스터들 좀 정리해줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000109,
						221000110
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221000109,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000111
					]
				},
				{
					"id": 221000111,
					"content": "하하, 말투가 직설적인 게 마음에 드는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221000114,
					"content": "손님에게 부탁하다니… 정말 미안하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000115
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221000115,
					"content": "일 끝내면 보수는 두둑이 줄 테니까, 걱정 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000116
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221000116,
					"content": "그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "회안"
				},
				{
					"id": 221000110,
					"content": "눈에 거슬린다고 없애버리라고요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000112
					]
				},
				{
					"id": 221000112,
					"content": "그 눈에 거슬린다는 게 생각보다 중요한 문제거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000113
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221000113,
					"content": "특히 그 결벽증 도련님이 화를 내기라도 하면 적화주 전체에 비상이 걸릴 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "회안"
				}
			]
