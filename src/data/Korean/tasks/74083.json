			"dialogs": [
				{
					"id": 740820701,
					"content": "맑고 투명한 물방울이 제단 위에 나타났다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740830102,
					"content": "엇, 이 물방울은… 설마 이 물방울이 보물인 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830103,
					"content": "보물같이 생기진 않았는데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830104
					]
				},
				{
					"id": 740830104,
					"content": "내 생각도 그래…. 이렇게 손쉽게 얻은 것도 그렇고… 근데 그럼 이건 뭐지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830105,
						740830110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830105,
					"content": "마왕을 봉인하고 있던 중요한 물건일지도",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830106
					]
				},
				{
					"id": 740830110,
					"content": "누가 여기에 보관한 걸지도 몰라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830111
					]
				},
				{
					"id": 740830106,
					"content": "뭐? 그럼 우리 엄청 크게 사고친 거잖아! 빨리! 늦기 전에 빨리 돌려놔!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830107,
					"content": "아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830108
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830108,
					"content": "큰일 났다! 마왕이 나타났어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830109,
					"content": "마왕? 멜뤼진",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830111,
					"content": "뭐? 이런, 그럼 우린 도둑이 되는 거잖아? 미… 미안하네. 우리 빨리 물건을 제자리에 돌려놓자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830112,
					"content": "아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830113
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830113,
					"content": "망했다! 주인이 돌아왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830114,
					"content": "주인? 멜뤼진",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830115,
					"content": "깜짝이야… 멜뤼진이었구나…. 근데 왜 여기 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830116,
					"content": "열쇠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830117
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830117,
					"content": "무… 무슨 열쇠? 이 물방울이 열쇠야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830118,
					"content": "프샤비",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830119
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830119,
					"content": "어… 이 물방울이 프샤비라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830120,
					"content": "멜뤼진",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830121
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830121,
					"content": "어어? 이 물방울이 멜뤼진이라고? 으아, 어지러워. 대체 무슨 뜻이야! 멜뤼진은 너 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830122,
					"content": "프샤비…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830123
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830123,
					"content": "어… 네가 프샤비라고? 네 이름이 프샤비야? 아, 잠깐만… 나 또 네 대답을 들으면 헷갈릴 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830124,
					"content": "그냥 널 프샤비라고 부를게. 괜찮지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830125,
					"content": "멜뤼진…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830126
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830126,
					"content": "#{NICKNAME}… 어떡하지? 나 도저히 얘 말을 못 알아듣겠어. 대체 뭐라는 거냐구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830127,
					"content": "넌 우리 말을 알아듣는 거 맞지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830128
					]
				},
				{
					"id": 740830128,
					"content": "프샤비…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830129
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830129,
					"content": "이 물방울은 열쇠야, 맞지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830130
					]
				},
				{
					"id": 740830130,
					"content": "프샤비",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830131
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830131,
					"content": "넌 인간이 아니야, 맞지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830132
					]
				},
				{
					"id": 740830132,
					"content": "프샤비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830133
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830133,
					"content": "윽… 갑자기 그런 질문은 좀 무례하지 않을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830134
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830134,
					"content": "난 인간이 아니야, 맞지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830135
					]
				},
				{
					"id": 740830135,
					"content": "메… 멜뤼진?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830136
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830136,
					"content": "앗! 잠깐만, 나 좀 알 것 같은데… 「프샤비」는 긍정이고 「멜뤼진」은 부정인 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830137
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830137,
					"content": "프샤비! 프샤비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830138
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830138,
					"content": "네 이름이 프샤비인 게 아니었구나…. 미안, 내가 오해했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830139,
					"content": "프샤비… 좋아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830140
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830140,
					"content": "그 이름이 좋다고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830141
					]
				},
				{
					"id": 740830141,
					"content": "프샤비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830142
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830142,
					"content": "#잘됐네! 헤헤, 앞으로 그렇게 부르면 되겠다. 이쪽은 {NICKNAME}, 난 페이몬이야. 만나서 반가워, 프샤비. 너 같은 멜뤼진은 처음 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830143
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830143,
					"content": "#페이몬, 프샤비! {NICKNAME}, 프샤비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830144
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830144,
					"content": "에리니에스… 멜뤼진…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830145
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830145,
					"content": "…에리니에스를 부정한다고? 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830146
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830146,
					"content": "에리니에스섬이 안 좋아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830147
					]
				},
				{
					"id": 740830147,
					"content": "에리니에스, 멜뤼진, 지금…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830148
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830148,
					"content": "프샤비, 에리니에스, 지켜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830149
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830149,
					"content": "에리니에스섬이 지금 안 좋아지고 있어서 네가 지켜야 한다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830150
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830150,
					"content": "#페이몬, {NICKNAME}, 에리니에스, 또와줘, 또와줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830151
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830151,
					"content": "#음… 이번엔 단어가 다섯 개네. 그러니까 페이몬이랑 {NICKNAME}한테 에리니에스섬으로 또 와 달라고 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830152
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830152,
					"content": "멜뤼진!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830153
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830153,
					"content": "도와달라는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830154
					]
				},
				{
					"id": 740830154,
					"content": "프샤비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830155
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830155,
					"content": "아~ 도와달라는 거였구나. 난 또 무슨 말인가 했네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830156
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830156,
					"content": "또와줘, 또와줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830157,
						740830161
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830157,
					"content": "보수는 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830158
					]
				},
				{
					"id": 740830161,
					"content": "그럼 어떻게 도와줄까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830158,
					"content": "보…수?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830159
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830159,
					"content": "#어휴, {NICKNAME}, 프샤비는 말을 잘 못해서 도와줄 다른 사람은 찾기 힘들 것 같아. 그러니까 우리가 그냥 도와주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830160
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830160,
					"content": "그럼 어떻게 도와줄까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830162,
					"content": "열쇠, 열쇠, 열쇠, 개수",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830163
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830163,
					"content": "그다음은? 열쇠의 개수가 몇 갠데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830164
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830164,
					"content": "열쇠! 열쇠! 열쇠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830165
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830165,
					"content": "열쇠가 세 개라고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830166
					]
				},
				{
					"id": 740830166,
					"content": "프샤비! 열쇠, 안갯길, 남쪽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830167
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830167,
					"content": "열쇠, 샘의 눈, 북쪽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830168
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830168,
					"content": "열쇠, 버드나무, 동쪽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830169
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830169,
					"content": "오, 그런 뜻이었구나…. 어디 보자… 열쇠는 총 세 개가 있고 각각 남쪽의 안갯길, 북쪽의 샘의 눈, 동쪽의 버드나무… 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830170
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830170,
					"content": "열쇠, 열쇠, 열쇠, 광장, 서쪽",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830171
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830171,
					"content": "서쪽 광장에도 열쇠가 세 개 있다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830172
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830172,
					"content": "열쇠 세 개를 모아서 광장으로 가라고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830173
					]
				},
				{
					"id": 740830173,
					"content": "#페이몬, 멜뤼진! {NICKNAME}, 프샤비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830174
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830174,
					"content": "#에잇, 프샤비, 자꾸 그런 식으로 말하면 {NICKNAME}이(가) 나보다 똑똑해 보이잖아! 얘는 나랑 비슷하단 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830175
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830175,
					"content": "아무튼 이미 열쇠를 하나 얻었으니까, 나머지 두 개만 더 찾으면 되겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830176
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830176,
					"content": "에리니에스, 멜뤼진… 프샤비, 지켜!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830177
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830177,
					"content": "안심해. 무슨 일이 생긴 건진 모르겠지만, 우리가 에리니에스섬 지키는 걸 도와줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830178
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830178,
					"content": "근데 프샤비, 한 가지만 부탁할게… 혹시 우연히 주인이 없는 동글동글한 금색 물건이나 엄청 비싸 보이는 상자를 발견하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830179
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740830179,
					"content": "꼭 우리한테 알려줘야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830180
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740820780,
					"content": "프샤비는 아리송하다는 듯 머리를 긁적이다 이내 신나서 폴짝폴짝 뛰고는 조금 서둘러 자리를 떠났다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740830181,
					"content": "#어, 바로 가버렸네. 엄청 급한 일인가 봐. {NICKNAME}, 그럼 우리도 다른 열쇠를 찾으러 갈까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
