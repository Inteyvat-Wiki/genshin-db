					"nextDialogs": [
						740830205
					]
				},
				{
					"id": 740830205,
					"content": "#페이몬, 프샤비! {NICKNAME}, 프샤비! 열쇠, 열쇠, 열쇠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830206
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740830206,
					"content": "광장, 서쪽!",
					"roleType": "TALK_ROLE_NPC",
