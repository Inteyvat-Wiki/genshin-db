					"nextDialogs": [
						700140110
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700140110,
					"content": "그 녀석의 위치는 지도에 표시해뒀어. 네가 찾고 있던 목표를 찾길 바래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700140111
					],
					"speakerTitle": "엘라·머스크"
				},
