					"nextDialogs": [
						750240602
					],
					"speakerTitle": "「금잔화」"
				},
				{
					"id": 750240602,
					"content": "흥분하지 마. 우린 저 사람이 다쳤는지 확인하러 온 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240603,
						750240605
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750240603,
					"content": "싸우는 수밖에 없겠네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240604
					]
				},
				{
					"id": 750240604,
					"content": "얌마, 포기가 너무 빠르잖아! 금잔화야, 우리는 착한 사람들이야. 음, 그리고 지금 보여주는 호전적인 모습은 네 본성이 아니라는 것도 알아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750240606,
					"content": "까! 우!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240607
					],
					"speakerTitle": "「금잔화」"
				},
				{
					"id": 750240607,
					"content": "와… 더 화난 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750240605,
					"content": "「사랑하는 금잔화야」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240606
					]
				}
