			"dialogs": [
				{
					"id": 200160101,
					"content": "식사 배달 주문",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160102
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200160102,
					"content": "여행자! 마침 잘 왔어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160103
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200160103,
					"content": "미안해요, 배고프겠지만 나 좀 도와줄래요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160104
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200160104,
					"content": "최근 배달 주문이 점점 많아져서, 주문을 지역별로 나눠 주문자를 표기하고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160105
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200160105,
					"content": "그런데 이 <color=#00E1FFFF>통통 연꽃 해산물 수프</color>의 주문자 꼬리표를 잃어버렸지 뭐예요. 샘물 마을에서 주문했다는 것만 알아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160106
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200160106,
					"content": "이 <color=#00E1FFFF>통통 연꽃 해산물 수프</color>를 샘물 마을로 가져가셔서 주문자를 찾아주시겠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160107,
						200160110
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200160107,
					"content": "알겠어요. 근데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160108
					]
				},
				{
					"id": 200160108,
					"content": "돌아오면 한 상 거하게 차려줄게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160109
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200160109,
					"content": "부탁드려요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사라"
				},
				{
					"id": 200160110,
					"content": "너무 배고파요. 난 그냥 밥 먹으러 온 건데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160111
					]
				},
				{
					"id": 200160111,
					"content": "부탁을 들어주면, 내, 내가 디어 헌터의 스페셜 요리를 대접할게요. 제발 도와주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사라"
				}
			]
		},
