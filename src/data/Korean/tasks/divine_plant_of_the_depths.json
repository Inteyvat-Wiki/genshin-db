			"dialogs": [
				{
					"id": 721500301,
					"content": "자네들이구먼, 어서 가서 쉬게나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500302
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500302,
					"content": "코마키 할머니, 할머니가 말한 물을 가지고 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721500303,
					"content": "이게 할머니가 말씀하신 「제일 이상적인 물」이죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500304
					]
				},
				{
					"id": 721500304,
					"content": "맞아, 이 정도면 충분하다네, 정말 고맙네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500305
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500305,
					"content": "허허, 생기가 많이 돌아왔구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500306
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500306,
					"content": "「영초」의 색을 보니… 내년부터 평화롭고 풍족하게 살겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500307
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500307,
					"content": "음… 어떻게 안 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721500308,
					"content": "「영초」의 색이 물의 윤기와 사람들의 「염원」에 의해 결정이 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500309
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500309,
					"content": "이 빛이 바로 염원을 암시하고 있다네. 염원이 아름다울수록 색은 선명하고 윤기가 나고, 미래도 더 희망적이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500310
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500310,
					"content": "왜냐하면… 사람들의 염원은 항상 더 나은 내일을 바라기 때문이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500311
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500311,
					"content": "사람들이 지금보다 더 나은 생활을 위해 무언가를 해달라는 염원만 있으면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500312
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500312,
					"content": "어쩌면 전쟁이 가져다준 궁핍한 생활은 아무것도 아니라네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500313
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500313,
					"content": "음… 그래서 그게 신통한 거랑 무슨 상관이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721500314,
					"content": "물론… 이게 노인들의 지혜라네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500315
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500315,
					"content": "「염원」이 사람들을 행동하게 하고, 행동의 결과들이 「염원」을 인증하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500316
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500316,
					"content": "생활의 평화를 지키기만 한다면, 암담한 날들 속에서 희망을 잃지 않는다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500317
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500317,
					"content": "「영초」의 점괘는 항상 정확할 걸세",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500318,
						721500319
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500318,
					"content": "말도 안 되는 변명으로 미신을 옹호하는 것 같지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				},
				{
					"id": 721500320,
					"content": "허허, 언젠가는 이해하게 될 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500321
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500321,
					"content": "가져온 물의 「염원」 효력은 며칠 더 유지할 수 있을 테니, 필요하다면 언제든지 오게나. 점괘를 봐줄 테니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500319,
					"content": "일리가 있는 것 같기도 하네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				}
			]
		},
