			"dialogs": [
				{
					"id": 721500201,
					"content": "돌아왔구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500202
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500202,
					"content": "말씀하신 거 가지고 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500203
					]
				},
				{
					"id": 721500203,
					"content": "소원 연못의 깨끗한 물, 아직 신선해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721500204,
					"content": "정말 고맙다네, 바로 「영초」에 뿌려주고 오겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500205
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500205,
					"content": "어디까지 말했지… 그렇지, 한 가지 조건을 더 만족해야 「영초」가 더 빛이 난다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500206
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500206,
					"content": "심해의 물 원소가 풍부한 환경이어야만 「영초」의 줄기가 곧게 자라고 「염원」의 색을 더 잘 표현할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500207
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500207,
					"content": "간단하게 말하면… 북쪽에 있는 동굴 안에 영초의 생존 환경과 가장 비슷한 수질을 가진 물 원소가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500208
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500208,
					"content": "동굴 안에 있는 구역에 따라 그 농도도 다 다르다네… 그중에서 농도가 가장 이상적인 물 원소는 가장 밝고 투명한 것일세",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500209
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500209,
					"content": "다른 생물이 섞여서… 탁해진다면 그 물의 원소는 사용할 수가 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500210
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500210,
					"content": "나도 많이 늙어서, 설명을 자세히 못하겠구먼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500211
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500211,
					"content": "가서 직접 보면 무슨 말인지 이해가 바로 될걸세, 허허",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500212
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500212,
					"content": "그 동굴은 보우로우 마을의 선조들의 비밀과 밀접한 관계가 있다네… 하지만 안타깝게도 최근에 있었던 전쟁 때문에 젊은이들은 그곳에 가서 「영초」에 양분 공급하는 것을 꺼리지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500213
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500213,
					"content": "휴… 젊은이들이 안전하게 돌아왔으면 좋겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500214
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500214,
					"content": "그나저나 자네들도 그곳에 가면 꼭 조심해야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500215
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500215,
					"content": "알았어, 걱정하지 말라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500216,
						721500217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721500216,
					"content": "조심할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500218
					]
				},
				{
					"id": 721500218,
					"content": "알겠어, 그럼 됐어… 도와줘서 정말 고맙네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "코마키"
				},
				{
					"id": 721500217,
					"content": "걱정하지 마세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500218
					]
				}
			]
		},
