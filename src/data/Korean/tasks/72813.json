				"points": []
			},
			"dialogs": [
				{
					"id": 728130801,
					"content": "엘라니, 진짜 너야? 네, 네가 왜 이나즈마에 왔지? 리월에 있어야 하는 거 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130802
					],
					"speakerTitle": "카우시크"
				},
				{
					"id": 728130802,
					"content": "윽… 말하자면 끝도 없죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130803
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 728130803,
					"content": "카우시크 씨, 당신은 엘라니와 아는 사이인가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130804
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130804,
					"content": "당신은… 아, 고로 대장이군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130805
					],
					"speakerTitle": "카우시크"
				},
				{
					"id": 728130805,
					"content": "고로 대장 말이 맞아, 엘라니와 나는 모두 아카데미아의 학자야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130806
					],
					"speakerTitle": "카우시크"
				},
				{
					"id": 728130806,
					"content": "우리는 각자 과제를 위해 아카데미아를 떠났지. 물론 여기서 마주칠 줄은 몰랐지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130807
					],
					"speakerTitle": "카우시크"
				},
				{
					"id": 728130807,
					"content": "하지만… 학자들은 자유롭게 아카데미아를 떠날 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130808
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130808,
					"content": "아무나 자유롭게 떠날 수 있는 건 아니야. 나랑 엘라니는 「드리요쉬」에 속하기 때문이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130809
					],
					"speakerTitle": "카우시크"
				},
				{
					"id": 728130809,
					"content": "우리는 떠돌며 공부하는 게 연구의 일부분이라 아카데미아를 나오는 게 허락되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130810
					],
					"speakerTitle": "카우시크"
				},
				{
					"id": 728130810,
					"content": "고로 대장, 내가 엘라니의 신분에 대해 보증을 설 수 있어, 그럼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130811
					],
					"speakerTitle": "카우시크"
				},
				{
					"id": 728130811,
					"content": "카우시크가 보증을 서 줬으니 이제 문제없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130812
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130812,
					"content": "후… 살았네… 고마워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130813
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 728130813,
					"content": "히로유키, 오오쿠보, 너네도 가서 볼일 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130814
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130814,
					"content": "네, 대장",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130815
					],
					"speakerTitle": "히로유키"
				},
				{
					"id": 728130815,
					"content": "알겠습니다, 대장",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130816
					],
					"speakerTitle": "오오쿠보 다이스케"
				},
				{
					"id": 728130816,
					"content": "수상한 인물로 의심해서 미안해요, 엘라니 씨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130817
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130817,
					"content": "음… 물론 혐의는 벗었지만 와타츠미섬에 무단으로 진입해 우리가 아주 귀찮게 됐어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130818
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130818,
					"content": "엥? 무, 무슨 처벌이라도 있는 거야? 난 모라가 별로 없는데, 윽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130819
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 728130819,
					"content": "전에 당신이 비료 판매원이라고 했었죠… 게다가 학자 신분이 있는 비료 판매원 말이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130820
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130820,
					"content": "마침 잘됐네요, 여기 이와타라는 사람이 있는데 비료 때문에 골치를 앓고 있거든요. 엘라니 씨가 가서 좀 도와주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130821
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130821,
					"content": "만약 당신이 그를 도와 그렇게 폐가 되지 않는 비료를 만들 수 있다면, 당신도 카우시크 씨처럼 이 근처에서 자유롭게 연구할 수 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130822
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130822,
					"content": "비, 비료? 아니, 그, 난 그저…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130823,
						728130824
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 728130823,
					"content": "그녀는 잘 해낼거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				},
				{
					"id": 728130825,
					"content": "엘라니, 소재를 얻을 수 있는 좋은 기회야, 네가 이나즈마에 온 이상, 네 논문은 아직…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130826
					],
					"speakerTitle": "카우시크"
				},
				{
					"id": 728130826,
					"content": "음… 으음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130827
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 728130827,
					"content": "아카데미아 졸업 규정을 너도 알고 있겠지, 몇 년 연속 졸업을 못하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130828
					],
					"speakerTitle": "카우시크"
				},
				{
					"id": 728130828,
					"content": "내, 내가 해! 내가 하면 되잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130829
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 728130829,
					"content": "나도 바히드 씨 쪽에 비료에 대해 알아봤었어… 내가 한 번에 해낼 테니 지켜보라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130830,
						728130831
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 728130830,
					"content": "졸업은 사람을 정말 성장하게 하네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130832,
					"content": "그럼 이 일은 이렇게 하는걸로 정하고, 비료에 대해서는 엘라니 씨 부탁 좀 드릴게요. 저는 그럼 먼저 다른 일을 처리하러 가보겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130833
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130833,
					"content": "참, 너희는 기억했다가 이와타 씨에게 전해줘, 그… 비료 더미를 좀 더 멀리 놓아 달라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130834
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130834,
					"content": "그럼 나도 연구를 계속하러 갈게. 엘라니, 혹시 무슨 문제가 있으면 나한테 물어봐도 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카우시크"
				},
				{
					"id": 728130831,
					"content": "졸업이 최고의 원동력이네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130832
					]
				},
				{
					"id": 728130824,
					"content": "엘라니 씨, 부탁할께요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130825
					]
				}
			]
		},
