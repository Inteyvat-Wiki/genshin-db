			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"이와타",
					"고로",
					"페이몬",
					"오오쿠보 다이스케"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130301,
					"content": "고마워, 여행자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130302
					],
					"speakerTitle": "이와타"
				},
				{
					"id": 728130302,
					"content": "방금 비료를 절반 정도 완성했는데, 저 마물 들이 어디서 쳐들어왔는지 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130303
					],
					"speakerTitle": "이와타"
				},
				{
					"id": 728130303,
					"content": "이유를 모르겠네… 네가 와서 정말 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130304
					],
					"speakerTitle": "이와타"
				},
				{
					"id": 728130304,
					"content": "아마 저 비료 더미 때문이겠죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130305
					]
				},
				{
					"id": 728130305,
					"content": "그 그런가? 하지만 이런 냄새가 성공의 전조라고 들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130306
					],
					"speakerTitle": "이와타"
				},
				{
					"id": 728130306,
					"content": "말은 그만하고, 자자, 어서 내가 만든 비료 더미를 봐줘. 열어서 자세히 설명해 줄게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130307
					],
					"speakerTitle": "이와타"
				},
				{
					"id": 728130307,
					"content": "잠깐만요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130308
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130308,
					"content": "어? 고로 님, 어쩐 일로 이곳에?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130309
					],
					"speakerTitle": "이와타"
				},
				{
					"id": 728130309,
					"content": "순찰 중이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130310
					]
				},
				{
					"id": 728130310,
					"content": "나는… 어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130311
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130311,
					"content": "이… 더미들, 혹시 당신들이 만든 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130312
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130312,
					"content": "하하하, 맞아요. 이 비료들은 나와 여행자가 만들었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130313
					],
					"speakerTitle": "이와타"
				},
				{
					"id": 728130313,
					"content": "고로 님, 혹시 비료 상황을 확인하고 싶어 오신 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130314
					],
					"speakerTitle": "이와타"
				},
				{
					"id": 728130314,
					"content": "허허, 마침 잘 오셨네요. 그럼 바로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130315
					],
					"speakerTitle": "이와타"
				},
				{
					"id": 728130315,
					"content": "잠시만! 이거 보러 온 게 아니고, 아니, 이거 보러 왔는데… 아놔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130316
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130316,
					"content": "고로가 못 견디겠다는 표정인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 728130317,
					"content": "우선 우리 이 비료 더미에서 좀 벗어나 볼까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130318
					]
				},
				{
					"id": 728130318,
					"content": "좋아, 우리 근처에 가서 이야기 하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130319
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130319,
					"content": "고로 님, 그나저나 대체 무슨 일로 오신 겁니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130320
					],
					"speakerTitle": "이와타"
				},
				{
					"id": 728130320,
					"content": "요즘, 주민들이 끔찍한 냄새가 난다고 해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130321
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130321,
					"content": "안전을 위해 정찰을 나와 냄새를 따라왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130322
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130322,
					"content": "그리고 당신들을 만난 거죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130323
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130323,
					"content": "이와타 씨, 비료를 계속 연구 중이라 듣긴 했는데 이런 식의 제조 방법은 좀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130324,
						728130325
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130324,
					"content": "민폐예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				},
				{
					"id": 728130326,
					"content": "그렇죠. 아무튼 이와타, 비료 더미부터 치워주세요. 비료에 관해선 내가 다른 방법을 생각해 볼게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130327
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130327,
					"content": "대장! 고로 대장!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130328
					],
					"speakerTitle": "오오쿠보 다이스케"
				},
				{
					"id": 728130328,
					"content": "응, 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130329
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130329,
					"content": "대장, 저희가 외곽에서 수상한 사람을 잡았습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130330
					],
					"speakerTitle": "오오쿠보 다이스케"
				},
				{
					"id": 728130330,
					"content": "그 수상한 놈이 자기가 뭐라더라… 비료 판매원이라고 했습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130331
					],
					"speakerTitle": "오오쿠보 다이스케"
				},
				{
					"id": 728130331,
					"content": "수상하게 생각되어 잡아두었습니다. 얼른 가서 확인해보셔야 할 것 같습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130332
					],
					"speakerTitle": "오오쿠보 다이스케"
				},
				{
					"id": 728130332,
					"content": "또 비료야, 오늘 난 비료를 벗어날 수 없나 보군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130333
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130333,
					"content": "알겠어. 곧 갈 테니, 먼저 가서 질서를 잡고 유지하도록",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130334
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130334,
					"content": "이와타 씨, 우선 비료 더미부터 처리하고 후에 다시 얘기해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130335
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130335,
					"content": "여행자, 너도 같이 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130336,
						728130337
					],
					"speakerTitle": "고로"
				},
				{
					"id": 728130336,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130338,
					"content": "왠지 익숙한 느낌이 드는데… 그런데 기억이 안 나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130339
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 728130339,
					"content": "됐어, 일단 먼저 가서 확인해보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 728130337,
					"content": "비료… 판매원?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130338
					]
				},
				{
					"id": 728130325,
					"content": "자극적이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130326
					]
				}
			]
		},
