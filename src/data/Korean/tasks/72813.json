			},
			"dialogs": [
				{
					"id": 728130901,
					"content": "여행자 돌아왔네, 비료 더미는 이미 처리했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130902
					],
					"speakerTitle": "이와타"
				},
				{
					"id": 728130902,
					"content": "휴, 다른 실험할 곳을 찾아야 겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130903
					],
					"speakerTitle": "이와타"
				},
				{
					"id": 728130903,
					"content": "엥? 이분은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130904,
						728130906
					],
					"speakerTitle": "이와타"
				},
				{
					"id": 728130904,
					"content": "이분은 고로가 찾아 준 조력자예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130905
					]
				},
				{
					"id": 728130905,
					"content": "반가워, 나는 엘라니라고 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130909
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 728130909,
					"content": "그게… 암튼 고로 「대장」이 나보고 네가 비료를 연구하는 걸 도우라고 했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130910
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 728130910,
					"content": "앞으로 잘 부탁해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130911
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 728130911,
					"content": "응… 좋아! 정말 비료 제작에 성공한다면 와타츠미섬에서 더 많은 작물을 심을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130912
					],
					"speakerTitle": "이와타"
				},
				{
					"id": 728130912,
					"content": "비료 더미를 더 멀리 두는 거 잊지 마세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130913
					]
				},
				{
					"id": 728130913,
					"content": "아… 아, 알겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130914
					],
					"speakerTitle": "이와타"
				},
				{
					"id": 728130914,
					"content": "어쨌든, 같이 힘을 합쳐봅시다! 잘 부탁해요! 엘라니 씨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130915
					],
					"speakerTitle": "이와타"
				},
				{
					"id": 728130915,
					"content": "알았어, 열심히 해 볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130916
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 728130916,
					"content": "내 논문을 위해 꼭 노력할게, 윽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엘라니"
				},
				{
					"id": 728130906,
					"content": "수메르에서 온 비료 전문가죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130907
					]
				},
				{
					"id": 728130907,
					"content": "반가워, 나는 엘라니라고 해… 잠깐, 누가 비료 전문가야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130908
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 728130908,
					"content": "그냥… 조금 알 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130909
					],
					"speakerTitle": "엘라니"
				}
			]
