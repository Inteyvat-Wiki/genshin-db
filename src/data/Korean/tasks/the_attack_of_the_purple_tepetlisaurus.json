			"dialogs": [
				{
					"id": 751790201,
					"content": "후, 후——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790202,
						751790204
					],
					"speakerTitle": "자사리"
				},
				{
					"id": 751790202,
					"content": "괜찮으세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790203
					]
				},
				{
					"id": 751790203,
					"content": "괘, 괜찮아. 아까 너무 급하게 뛰는 바람에… 시, 심장이 빨리 뛰는 것뿐이야. 조금 진정하면 괜찮아질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자사리"
				},
				{
					"id": 751790204,
					"content": "푹 쉬세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790205
					]
				},
				{
					"id": 751790205,
					"content": "응, 고, 고마워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자사리"
				}
			]
