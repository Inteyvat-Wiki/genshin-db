					"페이몬"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2893.348,
							257.691,
							9926.251
						],
						"pointId": 10703
					},
					{
						"sceneId": 3,
						"position": [
							-2892.566,
							257.855,
							9924.833
						],
						"pointId": 10710
					},
					{
						"sceneId": 3,
						"position": [
							-2892.844,
