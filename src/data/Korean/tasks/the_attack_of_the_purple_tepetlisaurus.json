			"dialogs": [
				{
					"id": 751791101,
					"content": "어떡하지? 어떡하지? 돌아가면 대장이 분명 날 가만두지 않을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791102,
