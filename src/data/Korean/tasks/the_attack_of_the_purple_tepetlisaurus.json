							9921.14
						],
						"pointId": 10983
					}
				]
			},
			"dialogs": [
				{
					"id": 751790101,
					"content": "거기, 도, 동작 그만! 이건 전부 우리 거거든! 손댈 생각 마! 이봐, 나, 난 「밤 순찰자 전쟁」에 참가할 수도 있는 몸이라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790102
					],
					"speakerTitle": "마소세"
				},
				{
					"id": 751790102,
					"content": "가, 감히 우리 물건을 빼앗으려는 거라면 가만두지 않을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790103
					],
					"speakerTitle": "마소세"
				},
				{
					"id": 751790103,
					"content": "휴… 오늘 정말 무슨 날인가? 화산 폭발에 이어 보라색 산룡이 나타나질 않나… 이젠 무더기로 강도까지 나타나는 거야? 정말 운도 지지리 없지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790104
					],
					"speakerTitle": "이사호"
				},
				{
					"id": 751790104,
					"content": "마소세, 저 사람은 꽤 강해 보이는데? 우린 상대도 안 될 것 같으니 포기하는 게 어때…? 우린 경기를 구경하러 온 거지 참가하러 온 게 아니잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790105
					],
					"speakerTitle": "이사호"
				},
				{
					"id": 751790105,
					"content": "이사호, 너, 너 이 자식! 어떻게 그럴 수가 있어! 이건 우리 모두의 물건이라고! 그, 그리고 우리 둘이 한꺼번에 덤비면 이길 수 있을지도 모르잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790106
					],
					"speakerTitle": "마소세"
				},
				{
					"id": 751790106,
					"content": "우리 둘이라니? 얻어맞고 싶으면 너 혼자 해, 나 끌어들이지 말고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790107
					],
					"speakerTitle": "이사호"
				},
				{
					"id": 751790107,
					"content": "저기, 우린 필요 없으니까 이 물건들을 가져가고 우린 그냥 보내주면 안 될까…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790108,
						751790109
					],
					"speakerTitle": "이사호"
				},
				{
					"id": 751790108,
					"content": "오해가 있는 것 같은데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790111
					]
				},
				{
					"id": 751790111,
					"content": "오해야! 우리는 남을 돕는 걸 좋아하는 착한 모험가지, 나쁜 사람이 아니라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751790112,
					"content": "나, 날더러 그걸 믿으라고? 앗! 아야야. 이사호, 갑자기 왜 때려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790113
					],
					"speakerTitle": "마소세"
				},
				{
					"id": 751790113,
					"content": "저 사람들이 나쁜 마음을 먹었다면 이렇게 입씨름하기도 전에 얻어맞았을걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790114
					],
					"speakerTitle": "이사호"
				},
				{
					"id": 751790114,
					"content": "실은 우리 캐러밴은 조금 전에 뿔뿔이 흩어진 상태야. 모험가라고 했지? 혹시 우리 대장에게 우리가 여기서 기다리고 있다고 전해줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790115
					],
					"speakerTitle": "이사호"
				},
				{
					"id": 751790115,
					"content": "상자 안에 있는 물건은 우리가 주는 사례라고 생각해 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790116
					],
					"speakerTitle": "이사호"
				},
				{
					"id": 751790116,
					"content": "그 정도는 누워서 떡 먹기지! 우리한테 맡겨줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751790109,
					"content": "그렇게 말씀하신다면야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790110
					]
				},
				{
					"id": 751790110,
					"content": "야아! 그렇게 말하면 우리가 나쁜 사람 같잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790111
					],
					"speakerTitle": "페이몬"
				}
			]
		},
