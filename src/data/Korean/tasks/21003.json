					"교서"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210033001,
					"content": "이걸 어쩐담…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033002
					],
					"speakerTitle": "교서"
				},
				{
					"id": 210033002,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033003
					]
				},
				{
					"id": 210033003,
					"content": "음? 누구냐? 다리를 건너는 사람은 모두 검문을 받아야 한다. 넌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033004
					],
					"speakerTitle": "교서"
				},
				{
					"id": 210033004,
					"content": "음… 하지만 넌 그런 이상한 옷을 입고 있으니, 분명 나쁜 사람은 아니겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033005
					],
					"speakerTitle": "교서"
				},
				{
					"id": 210033005,
					"content": "왜냐니… 생각해봐, 나쁜 짓을 하려면 눈에 안 띄는 옷을 입는 편이 더 좋지 않겠어? 너처럼 눈에 튀는 옷을 입을 리가 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033015
					],
					"speakerTitle": "교서"
				},
				{
					"id": 210033015,
					"content": "여기서 뭐 해요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033006
					],
					"speakerTitle": "교서"
				},
				{
					"id": 210033006,
					"content": "난 이 구역 담당 「천암군」이야. 여긴 적화주의 교통 요지이기 때문에 상인이든 행인이든 모두 이곳을 지나야 해. 그래서 난 호위병으로 이곳에 파견됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033007
					],
					"speakerTitle": "교서"
				},
				{
					"id": 210033007,
					"content": "며칠 전에 이 근처에서 몬스터들을 발견했어…. 그 몬스터들이 거기서 터라도 잡은 모양이야. 아직까지 별다른 움직임은 없지만, 그래도 혹시 몰라 계속 주시하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033008
					],
					"speakerTitle": "교서"
				},
				{
					"id": 210033008,
					"content": "가서 그것들을 처리해버리고 싶지만… 내가 자리를 뜨면 혹시라도 다른 몬스터들이 행인들을 습격할까 봐 계속 여기서 이러고 있을 수밖에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033009
					],
					"speakerTitle": "교서"
				},
				{
					"id": 210033009,
					"content": "몬스터들은 제가 이미 다 처리했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033010
					]
				},
				{
					"id": 210033010,
					"content": "네가 다 처리했다고? 아, 정말… 정말 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033011
					],
					"speakerTitle": "교서"
				},
				{
					"id": 210033011,
					"content": "수고 많았어. 원래는 내 일인데 번거롭게 했네, 정말 미안해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033012
					],
					"speakerTitle": "교서"
				},
				{
					"id": 210033012,
					"content": "에휴, 위에선 무슨 생각인지 사람을 보낼 생각도 안 하고. 나 혼자서 어떻게 모든 걸 빈틈없이 처리하겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033013
					],
					"speakerTitle": "교서"
				},
				{
					"id": 210033013,
					"content": "나중에 이 일을 꼭 위에 보고해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033014
					],
					"speakerTitle": "교서"
				},
				{
					"id": 210033014,
					"content": "고마워. 이걸 줄게, 일종의 답례랄까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "교서"
				}
			]
		},
