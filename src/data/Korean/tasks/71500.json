				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"류운차풍진군"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715000101,
					"content": "음… 이거면 됐어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000102
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000102,
					"content": "여행자, 마침 잘 왔어, 방금 이 기구를 설치 완료했다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000103,
						715000105
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000103,
					"content": "이게 바로… 「기관요리 신기」인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000104
					]
				},
				{
					"id": 715000104,
					"content": "그렇다네. 이 기구는 내가 직접 설계하여 용도가 무궁무진하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000107
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000107,
					"content": "이 요리용 기구를 만들기 위해 무수히 많은 고대 서적을 읽었다네. 우선 「요리」 과정에 있어 중요한 주의 사항 몇 가지가 다일세",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000108
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000108,
					"content": "첫 번째는 바로 식자재를 찾는 일이지. 요리에서 제일 중요한 것은 식자재라네. 진귀한 식자재를 구하기 위해서 많은 요리사가 이곳저곳을 돌아다니며 고생을 한다네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000109
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000109,
					"content": "내가 제작한 이 기구는 그 문제를 한 번에 해결했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000110
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000110,
					"content": "이 기구를 작동만 시키면 자동으로 주변에 있는 제일 적합한 요리 재료를 찾아주고 식자재의 기운을 표시해 줘서 요리사는 그 기운만 따라가면 된다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000111
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000111,
					"content": "장치가 직접 움직여서 찾으러 가지는 못하나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000112
					]
				},
				{
					"id": 715000112,
					"content": "크흠, 그건… 연구 시간이 부족해서 아직 그 문제는 해결하지 못했다네…냄비가 어떻게 산지에서 식자재를 스스로 찾겠나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000113
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000113,
					"content": "두 번째는 바로 요리라네. 이 기구에 무수히 많은 정교한 부품을 장착해서 식자재만 넣으면 자동으로 요리를 해준다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000114
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000114,
					"content": "식자재 손질은 어떻게 하죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000115
					]
				},
				{
					"id": 715000115,
					"content": "그건…당연히 레시피에 있는 데이터를 이용해서 모든 식자재의 손질 방법을 설정해놓는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000116
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000116,
					"content": "세세한 설정 방법은 한두 마디로 끝내기 어려우니 설명은 생략하겠네. 엄청 귀찮다는 것만 알아두면 되네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000117
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000117,
					"content": "그 외에, 내가 느낀 점이지만 요리하면서 제일 짜증 나는 일은 바로 「설거지」라네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000118
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000118,
					"content": "아주 맛있게 음식을 먹어서 신이 나는데, 남은 음식을 처리해야 해서 흥이 깨지곤 하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000119,
						715000122
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000119,
					"content": "이 기구 얼마인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000120
					]
				},
				{
					"id": 715000120,
					"content": "하하하, 돈을 아무리 줘도 팔 생각이 없다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000121
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000121,
					"content": "그리고, 이 기구는 아직 나만 작동할 수 있다네. 자네가 산다고 해도 쓸 수가 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000125
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000125,
					"content": "자자, 잡담은 이제 그만하고. 난 기구를 제작하면서 레시피도 같이 연구하고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000126
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000126,
					"content": "기구는 다 만들어졌고, 「기관요리 신기」를 테스트하기 위해 세계에는 없는 레시피를 연구했다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000127
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000127,
					"content": "자네를 부른 이유는 나를 좀 도와줬으면 해서야. 식자재를 찾아서 레시피대로 요리를 해줬으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000128
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000128,
					"content": "첫 번째 요리, 특별히 「문심 두부」라고 이름을 지었다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000129
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000129,
					"content": "이 요리는 두부를 실처럼 얇게 썰어야 하지… 기구의 「칼 솜씨」를 시험해볼 좋은 기회야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000130
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000130,
					"content": "식재료는… 두부, 햄, 죽순과 새고기가 필요해. 감우에게 미리 식자재를 준비해달라고 부탁했지, 여기 있…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000131
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000131,
					"content": "음? 죽순이 어디 갔지? 분명 여기 있었는데, 기구를 설정할 때 누가 훔쳐 간 건가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000132
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000132,
					"content": "흠, 하지만… 이참에 「기관요리 신기」의 식자재 찾는 능력을 보여주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000133
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000133,
					"content": "기관요리 신기… 재가동!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000134
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000134,
					"content": "여행자, 내가 기구를 가동했으니 빨리 기운의 행적을 따라 죽순을 구해오게나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000122,
					"content": "이 기구를 만든 목적이 뭔가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000123
					]
				},
				{
					"id": 715000123,
					"content": "목적이라… 당연히 기구의 새로운 역사를 써 내려가기 위해서이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000124
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000124,
					"content": "그리고 이 기구만 있으면 요리하는 것도 편하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000125
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 715000105,
					"content": "이 기구는 어떻게 쓰는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715000106
					]
				},
				{
					"id": 715000106,
					"content": "흠, 뭐가 그렇게 급한가. 잠시만 기다려보게, 내 천천히 시범을 보여주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715000107
					],
					"speakerTitle": "류운차풍진군"
				}
			]
		},
