			},
			"dialogs": [
				{
					"id": 210330101,
					"content": "모르겠네… 이렇게 하는 게 맞는 걸까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330102
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 210330102,
					"content": "아직도 검을 찾는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330103
					]
				},
				{
					"id": 210330103,
					"content": "여행자? 너구나…. 맞아, 아직도 「장봉」을 찾고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330104
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 210330104,
					"content": "근데 아직까지 쓸모 있는 단서는 못 찾았네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330105
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 210330105,
					"content": "어쩔 수 없지, 리월에서 검 한 자루 찾기란… 너무나도 어려운 일이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330106
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 210330106,
					"content": "누가 그러던데, 장봉은 한참 전에 마물이 부쉈을 거라고…. 설령 그렇다고 해도, 난 검의 모든 조각을 찾아내고야 말 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330107
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 210330107,
					"content": "미안, 혼잣말만 잔뜩 해버렸네. 이번 의뢰의 좌표는 지도에 표시해놨어. 부탁한다, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330108
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 210330108,
					"content": "부디… 검이 멀쩡하길…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "란 누님"
				}
			]
		},
