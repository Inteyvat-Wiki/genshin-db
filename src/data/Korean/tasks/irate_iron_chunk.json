					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161602
					],
					"speakerTitle": "아란바리카"
				},
				{
					"id": 730161602,
					"content": "우리 칭찬받았어! 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161603
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730161603,
					"content": "이제 땅속으로 들어갈 수 있어. 빨리 따라와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161604
					],
					"speakerTitle": "아란바리카"
				},
				{
					"id": 730161604,
					"content": "좋아, 우리 빨리 아란바리카를 따라 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
