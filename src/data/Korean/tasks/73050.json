			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"아란리캔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500201,
					"content": "#나라{NICKNAME}와(과) 페이몬! 바나를 「아프게」 하려는 나쁜 녀석들은 그 뒤로 다시 나타나지 않았어. 이제 안심해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500202
					],
					"speakerTitle": "아란리캔"
				},
				{
					"id": 730500202,
					"content": "#나라{NICKNAME}(이)랑 페이몬, 도와줘서 고마워. 덕분에 아란리캔이 바나를 지킬 수 있었어… 그래서 나라{NICKNAME}와(과) 페이몬에게 꽃을 선물로 주려고 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500203
					],
					"speakerTitle": "아란리캔"
				},
				{
					"id": 730500203,
					"content": "꽃을 받으면 아란리캔의 좋은 친구가 되는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란리캔"
				}
			]
		},
		{
