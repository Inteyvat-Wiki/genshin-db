			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"아란나가"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500301,
					"content": "우트사바 축제… 그리운 느낌인데… 음? 하얀색 둥실이… 그리고 금빛의 나라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500302
					],
					"speakerTitle": "아란나가"
				},
				{
					"id": 730500302,
					"content": "나라 친구와 나라 친구의 친구네. 우트사바 축제에서 즐거운 시간 보내길 바랄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500303
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 730500303,
					"content": "친구의 친구도 친구지! 금빛의 나라랑 하얀 털 슝슝도 아란가루의 친구야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란가루"
				}
			]
		}
	]
