					"nextDialogs": [
						708240202
					]
				},
				{
					"id": 708240202,
					"content": "청소하는 법을 아세요? 그래… 지금은 인력이 부족하니까 도와주시면 정말 고맙죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240203
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 708240203,
					"content": "안으로 들어가요. 청소해야 할 곳이 엄청 많아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
