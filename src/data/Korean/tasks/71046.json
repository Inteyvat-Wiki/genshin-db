				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"철홍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710460201,
					"content": "잠깐! 층암거연은 중요 지역으로 외부 여행객은… 아, 너였구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460202
					],
					"speakerTitle": "철홍"
				},
				{
					"id": 710460202,
					"content": "망했어! 빨리 도망치자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460203,
						710460204,
						710460205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710460203,
					"content": "페이몬, 진정해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460206,
					"content": "하하하하… 놀라게 해서 미안해. 내가 생명의 은인을 잊을 리가 없잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460207
					],
					"speakerTitle": "철홍"
				},
				{
					"id": 710460207,
					"content": "나도 최근 교대로 여기 오게 됐어… 근데 여기서 은인을 만날 줄은 몰랐네, 난 정말 운이 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460208
					],
					"speakerTitle": "철홍"
				},
				{
					"id": 710460208,
					"content": "은인…? 우리 뭐 좋은 일이라도 했었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710460209,
					"content": "그게 무슨 소리야! 모두가 바다의 마수와 싸울 때 나도 군옥각에 있었거든. 그때 부상을 좀 입었는데 최근에 다 나았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460210
					],
					"speakerTitle": "철홍"
				},
				{
					"id": 710460210,
					"content": "넌 내가 기억이 안 날 수도 있겠지만 난 널 기억하고 있어. 그때 함께 싸웠던 형제들 모두 네가 리월을 위해 노력한 걸 직접 지켜봤으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460211
					],
					"speakerTitle": "철홍"
				},
				{
					"id": 710460211,
					"content": "층암거연에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460212
					]
				},
				{
					"id": 710460212,
					"content": "2년 전쯤에 광갱에서 원인 불명의 사고가 발생한 이후에 칠성의 명령으로 폐쇄됐어. 광부들 대부분이 무사히 철수했지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460213
					],
					"speakerTitle": "철홍"
				},
				{
					"id": 710460213,
					"content": "다만, 아쉽게 됐어. 이렇게 큰 광산이 그대로 폐쇄되다니. 광부들은 보조금을 받고 생계를 위해 뿔뿔이 흩어졌어… 휴, 함께했던 사람들이라 해도 헤어지면 다시 만나기 어렵잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460214
					],
					"speakerTitle": "철홍"
				},
				{
					"id": 710460214,
					"content": "아, 쓸데없는 얘기로 샜네, 미안. 중요한 일이 있어서 온 거 같으니까 더는 시간 안 뺏을게. 볼일이 있으면 목영을 찾아가면 돼, 목영은 입구 쪽 야영지에 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460215
					],
					"speakerTitle": "철홍"
				},
				{
					"id": 710460215,
					"content": "음… 널 믿지 못하는 건 아니지만, 맡은 직책이 있으니 하나만 당부할게. 여기서 질서를 어지럽히는 일은 하면 안 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460216
					],
					"speakerTitle": "철홍"
				},
				{
					"id": 710460216,
					"content": "걱정 마, 우릴 못 믿는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710460204,
					"content": "절 아세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460205,
					"content": "들켰어, 얼른 도망치자!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				}
			]
		}
	]
}