			"trigger": {
				"objectNames": [
					"아가피아"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790220701,
					"content": "#{NICKNAME}, 이 거울의 여인은 좀 이상한걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220702
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790220702,
					"content": "…어서… 어서 돌아가야 하는데, 그는 아직… 근데 오빠들이 보이지 않아… 오빠들의 사진…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220703
					],
					"speakerTitle": "아가피아"
				},
				{
					"id": 790220703,
					"content": "어이, 우인단의…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220704
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790220704,
					"content": "오빠들의 사진… 사진을 잃어버려서 돌아갈 수 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220705
					],
					"speakerTitle": "아가피아"
				},
				{
					"id": 790220705,
					"content": "우인단이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220706
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790220706,
					"content": "안 돼, 그를 놔둬선… 그를 혼자 둬선 안 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220707,
						790220708
					],
					"speakerTitle": "아가피아"
				},
				{
					"id": 790220707,
					"content": "상태가 안 좋아 보이는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220709
					]
				},
				{
					"id": 790220709,
					"content": "이런 장면 어디서 본 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220710
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790220710,
					"content": "저번에 우인단…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220711
					]
				},
				{
					"id": 790220711,
					"content": "맞아, 저번에 체프카 만났을 때, 걔도 계속 「휘장, 휘장…」거려서 휘장을 줬더니 정신을 차렸었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220712
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790220712,
					"content": "우인단이 여기서 한 실험이 결국 자신에게도 영향을 미쳤구나. 이런 걸 「인과응보」라고 하지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220713
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790220713,
					"content": "페이몬 말이 맞아!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220714
					]
				},
				{
					"id": 790220714,
					"content": "그러고 보니 저 거울의 여인, 체프카가 말했던 사람 아니야? 우인단 소대 대원이라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220715
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790220715,
					"content": "그럼 우리가 그녀의 정신이 돌아올 만한 물건을 찾아 줘야 하는 건가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220716
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790220716,
					"content": "오빠들이랑 같이 찍은 단체 사진… 그게 없으면 난 돌아갈 수 없어. 그런데… 그런데 그는 아직 그곳에 있어. 혼자서 날 기다리고 있다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790220717
					],
					"speakerTitle": "아가피아"
				},
				{
					"id": 790220717,
					"content": "#알겠다… {NICKNAME}, 쟤가 계속 찾는 그 사진을 가져와야 제정신으로 돌아올 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790220708,
					"content": "대화가 안 통하는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790220709
					]
				}
			]
		},
