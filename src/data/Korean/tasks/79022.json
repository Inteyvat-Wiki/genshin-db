			},
			"dialogs": [
				{
					"id": 790221101,
					"content": "참… 그나저나 우리가 이 섬에서 회중시계를 하나 주웠잖아. 그 회중시계 속 사진이 그 사진 아닐까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790221102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790221102,
					"content": "회중시계를 그녀에게 보여주자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7902212,
			"completionStepIds": [
				7902213
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902213",
