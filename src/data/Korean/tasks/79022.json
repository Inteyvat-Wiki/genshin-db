			"dialogs": [
				{
					"id": 790222501,
					"content": "너와 우린 적이야. 적이랑 많이 얘기해서는 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222502
					],
					"speakerTitle": "자카르"
				},
				{
					"id": 790222502,
					"content": "적이랑 너무 많이 얘기하면 서로 친해지고 마음이 약해지지. 그러면 전투할 때 불리해져…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222503
					],
					"speakerTitle": "자카르"
				},
				{
					"id": 790222503,
					"content": "교관님이 그렇게 말씀하셨어",
					"roleType": "TALK_ROLE_NPC",
