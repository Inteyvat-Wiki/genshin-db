			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아가피아",
					"자카르"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790222301,
					"content": "자카르, 자카르… 괜찮은 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222302
					],
					"speakerTitle": "아가피아"
				},
				{
					"id": 790222302,
					"content": "아가샤, 무슨 일이야… 나 여기서 잠깐 자고 일어났더니 몸이 많이 좋아졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222303
					],
					"speakerTitle": "자카르"
				},
				{
					"id": 790222303,
					"content": "휴… 네가 무사하면 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222304
					],
					"speakerTitle": "아가피아"
				},
				{
					"id": 790222304,
					"content": "헤헤. 맞다, 아가샤, 나한테 줬던 과일 네 개 있잖아. 너랑 같이 먹으려고 하나도 안 먹었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222305
					],
					"speakerTitle": "자카르"
				},
				{
					"id": 790222305,
					"content": "나 참, 원래 너 주려고 딴 사과거든! 기다리다 배고프면 먹지 그랬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222306
					],
					"speakerTitle": "아가피아"
				},
				{
					"id": 790222306,
					"content": "너 혼자 임무하러 가는 게 더 힘들잖아… 배고프긴 하지만 난 참았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222307
					],
					"speakerTitle": "자카르"
				},
				{
					"id": 790222307,
					"content": "어? 혼자 임무를 하러 간다니? 무슨 임무…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790222308,
					"content": "아, 야코프가 장비를 망가뜨릴 뻔했거든 그래서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222309
					],
					"speakerTitle": "자카르"
				},
				{
					"id": 790222309,
					"content": "자카르! 너 아무거나 다 말해주면 어떡해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222310
					],
					"speakerTitle": "아가피아"
				},
				{
					"id": 790222310,
					"content": "#아! 너희는 내부 문건의 {NICKNAME}와(과)…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222311
					],
					"speakerTitle": "자카르"
				},
				{
					"id": 790222311,
					"content": "「작은 비행 인간」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222312
					]
				},
				{
					"id": 790222312,
					"content": "맞아, 「작은 비행 인간」!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222313
					],
					"speakerTitle": "자카르"
				},
				{
					"id": 790222313,
					"content": "이젠 별 감흥도 없다. 내 이름은 「페이몬」이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790222314,
					"content": "헤헤, 난 좀 멍청해. 내 이름은 자카르야… 잠깐, 너희와 우리 우인단은… 적이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222315
					],
					"speakerTitle": "자카르"
				},
				{
					"id": 790222315,
					"content": "아가피아, 네가 적을 여기로 데려온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222316
					],
					"speakerTitle": "자카르"
				},
				{
					"id": 790222316,
					"content": "맞아. 이 둘은 가시덤불에서 널 구해준 착한… 착한 적이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222317
					],
					"speakerTitle": "아가피아"
				},
				{
					"id": 790222317,
					"content": "아 그렇지, 네가 가고 나서 여기에 갑자기 거대한 가시덤불이 자라나 동굴을 둘러쌌는데… 너희들이 그 거대한 가시덤불을 없애주었구나. 대단한걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222318
					],
					"speakerTitle": "자카르"
				},
				{
					"id": 790222318,
					"content": "맞아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790222319,
					"content": "근데 우리 적이잖아. 왜 적을 도와주는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222320
					],
					"speakerTitle": "자카르"
				},
				{
					"id": 790222320,
					"content": "대답하기 힘들지만 정말 좋은 질문이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222321
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790222321,
					"content": "아가샤가 널 구해주면 우리한테 너희들이 대체 뭘 하는지 알려주겠다고 했거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222322
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790222322,
					"content": "아가샤, 너 정말 우인단의 정보를 팔아넘길 셈이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222323
					],
					"speakerTitle": "자카르"
				},
				{
					"id": 790222323,
					"content": "상관없어, 자카르. 「우인단이 바다에서 신비로운 구피를 잡고 있다」 같은 거짓말로 대충 때우면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222324
					],
					"speakerTitle": "아가피아"
				},
				{
					"id": 790222324,
					"content": "와, 대놓고 거짓말을 하려 하다니. 우릴 너무 쉽게 보는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222325
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790222325,
					"content": "좋아, 가시덤불도 없애주고 자카르도 구해줬어. 너희들이 무슨 일을 하려는지 말하는 게 좋을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222326
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790222326,
					"content": "말해선 안 돼, 아가피아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222327
					],
					"speakerTitle": "자카르"
				},
				{
					"id": 790222327,
					"content": "휴… 어쩔 수 없지… 사실 우리도 사정을 잘 몰라, 단순히 테스트하러 온 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222328,
						790222329
					],
					"speakerTitle": "아가피아"
				},
				{
					"id": 790222328,
					"content": "테스트?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222330
					]
				},
				{
					"id": 790222330,
					"content": "아마 무슨 신호 테스트일걸… 구체적인 건 나도 잘 몰라. 그래도 소대 내 다른 팀이라면 알고 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222331
					],
					"speakerTitle": "아가피아"
				},
				{
					"id": 790222331,
					"content": "걔네들은 많이 알려줬는데, 너희들은 이거뿐이라는 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222332
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790222332,
					"content": "내가 알고 있는 게 많지 않아서… 그럼 정보도 알려줬으니 우릴 놓아주는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222333
					],
					"speakerTitle": "아가피아"
				},
				{
					"id": 790222333,
					"content": "보내주겠다고 한 적은 없지만, 위험해 보이진 않으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222334
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790222334,
					"content": "그러면 우리가 아량을 베풀도록 할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222335
					]
				},
				{
					"id": 790222335,
					"content": "어머, 그러면 너무 고맙지. 휴, 두 섬으로 간 다른 팀 녀석들은 어떻게 됐는지 모르겠네. 임무를 다 끝내면 바다 한가운데 있는 야영지에서 만나기로 했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222336
					],
					"speakerTitle": "아가피아"
				},
				{
					"id": 790222336,
					"content": "아, 혹시…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790222337
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790222337,
					"content": "그전에 만났던 다른 우인단 말하는 건가…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222338
					]
				},
				{
					"id": 790222338,
					"content": "이미 만난 적이 있어? 안 되겠다, 자카르. 우리 빨리 야영지로 돌아가자. 전에 합류하기로 했던 약속 장소로 가야 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아가피아"
				},
				{
					"id": 790222329,
					"content": "무슨 테스트요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790222330
					]
				}
			]
		},
