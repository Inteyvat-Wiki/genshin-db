				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320101,
					"content": "왔구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320102
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320102,
					"content": "단서는 찾았어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320103
					]
				},
				{
					"id": 400320103,
					"content": "응. 산고 사장님 덕분에 찾았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320104
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320104,
					"content": "사장님의 「추리」에 근거하여, 대략 장소를 몇 군데 유추해냈어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320105
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320105,
					"content": "야영지 한 곳은 어제의 그 「모자견」이 지키고 있어. 각별히 조심해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320106
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320106,
					"content": "페이몬이 지은 별명 같네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320107
					]
				},
				{
					"id": 400320107,
					"content": "잠깐! 페이몬은 그런 식으로 짓지 않는다구. 나라면 아마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400320108,
					"content": "그래——「칼날견」이라고 하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400320109,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320110
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320110,
					"content": "아무튼 저쪽에 같은 기관을 설치했어. 이번에도 효과가 있었으면 좋겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320111
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320111,
					"content": "와! 무시당했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400320112,
					"content": "그럼, 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320113
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320113,
					"content": "무슨 문제 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320114
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320114,
					"content": "위치는 확실해요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320115
					]
				},
				{
					"id": 400320115,
					"content": "내가 직접 현지답사했으니 당연히 확실하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320116
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320116,
					"content": "류지는 왜 우리와 같이 가지 않는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400320117,
					"content": "나도 함께 가고 싶지만 공교롭게도 오늘 산고 사장님한테서 다른 임무가 내려왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320118
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320118,
					"content": "「모자견」의 정체에 대해 무슨 생각이 있으신지, 내게 조사를 부탁했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320119
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320119,
					"content": "「칼날견」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400320120,
					"content": "「모자견」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320121,
						400320124
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320121,
					"content": "「모자 칼날견」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320122
					]
				},
				{
					"id": 400320122,
					"content": "이상해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320123
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320123,
					"content": "별명이 뭐 이래? 이상해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400320125,
					"content": "…됐어, 그냥 「검은 그림자」라고 부르자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320126
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320126,
					"content": "아무튼, 동물을 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "류지"
				},
				{
					"id": 400320124,
					"content": "이런 걸로 싸우지 말자고, 페이몬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320125
					]
				}
			]
		},
		{
			"id": 4003203,
			"completionStepIds": [
				4003203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003203",
							"2"
						],
						"stepId": 4003203,
						"stateName": "QUEST_STATE_UNFINISHED"
