				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"류지"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400320301,
					"content": "수고들 했어. 어디 보자… 수량이 안 맞는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320302
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320302,
					"content": "동물이 이렇게 많이 실종됐다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400320303,
					"content": "그래. 의뢰 내용에 따르면 이제 절반 정도밖에 못 찾았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320304
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320304,
					"content": "아쉽게도 지금은 단서가 끊겼어. 하지만 괜찮아. 물건이 살아있는 동물보다 조사하기 쉬우니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320305
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320305,
					"content": "전에 부잣집의 도둑맞은 물건을 찾아준 적 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320306
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320306,
					"content": "그때 몇 번이나 단서가 끊겼지만, 결국 산고 사장님의 추리 덕분에 찾아냈지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320307,
						400320325
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320307,
					"content": "자세히 말해줄 수 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320308
					]
				},
				{
					"id": 400320308,
					"content": "재밌을 것 같은데 계속 이야기해 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400320309,
					"content": "두 사람이 탐정에 흥미가 있으리라고는 생각지도 못했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320310
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320310,
					"content": "사실 당시 우리는 이미 용의자를 확정 지었지만, 그의 집에서 장물을 찾지 못했고 다른 단서도 없었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320311
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320311,
					"content": "그 뒤로 수소문하던 중 우연히 용의자가 하루 전에 울림풀을 팔았다는 사실을 알게 됐어. 내가 구매자를 찾아가 울림풀을 확인하니 그런대로 신선한 편이었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320312
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320312,
					"content": "산고 사장님은 그 사실을 알고는 바로 요고우산 산기슭 일대를 조사하라고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320313
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320313,
					"content": "어? 왜 요고우산이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400320314,
					"content": "당시 산고 사장님의 말을 빌리자면… 「우선 용의자는 나루카미섬에 살고 있었어. 이나즈마에는 울림풀이 있는 곳이 많지만 다른 섬으로 가려면 반드시 배가 필요해. 하지만 우리는 배를 발견하지 못했지」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320315
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320315,
					"content": "「게다가 텐료 봉행은 쇄국령으로 인해 배에 굉장히 민감하기 때문에, 용의자가 범행을 계획했다면 절대로 텐료 봉행의 눈에 거슬리는 행동은 하지 않았을 거야」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320316
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320316,
					"content": "「그러니 다른 섬은 배제한 거지」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320317
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320317,
					"content": "그런데 나루카미 다이샤 근처에도 울림풀이 있잖아? 왜 요고우산 산기슭이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400320318,
					"content": "그 점은 산고 사장님도 생각했어. 「나루카미 다이샤에는 무녀가 있고 참배하는 신자들도 있어」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320319
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320319,
					"content": "「수상한 자가 있으면, 오가는 사람들이 많아서 들키기 쉽지」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320320
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320320,
					"content": "그랬구나! 이젠 믿을 수 있어. 산고는 확실히 두뇌파야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320321
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400320321,
					"content": "그리고 요고우산 산기슭에서 역시나 흙더미를 발견했는데 최근에 파헤친 흔적이 있었어. 용의자는 장물을 묻고 상황이 잠잠해지면 다시 꺼내서 처분하려 했던 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320322
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320322,
					"content": "그도 광주리를 메고 나갔다가 빈손으로 돌아오면 의심받을지도 모르니 길가의 울림풀을 따서 판 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320323
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320323,
					"content": "그런데 아이러니하게도 울림풀이 단서가 된 거네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320324
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400320324,
					"content": "맞아. 그러니까 분명히 우리가 아직 눈치채지 못한 어떤 단서가 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320327
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320327,
					"content": "이런 협력 관계 꽤 괜찮네. 난 발로 뛰는 것만 잘하지, 잠입과 전투는 내 특기가 아니거든. 싸움과 전투를 너에게 맡기면 정말 좋을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320328
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320328,
					"content": "어때? 「만능 산고」에 취직할 생각 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320329
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320329,
					"content": "산고… 사장님이 소통이 좀 어렵고 「양심은 지혜의 짐」이라는 말을 하기도 하지만, 속은 참 착한 사람이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320330,
						400320331
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320330,
					"content": "됐어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320332
					]
				},
				{
					"id": 400320332,
					"content": "아쉽게 됐군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320333
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320333,
					"content": "그런데 산고 사장님 옆에 너처럼 유능한 사람이 있었다면 난 진작에 실직했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320334
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320334,
					"content": "여기서부터는 내가 조사할게. 다른 일 있으면 먼저 볼일 보러 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320335
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400320335,
					"content": "이따가 탐정소에서 다시 만나자. 고생했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "류지"
				},
				{
					"id": 400320331,
					"content": "고맙지만 사양할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320332
					]
				},
				{
					"id": 400320325,
					"content": "이번에도 순조로우면 좋겠는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400320326
					]
				},
				{
					"id": 400320326,
					"content": "응응, 동물을 잃어버린 마을 사람들이 불안해하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400320327
					],
					"speakerTitle": "페이몬"
				}
			]
		},
