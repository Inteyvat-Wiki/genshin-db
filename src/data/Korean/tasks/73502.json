				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020101,
					"content": "「대낮과 교대하는 대낮, 급히 퇴근하는 등대의 뒷모습이 다리 위에서 보인다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020102
					],
					"speakerTitle": "조사"
				},
				{
					"id": 735020102,
					"content": "이게, 뭐야… 수수께끼인가? 아니면 속담 같은 건가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735020103,
					"content": "대낮과 교대하는 대낮? 퇴, 퇴근하는 뒷모습…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735020104,
					"content": "아, 여행자잖아? 너희도 드루수스 씨의 수수께끼에 관심이 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020105,
						735020106
					],
					"speakerTitle": "카말"
				},
				{
					"id": 735020105,
					"content": "이게 정말 수수께끼인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				},
				{
					"id": 735020107,
					"content": "이 수수께끼를 설치하신 분은 바로 아카데미아의 학자 드루수스 씨야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020108
					],
					"speakerTitle": "카말"
				},
				{
					"id": 735020108,
					"content": "그분은 아카데미아에서도 괴짜로 불리지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020109
					],
					"speakerTitle": "카말"
				},
				{
					"id": 735020109,
					"content": "사람들과 여러 가지 수수께끼를 토론하고 각양각색의 암호화 방식을 연구하는 게 취미래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020110
					],
					"speakerTitle": "카말"
				},
				{
					"id": 735020110,
					"content": "그런데 그분의 수수께끼는 너무 난해해서 다들 그분과의 토론을 기피하는 바람에",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020111
					],
					"speakerTitle": "카말"
				},
				{
					"id": 735020111,
					"content": "이런 식의 「경품 퀴즈」 방식을 고안하셨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020112
					],
					"speakerTitle": "카말"
				},
				{
					"id": 735020112,
					"content": "간단히 말해서, 이 수수께끼에는 「보물 매장지」가 감춰져 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020113
					],
					"speakerTitle": "카말"
				},
				{
					"id": 735020113,
					"content": "정확한 시간에 정확한 방식으로 정확한 위치에 도착하면 보물을 얻을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020114
					],
					"speakerTitle": "카말"
				},
				{
					"id": 735020114,
					"content": "드루수스 씨는 「보물 매장지」가 모두 수메르성 안에 있다는 힌트를 남겼어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020115
					],
					"speakerTitle": "카말"
				},
				{
					"id": 735020115,
					"content": "하지만 보다시피 지금까지 어떤 모험가도 이 수수께끼를 풀지 못했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020116
					],
					"speakerTitle": "카말"
				},
				{
					"id": 735020116,
					"content": "관심 있으면 한번 도전해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020117
					],
					"speakerTitle": "카말"
				},
				{
					"id": 735020117,
					"content": "다만 개인적으로는 이것보다 쓸모 있는 일을 하라고 권하고 싶어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카말"
				},
				{
					"id": 735020106,
					"content": "누가 설치했는지 아시나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020107
					]
				}
			]
		},
		{
			"id": 7350203,
			"completionStepIds": [
				7350203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350203",
							"2"
						],
						"stepId": 7350203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"드루수스"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735020301,
					"content": "오늘도 역시 아무도 안 오는 것인가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020302
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735020302,
					"content": "여기가 「지식의 전당 정문」 맞나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020303
					]
				},
				{
					"id": 735020303,
					"content": "맞아! 여기가 바로 「지식의 전당 정문」이야. 보아하니… 내 모든 수수께끼를 푼 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020304
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735020304,
					"content": "다행이다! 오늘도 아무도 풀지 못할 줄 알았거든! 조금 있으면 점심시간인데 말이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020305
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735020305,
					"content": "왜 이런 수수께끼들을 쓴 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020306
					]
				},
				{
					"id": 735020306,
					"content": "물론 「재미」 때문이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020307
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735020307,
					"content": "대답이 너무 빠른데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735020308,
					"content": "재미 말고 내가 왜 이런 수수께끼를 썼다고 생각해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020309
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735020309,
					"content": "단순히 사람을 괴롭히는 걸 즐겨서라고 생각하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020310,
						735020311
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735020310,
					"content": "아마도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				},
				{
					"id": 735020312,
					"content": "하하하, 너희들도 아카데미아의 누구처럼 나를 오해했나 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020313
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735020313,
					"content": "이런 수수께끼를 쓴 이유는 단순히 내가 수수께끼를 풀 때의 사변 과정을 좋아해서야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020314
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735020314,
					"content": "내가 쓴 수수께끼를 다시 보면 수수께끼를 풀 수 있는 「키워드」를 발견할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020315
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735020315,
					"content": "이 키워드를 돌파구로 삼아 끊임없이 생각하면 수수께끼를 풀 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020316
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735020316,
					"content": "단순히 사람을 괴롭히려고 썼다면 모든 단서를 지워서 「풀 수 없는 퀴즈」로 만드는 편이 나아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020317
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735020317,
					"content": "얘기는 여기까지 하고, 내 수수께끼를 모두 풀었으니 이것들을 가져가도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735020318
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735020318,
					"content": "이것은 너희들이 「사변」으로 얻은 보상이니 잘 받아둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735020311,
					"content": "그럴지도 모르죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735020312
					]
				}
			]
		},
