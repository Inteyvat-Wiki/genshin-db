				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110010201,
					"content": "네가 향릉이군, 그렇지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010202
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 110010202,
					"content": "죄송해요, 두라프 씨. 제 잘못이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010203
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110010203,
					"content": "네가 한 일은 다 들었다. 이왕 여기까지 왔으니——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010204
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 110010204,
					"content": "무, 무서워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010205,
						110010206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110010205,
					"content": "폭, 폭력은 안 돼요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010207
					]
				},
				{
					"id": 110010207,
					"content": "——우리 고기 홍보 좀 해줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010208
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 110010208,
					"content": "…에?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010209
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110010209,
					"content": "미안하군, 조금 무례했나. 내 제대로 설명하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010210
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 110010210,
					"content": "샘물 마을은 고기 품질이 좋기로 유명해, 근데 그 명성이 몬드에만 국한되어선 안 되지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010211
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 110010211,
					"content": "마침 주방장 향릉이 몬드에 왔다는 소식을 듣고 앨런에게 데려와 달라고 부탁한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010212
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 110010212,
					"content": "주방장?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110010213,
					"content": "못 들어봤나? 리월항에서 독보적인, 서민 음식을 주로 다루는 「만민당」의 주방장이 바로 향릉이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010214
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 110010214,
					"content": "식자재를 독특하게 해석해 만든 요리는 현지 주민의 사랑을 받을 뿐만 아니라 여행객들에게도 호평 일색이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010215
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 110010215,
					"content": "헤헤, 과찬이세요. 전 그저 저렴하고 맛있는 음식을 만들고 싶었던 것뿐이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010216
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110010216,
					"content": "향릉 같은 일류 주방장이 일류 고기로 일류 요리를 만든다면, 우리 샘물 마을의 고기도 유명해질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010217
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 110010217,
					"content": "하지만… 이 부탁은 들어줄 수 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010218
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110010218,
					"content": "전 맛있는 요리를 만들고 싶은 것뿐이지, 식자재를 정해둔 적도, 홍보 같은 걸 해본 적도 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010219
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110010219,
					"content": "어차피 고기도 네가 원하던 식자재니까 상관없지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010220
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 110010220,
					"content": "달라요, 아주 다르다구요! 제가 슬라임 응축액을 첨가하겠다면 동의하시겠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010221
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110010221,
					"content": "그, 그건 좀… 정상적인 식자재를 쓸 순 없는 거니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010222
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 110010222,
					"content": "비정상적인 식자재는 없어요! 뭐든지 방법만 적절하면 맛있는 요리를 만들 수 있다구요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010223
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110010223,
					"content": "식자재에 영감이 제한되면 안 돼요. 그러면 식상한 요리밖에 안 나오니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010224,
						110010225
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110010224,
					"content": "갑자기 분위기가 바뀌었어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010226
					]
				},
				{
					"id": 110010226,
					"content": "휴, 이렇게 단호하면 어쩔 수 없지. 하지만 정말 아쉬운걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "두라프"
				},
				{
					"id": 110010225,
					"content": "이게 바로 주방장의 집념인가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010226
					]
				},
				{
					"id": 110010206,
					"content": "정말 매가 필요한 거라면… 절 혼내세요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010207
					]
				}
			]
		},
		{
			"id": 1100104,
			"completionStepIds": [
				1100104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100104",
							"2"
						],
						"stepId": 1100104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"향릉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110010401,
					"content": "안녕하세요, 언니가 한 이 요리 좀 먹어볼 수 있을까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010402
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110010402,
					"content": "미안하지만 예약이 꽉 차서 일주일 후에나 먹을 수 있을 것 같은데, 괜찮을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010403
					],
					"speakerTitle": "브룩"
				},
				{
					"id": 110010403,
					"content": "인기가 대단하네…. 엄청 맛있나봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110010404,
					"content": "이상하네, 분명 이렇게 환영받는 요리사가 있는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010405
					]
				},
				{
					"id": 110010405,
					"content": "그러게, 두라프 씨는 왜 향릉한테 부탁한 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110010406,
					"content": "에휴… 아마 몬드가 리월항 같은 대륙의 상업 요지에 비해 맛이 대중적이지 않다고 생각하는 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010407
					],
					"speakerTitle": "브룩"
				},
				{
					"id": 110010407,
					"content": "난 인정 못 해! 난 한 번도 내 고기 요리가 뒤처진다고 생각한 적 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010408
					],
					"speakerTitle": "브룩"
				},
				{
					"id": 110010408,
					"content": "그럼 이번 한 번만 먹게 해줘요, 내가 피드백을 해줄 수 있을지도 모르잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010409
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110010409,
					"content": "일반인은 그저 「맛있어」 같은 쓸모없는 말만 하지, 네가 향릉도 아니… 잠깐… 넌 향릉이잖아?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010410
					],
					"speakerTitle": "브룩"
				},
				{
					"id": 110010410,
					"content": "네, 맞아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010411
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110010411,
					"content": "너였구나! 그럼 너도 고기 요리를 엄청 잘하겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010412
					],
					"speakerTitle": "브룩"
				},
				{
					"id": 110010412,
					"content": "사실 오늘의 최상급 고기를 조금 남겨뒀는데 이걸로 스테이크를 만든다면 어떻게 만들 생각이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010413
					],
					"speakerTitle": "브룩"
				},
				{
					"id": 110010413,
					"content": "그건 육질과 지방량에 따라 다르죠. 이 고기라면 해염, 절운고추 그리고 청심화를 곁들여 석판구이를 만들고 싶네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010414
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110010414,
					"content": "청심화를?! 그건 가열되면 날것일 때보다 향이 몇 배나 더 강해져서 고기 본연의 향이 가려진다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010415
					],
					"speakerTitle": "브룩"
				},
				{
					"id": 110010415,
					"content": "나도 알아요. 이 청심화는 스테이크에 쓸 향신료가 아닌 고명으로 쓸 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010416
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110010416,
					"content": "해보니까, 불 세기를 잘 조절하고 기름을 거친 청심화는 꽃잎의 쓴맛도 없고 식감도 더 깔끔해지더라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010417
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110010417,
					"content": "그다음 고산지대에서 자란 절운고추를 넣는데, 낮은 습도와 큰 기온 차로 인해 생긴 특별한 향이 나죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010418
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110010418,
					"content": "해염의 짠맛, 절운고추의 매운맛, 그리고 스테이크의 향긋한 기름 향이 꽃잎과 어우러져 입안에서 식물의 향긋함까지 느낄 수 있죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010419
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110010419,
					"content": "말만 번지르르하고, 이건 주객이 전도됐잖아?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010420
					],
					"speakerTitle": "브룩"
				},
				{
					"id": 110010420,
					"content": "스테이크면 스테이크지, 고기 향이 사라지면, 스테이크를 무슨 맛으로 먹으라는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010421
					],
					"speakerTitle": "브룩"
				},
				{
					"id": 110010421,
					"content": "으아아, 싸우지 마, 진정하라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010422,
						110010423
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110010422,
					"content": "다른 사람 말은 들리지도 않나봐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010424
					]
				},
				{
					"id": 110010424,
