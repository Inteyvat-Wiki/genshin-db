			},
			"dialogs": [
				{
					"id": 225000301,
					"content": "3000 모라면 될까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000302
					]
				},
				{
					"id": 225000302,
					"content": "성격 한번 급하시군요…. 좋아요, 우리 사이를 생각해서 룰루의 향고를 먼저 만들게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000303
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 225000303,
					"content": "하지만 낮엔 가게를 봐야 하니 밤에나 작업할 수 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000304
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 225000304,
					"content": "밤에 다시 오세요. 작업 준비를 제대로 해 놓을게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "앵아"
				}
			]
		},
		{
			"id": 2250004,
