			"dialogs": [
				{
					"id": 225000601,
					"content": "#{M#오빠}{F#언니}, 향고를 받았어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000602
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000602,
					"content": "받았어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000603
					]
				},
				{
					"id": 225000603,
					"content": "#{M#오빠}{F#언니}, 고마워요. 앵아 언니의 향고는 최고예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000604
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000604,
					"content": "소몽이와 아비가 냄새를 맡으면 어떤 반응을 보일지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000605
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000605,
					"content": "어떤 반응을 보이든 재미있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000606,
						225000608
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000606,
					"content": "다들 좋아할 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000607
					]
				},
				{
					"id": 225000607,
					"content": "그럼 좋죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000610
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000610,
					"content": "#{M#오빠}{F#언니}, 고마워요. 집에 가서 향고를 써봐야겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000611
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000611,
					"content": "잘 맞는다면 계속 사용할 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000608,
					"content": "누구와 노는 게 가장 좋니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000609
					]
				},
				{
					"id": 225000609,
					"content": "음, 「가장 좋은」 건 없어요. 소몽이와 아비 모두 최고로 좋아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000610
					],
					"speakerTitle": "룰루"
				}
			]
