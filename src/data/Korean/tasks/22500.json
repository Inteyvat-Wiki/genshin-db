			},
			"dialogs": [
				{
					"id": 225000101,
					"content": "언제쯤 잘할 수 있을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000102
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000102,
					"content": "오늘은 게임 안 하니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000103
					]
				},
				{
					"id": 225000103,
					"content": "#{M#오빠}{F#언니}, 요새 게임하기 좀 힘들어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000104
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000104,
					"content": "소몽이가 요새 울적한지 혼자 멍때리고만 있어요. 아비도 잘 보이지 않구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000105
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000105,
					"content": "소몽이한테 왜 그러냐고 물어봤는데 말을 안 해줘요…. 요새 다들 좀 이상해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000106,
						225000110
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000106,
					"content": "자라면 다 그래",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000107
					]
				},
				{
					"id": 225000107,
					"content": "자라면 울적해지는 거예요? 근데 소몽이랑 아비는 빨리 어른이 되고 싶어하는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000108
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000108,
					"content": "그렇다면 난 자라지 않는 게 좋겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000109
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000109,
					"content": "#그 이야기 말고 일이 좀 있는데 {M#오빠}{F#언니}, 도와주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000112,
					"content": "앵아 언니한테 가서 물건 좀 받아다 줄 수 있어요? 언니와 이야기했으니 물건을 준비해뒀을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000113,
						225000115
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000113,
					"content": "내게 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000114
					]
				},
				{
					"id": 225000114,
					"content": "#그럼 부탁해요, {M#오빠}{F#언니}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000115,
					"content": "앵아한테서…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000116
					]
				},
				{
					"id": 225000116,
					"content": "#{M#오빠}{F#언니}, 이상하게 생각하지 말아요. 앵아 언니한테 뭘 좀 만들어달라고 한 것뿐이니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000117
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000117,
					"content": "#어쨌든, {M#오빠}{F#언니}, 부탁해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "룰루"
				},
				{
					"id": 225000110,
					"content": "너도 기분이 울적하니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000111
					]
				},
				{
					"id": 225000111,
					"content": "#나요? 난 괜찮아요. 근데… 일이 좀 있어서 {M#오빠}{F#언니}, 도와주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "룰루"
				}
			]
		},
		{
			"id": 2250002,
			"completionStepIds": [],
