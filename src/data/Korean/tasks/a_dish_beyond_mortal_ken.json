				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"강설"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290301,
					"content": "어라? 귀한 손님이 와 있었네. 평소에는 나와 주방장 둘뿐이라 썰렁했는데, 오늘은 네가 있어서 화기애애하겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290302
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290302,
					"content": "근데 오늘 보니 주방장이 죽상이던데, 무슨 고민 있나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "강설"
				}
			]
		},
		{
			"id": 7182904,
			"completionStepIds": [
				7182903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182903",
							"2"
						],
						"stepId": 7182903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"강설",
					"언소"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290401,
					"content": "이 완자 맛 좋은데, 살이 연해서 살살 녹고 국물 맛도 일품이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290402
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290402,
					"content": "엇? 게살이 들어서 이렇게 맛이 좋았던 거구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290403
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290403,
					"content": "자, 여행자, 너도 맛 좀 봐. 젓가락으로 완자를 국물에 찍어서 밥과 함께 먹는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290404,
						718290405,
						718290407
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290404,
					"content": "칭찬해 주셔서 감사해요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290409
					]
				},
				{
					"id": 718290409,
					"content": "두 사람이나 많이 먹으라고. 어차피 난 여기서 짤릴 테니 이참에 많이 먹어둬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290410
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718290410,
					"content": "짤릴 거라니… 그게 무슨 소린가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290411
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290411,
					"content": "후, 내가 너무 공짜로 얻어먹어서 자네가 지배인에게 한 소리 들었나 보군?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290412
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290412,
					"content": "아니, 나도 실한 물고기를 잡는 족족 객잔에 넘겼어, 그 정도면 밥값으로는 충분할 텐데. 그리고 여기 지배인도 그렇게 쪼잔한 사람이 아니고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290413
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290413,
					"content": "어서 먹기나 해. 네가 잡아온 물고기를 누가 다 먹었지? 다 네가 먹어치웠잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290414
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718290414,
					"content": "그럼 대체 왜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290415
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290415,
					"content": "휴… 그래, 말해줄게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290416
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718290416,
					"content": "예쁘고, 맛있고, 기개도 느껴지는 데다가, 예술적으로 보여야 하고 격식도 있어야 한다라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290417
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290417,
					"content": "하하, 지배인이 이 세상에 있을 리가 없는 진기한 요리를 만들어 내라고 한 거군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290418
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290418,
					"content": "그래 웃어라, 웃어. 내가 떠난 뒤에 누구한테 얻어먹을 수 있을지 한번 보자고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290419
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718290419,
					"content": "아이 웃어봐. 요리사가 오늘따라 왜 이렇게 울상이냐고 물었는데, 알고 보니 그런 일이 있었군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290420
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290420,
					"content": "그것 말고도 지배인이 얼마나 기상천외한 방법으로 나를 괴롭혔는지 넌 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290421
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718290421,
					"content": "에이, 너도 참 둔하군. 난 요리를 할 줄 모르지만, 아주 기묘한 요리를 하나 알고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290422
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290422,
					"content": "이건 내가 세상을 떠돌아다니다가 우연히 한 대부호의 저택에서 먹은 기묘한 요리인데, 「꼬꼬 연두부」라고 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290423
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290423,
					"content": "이 요리는 「고기지만 고기 같지 않은」 요리야. 먹으면 연두부같이 부드럽지만 고기향은 아주 진하게 느껴져서 아주 맛있어. 기묘한 「채식 같은 육식」 요리라고 할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290424
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290424,
					"content": "이 요리를 먹고 난 후에 너무 신기해서 레시피를 배워왔지만, 난… 요리를 잘 하지 못하니까 이 레시피를 오랫동안 묵혀둘 수밖에 없었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290425,
						718290428
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290425,
					"content": "어떻게 이 요리 레시피를 배워오신 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290426
					]
				},
				{
					"id": 718290426,
					"content": "음… 간단히 말하자면 내가 그 대부호 집을 도와준 적이 있는데, 그때 그분들이 날 초대해 주셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290427
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290427,
					"content": "이 요리를 만든 요리사는 아주 자신만만했다고, 세상에 이 요리를 만들 수 있는 사람은 손에 꼽을 정도라서 레시피를 나한테 알려줘도 상관없다고 했었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290429
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290429,
					"content": "맞아, 만들기 엄청 어려워. 그 요리사 얘기대로라면 요리 실력뿐만 아니라 검술에도 정통해야 한다던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290430
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290430,
					"content": "쳇, 무슨 요리에 검술이 필요해? 만약 고기를 다져야 하는 거면 내 칼 솜씨로도 충분해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290431
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718290431,
					"content": "네가 만약 네 칼로 고기를 부드럽게 만들려면 고기가 부드러워지기 전에 네 도마부터 두 동강 났을걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290432
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290432,
					"content": "그 요리사는 이 요리의 정수는 다 고기의 부드러움에서 나오는 거라고 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290433
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290433,
					"content": "정교한 칼 솜씨가 필요해. 먼저 날을 세워서 힘줄을 제거하고 고기를 다져서 진흙처럼 만든 다음 칼등으로 두드려서 부드럽게 만들고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290434
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290434,
					"content": "야, 기다려봐… 네가 말한 레시피는 말하나 마나인 거 아니야? 나는 늘 주방에 있던 사람이고 너는 주방에 들어와 본 적도 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290435
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718290435,
					"content": "요리도 잘하면서 검술도 뛰어난 사람을 어디서 찾지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290436
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718290436,
					"content": "글쎄… 멀리서 찾으려면 멀고, 가까운 곳에서 찾으려면 눈앞에도 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290437,
						718290439
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290437,
					"content": "저… 저요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290438
					]
				},
				{
					"id": 718290438,
					"content": "정답. 때마침 여행자는 요리도 잘하고 검술도 뛰어나잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290441,
					"content": "아니면 여행자에게 이 요리를 맡겨보는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290442
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290442,
					"content": "하지만 지배인님이 언소 씨한테 맡긴 일인 걸요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290443
					]
				},
				{
					"id": 718290443,
					"content": "에이, 지배인은 요리사를 닦달해서 새로운 요리를 만들어내려고 하는 거야, 누가 만든 거냐고 물어보면 그때 다시 방법을 생각해 보면 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290444
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290444,
					"content": "어때 요리사, 일리가 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290445
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290445,
					"content": "어… 맞아! 아주 논리적이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290446
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718290446,
					"content": "하지만 이 꼬꼬 연두부는 도대체 어떤 재료를 써야 하는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290447
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718290447,
					"content": "식자재는 비교적 흔한 것들이야. 새고기, 햄, 새알, 금어초면 충분하다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290448
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290448,
					"content": "새고기와 햄은 있지만, 새알이랑 금어초는… 내가 이미 다 써버린 거 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290449
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718290449,
					"content": "어휴, 이럴 줄 알았으면 송이 새알 볶음은 만들지 말걸 그랬어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290450
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718290450,
					"content": "여행자, 나한테 새알 1개, 금어초 1개만 구해다 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290451
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718290451,
					"content": "찾고 나서 같이 이 꼬꼬 연두부를 어떻게 만들지 연구해보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290452
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718290452,
					"content": "음… 물론 보수는 섭섭하지 않게 챙겨줄게… 잘 부탁해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "언소"
				},
				{
					"id": 718290439,
					"content": "확실히 제 요리 솜씨가 나쁘지 않긴 하죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290440
					]
				},
				{
					"id": 718290440,
					"content": "검도 잘 다루잖아, 맞지? 내가 평소에 눈여겨봤었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290428,
					"content": "만들기 엄청 어려울 것 같은데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290429
					]
				},
				{
					"id": 718290405,
					"content": "먹는 법을 되게 잘 아시네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290406
					]
				},
				{
					"id": 718290406,
					"content": "하하하, 이렇게 맛있는 음식을 자주 먹으면 바보라 해도 깨닫게 되지. 이 생선찜을 어떻게 먹는지도 알려줄게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "강설"
				},
				{
					"id": 718290407,
					"content": "왜 같이 안 드세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290408
					]
				},
				{
					"id": 718290408,
					"content": "나? 난 됐어. 아침에 지배인님한테 욕을 배 터지게 먹었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "언소"
				}
			]
		},
