		},
		{
			"id": 7182903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182902",
							"2"
						],
						"stepId": 7182902,
						"stateName": "QUEST_STATE_UNFINISHED"
