{
	"id": 73509,
	"type": "WQ",
	"name": "폭발과 끓음!",
	"description": "우림 남서쪽 방사벽 일대에서 이상한 학생을 만났다. 여행자와 페이몬은 그녀에게 꽤 깊은 인상을 남겼던 듯하다…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 5129,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
	"prevMainQuestList": [],
	"steps": [
		{
			"id": 7350901,
			"order": 1,
			"listShowType": "QUEST_SHOW",
			"description": "이상한 학자와 대화하기",
			"finishConditions": [
				{
					"type": "QUEST_CONTENT_COMPLETE_TALK",
					"rawParams": [
						7350901,
						0
					],
