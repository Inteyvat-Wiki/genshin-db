	],
	"talks": [
		{
			"id": 7350901,
			"completionStepIds": [
				7350901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350901",
							"2"
						],
						"stepId": 7350901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"하자나드"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735090101,
					"content": "흐흐흐… 하하하하… 성공했다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090102
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090102,
					"content": "이젠 용병들을 고용해서 각 실험에 배치하고 열흘 내로 초기 전투 능력을 달성하기만 하면 되겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090103
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090103,
					"content": "현장 인력의 보고만 있으면 지도 교수님을 확실히 설득해 더 많은 예산을 받을 수 있을 거고, 나아가 아카데미아에 이게 최강의 연금 포션이라는 걸 증명할 수 있겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090104
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090104,
					"content": "음? 이 사람은 왜 여기서 혼자 사막을 보며 웃고 있는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090105,
					"content": "용병과 전투를 언급한 걸 보면 전투광인가 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090106,
					"content": "#{NICKNAME}, 어떻게 할까? 일단… 이 녀석한테서 좀 떨어지는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090107,
						735090124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090107,
					"content": "난 좀 관심이 가는데, 일단 더 지켜보자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090108
					]
				},
				{
					"id": 735090108,
					"content": "아, 맞다! 너도 싸움에 일가견이 있었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090109,
					"content": "그러고 보니 전에도 비슷한 상황이 있었네——네가 상대랑 말이 잘 통하면, 대부분 상대가 도움을 청하는 결말로 이어졌잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090110,
					"content": "나쁜 짓을 하는 게 아니고 모라도 넉넉히 준다면야, 고려해 볼 수 있지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090111,
					"content": "음? 누가 뒤에서 내 얘기를 하나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090112
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090112,
					"content": "세… 세상에 너희였구나! 금발의 이방인과 「날아다니는 하얀색 스마트 도우미 단말기」!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090113
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090113,
					"content": "음, 우리를 알아? 나한테 그런 별명이 있었나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090114,
					"content": "누구시죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090115
					]
				},
				{
					"id": 735090115,
					"content": "날 잊은 모양이네…. 뭐 그럴 수도 있지. 난 평범한 일반인일 뿐이고 너희는 살아있는 전설이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090116
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090116,
					"content": "예전에 너희가 내 야심작 「재용해 약제」——신식 전투 보조 연금 포션 테스트를 도와줬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090117
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090117,
					"content": "연구는 순조로웠지. 너희는 전투의 쾌감을 느끼며, 내게 수많은 데이터와 영감을 줬으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090118
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090118,
					"content": "너희는 내 인생을 바꿔준 사람이라 늘 고마워하고 있었어! 덕분에 내 연구 성과도 일부 「30인단」 단원들과 수메르 치안에 도움이 됐고 말이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090119
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090119,
					"content": "그, 그 정도였다구? 이따가 한번 제대로 떠올려 봐야겠네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090120,
					"content": "그나저나 아까 전투랑 포션에 대해 중얼거리던데, 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090121,
					"content": "이번에도 우리 도움이 필요해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090122,
					"content": "나야 좋지! 너희가 있다면야 용병들이랑 엮일 필요도 없으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090123
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090123,
					"content": "솔직히 용병들한테 바가지 쓰이거나 약탈당할까 봐 걱정했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090139
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090139,
					"content": "날 도와 「부글부글 혼합제」 테스트를 완료해준다면, 모든 예산을 너희한테 줄게. 지난 일에 대한 감사도 담아서 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090140
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090140,
					"content": "총 50인분의 보수에 달하는 모라인데, 이 정도면 충분하지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090141
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090141,
					"content": "50인분의 모라? 어디 보자… 그럼 하루만 일해도 한동안은 일할 필요 없는 거 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090142
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090142,
					"content": "#정말 좋은 의뢰인 것 같아. {NICKNAME}, 이런 기회는 흔치 않다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090143,
						735090144
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090143,
					"content": "좋은 기회인 것 같아요. 받아들일게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090145
					]
				},
				{
					"id": 735090145,
					"content": "좋아. 너희는 여전히 시원시원하구나! 바로 본론으로 들어갈게——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090146
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090146,
					"content": "전에 적색 모래바다에서 「재용해 약제」를 테스트할 때 「약 온도」의 결함을 발견했어. 무더운 환경에서 약제가 폭발할 경우 효과가 기대 미달이었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090147
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090147,
					"content": "그래서 약제를 안정 액체 매개물에 섞고 녹는점이 높은 약제와 분리한 다음, 사용 시 둘을 혼합해서 용기에 압력을 가하기로 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090148
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090148,
					"content": "약제가 들끓는 액체 매개물 속에서 폭발하면 더 효율적이고 안정적인 「폭발과 끓음 반응」을 실현할 수 있어. 새로운 장치도 이에 따라 「부글부글 장치」라고 명명했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090149
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090149,
					"content": "이러면 화염꽃 옆에 하루 종일 앉아 있더라도, 연금 포션의 효과를 정상적으로 누릴 수 있지. 장치 전체의 안정성이 획기적으로 상승한 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090150
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090150,
					"content": "게다가 장치에 타이머와 기록 기능까지 추가해서 전투 중에 「부글부글 장치」가 자동으로 작동하고 전투 정보도 기록하니까 전보다 훨씬 편리해졌지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090151
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090151,
					"content": "어… 아무튼 이 간편하고 대단한 보조 장치를 들고 마물을 혼내주면 된다는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090152
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090152,
					"content": "맞아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090153
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090153,
					"content": "하자나드는 여전히 열심이구나. 우리 같은 문외한에게도 이렇게 자세히 설명해주다니, 나도 어느 정도 이해가 된 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090154
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090154,
					"content": "다른 성격 나쁜 학자였다면… 「확인된 문제를 수정했다」 정도로 대충 얼버무렸겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090155,
						735090156
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090155,
					"content": "아무튼 자동으로 작동하고 기록하니까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090157
					]
				},
				{
					"id": 735090157,
					"content": "좋아. 그럼 우린 늘 하던 대로, 하자나드를 도와 이 장치의 효과를 테스트해 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090158
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090158,
					"content": "우리 전문 분야잖아! 가볍게 전투만 하면 모라도 왕창 챙길 수 있는 데다 하자나드까지 도울 수 있으니, 서로 윈윈이네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090159
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090159,
					"content": "정말 효율 높은 대화야! 역시 용병들보단 너희랑 같이 일하는 게 훨씬 깔끔하다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090160
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090160,
					"content": "실험 장소는 이미 확보했어. 멀지 않은 곳에 비경이 있으니 가서 테스트해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090161
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090161,
					"content": "난 여기서 너희의 피드백을 기다리고 있을게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090156,
					"content": "구체적인 원리는 잘 몰라도 되겠지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090157
					]
				},
				{
					"id": 735090144,
					"content": "어서 「부글부글 혼합제」에 대해 알려주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090145
					]
				},
				{
					"id": 735090124,
					"content": "잠깐, 어디서 본 느낌인데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090125
					]
				},
				{
					"id": 735090125,
					"content": "네 말대로 확실히 낯이 익네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090126,
					"content": "생각났다. 예전에 우림 절벽에서 만난 적이 있었지! 이름이 뭐였더라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090127,
						735090129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090127,
					"content": "연금솥 차 끓이기 마스터였지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090128
					]
				},
				{
					"id": 735090128,
					"content": "음… 아주 진지한 연금술사여서 연금솥으로 연구 외의 일을 하진 않았던 것 같은데… 아, 생각났다. 이름이 하자나드였지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090131,
					"content": "음? 누가 뒤에서 내 얘기를 하나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090132
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090132,
					"content": "세… 세상에 너희였구나? 금발 이방인과 「날아다니는 하얀색 스마트 도우미 단말기」!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090133
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090133,
					"content": "여기서 만날 줄이야! 하자나드, 그동안 잘 지냈어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090134
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735090134,
					"content": "더할 나위 없을 정도로 잘 지냈지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090135
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090135,
					"content": "난 「재용해 약제」 연구 성과로 논문을 발표하며 약제의 우월성을 증명하고 「30인단」의 주목까지 받았거든! 다 너희 덕분이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090136
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090136,
					"content": "원래 내 지도 교수였던 그 무능한 녀석은 날 무시했지만 내 논문에 대한 평가는 그 녀석과 그 녀석의 학생들을 압도했어. 그래서 그 녀석을 걷어차 버릴 수 있었지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090137
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090137,
					"content": "새로운 지도 교수님은 내 연구를 아주 높게 평가해주셔서, 날 위해 새로운 프로젝트까지 만들어주시고 많은 예산까지 지원해주셨어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090138
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090138,
					"content": "마침 잘됐다. 혹시 시간 괜찮으면 나 좀 도와줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735090139
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735090129,
					"content": "마의 폭발 약물 연금 괴인이었지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735090130
					]
				},
				{
					"id": 735090130,
					"content": "이봐, 그런 별명은 내가 지어주는 거라구! 이름이 아마… 하자나드였지!",
					"roleType": "TALK_ROLE_NPC",
