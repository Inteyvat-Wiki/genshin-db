			"dialogs": [
				{
					"id": 4630001,
					"content": "휴~ 드디어 수수께끼를 다 풀었네. 힘들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630014
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630014,
					"content": "그나저나 이 보물지도는 해적이 만든 거라 그런지 역시 참 조잡해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630002
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630002,
					"content": "그럼 이제…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630003,
						4630005
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630003,
					"content": "케이아 씨한테 가서 보고부터 하자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630004
					]
				},
				{
					"id": 4630004,
					"content": "응…? 페이몬은 그럴 필.요.없.다.고 생각하는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630006
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630006,
					"content": "역시, 나랑 잘 통해! 나도 딱 그 말하려던 참이었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630007
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630007,
					"content": "바로 안 갔다가 다른 사람한테 뺏기면 큰일 나잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630008
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630008,
					"content": "그러니까 그… 케이아가 말했던 「보물 사냥단」 같은 놈들 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630009
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630009,
					"content": "아무튼, 난 그냥 그 검을 빌려서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630010
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630010,
					"content": "아… 아니, 그냥 한번 구경해보고 싶을 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630011
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630011,
					"content": "절대로 천하무적이 되어 먹고 놀고 싶은 게 아냐! 절대!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630012
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630012,
					"content": "잡담은 보물을 먼저 찾고 나서 하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630013
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630013,
					"content": "아카디아 보물 찾기 모험은 이제부터 시작이당!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630005,
					"content": "바로 보물이 있는 곳으로 가자!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630006
					]
				}
			]
		},
