			"dialogs": [
				{
					"id": 4630101,
					"content": "「아카디아 유적」은 이쯤이겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630102,
					"content": "흠… 뭔가 평범한 것 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630103,
					"content": "알겠다! 등잔 밑이 어둡다고, 가장 평범하게 보이는 곳이 발견하기 더 어려우니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630104,
					"content": "철학적이야…. 역시 케이아의 할아버지는 위대한 해적이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630105,
					"content": "——쏴쏴, 콰당",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630106
					],
					"speakerTitle": "???"
				},
				{
					"id": 4630106,
					"content": "응? 페이몬, 무슨 소리가 안 들려?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630107
					]
				},
				{
					"id": 4630107,
					"content": "생쥐가 있나 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630108,
					"content": "너무 건성으로 대답하는 거 아냐?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630109
					]
				},
				{
					"id": 4630109,
					"content": "휴… 아무 일도 없을 테니까 너무 의심하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4630110,
					"content": "빨리, 빨리! 보물이 우릴 기다리고 있다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
