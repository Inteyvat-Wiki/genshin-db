			"dialogs": [
				{
					"id": 716662101,
					"content": "훌륭하군!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662102
					],
					"speakerTitle": "「다음 대결 복기를 기대하시게」"
				},
				{
					"id": 716662102,
					"content": "아라타키파의 자랑인 곤충 싸움이 이토록 치열한 각축전으로 발전했다니. 흐음, 아주 멋진 이야기를 쓸 수 있을 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662103
					],
					"speakerTitle": "「다음 대결 복기를 기대하시게」"
				},
				{
					"id": 716662103,
					"content": "형씨, 한 수 가르쳤어. 즐거운 대결이었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662104
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 716662104,
					"content": "「한 수 배웠어」겠지, 오니의 왕",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662105
					],
					"speakerTitle": "「하나카도 장군」"
				},
				{
					"id": 716662105,
					"content": "크흠! 그런 건 중요하지 않아! 어쨌든… 와줘서 고마워, 형씨!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662106
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 716662106,
					"content": "아라타키파 대장도 수고가 많네. 난 한동안 이곳에서 곤충 싸움을 구경하며 소재를 구해볼 생각이야. 난 신경 쓰지 말고 마음껏 즐기게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662107
					],
					"speakerTitle": "「다음 대결 복기를 기대하시게」"
				},
				{
					"id": 716662107,
					"content": "정말 교양 있는 상대야. 계속 듣고 있으니 머리가 좀 띵한 게 곤충 싸움 말고 다른 지식도 습득한 느낌이랄까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662108
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 716662108,
					"content": "이번 「아라타키 반짝반짝 갑각 곤충 싸움 수행」은 시작이 좋군!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아라타키 이토"
				}
			]
