				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200101,
					"content": "으아? 윽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200102
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200102,
					"content": "아, 나라다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200103
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200103,
					"content": "크흠, 나라에게 곤경에 빠진 모습을 보이다니 정말 부끄럽네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200104
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200104,
					"content": "착한 나라, 나는 아란차토라야. 너희는?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200105
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200105,
					"content": "#난 {NICKNAME}(이)라고 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200106
					]
				},
				{
					"id": 730200106,
					"content": "페이몬이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200107,
					"content": "#나라{NICKNAME}(이)랑 페이몬, 알겠어. 정말 고마워. 여기서 너희를 만나지 않았더라면 회복하는 데 시간이 조금 걸렸을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200108
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200108,
					"content": "우리가 안 왔으면 얼마나 오래 이렇게 있으려고 했어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200109,
					"content": "부끄럽지만 예전에도 나쁜 버섯 때문에 비슷한 상황을 겪은 적이 있는데, 달 연꽃이 물속에서 두 번 피었다 지고 나서야 겨우 회복됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200110
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200110,
					"content": "달의 연꽃이 피고 지었다면… 그건 이틀 걸렸다는 거잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200111,
					"content": "아, 이틀. 그게 바로 「날짜」라는 거구나. 너희 나라들은 정말 재미있어. 이틀은 긴 편이야 짧은 편이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200112
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200112,
					"content": "#음… {NICKNAME}, 어때? 이틀이면 긴 편인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200113,
						730200116,
						730200120,
						730200123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200113,
					"content": "긴 편이지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200114
					]
				},
				{
					"id": 730200114,
					"content": "맞아, 아란차토라가 꼬박 이틀 동안 「으아아아」만 했다는 게 믿기지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200115,
					"content": "그래? 이게 긴 시간이었구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200126,
					"content": "그나저나 네 이름이 아란차토라라면… 혹시 아란파카티의 가족이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200127,
					"content": "아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200128
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200128,
					"content": "엥? 너… 아란파카티의 오빠 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200129,
					"content": "응, 어떻게 알았어? 아란파카티는 내 「동생」이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200130
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200130,
					"content": "도대체 뭐라는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200131,
					"content": "아란나라한테는 다른 개념인가 봐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200132
					]
				},
				{
					"id": 730200132,
					"content": "아무튼 우리가 여기 온 이유는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200133,
					"content": "아란차토라에게 자초지종을 이야기한다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730200134
					]
				},
				{
					"id": 730200134,
					"content": "우트사바 축제가 또 열리는 건가, 이걸 어쩌지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200135
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200135,
					"content": "우트사바 축제에서 사용할 중요한 「식자재」가 아직 준비되지 않았는데…. 이러면 아란사카, 아란파스, 아란팔라에게 버섯 요리가 최고라는 걸 증명할 수 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200136
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200136,
					"content": "그러고 보니, 아…아란…파…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200137
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200137,
					"content": "아란사카, 아란파스, 아란팔라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200138
					]
				},
				{
					"id": 730200138,
					"content": "으아아! 아란나라의 이름은 정말 외우기 힘들어! 아란차토라의 형제들은 어디 갔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200139,
					"content": "강물이 시냇물로 갈라지는 것처럼, 우리도 각자의 수행을 선택하고 다른 길을 가게 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200140
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200140,
					"content": "그냥 흩어졌다는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200141
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200141,
					"content": "「요리 수행」의 최종 목표는 「최고의 진미」를 완성하는 건데, 모두 버섯 요리는 인정 못한대. 어떻게 그럴 수가 있지? 「머리 버섯」은 최고인데 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200142
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200142,
					"content": "아무튼 우린 각자 요리를 완성하고 다시 대결하기로 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200143
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200143,
					"content": "그렇구나. 맛에 대한 추구라면 충분히 이해할 수 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200144
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200144,
					"content": "그래서 「머리 버섯」은 어떻게 됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200145
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200145,
					"content": "최근에 「마라나」의 넝쿨이 「머리 버섯」이 자라는 곳까지 퍼졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200146
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200146,
					"content": "아, 죽음의 땅… 라나가 무사했으면 좋겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200147
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200147,
					"content": "넝쿨의 말라빠진 발톱이 귀중한 버섯까지 파괴했을 거야. 너희도 명심해. 「마라나」의 땅은 정말 위험한 곳이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200148
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200148,
					"content": "아무튼 「머리 버섯」이 없어서 아란나라가 먹어 본 적 없는 이상한 버섯으로 시도해 봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200149
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200149,
					"content": "결과는 어떻게 됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200150,
						730200151
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200150,
					"content": "우리가 본 그 모습이었겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200152,
					"content": "정말 쑥스럽네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200153
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200153,
					"content": "그런데 죽음의 땅… 그러니까 「마라나」라면, 우리도 예전에 상대해 본 적 있잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200154,
						730200155
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200154,
					"content": "식은 죽 먹기였지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200156,
					"content": "와, 「마라나」에 맞설 힘이 있다니 놀랍네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200157
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200157,
					"content": "#하긴 나라{NICKNAME}(은)는 풀의 신의 힘으로 나를 치유해 줬으니까, 「마라나」의 영향을 제거하는 것쯤은 문제없겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200158
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200158,
					"content": "#나라{NICKNAME}, 나랑 같이 「머리 버섯」이 자라는 곳으로 가줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200159
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200159,
					"content": "#천상의 맛을 가진 버섯 요리를 맛볼 기회잖아! {NICKNAME}, 남매들이 한자리에 모일 수 있게 도와주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200160,
						730200161
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200160,
					"content": "좋아, 아란파카티에게도 약속했으니까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200163
					]
				},
				{
					"id": 730200163,
					"content": "버섯은 앞에 있는 동굴에 있어. 같이 가 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200161,
					"content": "그냥 먹고 싶은 거겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200162
					]
				},
				{
					"id": 730200162,
					"content": "일석이조잖아, 내 말이 틀려?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200163
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200155,
					"content": "겨우 이겼어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200151,
					"content": "「으아아아——!」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200116,
					"content": "짧은 편이지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200117
					]
				},
				{
					"id": 730200117,
					"content": "음… 그러고 보니 우리도 이렇게 오랫동안 알고 지냈는데 아직도 어제 만난 것처럼 느껴져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200118,
					"content": "그래? 숲에서 이틀 동안 통제력을 잃은 건 긴 시간으로 안 치는구나, 다행이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200119
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200119,
					"content": "그런 뜻이 아니잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200120,
					"content": "이틀 동안 뭘 하고 있었는지가 중요해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200121
					]
				},
				{
					"id": 730200121,
					"content": "응, 맞아. 「으아아아」만 꼬박 이틀을 했다면 긴 시간이고, 그 사이에 숲멧돼지가 자랐다면 짧은 시간이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200122,
					"content": "그래? 이게 긴 시간이었구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200123,
					"content": "시간은 주관적인 거라 별 의미 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200124
					]
				},
				{
					"id": 730200124,
					"content": "#음, 나라{NICKNAME}(은)는 숲의 이치를 잘 알고 있네. 숲은 생명의 탄생이나 생명의 성장, 생명의 회귀 따위에 「날짜」를 필요로 하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200125
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200125,
					"content": "그게 뭐야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "페이몬"
				}
			]
		},
