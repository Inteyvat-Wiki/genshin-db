			"dialogs": [
				{
					"id": 730200201,
					"content": "아아, 오매불망 기다렸던 「머리 버섯」을 드디어 만나네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200202
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200202,
					"content": "「머리 버섯」이 향기를 잃는다면, 여전히 「머리 버섯」이라고 할 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200203
					],
					"speakerTitle": "아란차토라"
				},
				{
					"id": 730200203,
					"content": "헤헤, 버섯 냄새 너무 좋다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730200204,
					"content": "아무튼 이제 나가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
