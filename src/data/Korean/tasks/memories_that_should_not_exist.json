					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80200216,
					"content": "?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200217
					]
				},
				{
					"id": 80200217,
					"content": "뭐?!",
					"roleType": "TALK_ROLE_NPC",
