					"nextDialogs": [
						80200222
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80200222,
					"content": "대체 왜 그런 짓을 한 걸까…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200223
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80200223,
					"content": "오늘 일로 심연 교단의 숨겨진 사실이 하나 드러났어",
