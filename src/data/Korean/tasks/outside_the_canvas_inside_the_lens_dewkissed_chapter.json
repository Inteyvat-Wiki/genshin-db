						],
						"pointId": 340500109
					}
				]
			},
			"dialogs": [
				{
					"id": 745140101,
					"content": "으으… 추워. 역시 함부로 바람 쐬러 나오면 안 됐었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140102
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 745140102,
					"content": "#어? {NICKNAME}! 페이몬! 너희들… 에취!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140103
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 745140103,
					"content": "아사기리? 왜 여기 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140104
					]
				},
				{
					"id": 745140104,
					"content": "몸은 좀 괜찮아? 혼자 이렇게 먼 곳까지 올 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745140105,
					"content": "나… 난… 거의 다 나았어! 봐, 지금은 기침도 안 하는걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140106
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 745140106,
					"content": "하하… 하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140107,
						745140108
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 745140107,
					"content": "정말요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				},
				{
					"id": 745140109,
					"content": "으악! 그러지 마! 인정할게, 나 혼자 몰래 나온 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140110
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 745140110,
					"content": "나… 나도 어쩔 수 없었어. 계속 이나즈마에만 있으면 좋은 그림을 그릴 수 없는걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140111
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 745140111,
					"content": "네가 대신 사진을 찍어주는 건 고맙지만, 사진 자료가 직접 실물을 보는 것보다 나을 수는 없잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140112
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 745140112,
					"content": "그래서 전에 같이 일했던 분한테 캐러밴 쪽에 연락해 달라고 부탁해서, 몰래 여행을 온 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140113
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 745140113,
					"content": "그림 도구까지 다 챙겨왔네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140114
					]
				},
				{
					"id": 745140114,
					"content": "당연하지. 캔버스는 내 영혼이나 다름없는 물건인데 놔두고 올 수야 있나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140115
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 745140115,
					"content": "게다가 내 그림, 폰타인에서도 꽤 잘 팔렸거든. 폰타인 작가 몇 명이 나한테 소설 표지 작업을 의뢰하기도 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140116
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 745140116,
					"content": "다만… 소설 중간중간에 일러스트를 안 넣는다는 건 예상 밖이었지만 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140117
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 745140117,
					"content": "#참! {NICKNAME}, 이렇게 만난 김에… 혹시 소재 찾는 것 좀 도와주지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140118,
						745140120
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 745140118,
					"content": "맡겨만 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140119
					]
				},
				{
					"id": 745140119,
					"content": "좋았어! 네가 도와주면 마음이 놓일 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 745140123,
					"content": "그럼, 어디 보자…. 마침 또 작가 몇 명한테 의뢰를 받은 참이거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아사기리"
				},
				{
					"id": 745140120,
					"content": "좋아요. 대신 함부로 돌아다니면 안 돼요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140121
					]
				},
				{
					"id": 745140121,
					"content": "알겠어. 어차피 난 저 커다란 장치들을 상대할 수도 없는걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140122
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 745140122,
					"content": "이상한 마물을 상대하는 덴 네가 최고잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "아사기리"
				},
				{
					"id": 745140108,
					"content": "편지를 보내서 물어봐야겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				}
			]
		}
	]
}