			"trigger": {
				"objectNames": [
					"페이몬",
					"토마"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030101,
					"content": "오긴 왔는데 토마는? 토마는 어디 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20030102,
					"content": "휴… 토마 그 자식 설마 약속을 잊어버린 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20030103,
					"content": "누가 그래. 나야말로 너희가 날 잊은 것 같아 서운한걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030104
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030104,
					"content": "어, 어떻게 된 거야! 개가 말을 하잖아?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20030105,
					"content": "하하하… 놀랄 거 없어, 이런 난 처음 보는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030106,
						20030107
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030106,
					"content": "토마 씨는… 강아지인 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				},
				{
					"id": 20030108,
					"content": "흠… 리월에선 이런 걸 본 적 없나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030109
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030109,
					"content": "그렇구나, 이제야 이해가 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030110,
						20030111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20030110,
					"content": "뭔가 잘못된 거지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030112,
					"content": "하하하하하… 자자, 장난 그만 칠게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030113
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030113,
					"content": "야! 너 정말 너무해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20030114,
					"content": "이도에서도, 찻집에서도 너흴 너무 오래 기다렸거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030115
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030115,
					"content": "그래서 특이한 환영 인사 좀 생각해봤지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030116
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030116,
					"content": "그래도… 일전의 「시험」에 대해선 정중히 사과할게. 꼭 필요한 절차였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030117
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030117,
					"content": "그건 너흴 아야카 아가씨께로 데려와도 될지, 그리고 우리와 함께 뇌광에 맞설 수 있는 파트너인지… 결정하기 위함이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030118
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030118,
					"content": "갑자기 진지하게 군다고 용서해 줄 거 같아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20030119,
					"content": "아하… 역시 너무 심했나? 미안 미안",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030120,
						20030121
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030120,
					"content": "그래서… 시험 결과는요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030122,
					"content": "넌 처음부터 그 「규정」들보다 앞서 있던 거야, 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030123
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030123,
					"content": "네 「의지」는 흔들린 적도, 굴복된 적도 없으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030124
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030124,
					"content": "예전에도 그런 파트너가 있었지. 다만 뇌광이 번쩍인 후…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030125,
						20030126
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030125,
					"content": "카즈하의 친구를 말하는 거군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030127,
					"content": "오~ 너희도 그 얘길 들었구나, 보아하니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030128
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030128,
					"content": "그 친구의 명성은 아직 건재한 것 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030129
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030129,
					"content": "그럼 「백로공주」를 만나봐도 될까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030130
					]
				},
				{
					"id": 20030130,
					"content": "물론이지, 야시로 봉행소에 있는 카미사토 저택으로 안내할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030131
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030131,
					"content": "하지만 그 전에 너희가 같이 가줬으면 하는 곳이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030132
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030132,
					"content": "응? 어딘데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20030133,
					"content": "나루카미섬에 산다면 그냥 지나칠 수 없는 곳, 건설 중인 거대한 건축물——「천수백안 신상」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "토마"
				},
				{
					"id": 20030126,
					"content": "어전시합에서 목숨을 잃은 분 말이군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030121,
					"content": "뇌광에 맞설 파트너라면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030111,
					"content": "하지만 이건 완전히 강아지잖아!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030107,
					"content": "인간 토마 씨는 어디 있죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				}
			]
		},
		{
			"id": 200302,
			"completionStepIds": [
				200302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200302",
							"2"
						],
						"stepId": 200302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"토마"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030201,
					"content": "이 신상 근처, 분위기가 으스스한걸…. 평범한 사람들은 잘 안 오지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20030202,
					"content": "엥? 자세히 보니까… 여기 박혀있는 것들 다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20030203,
					"content": "신의 눈",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030204
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030204,
					"content": "신의 눈! 그러니까 안수령으로 몰수한 신의 눈이 전부 이 신상에 박혀있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20030206,
					"content": "쇼군은 왜 안수령을 내린 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030207
					]
				},
				{
					"id": 20030205,
					"content": "역시 너희도 안수령에 대해 들어봤구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030206
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030207,
					"content": "그 전에 일러 줄게 있어. 너희도 알지? 몬드는 「자유」의 도시, 리월은 「계약」의 도시이듯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030208
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030208,
					"content": "이나즈마는… 「영원」의 국가라는 것을…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030209
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030209,
					"content": "라이덴 쇼군은 이나즈마 최고 통치자이자 이나즈마의 신이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030210
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030210,
					"content": "천년만년 변하지 않는 영원, 그것이 이 나라를 움켜쥔 「그녀」의 의지지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030211
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030211,
					"content": "이를 위해 삼봉행을 기반으로 국정을 안정시키고 쇄국령을 통해 사람들의 이동을 차단했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030212
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030212,
					"content": "쇼군은 이나즈마를 정적인 상태로 유지해 시간의 흐름 속에서 이나즈마만이 변치 않고 「영원」하길 바라셔",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030213
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030213,
					"content": "신은 모두 자기만의 생각이 있구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20030214,
					"content": "물론, 이건 내 소견일 뿐이야. 최근 안수령이 반포된 이유라면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030215
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030215,
					"content": "쇼군께선 신의 눈이 사람들에게 「변혁」의 힘을 부여한다고 생각하는 모양이야. 그녀가 말하는 「영원」엔 이런 「불안 요소」를 허용할 수 없거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030216
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030216,
					"content": "그래서 라이덴 쇼군은 「텐료 봉행」의 수하를 곳곳에 파견해 신의 눈을 하나둘씩 몰수한 뒤, 이 신상에 박아넣은 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030217
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030217,
					"content": "그러니까 이 「천수백안 신상」은 이나즈마의 「영원」을 상징하는 거라 봐도 무방해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030218
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20030218,
					"content": "그러니까… 라이덴 쇼군은 좀 이기적인 캐릭터구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20030219,
					"content": "하하, 너희 같은 이방인만이 라이덴 쇼군을 적나라하게 비판할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
