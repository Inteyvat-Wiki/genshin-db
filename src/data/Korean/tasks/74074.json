			"dialogs": [
				{
					"id": 740741901,
					"content": "장치 위쪽의 공간을 자세히 확인했지만 아무것도 찾지 못했다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740741902
					]
				},
				{
					"id": 740741902,
					"content": "결국 여기에는 아무것도 없는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741903
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740741903,
					"content": "그렇지 않아. 분명 누군가가 먼저 가져간 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741904
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740741904,
					"content": "그럼 우리 계획은 실패한 거잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741905
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740741905,
					"content": "「이성」이 탄생하려면 4개의 상한이 하나로 합쳐져야 해. 나머지 상한을 먼저 확보한다면 아직 기회는 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741906
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740741906,
					"content": "그럼 서둘러서 다음 장소로 이동하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "안"
				}
			]
