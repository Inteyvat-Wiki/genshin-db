{
	"id": 71665,
	"type": "WQ",
	"name": "내 동료가 돼라·불타오른다!",
	"description": "이상한 의뢰를 받았다. 폭염 나무 근처에서 의뢰인을 찾아 자세한 내용을 알아보자",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 5188,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
