					"동욱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160201,
					"content": "파르바나… 응? 여행자, 넌 여긴 어쩐 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160202,
						220160205
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160202,
					"content": "나도 도우러 왔어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160203
					]
				},
				{
					"id": 220160203,
					"content": "그래… 고마워. 줄리 그 녀석, 더 깊은 곳으로 들어간 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160204
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160204,
					"content": "거긴 마물이 너무 많아서 우리 둘만으로는 상대하기 힘들 거야. 네가 도와준다니 정말 다행이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160210,
					"content": "바로 출발하자, 줄리는 숲 안쪽에 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160205,
					"content": "식사 얻어먹으러 왔어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160206
					]
				},
				{
					"id": 220160206,
					"content": "문제없어. 하지만 나 혼자서 성대한 만찬을 만들긴 힘들걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160207
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160207,
					"content": "그래서 말인데 여행자, 함께 줄리를 찾으러 가자, 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160208
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160208,
					"content": "줄리 그 녀석, 꽤나 깊은 곳까지 갔을 거야. 거긴 마물이 너무 많아서 우리 둘만으로는 상대하기 벅찰 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160209
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160209,
					"content": "줄리를 찾으면, 약속대로 한 상 거하게 차려줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160210
					],
					"speakerTitle": "동욱"
				}
			]
		},
		{
			"id": 2201603,
			"completionStepIds": [
				2201609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201609",
							"2"
						],
						"stepId": 2201609,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"파르바나",
					"동욱",
					"줄리"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160301,
					"content": "너, 너 이 녀석… 냄비를 부수면 어쩌자는 거야? 이제 요리는 어떻게 해?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160302
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220160302,
					"content": "리월의 주조 기술을 얕보지 말라구! 이건 뒤집기를 연습하기 위한 특제 냄비야! 그렇게 쉽게 망가질 리 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160303
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160303,
					"content": "게다가, 마물 몇 마리일 뿐이잖아? 고작 마물 몇 마리도 처치할 수 없는 걸 진정한 냄비라고 할 순 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160304
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160304,
					"content": "냄비에 대한 기대치가 너무 높은 거 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160305,
						220160308,
						220160312
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220160305,
					"content": "동욱은 기세가 대단하네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160306
					]
				},
				{
					"id": 220160306,
					"content": "물론이야, 요리사의 필수 과목이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160307
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160307,
					"content": "생전 처음 듣는 소린데?! 대체 요리사가 냄비로 마물을 처치해야 하는 이유가 뭔데?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220160315,
					"content": "됐어, 줄리. 이제 얼른 이곳을 벗어나자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160316
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160316,
					"content": "잠, 잠깐만, 아저씨를 도와줘! 아저씨가 숲에서 해란귀와 싸우고 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160317
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 220160317,
					"content": "해란귀? 마물이 아니고? 왜 해란귀 같은 무시무시한 녀석과 싸우는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160318
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220160318,
					"content": "내, 내가 나중에 설명할게… 얼른 아저씨 좀 도와줘! 아저씨 혼자서 상대하고 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160319
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 220160319,
					"content": "알겠어. 여행자, 미안하지만 조금 더 동행해주지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160320,
						220160321
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160320,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160325
					]
				},
				{
					"id": 220160325,
					"content": "얼른 출발하자, 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160321,
					"content": "해란귀와 싸울 생각이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160322
					]
				},
				{
					"id": 220160322,
					"content": "물론이지, 내 냄비가 얼른 싸우고 싶다고 야단인걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160323
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160323,
					"content": "게다가, 요리사가 돼서 위험이 닥친다고 도망치면 쓰나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160324
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160324,
					"content": "내가 말했지, 요리사와 냄비한테 기대를 너무 품지 말라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160325
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220160308,
					"content": "그럼, 이 냄비는 어디 가야 살 수 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160309
					]
				},
				{
					"id": 220160309,
					"content": "하하하, 좋은 질문이야. 「한봉 철기」의 그분한테 특별 주문 제작한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160310
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160310,
					"content": "그 아저씨는 제작한 물건에 층암거연에서 발굴한 재료를 넣기도 한대. 구매하고 싶으면 아저씨를 찾아가면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160311
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160311,
					"content": "하지만 층암거연은 봉쇄된 지 꽤 오래돼서 지금은 만들 수 없을지도 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160312,
					"content": "파르바나 기세도 엄청난데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160313
					]
				},
				{
					"id": 220160313,
					"content": "응? 앗… 하하하, 그냥 마물들의 머리통에 책을 몇 권 던졌을 뿐이야. 네 덕분에 마물을 격퇴한 거지, 뭐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160314
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220160314,
					"content": "잠깐, 내 《신과 함께》 6권 어디 갔지? 설, 설마 던져버린 건… 아직 다 못 봤는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160315
					],
					"speakerTitle": "파르바나"
				}
			]
		},
		{
			"id": 2201604,
			"completionStepIds": [
				2201608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201608",
							"2"
						],
						"stepId": 2201608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"카메이 무네히사",
					"줄리",
					"동욱",
					"파르바나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220160401,
					"content": "콜록… 콜록. 악당들한테 이 지경이 되다니, 우스운 꼴을 보였군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160402
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220160402,
					"content": "아저씨, 괜찮은 거죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160403
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 220160403,
					"content": "몇 수 졌을 뿐입니다. 별일이 아닙니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160404
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220160404,
					"content": "줄리, 이제 사건의 자초지종을 설명해줄 수 있겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160405
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160405,
					"content": "제대로 실토하는 게 좋을 거야, 내 책들의 희생이 헛되지 않게. 아… 페이지가 다 구겨졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160406
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220160406,
					"content": "사실 별거 아니야… 그냥, 아저씨한테 음식을 좀 가져다주려고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160407
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 220160407,
					"content": "너 말이야… 딱 한 번밖에 본 적 없으면서, 왜 그렇게 저 사람을… 믿는 거냐고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160408
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220160408,
					"content": "아저씨는 좋은 사람이 분명해! 그때 엄청 배고팠을 텐데, 우리한테 음식을 나눠줬잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160409
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 220160409,
					"content": "배고플 때 음식을 나눠줄 수 있는 사람은 분명 좋은 사람이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160410
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 220160410,
					"content": "순수하면서 단순한 논리군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160411
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220160411,
					"content": "넌 티바트 대륙이 아니라 동화 속에 살고 있는 거 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160412
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220160412,
					"content": "하하하, 근데 난 줄리 말도 일리가 있다고 생각해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160413
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160413,
					"content": "굶주린 상황에서도 베풀 줄 아는 사람이라면, 적어도 나쁜 사람은 절대 아니지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160414
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160414,
					"content": "간단하고 직접적인 논리네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160415
					]
				},
				{
					"id": 220160415,
					"content": "암튼 계속 말해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160416
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160416,
					"content": "혹시나 하는 마음에, 버섯 닭꼬치를 좀 만들어서 아저씨를 처음 만난 곳으로 가, 운을 시험해 봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160417
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 220160417,
					"content": "근데 거기서 정말로 아저씨를 보게 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160418
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 220160418,
					"content": "인사를 건네려는데 아저씨가 뭐라고 말하면서 해란귀들과 대치 중인 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160419
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 220160419,
					"content": "조금 멀리 떨어지려고 했는데, 해란귀한테 들켜버리고 말았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160420
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 220160420,
					"content": "지금부턴 제가 설명하지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160421
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220160421,
					"content": "그… 사람들 중에는, 제 「오래된 벗」들도 여럿 있습니다. 과거 저와 함께 막부에 충성을 다했던 친우들입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160422
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220160422,
					"content": "이나즈마에 뜻밖의 변고가 생긴 뒤로, 우린 막부를 떠나 각자 생계를 도모하게 되었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160423,
						220160425,
						220160427
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220160423,
					"content": "그게 그들의 생계 수단인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160424
					]
				},
				{
					"id": 220160424,
					"content": "…그렇습니다. 우린 검을 휘두르는 것 말고는, 달리 살아갈 방도가 없는 자들이니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160432
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220160432,
					"content": "어쨌든 그 후, 그들은 「해란귀」가 되어 약탈로 생계를 유지하게 됐습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160433
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220160433,
					"content": "하지만 전 그들과 함께하고 싶지 않아서 정처 없이 떠돌며 일자리를 구하고 있었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160434
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220160434,
					"content": "허나 제가 막부를 떠난 무사라는 걸 알고 쉽사리 일을 주려는 사람이 없었습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160435
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220160435,
					"content": "그래서 보시다시피, 야외에서 음식을 구해 배를 채웠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160436
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220160436,
					"content": "요새 제 옛 동료들은 일손이 모자라다며 매일같이 절 설득했고 저도 매번 거절했지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160437
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220160437,
					"content": "오늘… 줄리 씨를 보자 그들은 제가 다른 집단에 가담한 줄 오인하고 그 집단을 제거하려고 했죠. 그래서 저희를 공격한 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160438,
						220160440
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220160438,
					"content": "전혀 말이 안 통하네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160439
					]
				},
				{
					"id": 220160439,
					"content": "말이 통하는 자들이 아닙니다만, 저런 처지라면… 어쩔 수 없지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160444
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220160444,
					"content": "그 후, 아저씨는 그 악당들을 상대했고, 난 그 장소에서 아저씨를 기다리고 있는데 갑자기 마물들이 나타났지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160445
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 220160445,
					"content": "줄리라면 충분히 마물들을 처치했겠지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160446
					]
				},
				{
					"id": 220160446,
					"content": "평소라면 그랬겠지. 근데 오늘 아침 떠날 때 아무것도 안 먹었더니 배가 고파서 힘이 안 나더라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160447
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 220160447,
					"content": "게다가 해란귀들한테 들켰을 때, 버섯 닭꼬치까지 떨어뜨리는 바람에… 다행히 아저씨가 날 지켜줬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160448,
						220160449
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 220160448,
					"content": "이래서 아침 식사가 중요한 거군요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160450
					]
				},
				{
					"id": 220160450,
					"content": "근데 이나즈마에는 말이 안 통하는 해란귀들이 아직 많잖아. 우린 한동안 여기 있어야 하는데, 너무 위험한 거 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160451
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220160451,
					"content": "게다가 우리가 약한 마물들을 상대할 순 있어도, 무예에 능한 녀석들을 상대하긴 버거워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160452
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220160452,
					"content": "음… 아저씨, 아까 일자리를 찾는다고 하셨죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160453
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160453,
					"content": "괜찮다면 저희와 동행하실래요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160454
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160454,
					"content": "오예!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160455
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 220160455,
					"content": "근데 아저씨는 막부를 떠난 무사잖아? 이나즈마에서 그런 신분은 성가신 일이 많을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160456
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220160456,
					"content": "…그렇습니다. 제가 여러분들과 동행하면 성가신 일이 많이 생길 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160457
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220160457,
					"content": "하하하, 전 괜찮은데요? 우린 도처에서 식자재를 찾아 요리를 하는 것뿐이니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160458
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160458,
					"content": "아저씨 같은 신분은 막부나 무사와 전혀 상관이 없는 일을 하는 게 제일 적절해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160459
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160459,
					"content": "아저씨가 호위병이거나, 문지기를 하는 게 오히려 더 수상해 보일걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160460
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160460,
					"content": "게다가 아저씨처럼 좋은 분이 배를 곯는 건 말도 안 되는 일이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160461
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160461,
					"content": "요리사로서 이 상황을 좌시할 순 없어요. 다른 일은 모르겠지만, 식사만은 제가 책임질게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160462
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160462,
					"content": "그건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160463
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220160463,
					"content": "헤헤, 어때요? 저희랑 동행하실래요? 급여는 얼마 안 되지만, 식사만은 부족함 없이 대접할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160464
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160464,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160465
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220160465,
					"content": "그럼, 사양하지 않겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160466
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220160466,
					"content": "오예ㅡ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160467
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 220160467,
					"content": "좋게 생각하자, 좋게 생각해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160468
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 220160468,
					"content": "좋아! 다들 고생했으니까, 지금 뱃가죽이 등에 붙을 지경이겠지? 여기서 요리하긴 힘들겠지만… 방법을 찾아서 음식을 만들어볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160469
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160469,
					"content": "여행자, 너도 그만하고 이리 와. 내가 할 테니까, 넌 쉬면서 식사를 기다리고 있으라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160470
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160470,
					"content": "그럼, 시작할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160471
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160471,
					"content": "이제 됐다… 하하, 잔반으로 만든 「주먹밥」 완성. 좀 조잡하긴 하지만… 허기를 채우긴 충분할 거야, 어서 먹자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160472
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160472,
					"content": "아 참, 여행자. 동행해 줘서 정말 고마웠어, 이 레시피는 네게 줄게. 무네히사 아저씨가 금방 나한테 준 건데, 메모해 뒀으니까 가져가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160473
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160473,
					"content": "막부에 있을 때 적어둔 레시피래. 엄청 색다른 요리라고 하던데, 관심 있으면 한번 만들어봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160474
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160474,
					"content": "자, 됐다. 그만 얘기하고 얼른 먹자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동욱"
				},
				{
					"id": 220160449,
					"content": "이젠 밥 제때 챙겨 먹는 거 잊지 마",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
