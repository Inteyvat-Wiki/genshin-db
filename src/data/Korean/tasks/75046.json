			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"우루밤바"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750460101,
					"content": "우루루—— 루루—— 어서 돌아와! 우루루—— 루루——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460102
					],
					"speakerTitle": "우루밤바"
				},
				{
					"id": 750460102,
					"content": "안녕하세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460103
					]
				},
				{
					"id": 750460103,
					"content": "우루루—— 루루—— 휴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460104
					],
					"speakerTitle": "우루밤바"
				},
				{
					"id": 750460104,
					"content": "난 안녕하지 못해. 여기도 마찬가지고. 어쩌면 좋지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460105
					],
					"speakerTitle": "우루밤바"
				},
				{
					"id": 750460105,
					"content": "잠깐 건초 좀 사러 다녀온 사이에 내가 키우던 어린 뿔룡 중 8마리가 어디론가 사라져 버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460106
					],
					"speakerTitle": "우루밤바"
				},
				{
					"id": 750460106,
					"content": "아직 어린 녀석들인데… 밖에서 츄츄족을 만나 괴롭힘이라도 당하고 있는 거면 어쩌지? 길을 잃거나 어디에 갇혀 있는 거면 또 어쩌고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460107
					],
					"speakerTitle": "우루밤바"
				},
				{
					"id": 750460107,
					"content": "마음씨 착한 친구, 혹시 내가 키우는 뿔룡 못 봤니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460108
					],
					"speakerTitle": "우루밤바"
				},
				{
					"id": 750460108,
					"content": "어떻게 생겼나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460109
					]
				},
				{
					"id": 750460109,
					"content": "내가 그 여덟 녀석의 엄마를 키웠으니까 녀석들의 엄마는 내 딸이나 마찬가지야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460110
					],
					"speakerTitle": "우루밤바"
				},
				{
					"id": 750460110,
					"content": "녀석들의 엄마는 비옥한 터전에서 손꼽히는 미모를 자랑하는 용인데, 우리 지역에서 미모를 겨루는 대회에 출전해서 대상까지 받았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460111
					],
					"speakerTitle": "우루밤바"
				},
				{
					"id": 750460111,
					"content": "그 개구쟁이 여덟 녀석도 엄마의 미모를 물려받아서 뽀얀 분홍색 피부에 살짝 보랏빛이 도는 완벽히 대칭되는 부채꼴 모양의 뿔이 달려 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460112
					],
					"speakerTitle": "우루밤바"
				},
				{
					"id": 750460112,
					"content": "녀석들을 보면 어떻게든 이리로 데려와 줄 수 있겠니? 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460113
					],
					"speakerTitle": "우루밤바"
				},
				{
					"id": 750460113,
					"content": "우리 꼬마 용들아… 할아버지가 다시는 엄하게 굴지 않을게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460118
					],
					"speakerTitle": "우루밤바"
				},
				{
					"id": 750460118,
					"content": "신경 써서 볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460119
					]
				},
				{
					"id": 750460119,
					"content": "고마워, 착한 친구! 오늘 새로운 벤치 프레스 기록을 세울 수 있기를, 그리고 풀업할 때 쥐가 나지 않기를!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "우루밤바"
				}
			]
		},
