			"dialogs": [
				{
					"id": 706785101,
					"content": "아직 준비 작업이 덜 끝나서요…. 조금만 더 기다려 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706785102
					],
					"speakerTitle": "울피"
				},
				{
					"id": 706785102,
					"content": "괜찮으시면 다시 무대에서 공연을 펼쳐 보세요. 보물상자에서 장난감 메달을 보상으로 얻으실 수 있을 겁니다!",
					"roleType": "TALK_ROLE_NPC",
