			"dialogs": [
				{
					"id": 740920101,
					"content": "대체 왜… 어째서 이렇게 된 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920102,
						740920103
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920102,
					"content": "클로니아 씨?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				},
				{
					"id": 740920104,
					"content": "#{NICKNAME}, 왔구나! 마침 잘됐어… 적어도… 너는 진실을 알고 있으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920105
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920105,
					"content": "클로니아, 진정해. 대, 대체 왜 그러는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740920106,
					"content": "비록… 내 기사가 신문에 실릴 수 없다고 해도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920107
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920107,
					"content": "기사가 왜요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920108
					]
				},
				{
					"id": 740920108,
					"content": "그러게. 안 그래도 언제쯤 네 기사를 볼 수 있을지 기다리고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740920109,
					"content": "못 봤을 거야… 맞아, 그래… 너희는 못 봤겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920110
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920110,
					"content": "대체 왜… 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920111
					]
				},
				{
					"id": 740920111,
					"content": "그게 말이야… 그날 폰타인 과학원을 다녀오고 나서부터 난 바로 원고를 작성하기 시작했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920112
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920112,
					"content": "내가 보고 듣고 느낀 모든 것을 있는 그대로 적었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920113
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920113,
					"content": "폰타인 과학원은 아르케 광석을 처리하지 않았으며, 오히려 아르케 광석과 연관된 또 다른 프로젝트를 시작했다든가 하는 거 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920114
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920114,
					"content": "에드윈의 부하가 폰타인 과학원을 탐색하기 위해 파견되었으나 폭발에서 목숨을 잃었는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920115
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920115,
					"content": "폰타인 과학원의 고위 기술책임관 레이먼드는 그의 죽음을 부정했고, 그 폭발 또한 사고가 아닌 계획했던 바라고 주장했다는 것도",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920116
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920116,
					"content": "그 밖에도 폐허에서 폭주하던 거대한 기계와 오염된 물까지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920117
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920117,
					"content": "폰타인 과학원이 숨기려는 모든 걸 원고에 적어 넣었지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920118
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920118,
					"content": "하지만… 원고를 제출하자마자 폰타인 과학원에서 날 고소했다는 통보를 받았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920119
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920119,
					"content": "신문사의 규정대로 폰타인 과학원에 관해 내가 쓴 모든 문장들은 전부 「신빙성 심사」를 받게 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920120
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920120,
					"content": "폰타인 과학원에 대한 기사도 취소됐지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920121,
						740920122
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920121,
					"content": "신빙성 심사요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920123,
					"content": "아니, 그건 기사가 아니라 날 겨냥한 심사야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920124
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920124,
					"content": "한마디로 폰타인 과학원과 이해관계가 안 맞아 고소까지 당했으니까, 내 기사에 개인적 감정이 실렸는지를 확인해야 한다는 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920125
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920125,
					"content": "폰타인 과학원과 이해관계가 안 맞았나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920126
					]
				},
				{
					"id": 740920126,
					"content": "클로니아는 사진을 몇 장 찍은 것뿐이잖아. 그 안에는 돌무더기와 움직이지 않는 거대한 기계들만 잔뜩 있었는데… 그걸로 「이해관계」 운운할 수가 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740920127,
					"content": "설마 그들의 도덕적인 수준을 폭로한 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920128
					]
				},
				{
					"id": 740920128,
					"content": "그쪽에선… 내가 폰타 신제품을 유출했다고 고소한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920129
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920129,
					"content": "폰타인 과학원 사람들은 내가 전에 폐허에서 찍은 사진 중 일부에 새로운 폰타의 기획안이 포함되어 있다고 우기고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920130
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920130,
					"content": "그래서 모든 사진을 확인해 봐야겠대. 그 전까진 고소를 취하할 생각이 없다고 하니까 신빙성 심사도 계속 받아야겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920131
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920131,
					"content": "내 기사를 막기 위해 이러는 게 확실해…. 하지만 난 절대 포기하지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920132
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920132,
					"content": "자, 이거 받아! 내가 몰래 인쇄한 신문인데, 이따가 가져가서 뿌리려고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920133
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920133,
					"content": "모든 사람에게 진실과 폰타인 과학원의 진짜 모습을 알릴 거야. 그리고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920134
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920134,
					"content": "클로니아 씨! 왜 아직도 여기 계세요? 한참 찾았잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920135
					],
					"speakerTitle": "미르너"
				},
				{
					"id": 740920135,
					"content": "큰일 났다! 누가 왔나 봐. 더는 여기 있으면 안 되겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920136
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920136,
					"content": "이 신문은 너 줄 테니까 부디 잘 챙겨줘. 모든 진실을 그 안에 담았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920137
					],
					"speakerTitle": "클로니아"
				},
				{
					"id": 740920137,
					"content": "규정에 따라 행정청에 가셔서 매일 정기적으로 진행되는 심사를 받으셔야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920138
					],
					"speakerTitle": "미르너"
				},
				{
					"id": 740920138,
					"content": "앗! 도망가지 마세요, 클로니아 씨!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920139
					],
					"speakerTitle": "미르너"
				},
				{
					"id": 740920139,
					"content": "폰타일 뿐이잖아요. 오해일지도 모른다고요! 잘 설명만 하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920140
					],
					"speakerTitle": "미르너"
				},
				{
					"id": 740920140,
					"content": "잠깐! 기다리세요, 클로니아 씨!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "미르너"
				},
				{
					"id": 740920122,
					"content": "신문사는 당신의 기사가 못 미덥다고 생각하는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920103,
					"content": "여기서 뭐 하시는 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				}
			]
		}
	]
}