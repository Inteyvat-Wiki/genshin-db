			"dialogs": [
				{
					"id": 400740901,
					"content": "주변 환경이 변했어. 이곳은 우리가 출발하기 전의 그 바닷가가 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740902
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400740902,
					"content": "보아하니 몬드의 산지 같군요. 설마 저희 몬드에 온 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740903
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 400740903,
					"content": "하지만 주변이 온통 끝없는 바다로 이어져 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740904
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 400740904,
					"content": "주변에 아까 같은 그런 연못이 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740905
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400740905,
					"content": "여기 있다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740906
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400740906,
					"content": "…음? 바로 들어갈 수가 없잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740907
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400740907,
					"content": "물 위로 무언가 떠오른 거 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740908
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400740908,
					"content": "이건 그림? 아니면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740909
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400740909,
					"content": "어떤 장소를 가리키고 있는 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740910
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400740910,
					"content": "본 황녀가 앞장서도록 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740911
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 400740911,
					"content": "왜 또 네가 우리를 인솔하는 거야…. 아니다, 누가 앞장 서든 상관없어, 일단 이곳을 찾는 게 급선무니까",
