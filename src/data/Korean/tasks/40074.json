					"nextDialogs": [
						400741208
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 400741208,
					"content": "사람들에게 오해받는 삶은 견디기 힘들었을 텐데…. 버텨냈다니 정말 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741209
					],
					"speakerTitle": "카에데하라 카즈하"
