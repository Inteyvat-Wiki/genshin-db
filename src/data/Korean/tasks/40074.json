					"nextDialogs": [
						400741210
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400741210,
					"content": "하지만 난 천재잖아, 다른 사람이 하지 못한 일이라도 반드시 해낼 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741211
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400741211,
					"content": "이렇게 아름다운 곳에서 그런 이야기를 하니까 더 멋져 보여!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741212,
						400741213
