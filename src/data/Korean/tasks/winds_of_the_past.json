			"dialogs": [
				{
					"id": 3061101,
					"content": "여기가 바로 버려진 <color=#00E1FFFF>바람 사신수 사당</color> 가운데 하나야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061102
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061102,
					"content": "이 사당들은 아주 오래전에 버려져서 몬드의 주민들도 오지 않는 곳이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061103
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061103,
					"content": "잘하면 동물들이 보금자리를 만들었거나 츄츄족이 주둔지를 건설했을 수도 있겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061104
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061104,
					"content": "풍마룡도 자신의 사당을 버렸으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061105,
						3061106
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061105,
					"content": "풍마룡이…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				},
				{
					"id": 3061107,
					"content": "…맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061108
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061108,
					"content": "나도 받아들이기 힘든 사실이지만… 사실 풍마룡도 「바람 사신수」 가운데 하나였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061109
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061109,
					"content": "뭐?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3061110,
					"content": "일단 이 얘긴 그만하고 혹시 뭔가 느껴지는 게 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061111
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061111,
					"content": "이곳의 「바람」이 뭔가 이상한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061112
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061112,
					"content": "#들어가서 확인해야겠어, {NICKNAME}. 조심해야 될 거야. 드래곤의 힘이 이곳에 영향을 끼치고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061106,
					"content": "「자신의 사당」이라고…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				}
