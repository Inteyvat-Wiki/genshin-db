			"dialogs": [
				{
					"id": 3061001,
					"content": "하아… 힘드네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061002
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061002,
					"content": "그래도 진 단장에게 도움을 줄 수 있어서 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061003
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061003,
					"content": "예전에는 우리의 힘으로 도시의 안전은 지킬 수 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061004
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061004,
					"content": "정확히 말하면 진 단장이 있기 때문이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061005
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061005,
					"content": "근데 지금은 풍마룡이 몬드성 안으로 바로 습격까지 할 정도니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061006
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061006,
					"content": "「바람의 방향이 바뀌었으니까 우리도 그에 맞게끔 전략을 바꿔야겠지」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061007,
						3061008
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061007,
					"content": "철학적인데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				},
				{
					"id": 3061009,
					"content": "리사가 좋아하는 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061010
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061010,
					"content": "아, 맞다! 아까 얘기했던 「바람 사신수」에 대해서——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061011
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061011,
					"content": "자세히 알고 싶다면 리사를 찾아가서 물어보면 들을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061012
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061012,
					"content": "…내가 역사 공부를 못해서 안 알려주는 게 아냐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061013
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061013,
					"content": "리사는 도서관 사서니까… 아무튼 나 같은 정찰 기사보단 더 정확히 알고 있지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				},
				{
					"id": 3061008,
					"content": "네가 만든 말이니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061009
					]
				}
			]
		},
