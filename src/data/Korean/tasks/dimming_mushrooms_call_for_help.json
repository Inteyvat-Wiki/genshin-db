					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610401,
					"content": "#{NICKNAME}에게 찬사를, 페이몬에게 찬사를",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610402
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610402,
					"content": "불안하지만 자마란이 솔직히 말한다. 두 발 달린 존재가 「이왕 돕는 거 끝까지 도울게요」라고 한 것처럼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610403,
						710610405
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610403,
					"content": "설마 또 우리한테 심부름시키는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610404
					]
				},
				{
					"id": 710610405,
					"content": "하지만 넌 사람이 아니라 버섯이잖아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610406
					]
				},
				{
					"id": 710610404,
					"content": "두 발 달린 존재는 선견지명이 뛰어나다. 지혜로운 자라는 칭호에 어울린다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610406,
					"content": "똑같이 대지의 은혜를 누린 생물체는 서로 돕고 사는 것이 자연의 도리다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610407,
					"content": "거절은 거절이다. 「지혜의 비호」를 받아줬으면 한다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610408
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610408,
					"content": "「지혜의 비호」를 획득했다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610409
					]
				},
				{
					"id": 710610409,
					"content": "윽… 이게 뭐야. 엄청 수상해 보이는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710610410,
					"content": "자마란에겐 아직도 공중을 떠다니는 사악한 기운이 느껴진다. 하지만 그 근원이 어디 있는지는 알 수 없다. 물살을 따라 탐사하면 뭔가 발견할 수 있을 거다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610411
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610411,
					"content": "#{NICKNAME}, 사악한 기운의 근원에 「지혜의 비호」를 사용하면, 나머지는 자마란의 동족이 처리한다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610412,
						710610413
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610412,
					"content": "사악한 기운의 근원을… 내버려 둘 순 없지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610413,
					"content": "…아니 넌 왜 안 가는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610414,
					"content": "#{NICKNAME}은(는) 페이몬보다 유머를 잘 안다. 자마란은 발이 없지만 {NICKNAME}은(는) 발이 달린 존재, 발이 필요한 일은 발이 달린 존재가 완성하는 게 도리인 법이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610415
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610415,
					"content": "게다가 나, 자마란에겐 더욱 중요한 사명이 있다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610416
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610416,
					"content": "더욱 중요한 사명?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610417
					]
				},
				{
					"id": 710610417,
					"content": "#이번에 너무 많은 힘을 썼다. {NICKNAME}, 페이몬과 대화하는 건 무척 즐거운 일이지만 자마란에겐 수면이 필요하다. 힘을 모아 사악한 기운을 막고 동족을 숨기고 번식시켜야 한다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610418
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610418,
					"content": "#{NICKNAME}에게 축복을, 페이몬에게 축복을",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610419
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610419,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610420
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610420,
					"content": "이봐! 대 머리 버섯, 어이!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610421
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710610421,
					"content": "#{NICKNAME}, 대 머리 버섯은 잠든 모양이야, 우린 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710610207,
					"content": "으앗, 이 검은 진흙은 어디서 튀어나온 거야? 이게 대 머리 버섯이 말했던 「사악한 기운」인 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
