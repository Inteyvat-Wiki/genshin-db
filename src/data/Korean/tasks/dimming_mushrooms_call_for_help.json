							"7106110",
							"2"
						],
						"stepId": 7106110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610301,
					"content": "#{NICKNAME}에게 찬사를, 페이몬에게 찬사를",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610302
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610302,
					"content": "자마란의 부름은 오랫동안 답을 듣지 못했다. 많은 발과 네 발은 물론, 두 발 달린 존재도 자마란의 구조 요청을 무시했다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610303
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610303,
					"content": "#진정으로 지혜로운 자만이 자마란의 부름에 답할 수 있다. 페이몬은 지혜로운 자, {NICKNAME}도 지혜로운 자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610304
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610304,
					"content": "두 발 달린 존재 중 가장 뛰어나니까 자마란의 감사를 받는 게 당연하다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610323
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610323,
					"content": "후후. 「지혜로운 자」 페이몬을 얕보지 말라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710610305,
					"content": "식은 죽 먹기지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610306
					]
				},
				{
					"id": 710610306,
					"content": "#언젠간 {NICKNAME}, 페이몬도 자마란, 그리고 자마란의 동족과 비견할 수 있는 존재가 될 수 있을 거다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610307
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610307,
					"content": "잠깐, 대 머리 버섯. 그게 무슨 뜻이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710610308,
					"content": "많은 발은 네 발보다 못하고, 네 발은 두 발보다 못하다. 그러니까 두 발 달린 존재는 발이 없는 존재보다 못한 게 당연하다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610309
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610309,
					"content": "#{NICKNAME}, 페이몬은 선천적으로 결함이 있지만, 마음만 먹는다면 후천적인 노력으로 운명을 바꿀 수 있다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610310
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610310,
					"content": "큰 형광 머리 버섯 주제에 기고만장하긴! 형광 버섯을 요리로 만들 순 없나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610311,
						710610312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710610311,
					"content": "버섯 닭꼬치가 좋겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610312,
					"content": "예쁜 버섯은 거짓말에 능하니까 독이 있는 게 틀림없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610313,
					"content": "페이몬, 식탐이 강하다. 오늘도 버섯을 먹고, 내일도 버섯을 먹고, 백일이 지나면 페이몬은 배 속의 버섯에 먹힐 거다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610314
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610314,
					"content": "#흑흑, {NICKNAME}, 대 머리 버섯 진짜 무서워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710610315,
					"content": "음, 페이몬은 유머를 모른다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610316
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610316,
					"content": "전혀 유머러스하지 않다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710610317,
					"content": "자마란은 사악한 기운에서 빠져나왔지만 자마란의 동족은 여전히 고통받고 있다. 하지만 지금의 자마란은 힘이 부족해, 예전처럼 약자를 보호해 줄 수 없다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610318
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610318,
					"content": "#{NICKNAME}, 자마란이 부탁한다. 자비를 베풀어 스스로를 구제할 수 없는 약자들을 도와줬으면 한다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610319
					],
					"speakerTitle": "자마란"
				},
				{
					"id": 710610319,
					"content": "#그럼 시름시름 앓는 버섯이 더 있다는 거야? {NICKNAME}, 우리가 도와주는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610320,
						710610321
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710610320,
					"content": "이왕 온 거…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610321,
					"content": "지나가는 길에 보면 도울게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610322,
					"content": "그럼 얼른 출발하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710610207,
					"content": "으앗, 이 검은 진흙은 어디서 튀어나온 거야? 이게 대 머리 버섯이 말했던 「사악한 기운」인 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
