			"dialogs": [
				{
					"id": 727210101,
					"content": "멍? 멍멍! 멍!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210102,
						727210103
					],
					"speakerTitle": "타로마루"
				},
				{
					"id": 727210102,
					"content": "대체 타로마루가 왜?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210104
					]
				},
				{
					"id": 727210104,
					"content": "야스히코 타로가 네 번째 무사는 주머니 사정이 어려워서 비무에 참여하는 거라고 했잖아. 그럼 타로마루의 목표도 우승자의 상금인가 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 727210105,
					"content": "좀 미안하긴 한데, 난 모라와 관련된 일에서는 절대 양보하지 않아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 727210106,
					"content": "멍멍?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210107
					],
					"speakerTitle": "타로마루"
				},
				{
					"id": 727210107,
					"content": "멍멍, 멍멍멍멍! 멍멍멍!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210108,
						727210109
					],
					"speakerTitle": "타로마루"
				},
				{
					"id": 727210108,
					"content": "타로마루가 더 크게 짖고 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210110
					]
				},
				{
					"id": 727210110,
					"content": "#타로마루, 이건 정정당당한 비무야. 상금은 너와 {NICKNAME}, 둘 중 무예가 더 뛰어난 쪽이 갖는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 727210111,
					"content": "하지만 우리가 이기면 너한테 맛있는 거 사줄 순 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 727210112,
					"content": "멍, 멍멍멍멍멍, 멍멍멍!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727210115,
						727210113
					],
					"speakerTitle": "타로마루"
				},
				{
					"id": 727210115,
					"content": "무슨 말인지 이해할 순 없지만 시작하자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210116
					]
				},
				{
					"id": 727210116,
					"content": "멍!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타로마루"
				},
				{
					"id": 727210113,
					"content": "무슨 말인지 이해할 순 없지만 준비는 좀 해야겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210114
					]
				},
				{
					"id": 727210114,
					"content": "멍멍멍",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타로마루"
				},
				{
					"id": 727210109,
					"content": "우리가 화나게 한 건 아니겠지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727210110
					]
				},
				{
					"id": 727210103,
					"content": "「최강 무사」가 타로마루였다니!",
