			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"카미사토 아야카"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20080301,
					"content": "이상하네. 오늘은 왜 이렇게 조용하지? 평소랑 완전 딴판이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20080302,
					"content": "멍멍… 멍!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080303
					],
					"speakerTitle": "타로마루"
				},
				{
					"id": 20080303,
					"content": "설마 또 토마가 짜고 치는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20080304,
					"content": "토마——토마——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20080305,
					"content": "멍! 멍! …멍!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080306
					],
					"speakerTitle": "타로마루"
				},
				{
					"id": 20080306,
					"content": "이봐——숨지 말고 나와. 다 봤어——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20080307,
					"content": "엥? 아무 반응도 없잖아. 토마가 어디로 갔지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20080308,
					"content": "멍멍멍! 멍!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080309
					],
					"speakerTitle": "타로마루"
				},
				{
					"id": 20080309,
					"content": "엥? 평소엔 얌전하던 타로마루가 오늘은 좀 이상하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20080310,
					"content": "두 분, 토마를 보셨나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080311
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 20080311,
					"content": "아야카랑 같이 있는 줄 알았는데, 설마 무슨 일 생겼나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20080312,
					"content": "큰일이에요…. 오면서 토마가 텐료 봉행 사람한테 잡혀갔다는 소릴 들었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080313
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 20080313,
					"content": "전 소식이 진짜인지 판단할 방법이 없어 이곳에 확인하러 온 거고요. 토마가 약속 시각에 오지 않았다는 건 그 소식이 사실이라는 뜻이네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080314
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 20080314,
					"content": "라이덴 쇼군이 천수백안 신상 앞에서 100번째 신의 눈의 「수안(狩眼) 의식」을 거행할 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080315
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 20080315,
					"content": "그리고 신의 눈을 가진 그 100번째 사람은… 공개적으로 신의 눈을 몰수당하는데, 그게 아마… 토마 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080316
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 20080316,
					"content": "설마 토마가 전에 들었다던, 텐료 봉행에서 준비 중이라는 「의식」이 「수안 의식」인 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20080317,
					"content": "그런 것 같아요…. 쇼군님과 텐료 봉행 사람들은 100번째 신의 눈의 「수안 의식」으로 안수령의 단계적인 성과를 증명할 생각인가봐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080318
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 20080318,
					"content": "…안 돼, 토마를 구해야 해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080319
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 20080319,
					"content": "멍멍! 멍!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080320
					],
					"speakerTitle": "타로마루"
				},
				{
					"id": 20080320,
					"content": "진정해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080321
					]
				},
				{
					"id": 20080321,
					"content": "하지만 「백로공주」는 야시로 봉행을 대표하잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080322
					]
				},
				{
					"id": 20080322,
					"content": "그래, 네가 직접 가면 야시로 봉행이 라이덴 쇼군의 적이라는 얘기가 되는걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20080323,
					"content": "대놓고 라이덴 쇼군에게 저항했다간, 야시로 봉행 사람들까지 말려들 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080324
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20080324,
					"content": "어쩔 수 없죠…. 시간이 얼마 없어요. 의식이 곧 시작된다고요. 이대로 토마를 포기할 순 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080325
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 20080325,
					"content": "토마는 제 친구예요. 얼마 전까지만 해도 우린 함께…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080326
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 20080326,
					"content": "토마 씨는 내 친구이기도 해. 내가 가서 구할게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080327
					]
				},
				{
					"id": 20080327,
					"content": "하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080328
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 20080328,
					"content": "네가 방금 그랬지?——시간 없다고",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080329
					]
				},
				{
					"id": 20080329,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080330
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 20080330,
					"content": "…네, 그럼 전… 무사히 돌아오시길 기다릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080331
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 20080331,
					"content": "걱정 마, 아야카! 친구의 목숨이 달렸으니까 절대 실수하지 않을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
