			"dialogs": [
				{
					"id": 750290501,
					"content": "용사! 이 코스로 연습해 보니까 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290502,
						750290504
					],
					"speakerTitle": "마타카"
				},
				{
					"id": 750290502,
					"content": "실력이 좀 늘었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290503
					]
				},
				{
					"id": 750290503,
					"content": "나약해! 발전이 없는 건 곧 퇴보라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "마타카"
				},
				{
					"id": 750290506,
					"content": "뭐랄까, 마타카의 사전에는 「앞으로」, 「필사적으로」 같은 단어 말고는 다른 단어가 없는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750290507,
					"content": "맞아, 내 사전은 다른 사람들보다 더 얇지! 노력과 분투 외에는 아무것도 인정하지 않거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290508
					],
					"speakerTitle": "마타카"
				},
				{
					"id": 750290508,
					"content": "너희도 연습이 필요하고 나도 연습이 필요해. 용과 협력하는 연습만으로는 난 만능형 용사가 될 수 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290509
					],
					"speakerTitle": "마타카"
				},
				{
					"id": 750290509,
					"content": "더 큰 무대에서 단련해야 해! 그러니까, 난 한동안 이곳을 떠날 예정이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290510
					],
					"speakerTitle": "마타카"
				},
				{
					"id": 750290510,
					"content": "여기 코스는 남겨둘 테니까 걱정하지 마! 하지만 비행 오두막은 철거해서 가져갈 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290511,
						750290513
					],
					"speakerTitle": "마타카"
				},
				{
					"id": 750290511,
					"content": "어디로 가려고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290512
					]
				},
				{
					"id": 750290512,
					"content": "음… 아빠랑 누나를 보러 갈 생각이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "마타카"
				},
				{
					"id": 750290515,
					"content": "응? 마타카의 말투가 왜 갑자기 약해졌지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290516
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750290516,
					"content": "그게 왜! 가족을 아끼고 존중하는 것도 용사가 마땅히 갖춰야 할 미덕이야! 편협하긴!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290517
					],
					"speakerTitle": "마타카"
				},
				{
					"id": 750290517,
					"content": "우리 아빠는 꽃깃회에서 가장 전문적인 훈련 교관이고, 누나는 최고의 용 기사야! 난 두 사람이 자랑스러워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290518
					],
					"speakerTitle": "마타카"
				},
				{
					"id": 750290518,
					"content": "알겠어. 놀리려는 의도는 아니었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290519
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750290519,
					"content": "응, 건투를 빌게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290520
					]
				},
				{
					"id": 750290520,
					"content": "너도야! 용사! 이번 작별 인사로 해주고 싶은 말은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290521
					],
					"speakerTitle": "마타카"
				},
				{
					"id": 750290521,
					"content": "음… 절대 포기하지 않고, 피땀 흘려가며 영웅이 되길 바라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마타카"
				},
				{
					"id": 750290513,
					"content": "어떻게 단련할 생각이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290514
					]
				},
				{
					"id": 750290514,
					"content": "음… 우선 아빠랑 누나의 의견을 물어보려고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "마타카"
				},
				{
					"id": 750290504,
					"content": "요즘 연습할 시간이 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290505
					]
				},
				{
					"id": 750290505,
					"content": "게을러! 무의미한 방황으로 인생을 낭비한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "마타카"
				}
