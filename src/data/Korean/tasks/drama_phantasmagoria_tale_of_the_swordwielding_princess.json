			"dialogs": [
				{
					"id": 790260101,
					"content": "환영합니다! 환영합니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260102
					],
					"speakerTitle": "심야 극단 단장"
				},
				{
					"id": 790260102,
					"content": "환영합니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260104
					],
					"speakerTitle": "심야 극단 단장"
				},
				{
					"id": 790260104,
					"content": "#당신이 바로 그 유명한 {NICKNAME} 님이시군요! 그리고 최고의 파트너——페이몬 님까지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260105
					],
					"speakerTitle": "심야 극단 단장"
				},
				{
					"id": 790260105,
					"content": "와! 우리 이름은 어떻게 안 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790260106,
					"content": "섬의 귀한 손님이시지 않습니까, 당연히 알지요. 왜냐하면 제가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260107
					],
					"speakerTitle": "심야 극단 단장"
				},
				{
					"id": 790260107,
					"content": "네가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790260108,
					"content": "바로 그 유명한 심야 극단의 단장입니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260109
					],
					"speakerTitle": "심야 극단 단장"
				},
				{
					"id": 790260109,
					"content": "스스로 유명하다고 하는 사람이 진짜 있구나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790260110
					]
				},
				{
					"id": 790260110,
					"content": "스스로 유명하다고 했지만, 우린 네 이름 들어본 적 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790260111,
					"content": "괜찮습니다! 지금 들었으면 됐죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260112
					],
					"speakerTitle": "심야 극단 단장"
				},
				{
					"id": 790260112,
					"content": "저희 극단이 바쁘게 준비한 「검을 든 왕녀」가 첫 공연을 앞두고 있습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260113
					],
					"speakerTitle": "심야 극단 단장"
				},
				{
					"id": 790260113,
					"content": "공연은 총 5막이고, 1막당 각각 상하 2회로 나뉘죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260114
					],
					"speakerTitle": "심야 극단 단장"
				},
				{
					"id": 790260114,
					"content": "마침 잘 오셨어요! 곧 서막이 시작됩니다! 자리에 앉으시지요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260115
					],
					"speakerTitle": "심야 극단 단장"
				},
				{
					"id": 790260115,
					"content": "전 무대 뒤에서 처리할 일이 있어서, 먼저 실례하겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260116
					],
					"speakerTitle": "심야 극단 단장"
				},
				{
					"id": 790260116,
					"content": "심야 극단이 최선을 다해 준비한 연극이 곧 시작되오니, 즐거운 관람되십시오!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "심야 극단 단장"
				}
			]
		}
	]
