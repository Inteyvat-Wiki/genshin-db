			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"베루",
					"오렐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030101,
					"content": "이번에 숨을 곳은 절대 못 찾을걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030102
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240030102,
					"content": "그런 곳에 숨으면 내가 아니라 엄마랑 아빠가 찾으러 가실 텐데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030103
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240030103,
					"content": "뭐 하고 있는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030104
					]
				},
				{
					"id": 240030104,
					"content": "형이랑 숨바꼭질하는 중이야! 근데… 내가 어디에 숨든지 전부 찾아내 버려서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030105
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240030105,
					"content": "베루… 우리가 여기서 얼마나 많이 놀았는데, 숨을 곳 같은 데가 남아 있겠냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030106
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240030106,
					"content": "숨으면 안 되는 곳은… 왜 거기로 가면 안 되는지 이미 수백 번도 더 말했지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030107
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240030107,
					"content": "거긴 그렇게 위험하지 않아! 엄마랑 아빠가 과장한 거란 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030108
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240030108,
					"content": "하지만 그런 곳에 숨으면 옷이 더러워지거나 찢어질 수도 있어. 엄마랑 아빠는 지금도 충분히 고생하고 계시니까, 괜히 걱정거리 더 만들지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030109
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240030109,
					"content": "으으… 알았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030110,
						240030111
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240030110,
					"content": "저기… 내가 같이 놀아 줄까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				},
				{
					"id": 240030112,
					"content": "#진짜?! {M#형아}{F#누나}, 나랑 놀아줄 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030113
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240030113,
					"content": "베루, 남한테 민폐 끼치지 마! 죄송해요. 동생이 항상 놀 생각만 해서요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030114,
						240030115
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240030114,
					"content": "괜찮아, 마침 시간이 있거든",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030116,
					"content": "야호! 형, 봐봐! 괜찮다잖아! 내가 형보다 더 잘 숨을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030117
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240030117,
					"content": "#그럼… 부탁드릴게요, {M#형아}{F#누나}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030118
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240030118,
					"content": "베루, 전에 말했던 곳엔 숨지 마. 오늘 밤엔 엄마랑 아빠가 늦게 돌아오실 거라 옷이 찢어져도 고쳐줄 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030119
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240030119,
					"content": "알았다니까! 진짜 잔소리는… 나 먼저 숨을 테니까 형도 같이 놀자! 아, 얼른!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030120
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240030120,
					"content": "너 먼저 가. 난 어디에 숨을지 이미 다 생각해 뒀으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030121
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240030121,
					"content": "#진짜? 뻥치시네! 제일 먼저 {M#형아}{F#누나}한테 잡힐 거면서!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030122
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240030122,
					"content": "오렐과 베루가 각자 자리에 숨는다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240030115,
					"content": "민폐 아니니까 걱정 마",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030111,
					"content": "나라면 널 찾기 어려울 것 같은데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				}
			]
		},
