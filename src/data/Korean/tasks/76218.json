				"points": []
			},
			"dialogs": [
				{
					"id": 762180101,
					"content": "응? 너희 왔구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180102
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 762180102,
					"content": "안녕! 산드로네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180103,
						762180104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762180103,
					"content": "초대해 줘서 고마워",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				},
				{
					"id": 762180105,
					"content": "어라? 티타임을 연다고 하지 않았어? 그런데 왜 아무것도 없지? 설마 아직 준비 못 한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762180106,
					"content": "하, 그럴 리가. 날 너무 얕보는 거 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180107
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 762180107,
					"content": "우와! 이… 이 테이블, 어떻게 갑자기 튀어나온 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762180108,
					"content": "훗, 대단하지? 내가 새로 개발한 휴대용 티테이블이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180109
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 762180109,
					"content": "가지고 다니기 편하고, 보관도 쉽고, 파지오와 동일한 부유 장치까지 달아놨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180110
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 762180110,
					"content": "더 대단한 건… 아니, 됐다. 무슨 홍보하는 것도 아니고, 굳이 자랑 안 할게. 너희가 직접 느껴봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180111
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 762180111,
					"content": "자, 내가 준비한 차랑 디저트야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180112
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 762180112,
					"content": "그럼 잘 먹을게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180113
					]
				},
				{
					"id": 762180113,
					"content": "오…! 진짜 맛있어! 역시 솜씨 좋다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762180114,
					"content": "그야 당연하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180115
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 762180115,
					"content": "근데 어쩌다 이런 걸 만들 생각을 했어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762180116,
					"content": "물론, 어디서든 친구들과 즐거운 티타임을 가지기 위해서지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180117
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 762180117,
					"content": "전에도 말했잖아? 소중한 걸 지키는 방법이 꼭 지금 가진 걸 붙잡는 것만은 아니라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180118
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 762180118,
					"content": "요즘은 좀 더 돌아다니면서, 친구들을 많이 만나고 싶어졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180119
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 762180119,
					"content": "하지만 초대받은 사람한테 디저트 준비에 테이블 정리까지 시키는 건, 숙녀의 예의에 어긋나지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180120
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 762180120,
					"content": "헤헤, 친구들은 그런 거 신경 안 쓸 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762180121,
					"content": "내가 신경 써. 게다가 이런 간단한 발명은 나한테 별로 힘든 일도 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180122
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 762180122,
					"content": "마음에 들어 하는 것 같은데, 그냥 하나 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180123
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 762180123,
					"content": "뭐?! 그래도 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762180124,
					"content": "안 될 건 또 뭐야? 나 이런 거 잘 만든다니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180125
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 762180125,
					"content": "그럼 고맙게 받을게…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180126
					]
				},
				{
					"id": 762180126,
					"content": "고마워할 거 없어. 폰티날리아 축제 때 너희도 날 많이 도와줬잖아. 숙녀의 답례라고 생각해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 762180104,
					"content": "오래 기다리게 한 건 아니지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				}
			]
		}
	]
}