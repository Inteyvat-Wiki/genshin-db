						],
						"pointId": 350400120
					}
				]
			},
			"dialogs": [
				{
					"id": 250310401,
					"content": "고마워, 도와줘서 정말 고마워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310402
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 250310402,
					"content": "그 망할 가방만 빨리 던져버렸어도, 나 혼자서 해결 할 수 있었을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310403
					],
					"speakerTitle": "나잠"
				},
				{
					"id": 250310403,
					"content": "그럼 우리가 나타에 온 의미가 없어지잖아! 난 싫어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310404
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 250310404,
					"content": "잠깐, 당신은… 엘라니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310405
					]
				},
				{
					"id": 250310405,
					"content": "#응? 너… 넌 {NICKNAME}! 진짜 너구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310406
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 250310406,
					"content": "옆에 있는 사람은 설마…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310407
					]
				},
				{
					"id": 250310407,
					"content": "나잠, 보물 사냥단. 우리 만난 적 있잖아, 잊은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310408
					],
					"speakerTitle": "나잠"
				},
				{
					"id": 250310408,
					"content": "후아… 넌 정말 내 구세주야. 내 목숨을 몇 번이나 구해준 거지? 한 번, 두 번…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310409
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 250310409,
					"content": "그때 나랑 있었던 일은 포함하지 마. 그때는 네가 가기 싫어했던 거잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310410
					],
					"speakerTitle": "나잠"
				},
				{
					"id": 250310410,
					"content": "그때 일은 계산에 안 넣었어. 게다가 내가 가기 싫어했다니? 내가 돈도 줬잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310411
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 250310411,
					"content": "그 정도 돈은 먹고 마시면서 다 써버릴 수 있다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310412
					],
					"speakerTitle": "나잠"
				},
				{
					"id": 250310412,
					"content": "설마 또 논문 때문에 오신 건 아니죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310413
					]
				},
				{
					"id": 250310413,
					"content": "헤헤… 이렇게 오랫동안 노력했는데 다 헛수고로 만들 순 없잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310414
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 250310414,
					"content": "이번엔 아카데미아에 신청해서 경비를 받았어. 과제도 확인 받았고. 나랑 부딪히는 사람도 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310415
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 250310415,
					"content": "게다가 나잠이 내 경호원을 맡아서 나쁜 놈들도 전부 내쫓아 줬지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310416
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 250310416,
					"content": "우리가 가진 물건이 문제를 일으켜서 가질 만큼 가치 있는 물건이 아니라는 걸 알았기 때문이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310417,
						250310418
					],
					"speakerTitle": "나잠"
				},
				{
					"id": 250310417,
					"content": "하지만 방금…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				},
				{
					"id": 250310419,
					"content": "…이 녀석이 문헌 가방을 터질 듯이 가득 채운 채로 「메아리 아이」가 있는 곳에서 여기까지 걸어왔거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310420
					],
					"speakerTitle": "나잠"
				},
				{
					"id": 250310420,
					"content": "솔직히 말해서 내가 봐도 엘라니의 모습은 가슴 속에 보물을 품고 있는 바보처럼 보여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310421
					],
					"speakerTitle": "나잠"
				},
				{
					"id": 250310421,
					"content": "보물을 품고 사람이 아무도 없는 황야를 걷는데, 옆에 경호원 한 명밖에 없다면… 누구라도 그냥 놓치기 싫겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310422
					],
					"speakerTitle": "나잠"
				},
				{
					"id": 250310422,
					"content": "맞아! 내 가방에 있는 건 다 보물이야. 이건 전부 현장 인터뷰 기록과 각종 문헌 사본이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310423
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 250310423,
					"content": "이것만 있으면, 난 논문을 쓸 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310424
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 250310424,
					"content": "흥, 이번 논문 주제가 바로 「불이 돌아온 밤의 순례」야. 무게감도 있고 중요한 내용이니까 분명 졸업할 수 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310425
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 250310425,
					"content": "아, 다 타무레스가 좋은 아이디어를 준 덕분이야. 역시 내 친구는 최고야, 헤헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310426
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 250310426,
					"content": "#다시 한번 고마워, {NICKNAME}. 네가 아니었으면 그 나쁜 녀석들이 내 책을 엉망으로 만들고 돈도 뺏어갔을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310427
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 250310427,
					"content": "얼마 전에 다른 사람들이 서적이랑 자료를 정리하는 걸 도와주고 겨우 돈을 좀 벌었거든. 만약 그걸 빼앗기면 새로운 자료를 살 돈이 없어지는 거잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310428
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 250310428,
