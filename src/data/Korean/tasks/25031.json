					}
				]
			},
			"dialogs": [
				{
					"id": 250310101,
					"content": "큰일 났네… 정말 큰 일이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310102
					],
					"speakerTitle": "타무레스"
				},
				{
					"id": 250310102,
					"content": "알렘의 훈련에 문제가 생겼나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310103
					]
				},
				{
					"id": 250310103,
					"content": "#{NICKNAME}! 마침 잘 왔어, 정말 다행이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310104
					],
					"speakerTitle": "타무레스"
				},
				{
					"id": 250310104,
					"content": "설명할 시간이 없어, 빨리 가서 사람 좀 구해 주라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310105,
						250310106
					],
					"speakerTitle": "타무레스"
				},
				{
					"id": 250310105,
					"content": "친구인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				},
				{
					"id": 250310107,
					"content": "그… 그런 셈이지. 우리 둘 다 논문 때문에 몇 번이나 좌절하고, 도서관에서 머리를 감싼 채로 울고 있었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310108
					],
					"speakerTitle": "타무레스"
				},
				{
					"id": 250310108,
					"content": "아아아——지금은 이런 말을 할 때가 아니야! 그 녀석은 내 충고를 듣지도 않아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310109
					],
					"speakerTitle": "타무레스"
				},
				{
					"id": 250310109,
					"content": "논문을 위해서라면 뭐든 할 수 있다고 하더니, 경호원이랑 같이 하루 종일 바깥을 배회하고 있다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310110
					],
					"speakerTitle": "타무레스"
				},
				{
					"id": 250310110,
					"content": "그리고 아직까지 돌아오지 않았어! 부족은 사람을 보내기엔 인력이 부족해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310111
					],
					"speakerTitle": "타무레스"
				},
				{
					"id": 250310111,
					"content": "#{NICKNAME}, 빨리 가서 구해줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310112,
						250310113
					],
					"speakerTitle": "타무레스"
				},
				{
					"id": 250310112,
					"content": "저한테 맡기세요, 이런 일은 아주 익숙하거든요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310115
					]
				},
				{
					"id": 250310115,
					"content": "#이 일을 맡아줄 사람은 너 뿐이야! 전부 네게 달렸어, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타무레스"
				},
				{
					"id": 250310113,
					"content": "아카데미아 사람들은 정말…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310114
					]
				},
				{
					"id": 250310114,
					"content": "그 녀석… 하아, 운이 너무 안 좋았어. 나타에 왔으니 논문을 위해 마지막 노력을 할 거라나 뭐라나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310115
					],
					"speakerTitle": "타무레스"
				},
				{
					"id": 250310106,
					"content": "아는 사람인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310107
					]
				}
			]
		},
		{
