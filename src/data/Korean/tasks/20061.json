			"dialogs": [
				{
					"id": 200610101,
					"content": "비둘기에 대해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610102
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 200610102,
					"content": "이 비둘기들은 안주로 삼는 게 낫겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610103
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 200610103,
					"content": "왜요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610104
					]
				},
				{
					"id": 200610104,
					"content": "난 원래 여기서 편지를 배달할 비둘기들을 키웠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610105
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 200610105,
					"content": "그런데 요새 비둘기들이 점점 이상해지고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610106
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 200610106,
					"content": "편지도 잃어버리고 한나절이 넘게 배달도 안 되고 있어. 땅에 가만히 있다가 사람들에게 쫓겨나고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610111
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 200610111,
					"content": "시간 있으면 방금 날려보낸 비둘기들 좀 살펴봐줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610107,
						200610109
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 200610107,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610108
					]
				},
				{
					"id": 200610108,
					"content": "그럼 부탁할게, 비둘기들이 게으름을 피우고 있다면 놈들을 다그쳐줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "두라프"
				},
				{
					"id": 200610109,
					"content": "비둘기들에게 미움 받을 텐데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610110
					]
				},
				{
					"id": 200610110,
					"content": "괜찮아. 놈들은 머리가 나빠서 금방 잊어버려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610112
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 200610112,
					"content": "네가 비둘기를 그렇게 좋아하는지 몰랐어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "두라프"
				}
			]
		},
