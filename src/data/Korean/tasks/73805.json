				},
				{
					"id": 738050102,
					"content": "저한테 온 편지요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050103
					]
				},
				{
					"id": 738050103,
					"content": "리월의 「동욱」이라는 사람이 보낸 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050104,
						738050105
					],
					"speakerTitle": "마리암"
				},
				{
					"id": 738050104,
					"content": "동욱은 지금 어디 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050106
					]
				},
				{
					"id": 738050106,
					"content": "그건 나도 잘 모르겠지만, 얼마 전에 아주 급하게 와서 나한테 이 편지를 주고 갔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050107
					],
					"speakerTitle": "마리암"
				},
				{
					"id": 738050107,
					"content": "뭐라고 했더라… 꼭 전해달라고 하면서 나한테 돈도 조금 주고 갔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050108
					],
					"speakerTitle": "마리암"
				},
				{
					"id": 738050108,
					"content": "동욱이… 급해 보였다고? 무슨 일 때문에 그렇게 서두른 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 738050109,
					"content": "설마… 그 나쁜 놈이 무슨 짓을 한 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050110,
						738050111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 738050110,
					"content": "우선 편지를 봐보자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738050112
					]
				},
				{
					"id": 738050112,
					"content": "그래… 우선 편지를 읽어보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 738050111,
