				]
			},
			"dialogs": [
				{
					"id": 747070101,
					"content": "…좋아, 완벽해! 한 컷만 더——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070102
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 747070102,
					"content": "좋아. 컷——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070103
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 747070103,
					"content": "푸리나! 콜롬비나랑 치오리도! 또 만났네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 747070104,
					"content": "응, 마침 저번에 말한 분위기 연출용 컷을 다 찍었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070105
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 747070105,
					"content": "오! 물고기한테 배우를 시킨다는 그거 말이지? 어때, 잘 나왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 747070106,
					"content": "너희가 도와준 덕분에 아주 딱 맞는 「배우」를 찾았어. 촬영도 순조로웠고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070107
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 747070107,
					"content": "수조 꾸미는 솜씨가 훌륭하더라. 아까 푸리나 감독이 보고 수중 다큐멘터리를 찍고 싶댔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070108,
						747070109
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 747070108,
					"content": "과찬이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				},
				{
					"id": 747070110,
					"content": "응, 나도 마음에 들어. 물고기들이 편안하고 즐거워하는 게 느껴지거든. 너희가 얼마나 정성껏 돌봤는지 알 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070111
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 747070111,
					"content": "이 수족관이 계속 여기 남아 있으면 좋겠다. 그럼 이 물고기들을 보러 자주 올 수 있을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070112
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 747070112,
					"content": "정 아쉬우면 영화에 몇 장면 더 넣으면 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070113
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 747070113,
					"content": "맞는 말이네. 그럼 이참에 추가하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070114
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 747070114,
					"content": "물고기를?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070115
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 747070115,
					"content": "컷 말이야…. 조명 담당, 카메라맨, 스크립터! 다들 스탠바이!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070116
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 747070116,
					"content": "알겠어! 그치만 물고기들을 위해 슬레이트를 치는 건 또 처음이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 747070109,
					"content": "마음에 들었다니 다행이네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				}
			]
		}
	]
}