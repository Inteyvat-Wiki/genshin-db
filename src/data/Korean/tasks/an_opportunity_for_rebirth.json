			"dialogs": [
				{
					"id": 140040501,
					"content": "물에 떨어졌을 줄 알았는데, 물속에도 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040502,
					"content": "대체 어디에 떨어진 걸까…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040503,
						140040504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040503,
					"content": "포기하자. 여긴 너무 넓어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040505
					]
				},
				{
					"id": 140040505,
					"content": "하긴, 대머리를 가릴 수만 있다면 아무 모자나 상관없겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040506,
					"content": "우리 「허름한 뼈다귀 상점」에 가 보자! 거기는 별게 다 있었던 거 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040507,
						140040509
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040507,
					"content": "어째 상점 얘기만 하면 신나네?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040508
					]
				},
				{
					"id": 140040508,
					"content": "헤헤, 가는 김에 다른 것도 살 수 있잖아~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040512
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040512,
					"content": "아무튼 일단 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040509,
					"content": "…미리 말해두지만, 모자만 살 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040510
					]
				},
				{
					"id": 140040510,
					"content": "엥? 내 생각을 어떻게 알았지?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040511
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040511,
					"content": "#에휴, {NICKNAME} 넌 갈수록 못 당하겠네",
