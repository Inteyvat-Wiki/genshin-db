			},
			"dialogs": [
				{
					"id": 140040801,
					"content": "이제 나와 봐. 우리가 모자를 가져왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040802
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040802,
					"content": "정말요? 고맙습니다! 지금 바로 나갈게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040803
					],
					"speakerTitle": "페이솔"
				},
				{
					"id": 140040803,
					"content": "어… 어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040804
					],
					"speakerTitle": "페이솔"
				},
				{
					"id": 140040804,
					"content": "뭐야, 머리카락이 있잖아? 게다가 엄청 풍성해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040805
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040805,
					"content": "후, 당신들이 오해한 거라니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040806
					],
					"speakerTitle": "페이솔"
				},
				{
					"id": 140040806,
					"content": "잠깐, 이건 제가 잃어버린 모자가 아니네요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040807
					],
					"speakerTitle": "페이솔"
				},
				{
					"id": 140040807,
					"content": "네가 말한 모자는 도저히 못 찾겠어서 우리가 새로 하나 사 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040808
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040808,
					"content": "정확히 말하면 선물로 받은 거죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040809
					]
				},
				{
					"id": 140040809,
					"content": "아, 그랬군요. 정말 고마워요. 근데 전 그 모자가 아니면 안 돼요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040810
					],
					"speakerTitle": "페이솔"
				},
				{
					"id": 140040810,
					"content": "뭔가 의미 있는 물건인 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040811
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040811,
					"content": "그게, 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040812
					],
					"speakerTitle": "페이솔"
				},
				{
					"id": 140040812,
					"content": "미안해요. 뭐라 설명할지 모르겠네요. 시간이 없으니 전 가서 좀 더 찾아볼게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040813
					],
					"speakerTitle": "페이솔"
				},
				{
					"id": 140040813,
					"content": "모자라면 방금 아래에서 주운 게 하나 있는데, 이게 네 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040814
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 140040814,
					"content": "고, 공작님?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040815
					],
					"speakerTitle": "페이솔"
				},
				{
					"id": 140040815,
					"content": "아, 라이오슬리구나. 오랜만이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040816
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040816,
					"content": "그래. 오늘은 딱히 일도 없어서 둘러보러 나왔어. 사무실이 넓긴 하지만 오래 있으면 역시 답답하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040817
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 140040817,
					"content": "그나저나 너희는 여전하네. 도움 요청을 받으면 거절하는 법이 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040818
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 140040818,
					"content": "이게 바로 모험가 정신이라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040819
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040819,
					"content": "하, 메로피드 요새에 모험가 길드 지부라도 하나 세우고 싶은걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040820
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 140040820,
					"content": "그나저나 모자는 「챙모자회」 멤버에게 아주 중요한 물건일 텐데, 이렇게 쉽게 잃어버려서야 쓰나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040821
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 140040821,
					"content": "다음번엔 이런 행운이 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040822
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 140040822,
					"content": "지당하신 말씀입니다. 저, 정말 감사합니다. 공작님…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040823
					],
					"speakerTitle": "페이솔"
				},
				{
					"id": 140040823,
					"content": "그, 그럼 전 이만… 어, 먼저 가보겠습니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040824
					],
					"speakerTitle": "페이솔"
				},
				{
					"id": 140040824,
					"content": "음, 정말 이상한 사람이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040825
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040825,
					"content": "뭐라도 잘못한 건가? 어째 널 보자마자 혼이 쏙 빠진 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040826
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040826,
					"content": "그럴 리가. 「챙모자회」 녀석들은 말썽을 피우지도 않고 일도 열심히 해서 걱정할 거 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040827
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 140040827,
					"content": "아마 내향적인 성격이라 갑자기 날 보고 긴장한 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040828
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 140040828,
					"content": "엥? 내향적인… 죄수도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040829
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040829,
					"content": "세상에 수많은 죄명이 있듯 범죄자의 동기 또한 다양하지. 「죄인」이라는 건 하나의 큰 범주일 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040830
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 140040830,
					"content": "「사악함」이나 「난폭함」 그리고 「이기심」 같은 단어 하나로 복잡한 인간성을 설명할 순 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040831
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 140040831,
					"content": "그가 어떤 사람이고 어째서 유죄 판결을 받았는지는 그가 겪은 일을 알아봐야 알 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040832
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 140040832,
					"content": "맞는 말이야. 아무튼 네가 신경 안 쓰인다면 된 거지 뭐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040833,
						140040834
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040833,
					"content": "「챙모자회」는 뭐죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040835
					]
				},
				{
					"id": 140040835,
					"content": "대부분의 파벌은 죄수 개인 간의 다툼을 패싸움으로 만들 뿐이지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040836
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 140040836,
					"content": "「챙모자회」는 꽤 신선한 일을 시도하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040837
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 140040837,
					"content": "지금 시간 어때? 괜찮으면 같이 특별 허가 식당에 가서 이야기 좀 나눴으면 하는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040838
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 140040838,
					"content": "이야기 끝나고 관심 있으면 「챙모자회」의 휴게실도 구경시켜 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040839
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 140040839,
					"content": "그 식당에 좋은 기억은 없지만, 어차피 할 일도 없으니까 뭐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040840
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040840,
					"content": "가보죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040841
					]
				},
				{
					"id": 140040841,
					"content": "그럼 날 따라와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 140040834,
					"content": "여기서 열심히 일하는 사람도 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040835
					]
				}
			]
		},
