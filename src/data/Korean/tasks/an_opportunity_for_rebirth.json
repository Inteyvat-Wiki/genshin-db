						],
						"pointId": 6129
					}
				]
			},
			"dialogs": [
				{
					"id": 140040701,
					"content": "응? 여기 사장은 다른 사람이었던 거 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040702
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040702,
					"content": "하하하, 에르바도 형님은 물건 수주하러 가셨거든. 그래서 내가 가게를 보고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040703
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040703,
					"content": "잠깐, 금발의 외국인과 날아다니는 흰색 생강 쿠키라면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040704
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040704,
					"content": "설마 소문으로만 듣던 그 여행자와 유능한 파트너 페이몬 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040705
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040705,
					"content": "맞아! …가 아니라 반만 맞았네? 난 생강 쿠키가 아니야. 하지만 유능한 파트너지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040706
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040706,
					"content": "미안미안, 직접 보니까 너무 흥분했나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040707
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040707,
					"content": "혹시라도 내가 말실수했다면, 넓은 아량으로 이해해 줘. 너희에 비하면 난 일개 점원에 불과하잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040708
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040708,
					"content": "앗, 그렇게 말할 것까진 없는데. 그냥 해본 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040709
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040709,
					"content": "너희가 에리니에스섬에서 한 일들은 이미 메로피드 요새까지 퍼졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040710
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040710,
					"content": "저번에 공작님께서 여기 온 너희를 직접 맞아주셨다며? 그 얘길 듣고 어찌나 부럽던지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040711
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040711,
					"content": "이젠 다들 너희가 공작님 곁의 유명 인사라는 걸 아니까, 너희랑 친해지고 싶어서 안달이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040712,
						140040713
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040712,
					"content": "그 사람 때문이었군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040714
					]
				},
				{
					"id": 140040714,
					"content": "하하, 아부하는 것보다 솔직히 말하는 게 더 낫다고 생각했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040715
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040715,
					"content": "애초에 에르바도 형님 가게를 봐주겠다고 한 것도 형님이 공작님과의 관계가 남다르다고 들어서였거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040716
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040716,
					"content": "근데 여태까지 공작님은 몇 번 뵙지도 못 하고, 형님이랑만 친해졌지 뭐야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040717
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040717,
					"content": "누구나 목표는 있지만, 그게 실현될지는 아무도 모르는 법이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040718
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040718,
					"content": "그래서 목표를 우리로 바꾼 거구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040719
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040719,
					"content": "에이, 그건 그거고. 너희를 만난 것 자체로도 충분히 영광이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040720
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040720,
					"content": "참, 그래서 무슨 일로 왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040721
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040721,
					"content": "남성용 모자가 필요해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040722
					]
				},
				{
					"id": 140040722,
					"content": "문제없지. 더 필요한 건 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040723
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040723,
					"content": "「특별 허가 쿠폰」 걱정은 하지 말고 마음껏 골라. 내가 선물로 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040724
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040724,
					"content": "에이, 아니야. 그럼 너무 미안하잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040725
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040725,
					"content": "후, 어차피 형님도 매번 급여 대신 나보고 마음에 드는 물건을 골라가라고 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040726
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040726,
					"content": "난 요즘 필요한 것도 딱히 없으니, 친구 사귀는 셈 치고 선물로 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040727
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040727,
					"content": "그렇게까지 말한다면야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040728
					]
				},
				{
					"id": 140040728,
					"content": "그, 그럼 한번 골라볼까…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040729
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040729,
					"content": "페이몬은 망설임 끝에 최대한 자제해서 간식 두 가지를 고른다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140040730
					]
				},
				{
					"id": 140040730,
					"content": "더 안 고를 거야? 쉽게 찾아오는 기회가 아니라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040731
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040731,
					"content": "괜찮아, 이거면 충분해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040732
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040732,
					"content": "페이몬도 자제할 때가 있구나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040733
					]
				},
				{
					"id": 140040733,
					"content": "그치만 받는 거랑 고르는 건 느낌이 다르다구. 받는 게 더 속 편해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040734
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040734,
					"content": "아무튼 이건 복잡한 문제니까 됐어. 페이몬 심리학은 다음에 가르쳐줄게. 일단 모자나 가져다주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040735
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040735,
					"content": "고마워. 그럼 우린 이만 가볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040736
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040736,
					"content": "응, 방문해 줘서 고마워! 나중에 공작님한테 「허름한 뼈다귀 상점」에 대한 호평도 좀 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140040737
					],
					"speakerTitle": "샴보듀크"
				},
				{
					"id": 140040737,
					"content": "흠, 이런 식으로 호평을 받으려는 건 조금 교활하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140040713,
					"content": "전 제 매력 때문인 줄 알았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140040714
					]
				}
			]
		},
