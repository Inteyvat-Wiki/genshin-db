			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"알베도"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410401,
					"content": "저 사람이 알베도인가? 왜 이런 곳에 있는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110410402,
					"content": "알베도는 그림 그리는 걸 좋아한다고 들었어. 이런 곳에 와서 그린다 해도 이상할 건 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410403
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110410403,
					"content": "여긴 시야가 탁 트여 경치도 좋으니 어딜 그려도 멋질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410404
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110410404,
					"content": "하지만… 저기 저 츄츄족들은 못 본 건가? 갑자기 공격할 수도 있는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110410405,
					"content": "으악?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 1104106,
			"completionStepIds": [
				1104106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104106",
							"2"
						],
						"stepId": 1104106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"알베도"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410601,
					"content": "누구야? 왜 저들을 괴롭히는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410602
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410602,
					"content": "그림을 다 그렸기에 망정이지. 특이한 츄츄족을 다 못 그렸다면 아쉬울 뻔했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410603,
						110410604
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410603,
					"content": "츄츄족을 그리고 있었구나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				},
				{
					"id": 110410605,
					"content": "츄츄족이 그릴 게 뭐 있다고? 다 똑같이 생긴 거 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110410606,
					"content": "음… 그건 말로 설명하긴 복잡해. 내 그림을 직접 봐봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410607,
						110410608
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410607,
					"content": "이건…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410609,
					"content": "와, 열심히 그린 것도 있는데, 되게 성의 없게 그린 것도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410610
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110410610,
					"content": "어디서나 볼 수 있는 시시한 츄츄족은 시간 낭비할 가치도 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410611
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410611,
					"content": "하지만 얘를 좀 봐. 체격이며 털이며 자태며, 전부 남다른 생명력이 보여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410612
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410612,
					"content": "원시 부족의 순환되는 삶 속에서 이런 특수성은 진화를 의미해. 진화는 즉 무에서 유로, 이미 알고 있던 것부터 미지의 것까지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410613
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410613,
					"content": "잠깐잠깐. 얘기가 길어질 것 같은데 난 그런 데 관심 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410614
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110410614,
					"content": "사람도 찾았으니 난 이만 가볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410615
					],
					"speakerTitle": "로자리아"
				},
				{
					"id": 110410615,
					"content": "아, 너 알베도한테 물어볼 거 있는 거 아니었어? 이봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410616
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110410616,
					"content": "휴, 정말 이상한 사람이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410617
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110410617,
					"content": "로자리아 수녀님이 길잡이 역할을 하실 줄이야. 음, 미처 감사하단 말도 못 했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410618
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410618,
					"content": "그나저나 여기까지 날 찾아온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410619
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410619,
					"content": "응, 맞아! 몬드성에서 설탕이란 애를 만났는데, 요즘 네 연구가 슬럼프에 빠졌다고 하더라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410620
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110410620,
					"content": "그랬군. 설탕이 너흴 보낸 거구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410621
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410621,
					"content": "내 예상이 맞다면, 네가 바로 요즘 몬드성에서 회자되는 그 「명예 기사」지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410622
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410622,
					"content": "네가 용의 재앙에서 보여줬던 행동과 심상치 않은 원소 제어 능력, 그리고 그 외의 신비한 점들까지 모두 전해 들었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410623
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410623,
					"content": "결론부터 말하자면, 가능성은 오직 하나——넌 머나먼 「다른 세계」에서 온 거, 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410624,
						110410625
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410624,
					"content": "응, 맞아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410626,
					"content": "좋아! 네가 도와준다면 분명 내 연구에 한 획을 그을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410627,
						110410628
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410627,
					"content": "네 연구?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410629,
					"content": "아, 미안. 많이 당황스럽지? 어디부터 설명하는 게 좋을까… 음, 먼저 생명의 본질부터 얘기해 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410630
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410630,
					"content": "잠깐! 벌써부터 너무 추상적이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410631
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110410631,
					"content": "음… 그건 그렇네. 말로 설명하는 것보단 직접 보여주는 게 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410632
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410632,
					"content": "마른 가지에 「새 생명」을 불어 넣는 그런 거 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410634
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410634,
					"content": "그런 걸 할 수 있다구?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410635,
						110410636
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110410635,
					"content": "연금술은 정말 신기하네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410637,
					"content": "하지만… 내 특별한 씨앗은 방금 말한 방법으로도 효과가 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410639
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410639,
					"content": "그건 너처럼 다른 세계에서 왔어——어떻게 싹 틔우고 꽃 피울지가 바로 내가 맞닥트린 고민거리이자 네가 도와줘야 할 연구 과제야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410640
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410640,
					"content": "네가 못하는 거면, 우리도 못 하지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410641
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110410641,
					"content": "아니. 난 다른 세계의 생명은 상상할 수도 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410642
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410642,
					"content": "하지만 똑같이 다른 세계에서 온 널 관찰하고 연구한다면, 씨앗을 싹 틔울 방법을 찾아낼 수 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410643
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410643,
					"content": "그니까 내가 「연구 대상」이란 거네?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410644
					]
				},
				{
					"id": 110410644,
					"content": "#어, 어쩌지, {NICKNAME}? 좀 이상한 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410645,
						110410647
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110410645,
					"content": "위험한 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410646
					]
				},
				{
					"id": 110410646,
					"content": "어쩌면. 하지만 내가 최대한 안전하게 지켜줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110410649,
					"content": "그럼 지체할 거 없이 서둘러 장소를 옮겨 연구를 시작하자",
