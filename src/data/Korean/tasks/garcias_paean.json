				"objectNames": [
					"가르시아"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710981301,
					"content": "이 변수… 틀렸어. 이게 아냐. 먼저 계산법을 수정해야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981302
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 710981302,
					"content": "선생님, 우리 돈 아껴 써야 해요. 그렇지 않으면 수메르로 갈 경비가 모자랄 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981303
					],
					"speakerTitle": "루통"
				},
				{
					"id": 710981303,
					"content": "수메르? 그래 맞아. 경비를 생각해야지. 수메르에 도착하기만 하면 이 「숫자 기계」를 개량할 방법을 반드시 찾을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981304
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 710981304,
					"content": "그럼 내 「숫자 기계」가 더 위대한 숫자를 계산할 수 있게 되겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981305
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 710981305,
					"content": "…저도 선생님 의견에 완전히 동의해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "루통"
				}
			]
		},
		{
