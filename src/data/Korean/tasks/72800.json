				"points": []
			},
			"dialogs": [
				{
					"id": 728000201,
					"content": "…무슨 일이시죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000202
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000202,
					"content": "당신은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000203
					]
				},
				{
					"id": 728000203,
					"content": "나는 무네히사라 하오, 그냥 지나가는 사람이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000204
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000204,
					"content": "우와… 이 아저씨의 옷차림은 「무사」 같은 걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000205
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 728000205,
					"content": "무, 무사? 설마 막부의 그 「무사」… 막부는 외국인한테 엄청… 그렇다고 하던데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000206
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 728000206,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000207
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000207,
					"content": "걱정 마십시오. 이미 막부를 떠난 몸, 더 이상 무사가 아닙니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000208
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000208,
					"content": "종종 여기에 먹을거리를 찾으러 오는데, 오늘 마물이 근처에서 출몰하는 걸 보게 됐습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000209
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000209,
					"content": "게다가 근처의 식자재들도 전부 쓸어간 듯하여, 어쩔 수 없이 처치하게 되었습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000210,
						728000212,
						728000214
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000210,
					"content": "여기 자주 오세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000211
					]
				},
				{
					"id": 728000211,
					"content": "여긴 마물이 별로 없는 지역입니다. 종종 이 근처에 과일을 따거나 사냥을 하러 옵니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000217,
					"content": "여기까지만 말씀드리겠습니다. 마물들을 처치했으니 주변의 마물들도 잠시 동안은 접근하지 않을 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000218
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000218,
					"content": "여러분들도 먹을거리를 찾으러 오신 거라면, 주변에서 찾으시면 됩니다. 혼자 먹을 양만 수집했으니 아직도 많이 남았을 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000219
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000219,
					"content": "그럼, 이만 가보겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000220
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000220,
					"content": "그, 그냥 가버렸어. 어쩐지 분위기가 소문으로 들었던 무사랑 똑같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000221
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 728000221,
					"content": "그런데 막부를 떠났다는 건 무슨 의미지? 게다가 막부를 떠난 무사라면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000222,
						728000223
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 728000222,
					"content": "전에 만났던 적처럼요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000224,
					"content": "맞아, 예전에 들은 적 있어. 막부를 떠난 떠돌이 무사들이 생계를 위해 강도짓을 하고 다닌다던데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000225
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 728000225,
					"content": "아까 아저씨는 악당은 아닌 거 같은데 그래도 경계하는 게 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000226
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 728000226,
					"content": "그만, 그만. 우리 식자재 찾으러 여기 온 거잖아? 하지만 주변 상황을 보니까 더 깊이 들어가지는 말자, 위험한 상황이 생길 수도 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000227
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 728000227,
					"content": "여행자도 장시간 우릴 호송했으니 힘들 거야. 여기서 음식을 요리해서 재정비를 하고 성으로 돌아가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000228
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 728000228,
					"content": "아저씨가 근처에 남은 음식이 있다고 했지? 주변에서 찾아보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동욱"
				},
				{
					"id": 728000223,
					"content": "「해란귀」처럼요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000224
					]
				},
				{
					"id": 728000212,
					"content": "혼자서 마물을 전부 해치운 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000213
					]
				},
				{
					"id": 728000213,
					"content": "그렇습니다. 평범한 마물들이어서 상대하기 쉬웠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000214,
					"content": "왜 야외에서 먹을거리를 찾는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000215
					]
				},
				{
					"id": 728000215,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000216
					],
					"speakerTitle": "???"
				},
				{
					"id": 728000216,
					"content": "사정이 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000217
					],
					"speakerTitle": "???"
				}
			]
		},
