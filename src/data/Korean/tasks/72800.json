				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728000301,
					"content": "신선한 식자재를 찾으려고 했는데… 뭐, 이것들로도 충분하겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000302
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 728000302,
					"content": "미안, 맛있는 요리를 해주고 싶었는데 그냥 대충 때워야 할 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000303,
						728000306
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 728000303,
					"content": "괜찮아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000304
					]
				},
				{
					"id": 728000304,
					"content": "호송하느라 고생했는데 「괜찮다」고 그냥 넘어가면 안 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000305
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 728000305,
					"content": "일단은 기억해두고, 다음에는 꼭 맛있는 요리를 대접해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 728000308,
					"content": "줄리, 국 다 돼가지? 잊지 말고 파르바나한테…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000309
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 728000309,
					"content": "읍읍, 안, 안 돼! 조용히 끓게 하면 되잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000310
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 728000310,
					"content": "걱정 마, 개조한 레시피에 따라 국에 간을 한 것뿐이니까. 조미료 조금 넣는 것뿐인데 뭐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000311
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 728000311,
					"content": "네가 개조한 레시피는 이제 알아볼 수도 없다고, 그만해! 동욱아, 동욱아, 빨리 와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000312
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 728000312,
					"content": "파르바나! 야! 대체 안에 무슨 이상한 조미료를 넣고 있는 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000313
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 728000313,
					"content": "이상한 조미료라니? 그건 내가 개발한 특제 조미료라구! 내 논문에도 수록된 연구 성과란 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000314
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 728000314,
					"content": "괜찮아! 오늘은 그냥 평범한 요리로 만족하자! 줄리, 파르바나 좀 말려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000315
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 728000315,
					"content": "흥, 아무것도 모르면서… 됐어, 조금 더 개선해야겠다. 요리에 넣기만 하면, 그 어떤 요리든지 맛있어지는 스페셜 조미료를 언젠가는 꼭 만들고 말 테야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000316
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 728000316,
					"content": "만능 조미료… 과연 그런 걸 만들어낼 수 있을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000317
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 728000317,
