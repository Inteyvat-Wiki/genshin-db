						700090312
					],
					"speakerTitle": "블랑키"
				},
				{
					"id": 700090312,
					"content": "흠… 새고기를 두는 게 좋겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090313
					],
					"speakerTitle": "블랑키"
