			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"빅토르"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090101,
					"content": "아저씨, 아저씨네 우잉단도 윈드블루 축제 때 놀아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090102
					],
					"speakerTitle": "릴리"
				},
				{
					"id": 700090102,
					"content": "음, 못 놀 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090103
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090103,
					"content": "뭐 하고 계세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090104
					]
				},
				{
					"id": 700090104,
					"content": "어, 또 너야? 이봐, 왜 또 의심스러운 표정인 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090105
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090105,
					"content": "내가 나쁜 짓을 한 것도 아니고, 애랑 얘기 좀 하겠다는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090106
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090106,
					"content": "우인단은 정말 윈드블룸 축제를 안 즐기나 보네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090107
					]
				},
				{
					"id": 700090107,
					"content": "#{M#오빠}{F#언니}도… 축제 때 못 놀아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090108
					],
					"speakerTitle": "릴리"
				},
				{
					"id": 700090108,
					"content": "그야 당연하지, 몬드성 「명예 기사」가 축제는 무슨, 계속 일할걸? 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090109
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090109,
					"content": "그 우쭐한 표정은 뭐죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090110
					]
				},
				{
					"id": 700090110,
					"content": "크흠… 큼, 됐다. 얘긴 그만하고 지금 한가해 보이는데, 나 좀 도와줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090111
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090111,
					"content": "얘 부모님이 이 소란스러운 축젯날에도 쇼핑하러 가겠다며 얘를 수녀한테 맡기고 갔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090112
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090112,
					"content": "근데 너도 알다시피 이날 성 안팎으로 다들 바쁘잖아. 수녀가 얠 봐줄 시간이 어딨겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090113
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090113,
					"content": "그래서 나한테 떠밀고 가버렸지 뭐야. 열심히 놀아주고 있긴 한데, 내가 성당을 나갈 수 없으니 여기서 잡담을 나누는 수밖에 없다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090114
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090114,
					"content": "근데 내가 「우인단」이라 그런지 이 애랑 말만 하면 옆에 있는 수녀가 째려본다니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090115
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090115,
					"content": "분명 '저 「우인단」 놈이 또 무슨 꿍꿍이가 있는 거지?'라고 생각할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090116
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090116,
					"content": "쳇, 그 수녀가 귀찮게 하기 전에, 아 그리고 이 애를 위해서라도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090117
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090117,
					"content": "너같이 정의로운 「명예 기사」가 대신 이 애랑 놀아주는 어떨까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090118,
						700090122
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090118,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090119
					]
				},
				{
					"id": 700090119,
					"content": "오, 시원시원한데, 역시 「명예 기사」야. 이것저것 따져가며 보수라도 달라고 할 줄 알았는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090120
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090120,
					"content": "빨리 그 애 데리고 나가. 난 여기서 계속 수녀들의 매서운 눈총이나 받고 있을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090121
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090121,
					"content": "에휴, 언제까지 이렇게 살아야 되는 걸까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090122,
					"content": "사실은 릴리가 나가서 놀라고 배려해주는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090123
					]
				},
				{
					"id": 700090123,
					"content": "뭣… 그럴 리가, 난 「우인단」이야. 나쁜 사람이라고. 배려는 무슨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090124
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090124,
					"content": "에이, 됐으니까 빨리 그 애 데리고 나가. 성당 안에만 있느라 엄청 답답했던 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090125
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090125,
					"content": "난 뭐… 계속 여기서 수녀들의 따가운 눈초리나 받아야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090126
					],
					"speakerTitle": "빅토르"
				},
				{
					"id": 700090126,
					"content": "에휴, 언제까지 이렇게 살아야 되는 걸까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "빅토르"
				}
			]
		},
		{
			"id": 7000902,
