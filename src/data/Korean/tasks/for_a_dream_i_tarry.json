			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아미",
					"자비"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090501,
					"content": "이건… 저한테 주는 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090502
					],
					"speakerTitle": "아미"
				},
				{
					"id": 731090502,
					"content": "그 상자는 별생각없이 묻었고, 안에 든 쪽지의 글도 대충 쓴 거라 아저씨가 보셔도 괜찮아요, 사과할 필요 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090503
					],
					"speakerTitle": "아미"
				},
				{
					"id": 731090503,
					"content": "괜찮아, 이 화분은 어차피 나한테 쓸모없으니까 너 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090504
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090504,
					"content": "그리고 다른 사람에게 씨앗을 구해달라고 부탁했어. 이제 곧 올 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090505,
						731090506
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090505,
					"content": "씨앗 가져왔어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				},
				{
					"id": 731090507,
					"content": "어? 언제 왔어? 못 봤네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090508
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090508,
					"content": "크흠… 아미야, 원예사가 되고 싶다고 했지? 이걸로 먼저 꽃을 심어보렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090509
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090509,
					"content": "고마워요… 근데 아빠가 가게 옆에서 꽃을 키우면 벌레가 냄비에 날아들지도 모른다고 하셨어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090510
					],
					"speakerTitle": "아미"
				},
				{
					"id": 731090510,
					"content": "냄비에 빠진 벌레도 불쌍하고, 벌레를 먹을 어른도 불쌍해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090511
					],
					"speakerTitle": "아미"
				},
				{
					"id": 731090511,
					"content": "꽃을 멀리 옮겨 놓으면 돌보는 것도 잊어버릴까 봐 걱정돼요. 그럼 시들 꽃도 불쌍해요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090512
					],
					"speakerTitle": "아미"
				},
				{
					"id": 731090512,
					"content": "그리고 아빠는 평소에 너무 바빠서, 저 혼자 너무 멀리 가지 못하게 하셔서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090513
					],
					"speakerTitle": "아미"
				},
				{
					"id": 731090513,
					"content": "음… 괜찮다면 나랑 같이 이 꽃을 돌보는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090514
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090514,
					"content": "매일 퇴근할 때만 올 수 있겠지만 잠깐의 여유는 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090515
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090515,
					"content": "좋아요! 근데 아빠가 허락하지 않을지도 몰라요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090516
					],
					"speakerTitle": "아미"
				},
				{
					"id": 731090516,
					"content": "나랑 자한기르 씨는 구면이라, 같이 가서 얘기해 보면 허락할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090517
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090517,
					"content": "좋아요! 그럼… 화분 몇 개 더 심어야겠어요! 저는 장미가 너무 좋아요! 나중에는… 아빠의 가게 옆에 수메르 장미를 잔뜩 심을 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090518
					],
					"speakerTitle": "아미"
				},
				{
					"id": 731090518,
					"content": "알았어, 꿈이 있는 소녀구나. 그럼 같이 노력해 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090519,
						731090520
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090519,
					"content": "꽃이 피게 되면 한 송이쯤은 꼭 나눠줘",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090521,
					"content": "#네! 고마워요, {M#오빠}{F#언니}. 달콤달콤꽃도 더 심고 싶고, 그… 다음에 뭘 더 심으면 좋을까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090522
					],
					"speakerTitle": "아미"
				},
				{
					"id": 731090522,
					"content": "이 아이는 꽃 심기를 진심으로 좋아하나 봐. 계속 이렇게 자신의 꿈을 좇았으면 좋겠는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090523
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090523,
					"content": "헤헤… 나처럼 평범하고 지루한 어른이 되지 않기를",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090524
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090524,
					"content": "크흠! 여행자, 도와줘서 고마워! 이건 보수니까 받아둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090525,
						731090526
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090525,
					"content": "열심히 사는 것은 결코 평범하지 않아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090527,
					"content": "고마워, 사실 현 상황에 딱히 불만이 있는 것은 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090528
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090528,
					"content": "다만… 오늘 묻어둔 「꿈」을 보고 마음이 좀 복잡했을 뿐이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090529
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090529,
					"content": "나도 이제 돌아갈 시간이 되었어. 오늘 고마웠어, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090530
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090530,
					"content": "혹시… 「꿈」을 다시 써서 묻어야 하나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자비"
				},
				{
					"id": 731090526,
					"content": "열심히 사는 것은 결코 지루하지 않아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090520,
					"content": "힘내!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090506,
					"content": "이 씨앗들을 받아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				}
			]
