			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"자비"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090301,
					"content": "이런. 이 「꿈의 상자」는 내 것이 아니네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090302,
						731090304
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090302,
					"content": "우리가 상자 하나를 파냈어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090303
					]
				},
				{
					"id": 731090303,
					"content": "하하… 나도 하나 파냈어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090305
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090305,
					"content": "그리고 이 「꿈의 상자」를 열어보았는데, 상자 안에 든 쪽지에는 아미의 이름이 적혀 있더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090306
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090306,
					"content": "그 아이는 자한기르의 딸인데, 그 식품점 옆에서 자주 봤던 걸로 기억이 나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090307
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090307,
					"content": "그 아이의 꿈은 원예사가 되어 꽃을 많이 심는 거였구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090308
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090308,
					"content": "전혀 몰랐어, 자한기르가 자신 가게의 후계자로 키우려는 줄 알았는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090309,
						731090310
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090309,
					"content": "일단 당신의 꿈부터 봐요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090311,
					"content": "아! 그래그래, 자신의 꿈부터 확인해야지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090312
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090312,
					"content": "어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090313
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090313,
					"content": "「『바나{RUBY#[D]숲을 걷는 자}라』가 되어 숲에서 계속 살고 싶다…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090314
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090314,
					"content": "내 어릴 적 꿈이 이거였다고? 그땐 무슨 생각을 했는지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090315
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090315,
					"content": "야… 이놈아, 바나{RUBY#[D]숲을 걷는 자}라는 쉽게 돈을 벌 수 없는 직업이란다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090316,
						731090317
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090316,
					"content": "나쁘지 않다고 생각해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090318,
					"content": "그건 어린이만이 가질 수 있는 생각이고, 나처럼 어른이 되면 꿈보다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090319
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090319,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090320
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090320,
					"content": "차라리 어떻게 해야 모라를 좀 더 벌어서 밤에 편히 잠들 수 있는지를 고민하는 게 낫겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090321
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090321,
					"content": "됐어, 내 지루한 꿈은 그만 말하고 아미 것 좀 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090322
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090322,
					"content": "그 아이의 「꿈의 상자」를 함부로 열었으니 사죄의 뜻으로 뭔가를 해줘야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090323
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090323,
					"content": "음… 어디 보자, 꿈이 원예사라고 했으니 먼저 꽃을 키우는 법을 배워야겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090324
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090324,
					"content": "여기에 마침 방치된 화분이 있으니 그 아이에게 가져다주면 되겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090325
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090325,
					"content": "여행자, 꽃의 씨앗을 어떻게 구하는지 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090326,
						731090327
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090326,
					"content": "맡겨주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090332
					]
				},
				{
					"id": 731090332,
					"content": "그럼 씨앗 부탁할게. 여행자, 이따가 자한기르의 가게 옆에서 만나자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자비"
				},
				{
					"id": 731090327,
					"content": "왜 이렇게까지 하려는 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090328
					]
				},
				{
					"id": 731090328,
					"content": "하하하… 갑자기 그러고 싶어서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090329
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090329,
					"content": "내 꿈을 좇는 건 이제 불가능한 일인 것 같아서. 한편으로 젊은 나이도 아니고, 다른 한편으로… 지금은 그 꿈에 관심 없으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090330
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090330,
					"content": "그런데 아미는 달라. 얘는 아직 어려서 자신의 꿈을 이루기 위해 얼마든지 도전할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090331
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090331,
					"content": "도움이 안 되는 이 따분한 어른이 응원차 화분이라도 보내려는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090332
					],
					"speakerTitle": "자비"
				},
				{
					"id": 731090317,
					"content": "꿈은 좋다 나쁘다로 구분하는 게 아니니깐요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090310,
					"content": "이건 당신의 「꿈의 상자」예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090304,
					"content": "당신도요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090305
					]
				}
			]
		},
		{
			"id": 7310905,
			"completionStepIds": [
				7310905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
