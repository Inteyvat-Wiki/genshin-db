	"talks": [
		{
			"id": 7310901,
			"completionStepIds": [
				7310901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
