			"dialogs": [
				{
					"id": 220010401,
					"content": "#{M#오빠}{F#언니}, 연꽃받침 찾았어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010402
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220010402,
					"content": "찾았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010403
					]
				},
				{
					"id": 220010403,
					"content": "너…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010404
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220010404,
					"content": "너…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010405
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220010405,
					"content": "그만 좀 해! 이렇게 오래 싸우면 지치지도 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010406
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220010406,
					"content": "그냥 게임일 뿐이니까 화내지 마. 우린 모두 친구잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010407
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220010407,
					"content": "자, 방금 따온 연꽃받침이야. 어서 먹어봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010408
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220010408,
					"content": "다 먹고 나서 다시 상의해보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010409
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220010409,
					"content": "누가 선장하고 누가 종업원 할지 순서를 정하면 되잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010410
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220010410,
					"content": "그래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010411
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220010411,
					"content": "응…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010412
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220010412,
					"content": "정말 조용해졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220010413,
					"content": "어때요, 내 말이 맞죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010414,
						220010416
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220010414,
					"content": "어떻게 알았어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010415
					]
				},
				{
					"id": 220010415,
					"content": "오랫동안 같이 놀았으니까, 당연히 알죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "룰루"
				},
				{
					"id": 220010416,
					"content": "룰루, 대단한걸…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010417
					]
				},
				{
					"id": 220010417,
					"content": "#고마워요, {M#오빠}{F#언니}. 하지만 정말 대단한 건 북두 언니예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010418
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220010418,
					"content": "저도 커서 북두 언니처럼 될 수 있을까요…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "룰루"
				}
			]
		},
