		{
			"id": 2200103,
			"completionStepIds": [
				2200106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200106",
							"2"
						],
						"stepId": 2200106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"소몽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220010301,
					"content": "#{M#형}{F#누나}, 바로 여기예요! 선장은 여기에 있어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010302
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220010302,
					"content": "해적을 데리고 오면 어떡해! 원래 네가 시간을 끌면 내가 룰루를 데리고 도망치기로 했잖아!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010303
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220010303,
					"content": "왜 넌 룰루랑 도망치고 나만 여기서 해적을 막아야 하는 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010304
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220010304,
					"content": "해적한테 너를 넘기면 나도 룰루를 데리고 도망칠 수 있잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010305
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220010305,
					"content": "너… 북두 누나는 친구를 함부로 배신하면 안 된다고 했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010306
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220010306,
					"content": "그럼 북두 누나가 선장은 사람 데리고 도망이나 치는 사람이라는 말도 했냐?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010307
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220010307,
					"content": "너… 이제 다신 너한테 맛있는 거 안 나눠줄 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010308
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220010308,
					"content": "그까짓 거 치사해서 안 먹고 만다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010309
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220010309,
					"content": "왜들 갑자기 싸우는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220010310,
					"content": "#{M#오빠}{F#언니}, 걱정 마요. 저한테 방법이 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010311
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220010311,
					"content": "둘 다 연꽃받침을 제일 좋아해요. 맛있는 게 있으면 분명 조용해질 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010312
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220010312,
					"content": "연꽃받침 좀 구해줄 수 있어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010313,
						220010315
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220010313,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010314
					]
				},
				{
					"id": 220010314,
					"content": "#고마워요, {M#오빠}{F#언니}. 빨리 다녀와야 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "룰루"
				},
				{
					"id": 220010315,
					"content": "쟤들이 제일 좋아하는 건 연꽃받침이 아닐 거야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010316
					]
				},
				{
					"id": 220010316,
					"content": "#음… {M#오빠}{F#언니}, 그게 무슨 말이에요? 그럼 뭘 제일 좋아한다는 거예요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010317
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220010317,
					"content": "아무튼 계속 저대로 둘 순 없으니, 빨리 연꽃받침부터 찾아주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "룰루"
				}
			]
		},
