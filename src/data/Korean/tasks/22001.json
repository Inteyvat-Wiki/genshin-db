					"nextDialogs": [
						220010610
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220010610,
					"content": "맞아요, 그래서 전 선장이 어디 있는지 알고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010611
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220010611,
					"content": "흥, 선장 따위, 뭐가 그렇게 대단하다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010612
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220010612,
					"content": "제가 선장이 있는 곳까지 데려다줄게요!",
