			},
			"dialogs": [
				{
					"id": 220010101,
					"content": "소몽, 오늘은 내가 선장 하는 거다?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010102
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220010102,
					"content": "룰루, 난 며칠 동안 계속 선장했으니까 이제 아비보고 하라고 하자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010103
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220010103,
					"content": "근데 난 소몽 네가 선장 연기를 잘하는 것 같은데, 그냥 네가 하면 안 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010104
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220010104,
					"content": "여기서 뭐 해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010105
					]
				},
				{
					"id": 220010105,
					"content": "#{M#형}{F#누나}! 우린 역할 놀이 하고 있어요. 원래 이번엔 제가 선장을 하기로 했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010106
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220010106,
					"content": "룰루는 계속 소몽이 선장하는 게 더 재밌대요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010107
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220010107,
					"content": "휴, 그래도 룰루가 좋다면 그냥 그렇게 하죠, 뭐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010108
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220010108,
					"content": "#{M#형이}{F#누나가} 다시 해적 해주면 안 돼요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010109,
						220010111
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220010109,
					"content": "그래…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010110
					]
				},
				{
					"id": 220010110,
					"content": "결국… 전 이번에도 종업원이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220010113,
					"content": "#저번처럼 {M#형이}{F#누나가} 준비되면 여기로 와줘요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아비"
				},
				{
					"id": 220010111,
					"content": "난 착한 해적이 되고 싶어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010112
					]
				},
				{
					"id": 220010112,
					"content": "하아, 전 선장이 하고 싶어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "아비"
				}
			]
		},
