			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"시게루",
					"쥰키치"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130101,
					"content": "독자들의 피드백을 보긴 한 거야? 평가가 곤두박질치고 있잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130102
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220130102,
					"content": "호들갑은, 클라이맥스 전의 숨 고르기일 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130103
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220130103,
					"content": "메인 스토리가 시작되면, 평판이 완전히 바뀔 거라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130104
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220130104,
					"content": "그 전에 소설이 망하게 생겼다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130105
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220130105,
					"content": "무슨 일 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130106
					]
				},
				{
					"id": 220130106,
					"content": "여행자, 드디어 왔구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130107
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220130107,
					"content": "지난번 소재를 찾고 나서, 쥰키치가 또 《귀무도》의 주인공에게 무리한 능력을 추가했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130108
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220130108,
					"content": "「야에 출판사」에 혹평이 쇄도했어. 독자들이 입을 모아 이 설정들에 개연성이 없다며, 작가가 너무 제멋대로래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130109
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220130109,
					"content": "뭘 모르는 소리! 내 페이스대로 써나간다면 독자들도 언젠가는 알게 될 거야ㅡ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130110
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220130110,
					"content": "그러니까, 독자들이 그걸 알기 전에 네 소설이 망하게 생겼다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130111
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220130111,
					"content": "그만해… 내 기억이 틀림없다면, 근처에 《귀무도》를 읽은 독자들이 있을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130112
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220130112,
					"content": "진짜 독자들이 네 구상을 좋아한다고 생각한다면, 독자들에게 직접 물어보고 와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130113
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220130113,
					"content": "누가 못할 줄 알고! 독자들은 분명 날 이해할 거야. 여행자, 나와 동행해서 증인이 돼 줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130114
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220130114,
					"content": "좋은 생각이야, 여행자가 동행하면, 너도 발뺌하지 못하겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130115
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220130115,
					"content": "맡겨만 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130116
					]
				},
				{
					"id": 220130116,
					"content": "좋아, 그럼 지금 당장 가자. 독자들은 분명 날 이해해줄 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130117
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220130117,
					"content": "도대체 설정을 얼마나 추가한 거예요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130118
					]
				},
				{
					"id": 220130118,
					"content": "조… 조금, 진짜 아주 조금 추가했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130119
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220130119,
					"content": "조금? 이대로 가다간 곧 주인공의 능력이 등장인물의 수보다도 더 많아지겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130120
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220130120,
					"content": "크… 크흠! 얼른 출발하자. 난 독자들이 날 이해해 줄 거라고 믿어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쥰키치"
				}
			]
		},
