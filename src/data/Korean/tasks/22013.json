			"dialogs": [
				{
					"id": 220130501,
					"content": "좋은 아침이야. 나랑 얘기 나누러 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130502
					],
					"speakerTitle": "리에"
				},
				{
					"id": 220130502,
					"content": "소설 《귀무도》를 본 적 있으세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130503
					]
				},
				{
					"id": 220130503,
					"content": "본 적 있지. 내가 거기 나오는 주인공을 엄청 좋아하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130504
					],
					"speakerTitle": "리에"
				},
				{
					"id": 220130504,
					"content": "근데 최근에는 소설을 읽는 게 좀 힘들다고 해야 하나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130505
