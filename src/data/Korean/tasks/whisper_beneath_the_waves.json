				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760200101,
					"content": "오늘도 허탕이군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200102,
						760200105,
						760200112,
						760200117
					],
					"speakerTitle": "일마리"
				},
				{
					"id": 760200102,
					"content": "여기서 뭐 하세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200103
					]
				},
				{
					"id": 760200103,
					"content": "낚시란다. 하지만 아직까지 물고기 아닌 것들만 낚았구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200104
					],
					"speakerTitle": "일마리"
				},
				{
					"id": 760200104,
					"content": "침몰선의 잡동사니 같은 거라면 여행 상인이 사 가기라도 하지. 부츠 반쪽이라니… 에휴, 됐다. 말을 많이 하면 물고기가 다 도망갈 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "일마리"
				},
				{
					"id": 760200105,
					"content": "주변에 볼만한 게 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200106
					]
				},
				{
					"id": 760200106,
					"content": "너도 보물 찾으러 왔니? 달의 동쪽, 태양의 서쪽에서만 찾을 수 있는 「위대한 보물」은… 당연히 여기에 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200107
					],
					"speakerTitle": "일마리"
				},
				{
					"id": 760200107,
					"content": "오, 그러고 보니 이곳에 배가 침몰했던 적이 꽤 있었지. 그러니 침몰선엔 값진 물건이 있겠지만 찾기 쉽진 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200108
					],
					"speakerTitle": "일마리"
				},
				{
					"id": 760200108,
					"content": "술집에서도 살아남은 선원들이 말하길, 달 없는 밤에 거센 파도 사이에서 빛나는 걸 봤다더군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200109
					],
					"speakerTitle": "일마리"
				},
				{
					"id": 760200109,
					"content": "그건 분명 외눈박이 크라티일 거라고 하더구나. 달도 삼켜버리는 괴물이 바닷속에서 거대한 뱀이랑 영역 다툼을 벌이고 있었대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200110
					],
					"speakerTitle": "일마리"
				},
				{
					"id": 760200110,
					"content": "그 후로 아주 오랫동안 이곳은 회계사의 잉크병처럼 새카매져서, 어떤 배도 감히 이곳을 지나갈 생각을 못 했지. 물속의 망령한테 붙잡힐까 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200111
					],
					"speakerTitle": "일마리"
				},
				{
					"id": 760200111,
					"content": "그 망령들이 지금도 근처를 배회하고 있다는데, 다 애들 겁주는 소리지. 난 이런 헛소리 안 믿는다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "일마리"
				},
				{
					"id": 760200112,
					"content": "이 나무에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200113
					]
				},
				{
					"id": 760200113,
					"content": "이건 진짜 좀 이상해. 여기엔 원래 소용돌이가 있었고, 선원들은 그걸 크라티의 눈이라고 불렀어. 근데 어느 날 갑자기 이 나무가 이렇게 자란 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200114
					],
					"speakerTitle": "일마리"
				},
				{
					"id": 760200114,
					"content": "근데 그때 일어난 이상한 일이 이거뿐만이 아니란다. 생각해 보면 이 모든 건 그 돌들이 하늘에서 떨어진 후란 말이지…. 어쩌면 이 나무도 돌처럼 하늘 밖에서 온 걸지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200115
					],
					"speakerTitle": "일마리"
				},
				{
					"id": 760200115,
					"content": "가끔 눈에 띄는 반짝이는 작은 것들도 아주 희귀하단다. 어쩌면 새로운 물고기가 있을지도 모르지. 그래서 운을 시험해 보러 온 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200116
					],
					"speakerTitle": "일마리"
				},
				{
					"id": 760200116,
					"content": "원래는 같이 오는 낚시 친구가 있었는데, 그 친구가 자꾸 이상한 노랫소리가 들린다면서 겁을 먹고는 다시는 안 와. 하, 반쪽짜리 서리달 아이인데도 나쁜 점은 다 물려받았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "일마리"
				},
				{
					"id": 760200117,
					"content": "실례했습니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200118
					]
				},
				{
					"id": 760200118,
					"content": "괜찮아. 지금은 물고기 그림자도 안 보이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "일마리"
				}
			]
		},
