				]
			},
			"dialogs": [
				{
					"id": 746720101,
					"content": "응? 샤를로트잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746720102,
					"content": "폴린에게 뭐라고 하고 있네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746720103,
					"content": "제발 부탁이에요, 샤를로트 씨, 아니, 샤를로트 님! 방금 하신 그 말, 농담이죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720104
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720104,
					"content": "「탱탱 물범으로 위장해 경비 장치를 속이고 범행에 성공」… 이거 실제로 있었던 사건이잖아요!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720105
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720105,
					"content": "「이미지 식별」 기술을 위해 모아둔 돈을 전부 투자한 걸로도 모자라, 은행에서 크게 대출까지 받았다고요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720106
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720106,
					"content": "무릎이라도 꿇고 빌게요, 네?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720107
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720107,
					"content": "일단 진정해요, 르핀 폴린 씨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720108
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720108,
					"content": "연구에 대한 열정과… 음… 큰 주문 건에 대한 갈망은 충분히 이해해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720109
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720109,
					"content": "하지만 그건… 단순 소설이에요. 익명의 작가가 무기명 서신으로 투고한, 단순 재미로 쓰인 픽션 소설이라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720110,
						746720111
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720110,
					"content": "사건이라고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720112
					]
				},
				{
					"id": 746720112,
					"content": "음… 나 알 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746720113,
					"content": "폴린이 전에 《스팀버드》에서 봤다던 기사가 설마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746720114,
					"content": "전에 편집자들이 회의하는 걸 직접 들었어요. 편집자들도 그 소설 때문에 대중들의 오해를 사는 건 아닐까 걱정하며 법률 집행청에 자문까지 구했죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720115
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720115,
					"content": "그런데 의외로 법률 집행청은 그 소설을 높이 평가했어요. 잠재적 범죄자들에게 잘못된 정보를 제공해서 그들이 눈에 띄는 인형 옷을 입고 돌아다니게 할 수 있다면서요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720116
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720116,
					"content": "경비 장치의 식별 능력은 경험 많은 경비대원에게 뒤지지 않을 정도로 매우 뛰어나요. 그래서 그런 수법은 장치를 속이기는커녕 오히려 더 눈에 띄는 꼴이 되는 거예요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720117
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720117,
					"content": "그 소설을 게재한 뒤로, 법률 집행청은 다수의… 「탱탱 물범 괴도」, 「거대 붉은 왕관새」, 「떠도는 정령 도둑」을 체포했죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720118
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720118,
					"content": "그 소설이 치안에 도움이 된 건 사실이지만, 당신 같은 연구원이 거액을 낭비하게 만들었을 줄은 몰랐네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720119
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720119,
					"content": "으… 으아아아아아아아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720120
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720120,
					"content": "윽… 폴린의 연구가 허구의 이야기를 토대로 한 거였다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746720121,
					"content": "부자 되긴 글렀네…. 아니지, 그보다 폴린의 투자금은 그냥 이대로 날아가는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746720122,
					"content": "#{NICKNAME}, 페이몬. 왔구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720123
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720123,
					"content": "소재 때문에 근처에서 사진을 찍고 있었는데, 우연히 르핀 폴린 씨를 만나서 연구와 너희 얘길 듣게 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720124
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720124,
					"content": "원고료와 샘플을 억지로 쥐여주시면서 「이미지 식별 기술」의 홍보 글을 써달라고 하시더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720125
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720125,
					"content": "유감이지만 르핀 폴린 씨의 기대도, 너희 노력도 물거품이 된 것 같네…. 너희들에게 보수도 줘야 한다며? …위로하긴 했는데, 당장은 받아들이기 힘든 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720126
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720126,
					"content": "솔직히 이런 상황은 우리도 처음이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746720127,
					"content": "그 소설의 작가는 단순히 인기 있을 법한 이야기를 쓰고 싶었던 것 같네…. 법률 집행청의 방법은 확실히 폰타인 치안에 도움이 됐고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720128,
						746720129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746720128,
					"content": "잘못한 사람은 아무도 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720130
					]
				},
				{
					"id": 746720130,
					"content": "잠깐만요, 르핀 폴린 씨. 뭐 하시는 거예요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720131
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720131,
					"content": "경비 장치와 한 판 붙으려고요. 에피클레스 오페라 하우스를 거쳐서 메로피드 요새의 주민이 될 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720132
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720132,
					"content": "그럼 돈을 안 갚아도 되겠죠. 맞아요, 제 살 길은 이것밖에 없어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720133
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720133,
					"content": "그러지 마세요! 당신이 한 판 붙는다 해도 경비 장치의 갑옷조차 못 부술 거라구요. 기껏 해봤자 며칠 구류 당했다가 풀려나겠죠. 그럼 결국 돈은 갚아야 해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720134
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720134,
					"content": "아니, 대체 이 기술에 얼마를 투자했길래 이러는 거죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720135
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720135,
					"content": "2… 27만 모라를 투자했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720136
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720136,
					"content": "메로피드 요새로 도망칠 정도의 액수는 아니지 않나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720137
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720137,
					"content": "폰타인 과학원 외주 기자재 공급업체의 엔지니어였던 소시민으로서 몇 년에 걸쳐 영혼까지 끌어모은 돈이라고요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720138
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720138,
					"content": "게다가 제가 잃은 건 제 전재산뿐만이 아니에요. 「이미지 식별」로 이룩한 제 장밋빛 미래와 억만장자의 꿈까지 사라졌죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720139
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720139,
					"content": "하… 하하… 하아… 흑흑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720140
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720140,
					"content": "내 인생은 끝났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720141
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720141,
					"content": "흠흠, 그렇게 낙담할 필요 없어요. 르핀 폴린 씨, 제안 하나 할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720142
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720142,
					"content": "보니까 당신이 준 「이미지 식별 샘플 수집용 사진기 렌즈」는 이미지를 더욱 정확하게 수집하고 분석하기 위해 특별한 디자인으로 설계되었더라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720143
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720143,
					"content": "이런 빠른 줌 렌즈가 있으면 기자들이 한결 편해질 거예요. 더 나아가 폰타인 저널리즘 업계의 발전에도 큰 기여를 할 수도 있구요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720144
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720144,
					"content": "그러니까 지금까지의 연구는 헛수고가 아니에요. 당신이 생각지 못한 분야에서 큰 가치를 발휘할 수도 있으니까요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720145
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720145,
					"content": "정, 정말이에요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720146
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720146,
					"content": "그럼요! 제가 이래 봬도 《스팀버드》에서 꽤 오래 일했거든요. 동료들이 일하면서 겪는 고충은 누구보다 잘 알죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720147
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720147,
					"content": "우선 진정하시고 기운 차리고 나면 렌즈를 양산하는 것에 대해 고민해 봐요. 전 동료들에게 렌즈를 홍보할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720148
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720148,
					"content": "제게 이런 행운이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720149
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720149,
					"content": "그렇게만 되면… 전 「촬영 장비」의 발전에 기여할 수 있겠네요? 큰 주문 건을 받고 억만장자가 될 수도 있고요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720150
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720150,
					"content": "그럼… 돈을 더 빌려볼까요? 렌즈를 좀 더 개선한 다음 촬영 장비 시장을 선점해서 다가올 경쟁에 대비해야죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720151
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720151,
					"content": "아직도 포기 안 한 거야? 한 번에 전 재산을 투자해서 떼돈 벌 생각 말고 차근차근 벌어야지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720152,
						746720153
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746720152,
					"content": "야망이 클수록 실망하기 쉬워요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720154
					]
				},
				{
					"id": 746720154,
					"content": "음… 지인에게 부탁해서 이미지 식별 장비를 필요로 하는 공방에 팔면 모라를 더 끌어올 수 있을 거야… 진작 이렇게 할걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720155
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720155,
					"content": "한시가 급하니 늦기 전에 얼른 시작해야겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720156
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 746720156,
					"content": "엥, 그냥 가버렸어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720157
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746720157,
					"content": "우리 충고는 씨알도 안 먹힌 것 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720158
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746720158,
					"content": "음… 이해해. 영감과 열정이 솟구칠 때면 다른 사람의 충고를 무시한 채 업무에만 몰두하지… 신입 기자들도 자주 그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720159
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720159,
					"content": "그래도 걱정 마. 이번 사건은 기사로 보도할 거니까. 그리고 앞으로 르핀 폴린 씨도 종종 찾아가려고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720160
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720160,
					"content": "그분의 연구는 우리 기자들에게 큰 도움이 되는 만큼, 나도 그분이 잘못된 길로 빠지지 않고 빠른 시일 안에 렌즈를 양산할 수 있게 옆에서 조언해 줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720161
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720161,
					"content": "네가 그렇게 말하니까 마음이 좀 놓이네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720162,
						746720163
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746720162,
					"content": "역시 샤를로트야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720164
					]
				},
				{
					"id": 746720164,
					"content": "그러고 보니, 두 사람은 세계 각지를 여행하니까 이 샘플 렌즈는 너희에게 줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720165
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720165,
					"content": "신기한 도구는 능력자의 손에서 힘을 발휘하는 법이니까. 너희가 사용하면 분명 멋진 경치를 잔뜩 기록할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720166
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720166,
					"content": "고마워, 샤를로트!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720167
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746720167,
					"content": "모라는 못 벌었지만 괜찮아. 적어도 헛걸음을 한 건 아니니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720168
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746720168,
					"content": "천만에, 덕분에 나도 특별한 기삿거리를 찾았잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720169
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720169,
					"content": "「특별한 수요가 있다고 해도, 신문 보도와 픽션 문학 작품의 경계는 명확할수록 좋다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720170
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720170,
					"content": "앞으로 르핀 폴린 씨처럼… 좋은 의도로 시작한 일이 나쁜 결말을 맞이하지 않게 편집자들한테도 잘 얘기할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 746720163,
					"content": "역시 에이스 기자야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720164
					]
				},
				{
					"id": 746720153,
					"content": "한 걸음씩 나아가는 게 좋아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720154
					]
				},
				{
					"id": 746720129,
					"content": "폴린 씨만 피해를 입었네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720130
					]
				},
				{
					"id": 746720111,
					"content": "소설이라니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720112
					]
				}
			]
		},
		{
