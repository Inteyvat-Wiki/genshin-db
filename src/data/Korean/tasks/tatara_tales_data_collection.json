			"dialogs": [
				{
					"id": 721170301,
					"content": "어떤가? 비콘을 다 회수했나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170302
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721170302,
					"content": "모아왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170303
					]
				},
				{
					"id": 721170303,
					"content": "잘됐군. 잠시 후에 이 데이터에 근거해서 이 장치를 개조해 볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170304
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721170304,
					"content": "그런데 최근 들어 우인단의 활동이 괴이해지면서, 코어 지역에 집중되고 있는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170305
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721170305,
					"content": "이놈들이 혹시 또 무슨 꿍꿍이를 꾸미고 있는 게 아니었으면 좋겠군… 적어도 우리가 수습할 수 없는 일은 하지 않았으면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자비에"
