				"points": []
			},
			"dialogs": [
				{
					"id": 230130201,
					"content": "루통, 우리가 가지고 있는 돈으로는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130202
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130202,
					"content": "어떻게든 살 수 있을 거예요, 가르시아 선생님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130203
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130203,
					"content": "우리 리월에는 「산에 도착하면 길이 보이기 마련이다」라는 말이 있죠. 지금 우리 처지에 딱 맞는 말이라고 생각해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130204
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130204,
					"content": "큰 산이 앞을 막고 있어도 에둘러 가는 방법을 찾을 수 있다는 뜻이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130205
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130205,
					"content": "아하, 아주 교묘한 비유로군. 우리의 처지도 최악까지는 아닌 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130206
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130206,
					"content": "가르시아 선생님, 이 말을 처음 했던 사람이 산을 건널 방법을 찾았을 거라고 생각하세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130207
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130207,
					"content": "응? 아, 젠장…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "가르시아"
				}
			]
		},
