					"가르시아"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130301,
					"content": "슬라임 응축액은 구해왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130302
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130302,
					"content": "가져왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130303
					]
				},
				{
					"id": 230130303,
					"content": "훌륭해! 이 정도면 충분하겠어. 가서 바로 테스트를 시작해야겠군. 윤활제도 있으니 내 「숫자 기계」는 분명…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130304
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130304,
					"content": "제대로 연구해 봐야겠어. 루통, 나머지는 자네한테 맡기지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130305
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130305,
					"content": "네, 선생님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130306
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130306,
					"content": "여기 여행자님의 보수입니다. 정말 고맙습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130307
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130307,
					"content": "음… 제 소견으로는 앞으로도 여행자님의 도움이 필요할 것 같군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130308
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130308,
					"content": "걱정 마세요. 제가 돈을 관리하는 한, 합리적인 보수를 받으실 수 있을 거라고 약속드리죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130309
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130309,
					"content": "휴, 제가 가르시아 선생님과 함께 여행을 시작하게 된 건, 부모님처럼 평생 리월 총무부에서 장부만 보고 싶지 않아서였어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130310
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130310,
					"content": "그런데 지금은… 가르시아 선생님 대신 계산도 해야 하고 장부도 정리해야 하죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130311
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130311,
					"content": "이게 아마 「운명」이라는 거겠지만요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "루통"
				}
			]
		},
