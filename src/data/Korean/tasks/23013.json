			},
			"dialogs": [
				{
					"id": 230130101,
					"content": "루통… 여, 여기가 확실한 거니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130102
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130102,
					"content": "네, 가르시아 선생님. 여기가 슬라임들이 가장 자주 출몰하는 곳입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130103
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130103,
					"content": "그건 알겠다만, 문제는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130104
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130104,
					"content": "슬라임이 너무 많잖아!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130105
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130105,
					"content": "이건 재정 부족으로 인한 결과입니다. 가르시아 선생님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130106,
						230130107
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130106,
					"content": "당신은… 가르시아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				},
				{
					"id": 230130108,
					"content": "여행자잖아! 이런 우연이, 자네도 수메르로 온 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130109
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130109,
					"content": "여긴 어쩐 일이세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130110
					]
				},
				{
					"id": 230130110,
					"content": "하하하, 그게 말이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130111
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130111,
					"content": "사서 고생하는 중이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130112
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130112,
					"content": "용감한 모험 중이지. 고맙지만 루통, 제발 좀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130113
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130113,
					"content": "선생님 뜻대로 말한 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130114
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130114,
					"content": "본론부터 말하지. 내가 여기 온 건 「숫자 기계」 제작에 필요한 「슬라임 응축액」을 구하기 위해서라네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130115
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130115,
					"content": "시중에서 파는 「슬라임 응축액」은 너무 오래 방치한 것이라 품질이 떨어지지. 또…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130116
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130116,
					"content": "가르시아 선생님이 최근 책을 엄청 사들이셨거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130117
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130117,
					"content": "…불가피한 지출이 있었거든. 어쩔 수 없었어! 결국 돈이 부족한 상태가 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130118
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130118,
					"content": "그래서 여기 온 거야. 신선한 슬라임 응축액을 얻기 위해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130119
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130119,
					"content": "하지만 보다시피 우리 친애하는 루통은 리월 출신이면서 무공은커녕, 요리도 전혀 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130120
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130120,
					"content": "다행히 장부 정리 재능은 있죠… 총무부의 복잡한 세무 규칙에 고마워해야 할 정도예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130121
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130121,
					"content": "…나도 「숫자 기계」 부품으로 사람을 때릴 순 없고 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130122
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130122,
					"content": "제 도움이 필요하신 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130123
					]
				},
				{
					"id": 230130123,
					"content": "어떻게 보면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130124
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130124,
					"content": "맞아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130125
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130125,
					"content": "루통, 우리… 돈이 얼마나 남았지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130126
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130126,
					"content": "여행자님께 드릴 보수를 제외하고서도 어떻게든 살아갈 순 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130127
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230130127,
					"content": "그럼 좋아! 부탁하네, 여행자… 날 도와 슬라임 응축액을 구해다 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230130107,
					"content": "왜 여기에 계신 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				}
			]
		},
