					"소천"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570101,
					"content": "「영롱한 소등도」에 온 걸 환영해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570102
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413570102,
					"content": "영롱… 뭐라구요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570103
					]
				},
				{
					"id": 413570103,
					"content": "「영롱한 소등도」. 어때, 한번 해볼래? 아주 간단해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570104
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413570104,
					"content": "뒤에 이 병풍들 보여? 앞에 있는 이 등 3개도",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570105
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413570105,
					"content": "이 등은 특별히 주문 제작한 거야. 불을 켜면 여러 가지 모양이 비치지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570106
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413570106,
					"content": "이 등 세 개를 정확한 방법으로 돌리면 세 도안을 합쳐서 하나의 완전한 그림으로 만들 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570107
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413570107,
					"content": "아… 말로 해선 잘 이해가 안 될 거야. 일단 등을 하나만 돌려봐. 기본적인 걸 익히고 나면 자세한 플레이 방법을 설명해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소천"
				}
			]
		},
		{
			"id": 4135702,
			"completionStepIds": [
				4135704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4135703",
							"3"
						],
						"stepId": 4135703,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4135704",
							"2"
						],
						"stepId": 4135704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"소천"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570201,
					"content": "오, 습득력이 빠르군. 기본적인 원리를 알았으니 이제 제대로 시작해도 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570202
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413570202,
					"content": "많이 어렵나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570203
					]
				},
				{
					"id": 413570203,
					"content": "안 어려워. 방금 돌리는 방법을 익혔잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570204
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413570204,
					"content": "시작하면 이 등 3개를 돌려서 병풍에 비친 도안을 정확히 하나로 맞추기만 하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570212
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413570212,
					"content": "조합해야 할 도안은 미리 알려줄 거지만, 등 세 개를 어떻게 돌릴지는… 네가 잘 고민해봐야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570205
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413570205,
					"content": "다 맞추면요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570206
					]
				},
				{
					"id": 413570206,
					"content": "음, 눈치챘는지 모르겠지만 뒤에 있는 이 병풍엔 전부 리월의 「지도」가 그려져 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570207
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413570207,
					"content": "그림을 정확히 맞춘 뒤 지도에 비추면, 우리 모험가 길드가 특별히 준비한 「보물」을 발견할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570208
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413570208,
					"content": "그 보물들을 배치하려고 길드에서 사람을 얼마나 많이 불렀는지 몰라. 엄청 오래 걸렸다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570213
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413570213,
					"content": "보물상자는… 내 맞은편에 있는 것들처럼 장소만 알아내면 쉽게 찾을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570209
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413570209,
					"content": "도안을 조정해놨어. 오늘의 도안은 <color=#00E1FFFF>「유리백합」</color>이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570210
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413570210,
					"content": "참, 그리고 등의 도안은 날이 어두울 때 가장 잘 보이니까 밤에 오는 게 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570211
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413570211,
					"content": "길드에서 사람을 불러 특별 제작한 거라구. 이렇게 예쁜 등을 자세히 안 보면 너무 아깝잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소천"
				}
			]
		},
