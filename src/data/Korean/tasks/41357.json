			"dialogs": [
				{
					"id": 413570301,
					"content": "어때? 보물 찾기는 잘 돼가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570302
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413570302,
					"content": "모든 보물을 다 찾았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570303
					]
				},
				{
					"id": 413570303,
					"content": "전부 다? 너 보물 꽤 잘 찾는데? 보통 등도 잘 못 돌리거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570304
					],
					"speakerTitle": "소천"
				},
				{
					"id": 413570304,
					"content": "보물을 전부 찾았으니… 이 보상을 줄게. 해등절 재밌게 보내길 바라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소천"
				}
			]
		},
