			"dialogs": [
				{
					"id": 708140501,
					"content": "엥? 벌써 돌아온 거야? 의뢰는 완료했고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140502
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 708140502,
					"content": "완료했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140503
					]
				},
				{
					"id": 708140503,
					"content": "너 진짜 대단하구나…. 의뢰 기준에 맞춰 모험가 길드에 돌아가서 의뢰를 정리했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140504
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 708140504,
					"content": "마물 처치 같은 의뢰가 엄청 많더라구. 모험가들은 평소에 그런 일을 하나봐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140505
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 708140505,
					"content": "근데 마물 처치 외에 여러 보물 사냥단이 길거리를 점거하고 있다는 보고도 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140506
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 708140506,
					"content": "모험가가 이런 일도 처리하니? 이건 천암군이 해야 할 일 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140507,
						708140509
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 708140507,
					"content": "처리할 수 있죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140508
					]
				},
				{
					"id": 708140508,
					"content": "그렇구나. 모험가는 못하는 게 없구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 708140511,
					"content": "그럼 충분한 보수를 준비할 테니 이 의뢰를 받아줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140512
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 708140512,
					"content": "이렇게 갑작스럽게 의뢰를 추가하면 어떡해! 전에 아무 얘기 없었잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140513
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 708140513,
					"content": "보수를 더 두둑이 챙겨줄게! 란 언니와 이야기 끝냈어. 너희가 의뢰를 완료하면 더 많은 보수를 지급할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140514
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 708140514,
					"content": "그럼 의뢰를 받을게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140515
					]
				},
				{
					"id": 708140515,
					"content": "그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140516
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 708140516,
					"content": "이렇게 한 번에 두 가지 의뢰를 넘겼네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140517
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 708140517,
					"content": "란 언니가 말한 「모험가에게 의뢰를 넘기는 비결」은 잘 먹히는구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "첨아"
				},
				{
					"id": 708140509,
					"content": "보수만 짭짤하다면요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140510
					]
				},
				{
					"id": 708140510,
					"content": "모험가는 진짜 대단하구나…. 못하는 게 없네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "첨아"
				}
			]
