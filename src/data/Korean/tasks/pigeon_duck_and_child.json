			},
			"dialogs": [
				{
					"id": 200480101,
					"content": "와앗! 또 너야! 비둘기가 또 다 날아가 버렸어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480102
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200480102,
					"content": "먹이 주고 있는 거 안 보여? 뭐 하는 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480103
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200480103,
					"content": "미안해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480104
					]
				},
				{
					"id": 200480104,
					"content": "미안하면 행동으로 보이라고 엄마가 그랬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480105
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200480105,
					"content": "다리 위에 있는 비둘기는 내 친구야, 내가 밥을 챙겨주고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480106
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200480106,
					"content": "하지만 요즘 근처 비둘기들이 음식을 뺏어 먹어, 그러면 아무도 배불리 먹을 수가 없을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480107
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200480107,
					"content": "그래서 밀 3개를 찾아야 하는데 좀 도와줘. 다리 위의 비둘기들이 배부르게 먹었으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480108
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200480108,
					"content": "배불리 먹고 나면 비둘기들이 사이 좋게 지낼 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480109,
						200480110
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200480109,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480111
					]
				},
				{
					"id": 200480111,
					"content": "그럼 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480112
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200480112,
					"content": "동물에게 잘 대해주면 그들과 친구가 될 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "티미"
				},
				{
					"id": 200480110,
					"content": "난 비둘기랑 별로 친구 하고 싶지 않아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480113
					]
				},
				{
					"id": 200480113,
					"content": "친구 하고 싶든 말든… 어쨌든 비둘기들한테 사과해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480114
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200480114,
					"content": "그러니——빨리 밀 좀 찾아줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "티미"
				}
			]
		},
