				},
				{
					"id": 200480303,
					"content": "알겠어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480304
					]
				},
				{
					"id": 200480304,
					"content": "됐어, 용서해줄게. 이건 내 최애 몬드 감자전인데 너 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480305
					],
					"speakerTitle": "티미"
				},
				{
					"id": 200480305,
					"content": "선의를 갖고 만물을 대하라구…. 우리 엄마가 그랬어",
					"roleType": "TALK_ROLE_NPC",
