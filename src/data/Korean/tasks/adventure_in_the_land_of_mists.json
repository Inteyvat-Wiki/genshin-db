						751330302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751330302,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330303
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330303,
					"content": "#역시 {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330304
					]
				},
				{
					"id": 751330304,
					"content": "그래도 자만하면 안 돼. 더 큰 도전이 우릴 기다리고 있다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751330305,
					"content": "그럼 입구도 열렸겠다, 확인하러 내려가 볼까나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751330306,
					"content": "좋은 생각이야, 페이몬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330307
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751330307,
					"content": "끼이… 끼이이!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330308
					],
					"speakerTitle": "「터키석」"
				},
				{
					"id": 751330308,
					"content": "엥? 초록아, 왜 그래? 혹시 무서운 거야? 여기서 물러설 수는 없어. 모험은 아직 반밖에 진행되지 않았다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330309
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751330309,
					"content": "끼이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330310
					],
					"speakerTitle": "「터키석」"
				},
				{
					"id": 751330310,
					"content": "파우나, 너무 그렇게 다그치지 마. 초록이가 그렇게 무서워하는 걸 보면, 혹시… 밑에 뭔가 위험한 게 있는 것 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751330311,
					"content": "으악! 무서워라!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330312
					]
				},
				{
					"id": 751330312,
					"content": "#야, 너까지 그러면 어떡해? {REALNAME[ID(2)|SHOWHOST(true)]}(이)처럼 정신 바짝 차리라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751330313,
					"content": "벌써 두근두근해지는데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330314
					]
				},
				{
					"id": 751330314,
					"content": "오오, 의욕이 넘치네. 하긴 밑에서 뭐가 기다리고 있든 네 상대가 될 것 같지는 않지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751330315,
					"content": "걱정 마, 우리에겐 용감한 꼬마 용이 있으니까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330316
					]
				},
				{
					"id": 751330316,
					"content": "꺄… 꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330317,
					"content": "으——음… 그렇게 무서우면 초록이는 일단 여기 있을래? 하지만 얘 혼자 둘 수 없는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751330318,
					"content": "응, 어쩔 수 없네. 나도 초록이랑 같이 위에 남아 있을게. 대신 응원하는 의미에서 화린석을 줄 테니 가져가도록 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330319
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751330319,
					"content": "미리 말해두겠는데, 밑에서 무엇을 발견하든 여기로 돌아와서 알려줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330320
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751330320,
					"content": "저희는 동료를 버리지 않아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330321
					]
				},
				{
					"id": 751330321,
					"content": "진짜지…? 알겠어, 그럼 너희를 믿고 여기서 기다리고 있을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330322
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751330322,
					"content": "안심하고 여기서 기다리세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330323
					]
				},
				{
					"id": 751330323,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
