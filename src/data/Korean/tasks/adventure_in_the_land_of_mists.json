							-137.177,
							452.96,
							10019.38
						],
						"pointId": 8646
					}
				]
			},
			"dialogs": [
				{
					"id": 751330101,
					"content": "초록이가 우리를 이리로 데려올 줄은 몰랐네. 아무래도 파우나랑 만났던 곳이랑 비슷한… 좀 이상한 탑인 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751330102,
					"content": "봐, 여기에도 똑같은 벽화가 있어. 음… 근데 여기는 덧칠한 흔적이 없네. 너무 높은 곳에 있어서 그런가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751330103,
					"content": "#{NICKNAME}, 여기 그려져 있는 게 방금 파우나가 말한 그 뱀왕 아닐까? 딱 봐도 만만한 녀석은 아닌 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751330104,
					"content": "응, 이 녀석이 바로 뱀왕 오치칸이야. 전설에 따르면 그는 하늘뱀선을 만들기 위해 사람들을 잔혹하게 착취했대. 그러다 결국 심연을 불러오는 바람에 자기는 죽고, 나라는 멸망을 맞이했다고 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330105
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751330105,
					"content": "물론 이것도 전설일 뿐이야. 뱀왕이 어떤 최후를 맞이했는지는 부족의 이야기꾼들 사이에서 견해가 갈리거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330106
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751330106,
					"content": "어쩌면 아직도 그 하늘뱀선 위에서 보물을 먹으며 살고 있을지도 모르지. 아니면 줄곧 우리를 방해하는 못된 용이 실은 원귀로 변한 그 녀석일 수도 있고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330107
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751330107,
					"content": "끼꾸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330108
					],
					"speakerTitle": "「터키석」"
				},
				{
					"id": 751330108,
					"content": "으, 소름 돋아. 그런 무서운 말은 하지 마! 초록이가 놀랐잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751330109,
					"content": "꺄! 꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330110,
					"content": "#그 악룡을 물리친 이후로 {REALNAME[ID(2)|SHOWHOST(true)]}이(가) 계속 안달복달하는 것 같던데. 혹시 초록이랑 몰래 경쟁이라도 한 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751330111,
					"content": "그나저나 우리가 찾아야 하는 그 제단은 대체 어디에 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751330112,
					"content": "초록이가 올바른 방향을 가리키고 있는 거라면 아마 이 아래쪽에 있을 거야. 어라? 그러고 보니, 더 높은 곳에 있을 줄 알았는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330113
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751330113,
					"content": "설마 실수한 건가? 근원의 불 제단이 산 중심에 숨겨져 있을 리가 없는데. 그럼 바람이 산 전체를 날려버려야 우리를 하늘로 올려보낼 수 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330114
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751330114,
					"content": "뭔가 특수한 워프 장치라도 있는 거 아닐까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330115
					]
				},
				{
					"id": 751330115,
					"content": "으으, 아까 아래쪽에서 큰소리 뻥뻥 치더니… 곤란하게 됐네. 초록이가 뭐라 하는지도 전혀 못 알아듣겠고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751330116,
					"content": "꾸륵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330117
					],
					"speakerTitle": "「터키석」"
				},
				{
					"id": 751330117,
					"content": "꺄! 꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330118,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, 뭔가 해결책이 떠오른 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751330119,
					"content": "알겠다! 페이몬, 얘는 지금 틀에 박힌 논리에만 의존하면 모험을 이어 나갈 수 없다는 말을 하려는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330120
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751330120,
					"content": "그거 또 적당히 지어낸 말이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751330121,
					"content": "아무튼 밑에 뭐가 있든지 싹 다 조사해 보는 게 좋을 것 같아. 그것도 모험의 과정 아니겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330122
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751330122,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330123,
					"content": "#으으… {REALNAME[ID(2)|SHOWHOST(true)]} 얘 엄청 의욕이 넘치네. 그럼 일단 내려가는 방법을 찾아보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
