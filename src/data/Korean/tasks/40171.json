			"dialogs": [
				{
					"id": 401710201,
					"content": "어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710202
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401710202,
					"content": "왜 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401710203,
					"content": "할머니가… 사라졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710204
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401710204,
					"content": "원래 저 동굴 입구에 서서 내가 들어가는 걸 막고 있었거든. 그렇게 내 앞길이 막혀 버렸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710205
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401710205,
					"content": "진짜 말 그대로 길을 막고 있었던 거야?! 길을 막는 호랑이가 비유가 아니었네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401710206,
					"content": "할머니는 한 단락에 비유를 두 번 쓰는 라이트 노벨은 이류라고 했어. 난 이류가 되고 싶지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710207
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401710207,
					"content": "하지만 너도 방금 자신을 라이트 노벨에 비유했잖아. 그럼 두 번 한 거 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401710208,
					"content": "뭐? 큰일 났다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710209
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401710209,
					"content": "어쨌든, 이젠 자유롭게 통행할 수 있겠네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710210
					]
				},
				{
					"id": 401710210,
					"content": "그러게, 시틀라리가 마음이 바뀌었나 봐. 올로룬, 이제 마음껏 하고 싶은 일을 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401710211,
					"content": "그렇게 간단하진 않을 거 같아…. 할머니는 이렇게 쉽게 날 놓아줄 사람이 아냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710212
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401710212,
					"content": "내가 저 동굴 안으로 들어가면 할머니의 감시 술법에 걸리거나, 할머니가 남겨둔 함정을 밟을지도 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710213
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401710213,
					"content": "근데 시틀라리가 왜 널 잡는 건데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710214
					]
				},
				{
					"id": 401710214,
					"content": "맞아, 심지어 함정까지 설치했다고? 너 또 전처럼… 수상한 짓이라도 한 거 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401710215,
					"content": "난 사람을 구하려는 것뿐인데… 할머니가 막았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710216
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401710216,
					"content": "사, 사람을? 무슨 일이 생긴 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401710217,
					"content": "먼저 가서 동굴 안을 확인해 줄래? 지금은 무사하겠지만, 시간을 오래 끌면 위험해질지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710218
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401710218,
					"content": "그럼 넌 어떡하고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401710219,
					"content": "할머니의 함정에 걸릴 수도 있으니까 난 입구에서 기다리고 있을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710220
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401710220,
					"content": "근데 진짜 함정이 있으면 우리가 걸리게 되는 거잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401710221,
					"content": "#괜찮아. 할머니의 함정은 {NICKNAME}을(를) 알아보니까 너희를 어쩌진 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710222
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401710222,
					"content": "그런 게 가능하다고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710223
					]
				},
				{
					"id": 401710223,
					"content": "응, 내가 우리 집 꿀벌레한테 네 업적을 얘기하듯, 할머니도 함정한테 네 이야길 해줬을걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710224
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401710224,
					"content": "모두를 너처럼 생각하지 말라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710225
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401710225,
					"content": "#아무튼 꼭 좀 부탁할게, {M#할아버지}{F#할머니}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710226
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401710226,
					"content": "#{NICKNAME}, 사람 목숨이 달린 일이라니까 일단 가서 확인해 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
