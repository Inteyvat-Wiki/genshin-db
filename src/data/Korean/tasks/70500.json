			"dialogs": [
				{
					"id": 705000501,
					"content": "이건… 무슨 고기지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000502
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 705000502,
					"content": "냉동 생고기",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000503
					]
				},
				{
					"id": 705000503,
					"content": "냉동 생고기라… 이름은 익숙하군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000504
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 705000504,
					"content": "음… 상태가 괜찮아 보이는구나. 하지만 해동을 잘 시켜야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000505
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 705000505,
					"content": "다행히도 내가 설계한 「기관요리 신기」에 해동 기능이 있다네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000506,
						705000512
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 705000506,
					"content": "이 기구에 없는 기능이 없는 거 같네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000507
					]
				},
				{
					"id": 705000507,
					"content": "그게 무슨 소리인가? 아직 부족한 부분이 있다네, 예를 들면 자동으로 식자재 구해오기, 자동으로 불 조절하기… 등등",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000508
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 705000508,
					"content": "이 기구는 아직 개선할 점이 많다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 705000509,
					"content": "쓸데없는 소리는 그만하고. 식자재를 다 모았으니 기구를 가동하겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000510
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 705000510,
					"content": "불 조절은 자네에게 맡기지, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000511
					],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 705000511,
					"content": "준비가 다 되면 날 찾아오게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "류운차풍진군"
				},
				{
					"id": 705000512,
					"content": "선인은 정말 대단하군요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705000513
					]
				},
				{
					"id": 705000513,
					"content": "선력을 높이 평가하는 것보다 나의 「기관요리 신기」를 더 높이 평가해 줬으면 좋겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705000509
					],
					"speakerTitle": "류운차풍진군"
				}
			]
		},
