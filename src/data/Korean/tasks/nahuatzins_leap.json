			},
			"dialogs": [
				{
					"id": 751480101,
					"content": "용에게 선택받은 자여… 아, 용에게 선택받은 자여…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751480102,
					"content": "왕관의 정상에 올라, 신성한 산의 불길 속으로 뛰어들어라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751480103,
					"content": "가서 금빛 인장을 풀고 억만 개 잿불의 불꽃을 밝혀라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751480104,
					"content": "우우웅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480105,
					"content": "왜 그래? 혹시 또 뭔가 이상한 걸 본 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480106,
						751480107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751480106,
					"content": "뭔가… 갈수록 선명해지는 것 같아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				},
				{
					"id": 751480108,
					"content": "흐음, 화산 가까이로 온 거랑 연관이 있으려나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751480109,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480110,
					"content": "…아무래도 계속 너희에게 말을 걸던 사람은 화산 안에 있는 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751480111,
					"content": "화산에 가까워지니까 또 나타나는 걸 보면, 우리가 제대로 찾아왔나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751480112,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480107,
					"content": "뭔가… 거리가 더 가까워진 것 같아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				}
			]
		},
