			"dialogs": [
				{
					"id": 101100101,
					"content": "#{NICKNAME}, 저기 좀 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100102,
					"content": "노, 노라 혼자 있는 거 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100103,
					"content": "근데 누구랑 대화 중인거야?! 봐, 웃었어! 헐, 무서워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100104,
					"content": "나도 어렸을 때 「상상 속 친구」와 놀곤 했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100105
					]
				},
				{
					"id": 101100105,
					"content": "#엥? {NICKNAME}, 너도 저랬다고?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100106,
					"content": "환각이 보이는 거야? 아니면 진짜로 상상 속 친구가 놀아주는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100107,
						101100109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100107,
					"content": "환각에 상상 속 친구가 보이는 거지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100108
					]
				},
				{
					"id": 101100108,
					"content": "상상 속 친구라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100111,
					"content": "아, 그게… 「상상으로 만들어낸 친구」구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100112,
					"content": "네 「상상 속 친구」는 어떻게 생겼어? 보여줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100113,
						101100114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100113,
					"content": "요새는 잘 안 나타나…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100115,
					"content": "엥? 설마 「상상 속 친구」는 어른이 되면 없어지는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100116,
						101100117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100116,
					"content": "응",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100118,
					"content": "#아… 한번 보고 싶었는데…. 참, 네 {F#오빠}{M#여동생}도 그런 친구 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100119,
					"content": "있지~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100120
					]
				},
				{
					"id": 101100120,
					"content": "그렇구나! 하긴 엄청 편하긴 하겠다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100121,
					"content": "리월에서 온 카드 게임 알아? 원래 네 명이 하는 건데 너희는 둘이서도 할 수 있겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100122,
					"content": "여행자! 너희도 여기 있었구나. 이런 우연이!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100123
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101100123,
					"content": "각설이, 또 너야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100124,
					"content": "하하, 리사가 최근에 재미있는 걸 만들었대서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100125
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101100125,
					"content": "리사가 「재미있다」고 한 거라니, 무서워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100126,
					"content": "훗, 숙녀를 그렇게 말하면 안 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100127
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101100127,
					"content": "이 재미있는 걸 만들려고 리사는 수메르까지 가서 위험한 재료를 구해왔다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100128
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101100128,
					"content": "방금 「위험」이라고 했지?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100129,
						101100131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100129,
					"content": "이거 안경 모양 탐지기야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100130
					]
				},
				{
					"id": 101100130,
					"content": "맞아. 모노클처럼 생겼지만 탐지기야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101100133,
					"content": "안타깝게도 리사는 직접 사용할 수가 없어서 대신 실험도 해줄 겸 가지고 놀려고 빌렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100134
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101100134,
					"content": "엥? 리사는 왜 사용할 수가 없는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100135
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100135,
					"content": "음… 자유로운 동심이 부족해서라고 해야 하나 아님, 다른 이유 때문이라고 해야 하나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100136
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101100136,
					"content": "다음에 너희가 직접 물어봐, 그럼 알게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100137
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101100137,
					"content": "그럼 넌 이 녀석의 상상 속 친구가 어떻게 생겼는지 볼 수 있겠네? 빨리 나한테도 말해줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100138
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100138,
					"content": "음, 그건… 비~~밀~~^_^",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100139
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101100139,
					"content": "어쨌든 너한테 줬으니까 이걸로 노라의 「상상 속 친구」를 봐봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100140
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101100140,
					"content": "어때? 어떠냐구! 보여?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100141,
						101100142
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100141,
					"content": "진짜 있어!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100143,
					"content": "역시 네가 끼면 볼 수 있구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100144
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101100144,
					"content": "미워, 나도 보고 싶다구! ——그치만 나한텐 너무 커!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100145
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100145,
					"content": "#{NICKNAME}, 너만 믿을게! <color=#00E1FFFF>다른 사람들</color>의 상상 속 친구는 어떤 모습인지 보러 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101100142,
					"content": "노라와 잘 어울리는 아이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100143
					]
				},
				{
					"id": 101100131,
					"content": "겉모습은 완전 모노클 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100132
					]
				},
				{
					"id": 101100132,
					"content": "그치? 나도 그렇게 생각해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100133
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101100117,
					"content": "안타깝지만 그런 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100118
					]
				},
				{
					"id": 101100114,
					"content": "이제는 볼 수 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100115
					]
				},
				{
					"id": 101100109,
					"content": "상상 속 친구가 환각에 나타나는 거지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100110
					]
				},
				{
					"id": 101100110,
					"content": "환각이라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100111
					],
					"speakerTitle": "페이몬"
				}
			]
