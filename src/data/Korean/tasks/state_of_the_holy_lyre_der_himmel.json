			"dialogs": [
				{
					"id": 3790401,
					"content": "우워, 역시",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790402
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3790402,
					"content": "이 젊음을… 되찾은 느낌은?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790403
					],
					"speakerTitle": "진"
				},
				{
					"id": 3790403,
					"content": "지금 자기 자랑한 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3790404,
					"content": "…천공의 하프가 그렇다는 소리야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790405
					],
					"speakerTitle": "진"
				},
				{
					"id": 3790405,
					"content": "#{NICKNAME}, 네가 결정을 정화해준 덕분에 하프의 「바람」 원소가 완전히 사라지지 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790406
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3790406,
					"content": "회복하려면 원소가 아직도 많이 부족해. 드발린의 눈물을 더 얻을 수만 있다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790407,
						3790409,
						3790410
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3790407,
					"content": "우리가 도와줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790408
					]
				},
				{
					"id": 3790408,
					"content": "그런데 눈물 결정을 어떻게 수집하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3790411,
					"content": "지금도 드발린은 울고 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790412
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3790412,
					"content": "사람들이 없는 곳에서 혼자 괴로워하고 있겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790413
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3790413,
					"content": "드발린…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790414
					],
					"speakerTitle": "진"
				},
				{
					"id": 3790414,
					"content": "불쌍해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790415
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3790415,
					"content": "이건 명예 기사, 혼자만의 일이 아니야. 페보니우스 기사단도 같이 움직이겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790416
					],
					"speakerTitle": "진"
				},
				{
					"id": 3790416,
					"content": "#눈물 결정을 얻으면 정화를 부탁할게, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790417
					],
					"speakerTitle": "진"
				},
				{
					"id": 3790417,
					"content": "내게 맡겨요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790418
					]
				},
				{
					"id": 3790418,
					"content": "음… 멋있는데. 영웅들이 같은 목적을 가지고 여정을 시작하는 장면은 언제나 근사하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790419
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3790419,
					"content": "그럼… 이 노래로 너흴 배웅해줄게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790420
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3790420,
					"content": "엥? 게으름 피우려구? 날로 먹을 셈이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790421
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3790421,
					"content": "하프를 연주하려면 손이 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790422
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3790422,
					"content": "으이~ 나 화났어. 너에게 우스꽝스러운 별명을 지어줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790423
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3790423,
					"content": "음… 정했어. 앞으로 너의 별명은 「<color=#00E1FFFF>각설이</color>」야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3790409,
					"content": "눈물 결정을 어떻게 수집하지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
				},
				{
					"id": 3790410,
					"content": "드발린을 어떻게 울리면 되는 거지? 꿀밤을 때려야 하나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
				}
			]
		}
