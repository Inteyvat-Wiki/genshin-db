			"dialogs": [
				{
					"id": 732330201,
					"content": "후우, 아직도 한 무더기는 남아있네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330202
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 732330202,
					"content": "리프의 물건에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330203
					]
				},
				{
					"id": 732330203,
					"content": "리프가 주문한 물건 말이지? 방금 받았네. 저기 안에 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330204
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 732330204,
					"content": "그런데 양이 꽤 많던데… 들고 갈 수 있겠나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330205,
						732330206
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 732330205,
					"content": "많이 무겁나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				},
				{
					"id": 732330207,
					"content": "화분 말고도 각종 씨앗이랑 비료에, 원예용품도 있거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330208
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 732330208,
					"content": "다 합치면 무게가 꽤 나갈 텐데. 음… 혼자서 들 수 있으려나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330209,
						732330210
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 732330209,
					"content": "알아서 들고 갈게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330211,
					"content": "그렇다면야… 알겠네, 잘 들고 가게나. 수고가 많겠구만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 732330210,
					"content": "가져다준다고 약속했으니까요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330206,
					"content": "어, 얼마나 많길래…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				}
			]
		},
