					"리프"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330601,
					"content": "여행자, 돌아왔구나. 수고 많았어. …네르민이 뭐래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330602,
						732330605
					],
					"speakerTitle": "리프"
				},
				{
					"id": 732330602,
					"content": "제대로 돌보지 못할까 봐 걱정하더라고요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330603
					]
				},
				{
					"id": 732330603,
					"content": "그건… 내가 좀 도와줘야겠네. 안 되겠다 싶으면 다른 사람들한테 물어보고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330604
					],
					"speakerTitle": "리프"
				},
				{
					"id": 732330604,
					"content": "정 방법이 없다 싶으면… 키우기 쉽고 생명력이 강한 식물을 찾아봐야겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "리프"
				},
				{
					"id": 732330608,
					"content": "후, 아무튼… 정말 고마워, 여행자. 여기 수고비야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330609
					],
					"speakerTitle": "리프"
				},
				{
					"id": 732330609,
					"content": "조금 있다가 나머지도 네르민한테 갖다줘야겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330610
					],
					"speakerTitle": "리프"
				},
				{
					"id": 732330610,
					"content": "잠깐, 원예 도구에 설명서가 없잖아? 어떻게 사용하는 건지 하나도 모르는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리프"
				},
				{
					"id": 732330605,
					"content": "전에 꽃 선물해준 적 없어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330606
					]
				},
				{
					"id": 732330606,
					"content": "없는 건 아닌데… 전에 다른 사람에게 부탁해서 다 자란 꽃을 가져다 달라고 했었거든? 근데 마을에 도착했을 땐 이미 말라 죽어있더라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330607
					],
					"speakerTitle": "리프"
				},
				{
					"id": 732330607,
					"content": "그래서 이번엔 아예 씨앗을 심어서 선물했던 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
