				"points": []
			},
			"dialogs": [
				{
					"id": 4670101,
					"content": "다음 요리는 뭘 만들지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670102
					],
					"speakerTitle": "린"
				},
				{
					"id": 4670102,
					"content": "음? 너희도 모험가야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670103
					],
					"speakerTitle": "린"
				},
				{
					"id": 4670103,
					"content": "우린 지나가던 여행자야. 요리하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4670104,
					"content": "여행자구나, 반가워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670105
					],
					"speakerTitle": "린"
				},
				{
					"id": 4670105,
					"content": "난 모험가 길드의 생존 전문가, 린이라고 해. 보다시피 지금은 요리 연구 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670106
					],
					"speakerTitle": "린"
				},
				{
					"id": 4670106,
					"content": "「배불리 먹고 길에 오르는」 거야말로 「야외 생존」의 첫 번째 수칙이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670107
					],
					"speakerTitle": "린"
				},
				{
					"id": 4670107,
					"content": "먹는 거! 나도 먹는 거 좋아해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4670108,
					"content": "내 친구도 요리 꽤 잘해. 맞지? 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670801,
						4670901
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4670801,
					"content": "그냥 간단한 것밖에 못 해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670802
					]
				},
				{
					"id": 4670802,
					"content": "괜찮아. 네 솜씨 좀 보여줘 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670803
					],
					"speakerTitle": "린"
				},
				{
					"id": 4670803,
					"content": "생존 전문가한테 직접 과외받을 기회는 흔치 않다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "린"
				},
				{
					"id": 4671001,
					"content": "버섯이랑 고기는 옆에 있는 나무통에 있으니까 <color=#00E1FFFF>「버섯 닭꼬치」</color>를 한번 만들어봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "린"
				},
				{
					"id": 4670901,
					"content": "맞아요, 저도 요리하는 걸 꽤 좋아해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670902
					]
				},
				{
					"id": 4670902,
					"content": "그래? 그럼 어서 네 솜씨 좀 보여줘 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670903
					],
					"speakerTitle": "린"
				},
				{
					"id": 4670903,
					"content": "요리 비법을 나눌 기회는 흔치 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "린"
				}
			]
		},
