				"objectNames": [
					"리와"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750860301,
					"content": "왔구나! 타루카가 네 이야기를 계속하던데? 굉장한 실력자라면서, 비행 대회에서 어떻게든 따라가 보기라도 하더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860302
					],
					"speakerTitle": "리와"
				},
				{
					"id": 750860302,
					"content": "내가 이길 수 있을지도 모른다는 생각은 전혀 안 하는 말투였어. 누나의 체면이 다 어디로 갔는지 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860303
					],
					"speakerTitle": "리와"
				},
				{
					"id": 750860303,
					"content": "그러니까 이따 대회에서는 봐주지 않을 거야. 너도 온 힘을 다해서 최선을 다해. 승부를 내보는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860304,
						750860306
					],
					"speakerTitle": "리와"
				},
				{
					"id": 750860304,
					"content": "절 진지하게 만든 걸 후회하게 되실 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750860305
					]
				},
				{
					"id": 750860305,
					"content": "바로 그 기세야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860308
					],
					"speakerTitle": "리와"
				},
				{
					"id": 750860308,
					"content": "얘기는 그만하고, 준비됐으면 시작하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리와"
				},
				{
					"id": 750860306,
					"content": "제 목표는 참가상이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750860307
					]
				},
				{
					"id": 750860307,
					"content": "내가 방심하길 바라는 거야? 후후, 절대 안 속아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750860308
					],
					"speakerTitle": "리와"
				}
			]
		},
