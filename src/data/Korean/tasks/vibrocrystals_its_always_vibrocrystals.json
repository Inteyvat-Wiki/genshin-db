						],
						"stepId": 7112501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"패트리스",
					"아나톨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711250301,
					"content": "사실 제가 명예 선임 연구원이거든요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711250302
					]
				},
				{
					"id": 711250302,
					"content": "그, 그건 좀 놀랍네. 과학원에서 명예 직함을 수여하는 범위가 이 정도로 넓어질 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711250303
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 711250303,
					"content": "실험을 도와주고 싶어 하는 열정 하나만으로도 명예 직함을 몇 개는 받을 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "패트리스"
				}
			]
		},
		{
			"id": 7112504,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
