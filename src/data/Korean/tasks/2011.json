			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"북두"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110301,
					"content": "여어, 드디어 왔구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110302
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20110302,
					"content": "「남십자함대」는 폭풍우에도 지체된 적이 없었는데, 이번엔 내가 너희 체면을 세워준 거라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110303,
						20110304
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20110303,
					"content": "#오래 기다리셨죠, {F#대장}{M#누님}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				},
				{
					"id": 20110305,
					"content": "하하하, 농담이야. 딱 맞춰왔어. 출항 준비를 방금 마쳤거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110306
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20110306,
					"content": "이제 빠진 사람도 없으니——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110307
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20110307,
					"content": "번개와 폭우로 둘러싸인 「영원」의 나라로 출항한다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110308
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20110308,
					"content": "출발!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20110304,
					"content": "영광입니다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				}
			]
		},
		{
			"id": 201107,
			"completionStepIds": [
				201107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201107",
							"2"
						],
						"stepId": 201107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"토마"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110701,
					"content": "드디어 오셨군요, 「리월인들의 누님」. 엄청 기다렸다구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110702
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20110702,
					"content": "게다가 밀입국 손님… 아니, 귀한 손님들까지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110703
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20110703,
					"content": "쉿!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110704
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20110704,
					"content": "그건 너희 쇼군님을 탓해야지. 요즘 이나즈마 외해의 뇌우와 파도가 훨씬 강해졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110705
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20110705,
					"content": "내 함대의 실력으론 문제없었지만, 꽤나 시간이 걸렸다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110706
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20110706,
					"content": "아, 참. 소개할게, 이쪽은 토마. 최근에 알게 된 상업 파트너지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110707
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20110707,
					"content": "여어, 너희들을 만나고 싶었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110708
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20110708,
					"content": "토마, 이 둘은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110709
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20110709,
					"content": "소개는 됐어요. 이방에서 온 여행자의 명성은 외해의 폭풍우도 막을 수 없죠. 벌써 익히 들었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110710,
						20110711
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20110710,
					"content": "토마 씨, 안녕하세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110712
					]
				},
				{
					"id": 20110712,
					"content": "헤헤, 말을 참 예쁘게 하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110713
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20110713,
					"content": "응, 차라리 잘됐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110714
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20110714,
					"content": "#{NICKNAME}, 토마는 이도에서 오래 지냈으니 이 구역에서 꽤 잘나가는 유명인인 셈이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110715
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20110715,
					"content": "문제가 생기면 토마를 찾아가. 하지만 이 녀석이 널 해코지하면… 내가 다음에 이나즈마에 올 때 혼내줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110716
					],
					"speakerTitle": "북두"
				},
				{
					"id": 20110716,
					"content": "하하하… 걱정 마세요. 우린 꽤 잘 지낼 수 있을 것 같거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110717
					],
					"speakerTitle": "토마"
				},
				{
					"id": 20110717,
					"content": "슬슬 가야겠네. 내 배에 「지명 수배범」도 하나 숨어 있어서 여기 오래 못 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110718
					],
