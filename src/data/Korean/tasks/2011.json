				"points": []
			},
			"dialogs": [
				{
					"id": 20110101,
					"content": "여행자, 무슨 일 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110102,
						20110103
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 20110102,
					"content": "이나즈마에 가는 것에 대해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				},
				{
					"id": 20110104,
					"content": "응, 남십자함대의 선장이 너희를 이나즈마까지 데려다준다고 약속했다던데, 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110105
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 20110105,
					"content": "그것도 꽤 오래전이네. 나한테도 특별히 줄 만한 정보는 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110106
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 20110106,
					"content": "찾았다! 네가 바로 북두 누님이 말씀하신 그 여행자 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110107,
						20110109
					],
					"speakerTitle": "해룡"
				},
				{
					"id": 20110107,
					"content": "목 빠져라 기다렸어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110108
					]
				},
				{
					"id": 20110108,
					"content": "그렇군, 하하, 영광인걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110110
					],
					"speakerTitle": "해룡"
				},
				{
					"id": 20110110,
					"content": "함대의 보급 업무도 거의 다 끝나가서 지금 인원수 체크 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110111
					],
					"speakerTitle": "해룡"
				},
				{
					"id": 20110111,
					"content": "누님이 널 찾아오라고 하셔서. 너만 오면 바로 출항이래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110112
					],
					"speakerTitle": "해룡"
				},
				{
					"id": 20110112,
					"content": "역시 북두는 약속을 잘 지키네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20110113,
					"content": "그야 당연하지, 누님이 얼마나 믿음직스러운데. 출항하면 너희도 차차 알게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110114
					],
					"speakerTitle": "해룡"
				},
				{
					"id": 20110114,
					"content": "두 사람 이제 떠나는 거야? 어쨌든 축하해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110115
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 20110115,
					"content": "앞날에 별이 있든 심연이 있든 다음 단계로 나아 간다는 건 축하해야 할 일이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110116
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 20110116,
					"content": "그럼 또 보자, 모험이 순조롭길~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110117,
						20110118
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 20110117,
					"content": "캐서린 씨…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110119,
					"content": "맞아. 좀 아쉽네. 거의 매일 봤었는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20110120,
					"content": "하하, 그럼 이나즈마에 가서도 얼른 날 찾아줘야 해. 나루카미섬에서 기다리고 있을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110121,
						20110122
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 20110121,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110123,
					"content": "역시 이나즈마에도 캐서린이 있었군! 그럼 그렇게 진지하게 작별 인사할 필요 없잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20110124,
					"content": "하하, 리월이랑 제대로 작별하고 와. 배는 고운각 쪽에 정박해 있어. 메시지는 다 전했으니 난 먼저 돌아갈게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110125
					],
					"speakerTitle": "해룡"
				},
				{
					"id": 20110125,
					"content": "응, 여기까지 오느라 고생했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20110126,
					"content": "괜찮아, 배에서 보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "해룡"
				},
				{
					"id": 20110122,
					"content": "…역시!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110118,
					"content": "보고 싶을 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110109,
					"content": "정보가 알아서 찾아왔네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110110
					]
				},
				{
					"id": 20110103,
					"content": "남십자함대에 대해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				}
			]
		},
		{
			"id": 201103,
			"completionStepIds": [
				201103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201103",
							"2"
						],
						"stepId": 201103,
						"stateName": "QUEST_STATE_UNFINISHED"
