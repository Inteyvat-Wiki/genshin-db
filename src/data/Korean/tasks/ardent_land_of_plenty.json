			"dialogs": [
				{
					"id": 150180201,
					"content": "네가 바레사였구나, 들어본 적 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150180202,
					"content": "#나는 페이몬, 얘는 {NICKNAME}(이)야! 우린 최고의 파트너지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150180203,
					"content": "#응! 페이몬, {NICKNAME}. 좋은 이름이네, 기억해 둘게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180204
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 150180204,
					"content": "그럼 이제 출발하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
