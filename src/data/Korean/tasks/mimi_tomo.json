			"dialogs": [
				{
					"id": 700240101,
					"content": "여행자, 이쪽이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240102
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700240102,
					"content": "시간 뺏어서 미안해. 새로운 의뢰 맡아볼 생각있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240103,
						700240104
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700240103,
					"content": "들어보고 싶어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				},
				{
					"id": 700240105,
					"content": "최근에 야외의 츄츄족 무리가 또 상로를 공격했다는 소식이 들어왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240106
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700240106,
					"content": "그래서 모험가들을 파견했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240107
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700240107,
					"content": "들어보니 츄츄족 무리 중엔 항상 이상한 츄츄족 한 마리가 있었나 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240108
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700240108,
					"content": "아무래도 그 이상한 츄츄족이 이번 소동과 관련 있는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240114
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700240114,
					"content": "그 녀석을 포획하거나, 적어도 쫓아내줄 사람이 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240109
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700240109,
					"content": "여행자, 이 의뢰 받아볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240110,
						700240111
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700240110,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240112,
					"content": "고마워. 장소는 네 지도에 표시해뒀어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240113
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700240113,
					"content": "다 츄츄족이 출몰했던 곳이니까 표시해둔 곳부터 조사해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240115
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700240115,
					"content": "그 이상한 츄츄족을 마주치면… 조심하렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐서린"
				},
				{
					"id": 700240111,
					"content": "주의할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240104,
					"content": "무슨 의뢰인데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				}
			]
		},
