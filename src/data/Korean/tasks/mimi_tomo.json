			},
			"dialogs": [
				{
					"id": 700240202,
					"content": "우리가 와서 다행이네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240203,
					"content": "너 괜찮아…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240201,
					"content": "휴… 위험했어, 너희가 와줘서 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240202,
						700240203
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700240204,
					"content": "휴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240205
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700240205,
					"content": "분명 분위기는 좋았는데… 뭘 잘못 말한걸까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240206
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700240206,
					"content": "아무튼… 구해줘서 고마워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240207
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700240207,
					"content": "쟤 엄청 우울해 보여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700240208,
					"content": "조금 전 일은 너희도 봤을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240223
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700240223,
					"content": "내가 직접 츄츄족과 대화하는 건 위험하겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240209
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700240210,
					"content": "그렇구나…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240211,
					"content": "도움이 필요하면 말해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240209,
					"content": "하지만… 츄츄족과 얘기할 기회를 이대로 놓치고 싶지 않아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240210,
						700240211
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700240212,
					"content": "그럼 사전 편집 작업이 또 연기되겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240224
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700240213,
					"content": "내가 도와줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240214
					]
				},
				{
					"id": 700240224,
					"content": "누가 나 대신 책 내용이 정확한지 확인해주면 좋을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240213
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700240214,
					"content": "정, 정말? 잘됐다! 그럼 이 책 꼭 챙겨가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240215
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700240215,
					"content": "우왓… 말투가 그새 명령조로 바뀌었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700240217,
					"content": "이론상으로는…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240218
					]
				},
				{
					"id": 700240216,
					"content": "얘기하다가 막혔을 때 단어를 찾아보면 해결할 수 있을 거야… 이론상으로는 그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240217
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700240218,
					"content": "그럼 자기가 뭘 쓴지도 모른다는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700240219,
					"content": "그건 풋내기들이나 하는 질문이라구! 현실검증도 안 하고선 과학연구가 논리적으로 맞는지 어떻게 알아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240225
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700240225,
					"content": "쳇… 됐어, 계속 말한다고 해서 네가 알아들을 것도 아니잖아. 아무튼 구해줘서 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700240221,
					"content": "우리야 환영이지!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240222,
					"content": "그래, 이왕 왔으니까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240220,
					"content": "괜찮다면 츄츄족과 협상할 때 나도 따라갈래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220,
						700240221
					],
					"speakerTitle": "엘라·머스크"
				}
			]
		}
	]
