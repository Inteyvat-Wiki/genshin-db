						],
						"pointId": 360300003
					}
				]
			},
			"dialogs": [
				{
					"id": 760490101,
					"content": "…음이 조금 높은 것 같아. 다시 해볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490102
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490102,
					"content": "콜롬비나! 안녕",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760490103,
					"content": "어? 오늘은 월령한테 악기를 가르치는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760490104,
					"content": "응. 전에 악기를 고친 후로 신이 나서는 매일 나를 조르고 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490105
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490105,
					"content": "근데 사실 나도 악기는 잘 못 다뤄. 예전에도 다른 사람이 연주하는 것만 들었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490106
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490106,
					"content": "음, 이해돼. 밴드를 꾸려도 콜롬비나는 왠지 보컬이 어울린달까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760490107,
					"content": "그나저나 악기라면 얘가 완전 잘 다뤄! 몬드의 「하프」부터 나타의 「젬베」까지 전부 수준급이라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490108,
						760490109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760490108,
					"content": "평범한 수준이야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				},
				{
					"id": 760490110,
					"content": "그래? 그럼… 네가 좀 가르쳐 줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490111,
						760490112
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490111,
					"content": "실력 발휘 좀 해볼까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490113,
					"content": "이 아이들은 요즘 내가 평소에 부르는 노래를 연습하고 있어. 멜로디 기억하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490114
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490114,
					"content": "아니면… 네가 잘하는 걸 연주해 줘도 돼. 월령들은 다른 나라의 음악을 들을 일이 거의 없으니까. 나도 듣고 싶고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490115
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490115,
					"content": "(뭘 연주할까…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202,
						760490801
					]
				},
				{
					"id": 760490202,
					"content": "콜롬비나가 자주 흥얼거리던 노래를 연주하자…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "(어떤 감정으로 연주할까…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "잔잔하게…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "듣기 좋네. 내가 흥얼거리던 멜로디를 다 기억하고 있었구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490605,
					"content": "헤헤, 네가 노래를 워낙 잘 부르니까, 가끔 옆에서 몰래 듣기도 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760490606,
					"content": "월령들도 푹 빠져서 듣더라. 잘 보고 배웠는지 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490607,
					"content": "앞으로 몇 번 더 부탁해야 할지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490608,
					"content": "자, 손 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490609,
					"content": "응? 이건 무료 공연이야. 수강료는 필요 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760490610,
					"content": "응? 수강료?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490611,
					"content": "난 그냥, 예쁜 선율은 예쁜 달빛과 함께하는 게 좋을 것 같아서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490701,
					"content": "즐겁게…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "벌써 끝났어? 더 듣고 싶었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490703,
					"content": "이건 내가 유일하게 기억하는 「자장가」라고 했었지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490704,
					"content": "거기에 담긴 의미는 아직 잘 모르겠지만, 네 연주를 듣고 나니 이런 생각이 들어. 달에서 나를 기다리고 있는 답은, 최소한 아름다운 걸 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490705,
					"content": "자, 손 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490706,
					"content": "이번엔 보답 같은 건 괜찮아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760490707,
					"content": "아냐. 그냥 이 예쁜 선율에 예쁜 달빛을 더하고 싶을 뿐인걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490801,
					"content": "다른 나라의 음악을 연주하자…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490802
					]
				},
				{
					"id": 760490802,
					"content": "신기하다. 전에도 가끔 이런 멜로디를 들어본 적이 있는데, 네가 치니까 느낌이 달라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490803
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490803,
					"content": "그 나라를 향한 여행자의 감정이 실려서 그런 거 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490804
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760490804,
					"content": "멜로디를 듣는데 풍경이 절로 떠오르더라…. 현실과 내 상상이 얼마나 다를지는 모르겠지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490805
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490805,
					"content": "실제 풍경이 어떤지 궁금하면, 우리가 나중에 데려가서 보여줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490806
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760490806,
					"content": "응… 정말 그런 날이 온다면 좋겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760490112,
					"content": "어떤 곡을 연주하지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490109,
					"content": "조금 치는 정도지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				}
			]
		},
