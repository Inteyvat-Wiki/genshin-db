			"dialogs": [
				{
					"id": 200500101,
					"content": "골치 아프네…. 이걸 어떻게 해결해야 하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500102
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200500102,
					"content": "뭐 하는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500103
					]
				},
				{
					"id": 200500103,
					"content": "다음 기사단 선발을 위해 훈련 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500104
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200500104,
					"content": "음… 하지만 난 진 단장님 같은 힘이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500105
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200500105,
					"content": "「힘」을 단련하는 것보다는 「기술」을 익히는 게 나한테 더 맞는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500106
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200500106,
					"content": "예를 들어, 이 통나무들을 단숨에 모두 파괴하는 방법 같은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500107
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200500107,
					"content": "시간 있으면 너도 나랑 같이 생각해보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500108,
						200500109
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200500108,
					"content": "한번 생각해볼게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500110
					]
				},
				{
					"id": 200500110,
					"content": "괜찮아. 통나무는 어디 도망 안 가니까 천천히 생각해도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500111
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200500111,
					"content": "홀로 도망갈 수 있는 건 흘러가는 시간과 생명체밖에 없으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200500114,
					"content": "누가 그러던데 원소는 상호 작용이 가능해서 이 화롯불을 점점 크게 키울 수 있다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500115
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200500115,
					"content": "하지만 이 화로에 불을 먼저 붙여야 하지 않을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엘린"
				},
				{
					"id": 200500109,
					"content": "우리 둘이 같이 하는 건…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500112
					]
				},
				{
					"id": 200500112,
					"content": "단체 전투 해봤어? 언제든지 도움을 요청할 수 있으니…. 정말 부러운 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500113
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200500113,
					"content": "나 같은 사람은 그냥 독자적인 전투만 배워야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "엘린"
				}
			]
		},
