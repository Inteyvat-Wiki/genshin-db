			"trigger": {
				"objectNames": [
					"쿠로다"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751210101,
					"content": "책 두 권을 구해달라는 부탁을 받았는데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210102
					]
				},
				{
					"id": 751210102,
					"content": "쿠로다에게 시틀라리가 원하는 절판된 책을 설명한다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751210103
					]
				},
				{
					"id": 751210103,
					"content": "《라이덴 쇼군으로 환생하면 천하무적이 된다》의 초판이랑 《부탁해요, 나의 여우 신선 궁사님》의 한장판 양장본이라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210104
					],
					"speakerTitle": "쿠로다"
				},
				{
					"id": 751210104,
					"content": "네 친구의 안목이 대단한데? 소장 가치를 따지자면 지금까지 야에 출판사에서 출판한 책들 전부를 가져와도 그 두 권보다 못 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210105
					],
					"speakerTitle": "쿠로다"
				},
				{
					"id": 751210105,
					"content": "이런 독자를 모르고 있었다니, 정말 유감인걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210106
					],
					"speakerTitle": "쿠로다"
				},
				{
					"id": 751210106,
					"content": "지금도 구할 수 있을까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210107
					]
				},
				{
					"id": 751210107,
					"content": "두 권 모두 시중에서 구하긴 힘들 거야. 재고는 두말할 것도 없이 진작에 다 팔렸고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210108
					],
					"speakerTitle": "쿠로다"
				},
				{
					"id": 751210108,
					"content": "그런데 마침, 내게 한 권씩 있기는 한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210109
					],
					"speakerTitle": "쿠로다"
				},
				{
					"id": 751210109,
					"content": "제가 살게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210110
					]
				},
				{
					"id": 751210110,
					"content": "아냐, 이 두 권은 네 친구의 손에 있을 때 더 가치가 있을 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210111
					],
					"speakerTitle": "쿠로다"
				},
				{
					"id": 751210111,
					"content": "네게 선물로 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쿠로다"
				}
			]
		}
	]
