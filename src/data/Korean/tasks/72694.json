				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726940401,
					"content": "어때, 재료 수집은 잘 되어가나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940402
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726940402,
					"content": "모두 수집기에 들어있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940403
					]
				},
				{
					"id": 726940403,
					"content": "자, 이제 수집한 재료를 내 유일무이 절대 안정…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940404
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726940404,
					"content": "「울트라 대왕 머신」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726940405,
					"content": "알았어 알았어, 수집한 재료를 「울트라 대왕 머신」에 넣어보도록 하자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940406
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726940406,
					"content": "베르트랑이 수집기를 「울트라 대왕 머신」에 연결한다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						726940407
					]
				},
				{
					"id": 726940407,
					"content": "와, 다음은?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726940408,
					"content": "조금 있으면 기계가 달그락달그락 작동하고, 그다음 장난감을 탁탁 만들어내는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726940409,
					"content": "하하하, 그건 물론…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940410
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726940410,
					"content": "불가능하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940411
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726940411,
					"content": "무슨 생각을 하고 있는 거야? 3개 공정 중 이제 겨우 하나만 완성했어. 장난감이 만들어지기까지 아직 멀었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940412
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726940412,
					"content": "모든 공정이 끝나야 장난감이 생기는구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726940413,
					"content": "그래, 세 공정이 차례대로 완성되어야 장난감을 생산할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940414,
						726940415
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726940414,
					"content": "너무 번거롭네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940416
					]
				},
				{
					"id": 726940416,
					"content": "맨날 첫술에 배부를 생각만 하고 있군. 장난감 제작은 인내심이 필요해. 제조 공정 하나하나에 제작자의 깊은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940417
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726940417,
					"content": "제작자의 깊은…? 아아, 「장난감」을 만들려면 제작자가 깊은 애정을 쏟아부어야 한다는 말이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940418
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726940418,
					"content": "맞아, 모라에 대한 자신의 깊은 애정을 쏟아부어야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940419
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726940419,
					"content": "아, 내가 생각했던 거랑은 다르지만 그런 애정이라면 내게도 얼마든 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940420
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726940420,
					"content": "페이몬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726940421
					]
				},
				{
					"id": 726940421,
					"content": "헤헤, 그냥 한번 말해본 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940422
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726940422,
					"content": "그럼 베르트랑, 이제 뭐가 필요해? 남은 공정을 이어서 완성해야겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726940423
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726940423,
