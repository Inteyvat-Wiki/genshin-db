					"nextDialogs": [
						740630502
					],
					"speakerTitle": "넬리"
				},
				{
					"id": 740630502,
					"content": "원하던 대로 생생한 장면을 찍었나 보네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740630503,
					"content": "맞아. 이걸 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630504,
						740630506
					],
					"speakerTitle": "넬리"
				},
				{
					"id": 740630504,
					"content": "생생한지는 모르겠지만 예술적이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630505
					]
				},
				{
					"id": 740630505,
					"content": "난 예술에 대해 잘 몰라서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740630508,
					"content": "정말 이걸로 괜찮겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630509
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740630509,
					"content": "무슨 문제라도 있어? 내가 보기엔 정말 잘 찍었는걸! 선배님이 보시면 깜짝 놀랄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630510
					],
					"speakerTitle": "넬리"
				},
				{
					"id": 740630510,
					"content": "대체 기준이 뭔지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630511
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740630511,
					"content": "에이, 이런 게 바로 「실질적 내용보다 상징적인 의미가 더 크다」는 거야. 선배님이라면 여기에 감춰진 뜻을 이해하겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630512
					],
					"speakerTitle": "넬리"
				},
				{
					"id": 740630512,
					"content": "어쨌든 도와줘서 고마워. 이건 답례야. 헤헤, 다음에는 물고기를 낚을 수 있는 곳에서 만나서 얘기를 나눴으면 좋겠네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "넬리"
				},
				{
					"id": 740630506,
					"content": "생생하다 못해 진짜 움직이는 중인 것 같네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630507
					]
				},
				{
					"id": 740630507,
					"content": "으음, 계속 보고 있으니까 좀 어지러운 것 같기도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630508
					],
					"speakerTitle": "페이몬"
				}
			]
