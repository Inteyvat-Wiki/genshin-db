				"points": []
			},
			"dialogs": [
				{
					"id": 740630401,
					"content": "안녕? 저기 저쪽에 있는 확성기에 문제가 생긴 것 같아서 왔어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740630402,
					"content": "또 고장이야? 전에 클라인즈가 고친 걸로 알고 있는데 이상하군. 그 녀석은 실력이 나보다도 못한가? 그냥 몇 번 때리면 알아서 고쳐지던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630403
					],
					"speakerTitle": "그랑빌"
				},
				{
					"id": 740630403,
					"content": "아무튼 알려줘서 고마워. 확인하러 가보지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630404
					],
					"speakerTitle": "그랑빌"
				},
				{
					"id": 740630404,
					"content": "수고해!",
