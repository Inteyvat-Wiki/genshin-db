					"케리흐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150101,
					"content": "왜 그래? 너도 근력 훈련장에 관심 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150102
					],
					"speakerTitle": "케리흐"
				},
				{
					"id": 752150102,
					"content": "기구들은 마음껏 사용해도 되지만, 팔다리가 가느다란 걸 보니… 다치지 않도록 조심해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150103,
						752150104
					],
					"speakerTitle": "케리흐"
				},
				{
					"id": 752150103,
					"content": "저 매일 운동 엄청 많이 하거든요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				},
				{
					"id": 752150105,
					"content": "아, 그래? 그럼 허풍만 떨지 말고 옆에 있는 블록과 한판 붙어보지 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150106
					],
					"speakerTitle": "케리흐"
				},
				{
					"id": 752150106,
					"content": "블록을 <color=#00E1FFFF>공격</color>하거나 <color=#00E1FFFF>들이받으면</color> 힘의 크기에 따라 점수를 얻게 될 거야. 얼마나 강한지 한번 보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "케리흐"
				},
				{
					"id": 752150104,
					"content": "전 츄츄족을 한 방에 날려버릴 수 있거든요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				}
			]
		},
		{
			"id": 7521502,
			"completionStepIds": [
				7521502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
