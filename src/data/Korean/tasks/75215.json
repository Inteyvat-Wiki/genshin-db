			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"케리흐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150201,
					"content": "말도 안 돼. 네가 저 블록의 한쪽 모서리를 부순 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150202
					],
					"speakerTitle": "케리흐"
				},
				{
					"id": 752150202,
					"content": "이런 힘을 가진 사람은 바레사 선배밖에 없었는데… 너도 선배처럼 타고난 선수인가 보구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150203,
						752150204
					],
					"speakerTitle": "케리흐"
				},
				{
					"id": 752150203,
					"content": "좀 힘들긴 했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				},
				{
					"id": 752150205,
					"content": "진짜 사람은 겉만 보고 판단하면 안 된다니까. 기회만 된다면 널 코치로 초빙하고 싶을 정도야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150206
					],
					"speakerTitle": "케리흐"
				},
				{
					"id": 752150206,
					"content": "참, 이 비옥한 땅의 과일 주스는 운동 효과를 높여준다고 해서 수강생들이 아주 좋아하더라고. 너도 한번 마셔봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "케리흐"
				},
				{
					"id": 752150204,
					"content": "이 정도는 식은 죽 먹기죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				}
			]
		},
		{
