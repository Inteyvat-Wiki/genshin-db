				]
			},
			"dialogs": [
				{
					"id": 706810401,
					"content": "선배! 미안한데 여기서 잠깐 기다려 줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810402
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706810402,
					"content": "무슨 일 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810403
					]
				},
				{
					"id": 706810403,
					"content": "뭐 놓고 온 거라도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 706810404,
					"content": "그건 아니야. 그냥 지도를 보니까 앞으로 더 가면 몬드를 벗어나게 된다고 하길래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810405
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706810405,
					"content": "다음에 돌아오는 날이 언제일지 모르겠지만… 선생님은 내가 남긴 편지를 보시면 분명히 화내시겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810406,
						706810407
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706810406,
					"content": "전에도 선생님 얘기를 했던 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				},
				{
					"id": 706810408,
					"content": "맞아… 선생님은 막 모험가가 되셨을 때 밖에서 츄츄 폭도를 만나 대치하다가 결국 실수로 그 도끼에 맞아 기절하셨다고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810409
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706810409,
					"content": "다행히 지나가던 기사가 선생님을 구해줬지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810410
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706810410,
					"content": "부끄러웠던 선생님은 성안에서 무예를 극한까지 연마한 뒤 모험을 떠나기로 하신 거야. 근데 그 훈련이 10년이나 지속됐어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810411
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706810411,
					"content": "선생님은 기초가 제일 중요하다고 하시는데, 매일 말뚝만 베는 건 도저히 못 견디겠더라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810412
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706810412,
					"content": "그래서 선생님 몰래 혼자 여행을 떠난 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810413,
						706810414
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706810413,
					"content": "강해져서 돌아가요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810415,
					"content": "응! 나도 같은 생각이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810416
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706810416,
					"content": "아, 생각났다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810417
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706810417,
					"content": "게지네가 배낭에서 민들레 씨앗을 꺼내 손바닥 위에 올려놓고 씨앗에게 무언가 얘기한 다음, 바람에 흩날려 보낸다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810418
					]
				},
				{
					"id": 706810418,
					"content": "몬드에는 민들레에 소원을 담을 수 있다는 말이 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810419
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706810419,
					"content": "방금 소원을 빌었어. 순조롭게 목표를 이루고 선생님도 날 이해해 주셨으면 좋겠다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810420
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706810420,
					"content": "바람의 신이 당신의 소원을 들었을 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810421
					]
				},
				{
					"id": 706810421,
					"content": "응! 그럼 이제 계속 가보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "게지네"
				},
				{
					"id": 706810414,
					"content": "선생님이 인정할 만한 결과를 가져가는 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810407,
					"content": "선생님도 모험가인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				}
			]
