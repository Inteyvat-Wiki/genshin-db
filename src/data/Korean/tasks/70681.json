					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810807,
					"content": "고생했어. 너희가 아니었다면 이렇게 쉽게 여기까지 오지 못했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810808
					],
					"speakerTitle": "게지네"
				},
				{
