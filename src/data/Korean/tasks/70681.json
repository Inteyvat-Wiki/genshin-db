			"dialogs": [
				{
					"id": 706819905,
					"content": "게지네가 지배인에게 메뉴를 물어보고, 비싼 요리를 주문했다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 706811201,
					"content": "리월 요리는 색, 향, 맛을 모두 중요하게 생각한다고 들었는데, 정말 다르네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811202
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706811202,
					"content": "보기만 해도 군침이 돌아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 706811203,
					"content": "다 함께 맛있는 음식을 음미한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706811204
					]
				},
				{
					"id": 706811204,
					"content": "우와, 이것도 맛있고, 저것도 맛있고… 더 이상은 못 먹겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811205,
						706811206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 706811205,
					"content": "대만족!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811207
					]
				},
				{
					"id": 706811206,
					"content": "여행의 피로가 다 사라진 것 같아요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811207
					]
				},
				{
					"id": 706811207,
					"content": "고생했어. 너희가 아니었다면 이렇게 쉽게 여기까지 오지 못했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811208
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706811208,
					"content": "방금 객잔 사람이 더 앞으로 가면 <color=#00E1FFFF>리월항</color>이래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811209
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706811209,
					"content": "여기서 며칠 쉬면서 다른 여행객들에게 어떻게 해야 은둔 고수를 만날 수 있는지 물어보려고. 그리고 그 후에 어디로 갈지 정할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811210
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706811210,
					"content": "선배랑 여행하는 건 정말 즐겁지만 더 이상 시간을 뺏을 수는 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811211
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706811211,
					"content": "앞으로 열심히 노력해서 선배처럼 믿음직한 모험가가 될 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811212
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706811212,
					"content": "헤헤, 짧은 시간이었지만 우리도 정말 즐거웠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 706811213,
					"content": "다른 곳에서도 만날 기회가 있었으면 좋겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811214,
						706811215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 706811214,
					"content": "인연이 닿으면 또 만나요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811216
					]
				},
				{
					"id": 706811215,
					"content": "소원이 이뤄지길 바랄게요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706811216
					]
				},
				{
					"id": 706811216,
					"content": "응응! 너희도 순조로운 여행 되길 바랄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811217
					],
					"speakerTitle": "게지네"
				},
				{
					"id": 706811217,
					"content": "게지네가 손을 흔들며 작별 인사를 건넸다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706811218
					]
				},
				{
					"id": 706811218,
					"content": "여기까지 왔으니 우리도 주변을 둘러볼까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706811219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 706811219,
					"content": "어쩌면 놀라운 일이 일어날지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
