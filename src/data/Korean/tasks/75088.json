		},
		{
			"id": 7508802,
			"completionStepIds": [
				7508802
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508802",
							"2"
						],
						"stepId": 7508802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"추뇨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880201,
					"content": "와, 대단하네. 이제 「빛새김 각문」의 금빛 문양을 해독할 수 있어… 보상… 보상은 내 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880202
					],
					"speakerTitle": "추뇨"
				},
				{
					"id": 750880202,
					"content": "이번에도 실패하면 경비가 하나도 남지 않아. 생사가 달렸다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880203
					],
					"speakerTitle": "추뇨"
				},
				{
					"id": 750880203,
					"content": "아, 참. 이건 너희에게 주는 보수야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "추뇨"
				}
			]
		},
		{
			"id": 7508803,
			"completionStepIds": [
				7508803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508803",
							"2"
						],
						"stepId": 7508803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"추뇨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880301,
					"content": "음, 샘플이 충분하다면, 어쩌면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880302
					],
					"speakerTitle": "추뇨"
				},
				{
					"id": 750880302,
					"content": "앗, 여기 이상한 녀석이 중얼거리고 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750880303,
					"content": "나타에는 나 같은 사람이 널렸어. 이상한 건 너희들이지…. 별일 없으면 내 연구를 방해하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880304
					],
					"speakerTitle": "추뇨"
				},
				{
					"id": 750880304,
					"content": "이번 달 지출이 예산을 초과했어. 협회의 현상금이 걸린 문제를 해결해서 채우는 수밖에 없겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880305
					],
					"speakerTitle": "추뇨"
				},
				{
					"id": 750880305,
					"content": "원래 연구를 하면서 돈을 받는구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750880306,
					"content": "맞아, 「용 유물 연구 협회」는 그런 조직이야. 보상이 있어야 다양한 연구를 추진할 수 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880307
					],
					"speakerTitle": "추뇨"
				},
				{
					"id": 750880307,
					"content": "이번에는 「빛새김 각문」의 해독에 도전할 거야… 아무도 완성하지 못한 위대한 업적이라 모라도 많이 받을 수 있다고 들었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880308
					],
					"speakerTitle": "추뇨"
				},
				{
					"id": 750880308,
					"content": "다만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880309
					],
					"speakerTitle": "추뇨"
				},
				{
					"id": 750880309,
					"content": "다만?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750880310,
					"content": "「빛새김 각문」을 해독하려면 먼저 충분한 「빛새김 각문」 파편을 모아야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880311
					],
					"speakerTitle": "추뇨"
				},
				{
					"id": 750880311,
					"content": "…음, 이렇게 하자. 「빛새김 각문」의 파편을 찾아오면 내가 보수를 줄게, 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880312
					],
					"speakerTitle": "추뇨"
				},
				{
					"id": 750880312,
					"content": "너희는 경험이 풍부한 모험가처럼 보이는데, 이런 의뢰를 자주 받지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880313
					],
					"speakerTitle": "추뇨"
				},
				{
					"id": 750880313,
					"content": "안 되는 건 아니지만, 이번 달 지출이 이미 예산을 초과했다고 하지 않았어…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750880314,
					"content": "이미 초과한 거니까 얼마가 더 초과되든 문제없어…. 「빛새김 각문」의 조각을 손에 넣고 그 안의 내용을 해독하면 모라는 얼마든지 얻을 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880315,
						750880316
					],
					"speakerTitle": "추뇨"
				},
				{
					"id": 750880315,
					"content": "저희는 파편만 찾을 거예요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				},
				{
					"id": 750880317,
					"content": "너희가 「진짜」를 손에 넣을 수만 있으면 문제없어. 생각만 해도 화가 나는데, 이번 달에 내가 산 비밀근원 유적의 유물은 모두 다 가짜였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880318
					],
					"speakerTitle": "추뇨"
				},
				{
					"id": 750880318,
					"content": "아주 많은 모라를 뜯겼어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880319
					],
					"speakerTitle": "추뇨"
				},
				{
					"id": 750880319,
					"content": "아, 그래서 지출이 많아진 거구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880320
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750880320,
					"content": "그러니까 이번에는 「빛새김 각문」 조각으로 다시 일어서야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880321
					],
					"speakerTitle": "추뇨"
				},
				{
					"id": 750880321,
					"content": "부탁이야, 파편을 찾는 건 너희한테 맡길게! 찾으면 꼭 여기로 가져와 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880322
					],
					"speakerTitle": "추뇨"
				},
				{
					"id": 750880322,
					"content": "음, 그렇게 많이 필요한 건 아니고, 음… 3개, 아니 4개면 돼! 더 많으면 보수를 못 줄 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "추뇨"
				},
				{
					"id": 750880316,
					"content": "파편이 모두 유용하단 보장은 없어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				}
			]
		},
