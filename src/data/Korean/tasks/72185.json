			},
			"dialogs": [
				{
					"id": 721850301,
					"content": "돌아왔군요, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850302
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 721850302,
					"content": "어때요, 수확은 좀 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850303
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 721850303,
					"content": "손님의 피드백에 대해서…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850304
					]
				},
				{
					"id": 721850304,
					"content": "오리지널 「버섯피자」라… 음, 시도는 해볼 수 있겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850305
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 721850305,
					"content": "치즈와, 양배추, 버섯을 준비해야겠네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850306
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 721850306,
					"content": "다른 식자재는 다 있는데, 치즈는 가게에 많이 준비가 안 돼 있어서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850307
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 721850307,
					"content": "괜찮으면 치즈를 좀 부탁해도 될까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850308,
						721850310
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 721850308,
					"content": "맡겨줘요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850309
					]
				},
				{
					"id": 721850309,
					"content": "그럼 치즈 한 개만 부탁해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 721850310,
					"content": "평소에 치즈를 안 쓰나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850311
					]
				},
				{
					"id": 721850311,
					"content": "없는 게 아니라, 평소에 많이 안 써요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850312
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 721850312,
					"content": "저희 가게 음식에 치즈가 들어가는 음식이 많이 없어서 조금만 준비하거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850313
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 721850313,
					"content": "어쨌든 치즈 한 개만 부탁드리겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "키미나미 안나"
