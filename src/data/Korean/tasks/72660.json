			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"카야부키 잇케이"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600201,
					"content": "도착했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600202
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600202,
					"content": "이 수상한 문만 통과하면 백 명의 봉기의 결투장에 들어갈 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600203,
						726600204
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600203,
					"content": "정말 기대되네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				},
				{
					"id": 726600205,
					"content": "「텐구파」는 이미 공서양속을 어겨 사라졌지만, 비밀리에 가끔씩 백 명의 봉기를 진행하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600206
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600206,
					"content": "세계 각국에 마물과 싸움을 갈망하는 모험가, 전사들이 암암리에서 통쾌한 전투를 하려고 몰려들어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600207
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600207,
					"content": "뜻이 맞는 동료, 전우와 같이 참가해도 돼, 왜냐하면 「백인」 무대라서 사람이 많으면 많을수록 좋거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600208
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600208,
					"content": "자네는 보아하니 여러 곳을 여행하는 모험가니 같이 참가할 친구들이 많겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600209
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600209,
					"content": "당신은 참가 안 하나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600210
					]
				},
				{
					"id": 726600210,
					"content": "나? 난 구경 하러 갈 거야, 너흴 응원할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600211
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600211,
					"content": "사실, 내 목적은 최고의 격투 소설을 써서 야에 출판사의 「이 소설이 짱이야!」 부문 대상을 받는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600212
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600212,
					"content": "내 직감이 그러는데, 네가 격투 무대에서 엄청난 실력을 보여줄 거같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600213,
						726600214
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600213,
					"content": "노력해볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600215,
					"content": "소설 제목도 미리 생각해뒀어. 《백 명의 봉기~최강 무투 대회 편~》. 만약에 언젠가 야에 출판사 서점에서 이 책을 보게 된다면, 이방에서 온 금발의 전사가 등장하는 부분을 주목하라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600216
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600216,
					"content": "자네의 활약을 기대하겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600214,
					"content": "당연하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600204,
					"content": "정말 의심스럽네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				}
			]
		}
	]
}