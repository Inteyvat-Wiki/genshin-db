				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600101,
					"content": "안녕! 거기 이방인, 나랑 대결 한 번 할래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600102,
						726600104
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600102,
					"content": "저 산전수전을 다 겪은 전사에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600103
					]
				},
				{
					"id": 726600103,
					"content": "역시 난 사람 보는 눈이 있다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600106,
					"content": "사실은 최근에 누가 비밀리에 「백 명의 봉기」를 진행하고 있나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600107,
						726600109
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600107,
					"content": "백 명 보기?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600108
					]
				},
				{
					"id": 726600108,
					"content": "아니아니, 백 명의 봉기, 백 명 보기가 뭐야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600110
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600110,
					"content": "과거에 텐구의 「텐구파」를 모방했는데 전통 의식 같은 게 전해져 내려오고 있어, 간단하게 말하면——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600111
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600111,
					"content": "불경기 시기에 기분이 안 좋을 때나, 혹은 축하받을 일이 있을 때 혹은 단순히 심심할 때…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600112
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600112,
					"content": "통쾌한 전투를 통해 축하도 하고 스트레스도 풀고 하는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600113
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600113,
					"content": "언제든지 할 수 있을 거 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600114
					]
				},
				{
					"id": 726600114,
					"content": "…생각해 보니 맞는 말이군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600115
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600115,
					"content": "어쨌든, 자리를 옮겨서 말하자. 이곳은 사람이 많아 좀 그렇네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 726600109,
					"content": "자세히 알려주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600110
					]
				},
				{
					"id": 726600104,
					"content": "무슨 의뢰할 거라도 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600105
					]
				},
				{
					"id": 726600105,
					"content": "의뢰는 아니지만, 그냥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "카야부키 잇케이"
				}
			]
		},
		{
			"id": 7266002,
			"completionStepIds": [
				7266002
			],
