			"dialogs": [
				{
					"id": 741185001,
					"content": "#얼마든지 도와드릴게요, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185002,
						741185008,
						741185014
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741185002,
					"content": "이제 어쩌실 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185003
					]
				},
				{
					"id": 741185003,
					"content": "우리는 아직 저들의 정체를 파악하지 못했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185004
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741185004,
					"content": "신고는 했지만, 단서가 전혀 없어서 경찰도 제대로 된 조사를 시작하긴 어려워요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185005
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741185005,
					"content": "게다가 폰타인성은 너무 넓어요. 경찰이라고 해도 모든 곳에서 저희를 보호해 줄 순 없을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185006
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741185006,
					"content": "거기다… 카이아 씨까지 말려들었으니, 일이 더 복잡해졌어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185007
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741185007,
					"content": "가르시아 선생님이 카이아 씨가 서둘러 폰타인을 떠나도록 설득할 수 있었으면 좋겠네요. 그러면 저희도 원래 계획대로 움직일 수 있을 테니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "루통"
				},
				{
					"id": 741185008,
					"content": "가르시아 씨의 연구는 가망이 없는 거 아니었나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185009
					]
				},
				{
					"id": 741185009,
					"content": "「가망이 없다」는 건 더 이상 성능을 높일 여지가 없다는 뜻이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185010
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741185010,
					"content": "하지만 응용 분야에서는 「숫자 기계」의 전망이 꽤 좋죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185011
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741185011,
					"content": "다만 가르시아 선생님은 응용 분야에 관심을 가져본 적이 없어서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185012
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741185012,
					"content": "전 그것도 선생님이 힘들어하는 이유 중 하나일 거라고 생각해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185013
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741185013,
					"content": "하지만 덕분에 실의에 빠진 연구자의 역할을 아주 훌륭하게 맡고 계시죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "루통"
				},
				{
					"id": 741185014,
					"content": "이만 가볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185015
					]
				},
				{
					"id": 741185015,
					"content": "그럼 잘 부탁드립니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "루통"
				}
			]
		},
