					}
				]
			},
			"dialogs": [
				{
					"id": 741180201,
					"content": "이 오페라 하우스 정말 엄청나네요. 돈을 쓸어 담겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180202
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741180202,
					"content": "오페라 하우스라… 하아, 어서 일이나 하러 가자. 이 일만 끝내면 페트리코 마을로 돌아갈 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180203
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 741180203,
					"content": "그리고 마을에 빵집이나 차려야지. 다시는 숫자 기계를 거들떠보지도 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180204
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 741180204,
					"content": "헉… 선생님…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180205
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741180205,
					"content": "루통, 표정이 왜 그래? 무슨… 귀신이라도 본 사람처럼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180206
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 741180206,
					"content": "진짜… 귀신이다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180207
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 741180207,
					"content": "가르시아…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180208
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 741180208,
					"content": "카이아?! 카이아가 왜 여기에?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741180209,
					"content": "엄청난 우연이네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180210
					]
				},
				{
					"id": 741180210,
					"content": "선생님, 방금 그 말은 정말 실례였어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180211
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741180211,
					"content": "입 다물어, 루통",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180212
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 741180212,
					"content": "#가르시아, 여기서 만나다니 정말 반갑다. 그리고 {NICKNAME}도! 어디 보자, 오페라 하우스의 장부를 정리하러 온 거 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180213
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 741180213,
					"content": "설마 가르시아 씨가 의뢰를 받아들인 진짜 이유가 바로…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180214
					]
				},
				{
					"id": 741180214,
					"content": "그건 아니에요. 저희 극단은 여기서 공연하지 않거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180215
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 741180215,
					"content": "다만 제가 아는 가르시아는 여가 시간에 오페라나 보러 올 사람은 아니거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180216
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 741180216,
					"content": "그러니 오페라 하우스에 온 건… 일 때문이 아닐까 싶었던 거죠. 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180217
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 741180217,
					"content": "진심으로 저보다 카이아 씨가 선생님 곁에 더 잘 어울리는 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180218
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741180218,
					"content": "우리는 모두 대체할 수 없는 존재야, 루통",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180219
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 741180219,
					"content": "어… 그러니까… 카이아, 반가워. 나는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180220
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 741180220,
					"content": "…기분이 별로 안 좋아 보이는데 연구가 잘 안돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180221
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 741180221,
					"content": "어떻게 아셨어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180222
					]
				},
				{
					"id": 741180222,
					"content": "음, 적어도 저나 당신, 아니면 루통을 만나서 기분이 안 좋을 리는 없으니까요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180223
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 741180223,
					"content": "가르시아를 이렇게까지 침울하게 만들 수 있는 건 그 「숫자 기계」뿐이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180224
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 741180224,
					"content": "카이아는 어떻게 가르시아에 대해서 이렇게 잘 알아? 엄청 오랫동안 떨어져 있었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180225,
						741180226
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741180225,
					"content": "여자의 직감이라는 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				},
				{
					"id": 741180227,
					"content": "카페에서 천천히 이야기하시죠. 한두 마디로 설명할 수 있는 일이 아니잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180228
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741180228,
					"content": "나는… 으, 물론 기쁘지만… 하지만 우린…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180229
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 741180229,
					"content": "걱정하지 마세요, 선생님. 그런 단순 계산은 저 혼자서도 충분해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180230
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741180230,
					"content": "…그리고 우리 일이 끝날 때까지 카이아 씨를 기다리게 할 수는 없잖아요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180231
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741180231,
					"content": "역시 루통은 세심하다니까. 그럼 돌아오는 길에 네 커피도 사다 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180232
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 741180232,
					"content": "네, 감사합니다. 선생님이랑 즐거운 시간 보내세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180233
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741180233,
					"content": "가르시아와 카이아가 떠난다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180234
					]
				},
				{
					"id": 741180234,
					"content": "커피 마시러 가버렸네…. 처음부터 끝까지 우리랑은 아무 상관도 없는 일만 일어나는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180235,
						741180236
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741180235,
					"content": "아무 상관도 없지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180237,
					"content": "#아니에요, {NICKNAME}. 이제부터가 정식 의뢰라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180238,
						741180239,
						741180240
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741180238,
					"content": "어떤 식자재를 찾아올까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180241,
					"content": "농담도 참. 그런 일로 당신의 시간을 낭비할 생각은 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180242
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741180242,
					"content": "사실 가르시아 선생님과 전 상당히 위험한 상황에 처해있거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180243
					],
					"speakerTitle": "루통"
				},
				{
					"id": 741180243,
					"content": "에… 엥?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180244
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741180244,
					"content": "자리를 옮겨서 얘기하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "루통"
				},
				{
					"id": 741180239,
					"content": "어떤 부품을 찾아올까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180240,
					"content": "저 두 사람의 사진이라도 찍어줄까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180236,
					"content": "난 여기서 뭐 하고 있는 걸까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180226,
					"content": "가르시아 씨가 알기 쉬운 사람인 거지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				}
			]
		},
