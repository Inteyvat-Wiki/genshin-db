					"앤서니"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205110101,
					"content": "이 처방전, 진짜 효과 있을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110102
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205110102,
					"content": "무슨 일이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110103
					]
				},
				{
					"id": 205110103,
					"content": "여행자! 고민이 좀 있었는데 마침 잘 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110104
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205110104,
					"content": "사실은… 너 내 여동생 안나 기억하지? 안나는 투병 중이라 갖은 치료법을 다 동원해봤는데도 소용없었거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110105
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205110105,
					"content": "근데 리월항에 난치병을 잘 고치는 명의 한 분이 계시다는 소리를 듣고 사람을 시켜 처방전을 받아왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110106
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205110106,
					"content": "처방전에 적힌 재료들이 전부 이상하긴 하지만… 시도해 볼 수밖에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110107
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205110107,
					"content": "음, 어디 보자… 「풀 슬라임이 삼켰던 라즈베리」 1개를 구해다 줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110108,
						205110112,
						205110116
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205110108,
					"content": "정말 그런 게 있다고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110109
					]
				},
				{
					"id": 205110109,
					"content": "나도 몰라! 풀 슬라임이 라즈베리를 먹을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110110
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205110110,
					"content": "그, 그럼 부탁할게! 난 라즈베리가 자라면서 풀 슬라임이 출몰하는 곳을 알고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110111
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205110111,
					"content": "네가 가서 확인해 줘. 찾을 수 있으면 좋겠다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205110112,
					"content": "돌팔이 의사가 일을 그르치는 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110113
					]
				},
				{
					"id": 205110113,
					"content": "너도 그렇게 생각하지? 근데 나도 진짜 어쩔 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110114
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205110114,
					"content": "난 라즈베리가 자라면서 풀 슬라임이 출몰하는 곳을 알고 있어. 네가 가서 확인 좀 해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110115
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205110115,
					"content": "이 재료로 만든 약은 내가 먼저 먹어볼 거야. 어찌됐든 안나의 몸 상태가 더 악화되면 안 되니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205110116,
					"content": "못 찾으면 내가 풀 슬라임을 잡아다 줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110117
					]
				},
				{
					"id": 205110117,
					"content": "뭐? 나보고 직접 라즈베리를 풀 슬라임에게 먹이라는 거야…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110118
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205110118,
					"content": "한 번만 봐주라. 저번에 안나의 약을 채집할 때, 풀 슬라임 무리가 샘물 마을 안까지 쫓아왔었단 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110119
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205110119,
					"content": "난 라즈베리가 자라면서 풀 슬라임이 출몰하는 곳을 알고 있어. 네가 가서 확인 좀 해줘. 제발 찾을 수 있으면 좋겠다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110120
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205110120,
					"content": "근데… 정 안되면 안나를 위해… 푸, 풀 슬라임을 잡아와! 난 할 수 있어! 반드시 할 수 있다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "앤서니"
				}
			]
		},
