			},
			"dialogs": [
				{
					"id": 200490101,
					"content": "술이 당기네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490102
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 200490102,
					"content": "하지만 유리한테 술 마시는 걸 걸리기라도 하면 끝장이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490103
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 200490103,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490104
					]
				},
				{
					"id": 200490104,
					"content": "응? 아, 그게… 술이 좀 당기네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490105
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 200490105,
					"content": "내 아내 유리는 내가 술 마시는 꼴을 못 봐. 평소 집에서 술을 입에 댈 생각도 못한다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490106
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 200490106,
					"content": "아내가 시장에 갔을 때나 몰래 몇 잔 마시는 게 다야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490107
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 200490107,
					"content": "술을 너무 좋아하시는 거 아니에요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490108
					]
				},
				{
					"id": 200490108,
					"content": "그런 섭섭한 말을 하다니! 애주가인 몬드 사람으로서 당연한 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490109
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 200490109,
					"content": "부탁해, 나 술 한두 잔만 마시면 돼, 그러니 유리를 찾아 시간 좀 끌어줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490110
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 200490110,
					"content": "장을 볼 때 물건이 다양하기만 하면 돼. 유리는 고민하는 데에 시간을 많이 쓸 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490111
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 200490111,
					"content": "계속해서 선택지를 주면 끊임없이 고민하겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490112,
						200490114
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 200490112,
					"content": "알겠어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490113
					]
				},
				{
					"id": 200490113,
					"content": "하하하, 그럼 부탁해. 술운이 번창하길 바라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "니므롯"
				},
				{
					"id": 200490114,
					"content": "얼마나 마시려구요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490115
					]
				},
				{
					"id": 200490115,
					"content": "하하하, 그건 너한테 달렸지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490116
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 200490116,
					"content": "아, 아니, 난 그냥 조용히 한 잔만 마시면 충분해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490117
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 200490117,
					"content": "이건 몬드 주객의 약속이야, 부탁해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "니므롯"
				}
			]
		},
