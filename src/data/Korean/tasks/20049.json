			"dialogs": [
				{
					"id": 200490201,
					"content": "일몰 열매, 사과… 대체 뭘 사야 좋을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490202
					],
					"speakerTitle": "유리"
				},
				{
					"id": 200490202,
					"content": "흠, 니므롯이 있으면 그가 좋아하는 걸로 사면 되는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490203
					],
					"speakerTitle": "유리"
				},
				{
					"id": 200490203,
					"content": "죄송합니다, 유리 아가씨. 일몰 열매는 다 팔렸어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490204
					],
					"speakerTitle": "퀸"
				},
				{
					"id": 200490204,
					"content": "그래요? 어머, 그럼 사과를 사야겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490205
					],
					"speakerTitle": "유리"
				},
				{
					"id": 200490205,
					"content": "크흠, 유리 아가씨, 이 사과들은 별로 신선하지 않아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490206
					],
					"speakerTitle": "퀸"
				},
				{
					"id": 200490206,
					"content": "네? 그렇구나…. 하지만 다른 선택지가 없는걸요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490207
					],
					"speakerTitle": "유리"
				},
				{
					"id": 200490207,
					"content": "우리가 도와줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200490208,
					"content": "네? 당신들은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490209
					],
					"speakerTitle": "퀸"
				},
				{
					"id": 200490209,
					"content": "저희에게 맡겨주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490210
					]
				},
				{
					"id": 200490210,
					"content": "우리가 신선한 <color=#00E1FFFF>일몰 열매</color>를 가지고 돌아올 테니까, 걱정 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200490211,
					"content": "그, 그럴래? 그럼 부탁할게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490212
					],
					"speakerTitle": "퀸"
				},
				{
					"id": 200490212,
					"content": "너무 잘됐다, 니므롯도 일몰 열매를 더 좋아하는데, 그럼 난 여기서 기다릴게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "유리"
				}
			]
		},
