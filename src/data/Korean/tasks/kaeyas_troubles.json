				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610101,
					"content": "아… 젠장… 골치 아프네…. 이걸 어떡한다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610102,
						4610103
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610102,
					"content": "왜 그래요, 케이아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				},
				{
					"id": 4610104,
					"content": "#오, 천풍이시여 고맙습니다. {NICKNAME}, 네가 나타난 건 분명 신이 내게 내린 축복일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610105
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610105,
					"content": "바람의 신이 보낸 구세주여, 시간 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610106
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610106,
					"content": "으… 느끼해, 닭살 돋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610107,
						4610109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4610107,
					"content": "시간이 없는 건 아니지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610108
					]
				},
				{
					"id": 4610108,
					"content": "다행이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610110
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610110,
					"content": "사실… 기사단 동료들이 알아선 안 될 문제라…네가 도와줬으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610111
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610111,
					"content": "그래서 말인데 조용한 곳으로 가서 얘기하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610112
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610112,
					"content": "기사단 건물 옆의 정원에 가서 얘기하는 게 어때? 날 따라와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610113
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610113,
					"content": "도대체 뭐길래 이렇게 조심스러워 하는 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4610109,
					"content": "일단 무슨 일인지 말해주실래요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610110
					]
				},
				{
					"id": 4610103,
					"content": "당황하다니 케이아 씨 답지 않네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				}
			]
		},
		{
			"id": 46102,
			"completionStepIds": [
				46109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46109",
							"2"
						],
						"stepId": 46109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"케이아"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610201,
					"content": "좋아, 여기서 얘기하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610202
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610202,
					"content": "뜸 들이지 말고 이제 무슨 일인지 말해 볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4610203,
					"content": "어디서부터 말을 꺼내야 할까…. 아! 우선 비밀 하나 알려줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610204
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610204,
					"content": "내 과거와 관련된 비밀이니까 절대 다른 사람에게 말하면 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610205
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610205,
					"content": "나 입 진짜 무거우니까, 걱정 붙들어 매!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4610206,
					"content": "사실… 내 할아버지는… 해적이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610207
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610207,
					"content": "ㅇㅇ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4610208,
					"content": "…이 영혼없는 대답은 뭐야. 혹시 내 말을 못 믿는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610209
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610209,
					"content": "봐! 내가 차고 있는 안대가 바로 할아버지의 유전이야. 이게 바로 가족이라는 증거고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610210,
						4610213
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610210,
					"content": "안대도 유전되나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610211
					]
				},
				{
					"id": 4610211,
					"content": "#하하하, {NICKNAME}, 넌 진짜 아무것도 모르는구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610212
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610212,
					"content": "이건 많은 아이들의 땋은 머리가 엄마한테 유전되는 것과 같은 이치야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610214
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610214,
					"content": "어젯밤에 할아버지가 남긴 수첩을 읽다가 우연히 <color=#00E1FFFF>보물</color>에 관한 정보를 발견했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610215
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610215,
					"content": "보… 보물?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4610216,
					"content": "수첩에 적혀 있는 내용에 의하면 보물이 「잃어버린 아카디아 유적」에 숨겨져 있는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610217
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610217,
					"content": "보물…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4610218,
					"content": "근데… 유적의 정확한 위치에 대한 단서는 아무것도 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610219
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610219,
					"content": "보물!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4610220,
					"content": "케이아! 어떤 보물이야? 황금? 보석? 말해 봐! 어떤 보물이냐구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4610221,
					"content": "흐흥, 황금이랑 보석만 있는 건 삼류 보물일 뿐이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610222
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610222,
					"content": "내 할아버지의 진짜 보물은 바로 「검」이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610223
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610223,
					"content": "검자루를 잡기만 해도 무적의 힘을 가질 수 있다는 신검이라는 소문이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610224
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610224,
					"content": "우와~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610225
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4610225,
					"content": "셀레스티아에 계시는 신이 실수로 바다에 빠트린 검을 할아버지가 운 좋게 건진 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610226
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610226,
					"content": "검자루를 움켜쥔 순간 마른 하늘에 천둥번개가 치고 거대한 해일이 일어나면서 폭풍이 불기 시작했다나 뭐라나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610227
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610227,
					"content": "할아버지는 신검의 힘을 빌려 머리가 8개 달린 바다뱀과 은발 밴쉬, 심연의 마룡들을 물리쳤지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610228
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610228,
					"content": "하지만 너무 강한 힘 때문에, 다른 해적들이 계속 호시탐탐 노렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610229
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610229,
					"content": "할아버지는 분쟁을 피하기 위해 신검을 숨길 수밖에 없었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610230,
						4610232
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610230,
					"content": "머리가 8개 달린 뱀, 은발 밴쉬…. 전부 실존하는 거였군요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610231
					]
				},
				{
					"id": 4610231,
					"content": "이 세상엔 아직 미지의 것이 많아서 재밌는 게 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610233
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610233,
					"content": "믿기 어려울 정도로 멋진 모험은 해적만이 누릴 수 있는 낭만이지, 안 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610234
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610234,
					"content": "우~~~~와!! 진짜 대단해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610235
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4610235,
					"content": "최근 한 <color=#00E1FFFF>보물 사냥단</color>이 기승을 부리면서 수많은 유적의 유물을 도둑맞았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610236
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610236,
					"content": "내가 걱정되는 건 그놈들이 「아카디아 유적」을 찾아내서 그 신검을 가지게 된다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610237
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 4610237,
					"content": "절대 안 돼! 나쁜 놈들이 가질 바에 우리가 가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610238
					],
					"speakerTitle": "페이몬"
				},
