				"points": []
			},
			"dialogs": [
				{
					"id": 726930401,
					"content": "꽃에서 연인으로 이어지는 연상은 어느 나라나 비슷하군요. 이 시구의 의미는 첫사랑을 기억하는 것처럼 이나즈마의 풍경을 기억하라는 의미죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "레네"
				}
			]
		},
		{
			"id": 7269305,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
