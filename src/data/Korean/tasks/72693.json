				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930201,
					"content": "#{M#젊은이}{F#아가씨}, 사진은 어떻게 됐나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930202
					],
					"speakerTitle": "오오토모"
				},
				{
					"id": 726930202,
					"content": "여기요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930203
					]
				},
				{
					"id": 726930203,
					"content": "고마워, 정말 고맙군. 이 소재들이라면 충분히 만족할 만한 시를 쓸 수 있을 것 같군. 음, 어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930204
					],
					"speakerTitle": "오오토모"
				},
				{
					"id": 726930204,
					"content": "#{M#젊은이}{F#아가씨}, 자네의 사진에 따라 시구를 좀 써봤네. 괜찮다면 구체적으로 어떤 시구를 선택하면 좋을지 자네가 선택해 주게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "오오토모"
				}
			]
		},
		{
