					"레네"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930501,
					"content": "이 시구에서 열매는 슬픈 일을 나타내는 말이겠군요. 술을 처음 마시거나, 시를 처음 읽는 것처럼 즐거운 기억은 아니지만, 곧 다가올 이별만큼이나 인상적이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "레네"
				}
			]
		},
		{
