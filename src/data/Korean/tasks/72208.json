			"dialogs": [
				{
					"id": 722080201,
					"content": "정말 고마워! 드디어 마음 놓고 배에 탈 수 있겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080202
					],
					"speakerTitle": "이페"
				},
				{
					"id": 722080202,
					"content": "그 배의 목적지는 어디인가요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080203
					]
				},
				{
					"id": 722080203,
					"content": "황금의 땅, 꿈의 땅. 안개가 없는 나라… 꿈에서 또 만날 수 있을 걸세, 친구",
