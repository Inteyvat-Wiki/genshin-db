			"dialogs": [
				{
					"id": 205210301,
					"content": "이 「크림 스튜」를 받으세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210302
					]
				},
				{
					"id": 205210302,
					"content": "해리스 씨가 보내서 왔구나, 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210303
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 205210303,
					"content": "이렇게 맛있는 음식을 먹다가 건량은 못 먹게 될지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210304
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 205210304,
					"content": "하하하, 농담이야. 난 모험가니까 고생해야 할 땐 고생해야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210305
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 205210305,
					"content": "설산 깊숙이 들어갈 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210306
					]
				},
				{
					"id": 205210306,
					"content": "그야 물론이지. 여긴 베이스캠프일 뿐이야. 적당한 때가 되면 더 안쪽에 야영지를 세울 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210307
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 205210307,
					"content": "그때는 따뜻한 요리를 먹을 기회가 없겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210308
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 205210308,
					"content": "하지만 무모하게 움직이진 않을 거야. 한동안 관찰한 후에 베이스캠프로 돌아와 구체적인 계획을 세우고 나서 결정해야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210309
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 205210309,
					"content": "요리를 배달해줘서 고마워. 이건 보수라고 생각하고 받아둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "옥희"
				}
			]
		},
