			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"하니야"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400850401,
					"content": "어떻게 이런 일이… 「화염 1호」, 왜 전력으로 싸우지 않는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850402,
						400850403
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 400850402,
					"content": "명령을 내린 건 당신이었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850404
					]
				},
				{
					"id": 400850404,
					"content": "그러니까 「화염 1호」를 혼내지 말고 너도 너무 무리하지 마. 준결승 때도 「화염 1호」가 다쳐서 공격을 망설였잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400850405,
					"content": "지금까지 우리와 미코처럼 강력한 상대와 대결한 적이 없었던 거지? 「화염 1호」와 다른 파트너들이 이런 고전을 치르는 것도 처음이고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400850406,
					"content": "정작 「화염 1호」와 다른 파트너들이 부상을 입으니까 너도 마음이 아팠잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400850407,
					"content": "무리하지 말라고? 아직도 내가 버섯몬의 부상 따위에 흔들린다고 생각해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850408,
						400850409
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 400850408,
					"content": "이건 우리의 억측이 아니에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850410
					]
				},
				{
					"id": 400850410,
					"content": "넌 어려서부터 무서운 이야기를 듣고 자랐으니까 버섯몬에 대해 부정적인 생각을 가지는 것도 충분히 이해가 가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400850411,
					"content": "하지만 불확실한 추측으로 지금 바로 눈앞에 있는 파트너를 포악한 적으로 대한다면… 시간이 흐를수록 점점 흔들리게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850412
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400850412,
					"content": "우리도 종종 포악한 버섯몬을 토벌하곤 해. 우리도 버섯몬을 단순히 마물이라고만 생각했고 이 경기에 참여한 것도 버섯몬들이 소란을 일으키는 걸 막기 위해서였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400850413,
					"content": "하지만 「둥둥 모자」를 만나고 생각이 바뀌었어. 온순한 버섯몬을 진심으로 대한다면 버섯몬도 우리의 마음을 알아주고 서로 우호적인 관계가 될 수 있다는 걸 알았으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400850414,
					"content": "적어도 이 온순한 버섯몬들은 네 파트너야. 이용하는 상대이거나 적이 아니라고! 네가 「화염 1호」와 다른 파트너들을 믿어주면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400850415,
						400850416
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400850415,
					"content": "지금처럼 극단적인 생각을 버리고",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850417
					]
				},
				{
					"id": 400850417,
					"content": "그만! 아직 경기는 끝나지 않았어. 이미 승자라도 된 듯 설교하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하니야"
				},
				{
					"id": 400850416,
					"content": "버섯몬을 좀 더 이성적으로 대했으면 좋겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850417
					]
				},
				{
					"id": 400850409,
					"content": "당신이 인정하고 싶지 않은 것뿐이겠죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850410
					]
				},
				{
					"id": 400850403,
					"content": "당신이 마음 약해진 거라고요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400850404
					]
				}
			]
		},
		{
			"id": 4008505,
			"completionStepIds": [
				4008505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
