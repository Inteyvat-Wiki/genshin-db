				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400851501,
					"content": "#{NICKNAME}, 페이몬, 이 날을 얼마나 기다렸는지 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851502
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 400851502,
					"content": "내가 말했었지? 버섯몬한테 쓸데없는 감정 주지 말라고. 녀석들을 이용하고 지휘하기만 하면 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851503
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 400851503,
					"content": "보아하니 생각이 바뀌진 않았나 보네. 경기가 아주 싱겁게 끝나겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851504,
						400851505
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 400851504,
					"content": "생각을 바꿔야 하는 건 당신이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851506
					]
				},
				{
					"id": 400851506,
					"content": "맞아! 「둥둥 모자」와 다른 파트너들이 있는 한 절대 지지 않아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400851507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400851507,
					"content": "휴… 내가 직접 보여주지. 너희들의 그 연약한 전략과 진짜 훈련사 사이의 격차를 말이야… 「화염 1호」!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하니야"
				},
				{
					"id": 400851505,
					"content": "실력으로 당신을 설득할 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400851506
					]
				}
			]
		},
		{
			"id": 4008516,
			"completionStepIds": [
				4008517
			],
			"beginWay": "TALK_BEGIN_MANUAL",
