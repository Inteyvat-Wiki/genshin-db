			"dialogs": [
				{
					"id": 221030101,
					"content": "정말 귀찮네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030102
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221030102,
					"content": "왜요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030103
					]
				},
				{
					"id": 221030103,
					"content": "엥? 손님이야? 미안, 요즘에 객잔 주변이 좀 이상해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030104
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221030104,
					"content": "손님들이 근처에서 마물의 습격을 받았거든. 그것 때문에 몇몇 손님은 찾아올 엄두도 못 내고 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030105
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221030105,
					"content": "계속 이렇게 가다간 분명 큰 문제가 생길 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030106
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221030106,
					"content": "흠, 보아하니 여행자 같은데…. 나 대신 주변을 한번 둘러보지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030107,
						221030108
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221030107,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030109
					]
				},
				{
					"id": 221030109,
					"content": "도와준다니 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221030113,
					"content": "아무튼, 보수는 지급할 테니까 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221030108,
					"content": "마물 때문에 위험한 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030110
					]
				},
				{
					"id": 221030110,
					"content": "마물 때문에 위험한 거냐고? 아니, 마물은 부차적인 문제일 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030111
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221030111,
					"content": "마물이 그분의 심기를 거스를까 봐 그러는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030112
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221030112,
					"content": "그분은 마물을 상대할 땐 주변을 전혀 신경 쓰지 않거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "베르 고데트"
				}
			]
		},
