					"nextDialogs": [
						221030203
					]
				},
				{
					"id": 221030203,
					"content": "빨리해줘. 그분은 귀신처럼 왔다 가니까… 언제 돌아올지 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030204
