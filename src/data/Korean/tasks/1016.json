			},
			"dialogs": [
				{
					"id": 10160301,
					"content": "응광… 감우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160302
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10160302,
					"content": "암류가 흐르던 이 며칠 동안, 그들은 도대체 어디에 있던 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "종려"
				}
			]
		},
		{
			"id": 101610,
			"completionStepIds": [
				101610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101610",
							"2"
						],
						"stepId": 101610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"종려"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10161001,
					"content": "그 감우라는 사절은 몇 마디 하더니 사라져버렸네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161002
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10161002,
					"content": "그나저나 우리가 「리월 칠성」의 초청을 받다니. 꿈이야 생시야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161003
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10161003,
					"content": "#{NICKNAME}! 엄청난 부자랑 만나는 거니까 예의 바르게 행동해야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161004,
						10161005
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10161004,
					"content": "난 원래 예의 바른데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				},
				{
					"id": 10161006,
					"content": "하하… 확실히 「군옥각」에 초청되는 행운이 주어진 자는 드물지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161007
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10161007,
					"content": "어서 가봐. 하지만 「송신의례」를 잊어선 안 돼. 군옥각에서 돌아오면 적화주에서 만나자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161008
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10161008,
					"content": "응. 그럼 그때 적화주에서 만나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10161005,
					"content": "또 무슨 꿍꿍이야, 페이몬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				}
			]
		}
	]
}