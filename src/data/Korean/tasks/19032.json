				],
				"points": []
			},
			"dialogs": [
				{
					"id": 1903203101,
					"content": "으… 으으…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203102
					],
					"speakerTitle": "첸첸"
				},
				{
					"id": 1903203102,
					"content": "#저기 {M#오빠}{F#언니}, 첸첸이 좀 도와주면 안 돼요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203103,
						1903203104
					],
					"speakerTitle": "첸첸"
				},
				{
					"id": 1903203103,
					"content": "도와달라고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				},
				{
					"id": 1903203105,
					"content": "저 파란 머리의 도사, 너무 무서워요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203106
					],
					"speakerTitle": "첸첸"
				},
				{
					"id": 1903203106,
					"content": "좀 멀리 데려가 주면 안 될까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203107,
						1903203108
					],
					"speakerTitle": "첸첸"
				},
				{
					"id": 1903203107,
					"content": "너도 양의 체질에 영향을 받니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203109,
					"content": "저는 가까이 갈 수 없어요. 저 사람 몸속에서 나오는 그 무서운 힘이 절 사라지게 할 거라구요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203110
					],
					"speakerTitle": "첸첸"
				},
				{
					"id": 1903203110,
					"content": "아직 사라지고 싶지 않아요. 그러니까 제발 부탁해요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203111,
						1903203112
					],
					"speakerTitle": "첸첸"
				},
				{
					"id": 1903203111,
					"content": "중운 눈에는 너도 요마이려나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203113,
					"content": "그럼 이렇게 해요. 저한테 방법이 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203114
					],
					"speakerTitle": "첸첸"
				},
				{
					"id": 1903203114,
					"content": "방금 멀리서 파란 머리의 도사가 누군가와 다투는 걸 봤어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203115
					],
					"speakerTitle": "첸첸"
				},
				{
					"id": 1903203115,
					"content": "첸첸이가 귀찮은 사람을 전부 쫓아줄 테니까, 그 도사한테 절 못 본 척해달라고 해주세요, 네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203116,
						1903203118
					],
					"speakerTitle": "첸첸"
				},
				{
					"id": 1903203116,
					"content": "정말이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203117
					]
				},
				{
					"id": 1903203117,
					"content": "그럼요. 첸첸이가 한 말은 전부 사실이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "첸첸"
				},
				{
					"id": 1903203120,
					"content": "어때요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203121
					],
					"speakerTitle": "첸첸"
				},
				{
					"id": 1903203121,
					"content": "확답은 못 줘. 상황 설명만 해줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203122
					]
				},
				{
					"id": 1903203122,
					"content": "네, 그럼 오케이한 거죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203123
					],
					"speakerTitle": "첸첸"
				},
				{
					"id": 1903203123,
					"content": "저 파란 머리 도사가 좋은 사람이었으면 좋겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203124
					],
					"speakerTitle": "첸첸"
				},
				{
					"id": 1903203124,
					"content": "첸첸이가 그를 돕고 나면… 당신이 첸첸이도 좀 도와주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "첸첸"
				},
				{
					"id": 1903203118,
					"content": "그건 나도 할 수 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203119
					]
				},
				{
					"id": 1903203119,
					"content": "음, 근데 귀찮잖아요. 저한테 좋은 방법이 있어요. 첸첸이 좀 믿어주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "첸첸"
				},
				{
					"id": 1903203112,
					"content": "내 멋대로 결정할 수 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203108,
					"content": "어쩐지 오늘 네가 안 보이더라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203104,
					"content": "왜 나한테?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				}
			]
		}
	]
}