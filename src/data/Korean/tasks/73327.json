			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"제트"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733270101,
					"content": "#{NICKNAME}?! 너였구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270102
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270102,
					"content": "페이몬도 있었네? 이런 곳에서 만나다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270103
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270103,
					"content": "제트! 진짜 제트다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733270104,
					"content": "하하, 목소리 좀 낮춰! 물고기가 도망가겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270105
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270105,
					"content": "삐삐——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270106
					],
					"speakerTitle": "붐붐"
				},
				{
					"id": 733270106,
					"content": "앗… 낚시 중이야? 근데 낚싯대는 어쩌고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733270107,
					"content": "삐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270108
					],
					"speakerTitle": "붐붐"
				},
				{
					"id": 733270108,
					"content": "#붐붐, 그게 무슨 말이야! {NICKNAME}, 우리 다른 얘기나 할까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270109,
						733270121
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270109,
					"content": "낚싯대는 어쨌어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270110
					]
				},
				{
					"id": 733270110,
					"content": "아잇, 정말…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270111
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270111,
					"content": "어쩌다 보니… 부러졌어…. 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270112
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270112,
					"content": "후우… 낚시가 사냥이랑 이렇게 다를 줄은 몰랐어. 너무 어려워! 가만히 앉아서 물고기를 기다리느니 차라리 물에 들어가 직접 잡는 게 낫지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270113
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270113,
					"content": "그래서 잡았어? 못 잡았지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733270114,
					"content": "훗, 당연히 아주 큰 놈을 잡았지. 크기가 너에다가… 붐붐의 절반을 합친 정도였달까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270115
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270115,
					"content": "삐삐! 삐삐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270116
					],
					"speakerTitle": "붐붐"
				},
				{
					"id": 733270116,
					"content": "근데 다 구워 먹어서 네 몫은 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270117
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270117,
					"content": "삐삐…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270118
					],
					"speakerTitle": "붐붐"
				},
				{
					"id": 733270118,
					"content": "음, 붐붐도 같이 먹었어. 그치만 네 몫은 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270119
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270119,
					"content": "못 믿겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733270120,
					"content": "하하하하! 안 믿으면 너만 손해지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270125,
					"content": "요즘 어떻게 지냈어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270126
					]
				},
				{
					"id": 733270126,
					"content": "응? 잘 지냈지. 걱정 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270127
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270127,
					"content": "혼자 여행하는 게 한두 번도 아니고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270128
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270128,
					"content": "삐삐! 삐삐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270129
					],
					"speakerTitle": "붐붐"
				},
				{
					"id": 733270129,
					"content": "하하하! 그래, 너도 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270130
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270130,
					"content": "타니트 사건 이후로 그 어떤 사막 부족도 내게 텐트와 음식을 안 내어주지 뭐야…. 더 이상 날 보호해주지 않겠다는 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270131
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270131,
					"content": "나중에는… 「30인단」의 루크 샤 두목이 날 받아줬지만… 도시 생활은 불편하기도 하고, 자꾸 어머니 생각도 나서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270132
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270132,
					"content": "수메르성을 떠나 다른 나라에 가서 색다른 경치나 보자고 생각한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270133
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270133,
					"content": "그렇게 상선을 타고 정신을 차려 보니 이곳에 도착해 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270134
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270134,
					"content": "그 이후라… 하하, 딱히 얘기할 게 없네! 경호원은 어디서든 필요하잖아. 이런 캐러밴이 오가는 대도시에선 더더욱 그렇고! 덕분에 잘 지내고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270135
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270135,
					"content": "헤헤, 이렇게 세상을 집 삼아 사는 것도 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270136
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270136,
					"content": "나랑 붐붐이 꼭 너랑 페이몬 같지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270137
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270137,
					"content": "흥, 붐붐보단 내가 낫지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270138
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733270138,
					"content": "삐삐!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270139
					],
					"speakerTitle": "붐붐"
				},
				{
					"id": 733270139,
					"content": "#하하, 그래그래… {NICKNAME}, 더는 시간 뺏지 않을게. 밥이라도 사주고 싶은데 호송국 규정 때문에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270140
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270140,
					"content": "크흠! 심란한 이야기는 이쯤할게! 앞으로의 여정이 순조롭기를 진심으로 바랄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270141
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270141,
					"content": "#{M#우린 언젠간 꼭 다시 만나게 될 거란 걸 명심해!}{F#…전에 타니트에서 했던 말을 절대 잊어버리지 마. 언제든 지치고 힘들어서 쉬고 싶을 때가 되면… 우린 다시 만나게 될 거야}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "제트"
				},
				{
					"id": 733270121,
					"content": "여기서 다 만나네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733270122
					]
				},
				{
					"id": 733270122,
					"content": "그, 그러게…. 나도 이렇게 만날 줄은 몰랐어. 이렇게 보니 너무 좋다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270123
					],
					"speakerTitle": "제트"
				},
				{
					"id": 733270123,
					"content": "헤헤, 내가 낚시… 아니, 고기 잡는 걸 방해한 건 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 733270124,
					"content": "조용히 해, 페이몬! 하여간 넌 입이 방정이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733270125
					],
					"speakerTitle": "제트"
				}
			]
		},
		{
