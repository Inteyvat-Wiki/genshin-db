			"dialogs": [
				{
					"id": 701430201,
					"content": "여행자, 안녕! 요즘 모험은 할 만해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430202
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 701430202,
					"content": "할만해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430203
					]
				},
				{
					"id": 701430203,
					"content": "나도 네가 한 일들을 들었어. 이런 추세로 가면 분명 뛰어난 모험가가 될 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430204
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 701430204,
					"content": "그리고… 나한테 「모험 정보」가 하나 있는데, 혹시 관심 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430205
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 701430205,
					"content": "또 새로운 의뢰 있는 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430206
					]
				},
				{
					"id": 701430206,
					"content": "이제 길드에 대해 완전 빠삭하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430207
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 701430207,
					"content": "근데 이번엔 의뢰가 아니라 「모험 정보」야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430208
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 701430208,
					"content": "이 「모험 정보」는 몬드 옆의 그 「드래곤 스파인」에 관련된 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430209
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 701430209,
					"content": "길드에서 그곳에 야영지를 세워놨어. 많은 모험가들이 거기 가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430210
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 701430210,
					"content": "장소는 지도에 표시해 줬어. 야영지에 도착하면 먼저 「옥희」라는 모험가한테 주변 상황에 대해 물어봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430211
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 701430211,
					"content": "그럼 열심히 해봐. 별과 심연을 향해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐서린"
				}
			]
		}
	]
