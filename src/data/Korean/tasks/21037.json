					"손우"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370301,
					"content": "고마워, 이 정도면 충분하겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370302,
						210370305
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210370302,
					"content": "기분이… 별로 안 좋아 보이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370303
					]
				},
				{
					"id": 210370303,
					"content": "응? 아무것도 아니야. 하하하… 창피한 모습을 보였군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370304
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210370304,
					"content": "그냥 좀, 평생을 살아온 리월을 떠나려니 발이 떨어지질 않아서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "손우"
				},
				{
					"id": 210370305,
					"content": "언제 출발하세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370306
					]
				},
				{
					"id": 210370306,
					"content": "물자가 준비되면 바로 떠나려고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370307
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210370307,
					"content": "아, 전에 같이 층암거연에 갔던 그 모험가도 함께 갈 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370308
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210370308,
					"content": "폰타인에 간다는 이야기를 듣더니 본인도 관심이 있다며 동행하겠다더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370309
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210370309,
					"content": "그 상인은 자신을 지켜줄 모험가가 늘었다며 좋아했지만… 사실 난 이렇게 활발한 사람은 버거워, 어휴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370310
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210370310,
					"content": "내게도 고향을 떠날 날이 올 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "손우"
				}
			]
		},
		{
			"id": 2103704,
			"completionStepIds": [],
