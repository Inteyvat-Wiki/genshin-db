				]
			},
			"dialogs": [
				{
					"id": 401460101,
					"content": "안녕하세요, 전 수메르에서 온 여행 상인 아텝이라고 해요. 만나서 반가워요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460102
					],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460102,
					"content": "와, 엄청 멀리서 왔네? 우리 가게가 벌써 그렇게 유명해진 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460103,
						401460105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401460103,
					"content": "다 페이몬 덕분이지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460104
					]
				},
				{
					"id": 401460104,
					"content": "우후후후, 이 몸이 바로 떠오르는 판매왕 페이몬이라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401460106,
					"content": "아하하, 확실히 요즘 소식 빠른 상인들 사이에선 두 분의 연금 포션이 화두예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460107
					],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460107,
					"content": "이렇게 인지도가 없는 상품을 파는 모험은 잘들 안 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460108
					],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460108,
					"content": "하지만 전 큰돈을 벌려면 사업 기회를 선점해야 한다고 생각해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460109
					],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460109,
					"content": "지금은 연금 포션에 대한 사람들의 이해도가 높지 않지만, 판매 수단에 따라 판로를 넓히면 모라가 끝없이 들어올 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460110
					],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460110,
					"content": "유명해지기만 하면 판매가가 열 배로 뛸 수도 있을 거고… 그럼 한 건만 제대로 뛰어도 연말까지 푹 쉴 수 있겠죠. 하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460111
					],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460111,
					"content": "10배라고?! 정말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401460112,
					"content": "후후, 사는 사람만 있으면 부르는 게 값이죠. 서로의 필요를 충족해 주는 거니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460113
					],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460113,
					"content": "그 말을 들으니까 머리가 온통 모라 생각뿐인 녀석이 떠오르네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401460114,
					"content": "아 맞다, 너 수메르에서 왔댔지? 그럼 도리랑도 아는 사이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401460115,
					"content": "도리요? 설마 도리·산게마 바이 어르신을 말하시는 건가요? 설마 그 위대한 분을 아세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460116,
						401460117
					],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460116,
					"content": "친구예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460118,
					"content": "대단해요! 산게마 바이 어르신은 제 우상이거든요! 그분의 사업 감각과 모라를 향한 집착은 늘 제 삶의 원동력이 되고 있죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460119
					],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460119,
					"content": "전에 카자르자레궁을 방문한 적이 있는데, 정말 웅장하고 아름다운 저택이었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460120
					],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460120,
					"content": "언젠간 저도 그분처럼 써도 써도 끝이 없는 모라를 벌 거예요, 헤헤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460121
					],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460121,
					"content": "허허… 완전히 꿈속에 빠져버린 거 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460122,
						401460124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401460122,
					"content": "꼭 성공하길 바랄게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460123
					]
				},
				{
					"id": 401460123,
					"content": "응원해 주셔서 감사해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460126,
					"content": "그럼 큰돈을 벌 방법에 대해 얘기해 볼까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460127
					],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460127,
					"content": "사실 엄청 간단해요. 제가 여기서 정기적으로 필요한 포션을 구입한 다음 다른 곳에 가져다 파는 거죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460128
					],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460128,
					"content": "저랑 협력하시겠다면, 이번에 판매할 포션에 대해 구체적으로 논의해 봐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460129,
						401460131
					],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460129,
					"content": "필요한 포션을 확인해 보죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460130
					]
				},
				{
					"id": 401460130,
					"content": "제 예리한 촉에 의하면 이번에 시장에서 필요로 할 포션은 이거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460131,
					"content": "나중에 다시 얘기하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460132
					]
				},
				{
					"id": 401460132,
					"content": "돈 벌 기회는 한번 놓치면 돌아오지 않아요~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460124,
					"content": "다시 본론으로 돌아가죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460125
					]
				},
				{
					"id": 401460125,
					"content": "크흠, 잠시 말이 딴 데로 샜네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "아텝"
				},
				{
					"id": 401460117,
					"content": "전에 만난 적이 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460105,
					"content": "그동안 다 함께 노력한 결과라고 볼 수 있지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460106
					]
				}
			]
		},
