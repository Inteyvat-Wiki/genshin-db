					"로위"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240050101,
					"content": "형, 빨리! 이리로 가자! 저쪽에 있는 커다란 건물, 우리 처음 보는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050102
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240050102,
					"content": "천천히 가, 베루. 그러다 또 넘어질라. 로위도 마찬가지야. 너희 아빠가 너 몸 약하니까 감기 걸리지 않게 조심하라고 그러셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050103
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240050103,
					"content": "으엑, 너네 형 잔소리 장난 아니다. 우리 엄마랑 똑같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050104
					],
					"speakerTitle": "로위"
				},
				{
					"id": 240050104,
					"content": "내 말이 그 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050105
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240050105,
					"content": "이것들이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050106,
						240050107
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240050106,
					"content": "또 만났네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				},
				{
					"id": 240050108,
					"content": "#{M#오빠}{F#언니}, 안녕! 또 만났네! 이번에는 숨바꼭질 안 하고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050109
					],
					"speakerTitle": "로위"
				},
				{
					"id": 240050109,
					"content": "정확히 말하자면 방금 전에 놀다가… 누어 누나한테 한소리 들었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050110
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240050110,
					"content": "누어 언니는 일할 땐 엄청 엄해서 맨날 누구를 혼내고 있다니까! 내가 전에 쿠키까지 줬는데도 말이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050111
					],
					"speakerTitle": "로위"
				},
				{
					"id": 240050111,
					"content": "뭐, 됐어. 어차피 피곤해서 오렐이랑 베루를 데리고 맛있는 거 먹으러 가려던 참이었으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050112
					],
					"speakerTitle": "로위"
				},
				{
					"id": 240050112,
					"content": "#{M#오빠}{F#언니}, 혹시 우리랑 같이… 으음… 그걸 뭐라고 하더라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050113
					],
					"speakerTitle": "로위"
				},
				{
					"id": 240050113,
					"content": "산책?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050114
					],
					"speakerTitle": "오렐"
				},
				{
					"id": 240050114,
					"content": "맞아! 우리랑 산책하지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050115
					],
					"speakerTitle": "로위"
				},
				{
					"id": 240050115,
					"content": "우리 저쪽에 있는 광장으로 가보자. 나 분수 보고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050116,
						240050117
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240050116,
					"content": "그럼 안내 부탁할게, 꼬마 아가씨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050118,
					"content": "알았어. 그럼… 우선 광장으로 가보자. 안쪽에 분수대가 엄청 예쁘거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "로위"
				},
				{
					"id": 240050117,
					"content": "그럼 안내 부탁할게, 꼬마 친구들",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050107,
					"content": "여기서 뭐 해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				}
			]
		},
		{
