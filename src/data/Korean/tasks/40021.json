			"dialogs": [
				{
					"id": 400210301,
					"content": "신염, 여행자, 페이몬!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210302
					],
					"speakerTitle": "「시키 대장」"
				},
				{
					"id": 400210302,
					"content": "방금 여장성 한 명이 사람을 데리고 근처에 정찰을 왔소",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210303
					],
					"speakerTitle": "「시키 대장」"
				},
				{
					"id": 400210303,
					"content": "그 사람은 텐료 봉행의 쿠죠 사라야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400210304,
					"content": "쿠죠 사라… 텐료 봉행에 그런 자가 있었나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210305
					],
