			},
			"dialogs": [
				{
					"id": 400210101,
					"content": "여행자, 페이몬!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210102
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400210102,
					"content": "방금 쿠죠 사라 씨가 왔어. 저쪽이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210103
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400210103,
					"content": "갔다가 바로 돌아온 걸 보니 마음이 안 놓였나 봐… 경계심이 장난 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400210104,
					"content": "책임감이 강하다는 거지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210105
					]
				},
				{
					"id": 400210105,
					"content": "상황이 복잡하니 먼저 그녀와 이야기해 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "신염"
				}
			]
		},
		{
			"id": 4002102,
			"completionStepIds": [
				4002102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002102",
							"2"
						],
						"stepId": 4002102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"쿠죠 사라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210201,
					"content": "모두 그동안 수고했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210202
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 400210202,
					"content": "병력을 데리고 왔어. 제일 위험한 고비는 넘겼으니 이 길만 지키면 마물들을 효과적으로 막을 수 있을 거야. 도망치는 마물이 있으면 황해 일대에 막아둘 수 있고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210203
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 400210203,
					"content": "비경 안에서 큰 소리가 나는 걸 들었는데, 안에 장치가 많은 것 같아…. 우린 침입할 최적의 타이밍을 노리고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210204
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 400210204,
					"content": "왜 비경과 더 가까운 곳으로 안 가는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400210205,
					"content": "저번에 무사들이 비경과 충분한 거리를 유지하지 못해서 갑작스러운 마물들의 습격에 황급히 물러날 수밖에 없었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210206
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 400210206,
					"content": "처음은 예상 밖이라고 쳐도 두 번부턴 실수야. 이런 일이 다시 일어나는 건 용납할 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210207
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 400210207,
					"content": "그렇구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400210208,
					"content": "(우리에게 좋은 기회야)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210209
					]
				},
				{
					"id": 400210209,
					"content": "난 이따가 쿠죠 병영으로 돌아가서 다른 지역 방어를 준비해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210210
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 400210210,
					"content": "좀 늦었지만 이제부턴 텐료 봉행이 이곳을 맡을 거야. 도와줘서 정말 고마워. 약속한 답례도 잊지 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210211
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 400210211,
					"content": "신염, 이 편지 안엔 내가 직접 작성한 「통행증」이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210223
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 400210223,
					"content": "가장 긴 체류 기간을 신청했으니 남은 시간 이나즈마에서 즐겁게 보냈으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210212
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 400210212,
					"content": "숙식 문제도 해결해 뒀으니, 성에 돌아가면 편지에 적힌 곳으로 가면 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210213
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 400210213,
					"content": "와! 정말 횡재했네? 숙식 제공에 이나즈마 여행까지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210214
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400210214,
					"content": "사양할 거 없어. 당연한 거니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210215
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 400210215,
					"content": "정말 고마워요. 사라 씨가 언제쯤 한가해질진 모르겠지만… 휴가 때 제가 이나즈마에 아직 있다면 꼭 제 공연 보러 와주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210216
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400210216,
					"content": "시와 음악에 큰 흥미는 없지만, 텐료 봉행을 많이 도와줬으니… 기회 되면 꼭 보러 가지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210217
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 400210217,
					"content": "신염의 제일 큰 걱정거리가 해결됐네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400210218,
					"content": "아니야, 제일 걱정인 건 「시키 대장」이라고! 이제 개인적인 일은 다 해결했지만… 친구로서 그를 도와야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210219
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400210219,
					"content": "그리고 그 형씨도. 여행자, 당연히 구하러 갈 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210220,
						400210221
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400210220,
					"content": "그 사람은 별문제 없을 거 같지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210222
					]
				},
				{
					"id": 400210222,
					"content": "그럼 몰래 가서 「시키 대장」이랑 합류하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "신염"
				},
				{
					"id": 400210221,
					"content": "그래도 보고만 있을 순 없으니까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210222
					]
				}
			]
		},
