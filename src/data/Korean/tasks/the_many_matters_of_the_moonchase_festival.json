					"임양"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726640101,
					"content": "음… 보물상자를 다시 배치해야겠는걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640102
					],
					"speakerTitle": "임양"
				},
				{
					"id": 726640102,
					"content": "보물상자요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640103
					]
				},
				{
					"id": 726640103,
					"content": "음?! 여행자… 인가요? 「축월절」에 참가하러 오신 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640104
					],
					"speakerTitle": "임양"
				},
				{
					"id": 726640104,
					"content": "그런 셈이죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640105
					]
				},
				{
					"id": 726640105,
					"content": "그럼 잘 오셨어요. 축월절을 축하하기 위해 모험가 길드에서 이벤트를 준비 중이거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640106
					],
					"speakerTitle": "임양"
				},
				{
					"id": 726640106,
					"content": "어때요, 한번 들어보실래요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640107,
						726640108
					],
					"speakerTitle": "임양"
				},
				{
					"id": 726640107,
					"content": "정확히 어떤 이벤트인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640110
					]
				},
				{
					"id": 726640110,
					"content": "축월절 기간에 모험가 길드 곳곳에 「축월 부적」이라는 것을 배치해두었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640111
					],
					"speakerTitle": "임양"
				},
				{
					"id": 726640111,
					"content": "이 축월 부적을 찾은 사람은 길드로 가지고 와서 보상으로 교환할 수 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640112
					],
					"speakerTitle": "임양"
				},
				{
					"id": 726640112,
					"content": "그리고 길드에서 모험가를 파견해 야외에다가 특별한 보물상자를 배치해 두었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640113
					],
					"speakerTitle": "임양"
				},
				{
					"id": 726640113,
					"content": "특별한 보물상자 안에는 길드에서 준비한 각종 보물이 들어있답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640114
					],
					"speakerTitle": "임양"
				},
				{
					"id": 726640114,
					"content": "이 두 가지 이벤트 외에도 길드에서는 도전하고 싶어 하는 엘리트 모험가들을 위해 고난도 모험을 준비해두었습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640115
					],
					"speakerTitle": "임양"
				},
				{
					"id": 726640115,
					"content": "정확히는… 마물 야영지를 배치해두었답니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640116,
						726640117
					],
					"speakerTitle": "임양"
				},
				{
					"id": 726640116,
					"content": "축월절이랑 관련 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640118,
					"content": "아… 하하하, 그게… 음… 그게 아니라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640119
					],
					"speakerTitle": "임양"
				},
				{
					"id": 726640119,
					"content": "이 마물들을 무찌르면 길드에서 상응하는 보상도 드려요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640120
					],
					"speakerTitle": "임양"
				},
				{
					"id": 726640120,
					"content": "평소 의뢰와 무슨 차이죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640121
					]
				},
				{
					"id": 726640121,
					"content": "제발, 부탁할게요! 축월절 기간에는 모험가들이 다들 축제를 즐기러 가서 의뢰를 받아주는 사람이 없다구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640122
					],
					"speakerTitle": "임양"
				},
				{
					"id": 726640122,
					"content": "어때요? 여행자님 실력이면 그 마물들은 식은 죽 먹기일 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640123,
						726640124
					],
					"speakerTitle": "임양"
				},
				{
					"id": 726640123,
					"content": "그렇군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640125,
					"content": "보, 보수는 절대 실망하지 않도록 준비할 테니 걱정하지 마세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640126
					],
					"speakerTitle": "임양"
				},
				{
					"id": 726640126,
					"content": "축월절 기간에는 항상 이곳에 있을 테니 문제가 생기면 언제든지 찾아와요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640127
					],
					"speakerTitle": "임양"
				},
				{
					"id": 726640127,
					"content": "그럼 부탁할게요, 그리고… 즐거운 축월절을 보내시길!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "임양"
				},
				{
					"id": 726640124,
					"content": "보수나 준비해두세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640117,
					"content": "축월절이랑 전혀 관련 없잖아요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640108,
					"content": "또 이상한 일상 잡일 같은 거 시키는 거 아니겠죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640109
					]
				},
				{
					"id": 726640109,
					"content": "아니에요! 이번 이벤트는 정말 모험적일 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640110
					],
					"speakerTitle": "임양"
				}
			]
		}
	]
}