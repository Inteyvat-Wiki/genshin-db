							"2051806",
							"2"
						],
						"stepId": 2051806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"베일"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180401,
					"content": "왔구나. 일처리가 빠르네. 그분이 왜 항상 너한테 일을 맡기는지 알겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180402
					],
					"speakerTitle": "베일"
				},
				{
					"id": 205180402,
					"content": "이 사건은 페보니우스 기사단한테 넘겼어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180403
					]
				},
				{
					"id": 205180403,
					"content": "페보니우스 기사단한테 넘겼… 저기, 내가 아까 페보니우스 기사단한테 넘기면 일이 엄청 복잡해질 거라고 하지 않았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180404
					],
					"speakerTitle": "베일"
				},
				{
					"id": 205180404,
					"content": "요령을 피우다니, 휴… 다행히 네가 그럴지도 모른다고 그분이 미리 알려줘서 대비책을 마련해뒀지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180405
					],
					"speakerTitle": "베일"
				},
				{
					"id": 205180405,
					"content": "나머지 일은 걱정하지 마. 또 심부름을 다녀와야겠군, 휴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180406
					],
					"speakerTitle": "베일"
				},
				{
					"id": 205180406,
					"content": "하지만 그분의 말대로라면, 네 행동으로 사건이 엉뚱한 방향으로 튈 수도 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180407
					],
					"speakerTitle": "베일"
				},
				{
					"id": 205180407,
					"content": "내가 보물 사냥단의 동향을 보고하러 가는 건 너무 티 나잖아. 게다가 그분의 신분으로 페보니우스 기사를 직접 지휘하기도 좀 그렇고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180408
					],
					"speakerTitle": "베일"
				},
				{
					"id": 205180408,
					"content": "음… 이걸 받아줘. 그분의 말로 하면, 「바람의 방향을 바꾼」 거에 대한 소소한 답례야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베일"
				}
			]
		},
