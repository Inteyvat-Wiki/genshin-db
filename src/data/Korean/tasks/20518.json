			},
			"dialogs": [
				{
					"id": 205180201,
					"content": "왔구나. 일처리가 빠르네. 그분이 왜그렇게 널 좋아하는지 알겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180202,
						205180204
					],
					"speakerTitle": "베일"
				},
				{
					"id": 205180202,
					"content": "돈부터 주시죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180203
					]
				},
				{
					"id": 205180203,
					"content": "차갑게 굴기는… 알았어. 바로 줄게. 내 처지도 좀 이해해줘, 난 그저 심부름꾼일 뿐이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베일"
				},
				{
					"id": 205180204,
					"content": "그거 정말 고맙네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180205
					]
				},
				{
					"id": 205180205,
					"content": "별말씀을. 이건 이번 일의 보수야. 앞으로도… 잘 부탁해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베일"
				}
			]
		},
		{
			"id": 2051803,
			"completionStepIds": [
				2051805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
