	"talks": [
		{
			"id": 2051801,
			"completionStepIds": [
				2051801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
