			"dialogs": [
				{
					"id": 6051101,
					"content": "#알베도 님! {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051102
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 6051102,
					"content": "아직 상황 괜찮지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051103
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 6051103,
					"content": "네! 방금 성안에 침입한 마물들이 있었는데, 다이루크 님과 케이아 님이 무찔러 주셨어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051104
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 6059901,
					"content": "한편 조금 전…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
