			"dialogs": [
				{
					"id": 150450601,
					"content": "와, 예쁘다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450602
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450602,
					"content": "다들 여기로 모여! 사진 찍자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450603
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150450603,
					"content": "음음… 좋아! 다들 컨디션도 좋고, 앞머리가 떡지거나 다크서클 내려온 사람도 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450604
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150450604,
					"content": "사진 찍기 전에 그런 것도 체크해 주는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450605
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150450605,
					"content": "사진 찍을 때 디테일까지 잘 챙겨야 좋은 가이드지~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450606
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150450606,
					"content": "음음, 술 좋아하는 음유시인이 좋은 길동무인 것처럼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450607
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 150450607,
					"content": "그건 또 무슨 맥락이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450608
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150450608,
					"content": "하하, 어쨌든 분위기 좋잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450609
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450609,
					"content": "다들 농담을 주고받을 수 있는 친구가 되었네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450610
					]
				},
				{
					"id": 150450610,
					"content": "이거 맞아? 너도 베넷처럼 각설이한테 너무 관대한 거 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450611
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150450611,
					"content": "나쁘지 않은데 뭐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450612
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150450612,
					"content": "자, 이 아샤 머리띠 써. 너 주려고 다 같이 산 기념 선물이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450613
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150450613,
					"content": "고마워",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450614
					]
				},
				{
					"id": 150450614,
					"content": "응, 잘 어울린다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450615
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450615,
					"content": "그럼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450616
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150450616,
					"content": "하나, 둘, 셋——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450617
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150450617,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450618
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150450618,
					"content": "페이몬?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450619
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450619,
					"content": "…미안, 모두의 말을 듣다 보니까 순간 할 말이 생각이 안 나서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450620
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150450620,
					"content": "그리고 모두와 헤어지기 아쉬워서?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450621
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150450621,
					"content": "말하는 순간, 이 휴가에 마침표를 찍게 될 것 같아서?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450622
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150450622,
					"content": "너…! 「중재자」는 독심술 못 한다며!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450623
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150450623,
					"content": "하하, 페이몬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450624
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150450624,
					"content": "괜찮아, 페이몬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450625
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450625,
					"content": "여름은 또 돌아올 거야. 네가 불의 신님께 빌었던 것처럼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450626
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450626,
					"content": "각자의 여정은 계속되겠지만, 우리가 서로를 소중히 여기는 한 언젠가 꼭 다시 모일 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450627
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450627,
					"content": "베넷이 말솜씨가 엄청 늘었는데, 벤티 선생님?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450628
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150450628,
					"content": "헤헤! 근데 내가 가르친 거 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450629
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 150450629,
					"content": "뭐야, 근데 왜 그렇게 득의양양한 얼굴이야! 진짜, 모처럼 감동받았는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450630
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150450630,
					"content": "그럼 다시 찍는다?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450631
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150450631,
					"content": "이번엔 다 같이 외칠까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450632
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450632,
					"content": "뭐라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450633
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150450633,
					"content": "행운의 별?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450634
					]
				},
				{
					"id": 150450634,
					"content": "좋아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450635
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150450635,
					"content": "하나, 둘, 셋——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450636
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150450636,
					"content": "행운의 별!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450641
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150450641,
					"content": "친구들과 함께 즐거운 시간을 보냈다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150450642
					]
				},
				{
					"id": 150450642,
					"content": "…베넷은 앞으로 어떻게 할 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450643
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150450643,
					"content": "그러게, 아직 결정하기 어려우면 우리 「샘물 무리」에 쉬러 와. 얼마든지 있어도 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450644
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150450644,
					"content": "…응, 고마워 말라니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450645
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450645,
					"content": "나, 불의 신님을 만나서 정중하게 감사 인사를 드렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450646
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450646,
					"content": "그분이 말씀하시길, 그곳은 심연이 의태해낸 잿더미 바다였는데, 공간 자체가 극도로 불안정해서 지금은 완전히 사라졌다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450647
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450647,
					"content": "그 뒤로는 내 이야기를 나눴는데… 불의 신님은 내가 나타에 남는다면 환영이지만, 내 의사를 존중하겠다고 해주셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450648
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450648,
					"content": "고민해 봤는데… 나, 역시 몬드로 돌아가려고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450649
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450649,
					"content": "아버지들이 걱정돼서?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450650
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150450650,
					"content": "그것도 이유 중 하나예요. 모험 이야기를 꼭 들려주기로 했는데, 약속을 어길 순 없잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450651
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450651,
					"content": "그리고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450652
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450652,
					"content": "아까 엄마 아빠랑 헤어질 때 말했거든요, 티바트에서 가장 위대하고 전설적인 모험가가 되겠다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450653
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450653,
					"content": "모험가가 한 곳에만 머물 수는 없잖아요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450654
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450654,
					"content": "베넷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450655
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150450655,
					"content": "나타를 떠나서 다시 악운이 찾아오면… 그땐 어떡하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450656
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150450656,
					"content": "하하, 괜찮아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450657
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450657,
					"content": "이번 여행에서 얻은 온기가, 앞으로 어떤 어려움도 이겨내게 해줄 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450658
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450658,
					"content": "난 내 운명을 스스로 거머쥐고 싶고, 가족과 친구들에게 받은 온기를 다시 전하고 싶어. 이 마음은 결코 변하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450659
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450659,
					"content": "우리의 단장을 위해 건배!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450660
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150450660,
					"content": "베넷 단장을 위해 건배!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450661
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 150450661,
					"content": "건배——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450662
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150450662,
					"content": "으… 밤을 거의 새버렸네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450663
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150450663,
					"content": "그만큼 신난다는 거지! 다음은 누가 공연할 차례더라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450664
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150450664,
					"content": "베넷이 벌써 몇 번이나 잠들 뻔했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450665
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150450665,
					"content": "아냐 아냐… 나 아직 멀쩡해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450666
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150450666,
					"content": "슬슬 다 들어가서 쉬자. 말라니, 기운이 넘쳐 보이니 뒷정리는 너한테 맡길게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450667
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150450667,
					"content": "에? 너무해——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450668
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150450668,
					"content": "#{NICKNAME}, 나랑 산책가지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450669
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 150450669,
					"content": "경치 좋은 곳을 알거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "벤티"
				}
			]
		},
