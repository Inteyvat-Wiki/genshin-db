			},
			"dialogs": [
				{
					"id": 4530601,
					"content": "조사하면서 뭐 좀 찾은 거 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530602
					],
					"speakerTitle": "신통한 홉킨스"
				},
				{
					"id": 4530602,
					"content": "우와, 일어났구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530603
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4530603,
					"content": "이제 괜찮아. 지옥에 다녀온 기분이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530604
					],
					"speakerTitle": "신통한 홉킨스"
				},
				{
					"id": 4530604,
					"content": "그래서 기사단의 조사 결과는 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530605
					],
					"speakerTitle": "신통한 홉킨스"
				},
				{
					"id": 4530605,
					"content": "남겨진 털로 울프 영지에서 서식하는 늑대 무리라는 것만 알아냈어요. 다른 건 딱히…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530606
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530606,
					"content": "하지만 지금 바로 울프 영지에 가서 본격적으로 조사할 테니 걱정 마세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530607
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530607,
					"content": "우리 기사단은 이런 위험한 일이 계속 생기는 걸 절대 보고만 있지 않을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530608
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530608,
					"content": "그래 그럼. 한발 늦었지만 아무것도 안 하는 것보다야 낫지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530609
					],
					"speakerTitle": "신통한 홉킨스"
				},
				{
					"id": 4530609,
					"content": "으이, 정말 무례한 사람이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530610
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4530610,
					"content": "우린 이제 우리가 할 일을 하러 갈 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530611
					],
					"speakerTitle": "신통한 홉킨스"
				},
				{
					"id": 4530611,
					"content": "멍청한 짓은 하지 않는 게 좋을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530612
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530612,
					"content": "웃기는군, 우린 기사단과 달라. 원수는 반드시 갚는다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530613
					],
					"speakerTitle": "신통한 홉킨스"
				},
				{
					"id": 4530613,
					"content": "이만 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530614
					],
					"speakerTitle": "신통한 홉킨스"
				},
				{
					"id": 4530614,
					"content": "정말 처참하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530615
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 4530615,
					"content": "뭐가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530616
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4530616,
					"content": "저들의 미래 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530617
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 4530617,
					"content": "저도 그 말에 동의해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530618
					]
				},
				{
					"id": 4530618,
					"content": "요즘 젊은이들은 너무 다혈질이야. 저들이 멍청한 짓을 못 하게 해줘, 부탁하마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530619
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 4530619,
					"content": "걱정 마세요, 저 사람이 아무리 거슬려도 그게 저희 일인걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530620
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530620,
					"content": "저희에게 맡겨 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530621
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530621,
					"content": "그럼 빨리 울프 영지로 가보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
