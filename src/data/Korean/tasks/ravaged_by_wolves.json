			"dialogs": [
				{
					"id": 4530701,
					"content": "이 발자국은——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530702
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4530702,
					"content": "발자국을 보면 늑대가 몇 마리인지, 얼마나 큰지 짐작할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530703
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4530703,
					"content": "한두 마리가 아니야, 게다가 크기는 한——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530704
					],
					"speakerTitle": "페이몬"
				},
