			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"엠버"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530501,
					"content": "이건 늑대의 털이야. 리월 사람들은 이걸로 붓을 만든다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530502
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530502,
					"content": "털색이 책에서 본 몬드의 늑대와 좀 달라. 외지에서 온 늑대일 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530503
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530503,
					"content": "늑대의 몸에는 여러 가지 털이 있어, 색이 다 다르다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4530504,
					"content": "하지만, 이것 좀 봐 봐——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530505
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530505,
					"content": "이건 다른 털인데 뭔가 묻어있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530506,
						4530507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4530506,
					"content": "씨앗이네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				},
				{
					"id": 4530508,
					"content": "흠흠, 이건 고리고리 열매의 씨앗이야. 씨앗에 고리가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530509
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530509,
					"content": "몬드에서는 울프 영지와 크라운 협곡 같은 곳에서만 자라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530510
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530510,
					"content": "그 말은… 결국 울프 영지의 늑대 무리라는 거네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530511
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4530511,
					"content": "응…. 여러 늑대 무리가 한 지역에서 영토 쟁탈을 하는 경우도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530512
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530512,
					"content": "자세한 내용은 모르겠는데 이것도 중요한 단서가 될 거야. 조사하기 좀 더 수월해지겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530513
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530513,
					"content": "출발하기 전에 마을 주민들을 좀 위로해주고 올게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530507,
					"content": "뭔가 특별한 게 있는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				}
			]
		},
		{
