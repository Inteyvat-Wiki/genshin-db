			},
			"dialogs": [
				{
					"id": 4530101,
					"content": "휴, 정말 처참하네. 일어서지도 못하는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530102
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 4530102,
					"content": "네?! 이 나쁜 놈들!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530103
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530103,
					"content": "하지만… 그는 다친 곳이 없는걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4530104,
					"content": "그래서 더 처참하지. 너무 놀라서 주저앉아 버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530105
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 4530105,
					"content": "아… 저, 정말 처참하네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530106
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530106,
					"content": "목격 정보가 필요한데 단서가 될만한 게 있을까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530107
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530107,
					"content": "느, 늑대를 본 건 이번이 처음이야, 너무 무서워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530108
					],
					"speakerTitle": "신통한 홉킨스"
				},
				{
					"id": 4530108,
					"content": "…뭐, 쓸만한 정보는 없는 것 같네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530109
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4530109,
					"content": "현장으로 가서 다시 한번 단서를 찾아보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				}
			]
		},
		{
			"id": 45305,
			"completionStepIds": [
				45305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
