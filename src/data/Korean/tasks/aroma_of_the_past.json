				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"리사",
					"벤티",
					"진",
					"레이저"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400800601,
					"content": "사람 엄청 많다. 다들 바람의 신을 맞이하러 왔구나. 엥, 왜 다들 「천사의 몫」 노점 앞에 모여있는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400800602,
					"content": "와인 축제에서 가장 품질이 좋은 술은 건배 의식을 통해 바람의 신께 올린 후 판매하는 게 관례거든. 그래서 다들 줄을 서서 기다리고 있는 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800603
					],
					"speakerTitle": "리사"
				},
				{
					"id": 400800603,
					"content": "흥, 이 녀석들한텐 바람의 신을 맞이하는 것도 다 형식적인 겉치레인 것 같아. 리사, 넌 레이저를 보러 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400800604,
					"content": "응, 조금 걱정이 돼서. 방금 레이저랑 얘기 나눠봤어. 양조 여행은 순조로웠던 모양이네. 오늘은 나도 안심하고 한잔할 수 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800605
					],
					"speakerTitle": "리사"
				},
				{
					"id": 400800605,
					"content": "우와… 리사, 너마저…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400800606,
					"content": "후후, 레이저는 저쪽에 있으니까 얼른 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800607
					],
					"speakerTitle": "리사"
				},
				{
					"id": 400800607,
					"content": "오, 왔구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800608
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 400800608,
					"content": "우앗, 이 술병들은 대체 어떻게 된 일이야? 다른 사람들이 보면 너희들도 술 파는 노점상인 줄 알겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800609
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400800609,
					"content": "하하하, 이건 전부 레이저를 위해 준비한 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800610
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 400800610,
					"content": "엄마가 그러는데, 오늘은 사람들이 바람의 신을 맞이하기 위해 술을 올린대. 바람의 신이 기분이 좋아지면 바람으로 변해서 모두에게 축복을 내린대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800611
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400800611,
					"content": "#바람의 신의 기분이 좋아져서 레이저를 도와줬으면 좋겠어. 명예 기사 {M#오빠}{F#언니}, 봐봐. 이건 알베도 오빠가 클레한테 빌려준 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800612
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400800612,
					"content": "이건 아버지들이 준 거야. 오는 길에 실수로 깨지 않아서 다행이야…. 사실 그냥 척하는 거야. 다 쓰면 다시 가져다드려야 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800613
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 400800613,
					"content": "엄마가 그러는데 바람의 신은 주량이 엄청나서 원한다면 시드르 호수를 단숨에 다 마셔버릴 수도 있다고 했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800614
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400800614,
					"content": "이 술들이랑, 레이저의 엄마 아빠가 남긴 술이면… 충분하려나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800615
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400800615,
					"content": "아, 초록색 시인",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800616
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 400800616,
					"content": "크흠크흠, 여러분. 이 자리에 오게 돼서 영광입니다. 오늘 전 페보니우스 기사단 단장 대행, 진 씨의 초대로 여러분께 「천풍의 술」을 연주해 드리려고 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800617
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 400800617,
					"content": "가장 훌륭한 노래를 바람에, 그리고 이 자리에 있는 여러분에게 바치겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800618
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 400800618,
					"content": "「우린 이 재료들을 통에 담고,\\n바람이 일 때까지 하염없이 기다리고, 기다리네.\\n술병의 입구를 단단히 봉인하니,\\n남풍은 따사롭고, 북풍은 매섭구나」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800619
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 400800619,
					"content": "「술의 맛은 어떠한가?\\n몬드의 이름 같고, 자유의 꿈과도 같지.\\n어떻게 숙성된 술인가?\\n탐험의 용기와 자애로운 부드러움이라」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800620
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 400800620,
					"content": "「수호의 마음은 여전히 처음처럼,\\n천풍과 함께 축복하리.\\n새콤한 술이 달콤해질 때까지, 투박한 통이 촉촉해질 때까지.\\n바람이 일 때까지 하염없이 기다리고, 기다리리」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800621
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 400800621,
					"content": "「술통 안엔 뭐가 들어 있을까?\\n밀의 황금빛이 빼곡하게 들어 있네.\\n통에서 나온 술은 무엇을 싣고 올까?\\n풍경의 소리와 만고의 하늘이어라」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800622
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 400800622,
					"content": "「우린 술과 함께 노래하고,\\n바람이 노래할 때까지 하염없이 기다리고, 기다리네.\\n천풍은 어떤 안줏거리를 가져갔을까?\\n하프 현에 담긴 이야기와 오늘 밤의 달콤한 꿈이어라」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800623
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 400800623,
					"content": "여러분, 이제 술을 준비해 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800624
					],
					"speakerTitle": "진"
				},
				{
					"id": 400800624,
					"content": "바람의 신을 위하여!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800628
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 400800628,
					"content": "바람의 신을 위하여…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800629
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 400800629,
					"content": "바람의 신을 위하여",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800630
					]
				},
				{
					"id": 400800630,
					"content": "어… 바람이 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800631
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400800631,
					"content": "클레, 슬퍼하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800632
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 400800632,
					"content": "이럴 수가. 레이저 오빠, 바람의 신이 돌아오지 않았어. 우리가 준비한 술이 마음에 안 드는 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800633
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400800633,
					"content": "아닐 거야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800634
					]
				},
				{
					"id": 400800634,
					"content": "그럴 리가! 클레, 그거 알아? 바람의 신은 바람뿐만 아니라 다른 모습으로도 변할 수 있어. 올해에는 분명 다른 모습으로 돌아왔을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800635
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400800635,
					"content": "웅? 그래? 그럼… 그럼 통통이로 변할 수도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800636
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400800636,
					"content": "그래, 통통이로 변하는 거야! 바람의 신——들었지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800637
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400800637,
					"content": "헤헤… 레이저 오빠, 바람의 신의 축복이 느껴져?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800638
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400800638,
					"content": "응",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800639
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 400800639,
					"content": "너희랑 같이, 말도 많이 하고, 많은 걸 배웠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800640
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 400800640,
					"content": "지금은, 무섭지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800641
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 400800641,
					"content": "이게… 축복이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800642
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 400800642,
					"content": "나중에 술이 숙성되면 나도 한 모금 마셔볼래. 절대 잊으면 안 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800643,
						400800644
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 400800643,
					"content": "내 몫도 있겠지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800645
					]
				},
				{
					"id": 400800645,
					"content": "응, 같이 공유하고, 같이 기억하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800646
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 400800646,
					"content": "응응! 근데… 클레 목말라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800647
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400800647,
					"content": "그래, 수다 그만 떨고 음료 마시러 갈까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800648
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400800648,
					"content": "「천사의 몫」 노점에서 새로 판매하는 「바캉스 과일주」가 엄청 맛있대!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800649
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 400800649,
					"content": "마실래, 클레 마실래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800650
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400800650,
					"content": "응, 다 같이, 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "레이저"
				},
				{
					"id": 400800644,
					"content": "지금이 생각날 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400800645
					]
				}
			]
		},
		{
			"id": 4008009,
