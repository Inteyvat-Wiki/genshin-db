			},
			"dialogs": [
				{
					"id": 400800901,
					"content": "레이저 오빠, 방금 엄청 멋졌어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800902
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400800902,
					"content": "멋져… 그게 무슨 뜻이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800903
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 400800903,
					"content": "대단하다는 뜻이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400800904
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400800904,
					"content": "음… 아냐. 클레가 더 멋져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "레이저"
				}
			]
		},
		{
			"id": 4008050,
			"completionStepIds": [],
