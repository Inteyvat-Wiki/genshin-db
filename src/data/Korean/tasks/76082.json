			"trigger": {
				"objectNames": [
					"마이테",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141701,
					"content": "으악! 이 녀석 전보다 커진 것 같지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141702
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760141702,
					"content": "후후, 그야 당연하죠. 제가 고생해서 찾아낸 백령과를 왕창 먹었더니, 페이몬보다 더 동글동글한 차르 어르신이 되어버렸어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141703
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141703,
					"content": "이봐! 그런 이상한 비교는 하지 말라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141704
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760141704,
					"content": "#어?! {NICKNAME} {M#오빠}{F#언니}를 보고 갑자기 힘이 넘치는… 아니, 흥분한 것 같은데요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141705
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141705,
					"content": "#{M#오빠}{F#언니}랑 한 판 붙으려는 눈치인데… 하, 저번에 처참하게 당했던 게 아직도 화가 나서 그냥 넘어가지 못하는 모양이네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141706,
						760141708
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141706,
					"content": "바라던 바야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141707
					]
				},
				{
					"id": 760141707,
					"content": "#조심해요, {M#오빠}{F#언니}. 저 녀석, 저번보다 훨씬 강해졌어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141708,
					"content": "응? 지금?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141709
					]
				},
				{
					"id": 760141709,
					"content": "굳이 저 성질을 받아줄 필요는 없어요. 흥미가 생기면 그때 도전을 받아줘도 돼요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141710
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141710,
					"content": "이제 이 녀석은 제가 돌보기로 했으니까 제 말은 잘 들을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141711
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141711,
					"content": "자, 착하지. 앉아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141712
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141712,
					"content": "무슨 네가 키우는 강아지야? 잠깐, 꽃게는 원래 앉아 있잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
