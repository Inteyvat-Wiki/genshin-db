				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"마이테"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141401,
					"content": "무슨 일이에요? 뭐 더 궁금한 거라도 있어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141402,
						760141406,
						760141409,
						760141413,
						760141426
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141402,
					"content": "그 꽃게에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141403
					]
				},
				{
					"id": 760141403,
					"content": "휴, 무서워 보이긴 해도, 원래는 성격이 온화한 편이에요. 그 이상한 돌이 사라졌으니 이제 다시 정상으로 돌아올 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141404
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141404,
					"content": "하지만 지금은 숨어서 조용히 반성하라고 해야죠. 어떤 영향을 받았든, 그가 저지른 나쁜 짓과 작은 게들에게 준 상처는 변하지 않으니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141405
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141405,
					"content": "대도 리드·밀러가 상대했던, 거울에 현혹된 나쁜 총독처럼 말이에요. 아무리 변명을 늘어놓아도 소용없죠. 참회는 결국 행동으로 보여줘야 하니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141406,
					"content": "그 이상한 돌에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141407
					]
				},
				{
					"id": 760141407,
					"content": "후후, 그건 사람의 마음을 조종하는 욕망의{RUBY#[D]트바르도프스카의 돌} 돌이에요… 음, 히딤바 언니가 말한 이름이 이거였나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141408
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141408,
					"content": "크흠, 아, 아무튼, 서리달 쪽에 있는 큰 돌덩이랑 마찬가지로 하늘에서 떨어진 물건인 것 같아요. 이제 날아가 버렸으니 우리한테 더 이상 위협이 되진 않겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141409,
					"content": "소라단에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141410
					]
				},
				{
					"id": 760141410,
					"content": "#음? 소라단에 대해 궁금한가요? 좋아요, {M#오빠}{F#언니}는 소라단의 친구니까 뭐든 편하게 물어봐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141411
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141411,
					"content": "#우리는… 음, 같은 길을 걷는 또래들의 「상호협동 조직」이라고 할 수 있어요. {M#오빠}{F#언니} 나이로는 우리 조직에 가입하기는 좀 힘들겠지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141412
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141412,
					"content": "나샤 마을에서 「상호협동」이 필요할 때, 제가 도울 수 있는 일이라면 언제든지 말하세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141413,
					"content": "이상한 사람에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141414
					]
				},
				{
					"id": 760141414,
					"content": "아, 그 보라색 사제 말하는 거죠? 우리를 공격하지 않은 걸 보면, 적어도 지금은 적이 아닌 것 같아요. 그래도 그녀 일에 끼어들지 않는 게 좋겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141415
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141415,
					"content": "호기심은 죽음을 부르기도 하죠. 카르야 언니도 그 서리달 괴짜들이랑 접촉하지 말라고 했어요. 저 같은 대도도 그 녀석들한테 잡혀 달의 신의 제물이 될 뻔했으니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141416
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141416,
					"content": "제물?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141417
					]
				},
				{
					"id": 760141417,
					"content": "네, 엄청 사악한 녀석들이에요. 소문에 의하면 여러 사람의 피를… 윽, 생각만 해도 끔찍하네요. 이쯤에서 그만 얘기할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141418
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141418,
					"content": "다행히 절 붙잡은 게 아무것도 모르는 꼬마라, 이야기를 조금 들려주니 놓아주더라고요. 정말 큰일 날 뻔했죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141419
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141419,
					"content": "무, 무섭진 않아요! 대도는 절대 겁내지 않거든요! 다만 충고하자면, 최대한 그들이랑 엮이지 않는 게 좋을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141420
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141420,
					"content": "아 참, 깜빡할 뻔했네요. 전에 말한 정보원 있잖아요? 서리달 아이에 관한 정보는 전부 히딤바 언니가 알려준 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141421
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141421,
					"content": "그 언니는… 음, 아직도 나샤 마을 근처에 있을 테니, 조금만 수소문하면 금방 찾을 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141422,
						760141424
					],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141422,
					"content": "아마 당분간은 은퇴할지도 몰라…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141423
					]
				},
				{
					"id": 760141423,
					"content": "#응? {M#오빠}{F#언니}, 벌써 히딤바 언니를 만났어요? 은퇴한다는 얘기는 못 들었는데… 뭐, 나중에 다시 물어보면 되겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141424,
					"content": "듣고 나니까 좀 불안하네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141425
					]
				},
				{
					"id": 760141425,
					"content": "걱정 마요, 그 언니는 정말 믿을 만한 사람이에요. 저, 마이테를 믿으세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마이테"
				},
				{
					"id": 760141426,
					"content": "그럼 이만 가볼게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141427
					]
				},
				{
					"id": 760141427,
					"content": "네, 조심해서 가요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마이테"
				}
			]
		},
		{
			"id": 7601417,
			"completionStepIds": [
				7608202
			],
