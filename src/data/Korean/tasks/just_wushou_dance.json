						],
						"pointId": 7593
					}
				]
			},
			"dialogs": [
				{
					"id": 715300101,
					"content": "#해피 해등절! 거기 동생이랑 {M#형씨}{F#누님}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300102
					],
					"speakerTitle": "가경"
				},
				{
					"id": 715300102,
					"content": "어? 너희는 저번에 가명을 찾아왔던 유명 인사들 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300103
					],
					"speakerTitle": "가경"
				},
				{
					"id": 715300103,
					"content": "우리도 널 본 적 있어. 그때 가명이랑 같이 놀고 있던 친구 맞지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715300104,
					"content": "맞아. 너희가 아직까지 기억하고 있다니 이거 행운인걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300105
					],
					"speakerTitle": "가경"
				},
				{
					"id": 715300105,
					"content": "너희는 뭐든 잘하는 고수라고 들었어! 매일 흘호암으로 장 보러 갈 때마다 너희를 칭찬하는 소리가 끊이질 않더라니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300106,
						715300107
					],
					"speakerTitle": "가경"
				},
				{
					"id": 715300106,
					"content": "맞아, 난 만능 고수지!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300108
					]
				},
				{
					"id": 715300108,
					"content": "나, 나 먹는 거 말고 다른 것도 잘하거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715300109,
					"content": "어디 보자, 내가 또 뭘 할 줄 아냐면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715300110,
					"content": "알겠다! 평범한 사람은 못 날잖아. 넌 하얗고 복슬복슬한 게 꼭 비둘기 선인 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300111
					],
					"speakerTitle": "가경"
				},
				{
					"id": 715300111,
					"content": "날 줄 안다니 정말 대단해. 물건을 나르기도 쉽고 일하기도 편할 거 아냐? 그러니까 친구를 많이 도와주도록 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300112,
						715300113
					],
					"speakerTitle": "가경"
				},
				{
					"id": 715300112,
					"content": "페이몬은 비둘기 선인이었구나!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300114
					]
				},
				{
					"id": 715300114,
					"content": "#비둘기가 선인이 될 수 있는지는 둘째 치고, 난 계속 {NICKNAME}을(를) 돕고 있었다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715300115,
					"content": "#예를 들어, 높은 곳에서 추락할 때 {NICKNAME}이(가) 너무 아프게 떨어지지 않도록 잡아당겨 준다든지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715300116,
					"content": "#물론 힘이 부족해서 많이 들어 올리진 못하지만 말이야…. 만약 내가 정말 비둘기 선인이라면, {NICKNAME}이(가) 바람의 날개를 쓸 때 더 멀리 날아갈 수 있게 당겨줄 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715300117,
					"content": "그럼 너희도 나랑 가명이 짐승춤을 연습하는 것처럼 열심히 연습해야겠네. 오랜 시간 꾸준히 노력하다 보면 합을 맞출 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300118
					],
					"speakerTitle": "가경"
				},
				{
					"id": 715300118,
					"content": "마침 내가 「둥둥 짐승춤」이라고 재미있는 새 놀이를 준비해 봤는데, 한번 해보지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300119
					],
					"speakerTitle": "가경"
				},
				{
					"id": 715300119,
					"content": "합도 맞추고 짐승춤에 대해서도 알아갈 수 있는 기회라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300120
					],
					"speakerTitle": "가경"
				},
				{
					"id": 715300120,
					"content": "「둥둥 짐승춤」? 설마 옆에 있는 이 커다란 인형을 말하는 거야…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715300121,
					"content": "맞아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300122
					],
					"speakerTitle": "가경"
				},
				{
					"id": 715300122,
					"content": "정통 짐승춤은 배우기 어려워서 전문적인 지도를 받아도 흥미나 끈기가 없으면 버티질 못하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300123
					],
					"speakerTitle": "가경"
				},
				{
					"id": 715300123,
					"content": "그래서 난 짐승춤의 규칙과 도구를 살짝 바꿔서 놀이로 만들어 봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300124
					],
					"speakerTitle": "가경"
				},
				{
					"id": 715300124,
					"content": "지금은 해등절이기도 하니까, 다들 즐거운 마음으로 식전식후 운동 삼아 즐길 수 있지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300125
					],
					"speakerTitle": "가경"
				},
				{
					"id": 715300125,
					"content": "이 무대 의상을 입고 누가 더 많은 차병을 얻나 겨루는 거야. 서로 부딪치기도 하고 얼마나 재미있다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300126
					],
					"speakerTitle": "가경"
				},
				{
					"id": 715300126,
					"content": "정말 재밌을 거 같긴 한데, 난 힘이 없어서 이렇게 큰 무대 의상을 입고 다른 사람과 노는 건 무리야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715300127,
					"content": "#이런 건 {NICKNAME}이(가) 잘하니까, 난 일단 옆에서 지켜보면서 배울게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300128,
						715300129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715300128,
					"content": "좋아! 그럼 한번 춤춰볼게!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300130
					]
				},
				{
					"id": 715300130,
					"content": "어? 비둘기 선인은 안 하는 거야? 좀 아쉬운데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300131
					],
					"speakerTitle": "가경"
				},
				{
					"id": 715300131,
					"content": "#괜찮아! 난 {NICKNAME}(이)랑 아주 오랫동안 여행해 왔고 앞으로도 계속 여행할 거니까 합을 맞출 기회는 많거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300132
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715300132,
					"content": "#그리고 옆에서 지켜보기만 해도 {NICKNAME}와(과) 합을 맞추는 요령을 배울 수 있을지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715300133,
					"content": "하하! 너희는 정말 사이가 좋구나. 좀 부러운걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715300134
					],
					"speakerTitle": "가경"
				},
				{
					"id": 715300134,
					"content": "#그럼 우리 유명 인사 {M#형씨}{F#누님}, 어서 「둥둥 짐승춤」을 즐겨봐. 비둘기 선인은 옆에서 잘 지켜봐 주고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "가경"
				},
				{
					"id": 715300129,
					"content": "좋아! 그럼 한번 부딪쳐 볼게!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300130
					]
				},
				{
					"id": 715300113,
					"content": "이상한 별명이 또 늘었네!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300114
					]
				},
				{
					"id": 715300107,
					"content": "하하, 페이몬은 먹기 고수야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715300108
					]
				}
			]
		}
	]
}