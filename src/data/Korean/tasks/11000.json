			},
			"dialogs": [
				{
					"id": 110000301,
					"content": "사냥 중이니까, 목소리 낮춰",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000302
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110000302,
					"content": "몬드에 좋은 식자재가 그렇게 많다던데, 역시 그냥 나온 말이 아니었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000303,
						110000304
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110000303,
					"content": "너 사냥꾼이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				},
				{
					"id": 110000305,
					"content": "아냐아냐, 난 요리사야. 각지의 진기한 식자재를 찾아다니는 요리사지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000306
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110000306,
					"content": "난 향릉이라고 해, 리월항에서 왔어. 너희들은?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000307
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110000307,
					"content": "#난 {NICKNAME}(이)라고 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000308
					]
				},
				{
					"id": 110000308,
					"content": "안녕, 난 페이몬이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110000309,
					"content": "페이몬!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000310
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110000310,
					"content": "왜 그래? 왜 갑자기 날 그렇게 쳐다봐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110000311,
					"content": "정말 신기한 생명체야, 먹을 수 있는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000312,
						110000314
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110000312,
					"content": "이쪽은 내 친구야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000313
					]
				},
				{
					"id": 110000313,
					"content": "아쉽다, 친구면 먹을 수 없는 거네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110000316,
					"content": "너희 사이 되게 좋구나. 사실 나도 그런 친구가 있는데, 누룽지라고 불러",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000317
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110000317,
					"content": "이름이 먹을 거잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110000318,
					"content": "하하, 귀여워서 그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000319
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110000319,
					"content": "맞다, 나 사냥하는 것 좀 도와줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000320
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110000320,
					"content": "여기엔 사냥감이 정말 많은데, 전부 훌륭한 식자재야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000321
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110000321,
					"content": "나 혼자 잡기엔 너무 많아서, 놓치면 너무 아깝잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000322
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110000322,
					"content": "귀찮을 거 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110000323,
					"content": "섭섭한 말 하지 말고, 이따가 맛있는 요리 해줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000324
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110000324,
					"content": "#마, 맛있는 거? 좋았어, {NICKNAME}은(는) 사냥을 아주 잘해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000325,
						110000326
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110000325,
					"content": "내 입장은 전혀 생각하지 않는구나…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000327,
					"content": "헤헤, 괜찮아 신경 쓰지 마. 네 친구가 이미 승낙했으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000328
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110000328,
					"content": "어떤 방법으로든 고기만 가져오면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000329
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110000329,
					"content": "그럼 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "향릉"
				},
				{
					"id": 110000326,
					"content": "내 의견은 무시하는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000327
					]
				},
				{
					"id": 110000314,
					"content": "당연하지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000315
					]
				},
				{
					"id": 110000315,
					"content": "안 돼! 페이몬은 먹는 게 아니야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110000304,
					"content": "너 모험가야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000305
					]
				}
			]
		},
		{
