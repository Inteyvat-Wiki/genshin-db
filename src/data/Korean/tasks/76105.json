			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"말타"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761050101,
					"content": "#{M#형}{F#누나}, 저기 바위 게들 보여요? 뭔가 신비로운 의식을 하고 있는 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050102
					],
					"speakerTitle": "말타"
				},
				{
					"id": 761050102,
					"content": "게들은 원래 저렇게 사나 봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050103
					]
				},
				{
					"id": 761050103,
					"content": "그런가요? 아… 무슨 말인지 알겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050104
					],
					"speakerTitle": "말타"
				},
				{
					"id": 761050104,
					"content": "나샤 마을에도 이 바위 게들 같은 사람이 많아요. 어떤 이들은 어깨동무를 하고 같이 가고, 어떤 이들은 얼굴을 보면 주먹다짐부터 하고 헤어지죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050105
					],
					"speakerTitle": "말타"
				},
				{
					"id": 761050105,
					"content": "이게 바로 나샤 마을이 사는 모습이겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050106,
						761050107
					],
					"speakerTitle": "말타"
				},
				{
					"id": 761050106,
					"content": "맞아. 이해가 빠르네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				},
				{
					"id": 761050108,
					"content": "#그럼 {M#형}{F#누나}, 저 바위 게들을 작은 물웅덩이에 들어가게 할 수 있어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050109
					],
					"speakerTitle": "말타"
				},
				{
					"id": 761050109,
					"content": "음… 모든 보물 사냥꾼을 「기함」으로 불러 모으는 것처럼요. 재밌을 것 같지 않아요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761051501
					],
					"speakerTitle": "말타"
				},
				{
					"id": 761051501,
					"content": "#바위 게들이 다 모이면 무슨 일이 일어날지 궁금한데… {M#형}{F#누나}, 지금 시간 괜찮아요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "말타"
				},
				{
					"id": 761050107,
					"content": "미묘한 차이가 있는 것 같지만, 그건 넘어가자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				}
			]
		},
		{
			"id": 7610503,
