						],
						"pointId": 340100825
					}
				]
			},
			"dialogs": [
				{
					"id": 746910101,
					"content": "…어? 내, 내가 잘못 봤나? 저기… 도도코 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910102,
						746910103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746910102,
					"content": "여긴 폰타인이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910104
					]
				},
				{
					"id": 746910104,
					"content": "아… 아니야! 저기 진짜 도도코가 있다구. 저건… 바르벨로스의 도도코 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910105,
						746910106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746910105,
					"content": "만세!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910107
					]
				},
				{
					"id": 746910107,
					"content": "#후후, 이거 참 우연이군. {NICKNAME}와(과) 페이몬이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910108
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910108,
					"content": "바르벨로스처럼 엄청난 점술사의 입에서 「우연」이라는 말이 나오니까 좀 이상해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746910109,
					"content": "농담이 아니야. 정말 「우연」이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910110
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910110,
					"content": "#{NICKNAME}은(는) 세계 밖에서 온 「강림자」라, 운명이 티바트에 묶여 있지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910111
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910111,
					"content": "후후, 나를 포함한 수많은 점술사들도 네 미래는 예측할 수 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910112
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910112,
					"content": "하지만 이번 「우연」은 참 절묘하군. 얼마 전에 나는 우연히 기묘한 징조 하나를 엿봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910113
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910113,
					"content": "마침 한가하기도 해서, 그 징조를 점쳐보고 점괘의 궤적을 따라 여기까지 찾아온 거야… 심심풀이 겸 소소한 휴가랄까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910114
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910114,
					"content": "아, 그 징조를 쫓는 과정에서 희미한 운명의 실도 몇 가닥 붙잡았어. 실의 주인들 모습도 엿볼 수 있었지. 이 사람들이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910115
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910115,
					"content": "전부 아는 사람들이네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910116
					]
				},
				{
					"id": 746910116,
					"content": "#거봐, 내 말이 맞지? {NICKNAME}은(는) 친구가 많으니까 분명 알 거라고 했잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910117,
						746910118
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910117,
					"content": "이 목소리는…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910119
					]
				},
				{
					"id": 746910119,
					"content": "안녕, 반가워. 되게 오랜만이네? 이번에 바르가 점을 칠 때 나도 같이 참여했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910120
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910120,
					"content": "맞아. 앨리스가 고집부리지 않았으면, 나는 이 이름들을 무시해도 되는 변수로 보고 점술식에서 빼버렸을 테지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910121
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910121,
					"content": "그랬으면 넌 휴가를 못 갔을걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910122
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910122,
					"content": "게다가! 마녀가 예언을 내놓은 이상, 그 예언에 얽힌 아이들을 실망시켜선 안 되지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910123
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910123,
					"content": "아이라면 누구나 새로운 선물, 위대한 사명, 그리고 신비한 예언을 기대한다구… 아무튼 절대 빼먹으면 안 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910124
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910124,
					"content": "…정말 못 말린다니까. 그래도 이런 작은 변수들을 모으면, 내 점술식도 어느 정도 다듬을 수 있을 테지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910125
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910125,
					"content": "그래서 여기에 온 거야. 그 사람들을 만나보고, 가능하면 간단한 점도 봐주려고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910126
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910126,
					"content": "어… 그럼 그 사람들은 언제 오는데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910127
					]
				},
				{
					"id": 746910127,
					"content": "그런 것까지 자세히 점칠 여유는 없어. 아무튼——언젠가는 올 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910128
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910128,
					"content": "그래서 여기에 자리를 펴고, 계속 이렇게 기다리려는 거야…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746910129,
					"content": "상관없어. 이 도도코는 내 분신일 뿐, 나는 따로 연구를 계속하고 있으니까. 시간이 낭비되진 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910130
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910130,
					"content": "맞아! 내가 바르의 도도코에 자동 감지 센서도 달아놨어. 예언 대상이 앞에 오면 바르한테 알림이 가지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910131
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910131,
					"content": "게다가 도도코도 더 신나게 몸을 흔들어서, 오는 사람의 시선을 사로잡을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910132
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910132,
					"content": "넌 왜 또 돌아왔어? 팔 좀 치워, 그러다 내 수점반을 떨어뜨리겠어. 그리고 컵 제대로 잡아, 내 원고지에 핫초코 쏟지 말고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910133
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910133,
					"content": "알겠어 알겠어. 얘들아, 잠깐만… 이러면 됐다. 참, 바르, 이 잔은 네 거야. 진짜로 조금밖에 안 달아, 정말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910134
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910134,
					"content": "너와 나는 「조금 달다」의 기준이 전혀 달라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910135
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910135,
					"content": "크흠, 본론으로 돌아가서! 아무튼 바르의 점괘가 나온 후, 나는 그 친구들을 불러 모아 아주아주 성대한 파티를 열 생각이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910136
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910136,
					"content": "편지를 전할 방식까지 구상해서, 일부러 멋진 새들을 잔뜩 찾아놨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910137
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910137,
					"content": "상상해 봐. 고요한 한밤중에, 순백의 거대한 새가 수수께끼의 편지를 물고 찾아오는 거야. 그 편지를 여는 순간, 완전히 새로운 세계가 펼쳐지는 거지——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910138
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910138,
					"content": "하지만 그렇게 하면 운명의 궤적을 어지럽힐 뿐이야. 게다가 이런 사소한 예언을 처리하는 건 아주 번거로워. 그래서 내가 말렸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910139
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910139,
					"content": "정말 아쉽지만, 그래도 파티는 열 수 있어. 적당한 때가 되면 내가 모두를 초대할 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910140
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910140,
					"content": "#파티를 빨리 열 수 있도록, {NICKNAME}, 페이몬! 이 사람들을 데려오는 일은 너희한테 부탁해도 될까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910141
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910141,
					"content": "그, 그래도 괜찮을까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910142
					]
				},
				{
					"id": 746910142,
					"content": "하하… 이것도 운명의 궤적을 어지럽히는 거 아닌가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910143
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746910143,
					"content": "#음… 이들은 이미 {NICKNAME}와(과) 인연이 있는 사람들이니, 이론적으론 운명도 이미 얽혀 있는 셈이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910144
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910144,
					"content": "#{NICKNAME}이(가) 직접 가서 데려오는 정도라면, 점술 결과에 큰 영향은 없겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910145
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910145,
					"content": "역시 넌 정말 믿음직스럽다니까. 그럼 이 일은 부탁해. 대신 파티 때 케이크랑 제일 가까운 자리를 두 개 잡아줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910146
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910146,
					"content": "…바르, 갑자기 종이는 왜 찢어? 뭐 하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746910147
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910147,
					"content": "귀 막으려고. 너랑 니콜은 하나는 귀를 울리고, 하나는 머리를 울리잖아. 정말이지, 옥타비아가 그립다니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746910118,
					"content": "앨리스 씨?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910119
					]
				},
				{
					"id": 746910106,
					"content": "드디어 도도코가 세계를 점령했다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910107
					]
				},
				{
					"id": 746910103,
					"content": "요즘 도도코를 너무 많이 봐서 그런 거 아니야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746910104
					]
				}
			]
		}
	]
}