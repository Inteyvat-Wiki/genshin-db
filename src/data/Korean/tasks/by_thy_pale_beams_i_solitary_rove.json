			},
			"dialogs": [
				{
					"id": 726620101,
					"content": "이것 봐! 아버지의 항해일지를 다 뒤져봤는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620102
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620102,
					"content": "여기 특수한 미끼 제조법을 개발했다고 적혀있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620103
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620103,
					"content": "「해중월」을 만났을 때 해초와 마법 수정석이 섞인 특수한 미끼를 사용했다고 적혀있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620104
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620104,
					"content": "만약에 우리도 이 미끼를 만들 수 있으면 「해중월」을 유인할 수도 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620105
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620105,
					"content": "해초는 많은데, 마법 수정석은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620106
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620106,
					"content": "걱정하지 마세요, 저한테 있으니까요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620107
					]
				},
				{
					"id": 726620107,
					"content": "뭐? 진짜? 황해에서 캔 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620108
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620108,
					"content": "항해일지에 황해의 폐허에서 채굴한 마법 수정석만 된다고 적혀있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620109
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620109,
					"content": "일반 마법 수정석과 무슨 차이가 있는지 모르겠지만, 이왕 시작한 거 설명을 정확하게 따르는 게 좋을 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620110
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620110,
					"content": "황해에 마물들이 많으니까 위험할 거야. 모험가 길드에 가서 의뢰를 맡겨보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620111
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620111,
					"content": "괜찮아요, 저에게 맡겨줘요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620112
					]
				},
				{
					"id": 726620112,
					"content": "아… 그래, 너는 엄청 강한 모험가였지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620113
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620113,
					"content": "네가 도와줘서 정말 다행이다, 그럼 부탁 좀 할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620114
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620114,
					"content": "그럼 난 가서 미끼를 제작하는 도구 좀 챙겨올게, 황해 서쪽에 있는 모래사장에서 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쿠지라이 모미지"
				}
			]
		},
		{
