					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726620201,
					"content": "이렇게 빨리 끝났어? 역시 모험가는 다르구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620202
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620202,
					"content": "이 정도면 충분해요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620203
					]
				},
				{
					"id": 726620203,
					"content": "응, 이제 내게 맡겨, 이렇게 하고… 이렇게 해서… 마지막으로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620204
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620204,
					"content": "다 됐다, 이거면 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620205
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620205,
					"content": "이제 미끼를 뿌리고 「해중월」이 오기를 기다리면 되지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726620206,
					"content": "그때 이곳이 마지막으로 해중월을 마주한 곳이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620207
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620207,
					"content": "길을 알려주던 「해중월」도 이곳에서 사라졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620208
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620208,
					"content": "그럼 준비됐어? 「해중월」을 보면 소원 비는 거 잊지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620209
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620209,
					"content": "만약에 못 만나면 어떻게 해요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620210
					]
				},
				{
					"id": 726620210,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620211
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620211,
					"content": "부정 타는 말 하지 마, 꼭 성공할 거야, 「해중월」은 꼭 나타날 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620212
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620212,
					"content": "맞아! 꼭 성공할 거야! 대어야 대어야 어서 오너라! 이렇게 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726620213,
					"content": "저기! 저기를 봐! 물 밑에서 빛을 내며 다가오고 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620214
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620214,
					"content": "진짜? 진짜 「해중월」이 나타난 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726620215,
					"content": "우와——유적 가디언이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726620216,
					"content": "왜 이 녀석이 나타난 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
