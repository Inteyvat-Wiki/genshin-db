			"dialogs": [
				{
					"id": 726620301,
					"content": "어떻게… 이럴 수가 있지, 아버지의 미끼 제조법이 틀린 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620302
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620302,
					"content": "슬퍼하지 마! 유적 가디언 때문에 「해중월」이 도망갔을 거야! 다시 한번 해보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726620303,
					"content": "그래요, 한 번만 다시 해볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726620304
					]
				},
				{
					"id": 726620304,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620305
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620306
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620306,
					"content": "이제 그만하자, 나도 지쳤어. 난터크 말이 맞은 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620307
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620307,
					"content": "휴… 밖에 나가서 바람 좀 쐬고 싶어, 앞으로 어떻게 할지 생각도 좀 해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620308
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620308,
					"content": "여기 보상이야, 결과가 어떻게 됐든 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726620309
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726620309,
					"content": "쿠지라이는 혼자만의 시간이 좀 필요할 거 같아, 나중에 다시 보러 오자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		}
