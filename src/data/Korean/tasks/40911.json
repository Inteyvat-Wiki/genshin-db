			"dialogs": [
				{
					"id": 409110301,
					"content": "왔구나. 이게 바로 내 <color=#00E1FFFF>「원소 도가니」</color>야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110302
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 409110302,
					"content": "긴말 필요 없이 어서 실험을 시작해보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "데마로우스"
