			},
			"dialogs": [
				{
					"id": 409110401,
					"content": "몇 번만 더 가동하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110402
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 409110402,
					"content": "여행자! 잘 왔어, 「원소 도가니」 기억하니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110403
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 409110403,
					"content": "네가 「원소 도가니」를 가동시켜 줘서, 나도 꽤 많은 데이터를 모을 수 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110404
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 409110404,
					"content": "그리고 무엇보다도 성능을 확인할 수 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110405
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 409110405,
					"content": "이렇게 믿음직한 도구가 있으니, 더 많은 실험을 할 수 있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110406
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 409110406,
					"content": "여행자, 괜찮다면 「원소 도가니」를 다시 가동시켜 줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110407,
						409110409
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 409110407,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110408
					]
				},
				{
					"id": 409110408,
					"content": "그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 409110409,
					"content": "실험을 몇 번이나 하려고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110410
					]
				},
				{
					"id": 409110410,
					"content": "물론 많으면 많을수록 좋지. 나처럼 「신의 눈」이 없는 연금술사는 이런 원시적인 방법으로 연구할 수밖에 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110411
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 409110411,
					"content": "여행자, 그러니까 부탁 좀 할게. 다시 한번 「원소 도가니」를 가동시켜줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "데마로우스"
				}
			]
		}
	]
}