			"dialogs": [
				{
					"id": 140220801,
					"content": "…지금은 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220802
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140220802,
					"content": "조금만 더 왼쪽으로",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220803
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140220803,
					"content": "…이렇게?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220804
					],
					"speakerTitle": "키라라"
				},
				{
					"id": 140220804,
					"content": "좋아, 완벽해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220805
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140220805,
					"content": "읏챠…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220806
					],
					"speakerTitle": "키라라"
				},
				{
					"id": 140220806,
					"content": "와! 정말 잘 어울려요! 치오리 씨, 사진 한 장 찍어도 돼요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220807
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 140220807,
					"content": "물론이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220808
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140220808,
					"content": "치오리 언니가 새로운 간판까지 준비한 줄은 몰랐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220809
					],
					"speakerTitle": "키라라"
				},
				{
					"id": 140220809,
					"content": "패션 위크 전에 만든 거야. 패션쇼가 성공적으로 끝나면 걸려고 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220810
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140220810,
					"content": "자기 간판 하나 없이 어떻게 티바트를 휩쓸겠어? 그런 점에서 「가시 장미회」는 너보다 한발 앞선 셈이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220811
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140220811,
					"content": "음, 우리 마술단도 간판 하나 만들어야 할 거 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220812
					],
					"speakerTitle": "리니"
				},
				{
					"id": 140220812,
					"content": "오빠랑 내 대표 이미지는 「웃는 모자 고양이」와 「깜짝 고양이 모자」겠네. 페어도 추가해야 하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220813
					],
					"speakerTitle": "리넷"
				},
				{
					"id": 140220813,
					"content": "그럼 페어는… 「무표정 잠수모 펭귄」이려나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220814
					],
					"speakerTitle": "리니"
				},
				{
					"id": 140220814,
					"content": "푸하하하!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220815
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140220815,
					"content": "모자 안에 고양이 두 마리랑 펭귄 한 마리를 넣어야 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220816
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140220816,
					"content": "오, 엄청 따뜻하겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220817
					],
					"speakerTitle": "키라라"
				},
				{
					"id": 140220817,
					"content": "너무 비좁지 않을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220818
					],
					"speakerTitle": "리넷"
				},
				{
					"id": 140220818,
					"content": "#치오리 씨! 사진 다 찍었어요. {NICKNAME}이(가) 준 증거까지 더해서 내일 《스팀버드》 기사로 나갈 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220819
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 140220819,
					"content": "고마워, 샤를로트",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220820
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140220820,
					"content": "별말씀을요. 진실을 모두에게 알리는 게 기자의 사명인걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220821
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 140220821,
					"content": "앞으로 「베리떼 씨」의 장식은 전부 무료로 만들어 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220822
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140220822,
					"content": "아앗! 지… 진짜요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220823
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 140220823,
					"content": "물론이지. 리니랑 리넷도 나중에 무대 의상이 필요하면 언제든 말해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220824
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140220824,
					"content": "무대 의상이 아니어도 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220825
					],
					"speakerTitle": "리넷"
				},
				{
					"id": 140220825,
					"content": "정말 고마워, 치오리 씨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220826
					],
					"speakerTitle": "리니"
				},
				{
					"id": 140220826,
					"content": "난 됐어! 평소에 자주 놀러 오기나 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220827
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140220827,
					"content": "나도 괜찮아. 앞으로도 나한테 국제 배송을 맡겨주면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220828
					],
					"speakerTitle": "키라라"
				},
				{
					"id": 140220828,
					"content": "아, 그러고 보니 키라라 넌 언제 돌아갈 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220829
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140220829,
					"content": "엣! 그게… 저는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220830
					],
					"speakerTitle": "키라라"
				},
				{
					"id": 140220830,
					"content": "「가시 장미회」가 널 위해 수레를 준비했어. 거기에 태워서 널 폰타인 밖으로 보내줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220831
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140220831,
					"content": "그건 너무 창피하잖아요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220832
					],
					"speakerTitle": "키라라"
				},
				{
					"id": 140220832,
					"content": "헤헤, 그럼 우리한텐 뭐 해줄 거 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220833
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140220833,
					"content": "당연히 있지. 이따가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220834
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140220834,
					"content": "행사장 질서를 어지럽히고, 조명을 멋대로 사용한 데다, 신고도 없이 공공장소에서 무기를 사용해 위험한 공연을 펼치다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220835
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 140220835,
					"content": "앗, 슈브르즈, 그게 아니라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220836
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140220836,
					"content": "…혹시 방금 내가 묘사한 범죄자를 발견하면, 바로 이 특별 순찰대 대장에게 보고하도록 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220837
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 140220837,
					"content": "그렇게 읊으니까 재밌니? 깜짝 놀랐잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220838
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140220838,
					"content": "깜짝 놀란 건 나야. 다음엔 행사장에서 그런 짓 하기 전에 미리 좀 알려줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220839
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 140220839,
					"content": "말하면 허락해 줄 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220840
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140220840,
					"content": "아니, 하지만 적어도 놀라진 않겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220841
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 140220841,
					"content": "그래서 다 보상해 줬잖아? 잿빛의 강에서 유해 상품을 생산하는 악덕 공방 패거리들을 전부 거기에 묶어뒀다고. 그걸로 부족해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220842
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140220842,
					"content": "알았어, 더는 안 따질게. 오늘 밤은 내가 졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220843
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 140220843,
					"content": "뭐야, 다들 친구 사이였어? 그럼 이참에 같이 밥 먹자! 식비는 「가시 장미회」에 걸어두면 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220844
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140220844,
					"content": "난 아직 처리할 일이 많아서 빠질게. 다들 즐거운 시간 보내",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220845
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 140220845,
					"content": "참, 치오리, 오면서 웽거를 만났는데 말을 전해달라더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220846
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 140220846,
					"content": "됐어, 시답잖은 사과의 말이겠지. 그냥 나중에 직접 찾아가서 열심히 비웃어 줄래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220847
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140220847,
					"content": "그래, 그 사람은 네가 잘 알겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220848
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 140220848,
					"content": "이번에도 고마웠어, 슈브르즈",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220849
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140220849,
					"content": "당연한 일을 했을 뿐이야. 그리고——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220850
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 140220850,
					"content": "아까 패션쇼, 정말 아름다웠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220851
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 140220851,
					"content": "말 안 해도 알거든?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220852
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140220852,
					"content": "자자, 축하연에 올 친구들은 날 따라와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220853
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140220853,
					"content": "#{NICKNAME}, 페이몬, 풍경 좋은 곳에 가서 날 기다려 줄래? 나비아한텐 좀 늦는다고 얘기해 둘게. 너희에게 줄 게 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220854
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140220854,
					"content": "풍경 좋은 곳? 아! 거기 말이지? 알겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220855
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140220855,
					"content": "응, 금방 갈게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "치오리"
				}
			]
		},
