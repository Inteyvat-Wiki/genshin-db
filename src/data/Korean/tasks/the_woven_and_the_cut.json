			"dialogs": [
				{
					"id": 140221201,
					"content": "여긴 엄청 더러워 보이네. 위에 있는 옷을 정말 여기서 만든 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140221202,
					"content": "…저쪽을 봐봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221203
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140221203,
					"content": "윽… 물이 엄청 더러워. 여기까지 악취가 느껴질 정도야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140221204,
					"content": "우서 녀석, 이런 주제에 감히 내 원료를 문제 삼아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221205
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140221205,
					"content": "결국 악덕 공장은 자기가 연 거였네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140221206,
					"content": "어쩐지 옷의 촉감이 이상하다 했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221207
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140221207,
					"content": "원가를 절감하려고 공장 안에서 몰래 이런 짓을 하고 있었다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221208
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140221208,
					"content": "이렇게 만든 옷을 입을 수는 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140221209,
					"content": "색 빠짐이나 쪼그라드는 문제는 둘째 치고, 이런 원료로 만든 옷을 입다 보면… 피부에 문제가 생길 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221210
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 140221210,
					"content": "으으… 우리 얼른 증거 사진을 찍어두자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140221211,
					"content": "이러면 녀석도 심판청에서 발뺌 못 하겠지! 우리 계속 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
