			"dialogs": [
				{
					"id": 748000501,
					"content": "헉, 맞아요…. 그러네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000502,
						748000503
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 748000502,
					"content": "커피 다 식겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000503,
					"content": "전 다 마셨어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000504,
					"content": "#네, 여기까지 안전하게 데려다주셔서 감사해요, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000505
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 748000505,
					"content": "말이 좋아 데려다준 거지… 사실 그냥 널 따라왔을 뿐인걸. 아무것도 한 게 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000506,
						748000507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 748000506,
					"content": "나쁜 일도 일어나지 않았고요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000507,
					"content": "위험한 일도 겪지 않았고요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000508,
					"content": "맞아요. 제가 너무 생각이 많았나 봐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000509
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 748000509,
					"content": "커피 맛이 참 좋네요, 하하… 하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000510
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 748000510,
					"content": "…혹시 누군가가 독을 타진 않았겠죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000511,
						748000512
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 748000511,
					"content": "…켁",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000512,
					"content": "제발 그만 좀 하세요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000513,
					"content": "말도 안 되는 소리! 우린 다 마셨는데 멀쩡하잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000514
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 748000514,
					"content": "아뇨, 아뇨. 어쩌면… 특수한 트릭일 수도 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000515
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 748000515,
					"content": "먼저 범인은 우리가 마시는 커피에 첫 번째 약을 타요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000516
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 748000516,
					"content": "단독으로 섭취했을 땐 아무 영향이 없는 그런 약이요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000517
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 748000517,
					"content": "우리가 약을 먹으면 집으로 돌아갈 때 몰래 우리 뒤를 밟는 거예요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000518
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 748000518,
					"content": "그리곤 우리가 잠들면 방에 몰래 들어와서 물병에 두 번째 약을 넣는 거죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000519
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 748000519,
					"content": "그러면 다음 날 우리가 물병을 들고 나가 물을 마시는 순간, 두 약이 섞여서 반응을 일으키겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000520
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 748000520,
					"content": "그리고 우리는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000521
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 748000599,
					"content": "갑자기 급한 발걸음 소리가 들려온다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 748000521,
					"content": "손님, 대체 무슨 말씀하시는 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000522
					],
					"speakerTitle": "아루에"
				},
				{
					"id": 748000522,
