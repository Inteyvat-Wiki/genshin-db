			"dialogs": [
				{
					"id": 220480101,
					"content": "신사가 또 어지럽혀졌네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480102
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220480102,
					"content": "무슨 일이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480103
					]
				},
				{
					"id": 220480103,
					"content": "음냥, 자네들이군, 마침 잘 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480104
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220480104,
					"content": "신사 주변이 또 어지럽혀졌어, 낙엽들이 땅에 쌓여 있어서 보기에 안 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480105
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220480105,
					"content": "이 상태로는 신사에 참배하러 오는 인간들을 맞을 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480106
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220480106,
					"content": "자네들, 저번처럼 나를 도와 신사를 치워주겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480107,
						220480112
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220480107,
					"content": "타이유와 에츠코가 있지 않아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480108
					]
				},
				{
					"id": 220480108,
					"content": "이 몸이 직접 그 초록 초록한 인간들에게 말을 걸 순 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480109
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220480109,
					"content": "그 커다란 인간, 나를 보는 눈빛이 항상 이상하단 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480110
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220480110,
					"content": "또 다른 초록 초록한 인간도, 매일 맥 빠지는 얼굴을 하고 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480111
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220480111,
					"content": "야옹, 어떻게 생각해도 두 인간 다 믿음이 안 간단 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220480115,
					"content": "아무튼, 자네들한테 부탁을 좀 해야겠어. 저번과 같이, 길쭉한 막대기로 「청소」해 줘, 무슨 말인지 알지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480116,
						220480117
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220480116,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480118,
					"content": "아무튼, 이번 일은 자네들에게 맡길 테니, 나는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480119
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220480119,
					"content": "나는 여기서 자네들을 기다리지, 야옹",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220480117,
					"content": "대충 알겠어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480112,
					"content": "오오시마 씨에게 부탁하는 건…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480113
					]
				},
				{
					"id": 220480113,
					"content": "그 바위 인간은 계속 바빠, 뚱땅뚱땅 뭘 그리 두드리는 건지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480114
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220480114,
					"content": "이미 돌멩이는 두드려져 있는 건데, 도대체 왜 계속 뚱땅거리는 거야, 짜증 나게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "「네코」"
				}
			]
		},
