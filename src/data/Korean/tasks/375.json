					"벤티"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3750101,
					"content": "휴, 역시 안 되는 건가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750102
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750102,
					"content": "여, 역시라니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3750103,
					"content": "#그냥 기사단의 슈퍼 신인으로서 {NICKNAME}이(가) 자격이 있는지 확인하고 싶었을 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750104
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750104,
					"content": "용사가 마을에 온 김에 겸사겸사 귀중한 보검을 가져갔다——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750105
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750105,
					"content": "어때 후세에 전하기 딱 좋은 노래잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750106
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750106,
					"content": "흥, 그런 비유는 실례잖아, 음유시인",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3750107,
					"content": "오해야, 오해. 몬드에 대해 실망했을 뿐이라구, 용사에게 보검을 아까워하다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750108
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750108,
					"content": "음, 대놓고 빌리긴 힘들 것 같네, 아무래도 다른 수단이 필요할 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750109
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750110,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750111
					]
				},
				{
					"id": 3750109,
					"content": "자, 각자의 의견을 충분히 존중해줄 테니 맘껏 말해봐, 어떻게 훔치는 게 좋겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750110
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750112,
					"content": "사실 훔치는 건 싫어!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750113
					]
				},
				{
					"id": 3750111,
					"content": "괜찮아, 편하게 말해봐. 그래야 좋은 아이디어가 나오지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750112
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750113,
					"content": "하하하, 주제에서 벗어났잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750114
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750114,
					"content": "사실 이 일은 나보다 네가 더 적합해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750115
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750115,
					"content": "난 노래 말곤 잘하는 게 없단 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750116
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750116,
					"content": "게다가 난 몬드에 아는 사람도 없어. 잡히면 처벌받을 게 분명해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750117
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750117,
					"content": "물건을 훔치다가 잡혀도 억울할 건 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3750118,
					"content": "하지만 넌 달라, 넌 몬드에 한 공헌도 있고, 기사단 미래의 스타잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750119
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750119,
					"content": "걸리면 잘 변명해봐, 그냥 넘어갈 수도 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750120
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750140,
					"content": "게다가 여기 경비병은 밤에 바로 퇴근하는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750141,
					"content": "후훗, 이 시기를 이용하면 실수하려도 할 수 없겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750120,
					"content": "걸릴 걸 염두에 두고 추천한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3750122,
					"content": "방금 자신을 바르바토스라고 했지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750123
					]
				},
				{
					"id": 3750121,
					"content": "#{NICKNAME}… 어떻게 생각해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750122
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750123,
					"content": "음, 그렇게 말하긴 했지——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750124
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750125,
					"content": "네가 정말 신이라면 그냥 보고만 있으면 안 돼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750126
					]
				},
				{
					"id": 3750124,
					"content": "왜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750125
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750126,
					"content": "오? 이유가 뭐지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750127
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3750128,
					"content": "만약 네가 신이 아니라 해도 난 드발린을 구할 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750129
					]
				},
				{
					"id": 3750127,
					"content": "#{NICKNAME}의 과거에 대한 이야기는 나중에 천천히 말해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3750130,
					"content": "널 위해 「천공」을 가져다 줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750131,
					"content": "난 더는 이별하는 걸 보고 싶지 않아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750129,
					"content": "…뭐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750130,
						3750131
					],
					"speakerTitle": "벤티"
				}
			]
		},
