			},
			"dialogs": [
				{
					"id": 412120101,
					"content": "알베도! 우리 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412120102,
					"content": "어랏, 손님이 있네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120103,
						412120104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412120103,
					"content": "낯이 익어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				},
				{
					"id": 412120105,
					"content": "새내기 모험가를 설산으로 보내다니 내가 너무 성급했나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120106
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 412120106,
					"content": "하지만 자고로 모험이란 자신의 한계에 도전하는 거잖아? 자극 없는 여정이 무슨 재미가 있겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120107
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 412120107,
					"content": "이 일대에 흉악한 도적 츄츄족과 무릎까지 쌓인 눈밖에 없다 해도 모험가들은 발걸음을 멈출 수가 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120108
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 412120108,
					"content": "사이러스 씨, 본론을 말씀하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120109
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412120109,
					"content": "하하하, 뭘 모르는군! 수다는 탐험같이 과정이 중요하지, 본론이 어디 있겠나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120110
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 412120110,
					"content": "약탈 당해 거점을 포기하고, 차디찬 눈속에 불을 피워 밥도 짓고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120111
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 412120111,
					"content": "설산 여정은 모험가 협회의 새내기들에게 평생 잊지 못할 경험이 될 걸세, 하하하!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120112
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 412120112,
					"content": "네, 그렇죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120113
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412120113,
					"content": "지금이야 날 원망하고 미워할지 몰라도, 나중에는 이 추억을 만들어준 내게 감사할 거야. 이게 바로 모험의 대물림이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120114
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 412120114,
					"content": "네, 계속 말씀하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120115
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412120115,
					"content": "와우… 알베도의 고질병이 또 도졌어. 관심 없는 일엔 완전 냉담해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412120116,
					"content": "모험가에 대해 별 관심이 없어 보이긴 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120117
					]
				},
				{
					"id": 412120117,
					"content": "그래? 너한텐 관심 많은 것 같던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412120118,
					"content": "하지만 새내기들이 너무 나약한 건지, 아니면 설산이 너무 막강한 건지, 이번엔 손실이 엄청나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120119
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 412120119,
					"content": "왜 손실이 엄청난데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412120120,
					"content": "어…! 넌…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120121
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 412120121,
					"content": "안녕하세요, 사이러스 씨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120122
					]
				},
				{
					"id": 412120122,
					"content": "오랜만이야——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412120123,
					"content": "아~ 젊은 모험가와 날아다니는 친구고만 여기서 보다니 반갑군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120124
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 412120124,
					"content": "이 혹한의 산맥을 잘 헤쳐나가길 바라네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120125
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 412120125,
					"content": "이런 것쯤은 아무것도 아니지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412120126,
					"content": "하하하, 맞아! 그 자신감, 참 마음에 들어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120127
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 412120127,
					"content": "눈보라를 헤치고 여기까지 오다니, 무슨 일이라도 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120128
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 412120128,
					"content": "설산의 츄츄족 데이터를 수집하려고 제가 조수 역할을 부탁했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120129,
						412120130
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412120129,
					"content": "(엥? 그런 거야?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120131,
					"content": "그렇군, 다들 꿈을 찾아 여기로 모인 거였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120132
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 412120132,
					"content": "다들 원하는 바를 이루길 바라네. 난 새내기들 좀 보러 가야겠어. 그럼 이만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120201
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 412120201,
					"content": "후후, 나 뭔가를 알아낸 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412120202,
					"content": "알베도가 사이러스 씨를 속였어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120203
					]
				},
				{
					"id": 412120203,
					"content": "마검이니까 다른 몬드 사람에겐 알리고 싶지 않은 게 당연해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412120204,
					"content": "다 들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120205
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412120205,
					"content": "뭘 좀 물어봐도 될까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120206
					]
				},
				{
					"id": 412120206,
					"content": "우리 사이에 뭐 그런 걸 묻고 그래. 궁금하다면 다 말해줄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120207
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412120207,
					"content": "——하지만 지금은 아니야. 아주 중요한 일을 처리해야 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120208
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412120208,
					"content": "일? 음, 네 개인적인 일이겠지만… 왠지 우릴 가만히 안 놔둘 것 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412120209,
					"content": "페이몬, 너 점점 똑똑해지는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120210
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412120210,
					"content": "무슨 소리야! 나 원래부터 똑똑했거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412120211,
					"content": "근처에서 새로운 서식지를 발견했어. 다양한 속성의 몬스터들이 다양한 데이터를 제공해줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120212
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412120212,
					"content": "실험하는 거 진짜 좋아하는구나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120213
					]
				},
				{
					"id": 412120213,
					"content": "실험은 끈기가 있어야 성공하는 법, 연금술사에게 끈기는 필수 덕목이라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120214
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412120214,
					"content": "준비됐어? 그럼 출발하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "알베도"
				},
				{
					"id": 412120130,
					"content": "(검에 대해선 숨기려는 것 같아)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120104,
					"content": "내가 아는 얼굴인가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				}
			]
		},
