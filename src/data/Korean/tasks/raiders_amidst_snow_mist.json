					"content": "생각보다 훨씬 진솔하네!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120315,
					"content": "Tiga plata!",
					"roleType": "TALK_ROLE_NPC",
