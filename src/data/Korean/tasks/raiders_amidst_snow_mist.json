					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120319
					]
				},
				{
					"id": 412120319,
					"content": "무슨 말도 안 되는 소리야?",
					"roleType": "TALK_ROLE_NPC",
