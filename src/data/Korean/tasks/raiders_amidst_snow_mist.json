					"nextDialogs": [
						412120606
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412120606,
					"content": "이 설산은 무시무시하게 커. 중턱에 길이 있다고 해도 안전한 길은 아닐 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
