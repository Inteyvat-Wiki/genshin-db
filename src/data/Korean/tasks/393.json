			},
			"dialogs": [
				{
					"id": 3930101,
					"content": "모든 게 끝나고 나면, 이 이야기를 노래로 만들까 싶어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930102,
						3930103
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3930102,
					"content": "정말 많은 일이 있었지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				},
				{
					"id": 3930104,
					"content": "응, 이 노래도 《바네사 전기》처럼 몬드의 사람들에게 전해지겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930105
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3930105,
					"content": "전 그 노래를 어릴 때부터 좋아했습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930106
					],
					"speakerTitle": "진"
				},
				{
					"id": 3930106,
					"content": "그럼 명예 기사… 오늘 컨디션은 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930107
					],
					"speakerTitle": "진"
				},
				{
					"id": 3930107,
					"content": "난 컨디션 점검을 마쳤어. 분명 모두에게 도움이 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930108,
						3930109
					],
					"speakerTitle": "진"
				},
				{
					"id": 3930108,
					"content": "진 단장님은 정말 믿음직스러워요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930110,
					"content": "그러고 보면 다이루크 어르신도 우리랑 끝까지 함께했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3930111,
					"content": "처음엔 그냥 얼떨결에 말려든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3930112,
					"content": "말려든… 음… 행인? …이랄까, 뭐 아무튼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3930113,
					"content": "내게 비밀을 공유했으니 나도 믿음으로 보답하는 것뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930114,
						3930117,
						3930120
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 3930114,
					"content": "어르신이 여기까지 오신 이유는 「믿음」이었군요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930115
					]
				},
				{
					"id": 3930115,
					"content": "그리고 진 단장의 이유는 「책임」이겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3930116,
					"content": "그럼 각설이는?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3930121,
					"content": "「자유」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930122
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3930122,
					"content": "자유…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3930123,
					"content": "몬드에 왔을 때 몬드가 「자유의 도시」라고 사람들이 말 안하던?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930124
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3930124,
					"content": "엠버…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930125
					]
				},
				{
					"id": 3930125,
					"content": "아하하, 녀석도 참 자유로운 꼬맹이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930126
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3930126,
					"content": "몬드는 「국왕」의 통치가 없는 낭만적인 도시 국가야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930127
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3930127,
					"content": "그리고 몬드의 국민은 일곱 나라 중에서도 가장 자유로운 국민이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930128
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3930128,
					"content": "난 정말, 일찍이 몬드를 수호하던 용도 그랬으면 좋겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930129
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3930129,
					"content": "누구도 드발린에게 「이 도시가 널 배신했다」는 말로 기만해서도,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930130
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3930130,
					"content": "「이 도시를 수호하는 것이 네 영원한 의무다」라는 말을 뱉어서도 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930131
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3930131,
					"content": "녀석에겐 자신의 삶을 선택할 권리가 있다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930132
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3930132,
					"content": "벤티…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3930133,
					"content": "#자아, {NICKNAME}, 몬드의 천년의 바람이 너와 함께 한다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930134
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3930134,
					"content": "이제 지난번처럼 네게 「바람」 원소의 힘을 인도해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930135,
						3930136
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3930135,
					"content": "「지난번」이라면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930137,
					"content": "아하! 그래서 목소리가 익숙하다고 한 거였구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3930136,
					"content": "그럴 줄 알았어. 그때 그 목소린 역시 너였구나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930137
					]
				},
				{
					"id": 3930117,
					"content": "진 단장의 이유는 「책임」이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930118
					]
				},
				{
					"id": 3930118,
					"content": "그리고 다이루크 어르신의 이유는 「믿음」이려나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3930119,
					"content": "그럼 각설이는?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3930120,
					"content": "그럼 벤티는?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930121
					]
				},
				{
					"id": 3930109,
					"content": "걱정 마세요. 저도 컨디션 최고라고요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930110
					]
				},
				{
					"id": 3930103,
					"content": "벤티하고 오랜 파트너가 된 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3930104
					]
				}
			]
		}
	]
}