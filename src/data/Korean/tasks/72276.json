			"dialogs": [
				{
					"id": 722761201,
					"content": "돌아오셨군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761202
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722761202,
					"content": "안녕하세요, 이름이…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761203
					]
				},
				{
					"id": 722761203,
					"content": "야베잖아요, 야베! 내 이름은 야베예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761204
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722761204,
					"content": "휴, 제 이름 정도는 기억해 주세요. 설마 제 의뢰를 잊으신 건 아니죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761205
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722761205,
					"content": "#{NICKNAME}이(가) 장난친 거야. 우리 분코쿠 보물의 진실을 찾았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722761206,
					"content": "야베에게 자초지종을 설명한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722761207
					]
				},
				{
					"id": 722761207,
					"content": "그러니까 양염 환술과 보물 창고는 진짜인데 중간에 다른 일이 있었다고요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761208
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722761208,
					"content": "원혼과 오염도 진짜 있는 일이고, 사람을 조종할 수도 있다니. 휴, 깜짝 놀랐네. 당신들이랑 같이 안 가서 다행이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761209
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722761209,
					"content": "우리를 다치게 할까 봐요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761210
					]
				},
				{
					"id": 722761210,
					"content": "당신들한테 맞을까 봐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761211
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722761211,
					"content": "고마워요, 만족스럽긴 하지만 조금 아쉽네요. 아주 신기하지만 원소의 힘으로 설명할 수 있는 얘기라 뭔가 2% 부족한 느낌이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761212
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722761212,
					"content": "분코쿠 미스터리가 드디어 해결됐네요, 세상에 알려야겠어요",
