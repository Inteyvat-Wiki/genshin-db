			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"야베"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722760101,
					"content": "#당신이 {NICKNAME} 맞나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760102
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722760102,
					"content": "아직 제 이름을 기억하시는지 모르겠네요, 전 야베라고 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760103
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722760103,
					"content": "안녕하세요, 야베 씨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760104
					]
				},
				{
					"id": 722760104,
					"content": "헤헤, 안녕하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760105
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722760105,
					"content": "아마 당신은 잘 싸우시겠죠? 라이덴 쇼군과 정면으로 맞서고 연하궁에서도 활약했잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760106
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722760106,
					"content": "그런 일이 있긴 했죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760107
					]
				},
				{
					"id": 722760107,
					"content": "잘됐네요, 위험할지도 모르는 보물의 단서를 알고 있는데 혹시 관심 있으세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760108
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722760108,
					"content": "미스터리한 걸 좋아하지만 겁이 좀 많거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760109
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722760109,
					"content": "관심 있어요. 계속 얘기해 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760110
					]
				},
				{
					"id": 722760110,
					"content": "다이니치 미코시를 순찰할 때 이런 걸 찾았어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760111
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722760111,
					"content": "평범한 석판처럼 보이지만, 「분코쿠 보물」을 찾을 수 있는 중요한 단서 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760112
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722760112,
					"content": "분코쿠 보물?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760113
					]
				},
				{
					"id": 722760113,
					"content": "백야국의 역사가 와타츠미섬까지 전해지지 않아서 자세히는 저도 잘 몰라요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760114
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722760114,
					"content": "전해지는 이야기에 따르면, 두 번째 재상인 분코쿠가 「태양의 아이」와 함께 터무니없이 높은 세금을 걷었고, 그 후에 보물을 다이니치 미코시에 있는 비밀의 방에 숨겼다고 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760115
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722760115,
					"content": "분코쿠는 양염 환술로 보물의 방을 숨기고, 지맥의 귀신과 원념을 불러들여 보물을 지키게 했대요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760116
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722760116,
					"content": "당연하지만 분코쿠도 테 어쩌고 스라는 고대 이름이 있을 텐데, 소인과 간신의 이야기를 자세히 기록한 사람은 아무도 없어서 알 수가 없네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760117
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722760117,
					"content": "석판 얘기 다시 해주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760118
					]
				},
				{
					"id": 722760118,
					"content": "이 석판이 분코쿠 보물 창고의 중요한 단서일 거예요. 제가 괴담이나 전설, 미스터리 사건을 오랫동안 봐온 결과——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760119
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722760119,
					"content": "석판에… 어… 그러니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760120
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722760120,
					"content": "솔직하게 말해봐요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760121
					]
				},
				{
					"id": 722760121,
					"content": "솔직히 말하자면, 다이니치 미코시의 창고에서 석판을 찾았을 때, 옆에 두 가지 언어로 적힌 쪽지가 있었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760122
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722760122,
					"content": "과도기 시절에 분류한 문물은 설명을 두 가지 언어로 기록했더군요. 쪽지에는 석판이 「분코쿠 사건」과 직접적인 연관이 있다고 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760123
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722760123,
					"content": "석판은 총 8개이고, 현재 이 석판만 회수했다고 적혀 있어요. 분코쿠 밀실도 기록대로라면 이 근처에 있겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760124
					],
					"speakerTitle": "야베"
				},
				{
					"id": 722760124,
