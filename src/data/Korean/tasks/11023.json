			"dialogs": [
				{
					"id": 110231131,
					"content": "…길에 이게 다 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231132
					],
					"speakerTitle": "완연"
				},
				{
					"id": 110231132,
					"content": "이 사람들은 뭘 봤고… 뭘 했을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231133
					],
					"speakerTitle": "완연"
				},
				{
					"id": 110231133,
					"content": "그리고… 대체 무슨 일이 있었던 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231134
					],
					"speakerTitle": "완연"
				},
				{
					"id": 110231134,
					"content": "날 믿지 못하겠다면 계속 앞으로 가보시게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231135
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110231135,
					"content": "그때 벌어졌던 모든 일과 이 문 뒤에 남아있는 흔적 모두 사실대로 기록되어 있을 테니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
