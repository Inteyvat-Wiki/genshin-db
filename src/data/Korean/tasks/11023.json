				"points": []
			},
			"dialogs": [
				{
					"id": 110230501,
					"content": "흥, 자잖아. 아무짝에도 쓸모없어 보이는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230502
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110230502,
					"content": "이건… 제 기억이 맞다면 측량기인 것 같은데요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230503
					],
					"speakerTitle": "완연"
				},
				{
					"id": 110230503,
					"content": "정답일세. 하지만 「소금의 마신」의 권능이 담겨있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230504
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110230504,
					"content": "이 자를 땅에 꽂으면 땅에서 물이 솟구치듯 소금이 샘솟는다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230505
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110230505,
					"content": "깊이 꽂을수록 소금이 더 많이 나오지. 그야말로 소금 「풍년」이랄까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230506
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110230506,
					"content": "그, 그렇다면… 소금 단지보다 더 대단한 거잖아요?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230507
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110230507,
					"content": "그럼 계약에 따라 이 소금 자는 완연 아가씨 것일세",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230508
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110230508,
					"content": "안 돼! 동의할 수 없습니다! 비용도 내가 댔고, 이 탐사대도 내가 만들었는데, 밑지는 장사는 못 하죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230509
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110230509,
					"content": "그리고 이 아가씨는 아무 도움도 안 됐는데 이걸 왜 줍니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230510
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110230510,
					"content": "역시 이렇게 나오는군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230511,
						110230512
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110230511,
					"content": "휴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				},
				{
					"id": 110230513,
					"content": "「계약」을 깨고 싶다는 소리인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230514
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110230514,
					"content": "깨면 어쩔 건데요? 이 유적에 있는 장치는 대충 파악했으니, 이제 당신은 필요 없다고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230515
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110230515,
					"content": "그리고 내가 당신을 고용했는데, 왜 내가 당신이 하라는 대로 해야 합니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230516
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110230516,
					"content": "그야 자네는 계약을 맺었으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230517
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110230517,
					"content": "암왕제군은 「계약을 체결했지만 약속을 지키지 않는 자에겐 돌을 먹는 형벌을 내린다」고 했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230518
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110230518,
					"content": "그건 리월의 신이잖아요. 난 스네즈나야 사람이라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230519
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110230519,
					"content": "그렇다면 「돌을 먹는 형벌」을 한번 맛보시게…. 그리 녹록진 않을 걸세",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "종려"
				},
				{
					"id": 110230512,
					"content": "저런 말까지 했으니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				}
			]
		},
