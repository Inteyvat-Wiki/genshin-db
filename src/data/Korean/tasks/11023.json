					"nextDialogs": [
						110231126
					]
				},
				{
					"id": 110231126,
					"content": "자, 이제 나와 함께 「고운각」으로 가주겠나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231127
					],
					"speakerTitle": "종려"
				},
				{
