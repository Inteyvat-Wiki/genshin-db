					"키미나미 안나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721840301,
					"content": "돌아왔군요, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840302
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 721840302,
					"content": "어때요, 수확은 좀 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840303
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 721840303,
					"content": "손님의 피드백에 대해서…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840304
					]
				},
				{
					"id": 721840304,
					"content": "제비꽃 열매로 피자를 만들면… 어렵지는 않은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840305
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 721840305,
					"content": "다른 식자재는 원래대로 준비하고, 음 「이나즈마 본토의 특산품을 넣으면」이라고 했으니 다른 식자재도 조금 추가해봐야겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840306
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 721840306,
					"content": "음, 바다 불로초? 음, 울림풀? 음… 형광 버섯도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840307
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 721840307,
					"content": "그, 도와드릴까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840308
					]
				},
				{
					"id": 721840308,
					"content": "아! 죄송해요. 어떤 식자재를 넣을지 고민하다, 그만! 어디 보자, 가게에 제비꽃 열매가 얼마 없는 거 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840309
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 721840309,
					"content": "여행자, 제비꽃 열매 좀 구해주시겠습니까. 재료는… 제비꽃 열매만 있으면 될 거 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840310,
						721840312
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 721840310,
					"content": "맡겨만 줘요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840311
					]
				},
				{
					"id": 721840311,
					"content": "그럼 제비꽃 열매 하나만 부탁해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 721840312,
					"content": "다른 식자재는 필요 없어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840313
					]
				},
				{
					"id": 721840313,
					"content": "다른 식자재는 가게에 아직 좀 남아 있어서, 제비꽃 열매 한 개만 있으면 될 거 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "키미나미 안나"
				}
			]
		},
