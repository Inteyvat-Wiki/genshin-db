				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950201,
					"content": "음… 재료 수집기가 공정을 완료할 때마다 재료를 기계에 주입해야 한다면, 한 번 만들 때마다 세 번 왕복해야 하니, 너무 까다로운 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950202
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950202,
					"content": "개선할 수 있는 방법을 고민해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르트랑"
				}
			]
		},
		{
			"id": 7269503,
			"completionStepIds": [
				7269503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269503",
							"2"
						],
						"stepId": 7269503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"베르트랑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950301,
					"content": "어때, 재료 수집기는 쓸만해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950302
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950302,
					"content": "잘되어가고 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950303
					]
				},
				{
					"id": 726950303,
					"content": "이 「재료 수집기」도 나의 야심작 중 하나야. 전처럼 원자재를 수집하든, 아니면 지금처럼 원소의 힘을 저장하든 여러모로 유용하게 사용할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950304
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950304,
					"content": "사실 내가 지금 「재료 수집기」의 이름을 새로 지을까 고민 중인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950305
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950305,
					"content": "지금도 심플하고 좋은데 왜 바꾸려는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950306,
						726950307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726950306,
					"content": "맞아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				},
				{
					"id": 726950308,
					"content": "글쎄… 지금 이름은 수식어가 좀 부족해서 초라한 것 같지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950309
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950309,
					"content": "자, 「재료 수집기」를 이리 줘봐. 이번에도 프로토타입 공정을 좀 관찰해야겠어. 특히 원소의 힘과 관련되었으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950310
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950310,
					"content": "「울트라 대왕 머신」 안의 원소 반응이 안정된 후에야 다음 공정을 계속할 수 있을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950311
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950311,
					"content": "그때 다시 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950307,
					"content": "지금도 어울려",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				}
