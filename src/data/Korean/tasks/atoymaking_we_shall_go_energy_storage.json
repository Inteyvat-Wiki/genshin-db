				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950101,
					"content": "베르트랑!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726950102,
					"content": "#{NICKNAME}, 페이몬이구나. 마침 잘 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950103
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950103,
					"content": "내 유일무이한… 아니다 내 「울트라 대왕 머신」이 수집한 재료 처리를 완료했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950104
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950104,
					"content": "처리 결과는 어떤가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950105
					]
				},
				{
					"id": 726950105,
					"content": "내가 이래 보여도 기술은 폰타인에서 갈고닦았지, 내가 만든 기계인데 문제 있을 리가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950106
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950106,
					"content": "난 폰타인 출신이야. 세상에서 우리보다 정밀 기기를 더 잘만들고 잘다루는 사람은 없다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950107
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950107,
					"content": "지난번은 준비 자체가 완벽하지 않았고 시험 가동에 필요한 재료 수집을 도와줄 사람도 없었기에 장난감이 폭발한 거야. 이번에는 달라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950108
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950108,
					"content": "그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726950109,
					"content": "만약 이번에도 장난감이 폭발한다면, 내 마지막 적금과 노후도 함께 폭발해버리는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950110
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950110,
					"content": "나를 믿지 않더라도 노후를 걸겠다는 각오만은 믿어 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950111
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950111,
					"content": "장난감 제조업자는 이런 각오가 필요한 직업이었던가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726950112,
					"content": "자, 이제 다음 공정을 시작하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950113
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950113,
					"content": "혹시나 해서 묻는데, 3개 공정에서 현재 우리가 완료한 것은 「원자재 수집」이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950114
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950114,
					"content": "다음 공정은 「코어 수집」일까 「충전 수집」일까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950115,
						726950118
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950115,
					"content": "「코어 수집」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950116
					]
				},
				{
					"id": 726950116,
					"content": "정답이… 아니야, 네가 정말 코어를 수집한다면 내 노후를 망치는데 일조하는 셈이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950117
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950117,
					"content": "정답은 「원소 충전」이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950121,
					"content": "아무튼… 「원소 충전」을 하려면 「재료 수집기」를 휴대하고 원소의 영향을 받는 상태에 있어야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950122
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950122,
					"content": "예를 들어 물 원소를 수집하려면 「재료 수집기」를 가지고 강물 속에 한동안 서 있어야 해. 번개 원소를 수집하려면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950123
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950123,
					"content": "벼락을 맞으라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726950124,
					"content": "에이, 너희들은 모험가잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950125
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950125,
					"content": "모험가의 피지컬은 충분히 버텨낼 수 있을 거라고 믿어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950126
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950126,
					"content": "믿는 게 피지컬이라니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950127
					]
				},
				{
					"id": 726950127,
					"content": "사실 가장 좋은 방법은 원소 생물과 접촉하는 것이야. 이나즈마에서 여행할 때 원소 생물이 자주 출몰하는 장소를 세 곳을 표시해 놓았거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950128
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950128,
					"content": "원래는 정말 도우미를 찾지 못하면 나 혼자 비밀리에 배를 타고 표시한 곳에 가서 원소 생물과 접촉할 생각이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950129
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950129,
					"content": "그건 너무 위험해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726950130,
					"content": "지금은 너희가 있잖아. 표시한 장소에 가서 원소 생물이 있는지 살펴봐 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950131
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950131,
					"content": "그럼 「원소 충전」을 부탁한다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950118,
					"content": "「충전 수집」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950119
					]
				},
				{
					"id": 726950119,
					"content": "하하, 얼핏 보면 맞는 것 같지만 사실 정답은 「충전 수집」이 아니라 「원소 충전」이야. 내가 준 두 가지 선택지가 모두 정답이 아닐 줄은 몰랐지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950120
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726950120,
					"content": "웃는 게 약 올리는 것 같아서 재수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "페이몬"
				}
			]
		},
