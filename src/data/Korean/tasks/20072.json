			"dialogs": [
				{
					"id": 200720301,
					"content": "전에 설산에 묻어뒀던 꽃은 어떻게 됐나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720302
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200720302,
					"content": "이번 거랑 합해서 여기 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720303
					]
				},
				{
					"id": 200720303,
					"content": "다 가져오신 거예요? 정말 대단해요. 어서 보여주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720304
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200720304,
					"content": "후후, 상태가 좋은데요? 음… 이 방법은 쓸 만하네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720305
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200720305,
					"content": "하지만 설산은 몬드성에서 너무 멀어요. 매번 당신에게 부탁할 수도 없으니 다른 방법을 생각해야 돼요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720306
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200720306,
					"content": "그래도 도와줘서 고마워요. 이건 사례니까 받아주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "플로라"
				}
			]
		},
