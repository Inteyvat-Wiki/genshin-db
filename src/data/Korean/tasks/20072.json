			"dialogs": [
				{
					"id": 200720201,
					"content": "꽃은 어떻게 됐나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720202
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200720202,
					"content": "미안해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720203
					]
				},
				{
					"id": 200720203,
					"content": "네? 왜 그러세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720204
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200720204,
					"content": "상자와 꽃이 다 망가졌어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720205
					]
				},
				{
					"id": 200720205,
					"content": "마, 망가졌다고요?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720206
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200720206,
					"content": "흑흑… 그건 제가 엄선한 꽃들이에요, 그렇게 품질 좋은 꽃은 찾기 어려운데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720207
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200720207,
					"content": "설산이 정말 그렇게 위험한가요? 당신 같은 모험가도 실수하다니. 꽃 한 상자조차…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720208
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200720208,
					"content": "그래도 도와줘서 고마워요. 이거 받으세요. 전 꽃을 보살피러 가게로 가봐야 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720209
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200720209,
					"content": "휴, 이제… 사라 씨가 말했던 방법을 다시 시도해봐야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "플로라"
				}
			]
		},
