				"objectNames": [
					"오오시마 준페이"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130301,
					"content": "휴, 망치도 없고 끌도 없고 어떻게 하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130302
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722130302,
					"content": "무슨 문제라도 생겼나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130303
					]
				},
				{
					"id": 722130303,
					"content": "아, 왔어. 그게… 이곳에 올 때 공구 상태를 확인하지도 않고 그냥 와버렸네. 공구 상태가 엉망이었는지 작업하다가 부러져버렸어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130304
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722130304,
					"content": "나루카미섬에 돌아가서 공구를 사 오고 싶지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130305
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722130305,
					"content": "그게… 조각이라는 게 중간에 흐름이 끊기면 안 돼서 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130306
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722130306,
					"content": "망치와 끌이 망가졌지만, 어떻게 마무리 할지 생각 하고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130307
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722130307,
					"content": "지금 조각을 멈추고 나루카미섬으로 돌아가서 공구를 사면… 흐름이 끊겨서 처음부터 다시 느낌을 찾아야 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130308
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722130308,
					"content": "그리고 이 돌 자체가 아주 단단해서 일반 공구를 사용하면 얼마 못 쓰고 망가질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130309
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722130309,
					"content": "흠… 하는 수 없지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130310
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722130310,
					"content": "여행자, 괜찮으면 철광석 3개만 구해줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130311
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722130311,
					"content": "직접 공구를 제작해서 조각을 해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130312,
						722130314
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722130312,
					"content": "저한테 맡기세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130313
					]
				},
				{
					"id": 722130313,
					"content": "오! 그럼 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722130314,
					"content": "직접… 만드신다고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130315
					]
				},
				{
					"id": 722130315,
					"content": "타타라스나에서 일을 했었는데 대장장이 일도 어느 정도는 할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130316
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722130316,
					"content": "하지만 신사 내에서 불을 붙이다가는 고양이 대리 궁사님한테 혼날 거 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130317
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722130317,
					"content": "아무튼, 철광석 3개만 부탁해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "오오시마 준페이"
				}
			]
		},
