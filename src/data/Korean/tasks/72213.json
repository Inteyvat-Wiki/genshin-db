			},
			"dialogs": [
				{
					"id": 722130101,
					"content": "「복수」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130102
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722130102,
					"content": "조각은 어떻게 됐어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130103
					]
				},
				{
					"id": 722130103,
					"content": "그 바위 인간 정말 대단하더군, 야옹",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130104
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722130104,
					"content": "벌써 다 만들었어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130105
					]
				},
				{
					"id": 722130105,
					"content": "아니, 순식간에 엄청 큰 돌멩이를 구해왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130106
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722130106,
					"content": "그러고는 계속 「일단」, 「복수」라고 하고는 돌멩이를 두드리기 시작했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130107
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722130107,
					"content": "그건 그렇고 「일단」, 「복수」가 도대체 뭐 하는 물건이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130108
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722130108,
					"content": "「일당」, 「보수」겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130109
					]
				},
				{
					"id": 722130109,
					"content": "쉽게 이야기해서 조각을 한다고 수고했으니까 그에게 좋은 물건을 주는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722130110,
					"content": "그래? 인간들은 이상한 걸 따지는군…그럼 내 귀를 만질 수 있는 기회를 하사해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130111
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722130111,
					"content": "별, 별로 좋은 생각은 아닌 거 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722130112,
					"content": "그래? 그러면… 맛있는 걸 줘야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130113
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722130113,
					"content": "그가 원하는 건 돈이야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130114
					]
				},
				{
					"id": 722130114,
					"content": "돈? 그 물건은 「봉납함」에 넣는 게 아니었어? 정말 이상하군, 그런 걸 다 중요시하다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130115
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722130115,
					"content": "돈이 얼마나 중요한 물건인데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130116
					]
				},
				{
					"id": 722130116,
					"content": "흠, 자네가 그렇다면 그런 거겠지. 나중에 그 인간과 이야기를 해봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130117
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722130117,
					"content": "근데, 그 바위 인간 지금 아무것도 안 두드리고 있네. 그 짧은 나무 방망이를 들고 뭘 하려는 건지 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130118
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722130118,
					"content": "나무 방망이? 조각할 때 보통 망치랑 끌 같은 걸 사용하지 않나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722130119,
					"content": "공구가 부서졌나…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130120
					]
				},
				{
					"id": 722130120,
					"content": "#{NICKNAME}, 오오시마를 찾아가 보자! 우리 도움이 필요할 수도 있겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
