			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"대웅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200401,
					"content": "대웅 씨, 우리 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200402,
					"content": "엇! 이 사람이 너희가 말한 그 친구?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200403
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200403,
					"content": "맞아! 종려야말로 광석과 지질 분야의 최고 전문가라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200404,
					"content": "과분한 칭찬이군. 그냥 좀 아는 정도야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200405
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200405,
					"content": "훗, 그럼 내가 초빙한 사람도 밀리진 않겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200406
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200406,
					"content": "내가 직접 말하긴 그렇고, 그 친구가 오면 직접 보시죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200407
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200407,
					"content": "윽… 여기인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200408
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111200408,
					"content": "아이고, 딱 맞춰 왔군! 소개해 드릴게요. 이쪽은 내가 초빙한 균이라는 친구입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200409
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200409,
					"content": "균이, 여기 둘은 내가 초빙한 모험가고, 음, 이분은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200410
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200410,
					"content": "엇…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200411
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111200411,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200412
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200412,
					"content": "이분은 종려 씨예요. 왕생당의 객경이시죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200413
					]
				},
				{
					"id": 111200413,
					"content": "왕생당의 객경 종려 선생이라… 들어본 것 같군. 학식이 깊고 재주가 뛰어난 분이라고 들었는데 이렇게 뵙게 될 줄이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200414
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200414,
					"content": "어? 뭔가 낯이 익은데… 음, 설마 왕생당에서 만났나? 근데 난 왕생당엔 가본 적이 없는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200415
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111200415,
					"content": "대웅 씨, 누가 진정한 고수인지 겨뤄봐야 하지 않겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200416
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200416,
					"content": "당장 겨뤄보려는 거구나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200417
					]
				},
				{
					"id": 111200417,
					"content": "응? 그게… 나, 나도 어디서부터 시작해야 할지 모르겠는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200418
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200418,
					"content": "그럼 어떻게 겨룰지 그쪽에서 생각해봐. 종려가 이기면 종려한테 도움을 청하고, 종려가 지면… 음, 질 리가 없지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200419
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200419,
					"content": "겨뤄보자고? 좋아, 한번 해보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200420
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111200420,
					"content": "기운이 넘치시는군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200421
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200421,
					"content": "아하하, 딱 보니 이 분야의 고수이신 것 같지만, 길고 짧은 건 대봐야 하지 않겠습니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200422
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111200422,
					"content": "자신만만한데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200423
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200423,
					"content": "있는대로 말했을 뿐이야. 하하하… 그리고 난 할 줄 아는 게 이거밖에 없고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200424
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111200424,
					"content": "곤균 씨는 감정사인가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200425
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200425,
					"content": "아뇨, 사실… 사실 전 리월에 왜 왔는지 까먹었어요…. 어느 날 길가에 서 있는데 대웅 씨가 갑자기 말을 걸더라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200426
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111200426,
					"content": "그리곤 돌멩이를 들고 있는 절 보고 몇 가지 질문을 던지더니 흥분해서 이리로 불렀죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200427
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111200427,
					"content": "헐? 어떻게 그런 걸 잊어버려?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200428
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200428,
					"content": "리월항으로 오는데 이 친구가 길가에서 돌멩이를 만지작거리며 중얼거리고 있었어. 그 돌에 대해 잘 알고 있는 것처럼 보였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200429
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200429,
					"content": "그래서 호기심에 몇 마디 물었는데, 광산 작업반장인 나보다도 아는 게 많더라고! 게다가 한가해 보이길래 좀 도와달라고 부탁했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200430
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200430,
					"content": "기억력이 많이 안 좋나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200431
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200431,
					"content": "기억력이 좋다고 할 순 없지…. 하지만 광석에 대한 거라면 도움이 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200432
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111200432,
					"content": "종려 선생님, 이 돌은 어떤 것 같나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200433
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111200433,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200434
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200434,
					"content": "겉은 매끄럽군요. 표면의 균열은 화산 분출로 생긴 것이네요. 내 생각이 맞다면 이건 다른 나라에서 온 돌일 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200435
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200435,
					"content": "우와~! 눈썰미가 대단하시네요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200436
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111200436,
					"content": "이건 평범한 돌이 아니죠. 표면이 얇고 까만 선이 있는 걸 보니… 최고의 수정 광석을 품고 있을 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200437
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200437,
					"content": "정확히 보셨습니다. 이 돌은 화산 근처에서 난 것이에요. 시장을 돌아다니다가 우연히 봤는데 상인은 이 돌의 진가를 몰라보더라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200438,
						111200439
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111200438,
					"content": "수정 광석이라면 흔하지 않나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				},
				{
					"id": 111200440,
					"content": "빛깔이 순수하고 품질이 좀 좋다고 최고라 하진 않아. 최고의 수정은 물이나 사금을 머금고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200441
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111200441,
					"content": "이 돌 안엔 수정이 숨겨져 있어. 수정이 생성되는 순간 물을 가둔 거지. 마치 산속에 뜬 보름달처럼 하늘을 비추며 움직이는 아주 진귀한 수정이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200442
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111200442,
					"content": "와 직접 본 것처럼 자세히 말하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200443
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200443,
					"content": "우릴 속이는 건 아니겠지? 어쨌든 돌을 깨본 건 아니잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200444
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200444,
					"content": "아니, 곤균 씨 말이 맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200445
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200445,
					"content": "수정은 대부분 고온에서 생성돼. 고온과 물은 서로 상극이지. 그래서 물을 담고 있는 수정이 희귀한 거야. 이 수정은 고산 호수의 물을 머금고 있으니 더욱 희귀하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200446
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200446,
					"content": "종려까지 이렇게 말하는 걸 보니… 진짜겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200447
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200447,
					"content": "종려 선생님 같은 분은 처음입니다! 돌 표면 밑에까지 어떻게 아신 거죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200448
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111200448,
					"content": "많이 보다 보니 그렇게 됐네, 별로 대단한 건 아니오",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200449
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200449,
					"content": "아니요, 진짜 대단하세요! 우린 말이 잘 통하는 것 같아요. 종려 선생님과 친구가 되고 싶습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200450
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111200450,
					"content": "대웅 씨, 종려 선생님도 함께 가죠! 절 믿으세요. 이분은 뛰어난 실력을 지닌 전문가십니다. 평생 이런 분 못 만나실 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200451
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111200451,
					"content": "그래, 실력 있는 고수는 많을수록 좋지. 그럼 여러분, 층암거연 광산으로 가보죠. 실종된 동료들을 되찾아와야 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200439,
					"content": "어째서 최고라는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				}
			]
		},
