			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"종려"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200301,
					"content": "저번에 암왕제군 이야기까지 했죠…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200302
					],
					"speakerTitle": "전달변"
				},
				{
					"id": 111200302,
					"content": "여기 있었구나, 종려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200303,
					"content": "음?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200304
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200304,
					"content": "어쩐 일이야? 너희들도 이야기를 들으러 왔니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200305
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200305,
					"content": "아니, 종려를 찾으러 온 거야. 지금 시간 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200306,
					"content": "시간은 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200307,
						111200308
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200307,
					"content": "저희가 의뢰를 받았는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				},
				{
					"id": 111200309,
					"content": "이번 의뢰에는 지질과 광석을 잘 아는 사람이 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200310,
					"content": "지질과 광석이라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200311
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200311,
					"content": "이 티바트 대륙에 종려보다 지질과 광석에 빠삭한 사람은 없잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200312,
					"content": "의뢰인이 고수 중의 고수를 모셨다고 하더라구. 근데 티바트 최고의 전문가는 종려잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200313,
					"content": "뜬금없이 왜 비교를 하고 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200314
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200314,
					"content": "비교가 아니라, 뭘 모르니까 그렇지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200315,
					"content": "난… 그냥 진짜 고수를 보여주고 싶다구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200316,
					"content": "하하, 알겠어. 그럼 한번 가보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200317
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200317,
					"content": "진짜?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200318,
					"content": "근데 미리 말해둘게. 그 분야라면 잘 알고 있긴 하지만 내가 세상 최고는 아닐 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200319
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200319,
					"content": "학문의 세계는 끝이 없는 법이지. 뭐든 많이 봐두는 건 좋은 일이야. 어쨌든 내가 옆에 있으면 너희도 안심이 될 테고, 또 진짜 고수가 있다면 나도 그 사람에게 한 수 배울 수 있으니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200320
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111200320,
					"content": "음… 종려는 지나치게 겸손한 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200321
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200321,
					"content": "헤, 종려도 승낙했으니 대웅 아저씨한테 돌아가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200308,
					"content": "특별한 의뢰가 있는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				}
			]
		},
		{
			"id": 1112004,
			"completionStepIds": [
				1112004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112004",
							"2"
						],
						"stepId": 1112004,
						"stateName": "QUEST_STATE_UNFINISHED"
