			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"대웅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200201,
					"content": "이봐 당신이——대웅 씨?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200202,
					"content": "엇, 날 찾아왔니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200203
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200203,
					"content": "어라? 잠깐, 너희 혹시 모험가 길드에서 나온 모험가니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200204
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200204,
					"content": "와, 딱 알아보네?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200205,
					"content": "차림새나 표정을 보니 딱 봐도 고수 같거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200206
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200206,
					"content": "정확히 봤어. 보는 눈이 있군!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200207,
					"content": "하하하, 우리 업계에는 감정할 일이 많거든. 광석은 물론이고 사람도 눈여겨봐야 하지. 난 평범한 사람들의 속내까지 한눈에 간파할 수 있다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200208
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200208,
					"content": "잠시만 기다려, 내가 초빙한 사람이 금방 올 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200209
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200209,
					"content": "잠깐잠깐! 우리가 왔는데 다른 사람이 또 온다는 거야? 그럼 보수를 나눠야 되잖아!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200210,
					"content": "휴! 솔직히 말할게. 이번 일은 좀 까다로워서 모험가만으로는 부족해. 그래서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200211
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200211,
					"content": "역시 다른 사람도 불렀다는 거군, 흥!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200212,
					"content": "아저씨, 우릴 얕보는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200213,
						111200214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200213,
					"content": "페이몬, 그렇게 말하지 마…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				},
				{
					"id": 111200215,
					"content": "이번 일은 광산에서 발생한 데다 심상치 않아. 광산은 사고가 많은 곳이라 만약에 대비해야 해서 전문가를 초빙했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200216
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200216,
					"content": "모험가는 아무래도 광석 감정이나 지질분석에 약하잖아? 전문가가 함께하면 훨씬 든든할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200217
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200217,
					"content": "그리고 내가 초빙한 사람은 고수 중의 고수라고. 척 보기만 해도 어떤 광석인지 바로 맞힌다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200218
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200218,
					"content": "내 생각엔 광석에 대해서는 그 사람이 일인자야! 그런 전문가라면 당연히 모셔야 하는 거 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200219
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200219,
					"content": "아냐, 아냐! 아저씨는 최고의 광석 전문가가 누군지 모를걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200220,
					"content": "왜 그렇게 생각해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200221
					],
					"speakerTitle": "대웅"
				},
				{
					"id": 111200221,
					"content": "당연히 모르지. 세상에서 광석을 제일 잘 아는 사람은 우리 친구니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200222
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200222,
					"content": "에이, 너 설마…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200223
					]
				},
				{
					"id": 111200223,
					"content": "(잘됐다, 마침 물어볼 것도 있었는데)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200224
					]
				},
				{
					"id": 111200224,
					"content": "후후, 뛰는 놈 위에 나는 놈 있는 법! 여기서 딱 기다려. 우리가 바로 데려올게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200214,
					"content": "페이몬이 승부욕에 불타고 있어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				}
			]
		},
		{
			"id": 1112003,
			"completionStepIds": [
				1112003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112003",
							"2"
						],
						"stepId": 1112003,
						"stateName": "QUEST_STATE_UNFINISHED"
