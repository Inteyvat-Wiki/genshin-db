			},
			"dialogs": [
				{
					"id": 111200101,
					"content": "캐서린, 우리 왔어. 새로운 의뢰 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200102,
					"content": "응, 새 일이 들어왔는데 너희가 딱일 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200103
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 111200103,
					"content": "리월항 휘산청의 작업 반장인 대웅 씨가 모험가 길드에 사람을 좀 보내달라고 요청했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200104
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 111200104,
					"content": "구체적으로 뭘 해야 하는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200105,
					"content": "일손을 구하고 있대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200106
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 111200106,
					"content": "일손을 구한다고? 그거 우리 전문이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111200107,
					"content": "맞아, 여행자의 능력은 의심할 여지가 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200108
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 111200108,
					"content": "구체적인 의뢰 내용은 직접 만나서 들어야 해. 이 일이 마음에 들면 부두 근처에 가서 대웅 씨를 찾아봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐서린"
				}
			]
		},
		{
			"id": 1112002,
			"completionStepIds": [
				1112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
