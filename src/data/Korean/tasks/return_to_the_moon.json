			"dialogs": [
				{
					"id": 60280201,
					"content": "여기가 바로… 휘페르보레아 시대 사람들이 「달」과 소통했던 곳이구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280202
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 60280202,
					"content": "영원달, 서리달, 무지개달… 세 달의 힘이 모이면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280203
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60280203,
					"content": "달로 통하는 문이 열릴 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280204
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 60280204,
					"content": "네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280205
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60280205,
					"content": "달의 정수는 준비됐으니, 마지막 단계만 남았군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280206
					],
					"speakerTitle": "「아를레키노」"
				},
				{
					"id": 60280206,
					"content": "지금은 나샤 마을이 가장 시끌벅적할 때지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280207
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 60280207,
					"content": "응, 이런 때 널 보내야 한다니 아쉬워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60280208,
					"content": "괜찮아. 배낭에 마지막이자 유일하게 챙긴 이 짐이, 무척 마음에 들어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280209
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 60280209,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280210
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 60280210,
					"content": "달의 부름이… 느껴지고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280211
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 60280211,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280212
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 60280212,
					"content": "너의 집은 이 빛의 저편에 있다, 콜롬비나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280213
					],
					"speakerTitle": "「아를레키노」"
				},
				{
					"id": 60280213,
					"content": "앞으로 진짜 달을 위해 기도할 이유가 생겼네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280214
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60280214,
					"content": "콜롬비나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280215
					]
				},
				{
					"id": 60280215,
					"content": "응, 듣고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280216
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 60280216,
					"content": "기회 되면 꼭 자주 돌아와!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280217
					]
				},
				{
					"id": 60280217,
					"content": "훗… 물론이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280218
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 60280218,
					"content": "혹시 못 와도… 이 별에 「콜롬비나」를 그리워하는 친구들이 있다는 거 잊지 마",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280219
					]
				},
				{
					"id": 60280219,
					"content": "응, 꼭 그럴게. 다들 도와줘서 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280220
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 60280220,
					"content": "너희도 잊지 마. 달빛이 밤낮으로 우리를 이어 줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280221
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 60280221,
					"content": "후… 그럼… 안녕, 나의 친구들",
					"roleType": "TALK_ROLE_NPC",
