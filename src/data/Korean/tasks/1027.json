				"points": []
			},
			"dialogs": [
				{
					"id": 10280801,
					"content": "안 되겠어, 내가 한 번 더 가볼게. 이 아라타키 천하 독존의 이토가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280802
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280802,
					"content": "형님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280803
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280803,
					"content": "윽! 뭐야, 왜 그렇게 진지해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280804
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280804,
					"content": "제비꽃 열매나 구워요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280805
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280805,
					"content": "하? 이 상황에서 지금 나보고 제비꽃 열매나 구우라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280806
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280806,
					"content": "음메! 음메",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280807
					],
					"speakerTitle": "우시"
				},
				{
					"id": 10280807,
					"content": "들었지, 우시도 네 말이 맞다고 하잖아…. 잠깐, 우시 너 대체 누구 편이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280808
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280808,
					"content": "음메…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280809
					],
					"speakerTitle": "우시"
				},
				{
					"id": 10280809,
					"content": "물자가 얼마나 중요한데요. 미지의 수에 대응하려면 충분한 체력과 마음의 안정이 필요해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280810
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280810,
					"content": "우시도 그 정도는 안다고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280811
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10280811,
					"content": "어쭈, 이 녀석들… 벌써 먹기 시작했잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280812
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280812,
					"content": "잠깐, 벌써 익었다고? 냄새 한번 끝내주네… 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280813
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10280813,
					"content": "그래, 배부터 채우고 생각해 보자고. 다 먹지 말고 내 것도 남겨줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아라타키 이토"
				}
			]
		},
