						"pointId": 6039
					},
					{
						"sceneId": 3,
						"position": [
							4471.684,
							541.04,
							3851.864
						],
						"pointId": 6040
					}
				]
			},
			"dialogs": [
				{
					"id": 741270201,
					"content": "음… 여기가 「마리안 기념 공원」인가요? 공원 같은 느낌이 전혀 없네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270202
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270202,
					"content": "로이알트 씨가 실망하시겠어요. 사람들을 초대해 이곳에서 연설할 계획이었거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270203
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270203,
					"content": "주변을 보니 여기서 연설하긴 어려울 것 같네요…. 이렇다 할 랜드마크도 없고, 사진 찍기에도 마땅치 않아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270204
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270204,
					"content": "장치를 잡아서 기념품으로 가져가세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270205
					]
				},
				{
					"id": 741270205,
					"content": "하하, 재미있네요. 하지만 행정청에는 그런 걸 둘 자리가 없는걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270206
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270206,
					"content": "게다가 가져간다고 해도 평가, 기록, 분류 과정을 거친 다음 따로 보관해야 해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270207
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270207,
					"content": "윤, 그냥 농담하는 거잖아! 갑자기 진지하게 일 얘기 꺼내지 말라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741270208,
					"content": "그나저나 기록하니까 다시 생각났는데요…. 저는 결국 서류를 가져가는 데 실패했네요. 로이알트 씨가 또 한숨을 쉬시겠죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270209,
						741270211
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270209,
					"content": "슈아죌 씨 때문에 곤란한 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270210
					]
				},
				{
					"id": 741270210,
					"content": "꼭 그런 건 아니에요. 제 부탁이… 규정에 어긋나는 건 사실이거든요. 슈아죌 씨가 거절하는 것도 어찌 보면 당연해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270212
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270212,
					"content": "그게… 폰타인 과학원에서 재건 작업을 계획 중이잖아요? 그중 일부 물자와 인력 배치에 관해서는 행정청과 의논을 해야 하거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270213
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270213,
					"content": "행정청 입장에선 아주 중요한 일이에요. 그래서 로이알트 씨에게 과학원 주변 현장을 조사할 탐사대를 꾸리라는 지시가 내려왔죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270214
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270214,
					"content": "그렇게 로이알트 씨는 행정청에 남아서 인원 통계를 내고, 전 과학원 측과 관련 업무를 조율하기 위해 이곳에 오게 됐죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270215
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270215,
					"content": "마침 과학원에서 행정청으로 보내야 할 우편이 있다길래 겸사겸사 받아가면 되겠다 싶었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270216
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270216,
					"content": "슈아죌 씨가 규정에 어긋나는 행위라면서 죽어도 우편을 안 주시는 거 있죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270217
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270217,
					"content": "규정에 어긋난다고? 이번엔 또 어떤 규정인데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741270218,
					"content": "서류 하나 가져가는데도 규정이 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270219
					]
				},
				{
					"id": 741270219,
					"content": "으윽… 설마 또 여기저기 돌아다니면서 도장을 찍고, 서명도 하고, 마무리로 불평불만까지 들어야 하는 그런 일은 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741270220,
					"content": "쉽게 설명하자면, 행정청에서 이루어지는 대부분의 공문서 전달은 반드시 「우편 발송」 절차를 밟아야 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270221
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270221,
					"content": "뭐? 만약 문서를 받을 부서가 근처에 있거나… 심지어 바로 맞은편에 있으면?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270222
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741270222,
					"content": "…그래도 우편으로 보내야 해요. 행정청에서 오고 간 모든 서류를 「추적」하기 위한 조치죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270223
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270223,
					"content": "다들 불편하지도 않나 봐요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270224
					]
				},
				{
					"id": 741270224,
					"content": "다들 이미 불편함에 익숙해진 게 아닐까 싶어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270225
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270225,
					"content": "자, 이 얘기는 관두고 다음 장소로 가보죠. 음… 로이알트 씨가 적어주신 비망록에 따르면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270226
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270226,
					"content": "폰타인 과학원의 「학술 회당」이라는데… 이상하네요. 오는 길에 그런 이름의 건물은 못 본 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270227
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270227,
					"content": "어딨는지 알고 있으니 절 따라오세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270228
					]
				},
				{
					"id": 741270228,
					"content": "#정말 한결같이 듬직하시네요. {NICKNAME} 씨가 없었다면 전 일을 진행하지 못했을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270229
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270229,
					"content": "그럼 어서 출발하죠. 주변에 통제 불능 상태인 장치가 더 있을지도 모르니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "윤"
				},
				{
					"id": 741270211,
					"content": "슈아죌 씨와 무슨 얘기 중이었어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270212
					]
				}
			]
		},
