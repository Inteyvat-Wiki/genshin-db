				{
					"id": 741270901,
					"content": "이건 괜찮네…. 앗, 사진은 다 찍으셨어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270902,
						741270903
					],
					"speakerTitle": "윤"
				},
				{
					"id": 741270902,
					"content": "다 찍었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 741270903,
					"content": "아직이요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270904
					]
				},
				{
					"id": 741270904,
					"content": "다 찍으면 바로 가져다주세요. 부탁드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "윤"
				}
			]
		},
