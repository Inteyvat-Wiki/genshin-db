				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420301,
					"content": "어서 오시게나. 뭐 필요한 게 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420302
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230420302,
					"content": "네르민의 「물건」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420303
					]
				},
				{
					"id": 230420303,
					"content": "아, 그거? 이미 준비됐네. 전부 품질도 좋고 가격도 싼 향료로 준비했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420304
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230420304,
					"content": "네르민은 이 향료로 「향수」를 만들려고 하는 거겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420305
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230420305,
					"content": "음… 기운을 차리는 건 좋은 일이지만, 몸 생각도 해야 할 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아잘라이"
				}
			]
		},
		{
			"id": 2304205,
			"completionStepIds": [
				2304205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
