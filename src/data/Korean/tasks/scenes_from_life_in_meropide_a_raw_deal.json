			"dialogs": [
				{
					"id": 740610401,
					"content": "후, 겨우 맞춰 도착했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610402
					],
					"speakerTitle": "데쌍브르"
				},
				{
					"id": 740610402,
					"content": "왜 그렇게 숨을 가쁘게 쉬는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740610403,
					"content": "버려진 생산 구역에서 일이 끝나자마자 달려와서 그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610404
					],
					"speakerTitle": "데쌍브르"
				},
				{
					"id": 740610404,
					"content": "내가 부탁한 일은 잘 끝났어? 편지는 보냈지? 다행이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610405,
						740610406
					],
					"speakerTitle": "데쌍브르"
				},
				{
					"id": 740610405,
					"content": "순백의 은방울꽃이 보내는 편지였어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610407
					]
				},
				{
					"id": 740610407,
					"content": "뭐? 그런 이름을 쓰고 있었구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610408
					],
					"speakerTitle": "데쌍브르"
				},
				{
					"id": 740610408,
					"content": "사실 그건 어떤 소녀가 대신 전해달라고 부탁한 편지야. 몸 상태가 많이 안 좋아 보이길래 부탁을 들어준 거라 한 푼도 안 받았어! 너희에게 주는 보수도 내 주머니에서 나온 거고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610409
					],
					"speakerTitle": "데쌍브르"
				},
				{
					"id": 740610409,
					"content": "엥?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610410,
						740610411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740610410,
					"content": "편지 내용을 보니까 많이 아픈 것 같긴 했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610412
					]
				},
				{
					"id": 740610412,
					"content": "내가 나올 때 편지를 잘못 챙긴 모양이네. 큰일이다. 이러다 아들 생일이 지나가 버리겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610413
					],
					"speakerTitle": "데쌍브르"
				},
				{
					"id": 740610413,
					"content": "뭐? 편지를 잘못 챙겼다고? 역시 소문대로 운이 없네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740610414,
					"content": "이게 내 운명이겠지. 일단 편지부터 챙기러 가야겠어. 너무 늦지 않아야 할 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610415
					],
					"speakerTitle": "데쌍브르"
				},
				{
					"id": 740610415,
					"content": "이건 너희에게 주는 보수야. 도와줘서 고마워. 난 아들한테 편지를 보내야 해서… 그럼 다음에 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610416
					],
					"speakerTitle": "데쌍브르"
				},
				{
					"id": 740610416,
					"content": "아아, 그냥 가버렸네! 묻고 싶은 게 산더미인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610417
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740610417,
					"content": "어쨌든 특별 허가 쿠폰을 받았으니 상관없겠지. 엥?! 고작 요만큼이야? 이걸로는 한 끼도 못 사 먹겠는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610418,
						740610420
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740610418,
					"content": "오늘은 굶어야겠네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610419
					]
				},
				{
					"id": 740610419,
					"content": "싫어, 나 배고프다구… 흑흑",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740610420,
					"content": "우리 줄 서기 대행 의뢰를 한 번 더 받아볼까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610421
					]
				},
				{
					"id": 740610421,
					"content": "그럴 바엔 그냥 굶겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740610411,
					"content": "정말요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610412
					]
				},
				{
					"id": 740610406,
					"content": "당신이 순백의 은방울꽃이에요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610407
					]
				}
