			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"다네"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736950201,
					"content": "오? 「유물 모형」을 다 찾은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950202
					],
					"speakerTitle": "다네"
				},
				{
					"id": 736950202,
					"content": "대단하네! 넌 고고학에 재능이 있구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950203
					],
					"speakerTitle": "다네"
				},
				{
					"id": 736950203,
					"content": "그럼 이 선물을 받아. 우리 학부 행사에 참여해줘서 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950204
					],
					"speakerTitle": "다네"
				},
				{
					"id": 736950204,
					"content": "이번 행사를 통해 고고학의 즐거움을 느꼈으면 좋겠네, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950205
					],
					"speakerTitle": "다네"
				},
				{
					"id": 736950205,
					"content": "물론 실제 고고학의 대부분 일은 지루하고 힘들지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950206
					],
					"speakerTitle": "다네"
				},
				{
					"id": 736950206,
					"content": "중요한 유물을 발굴하는 순간, 그동안의 고생을 보답받은 느낌이 들지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950207,
						736950208
					],
					"speakerTitle": "다네"
				},
				{
					"id": 736950207,
					"content": "발굴하지 못하면요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				},
				{
					"id": 736950209,
					"content": "발굴하지 못하면… 속된 말로 「헛수고」한 셈이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950210
					],
					"speakerTitle": "다네"
				},
				{
					"id": 736950210,
					"content": "사실 대부분은 헛수고야. 순조롭게 중요한 유물을 발굴하는 경우는 매우 드물거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950211
					],
					"speakerTitle": "다네"
				},
				{
					"id": 736950211,
					"content": "하지만 고고학은 그런 일에 익숙해지고, 늘 낙관적인 마인드를 가져야 해. 그렇지 않으면 얼마 버티지 못하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "다네"
				},
				{
					"id": 736950208,
					"content": "발굴하지 못할 때도 있잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				}
			]
		},
