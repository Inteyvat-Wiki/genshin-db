				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10120801,
					"content": "향고를 가져왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120802
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10120802,
					"content": "음… 신상을 보면서 멍 때리고 있던데, 너무 오래 기다리게 했지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120803
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10120803,
					"content": "아, 왔군. 별로 오래 안 기다렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120804
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10120804,
					"content": "암왕제군의 신상이 리월을 수호한 시간에 비하면, 이 정도는 한순간에 불과하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120805
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10120805,
					"content": "하하, 사람을 어떻게 조각상에 비교해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120806
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10120806,
					"content": "맞는 말이군. 향고는 가져왔나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120807
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10120807,
					"content": "응, 3가지 다 가져왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120808
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10120808,
					"content": "수고했어. 그럼 차례대로 공양하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120809
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10120809,
					"content": "（「금옥장교」를 바친다）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120810
					]
				},
				{
					"id": 10120810,
					"content": "이건 첫 번째 향고야. 앵아 씨가 달콤하고 몽환적이라 소녀들이 좋아하는 거라고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120811
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10120811,
					"content": "（「산음금족」을 바친다）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120812
					]
				},
				{
					"id": 10120812,
					"content": "두 번째 향고는 고급스러워서 부잣집 아가씨들이 좋아해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120813
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10120813,
					"content": "（「표묘선연」을 바친다）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120814
					]
				},
				{
					"id": 10120814,
					"content": "세 번째 향고는 흐릿한 안개처럼 부드러운 향기가… 뭐였더라, 아무튼 성숙한 여성들에게 인기가 많대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120815
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10120815,
					"content": "엇… 방금 그건?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120816,
						10120817
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10120816,
					"content": "「암왕제군」께서 꽤 마음에 드셨나 봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120818
					]
				},
				{
					"id": 10120818,
					"content": "그건 성숙한 언니들이 좋아하는 향이랬지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120819
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10120819,
					"content": "설마… 「암왕제군」이 성숙한 언니인 건가?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120820
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10120820,
					"content": "하하하… 그럴지도 모르지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120821
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10120821,
					"content": "「암왕제군」은 여러 모습으로 변하실 수 있으니, 그런 모습이 있을지도 모르겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120822
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10120822,
					"content": "우린 엄청 큰 용의 모습밖에 못 봤는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120823
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10120823,
					"content": "「리월 칠성」이 빨리 범인을 잡았으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120824
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10120824,
					"content": "그런 건 높으신 분들께 맡기고 우린 「암왕제군」을 잘 보내드리기만 하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120825,
						10120826
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10120825,
					"content": "(칠성과 타르탈리아는, 대체 무슨 꿍꿍이가 있는 거지…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120827
					]
				},
				{
					"id": 10120827,
					"content": "그럼 이젠 뭘 하면 될까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120828
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10120828,
					"content": "그다음은… 「척진령」을 빌려와 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120829
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10120829,
					"content": "「척진령」?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120830
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10120830,
					"content": "지금 「척진령」을 보관하고 있는 사람은 내 오랜 벗, 평 할머니야. 그녀는 옥경대 근처에 있어. 말하면 바로 알 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120831
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10120831,
					"content": "알았어…. 근데 종려는 같이 안 가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120832
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10120832,
					"content": "음, 직접 가기엔 곤란한 사정이 있어. 그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120833
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10120833,
					"content": "엥… 태도가 좀 수상한데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10120826,
					"content": "(그래, 「선조의 허물」을 볼 수만 있다면…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120827
					]
				},
				{
					"id": 10120817,
					"content": "세 번째 향고가 맘에 드시나 보네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120818
