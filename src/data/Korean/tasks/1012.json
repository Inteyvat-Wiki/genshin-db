	"talks": [
		{
			"id": 101202,
			"completionStepIds": [
				101202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
