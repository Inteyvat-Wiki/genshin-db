					"앵아"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10121201,
					"content": "음, 수질이 좋네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121202
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 10121202,
					"content": "그럼 이제 합성대에서 예상꽃의 정유를 추출해주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121203
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 10121203,
					"content": "향고를 만드는 방법은 연금이랑 많이 달라요. 제가 알려드릴게요. 이렇게, 살살… 절굿공이를 부드럽게 잡고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121204
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 10121204,
					"content": "하지만 제대로 잡고 있지 않으면 놓칠 수도 있으니, 주의해 주세요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121205
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 10121205,
					"content": "그리고 리듬에 맞춰 저어주면… 예상꽃의 즙이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121206,
						10121207
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 10121206,
					"content": "걱정 마세요, 잘할 수 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10121208
					]
				},
				{
					"id": 10121208,
					"content": "음~ 바로바로 알아듣는 걸 보니, 이쪽에 소질이 있는 것 같네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121209
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 10121209,
					"content": "그럼 이걸 가지고 근처에 있는 <color=#00E1FFFF>합성대</color>에서 한번 해보세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121210
					],
					"speakerTitle": "앵아"
				},
				{
					"id": 10121210,
					"content": "3가지 모두 만들어야 하는 걸 잊지 마세요. 정유로 추출됐을 땐 비슷해 보이지만, 향고가 완성되면 각기 다른 상자에 넣어 드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "앵아"
				},
				{
					"id": 10121207,
					"content": "네, 알겠어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10121208
					]
				}
			]
		},
		{
			"id": 101213,
			"completionStepIds": [
				101215
			],
