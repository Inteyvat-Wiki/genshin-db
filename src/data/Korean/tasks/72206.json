					"아베"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060301,
					"content": "이봐! 내가 경고했지! 귀는 장식인 게인가?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060302
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060302,
					"content": "와, 귀신이다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060303
					]
				},
				{
					"id": 722060303,
					"content": "으악! 귀신?! 귀신이 어디 있어!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060304,
						722060305
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060304,
					"content": "여↗기↘있↗지↘요↗",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				},
				{
					"id": 722060306,
					"content": "으악! 저, 저리 가! 썩 물러나거라!! 아베의 이름으로 명하니, 게 썩 물러가거라!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060307
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060307,
					"content": "휴, 이런 괴상망측한 일이 있나! 이렇게 오래 살면서 이런 끈질긴 악령은 또 처음 보는구먼!! 어서 물러가지 못할까!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060308
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060308,
					"content": "저는 섬 밖에서 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060309
					]
				},
				{
					"id": 722060309,
					"content": "안개바다 밖에서 온 악령인 게인가… 흥, 하나도 안 무섭구먼! 거기서 움직이지 말고 딱 기다리게, 뇌조 님이 와서 자넬 쫓아내실 테니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060310,
						722060311
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060310,
					"content": "뇌조 님은 이제 오지 않아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060312,
					"content": "뭐라고…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060313,
						722060314
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060313,
					"content": "다른 사람들은 다 떠났어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060315,
					"content": "뭐… 뭐라는 게인가… 어떻게 그런 무서운 말을… 온몸에 닭살이 돋으려 하는군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060316
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060316,
					"content": "근데… 확실히 섬의 사람들이 점점 사라지고 있어… 키나라는 아이가 말하길 사람들이 다 배를 탔다고 하긴 했는데… 휴… 그 아이들은 또 어디에 있는 건지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060317
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060317,
					"content": "그런데, 섬 밖에서 온 악령님은 바닷가에 있는 저 은빛 배에 안 타시나…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060318,
						722060319
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060318,
					"content": "저에겐 배가 보이지 않아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060320,
					"content": "흥… 그럴 줄 알았어. 외부인은 배를 못 보는 거였어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060321
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060321,
					"content": "배 타라고 일러줘서 고맙네. 근데… 이렇게 오래 살았지만, 아직 경험하지 못한 게 너무 많아… 이렇게 떠나려니 너무 아쉽군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060322
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060322,
					"content": "도와드릴 수 있는 게 있을까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060323
					]
				},
				{
					"id": 722060323,
					"content": "도움? 하하, 도움까지는 아니고… 그냥 새로운 걸 보고 싶을 뿐이라네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060324
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060324,
					"content": "소싯적에 우나 누님이랑 내기했었지… 난 섬밖에는 이곳과 다른 버섯이 존재한다고 했고, 누님은 그 말을 믿지 않았다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060325
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060325,
					"content": "그 후로… 누님의 남편이 바다 밖으로 나갔는데, 두 번 다시는 돌아오지 못했지… 그의 영혼도 타지에서 떠돌고 있을 거야… 딱하기도 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060326
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060326,
					"content": "그 뒤로 우나 누님은 계속 혼자서 지냈어… 그것만 생각하면 난… (한숨)…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060327,
						722060328
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060327,
					"content": "다른 사람 생각은 인제 그만하세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060329,
					"content": "제사장님한테 부탁도 했었지… 누님한테 의지할 곳이 필요하니… 음? 아, 맞아, 버섯!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060330
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060330,
					"content": "크흠… 곧 배에 올라야 하는군. 딱히 아쉬운 건 없지만… 단지 섬 밖의 세상을 구경하지 못한 게 걸리는군. 하지만 가장 마음에 걸리는 건… 내가 키우던 버섯들이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060331
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060331,
					"content": "혹시 안개바다 밖의 버섯을 좀 구해줄 수 있겠나… 떠나기 전에 식견을 넓히고 싶다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060332
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060332,
					"content": "부탁하겠네, 섬 밖에서 온 악령님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아베"
				},
				{
					"id": 722060328,
					"content": "버섯에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060319,
					"content": "그 배는 절 위해 준비된 게 아니에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060314,
					"content": "이제 작별할 시간이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060311,
					"content": "「안개바다」는 이미 과거의 일이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060305,
					"content": "바로 제에요~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				}
			]
		},
