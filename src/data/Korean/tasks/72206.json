			"dialogs": [
				{
					"id": 722060101,
					"content": "이봐! 여기 사람 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060102
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060102,
					"content": "요즘 젊은이들은 공덕심이란 게 없어! 쯧쯧",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060103,
						722060105
					],
					"speakerTitle": "아베"
				},
				{
					"id": 722060103,
					"content": "죄, 죄송합니다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060104
					]
				},
				{
					"id": 722060104,
					"content": "흥… 알면 됐네. 이미 딴 버섯은 그냥 가져가고… 내 버섯은 함부로 만지지 말게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아베"
				},
				{
					"id": 722060105,
					"content": "이게 다 어르신의 버섯인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060106
					]
				},
				{
					"id": 722060106,
					"content": "자네가 알아서 뭐 하게! 함부로 따지 말고 어서 썩 떠나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아베"
				}
			]
		},
