					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060201,
					"content": "와아! 아까 그 녀석… 봤어?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060202,
						722060203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722060202,
					"content": "아니",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060204
					]
				},
				{
					"id": 722060204,
					"content": "음… 정말 이상해, 버섯 조금만 더 따고 어서 이곳을 벗어나자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722060203,
					"content": "잘못 본 거겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060204
					]
				}
			]
		},
		{
			"id": 7220603,
			"completionStepIds": [
				7220605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
