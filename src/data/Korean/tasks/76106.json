			"dialogs": [
				{
					"id": 761060201,
					"content": "…응",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060202
					]
				},
				{
					"id": 761060202,
					"content": "너를 위해 하는 말이야. 설계국에 함부로 들어가지 마. 특히 2층은 절대 가지 말라고! 달의 힘을 너무 많이 흡수하면… 두통이 생기고, 심하면 구토 증상까지 나타날 수 있어. 나중에 안 알려줬다고 탓하지 말라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베로슬라바"
				}
			]
		},
		{
			"id": 7610603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
