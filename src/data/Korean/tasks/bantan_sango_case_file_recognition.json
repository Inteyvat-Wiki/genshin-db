				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"류지"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340901,
					"content": "#휴, 드디어 끝났다. 정말 이해가 안 돼. 왜 갑자기 공격해 온 거지. 카게로마루, 분명 전에는 친근했었는데. {NICKNAME}, 네가 있어서 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340902
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340902,
					"content": "#어, 왜 카게로마루가 {NICKNAME}(을)를 따라오는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340903
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340903,
					"content": "멍멍멍멍!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340904
					],
					"speakerTitle": "카게로마루"
				},
				{
					"id": 400340904,
					"content": "짖는 소리를 보니 왠지 기분이 좋아 보이네?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340905
					]
				},
				{
					"id": 400340905,
					"content": "그걸 들으면 알아? 난 전혀 모르겠는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340906
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340906,
					"content": "#내 추측이 맞다면, 카게로마루는 이미 {NICKNAME}의 닌자견이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340907
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400340907,
					"content": "엥!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340908
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340908,
					"content": "엥!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340909
					]
				},
				{
					"id": 400340909,
					"content": "닌자견의 계약 방법은 나도 소문으로 들은 거지만, 닌자가 닌자견을 선택하고, 닌자견을 이겨야 인정받을 수 있다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340910
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400340910,
					"content": "닌자는 강한 동료를 원하지만, 그건 닌자견도 똑같아. 서로를 인정해야 계약이 성사돼. 이제 보니 확실히 그런 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340911
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400340911,
					"content": "#하지만 {NICKNAME}은(는) 닌자도 아니고… 그리고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340912
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340912,
					"content": "윽",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340913
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340913,
					"content": "왜 그래, 페이몬?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340914
					]
				},
				{
					"id": 400340914,
					"content": "#{NICKNAME}, 먼저 나랑 한 가지 약속해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340915
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340915,
					"content": "무슨 약속?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340916
					]
				},
				{
					"id": 400340916,
					"content": "일단 약속한다고 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340917
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340917,
					"content": "그래. 약속할게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340918
					]
				},
				{
					"id": 400340918,
					"content": "네가 카게로마루와 계약해도, 너의 가~장 좋은 파트너는 페이몬이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340919
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340919,
					"content": "응. 페이몬은 최고의 파트너야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340920
					]
				},
				{
					"id": 400340920,
					"content": "다행이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340921,
						400340922
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340921,
					"content": "고양이랑 개보다는…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				},
				{
					"id": 400340923,
					"content": "헤헤헤. 우린 영원히 가~장 좋은 파트너야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340924
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340924,
					"content": "큼큼, 두 사람 사이가 좋네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340925
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400340925,
					"content": "근데 카게로마루의 실력이 그렇게 강하다면, 왜 전에 그 사람은 다른 사람에게 부탁한다는 편지를 남겼을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340926
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400340926,
					"content": "#그건 내가 알아! {NICKNAME}은(는) 강하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340927
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340927,
					"content": "실력은 확실히 뛰어나지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340928
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400340928,
					"content": "#만약, 진짜 만약 무슨 일이 생겨서 나랑 {NICKNAME}이(가) 어쩔 수 없지 헤어져야 한다면, 나도 걱정될 거야. {NICKNAME}의 실력과는 무관하게 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340929
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340929,
					"content": "#퉤퉤, 내가 무슨 불길한 소리를! 아무튼 예를 든 거야! 나와 {NICKNAME}은(는) 가장 좋은 파트너니까, 우린 헤어지지 않을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340930
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340930,
					"content": "페이몬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340931
					]
				},
				{
					"id": 400340931,
					"content": "합리적인 추리네. 그럼 유일한 문제는… 이 강아지는 왜 마을 사람들의 동물을 훔쳐서 지키는 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340932
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400340932,
					"content": "어… 음… 그건 똑똑한 페이몬도 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340933
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340933,
					"content": "#카게로마루가 말을 할 줄 알면 {NICKNAME}한테 물어보라고 할 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340934
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340934,
					"content": "산고 씨를 찾아가자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340935
					]
				},
				{
					"id": 400340935,
					"content": "참, 산고가 있었지! 이럴 때는 두뇌파가 나서줘야지. 산고를 찾아가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340936
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340936,
					"content": "응. 난 우선 숨겨진 동물들을 돌려보낼게. 탐정소에서 만나자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "류지"
				},
				{
					"id": 400340922,
					"content": "페이몬이 더 믿음직하지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340923
					]
				}
			]
		},
		{
			"id": 4003410,
			"completionStepIds": [
				4003410
			],
			"beginWay": "TALK_BEGIN_MANUAL",
