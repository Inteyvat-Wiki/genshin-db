					"산고"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340102,
					"content": "응, 너희들 왔구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340103
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400340103,
					"content": "류지 씨는 지금까지 수집한 단서와 내 추리에 따라 이미 야시오리섬으로 조사하러 갔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340104
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400340104,
					"content": "지도에 위치를 표시해 줄게. 서둘러 출발한다면 류지 씨와 합류할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340105
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400340105,
					"content": "왜 이렇게 서두르는 거야. 전에 탐정소에서 합류하고 함께 움직이자고 했잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340106,
					"content": "사건은 이미 막바지야. 두 사람도 빨리 움직여. 함께 수면에 떠오르는 진실을 지켜보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340107
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400340107,
					"content": "#그렇게 말하니 나도 엉덩이가 들썩들썩이네. 우리 빨리 가자, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 4003402,
			"completionStepIds": [
				4003402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003402",
							"2"
						],
						"stepId": 4003402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"류지"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400340201,
					"content": "류지! 우리 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340202,
					"content": "아, 너희구나. 산고 사장님이 너희는 나중에 합류할 거니까 나보고 먼저 와서 조사하라고 했는데 역시나 왔네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340203
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400340203,
					"content": "산고가 류지가 있는 장소를 알려줬거든! 조사는 잘 돼가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340204,
					"content": "어, 왜 동물을 가두는 감옥밖에 없고 지키는 사람은 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340205,
					"content": "방금 보물 사냥단이 자리를 비웠어. 산고 사장님의 말로는 보물 사냥단이 훔친 동물들을 「보물찾기용 개」로 훈련시킬 계획인 것 같대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340206,
						400340208
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400340206,
					"content": "보물 사냥 족제비 같은?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340207
					]
				},
				{
					"id": 400340207,
					"content": "맞아, 보물 사냥 족제비. 다만 족제비는 장난이 심해서 통제가 어려워 실패했지. 그래서 이번에는 말을 잘 듣는 「강아지」로 목표를 바꾼 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400340210,
					"content": "전에 보물 사냥단 관련 의뢰를 많이 처리했는데. 생각해 보니 산고 사장님 말이 맞는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340211
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400340211,
					"content": "사람에게 발자국이 있는 것처럼 조직도 자신만의 특이한 흔적을 남겨. 이번 사건에는 실종된 동물도 있고, 갇힌 동물들도 있었지만, 단서의 흔적은 결국 보물 사냥단을 향하고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340212
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400340212,
					"content": "이전 사건의 해결 방법을 참고해서 여기까지 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340213
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400340213,
					"content": "그런데 지키는 사람도 없다니, 이전 사건에 비하면 이번 범인들은 너무 허술해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340214
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400340214,
					"content": "#응, 정말 허술하고 나쁜 놈들이야! 근데, {NICKNAME}, 몇 날 며칠을 싸웠는데 안 힘들어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340215,
						400340216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340215,
					"content": "그러니까 그들이 없는 틈을 타서…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340217,
					"content": "그래, 그렇게 하자! 헤헤, 우린 역시 영혼의 파트너야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400340216,
					"content": "몰래 동물을 구해낼까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340217
					]
				},
				{
					"id": 400340208,
					"content": "페이몬 같은?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400340209
					]
				},
				{
					"id": 400340209,
					"content": "야~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340210
					],
					"speakerTitle": "페이몬"
				}
			]
		},
