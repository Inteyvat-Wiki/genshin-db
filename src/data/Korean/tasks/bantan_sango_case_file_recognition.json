				},
				{
					"id": 400340609,
					"content": "어찌 됐든 우릴 공격할 생각은 없는 것 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400340610
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400340610,
					"content": "왈왈——",
