			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003409",
							"2"
						],
						"stepId": 4003409,
						"stateName": "QUEST_STATE_UNFINISHED"
