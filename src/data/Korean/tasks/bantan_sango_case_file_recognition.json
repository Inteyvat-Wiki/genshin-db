			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"산고"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400341001,
					"content": "산고 사장님, 다녀왔어요. 사실은……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341002
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400341002,
					"content": "알겠어. 카게로마루가 왜 동물들을 지키고 있었는지 대충 알 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341003
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400341003,
					"content": "다른 동물들을 훈련시키고 있었던 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341004
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400341004,
					"content": "그도 어렸을 때 아주 약했다가 나중에 강해졌지. 그래서 훈련을 통해서 다른 동물들도 자기처럼 강하게 만들려고 한 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341005
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400341005,
					"content": "나중에는 약자를 보호하는 여행자를 보고, 자기 주인으로 인정한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341006
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400341006,
					"content": "이것도 약자에 대한 동정심 때문이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341007
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400341007,
					"content": "하지만 단지 단서를 통해 추리한 거뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341008
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400341008,
					"content": "아마 십중팔구는 맞을 거야. 하지만 카게로마루는 말을 못 하니 우리도 확실한 답변을 들을 수는 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341009
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400341009,
					"content": "산고가 말하는 것도 일리가 있네! 역시 두뇌파",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341010
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400341010,
					"content": "멍멍멍!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341011
					],
					"speakerTitle": "카게로마루"
				},
				{
					"id": 400341011,
					"content": "우와. 산고가 한 말에 동의하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341012
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400341012,
					"content": "나에게 아부해도 다음에 의뢰비를 깎아주진 않을 거야. 그나저나 이번 사건은 원만히 해결했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341013
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400341013,
					"content": "#고마워, {NICKNAME}, 페이몬. 너희 덕분에 사건을 해결했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341014
					],
					"speakerTitle": "류지"
				},
				{
					"id": 400341014,
					"content": "아. 잊을 뻔했네. 「사방의 그물」은 잘 쓰고 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341015,
						400341016
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400341015,
					"content": "잘 사용하고 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				},
				{
					"id": 400341017,
					"content": "응. 기억해뒀다가 내 친구에게 전할게. 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341018
					],
					"speakerTitle": "산고"
				},
				{
					"id": 400341018,
					"content": "#천만에! 무슨 일 있으면 언제든지 우릴 찾아줘! {NICKNAME}은(는) 대단하다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400341019
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400341019,
					"content": "여행자의 실력은 확실히 뛰어나지만, 그런 치렛말은 사양할게. 감정은 진실의 적이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "산고"
				},
				{
					"id": 400341016,
					"content": "자꾸 망가질까 봐 걱정돼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400341017
					]
				}
			]
		},
