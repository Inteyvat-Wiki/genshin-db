					"speakerTitle": "밸푸어"
				},
				{
					"id": 735070302,
					"content": "표정을 보아하니 아직 잘 모르겠나 봐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070303,
