				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060201,
					"content": "내 그림 도구들 찾았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060202
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060202,
					"content": "찾았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060203
					]
				},
				{
					"id": 710060203,
					"content": "역시 그림을 그리던 곳에 놓고 왔나 보군. 난 그림 그릴 때 항상 쓰고 난 물건을 바닥에 두거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060204
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060204,
					"content": "가끔 너무 급하게 가면 물건을 다 놓고 올 때도 있어. 고마워, 덕분에 다시 시내에 도구를 사러 가지 않아도 되겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060205
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060205,
					"content": "여기서 계속 그릴 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060206
					]
				},
				{
					"id": 710060206,
					"content": "말도 마. 원래 이 두 조각상의 눈은 빛이 나서 멀리서도 보인다고 들었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060207
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060207,
					"content": "절벽 옆에 있는 눈이 반짝거리는 조각상… 분명 좋은 그림이 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060208
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060208,
					"content": "근데 와서 보니 조각상은 있는데, 눈에서 빛이 나는 건 못 봤단 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060209
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060209,
					"content": "내가 타이밍을 놓쳤거나 각도를 잘못된 잡은 줄 알고 계속 여기서 배경을 고르고 있었는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060210
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060210,
					"content": "휴… 아무리 봐도 모르겠단 말이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060211
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060211,
					"content": "유일한 수확은 밑에 있는 연못에서 이걸 찾았다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060212
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060212,
					"content": "어디에 쓰는 건진 모르겠지만, 보면 볼수록 이 돌이 눈 같다니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060213
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060213,
					"content": "정말 이게 눈이라면 비슷한 돌이 하나 더 있을 거야. 사람의 눈은 2개잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060214
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060214,
					"content": "아, 그냥 내 맘대로 생각해본 거야. 신경 쓰지 마. 이 돌은 내가 갖고 있어도 쓸모없으니 네게 줄게. 내 그림 도구를 찾아준 답례랄까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060215
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060215,
					"content": "휴, 눈이 빛나는 조각상이라… 이 녹화 연못엔 대체 어떤 비밀이 있는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르메르"
				}
			]
		},
