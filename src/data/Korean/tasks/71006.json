					"베르메르"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060601,
					"content": "내 그림 도구들 찾았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060602
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060602,
					"content": "찾았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060603
					]
				},
				{
					"id": 710060603,
					"content": "역시 그림을 그리던 곳에 놓고 왔나 보군. 난 그림 그릴 때 항상 쓰고 난 물건을 바닥에 두거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060604
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060604,
					"content": "가끔 너무 급하게 가면 물건을 다 놓고 올 때도 있어. 고마워, 덕분에 다시 시내에 도구를 사러 가지 않아도 되겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060605
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060605,
					"content": "여기서 계속 그릴 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060606
					]
				},
				{
					"id": 710060606,
					"content": "말도 마. 원래 이 두 조각상의 두 눈은 빛이 나서 멀리서도 보인다고 들었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060607
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060607,
					"content": "절벽 옆에 있는 두 눈이 반짝거리는 조각상… 분명 좋은 그림이 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060608
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060608,
					"content": "근데 와서 보니 조각상은 있는데, 눈에서 빛이 나는 건 못 봤단 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060609
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060609,
					"content": "내가 타이밍을 놓쳤거나 각도를 잘못된 잡은 줄 알고 계속 여기서 배경을 고르고 있었는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060610
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060610,
					"content": "휴… 아무리 봐도 모르겠단 말이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060611
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060611,
					"content": "유일한 수확은 밑에 있는 연못에서 이걸 찾았다는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060612
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060612,
					"content": "엇… 저도 하나 찾았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060613
					]
				},
				{
					"id": 710060613,
					"content": "어라? 어디 보자, 정말 똑같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060614
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060614,
					"content": "정말 이상하군. 뒤에 글씨도 있어. 붙여서 읽으면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060615
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060615,
					"content": "「석관으로 사립문을 닫는다, 원한다면 점을 찍어 넣어라」… 점을 찍으라고? 그게 뭐지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060616
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060616,
					"content": "이 돌은 내가 갖고 있어도 쓸모없으니 네게 줄게. 내 그림 도구를 찾아준 답례야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060617
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060617,
					"content": "사실 내가 생각해봤는데, 이 두 돌이 눈 같지 않아? 아, 그냥 해본 소리야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060618
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060618,
					"content": "만약 정말 이게 눈이라면, 방금 「점을 찍어 넣으라」는 말이 이 두 돌과 관련 있는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060619
					],
					"speakerTitle": "베르메르"
				},
				{
					"id": 710060619,
					"content": "하하하, 이것도 그냥 해본 소리야. 신경 쓰지 마. 난 가서 계속 배경을 찾아볼게. 그림 도구를 찾아줘서 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르메르"
				}
			]
		},
