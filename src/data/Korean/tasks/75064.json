				{
					"id": 750640805,
					"content": "하하, 잘됐네. 그럼 바로 시작하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750640806,
					"content": "그냥 지나가는 길이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640807
