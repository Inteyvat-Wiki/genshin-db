				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540509,
					"content": "우리 어디서 만난 적 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540501
					]
				},
				{
					"id": 752540501,
					"content": "친구, 이건 운명이 비범한 자에게 새긴 표식이야. 타인에게 잊을 수 없는 첫인상을 심어 주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540502
					],
					"speakerTitle": "테쿠틀리"
				},
				{
					"id": 752540502,
					"content": "이 사나운 늑대 같은 안대를 봤으니, 내 비범함을 바로 눈치챘겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "테쿠틀리"
				}
			]
		},
		{
			"id": 7525406,
			"completionStepIds": [],
