					"content": "그럼 이만 가볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540410
					]
				},
				{
					"id": 752540410,
					"content": "넌 아직 내 눈에 대해 묻지 않았잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "테쿠틀리"
