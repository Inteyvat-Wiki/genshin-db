						],
						"stepId": 2203011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"카메이 무네히사"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220300601,
					"content": "감사합니다! 아직 멀쩡하긴 하지만, 더 이상 시간을 지체해서는 안 됩니다… 바로 요리를 시작하겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300602
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300602,
					"content": "완성했습니다, 후우… 이게 다 여행자님 덕분이네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300603,
						220300610
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300603,
					"content": "정말 완벽주의시네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300604
					]
				},
				{
					"id": 220300604,
					"content": "물론이죠. 꽃꽂이든, 다도든, 요리든, 검술이든 모두 마찬가지입니다. 극한을 좇지 않으면 의미가 없는 법이지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300605
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300605,
					"content": "「극한」의 길이 제가 추구하는 길입니다. 하지만… 동욱 님은 저와 좀 다른 것 같습니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300606
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300606,
					"content": "전에 동욱 님이 리월에는 「중용」이라는 단어가 있다고 하셨습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300607
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300607,
					"content": "일이든 사람이든 극단으로 치닫지 말고 중용과 평온을 고수해야 한다고 하셨죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300608
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300608,
					"content": "하지만 저는 그 말의 의미를 잘 모르겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300609
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300609,
					"content": "그래도 전… 이것 또한 동욱 님이 많은 일을 겪고 나서 터득한 이치라고 생각하고 있습니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300612
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300612,
					"content": "식자재도 얻었고, 요리도 완성했으니 더 이상 여행자님의 시간을 뺏지 않겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300613
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300613,
					"content": "이 음식을 받아주십시오, 나머지는 동욱 님에게 드리겠습니다. 흔쾌히 받아주시겠죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300610,
					"content": "그 마물들은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300611
					]
				},
				{
					"id": 220300611,
					"content": "제가 전부 처치했으니 걱정 마십시오",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300612
					],
					"speakerTitle": "카메이 무네히사"
				}
			]
