			},
			"dialogs": [
				{
					"id": 220300101,
					"content": "또 만났네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300102
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300102,
					"content": "외람되지만, 도움을 청하고 싶은 일이 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300103,
						220300104
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300103,
					"content": "무슨 일인데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300106
					]
				},
				{
					"id": 220300106,
					"content": "동욱 님이 저를 고용한 후로, 저는 일행과 동행하게 되었습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300107
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300107,
					"content": "하여 동욱 님이 저를 받아주신 은혜에 보답하고자, 소소한 선물을 드리고 싶습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300108
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300108,
					"content": "근데 동욱 님은 무예보다는 요리를 선호하시니, 직접 음식을 만들어 선물하고 싶습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300109
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300109,
					"content": "식자재 있는 곳을 두 곳 봐놨는데, 식자재들이 다 익으면 수집할 생각이었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300110
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300110,
					"content": "그런데 마물들이 그 두 곳을 점령하고 식자재마저 전부 가져갔습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300111
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300111,
					"content": "제가 만들려는 요리는 식자재의 신선도가 생명입니다, 두 곳에 가서 식자재를 가져올 생각이었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300112
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300112,
					"content": "마물들이 식자재를 몽땅 가져갔어요. 그 요리를 만들려면 빨리 그 두 식자재를 입수해야만 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300113
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300113,
					"content": "하지만 몸이 두 개도 아니고, 한 곳의 마물을 처치한다 해도 다른 곳의 마물이 식자재를 망칠 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300114
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300114,
					"content": "그래서 말인데 저와 함께 마물들을 처치하고 식자재를 수집해주실 수 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300115,
						220300117
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300115,
					"content": "맡겨만 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300116
					]
				},
				{
					"id": 220300116,
					"content": "도와주셔서 정말 감사합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300119,
					"content": "흠… 여기서 이야기해봤자 해결될 일도 아니니, 저와 같이 가면서 논의하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300117,
					"content": "요리가 완성되면 저한테도 좀 나눠줄래요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300118
					]
				},
				{
					"id": 220300118,
					"content": "당연히 드려야지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220300104,
					"content": "그렇게 예의 차릴 것까지야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300105
					]
				},
				{
					"id": 220300105,
					"content": "도움을 청하는 입장에서 당연히 지켜야 할 예의지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300106
					],
					"speakerTitle": "카메이 무네히사"
				}
			]
		},
