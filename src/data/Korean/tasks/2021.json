			},
			"dialogs": [
				{
					"id": 20210201,
					"content": "승리하고 돌아온 여행자 아니신가? 신사에 감사의 예참이라도 하러 왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210202
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210202,
					"content": "네가 불렀잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210203,
					"content": "하하… 장난이야. 기다리고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210204
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210204,
					"content": "기분이 좋아 보이네, 미코",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210205,
					"content": "응, 오랜만에 옛 친구와 옛날이야기를 나눴으니 기쁠 만도 하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210206
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210206,
					"content": "그나저나… 나중에 들었는데 우인단 집행관과 어전시합을 벌였다며? 그 배짱 아주 칭찬해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210207,
						20210208
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210207,
					"content": "갑자기 떠올랐어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210209
					]
				},
				{
					"id": 20210209,
					"content": "정면전에서 그 「시뇨라」를 꺾을 정도면 내 예상보다 훨씬 대단한걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210210
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210210,
					"content": "어쨌든 이겼으면 됐어. 축하해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210211
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210211,
					"content": "드디어 우인단의 계획을 제대로 한번 망쳤군, 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210212,
					"content": "적어도 이번엔 우인단이 「신의 심장」을 못 가져갔잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210213,
					"content": "잠깐, 방금 「신의 심장」이라고 했어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210214
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210214,
					"content": "체스 말 같은 그거?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210215
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210215,
					"content": "맞아 맞아, 미코도 본 적 있어? 셀레스티아와 연결된 일곱 신 소유의 「신의 심장」!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210216,
					"content": "흠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210217
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210217,
					"content": "왜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210218,
					"content": "그거, 내가 넘겼는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210219
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210219,
					"content": "응?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210220
					]
				},
				{
					"id": 20210220,
					"content": "엥?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210221,
					"content": "아니면… 내가 「스카라무슈」한테서 널 어떻게 구했을 거 같아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210222,
						20210223
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210222,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210224
					]
				},
				{
					"id": 20210224,
					"content": "「스카라무슈」는 현재 우인단 집행관 서열 6위야. 실력으로 따지면 「시뇨라」 위에 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210225
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210225,
					"content": "난 쉽게 목숨 거는 타입이 아니거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210226
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210226,
					"content": "뭐라고 반응해야 될지 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210227
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210227,
					"content": "왜 당신이 「신의 심장」을 갖고 있었죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210228
					]
				},
				{
					"id": 20210228,
					"content": "에이가 인형의 형체를 만든 후로 「신의 심장」을 둘 곳이 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210229
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210229,
					"content": "그녀는 가장 친했던 친구인 나한테… 「신의 심장」을 맡기고 나루카미 다이샤에 보관했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210230
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210230,
					"content": "에이는 더 이상 「신의 심장」의 힘이 필요 없어. 셀레스티아와의 관계도 끊었다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210231
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210231,
					"content": "그렇다면 「신의 심장」을 갖고 있어봤자 분쟁만 일으킬 뿐이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210232
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210232,
					"content": "이걸로 「계획」의 핵심 인물과 교환하면 엄청 괜찮은 거래 아니겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210233
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210233,
					"content": "결과적으로도 확실히 이득이고, 후후",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210234
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210234,
					"content": "그러고 보니 그렇네… 나한테도 여행자는 신의 심장보다 훨씬 값진 존재니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210235,
						20210236
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210235,
					"content": "어쩐지 그 뒤로 「스카라무슈」가 안 보이더라니",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210237
					]
				},
				{
					"id": 20210237,
					"content": "휴, 됐어. 이렇게 된 이상 다시 돌려받을 수도 없으니까 신경 쓰지 말자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210238
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210238,
					"content": "그래서 이번에 우릴 부른 이유가 뭔데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210239
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210239,
					"content": "후후, 답례하려고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210240
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210240,
					"content": "진짜?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210241
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210241,
					"content": "티바트 전역을 여행 중이니, 이나즈마에서의 여정도 끝날 때가 되지 않았니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210242
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210242,
					"content": "답례로 앞으로의 길이든 과거의 의혹이든 모두 대답해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210243
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210243,
					"content": "물어보고 싶은 거 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210301,
					"content": "「인형」 쇼군에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210302
					]
				},
				{
					"id": 20210302,
					"content": "「인형」 쇼군의 기술은 지금은 사라진 지식에서 왔어. 신인 그녀만이 그 근원을 알 수 있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210303
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210303,
					"content": "그렇지만… 너희가 흥미로워할 만한 일이 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210304
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210304,
					"content": "에이가 자신의 신의 몸을 개조하기 전에 「원형 인형」을 만들었었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210305
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210305,
					"content": "그, 그럼 라이덴 쇼군이 셋이나 있었단 말이야!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210306,
					"content": "아니, 원형은 테스트용일 뿐이야. 외형과 지능은 에이를 본떠 만들어지지 않았어. 프로토타입이라고 할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210307
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210307,
					"content": "당초 구상대로라면 폐기했어야 하는데, 너무 잔혹하다 생각됐는지 에이는 그저 체내의 힘을 봉인하기로 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210308
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210308,
					"content": "그 후 일반인처럼 자의식을 갖고 이나즈마를 떠돌아다니다… 우인단의 눈에 들었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210309
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210309,
					"content": "우인단!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210310,
					"content": "원형 인형은 우인단 내부 괴짜들의 손을 거친 후 봉인돼 있던 힘이 해제됐는데, 봉인 전보다 더 강력할지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210311
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210311,
					"content": "설마…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210312
					]
				},
				{
					"id": 20210312,
					"content": "응, 신의 피조물이 신의 심장을 앗아간 거야… 그 원형 인형이 지금의 「스카라무슈」지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210313
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210313,
					"content": "어, 어떻게 이런 일이!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210314,
					"content": "그러게, 이게 과연 우연일까, 운명일까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210401,
					"content": "전임 라이덴 쇼군에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210402
					]
				},
				{
					"id": 20210402,
					"content": "이방인이 과거 번개 신이 바뀌었었단 것도 알다니… 이나즈마 사람들도 잘 모르는 일인데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210403
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210403,
					"content": "모락스가 말해줬어. 번개 신 바알도 세상을 떠났다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210404,
					"content": "응, 사실 「바알」과 「바알세불」은 쌍둥이 마신이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210405
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210405,
					"content": "쌍둥이… 마신?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210406,
					"content": "함께 마신 전쟁에서 승리를 거둔 후 바알은 막부를 세우고 바알세불은 측근 「그림자 무사」의 신분으로 바알의 대역이 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210407
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210407,
					"content": "바알세불이 우리가 알고 있는 에이(影)고, 바알의 이름은 「마코토」야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210408
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210408,
					"content": "사람들의 눈에 그 둘은 항상 하나의 존재였어. 두 사람은 서로 부족함을 채워주며 함께 이나즈마를 다스렸기에 백성들이 진실을 알 필요가 없었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210409
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210409,
					"content": "「바알」이란 마신의 이름도, 라이덴 쇼군이란 호칭도 모두 두 사람을 동시에 가리켰었어. 다만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210410
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210410,
					"content": "다만?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210411,
					"content": "다만 마코토가 수백 년 전 내가 겪지 못한 전쟁에서 죽고 나서야 에이가 밖으로 나오게 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210412
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210412,
					"content": "자매가 그리됐으니 충격이 컸겠다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210413,
						20210414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210413,
					"content": "수백 년 전의… 전쟁…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				},
				{
					"id": 20210415,
					"content": "에이가 변하기 시작한 게 그때부터야. 그녀에게 가장 큰 「상실」이었겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210416
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210416,
					"content": "이런 과거가 있었구나. 에이에 대해 더 잘 알게 된 것 같아… 그럼 「마코토」는 어떤 신이었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210417
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210417,
					"content": "그녀와 함께 지낸 시간이 길진 않지만… 상냥한 신이었어. 눈앞의 모든 아름다움을 소중히 여겼지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210418
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210418,
					"content": "그렇구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210501,
					"content": "#나의 {F#오빠}{M#동생}에 관해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210502
					]
				},
				{
					"id": 20210502,
					"content": "미안, 그건 나도 모르겠어. 너희가 말하는 그 신에 대해서도 잘 모르고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210503
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210503,
					"content": "하지만 에이를 의심하는 거라면 쓸데없는 걱정이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210504
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210504,
					"content": "에이는 너희가 말하는 모습과 일치하지도 않고, 이미 오래전에 신의 심장을 포기하고 셀레스티아와 관계를 끊었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210505
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210505,
					"content": "만나 보니 확실히 아닌 거 같아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210506
					]
				},
				{
					"id": 20210506,
					"content": "그럼 됐어. 안 그러면 번개 신의 권속인 나와의 관계가 갑자기 미묘해졌겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210507
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210507,
					"content": "걱정 마. 우린 너랑 싸울 생각 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210508,
					"content": "하하하… 하루빨리 목적을 이루고 모든 진실을 알게 되길 바랄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210509
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210509,
					"content": "#아야토한테 종말번대 부하를 빌려오든 뭐를 하든 내가 할 수 있는 모든 방법을 동원해서 네 {F#오빠}{M#동생}의 종적을 조사해볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210510
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210510,
					"content": "소식 있으면 알려주지. 이것도 답례의 일부야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210601,
					"content": "다음 여정에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210602
					]
				},
				{
					"id": 20210602,
					"content": "이나즈마를 떠나면… 수메르로 가기가 제일 편할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210603
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210603,
					"content": "수메르? 그동안 수메르 학자들을 엄청 많이 봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210604,
					"content": "응, 수메르는 지혜의 신의 나라야. 지혜와 지식에 대한 탐구가 끝이 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210605
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210605,
					"content": "하지만 이런 집착은 이해할 수 없는 일을 파생시키곤 해. 예를 들면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210606
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210606,
					"content": "…수메르에서 지식은 「자원」으로서 통합적으로 관리돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210607
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210607,
					"content": "지식도… 자원이라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210608
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210608,
					"content": "응, 다만 이런 결정을 내린 게 그 「현자」들인지, 「작은 쿠사나리 화신(化神)」인지는 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210609
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210609,
					"content": "「작은 쿠사나리 화신」? 이름이 귀엽네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210610
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210610,
					"content": "음? 모르고 있었구나. 「작은 쿠사나리 화신」은 수메르가 믿는 신이자 수메르인들이 부르는 애칭이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210611
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210611,
					"content": "그녀에게도 확인해보고 싶은 게 있겠지? 행운을 빌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210301,
						20210401,
						20210501,
						20210601,
						20210701
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210701,
					"content": "더 궁금한 거 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210702
					]
				},
				{
					"id": 20210702,
					"content": "그래 그럼. 아 참, 여행자, 내가 준 부적 아직 갖고 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210703
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210703,
					"content": "당연하죠, 잘 갖고 있을게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210704
					]
				},
				{
					"id": 20210704,
					"content": "잘 갖고 있기만 하겠다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210705
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210705,
					"content": "가장 눈에 띄게 목에 걸어놓고 만나는 사람한테마다 지혜와 미모를 겸비한 야에 미코 님이 선물한 거예요라고 말할 줄 알았는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210706
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210706,
					"content": "퍽이나 그러겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210707
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20210707,
					"content": "하하… 장난은 그만하고, 여행자, 네 염원은 뭐지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210708
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210708,
					"content": "#음… {F#오빠와}{M#동생과} 다시 만나는 것?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210709
					]
				},
				{
					"id": 20210709,
					"content": "그렇군… 하지만 너한테 이건 현재의 작은 목표일 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210710
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210710,
					"content": "너에게 있어 「염원」은 속세와 별바다를 초월해 운명과 함께 빛나는 것이어야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210711
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210711,
					"content": "너에게 신의 눈이 없는 이유는 그 염원이 아직 탄생하지 않아서일지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20210712
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210712,
					"content": "앞으로의 여행에서 그 순간이 오길 지켜봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20210414,
					"content": "설마… 켄리아…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210415
					]
				},
				{
					"id": 20210236,
					"content": "내가 이렇게 비싼 사람이었구나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210237
					]
				},
				{
					"id": 20210223,
					"content": "그럼 그때 이미…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210224
					]
				},
				{
					"id": 20210208,
					"content": "좀 충동적이었죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20210209
					]
				}
			]
		},
		{
