			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"야에 미코"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420201,
					"content": "방법이야 있지. 조금 교활한 방법이긴 하지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420202
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420202,
					"content": "문외한에게 의식 공간은 아주 추상적이야. 다행히 난 에이의 권속이니 에이가 있는 곳을 어느 정도 느낄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420203
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420203,
					"content": "그러니까 난 그곳이 공간에서 정확히 어딘지 파악할 수 없지만, 너희를 에이의 곁으로 보낼 순 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420204
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420204,
					"content": "추상적…? 위치? 무슨 소리야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120420205,
					"content": "이해하지 않아도 돼. 쉽게 말하자면, 지금 에이 곁의 모든 게 혼돈스러워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420206
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420206,
					"content": "급류처럼 무질서하지… 억지로 들어가면 파도에 휩쓸려 시간 공간에서 영원히 길을 잃을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420207
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420207,
					"content": "그래서 「일심정토」에 들어갈 땐 의식을 물체에 담아. 그게 가장 안전한 방법이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420208
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420208,
					"content": "엥? 그러면 난 안 갈래. 너희가 가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420209,
						120420210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120420209,
					"content": "어림없지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420211
					]
				},
				{
					"id": 120420211,
					"content": "안 가도 돼. 잘못돼 봤자 에이를 잃는 것뿐이잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420212
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420212,
					"content": "#너, 너희… 짜증 나! {NICKNAME}, 나도 같이 가줄게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120420213,
					"content": "결정했으면 내가 보내줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420214
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420214,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420215
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420215,
					"content": "음? 이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420216
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420216,
					"content": "무슨 일이에요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420217
					]
				},
				{
					"id": 120420217,
					"content": "아무것도 아니야. 조금 뒤죽박죽 하네. 네 추측이 맞았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420218
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420218,
					"content": "참, 공간에 들어갈 때 네 염원을 속으로 계속 외워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420219
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420219,
					"content": "강력한 의식만이 추상 공간의 파도에 휩쓸리지 않아. 네가 강해야 널 가장 적합한 장소로 보낼 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420220
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420220,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420221
					]
				},
				{
					"id": 120420221,
					"content": "자, 문이 열렸어. 들어가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420222
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420222,
					"content": "난 밖에서 상황을 보며 최악의 경우를 대비할게",
