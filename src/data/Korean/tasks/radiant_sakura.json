				"points": []
			},
			"dialogs": [
				{
					"id": 120420101,
					"content": "초조한 모습이군. 또 나한테 뭘 부탁하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420102
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420102,
					"content": "네가 와서 다행이야. 다른 사람이었다면 더 이상 웃는 낯으로 맞이할 기분이 아니었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420103
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420103,
					"content": "하지만 계속 웃고 있었잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120420104,
					"content": "말이 그렇다는 거지. 트집 잡지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420105
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420105,
					"content": "페이몬, 중요한 일부터…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420106
					]
				},
				{
					"id": 120420106,
					"content": "참, 그렇지. 큰일 났어! 에이… 에이가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120420107,
					"content": "야에 미코에게 자초지종을 설명한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120420108
					]
				},
				{
					"id": 120420108,
					"content": "아—— 그랬구나. 에이는 이나즈마를 인간에게 맡기고, 혼자 언제 끝날지 모르는 싸움을 하려는 거군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420109
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420109,
					"content": "고지식하기 짝이 없네. 자신의 의지로만 움직이고, 실력이 조금이라도 부족하면 이룰 수 없는 목표잖아… 에이다워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420110
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420110,
					"content": "그 오랜 시간 이런 식이었는데, 왜 이제와서 걱정이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420111,
						120420112
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420111,
					"content": "이번 결투의 심각성은 전이랑 확연히 달라요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420113
					]
				},
				{
					"id": 120420113,
					"content": "성급하다라… 후후. 틀린 말은 아니지. 에이는 가끔 어린애 같으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420114
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420114,
					"content": "그래서, 내가 도움이 될 거라고 생각했어? 누가 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420115
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420115,
					"content": "지금 모르는 척하는 거지? 일부러 이러는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120420116,
					"content": "꼬마가 똑똑해졌네. 근데 이번엔 진짜야. 라이덴 마코토의 의식 공간에 대해선 나도 잘 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420117
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420117,
					"content": "신성한 벚나무의 토대고, 에이의 「일심정토」랑 조금 다르다는 것밖에 모른다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420118
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420118,
					"content": "라이덴 마코토가 없어서 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120420119,
					"content": "그렇지만은 않아. 공간 본연의 성질도 달라… 나보다 직접 가 본 너희가 더 잘 알 텐데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420120,
						120420121
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420120,
					"content": "모르겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420122
					]
				},
				{
					"id": 120420122,
					"content": "아무튼 세세한 부분일 뿐이야. 설명하려면 조금 복잡해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420123
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420123,
					"content": "일단 나랑 같이 공간 입구로 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120420121,
					"content": "잘 못 봤어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420122
					]
				},
				{
					"id": 120420112,
					"content": "이번엔 너무 성급해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420113
					]
				}
			]
		},
		{
			"id": 1204202,
			"completionStepIds": [
				1204204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
