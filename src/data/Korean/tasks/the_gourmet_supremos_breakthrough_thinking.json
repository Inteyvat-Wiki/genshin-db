					"nextDialogs": [
						220140804
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220140804,
					"content": "「삐카」한 그런 느낌 말이지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140805
					]
				},
				{
					"id": 220140805,
					"content": "나도 모르겠어… 휴, 조금 더 고민해 봐야겠다. 묘 사부가 또 다른 길을 제시해 준 거나 다름없으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140806
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220140806,
					"content": "도와줘서 고마워. 이건 수고해준 답례야",
					"roleType": "TALK_ROLE_NPC",
