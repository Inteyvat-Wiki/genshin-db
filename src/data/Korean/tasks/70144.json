			},
			"dialogs": [
				{
					"id": 701440101,
					"content": "그 한파에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440102
					]
				},
				{
					"id": 701440102,
					"content": "어때? 조사하면서 뭐 좀 나온 거 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440103
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 701440103,
					"content": "이런 걸 찾았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440104
					]
				},
				{
					"id": 701440104,
					"content": "이런 게 언제부터 설산에 나타난 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440105
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 701440105,
					"content": "조사해 줘서 고마워. 길드에는 내가 보고할게. 보수는 여기 있어. 수고했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "옥희"
				}
			]
		},
		{
			"id": 7014402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"옥희"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701440201,
					"content": "무슨 의뢰 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440202
					]
				},
				{
					"id": 701440202,
					"content": "의뢰? 마침 잘 왔어. 지금 나 대신 이상한 한파를 조사할 베테랑 모험가를 찾고 있었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440203
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 701440203,
					"content": "한파요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440204
					]
				},
				{
					"id": 701440204,
					"content": "실은 전에 한 팀이 베테랑 모험가 몇 명이랑 같이 산에 조사하러 들어갔었어. 위험 지역을 피해 제일 안전한 길을 선택했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440205
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 701440205,
					"content": "왠진 모르겠지만 조사 도중에 매서운 한파에 맞닥뜨리게 돼서 야영지로 돌아올 수밖에 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440206
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 701440206,
					"content": "돌아온 모험가의 말에 따르면 그 길은 그런 강도의 한파가 나타나는 게 불가능하데. 게다가 아무런 징조도 없이 갑자기 나타난 거라 분명 자연 현상은 아닌 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440207
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 701440207,
					"content": "그리고 산에서 조사하던 다른 사람들도 같은 일이 발생했다고 보고해왔어. 몇 번이나 조사한 뒤에서야 그 한파의 근원지를 찾아낼 수 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440208
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 701440208,
					"content": "근데 조사를 여러 번 나가다 보니 조사팀의 모험가들은 동상에 걸렸거나 탈진한 상태라 야영지에서 휴식을 취해야 했지. 그래서 지금은 이를 계속 조사할 인원이 부족한 상태야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440209
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 701440209,
					"content": "여행자, 괜찮다면 네가 가서 한파의 근원지를 조사해 주지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440210,
						701440212
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 701440210,
					"content": "맡겨 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440211
					]
				},
				{
					"id": 701440211,
					"content": "그럼 부탁할게. 그 한파는 진짜 괴상하니까 잘 준비해야 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440215
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 701440215,
					"content": "어서 가서 조사해봐, 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "옥희"
				},
				{
					"id": 701440212,
					"content": "보수에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440213
					]
				},
				{
					"id": 701440213,
					"content": "응? 아주 직설적인데? 길드는 모험가를 홀대하지 않으니까, 걱정 마. 보수를 준비해놓고 야영지에서 기다리고 있을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440214
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 701440214,
					"content": "정확한 액수는… 네가 가지고 돌아오는 결과에 따라 정해지는 거지. 이건 너도 알지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440215
					],
					"speakerTitle": "옥희"
				}
			]
		},
