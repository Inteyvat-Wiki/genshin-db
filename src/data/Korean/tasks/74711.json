			"dialogs": [
				{
					"id": 747110101,
					"content": "음! 전부 순조롭네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110102
					],
					"speakerTitle": "시그윈"
				},
				{
					"id": 747110102,
					"content": "난폭한 물고기들을 치료하는 작업도 이제 마지막 단계에 접어들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110103
					],
					"speakerTitle": "시그윈"
				},
				{
					"id": 747110103,
					"content": "아픈 물고기들을 찾아내서 놓친 게 없나 확인하는 것 외에, 특별한 임무가 하나 더 있지——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110104
					],
					"speakerTitle": "시그윈"
				},
				{
					"id": 747110104,
					"content": "피해를 입은 수역에서 중요한 수중 장치를 찾아, 그 탐측 장치에 기록된 자료를 회수하는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110105,
						747110106
					],
					"speakerTitle": "시그윈"
				},
				{
					"id": 747110105,
					"content": "그리고 그 안에서 관련 규칙을 찾아내…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				},
				{
					"id": 747110107,
					"content": "맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110108
					],
					"speakerTitle": "시그윈"
				},
				{
					"id": 747110108,
					"content": "선주랑 잠수부한테도 주의를 주고, 이번 일로 얻은 교훈을 정리해 둬야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 747110109,
					"content": "응. 어부, 관광객, 배를 타거나 물속으로 잠수하는 사람까지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110110
					],
					"speakerTitle": "시그윈"
				},
				{
					"id": 747110110,
					"content": "물과 관련된 활동을 하는 사람이라면 누구나 신경 써야 해. 함부로 물건을 버려서 수역 환경을 파괴하면 안 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110111
					],
					"speakerTitle": "시그윈"
				},
				{
					"id": 747110111,
					"content": "안 그러면, 난폭한 물고기가 나타나서 배를 뒤집어버릴지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "시그윈"
				},
				{
					"id": 747110106,
					"content": "비슷한 사고를 예방하려는 거지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				}
			]
		}
	]
}