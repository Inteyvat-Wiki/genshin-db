						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401480201,
					"content": "요… 요리 나왔어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401480202,
					"content": "하하, 이게 바로 「만족의 기쁨」인가? 역시 푸짐하네, 아주 훌륭해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480203
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 401480203,
					"content": "자자, 친구 어서 앉아. 다들 친구 사이니까 편하게 있으라고! 일단 나부터 먹어볼까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480204
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 401480204,
					"content": "크흠! 형님, 여긴 리월이니까 리월 풍습에 따라야 하지 않을까요? 리월 식사 예절상 손님이 먼저 들어야 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480205
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 401480205,
					"content": "응? 시노부 넌 그런 규칙 같은 거 제일 싫어하지 않았냐…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480206,
						401480207
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 401480206,
					"content": "저도 지금은 손님이잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				},
				{
					"id": 401480208,
					"content": "응? 너마저… 아아, 요리가 너무 먹음직스러워 보여서 그렇구나? 좋아, 그럼 이 몸이 마지막으로 먹지 뭐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480209
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 401480209,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480210
					],
					"speakerTitle": "카미사토 아야토"
				},
				{
					"id": 401480210,
					"content": "당신과 페이몬, 아야토, 시노부가 순서대로 먹자, 그릇에 남은 「고기」도 많이 줄어들었다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480211
					]
				},
				{
					"id": 401480211,
					"content": "…훗, 그런 거였군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480212
					],
					"speakerTitle": "카미사토 아야토"
				},
				{
					"id": 401480212,
					"content": "——드디어 이 몸의 차례군. 제일 큰 조각을 먹어야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480213
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 401480213,
					"content": "자, 잠깐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401480214,
					"content": "응? 또 왜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480215,
						401480216
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 401480215,
					"content": "페이몬, 부탁할게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480217,
					"content": "최… 최선을 다해볼게…. 아참, 내가 이 요리의 유래를 설명하는 걸 깜빡했네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401480218,
					"content": "요리의 유래? 그게 뭐가 중요하다고. 먹을 수만 있으면 그만이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480219
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 401480219,
					"content": "그… 설명도 안 듣고 먹는 건 가이드 없이 여행하는 거나 마찬가지라구! 들으면 더 맛있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401480220,
					"content": "확실히, 차마다 즐기는 법이 다르듯 요리도 마찬가지겠죠. 설명도 듣지 않고 먹는다면 요리사의 성의를 무시하는 것이 아닐까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480221
					],
					"speakerTitle": "카미사토 아야토"
				},
				{
					"id": 401480221,
					"content": "친구의 성의라고? 그건 무시할 수 없지…. 자, 그럼 말해 봐! 다 들어줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480222
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 401480222,
					"content": "그래! 일단 재료부터 소개하자면… 아니지, 일단 망서 객잔과… 적화주의 역사에 대해 말해보자면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480223
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401480223,
					"content": "#({NICKNAME}, 지금이야!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480224
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 401480224,
					"content": "(알았어!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480225
					]
				},
				{
					"id": 401480225,
					"content": "페이몬이 시선을 끄는 틈을 타, 당신과 시노부는 요리를 먹어 치우기 시작한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480226
					]
				},
				{
					"id": 401480226,
					"content": "…적화주에… 그렇게 감동적인 일화가 있었다니…. 지금의 삶을 누릴 수 있는 건 정말 「만족의 기쁨」 그 자체로구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480227
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 401480227,
					"content": "(이런, 아직 「두부 요리」 이야기를 꺼내면 안 되는데…. 나도 모르게 그만 주제를… 다행히 요리가 얼마 안 남았네!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480228
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401480228,
					"content": "(하지만 더 이상은 못 먹겠어…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480229
					]
				},
				{
					"id": 401480229,
					"content": "아! 시노부, 여행자! 언제부터 먹은 거야? 요리가 얼마 남지 않았잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480230
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 401480230,
					"content": "——이젠 더 이상 못 참아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480231
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 401480231,
					"content": "잠깐만요! 형님, 사실 그건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480232
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 401480232,
					"content": "잠깐만요, 이토 씨. 음, 사실… 꼭 들어주셨으면 하는 부탁이 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480233
					],
					"speakerTitle": "카미사토 아야토"
				},
				{
					"id": 401480233,
					"content": "제가 급하게 혼자 오는 바람에, 아라타키파의 명성을 동경하는 제 가족이 당신과 만날 기회를 놓치게 돼서 아쉽더군요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480234
					],
					"speakerTitle": "카미사토 아야토"
				},
				{
					"id": 401480234,
					"content": "남은 「만족의 기쁨」을 포장해서… 가족에게 선물해 준다면, 음, 다들 매우 기뻐할 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480235
					],
					"speakerTitle": "카미사토 아야토"
				},
				{
					"id": 401480235,
					"content": "그… 어… 그건 좀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480236
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 401480236,
					"content": "형님, 리월에서는 남을 돕는 걸 미덕으로 여기죠…. 게다가 요리가 나왔을 때, 구운 생선을 여러 개 드시지 않았나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480237
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 401480237,
					"content": "——저랑 아야토 님의 몫까지 말이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480238
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 401480238,
					"content": "뭐? 그게 너희 몫이었구나…. 이야기에 너무 집중한 바람에 전혀 몰랐네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480239
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 401480239,
					"content": "…크흠, 그럼 아야토 형씨가 나 대신 안부를 전해줘! 어이, 여기 포장 좀 부탁할게——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 401480216,
					"content": "저번에 그거 한 번 더 해봐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480207,
					"content": "제가 먼저 먹어보고 싶어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				}
			]
		},
