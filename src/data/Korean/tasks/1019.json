						10190402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190402,
					"content": "#어떻게 된 거야! {NICKNAME}, 너 괜찮아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190403,
						10190404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190403,
					"content": "난 괜찮아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190405
					]
				},
				{
					"id": 10190405,
					"content": "윽… 엉덩이 밑에 책을 깔았는데도 아프네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190406
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10190406,
					"content": "이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190407
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10190407,
					"content": "여, 여기가 어디지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190408,
					"content": "아, 아파라… 어이 시노부! 그리고 내 형제! 은인! 다들 괜찮아!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190409
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10190409,
					"content": "후… 정말 마른하늘에 날벼락이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190410
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10190410,
					"content": "우리 대체 얼마나 깊은 곳까지 빠진 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190411,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190412
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10190412,
					"content": "방금 대치하던 중에 지면이 무너진 것 같아. 설마 원소의 힘 때문에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190413
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10190413,
					"content": "난 잘못한 거 없어. 그렇게 무례하게 말하면 누가 들어도 화날 거라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190414
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10190414,
					"content": "외부인의 침입을 막는 게 내 일이야. 사실을 말하는 것마저 무례한 거라면… 그쪽이 너무 유리 멘탈인 거 아닌가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190415
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10190415,
					"content": "뭐? 인생 폼생폼사 아니겠어? 이 몸은 양보 같은 것 안 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190416
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10190416,
					"content": "형님, 말로 못 이길 거면서 왜 덤빈 겁니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190417
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10190417,
					"content": "시노부, 지금 누구 편드는 거냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190418
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10190418,
					"content": "사실을 말한 것뿐이잖아요. 형님 마음은 이해하지만, 다른 사람이랑 자꾸 싸우면 피곤해지는 건 저라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190419
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10190419,
					"content": "가만 보니까, 이토는 말발로 야란도 못 이기고, 시노부도 못 이기네. 기가 좀 죽겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190420
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190420,
					"content": "이토와 시노부는 꼭 너랑 날 보는 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190421
					]
				},
				{
					"id": 10190421,
					"content": "으익 뭐어!? 이토랑 같은 취급하지 말아 줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190422
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190422,
					"content": "이봐! 무슨 뜻이야? 시비 거는 거냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190423
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10190423,
					"content": "사, 사실을 말한 것뿐이거든! 너 바보인 거 모르는 사람 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190424
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190424,
					"content": "내가 바보라고? 그럼 넌 날아다니는 땅딸보다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190425
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10190425,
					"content": "날아다니는 땅딸보?! 으, 열 받아…. 나도 이상한 별명을 붙여줄 거야…. 이 소몰이 청년! 흥, 조심하는 게 좋을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190426
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190426,
					"content": "아래로 한참 떨어진 모양이야. 위쪽 상황을 전혀 알 수가 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190427
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10190427,
					"content": "이 정도 거리면 올라갈 수 없을 것 같으니, 다른 길을 찾아야겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190428
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10190428,
					"content": "한창 수다 중에 미안하지만, 너희들이 미리 알아둬야 할 게 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190429
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10190429,
					"content": "층암거연은 리월의 신비 구역이라고 할 수 있어. 몇 년 동안 광갱 구역의 사고 때문에 봉쇄됐었지. 이곳에서는 뭐든 보지 않고, 듣지 않고, 묻지 않는 게 좋아. 알면 안 되는 비밀을 알아서 좋을 것 없으니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190430
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10190430,
					"content": "나도 적대적으로 굴지 않을 테니 너희도 비밀을 지키지 않아서 나와 얼굴 붉힐 일 없었으면 좋겠어. 출구는 내가 어떻게든 찾아볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190431
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10190431,
					"content": "음? 가버렸잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190432
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10190432,
					"content": "출구를 찾으러 갔나 봐요. 야란은 우리 중에서 위기 대처 능력이 가장 뛰어난 사람이니 가게 두자구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190433
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10190433,
					"content": "죄송해요. 관계자가 아닌 분께 의뢰인의 유언 내용을 발설할 수 없어서 두 분에게 사실대로 말 못 했어요…. 정말 미안해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190434
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10190434,
					"content": "제가 층암거연에 온 이유는 유언에서 말한 태위 나침반을 찾기 위해서입니다. 오래전에 제 의뢰인은 그 보물을 잘 활용할 수 있는 사람에게 건네줬어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190435
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10190435,
					"content": "목격자의 말에 의하면 받아 간 사람이 그걸 들고 층암거연으로 향한 이후로 행방불명 됐대요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190436
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10190436,
					"content": "역사적으로 보면 층암거연 일대에서 전쟁이 여러 번 있었죠. 그 사람이 전쟁에서 목숨을 잃었다 해도 전 그 보물을 찾아서 의뢰인의 마지막 소원을 들어주고 싶어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190437
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10190437,
					"content": "야란이 한 말도 전부 사실이에요. 층암거연에 위험이 숨어 있다는 것은… 여러분도 느꼈을 거예요. 곤경에 빠진 이상 다 같이 나갈 방법을 생각해 보는 게 어떨까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190438
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10190438,
					"content": "은인이 그렇게 말한다면… 좋아, 의리는 지켜야지. 이제부터 우린 모두 동료야. 그 거만한 녀석은… 흥, 그 녀석도 껴주지 뭐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190439
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10190439,
					"content": "야란은 총무부에서 일하는 거 아니었어? 엄청 대단한 사람 같아…. 총무부에서 일하려면 기준이 높구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190440
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190440,
					"content": "음, 대외적으론 그렇게 말하고 다니지만… 야란의 진짜 신분에 대해서는 알려줄 수 없어. 야란이 하는 일은 야란 말고 아무도 할 수 없는 일이라고만 해둘게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190441
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10190441,
					"content": "무슨 일을 하길래 이런 외진 곳까지 와야 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190442
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10190442,
					"content": "그건 내가 잘 알지! 딱 봐도 모험가잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190443
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190443,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190444
					]
				},
				{
					"id": 10190444,
					"content": "뭐야 그 표정은? 틀린 말도 아닌데. 우리가 딱 이렇잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190445
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190445,
					"content": "내가 모험가지, 페이몬은 아니잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190446
					]
				},
				{
					"id": 10190446,
					"content": "요즘 완전 쪼잔해졌다니까. 나도 같이 네 덕 좀 보면 어떻다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190447
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190447,
					"content": "#맞아, {NICKNAME}. 넌 페이몬의 대장이잖아. 대장은 부하들이 대장 덕을 볼 수 있게 아량이 넓어야 하는 법이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190448
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10190448,
					"content": "우리는 그런 관계 아니거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190449
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190449,
					"content": "페이몬, 형님이 한 말은 한 귀로 듣고 한 귀로 흘려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190450
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10190450,
					"content": "흥, 시노부 얼굴을 봐서… 넘어가 주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190451
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190451,
					"content": "내가… 휴, 됐다. 형님인 내가 양보해야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190452
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10190452,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190453
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10190453,
					"content": "지금 있는 곳은 설마 공문서에 기록이 되지 않은 또 다른 봉인된 장소인가…? 이곳엔 대체 뭐가 있을지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190454
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10190454,
					"content": "음식과 마실 물을 가져왔으니, 필요하면 말씀하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190455
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10190455,
					"content": "우와! 소몰이 이토야, 너는 좀 모자라도 네 부하는 진짜 든든하구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190456
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190456,
					"content": "헤헤, 나도 그렇게 생각… 아니! 이 몸도 무지 똑똑하거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190457
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10190457,
					"content": "앞에 입구가 있는데, 안에 길이 있는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190458
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10190458,
					"content": "무슨 길이지? 가서 확인해 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190404,
					"content": "여긴… 설마 아래로 떨어진 건가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190405
					]
				}
			]
		},
		{
