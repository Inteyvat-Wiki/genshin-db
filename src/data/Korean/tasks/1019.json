				"points": []
			},
			"dialogs": [
				{
					"id": 10190501,
					"content": "이런 곳에 비경 입구가 있다니, 신기하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190502,
					"content": "입구가 있으면 출구도 있겠지. 들어가 보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190503
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10190503,
					"content": "주위에 있는 건 전부 오래된 리월 산바위 같아. 책에서 본 거랑 비슷해. 이 비경은 아주 오래됐을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190504
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10190504,
					"content": "……!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190505
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10190505,
					"content": "(무슨 소리지?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190506
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10190506,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190507
					],
					"speakerTitle": "소"
				},
				{
					"id": 10190507,
					"content": "……!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190508
					]
				},
				{
					"id": 10190508,
					"content": "어! 소!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190509
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190509,
					"content": "항마대성? 여긴 어쩐 일로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190510
					],
					"speakerTitle": "연비"
				},
				{
					"id": 10190510,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190511
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10190511,
					"content": "나도 방금 위에서 내려왔어. 소리가 들리길래 여기까지 따라온 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190512
					],
					"speakerTitle": "소"
				},
				{
					"id": 10190512,
					"content": "실수로 떨어졌어? 우리랑 같이 다닐래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190513
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190513,
					"content": "아니, 난 따로 할 일이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190514
					],
					"speakerTitle": "소"
				},
				{
					"id": 10190514,
					"content": "중요한 일이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10190515
					]
				},
				{
					"id": 10190515,
					"content": "…사람을 찾고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190516
					],
					"speakerTitle": "소"
				},
				{
					"id": 10190516,
					"content": "여긴 너희가 있을 곳이 아니야, 어서 돌아가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190517
					],
					"speakerTitle": "소"
				},
				{
					"id": 10190517,
					"content": "신출귀몰한 건 여전하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190518
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190518,
					"content": "방금 그 형씨 포스 장난 아닌데? 이 몸과 아주 비슷하군. 엄청난 사람인 게 분명해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190519
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10190519,
					"content": "이봐 소몰이 청년, 어디서 온 자신감이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190520
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190520,
					"content": "그 사람 혼자 행동하게 둬도 괜찮은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190521
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10190521,
					"content": "걔는 아무리 말해도 들을 사람이 아니야…. 엄청 강한 녀석이니까 그냥 내버려 둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190522
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10190522,
					"content": "여기서부턴 주위를 똑바로 살펴. 앞에 뭐가 있을지 아무도 모르니까 준비 단단히 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190523
					],
					"speakerTitle": "야란"
				},
				{
					"id": 10190523,
					"content": "너희를 동료라고 인정했지만… 이 몸의 타고난 전투 능력으론 저 녀석의 설명이나 길 안내는 필요 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190524
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10190524,
					"content": "형님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190525
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 10190525,
					"content": "아——알았어, 알았다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190526
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 10190526,
					"content": "난 야란이 엄청 든든한데. 소몰이 청년, 넌 외국 손님이니까 사람들이랑 잘 지내야 한다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10190527
					],
					"speakerTitle": "페이몬"
				},
