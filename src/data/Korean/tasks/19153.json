			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"레일라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530901,
					"content": "그런 거였구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530902
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 191530902,
					"content": "네 추리를 들려줘",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530903
					]
				},
				{
					"id": 191530903,
					"content": "네, 일단 카타윤 씨의 정보로 봤을 때 선령님은 르타와히스트 학부의 학생이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530904
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 191530904,
					"content": "외부인일 가능성은 배제됐고, 관리자분의 관리를 벗어나 책을 대여하는 것도 불가능하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530905
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 191530905,
					"content": "그다음은 그 기상천외한 초능력은 둘째치고, 목격 지점이 전부 저희 학부에서 추천한 별 관측 지점이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530906
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 191530906,
					"content": "한마디로… 선령님은 연구를 하고 있었던 걸지도 몰라요. 그것도… 저와 비슷한 연구를요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530907
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 191530907,
					"content": "제가 선령님께 한 질문들은 상당히 난이도가 있는데도 하루 만에 답이 왔다는 건 관련 배경지식이 있다는 얘기예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530908
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 191530908,
					"content": "이 추측대로라면 다음 별 관측 지점에서 선령님을 기다리기만 하면 될 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530909,
						191530910
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 191530909,
					"content": "깔끔한 추론이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				},
				{
					"id": 191530911,
					"content": "과, 과찬이세요…. 사실 다른 이유도 있어요, 줄곧 들었던 생각이 있죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530912
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 191530912,
					"content": "하지만 이건 중요하지 않으니 일단 가요. 단서가 있다고 해도 결론에 도달할 수 있을지는 모르니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530913
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 191530913,
					"content": "제가 왜 이런 생각을 하는지는… 선령님이 오지 않으면 말해드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "레일라"
				},
				{
					"id": 191530910,
					"content": "이 정도 논리면 논문을 쓰는 것도 문제없겠는걸",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				}
			]
		}
	]
}