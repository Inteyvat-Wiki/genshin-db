			"trigger": {
				"objectNames": [
					"레일라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530801,
					"content": "다들 유용한 정보를 주셨네요. 같이 정리해볼까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530802
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 191530802,
					"content": "알기 쉬운 정보들도 있지만, 일부는 고민이 필요해 보여요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530803
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 191530803,
					"content": "선령의 정체나 행적을 유추해낼 수 있겠어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530804
					]
				},
				{
					"id": 191530804,
					"content": "네, 한번 볼게요. 잠시만요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530805
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 191530805,
					"content": "(레일라 레일라. 냉정하게 잘 생각해보자. 단서가 엉망이지만 너라면 할 수 있어)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530806
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 191530806,
					"content": "(우선 지금 있는 단서로 선령님의 정체를 추측해보자)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530807
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 191530807,
					"content": "(그다음 선령님의 행적과 동기를 분석하고, 전에 세운 가설을 더하면…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530808
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 191530808,
					"content": "(이러면 어떻게 해야 할지 정답이 나올 거야. 좋았어, 한번 해보자)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "레일라"
				}
			]
		},
		{
			"id": 1915309,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1915304",
							"2"
