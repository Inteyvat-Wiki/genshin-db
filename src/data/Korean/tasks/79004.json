			"dialogs": [
				{
					"id": 790041201,
					"content": "안녕, 무슨 일이니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041202
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790041202,
					"content": "저기, 당신은 「학자」야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790041203,
					"content": "허허, 그런 셈이지. 엄격하게 말하자면 난 사실 「떠돌이 학자」야. 하지만 「떠돌이 학자」도 「학자」라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041204
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790041204,
					"content": "왜, 「학자」만이 해결할 수 있는 문제가 생겼나 봐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041205
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790041205,
					"content": "그러니까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041206
					]
				},
				{
					"id": 790041206,
					"content": "바다 위의 섬에… 벽화라, 재미있군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041207
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790041207,
					"content": "그러니까 그 벽화들을 해독하고 싶어서 학자를 찾는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041208,
						790041210
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790041208,
					"content": "저희를 도와주시겠어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041209
					]
				},
				{
					"id": 790041209,
					"content": "물론이지. 이런 미지의 이야기에 관심이 아주 많거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790041213,
					"content": "그럼 바로 그 벽화들을 보여줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041214
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790041214,
					"content": "이건 저희가 배껴 그린 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041215
					]
				},
				{
					"id": 790041215,
					"content": "음… 훌륭하군. 미안한데 생각할 시간을 좀 줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사이드"
				},
				{
					"id": 790041210,
					"content": "수고비를 드릴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790041211
					]
				},
				{
					"id": 790041211,
					"content": "하하하, 그렇게 말하는 걸 보니 넌 경험이 풍부한 모험가로구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041212
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790041212,
					"content": "하지만 내겐 미지의 이야기 자체가 최고의 선물이야. 따로 수고료는 안 줘도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790041213
					],
					"speakerTitle": "사이드"
				}
			]
		},
