			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040301,
					"content": "이만큼이나 따라 그려놨어. 이걸 합치면 전반적인 내용을 이해할 수 있겠어",
					"roleType": "TALK_ROLE_NPC",
