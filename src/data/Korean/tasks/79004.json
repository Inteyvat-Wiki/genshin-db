				}
			]
		},
		{
			"id": 7900404,
			"completionStepIds": [
				7900404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7900404",
							"2"
						],
						"stepId": 7900404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"사이드"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790040401,
					"content": "음, 이 벽화에 그려진 내용은 어렵지 않네. 벽화의 순서를 정확히 맞출 순 없지만, 하나씩 이해해도 별문제 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040402
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040402,
					"content": "일단 이건 해난을 당한 사람들을 그린 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040403
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040403,
					"content": "해난을 당한 후, 이들은 너희가 벽화를 찾아낸 그 섬까지 표류했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040404
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040404,
					"content": "그 후 이들은 이 섬에 살기 시작하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040405
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040405,
					"content": "이 벽화를 봐. 여기에는 다섯 가지 물체에 대해 그려져 있는데, 이 물체들 안에는 각기 다른 표식이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040406
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040406,
					"content": "물을 담은 다섯 개의 잔 같은데, 잔마다 물이 담긴 양도 다 다르네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040407
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040407,
					"content": "보통 이런 건 어떤 사물의 상태 변화를 암시하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040414,
						790040415
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040414,
					"content": "사물의 상태 변화라…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040408
					]
				},
				{
					"id": 790040408,
					"content": "하지만 그게 어떤 사물인지는 잘 모르겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040409
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040409,
					"content": "그래도 이게 바다 위의 섬이라면, 저건 「바닷물」일지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040410
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040410,
					"content": "다음 그림을 보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040411
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040411,
					"content": "또 한번의 해난 후에 이 섬에 새로운 「손님」이 찾아왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040412
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040412,
					"content": "봐봐, 이건 처음으로 온 사람들이 두 번째로 온 사람들을 구조하는 그림이야. 그리고 부러진 배도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040413
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040413,
					"content": "첫 번째 벽화에서 배는 이들의 처지를 나타내는 거였지만, 이 그림에선 부러진 배를 아주 구체적으로 그렸네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040416
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040416,
					"content": "이 부러진 배는 표류한 사람들에게 특별한 의미가 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040417
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040417,
					"content": "그 다음이 바로 이 벽화야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040418
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040418,
					"content": "너희들도 발견했겠지만, 이 벽화의 산에는 특별한 표식이 있는 곳이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040419
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040419,
					"content": "이 사람들에게 이 위치는 뭔가 중요한 의미가 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040422
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040422,
					"content": "마지막은 이 벽화야. 이들은 이 섬을 나갈 방법을 찾았고, 그래서 이 섬을 탈출했다는 걸 바로 알 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040423
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040423,
					"content": "이 벽화들에 담긴 이야기는 아마 이 정도일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040424,
						790040428
					],
					"speakerTitle": "사이드"
				},
				{
