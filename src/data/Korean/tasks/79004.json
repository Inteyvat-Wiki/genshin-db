						790040425
					]
				},
				{
					"id": 790040425,
					"content": "천만에, 난 이런 걸 연구하는데 관심이 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040426
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040426,
					"content": "이 벽화들을 가져와줘서 고마워. 몬드에서 이런 걸 건지게 될 줄은 몰랐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790040427
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040427,
					"content": "음, 나도 시간을 내서 여기저기 다녀야 하나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사이드"
				},
				{
					"id": 790040428,
					"content": "왜 벽화라는 방법을 택했을까요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790040429
					]
				},
				{
					"id": 790040429,
					"content": "정보를 기록하고 전달하는 데 있어 그림은 언어보다 훨씬 직관적이거든",
					"roleType": "TALK_ROLE_NPC",
