	"talks": [
		{
			"id": 7114901,
			"completionStepIds": [
				7114901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7114901",
							"2"
						],
						"stepId": 7114901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"평계"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711490101,
					"content": "올해 준비는 문제 없겠지. 휴… 각청 님이 또 직접 확인하러 나오실 일은 없겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490116
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490116,
					"content": "으악! 이런 생각 하면 안 돼. 난 재물신이야… 재물신…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490103
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490103,
					"content": "당신은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490117
					]
				},
				{
					"id": 711490117,
					"content": "나는 재물신이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490118,
						711490119
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490118,
					"content": "그, 그래 보여요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490120
					]
				},
				{
					"id": 711490120,
					"content": "#어라? {NICKNAME}? 안녕, 네가 올 줄 알았으면 이렇게 달달 외울 필요도 없었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490121
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490121,
					"content": "보아하니 리월에 해등절 보내러 왔구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490122
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490122,
					"content": "올해는 정말 잘 맞춰 온 거야. 주위 분위기 좀 봐봐, 작년 해등절보다 훨씬 더 북적이지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490123,
						711490124
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490123,
					"content": "해등절은 해마다…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490125
					]
				},
				{
					"id": 711490125,
					"content": "그야 당연하지! 「소등처럼 해마다 더 높이 나아간다」고 하잖아. 뭐든지 해마다 발전해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490126
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490126,
					"content": "어머, 축제인데 이런 얘기는 그만하고. 자, 재미있는 데 좀 알려줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490127
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490127,
					"content": "어디 보자… 음… 아, 있다! 해등절이니까 당연히 소등부터 날려야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490128
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490128,
					"content": "그리고 올해는 리월항 곳곳에 「황금 나무」를 엄청 많이 설치했거든. 잔가지 자르는 걸 도와주면, 안에 든 「덕담 엽전」은 전부 네 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490129
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490129,
					"content": "우리가 몇 개나 설치했더라? 음… 21개, 맞아, 21개",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490130
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490130,
					"content": "게다가… 바로 이 근처에도 「황금 나무」가 있거든. 관심 있으면 가서 잔가지를 쳐내 봐, 아주 쉬울 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490131
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490131,
					"content": "마지막으로… 음, 혹시 관심 있으면 옆에 있는 「게시판」도 한번 봐봐. 저기, 내 바로 옆에 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490132
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490132,
					"content": "몇 년 사이에 해등절을 보러 오는 외국 관광객이 엄청 늘어서, 우리 총무부가 그 사람들을 위해 「게시판」을 따로 마련했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490102
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490102,
					"content": "궁금한 게 있거나 해결해야 할 일이 있으면 「게시판」에 적어서 걸어두면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490133
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490133,
					"content": "후후, 우리 총무부는 리월에 해등절을 즐기러 온 모두를 다 만족시켜서 돌려보낼 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490134,
						711490135
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490134,
					"content": "역시 총무부답네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490136
					]
				},
				{
					"id": 711490136,
					"content": "당연하지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490137
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490137,
					"content": "#맞다, {NICKNAME}, 너 사진 잘 찍지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490138,
						711490139
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490138,
					"content": "조금은요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490140
					]
				},
				{
					"id": 711490140,
					"content": "하하하, 그렇게 겸손해하지 마. 사실은… 너한테 부탁할 게 하나 있어서 그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490141
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490141,
					"content": "아주 간단해! 관광객들 몇 명한테 「기념사진」 한 장만 찍어주면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490142
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490142,
					"content": "원래는 우리도 「기념사진」 전담 사진가들을 좀 고용해 놨거든? 근데 올해는 관광객이 너무 많이 와서, 사진가들이 모자라지 뭐야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490143
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490143,
					"content": "#새로 사람 부르기엔 이미 늦었고, 그래서 결국 너밖에 부탁할 사람이 없다, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490144
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490144,
					"content": "제발! 관광객들을 위해서, 해등절을 위해서, 리월을 위해서! 너밖에 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490145,
						711490146
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490145,
					"content": "맡겨 주세요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490147
					]
				},
				{
					"id": 711490147,
					"content": "#오! 역시 {NICKNAME}(이)야. 그럼 관광객 몇 명의 이름이랑 예약 장소를 알려줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490148
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490148,
					"content": "그럼 부탁해. 네가 도와주면 올해 해등절은 진짜 완벽할 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490149
					],
					"speakerTitle": "평계"
				},
				{
					"id": 711490149,
					"content": "이 소등은 네 선물. 헤헤, 해피 해등절!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "평계"
				},
				{
					"id": 711490146,
					"content": "해등절을 위하여!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490147
					]
				},
				{
					"id": 711490139,
					"content": "아예 못 찍어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490140
					]
				},
				{
					"id": 711490135,
					"content": "역시 리월답네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490136
					]
				},
				{
					"id": 711490124,
					"content": "더 대단해지는 것 같아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490125
					]
				},
				{
					"id": 711490119,
					"content": "정말로 복이 들어올 것 같은 옷이네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490120
					]
				}
			]
		}
	]
}