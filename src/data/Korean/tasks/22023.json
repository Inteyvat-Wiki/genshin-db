			"dialogs": [
				{
					"id": 220230201,
					"content": "이렇게 빨리 돌아오다니? 너 신분을 감춘 엄청난 요리사였어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230202
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230202,
					"content": "음… 못 참겠어, 맛 좀 보게 해줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230203,
						220230204
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230203,
					"content": "맛있게 드세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220230204,
					"content": "방금 무슨 요리에 대해 논의했지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230205
					]
				},
				{
					"id": 220230205,
					"content": "음… 모라육, 훈제고기 볶음 그리고 뜨끈 야채 스튜!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220230206,
					"content": "결정했으면 탕운에게 맡기자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
