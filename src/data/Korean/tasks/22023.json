					"탕운"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220230101,
					"content": "음…리월 요리를 먹을 수 있다면 좋을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230102
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230102,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230103
					]
				},
				{
					"id": 220230103,
					"content": "이 차림은… 너 여행자니? 미안, 그냥 집 생각이 좀 나서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230104,
						220230105
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230104,
					"content": "방금 리월 요리가 먹고 싶다고 했죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230118
					]
				},
				{
					"id": 220230118,
					"content": "어? 설마… 리월 요리할 줄 알아? 잘됐다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230119
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230119,
					"content": "그럼, 어, 빨리 도와줘. 제대로 된 리월 요리 좀 만들어 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230120
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230120,
					"content": "지금 내가 가장 먹고 싶은 건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230121
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230121,
					"content": "그래! 고기! 고기를 한입 크게 먹고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230122
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230122,
					"content": "그 섬세한 질감, 그리고 고기 지방과 리월의 특수 조미료가 섞여서 나오는 최고의 향기…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230123
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230123,
					"content": "이런 고기만 생각하면, 저도 모르게 부들부들 떨려…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230124
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230124,
					"content": "그러니깐 난 고기를 먹고 싶어! 리월의 고기 요리를 부탁해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230105,
					"content": "무슨 문제가 생겼나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230106
					]
				},
				{
					"id": 220230106,
					"content": "먼저 내 소개를 할게, 내 이름은 탕운이야. 리월에서 온 역사학자로 이나즈마의 특색있는 풍습과 민화를 연구하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230107
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230107,
					"content": "원래 자료를 거의 다 수집해서 리월로 돌아가려던 참이었는데, 이나즈마의 쇄국령으로 발이 묶인 지 꽤 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230108
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230108,
					"content": "사실 난 이게 좋은 일이라고 생각하고 있어. 왜냐하면 지금 이나즈마는 역사적인 순간을 맞았거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230109
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230109,
					"content": "난 이 특별한 시기가 티바트의 역사에 한 획을 그을 것이라고 확신해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230110
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230110,
					"content": "이 역사를 눈으로 직접 보고 가감 없이 온전하고 분명하게 기록해서 후세에 남기는 것이 역사학자들이 해야 할 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230111
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230111,
					"content": "그런데… 사명감이 불타긴 하지만, 배가 고프긴 하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230112
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230112,
					"content": "배고프세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230113
					]
				},
				{
					"id": 220230113,
					"content": "말하기 민망한데… 배고파… 하하하, 이나즈마 음식이 정말 맛있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230114
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230114,
					"content": "난 이곳의 「모둠튀김」이 정말 좋아. 뭐랄까… 튀김옷을 입혀서 모든 것을 튀길 것 같은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230115
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230115,
					"content": "하지만 이나즈마 요리를 많이 먹다 보니, 리월 요리가 더 생각나네. 근데 제대로 된 리월 요리를 하는 식당을 찾지 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230116
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230116,
					"content": "며칠 전 마음을 단단히 먹고 모험가 길드에 가서 「요리 의뢰」를 신청했는데 아직까지 연락이 없네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230117
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220230117,
					"content": "제가 한번 해볼까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230118
					]
				}
			]
		},
