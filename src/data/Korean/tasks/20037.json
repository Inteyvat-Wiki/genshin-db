					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370503
					]
				},
				{
					"id": 200370503,
					"content": "휴… 이렇게 오랫동안 연락을 안 했는데, 다행히 화는 안 났나 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370504
					],
					"speakerTitle": "갓윈"
				},
