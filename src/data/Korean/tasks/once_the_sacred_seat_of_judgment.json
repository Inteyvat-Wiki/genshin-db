					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890714,
					"content": "「하얀 사자가 이런 혜안을 감추고 있었다니… 정말 놀랍군」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
