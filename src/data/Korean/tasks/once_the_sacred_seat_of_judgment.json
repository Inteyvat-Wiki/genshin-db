					"nextDialogs": [
						751890710,
						751890712
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751890710,
					"content": "한번 해 보자…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890711
					]
				},
				{
					"id": 751890711,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890716,
					"content": "어쨌든… 이 베리어를 위로 올릴 방법을 생각해 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751890712,
					"content": "보기 드물게 제대로 된 제안이네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890713
					]
				},
				{
					"id": 751890713,
					"content": "꺄우, 우웅!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
