				},
				{
					"id": 751890705,
					"content": "반짝반짝 빛나서… 한번 만져보고 싶어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890706
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751890706,
					"content": "꺄!",
