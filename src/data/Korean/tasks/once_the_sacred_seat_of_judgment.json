			"dialogs": [
				{
					"id": 751890301,
					"content": "「자, 녀석들이 허가를 어디에 숨겼는지 확인해보자꾸나…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890302
					],
					"speakerTitle": "비밀근원 하인"
				},
				{
					"id": 751890302,
					"content": "「저기에 그냥 둔 것을 보니… 숨길 생각이 없는 모양이군…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890303
					],
					"speakerTitle": "비밀근원 하인"
				},
				{
					"id": 751890303,
					"content": "「하지만 빈 껍데기만 남았어…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890304
					],
					"speakerTitle": "비밀근원 하인"
				},
				{
					"id": 751890304,
					"content": "으앗! 갑자기 어디서 수계 사냥개가 나타난 거지? 으, 저 허가도 그럼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751890305,
					"content": "「입구가 열린 틈을 타고 침입한 모양이군」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890306
					],
					"speakerTitle": "비밀근원 하인"
				},
				{
					"id": 751890306,
					"content": "그, 그럼 이제 어떡하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751890307,
					"content": "「심의회의 복구 정화 장치를 가동하면 해결할 수 있으니 걱정할 필요 없다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890308
					],
					"speakerTitle": "비밀근원 하인"
				},
				{
					"id": 751890308,
					"content": "「바로 저기 있군…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "비밀근원 하인"
				}
