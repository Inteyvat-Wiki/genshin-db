			"dialogs": [
				{
					"id": 761250201,
					"content": "(콜롬비나는 역시 여기에 없네…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250202
					]
				},
				{
					"id": 761250202,
					"content": "설마 콜롬비나, 정말로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761250203,
					"content": "(콜롬비나는 「달의 문」에 들어갔어. 그 안에 뭐가 있는지는 아무도 모르지만, 그곳은 강력한 달 사냥꾼마저 산산조각 낸 곳이야…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250204
					]
				},
				{
					"id": 761250204,
					"content": "(만약 그때 내가…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250205
					]
				},
				{
					"id": 761250205,
					"content": "콜롬비나?",
