					"nextDialogs": [
						761250231
					],
					"speakerTitle": "월령"
				},
				{
					"id": 761250231,
					"content": "이 월령은… 연주를 좋아하는 그 월령 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250232
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761250232,
					"content": "이 월령… 마음이 좀 불안해 보여…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250233
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761250233,
					"content": "아니면 네가 연주해 볼래? 익숙한 멜로디를 들으면 조금이나마 진정될지도 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250234
