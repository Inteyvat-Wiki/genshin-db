					"nextDialogs": [
						761250242
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 761250242,
					"content": "콜롬비나가 아직 돌아오지 않은 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761250243
					]
				},
				{
					"id": 761250243,
					"content": "내가 보기에도 그래",
