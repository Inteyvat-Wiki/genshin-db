					"content": "…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250208
					],
					"speakerTitle": "월령"
				},
				{
					"id": 761250208,
					"content": "너희구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761250209
