				"objectNames": [
					"소"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413130901,
					"content": "어때? 널 위해 해등절을 옮겨와 봤어! 되게 맛있어 보이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130902
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413130902,
					"content": "이게 너희가 옮겨온 해등절인가? 인간은 왜 항상 이런 괴이한 행동을 하는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130903
					],
					"speakerTitle": "소"
				},
				{
					"id": 413130903,
					"content": "이러는 이유가 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130904,
						413130905
					],
					"speakerTitle": "소"
				},
				{
					"id": 413130904,
					"content": "네가 해등절에 참석했으면 좋겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				},
				{
					"id": 413130906,
					"content": "…그런가? 인간의 마음은 정말 헤아리기 어렵군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130907
					],
					"speakerTitle": "소"
				},
				{
					"id": 413130907,
					"content": "얘기만 하지 말고 빨리 먹자! 음식이 식는다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130908
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413130908,
					"content": "헤헤, 나 먼저 먹는다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130909
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413130909,
					"content": "맛있는 것도 먹었으니까 이제 「명소등」 보러 가야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130910
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413130910,
					"content": "소도 같이 가자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130911
					]
				},
				{
					"id": 413130911,
					"content": "너희 둘이 가. 난 그런 거에 관심 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130912,
						413130913
					],
					"speakerTitle": "소"
				},
				{
					"id": 413130912,
					"content": "그럼 데려다만 줘",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130914,
					"content": "맞아. 같이 가서 보는 건 싫어도… 데려다줄 수는 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130915
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413130915,
					"content": "여기서 리월항까지 가려면 얼마나 멀고 험한데…. 그치? 엄청 위험하다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130916
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413130916,
					"content": "시내까지 갈 필요 없어. 리월항 밖까지만 데려다주면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130917
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413130917,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130918
					],
					"speakerTitle": "소"
				},
				{
					"id": 413130918,
					"content": "…후",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130919
					],
					"speakerTitle": "소"
				},
				{
					"id": 413130919,
					"content": "좋아. 그럼 <color=#00E1FFFF>리월항 밖</color>까지만 데려다주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130920
					],
					"speakerTitle": "소"
				},
				{
					"id": 413130920,
					"content": "응응! 어서 출발하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413130913,
					"content": "제발요, 호법야차님",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130914
					]
				},
				{
					"id": 413130905,
					"content": "해등절은 모두가 함께 즐기는 날이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130906
					]
				}
			]
		},
