			"dialogs": [
				{
					"id": 413130801,
					"content": "또 무슨 일이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130802
					],
					"speakerTitle": "소"
				},
				{
					"id": 413130802,
					"content": "같이 해등절에 가고 싶어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130803
					]
				},
				{
					"id": 413130803,
					"content": "…사람 많은 곳은 싫다니깐 너희들끼리 놀다 와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130804
					],
					"speakerTitle": "소"
				},
				{
					"id": 413130804,
					"content": "리월항에 안 가도 돼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130805
					]
				},
				{
					"id": 413130805,
					"content": "…그게 무슨 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130806
					],
					"speakerTitle": "소"
				},
				{
					"id": 413130806,
					"content": "해등절을 옮겨왔어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130807
					]
				},
				{
					"id": 413130807,
					"content": "「옮겨와」?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130808
					],
					"speakerTitle": "소"
				},
				{
					"id": 413130808,
					"content": "그러니까 객잔 밑에 맛있는 거랑 소등을 잔뜩 준비해놨다구. 사람도 별로 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130809
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413130809,
					"content": "「행인두부」랑 「흘호어 구이」도 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130810
					]
				},
				{
					"id": 413130810,
					"content": "빨리 내려가자! 음식 다 식겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 4131309,
			"completionStepIds": [
				4131314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
