			"dialogs": [
				{
					"id": 413130201,
					"content": "어때, 잘 마무리됐나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130202
					],
					"speakerTitle": "소"
				},
				{
					"id": 413130202,
					"content": "응. 그런데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130203
					]
				},
				{
					"id": 413130203,
					"content": "그럼 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130204
					],
					"speakerTitle": "소"
				},
				{
					"id": 413130204,
					"content": "진짜 명소등 보러 안 가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130205
					]
				},
				{
					"id": 413130205,
					"content": "안 가. 말했잖아, 북적이는 곳은 질색이라고. 특히 매년 이맘때는 더",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130206
					],
					"speakerTitle": "소"
				},
				{
					"id": 413130206,
					"content": "올해의 명소등은 「이소도천진군」이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413130207
					]
				},
				{
					"id": 413130207,
					"content": "맞아. 엄청 멋지고 위엄 있어 보이는 사슴이야. 같이 보러 가자~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413130208,
					"content": "「이소도천진군」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130209
					],
					"speakerTitle": "소"
				},
				{
					"id": 413130209,
					"content": "결국 소등일 뿐이잖아. 인간이 만든 모형엔 흥미 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413130210
					],
					"speakerTitle": "소"
				},
				{
					"id": 413130210,
					"content": "그냥 너희들끼리 가서 구경해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소"
				}
			]
		},
