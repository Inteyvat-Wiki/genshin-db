					"nextDialogs": [
						207030303
					],
					"speakerTitle": "이디스 박사"
				},
				{
					"id": 207030303,
					"content": "넌 「원소」를 볼 수 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030304
					],
					"speakerTitle": "이디스 박사"
				},
				{
					"id": 207030304,
					"content": "내 생각엔 「바람」의 흔적을 따라서만 수색해주면 될 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030305
					],
					"speakerTitle": "이디스 박사"
				},
				{
					"id": 207030305,
					"content": "난 나무 밑에서 기다리고 있을게. 뭔가를 찾으면 나한테 가져다줘",
