			"dialogs": [
				{
					"id": 207030401,
					"content": "인정하고 싶지 않지만, 연구에 관해서는 너 같은 사람이 더 적합한 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030402
					],
					"speakerTitle": "이디스 박사"
				},
				{
					"id": 207030402,
					"content": "모험 경험도 풍부하고 체력도 좋고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030403
					],
					"speakerTitle": "이디스 박사"
				},
				{
					"id": 207030403,
					"content": "무엇보다 「신의 눈」이 없는데도 원소를 다룰 수 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030404
					],
					"speakerTitle": "이디스 박사"
				},
				{
					"id": 207030404,
					"content": "원소… 이 대지에 과연 이 두 글자와 상관없는 연구가 있을까? 학자로서 원소를 다룰 수 있느냐 없느냐는 정말…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030405
					],
					"speakerTitle": "이디스 박사"
				},
				{
					"id": 207030405,
					"content": "아, 또 말이 길어졌네…. 미안, 신경 쓰지 마",
					"roleType": "TALK_ROLE_NPC",
