					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180538
					],
					"speakerTitle": "타카츠카사가 가신"
				},
				{
					"id": 120180538,
					"content": "용기 있게 나서는 자가 단 한 명도 없단 말인가?",
					"roleType": "TALK_ROLE_NPC",
