			"dialogs": [
				{
					"id": 120180301,
					"content": "우와, 이렇게 비밀스러운 곳이 있다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120180302,
					"content": "보통은 깊은 산속에 이런 건물을 지을 이유가 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180303,
						120180304
					],
					"speakerTitle": "에이(影)"
				},
				{
					"id": 120180303,
					"content": "긴급 피난처일 수도",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120180305
					]
				},
				{
					"id": 120180305,
					"content": "이 땅에 속하지 않는 위험한 기운이 느껴져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180306
					],
					"speakerTitle": "에이(影)"
				},
				{
					"id": 120180306,
					"content": "으엥?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120180307,
					"content": "조심하면서 가자. 쿠죠가의 후손이 이미 곤경에 처했을 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "에이(影)"
				},
				{
					"id": 120180304,
					"content": "사람들의 이목을 피하기 위함일 수도",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120180305
					]
				}
			]
		},
		{
			"id": 1201805,
			"completionStepIds": [
				1201805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
