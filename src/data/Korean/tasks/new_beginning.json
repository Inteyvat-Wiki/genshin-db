			"dialogs": [
				{
					"id": 120240401,
					"content": "#하암… 오늘이 회담일인데, 어때? {NICKNAME}, 준비됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240402
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240402,
					"content": "자, 이걸 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240403
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240403,
					"content": "어젯밤 내가 쓴 묘책 모음집이야. 이번 회담은 복잡하지만, 자세히 생각해보면 경우의 수는 187가지에 불과해",
