			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"산고노미야 코코미",
					"쿠죠 사라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120240101,
					"content": "오랜만입니다, 쿠죠 사라. 저번 만남은 전장에서였죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240102
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240102,
					"content": "네, 그땐 당신 덕분에 애 좀 먹었죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240103
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240103,
					"content": "근데 네가 왜 여기 있는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240104
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240104,
					"content": "이번 평화 회담을 보기 위해서요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120240105
					]
				},
				{
					"id": 120240105,
					"content": "#맞아요. {F#그녀}{M#그}는 이번 회담의 증인입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240106
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240106,
					"content": "#{F#그녀}{M#그}는 우리 사이의 전쟁을 온전히 겪었고, 지금의 평화를 위해 큰 공을 세웠죠. {F#그녀}{M#그}보다 적합한 사람은 없어 보입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240107
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240107,
					"content": "그렇네요. 그럼 바로 본론으로 들어가죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240108
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240108,
					"content": "우선 해역 관할권에 대한 문제입니다. 전쟁 기간 동안 우린 와타츠미섬 어민들의 나루카미섬 해역 활동을 제한해왔죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240109
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240109,
					"content": "이제부턴 정식으로 제한을 풀 계획입니다만, 나루카미섬의 세법에 따라 세금을 납부해야만 수확을 와타츠미섬으로 가져올 수 있게 되죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240110
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240110,
					"content": "좋습니다. 대신 나루카미섬 근처에서 어업 활동을 하는 어민은 반드시 텐료 봉행의 보호를 받아야 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240111
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240111,
					"content": "치안 문제로 손실이 발생한다면, 텐료 봉행이 나서서 해결해 주셔야 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240112
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240112,
					"content": "좋아요, 협약서에 넣죠. 텐료 봉행이 있는 한 아무 일도 없을 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240113
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240113,
					"content": "회담이 꽤 순조로워 보여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120240114,
					"content": "인적 왕래와 상주 군대의 소속 문제로 넘어갑시다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240115
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240115,
					"content": "예전엔 우리가 와타츠미섬에 가거나 와타츠미섬 사람이 올 때 모두 엄격한 심문을 거쳤었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240116
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240116,
					"content": "결국 교류는 점점 줄어들고, 섬을 넘나들며 장사하려는 상인도 적어졌고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240117
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240117,
					"content": "전쟁이 끝났으니, 야시로 봉행에서 상인들을 선발해 양측의 상업 무역을 관할할 것을 제안합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240118
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240118,
					"content": "상업 무역은 교류가 있어야 하죠. 양측 상인 모두 참여해야 합니다. 아예 야시로 봉행에 맡길 순 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240119
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240119,
					"content": "하지만 제가 알기로 와타츠미섬은 현재 각종 물자가 시급하다고 하던데, 야시로 봉행에서 일괄적으로 안배하는 게 그쪽한테도 좋을 텐데요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240120
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240120,
					"content": "부족한 물자는 저희 쪽에서 해결하겠습니다. 와타츠미섬은 자원이 풍부해서 외지 상인들도 오고 싶어 하거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240121
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240121,
					"content": "그리고 이런 안건은 카미사토 가문이 직접 저희랑 의논해야죠. 텐료 봉행은… 그럴 권력이 없을 텐데요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240122
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240122,
					"content": "그렇다면 치안 문제를 얘기해보죠. 전 와타츠미섬의 치안 부대를 텐료 봉행의 관할로 되돌릴 생각입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240123
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240123,
					"content": "지금으로선 불가능합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240124
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240124,
					"content": "불가능한 일이 어디 있습니까? 이나즈마의 치안은 텐료 봉행에서 전면 관리하고 있는데, 와타츠미섬만 예외로 둘 순 없죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240125
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240125,
					"content": "비겁한 쿠죠가, 우인단과 결탁해서 우리 와타츠미섬의 모든 걸 빼앗으려 하다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240127
					],
					"speakerTitle": "타다카츠"
				},
				{
					"id": 120240127,
					"content": "코코미! 이럴 땐 몇 번째 술책을 써야 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120240128,
					"content": "마지막… 근데 지금은 너희가 나서지 않아도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240129
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240129,
					"content": "타다카츠, 상황이 변했으니 일단 옆에서 대기하도록",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240130
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240130,
					"content": "걱정 마. 너희의 요구는 이미 알았으니, 이제부턴 나한테 맡겨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240131
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240131,
					"content": "쿠죠 씨, 이 일에 관해서 우리 와타츠미섬에 해명은 해주셔야죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240132
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240132,
					"content": "…네, 잠시만요. 다들 내 조사가 끝낼 때까지 움직이지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240133
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240133,
					"content": "너희 둘, 이쪽으로",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240134
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240134,
					"content": "말해 보아라, 정말 우인단과 결탁했나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240135
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240135,
					"content": "그게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240136
					],
					"speakerTitle": "모토스케"
				},
				{
					"id": 120240136,
					"content": "실은, 결탁이라 할 것도 아닙니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240137
					],
					"speakerTitle": "스에 요시타카"
				},
				{
					"id": 120240137,
					"content": "우인단 몇 명이 찾아와서 그들과 협력하면 와타츠미섬과의 전쟁을 계속할 수 있다고 했습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240138
					],
					"speakerTitle": "모토스케"
				},
				{
					"id": 120240138,
					"content": "그땐 시도해 봐도 나쁠 건 없다고 생각했죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240139
					],
					"speakerTitle": "모토스케"
				},
				{
					"id": 120240139,
					"content": "하지만 저흰 수락하지 않고 아주 신중히 행동했어요. 일단 그들이 와타츠미섬에 손해를 입히면, 저흰 상황 봐서 움직이겠다고 했습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240140
					],
					"speakerTitle": "스에 요시타카"
				},
				{
					"id": 120240140,
					"content": "쿠죠 님, 저흰 정말 결탁하지 않았습니다. 얼마 전에 얘기만 했을 뿐인데, 와타츠미섬 사람들이 어떻게 알았는지 모르겠어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240141
					],
					"speakerTitle": "스에 요시타카"
				},
				{
					"id": 120240141,
					"content": "됐다… 돌아가면 알아서 벌을 받도록",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240142
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240142,
					"content": "놈들은 우인단이다. 우인단이 우리한테 무슨 짓을 했는지 벌써 잊었나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240143
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240143,
					"content": "협력은커녕, 그들과는 머리카락 한 올도 얽히지 않아야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240144
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240144,
					"content": "그들의 목적은 뭐지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240145
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240145,
					"content": "우인단의 주요 병력은 이미 이나즈마에서 철수했을 겁니다. 저희를 찾아온 자들은 우두머리의 복수를 원한 것 같습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240146
					],
					"speakerTitle": "스에 요시타카"
				},
				{
					"id": 120240146,
					"content": "그 여자의 부하인가… 복수를 위해 이나즈마를 계속 혼란에 빠뜨릴 생각이군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240147
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240147,
					"content": "언젠가 내가 친히 그들을 전부 잡아들일 것이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240148
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240148,
					"content": "이번 일은 우리 문제가 맞습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240149
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240149,
					"content": "제 불찰로 이런 일이 생긴 점 사과합니다. 회담을 이어갈 기회를 다시 한번 주시죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240150
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240150,
					"content": "후후… 쿠죠 씨가 이 일을 제대로 처리하실 거라 믿어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240151
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240151,
					"content": "하지만 텐료 봉행 내부에서조차 불협화음이 있는데, 어떻게 와타츠미섬의 치안을 마음 놓고 맡길 수 있겠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240152
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240152,
					"content": "반박할 수 없군요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240153
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240153,
					"content": "이 안건은 일단 보류하죠. 텐료 봉행이 정돈된 후에 다시 의논하는 걸로 합시다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240154
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240154,
					"content": "상인 문제도 양측이 모두 참여할 수 있게 야시로 봉행 측과 상의해보죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240155
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240155,
					"content": "사라의 기세가 확연히 꺾였네. 그렇다면 회담도 순조롭게 진행할 수 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240156
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120240156,
					"content": "와타츠미섬의 「군사」가 작전뿐만 아니라, 담판에도 능할 줄은 몰랐군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240157
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240157,
					"content": "다음 만남에도 이렇게 앉아서 대화했으면 좋겠네요. 전장에서 당신을 만나면 꽤 성가시거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240158
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240158,
					"content": "오늘은 여기까지 하죠. 저도 돌아가서 텐료 봉행의 내부 문제를 철저히 조사해야겠군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240159
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240159,
					"content": "우인단 야영지는 저희가 처리했으니, 얼마 지나지 않아 지원을 얻기 위해 다시 그쪽과 연락할 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240160
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240160,
					"content": "괜히 경계할 수도 있으니 우선은 움직임을 보이지 않는 게 좋을 거예요. 그리고 그들이 나타나길 기다렸다 일망타진하는 걸 추천합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240161
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120240161,
					"content": "감사합니다, 고려하도록 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240162
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240162,
					"content": "그럼 전 이만 가보겠습니다. 다음에 보죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240163
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 120240163,
					"content": "산고노미야 님, 저흰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120240164
					],
					"speakerTitle": "타다카츠"
				},
				{
					"id": 120240164,
					"content": "일단 와타츠미섬으로 돌아가지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "산고노미야 코코미"
				}
			]
		},
