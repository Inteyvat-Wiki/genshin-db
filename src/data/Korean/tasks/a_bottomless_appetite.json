						222000303
					]
				},
				{
					"id": 222000303,
					"content": "좋아, 한번 먹어볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "일성"
				},
				{
					"id": 222000304,
					"content": "아직이요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000305
					]
				},
				{
					"id": 222000305,
					"content": "어부 토스트는 「만민당」에서도 팔아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000307
					],
					"speakerTitle": "일성"
				},
				{
					"id": 222000307,
					"content": "음, 몬드에서 온 상인한테 들은 건데, 「디어 헌터」 레스토랑에 통통 연꽃 해산물 수프라는 메뉴가 있대. 엄청 맛있을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000308
					],
					"speakerTitle": "일성"
				},
				{
					"id": 222000308,
					"content": "그리고 몬드 생선구이랑 달콤달콤 닭고기 스튜도. 이 요리들은 별로 어려울 것 같지 않네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000309
					],
					"speakerTitle": "일성"
				},
				{
					"id": 222000309,
					"content": "꼬르륵… 아… 먹을 걸 생각했더니 더 배고프네 꼬르륵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "일성"
				}
			]
		},
