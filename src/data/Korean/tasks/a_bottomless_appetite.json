					],
					"speakerTitle": "일성"
				},
				{
					"id": 222000602,
					"content": "생각하니까 더 배고프네, 꼬르륵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000603
					],
					"speakerTitle": "일성"
				},
				{
					"id": 222000603,
					"content": "부탁할게. 요리를 좀 가져다줘. 먹고 나면 오늘 하루만큼은 꼬르륵거리지 않겠지…",
					"roleType": "TALK_ROLE_NPC",
