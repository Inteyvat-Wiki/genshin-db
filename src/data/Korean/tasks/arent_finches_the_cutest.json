			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352801",
							"2"
						],
						"stepId": 7352801,
						"stateName": "QUEST_STATE_UNFINISHED"
