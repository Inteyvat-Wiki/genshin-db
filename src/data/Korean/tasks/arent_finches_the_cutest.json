			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"바히마"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735280101,
					"content": "안녕하세요. 전 생론파 학자인 바히마입니다. 부탁이니 잠시만 시간을 내주시겠어요…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280102
					],
					"speakerTitle": "바히마"
				},
				{
					"id": 735280102,
					"content": "아주 중요한 얘기를 해드릴 테니 몸과 마음을 가볍게 하고 귀를 기울여 주세요——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280103
					],
					"speakerTitle": "바히마"
				},
				{
					"id": 735280103,
					"content": "세상에서 제일 귀여운 건, 바로 참새랍니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280104
					],
					"speakerTitle": "바히마"
				},
				{
					"id": 735280104,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735280105,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280106
					]
				},
				{
					"id": 735280106,
					"content": "참새가 귀여운 건 알겠는데… 학자라고 하지 않았어? 그렇게 단정 지어 말하는 건 논쟁을 불러일으키지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735280107,
					"content": "내가 만약 학자라면… 음… 「황금 새우볼보다 맛있는 건 세상에 없어!」라고 단정 짓진 않을 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735280108,
					"content": "나라면 아마 좀 더 학자답게 「황금 새우볼은 최근 내가 제일 먹고 싶은 리월 요리 중에 하나야」라고 했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280109,
						735280110,
						735280111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735280109,
					"content": "그럼 저도 단도직입적으로 말할게요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280112,
					"content": "#윽! {NICKNAME}, 너 갑자기 왜 그래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735280113,
					"content": "농담이 아니더라도 그렇게 크게 말하진 말라구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735280114,
					"content": "하하하! 바로 그거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280115
					],
					"speakerTitle": "바히마"
				},
				{
					"id": 735280115,
					"content": "학자라는 신분 때문에 혹여나 말실수를 하진 않을까 전전긍긍하면서 매사를 토론회처럼 대하고 싶진 않아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280116
					],
					"speakerTitle": "바히마"
				},
				{
					"id": 735280116,
					"content": "누가 맨날 저만 지켜보고 있는 것도 아니고, 가끔 말실수 좀 한다고 해서 어떻게 되는 것도 아닌데요 뭐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280117
					],
					"speakerTitle": "바히마"
				},
				{
					"id": 735280117,
					"content": "중요하게 여기는 건, 마음속에 품지 말고 대담히 내뱉을 수 있어야 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280118
					],
					"speakerTitle": "바히마"
				},
				{
					"id": 735280118,
					"content": "여러분이 제가 만든 「우당탕탕 짹짹볼」 게임을 해봤다면, 저처럼 참새가 제일 귀여워라고 외치고 있을걸요?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280119
					],
					"speakerTitle": "바히마"
				},
				{
					"id": 735280119,
					"content": "우당… 탕탕… 짹짹볼? 테이블 위에 있는 저걸 말하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735280120,
					"content": "네, 이 게임을 해보시면 제가 왜 참새가 세상에서 가장 귀엽다고 했는지 알게 될 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280121
					],
					"speakerTitle": "바히마"
				},
				{
					"id": 735280121,
					"content": "게다가 이건 「유리빛 신기루」의 공식 이벤트 중 하나라서 높은 점수를 얻으면 보상도 받으실 수 있답니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280122
					],
					"speakerTitle": "바히마"
				},
				{
					"id": 735280122,
					"content": "그렇게 말하니까 왠지 해보고 싶네. 게다가 보상까지 받을 수 있다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735280123,
					"content": "#{NICKNAME}, 넌 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280124,
						735280125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735280124,
					"content": "해보자!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280126,
					"content": "하하, 시원시원하시네요! 그럼 마음껏 즐겨보시죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바히마"
				},
				{
					"id": 735280125,
					"content": "참새가 얼마나 귀여운지 어디 한번 보자고!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280110,
					"content": "세상에서 제일 귀여운 건, 페이몬이에요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280111,
					"content": "반박은 받지 않을게요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				}
			]
		}
	]
}