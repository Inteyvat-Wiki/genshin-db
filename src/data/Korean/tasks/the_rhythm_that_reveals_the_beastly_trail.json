			},
			"dialogs": [
				{
					"id": 730741601,
					"content": "잠깐 준비 좀 할게…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741602
					]
				},
				{
					"id": 730741602,
