			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬",
					"아란마"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730741701,
					"content": "이게 바로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741702
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741702,
					"content": "그래, 이게 바로 바소마 열매야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741703
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741703,
					"content": "바소마 열매는 바사라 나무의 꿈과 기억이 모여 열린 열매야. 우리가 힘을 되찾을 수 있는 소중한 열매이기도 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741704
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741704,
					"content": "「아슈바타 나무」에서 비야의 열매가 열리려면 많은 힘이 필요하거든. 그래서 바소마 열매를 공양해야 하는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741705
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741705,
					"content": "#나라{NICKNAME}, 바소마 열매를 잘 보관해야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741706
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741706,
					"content": "음… 그럼 아란마에게 「보물」의 의미를 가르쳐줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741707
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741707,
					"content": "보물이란 건 소중한 걸 말하는 거야. 바소마 열매를 봐, 많은 꿈과 기억을 보유하고 있고 아란나라의 힘도 회복시켜주잖아. 엄청 대단하고 희귀하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741708
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741708,
					"content": "바소마 열매처럼 소중하고 중요한 게 바로 보물이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741709
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741709,
					"content": "오오! 보물이란 게 그런 의미였구나… 알겠어. 고마워, 페이몬!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741710,
						730741712
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741710,
					"content": "이제 뭘 해야 해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741711
					]
				},
				{
					"id": 730741711,
					"content": "음… 전에 아란자가 말했던 것 같아. 필요한 바소마 열매가 하나가 아니지? 그럼 또 다른 아슈바타 전당을 찾아야겠네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741714
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741714,
					"content": "#응, 열심히 할게! 나라{NICKNAME}, 페이몬. 나중에 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741715
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741715,
					"content": "응! 아란마, 나중에 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741712,
					"content": "페이몬, 고마워!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741713
					]
				},
				{
					"id": 730741713,
					"content": "뭐라는 거야… 전에 아란자가 말했던 것 같아. 필요한 바소마 열매가 하나가 아니지? 그럼 또 다른 아슈바타 전당을 찾아야겠네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741714
					],
					"speakerTitle": "페이몬"
				}
			]
		},
