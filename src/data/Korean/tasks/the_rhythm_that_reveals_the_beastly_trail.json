			},
			"dialogs": [
				{
					"id": 730741801,
					"content": "두 번째 바소마 열매 획득!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741802
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741802,
					"content": "#나라{NICKNAME}(은)는 정말 대단해! 마라나도 처리하고, 마물도 두려워하지 않아. 역시 바나그니를 물리친 나라야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741803
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741803,
					"content": "크흠, 우린 함께 모험하면서 정말 많은 일을 겪었거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741804
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741804,
					"content": "#대단해! 그럼 나라{NICKNAME}와(과) 페이몬도 많은 추억과 이야기가 있겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741805,
						730741806
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741805,
					"content": "많긴 하지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741807
					]
				},
				{
					"id": 730741807,
					"content": "#음, 나라{NICKNAME}, 페이몬. 나중에 꼭 이야기 들려줘야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741808
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741808,
					"content": "물론이지! 예전에도 다른 사람에게 이야기를 들려준 적이 있어. 꽤나 오래전 일인 것처럼 느껴지네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741809
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741809,
					"content": "그러고 보니, 바사라 나무의 꿈… 꿈속에서 먼 곳에 있는 커다란 보라색 나무를 봤는데, 그게 뭘까? 바나라나에서도 보이는 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741810
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741810,
					"content": "그건 첫 번째 「아슈바타의 꿈 나무」야. 음… 뭐랄까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741811
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741811,
					"content": "꿈은 시냇물에 떠 있는 잎사귀 같아서 물의 흐름과 함께 빠르게 도망가곤 해. 그래서 꿈을 영원히 간직하고 싶다면 꿈이 뿌리내리게 해야 도망가지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741812
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741812,
					"content": "흑흑… 어떻게 설명해야 할까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741813,
						730741814
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741813,
					"content": "아슈바타의 꿈 나무가 나무뿌리 같다고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741815
					]
				},
				{
					"id": 730741815,
					"content": "#나라{NICKNAME}(은)는 역시 똑똑해. 이런 나무가 있으면 아란나라의 꿈은 영원히 존재할 수 있고, 더 많은 아란나라가 드나들 수 있고, 바사라 나무와 연결할 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741816
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741816,
					"content": "그렇구나… 그러니까 꿈속의 바나라나가 꿈속에 머문 것도 그 나무 때문인 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741817
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741817,
					"content": "응, 마라나의 일이 너무 걱정돼. 나중에 모두와 함께 방법을 찾아야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741818
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741818,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741819
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741819,
					"content": "#하지만 그건 비야의 열매를 맺은 다음 다시 얘기하자! 지금은 나라{NICKNAME}, 페이몬과 아란나의 친구를 도와야 하니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741820
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741820,
					"content": "응! 아란마도 이제 아슈바타 전당을 찾으러 가는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741821
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741821,
					"content": "맞아! 우린 꼭 다시 만날 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741822
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741822,
					"content": "조심해, 아란마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741823
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741823,
					"content": "#나라{NICKNAME}, 페이몬도 조심해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741814,
					"content": "아슈바타의 꿈 나무가 꿈을 도망가지 못하게 한다고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741815
					]
				},
				{
					"id": 730741806,
					"content": "그럭저럭",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741807
					]
				}
			]
		},
		{
			"id": 7307419,
			"completionStepIds": [
				7307414
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307414",
							"2"
						],
						"stepId": 7307414,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_GREATER",
						"rawParams": [
							"73263",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬",
					"아란마"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730741901,
					"content": "세 번째 바소마 열매도 획득! 아란자 말대로 세 개면 충분하겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741902
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741902,
					"content": "#응! 충분할 것 같아. 나라{NICKNAME}, 페이몬. 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741903,
						730741905
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741903,
					"content": "천만에",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741904
					]
				},
				{
					"id": 730741904,
					"content": "…그러고 보니, 분명히 네가 도움을 줬는데 왜 우리에게 고마워하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741906
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741906,
					"content": "음, 생각해 보니 이렇게 말해야 할 것 같네. 너희도 아란나를 돕는 중이고, 또 아란나는 내 친구니까, 그래서 너희한테 고마운 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741907
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741907,
					"content": "#그리고 나라{NICKNAME}(은)는 아란야사, 아란다사, 아란슈드라카를 도와 오래된 노래를 찾아냈고, 그들도 나의 친구니까, 그래서 너희한테 고마운 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741908
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741908,
					"content": "#마지막으로 나라{NICKNAME}(이)랑 페이몬과 함께 모험을 하게 되어 너무 즐거웠거든, 그래서 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741909
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741909,
					"content": "나도 즐거웠어! 고마워, 아란마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741910
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741910,
					"content": "그러고 보니 아슈바타 전당은 아주 오래된 유적 같아 보이는데… 전해져 오는 얘기 같은 거 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741911
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741911,
					"content": "아주 오래전의 이야기인데, 내가 씨앗도 아니었을 때 얘기야. 아주 먼 옛날엔 나라도 아란나라를 볼 수 있었고, 아란나라도 나라를 두려워하지 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741912
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741912,
					"content": "#그때는 나라와 아란나라가 서로를 도우며 함께 놀았어. 지금의 나랑 나라{NICKNAME}처럼 자주 함께 노래도 불렀지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741913
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741913,
					"content": "아란야사와 같은 채곡가들도 다 나라에게서 배운 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741914
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741914,
					"content": "아슈바타 전당은 원래 아란나라와 나라가 함께 놀던 곳이었어. 비록 아주 오래전 일이지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741915
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741915,
					"content": "그 끔찍한 재앙이 일어난 후로 바나라나는 멸망했고, 아슈바타 전당도 황폐해졌지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741916
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741916,
					"content": "그랬구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741917
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741917,
					"content": "응, 끔찍한 이야기야. 하지만 다행이야. 내 기억이 아닌 이야기일 뿐이라서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741918
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741918,
					"content": "#걱정 마! 다 잘될 거야. 그렇지, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741919,
						730741920
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741919,
					"content": "응, 맞아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741922
					]
				},
				{
					"id": 730741922,
					"content": "아슈바타 전당도 찾았고 바소마 열매 세 개도 구했으니까, 이제 돌아가서 우트사바 축제 준비를 돕고, 숲속의 동료들도 불러야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741923
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741923,
					"content": "응! 아란마, 힘내! 우트사바 축제가 기대된다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741924
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741924,
					"content": "나도 너무 기대돼! 그럼, 또 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741925
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730741925,
					"content": "아란마, 또 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741920,
					"content": "글쎄…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741921
					]
				},
				{
					"id": 730741921,
					"content": "#…{NICKNAME}, 너 많이 피곤해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730741922
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730741905,
					"content": "분명히 도움을 줘놓고…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730741906
					]
				}
			]
