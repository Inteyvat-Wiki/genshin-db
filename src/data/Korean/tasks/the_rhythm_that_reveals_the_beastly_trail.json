				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730740301,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740302
					],
					"speakerTitle": "아란다사"
				},
				{
					"id": 730740302,
					"content": "이게 아란야마가 남긴 노래야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740303
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730740303,
					"content": "「불이 활활 타오르는 길이라도, 노래를 부르며 나아가리라…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740304
					],
					"speakerTitle": "아란다사"
				},
				{
					"id": 730740304,
					"content": "「그날의 달빛이 죽어가는 짐승의 눈동자 같았다고 해도…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740305
					],
					"speakerTitle": "아란다사"
				},
				{
					"id": 730740305,
					"content": "「우리는 생명의 계곡의 주민이자, 용감한 씨앗이니까」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740306
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730740306,
					"content": "이 노래가… 우리가 찾아낸 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730740307,
					"content": "「열매를 맺길 바라는 석류가 있기에, 활짝 꽃을 피우고 싶은 장미가 있기에」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740308
					],
					"speakerTitle": "아란다사"
				},
				{
					"id": 730740308,
					"content": "「멀고도 가까운 하늘… 영원한 약속… 반드시 꿈으로 돌아올 투쟁」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740309
					],
					"speakerTitle": "아란다사"
				},
				{
					"id": 730740309,
					"content": "…그렇구나, 이제 알겠어. 아란야마의 노래로 아슈바타 전당으로 가는 길의 장애물을 없앨 수 있는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740310,
						730740312
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730740310,
					"content": "나도 알았어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740311
					]
				},
				{
					"id": 730740311,
					"content": "응? 뭘 알았다는 거야…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730740313,
					"content": "당연히 아란야마의 노래 덕이지. 음, 혹시 아란나라가 아니면 이해하기 어려운 걸까…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740314
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730740314,
					"content": "아란다사, 먼저 가서 우트사바 축제를 준비할래? 아슈바타 전당은 나한테 맡겨!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740315
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730740315,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740316
					],
					"speakerTitle": "아란다사"
				},
				{
					"id": 730740316,
					"content": "#나랑 {NICKNAME}도 같이 갈게! 바소마 열매 구하는 걸 도와주기로 했으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730740317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730740317,
					"content": "「…즐겁게 노래하며 나아갈 거야」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란다사"
				},
				{
					"id": 730740312,
					"content": "어떻게 안 거야…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730740313
					]
				}
			]
		},
