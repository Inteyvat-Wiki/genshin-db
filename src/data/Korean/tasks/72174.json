					"「뱃사공」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721740101,
					"content": "강가에… 은빛 나무가, 은빛 잔디, 은빛 바위…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740102,
						721740103
					],
					"speakerTitle": "「뱃사공」"
				},
				{
					"id": 721740102,
					"content": "저기…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				},
				{
					"id": 721740104,
					"content": "음… 손님이군, 배를 탈 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740105
					],
					"speakerTitle": "「뱃사공」"
				},
				{
					"id": 721740105,
					"content": "아이고, 외부인이구먼…. 그럼 안 돼, 그럼 안 되지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740106,
						721740107
					],
					"speakerTitle": "「뱃사공」"
				},
				{
					"id": 721740106,
					"content": "안 돼요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740108,
					"content": "달나라로 가는 은빛 나룻배는 자네들을 위해 준비된 게 아니네… 자네들은 이 배에 타면 안 된다네, 내 배를 더럽히지 말게나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740109
					],
					"speakerTitle": "「뱃사공」"
				},
				{
					"id": 721740109,
					"content": "아이고… 안개가 사라진 지 오랜데… 누가 아직 배에 안 탄 건가… 황금빛 집의 여주인님이 화내실 걸세…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740110
					],
					"speakerTitle": "「뱃사공」"
				},
				{
					"id": 721740110,
					"content": "배…? 배가 어디 있다는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740111
					]
				},
				{
					"id": 721740111,
					"content": "후후… 은빛 나룻배, 태양과 산의 자손의 배, 다들 이제 집으로 돌아가자꾸나, 달에 있는 황금빛 집으로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740112
					],
					"speakerTitle": "「뱃사공」"
				},
				{
					"id": 721740112,
					"content": "근데… 어린아이가 길을 잃어버려서, 아직 배에 안 탔는데… 여주인님이 화내실 텐데, 이거 어쩌지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740113,
						721740114
					],
					"speakerTitle": "「뱃사공」"
				},
				{
					"id": 721740113,
					"content": "도움이 필요하신가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740115,
					"content": "어서 배에 타… 망설이지 말고, 미련 갖지 말고 어서 배에 타시게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「뱃사공」"
				},
				{
					"id": 721740114,
					"content": "제 말 들리세요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740107,
					"content": "뭐라고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740103,
					"content": "누구세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				}
			]
		},
