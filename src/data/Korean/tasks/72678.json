			"dialogs": [
				{
					"id": 726780401,
					"content": "우낭낭… 바람이 너무 세…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780402
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726780402,
					"content": "이곳의 바람 장벽은 통과할 수 없어! 빙 돌아서 가야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726780403,
					"content": "길법사, 우릴 따라서 옆으로 천천히 돌아서 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
