					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726780302,
					"content": "길법사, 왜 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726780303,
					"content": "이 도시는 황량해, 조금 슬퍼. 이유는 모르겠어, 이상해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726780304,
						726780305
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726780304,
					"content": "나도 그렇게 생각해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726780306
					]
				},
				{
					"id": 726780306,
					"content": "다음은 「도시」의 중심으로 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726780305,
					"content": "길법사는 이상하네!",
					"roleType": "TALK_ROLE_PLAYER",
