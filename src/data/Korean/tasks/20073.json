			"dialogs": [
				{
					"id": 200730201,
					"content": "보급을 잘 두고 왔니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730202
					],
					"speakerTitle": "리제"
				},
				{
					"id": 200730202,
					"content": "네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730203
					]
				},
				{
					"id": 200730203,
					"content": "다행이다. 이제 좀 안심이 되네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730204
					],
					"speakerTitle": "리제"
				},
				{
					"id": 200730204,
					"content": "그래도 설산에 오르는 사람들이 만반의 준비를 갖춰서 이런 긴급 보급품을 안 쓰는 게 최고지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730205
					],
					"speakerTitle": "리제"
				},
				{
					"id": 200730205,
					"content": "그나저나 너 옷이 좀 얇은 거 아니야? 이게 몬드성 최신 유행인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730206
					],
					"speakerTitle": "리제"
				},
				{
					"id": 200730206,
					"content": "이건 보수니까 받아두고, 어서 돌아가서 옷 좀 더 껴입어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리제"
				}
			]
		},
