				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"리제"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200730101,
					"content": "여행자! 마침 잘 왔어. 뭐 좀 도와줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730102
					],
					"speakerTitle": "리제"
				},
				{
					"id": 200730102,
					"content": "무슨 일인데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730103
					]
				},
				{
					"id": 200730103,
					"content": "설산의 환경이 열악한 거 너도 봤잖아. 경험이 풍부한 모험가라고 해도 모든 상황에 완벽히 대처할 수 있다고 말하기 힘들지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730104
					],
					"speakerTitle": "리제"
				},
				{
					"id": 200730104,
					"content": "난 단장 대행의 명령으로 여기에서 몬드 시민에게 설산에 가지 말라고 경고하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730105
					],
					"speakerTitle": "리제"
				},
				{
					"id": 200730105,
					"content": "몬드 시민은 내 경고를 잘 듣는 편인데, 모험가들은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730106
					],
					"speakerTitle": "리제"
				},
				{
					"id": 200730106,
					"content": "너도 알잖아. 그들은 아무리 말려도 듣질 않아. 어떻게든 설산에 오르려고 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730107
					],
					"speakerTitle": "리제"
				},
				{
					"id": 200730107,
					"content": "모험가들과 관련된 일들을 얼마나 많이 처리했는지 몰라…. 근데 설산에 가려는 모험가들이 계속 늘고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730108
					],
					"speakerTitle": "리제"
				},
				{
					"id": 200730108,
					"content": "모험가들을 하나씩 통제하기란 불가능해…. 그래서 설산의 몇몇 장소에 보급품을 비치할 생각이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730109
					],
					"speakerTitle": "리제"
				},
				{
					"id": 200730109,
					"content": "이렇게 하면 고생 좀 했다가 하산하려는 모험가들이 설산에서 무사히 빠져나올 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730110
					],
					"speakerTitle": "리제"
				},
				{
					"id": 200730110,
					"content": "근데… 운이 너무 좋은 덜렁이 모험가들이 너무 깊이 들어가면, 그들의 안전은 운명에 맡겨야지, 뭐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730111
					],
					"speakerTitle": "리제"
				},
				{
					"id": 200730111,
					"content": "어쨌든 이 보급품들을 설산에 가져다줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730112,
						200730114
					],
					"speakerTitle": "리제"
				},
				{
					"id": 200730112,
					"content": "제게 맡기세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730113
					]
				},
				{
					"id": 200730113,
					"content": "그럼 부탁할게. 휴, 모험가들이 다 너처럼 실력 있고 판단력도 뛰어나면 좋을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "리제"
				},
				{
					"id": 200730117,
					"content": "네 지도에 세 장소를 표시해놨어. 표시된 곳에 <color=#00E1FFFF>햄 일인분</color>을 놓고 오면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730118
					],
					"speakerTitle": "리제"
				},
				{
					"id": 200730118,
					"content": "휴, 모험가들이 자신의 능력을 과대평가하지 않으면 좋으련만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리제"
				},
				{
					"id": 200730114,
					"content": "이게 도움이 될까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730115
					]
				},
				{
					"id": 200730115,
					"content": "그건 잘 모르겠지만… 그래도 없는 것보단 낫지 않겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730116
					],
					"speakerTitle": "리제"
				},
				{
					"id": 200730116,
					"content": "설산처럼 열악한 환경에 보급품이 많으면 좋은 거지. 그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "리제"
				}
			]
		},
		{
			"id": 2007302,
