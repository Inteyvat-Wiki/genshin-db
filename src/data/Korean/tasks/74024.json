				]
			},
			"dialogs": [
				{
					"id": 740240101,
					"content": "어, 여기서 혼자 뭐 해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240102,
					"content": "으악! 갑자기 뒤에서 말을 걸면 어떡해요! 놀라서 갈아놓은 가루를 흘릴 뻔했잖아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240103
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240103,
					"content": "가루? 음, 이것들은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240104,
					"content": "보석이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240105
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240105,
					"content": "보, 보석? 뭘 하는 곳이길래 보석이 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240106,
					"content": "보석이 없는 게 더 이상하지 않나요? 아직 정식 이름은 없지만 여긴 제가 보석을 가공하는 공방인걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240107
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240107,
					"content": "그냥 「슬루아시 공방」 같은 쉬운 이름으로 정할까 싶었는데, 제 이름을 내거는 건 별로겠죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240108
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240108,
					"content": "보석 가공?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240109
					]
				},
				{
					"id": 740240109,
					"content": "보석을 가공해서 다양하고 예쁜 장신구 같은 걸 만드는 작업이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240110
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240110,
					"content": "다만 당분간은 물감을 만드는 데 집중해야 해서 새로운 의뢰를 받을 수 없을 것 같아요. 물감도 보석으로 만드는 거긴 하지만요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240111
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240111,
					"content": "보, 보석으로 물감을 만든다고?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240112,
					"content": "응? 그게 왜요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240113
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240113,
					"content": "음, 아무리 생각해도 낭비 같은데… 보석이 필요 없는 거면 그냥 나 줘도 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240114,
					"content": "그나저나 물감은 왜 만드는 거야? 보석으로 장신구를 만드는 과정에 필요한 건 아닐 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240115,
					"content": "그림을 좋아하는 어떤 아이가 절 찾아와서, 보석처럼 반짝이고 태양처럼 빛나는 물감을 만들 수 있냐고 물어본 적이 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240116
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240116,
					"content": "그리고 얼마 전 마을 전체가 심하게 흔들렸던 적이 있는데, 그때 제 여동생을 구해준 게 바로 그 아이였죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240117
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240117,
					"content": "그래서 전 그 아이의 소원을 이뤄주고 싶어요. 「태양처럼 찬란하게 반짝이는 물감」을 만들어서 그 아이에게 답례로 줄 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240118
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240118,
					"content": "그 아이란 게 혹시…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240119
					]
				},
				{
					"id": 740240119,
					"content": "…저기, 네가 말한 「그림을 좋아하는 아이」 말인데, 설마 마메흐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240120,
					"content": "…? 맞아요… 마메흐랑 아는 사이세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240121
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240121,
					"content": "슬루아시에게 마메흐와 있었던 일을 이야기해 준다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240122
					]
				},
				{
					"id": 740240122,
					"content": "#서, 설마 마메흐랑 같이 푸카를 구해주신 {NICKNAME} 님과 페이몬 님이세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240123
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240123,
					"content": "#{NICKNAME} 님과 페이몬 님…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240124,
						740240125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240124,
					"content": "응, 맞아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				},
				{
					"id": 740240126,
					"content": "두 분, 정말 너무 감사합니다…! 만약 두 분이 아니었다면, 푸카는 아마도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240127
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240127,
					"content": "괜찮으시다면, 이걸 받아주세요…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240128,
						740240130
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240128,
					"content": "(아름다운 보석이네…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240129
					]
				},
				{
					"id": 740240129,
					"content": "#받아도 되는 걸까, {NICKNAME}? 엄청 비싸 보이는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240131,
					"content": "근데 그 마메흐가 다른 사람에게 부탁을 할 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240132
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240132,
					"content": "부탁이라고 하긴 좀 그래요. 마메흐는 제게 그런 걸 만들 수 있냐고 물어봤을 뿐이거든요. 근데 제가 대답도 하기 전에 도망가 버렸어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240133
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240133,
					"content": "마메흐다운 행동이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240134
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240134,
					"content": "#말이 나와서 말인데요, {NICKNAME} 님과 페이몬 님…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240135
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240135,
					"content": "두 분은 「태양색에 가장 가까운 것」이 뭐라고 생각하세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240136
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240136,
					"content": "태양의 모습을 열심히 관찰해 봤지만, 어떤 재료를 써야 태양색을 재현할 수 있을지 잘 모르겠어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240137
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240137,
					"content": "흐음, 「태양색에 가까운 것」이라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240138,
						740240141,
						740240145
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240138,
					"content": "…황금?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240139
					]
				},
				{
					"id": 740240139,
					"content": "아, 카노틸라가 전에 「황금은 태양이 흘린 눈물이다」 같은 말을 했어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240140
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240140,
					"content": "근데 황금으로 물감을 만드는 건 너무 사치스럽지 않아? 대체할 만한 평범한 재료가 있을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240148,
					"content": "「태양색에 가까운 것」이라면 분명 본 적이 있을 텐데. 그것도 엄청 흔히 보이는 물건일 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240141,
					"content": "…태양?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240142
					]
				},
				{
					"id": 740240142,
					"content": "#…역시 {NICKNAME} 님이시군요. 태양색에 가까운 것이라면 역시 태양 그 자체겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240143
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240143,
					"content": "태양을 갈아서 가루로 만들려면 어떻게 해야 할까요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240144
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240144,
					"content": "이봐, 그렇게 진지하게 엉뚱한 소리 하지 말라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240145,
					"content": "어쩔 수 없지. 그럼 내 머리카락으로…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240146
					]
				},
				{
					"id": 740240146,
					"content": "…네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240147
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240147,
					"content": "머리카락으로는 물감을 못 만들지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "페이몬"
				},
				{
