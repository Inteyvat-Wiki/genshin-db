			"dialogs": [
				{
					"id": 740240315,
					"content": "관찰을 마친 슬루아시가 재료를 돌려준다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240301
					]
				},
				{
					"id": 740240301,
					"content": "아무튼 도와주셔서 정말 감사합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240302
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240302,
					"content": "#그래도 {NICKNAME} 님의 물건을 제가 마음대로 가져갈 수는 없죠. 재료의 이름만 알려주시면 제가 알아서 찾아볼게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240303
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240303,
					"content": "다만 색깔이 너무 진한 거 아닐까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240304
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240304,
					"content": "「태양의 색」은 이보다 조금 더 연할 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240305
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240305,
					"content": "연하다는 건 하얗다는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240306,
					"content": "듣고 보니 「태양」은 「금색」보단 「흰색」에 더 가까운 것 같은걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240307,
					"content": "「흰색」… 그런가요? 그치만 어떤 재료를 써야 더 연한 색채를 낼 수 있을지 모르겠어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240308,
						740240311
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240308,
					"content": "물을 섞는 건 어때?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240309
					]
				},
				{
					"id": 740240309,
					"content": "물은… 전에도 해봤는데 결과물이 그리 좋지 않았어요. 물감이 흐릿한 게 태양같이 밝은 느낌이 나지 않았죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240310
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240310,
					"content": "그래서 가능하면 다른 재료를 섞고 싶어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "슬루아시"
				},
				{
					"id": 740240314,
					"content": "밝고 하얀 거라면 평소에도 자주 봤을 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240311,
					"content": "그럼 페이몬 머리카락은 어때?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240312
					]
				},
				{
					"id": 740240312,
					"content": "머리카락으로는 물감을 만들 수 없거든!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740240313,
					"content": "아니지, 설령 만들 수 있다고 해도 마음대로 뽑으면 안 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "페이몬"
				}
			]
		},
