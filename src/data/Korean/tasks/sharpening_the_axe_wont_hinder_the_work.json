			"dialogs": [
				{
					"id": 205030201,
					"content": "무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030202,
						205030204
					],
					"speakerTitle": "바그너"
				},
				{
					"id": 205030202,
					"content": "무기를 보러 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030203
					]
				},
				{
					"id": 205030203,
					"content": "저기에 있으니까 직접 골라봐. 다른 게 필요하다면 만들어 줄 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "바그너"
				},
				{
					"id": 205030207,
					"content": "맞춤 제작도 할 수 있었나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 205030208,
					"content": "당연하지. 판매, 맞춤 제작, 재련 등은 모두 대장간이 하는 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030209
					],
					"speakerTitle": "바그너"
				},
				{
					"id": 205030209,
					"content": "나한테 광석만 가져다주면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030210,
						205030212
					],
					"speakerTitle": "바그너"
				},
				{
					"id": 205030210,
					"content": "어디서 광석을 찾을 수 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030211
					]
				},
				{
					"id": 205030211,
					"content": "어디든지 다 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "바그너"
				},
				{
					"id": 205030214,
					"content": "그럼 이렇게 하지. 어리바리해 보이는데 주변에 철광이 많은 곳을 내가 알려주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030215
					],
					"speakerTitle": "바그너"
				},
				{
					"id": 205030215,
					"content": "철광만 가져와. 내가 단조해 줄 테니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030216
					],
					"speakerTitle": "바그너"
				},
				{
					"id": 205030216,
					"content": "네, 고마워요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030217
					]
				},
				{
					"id": 205030217,
					"content": "감사는 됐고, 난 그럼 일하러 가마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바그너"
				},
				{
					"id": 205030212,
					"content": "여기서 살 수 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030213
					]
				},
				{
					"id": 205030213,
					"content": "다른데 가서 알아봐, 광석은 나도 모자라니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "바그너"
				},
				{
					"id": 205030204,
					"content": "페이몬 무기를 봐주고 싶어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030205
					]
				},
				{
					"id": 205030205,
					"content": "무슨 소리야! 싸울 때 나부터 앞장세우겠다는 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 205030206,
					"content": "쪼그마한 녀석이군, 음, 맞춤 제작해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "바그너"
				}
			]
