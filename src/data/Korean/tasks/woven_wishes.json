				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120050101,
					"content": "음? 이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050102
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050102,
					"content": "축제 광고인가 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120050103,
					"content": "그러고 보니까 우리 이나즈마에서 이런 시끌벅적한 장소는 안 가본 것 같네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120050104,
					"content": "아야카, 축제에 가고 싶어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050105
					]
				},
				{
					"id": 120050105,
					"content": "아, 아니에요! 흠흠… 제 말은 이나즈마에서 축제는 아주 흔해서 야시로 봉행은 이미 이런 풍습에 익숙해졌다는 말이었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050106
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050106,
					"content": "이나즈마 주민들은 절기마다 축제에 참여하는데, 그때마다 치안을 유지하기도 어려워지죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050107
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050107,
					"content": "그래서 축제는 신나긴 하지만, 저희한텐 근심거리이기도 하답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050108
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050108,
					"content": "아! 일 생각 하다가 다른 쪽으로 새 버렸네요… 죄송해요. 제가 가려던 곳은 바로 옆에 이 가게예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050109
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050109,
					"content": "이 간판을 보러 온 게 아니었구나. 그럼 가게 안으로 들어가 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120050110,
					"content": "최신 유행 스타일입니다. 한번 보세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050111
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120050111,
					"content": "아, 카미사토 아가씨와 이방에서 온 손님들이시군요! 어서 오세요. 원단 사러 오셨나요 아니면 옷을 제작하러 오셨나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050112
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120050112,
					"content": "안녕하세요, 의상 설계도를 가져왔는데 좀 봐주시겠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050113
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050113,
					"content": "오오! 미리 준비해둔 설계도를 꺼냈어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120050114,
					"content": "한번 볼게요… 음? 이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050115
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120050115,
					"content": "어떤가요, 이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050116
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050116,
					"content": "아주 멋진 디자인인데요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050117
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120050117,
					"content": "카미사토 씨는 이런 기모노를 주문하고 싶으신 거죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050118
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120050118,
					"content": "네, 부탁드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050119
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050119,
					"content": "아가씨가 저희 가게에서 옷을 주문하신다니 정말 영광이지만… 문제가 조금 있어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050120
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120050120,
					"content": "이런 기모노를 만들려면 예상꽃으로 만든 비단이 필요하답니다. 이나즈마는 대부분의 비단을 리월에서 수입해오지만 지금은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050121
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120050121,
					"content": "어휴, 아시다시피 이나즈마는 지금 쇄국 상태잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050122
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120050122,
					"content": "솔직히 의류 업계에 타격이 엄청난 상황이에요. 고급 원단을 들여오기가 힘들어서 옷의 주문 제작도 한동안 미뤄두고 있구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050123
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120050123,
					"content": "하지만 손님이 원단을 직접 준비해 오신다면 옷은 얼마든지 만들어 드릴 수 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050124
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120050124,
					"content": "우리가 직접 가서 천을 사 오는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120050125,
					"content": "오구라의 가게에서도 구하지 못한 고급 원단을… 어디서 구할 수 있을까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050126
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050126,
					"content": "만국 상회에 한번 가보세요. 그들은 대륙 각지에서 온 상인들이라 저희보다 더 많은 루트를 알고 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050127
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120050127,
					"content": "그만큼 가격이 비싸긴 하겠지만, 이런 시기에 원하는 물건을 살 수 있는 것만으로도 나쁘지 않다고 생각해요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050128
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120050128,
					"content": "이나즈마에선 옷 맞추는 것도 이렇게 복잡해져 버리다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120050129,
					"content": "그나저나 만국 상회는 쿠리스가 있는 곳이었지? 이도(離島)에 안 간 지도 엄청 오래됐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120050130,
					"content": "음… 만국 상회에 한번 가봐야겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050131
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050131,
					"content": "정말 감사해요, 원단을 사서 다시 올게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050132
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050132,
					"content": "그전에 부탁이 하나 더 있는데, 혹시…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050133
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050133,
					"content": "아야카, 소곤소곤 무슨 얘기를 하는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050134
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120050134,
					"content": "음, 음… 네, 문제없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050135
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120050135,
