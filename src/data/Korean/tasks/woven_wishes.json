						120050204
					],
					"speakerTitle": "쿠리스"
				},
				{
					"id": 120050204,
					"content": "쿠리스 씨, 괜찮으세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050205
					],
					"speakerTitle": "카미사토 아야카"
