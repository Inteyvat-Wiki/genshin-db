			"dialogs": [
				{
					"id": 120050401,
					"content": "해결했다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120050402,
					"content": "…하아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050403,
						120050404
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050403,
					"content": "역시 아야카야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050405
					]
				},
				{
					"id": 120050405,
					"content": "아니에요… 제가 해야 할 일을 한 것뿐인데, 과찬입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050406
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050406,
					"content": "아야카 아가씨, 여행자. 다들 괜찮으세요?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050407
					],
					"speakerTitle": "쿠리스"
				},
				{
					"id": 120050407,
					"content": "저희 모두 괜찮으니 걱정 마세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050408
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050408,
					"content": "그 낭인들은 급하게 도망치느라 아무것도 못 챙겨 갔을 거예요. 쿠리스 씨의 물건은 아마 다 여기 있을 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050409
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050409,
					"content": "감사합니다, 정말 감사합니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050410
					],
					"speakerTitle": "쿠리스"
				},
				{
					"id": 120050410,
					"content": "확인해보세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050411
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050411,
					"content": "여섯, 여덟, 열…. 맞아요, 다 여기 있네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050412
					],
					"speakerTitle": "쿠리스"
				},
				{
					"id": 120050412,
					"content": "잘됐다! 그럼 우리 빨리 비단 사자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120050413,
					"content": "비단을 사신다고요? 혹시 이 물건들이 필요했던 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050414
					],
					"speakerTitle": "쿠리스"
				},
				{
					"id": 120050414,
					"content": "솔직히 말씀드리면, 맞아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050415
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050415,
					"content": "오해하지 마, 그것 때문에 도운 건 아니니까! 네가 잃어버린 게 당근이나 양배추였어도 널 도왔을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050416
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120050416,
					"content": "우리 운이 정말 좋았네. 한 발만 늦었으면 비단을 못 구했을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050417
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120050417,
					"content": "이 감사함을 어떻게 표현해야 할지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050418
					],
					"speakerTitle": "쿠리스"
				},
				{
					"id": 120050418,
					"content": "비단이 필요하신 거죠? 제가 골라 드리겠습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050419
					],
					"speakerTitle": "쿠리스"
				},
				{
					"id": 120050419,
					"content": "감사합니다, 얼마죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050420
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050420,
					"content": "제가 어떻게 은인한테 돈을 받겠습니까! 제가 아가씨께 드리는 선물입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050421
					],
					"speakerTitle": "쿠리스"
				},
				{
					"id": 120050421,
					"content": "아니에요, 정해진 값은 확실히 지불해야죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050422
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050422,
					"content": "상인은 상인만의 고충이 있을 거고, 페이몬님의 말처럼 쿠리스 씨를 도운 건 절대 제 이익 때문이 아니에요. 그러니까 물건을 정상 가격으로 제게 팔아주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050423
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050423,
					"content": "곤란해하실 거 없어요. 오늘 이 숲에선 아무 일도 일어나지 않았잖아요, 그렇죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050424
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050424,
					"content": "맞아요, 우린 산책하러 온 거죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050425
					]
				},
				{
					"id": 120050425,
					"content": "이, 이걸 어떻게 보답해야 할지, 정말 감사합니다! 이 은혜 절대 잊지 않을게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050426
					],
					"speakerTitle": "쿠리스"
				},
				{
					"id": 120050426,
					"content": "전 물건을 다시 상회로 돌려보내야 돼서 먼저 실례하겠습니다. 앞으로 필요하신 게 있다면 언제든 만국 상회에서 저 쿠리스를 찾아주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050427
					],
					"speakerTitle": "쿠리스"
				},
				{
					"id": 120050427,
					"content": "네, 비단 감사해요. 쿠리스 씨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050428
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050428,
					"content": "조심히 가——! 가는 길에 또 뺏기지 말고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050429
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120050429,
					"content": "여행자님, 도와주셔서 감사해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050430,
						120050431
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050430,
					"content": "약속한 거잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050432
					]
				},
				{
					"id": 120050432,
					"content": "근데 그 낭인들 꼭 널 모르는 것 같던데, 카미사토가의 장녀를 만날 신분이 안 돼서 그런가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050433
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120050433,
					"content": "그럴지도 모르죠. 어쨌든 저한텐 잘된 셈이에요. 이 일이 사람들에게 알려지는 건 싫거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050434
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050434,
					"content": "헤헤, 아야카처럼 대단한 사람이 직접 나서서 쿠리스를 도와주다니, 너 좋은 사람이구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050435
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120050435,
					"content": "앗… 너무 칭찬하지 마세요. 누구나 할 수 있는 일을 한 것뿐인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050436
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050436,
					"content": "제 입장상 쿠리스 씨를 돕는 건 적절치 않을 수도 있지만, 신분이나 계급과는 무관하게… 어려움에 처한 평범한 사람을 도운 것뿐이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050437
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050437,
					"content": "아마 제 마음 깊은 곳에선 사람들이 어려움을 겪어야 하는 사회는 「옳은」 사회가 아니라고 생각하기 때문이겠죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050438
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050438,
					"content": "아! 죄송해요, 쓸데없는 말을 했네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050439
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050439,
					"content": "괜찮아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050440
					]
				},
				{
					"id": 120050440,
					"content": "그럼 어서 어럽게 얻은 이 비단을 오구라의 가게로 갖고 갈까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050441
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050441,
					"content": "좋아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120050431,
					"content": "괜찮아, 별일 아닌걸",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050432
					]
				},
				{
					"id": 120050404,
					"content": "믿음직스러워!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120050405
					]
				}
			]
