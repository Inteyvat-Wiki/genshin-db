						120050226
					],
					"speakerTitle": "쿠리스"
				},
				{
					"id": 120050226,
					"content": "엥?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050227
					],
					"speakerTitle": "페이몬"
