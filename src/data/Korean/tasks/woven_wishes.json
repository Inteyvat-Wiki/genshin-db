				{
					"id": 120050902,
					"content": "돌아오셨군요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050903
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120050903,
					"content": "만국 상회엔 재고가 좀 있던가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050904
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120050904,
					"content": "네, 구했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120050905
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120050905,
					"content": "여기",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051001,
					"content": "다행이에요! 음, 비단 말고 나머지 재료는 아마 가게에 다 있을 거고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051002
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120051002,
					"content": "가서 재료를 확인해볼게요. 금방이면 되니까 여기서 조금만 기다리세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051003
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120051003,
					"content": "꼭 있어야 되는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051004
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120051004,
					"content": "이번엔 부족한 재료가 없으면 좋겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051005
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051005,
					"content": "사실 여행자님에게도 새 옷을 선물하고 싶다고 생각했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051006
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051007,
					"content": "고마워, 근데 난 이대로가 좋아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051008
					]
				},
				{
					"id": 120051006,
					"content": "하지만… 당신이 이나즈마 의상에 익숙하지 않을까 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051007
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051009,
					"content": "이 옷은 나한테 특별한 의미가 있거든",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051011
					]
				},
				{
					"id": 120051010,
					"content": "겉모습에 치중하다 보면 검이 무뎌질 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051011
					]
				},
				{
					"id": 120051008,
					"content": "네? 정말요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051009,
						120051010
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051011,
					"content": "그렇군요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051012
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051012,
					"content": "역시, 우수한 여행자는 모두 자신만의 규칙과 패션 철학을 가지고 있군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051013
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051013,
					"content": "밖에서 활동하다 보면 어쩔 수 없는 일들도 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051014
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120051015,
					"content": "그렇게 작은 사이즈는 없을걸?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051016
					]
				},
				{
					"id": 120051014,
					"content": "그치만 페이몬은 이나즈마 특유의 의상을 입어보고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051015
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120051016,
					"content": "뭐야, 만들려면 만들 수 있잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051017
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120051018,
					"content": "괜찮아, 아야카",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051020
					]
				},
				{
					"id": 120051019,
					"content": "나랑 페이몬은 이대로도 좋아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051020
					]
				},
				{
					"id": 120051017,
					"content": "하하, 두 분의 대화는 정말 귀엽네요…. 크흠! 아, 아니, 그러니까 페이몬 님이 원하시면 제가 옷 맞춰줄 사람을 찾아드리겠다는 말이었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051018,
						120051019
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051020,
					"content": "그렇군요… 그럼 여행자님 말씀대로 할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051021
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051022,
					"content": "특이한 옷차림이 아주 많아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051023
					]
				},
				{
					"id": 120051030,
					"content": "다들 개성에 맞게 잘 입어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051031
					]
				},
				{
					"id": 120051021,
					"content": "말이 나와서 말인데, 다른 나라 사람들은 어떤 스타일의 옷을 입나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051022,
						120051030
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051023,
					"content": "맞아, 별의별 스타일이 다 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051024
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120051024,
					"content": "후드를 둘러쓰거나, 반쪽 짜리 가면을 쓰거나, 공작새 같은 차림을 하거나, 아니면 배꼽이 드러나는 옷, 몸에 쫙 달라붙는 옷… 암튼 상상 이상이라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051025
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120051025,
					"content": "정말요? 기준도 없이, 그냥 취향 대로 옷을 입는다고요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051026
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051026,
					"content": "와, 좋네요…. 왜인지는 모르겠지만, 부러워요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051027
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051027,
					"content": "아야카도 이상한 옷을 입고 싶어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051028
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120051028,
					"content": "설마, 아니에요! 전 그냥… 마음 가는 대로 사는 사람들에게 감탄한 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051029
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051029,
					"content": "7개국을 돌아다니며 다른 사람들이 어떤 삶을 살고 있는지 보고 싶어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051038
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051031,
					"content": "맞아! 나라마다 각각의 특색을 가지고 있지. 우아하고, 고귀하고, 캐주얼하고… 모두 다르지만, 각자의 특색과 아주 잘 맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051032
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120051032,
					"content": "옷을 입는 건 아주 심오한 학문이라 저도 열심히 배우고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051033
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051033,
					"content": "분위기에 맞는 옷을 입어서 그걸 자신의 일부로 만드는 건… 아주 멋진 일 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051034
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051034,
					"content": "그래서 전 옷차림에 신경쓰는 걸 싫어하지 않는 편이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051035
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051035,
					"content": "알지 알지! 그렇다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051036
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120051036,
					"content": "페이몬 님은 귀여우니까 뭘 입으셔도 귀여울 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051037
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051037,
					"content": "우와——! 나 칭찬받은 거야!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051038
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120051038,
					"content": "오래 기다리셨죠? 확인 끝났습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051039
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120051039,
					"content": "수고하셨어요. 더 부족한 게 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051040
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051040,
					"content": "다행히 모든 재료가 다 있답니다! 사이즈는… 도면에 그려진 대로 할까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051041
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120051041,
					"content": "네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051042
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051042,
					"content": "예, 그럼 말씀하신 대로 만들어 드릴게요. 가격은 다 합쳐서… 이 정도예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051043
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120051043,
					"content": "여기요. 가능하면 최대한 빨리 부탁드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051044
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051044,
					"content": "다행히 요즘 급한 주문은 없어서 바로 시작할 수 있어요. 다만 옷은 만드는 데 시간이 좀 걸리니까, 조금 있다가 찾으러 오시면 될 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051045
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120051045,
					"content": "그때까지 좀 쉬다가 오셔요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051046
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120051046,
					"content": "좋은 생각이야. 우리 다른 곳에 가서 좀 둘러보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051047
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120051047,
					"content": "물론 그거라면 이미 생각해뒀어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051048
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051048,
					"content": "이제 두 분과 함께 식당에 가서 식사하면 될 것 같네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051049
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051050,
					"content": "마침 배고프던 참이었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120051051
					]
				},
				{
					"id": 120051049,
					"content": "우와와! 밥이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051050
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120051051,
					"content": "후후, 「키미나미 요정」이라고 하는 노점을 골라놨어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051052
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051052,
					"content": "너무 고급스러워서 불편한 식당보다는 자유로운 분위기의 식당이 오늘 일정에 더 맞다고 생각했거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051053
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051053,
					"content": "그럼 바로 갈까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120051054
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120051054,
					"content": "응, 배고파 죽겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
