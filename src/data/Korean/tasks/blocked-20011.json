			"dialogs": [
				{
					"id": 200110301,
					"content": "이제 지나갈 수 있겠다…. 고마워, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110302
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200110302,
					"content": "돈이 부족해서 안나의 병이 계속 낫질 않고 있어. 그래서 이 약초를 따러 여기에 자주 와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110303
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200110303,
					"content": "약초를 채집했지만 오늘 저놈들이 습격해올지 몰랐네. 그래도 네가 빨리 와줘서 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110304
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200110304,
					"content": "이거 받아. 난 이걸 자주 타서 안나에게 마시게 해. 그래야 기침이 좀 호전되거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110305
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200110305,
					"content": "넌 자주 밖에서 머무니까 몸 관리에 더 신경써야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "앤서니"
				}
			]
		}
