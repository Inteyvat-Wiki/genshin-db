			"dialogs": [
				{
					"id": 200110201,
					"content": "여행자, 고마워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110202
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200110202,
					"content": "하지만 아직 장애물이 있어서 못 지나가겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110203
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200110203,
					"content": "하하하, 스스로 해결할 수 있을 줄 알았는데…. 하지만 츄츄족을 몇 놈 먹으니 온몸이 아프네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110204
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200110204,
					"content": "그래도 괜찮아. 안나에게 주려고 딴 이 약초들이 아직 상하진 않았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110205
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200110205,
					"content": "미안, 이미 많은 폐를 끼쳤지만 그래도 이 장애물을 처리해줄 수 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110206,
						200110207
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200110206,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110208
					]
				},
				{
					"id": 200110208,
					"content": "고마워, 나 좀 쉬어야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200110207,
					"content": "급한 일이 있어서",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110209
					]
				},
				{
					"id": 200110209,
					"content": "안나가 아직 집에서 날 기다린단 말이야…. 좀 도와줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "앤서니"
				}
			]
		},
