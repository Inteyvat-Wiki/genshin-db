					}
				]
			},
			"dialogs": [
				{
					"id": 706890114,
					"content": "<color=#FFCC33FF>새로운 소식이라도 있나요?</color>",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890101
					]
				},
				{
					"id": 706890101,
					"content": "#{NICKNAME}, 마침 잘 왔어. 전해줄 게 있는데 잠깐 시간 괜찮아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890102,
						706890103
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 706890102,
					"content": "지원 요청인가요? 아니면 보물에 관한 단서?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890104
					]
				},
				{
					"id": 706890104,
					"content": "…역시 길드의 업무를 잘 아는구나. 하지만 아쉽게도, 이 물건은 그런 의뢰들과는 무관해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890105
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 706890105,
					"content": "자, 받아. 길드에서 만든 신형 노트야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890106,
						706890107
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 706890106,
					"content": "모험 핸드북이 있잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890108
					]
				},
				{
					"id": 706890108,
					"content": "모험 핸드북의 주요 역할은 모험가들의 의뢰 완료 상황과 마물에 관한 정보를 기록하는 거잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890109
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 706890109,
					"content": "그에 비해 이 노트는 모험에서 만난 사람과 사건들을 편하게 기록할 수 있도록 만들어졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890110,
						706890111
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 706890110,
					"content": "그렇군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890112
					]
				},
				{
					"id": 706890112,
					"content": "도움이 될 수 있어서 다행이야. 그럼 이걸로 이번 의뢰도 완료됐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706890113
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 706890113,
					"content": "계속해서 자유롭게 모험해 봐. 별과 심연을 향해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐서린"
				},
				{
					"id": 706890111,
					"content": "확실히 유용하겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890112
					]
				},
				{
					"id": 706890107,
					"content": "또 주는 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890108
					]
				},
				{
					"id": 706890103,
					"content": "호송 의뢰인가요? 아니면 사람을 찾는 의뢰?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706890104
					]
				}
			]
		},
