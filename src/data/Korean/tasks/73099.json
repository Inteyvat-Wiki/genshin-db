			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730990101,
					"content": "와, 아란나라의 세계는 정말 신기한 것 같아… 그림만 봐도 보물을 찾을 수 있다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990102,
					"content": "이제 모든 그림에 맞는 장소를 찾은 거지! 이 보물지도를 그린 아란나라는 지금 어디 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990103,
						730990104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990103,
					"content": "전부는 아니야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990105
					]
				},
				{
					"id": 730990105,
					"content": "그래. 그러고 보니까 여러 아란나라들이 함께 있는 그림이랑 맞는 보물을 못 찾았네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990106,
					"content": "(배낭에 들어있는 뭔가가 약하게 진동한다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990107,
					"content": "(진동하는 물품 찾기)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990108
					]
				},
				{
					"id": 730990108,
					"content": "응? 이건… 층암거연 지하에서 찾은 씨앗이잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990109,
						730990111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990109,
					"content": "길을 안내해 주는 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990110
					]
				},
				{
					"id": 730990110,
					"content": "그래… 그런 건지도 몰라! 씨앗이 다시 진동하면 잘 살펴보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990113,
					"content": "「위험에 처한 아란나라」가 있을지도 몰라! 아니면 「아란나라의 보물창고」라든가… 설마 씨앗이 열쇠인 건 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990111,
					"content": "이상하네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990112
					]
				},
				{
					"id": 730990112,
					"content": "음… 씨앗이 어딘가를 가고 싶은 것 같아! 다음에 씨앗이 또 진동하면 잘 살펴보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990104,
					"content": "아직 한 곳이 남았어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990105
					]
				}
			]
		},
