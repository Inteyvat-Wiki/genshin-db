			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7309905",
							"2"
						],
						"stepId": 7309905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아란미나리",
					"페이몬",
					"아란님바"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730990301,
					"content": "아! 금빛의 나라! 바람 냄새, 흙 냄새 그리고 아란나라 냄새!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990302
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990302,
					"content": "금빛의 나라, 너도 아란야마의 아란라칼라리를 해제한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990303
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990303,
					"content": "무서워, 너무 무서워! 이제 장애물도 아무 소용이 없는 거야! 이제 아무나 들어올 수 있을 거야! 아란미나리의 「아늑한 집」이 「짓밟힐」 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990304
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990304,
					"content": "진정해. 우린 아무런 악의가 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990305,
					"content": "「악의」가 없다는 게 무슨 뜻인데? 「탐욕스럽지」 않다는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990306
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990306,
					"content": "#음… 그렇다고 할 수 있어! 나랑 {NICKNAME}은(는) 아란나라 편이야. 우린 아란나라의 친구가 되고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990307,
					"content": "페이몬은 식탐이 많긴 하지만 나쁜 사람은 아니야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990308
					]
				},
				{
					"id": 730990308,
					"content": "야! 식탐이 많은 건 맞지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990309,
					"content": "아란나라의 친구… 금빛의 나라에게서 아란나라의 냄새가 느껴져. 익숙하지만 아주 오랫동안 느끼지 못했던 냄새가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990310
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990310,
					"content": "#아, 참! 그 이상한 씨앗! {NICKNAME}, 어서 그 씨앗을 아란미나리한테 보여줘. 뭔가 알고 있을지도 모르잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990311,
					"content": "음! 목말라! 걔는 물을 마셔야 원래 모습으로 돌아갈 수 있어… 빨리, 여기 물 많아. 물을 마시게 해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990312
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990312,
					"content": "씨앗을 물에 넣는다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730990313
					]
				},
				{
					"id": 730990313,
					"content": "…피융! 돌아왔다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990314
					],
					"speakerTitle": "아란님바"
				},
				{
					"id": 730990314,
					"content": "#와! 씨앗이 아란나라로 변했어! 정말 「위험에 처한 아란나라」가 있었던 거야. 봐, 내 말 맞지, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990315,
						730990316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990315,
					"content": "정말 「위험에 처한 아란나라」가 있었다니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990317
					]
				},
				{
					"id": 730990317,
					"content": "아란님바다! 아란미나리랑은 다르게 아란님바는 여기저기 여행 다니는걸 걸 좋아해. 예전에는 밖에서 본 풍경을 그림으로 그려 바나라나에 보내곤 했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990318
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990318,
					"content": "그러다 아주 단단하고 어두운 곳에 도착했어. 흙은 별로 없고 돌멩이들이 가득한 곳… 풀도 나무도 얼마 없는데, 버섯만 가득 자란 곳이었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990319
					],
					"speakerTitle": "아란님바"
				},
				{
					"id": 730990319,
					"content": "음… 층암거연을 말하는 것 같네. 그런데 아란님바, 아란나라가 그렇게 멀리 갈 수도 있는 거야? 수메르를 벗어나기까지 하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990320
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990320,
					"content": "맞아! 아주 멀고도 험한 여정이었어. 게다가 검은색 나라까지 만나고 아주 위험했지! 하지만 아란님바는 아란무후쿤다의 가호를 받아 씨앗으로 변했고 「위기에서 벗어날 수」 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990321
					],
					"speakerTitle": "아란님바"
				},
				{
					"id": 730990321,
					"content": "금빛의 나라와 하얀 둥실이 덕분에 아란님바가 다시 돌아올 수 있었던 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990322
					],
					"speakerTitle": "아란님바"
				},
				{
					"id": 730990322,
					"content": "#{NICKNAME}(이)랑 페이몬이거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990323,
					"content": "#맞아. 나라{NICKNAME}와(과) 페이몬은 아란나라의 좋은 친구야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990324
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990324,
					"content": "#아란미나리는 아란님바의 「좋은 친구」니까 나라{NICKNAME}와(과) 페이몬도 역시 아란님바의 「좋은 친구」인 거지. 음, 알겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990325
					],
					"speakerTitle": "아란님바"
				},
				{
					"id": 730990325,
					"content": "아란님바는 이제 곧 떠날 거야. 이번에는 그림 말고 「선물」도 「보물상자」에 담아 아란미나리한테 보낼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990326
					],
					"speakerTitle": "아란님바"
				},
				{
					"id": 730990326,
					"content": "이 「보물상자」는 전부 아란미나리 거야. 아란미나리가 바로 「보물상자」의 주인이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990327
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990327,
					"content": "만약 두 사람이 정말 아란나라의 좋은 친구라면 정말 많은 아란나라들을 도와줬다면… 아란나라는 「은혜를 갚을 줄 아는 존재」니까 「보물」을 「상자」에 넣어줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990328
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990328,
					"content": "빈 상자였어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990329
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990329,
					"content": "아란나라는 태어날 때부터 이미 바나에 대한 모든 지식을 알고 있어. 하지만 「상자」는 생겨날 때부터 텅 비어있었지! 그 이유는 아란미나리도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990330
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990330,
					"content": "페이몬도 잘 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990331
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990331,
					"content": "#아란미나리가 보물을 넣고 나서 나라{NICKNAME}(이)가 「보물상자」를 열면 초록색 나라처럼 가끔씩 「좋아!」라고 하거나 「휴…」하고 한숨을 쉬게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990332
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990332,
					"content": "왜 굳이 그렇게 하는 거야? 아란미나리도 아란님바도 지금 바로 보물상자에 넣을 물건을 보수로 주면 되잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990333
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990333,
					"content": "#아란미나리가 알기론 초록색 나라는 동굴이나 집 안으로 들어가서 「보물상자」 여는 걸 좋아하던데. 나라{NICKNAME}(이)랑 페이몬은 싫어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990334
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990334,
					"content": "아… 싫지는 않아… 왠지… 끌리는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990335
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990335,
					"content": "그래. 나라도 아란미나리도 「보물상자」가 좋아. 그러니까 아란나라의 친구인 나라에게 「보물상자」를 열 자격을 주는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990336
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990336,
					"content": "바나에는 아란나라가 아주 많이 살고 있어. 도움을 필요로 하는 아란나라도 있고 나라와 놀고 싶어하는 아란나라도 있지 아란나라들의 소원을 이뤄주는 나라야말로 진짜 아란나라의 친구야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990337
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990337,
					"content": "이런 나라만이 아란미나리가 준비한 「보물상자」를 열 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990338
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990338,
					"content": "「보물상자」를 가득 채우기 위해서 아란님바는 지금 바로 떠나야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990339
					],
					"speakerTitle": "아란님바"
				},
				{
					"id": 730990339,
					"content": "뭐? 아란님바는 돌아온 지 얼마 되지도 않았잖아? 이렇게 빨리 떠난다고? 정말 바쁘네… 발등에 불이라도 떨어진 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990340
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990340,
					"content": "윽! 바람은 좋지만 불은 싫어! 불을 가까이 하면 아란님바는 목이 마르거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990341
					],
					"speakerTitle": "아란님바"
				},
				{
					"id": 730990341,
					"content": "아, 그러니까 내 말은 왜 그렇게 급하게 떠나냐는 뜻이야. 아란미나리와 회포도 풀고 그러면 좋잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990342
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990342,
					"content": "아란미나리도 아란님바를 오랜만에 만난 건데 할 말이 많지 않겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990343
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990343,
					"content": "아란님바는 멈추지 않는 아란나라야. 그래서 「보물상자」의 주인이 될 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990344
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990344,
					"content": "아란님바가 여기저기를 돌아다니며 얻은 소식을 바나가, 바람이 꽃과 풀이 알게 된다면 아란미나리도 알 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990345
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990345,
					"content": "그러니까 굳이 말로 하지 않아도 괜찮아. 아란님바가 말하고 싶을 때 아란미나리도 들을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990346
					],
					"speakerTitle": "아란미나리"
				},
				{
					"id": 730990346,
					"content": "#음… 이게 바로 아란나라들의 우정인가? 나라면 {NICKNAME}와(과) 공유하고 싶은 게 정말 많을 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730990316,
					"content": "너 괜찮니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990317
					]
				}
			]
		},
