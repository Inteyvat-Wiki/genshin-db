			},
			"dialogs": [
				{
					"id": 120370401,
					"content": "음? 신의 눈이 없군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370402
					],
					"speakerTitle": "카고츠루베 잇신"
				},
				{
					"id": 120370402,
					"content": "사람을 잘못 봤군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370403
					],
					"speakerTitle": "카고츠루베 잇신"
				},
				{
					"id": 120370403,
					"content": "제대로 확인하고 공격을 했어야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120370404,
					"content": "아니… 누굴 찾든 갑자기 다른 사람을 공격하는 건 위험하다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120370405,
					"content": "너희들, 카에데하라 카즈하라는 사람을 본 적 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370406
					],
					"speakerTitle": "카고츠루베 잇신"
				},
				{
					"id": 120370406,
					"content": "너처럼 한손검을 쓰고, 듣자 하니 바람 원소 신의 눈을 가지고 있다고 하더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370407
					],
					"speakerTitle": "카고츠루베 잇신"
				},
				{
					"id": 120370407,
					"content": "그 사람은 왜 찾는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370408
					]
				},
				{
					"id": 120370408,
					"content": "너와는 상관없다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370409
					],
					"speakerTitle": "카고츠루베 잇신"
				},
				{
					"id": 120370409,
					"content": "모르나 보네. 시간 낭비했군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370410
					],
					"speakerTitle": "카고츠루베 잇신"
				},
				{
					"id": 120370410,
					"content": "저 사람 대체 뭐야! 밑도 끝도 없이 이상한 칼을 휘두르고 말이야! 게다가 사과 한마디 없다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120370411,
					"content": "저런 사람한테 함부로 카즈하 정보를 알려줄 리가 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370412,
						120370414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120370412,
					"content": "맞아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370413
					]
				},
				{
					"id": 120370413,
					"content": "그렇지? 정정당당한 대결이라 해도 카즈하를 못 이길 것 같긴 하지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120370416,
					"content": "그래도 혹시 모르니 카즈하에게 조심하라고 미리 알려주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370417
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120370417,
					"content": "지금 든 생각인데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370418
					]
				},
				{
					"id": 120370418,
					"content": "음? 무슨 생각?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370419
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120370419,
					"content": "저 사람 카즈하랑 특별한 관계일 수도 있는 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370420
					]
				},
				{
					"id": 120370420,
					"content": "특별한 관계? 그러니까 저 사람이 카즈하랑 아는 사이라는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370421,
						120370422
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120370421,
					"content": "정확하지는 않지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370423,
					"content": "맞아, 그런 것 같았어. 하지만 검술만 보면 다들 비슷하잖아. 그것만으로는 아무것도 설명할 수 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370424
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120370424,
					"content": "일단 위험한 일이 생기기 전에 카즈하한테 가서 미리 알려주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370425
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120370425,
					"content": "「남십자」 함대가 최근에 이도(離島)에서 화물을 보충한다고 들었어. 카즈하도 그곳에 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120370422,
					"content": "저 사람의 검술이 카즈하랑 비슷했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370414,
					"content": "오랜만에 좀 똑똑했네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370415
					]
				},
				{
					"id": 120370415,
					"content": "뭐야, 그 기분 나쁜 말은! 난 항상 똑똑했단 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
