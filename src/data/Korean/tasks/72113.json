			},
			"dialogs": [
				{
					"id": 721130101,
					"content": "점괘 뽑을 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130102
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721130102,
					"content": "으으, 너무 차가워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130103,
					"content": "점괘를 뽑고 싶어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130104
					]
				},
				{
					"id": 721130104,
					"content": "그래. 점괘를 뽑으려면 먼저 이걸 세게 흔들어야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130105
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721130105,
					"content": "이건 「점괘 뽑기 함」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130106
					]
				},
				{
					"id": 721130106,
					"content": "맞아, 안에서 죽첨 하나가 떨어질 거야. 그 죽첨을 나한테 주면 내가 그에 맞는 종이쪽지를 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130107
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721130107,
					"content": "이걸 「점괘」라고 불렀던 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130108
					]
				},
				{
					"id": 721130108,
					"content": "그런 건 뭐 아무래도 상관없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130109
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721130109,
					"content": "난 상관 있어! 만약에 우리가 뽑은 게 흉첨이면 어떡해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130110,
					"content": "운명이 네게 흉첨을 준 건데 네가 뭘 어쩔 수 있겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130111
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721130111,
					"content": "뭐야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130112,
					"content": "밖에 저 선반 같은 물건은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130113
					]
				},
				{
					"id": 721130113,
					"content": "쳇",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130114
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721130114,
					"content": "아주 대놓고 「쳇」이라고 했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130115,
					"content": "어디 보자… 그러니까 이런 거야. 「흉첨을 『점괘 걸이』에 걸면, 흉한 일을 막을 수 있다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130116
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721130116,
					"content": "아, 맞다! 만약 흉첨을 뽑으면, 그걸 저기에 묶어 놓으면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130117
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721130117,
					"content": "그들은… 아니, 우리 「나루카미 다이샤」는 아주 친절해서, 흉첨을 뽑아도 그 운을 바꿀 수 있는 기회를 주거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130118
					],
					"speakerTitle": "겐도우 링고"
				},
				{
					"id": 721130118,
					"content": "뭔가 좀 이상한 것 같긴 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130119,
					"content": "#{NICKNAME}, 우리도 뽑아보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
