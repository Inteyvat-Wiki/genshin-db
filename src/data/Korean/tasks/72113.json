					"nextDialogs": [
						721130808
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130808,
					"content": "이곳에 와서 다음 지시를 받으라는 것 같은데…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130809
