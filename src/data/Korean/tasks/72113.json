			"dialogs": [
				{
					"id": 721130601,
					"content": "엥? 이게 뭐지? 누군가의 수첩인 것 같은데, 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130602,
					"content": "「…종말… 우인단… 음모…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130603
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130603,
					"content": "이건 뭐야, 온통 얼룩져서 엉망진창이야. 하나도 안 보여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130604,
					"content": "보물의 단서 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130605
					]
				},
				{
					"id": 721130605,
					"content": "일리 있어! 다시 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130606,
					"content": "「…점괘 풀이… 암호…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130607,
						721130608
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130607,
					"content": "점괘 풀이?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130609
					]
				},
				{
					"id": 721130609,
					"content": "봐봐… 「…앞부분은 『어스름한 밤중』…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130610
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130610,
					"content": "여기까지 나오고 끊어졌어, 뒷부분은 뭔지 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130611
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130611,
					"content": "하지만 암호까지 쓴 걸 보면, 배후에 뭔가 비밀이 숨겨져 있는 거겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130612
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130612,
					"content": "되게 신경 쓰이네. 다음에 나루카미 다이샤에 점괘 풀이를 하러 갈 때, 한번 맞춰 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130608,
					"content": "암호?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130609
					]
				}
			]
		},
