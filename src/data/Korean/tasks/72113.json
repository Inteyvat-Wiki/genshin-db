			"dialogs": [
				{
					"id": 721130201,
					"content": "보자 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130202,
					"content": "와! 「대길」이라고 쓰여 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130203,
					"content": "오늘은 페이몬의 럭키데이인가 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130204,
					"content": "너의?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130205
					]
				},
				{
					"id": 721130205,
					"content": "그래! 너의 행복은 나 페이몬의 행복이잖아! 그러니까 반대로 말하면, 페이몬의 행복은 너의 행복이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130206,
					"content": "나는 맛있는 걸 먹으면 행복하다구. 그러니 네 자신의 행복을 위해서, 나한테 맛있는 것 좀 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
