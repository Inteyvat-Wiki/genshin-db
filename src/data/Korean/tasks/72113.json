			"dialogs": [
				{
					"id": 721130401,
					"content": "어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130402,
					"content": "윽, 「흉」이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130403,
					"content": "나 이 상황 기억해! 「흉첨을 뽑았다면 『점괘 걸이』에 걸어라」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130404,
					"content": "「그리고 페이몬에게 맛있는 것을 주면 전화위복이 된다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130405,
					"content": "그랬나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130406
					]
				},
				{
					"id": 721130406,
					"content": "당연하지! 선조의 지혜를 의심하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721130407,
					"content": "선조의 지혜는 정말 대단하다구! 아무튼, 일단 점괘 걸이를 찾아보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
