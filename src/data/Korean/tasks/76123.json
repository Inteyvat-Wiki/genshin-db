			"dialogs": [
				{
					"id": 761230101,
					"content": "맛있는 냄새가 나. 또 콜롬비나의 식사 시간인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230102,
					"content": "월령들이… 줄을 서 있어. 콜롬비나가 국을 뜨고 있잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230103,
					"content": "잠깐만 기다려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230104
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230104,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230105
					],
					"speakerTitle": "월령"
				},
				{
					"id": 761230105,
					"content": "와, 이거 엄청 맛있다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230106,
					"content": "상쾌하고 달콤한 과일 수프네. 다른 곳에서 먹어본 적 없는 맛이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230107,
					"content": "한 그릇 더 할래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230108
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230108,
					"content": "두 그릇 더!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230109,
					"content": "……!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230110
					],
					"speakerTitle": "루오노타르"
				},
				{
					"id": 761230110,
					"content": "요즘 요리를 배우고 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230111
					]
				},
				{
					"id": 761230111,
					"content": "응. 이네파한테 기본 레시피를 배워와서 몇 번 해봤는데, 월령이랑 동물들 반응이 꽤 괜찮았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230112
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230112,
					"content": "어려운 점은 없어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230113
					]
				},
				{
					"id": 761230113,
					"content": "음, 소매가 너무 넓어서, 실수로 냄비에 닿을 것 같긴 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230114
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230114,
					"content": "(요리 자체는 어렵지 않은가 보네)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230115
					]
				},
				{
					"id": 761230115,
					"content": "그리고, 디저트 같은 음식은 만들기 좀 까다롭더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230116
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230116,
					"content": "온도랑 비율을 엄청 세심하게 맞춰야 하더라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230117
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230117,
					"content": "(예전에는 직접 요리를 해먹는 일이 별로 없었던 것 같네)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230118
					]
				},
				{
					"id": 761230118,
					"content": "(확실히 디저트는 혼자 배워서 만들긴 쉽지 않지…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230119
					]
				},
				{
					"id": 761230119,
					"content": "내가 도와줄까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230120
					]
				},
				{
					"id": 761230120,
					"content": "좋아. 그럼 크룸카케부터 만들자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230121
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230121,
					"content": "약간의 시간이 흐른 뒤…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230122
					]
				},
				{
					"id": 761230122,
					"content": "먹어볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230123,
						761230124
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230123,
					"content": "(작게 한입 베어 문다)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230125
					]
				},
				{
					"id": 761230125,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230126
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230126,
					"content": "(처음에는 너무 셔서, 얼굴이 찌푸려질 정도였지만…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230127
					]
				},
				{
					"id": 761230127,
					"content": "(먹다 보면 단맛이 올라와…. 익숙해지면 괜찮을지도…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230128
					]
				},
				{
					"id": 761230128,
					"content": "어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230129,
						761230130
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230129,
					"content": "합격이야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230131
					]
				},
				{
					"id": 761230131,
					"content": "이건 또 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230132
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230132,
					"content": "페이몬, 얼른 먹어봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230133
					]
				},
				{
					"id": 761230133,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230134
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230134,
					"content": "으아아아, 너무 셔! 우씨, 나 괴롭히고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230135
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230135,
					"content": "하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230136
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230136,
					"content": "뒷맛이 꽤 좋아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230137
					]
				},
				{
					"id": 761230137,
					"content": "중요한 건 첫맛이야! 조금만 베어 물라고 알려줬어야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230138
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230138,
					"content": "말 안 하면 내 반응을 보려고 일부러 장난치는 것처럼 느껴진다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230139,
					"content": "알겠어, 다시 만들어 볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230140
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230140,
					"content": "또 약간의 시간이 흐른 뒤…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230141
					]
				},
				{
					"id": 761230141,
					"content": "자, 이번 것도 먹어 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230142
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230142,
					"content": "(오…! 훨씬 나아졌어!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230143,
						761230144
					]
				},
				{
					"id": 761230143,
					"content": "이번엔 진짜 맛있다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230145,
					"content": "진짜? 나도 나도! 으음…! 이거 맛있다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230146
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230146,
					"content": "남한테 줘도 될 정도야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230147
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230147,
					"content": "완전! 오, 콜롬비나, 요리도 배우고 크룸카케도 만들고, 누구한테 선물이라도 하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230148
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230148,
					"content": "응… 친구들한테 선물할래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230149
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230149,
					"content": "좋은 생각이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230150
					]
				},
				{
					"id": 761230150,
					"content": "너희 여기 처음 왔을 때 기억나? 너희가 날 위해 음식을 준비해 줬잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230151
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230151,
					"content": "음식으로 채우는 에너지는 내가 잃어버린 힘에 비하면 미미했지만, 먹고 나서 왠지 마음이 따뜻해졌었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230152
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230152,
					"content": "그때는 이유를 자세히 생각해 보지 않았는데, 이제는 알 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230153
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230153,
					"content": "손수 만들고, 정성을 쏟고… 이런 시간이 음식에 영혼을 불어넣는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230154
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230154,
					"content": "내가 누리는 건 음식 자체가 아니라, 그 안에 담긴 따스함과 상냥함이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230155
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230155,
					"content": "대가를 바라지 않는 마음은 너무나 귀해서, 똑같은 마음이 있어야 맞출 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230156
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230156,
					"content": "에이, 그렇게 말하면 민망해. 그때 우린 너한테 잘 보이려고 그런 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230157,
						761230158
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230157,
					"content": "물론 지금은 달라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230159,
					"content": "응. 하지만 나도 친구들한테 뭐라도 해주고 싶어… 행복한 기분이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230160
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230160,
					"content": "나 친구들한테 갈 건데 같이 가줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230161
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230161,
					"content": "크룸카케 말고 다른 선물도 조금 준비했어. 아, 근데, 몰래 줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230162
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230162,
					"content": "왜 몰래 줘?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230163
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230163,
					"content": "전에 너희가 나한테 「깜짝선물」을 해줬잖아. 나도 「깜짝선물」을 받은 친구들의 반응을 보고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230164
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230164,
					"content": "휴, 엄청 돌아다녔다. 드디어 배달 끝!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230165
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230165,
					"content": "다들 꽤 예상 밖의 반응이었어. 물론, 콜롬비나의 선물이라는 걸 아예 눈치 못 챈 사람도 있지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230166
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230166,
					"content": "아이노는 먹는 데에만 관심 있었지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230167
					]
				},
				{
					"id": 761230167,
					"content": "괜찮아, 그것도 예상하고 있었거든. 내 선물을 받고 기뻐했으면 됐어. 그게 제일 중요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230168
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230168,
					"content": "라우마는 테이블에 놓인 크룸카케랑 화환을 보고 콜롬비나의 선물이라는 걸 알아차린 것 같았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230169
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230169,
					"content": "근데 화환을 아까워서 못 쓰는 건 이해하는데… 크룸카케를 10분씩이나 쳐다만 보고 먹질 않더라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230170
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230170,
					"content": "고이 모셔둘까 봐 걱정했지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230171
					]
				},
				{
					"id": 761230171,
					"content": "근데 야호다는 많이 놀란 것 같더라… 몰래 뒤에 두면 안 되는 거였나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230172
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230172,
					"content": "진짜 놀라서 「펄쩍 뛰었지」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230173
					]
				},
				{
					"id": 761230173,
					"content": "야호다는 워낙 경계심이 많잖아. 아슈르가 와서 네가 준 고양이 스크래쳐를 긁으니까, 좀 진정하는 것 같더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230174
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230174,
					"content": "지금 노드크라이에 없는 다른 친구들 건, 너희한테 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230175
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230175,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230176
					],
					"speakerTitle": "긴 깃 따오기"
				},
				{
					"id": 761230176,
					"content": "콜롬비나는 선물 센스가 있네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230177
					]
				},
				{
					"id": 761230177,
					"content": "자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230178
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230178,
					"content": "오! 이번엔 우리 차례인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230179
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230179,
					"content": "응? 사탕? 다른 사람들처럼 크룸카케일 줄 알았는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230180
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761230180,
					"content": "그건 시식하면서 먹어봤잖아. 다른 걸 먹는 게 더 좋지 않겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230181,
						761230182
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761230181,
					"content": "음… 맛있다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230183
					]
				},
				{
					"id": 761230183,
					"content": "다행이다",
