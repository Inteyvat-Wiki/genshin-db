	"talks": [
		{
			"id": 7308001,
			"completionStepIds": [
				7308001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
