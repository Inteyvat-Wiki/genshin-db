			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"후쿠모토"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230330101,
					"content": "여행자, 또 만났네. 네 도움 덕분에 아사기리 씨가 일러스트 그릴 때 훨씬 수월했대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330102,
						230330103
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230330102,
					"content": "도움이 되었다니 다행이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330104
					]
				},
				{
					"id": 230330104,
					"content": "맞아. 그 아카데미아 학자들은 아직도 제작 디테일을 가지고 토론하고 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330105
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230330105,
					"content": "어떤 학자는 기왕 새롭게 내는 거, 콘텐츠도 그렇고 게임 리소스 시스템도 창의적이어야 한다고 하던데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330106
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230330106,
					"content": "또 어떤 학자는 카드가 보기 좋아야 한다며 예산으로 화가를 더 뽑자고 주장하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330107
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230330107,
					"content": "다른 한 명은 더 이상해… 글쎄 「일곱 성인의 소환」 제작에 참여한 모든 학자들끼리 대전 대회를 열어야 한다고 했다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330108
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230330108,
					"content": "뭐 이긴 사람이 더 큰 발언권을 가져야 한다는 건데, 내가 보기엔 그냥 단순히 「일곱 성인의 소환」을 즐기고 싶었던 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330109
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230330109,
					"content": "아무튼 당최 알 수 없는 얘기만 계속해서, 소재를 구한다는 핑계로 도망쳐버렸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330110
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230330110,
					"content": "여행자, 한 번만 더 모델이 되어주지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330111
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230330111,
					"content": "어려운 건 아니고, 네 전투 센스를 살짝 보여주기만 하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330112,
						230330113
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230330112,
					"content": "카드 게임 소설 쓰시는 거 아니었어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330114
					]
				},
				{
					"id": 230330114,
					"content": "뭘 모르는구나. 단순한 카드 게임은 이제 안 팔리는 시대야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330115
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230330115,
					"content": "사실 카드 게임이 전투로 번지는 건 좀 뻔한 것 같아서 캐릭터가 말 타고 경주하며 카드 게임을 하는 걸로 구상해뒀지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330116
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230330116,
					"content": "그런데 말 타고 카드 게임을 해야만 하는 이유를 아직 생각해내지 못했어… 그래서 일단 카드 게임이 싸움으로 번지는 구간을 쓰기로 결정했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330117
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230330117,
					"content": "장소는 벌써 정해놨어. 얼른 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230330113,
					"content": "카드 게임이랑 전투가 무슨 관련이 있죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330114
					]
				},
				{
					"id": 230330103,
					"content": "오늘도 소재를 찾고 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330104
					]
				}
			]
		},
