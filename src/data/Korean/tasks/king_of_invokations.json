					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230338015,
					"content": "아니다. 역시 현실적인 게 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230338016
					],
					"speakerTitle": "후쿠모토"
				},
