			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180601,
					"content": "「사금 여관」은 카라반 수도원의 유일한 여관이라 광고를 낼 필요가 없을 것 같지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180602
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732180602,
					"content": "저희 가게의 바비큐는 정말 끝내준답니다. 정통 사막 요리법을 사용해 성에서 파는 것보다 더 맛있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180603
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732180603,
					"content": "피곤하신 여행자분들, 꼭 한번 맛 보러 오세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "게시판"
				}
			]
		},
		{
			"id": 7321807,
			"completionStepIds": [
				7321807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321807",
							"2"
						],
						"stepId": 7321807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180701,
					"content": "「교령관님, 카라반 수도원의 통관 제한을 더 강화해 주실 수 있을까요?」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180702
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732180702,
					"content": "「현재는 사막 주민이면 누구나 통관이 가능합니다. 이로 인해 수많은 도적들이 숲으로 도망가기도 하고 저희 수메르 주민들의 취직 기회까지 빼앗고 있습니다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180703
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732180703,
					"content": "「비록 사막 주민들에게는 허공 권한을 개방하지 않았지만 취사청에서 공지한 의뢰는 더 이상 용병들만을 위한 의뢰가 아닙니다. 이런 상황이 계속된다면 다들 아카데미아 시험을 보거나 백수가 되고 말 겁니다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180704
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732180704,
					"content": "「무슨 말을 그렇게 해요? 사막 주민들도 위대한 룩카데바타님의 자손들이에요. 다들 수메르의 주민이라고요. 당연히 성에 들어올 수 있게 해야죠」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180705
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732180705,
					"content": "「여기서 이런 말을 하면 큰 비난을 받을 거예요」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "게시판"
				}
			]
		},
		{
			"id": 7321808,
			"completionStepIds": [
				7321808
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
