			"dialogs": [
				{
					"id": 740850201,
					"content": "열쇠, 조각상, 열쇠, 조각상, 열쇠, 조각상",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850202
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850202,
					"content": "음… 그러니까 열쇠를 조각상에 넣으라고? 마침 딱 열쇠 세 개에 조각상도 세 개긴 한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740850203,
					"content": "일단 해볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740850204,
					"content": "열쇠를 넣으면 어떻게 돼?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850205
					]
				},
				{
					"id": 740850205,
					"content": "문 열려, 문 열려…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850206
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850206,
					"content": "문? 어디? 문 뒤엔 뭐가 있는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740850207,
					"content": "뿌리, 에리니에스, 정말 깊어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850208
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850208,
					"content": "문 뒤가 에리니에스섬의 뿌리라고?! 프샤비, 너너… 너 아는 게 진짜 많구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740850209,
					"content": "프샤비, 지켜!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850210
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850210,
					"content": "또 우리가 알아야 할 게 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850211
					]
				},
				{
					"id": 740850211,
					"content": "…음?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850212
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850212,
					"content": "정보 말이야, 정보. 아는 게 많을수록 더 많이 파악할 수 있으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740850213,
					"content": "정…보? 정…보… 프샤비! 정보, 정말 많아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850214
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850214,
					"content": "잘됐다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740850215,
					"content": "에리니에스, 정보, 정말 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850216
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850216,
					"content": "응… 정보가 정말 많구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740850217,
					"content": "정보, 수맥, 정말 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850218
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850218,
					"content": "응… 수맥이 정말 많구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740850219,
					"content": "수맥, 늪이예뻐, 정말 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850220
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850220,
					"content": "으…응?! 늪이예뻐가 정말 많다고?! 잠깐만, 나 또 헷갈리는데… 늪이예뻐가 어떻게 많다는 거야? 뭐 분신술이라도 쓰나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740850221,
					"content": "멜뤼진!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850222
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850222,
					"content": "수맥, 늪이예뻐, 맛봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850223
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850223,
					"content": "사악함, 늪이예뻐, 감지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850224
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850224,
					"content": "수맥 속의 사악함을 맛본다고? 입맛 한번 독특하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850225
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740850225,
					"content": "늪이예뻐가 수맥 속의 정보를 감지할 수 있다고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850226
					]
				},
				{
					"id": 740850226,
					"content": "프샤비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850227
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850227,
					"content": "버드나무, 수집. 안갯길, 처리. 샘의 눈, 발송",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850228
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850228,
					"content": "뿌리, 수맥, 중심",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850229
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850229,
					"content": "에리니에스섬이 정보의 중심이란 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850230
					]
				},
				{
					"id": 740850230,
					"content": "그러니까 에리니에스섬 전체가 늪이예뻐의 정보 시스템이라는 거지? 그걸 통해 나쁜 걸 감지해 낼 수 있는 거고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850231
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740850231,
					"content": "#똑똑한 페이몬! 똑똑한 {NICKNAME}! 프샤비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850232
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850232,
					"content": "와, 이 늪이예뻐라는 녀석은 대체 어떤 인물인 걸까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850233
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740850233,
					"content": "폰타인, 늪이예뻐, 지켜",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850234
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850234,
					"content": "하지만, 늪이예뻐, 정말 바빠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850235
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850235,
					"content": "보랑이, 몰래 뿌리로 가. 보랑이, 몰래 뿌리 파괴해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850236
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850236,
					"content": "프샤비, 몰래 봤어. 프샤비, 몰래 비석 갈았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850237
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850237,
					"content": "어? 비석의 글을 지운 게 너였어? 그 녀석을 막으려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850238
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740850238,
					"content": "프샤비! 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850239
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850239,
					"content": "보랑이, 계속 뿌리로 가. 보랑이, 정말 무시무시해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850240
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850240,
					"content": "다른 길을 찾은 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850241
					]
				},
				{
					"id": 740850241,
					"content": "프샤비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850242
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850242,
					"content": "상대하기 까다로운 녀석인가 보네…. 뿌리가 망가지면 정보 시스템이 기능을 잃을 거고 늪이예뻐의 감지 능력도 영향을 받을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850243
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740850243,
					"content": "프샤비, 책임! 프샤비, 지켜!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850244
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850244,
					"content": "#{NICKNAME}, 또와줘. 페이몬, 또와줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850245
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740850245,
					"content": "#{NICKNAME}, 더 미루면 안 될 것 같아! 지금 바로 도와주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850246
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740850246,
					"content": "프샤비! 지금 바로 문을 열자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850247
					]
				},
				{
					"id": 740850247,
					"content": "좋았어, 출발이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
