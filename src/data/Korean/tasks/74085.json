					"nextDialogs": [
						740851902
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740851902,
					"content": "걱정 마, 프샤비는 수영할 줄 알 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851903
					]
				},
				{
					"id": 740851903,
					"content": "그건 그래… 우와! 저 큰 나무 좀 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851904
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740851904,
					"content": "엄청 예쁘다. 이게 원래 모습이겠지? 프샤비도 봤다면 아주 기뻐했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851905
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740851905,
					"content": "#페이몬! 프샤비! {NICKNAME}! 프샤비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851906
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740851906,
					"content": "프샤비? 다행이다. 아깐 어딜 갔던 거야? 계속 걱정했다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851907
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740851907,
					"content": "프샤비, 그림자 숨겨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851908
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740851908,
					"content": "아… 상자, 프샤비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851909
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740851909,
					"content": "엥? 이건… 보물상자? 너 보물상자를 찾으러 간 거였어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851910
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740851910,
					"content": "프샤비! 하지만, 금색, 동글동글, 멜뤼진…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851911
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740851911,
					"content": "모라는 못 찾았다고? 괜찮아! 이 보물상자만으로도 충분한걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851912
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740851912,
					"content": "내가 한 말을 기억하고 있었다니 정말 감동이야. 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851913
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740851913,
					"content": "고마…워?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851916
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740851916,
					"content": "고마워라는 건 프샤비란 뜻이야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851917
					]
				},
				{
					"id": 740851917,
					"content": "#페이몬, 고마워! {NICKNAME}, 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851918
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740851918,
					"content": "#페이몬, 착해! {NICKNAME}, 착해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851919
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 740851919,
					"content": "프샤비! 착해!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851920
					]
				},
				{
					"id": 740851920,
					"content": "프샤비! 착해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851921
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740851921,
					"content": "#{NICKNAME}, 우리 나중에 시간 나면 자주 프샤비랑 놀아주자! 그 늪이예뻐처럼 말도 더 가르쳐주고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851922
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740851922,
					"content": "프샤비!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851923
					]
				},
				{
					"id": 740851923,
					"content": "프샤비, 넌 어때? 나중에 우리가 또 놀러 오는 거 좋아? 어라?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851924
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740851924,
					"content": "얜 또 왜 없어졌어?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851925
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740851925,
					"content": "그림자도 남기지 않고 사라져 버렸네?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851926
					]
				},
				{
					"id": 740851926,
					"content": "정말 대단하네! 이런 멜뤼진은 진짜 처음이야. 애초에 멜뤼진 같지 않긴 했어. 오히려 신비로운 야생 정령 같았달까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851927
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740851927,
					"content": "하지만 그 덕분에 몰래몰래 그 나쁜 보랑이를 감시할 수 있었던 거겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851928
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740851928,
					"content": "어이! 프샤비! 또 만나자! 다음에 만나면 작별 인사하는 법을 가르쳐 줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
