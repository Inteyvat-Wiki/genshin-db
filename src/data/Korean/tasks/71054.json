						],
						"stepId": 7105402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"언박",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540101,
					"content": "잠깐, 스톱! 내 말 좀 들어 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540102
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540102,
					"content": "보물 사냥단이 말대꾸? 순순히 자수나 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710540103,
					"content": "#난 천암군이야. 층암거연 관할 지역의 중대장 언박이라고 해. 만나서 반가워, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540104
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540104,
					"content": "음… 그리고… 유명한 꼬마 피터팬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540105
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540105,
					"content": "야, 왜 내 이름은 까먹은 건데! 난 페이몬이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710540106,
					"content": "하하… 이거 실례했군. 미안하게 됐어… 하지만 우리 사이에 약간의 오해가 있는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540107,
						710540109
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540107,
					"content": "잠깐… 당신들은 보물 사냥단이 아니었나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540108
					]
				},
				{
					"id": 710540108,
					"content": "당연히 아니지. 사실은 반대야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540112,
					"content": "크흠, 이 작업장이 과거 보물 사냥단이 점령했던 거점인 건 맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540113
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540113,
					"content": "광부들이 철수한 후로 호시탐탐 기회를 노리던 녀석들이 들어오게 됐어… 처음에는 광석을 도굴하거나 유리 모래를 암거래하는 등의 사소한 일로 우리 순찰대와 숨바꼭질을 해왔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540114
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540114,
					"content": "하지만 나중에 그 녀석들은 점점 더 대담해져서 광부들이 남긴 낡은 창고를 점령하고는 조잡한 싸구려 장신구를 만들어 팔고 있더라고! 휴, 정말이지… 보기만 해도 마음이 아파",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540115
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540115,
					"content": "마음이 아프다고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540116
					]
				},
				{
					"id": 710540116,
					"content": "그렇게 조잡한 장신구는 리월에 처음 온 여행객이나 견문이 좁은 서생들이나 속일 수 있어… 낮은 가격으로 리월의 시장에 침투하려는 속셈이겠지? 흥, 아마 그들의 평판만 떨어지고 말 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540117
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540117,
					"content": "그 녀석들은 애초부터 평판이라고 할 것도 없잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710540118,
					"content": "하하, 맞아. 이것들을 가지고 돈을 벌려고 하다니 정말 품위 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540119
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540119,
					"content": "그래서 우린 보물 사냥단을 정리하고 녀석들의 모습으로 위장해 잠복하고 있었어… 음, 이게 얼마 전에 있었던 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540120
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540120,
					"content": "그리고 우린 보물 사냥단의 우두머리와 「우인단」의 한 부대가 비밀리에 연락하고 있다는 사실을 알아냈어. 위험 물자를 거래하는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540121,
						710540124
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540121,
					"content": "우인단과 보물 사냥단의 연락에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540122
					]
				},
				{
					"id": 710540122,
					"content": "우리가 우인단의 계획을 수포로 돌아가게 만들었지만, 리월의 야외에서는 여전히 우인단의 잔당들이 있어… 그 녀석들의 전문성이나 전투력은 우리한테 큰 위협이니 결코 얕봐서는 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540123
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540123,
					"content": "보물 사냥단과 우인단이 결탁해 우리한테 맞선다면… 정말 골치 아픈 안전 문제가 발생할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540126,
					"content": "어쨌든, 모든 준비를 끝내고 총공격만 기다리고 있던 참이었어. 그 녀석들을 일망타진하면 녀석들이 뭘 꾸미고 있는지 알아낼 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540127
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540127,
					"content": "근데 우리가 온 거구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710540128,
					"content": "휴… 너희가 대단한 건 알고 있었지만 이 정도일 줄은 몰랐어…. 네 덕에 우리의 팀 절반이 쓰러졌다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540129
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540129,
					"content": "물론, 우리가 여기 있는 또 다른 이유는… 이곳에 마침 「칠성 진법」의 「반건」이 하나 있거든. 그게 보물 사냥단처럼 심사가 뒤틀린 녀석들 손에 넘어가면 안 되니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540130,
						710540132
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540130,
					"content": "윽… 미안해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540131
					]
				},
				{
					"id": 710540131,
					"content": "하하하, 괜찮아! 너희를 못 알아본 우리 잘못이지 뭐… 전에 너희를 그냥 보내주라는 지령을 받았었는데 이렇게 빨리 올 줄은 몰랐지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540134,
					"content": "와… 이렇게 얘기가 잘 통하는 사람이었다니! 그럼 우리 이만 가 봐도 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540135
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710540135,
					"content": "난 너희를 탓하지 않지만 그게 리월의 법이 너희를 용서할 거라는 의미는 아니었어. 헤헤, 진짜 미안해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540136
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540136,
					"content": "이봐——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540137,
						710540138
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710540137,
					"content": "다음엔 말을 끝까지 해주세요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540139,
					"content": "음… 어디 보자, 소란난동죄, 천암군 공무집행 방해, 「칠성 진법」 고의 파손, 그리고… 범죄 현장 파괴까지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540140
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540140,
					"content": "천암군 당사자의 양해로 형량을 던다치고… 모든 게 순조롭다면 너희는 5년 내지 10년 동안 리월항에서 지내게 될 거야! 축하해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540141
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540141,
					"content": "엥??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540142,
						710540144
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710540142,
					"content": "변호사를 선임해도 되나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540143
					]
				},
				{
					"id": 710540143,
					"content": "음… 우리한테 변호사 명단을 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710540146,
					"content": "크흠… 하지만…! 말 좀 끝까지 들어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540147
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540147,
					"content": "하지만 합법적인 시민이나 외국인 여행객이 어떠한 합법적인 방법으로든 천암군의 조사에 협력해 사건을 해결했을 경우, 그에 상응한 보상을 받을 수 있다… 는 것 또한 리월의 규정이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540148
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540148,
					"content": "그러니까 영웅들, 아까 싸움이 헛수고는 아니라는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540149
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540149,
					"content": "도와주면 저희는 뭘 받을 수 있죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540150
					]
				},
				{
					"id": 710540150,
					"content": "압류한 장물은 함부로 건드릴 수 없어. 하지만 너희가 협력한다면, 체포 과정에서 우연히 찾은 장물… 음, 예를 들면 「보물 사냥단의 숨겨진 보물!」 같은 건 너희가 알아서 처리해도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540151
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540151,
					"content": "그리고 우리끼리 모라를 좀 준비했는데 부디 마음에 들어 했으면 좋겠군… 휴, 이런 갑작스러운 「도움」은 사전에 예산에 넣지 않았을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540152
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540152,
					"content": "음… 그러니까, 감옥에 갈 필요도 없고 보물도 가질 수 있다! 이거잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540153
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710540153,
					"content": "맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540154
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540154,
					"content": "좋아! 썩 내키진 않지만 도와줄게! 길이나 안내해 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540155,
						710540156
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710540155,
					"content": "잠깐…!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540157,
					"content": "자, 사양하지 말고… 그럼 난 먼저 집결지에서 대기하고 있을게. 미리 움직일 수도 있으니까 잘 따라오라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540158
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540158,
					"content": "맞아, 얼른 따라가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540159
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710540159,
					"content": "야…!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540160
					]
				},
				{
					"id": 710540160,
					"content": "빨리, 우린 지금 천암군에 협력해 사건을 해결하는 거라구! 게다가 모라도 잔뜩 준다잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710540156,
					"content": "난 아직…!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540144,
					"content": "이럴 줄 알았으면 좀 살살 하는 건데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540145
					]
				},
				{
					"id": 710540145,
					"content": "흥, 그냥 짜증 나 보이는 녀석들을 때린 거야. 누가 보물 사냥단 옷을 입고 있으래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710540138,
					"content": "이거 고의 맞죠?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540132,
					"content": "우리가 사람을 잘못 때린 거네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540133
					]
				},
				{
					"id": 710540133,
					"content": "응, 하지만 너희를 탓하진 않아. 우리 잘못이 먼저니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540124,
					"content": "위험 물자에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540125
					]
				},
				{
					"id": 710540125,
					"content": "내 정보원에 따르면 우인단이 대량의 모라와 군용 물자로 보물 사냥단한테서 어떤 물건을 사들이고 있다고 해… 하지만 음식과 생필품 뿐이더군. 어쩌면 눈속임일지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540109,
					"content": "당신들은… 천암군?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540110
					]
				},
				{
					"id": 710540110,
					"content": "하하, 미리 얘기 못 해서 미안해… 우린 너희가 말썽을 피우려고 온 녀석들인 줄 알았거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540111
					],
					"speakerTitle": "언박"
				},
				{
					"id": 710540111,
					"content": "음… 틀린 말은 아닌 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7105402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
