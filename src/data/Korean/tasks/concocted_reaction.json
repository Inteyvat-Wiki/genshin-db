				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"바하도르"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736930101,
					"content": "왜 이런 일을 나한테 맡긴 걸까. 경험이 풍부한 선배님한테 맡기면 얼마나 좋아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930102
					],
					"speakerTitle": "바하도르"
				},
				{
					"id": 736930102,
					"content": "어? 여기도 행사 중인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736930103
					]
				},
				{
					"id": 736930103,
					"content": "응, 여행자?! 응… 맞아. 지금 그게… 행사를… 진행 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930104
					],
					"speakerTitle": "바하도르"
				},
				{
					"id": 736930104,
					"content": "에휴, 행사라기보단 일종의… 탐험되길 기다리는 비경이라고 해야겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930105
					],
					"speakerTitle": "바하도르"
				},
				{
					"id": 736930105,
					"content": "이 비경은 학부 홍보전이랑 상관없나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736930106
					]
				},
				{
					"id": 736930106,
					"content": "휴, 말도 마. 아카데미아가 그런 행사를 열어서 내가 이런 일을 맡게 된 거니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930107
					],
					"speakerTitle": "바하도르"
				},
				{
					"id": 736930107,
					"content": "자기소개를 깜빡했네. 난 스판타마드 학부의 바하도르라고 해. 우리 학부는 연금술이나 원소 같은 것들을 연구하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930108
					],
					"speakerTitle": "바하도르"
				},
				{
					"id": 736930108,
					"content": "아무튼 난 이 행사를 맡게 됐는데, 우리 스판타마드 학부가 무슨 미니 게임을 만들 수 있겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930109
					],
					"speakerTitle": "바하도르"
				},
				{
					"id": 736930109,
					"content": "연금 테이블을 놓고 연금술 보급을 할 수도 없잖아? 엄청 지루할 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930110
					],
					"speakerTitle": "바하도르"
				},
				{
					"id": 736930110,
					"content": "그렇다고… 원소 반응 행사를 할 수도 없어. 사고가 발생하면 행사장이 폭발할 수도 있으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930111
					],
					"speakerTitle": "바하도르"
				},
				{
					"id": 736930111,
					"content": "결국 난 모험가 길드의 도움으로 비경을 하나 찾았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930112
					],
					"speakerTitle": "바하도르"
				},
				{
					"id": 736930112,
					"content": "동료들이랑 같이 비경을 둘러봤는데, 솔직히 말해 안은 좀 혼잡하더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930113
					],
					"speakerTitle": "바하도르"
				},
				{
					"id": 736930113,
					"content": "그래서 우리는 특정 상황에 대처하기 위한 몇 가지 연금용 포션을 개발했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930114
					],
					"speakerTitle": "바하도르"
				},
				{
					"id": 736930114,
					"content": "자 봐. 우리 학부의 특기가 드러났지? 하하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930115
					],
					"speakerTitle": "바하도르"
				},
				{
					"id": 736930115,
					"content": "여행자, 관심이 있다면 이 포션을 들고 비경으로 가봐. 비경 위치를 네 <color=#00E1FFFF>지도</color>에 표시해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930116,
						736930117
					],
					"speakerTitle": "바하도르"
				},
				{
					"id": 736930116,
					"content": "정말 놀러 오는… 사람이 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736930118
					]
				},
				{
					"id": 736930117,
					"content": "저 말고 놀러 오는 사람이 있나요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736930118
					]
				},
				{
					"id": 736930118,
					"content": "그, 그래도 관심을 갖고 비경에 도전하러 온 모험가들이 있긴 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930119
					],
					"speakerTitle": "바하도르"
				},
				{
					"id": 736930119,
					"content": "하지만 확실히 학부 학생들은 거의 없지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930120
					],
					"speakerTitle": "바하도르"
				},
				{
					"id": 736930120,
					"content": "휴, 아무튼 관심 있다면 그 비경에 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930121
					],
					"speakerTitle": "바하도르"
				},
				{
					"id": 736930121,
					"content": "그 모험가들 말에 따르면, 비경이 꽤 「도전적」이래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930122,
						736930124
					],
					"speakerTitle": "바하도르"
				},
				{
					"id": 736930126,
					"content": "맞다, 정말 갈 거면 네게 줄 특수한 포션들이 있어…. 아무튼 그 비경을 탐험할 때 안전에 주의해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바하도르"
				}
			]
		}
	]
}