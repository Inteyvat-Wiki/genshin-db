				"points": []
			},
			"dialogs": [
				{
					"id": 732150101,
					"content": "안녕, 나라 친구! 음… 할 말이 있었던 것 같은데 기억이 안 나네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150102
					],
					"speakerTitle": "아란나가"
				},
				{
					"id": 732150102,
					"content": "상관없어, 다시 만나서 너무 기뻐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732150103,
					"content": "응, 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150104,
						732150106
					],
					"speakerTitle": "아란나가"
				},
				{
					"id": 732150104,
					"content": "「마우티이마」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150105
					]
				},
				{
					"id": 732150105,
					"content": "이제 말은 안 하지만 잘 지내고 있어. 숲도 지금 회복 중이고… 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란나가"
				},
				{
					"id": 732150106,
					"content": "망각에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150107
					]
				},
				{
					"id": 732150107,
					"content": "망각…? 음, 「쿠사바」의 힘이 소진되면 기억이 마치 이슬처럼 조금씩 사라져…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란나가"
				}
			]
		},
		{
