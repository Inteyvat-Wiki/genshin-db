			"dialogs": [
				{
					"id": 732150401,
					"content": "안녕, 금빛의 나라랑 하얀 둥실이!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150402
					],
					"speakerTitle": "아란나가"
				},
				{
					"id": 732150402,
					"content": "안녕! 요즘 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732150403,
					"content": "아주 좋아. 근데 여기는 무슨 일로 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150404
					],
					"speakerTitle": "아란나가"
				},
				{
					"id": 732150404,
					"content": "어…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732150405,
					"content": "음… 우리는 조금 혼란스러워. 분명 이유가 있겠지만 너희가 왜 왔는지 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150406
					],
					"speakerTitle": "아란나가"
				},
				{
					"id": 732150406,
					"content": "우린 이미 이곳이 익숙해. 너희들과 함께 많은 모험을 겪었으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732150407,
					"content": "…? 음… 정말?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150408
					],
					"speakerTitle": "아란나가"
				},
				{
					"id": 732150408,
					"content": "우리가 함께 겪었던 일들을 기억 못 하나 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
