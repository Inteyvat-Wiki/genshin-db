			"dialogs": [
				{
					"id": 732150301,
					"content": "안녕, 금빛의 나라랑 하얀 둥실이! 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150302
					],
					"speakerTitle": "아란가루"
				},
				{
					"id": 732150302,
					"content": "너희 무슨 일로 온 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150303
					],
					"speakerTitle": "아란가루"
				},
				{
					"id": 732150303,
					"content": "꼭 돌아와서 같이 놀자고 했잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732150304,
					"content": "음, 내가 그런 말을 했나…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150305,
						732150307
					],
					"speakerTitle": "아란가루"
				},
				{
					"id": 732150305,
					"content": "응, 그렇게 말했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150306
					]
				},
				{
					"id": 732150306,
					"content": "그렇구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150309
					],
					"speakerTitle": "아란가루"
				},
				{
					"id": 732150309,
					"content": "암튼 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란가루"
				},
				{
					"id": 732150307,
					"content": "왜, 기분이 별로야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150308
					]
				},
				{
					"id": 732150308,
					"content": "음… 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150309
					],
					"speakerTitle": "아란가루"
				}
