				"points": []
			},
			"dialogs": [
				{
					"id": 732150201,
					"content": "안녕, 안녕!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150202
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 732150202,
					"content": "안녕, 꼬마! 우리 기억나지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732150203,
					"content": "얄미운 하얀 둥실이, 난 꼬마가 아니야! 내가 가르쳐줬던 노래 아직 기억해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150204
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 732150204,
					"content": "당연하지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150205
					]
				},
				{
					"id": 732150205,
					"content": "좋아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150206
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 732150206,
					"content": "그럼 약속해 줘. 설령 내가 내 노래를 잊더라도… 너희가 기억해 주겠다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란나킨"
				}
			]
		},
