			"dialogs": [
				{
					"id": 732150501,
					"content": "안녕! 금빛의 나라! 그리고 너, 조그마한 하얀 둥실이!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150502
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 732150502,
					"content": "흥, 나 작지 않아! 넌 거울도 안 보니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732150503,
					"content": "흥흥, 나도 작지 않아! 음… 참, 무슨 일 때문에 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150504
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 732150504,
					"content": "너희가 보고 싶어서 돌아왔어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150505
					]
				},
				{
					"id": 732150505,
					"content": "맞아, 우리 지난번에 나쁜 녀석들을 많이 물리쳤잖아. 같이 노래도 하고, 「무이야」도 구하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732150506,
					"content": "「마우티이마」!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150507
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 732150507,
					"content": "그래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732150508,
					"content": "음… 미안…. 너희들 말이 사실일 거라고 믿지만 난 기억이 안 나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150509
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 732150509,
					"content": "음…! 괜찮아, 괜찮아! 슬퍼하지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150510
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732150510,
					"content": "(정말 기억 못 하나 봐…)",
					"roleType": "TALK_ROLE_NPC",
