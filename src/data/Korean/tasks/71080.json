					"nextDialogs": [
						710800604
					]
				},
				{
					"id": 710800604,
					"content": "수락해 줘서 정말 고마워! 온 정신을 집중해서 경청하도록 할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "탈리에신"
				},
				{
					"id": 710800603,
