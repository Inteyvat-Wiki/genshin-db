	"talks": [
		{
			"id": 1102102,
			"completionStepIds": [
				1102102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102102",
							"2"
						],
						"stepId": 1102102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"종려"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110210201,
					"content": "음, 여긴 평범해 보이는데…. 값나가는 걸 찾을 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210202
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210202,
					"content": "응? 내 생각엔 아주 멋들어진 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110210203,
					"content": "경치를 말하는 게 아니야. 그래도… 큰 전투가 벌어졌던 곳이니 뭔가 눈에 띄는 게 있어야 하는데, 흠, 지금은 어디서부터 찾아봐야 할지 모르겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210204
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210204,
					"content": "이곳은 고운각이네. 마신이나 마신 전쟁 시기의 역사를 연구하고자 한다면 여기가 딱이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210205
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110210205,
					"content": "암왕제군은 바위로 만든 창을 이 해역에 던져 마신을 꿰지르고 진압했다고 하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210206
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110210206,
					"content": "그 바위창이 오랜 시간 풍화되며 이렇게 색다른 광경을 만들었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210207
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110210207,
					"content": "이, 이렇게 큰 산이 암왕제군의 무기였다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110210208,
					"content": "지금 우리 눈앞에 남아있는 건 빙산의 일각에 불과해. 당시 암왕제군이 던진 바위창은 엄청난 크기에 많기도 많았거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210209
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110210209,
					"content": "다만 던지는 방향이 저마다 달랐고 창이 워낙 거대해서, 해수에 침식됐거나 중력의 영향으로 바다에 잠겼을 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210210
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110210210,
					"content": "그러니까 풍화뿐 아니라 당초의 붕괴도 고운각을 형성한 중요 요소 중 하나였단 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210211
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110210211,
					"content": "그럼… 이 말도 안 되는 힘에 대항한 마신도 엄청 강했겠죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210212
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210212,
					"content": "그렇다네, 그게 바로 고운각의 연구 가치지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210213
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110210213,
					"content": "그때 역사와 관련된 상당수의 물건들은 바다에 가라앉았지만, 「소용돌이의 마신」이 일으킨 거대한 파도가 그것들을 다시 세상 밖으로 내보내는 계기가 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210214
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110210214,
					"content": "그러니까 자세히 찾아보면 벌이가 꽤 짭짤하겠네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210215
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210215,
					"content": "아, 좋은 성과를 얻을 수 있겠다는 뜻이었어요. 그럼 안심이네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210216
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210216,
					"content": "어차피 이렇게 많은 인원이 온 거 나눠져 찾는 게 효율적일 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210217
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210217,
					"content": "음, 그럼 난 내 친구들과 함께하겠네. 내가 잡학에 밝긴 하지만 고고학자 앞에서 주름잡을 순 없지 않겠나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210218
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110210218,
					"content": "네? 저, 저요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210219
					],
					"speakerTitle": "완연"
				},
				{
					"id": 110210219,
					"content": "왜요? 이게 본업이면서 뭘 그렇게 놀라요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210220
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210220,
					"content": "알겠어요…. 그, 그럼 제가 길을 안내할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210221
					],
					"speakerTitle": "완연"
				},
				{
					"id": 110210221,
					"content": "그러지, 뭔가 진귀하거나 희귀한 걸 발견한다면… 맞은편 기슭에서 모이세나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "종려"
				}
			]
		},
		{
			"id": 1102106,
			"completionStepIds": [
				1102106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102106",
							"2"
						],
						"stepId": 1102106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"클리멘트"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110210601,
					"content": "…이러고도 고고학자라고요?! 이것도 모르고 저것도 모르고! 대체 뭐 하는 겁니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210602
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210602,
					"content": "전, 전공 분야가 다를 수도 있는 거잖아요! 전 설명해주려고 무척 노력했어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210603
					],
					"speakerTitle": "완연"
				},
				{
					"id": 110210603,
					"content": "싸우지들 마. 대체 왜 그러는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110210604,
					"content": "이 아가씨는 입만 열면 고고학자라더니 주변 유적에 대해선 하나도 모르잖아! 나보다 더 모른다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210605
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210605,
					"content": "어쩔 수 없이 감으로… 그러니까 그간의 경험으로 가치가 있어 보이는 걸 가져왔어. 휴, 완전 시간 낭비였다니깐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210606
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210606,
					"content": "저… 전 계속 「소금의 마신」에 대해 연구해왔어요. 바닷속에 뭐가 있는지 모르는 건 당연하다구요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210607,
						110210608
					],
					"speakerTitle": "완연"
				},
				{
					"id": 110210607,
					"content": "(학자라면서 좀 이상하네…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110210609
					]
				},
				{
					"id": 110210609,
					"content": "당신이야말로 이건 몇 모라 나가냐, 저건 몇 모라 나가냐 계속 물어댔잖아요! 유물의 가치는 모라로 환산할 수 없는 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210610
					],
					"speakerTitle": "완연"
				},
				{
					"id": 110210610,
					"content": "그, 그건… 유물의 가치를 모라로 따지는 게 가장 간단하니까 그랬지! 리월의 전통과도 잘 맞잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210611
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210611,
					"content": "자, 두 사람 다 진정 좀 하시게. 우리가 괜찮은 걸 가져왔으니 같이 살펴보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210612
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110210612,
					"content": "흠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210613
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110210613,
					"content": "아쉽군. 그대들이 가져온 것들은 「소용돌이의 마신」에 의해 뭍으로 쓸려 온 건 맞지만, 마신과는 관련 없는 근처 해역에서 나온 물건들뿐일세",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210614
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110210614,
					"content": "그에 비해 우리가 찾아낸 이 석판은 무늬가 신비롭고 마신의 힘도 미세하게 담겨 있으니, 어쩌면 연구에 도움이 될지도 모르겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210615
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110210615,
					"content": "이, 이리 줘보세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210616
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210616,
					"content": "헤헤, 이거라도 있으니 헛고생한 건 아니군요. 마신의 힘이라, 후훗, 제대로 건졌어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210617
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210617,
					"content": "흠흠, 하지만 다른 물건들도 조금의 값어치는 나갈 테니 당신을 고용한 비용을 회수할 순 있겠네요——다 제 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210618
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210618,
					"content": "마신의 힘이 남아있어야만 연구 가치가 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210619
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110210619,
					"content": "아니에요. 제가 「소금의 마신」의 역사를 연구하는 이유는 역사가 문화와 신앙을 설명해 줄 수 있기 때문이에요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210620
					],
					"speakerTitle": "완연"
				},
				{
					"id": 110210620,
					"content": "하지만 당신은 고고학을 내세워 돈을 벌고 싶은 것뿐이잖아요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210621
					],
					"speakerTitle": "완연"
				},
				{
					"id": 110210621,
					"content": "모함하지 마세요! 난 스네즈나야의 전문 고고학 연구원이에요. 진짜라니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210622,
						110210623
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210622,
					"content": "(아냐, 고고학을 내세워 돈을 벌려는 거겠지…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110210624
					]
				},
				{
					"id": 110210624,
					"content": "아, 그렇지. 그 찻잔은 팔지 않는 게 좋을 걸세",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210625
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110210625,
					"content": "앗? 어째서요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210626
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210626,
					"content": "그건 군옥각과 함께 떨어진 응광의 물건이거든. 자네가 칠성의 심기를 건드리고 싶은 게 아니고서야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210627
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110210627,
					"content": "윽, 알겠습니다…. 쳇, 꽤 좋은 물건 같았는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210628
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210628,
					"content": "거봐요, 팔아서 한몫 챙기고 싶은 거잖아요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210629
					],
					"speakerTitle": "완연"
				},
				{
					"id": 110210629,
					"content": "그, 그게 뭐 어때서요?! 연구도 하고 돈도 벌면 안 됩니까? 하, 이렇게 융통성이 없어서야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110210630
					],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210630,
					"content": "자! 이제 여기 더 있을 필요 없겠어요. 참, 나도 그 「소금의 마신」에 관심 많으니까 「대지의 소금」으로 갑시다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "클리멘트"
				},
				{
					"id": 110210623,
					"content": "(아냐, 남아 있는 마신의 힘을 모으고 싶은 거겠지…)",
