			"dialogs": [
				{
					"id": 10210201,
					"content": "음? 뭔가 엄청 달콤한 향기가 나는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10210202,
					"content": "그리고… 방금 무슨 소리 못 들었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210203,
						10210205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10210203,
					"content": "누군가 도움을 청하는 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210204
					]
				},
				{
					"id": 10210204,
					"content": "저 유적 안에서 난 소리 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10210207,
					"content": "…아, 설마 보물 사냥단이 누군가를 가둬버린 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10210205,
					"content": "누군가 노래하고 있는 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210206
					]
				},
				{
					"id": 10210206,
					"content": "아니야, 도움을 청하는 소리잖아! 저 유적 안에서 난 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 102103,
			"completionStepIds": [
