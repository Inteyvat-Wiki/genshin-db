			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"응광"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210401,
					"content": "절운간에서 귀환한 자여. 기다리고 있었다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210402
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10210402,
					"content": "와, 응광이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10210403,
					"content": "첫 만남이니까 선물을 준비했는데, 마음에 들었으면 좋겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10210404,
					"content": "나한테? 고마워. 손님에게 오히려 마음 쓰게 했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210405
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10210405,
					"content": "아니야, 괜찮아. 헤헤~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210406,
						10210408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10210406,
					"content": "「군옥각」은 정말 예뻐요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210407
					]
				},
				{
					"id": 10210407,
					"content": "하하, 그 말을 들으니 나도 기쁘구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210409
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10210409,
					"content": "이 궁전은 어떤 산보다도 높이 떠 있어. 여기 있으면 리월항 전체가 훤히 보이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210410
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10210410,
					"content": "난 장사를 시작하면서부터 이곳을 짓기 위한 자금을 모았어. 그리고 「천권」이 된 후엔 최고의 장인을 불러 계속해서 이곳을 넓혀갔지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210411
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10210411,
					"content": "처음엔 방 하나 만한 크기였지만, 지금은 리월의 달을 가릴 만큼 거대해졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210412
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10210412,
					"content": "언젠간… 이 그림자가 7개국을 전부 뒤덮을 거라 믿어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210413
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10210413,
					"content": "(이 「천권」이란 분은 엄청 야망 있네….)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210414
					]
				},
				{
					"id": 10210414,
					"content": "외지에서 온 손님 중에 「군옥각」에 올 수 있는 자는 드물어. 하지만 페보니우스 기사단의 단장 대행이 편지에서 너에 대해 높이 평가하더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210415
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10210415,
					"content": "그래서 네가 리월에 온 그날부터 사람을 붙였어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210416
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10210416,
					"content": "뭐?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210417
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10210417,
					"content": "그리고 너희가 망서 객잔으로 갔을 때쯤 대충 너희의 동향을 파악했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210418
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10210418,
					"content": "설마 베르 고데트 사장님이 칠성 쪽 사람이었어?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210419
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10210419,
					"content": "아니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210420
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10210420,
					"content": "망서 객잔 전체가 다 우리 쪽 사람이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210421
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10210421,
					"content": "##%^%*&……!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210422
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10210422,
					"content": "조금 전에 「옥형성」도 만났어요….",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210423
					]
				},
				{
					"id": 10210423,
					"content": "귀종기 옆에서, 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210424
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10210424,
					"content": "설마 여기서 몰래 보고 있던 거 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210425
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10210425,
					"content": "하하… 이렇게 멀리서는 잘 안 보이지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210426
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10210426,
					"content": "…「눈과 귀」를 통해서 알 수 있어. 난 너희에게 관심이 있으니 지켜보는 건 당연하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210427
					],
					"speakerTitle": "응광"
				},
				{
					"id": 10210427,
					"content": "각청은 칠성이 제군을 살해하지 않았다고 했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210428
					]
				},
				{
					"id": 10210428,
					"content": "음, 넌 선인들과 자주 왕래했으니, 우릴 못 믿는 것도 당연해. 그래서 이렇게 오해를 풀기 위해 널 초대한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "응광"
				},
				{
					"id": 10210408,
					"content": "이렇게 높은 곳엔 처음 와봐요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210409
					]
				}
			]
