						10211323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10211323,
					"content": "하… 밖에 있으면 경치는 좋은데 높아서 바람이 좀 세. 안에 손님 맞을 준비를 마쳤으니, 날 따라와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "응광"
				},
				{
					"id": 10211319,
					"content": "그 자식이겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211303,
					"content": "단어 자체는 들어본 것 같아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				}
			]
		},
