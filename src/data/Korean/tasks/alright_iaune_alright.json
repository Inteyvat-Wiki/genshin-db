			]
		},
		{
			"id": 2401304,
			"completionStepIds": [
				2401304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401304",
							"2"
						],
						"stepId": 2401304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"윤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240130401,
					"content": "여행자님, 저… 정말로 절 위해 커피를 만들어 주신 건가요? 이렇게 귀찮게 해드리다니, 정말 죄송해요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130402,
						240130403
					],
					"speakerTitle": "윤"
				},
				{
					"id": 240130402,
					"content": "괜찮아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130404
					]
				},
				{
					"id": 240130404,
					"content": "…이 커피! 행정청의 카페에서 먹는 것보다 훨씬 맛있어! 아… 아니, 아예 다른 차원의 커피야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130405
					],
					"speakerTitle": "윤"
				},
				{
					"id": 240130405,
					"content": "항상 이런 커피를 마실 수 있다면, 매일 오후마다 졸음에 시달릴 일은 없을 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130406
					],
					"speakerTitle": "윤"
				},
				{
					"id": 240130406,
					"content": "커피 정말 고마워요. 전 다 마시고 다시 일하러 가야겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130407,
						240130408
					],
					"speakerTitle": "윤"
				},
				{
					"id": 240130407,
					"content": "힘내세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130409
					]
				},
				{
					"id": 240130409,
					"content": "물론이죠, 얼른 성장해서 로이알트 씨처럼 혼자 일을 마무리 짓는 인재가 될 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130410
					],
					"speakerTitle": "윤"
				},
				{
					"id": 240130410,
					"content": "아휴, 하지만 그 전까지 전 얼마나 더 악몽에 시달려야 할까요…",
