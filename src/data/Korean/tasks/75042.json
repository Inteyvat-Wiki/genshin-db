				"points": []
			},
			"dialogs": [
				{
					"id": 750420101,
					"content": "안녕? 요즘 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420102
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750420102,
					"content": "아니면 뭔가 확인하고 싶은 게 있어서 찾아온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420103,
						750420108,
						750420115
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750420103,
					"content": "「불꽃 주인의 축복」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420104
					]
				},
				{
					"id": 750420104,
					"content": "「불꽃 주인의 축복」이라… 어떤 사람은 그걸 원시로 회귀하는 현상이라고 하지. 다들 그 힘이 혈통의 근원에서 비롯된다고 믿거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420105
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750420105,
					"content": "다만… 용 유물 연구 협회의 기록에 따르면, 대부분 몸에 「불꽃 주인의 축복」 표식이 있는 어린 용들은 성장 과정에서 체내의 통제할 수 없는 힘에 휘둘리게 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420106
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750420106,
					"content": "그 힘은 어린 용들의 몸을 찢고, 일반적인 용들과 다른 무언가로 변화시켜서… 난폭해지고 이성을 잃게 만들지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420107
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750420107,
					"content": "「호라와카」라는 이름의 깃룡 폭군을 예로 들 수 있는데… 그 용은 「불꽃 주인의 축복」을 받은 깃룡이라고 하더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "망코"
				},
				{
					"id": 750420108,
					"content": "부족의 「처리」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420109
					]
				},
				{
					"id": 750420109,
					"content": "그 꼬마를 밤의 신의 나라로 돌려보내는 거지. 살아생전에는 용들이나 밤의 신의 나라가 받아주지 않을지 몰라도",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420110
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750420110,
					"content": "이 세상을 떠나면 필연적으로 밤의 품으로 돌아가게 되거든. 잔인하게 들릴 수도 있겠지만 그곳에서 그 꼬마의 영혼은 다른 영혼과 합류할 수 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420111
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750420111,
					"content": "미안한 말이지만, 일종의 배려일지도 모르지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420112
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750420112,
					"content": "증표의 단서를 찾았나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420113
					]
				},
				{
					"id": 750420113,
					"content": "찾긴 했지만… 아직 확인이 필요해. 나중에 날 찾고 싶을 때는 파칼을 찾아가. 파칼은 메아리 아이의 족장이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420114
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750420114,
					"content": "좀… 허풍쟁이처럼 보이긴 하지만, 사실 파칼은 가장 견고한 수정석보다 훨씬 더 믿음직한 사람이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "망코"
				},
				{
					"id": 750420115,
					"content": "궁금한 건 더 이상 없어요, 가볼게요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420116
					]
				},
				{
					"id": 750420116,
					"content": "언제든 환영이야, 친구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "망코"
				}
			]
		}
	]
}