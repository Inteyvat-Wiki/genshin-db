			"dialogs": [
				{
					"id": 747060101,
					"content": "…그럼 이건?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060102
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 747060102,
					"content": "이것도 뭔가 부족해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060103
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 747060103,
					"content": "콜롬비나랑 푸리나? 여기서 뭐 하고 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 747060104,
					"content": "푸리나 감독이랑 같이… 「캐스팅」? 중이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060105
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 747060105,
					"content": "틀린 말은 아니야. 다만 지금 뽑으려는 배우는 수조 안의 물고기들이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060106
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 747060106,
					"content": "물고기도 연기를 해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 747060107,
					"content": "요즘은 동물 배우도 흔하다구. 지금은 물고기 한 마리를 골라서, 영화 분위기를 살릴 인서트 장면을 찍으려고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060108
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 747060108,
					"content": "근데 한 바퀴 다 둘러봤는데도, 아직 딱 맞는 녀석을 못 찾았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060109
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 747060109,
					"content": "#{NICKNAME}(이)랑 페이몬한테 부탁해 보자. 둘은 웬만한 문제는 다 해결해 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060110
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 747060110,
					"content": "우릴 믿어줘서 고맙긴 한데… 이런 건 우리도 좀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060111,
						747060112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 747060111,
					"content": "물고기를 좀 더 찾아볼까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				},
				{
					"id": 747060113,
					"content": "맞다! 이 수족관 운영은 너희가 맡고 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060114
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 747060114,
					"content": "앞으로 물에 들어갈 때 조금 더 유심히 살펴보면 되나? 그 정도는 어렵지 않지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 747060115,
					"content": "그럼 부탁해! 어떤 느낌의 물고기를 원하는지 이따 자세히 말해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060116
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 747060116,
					"content": "너희 이제 「스카우터」가 된 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060117
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 747060117,
					"content": "푸리나랑 다니면서 새로운 단어를 많이 배웠구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 747060112,
					"content": "물속에 좀 더 자주 들어가 볼까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				}
			]
		}
	]
