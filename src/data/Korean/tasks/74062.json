			},
			"dialogs": [
				{
					"id": 740620501,
					"content": "우리 돌아왔어! 부탁한 일은 어떻게 됐냐면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620502,
					"content": "나쿨에게 자세한 협상 과정을 설명한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740620503
					]
				},
				{
					"id": 740620503,
					"content": "음… 사정은 이해했어. 어찌 됐든 난 신용 있는 고용주니까 약속했던 의뢰비는 너희한테 지급할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620504
					],
					"speakerTitle": "나쿨"
				},
				{
					"id": 740620504,
					"content": "흠, 이제 어쩐다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "나쿨"
				}
			]
		}
