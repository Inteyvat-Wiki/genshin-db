						],
						"pointId": 4927
					}
				]
			},
			"dialogs": [
				{
					"id": 740620301,
					"content": "(나쿨의 말대로라면, 녀석은 폰타인 현지인이 아니면 배척하나 봐. 그쪽이 과연 우리를 상대해 줄까? 뭐 좋은 방법 없으려나…?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620302,
					"content": "(문을 두드리자)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620303
					]
				},
				{
					"id": 740620303,
					"content": "누구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620304,
						740620306,
						740620309
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620304,
					"content": "무명의 여행자이자 각국을 누비는 모험가예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620305
					]
				},
				{
					"id": 740620305,
					"content": "…여기는 전망 포인트가 아닐 텐데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620312
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620312,
					"content": "#{NICKNAME}, 좀 진지해져. 우리 목적을 잊지 말라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620313,
						740620378
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620313,
					"content": "의뢰를 받고 당신과 협상하러 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620314
					]
				},
				{
					"id": 740620314,
					"content": "의뢰인이 너랑 협상을 해달라고 하더라고. 이 방을 빌려주지 않을래? 물론 의뢰인은 특별 허가 쿠폰을 지불한다고 했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620315,
					"content": "저번에도 이런 일이 있었던 것 같은데… 정말이지 포기를 모르는군. 그 말투가 짜증 나는 녀석이 너희를 보낸 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620316
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620316,
					"content": "후, 녀석의 끈기를 봐서라도 생각해 볼 테니까… 가격을 불러봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620317
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620317,
					"content": "(잘됐네. 말이 아예 안 통하는 녀석은 아니었구나)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620318,
					"content": "(나쿨이 우리한테 예산을 알려줬잖아. 시작부터 그만큼을 제시할까? 아니면 한번 가격을 깎아볼까?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620319,
						740620356
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620319,
					"content": "(솔직하게 예산이 얼마인지 제시하자)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620320
					]
				},
				{
					"id": 740620320,
					"content": "응, 그럼 솔직하게 얘기할게. 의뢰인이 가지고 있는 예산은 5만 4천 특별 허가 쿠폰이야. 이 정도면 꽤 괜찮다고 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620321
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620321,
					"content": "5만 4천? 저번에 문 두드리던 미치광이가 제시한 값보다… 고작 1할 올랐잖아. 정말 쩨쩨하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620322
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620322,
					"content": "적은가? 내 생각엔 꽤 많은 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620323,
					"content": "뭘 모르는구나. 너희 카란자 알아? 녀석은 통이 훨씬 크지. 무려… 10만 8천이나 불렀다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620324
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620324,
					"content": "정말이야? 그렇게나 많이?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620325
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620325,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620326
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620326,
					"content": "…다, 당연하지. 내가 거짓말할 사람으로 보여?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620327
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620327,
					"content": "문 뒤에 있는 네가 보일 리가 없잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620328
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620328,
					"content": "(목소리에 힘이 없는 걸 보니까 우리를 속이려는 것 같아)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620329
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620329,
					"content": "#({NICKNAME}, 이제 어떻게 할까?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620330,
						740620340
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620330,
					"content": "(성의는 충분히 보였으니 적당히 하라고 하자)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620331
					]
				},
				{
					"id": 740620331,
					"content": "우리는 처음부터 솔직하게 말했어. 진짜 5만 4천밖에 없다구. 10만 8천은 너무하잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620332
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620332,
					"content": "네가 거절하면, 우… 우리도 어쩔 수 없이 포기하는 수밖에",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620333
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620333,
					"content": "조금만… 조금만 더 기다리면 가격이 오를 거야. 너희가 다음… 혹은 다다음에 올 때는 분명 더 높은 가격을 제시하겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620334
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620334,
					"content": "내 예상은 틀림없어! 분명히 오를 거야! 그러니 참아야만 해! 이렇게 호락호락하게 받아들일 수 없다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620335
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620335,
					"content": "너무 확신하는 거 아냐? 무슨 근거라도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620336
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620336,
					"content": "경험이 있으니까! 앞선 두 번의 경험을 통해 내가 흐름을 끊지만 않는다면 가격은 계속 오를 거라는 것이 증명됐어. 간단한 법칙이잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620337
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620337,
					"content": "그런 법칙이 어디 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620338
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620338,
					"content": "넌 아직 어리니까 모르는 것도 당연해. 아무튼 아직은 때가 아니야. 난 받아들일 생각 없으니까 이만 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620339
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620339,
					"content": "#으… 녀석이 마음을 바꿀 것 같진 않네. {NICKNAME}, 우리 돌아가서 나쿨한테 알려 주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620340,
					"content": "(우릴 갖고 노는 것 같은데 우리도 속이자)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620341
					]
				},
				{
					"id": 740620341,
					"content": "흑흑… 카란자라는 강력한 경쟁 상대가 있을 줄이야. 도무지 이길 수 없겠는걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620342
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620342,
					"content": "#{NICKNAME}, 우리 돌아가자. 제시한 금액이 너무 낮아서 상대가 거들떠보지도 않는다고 나쿨한테 알려야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620343
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620343,
					"content": "문 뒤에 있는 사람아, 그럼 카란자랑 이야기 잘 나눠. 우린 이만 가볼게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620344
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620344,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620345
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620345,
					"content": "…어? 그냥 가는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620346
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620346,
					"content": "이봐, 너희 아직 거기 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620347
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620347,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620348
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620348,
					"content": "이봐——그렇게 급하게 떠나지 말고 돌아와 봐——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620349
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620349,
					"content": "멀리서 부르는 소리가 들려서 왔어. 무슨 일이야? 우리보고 카란자를 데려와 달라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620350
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620350,
					"content": "어떻게 너희한테 그런 수고스러운 부탁을 하겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620351
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620351,
					"content": "#괜찮아. 어차피 가는 길에 들르는 건데 뭐. 그치, {NICKNAME}? 그 정도는 식은 죽 먹기야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620352
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620352,
					"content": "크흠… 요 녀석 제법 못됐네. 그럼 다시 본론으로 돌아가자. 너희가 아까 제시한 가격은 여전히 유효해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620353
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620353,
					"content": "지금은 유효하지만 시간이 지나면 또 모르죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620354
					]
				},
				{
					"id": 740620354,
					"content": "좋아, 받아들일게. 그럼 그 가격대로 하자. 다만 너희 의뢰인이 직접 와서 나랑 얘기해야 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620355
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620355,
					"content": "#좋았어! {NICKNAME}, 우리 나쿨한테 알려주러 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620356,
					"content": "(가격을 세게 후려치자!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620357
					]
				},
				{
					"id": 740620357,
					"content": "그… 그럼 2만 7천! 2만 7천 특별 허가 쿠폰은 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620358
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620358,
					"content": "2만 7천?! 지금 날 모욕하는 거야? 어째서 전보다 가격이 줄어든 건데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620359
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620359,
					"content": "그 문 두드리는 미치광이가 훨씬 높은 가격을 불렀을 때도 거절했다고. 너희가 제시한 가격에 응할 거라고 생각해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620360
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620360,
					"content": "#(어쩌지, {NICKNAME}? 이 가격을 밀고 나갈 거야?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620361,
						740620370
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620361,
					"content": "하락세가 시작되면 가격은 더 떨어질 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620362
					]
				},
				{
					"id": 740620362,
					"content": "그럴 리가? 나쿨은 이 방을 갖고 싶어 하는데? 녀석은 분명히 더 높은 가격을 제시할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620363
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620363,
					"content": "저기… 사람의 인내심엔 한계가 있거든? 네가 이미 가차 없이 두 번이나 거절했으니까 걔도 의욕을 잃을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620364
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620364,
					"content": "지금은 반토막 가격이지만 다음엔… 아! 다음은 없을지도 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620365
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620365,
					"content": "…잠깐 생각 좀 해볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620366
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620366,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620367
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620367,
					"content": "이봐, 문 뒤에 있는 사람. 생각 끝났어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620368
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620368,
					"content": "좋아, 받아들일게. 그럼 그 가격대로 하자. 다만 너희 의뢰인이 직접 와서 나랑 얘기해야 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620369
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620369,
					"content": "#좋았어! {NICKNAME}, 우리 나쿨한테 알려주러 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620370,
					"content": "(의뢰인의 예산까지 높이자)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620371
					]
				},
				{
					"id": 740620371,
					"content": "음… 그럼 5만 4천 특별 허가 쿠폰은 어때? 2만 7천의 두 배라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620372
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620372,
					"content": "5만 4천? 저번에 문 두드리던 미치광이가 제시한 값보다… 고작 1할 올랐잖아. 정말 쩨쩨하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620373
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620373,
					"content": "게다가 너희가 제시하는 가격은 계속 오르락내리락하고 있어…. 분명히 더 오를 여지가 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620374
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620374,
					"content": "조금만… 조금만 더 기다리면 가격이 오를 거야. 너희가 다음… 혹은 다다음에 올 때는 분명 더 높은 가격을 제시하겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620375
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620375,
					"content": "내 예상은 틀림없어! 분명히 오를 거야! 그러니 참아야만 해! 이렇게 호락호락하게 받아들일 수 없다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620376
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620376,
					"content": "적어도 지금은 받아들이지 않을 거니까 그만 돌아가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620377
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620377,
					"content": "#으… 녀석이 마음을 바꿀 것 같진 않네. {NICKNAME}, 우리 돌아가서 나쿨한테 알려 주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620378,
					"content": "(문을 열어 보자)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620379
					]
				},
				{
					"id": 740620379,
					"content": "…이봐! 너, 너 무슨 짓을 하려는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620380
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620380,
					"content": "문을 열어보려고. 이렇게 문을 맞대고 대화하면 상대방의 얼굴이 안 보이잖아. 협상이라면 당연히 대면하는 편이 좋지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620381
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620381,
					"content": "게다가 메로피드 요새에 있는 방은 사유재산이 아닐 텐데? 잠깐 머무는 거라면 우리도 들어갈 자격이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620382
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620382,
					"content": "안 돼! 당연히 안 되지! 너희는 몰라… 문 뒤에 어떤 어둠이 도사리고 있는지 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620383
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620383,
					"content": "으, 그러니까 난 다른 사람과 눈을 맞대고 말하면 긴장해서 말을 못 한다는 뜻이야. 그냥 계속 문을 사이에 두고 대화하자. 그래서 너희, 무슨 일로 왔다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620384,
						740620449
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620384,
					"content": "의뢰를 받고 당신과 협상하러 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620385
					]
				},
				{
					"id": 740620385,
					"content": "응, 의뢰인이 너랑 협상을 해달라고 하더라고. 이 방을 빌려주지 않을래? 물론 의뢰인은 특별 허가 쿠폰을 지불한다고 했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620386
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620386,
					"content": "저번에도 이런 일이 있었던 것 같은데… 정말이지 포기를 모르는군. 그 말투가 짜증 나는 녀석이 너희를 보낸 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620387
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620387,
					"content": "후, 녀석의 끈기를 봐서라도 생각해 볼 테니까… 가격을 불러봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620388
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620388,
					"content": "(잘됐네. 말이 아예 안 통하는 녀석은 아니었구나)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620389
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620389,
					"content": "(나쿨이 우리한테 예산을 알려줬잖아. 시작부터 그만큼을 제시할까? 아니면 한번 가격을 깎아볼까?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620390,
						740620427
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620390,
					"content": "(솔직하게 예산이 얼마인지 제시하자)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620391
					]
				},
				{
					"id": 740620391,
					"content": "응, 그럼 솔직하게 얘기할게. 의뢰인이 가지고 있는 예산은 5만 4천 특별 허가 쿠폰이야. 이 정도면 꽤 괜찮다고 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620392
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620392,
					"content": "5만 4천? 저번에 문 두드리던 미치광이가 제시한 값보다… 고작 1할 올랐잖아. 정말 쩨쩨하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620393
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620393,
					"content": "적은가? 내 생각엔 꽤 많은 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620394
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620394,
					"content": "뭘 모르는구나. 너희 카란자 알아? 녀석은 통이 훨씬 크지. 무려… 10만 8천이나 불렀다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620395
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620395,
					"content": "정말이야? 그렇게나 많이?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620396
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620396,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620397
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620397,
					"content": "…다, 당연하지. 내가 거짓말할 사람으로 보여?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620398
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620398,
					"content": "문 뒤에 있는 네가 보일 리가 없잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620399
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620399,
					"content": "(목소리에 힘이 없는 걸 보니까 우리를 속이려는 것 같아)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620400
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620400,
					"content": "#({NICKNAME}, 이제 어떻게 할까?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620401,
						740620411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620401,
					"content": "(성의는 충분히 보였으니 적당히 하라고 하자)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620402
					]
				},
				{
					"id": 740620402,
					"content": "우리는 처음부터 솔직하게 말했어. 진짜 5만 4천밖에 없다구. 10만 8천은 너무하잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620403,
					"content": "네가 거절하면, 우… 우리도 어쩔 수 없이 포기하는 수밖에",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620404,
					"content": "조금만… 조금만 더 기다리면 가격이 오를 거야. 너희가 다음… 혹은 다다음에 올 때는 분명 더 높은 가격을 제시하겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620405
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620405,
					"content": "내 예상은 틀림없어! 분명히 오를 거야! 그러니 참아야만 해! 이렇게 호락호락하게 받아들일 수 없다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620406
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620406,
					"content": "너무 확신하는 거 아냐? 무슨 근거라도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620407,
					"content": "경험이 있으니까! 앞선 두 번의 경험을 통해 내가 흐름을 끊지만 않는다면 가격은 계속 오를 거라는 것이 증명됐어. 간단한 법칙이잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620408
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620408,
					"content": "그런 법칙이 어디 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620409,
					"content": "넌 아직 어리니까 모르는 것도 당연해. 아무튼 아직은 때가 아니야. 난 받아들일 생각 없으니까 이만 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620410
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620410,
					"content": "#으… 녀석이 마음을 바꿀 것 같진 않네. {NICKNAME}, 우리 돌아가서 나쿨한테 알려 주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620411,
					"content": "(우릴 갖고 노네? 우리도 속이자)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620412
					]
				},
				{
					"id": 740620412,
					"content": "흑흑… 카란자라는 강력한 경쟁 상대가 있을 줄이야. 도무지 이길 수 없겠는걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620413,
					"content": "#{NICKNAME}, 우리 돌아가자. 제시한 금액이 너무 낮아서 상대가 거들떠보지도 않는다고 나쿨한테 알려야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620414,
					"content": "문 뒤에 있는 사람아, 그럼 카란자랑 이야기 잘 나눠. 우린 이만 가볼게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620415
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620415,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620416
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620416,
					"content": "…어? 그냥 가는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620417
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620417,
					"content": "이봐, 너희 아직 거기 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620418
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620418,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620419
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620419,
					"content": "이봐——그렇게 급하게 떠나지 말고 돌아와 봐——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620420
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620420,
					"content": "멀리서 부르는 소리가 들려서 왔어. 무슨 일이야? 우리보고 카란자를 데려와 달라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620421
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620421,
					"content": "어떻게 너희한테 그런 수고스러운 부탁을 하겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620422
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620422,
					"content": "#괜찮아. 어차피 가는 길에 들르는 건데 뭐. 그치, {NICKNAME}? 그 정도는 식은 죽 먹기야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620423
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620423,
					"content": "크흠… 요 녀석 제법 못됐네. 그럼 다시 본론으로 돌아가자. 너희가 아까 제시한 가격은 여전히 유효해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620424
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620424,
					"content": "지금은 유효하지만 시간이 지나면 또 모르죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620425
					]
				},
				{
					"id": 740620425,
					"content": "좋아, 받아들일게. 그럼 그 가격대로 하자. 다만 너희 의뢰인이 직접 와서 나랑 얘기해야 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620426
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620426,
					"content": "#좋았어! {NICKNAME}, 우리 나쿨한테 알려주러 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620427,
					"content": "(가격을 세게 후려치자!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620428
					]
				},
				{
					"id": 740620428,
					"content": "그… 그럼 2만 7천! 2만 7천 특별 허가 쿠폰은 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620429
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620429,
					"content": "2만 7천?! 지금 날 모욕하는 거야? 어째서 전보다 가격이 줄어든 건데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620430
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620430,
					"content": "그 문 두드리는 미치광이가 훨씬 높은 가격을 불렀을 때도 거절했다고. 너희가 제시한 가격에 응할 거라고 생각해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620431
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620431,
					"content": "#(어쩌지, {NICKNAME}? 이 가격을 밀고 나갈 거야?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620432,
						740620441
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620432,
					"content": "하락세가 시작되면 가격은 더 떨어질 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620433
					]
				},
				{
					"id": 740620433,
					"content": "그럴 리가? 나쿨은 이 방을 갖고 싶어 하는데? 녀석은 분명히 더 높은 가격을 제시할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620434
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620434,
					"content": "저기… 사람의 인내심엔 한계가 있거든? 네가 이미 가차 없이 두 번이나 거절했으니까 걔도 의욕을 잃을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620435
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620435,
					"content": "지금은 반토막 가격이지만 다음엔… 아! 다음은 없을지도 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620436
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620436,
					"content": "…잠깐 생각 좀 해볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620437
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620437,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620438
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620438,
					"content": "이봐, 문 뒤에 있는 사람. 생각 끝났어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620439
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620439,
					"content": "좋아, 받아들일게. 그럼 그 가격대로 하자. 다만 너희 의뢰인이 직접 와서 나랑 얘기해야 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620440
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620440,
					"content": "#좋았어! {NICKNAME}, 우리 나쿨한테 알려주러 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620441,
					"content": "(그럼 의뢰인의 예산까지 높이자)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620442
					]
				},
				{
					"id": 740620442,
					"content": "음… 그럼 5만 4천 특별 허가 쿠폰은 어때? 2만 7천의 두 배라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620443
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620443,
					"content": "5만 4천? 저번에 문 두드리던 미치광이가 제시한 값보다… 고작 1할 올랐잖아. 정말 쩨쩨하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620444
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620444,
					"content": "게다가 너희가 제시하는 가격은 계속 오르락내리락하고 있어…. 분명히 더 오를 여지가 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620445
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620445,
					"content": "조금만… 조금만 더 기다리면 가격이 오를 거야. 너희가 다음… 혹은 다다음에 올 때는 분명 더 높은 가격을 제시하겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620446
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620446,
					"content": "내 예상은 틀림없어! 분명히 오를 거야! 그러니 참아야만 해! 이렇게 호락호락하게 받아들일 수 없다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620447
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620447,
					"content": "적어도 지금은 받아들이지 않을 거니까 그만 돌아가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620448
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620448,
					"content": "#으… 녀석이 마음을 바꿀 것 같진 않네. {NICKNAME}, 우리 돌아가서 나쿨한테 알려 주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620449,
					"content": "(계속 문을 열어 보자)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620450
					]
				},
				{
					"id": 740620450,
					"content": "세상에! 왜 멈추지 않는 거야? 내가 말했잖아. 너희는 문 뒤에 도사리고 있는 어둠에 대해 모른다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620451
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620451,
					"content": "얼굴을 봐야 당신이 진짜 사람인지 확인하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620452
					]
				},
				{
					"id": 740620452,
					"content": "난 당연히 진짜 사람이지…. 그리고 진짜 사람이 아니더라도 상관없잖아? 나도 너희가 실존하는 존재인지 알 수 없지만, 그래도 우리는 이렇게 대화를 할 수 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620453,
						740620455
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620453,
					"content": "페이몬은 꼬집을 수 있으니까 진짜 같은데요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620454
					]
				},
				{
					"id": 740620454,
					"content": "좋아. 너희는 서로 진짜 가짜 여부를 확인할 수 있는 모양이군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620458
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620458,
					"content": "아무튼 난 문을 열지 않을 거니까 너희도 허튼짓하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620459
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620459,
					"content": "으… 그치만 우리는 너랑 협상하러 온 건데. 의뢰인은 네가 이 방을 빌려주길 바란다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620460
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620460,
					"content": "그럼 그 녀석한테 포기하라고 해. 어둠과 함께하는 사람은 나 혼자로도 충분하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620461
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620461,
					"content": "아까부터 계속 어둠 어둠 하던데, 그게 대체 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620462
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620462,
					"content": "목소리가 앳된 걸 보면 어린아이 같군. 그렇다면 모르는 게 정상이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620463
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620463,
					"content": "흥, 너 지금 이상한 말로 대충 넘어가려는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620464
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620464,
					"content": "하하, 그럴 수도 있겠지. 하지만 내가 할 말은 다 했어. 문은 안 열어줄 거고, 방도 안 빌려줄 거야. 어서 돌아가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620465
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620465,
					"content": "문 뒤에서 나는 소리가 사라졌다.\\n잠깐 기다렸다가 다시 문을 두드렸지만 아무런 반응도 없다. 안에는 애초에 사람이 없었던 것처럼 말이다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740620466
					]
				},
				{
					"id": 740620466,
					"content": "엥? 진짜 우리랑 얘기하고 싶지 않나 봐…. 의뢰는 실패한 건가…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620467
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620467,
					"content": "음, 어찌 됐든 일단 돌아가서 나쿨한테 알려주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620455,
					"content": "제가 누군가의 꿈속 인물일지도 모르죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620456
					]
				},
				{
					"id": 740620456,
					"content": "그럼 이건 내 꿈인가? 난 너희의 목소리를 들은 적이 있어…. 너희가 어떤 활기찬 여자아이와 얘기하는 소리였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620457
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620457,
					"content": "#내 꿈일 수도 있어! 그렇다면… 깨어나서도 {NICKNAME}(이)가 내 옆에 있었으면 좋겠다. 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620458
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620306,
					"content": "제가 누군지, 어디서 온 건지는 묻지 마세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620307
					]
				},
				{
					"id": 740620307,
					"content": "뭐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620308
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620308,
					"content": "(그렇게 말하면 어떡해? 일이 더 꼬일 수도 있잖아!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740620309,
					"content": "전 멜뤼진이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620310
					]
				},
				{
					"id": 740620310,
					"content": "#{M#그 목소리로 멜뤼진이라고? 그럼 난 탱탱 물범이겠다. 장난치지 마}{F#난 병에 걸리지 않았으니 다가오지 마}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620311
					],
					"speakerTitle": "아무개"
				},
				{
					"id": 740620311,
					"content": "(멜뤼진을 사칭하다니, 너무 억지잖아!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620312
					],
					"speakerTitle": "페이몬"
				}
			]
		},
