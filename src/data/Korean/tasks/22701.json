			},
			"dialogs": [
				{
					"id": 227010201,
					"content": "무슨 말이 하고 싶은 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010202
					]
				},
				{
					"id": 227010202,
					"content": "우리 사형께서 말씀하시는데 예의 좀 지키지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010203
					],
					"speakerTitle": "소작아"
				},
				{
					"id": 227010203,
					"content": "사매, 내가 먼저 말을 걸었잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010204
					],
					"speakerTitle": "손우"
				},
				{
					"id": 227010204,
					"content": "절운간에 선인을 만나러 온 놈일지도 모르잖아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010205
					],
					"speakerTitle": "소작아"
				},
				{
					"id": 227010205,
					"content": "사매, 알겠으니까 넌 일단 여기서 좀 쉬어. 난 이 친구와 이야기 좀 나누고 올게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010206
					],
					"speakerTitle": "손우"
				},
				{
					"id": 227010206,
					"content": "사형, 제 앞에서 말씀 못 할 일이 있어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010207
					],
					"speakerTitle": "소작아"
				},
				{
					"id": 227010207,
					"content": "별일 아니야. 안 듣고 싶을걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010208
					],
					"speakerTitle": "손우"
				},
				{
					"id": 227010208,
					"content": "흥, 또 고화파 일이겠지…. 알겠어요, 제가 듣는 게 싫으시면 안 들을게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010209
					],
					"speakerTitle": "소작아"
				},
				{
					"id": 227010209,
					"content": "이봐, 나와 저쪽으로 가서 자세한 이야기를 나누지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "손우"
				}
			]
		},
