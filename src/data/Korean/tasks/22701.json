			"dialogs": [
				{
					"id": 227010601,
					"content": "당신 사형의 두통을 치료하려고요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010602
					]
				},
				{
					"id": 227010602,
					"content": "사형, 약재를 채집할 거면 제게 시키시지, 왜 남한테 부탁하셨어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010603
					],
					"speakerTitle": "소작아"
				},
				{
					"id": 227010603,
					"content": "누군지도 모르는 사람인데 혹시…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010604
					],
					"speakerTitle": "소작아"
				},
				{
					"id": 227010604,
					"content": "…됐어. 사매, 이 친구가 우릴 도와줬으니 그렇게 말하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010605
					],
					"speakerTitle": "손우"
				},
				{
					"id": 227010605,
					"content": "고마워, 이건 답례니까 받아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010606
					],
					"speakerTitle": "손우"
				},
				{
					"id": 227010606,
					"content": "받고 어서 가. 사형은 두통이 도지셔서 찬 바람을 쐬면 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010607
					],
					"speakerTitle": "소작아"
				},
				{
					"id": 227010607,
					"content": "사형, 저쪽으로 가서 바람을 피해요. 제가 설탕물 좀 끓일게요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소작아"
				}
			]
