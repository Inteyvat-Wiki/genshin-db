			},
			"dialogs": [
				{
					"id": 250220501,
					"content": "음, 이 꽃 냄새가 참 좋네. 상쾌한 향기가 나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220504
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250220504,
					"content": "호레이? 야… 으악! 벌써 먹었구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220505
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250220505,
					"content": "(호레이가 청심을 삼키며 눈을 깜빡인다…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220506
					],
					"speakerTitle": "호레이"
				},
				{
					"id": 250220506,
					"content": "호레이가 갑자기 몸을 돌려 옆에 있는 과일 한 그릇을 단숨에 해치운다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250220507
					]
				},
