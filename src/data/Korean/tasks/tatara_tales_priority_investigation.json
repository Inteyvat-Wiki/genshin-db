	"talks": [
		{
			"id": 7211501,
			"completionStepIds": [
				7211502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211502",
							"2"
						],
						"stepId": 7211502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"자비에"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150101,
					"content": "#{F#소녀}{M#소년}, 안녕! 「미카게 용광로」에 대해 좋은 소식 하나와 나쁜 소식 하나가 있어, 뭐부터 들을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150102,
						721150106
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150102,
					"content": "좋은 소식이요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150103
					]
				},
				{
					"id": 721150103,
					"content": "좋은 소식은, 용광로 중심부의 파손 상태가 생각보다 심각하지 않다는 거야. 아직은 처리할 수 있는 상황이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150104
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150104,
					"content": "나쁜 소식은, 용광로 안을 들쑤시고 다니는 우인단은 이 소식을 달가워하지 않는다는 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150105
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150105,
					"content": "우인단은 아직도 「재앙신」의 코어에 손댈 방법을 찾고 있는 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150111,
					"content": "이대로 우인단을 내버려 뒀다간, 「재앙신」의 힘이 언젠가는 정말 통제를 잃고 이 섬을, 그리고 섬에 있는 우리까지 함께 하늘로 보내버릴 거라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150112
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150112,
					"content": "우리가 만약 우인단에 모든 주의력을 빼앗겨버리면, 배리어에 갇힌 「재앙신」도 언젠가는 한계치에 도달해버리고 말 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150113
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150113,
					"content": "그러니까, 동시에 양쪽 다 해결해야 하는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150114
					]
				},
				{
					"id": 721150114,
					"content": "음… 쉽게 말해, 학술적인 관점에서 객관적으로 설명하려면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150115
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150115,
					"content": "현재 우리에겐 우인단과 「재앙신」 두 개의 문제가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150116
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150116,
					"content": "하지만 「미카게 용광로」의 상황에 따르면, 우리가 두 개의 문제 중 하나를 해결할 때 시행 과정에서 높은 확률로 다른 문제도 직면하게 된다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150117
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150117,
					"content": "그러니까 우리가 직면하고 있는 현실적인 상황은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150118
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150118,
					"content": "「그렇다」는 거죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150119
					]
				},
				{
					"id": 721150119,
					"content": "윽, 맞아, 그래. 동시에 양쪽을 다 해결해야만 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150120
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150120,
					"content": "그래도 천천히 진행하자, 리월 사람들은 종종 「급할수록 돌아가라」라고 하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150121
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150121,
					"content": "리월 속담도 알아요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150122
					]
				},
				{
					"id": 721150122,
					"content": "예전에 리월에 가본 적이 있거든, 여행 기념품인 셈이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150123
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150123,
					"content": "이런 기념품은 아직 많아, 근데 몬드의 기념품은 다 마셔버렸어… 정말 맛있더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150124
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150124,
					"content": "됐어, 이제 본론으로 들어가자. 이 「미카게 용광로」 사태를 해결하기 위해 세운 계획이 있는데 네 도움이 꼭 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150125,
						721150127
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150125,
					"content": "문제없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150126
					]
				},
				{
					"id": 721150126,
					"content": "하하! 난 네 이런… 시원시원하고 통쾌한 성격이 정말 마음에 든다구, 훌륭해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150131,
					"content": "크흠, 본론으로 돌아가자. 이 「탐지 비콘」들을 받아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150132
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150132,
					"content": "난 네게 이 「탐지 비콘」을 지정된 곳에 설치해줬으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150133
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150133,
					"content": "이 비콘들은 「미카게 용광로」 내부에 있는 「재앙신」의 힘에 대한 농도와 분포 데이터를 수집할 수 있어. 그 데이터를 기반으로 더 상세한 계획을 세울 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150134,
						721150136
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150134,
					"content": "맡겨주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150135
					]
				},
				{
					"id": 721150135,
					"content": "그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150141,
					"content": "설치 포인트를 지도에 표시해둘게. 그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150136,
					"content": "이 비콘들은 대체 무슨 원리죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150137
					]
				},
				{
					"id": 721150137,
					"content": "쉽게 말해… 원소의 힘을 기반한 원리야. 각종 에너지에 대해 계량과 산측을 할 수 있는 기기지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150138
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150138,
					"content": "「쉽게 말해」… 쉽게 말하고 싶긴 하지만 도저히 쉽게 설명할 수 없는 운행 방식이라. 그래, 7개의 원소에 대한 설명부터 하면 되겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150139
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150139,
					"content": "돼, 됐어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150140
					]
				},
				{
					"id": 721150140,
					"content": "알겠어, 정 그렇다면",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150127,
					"content": "뭐 좋은 거 주나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150128
					]
				},
				{
					"id": 721150128,
					"content": "좋은 거라… 그건 당연히 아직 발견되지 않은 섬의 보물들과 「미카게 용광로」의 「자투리 물건」들이겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150129
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150129,
					"content": "생각해 봐, 이나즈마 최대의 제련 시설인 「미카게 용광로」에는 반드시… 음… 구경할만한 좋은 것들이 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150130
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150130,
					"content": "물론, 「신의 눈」이 없는 난 「미카게 용광로」에 들어갈 수 없어서, 내부 상황은 잘 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150106,
					"content": "나쁜 소식이요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150107
					]
				},
				{
					"id": 721150107,
					"content": "나쁜 소식은 우인단이 아직도 「미카게 용광로」 내부를 들쑤시고 다닌다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150108
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150108,
					"content": "우인단은 아직도 「재앙신」의 코어에 손댈 방법을 찾고 있는 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150109
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150109,
					"content": "좋은 소식은, 용광로 중심부의 파손 상태가 생각보다 심각하지 않아서, 아직은 처리할 수 있는 상황이라는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150110
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721150110,
					"content": "하지만 우인단은 분명 이 소식을 달가워하지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "자비에"
				}
			]
		},
