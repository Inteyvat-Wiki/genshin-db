			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"알베도"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100501,
					"content": "우리보고 도둑이라니. 자기들이야말로 도둑이면서!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100502,
					"content": "정말 빨리도 왔네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100503,
						412100504
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100503,
					"content": "알베도, 네가 도둑이었어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100505
					]
				},
				{
					"id": 412100505,
					"content": "그럴 리가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100506
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100506,
					"content": "저 녀석들이 말한 게 이 검 같은데. 대체 어떻게 된 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100507,
					"content": "뭐야, 그 표정은? 내가 훔쳤을 리 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100508
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100508,
					"content": "얼마 전에 기사단이 몬드성 밖에서 보물 사냥단 무리를 잡았는데, 그들이 불법으로 가져온 장물도 같이 압수당했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100509
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100509,
					"content": "이 검도 그중 하나였어. 장물인데 찾아가는 사람도 없고 어디서 왔는지도 모른 채 계속 창고에 방치돼 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100510
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100510,
					"content": "창고에 뭐 좀 가지러 갔을 때 발견한 거야. 솔직히 이 정도로 낡은 검은 기껏해야 연금술 재료로만 쓰일 수 있을 걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100511
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100511,
					"content": "야, 그래도 장물을 자기 물건인 것처럼 말하면 안 되지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100512
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100512,
					"content": "그래서? 그냥 가져와 버린 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100513
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100513,
					"content": "응. 원래는 실험용으로 쓰려고 했는데, 조사하던 중에 이 검의 진짜 유래를 알게 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100514
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100514,
					"content": "이 낡아 보이는 무기는 지금은 고인이 된 한 대장장이가 만든 전설의 마검이래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100515
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100515,
					"content": "마검?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100516
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100516,
					"content": "소문에 의하면 그 대장장이는 검을 만들고 난 뒤 실종됐고, 검도 행방불명 됐대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100517
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100517,
					"content": "압수된 물건 중에 있던 걸 보면, 아마 보물 사냥단이 훔쳐 간 바람에 지금까지 못 찾았던 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100518
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100518,
					"content": "으악! 검을 만든 사람이 실종됐다고?! 소름!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100519
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100519,
					"content": "괜히 저주 받은 마검이 아니네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100520
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100520,
					"content": "맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100521
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100521,
					"content": "인간이 이런 마검을 만들어 낼 수 있다니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100522
					]
				},
				{
					"id": 412100522,
					"content": "혹시, <color=#00E1FFFF>「두린」</color>과 이 설산에 관한 이야기 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100523
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100523,
					"content": "<color=#00E1FFFF>「두린」</color>은 수백 년 전 <color=#00E1FFFF>「바람 신 바르바토스」</color>와 <color=#00E1FFFF>「드발린」</color>이 함께 무찌른 몬드를 위협했던 흑룡이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100524
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100524,
					"content": "마지막까지 격렬히 싸우다 패배한 두린은 하늘에서 새하얀 눈 속으로 추락했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100525
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100525,
					"content": "설산의 눈이 일 년 내내 녹지 않는 건 아주 기묘한 일이야. 두린이 이곳으로 떨어진 건 과연 우연일까, 필연일까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100526
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100526,
					"content": "설마 필연이라는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100527
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100527,
					"content": "설산을 무덤으로 택한 건, 모든 걸 봉인하는 얼음의 힘으로 두린의 독을 억제하려는 건지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100528
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100528,
					"content": "바르바토스와 같은 신이라면 분명 이런 방법을 생각해냈을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100529
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100529,
					"content": "우와… 바르바토스가 그렇게 대단하다고…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100530
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100530,
					"content": "내 추측일 뿐이라 근거는 없어. 하지만 이 설산과 두린 사이에 밀접한 관계가 있다는 건 확실해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100531
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100531,
					"content": "그리고 네 손에 있는 그 검엔 두린의 유해가 들어있을 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100532
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100532,
					"content": "용의 유해가 있다고?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100533
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100533,
					"content": "응. 죽은 드래곤의 눈, 발톱, 비늘을… 가루로 만들어 검신에 바른 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100534
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100534,
					"content": "이렇게 하면 두린의 더러운 독이 검에 녹아들어 그 위력의 원천이 될 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100535
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100535,
					"content": "이건 아주 수준 높은 기술이 필요하니, 대장장이는 검을 완성한 후 분명 너무 감격스러워서 직접 검을 휘둘러 봤을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100536
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100536,
					"content": "이 검을 사용했다면 검에 있던 오염된 힘이 그의 몸속으로 흘러 들어갔을 테지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100537
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100537,
					"content": "평범한 사람은 이런 힘에 대항할 수 없어. 저주받은 뒤 정신착란이 온 대장장이는 미친 듯이 날뛰다 어딘가에서 사고를 당했을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100538
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100538,
					"content": "으익…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100539
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100539,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100540
					]
				},
				{
					"id": 412100540,
					"content": "드발린의 눈물을 정화시킨 너한텐 아주 보긴 드문 힘이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100541
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100541,
					"content": "그 힘 때문에 넌 독에 침식당하지 않고, 위험 요소들을 완벽히 제거할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100542
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100542,
					"content": "그러니까 오직 너만이 이 검을 사용할 수 있는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100543
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100543,
					"content": "아무리 그래도 이 검은 너무… 앗!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100544
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100544,
					"content": "검, 검이 번쩍인 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100545
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100545,
					"content": "나에겐 실험을 시작하라는 신호라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100546
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100546,
					"content": "이 검은 아직 약해. 하지만 힘을 흡수할 수 있지. 이런 방법으로 검은 계속 강해질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100547
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100547,
					"content": "어떤 의미에서 이건 「생물」인 셈이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100548
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100548,
					"content": "여행자, 이걸 가지고 마음껏 모험을 펼쳐봐. 네가 이 검을 성장시켜줬으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100549
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100549,
					"content": "머지 않은 미래에 모든 가설들이 입증될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100504,
					"content": "설마 네가 저 녀석들 물건 훔친 건 아니지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100505
					]
				}
			]
		}
	]
