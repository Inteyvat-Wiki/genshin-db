			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"알베도"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100301,
					"content": "알베도——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100302,
					"content": "안녕, 우리 또 왔어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100303
					]
				},
				{
					"id": 412100303,
					"content": "응? 왜 다시 돌아왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100304
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100304,
					"content": "길이라도 잃은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100305
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100305,
					"content": "아니거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100306,
						412100307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100306,
					"content": "가던 길에 설탕이 부탁해서 네 비밀을 조사하러 왔어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				},
				{
					"id": 412100308,
					"content": "음? 비밀?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100309
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100309,
					"content": "아아아, 뭐 하는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100310,
					"content": "이런 건 몰래몰래 해야지! 다 말해버리면 어떡해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100311,
					"content": "어차피 알베도는 못 속일 걸",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100312
					]
				},
				{
					"id": 412100312,
					"content": "으… 아무리 그래도 그렇지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100313,
					"content": "마침 잘 왔어. 너한테 부탁할 게 있거든, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100314
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100314,
					"content": "받아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100315
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100315,
					"content": "엥? 이게 뭔데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100316,
					"content": "보다시피, 한손검이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100317,
						412100318
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100317,
					"content": "무기도 만들 줄 알아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100319,
					"content": "검은 내가 만든 게 아니야. 하지만 조금 전에 연금술을 더했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100320
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100320,
					"content": "한번 써볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100321
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100321,
					"content": "어? 나한테 주는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100322
					]
				},
				{
					"id": 412100322,
					"content": "연구해본 결과, 이 검은 특이하게도 너만 사용할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100323
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100323,
					"content": "지금 당장 검에 관한 데이터가 필요하니까, 전투할 때 이걸 많이 사용해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100324
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100324,
					"content": "잠깐, 여행자만 사용할 수 있는 검이라니, 대체 어떻게 된 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100325
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100325,
					"content": "부작용 있는 거 아니지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100326
					]
				},
				{
					"id": 412100326,
					"content": "예리하군. 이 검은 확실히 좀 특이해. 어떤 저주를 받았거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100327
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100327,
					"content": "평범한 사람은 절대 이 한손검을 사용할 수 없지만, 넌 달라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100328
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100328,
					"content": "뭐…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100329
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100329,
					"content": "이 저주받은 검은 유독 너한테만 해를 끼치지 않아. 그렇다면 너 말고 누구한테 부탁하겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100330
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100330,
					"content": "말로 설명하는 건 여기까지. 근처에 있는 몬스터로 확인해봐. 말보단 직접 해보는 게 빠를 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "알베도"
				},
				{
					"id": 412100318,
					"content": "연금술사가 대장장이 일도 해야 하다니",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100319
					]
				},
				{
					"id": 412100307,
					"content": "설탕이 너한테 말 못 할 비밀이 있다던데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100308
					]
				}
			]
		},
