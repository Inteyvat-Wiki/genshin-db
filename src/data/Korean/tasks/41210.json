				"points": []
			},
			"dialogs": [
				{
					"id": 412100401,
					"content": "찾았다! 저 녀석이 갖고 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100402
					],
					"speakerTitle": "험악한 남자"
				},
				{
					"id": 412100402,
					"content": "어서 물건을 내놔, 도둑놈아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100403
					],
					"speakerTitle": "험악한 남자"
				},
				{
					"id": 412100403,
					"content": "엥? 이렇게 추운 곳에도 보물 사냥단이?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100404,
					"content": "잔말 말고 빨리 내놔!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100405
					],
					"speakerTitle": "험악한 남자"
				},
				{
					"id": 412100405,
					"content": "조심해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "알베도"
				}
			]
		},
		{
			"id": 4121005,
			"completionStepIds": [
				4121008
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121008",
							"2"
