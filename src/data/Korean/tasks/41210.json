				}
			]
		},
		{
			"id": 4121002,
			"completionStepIds": [
				4121002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121002",
							"2"
						],
						"stepId": 4121002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"설탕"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412100201,
					"content": "어? 설탕이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100202,
					"content": "너도 설산을 탐험하러 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100203,
					"content": "으앗! 깜짝이야…. 연구 리포트를 생각하고 있을 때 갑자기 놀래키지 말아주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100204
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412100204,
					"content": "그냥 가만히 멍 때리며 서 있길래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100205,
					"content": "그, 그럴 리가요. 새로 개발된 씨앗이 4배나 큰 달콤달콤꽃의 이름을 생각 중이었다구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100206,
						412100207
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412100206,
					"content": "맛있겠다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				},
				{
					"id": 412100208,
					"content": "오오? 관심 있으세요?! 새로운 성과가 나오면 꼭 보여드릴게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100209
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412100209,
					"content": "설산에 오는 것만 아니면 항상 지니고 있었을 텐데, 아쉽네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100210
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412100210,
					"content": "참, 넌 원래 몬드성에서 연구하잖아. 왜 여기까지 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100211,
					"content": "저랑 데마로우스 씨는 알베도 님을 도와 실험 데이터를 정리하고 있었어요. 데마로우스 씨는 방금 가셨는데, 못 보셨어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100212
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412100212,
					"content": "못 봤는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100213,
					"content": "알베도 님에 비하면 자신은 데이터에 대해 너무 둔한 거 같다고 하셨어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100214
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412100214,
					"content": "알베도 님이 한눈에 알아보시는 걸 저흰 오랫동안 봐야 알거든요. 아마 학식과 경험의 차이겠죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100215
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412100215,
					"content": "우울하셨는지 잠깐 산책 좀 다녀오신다길래 저 혼자 남은 일을 마무리하고 있었답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100216
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412100216,
					"content": "(데마로우스 씨가 일부러 그런 것 같은데…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100217
					]
				},
				{
					"id": 412100217,
					"content": "일 끝내고 주변을 좀 돌아보려고 했는데, 보고서에서 재밌는 데이터를 발견했지 뭐예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100218
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412100218,
					"content": "휴… 제 비밀 탐험은 또 미뤄지겠네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100219
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412100219,
					"content": "비밀 탐험? 무슨 비밀인데?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100220,
					"content": "아… 저기 혹시, 지금 한가하세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100221
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412100221,
					"content": "응응! 아무 일도 없어서 그냥 돌아다니고 있었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100222
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100222,
					"content": "그럼 저 좀 도와주시면 안 될까요? 사실… 알베도 님이 저랑 데마로우스 씨한테 뭔가 숨기고 있는 거 같거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100223
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412100223,
					"content": "알베도는 너희들의 스승이잖아! 스승이 학생한테 숨길 게 뭐 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100224
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100224,
					"content": "그렇긴 한데, 진짜 뭔가 숨기고 계신 거 같다니깐요…. 분명 연금술에 관련된 엄청난 거겠죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100225
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412100225,
					"content": "아직 확실한 것도 아닌데 왜 그렇게 확신하는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100226
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100226,
					"content": "왜냐면 저랑 데마로우스 씨 모두 연금술에 미친 연구자잖아요. 만약 다른 거라면 저희한테 숨길 필요가 없죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100227
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412100227,
					"content": "아… 듣고 보니 일리 있네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100228
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100228,
					"content": "알베도 님이 뭘 숨기고 계시는지 좀 조사해주세요! 궁금해서 도저히 못 참겠어요! 부탁드려요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100229
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412100229,
					"content": "음… 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100230,
						412100231
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100230,
					"content": "설탕이 알고 싶다면 기꺼이 찾아주지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100232,
					"content": "와아——! 정말요? 진짜 고마워요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412100233
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412100233,
					"content": "좋아~ 그럼 우리 다녀올게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412100231,
					"content": "나도 알베도가 뭘 숨기고 있는지 알고 싶어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100232
					]
				},
				{
					"id": 412100207,
					"content": "그거 먹을 수 있는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412100208
					]
				}
			]
		},
		{
			"id": 4121003,
