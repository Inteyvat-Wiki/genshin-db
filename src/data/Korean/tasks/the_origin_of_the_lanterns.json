				"objectNames": [
					"강주"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413110601,
					"content": "#{NICKNAME}, 저기 봐! 돌이 공중에 떠서 쇠사슬을 팽팽하게 당기고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413110602,
					"content": "쇠사슬로 묶어두지 않는다면 어디로 날아갈까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110603
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413110603,
					"content": "저게 바로 「명소등」을 만드는데 쓰는 부유석이야. 「명소 시장」 전체가 저 돌을 중심으로 배치돼 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110604
					],
					"speakerTitle": "강주"
				},
				{
					"id": 413110604,
					"content": "어, 넌 누구…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110605
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413110605,
					"content": "난 강주야. 명소등의 건설 진척 통계를 담당하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110606
					],
					"speakerTitle": "강주"
				},
				{
					"id": 413110606,
					"content": "보아하니 리월에서 해등절을 보는 게 처음이구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110607
					],
					"speakerTitle": "강주"
				},
				{
					"id": 413110607,
					"content": "맞아… 어떻게 알았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110608
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413110608,
					"content": "작년엔 이상한 마스코트를 달고 다니는 여행자를 못 본 것 같거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110609
					],
					"speakerTitle": "강주"
				},
				{
					"id": 413110609,
					"content": "당신이 말한 「명소등」은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110610
					]
				},
				{
					"id": 413110610,
					"content": "해등절 때 사람들이 손에 들고 날리는 작은 등불은 「소등」이고, 모든 리월 사람들이 함께 만드는 거대한 등불이 바로 「명소등」이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110611
					],
					"speakerTitle": "강주"
				},
				{
					"id": 413110611,
					"content": "「명소 시장」의 노점은 리월 상인들이 1년에 1번 돈을 위해서가 아닌 오직 「명소등」에 필요한 자재를 조달하기 위해 열리지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110612
					],
					"speakerTitle": "강주"
				},
				{
					"id": 413110612,
					"content": "그 「명소 시장」엔 맛있는 것도 많겠네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110613
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413110613,
					"content": "당연하지. 내 생각에 해등절은 리월의 별미를 맛볼 수 있는 최고의 명절이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110614
					],
					"speakerTitle": "강주"
				},
				{
					"id": 413110614,
					"content": "해등절은 리월에서 가장 성대한 명절이잖아. 여기서 제대로 솜씨 한번 발휘하면, 입소문 타는 건 시간문제거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110615
					],
					"speakerTitle": "강주"
				},
				{
					"id": 413110615,
					"content": "그러니까 돈은 안되더라도 다들 젖먹던 힘을 다해 해등절에서 솜씨를 뽐내는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110616
					],
					"speakerTitle": "강주"
				},
				{
					"id": 413110616,
					"content": "리월 사람들은 여러모로 참 대단해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110617
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413110617,
					"content": "더 궁금한 게 있으면, 해등절 책임자인 <color=#00E1FFFF>망아</color> 씨를 찾아가 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110618
					],
					"speakerTitle": "강주"
				},
				{
					"id": 413110618,
					"content": "보통 「명소 시장」 근처에 있으니까, 무슨 일 있으면 그녀에게 물어보면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110619
					],
					"speakerTitle": "강주"
				},
				{
					"id": 413110619,
					"content": "어느 가게 음식이 제~일 맛있는지도 알고 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110620
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413110620,
					"content": "물론이지, 해등절과 관련된 모든 일은 망아 씨가 다 꿰고 있다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110621
					],
					"speakerTitle": "강주"
				},
				{
					"id": 413110621,
					"content": "알았어! 빨리 「명소 시장」에 가서 <color=#00E1FFFF>망아</color> 씨를 찾아보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110622
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413110622,
					"content": "그런 다음… 제일 맛있는 가게로 가서 배터지게 먹는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 4131107,
			"completionStepIds": [
				4131107
			],
