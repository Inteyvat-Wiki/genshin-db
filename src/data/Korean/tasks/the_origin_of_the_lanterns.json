			"dialogs": [
				{
					"id": 400010203,
					"content": "억만 모라를 줘도 안 팔아요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010204
					]
				},
				{
					"id": 400010205,
					"content": "제가 생각하고 있는 만큼 못 주실 텐데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010206
					]
				},
				{
					"id": 400010202,
					"content": "젊은이, 미안하지만 옆에 그 작은 녀석은 얼마에 파는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010203,
						400010205
					],
					"speakerTitle": "박래"
				},
				{
					"id": 400010204,
					"content": "억만 모라 줘도 안 팔아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400010206,
					"content": "그 이상한 대답은 뭐야!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400010207,
					"content": "사실… 날 얼마로 생각하고 있는지 궁금하긴 한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400010208,
					"content": "그냥 「억만 모라를 줘도 안 팔겠다는」 뜻으로 받아들일게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400010209,
					"content": "헤헤헤헤, 요즘 주머니 사정이 여의치 않아서 못 사겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010210
					],
					"speakerTitle": "박래"
				},
				{
					"id": 400010210,
					"content": "진귀한 보물을 파는 것도 아니고, 그저 평범한 상인일 뿐이니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010211
					],
					"speakerTitle": "박래"
				},
				{
					"id": 400010211,
					"content": "…말투가 엄청 수상한데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400010212,
					"content": "그런 말 마. 꼬마야, 사탕 하나 줄까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010213
					],
					"speakerTitle": "박래"
				},
				{
					"id": 400010220,
					"content": "페이몬은 참 한결같아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 400010213,
					"content": "#{NICKNAME}, 이 사람 좋은 사람 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400010214,
					"content": "참, 너희도 혹시 「해등절」 때문에 리월항에 온 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010215
					],
					"speakerTitle": "박래"
				},
				{
					"id": 400010215,
					"content": "올해는 20년 만에 가장 큰 「부유석」으로 「명소등」을 띄운다고 하니, 기대해도 좋을걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010216
					],
					"speakerTitle": "박래"
				},
				{
					"id": 400010216,
					"content": "상상도 못 할 만큼 크다고 하던데, 신화 속 구름 위를 떠다니는 성이 진짜 있다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010217
					],
					"speakerTitle": "박래"
				},
				{
					"id": 400010217,
					"content": "그 밑에 비슷한 크기의 부유석을 매달아 놓은 걸 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010218
					],
					"speakerTitle": "박래"
				},
				{
					"id": 400010218,
					"content": "왠지 대단할 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400010219,
					"content": "하하하, 기회 되면 또 보자구. 리월에 온 걸 환영해——이 말이 <color=#00E1FFFF>리월항</color>을 대표할 순 없지만, 우리 가게는 언제나 너흴 환영한다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "박래"
				}
			]
		},
