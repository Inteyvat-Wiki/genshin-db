				"points": []
			},
			"dialogs": [
				{
					"id": 413110101,
					"content": "곧 해등절이네~ 올해는 객잔을 좀 꾸며볼까…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110102
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 413110102,
					"content": "해등절이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110103
					]
				},
				{
					"id": 413110103,
					"content": "모르니? 매년 첫 보름날 밤이 바로 리월의 「해등절」이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110104
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 413110104,
					"content": "영웅을 기리기 위한 날로, 밤이 되면 사람들은 「소등」과 「명소등」을 하늘로 날려 보내",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110105
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 413110105,
					"content": "그 등불엔 「불꽃이 대대로 전해지듯 미덕도 영원히 사라지지 않는다」는 의미가 담겨있어. 우린 밤바다 위의 밝은 등불이 영웅들의 영혼을 고향으로 인도해 준다고 믿지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110106
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 413110106,
					"content": "와… 되게 성대한 명절인가 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413110107,
					"content": "맛있는 게 잔뜩 있을지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413110108,
					"content": "#{NICKNAME}, 내 말 무슨 뜻인지 알지?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413110109,
					"content": "해등절에 참가하려고? 마침 잘됐네. 「해등절」 당일 전까지 한동안 계속 명절 분위기일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110110
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 413110110,
					"content": "이 기간에 사람들은 평안하길 빌고 액운을 제거해. 리월 말론 이걸 「옛것을 보내고 새것을 맞는다」라고 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110111
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 413110111,
					"content": "참가하고 싶은 거라면, 지금 가도 늦지는 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110112
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 413110112,
					"content": "그리고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110113
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 413110113,
					"content": "그리고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110114
					]
				},
				{
					"id": 413110114,
					"content": "괜찮다면… 음… 소한테 한번 같이 가자고 해보는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110115
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 413110115,
					"content": "우리랑은 친한 사이가 아니라 물어보기 좀 그래. 그래도 너희는 많이 친해진 것 같던데, 차라리…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110116
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 413110116,
					"content": "하지만 지금 소의 기분을 생각하면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413110117
					]
				},
				{
					"id": 413110117,
					"content": "그래, 요 며칠은 안 건드리는 게 좋을 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 413110118,
					"content": "그렇구나…. 괜찮아, 그냥 해본 말이니까 너흰 빨리 <color=#00E1FFFF>리월항</color>으로 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110119
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 413110119,
					"content": "너무 늦으면 사람들이 바글바글해서 구경하기 힘들 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413110120
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 413110120,
					"content": "어서 가봐, 해등절 재밌게 즐기렴!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르 고데트"
				}
			]
		},
