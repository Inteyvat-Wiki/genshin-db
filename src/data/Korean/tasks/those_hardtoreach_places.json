				"points": []
			},
			"dialogs": [
				{
					"id": 700030501,
					"content": "진짜 고양이가 있었어. 근데 어떻게 여기까지 온 걸까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700030502,
					"content": "야옹… 야옹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030503,
						700030504
					],
					"speakerTitle": "길 잃은 고양이"
				},
				{
					"id": 700030503,
					"content": "야옹야옹",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				},
				{
					"id": 700030505,
					"content": "야옹, 야옹!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030506
					],
					"speakerTitle": "길 잃은 고양이"
				},
				{
					"id": 700030506,
					"content": "어… 네가 하는 말을 못 알아들은 거 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700030507,
					"content": "일단 요 녀석을 데리고 내려가자. 아라미 씨가 요 녀석 주인을 알지도 모르잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700030504,
					"content": "길을 잃었니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				}
			]
		},
		{
			"id": 7000306,
			"completionStepIds": [
				7000308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000308",
							"2"
						],
						"stepId": 7000308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아라미"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030601,
					"content": "정말 죄송한데 본 적이 없어요. 봤다면 기억에 남았을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030602
					],
					"speakerTitle": "아라미"
				},
				{
					"id": 700030602,
					"content": "그렇군요. 그 녀석이 꽃잎을 좋아해서 여기 왔을 줄 알았어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030603
					],
					"speakerTitle": "마가렛"
				},
				{
					"id": 700030603,
					"content": "고양이를 찾고 계세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030604
					]
				},
				{
					"id": 700030604,
					"content": "야옹… 야옹!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030605
					],
					"speakerTitle": "길 잃은 고양이"
				},
				{
					"id": 700030605,
					"content": "이 소리는… 나비? 요 녀석, 어디 갔었던 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030606
					],
					"speakerTitle": "마가렛"
				},
				{
					"id": 700030606,
					"content": "지붕에 있더라고요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030607
					]
				},
				{
					"id": 700030607,
					"content": "역시 내 생각이 맞았군… 고마워. 나비는 꽃잎을 너무 좋아해. 꽃잎이 온 성을 뒤덮는 윈드블룸 축제에는 사람을 미치게 만들지. 나비를 찾아줘서 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030608
					],
					"speakerTitle": "마가렛"
				},
				{
					"id": 700030608,
					"content": "다음에 「캣테일 술집」에 오면 한 잔 쏠게. 아, 당연히 무알코올 음료로",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030609,
						700030610
					],
					"speakerTitle": "마가렛"
				},
				{
					"id": 700030609,
					"content": "아, 그렇게 된 거군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				},
				{
					"id": 700030611,
					"content": "후후, 어쨌든 정말 고마워. 그럼 또 보자. 윈드블룸 축제를 신나게 즐기렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030612
					],
					"speakerTitle": "마가렛"
				},
				{
					"id": 700030612,
					"content": "고양이가 꽃잎을 따라갈 줄이야, 윈드블룸 축제는 역시 대단하네…. 그래도 네가 발견해서 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030613
					],
					"speakerTitle": "아라미"
				},
				{
					"id": 700030613,
					"content": "고양이를 찾으러 지붕에 올라갔다면 무릎에 무리가 갔을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030614
					],
					"speakerTitle": "아라미"
				},
				{
					"id": 700030614,
					"content": "정말 고생했어. 이건 사례니까 받아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아라미"
				},
				{
					"id": 700030610,
					"content": "나중에 갈게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				}
			]
		}
	]
}