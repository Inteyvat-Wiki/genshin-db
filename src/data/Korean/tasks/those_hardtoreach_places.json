					"아라미"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030101,
					"content": "휴, 어떡하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030102
					],
					"speakerTitle": "아라미"
				},
				{
					"id": 700030102,
					"content": "무슨 문제가 생겼나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030103
					]
				},
				{
					"id": 700030103,
					"content": "윈드블룸 축제가 시작되면 이곳에 와서 신상에 꽃을 바치는 사람이 너무 많아. 게다가 바람이 불면 그 꽃잎이 성안 곳곳으로 날아가지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030104
					],
					"speakerTitle": "아라미"
				},
				{
					"id": 700030104,
					"content": "이 마른 꽃잎을 치우려고 우리도 애 많이 썼어. 광장에 떨어진 꽃잎과 낙엽은 그래도 치울 수 있는데 지붕과 성벽까지 날아간 꽃잎들은 치울 방법이 없네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030105
					],
					"speakerTitle": "아라미"
				},
				{
					"id": 700030105,
					"content": "그리고 내 무릎이 이제 못 견디는 거 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030106
					],
					"speakerTitle": "아라미"
				},
				{
					"id": 700030106,
					"content": "제가 도울게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030107
					]
				},
				{
					"id": 700030107,
					"content": "도와줄 수 있어? 정말 다행이다. 그 말라버린 꽃잎들은 눈에 확 띄어. 지붕에 올라가면 바로 보일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아라미"
				}
			]
		},
