			"dialogs": [
				{
					"id": 760540101,
					"content": "응? 콜롬비나는 왜 안 보이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760540102,
					"content": "여기야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540103
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540103,
					"content": "우와! 그렇게 높은 곳에서 뭐 해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760540104,
					"content": "올라와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540105
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540105,
					"content": "응? 이번엔 또 뭘 하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760540106,
					"content": "저번에 나가서 돌 수집했던 거 기억나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540107
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540107,
					"content": "저번에? 아, 달의 힘을 흡수해서 빛나던 그 광석 말이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760540108,
					"content": "응. 그 후에 월령들이 몇 개를 더 모아 왔는데, 내가 그걸 짙은 색이랑 연한 색으로 나눠뒀어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540109
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540109,
					"content": "짙은 색이랑 연한 색? 왜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760540110,
					"content": "「달 바둑」을 하려고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540111
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540111,
					"content": "응? 「달 바둑」…? 그게 뭐야…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760540112,
					"content": "너희는 안 해봤어…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540113
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540113,
					"content": "응…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540114
					]
				},
				{
					"id": 760540114,
					"content": "그렇구나… 예전에 「서리달 아이」의 아이들이 땅에 칸을 그리고 노는 걸 봤을 때부터 해보고 싶었는데, 같이 놀 사람이 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540115
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540115,
					"content": "어떻게 두는 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760540116,
					"content": "음… 이렇게 설명하는 게 이해하기 쉬우려나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540117
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540117,
					"content": "와! 대, 대단해… 어떻게 한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760540118,
					"content": "응? 달의 힘을 살짝 사용했을 뿐이야. 너희는 못 해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540119
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540119,
					"content": "신의 기준에 우리를 맞추지 말아줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760540120,
					"content": "알겠어. 이 판은 게임 속 「밤하늘」이야. 그리고 두 사람이 가진 돌은 각자의 「달」을 의미해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540121
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540121,
					"content": "두 사람이 번갈아 가며 「달」을 「밤하늘」에 둬서, 세 개의 달을 먼저 일직선상에 놓는 사람이 이겨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540122
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540122,
					"content": "아! 돌 세 개를 일직선으로 놓으면 된다는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760540123,
					"content": "여기서는 이걸 「달 바둑」이라고 부르는구나… 노드크라이다운 작명이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760540124,
					"content": "다만 「달」은 교대로 떠. 하늘에 존재하는 「달」은 세 개를 넘길 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540125
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540125,
					"content": "「밤하늘」의 「달」이 일정 수량에 도달하면, 가장 먼저 뜬 「달」은 사라지게 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540126
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540126,
					"content": "음… 그렇구나… 게임 난이도가 한층 높아진 느낌이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760540127,
					"content": "응. 해볼래? 나도 처음 해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540128
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540128,
					"content": "(엄청 기대하는 것 같아…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540129
					]
				},
				{
					"id": 760540129,
					"content": "헤헤, 그럼 내가 심판할게. 여행자는 엄청 똑똑하니까 조심하라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760540130,
					"content": "응",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「콜롬비나」"
				}
			]
		},
