						207411003
					]
				},
				{
					"id": 207411003,
					"content": "이거면 충분해. 여기서 잠깐만 기다려줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411004
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 207411004,
					"content": "…바르바토스 님, 제 기도를 들어주세요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411005
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 207411005,
					"content": "우와… 정말 신실하네. 말을 엄청 많이 했어",
