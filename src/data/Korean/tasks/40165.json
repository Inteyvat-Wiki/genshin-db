						],
						"pointId": 910002010
					}
				]
			},
			"dialogs": [
				{
					"id": 401650301,
					"content": "이곳의 오두막 구조는… 정말 특이하네. 기록해 뒀다가 타이나리 스승님한테 알려드려야지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650302
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401650302,
					"content": "콜레이! 안녕!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401650303,
					"content": "#으앗! 깜짝이야…. {NICKNAME}(이)랑 페이몬? 너희도 초대를 받고 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650304
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401650304,
					"content": "…다음에는 초대라는 과정이 있으면 좋겠네. 콜레이, 뭐 보고 있었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401650305,
					"content": "아, 숲의 구조랑 여기 사는 동물들을 관찰하고 있었어…. 아니, 주민이라고 해야 하나? 종이로 되어 있어서 애매하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650306
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401650306,
					"content": "역시 숲의 순찰자답네. 근데 여긴 마법의 세계라 참고할 가치가 있을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401650307,
					"content": "어…? 전에도 저 커다란 발자국 옆에 집이 있었나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401650308,
					"content": "응, 여기 사는 날다람쥐들이 말해줬는데, 꼬마 용이랑 모자를 쓴 사람이 지어줬대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650309
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401650309,
					"content": "두린이랑 모자구나! 그 두 사람이 어디로 갔는지 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401650310,
					"content": "집을 지어준 후에, 뭐더라… 별길 왕성 쪽으로 갔다고 들었어. 이 이름 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650311
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401650311,
					"content": "응, 맞아. 근데 콜레이, 있잖아… 음, 여기 주민들이 그 용을 어떻게 생각하는지 들은 거 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401650312,
					"content": "음… 그러고 보니 말하는 게 심상치 않았지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650313
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401650313,
					"content": "앗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401650314,
					"content": "「과거의 오해」라느니, 「새로운 일원으로 받아들인다」느니, 그런 얘길 했던 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650315
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401650315,
					"content": "난 여기 온 지 얼마 안 돼서 무슨 일이 있었는진 잘 모르지만, 다들 새 집을 지어준 게 고마운지 환영회 같은 걸 연다고 하더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650316
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401650316,
					"content": "휴, 깜짝아! 그럼 나름 숲에 잘 녹아든 것 같네. 적어도 첫걸음은 잘 뗐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401650317,
					"content": "그 용한테 볼일이 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650318
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401650318,
					"content": "응, 그 애는 우리가 이 세계에서 새로 사귄 친구거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401650319,
					"content": "와, 정말? 무슨 일이 있었는지 점점 궁금해지는걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650320
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401650320,
					"content": "음… 아니야, 역시 다음에 얘기해 줘. 난 빨리 이 신기한 세계를 더 둘러보고 싶거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650321
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401650321,
					"content": "헤헤, 너무 서두르지 말고 케이아처럼 느긋하게 즐겨 봐. 참, 케이아가 대신 안부 전해달래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650322
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401650322,
					"content": "케이아 씨도 오셨어? 음… 나도 가서 인사해야겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650323
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401650323,
					"content": "케이아라면 아마 취할 때까지 주점에 있을걸? 게다가 아무리 마셔도 안 취하는 사람이니까 아무 때나 가도 상관없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650324
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401650324,
					"content": "하하… 맞아. 그럼 케이아 씨는 천천히 찾아봬야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650325
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401650325,
					"content": "우린 슬슬 왕성으로 가볼까? 두린이랑 다들 아직 있어야 할 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650326
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401650326,
					"content": "참, 요즘 수메르에 흥미로운 일이 생긴 것 같더라. 타이나리 스승님도 바쁘시고. 나중에 시간 되면 한번 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650327
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401650327,
					"content": "#응! {NICKNAME}, 나중에 수메르에도 한번 다녀오자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650328,
						401650329
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401650328,
					"content": "콜레이, 그럼 재밌게 놀아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650330
					]
				},
				{
					"id": 401650330,
					"content": "응, 나중에 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401650329,
					"content": "여행 답사라고 생각하고…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650330
					]
				}
			]
		},
