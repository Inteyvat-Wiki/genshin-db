			"dialogs": [
				{
					"id": 401650201,
					"content": "마법의 물이 잉크였다니… 정말 신기하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650202
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 401650202,
					"content": "감귤 양, 마법의 물이 안 들어간 음료는 없을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650203
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 401650203,
					"content": "당연히 있죠! 어떤 맛으로 드릴까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650204
					],
					"speakerTitle": "감귤"
				},
				{
					"id": 401650204,
					"content": "일몰 열매? 진, 너도 마실래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650205
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 401650205,
					"content": "…좋아, 나도 한 잔 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650206
					],
					"speakerTitle": "진"
				},
				{
					"id": 401650206,
					"content": "넵, 일몰 열매 맛 두 잔이요! 금방 가져다드릴게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "감귤"
				}
			]
		},
