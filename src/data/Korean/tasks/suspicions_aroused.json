			},
			"dialogs": [
				{
					"id": 401020501,
					"content": "내용이 너무 많아서 어지러워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020502,
					"content": "그러니까 사카인은 아카데미아에 재산 관리를 맡기고 본인은 연구하러 갔다는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020503,
					"content": "사카인의 인정을 받는 참가자가 있으면 상금뿐만 아니라 재산도 준다는데… 분명 엄청난 액수겠지!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020504,
					"content": "뭐?! 그런 좋은 일이?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020505
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401020505,
					"content": "사카인의 재산이라면… 평생 다 못 쓸 정도일 텐데. 그걸 받으면 빚을 갚고 새집을 사고도 셀 수 없는 돈이 남는 거잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020506
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401020506,
					"content": "그럼 카자르자레궁을 하나 더 지어야지. 아니, 열 배는 더 큰 궁을 지어야겠어——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020507
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401020507,
					"content": "오르모스 항구에 다리를 개조하는 새로운 프로젝트가 있었던 것 같은데, 제대로 하려면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020508
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401020508,
					"content": "정신 차려. 벌써부터 그런 고민하는 건 너무 이르다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020509
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020509,
					"content": "하긴, 우승해서 이사부터 나가는 게 급선무니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020510
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401020510,
					"content": "응? 잠깐만, 자료 사이에 쪽지가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020511
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020511,
					"content": "알하이탐이 쓴 건가? 생각을 메모해 둔 것 같은데… 어디 보자, 동그라미로 표시한 부분이 두 군데 있어——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020512
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020512,
					"content": "「사카인은 생사불명」, 그리고… 「통찰의 왕관」?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020513
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020513,
					"content": "알아볼 수 없는 말들도 있어. 다른 언어인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020514
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020514,
					"content": "어디 봐봐… 응? 이 문자는… 내 기억이 맞다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020515
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401020515,
					"content": "「위대한 이상은 허무주의에 대항할 수 없을지라도, 작은 선택은 가능하다」——완벽하진 않아도 대충 이런 뜻일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020516
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401020516,
					"content": "응? 밑에도 작게 뭐가 쓰여 있네… 음… 뭐라는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020517
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401020517,
					"content": "이런 이상한 문자를 알아볼 수 있다니, 정말 대단해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020518
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020518,
					"content": "학생 때 알하이탐과 「적왕 문명 유적의 고대 룬 문자 및 건물 설계 방향 해독」이라는 프로젝트를 같이 했었는데, 그때 고대 문자를 좀 배웠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020519
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401020519,
					"content": "그랬구나! 근데… 알하이탐이 쓴 게 대체 무슨 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020520
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020520,
					"content": "글쎄? 그 자식의 사고방식은 쉽게 이해할 수 없거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020521
					],
					"speakerTitle": "카베"
				},
				{
					"id": 401020521,
					"content": "알겠어, 그럼 여기서 얻을 수 있는 단서는 더 없겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020522
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020522,
					"content": "아라브 씨 쪽에 진전이 있길 바라야지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020523
					]
				},
				{
					"id": 401020523,
					"content": "응, 그 나쁜 녀석들을 빨리 잡았으면 좋겠어. 그 전까지… 음… 일단 다른 곳으로 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
