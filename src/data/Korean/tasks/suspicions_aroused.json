							-418.421,
							281.227,
							2772.651
						],
						"pointId": 330201420
					}
				]
			},
			"dialogs": [
				{
					"id": 401020201,
					"content": "아, 오랜만이네. 무슨 볼일이라도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020202
					],
					"speakerTitle": "아라브"
				},
				{
					"id": 401020202,
					"content": "데히야와 캔디스한테 들은 이야기를 아라브에게 알려준다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401020203
					]
				},
				{
					"id": 401020203,
					"content": "사카인 씨를 납치하려는 사람이 있다고…? 근데 생각해 보니 딱히 이상한 일도 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020204
					],
					"speakerTitle": "아라브"
				},
				{
					"id": 401020204,
					"content": "사카인 씨가 아카데미아 축제를 후원하신 덕에 축제가 커졌잖아. 그래서 많은 사람이 그를 엄청난 부자라고 생각하게 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020205
					],
					"speakerTitle": "아라브"
				},
				{
					"id": 401020205,
					"content": "그럼 그를 노리는 사람이 있다는 건데, 경호 인력을 더 투입해야 하는 거 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020206,
					"content": "우리도 그런 생각을 안 한 건 아니라고. 다만 사카인 씨는 늘 외부에서 연구하느라 수메르성에 안 계셔서 연락이 잘 안 된다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020207
					],
					"speakerTitle": "아라브"
				},
				{
					"id": 401020207,
					"content": "유일한 단서는 「학부 대항전이 열릴 때마다 가장 가까운 곳에서 내 재산을 물려받을 상속자가 있는지 지켜보겠다」라고 예전에 하셨던 이 말뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020208
					],
					"speakerTitle": "아라브"
				},
				{
					"id": 401020208,
					"content": "만약 사카인 씨가 그 약속을 지키셨다면 지금 수메르성 어딘가에 계시겠지. 도금 여단도 이 정보를 듣고 수메르성에 온 걸 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020209
					],
					"speakerTitle": "아라브"
				},
				{
					"id": 401020209,
					"content": "그럼 그 녀석들도 사카인이 어디 있는지 모른다는 거네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020210,
					"content": "아마 그럴 거야. 사이노 님은 아직 휴가 중이시니 이번 일은 내가 처리할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020211
					],
					"speakerTitle": "아라브"
				},
				{
					"id": 401020211,
					"content": "걱정 마. 고작 납치범들 때문에 수메르성이 뒤집힐 일은 없으니까. 놈들을 유인할 방법이 다 있다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020212
					],
					"speakerTitle": "아라브"
				},
				{
					"id": 401020212,
					"content": "그래도 이 사건에 관심 있으면, 사카인 씨를 한번 찾아보는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020213
					],
					"speakerTitle": "아라브"
				},
				{
					"id": 401020213,
					"content": "그분의 행방을 빨리 알수록 더 안전해질 테니까. 풍기관과 30인단이 아무리 대단해도 행방불명인 사람을 보호하기란 쉽지 않지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020214
					],
					"speakerTitle": "아라브"
				},
				{
					"id": 401020214,
					"content": "좋아, 그럼 한번 찾아볼게. 어디서부터 조사하는 게 좋을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020215,
					"content": "사카인 씨의 자료가 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020216
					]
				},
				{
					"id": 401020216,
					"content": "아니, 사카인 씨는 위법 행위를 하신 적이 없어서 풍기관한테는 정보가 별로 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020217
					],
					"speakerTitle": "아라브"
				},
				{
					"id": 401020217,
					"content": "알하이탐 님이 현자 대행직을 내려놓고 서기관으로 돌아오셨다고 들었는데, 그분께 물어보는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020218
					],
					"speakerTitle": "아라브"
				},
				{
					"id": 401020218,
					"content": "일리 있어. 그럼 대회장으로 돌아가서 알하이탐을 찾아보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
