			},
			"dialogs": [
				{
					"id": 401020101,
					"content": "#{NICKNAME}, 고민이 있는 것 같네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020102,
						401020103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020102,
					"content": "(대회 시작 전에 봤던 백발의 남자…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020104
					]
				},
				{
					"id": 401020104,
					"content": "#{NICKNAME}, 페이몬. 드디어 찾았네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020105
					],
					"speakerTitle": "캔디스"
				},
				{
					"id": 401020105,
					"content": "응? 무슨 일 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020106,
					"content": "이번 축제, 좀 이상한 것 같지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020107
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 401020107,
					"content": "아까 캔디스랑 커피숍에 있다가 이곳으로 일 보러 온 용병들을 본 것 같아. 안 들키려고 관광객으로 위장까지 했더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020108
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 401020108,
					"content": "하지만 아무리 위장해도 몸에 밴 피 냄새는 못 숨기지. 딱 봐도 수상한 게 아무래도 납치나 암살 같은 더러운 일로 온 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020109
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 401020109,
					"content": "그들이 하는 말을 잠깐 들었는데, 「사카인」이라는 사람이 목표인 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020110
					],
					"speakerTitle": "캔디스"
				},
				{
					"id": 401020110,
					"content": "사카인? 개막식 때 카리나가 말했던 사람 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020111,
					"content": "「통찰의 왕관」과 대회 상금 모두 그 사람이 지원했다고 들었어. 지금까지 한 번도 못 봤지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020112,
					"content": "부자인가 보네. 그럼 이상할 거 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020113
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 401020113,
					"content": "요즘 도금 여단도 벌이가 좋지 않거든. 「개인 의뢰」를 받는 용병단은 돈 많고 권력 있는 사람을 노리곤 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020114
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 401020114,
					"content": "그 사람들 말로 하면 반년은 먹고 사는 장사라는데, 땡잡으면 아주 오랫동안 밥그릇 걱정은 안 해도 되는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020115
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 401020115,
					"content": "아카데미아 축제 때문에 수메르성에 관광객이 몰렸으니, 그 틈을 타고 몰래 들어온 걸 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020116
					],
					"speakerTitle": "캔디스"
				},
				{
					"id": 401020116,
					"content": "우리가 그 사람들을 붙잡으려고 했는데, 경계심이 강해서 그런지 금방 빠져나가더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020117
					],
					"speakerTitle": "캔디스"
				},
				{
					"id": 401020117,
					"content": "성안에서 괜히 소동 피우기 싫어서 그렇지, 아니면 바로 잡았을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020118
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 401020118,
					"content": "이런 일은 보통 누가 처리해? 풍기관? 아니면 30인단?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020119
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 401020119,
					"content": "음… 사이노가 있었다면 분명 처리했을 거야. 일단 아카데미아로 돌아가서 풍기관에게 알리자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020120,
					"content": "알려줘서 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020121,
					"content": "아니야, 우리도 우연히 들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020122
					],
					"speakerTitle": "캔디스"
				},
				{
					"id": 401020122,
					"content": "그래, 신경 쓰지 마. 놈들 뜻대로 되면 도금 여단의 명성만 더러워질 뿐이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020123
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 401020123,
					"content": "수메르성에서는 나와 캔디스가 나서기 좀 그러니, 너희에게 맡길게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020124
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 401020124,
					"content": "도움이 필요하면 커피숍으로 와줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020125
					],
					"speakerTitle": "캔디스"
				},
				{
					"id": 401020125,
					"content": "아까부터 고민이 있어 보이는데, 너도 축제에 문제가 있다고 생각하는 거야? 데히야와 캔디스 말을 듣고 나니 뭔가 비밀이 숨겨져 있는 것 같기도 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020126,
					"content": "음… 이렇게 고민만 해선 해결되는 건 없어. 풍기관을 찾으러 아카데미아에 가보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401020103,
					"content": "(첫 라운드가 끝나고 들은 비밀 대화…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020104
					]
				}
			]
		},
		{
			"id": 4010202,
