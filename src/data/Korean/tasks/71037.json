			"dialogs": [
				{
					"id": 710370301,
					"content": "아, 돌아왔구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370302
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710370302,
					"content": "하 씨가 메시지를 남겼어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370303
					]
				},
				{
					"id": 710370303,
					"content": "오? 진짜 뭘 남기긴 했구나! 빨리 알려주렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370306
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710370306,
					"content": "근우에게 얼마 전에 알아낸 정보를 자세히 알려준다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710370304
					]
				},
				{
					"id": 710370304,
					"content": "음… 검은색 「용암」… 유명석… 버섯…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370305
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710370305,
					"content": "흥… 정말 불길하군. 익숙한 불길함이야. 너희도 이곳에 오래 머물지 말고 같이 야영지로 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "근우"
				}
			]
		},
		{
			"id": 7103704,
			"completionStepIds": [
				7103711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
