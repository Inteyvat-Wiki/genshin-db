			"dialogs": [
				{
					"id": 150260201,
					"content": "여기가 그 대샤먼이 사는 곳이야? 뭐가 이리 외졌어? 설마 그 부족민이 거짓말한 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260202
