				"points": []
			},
			"dialogs": [
				{
					"id": 20170201,
					"content": "라, 라쿤 인형이 인간으로 변했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20170202,
					"content": "이런 건 처음 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20170203,
					"content": "라쿤이 아니라… 너구리야… 쿠울…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170204
					],
					"speakerTitle": "사유"
				},
				{
					"id": 20170204,
					"content": "졸려… 잠을 충분히 안 자면… 키가 안 큰다구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170205
					],
					"speakerTitle": "사유"
				},
				{
					"id": 20170205,
					"content": "설마 얘가 바로 야에가 말한 「전문가」?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20170206,
					"content": "전혀 그래 보이지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20170207,
					"content": "후후… 이분은 「종말번대」 대원이야. 진정한 「닌자」지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170208
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20170208,
					"content": "닌자! 그럼 방금 전 그건 말로만 듣던 바꿔치기술?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20170209,
					"content": "근데 「종말번대」는 또 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20170210,
					"content": "종말번대는 야시로 봉행에 소속된 카미사토 아야토의 비밀 부대야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170211
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20170211,
					"content": "카미사토 아야토와 야시로 봉행이 중립의 입장을 취하고 있어서 나도 종말번대를 동원할 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170212
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20170212,
					"content": "단, 게으름 피우는 종말번대 대원을 잡아다가 부탁하는 건 가능하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170213
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20170213,
					"content": "꼬르륵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170214
					],
					"speakerTitle": "사유"
				},
				{
					"id": 20170214,
					"content": "그러니까 이제 시내로 가서 텐료 봉행의 반역 증거를 찾아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170215
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20170215,
					"content": "그런 장소에 내가 얼굴 내밀긴 좀 그렇잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170216
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20170216,
					"content": "그렇게 말해도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170217,
						20170218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20170217,
					"content": "감이 안 잡혀요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				},
				{
					"id": 20170219,
					"content": "응? 이미 알고 있을 줄 알았는데. 그래, 그럼 힌트를 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170220
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20170220,
					"content": "외부인이 텐료 봉행의 속사정을 파악하기는 쉽지 않으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170221
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20170221,
					"content": "삼봉행은 함께 쇼군을 보좌하고 자주 왕래하다 보니, 다른 봉행이 더 쉽게 이상함을 눈치챘을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170222
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20170222,
					"content": "야시로 봉행!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170223
					]
				},
				{
					"id": 20170223,
					"content": "후후… 이제 알았나 보군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170224
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20170224,
					"content": "막부군이 아직 널 쫓고 있지만, 이 종말번대 닌자의 도움으로 다시 친구와 만날 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170225
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20170225,
					"content": "명심해, 약속한 날이 되기 전까지 반드시 증거를 가져와야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20170218,
					"content": "대체 증거가 뭘까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				}
			]
		},
		{
