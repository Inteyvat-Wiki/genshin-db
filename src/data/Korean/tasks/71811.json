				},
				{
					"id": 718110502,
					"content": "「사진기」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110503
					]
				},
				{
					"id": 718110503,
					"content": "「사진기」… 아아, 며칠 전에 비운 상회한테 와서 사진 좀 찍어달라고 부탁했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110504
					],
					"speakerTitle": "아산파"
				},
				{
					"id": 718110504,
					"content": "일부러 사진을 갖다주러 온 건가? 정말 고맙구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아산파"
