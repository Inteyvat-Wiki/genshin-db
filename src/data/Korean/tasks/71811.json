			"dialogs": [
				{
					"id": 718110412,
					"content": "「사진기」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110401
					]
				},
				{
					"id": 718110401,
					"content": "물건은 다 전해드렸나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110402
					],
					"speakerTitle": "욱이"
				},
				{
					"id": 718110402,
					"content": "네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110403
					]
				},
				{
					"id": 718110403,
					"content": "정말 감사합니다. 수고하셨어요. 아휴, 너무 바빠서 쓰러질 거 같아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110404
					],
					"speakerTitle": "욱이"
				},
				{
					"id": 718110404,
					"content": "참, 이 「사진기」를 드릴게요. 도와주셔서 감사합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110405,
						718110406
					],
					"speakerTitle": "욱이"
				},
				{
					"id": 718110405,
					"content": "이 좋은 걸 어떻게 받아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				},
				{
					"id": 718110407,
					"content": "괜찮습니다. 저희를 도와주셨잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110408
					],
					"speakerTitle": "욱이"
				},
				{
					"id": 718110408,
					"content": "그렇게 귀중한 물건도 아닌걸요. 이건 물건을 들여올 때 폰타인에서 준 시제품이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110409
					],
					"speakerTitle": "욱이"
				},
				{
					"id": 718110409,
					"content": "완제품과 똑같진 않지만… 기본 성능은 다 있으니 쓰시기엔 충분할 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110410
					],
					"speakerTitle": "욱이"
				},
				{
					"id": 718110410,
					"content": "그리고… 저, 써보시고 좋으면 여기저기 홍보도 부탁드려요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110411
					],
					"speakerTitle": "욱이"
				},
				{
					"id": 718110411,
					"content": "흠흠… 아무튼 감사합니다! 이 「사진기」 잘 챙기시구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "욱이"
				},
				{
					"id": 718110406,
					"content": "엄청 비싸지 않나요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				}
			]
		},
