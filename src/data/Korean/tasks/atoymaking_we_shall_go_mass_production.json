	"talks": [
		{
			"id": 7269701,
			"completionStepIds": [
				7269701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269701",
							"2"
						],
						"stepId": 7269701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"베르트랑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726970101,
					"content": "#헤이 {NICKNAME}, 페이몬. 어서 와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970102
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970102,
					"content": "내 장난감 상점이 곧 오픈할 예정이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970103
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970103,
					"content": "장난감 상점?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726970104,
					"content": "흠흠… 장난감 상점이라고 하지만 실은 나와 내 「울트라 대왕 머신」밖에 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970105
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970105,
					"content": "내가 공정을 약간 손봤거든. 이제는 제조 완료까지 그리 오래 기다리지 않아도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970106
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970106,
					"content": "「즉시 완성」까지는 아니지만 어쨌든 「빠른 완성」 정도는 가능해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970107
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970107,
					"content": "와, 굉장한걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726970108,
					"content": "그리고 이 「재료 수집기」도 개량했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970109
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970109,
					"content": "이전에는 한 공정을 마친 후 반드시 돌아와야 했잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970110
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970110,
					"content": "이러면 효율이 낮은 것 같아서 조정을 했는데, 지금은 수집기가 수집 상황에 따라서 현재 공정 내용을 자동 업데이트할 수 있게 되었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970111
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970111,
					"content": "수집 상황에 따라서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726970112,
					"content": "공정 내용을 조절한다?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726970113,
					"content": "무슨 말인지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970114
					]
				},
				{
					"id": 726970114,
					"content": "아, 어떻게 설명해야 할까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970115
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970115,
					"content": "예를 들어 첫 번째 공정에서는 일몰 열매 10개, 두 번째 공정에서는 물 원소가 필요하고, 세 번째 공정에서는 2마리의 물 슬라임을 처치해야 한다고 치자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970116
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970116,
					"content": "개량된 「재료 수집기」를 휴대하고 일몰 열매 10개를 수집하면 수집기는 첫 번째 공정에 필요한 모든 재료가 수집되었다고 판단하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970117
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970117,
					"content": "그러면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970118
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970118,
					"content": "알았어. 그러면 수집기가 자동으로 두 번째 공정의 수집 모드로 들어가는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726970119,
					"content": "맞아. 「원소 충전」 모드로 들어가서 물 원소를 보충하겠지. 물 원소가 모두 보충되면 재차 변경되어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970120,
						726970121
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970120,
					"content": "세 번째 공정으로 진입하겠죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				},
				{
					"id": 726970122,
					"content": "그래, 그때는 2마리의 물 슬라임만 처치하면 되는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970123
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970123,
					"content": "정말 많이 편리해졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726970124,
					"content": "그렇지? 내가 이 재료 수집기를 개량하기 위해서 꼬박 밤을 새웠다니깐. 나는 이걸 궁극 최강의 삼위일체라고 부르기로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970125
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970125,
					"content": "와, 「재료 수집기」가 정말 대단해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726970126,
					"content": "맞아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970127
					]
				},
				{
					"id": 726970127,
					"content": "으으…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970128
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970128,
					"content": "그런데 왜 「재료 수집기」를 우리에게 주는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726970129,
					"content": "헤헤, 내가 잠시 금족령을 받아 이도를 벗어나지 못해서… 재료를 수집할 수가 없거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970130
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970130,
					"content": "기왕 도울 바에는 끝까지 도와줘. 나중에 장난감을 판 수익도 너희들에게 좀 나눠주면 되잖아. 그리고 이렇게 만들어낸 장난감 중 하나를 공짜로 가져갈 수 있게 허락하겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970141
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970141,
					"content": "전에 준 쿠폰이 기억나지? 헤헤, 그 쿠폰을 사용해 공짜로 교환할 수 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970142
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970142,
					"content": "네가 만들어낸 장난감 모형이라면 아무거나 교환해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970131
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970131,
					"content": "어라, 우리가 열심히 뛰어다니며 재료를 모아 장난감을 만들면 그쪽에서 대부분 수익을 꿀꺽하시겠다 이 말인 거지? 게다가 장난감도 하나만 주시겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970132
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726970132,
					"content": "#이런 일이 어딨어. 가자, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726970133,
					"content": "그, 그럼… 수익 배당을 좀 더 늘려주고 장난감도 2개… 아니… 3개를 주면 안 되겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970134
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970134,
					"content": "가자, 페이몬",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970135
					]
				},
				{
					"id": 726970135,
					"content": "4개! 4개! 더 이상은 정말 안 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970136
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970136,
					"content": "에휴, 빚만 없다면 장난감을 너희들에게 다 줄 수도 있어. 그런데 난, 난 만국 상회의 빚을 갚아야 한단 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970137
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970137,
					"content": "흥, 불쌍해서 봐줄게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970138
					]
				},
				{
					"id": 726970138,
					"content": "…맞아. 수익 배당이나 장난감 4개를 위해서가 아니라 당신이 불쌍해 보여서 도와주는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726970139,
					"content": "헤헤, 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970140
					],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970140,
					"content": "이제야 한숨 돌릴 수 있을 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르트랑"
				},
				{
					"id": 726970121,
					"content": "「코어 활성화」 공정으로 넘어가겠죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				}
			]
		}
	]
}