			},
			"dialogs": [
				{
					"id": 411200101,
					"content": "다들 무사하면 좋겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200102
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 411200102,
					"content": "무슨 고민 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200103
					]
				},
				{
					"id": 411200103,
					"content": "여행자구나. 너도 하늘에서 떨어진 그 운석들을 봤지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200104
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 411200104,
					"content": "다행히 몬드성 안에 떨어진 운석은 없지만, 성 밖은 엉망진창이 됐다고 들었어. 아직 밖에 남아있는 사람들이 걱정돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200105
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 411200105,
					"content": "여행자, 가서 아직 밖에 있는 사람들에게 조심하라고 좀 해줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200106
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 411200106,
					"content": "그들이 원한다면 몬드성 안으로 대피시켜줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200107,
						411200109
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 411200107,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200108
					]
				},
				{
					"id": 411200108,
					"content": "그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 411200112,
					"content": "일단 린 씨한테 가서 물어봐. 그녀라면 누가 아직 밖에 있는지 알 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200113
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 411200113,
					"content": "그리고 린 씨도 몬드성 안으로 대피하라고 설득해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200114
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 411200114,
					"content": "지금은 「야외 생존」 같은 걸 할 때가 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "그레이스"
				},
				{
					"id": 411200109,
					"content": "왜 운석이 몬드성 안으론 안 떨어진 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200110
					]
				},
				{
					"id": 411200110,
					"content": "운이 좋았던 거겠지. 어찌 됐든 지금으로선 몬드성이 그나마 제일 안전한 곳이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200111
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 411200111,
					"content": "적어도 야외에 있는 것보단 안전하지. 안 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "그레이스"
				}
			]
		},
		{
			"id": 4112002,
			"completionStepIds": [
				4112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
