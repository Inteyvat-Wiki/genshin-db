			"dialogs": [
				{
					"id": 207000201,
					"content": "다 했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000202
					]
				},
				{
					"id": 207000202,
					"content": "1분도 안 걸렸는데 벌써 처리하고 오다니. 보통 솜씨가 아니구먼, 하하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000203
					],
					"speakerTitle": "짜레비치"
				},
				{
					"id": 207000203,
					"content": "좋아 좋아, 딱 5000 모라야. 가져가게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000204
					],
					"speakerTitle": "짜레비치"
				},
				{
					"id": 207000204,
					"content": "보통 솜씨가 아니라더니, 겨우 5000 모라야…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 207000205,
					"content": "적다고? 다 내가 정확히 계산해 본 거야. 너희가 일한 만큼 딱 맞게 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000206
					],
					"speakerTitle": "짜레비치"
				},
				{
					"id": 207000206,
					"content": "돈을 많이 벌고 싶으면 큰일을 해야지. 다음 기회에 더 노력해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "짜레비치"
				}
			]
		},
