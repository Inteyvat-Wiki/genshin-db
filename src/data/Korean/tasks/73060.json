				"points": []
			},
			"dialogs": [
				{
					"id": 730600301,
					"content": "역시 아란바리카가 잘 해냈구나. 하지만 야스나 유경에 있는 아란나쿨라와 꿈의 숲에 있는 아란쿤티가 걱정돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600302
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730600302,
					"content": "아란나쿨라… 나쁜 버섯이 너무 많아서 혹시나 녀석들에게 잡히기라도 하는 날엔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600303
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730600303,
					"content": "너무 걱정해 봤자 소용없어. 금빛의 나라는 아주 강해. 강풍이 고목을 쓰러뜨리듯 커다란 쇳덩이도 단숨에 부술 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600304
					],
					"speakerTitle": "아란바리카"
				},
				{
					"id": 730600304,
					"content": "바루나 신기를 치유하기만 하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란판두"
				}
			]
		},
