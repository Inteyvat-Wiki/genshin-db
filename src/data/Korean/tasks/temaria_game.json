						],
						"stepId": 7217602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"쿠지라이",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760202,
					"content": "와, 정말 어렵네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760203
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760203,
					"content": "운이 좋았을 뿐이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721760204,
					"content": "#{F#누나}{M#형아}, 한 번 더 하실래요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760205
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760205,
					"content": "#좋아! {NICKNAME}, 우리가 얼마나 잘하는지 보여줘야겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721760206,
					"content": "한 번 더!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760207
					]
				},
				{
					"id": 721760207,
					"content": "네! 목표는 제한 시간 내에 테마리를 찾는 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쿠지라이"
				}
			]
		},
		{
			"id": 7217607,
			"completionStepIds": [
				7217605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217605",
							"2"
						],
						"stepId": 7217605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"쿠지라이",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760702,
					"content": "#{F#누나}{M#형아}, 대단해요. 한 번에 찾았네요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760703
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760703,
					"content": "#흠흠, {NICKNAME}, 그리고 난 산전수전을 다 겪은 여행자라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760704
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721760704,
					"content": "와! 혹시, 「몬드」도 가보셨나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760705
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760705,
					"content": "당연하지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760706
					]
				},
				{
					"id": 721760706,
					"content": "대단해요! 그 모험가 누나가 몬드에 아주 아름다운 곳이 많다고 했어요, 엄청 높은 「바람 드래곤의 유적」이 있다 했나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760707,
						721760708
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760707,
					"content": "바람 드래곤의 폐허야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				},
				{
					"id": 721760709,
					"content": "음, 그러면 그 탑이 높나요 아니면 쇼군님의 천수가 더 높나요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760710
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760710,
					"content": "쿠지라이, 왜 혼자 밖에 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760711
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721760711,
					"content": "누나가 낚시할 때 물고기 도망간다고 저보고 혼자 놀다 오라고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760712
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760712,
					"content": "한번은 모험가 누나를 만났는데, 제가 심심해 보였는지 테마리를 많이 선물해 줬어요. 「탐욕의 여행자와 같이 놀아」라고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760713
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760713,
					"content": "탐욕의 여행자…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760714
					]
				},
				{
					"id": 721760714,
					"content": "탐욕이라니! 그냥 쿠지라이가 심심해할까 봐 그러지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760715
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721760715,
					"content": "#맞아요, 저도 {F#누나}{M#형아}가 착하다고 생각해요. 재미있게 잘 놀았습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760716
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760716,
					"content": "혼자 밖에서…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760717
					]
				},
				{
					"id": 721760717,
					"content": "혼자 밖에 있으면 위험하지 않아? 들고 다니는 물건도 많으면서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760718
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721760718,
					"content": "#{F#누나}{M#형아}는 친절하시네요. 괜찮아요, 그 모험가 누나가 알려줬는데 간단한 조작 하나로 테마리를 폭탄으로 만들 수 있어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760719
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760719,
					"content": "위험하잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760720
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721760720,
					"content": "안 위험해요! 츄츄족이나 슬라임이나 나쁜 놈들도 저 혼자 다 쫓아냈어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760721
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760721,
					"content": "네가 위험하다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760722
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721760722,
					"content": "#맞다, {F#누나}{M#형아}, 만약 다른 친구와 테마리 놀이를 하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760723
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760723,
					"content": "테마리 하나를 여기 두고! 테마리 놀이 규칙은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760724
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760724,
					"content": "테마리를 숨길 때는, 노래 한 소절이 끝나기 전까지 숨겨야 해요. 테마리를 찾는 사람은 노래가 끝나기 전까지 찾아야 하고요! 그래야 공평하잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760725
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760725,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760726
					]
				},
				{
					"id": 721760726,
					"content": "우리가 가지고 논 게 폭탄이라니까 너무 무서워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760727
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721760727,
					"content": "#{F#누나}{M#형아}, 걱정하지 마세요. 우리 누나가 「나쁜 사람한테만 터져, 아마」라고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760728
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760728,
					"content": "「아마」?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760729
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721760729,
					"content": "#그럼 전 다른 곳 가서 놀게요! {F#누나}{M#형아}, 안녕!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760708,
					"content": "그래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				}
			]
		}
	]
}