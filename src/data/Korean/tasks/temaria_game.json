	"talks": [
		{
			"id": 7217601,
			"completionStepIds": [
				7217601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217601",
							"2"
						],
						"stepId": 7217601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"쿠지라이",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760101,
					"content": "#안녕하세요! {F#누나}{M#형아}, 저한테 좋은 물건이 있는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760102
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760102,
					"content": "괜찮아, 관심 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760103
					]
				},
				{
					"id": 721760103,
					"content": "불쌍해, 어릴 때부터 강제로 저런 일이나 하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721760104,
					"content": "#아니에요! 저는 그냥 {F#누나}{M#형아}와 테마리 놀이를 하고 싶어서예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760105
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760105,
					"content": "「테마리」?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721760106,
					"content": "#간단하게 설명드릴게요. 제가 테마리를 어딘가에 숨기고 노래를 할 건데 만약 시간 내에 {F#누나}{M#형아}가 찾으면 {F#누나}{M#형아}가 이기는 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760107
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760107,
					"content": "테마리 놀이가 그런 거였어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760108
					]
				},
				{
					"id": 721760108,
					"content": "음? 이건 엄청 강한 모험가 누나가 저한테 알려준 건데, 누나가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760109
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760109,
					"content": "「쿠지라이, 꼭 기억해. 『만약 이기면 좋은 물건을 받을 수 있어』라고 말해야 해」라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760110
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760110,
					"content": "#그래서, {F#누나}{M#형아}가 이기면 좋은 물건을 받을 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760111
					],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760111,
					"content": "#좋은 물건! {NICKNAME} 어린애랑 놀아주는 건 예나 지금이나 변하질 않네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760112,
						721760115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721760112,
					"content": "근데 테마리 놀이는 저렇게 하는 게 아닌데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760113
					]
				},
				{
					"id": 721760113,
					"content": "현지인들만 아는 그런 방법인가 봐, 세세한 부분까지 따지지 말자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721760114,
					"content": "쿠지라이 맞지? 내가 같이 놀아줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721760116,
					"content": "오예!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쿠지라이"
				},
				{
					"id": 721760115,
					"content": "알았어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760116
					]
				}
			]
		},
		{
			"id": 7217602,
			"completionStepIds": [
				7217602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
