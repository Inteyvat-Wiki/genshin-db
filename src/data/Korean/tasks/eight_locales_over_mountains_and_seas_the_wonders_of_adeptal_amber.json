						722610423
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610423,
					"content": "하지만 길법사도 우리 말 잘 들어야 해, 너무 심한 장난은 안된다구",
					"roleType": "TALK_ROLE_NPC",
