					"nextDialogs": [
						722610237
					]
				},
				{
					"id": 722610237,
					"content": "야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610238
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610238,
					"content": "페이몬 선인이야? 페이몬 대단해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610239
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610239,
					"content": "으앗, 마음이 복잡해. 길법사한테 칭찬받긴 했지만, 씁쓸한 거 같기도 하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610240
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610240,
					"content": "하지만 페이몬은 선인이 아니야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610241
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610241,
					"content": "선인이랑 놀고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610242
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610242,
					"content": "보통 선인은 모습을 잘 드러내지 않아… 하지만 이곳저곳 둘러보는 것도 나쁘지 않겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610243
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610243,
					"content": "길법사 출발!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610236,
					"content": "게다가 둘 다 날 수 있고",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610237
					]
				}
