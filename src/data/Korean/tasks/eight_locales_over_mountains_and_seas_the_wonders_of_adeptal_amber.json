			"dialogs": [
				{
					"id": 722610101,
					"content": "이봐—— 리수첩산진군ㅡ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610102,
					"content": "이봐ㅡ 리리진ㅡ",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610103
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610103,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610104,
					"content": "골치 아프네, 선인이 여기 없나 본데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610105,
					"content": "선인한테 예의없게 굴면 안 돼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610106
					]
				},
				{
					"id": 722610106,
					"content": "페이몬, 선인이 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610107
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610107,
					"content": "음… 아주 특별한 사람이나, 동물이라고 하면 되려나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610108,
					"content": "길법사처럼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610109
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610109,
					"content": "아냐, 아냐! 신비한 힘을 갖고 있다고 설명 하는 게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610110,
					"content": "펑펑도 할 수 있어? 그럼 길법사도 선인이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610111
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610111,
					"content": "음… 선인은, 더 오래되고 더 위엄이 넘치는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610112,
					"content": "알겠다, 길법사는 선인이 아니야, 이오로이가 선인이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610113
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610113,
					"content": "으아, 어떻게 설명해야 하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610114,
					"content": "선인은 리월을 지키는 오래된 존재들이야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610115
					]
				},
				{
					"id": 722610115,
					"content": "나, 알았어. 이오로이가 지키는 건 진수의 숲이니까 선인이 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610116
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610116,
					"content": "완전히 정확한 건 아니지만 오해를 풀었으니 그거로 됐어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610117,
					"content": "어쨌든 선인의 거처에 어렵게 온 만큼, 길법사 사진 찍어주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610118,
					"content": "낭! 길법사 얌전히 사진 찍을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610119
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610119,
					"content": "길법사 착하다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
