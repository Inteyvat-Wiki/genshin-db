				"points": []
			},
			"dialogs": [
				{
					"id": 722610201,
					"content": "엄청 잘 찍었네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610202,
					"content": "낭하하, 길법사 멋있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610203
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610203,
					"content": "이 꼬맹이, 겸손이라곤 찾아볼 수가 없잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610204,
					"content": "참, 페이몬. 선인은 무슨 법술을 써?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610205
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610205,
					"content": "선인의 힘은 엄청 대단하다구! 예를 들어서 자세히 설명하자면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610206,
					"content": "근처의 호박이겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610207
					]
				},
				{
					"id": 722610207,
					"content": "호박, 그게 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610208
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610208,
					"content": "응! 리수첩산진군은 호박이 자라나는 꽃을 갖고 있어서 여기에 침입하는 나쁜 녀석들을 호박 안에 가둘 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610209,
					"content": "리리는 대단해. 리월을 지키고 나쁜 녀석들을 가뒀어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610210
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610210,
					"content": "옛날 옛적, 엄청 나쁜 오가타 오니 4인방이 숲에 들어와서 마구 소란을 피우고 너구리들을 괴롭혔어. 이오로이가 높은 어르신의 모습으로 변해서 그 녀석들에게 너구리 요괴 밥을 먹였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610211
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610211,
					"content": "그리고 나중에 오토기 대왕과 함께 그 녀석들을 그림에 봉인했버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610212
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610212,
					"content": "그런 일이 있었구나. 어쩐지 이오로이가 길법사 사진을 보고 깜짝 놀라더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610213,
					"content": "이오로이는 선인이 아냐, 리월을 지키지 않아. 하지만 이오로이는 숲을 지키고 너구리들을 지켜",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610214
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610214,
					"content": "사람들에겐 각자 자신이 지켜야 할 것들이 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610215
					]
				},
				{
					"id": 722610215,
					"content": "낭?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610216
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610216,
					"content": "길법사가 크면 알게 될 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610217
					]
				},
				{
					"id": 722610217,
					"content": "그러니까, 길법사는 열심히 수행해서 위대한 너구리 요괴가 돼야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610218,
					"content": "낭! 당연하지. 천하에 이름을 떨치는 너구리 요괴 길법사!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610219
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610219,
					"content": "이오로이가 봉인 당하기 전의 모습이 궁금해! 엄청 재밌을 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610220,
					"content": "아, 갑자기 생각난 건데 전에 보물 사냥단 녀석들도 호박에 봉인당했었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610221,
					"content": "우리가 「선인의 사절」로 오해받기도 했잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610222
					]
				},
				{
					"id": 722610222,
					"content": "엄청 오래전에 일어난 일처럼 느껴져… 근데 얼마 지나지 않은 거 같기도 하고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610223
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610223,
					"content": "낭?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610224
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610224,
					"content": "큼큼, 우리가 리월에 온 후에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610225
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610225,
					"content": "#「일 년에 한 번뿐인 청신의례야. 에헤헤, 나 {NICKNAME}은(는) 맛있는 음식을 많이 먹을 자 있다고. 페이몬, 어서 가자!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610226
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610226,
					"content": "「공양품도 있어! 페이몬은 날아갈 거야!」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610227
					]
				},
				{
					"id": 722610227,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610228
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610228,
					"content": "헛소리하지 마…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722610229
					]
				},
				{
					"id": 722610229,
					"content": "알겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610230
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610230,
					"content": "민림 절운으로 선인을 찾으러 오기 전까지\\n리월에서 겪었던 모험담을 간략하게 설명한다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722610231
					]
				},
				{
					"id": 722610231,
					"content": "#…그리고 나랑 {NICKNAME}은(는) 그 「유리정」에서 같이 밥을 먹었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610232
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610232,
					"content": "리리 정말 대단해, 류류도 대단해! 움직일 수 있는 집도 만들 수 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610233
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722610233,
					"content": "류류진… 앗, 류운차풍진군도 맛있는 음식을 엄청 좋아하는 거 같았어! 그때 요리를 엄청 많이 만든 후에 만날 수 있었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722610234
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722610234,
					"content": "맛있는 거, 좋아해. 페이몬처럼",
