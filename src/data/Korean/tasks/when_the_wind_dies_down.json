			"dialogs": [
				{
					"id": 3980301,
					"content": "고마워! 덕분에 이 모든 게 마침내 끝났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980302
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 3980302,
					"content": "용의 재앙 때문에 많은 상로가 막혀버렸어. 식량이나 과일은 괜찮은데… 술이 동나버리면 정말 큰일이라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980303
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 3980303,
					"content": "난 술 없인 못 살아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980304
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 3980304,
					"content": "휴, 상로가 빨리 복구되길 바라야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "니므롯"
				}
			]
		},
