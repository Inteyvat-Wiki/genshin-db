			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"그레이스"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980201,
					"content": "「바람 사신수」 중 하나인 드발린 님이었구나…. 몬드 사람이라면 그의 지난날의 희생을 잊어선 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980202
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 3980202,
					"content": "불행 중 다행인 건, 「동풍의 용」 드발린 님과의 관계가 돌이킬 수 없는 지경까지 이르진 않았다는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980203
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 3980203,
					"content": "이건 모두 너희들, 그리고 기사단의 진 단장님 덕분이야. 정말 신실하신 분이라니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980204
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 3980204,
					"content": "페보니우스 기사단만 있다면, 몬드는 앞으로도 계속 평안하고 자유로울 수 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "그레이스"
				}
			]
		},
		{
