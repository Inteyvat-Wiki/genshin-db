				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"두니야",
					"두치에"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751420201,
					"content": "「발굴지」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420202
					]
				},
				{
					"id": 751420202,
					"content": "응, 사실 발굴지는 「비밀근원 유적 발굴지」라고 불러야 해. 신성한 산 남쪽에 유적이 펼쳐져 있는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420203
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420203,
					"content": "거기도 거대한 고대 용이 남긴 거래. 도굴꾼들이 유물을 훔치지 못하도록 음포소 할아버지가 매일 순찰을 돌고 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420204
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420204,
					"content": "예전부터 음포소 할아버지는 유적이나 유물에 관심이 많았어. 용 유물 연구 협회에도 가입했고, 매번 옛날이야기를 들려주시지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420205
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420205,
					"content": "근데 음포소 할아버지는 말솜씨가 없어서 이야기가 따분하고 지루하다니까. 유적의 문양에서 무슨 토템 「선배」 인지 알아낼 수 있다는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420206
					],
					"speakerTitle": "두치에"
				},
				{
					"id": 751420206,
					"content": "토템 「숭배」야…. 음포소 할아버지는 이야기꾼보다 고고학자에 가까워서 그래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420207
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420207,
					"content": "음포소 할아버지도 옛날에 화산을 탐사하셨다고 들었는데, 도움이 될지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "두니야"
				}
			]
		},
