						"position": [
							-2692.544,
							286.745,
							10158.87
						],
						"pointId": 351700001
					}
				]
			},
			"dialogs": [
				{
					"id": 751420701,
					"content": "신성한 산님은 속이 안 좋아서 매일 토하고 있어. 너도 봤잖아! 지금 밖에서 노는 건 너무 위험해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420702
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420702,
					"content": "삼촌은 화산이 체했을 때 다 같이 힘껏 두드려 주면 괜찮아진다고 했어. 내 손은 작아서 불가능하겠지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420703
					],
					"speakerTitle": "두치에"
				},
				{
					"id": 751420703,
					"content": "어른들은 분명 두드릴 수 있을 거야. 하지만 우리를 부족 밖으로 나가지 못하게 하려고 미루는 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420704
					],
					"speakerTitle": "두치에"
				},
				{
					"id": 751420704,
					"content": "하하, 두치에 그게 아니야. 신성한 산님을 낫게 하려면… 부족의 모든 어른들이 함께 두드려야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420705
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420705,
					"content": "하지만 어른들은 다들 바쁘잖아. 바레사 언니만 봐도 과수원을 돌봐야 하니까. 모두가 한가할 때 다 같이 신성한 산님을 두드리는 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420706
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420706,
					"content": "네 말도 일리가 있네…. 휴, 어른들이 한가해질 때까지 기다려야 하는구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420707
					],
					"speakerTitle": "두치에"
				},
				{
					"id": 751420707,
					"content": "응응, 그러니까 그전까지는 어른들의 금지령을 따라야 해. 신성한 산님의 활동이 활발한 시기에는 부족에 얌전히 있자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420708
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420708,
					"content": "…알겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420709
					],
					"speakerTitle": "두치에"
				},
				{
					"id": 751420709,
					"content": "그게 무슨 얘기야? 뭘 두드린다는 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420710
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751420710,
					"content": "#우린… 아… 금발이랑 은빛의 작은 요정이다… 대영웅 {NICKNAME} {F#누나랑}{M#형이랑} 페이몬이구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420711
					],
					"speakerTitle": "두치에"
				},
				{
					"id": 751420711,
					"content": "우, 우린 아주 아주 중요한 부족의 비밀에 대해 얘기하고 있었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420712
					],
					"speakerTitle": "두치에"
				},
				{
					"id": 751420712,
					"content": "화산을 두드리는 게 부족의 비밀이구나…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420713
					]
				},
				{
					"id": 751420713,
					"content": "뭐, 뭐야. 다 들었잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420714
					],
					"speakerTitle": "두치에"
				},
				{
					"id": 751420714,
					"content": "두치에, 네 목소리가 너무 커서 그래. 다음에 비밀 얘기를 할 땐 귀에 대고 말해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420715
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420715,
					"content": "알겠어… 엇, 근데 너, 너무 가깝지 않아?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420716
					],
					"speakerTitle": "두치에"
				},
				{
					"id": 751420716,
					"content": "#헤헤, 아무튼. 음… 이방에서 온 영웅 {F#언니}{M#오빠} 난 두니야고, 얜 바보 두치에야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420717
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420717,
					"content": "또 바보래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420718
					],
					"speakerTitle": "두치에"
				},
				{
					"id": 751420718,
					"content": "비옥한 터전에 온 걸 환영해. 그리고 거기 꼬마 산룡도… 이상하네. 신성한 산님의 상태가 이상해서 그런가… 부락에는 외부 용을 막는 룬이 있는데 어떻게 들어온 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420719
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420719,
					"content": "후후, 그건 룬을 두드릴 때가 됐다는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420720
					],
					"speakerTitle": "두치에"
				},
				{
					"id": 751420720,
					"content": "지금 두드려야 할 건 바보 두치에의 머리 같은데…. 그나저나 대영웅이 무슨 일로 「비옥한 터전」에 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420721
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420721,
					"content": "도움이 필요한 일이라도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420722
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420722,
					"content": "두니야와 두치에에게 신성한 산에 들어가고 싶은 이유를 설명했다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751420723
					]
				},
				{
					"id": 751420723,
					"content": "「신성한 산에 들어가는」 건 쉬운 일이 아니야…. 어른들은 신성한 산이 위험하다고 경고했거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420724
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420724,
					"content": "#하지만 {NICKNAME} {F#언니}{M#오빠}한테는 들어가야 하는 나름의 이유가 있겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420725
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420725,
					"content": "음… 신성한 산에 들어갔던 사람을 알고 있긴 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420726
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420726,
					"content": "나, 나도 알아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420727
					],
					"speakerTitle": "두치에"
				},
				{
					"id": 751420727,
					"content": "「신성한 산」은 엄청 중요한 곳 같은데, 이렇게 쉽게 알려줘도 괜찮은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420728
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751420728,
					"content": "「신성한 산」은 고대 두루마리로부터 전해 내려온 이름일 뿐이야… 지금 우리한테는 「성화 경기장」이 더 신「성」해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420729
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420729,
					"content": "출입 금지령을 내린 이유는 화산 안이 위험하기 때문이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420730
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420730,
					"content": "실제로 「회의소」에서 탐사단을 꾸려 화산에 들어간 적이 있어…. 헤헤, 나도 크면 들어가서 놀 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420731
					],
					"speakerTitle": "두치에"
				},
				{
					"id": 751420731,
					"content": "그건 너무 위험하다고 말했잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420732
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420732,
					"content": "음… 자세한 건 나도 잘 모르니까 <color=#00E1FFFF>음포소 할아버지</color>를 찾아가 봐. 도움이 된다면 할아버지도 기뻐하실 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420733
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420733,
					"content": "「빈둥대는 음포소 할아버지」라… 차라리 <color=#00E1FFFF>키모시</color>에게 가봐. 헤헤, 우리 삼촌인데 탐사단 출신이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420734
					],
					"speakerTitle": "두치에"
				},
				{
					"id": 751420734,
					"content": "음포소 할아버지한테 빈둥댄다고 하지 마…. 음, 한 분은 <color=#00E1FFFF>산 남쪽의 발굴지</color>에 계시고, 한 분은 <color=#00E1FFFF>마을 서쪽의 분출 유적</color> 쪽에 계셔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420735
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420735,
					"content": "미안하지만, 지금은 신성한 산님의 「분출」 시기라… 안내해 줄 수가 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420736
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420736,
					"content": "괜찮아, 이만큼 알려준 걸로도 충분해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420737
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751420737,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}! 돌아왔구나, 출발할 시간이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420738
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751420738,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420739
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751420739,
					"content": "헤헤, 정말 귀여운 녀석이네. 꼬리에 묶은 손수건도 너무 예쁘다. 신성한 산님이 잠들면 부족 밖에서 같이 놀자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420740
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420740,
					"content": "좋아! 다음에 같이 놀자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
}