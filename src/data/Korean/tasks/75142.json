			},
			"dialogs": [
				{
					"id": 751420101,
					"content": "아, 이방의 영웅, 무슨 일 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420102
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420102,
					"content": "「발굴지」와 「분출 유적」을 못 찾았구나? 그렇다면 어쩔 수 없이 어른들의 금지령을 어기는 수밖에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420103
					],
					"speakerTitle": "두치에"
				},
				{
					"id": 751420103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420104
					],
					"speakerTitle": "두니야"
				},
				{
					"id": 751420104,
					"content": "흑, 알았어… 나가지 않을게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420105
					],
					"speakerTitle": "두치에"
				},
				{
					"id": 751420105,
					"content": "#그럼 {NICKNAME} {F#언니}{M#오빠}… 뭐 물어보고 싶은 거 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "두니야"
				}
			]
		},
		{
			"id": 7514202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
