			"dialogs": [
				{
					"id": 205140401,
					"content": "응? 진짜 신기하네. 네가 왜 여기에?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140402
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 205140402,
					"content": "여자애를 본 적 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140403
					]
				},
				{
					"id": 205140403,
					"content": "여자애? 안나 말하는 거야? 당연히 봤지. 아까 전에 저 풍차 쪽으로 뛰어갔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140404
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 205140404,
					"content": "그 애 몸이 안 좋은 거 아니었나? 근데 갑자기 활력이 넘쳐서 이상하게 생각하고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140405
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 205140405,
					"content": "나한테 인사하고 나서 뛰어갔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140406
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 205140406,
					"content": "병이 언제 다 나은 거지…. 뭐 짚이는 거 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
