					"앤서니"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140101,
					"content": "이게 대체 어떻게 된 일이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140102
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205140102,
					"content": "무슨 일이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140103
					]
				},
				{
					"id": 205140103,
					"content": "너구나, 마침 잘 왔어…. 명의가 준 약을 먹은 뒤부터 안나의 병세가 점점 좋아졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140104
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205140104,
					"content": "예전엔 몸이 안 좋아서 요양하느라 계속 집에만 있었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140105
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205140105,
					"content": "몸 상태가 좋아지니까 매일 밖에 나가 놀자고 조르는 거야. 난 어쩔 수 없이 허락했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140106
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205140106,
					"content": "근데… 지금 안나가 어딨는지 아예 못 찾겠어. 대체 어디로 간 거야…. 빨리 안나 좀 찾아줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140107,
						205140110,
						205140113
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205140107,
					"content": "아, 알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140108
					]
				},
				{
					"id": 205140108,
					"content": "난 여기서 기다리고 있을 테니까, 어서 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140109
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205140109,
					"content": "몸이 괜찮아진지 얼마나 됐다고 이 난리야…. 만약 무슨 일이라도 생기면 어떡하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205140116,
					"content": "벌써 오랫동안 찾아다녔어…. 모험가 길드 쪽만 찾아보면 되는데, 이젠 움직일 힘이 하나도 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140117
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205140117,
					"content": "우선 모험가 길드 쪽에 가서 찾아봐. 그리고 사이러스 씨가 뭔가 알아차릴 수도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140118
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205140118,
					"content": "찾으면 좋겠다. 아니면 나도 다시 찾기 시작해야 하니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205140110,
					"content": "기분 좋아 보이는데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140111
					]
				},
				{
					"id": 205140111,
					"content": "좋아 보인다고? 무, 무슨 헛소리야! 그 녀석 몸이 좀 괜찮아지자마자 이 난린데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140112
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205140112,
					"content": "돌아오면, 한번 혼내야겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205140113,
					"content": "배고프면 돌아오겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140114
					]
				},
				{
					"id": 205140114,
					"content": "내 여동생이 고양이인 줄 아나…. 게다가 몸이 나은 지도 얼마 안 됐는데, 배고프긴 무슨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140115
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 205140115,
					"content": "됐고, 어서 안나 좀 찾아줘. 난 여기서 기다릴게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "앤서니"
				}
			]
		},
