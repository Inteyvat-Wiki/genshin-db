			"dialogs": [
				{
					"id": 741540201,
					"content": "수상하다, 수상해! 나조차도 수상하다는 걸 눈치챘다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741540202,
					"content": "#{NICKNAME}, 넌 똑똑하니까 어떻게 하면 좋을지 생각해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540203,
						741540204,
						741540205,
						741540206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741540203,
					"content": "브누아 씨는 구해달라고 했다가 번복했어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540207,
					"content": "그럼 우리 다시 브누아 집 근처로 가볼까? 뒤쪽 창문에 이상한 상자가 있었잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741540208,
					"content": "분명히 거기에 뭔가 숨겨져 있을 거야. 네 추측을 증명해 줄 수 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741540204,
					"content": "그 부부는 아마 잿빛의 강 출신일 거야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540205,
					"content": "그들의 반응을 보면 다른 사정이 있을지도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540206,
					"content": "증거는 부족하지만, 짐작 가는 게 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				}
			]
		},
