				]
			},
			"dialogs": [
				{
					"id": 741540701,
					"content": "너희의 집착을 감안하면 이대로 돌아갈 리 없다고 생각했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540702
					],
					"speakerTitle": "아토스"
				},
				{
					"id": 741540702,
					"content": "바로 법률 집행청에 신고할 줄 알았는데 아니었네. 보아하니, 너희도 너희만의 생각이 있나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540703,
						741540704
					],
					"speakerTitle": "아토스"
				},
				{
					"id": 741540703,
					"content": "왜 브누아 씨를 가둔 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				},
				{
					"id": 741540705,
					"content": "솔직히 제법 감탄했어. 너희가 그 열정을 제대로 된 곳에 사용한다면 대단한 녀석이 될 수도 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540706
					],
					"speakerTitle": "아토스"
				},
				{
					"id": 741540706,
					"content": "하지만 이번 일에 사용해선 안 돼. 휴, 너흰 정말 겁도 없구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540707
					],
					"speakerTitle": "아토스"
				},
				{
					"id": 741540707,
					"content": "협박할 사람을 잘못 찾으셨어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540708
					]
				},
				{
					"id": 741540708,
					"content": "오? 상황 파악이 안 되는 거야 아니면 정의감에 취해 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540709
					],
					"speakerTitle": "아토스"
				},
				{
					"id": 741540709,
					"content": "그러고 보니 아까 신문에서 언급했던 익사한 상인 이름이 브란트였지? 음, 말솜씨가 아주 기막힌 녀석이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540710
					],
					"speakerTitle": "아토스"
				},
				{
					"id": 741540710,
					"content": "그거 알아? 신문에 따르면 사실 그 녀석은 익사한 게 아니라 살해당한 후 호수에 빠진 거래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540711
					],
					"speakerTitle": "아토스"
				},
				{
					"id": 741540711,
					"content": "그림자 수사청에선 이 사건을 한참 동안 조사했지만, 피해자는 살해당했으며 가해자는 벌을 받아 마땅하다는 것만 알아낼 수 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540712
					],
					"speakerTitle": "아토스"
				},
				{
					"id": 741540712,
					"content": "그래서 신문은 그 결과를 그대로 보도했는데, 실제 상황은 과연 어땠을까? 가해자가 더 나빴을까? 아니면 피해자가 더 나빴을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540713
					],
					"speakerTitle": "아토스"
				},
				{
					"id": 741540713,
					"content": "음… 이건 복잡한 문제라서 난 아직 답을 찾지 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540714
					],
					"speakerTitle": "아토스"
				},
				{
					"id": 741540714,
					"content": "아, 말이 샜네. 그 일은 우리가 할 얘기와는 상관없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540715
					],
					"speakerTitle": "아토스"
				},
				{
					"id": 741540715,
					"content": "대체 무슨 말을 하고 싶은 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540716
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741540716,
					"content": "사건을 완벽하게 파악하기 전에 섣불리 행동하는 건, 나쁜 결과를 초래할지도 모르는 어리석은 짓이라는 뜻이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540717,
						741540718
					],
					"speakerTitle": "아토스"
				},
				{
					"id": 741540717,
					"content": "불의를 모른 척하는 게 더 어리석어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540719,
					"content": "하하, 다른 곳에서 만났다면 우린 친구가 됐을지도 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540720
					],
					"speakerTitle": "아토스"
				},
				{
					"id": 741540720,
					"content": "네 생각은 나랑 잘 맞지만, 지금 난 할 일이 있어서 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540721
					],
					"speakerTitle": "아토스"
				},
				{
					"id": 741540721,
					"content": "이건 내 마지막 인내심이야. 다음에 또 너희가 내 집 근처에서 돌아다니는 걸 보면 그땐 절대 가만있지 않을 거다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540722
					],
					"speakerTitle": "아토스"
				},
				{
					"id": 741540722,
					"content": "아토스는 이해하기 어려운 말을 남기고 떠난다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540723
					]
				},
				{
					"id": 741540723,
					"content": "그의 수상한 태도에 의아한 당신은 이번 사건에서 어떠한 입장을 취해야 할지 생각한다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540724
					]
				},
				{
					"id": 741540724,
					"content": "뒤쪽 창문에서 유리 두드리는 소리가 들린다. 이윽고 작은 「삐걱」 소리와 함께 쪽지 한 장이 창문에서 떨어진다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540725
					]
				},
				{
					"id": 741540725,
					"content": "쪽지에는 갈색 글씨가 적혀 있다. 매우 다급하게 커피를 묻혀서 쓴 글 같다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540726
					]
				},
				{
					"id": 741540726,
					"content": "뭐라고 적혀있는지 얼른 확인해 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540727
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741540727,
					"content": "브누아가 쓴 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540728
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741540728,
					"content": "쉿",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540729
					]
				},
				{
					"id": 741540729,
					"content": "…미안, 어쨌든 고양이 밥그릇을 주시하면서 녀석의 신호를 기다리자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741540718,
					"content": "전 불의를 보면 적극적으로 행동하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540704,
					"content": "브누아 씨는 당신들과 무슨 관계죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				}
