							9785.573
						],
						"pointId": 11326
					}
				]
			},
			"dialogs": [
				{
					"id": 751940101,
					"content": "잠깐, 잠깐, 이건 파는 물건이니까 살 거 아니면 만지지 마! 어라… 거기, 금발 손님, 그래 너. 그렇게 급하게 가지 말고 잠깐 나 좀 봐봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940102
					],
					"speakerTitle": "쿨레마나"
				},
				{
					"id": 751940102,
					"content": "음——역시. 태양처럼 눈부시게 빛나는 머리카락에 밤의 신의 나라처럼 깊은 두 눈… 내 생각에 넌, 아니, 장담컨대 넌 아주 대단한 인물이 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940103
					],
					"speakerTitle": "쿨레마나"
				},
				{
					"id": 751940103,
					"content": "자자자, 여기 이 결정 세트 보이지? 여기엔 아주 다양한 선율이 담겨 있어. 너 같은 영웅한테 아주 딱이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940104
					],
					"speakerTitle": "쿨레마나"
				},
				{
					"id": 751940104,
					"content": "원래는 값을 매길 수 없는 보물이라 평범한 사람이면 적어도 천만 모라 정도는 받아야 하는데, 넌 이 결정이랑 인연이 있어 보이니 특별히 할인해서 10%만 받을게. 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940105
					],
					"speakerTitle": "쿨레마나"
				},
				{
					"id": 751940105,
					"content": "뭐?! 10%? 완전 파격 세일이잖아! 잠깐… 그래도 백만 모라가 넘는데? 너무 비싼 거 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751940106,
					"content": "휴, 어쩔 수 없어. 이 정도면 거의 원가라구. 우리 같은 소상공인들에겐 쉽지 않은 가격이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940107,
						751940108
					],
					"speakerTitle": "쿨레마나"
				},
				{
					"id": 751940107,
					"content": "경비를 이렇게 벌면 안 되죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				},
				{
					"id": 751940109,
					"content": "다 들은 모양이네. 하핫, 내가 혼잣말하는 버릇이 있거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940110
					],
					"speakerTitle": "쿨레마나"
				},
				{
					"id": 751940110,
					"content": "휴, 다 들킨 마당에 솔직하게 말할게. 사실 이 결정은 주운 거라 그 정도 값어치는 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940111
					],
					"speakerTitle": "쿨레마나"
				},
				{
					"id": 751940111,
					"content": "하지만 나도 어쩔 수 없었어. 네가 들은 대로 우린 경비가 부족한 상황이거든. 수면 위 부표 데이터를 회수해 줄 조수를 구할 돈도 마련하지 못했고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940112
					],
					"speakerTitle": "쿨레마나"
				},
				{
					"id": 751940112,
					"content": "이렇게 사기 칠 바엔 차라리 회수하는 걸 포기하면 되잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751940113,
					"content": "그럴 순 없어…. 다른 조직은 경비가 부족하면 활동을 멈추지만, 우리 조직은 화산을 관찰하는 자원봉사 임무를 맡고 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940114
					],
					"speakerTitle": "쿨레마나"
				},
				{
					"id": 751940114,
					"content": "우리가 부표를 띄운 것도 수온과 같은 데이터를 수집해서 화산 활동 상황을 관측하기 위해서야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940115
					],
					"speakerTitle": "쿨레마나"
				},
				{
					"id": 751940115,
					"content": "갈수록 화산 활동이 활발해지고 있는데, 서둘러 부표를 회수하지 않으면 정말 큰일이 날 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940116
					],
					"speakerTitle": "쿨레마나"
				},
				{
					"id": 751940116,
					"content": "근데 내가 다쳐서 부표를 부수는 일을 할 수 없게 됐어. 그 안에 있는 데이터를 회수하는 건 두말할 것도 없고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940117
					],
					"speakerTitle": "쿨레마나"
				},
				{
					"id": 751940117,
					"content": "#{NICKNAME}, 우리가 도와줄까? 화산에 관한 건 모두의 안전과도 관련이 있고, 또 이렇게 못 본 척할 수는 없잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751940118,
					"content": "저, 정말? 날 도와주면 이 결정들을 공짜로 줄게! 보수라고 생각해, 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940119,
						751940120
					],
					"speakerTitle": "쿨레마나"
				},
				{
					"id": 751940119,
					"content": "백만 모라라고 하지 않았나요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940121,
					"content": "걱정 마, 가진 게 많지는 않지만 결정 말고도 추가로 보수를 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940122
					],
					"speakerTitle": "쿨레마나"
				},
				{
					"id": 751940122,
					"content": "헤헤, 결정이면 충분해! 이건 화산 근처에 있는 사람들을 위한 거니까! 아무튼 걱정 말고 우리한테 맡겨줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940123,
						751940124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751940123,
					"content": "바로 시작하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 751940124,
					"content": "준비가 필요해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940125
					]
				},
				{
					"id": 751940125,
					"content": "언제든지 네가 편할 때 시작해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쿨레마나"
				},
				{
					"id": 751940120,
					"content": "흠… 결정이 다예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940108,
					"content": "어떤 조수를 고용하길래 백만 모라나 드나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				}
			]
		},
		{
			"id": 7519404,
			"completionStepIds": [
				7519404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
