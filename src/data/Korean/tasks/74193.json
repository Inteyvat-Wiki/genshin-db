						741930507
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930507,
					"content": "#페이몬, 친구… 진심! {NICKNAME}, 친구… 진심! 그러니까… 교환!",
					"roleType": "TALK_ROLE_NPC",
