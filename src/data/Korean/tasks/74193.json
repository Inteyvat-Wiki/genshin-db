			},
			"dialogs": [
				{
					"id": 741930101,
					"content": "#페이몬! {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930102
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930102,
					"content": "와! 프샤비다! 또 만나서 정말 기뻐! 여기서 뭐 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741930103,
					"content": "프샤비… 일해! 프샤비… 힘들어! 프샤비… 쉬어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930104
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930104,
					"content": "음…? 일하는 중이라는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741930105,
					"content": "그윽한 숲의 가지… 그윽한 숲의 가지… 정말 잃었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930106
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930106,
					"content": "그윽한 숲의 가지? 그게 뭔데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741930107,
					"content": "그윽한 숲의 가지… 정보!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930108
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930108,
					"content": "버드나무, 수집. 안갯길, 처리. 샘의 눈, 발송",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930109
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930109,
					"content": "그윽한 숲의 가지, 안갯길 정보!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930110
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930110,
					"content": "그게 그윽한 숲속 안갯길의 정보야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930111
					]
				},
				{
					"id": 741930111,
					"content": "프샤비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930112
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930112,
					"content": "그윽한 숲의 가지… 정말 잃었어! 정말 많은 곳!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930113
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930113,
					"content": "프샤비… 찾아! 프샤비… 힘들어! 프샤비… 먹어! 프샤비… 쉬어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930114
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930114,
					"content": "그윽한 숲의 가지… 정말 안 많아! 하지만 상자 정말 많아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930115
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930115,
					"content": "#아… 고마워, 페이몬. 고마워, {NICKNAME}, 받아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930116
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930116,
					"content": "너 또 우리를 위해 보물상자를 찾아준 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930117
					]
				},
				{
					"id": 741930117,
					"content": "프샤비! 상자, 보물, 꽃, 반짝이, 달콤이, 정말 많아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930118
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930118,
					"content": "와, 또 다른 물건이 있다고? 프샤비, 정말 고마워. 하지만 공짜로 받기는 미안하니까 우리 교환하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741930119,
					"content": "교… 교환?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930120
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930120,
					"content": "우리는 친구잖아. 친구끼리 진심과 진심을 교환하는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741930121,
					"content": "그러니까 우리가 그윽한 숲의 가지를 찾아서 네 보물로 교환할게, 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741930122,
					"content": "겸사겸사 먹을 것도 찾아다 줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930123
					]
				},
				{
					"id": 741930123,
					"content": "참, 프샤비는 밖에서 혼자 사니까 힘들겠구나. 먹을 것도 찾아줘야겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741930124,
					"content": "먹을 거! 돌말! 프샤비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930125
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930125,
					"content": "돌말을 좋아해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930126
					]
				},
				{
					"id": 741930126,
					"content": "돌말! 돌말! 돌말돌말돌말!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930127
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930127,
					"content": "하루에 5끼를 먹는다는 거야, 아니면 한 번에 5개를 먹는다는 거야? 와… 아무튼 먹성이 나보다 더 좋은 것 같네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741930128,
					"content": "그럼 그윽한 숲의 가지는 어디 있어, 프샤비? 그윽한 숲속 안갯길에서 찾을 수 있는 거 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741930129,
					"content": "멜뤼진…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930130
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930130,
					"content": "그윽한 숲의 가지… 정말 잃었어! 정말 많은 곳! 정말 에리니에스!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930131
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930131,
					"content": "그윽한 숲의 가지가 에리니에스 전체에 있다는 뜻이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930132
					]
				},
				{
					"id": 741930132,
					"content": "#똑똑한 {NICKNAME}! 프샤비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930133
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930133,
					"content": "안갯길, 꽃 있어. 그윽한 숲의 가지도, 꽃 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930134
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930134,
					"content": "그윽한 숲의 가지… 그윽한 숲의 가지… 그윽한 숲의 가지… 그윽한 숲의 가지… 그윽한 숲의 가지… 그윽한 숲의 가지… 수량!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930135
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930135,
					"content": "아… 이번에는 알아듣겠다! 그윽한 숲의 가지가 있는 곳에는 그윽한 숲속 안갯길과 똑같은 꽃이 자라있고, 총 6군데라는 뜻이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930136
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741930136,
					"content": "똑똑한 페이몬! 프샤비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930137
					],
					"speakerTitle": "프샤비"
				},
				{
					"id": 741930137,
					"content": "헤헤, 이번엔 제대로 이해했네. 프샤비, 그럼 푹 쉬고 있어. 우리한테 맡겨!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930138
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741930138,
					"content": "#페이몬, {NICKNAME}, 착해! 그러니까 천천… 천천히! 프샤비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "프샤비"
				}
			]
