			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"류지",
					"산고"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361401,
					"content": "여행자도 시간이 없다고 하면 어떡하죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361402
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361402,
					"content": "그건 내 알 바 아니죠. 그러길래 누가 그렇게 귀찮은 일을 맡으래요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361403
					],
					"speakerTitle": "산고"
				},
				{
					"id": 190361403,
					"content": "어라, 운이 좋네요. 구세주가 왔어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361404
					],
					"speakerTitle": "산고"
				},
				{
					"id": 190361404,
					"content": "네? 살았다! 여행자, 와줬구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361405
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361405,
					"content": "네, 요새 별로 안 바쁘거든요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361406
					]
				},
				{
					"id": 190361406,
					"content": "호랑이도 제 말하면 온다더니, 되게 한가한가 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361407
					],
					"speakerTitle": "산고"
				},
				{
					"id": 190361407,
					"content": "사장님!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361408
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361408,
					"content": "여행자보다 사장님이 더 한가하시잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361409
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361409,
					"content": "그럴 리가요. 제가 얼마나 바쁜데요. 여기에 하루 종일… 서 있어야 하는걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361410
					],
					"speakerTitle": "산고"
				},
				{
					"id": 190361410,
					"content": "아무리 받기 싫은 의뢰라고 해도, 핑계가 너무 성의 없는 거 아닌가요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361411
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361411,
					"content": "받기 싫은 의뢰?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361412
					]
				},
				{
					"id": 190361412,
					"content": "맞아…. 사실은 그것 때문에 널 부른 거야. 상황 설명부터 할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361413
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361413,
					"content": "최근 텐료 봉행의 중요 인사 한 명이 실종됐어. 연락도 안 되는 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361414
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361414,
					"content": "이런저런 이유로 텐료 봉행 쪽에서 대대적인 수색을 펼칠 수는 없다고 해. 그래서 우리에게 개인적으로 의뢰가 들어왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361415
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361415,
					"content": "그 사람의 이름은 바로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361416
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361416,
					"content": "쿠죠 사라야. 텐료 봉행의 대장이 실종됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361417
					],
					"speakerTitle": "산고"
				},
				{
					"id": 190361417,
					"content": "…정말 그 대장님이 실종됐다면 이나즈마성이 조용할 리 있겠어요? 그랬다면 우리에게만 의뢰할 리가 없잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361418
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361418,
					"content": "여행자, 사장님이 헛소리한 거야. 실종된 사람은 시카노인 헤이조라고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361419
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361419,
					"content": "그는 봉행소의 특별 탐정이야. 직급은 도신인데 능력이 출중해서 봉행소가 아주 중요시하는 사람이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361420
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361420,
					"content": "음? 저보다 능력이 출중한가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361421
					],
					"speakerTitle": "산고"
				},
				{
					"id": 190361421,
					"content": "사장님, 안 도와주실 거면 적어도 방해는 하지 말아 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361422
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361422,
					"content": "미안해, 여행자. 의뢰를 받기는 했지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361423
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361423,
					"content": "너도 보다시피 사장님은… 이 일에 끼어드는 걸 별로 원치 않으셔",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361424,
						190361425
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361424,
					"content": "보수가 너무 적어서요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				},
				{
					"id": 190361426,
					"content": "땡! 틀렸어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361427
					],
					"speakerTitle": "산고"
				},
				{
					"id": 190361427,
					"content": "이유는 간단해, 난 그 녀석 일에는 절대 안 끼어들 거거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361428
					],
					"speakerTitle": "산고"
				},
				{
					"id": 190361428,
					"content": "시카노인이 실종된 것보다 더 반가운 소리는… 시카노인이 백 년 동안 실종됐다는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361429
					],
					"speakerTitle": "산고"
				},
				{
					"id": 190361429,
					"content": "흠흠… 아무튼 산고 사장님이랑 헤이조 씨의 사이가 그렇게 좋지는 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361430
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361430,
					"content": "아하… 라이벌인 거네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361431
					]
				},
				{
					"id": 190361431,
					"content": "흠흠… 아니, 그것보다 더 심각해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361432
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361432,
					"content": "사장님은 헤이조 씨가 진실의 성전으로 가는 길의 걸림돌이라 했거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361433
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361433,
					"content": "정말 짜증 나는 녀석이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361434
					],
					"speakerTitle": "산고"
				},
				{
					"id": 190361434,
					"content": "휴… 헤이조 씨의 성격이… 음… 별나다고 해야 하나? 그래도 절대 나쁜 사람은 아니야, 나한테 많은 걸 가르쳐줬으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361435
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361435,
					"content": "그래서 사장님이 반대한다 해도, 난 모른 척할 수 없어. 적어도 믿을 수 있는 사람한테 의뢰를 맡기고 싶어. 예를 들면 전지전능한 여행자한테 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361436,
						190361437
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361436,
					"content": "그러니까 전 외주인 거네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361438,
					"content": "아… 아, 아니! 그… 텐료 봉행이 약속한 보수는 한 푼도 빼지 않고 다 줄게! 개인적으로 추가 금액도 지불할 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361439
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361439,
					"content": "그러니까 제발 이 의뢰를 맡아줬으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361440
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361440,
					"content": "헤이조 씨가 정말 위험한 상황에 처한 거라면, 네가 도와주는 게 안전할 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361441,
						190361445
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361441,
					"content": "류지 씨랑 친한 사이인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361442
					]
				},
				{
					"id": 190361442,
					"content": "우리 둘의 관계는 나쁘지 않아. 다만 산고 사장님이 계속 거리를 두라고 하셔서 대놓고 친한 티를 못 내는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361443
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361443,
					"content": "그래서 다른 사람이 물어보면, 시카노인 씨랑은 얼굴만 몇 번 본 사이라고 말하고 있어. 이 일이 아니었으면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361444
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361444,
					"content": "흠흠… 일단 그것보다 혹시 그를 좀 찾아줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361449,
					"content": "알겠어요, 바로 출발할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361450
					]
				},
				{
					"id": 190361450,
					"content": "음, 정보는 대충 이 정도야. 이건 봉행소의 의뢰서니까 헤이조 씨를 찾으면 바로 봉행소에 보고해 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "류지"
				},
				{
					"id": 190361445,
					"content": "좋아요. 근데 정보가 더 필요해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361446
					]
				},
				{
					"id": 190361446,
					"content": "정말 고마워! 헤이조 씨가 실종 전에 와타츠미섬에 관심을 보였다는 정보를 입수했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361447
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361447,
					"content": "전쟁 기간에 와타츠미섬에서 임무를 수행했던 모양이야. 전쟁이 끝나고도 와타츠미섬에 자주 왔다 갔다 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361448
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361448,
					"content": "듣자 하니 넌 산호궁이랑 보통 인연이 아니라고 하던데, 거기서부터 조사를 시작하면 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "류지"
				},
				{
					"id": 190361437,
					"content": "그러니까 류지 씨가 브로커인 거네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361425,
					"content": "단서가 너무 적어서요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				}
			]
		},
		{
			"id": 1903615,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
