	"talks": [
		{
			"id": 7350601,
			"completionStepIds": [
				7350601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350601",
							"2"
						],
						"stepId": 7350601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"에펜디"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735060101,
					"content": "안녕하세요. 취사청에 오신 걸 환영해요. 의뢰가 있는데 관심 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060102
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 735060102,
					"content": "혹시 하나도 안 힘들고 가만히 서서 모라를 왕창 받을 수 있는 일 없어? 그런 일에 관심이 아주 많거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735060103,
					"content": "그… 그런 의뢰는 아직 없지만 비교적 쉬운 주민 의뢰가 있는데 보수는 몇만 모라 정도 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060104
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 735060104,
					"content": "음… 몇만 모라? 그 정도는 부족한데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060105,
						735060106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735060105,
					"content": "모라가 많으면 많을수록 좋아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060107
					]
				},
				{
					"id": 735060107,
					"content": "그래, 에펜디. 보수가 더 많은 의뢰는 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735060108,
					"content": "아, 그래요? 그럼… 요즘 스판타마드 학부에서 새로운 지맥 연구를 시작했는데, 유상으로 지원자를 모집 중이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060109
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 735060109,
					"content": "스판타마드 학부에는 지맥 연구 전공인 학자가 많아서 지맥 데이터의 수요가 많아요. 그래서 종종 비경으로 들어가서 지맥 이상을 조사해야 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060110
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 735060110,
					"content": "요즘 일손이 학부 학생까지 동원했는데도 부족할 정도라 지원자를 대량으로 모집하고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060111
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 735060111,
					"content": "보수는 많지만 지원자에 대한 요구도 엄격한데, 관심 있으세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060112
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 735060112,
					"content": "어떤 요구가 있는데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060113
					]
				},
				{
					"id": 735060113,
					"content": "모집 절차에 따라 확인해 드릴게요. 우선, 「한 가지 이상의 무기를 능숙하게 다룰 수 있나요?」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060114,
						735060115
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 735060114,
					"content": "전 한손검에 통달했죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060116
					]
				},
				{
					"id": 735060116,
					"content": "좋습니다. 그럼 「원소에 대해 얼마나 아시나요? 원소의 힘을 사용할 수 있나요?」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060117,
						735060118
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 735060117,
					"content": "원소 반응을 아주 잘 알고 있죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060119
					]
				},
				{
					"id": 735060119,
					"content": "네, 그럼 기록해 두겠습니다. 필요한 물자랑 보수는 추후 제가 조율해 드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060120
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 735060120,
					"content": "구체적인 업무 인수인계는 가푸르 씨를 찾아가야 하는데, 오늘 중요한 방문객이 있어서 아마 아카데미아에 안 계실 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060121
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 735060121,
					"content": "아카데미아 방문객 접대 표준 절차에 따라 아마 푸스파 커피숍에 갔을 텐데, 방문객 접대가 끝나면 얘기해 보세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060122
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 735060122,
					"content": "정말이지, 저한테 연락할 땐 그렇게 급하다고 하더니, 왜 갑자기 방문객을 맞이하러 간 건지 모르겠네요. 얼마나 중요한 손님이길래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "에펜디"
				},
				{
					"id": 735060118,
					"content": "원소의 힘을 사용한 전투 경험이 풍부하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060119
					]
				},
				{
					"id": 735060115,
					"content": "사실 여러 가지 무기를 능숙하게 다룰 수 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060116
					]
				},
				{
					"id": 735060106,
					"content": "전 반짝이는 돌멩이를 원해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060107
					]
				}
			]
		},
		{
			"id": 7350602,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
