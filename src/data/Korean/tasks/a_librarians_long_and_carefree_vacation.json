			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"가푸르",
					"리사"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735060201,
					"content": "여기 커피, 아직 기억하나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060202
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060202,
					"content": "당연하죠. 제가 제일 자주 먹었던 건데 모를 리가 있나요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060203
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060203,
					"content": "가푸르 선배, 음… 지금은 가푸르 선생님이죠. 다 아는 사람끼리 빙빙 돌려서 말할 필요 없잖아요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060204
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060204,
					"content": "옛날 얘기에, 커피에, 하고 싶은 얘기가 있으면 그냥 말해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060205
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060205,
					"content": "저 사람이 바로 가푸르인가? 지금은 다른 사람이랑 얘기 중이니까 조금 기다려 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735060206,
					"content": "별일은 아닌데, 네가 아카데미아를 떠난 뒤로 당초의 프로젝트에 구심점이 없어졌달까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060207
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060207,
					"content": "키루스 선생님도 실망하셨어. 전부터 널 자랑스럽고 중요하게 여기셨거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060208
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060208,
					"content": "리사, 네가 아카데미아를 떠난 건 정말 아쉬운 일이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060209
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060209,
					"content": "그때 아카데미아에 남았으면, 네 재능에 지금쯤 허배드의 자리를 차지했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060210,
						735060211
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060210,
					"content": "(리사 씨다!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060212
					]
				},
				{
					"id": 735060212,
					"content": "내가 잘못 들은 거 아니지? 저건 페보니우스 기사단 도서관 사서 리사잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735060213,
					"content": "리사가 수메르의 아카데미아에서 공부했다는 건 들었지만 다 옛날 얘긴 줄 알았는데, 지금 여기서 뭐 하는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735060214,
					"content": "흠, 선배는 옛날 얘기로 절 다시 돌아오게 만들 생각인가 봐요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060215
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060215,
					"content": "후후, 지금 몬드의 페보니우스 기사단에서 도서관 사서를 한다며? 그건 네 재능을 썩히는 게 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060216
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060216,
					"content": "왜 네 시간을 도서관 관리 같은 사소한 일에 낭비하는 거야? 네 시간은 무엇보다 귀한 물건인데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060217
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060217,
					"content": "아카데미아로 돌아오면 네가 주축이 돼서 할 수 있는 프로젝트가 산더미야. 지금 아카데미아엔 인재가 필요해. 일부 중요한 연구는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060218
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060218,
					"content": "하암… 어쨌든 저더러 돌아와 달라는 거잖아요. 선배가 이러는 거, 키루스 선생님은 모르시죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060219
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060219,
					"content": "사실 은사님도 전부터 네가 아카데미아로 돌아오길 바라셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060220
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060220,
					"content": "…글쎄요? 가푸르 선배, 남을 속이는 건 좋은 행동이 아니에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060221
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060221,
					"content": "제가 왜 아카데미아에서 2년만 있다가 떠났는지 누구보다 잘 아는 선생님이 이런 요구를 하실 리가 없잖아요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060222
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060222,
					"content": "몬드의 생활을 포기하고, 아카데미아 소론파 학자의 신분으로 돌아가라…. 글쎄요, 지혜를 구하는 데 필요한 대가를 저는 더는 감당 못 해서요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060223
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060223,
					"content": "그러니까 절 돌아가게 하려는 노력은 그만두세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060224
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060224,
					"content": "우와, 리사가 소론파 학자였어? 한 번도 얘기한 적이 없어서 몰랐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060225,
						735060226
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735060225,
					"content": "목소리 좀 낮춰",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060227
					]
				},
				{
					"id": 735060227,
					"content": "그리고 도서 관리는 아주 중요한 일이에요. 시간 낭비라고 생각한 적 한 번도 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060228
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060228,
					"content": "「지혜는 세계의 모든 구석에 숨겨져 있으니, 작은 지혜라도 무시해선 안 된다.」 이건 선생님이 입에 달고 살았던 말이라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060229
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060229,
					"content": "훌륭한 학자는 사소한 걸 놓치면 안 되죠, 가푸르 선배. 방금 선배가 한 말은 세세한 오류가 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060230
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060230,
					"content": "그리고 선배는 눈치 못 챘을 디테일이 더 있는데, 지금 이 순간에도 우리 대화를 엿듣는 사람이 둘이나 있답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060231
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060231,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060232
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060232,
					"content": "거기 두 사람, 우리한테 볼일 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060233
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060233,
					"content": "헤헤, 안녕, 리사",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060234
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735060234,
					"content": "오랜만이에요, 리사 씨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060235
					]
				},
				{
					"id": 735060235,
					"content": "그래, 역시 너희 둘이었구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060236
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060236,
					"content": "오랜만이야, 귀염둥이랑 페이몬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060237
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060237,
					"content": "…두 분은 무슨 일이시죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060238
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060238,
					"content": "아 그게, 우리는 판타… 어… 스판타마드 학부의 지맥 조사 연구 때문에 왔는데, 아까 에펜디한테 신청을 마쳤거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060239,
						735060240
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735060239,
					"content": "그리고 마침 리사 씨를 만났죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060241
					]
				},
				{
					"id": 735060241,
					"content": "지맥 조사 연구? 설마 귀염둥이 너희도 아카데미아에 들어간 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060242
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060242,
					"content": "연구 지원자일 뿐이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060243
					]
				},
				{
					"id": 735060243,
					"content": "에펜디가 유상 지원자를 모집 중이라고 해서, 연구에 대해 알아보려고 가푸르를 찾아온 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060244
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735060244,
					"content": "유상 지원자? 가푸르 선배, 아카데미아에 사람이 그렇게 부족한가요? 아니면 외부인을 써야만 하는 계획이 있는 건지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060245
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060245,
					"content": "아니, 아니야. 이건 정규적인 지맥 관측에 필요한 연구고, 전부 안전 기준에 부합한 작업이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060246
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060246,
					"content": "대량의 인력을 투입해 지맥 데이터를 수집해야 해서 우리도 어쩔 수 없었어…. 네가 돌아와서 도와주면 이렇게 복잡하게 할 필요도 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060247
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060247,
					"content": "제 기억상 지맥 데이터 수집은 조사원이 비경 깊숙이 들어가야 하는 위험한 일일 텐데요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060248
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060248,
					"content": "#나랑 {NICKNAME}은(는) 몬드를 떠난 후에도 수많은 전투를 겪었어. 비경 탐사는 별거 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060249
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735060249,
					"content": "오랜만에 만났더니 그새 또 재밌는 일을 많이 겪었나 보구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060250
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060250,
					"content": "응, 그러니까 걱정 안 해도 돼, 리사",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060251
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735060251,
					"content": "연구에 참여하러 온 거면 저랑 리사의 얘기가 끝날 때까지 잠깐 기다려 주시죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060252
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060252,
					"content": "가푸르 선배, 미안해요. 전 안 돌아가요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060253
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060253,
					"content": "일말의 여지도 없는 것이냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060254
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060254,
					"content": "아카데미아를 떠나기로 한 결정은 지금도 후회 안 해요. 미래에도… 후회하지 않을 거고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060255
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060255,
					"content": "오랜 시간이 지났으니 다른 답을 얻을 줄 알았는데, 하아, 리사 넌 한결같이 고집스럽구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060256
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060256,
					"content": "뭐 그렇게까지 말하는데, 더 얘기해 봐야 아무 의미 없겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060257
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060257,
					"content": "나도 처리해야 할 일이 많으니까 여기까지 얘기할게. 그럼 며칠 후에 있는 학부 모임에서 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060258
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060258,
					"content": "네, 걱정하지 마요, 선배. 학부 모임에는 나갈 테니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060259
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060259,
					"content": "그리고 지원자 두 분은 이따 시간 될 때 마우티이마 숲으로 절 찾아오세요. 해주실 일이 있으니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060260
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060260,
					"content": "아 참, 리사, 마지막으로 하나 더…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060261
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060261,
					"content": "왜요, 선배?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060262
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060262,
					"content": "몬드에서 모든 일이 잘 풀리길 바라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060263
					],
					"speakerTitle": "가푸르"
				},
				{
					"id": 735060263,
					"content": "…고마워요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060264
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060264,
					"content": "자, 수다쟁이도 갔고, 이제 우리 귀염둥이랑 얘기를 나눠볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060265,
						735060266
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060265,
					"content": "수다쟁이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060267
					]
				},
				{
					"id": 735060267,
					"content": "후후, 아카데미아 내부에 큰일이 난 것 같은데, 우리 선배가 자기 앞길을 위해 바쁜 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060268
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060268,
					"content": "참, 리사는 어쩐 일로 수메르에 온 거야? 기사단 쪽은 괜찮아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060269
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735060269,
					"content": "당연히 진이 나에게 긴 유급 휴가를 줘서 왔지. 모처럼의 휴가니까 여행하면서 쉬는 것도 좋잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060270
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060270,
					"content": "들었는지 모르겠지만 난 수메르 아카데미아의 스판타마드 학부에서 2년 동안 공부했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060271
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060271,
					"content": "졸업하고서는 아카데미아에 남지 않고 몬드로 돌아와 기사단 도서관의 사서가 됐지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060272
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060272,
					"content": "그래서 수메르에 온 거구나. 여행하면서 옛날 친구랑 선생님을 볼 수 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060273
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735060273,
					"content": "리사 씨는 왜 아카데미아를 떠났나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060274
					]
				},
				{
					"id": 735060274,
					"content": "궁금해? 흠… 뭐, 알려줘도 괜찮겠지. 이미 오래전의 일이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060275
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060275,
					"content": "굳이 말하자면 이념이 달라서야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060276
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060276,
					"content": "아카데미아에 있었을 때, 날 좋게 보신 키루스 선생님은 아카데미아의 많은 핵심 연구에 참여할 수 있게 해주셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060277
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060277,
					"content": "근데 그중 대부분의 연구가 실패했어. 솔직히 초인적인 지혜를 얻으려고 너무 멀리 가버렸으니, 실패한 것도 당연지사였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060278
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060278,
					"content": "난 그런 미친 일을 하고 싶지 않아서 떠난 거고. 자, 이제 다 알았으니까 비밀로 해줘야 해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060279
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060279,
					"content": "음… 많은 일이 있었던 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060280
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735060280,
					"content": "그래서 키루스 선생님이 직접 와서 설득한다 해도, 난 아카데미아로 안 돌아가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060281
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060281,
					"content": "나에겐 밤낮없이 연구하는 것보다 아침 10시에 출근하고, 매일 같은 시간에 애프터눈 티를 즐기는 삶이 더 어울려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060282
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060282,
					"content": "역시 리사는 귀찮은 게 싫어서 도서관 사서를 한 거구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060283
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735060283,
					"content": "리사 씨답네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060284
					]
				},
				{
					"id": 735060284,
					"content": "일은 귀찮으니까, 난 여유로운 게 좋아. 그리고 주기적인 휴가가 얼마나 중요한데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060285
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060285,
					"content": "하아, 수메르에 온 지도 얼마 안 됐는데 간다르바 성곽에 그 아이를 보러 가기도 전에 가푸르 선배한테 잡혀버렸네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060286
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060286,
					"content": "내 얘기만 한참 했네. 귀염둥이랑 페이몬은? 무슨 일로 수메르에 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735060287
					],
					"speakerTitle": "리사"
				},
				{
					"id": 735060287,
					"content": "리사에게 수메르에서 보고 겪은 일을 들려준다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 735060266,
					"content": "가푸르 씨를 말하는 거군요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060267
					]
				},
				{
					"id": 735060240,
					"content": "두 분의 대화를 방해하고 싶지 않았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060241
					]
				},
				{
					"id": 735060226,
					"content": "페이몬, 쉿",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060227
					]
				},
				{
					"id": 735060211,
					"content": "(리사 씨가 왜 여기 있지?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735060212
					]
				}
			]
		},
