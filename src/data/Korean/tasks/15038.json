			"dialogs": [
				{
					"id": 150380701,
					"content": "(스커크가 아득히 먼 하늘을 바라본다)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150380702
					]
				},
				{
					"id": 150380702,
					"content": "(여기서 더 해야 할 일은 없는 것 같아. 떠나야 할까?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
