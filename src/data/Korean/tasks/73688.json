			"dialogs": [
				{
					"id": 736880301,
					"content": "저기 봐, 카미사토 아가씨랑 여행자가 나왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880302
					],
					"speakerTitle": "유우"
				},
				{
					"id": 736880302,
					"content": "분명히 전에 소설 삽화를 통해 봤던 의상인데도 카미사토 아가씨가 입으니까 독특한 분위기가 느껴져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880303
					],
					"speakerTitle": "사에"
				},
				{
					"id": 736880303,
					"content": "아침부터 줄 서서 시범 경기 맨 앞줄 자리를 차지한 보람이 있네. 오늘 경기는 정말 재밌을 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880304
					],
					"speakerTitle": "마츠마에"
				},
				{
					"id": 736880304,
					"content": "와, 아야카는 등장하는 것만으로도 모두의 시선을 사로잡네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736880305,
					"content": "관중 여러분, 정숙해주시기 바랍니다. 「연무 전심」의 시범 경기가 곧 시작되오니 질서 있게 대회장에 입장해서 자리에 앉아 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880306
					],
					"speakerTitle": "레이나"
				},
				{
					"id": 736880306,
					"content": "카미사토 아가씨, 여행자님, 두 분도 저와 같이 입장하시죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880307
					],
					"speakerTitle": "레이나"
				},
				{
					"id": 736880307,
					"content": "여행자님, 준비는 되셨나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880308,
						736880310
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736880308,
					"content": "물론이지, 바로 출발하자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880309
					]
				},
				{
					"id": 736880309,
					"content": "좋아요. 그럼 곧 있을 전투에서 잘 부탁드려요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 736880310,
					"content": "좀 더 준비가 필요해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880311
					]
				},
				{
					"id": 736880311,
					"content": "아직 시간이 있으니까 천천히 하세요. 준비가 되면 함께 대회장으로 입장하도록 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카미사토 아야카"
				}
			]
		},
