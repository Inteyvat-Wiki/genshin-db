			"dialogs": [
				{
					"id": 230170301,
					"content": "음… 이 정도 인장이면 충분해. 테스트를 진행할 수 있겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170302
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230170302,
					"content": "이건 보수이니 잘 넣어두라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170303
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230170303,
					"content": "여행자, 왜 그런 눈빛으로 보는 거지? 왠지 당황스러운데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170304
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230170304,
					"content": "큼! 난 일하러 가봐야겠어. 지금 바로 가야겠어…",
					"roleType": "TALK_ROLE_NPC",
