				"points": []
			},
			"dialogs": [
				{
					"id": 230175001,
					"content": "안녕하세요? 음… 뭐가 궁금하신 거죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175002
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 230175002,
					"content": "가르시아 씨와는 어떻게 아는 사이인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230175003
					]
				},
				{
					"id": 230175003,
					"content": "이렇게 단도직입적으로 묻다니, 모험가답네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175004
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 230175004,
					"content": "제가 소속된 극단에서 가르시아를 고용해 장부 정리를 맡겼죠. 그때 처음 만났어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175005
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 230175005,
					"content": "하하하, 그렇게 극단에 안 어울리는 사람은 솔직히 처음 봤어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175006
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 230175006,
					"content": "우리가 악기를 연주하고 춤을 추고 술을 마시고 노래를 부를 때도 가르시아와 루통은 그저 묵묵히 계산에만 몰두했죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175007
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 230175007,
					"content": "어느 날, 전 가르시아가 아주 이상한 옷을 입은 걸 발견했어요. 옷에는 무슨 도안 같은 게 그려져 있었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175008
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 230175008,
					"content": "그 도안이 뭐냐고 물었더니 기계의 설계도라고 하더군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175009
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 230175009,
					"content": "밖에서 다른 사람에게 기계의 원리를 설명할 때 갑자기 펜이랑 종이를 못 찾아서 옷에 그림을 그렸다고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175010
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 230175010,
					"content": "석탄으로 바로 옷에 설계도를 그려서 설명했다고 그러더군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175011
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 230175011,
					"content": "그 뒤로 지저분한 옷과 그 기계에 대해 오랫동안 얘기를 나눴어요. 대부분은 가르시아가 말하고 저는 듣는 역할이었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175012
					],
					"speakerTitle": "카이아"
				},
				{
					"id": 230175012,
					"content": "하하, 가르시아는 참 이상한 사람이에요… 하지만 매력적인 사람이기도 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카이아"
				}
			]
		},
