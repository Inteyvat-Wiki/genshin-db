			"dialogs": [
				{
					"id": 750360801,
					"content": "싹을 틔워라, 싹을 틔워라, 작은 씨앗아~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360802
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750360802,
					"content": "자라나라, 자라나라, 예쁜 꽃아~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360803
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750360803,
					"content": "…엥?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360804
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750360804,
					"content": "흐음…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360805
					]
				},
				{
					"id": 750360805,
					"content": "#앗, {NICKNAME}! 열소 에너지가 없어졌어. 씨앗이 흡수한 게 분명한데… 왜 아무런 반응이 없지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360806
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750360806,
					"content": "우웅?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360807,
						750360811
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360807,
					"content": "씨앗이 자라는 데 시간이 필요한 걸지도 몰라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360808
					]
				},
				{
					"id": 750360808,
					"content": "그런가? 일리가 있는 말인 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360809
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750360809,
					"content": "민들레는 「후——」하고 불면 하얀 우산을 가득 날려 보내고, 고리고리 열매는 늑대의 몸에 매달리면 아주 먼 곳까지 갈 수 있잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360810
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750360810,
					"content": "씨앗은 아주 생명력이 강한 녀석들이니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750360815,
					"content": "우리 일단 방해하지 말고 나중에 다시 보러 오자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360816
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750360816,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360811,
					"content": "어쩌면 씨앗이 겁을 먹었을 수도 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360812
					]
				},
				{
					"id": 750360812,
					"content": "그, 그런가? 하긴… 내가 너무 성급했나 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360813
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750360813,
					"content": "#씨앗은 갑자기 {REALNAME[ID(2)|SHOWHOST(true)]}에게 파내지기도 했고… 날벌레에게 양분을 빼앗긴 데다, 마물들이 주변에서 쿵쾅거리기도 했으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360814
					],
					"speakerTitle": "페이몬"
				},
