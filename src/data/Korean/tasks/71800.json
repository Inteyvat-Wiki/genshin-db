			"dialogs": [
				{
					"id": 718000301,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000302,
						718000305
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 718000302,
					"content": "옷이 다 젖었어요, 할머니...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718000303
					]
				},
				{
					"id": 718000303,
					"content": "정말 미안하구나. 내 생각이 짧았네. 안에 물이 얼마 없는 줄 알았거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000304
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 718000304,
					"content": "이 주전자도 이제 어느 정도 깨끗해진 것 같구나. 구석구석 남은 곳은 천천히 하면 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000307
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 718000307,
					"content": "할머니, 벽수강에 있는 물을 다 담아온 거야...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 718000308,
					"content": "그럴 리가. 다른 사람들도 물을 써야지...절반 정도만 담아왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000309
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 718000309,
					"content": "어쨌든 이번엔 정말 고생했어, 얘들아. 이건 답례니까 어서 받으렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000310
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 718000310,
					"content": "그러고 보니, 이 주전자 안에 있는 물을 다시 강에 부어야 할 텐데...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 718000305,
					"content": "안에도 깨끗해졌을 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718000306
					]
				},
				{
					"id": 718000306,
					"content": "음, 구석진 곳들도 들어가서 깨끗이 치워야 한단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000307
					],
					"speakerTitle": "평 할머니"
				}
			]
		},
