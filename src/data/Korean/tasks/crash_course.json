			"dialogs": [
				{
					"id": 3071101,
					"content": "왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071102
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3071102,
					"content": "자, 좀 더 가까이 와봐…. 무슨 냄새 안나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071103,
						3071104
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3071103,
					"content": "…안 나는데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				},
				{
					"id": 3071105,
					"content": "이 <color=#00E1FFFF>사당</color>에는 사연이 아주 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071106
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3071106,
					"content": "슬라임, 츄츄족… 그리고 풍마룡이 남긴 마력 고리까지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071107
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3071107,
					"content": "뭔가 재밌을 것 같지 않아? 하하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071108,
						3071110
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3071108,
					"content": "위험하지 않을까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071109
					]
				},
				{
					"id": 3071109,
					"content": "음… 그래도 위험하진 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3071112,
					"content": "「북풍의 늑대」 사당이 이렇게 되다니…. 슬프네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071113
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3071113,
					"content": "#가자고, {M#소년}{F#소녀}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071114
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3071114,
					"content": "지금은 아무도 「바람 사신수」를 위한 제사를 지내진 않지만 그래도 오래된 풍습은 사라지지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071115
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3071115,
					"content": "「바람 사신수」를 위해 청소 한번 해볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "케이아"
				},
				{
					"id": 3071110,
					"content": "그저 오합지졸들일 뿐이죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071111
					]
				},
				{
					"id": 3071111,
					"content": "오~ 꽤 멋진 말인데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3071104,
					"content": "이건 화염 슬라임이 타는 냄새…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
