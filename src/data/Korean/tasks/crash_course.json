					"speakerTitle": "케이아"
				},
				{
					"id": 3071507,
					"content": "몬드를 위해 싸우던 모습을 보니 넌 분명히 엄청 유명해질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071508
					],
					"speakerTitle": "케이아"
				},
				{
