			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340201,
					"content": "음? 뭘 보고 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730340202,
					"content": "이 수첩에는 꽃을 돌보는 방법이 적혀 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340203
					]
				},
				{
					"id": 730340203,
					"content": "진짜? 나도 볼래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730340204,
					"content": "「…개방된 장소에 두고 햇볕을 많이 쬐게 해야 한다…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730340205,
					"content": "콜레이가 밖으로 옮길 시간이 없었나 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730340206,
					"content": "헤헤, 그럼 우리가 콜레이를 도와 이 꽃을 돌봐주면 되겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730340207,
					"content": "음… 일단 이 꽃을 가지고 나가서 집 바로 옆에 두는 게 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730340208,
					"content": "너무 멀리 옮겨두면 콜레이가 돌아와서 찾다가 당황할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7303406,
			"completionStepIds": [
				7303406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303406",
							"2"
						],
						"stepId": 7303406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340601,
					"content": "어? 이 편지는… 콜레이가 남긴 것 같아, 우리 가서 확인해보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730340602,
					"content": "그런데 콜레이는 왜 코빼기도 안 보이지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340603
					]
				},
				{
					"id": 730340603,
					"content": "또 타이나리와 함께 일하러 갔나 봐. 두 사람은 항상 바빠 보였거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730340604,
					"content": "일단 편지를 확인하자. 이 글씨체 좀 봐, 콜레이가 적을 때 꾹꾹 눌러 썼나 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340605
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730340605,
					"content": "#「페이몬이랑 {NICKNAME}, 나 대신 이 꽃을 돌봐줘서 고마워」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730340606,
					"content": "「요즘 숲속에 처리해야 할 일이 많아 바쁘다 보니 꽃을 돌볼 틈이 없었어…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340607
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730340607,
					"content": "「도와줘서 다시 한번 고마워. 나중에 시간이 나면 같이 자한기르 씨의 가게에 『감자 보트』 먹으러 가자!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340608
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730340608,
					"content": "와! 콜레이가 맛있는 거 사준대! 얼른 적어두자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340609
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730340609,
					"content": "그런데 콜레이는 뭐 하느라 그렇게 바쁜 걸까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340610
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730340610,
					"content": "너무 무리하지 말고 푹 쉬었으면 좋겠는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
}