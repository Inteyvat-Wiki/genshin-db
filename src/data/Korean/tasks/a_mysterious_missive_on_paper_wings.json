			"dialogs": [
				{
					"id": 401120601,
					"content": "와, 엄청 큰 사막이야——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120602
					],
					"speakerTitle": "클레"
				},
				{
					"id": 401120602,
					"content": "직접 보니까 역시 놀랍네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120603
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401120603,
					"content": "확실히 장관이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120604
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 401120604,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120605
					],
					"speakerTitle": "유라"
				},
				{
					"id": 401120605,
					"content": "왜 그래, 어디 아파?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120606
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401120606,
					"content": "아니, 갑자기 적응하기 어려워서. 공기가 몬드에 비해… 좀 건조하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120607
					],
					"speakerTitle": "유라"
				},
				{
					"id": 401120607,
					"content": "사람이 살 수 없을 것 같은데. 정말로 비경이 있을까? 근처에 입구도 안 보이는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120608
					],
					"speakerTitle": "유라"
				},
				{
					"id": 401120608,
					"content": "호, 혹시 방금 내 발음이 잘못됐다거나 그런 건… 아니겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120609
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401120609,
					"content": "아니야! 콜레이 언니 탓이 절대로 아니야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120610
					],
					"speakerTitle": "클레"
				},
				{
					"id": 401120610,
					"content": "저번에 클레도 발음이 틀렸는데, 그래도 간다르바 성곽에 도착했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120611
					],
					"speakerTitle": "클레"
				},
				{
					"id": 401120611,
					"content": "저번 경험을 미루어 볼 때, 목적지는 틀리지 않았을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120612
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 401120612,
					"content": "휴우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120613
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401120613,
					"content": "모래언덕 아래에 숨겨져 있는 게 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120614
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401120614,
					"content": "…어쩔 수 없지. 일단 찾아봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120615
					],
					"speakerTitle": "유라"
				},
				{
					"id": 401120615,
					"content": "일행은 흩어져서 한참 동안 찾아봤지만, 아무런 단서도 발견하지 못했다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401120616
					]
				},
				{
					"id": 401120616,
					"content": "힘들어, 그리고 목말라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120617
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401120617,
					"content": "이럴 리가 없는데. 설마 「신기한 초대장」에 문제가 생긴 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120618
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 401120618,
					"content": "응? 그럴 리가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120619
					],
					"speakerTitle": "클레"
				},
				{
					"id": 401120619,
					"content": "앗, 설마 클레가 망가트린 거야? 하지만 클레는 아무것도 안 했는데… 도도코가 증명해줄 수 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120620
					],
					"speakerTitle": "클레"
				},
				{
					"id": 401120620,
					"content": "클레의 문제도 절대로 아니야. 이것 봐. 종이에 흔한 주름도 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120621
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401120621,
					"content": "만약 그 비경이 근처에 있다면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120622
					]
				},
				{
					"id": 401120622,
					"content": "#응? 명예 기사 {M#오빠}{F#언니}, 방법이 떠오른 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120623
					],
					"speakerTitle": "클레"
				},
				{
					"id": 401120623,
					"content": "우리가 비경을 찾는 것보다…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120624
					]
				},
				{
					"id": 401120624,
					"content": "아, 무슨 말인지 알겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120625
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401120625,
					"content": "응, 차라리 비경이 우릴 찾게 하자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120626
					]
				},
				{
					"id": 401120626,
					"content": "재밌는 생각이야. 「신기한 초대장」의 장소가 여기라면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120627
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 401120627,
					"content": "초대장을 보낸 비경도 분명 연관이 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120628
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 401120628,
					"content": "아, 알겠다. 실은 클레에게 필살기가 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120629
					],
					"speakerTitle": "클레"
				},
				{
					"id": 401120629,
					"content": "무슨 필살기? 우리가 배울 수 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120630
					],
					"speakerTitle": "유라"
				},
				{
					"id": 401120630,
					"content": "배울 수 있어! 엄마가 도움이 필요할 때는 이렇게 큰 소리로 외치라고 했어——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120631
					],
					"speakerTitle": "클레"
				},
				{
					"id": 401120631,
					"content": "「신기한 초대장」아, 「신기한 초대장」아, 클레에게 도움이 필요해! 방법을 찾아줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120632
					],
					"speakerTitle": "클레"
				},
				{
					"id": 401120632,
					"content": "#저기 봐, {NICKNAME}! 뭔가 날아오고 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120633
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401120633,
					"content": "어? 저건… 병이네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120634
					],
					"speakerTitle": "유라"
				},
				{
					"id": 401120634,
					"content": "효과가 제법인데? 나도 호신용으로 배워둬야겠어. 너도 배워봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120635
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 401120635,
					"content": "됐어! 나한텐 안 어울려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120636
					],
					"speakerTitle": "유라"
				},
				{
					"id": 401120636,
					"content": "병은 수메르의 전설에서 자주 등장하는 물건인데… 설마 이게 비경의 입구인 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120637
					],
					"speakerTitle": "콜레이"
				},
				{
					"id": 401120637,
					"content": "병 속에 있는 비경이라니, 꼭 리월에서 있었던 일 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120638
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401120638,
					"content": "#진짜 그렇다면, 들어갈 방법은 단 하나야! 자, {NICKNAME}, 손을 내밀어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120639
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401120639,
					"content": "(병을 만진다…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
