			"dialogs": [
				{
					"id": 240010301,
					"content": "역시 여기 있었네요. 상태는 괜찮아 보여요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010302
					],
					"speakerTitle": "블라신"
				},
				{
					"id": 240010302,
					"content": "스탈 씨는 강아지가 오페라도 자기 소설도 듣기 싫어한다는 걸 대체 언제쯤 깨닫게 될까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010303
					],
					"speakerTitle": "블라신"
				},
				{
					"id": 240010303,
					"content": "이제 돌아가요. 스탈 씨가 목이 빠지게 기다리고 있을 테니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "블라신"
				}
			]
