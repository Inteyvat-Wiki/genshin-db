			"dialogs": [
				{
					"id": 760600301,
					"content": "좋아, 이걸로 하자. 말라우스, 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760600302,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600303
					],
					"speakerTitle": "말라우스"
				},
				{
					"id": 760600303,
					"content": "만족한 것 같네. 헤헤… 이번에는 또 어떤 그림이 나올까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760600304,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600305
					],
					"speakerTitle": "말라우스"
				},
				{
					"id": 760600305,
					"content": "응? 벌써 다 그렸어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760600306,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600307
					],
					"speakerTitle": "말라우스"
				},
				{
					"id": 760600307,
					"content": "말라우스가 어쩐지 조금 슬퍼 보여. 그림이랑 관련이 있을까? 어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760600308,
					"content": "음, 이번에도 콜롬비나를 그렸네. 이건… 달빛 아래서 산책하는 모습인가? 밤하늘을 올려다보고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760600309,
					"content": "아마도… 거짓된 하늘 밖에 있는 달을 보던 걸 거야. 예전에는 자주 이렇게 산책하곤 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600310
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760600310,
					"content": "예전에? 아… 그러고 보니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760600311,
					"content": "(지금의 콜롬비나는 이 정원에서 거의 나가지 못해…. 노드크라이는 콜롬비나가 태어난 곳인데도…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600312
					]
				},
				{
					"id": 760600312,
					"content": "산책할 때마다 생각했어. 진짜 「서리달」에는 과연 뭐가 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600313
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760600313,
					"content": "거기도 여기처럼 동물이 많을까…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600314
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760600314,
					"content": "아니면, 아무것도 없으려나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600315
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760600315,
					"content": "으음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600316,
						760600319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760600316,
					"content": "몇 마리 데려가면 되지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600317
					]
				},
				{
					"id": 760600317,
					"content": "재미있는 생각이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600318
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760600318,
					"content": "하지만… 달은 거짓된 하늘 밖에 있는걸. 동물들을 위험할지도 모르는 곳에 데려갈 순 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760600322,
					"content": "(하나는 자유롭게 행동할 수 없는 「집」이고… 하나는 뭐가 있는지 모르는 「집」인가…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600323
					]
				},
				{
					"id": 760600323,
					"content": "(……)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600324
					]
				},
				{
					"id": 760600324,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600325
					],
					"speakerTitle": "말라우스"
				},
				{
					"id": 760600325,
					"content": "말라우스도 너랑 헤어지고 싶지 않은가 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600326
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760600326,
					"content": "나도 그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600327
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760600327,
					"content": "하지만 이건 나 혼자만의 여행이야. 나 혼자서 찾아야 하는 답이고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600328
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760600328,
					"content": "그 답이, 사실은 무척 아름다울지도 모르지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600329
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760600329,
					"content": "그때가 되면, 우리가 말라우스를 데리고 널 보러 갈게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600330
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760600330,
					"content": "좋아. 달에서 전시회를 열자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600331
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760600331,
					"content": "와, 듣기만 해도 신나! 약속한 거다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600332
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760600332,
					"content": "응…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600333
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760600333,
					"content": "정말 그러면 좋겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760600319,
					"content": "거기에도 귀여운 생물이 있을지 몰라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600320
					]
				},
				{
					"id": 760600320,
					"content": "응. 그러면 좋겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600321
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760600321,
					"content": "그곳의 아이들이 갑자기 돌아온 「신」을 반겨주면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "「콜롬비나」"
				}
			]
