					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741870602,
					"content": "아앙? 너희는 또 뭐야? 설마 에스테가 데려온 조력자는 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
