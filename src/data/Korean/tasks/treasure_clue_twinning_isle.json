			"dialogs": [
				{
					"id": 790290101,
					"content": "여기 조각상이 하나 있네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790290102,
					"content": "휴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290103
					],
					"speakerTitle": "까마귀 선장"
				},
				{
					"id": 790290103,
					"content": "안녕, 동굴 입구에서 웬 한숨이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790290112,
					"content": "난 요즘 이 동굴에서 살고 있네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290113
					],
					"speakerTitle": "까마귀 선장"
				},
				{
					"id": 790290113,
					"content": "이런 동굴에서 산다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790290114,
					"content": "어쩔 수 없는 선택이었다네! 누가 부른 건지 갑자기 무슨 극단 배우들이 몰려와서는 매일 쿵쾅쿵쾅하는데, 시끄러워서 잠을 잘 수가 있어야지…. 그래서 조용한 곳으로 오게 됐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290104
					],
					"speakerTitle": "까마귀 선장"
				},
				{
					"id": 790290104,
					"content": "근데 어디선가 갑자기 츄츄족 무리가 나타나서는 내 휴식처를 빼앗았지. 그러니 밖에서 찬 바람만 쐴 수밖에!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290105
					],
					"speakerTitle": "까마귀 선장"
				},
				{
					"id": 790290105,
					"content": "휴… 그래서 마음먹었지. 누군가 날 도와준다면, 그 사람에게만 알려줄 거라네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290106
					],
					"speakerTitle": "까마귀 선장"
				},
				{
					"id": 790290106,
					"content": "뭘 알려줄 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790290107,
					"content": "전설 속 해적의 보물을 찾을 수 있는 단서일세! 비록 나도 네 가지 단서 중에 하나밖에 모르지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290108
					],
					"speakerTitle": "까마귀 선장"
				},
				{
					"id": 790290108,
					"content": "네 가지 단서 중에 하나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790290109,
					"content": "너희들도 보물을 찾고 있는 거 같은데 어떤가? 저 안에 있는 츄츄족을 처리해 주면 내가 단서의 위치를 알려주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290110
					],
					"speakerTitle": "까마귀 선장"
				},
				{
					"id": 790290110,
					"content": "네 가지 단서를 다 모으면 이곳에서 떠돌아다니던 해적들이 남긴 보물을 찾을 수 있다더군!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290111
					],
					"speakerTitle": "까마귀 선장"
				},
				{
					"id": 790290111,
					"content": "약속한 거다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
