			"dialogs": [
				{
					"id": 4260101,
					"content": "앉아서 좀 쉬자. 이제 어떻게 할 계획이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4260102,
					"content": "임무를 수행하고 싶어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260103
					]
				},
				{
					"id": 4260103,
					"content": "그건 쉽지. 좌측 상단의 느낌표 아이콘을 클릭하면 현재 수령할 수 있는 임무를 확인할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4260104,
					"content": "임무마다 난이도 레벨이 있지. 하지만 레벨이 너무 많이 차이 나면 임무가 어려워져!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4260117,
					"content": "또 다른 건 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4260105,
					"content": "돌아다니고 싶어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260106
					]
				},
				{
					"id": 4260106,
					"content": "지역마다 그에 맞는 난이도 레벨이 정해져 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4260107,
					"content": "적합한 난이도 지역에 도전해야 실력을 효과적으로 높일 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4260108,
					"content": "모험가 길드의 알프리가 티바트 대륙에 대해서 아주 잘 알고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4260109,
					"content": "그녀는 몬드성 상점가에 있으니까, 가서 적합한 지역이 있는지 물어봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4260110,
					"content": "강해지고 싶어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260111
					]
				},
				{
					"id": 4260111,
					"content": "음... 강해지고 싶다면 손에 맞는 무기와 진귀한 성유물이 빠질 순 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4260112,
					"content": "위험해서 그렇지 던전에 가면 좋은 것들이 많다고 하던데...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4260113,
					"content": "돈만 되면 몬드성 상점가에 가서 구매해도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4260114,
					"content": "그리고 또 무기랑 성유물은 강화하거나 돌파할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4260115,
					"content": "그것들은 네가 혼자 연구해봐야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4260116,
					"content": "맞다! 캐릭터 레벨도 무척 중요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4260118,
					"content": "없어, 이제 들어가 봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260119
					]
				},
				{
					"id": 4260119,
					"content": "웅웅~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
