			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"드루수스"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030201,
					"content": "좋아! 여기에 두 번째 수수께끼를 내자. 이 수수께끼를 풀면 최종 보물상자를 찾을 수 있게 하는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030202
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735030202,
					"content": "최종 보물상자는… 저쪽에 배치하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030203
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735030203,
					"content": "어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735030204,
					"content": "어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030205
					]
				},
				{
					"id": 735030205,
					"content": "그냥 평범한 언덕 옆에 있는 평범한 폭포 아닌가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735030206,
					"content": "맞아! 하지만 이제 우리의 수수께끼가 있으니 더는 평범하지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030207
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735030207,
					"content": "자, 여행자, 이 수수께끼에 대해 더 좋은 생각 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030208,
						735030211,
						735030214
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735030208,
					"content": "복잡하게 하지 말고 그냥 단도직입적인 표현으로…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030209
					]
				},
				{
					"id": 735030209,
					"content": "어? 그래? 음… 산 넘고 여기까지 수수께끼를 풀러 온 사람한테는 확실히 피곤할 것 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030210
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735030210,
					"content": "그럼 쉽게 낼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735030219,
					"content": "특별히 배웠다고 할 수는 없지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030219,
						735030220
					]
				},
				{
					"id": 735030220,
					"content": "그냥 하다 보니 잘하게 되던데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030221
					]
				},
				{
					"id": 735030221,
					"content": "그렇군. 역시 여행자야 정말 박학다식해… 좋아, 네가 쓴 수수께끼를 배치할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030222
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735030222,
					"content": "드루수스는 수수께끼를 배치하기 시작한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030223
					]
				},
				{
					"id": 735030223,
					"content": "됐어! 이 작은 게시판이면 눈에 확 띌 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030224
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735030224,
					"content": "이제 마지막으로 보물상자를 배치하러 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735030211,
					"content": "폭포를 주제로 해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030212
					]
				},
				{
					"id": 735030212,
					"content": "음… 폭포는 명확한 주제인 게 틀림없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030213
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735030213,
					"content": "좋아. 이걸 주제로 하자. 그리고 이건 마지막 수수께끼니까… 난이도를 조금 낮추는 게 좋을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735030214,
					"content": "헤헤헤, 제가 써볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030215
					]
				},
				{
					"id": 735030215,
					"content": "야! 너 점점 더 해맑게 웃는걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735030216,
					"content": "다 썼어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030217
					]
				},
				{
					"id": 735030217,
					"content": "「푸른 우산이 보물을 품고, 주렴을 바라본다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030218
					],
					"speakerTitle": "드루수스"
				},
				{
					"id": 735030218,
					"content": "음… 이 수수께끼는 문구는 독특하군… 어디서 이 분야를 전문적으로 배운 적 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "드루수스"
				}
			]
		},
