						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705510201,
					"content": "에밀리, 이거 한번 마셔볼래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510202
					]
				},
				{
					"id": 705510202,
					"content": "퍼포먼스가 아주 멋있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510203
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510203,
					"content": "음… 이건 현지 버전으로 개량한 「7시의 등방울」인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510204,
						705510205
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510204,
					"content": "아주 정확해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				},
				{
					"id": 705510206,
					"content": "부드럽고 은은하면서 맛도 살아있어. 몬드 특유의 향을 더해 친근감을 더하면서도, 내가 거부감을 느낄 만한 성분은 피했네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510207
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510207,
					"content": "사실, 이렇게까지 조심스러울 필요는 없어. 나는 일반적인 틀을 벗어난 맛도 잘 받아들이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510208,
						705510209
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510208,
					"content": "음료가 너무 평범한가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510210,
					"content": "이것도 마음에 들어. 하지만 조금 더 깊이 있고, 너만의 독특한 해석이 담겨 있으며, 몬드의 인상을 한층 깊게 해줄 음료라면 더할 나위 없겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510211
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510211,
					"content": "우리 천천히 이야기 나누면서 영감을 찾아보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510212
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510212,
					"content": "이건 방금 산 꽃이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510213
					]
				},
				{
					"id": 705510213,
					"content": "꽃집 운영 보수 중 하나야. 중요한 향수 재료지. 이것 덕분에 캣테일 술집 의뢰를 완료할 수 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510214
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510214,
					"content": "몇 년 전에 몬드의 세실리아꽃을 연구했었는데, 특정 영역에서는 이 꽃향기가 「몬드」를 대표하기도 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510215
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510215,
					"content": "하지만 이번에는 상황이 좀 특수했지. 세실리아꽃 향을 싫어하는 고양이도 있어서, 그 점을 특별히 고려해야 했거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510216,
						705510217
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510216,
					"content": "그래서 이번에는 어떤 향을 사용했어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510218,
					"content": "풍차 국화야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510219
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510219,
					"content": "풍차 국화를 부위별로 갈아 추출한 뒤, 꽃잎과 잎사귀의 향을 적절히 혼합했어. 꿀술 같은 달콤함은 물론, 꽃과 잎의 상쾌한 향도 강조했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510220
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510220,
					"content": "아까 캣테일 술집에서 시험해 봤는데, 고양이들의 반응이 꽤 좋았어. 손님들도 포근하면서 상쾌한 느낌이라 좋다고 했고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510221
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510221,
					"content": "스쳐 지나가기 쉬운 평범한 재료에서 뛰어난 향기를 끌어낸다는 건… 정말 기쁜 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510222
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510222,
					"content": "오늘 날씨가 참 좋네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510223
					]
				},
				{
					"id": 705510223,
					"content": "(뻔한 주제로 대화를 여는 건 이런 느낌이군…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510224
					]
				},
				{
					"id": 705510224,
					"content": "그러게. 아까 낮은 하늘에 옅은 구름이 베일처럼 떠다녔어…. 대기의 습도도 적당하고, 바람도 잔잔했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510225
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510225,
					"content": "이런 환경에서는 사람의 후각이 활발하면서도 예민하지 않은 상태가 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510226
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510226,
					"content": "적절하게 섞인 향이 주변 환경과 자연스럽게 어우러져, 사람들의 기억 속에 깊이 각인되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510227,
						705510228
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510227,
					"content": "그런 이론도 있다니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510229,
					"content": "음료를 만들 때도 똑같아. 적당한 도수의 베이스를 선택하고, 다양한 맛과 향을 조화롭게 녹여내는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510230
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510230,
					"content": "이걸 잘 해내면, 모든 재료가 시너지를 발휘해서 미각에 가장 아름다운 교향곡을 선사할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510231,
						705510232
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510231,
					"content": "이제 알겠어. 맛의 조화가 중요하다는 거구나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510233,
					"content": "응… 그러네. 곰곰이 생각해 보니, 맛이 제각기 따로 노는 건 내 취향이 아닌 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510234
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510234,
					"content": "평소에는 어떤 음료를 마셔?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510235
					]
				},
				{
					"id": 705510235,
					"content": "평소에는… 업무가 끝나면, 법률 집행청 친구들이 가끔 한 잔씩 사주곤 해. 하지만 난 모임 후에 다시 업무로 복귀할 수 있도록, 보통 과일차를 마시지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510236
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510236,
					"content": "다음날이 휴일이면, 즐거워하는 친구들을 보고 나도 스파클링 와인 한 잔 정도는 주문하는 편이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510237
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510237,
					"content": "튀렌나라는 경찰관이 나무통에 숙성한 코르트 술을 같이 마시자고 자주 불러 줬었는데, 특별 순찰대로 발령되고 나서부턴 마실 일이 없어졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510238,
						705510239
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510238,
					"content": "술 마실 수 있었구나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510240,
					"content": "과학적으로 보면, 알코올은 사용 빈도가 매우 높은 용매야. 난 이미 오래전부터 고농도 알코올 냄새에 익숙해졌지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510241
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510241,
					"content": "그리고 약간 취하면 기분이 달라져서, 향수를 만드는 사고방식에도 영향을 미치게 돼… 결과가 좋든 나쁘든, 새로운 시도라고 할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510242
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510242,
					"content": "그래서 도수가 낮은 칵테일은 딱히 꺼리지 않아. 음료에 술을 살짝 넣는 정도라면 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510243
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510243,
					"content": "요즘 조향 일은 순조로워?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510244
					]
				},
				{
					"id": 705510244,
					"content": "응, 신경 써줘서 고마워. 다만 이번 몬드 여행에서 예상 밖의 도전을 하나 맞닥뜨렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510245
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510245,
					"content": "처음에는 《향료와 인체 감각 개론》에 따라 몬드의 전통적인 향료 몇 가지를 선택했거든?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510246
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510246,
					"content": "그런데 낙락베리를 주재료로 만든 디퓨저가, 술집 안에서는 향이 지나치게 달아서 사람들을 어지럽게 만들더라고…. 예쁜 귀를 가진 바텐더 소녀가 그대로 쓰러져 잠들어 버렸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510247,
						705510248
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510247,
					"content": "낙락베리에 그런 효과가 있었다고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510249,
					"content": "달다고 무조건 좋은 건 아니야. 단 성분을 첨가할 때는 양을 적당히 조절해야 심신 건강에 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510250
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510250,
					"content": "그래서 나는 단 음식은 자주 먹지 않고, 당도가 높은 베리류도 웬만하면 피하려고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510251
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510251,
					"content": "이번에는 낙락베리 관련 성분을 전부 빼고, 풍차 국화 쪽으로 방향을 바꿔 좋은 성과를 얻었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510252
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510252,
					"content": "아이디어가 떠올랐어. 잠시만 기다려줘. 지금 바로 레시피를 조정해 볼게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510253
					]
				},
				{
					"id": 705510253,
					"content": "응? 몇 마디 나눴을 뿐인데, 벌써 아이디어가 떠오른 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510254
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510254,
					"content": "너에겐 타고난 연구 재능이 있는지도 모르겠는걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510248,
					"content": "낙락베리 디퓨저는 쓰기 어렵겠네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510239,
					"content": "술은 좀 힘들어할 줄 알았는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510232,
					"content": "조화롭게 어우러진 맛을 선호하는 거네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510228,
					"content": "처음 들어봤어, 덕분에 배웠네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510217,
					"content": "세실리아 대신 어떤 꽃을 선택했어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510209,
					"content": "더 특별한 맛을 원해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510205,
					"content": "한 번에 맞혔네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				}
			]
		},
