			},
			"dialogs": [
				{
					"id": 705510101,
					"content": "#안녕, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510102
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510102,
					"content": "…몬드에서 네 「조제」 능력을 보게 될 줄은 몰랐네. 행운인걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510103,
						705510104
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510103,
					"content": "에밀리, 여행 온 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				},
				{
					"id": 705510105,
					"content": "둘 다야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510106
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510106,
					"content": "자칭 마녀분이 자기 꽃집을 운영해 달라고 부탁하셨거든. 캣테일 술집에서도 가게에 새로운 향을 불어넣을 디퓨저 제작 의뢰를 맡겼고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510107
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510107,
					"content": "네가 만든 음료로 바쁜 하루를 마무리할 수 있다면, 오늘 최고의 수확일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510108,
						705510109
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510108,
					"content": "그럼 제대로 솜씨를 보여볼까!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510110,
					"content": "메뉴 선택은 너에게 맡길게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510111
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510111,
					"content": "(에밀리는 일반인보다 향에 민감하니까, 잘못 섞인 향을 맡으면 거북해할지도 몰라)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510112
					]
				},
				{
					"id": 705510112,
					"content": "(향기의 포용성이 높은 재료를 쓰고, 폰타인 풍미를 적절히 가미하자)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510113
					]
				},
				{
					"id": 705510113,
					"content": "(일단 몬드식으로 개량한 「7시의 등방울」을 만들어 볼까)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705510109,
					"content": "너를 위한 특제 음료를 만들어 줄게!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510104,
					"content": "아니면 출장 온 건가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				}
			]
		},
		{
			"id": 7055102,
			"completionStepIds": [
				7055106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
