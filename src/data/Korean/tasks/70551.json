			"dialogs": [
				{
					"id": 705510301,
					"content": "너를 위해 개량한 「7시의 등방울」이야. 한번 마셔봐. 근데 아직 이름은 못 정했어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510302
					]
				},
				{
					"id": 705510302,
					"content": "색이 훨씬 산뜻하고, 퍼져 나오는 향기도 은은해서 푸른 이미지와 잘 어울리네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510303
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510303,
					"content": "표면에 있는 이 영롱한 가루는 풍차 국화의 꽃과 잎에서 나온 거니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510304,
						705510305
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510304,
					"content": "맞아, 한눈에 알아봤네!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510306
					]
				},
				{
					"id": 705510306,
					"content": "정말 맛있어 보여…. 한번 마셔볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510307
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510307,
					"content": "음… 풍차 국화의 꽃말은 「보이는 바람」이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510308
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510308,
					"content": "형태뿐만 아니라, 꽃이 전해주는 향기까지 음료에 녹여냈구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510309
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510309,
					"content": "이 특제 음료의 이름을 「구름과 바람의 향기」라고 하면 어떨까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510310
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510310,
					"content": "몬드의 구름과 바람이 잔 속에서 맴돌며 향긋한 자취를 남긴다는 의미로",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510311,
						705510312
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510311,
					"content": "역시 향수 전문가답네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510313
					]
				},
				{
					"id": 705510313,
					"content": "그래? 직업적인 습관 때문일 수도 있지만, 마음에 들어서 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510314
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510314,
					"content": "이제 이 특제 음료를 천천히 음미해 보도록 할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510315
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510315,
					"content": "고마워. 이번 몬드 여행은 정말 수확이 많았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510316
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510316,
					"content": "이건 내가 지금까지 마셔본 것 중에 가장 인상 깊은 음료야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510317
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510317,
					"content": "폰타인으로 돌아가면, 이 순간의 기억을 바탕으로 네 작품을 재현해 볼게. 향수와 디퓨저, 두 가지 형식으로",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510318,
						705510319
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510318,
					"content": "좋아!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510320
					]
				},
				{
					"id": 705510320,
					"content": "제작이 완료되면, 네가 두 신제품의 첫 번째 고객이 되어줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510321
					],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510321,
					"content": "그때 폰타인성에서 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "에밀리"
				},
				{
					"id": 705510319,
					"content": "영광이지!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510320
					]
				},
				{
					"id": 705510312,
					"content": "작명 센스가 뛰어나!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510313
					]
				},
				{
					"id": 705510305,
					"content": "몬드의 특산 꽃이야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510306
					]
				}
			]
