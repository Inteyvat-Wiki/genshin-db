			"dialogs": [
				{
					"id": 411220301,
					"content": "응? 무슨 일이에요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220302
					],
					"speakerTitle": "꼬마 질"
				},
				{
					"id": 411220302,
					"content": "현재 상황에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220303
					]
				},
				{
					"id": 411220303,
					"content": "운석이라면 우리도 알아요. 근데… 아직 운석이 떨어지는 모습을 못 봤단 말이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220304
					],
					"speakerTitle": "꼬마 질"
				},
				{
					"id": 411220304,
					"content": "윌이 운석이 잘 보이는 곳을 알고 있다고 해서 여기로 왔어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220305
					],
					"speakerTitle": "꼬마 질"
				},
				{
					"id": 411220305,
					"content": "몬드성 안에서도 볼 수 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220306
					]
				},
				{
					"id": 411220306,
					"content": "하지만 성안에선 엄청 높은 곳에서만 보이잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220307
					],
					"speakerTitle": "꼬마 질"
				},
				{
					"id": 411220307,
					"content": "경비병 아저씨들이 분명 높은 곳에 못 올라가게 할 거라구요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220308
					],
					"speakerTitle": "꼬마 질"
				},
				{
					"id": 411220308,
					"content": "저 아저씨가 도와주신대",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220309
					]
				},
				{
					"id": 411220309,
					"content": "웅? 옆에 있는 저 이상한 아저씨요? 저번에 엄청 무서운 말투로 얘기하던데요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220310
					],
					"speakerTitle": "꼬마 질"
				},
				{
					"id": 411220310,
					"content": "다른 말도 없이 무작정 돌아가라고만 하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220311
					],
					"speakerTitle": "꼬마 질"
				},
				{
					"id": 411220311,
					"content": "근데 우릴 높은 곳에 데려가서 운석을 보여준다면… 돌아가 줄 수 있죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220312
					],
					"speakerTitle": "꼬마 질"
				},
				{
					"id": 411220312,
					"content": "일단 윌한테도 물어보세요. 윌의 아이디어니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "꼬마 질"
				}
			]
		},
