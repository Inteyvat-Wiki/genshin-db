			"dialogs": [
				{
					"id": 732790401,
					"content": "쉿…! 저길 봐… 저기에 누가 있어…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732790402,
					"content": "주인님, 저자들이 바로… 그동안 계속 말했던 「우매단」 이죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790403
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732790403,
					"content": "「우인단」이야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790404
					]
				},
				{
					"id": 732790404,
					"content": "별 차이 없는 것 같은데요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790405
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732790405,
					"content": "조용히 해! 혹시라도 들키면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732790406,
					"content": "걱정 마, 녀석들은 내가 하는 말을 듣지 못하거든. 못 믿겠으면 잘 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790407
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732790407,
					"content": "야! 이 뚱땡아! 여길 봐! 식사 시간이라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790408
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732790408,
					"content": "음…? 혹시 무슨 소리 못 들었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790409
					],
					"speakerTitle": "우인단 선발대원A"
				},
				{
					"id": 732790409,
					"content": "못 들었는데, 왜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790410
					],
					"speakerTitle": "우인단 선발대원B"
				},
				{
					"id": 732790410,
					"content": "으음… 혹시 식사 시간이 된 건가 해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790411
					],
					"speakerTitle": "우인단 선발대원A"
				},
				{
					"id": 732790411,
					"content": "후후, 봤지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790412
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732790412,
					"content": "릴루페르가 이런 어린애 같은 장난을 칠 줄은 몰랐는걸…. 헤헤, 귀여운 구석이 있단 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732790413,
					"content": "저길 봐…! 저기 잡혀 있는 게 타들라 아닐까!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732790414,
					"content": "어디 보자… 키가 크고 까무잡잡한 피부에 밝은색 긴 머리… 맞는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790415
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732790415,
					"content": "꼬마 녀석, 기억력 좋은데? 주인님, 그럼 시작하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790416
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732790416,
					"content": "#좋아. {NICKNAME}, 시작하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
