				{
					"id": 732790603,
					"content": "네…? 맞아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790604
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732790604,
					"content": "저들을 놓아주셨군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790605,
						732790606
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732790605,
					"content": "더 이상 위협이 되지 않으니까요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				},
				{
					"id": 732790607,
					"content": "…돌아가면 다른 사람들에게 우리가 여기에 있다고 알릴 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790608
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732790608,
					"content": "거봐, 똑똑한 사람들끼리는 통하는 게 있다니까. 이 여자애, 마음에 드는 걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790609
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732790609,
					"content": "다시 오면 또 쫓아내면 되니 그런 건 중요하지 않아! 근데 부상을 입었네… 우리가 좀 도와줄까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790610
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732790610,
					"content": "전 괜찮아요. 걸을 수도 있고, 스스로 죽을 곳을 찾을 수도 있는걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790611
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732790611,
					"content": "오… 그렇다면야. 앗, 잠깐! 그건 괜찮은 게 아니잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790612
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732790612,
					"content": "농담이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790613
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732790613,
					"content": "하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790614
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732790614,
					"content": "이 여자애의 은근한 유머 감각… 마음에 드는 걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790615
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732790615,
					"content": "고마워요. 그럼 이제 돌아가죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790616,
						732790618
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732790616,
					"content": "다리가 불편하진 않아요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790617
					]
				},
				{
					"id": 732790617,
					"content": "불편하긴 하지만 부축은 필요 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타들라"
				},
				{
					"id": 732790618,
					"content": "조금 쉬는 게 좋지 않을까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790619
					]
				},
				{
					"id": 732790619,
					"content": "쉰다고요…? 아뇨, 우린 서로 아직 그렇게 잘 아는 사이가 아닌걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790620
					],
					"speakerTitle": "타들라"
				},
				{
					"id": 732790620,
					"content": "서로 알아가는 것도 좋을 것 같은데, 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790621
					],
					"speakerTitle": "릴루페르"
				},
				{
					"id": 732790621,
					"content": "고맙지만 그건 나중에 하도록 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타들라"
				},
				{
					"id": 732790606,
					"content": "굳이 전부 처치할 필요는 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790607
					]
				}
			]
		},
