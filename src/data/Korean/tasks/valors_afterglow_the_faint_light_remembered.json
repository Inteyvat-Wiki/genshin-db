				"points": []
			},
			"dialogs": [
				{
					"id": 710390101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390102,
						710390103
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710390102,
					"content": "#안녕하세요, 근우 {M#누님}{F#언니}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390104
					]
				},
				{
					"id": 710390104,
					"content": "…?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390105
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710390105,
					"content": "으앗, 깜짝이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710390106,
					"content": "미… 미안. 음, 지경을 찾는 거라면… 지경은 팀에서 떠났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390107,
						710390109
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710390107,
					"content": "어디로 갔어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390108
					]
				},
				{
					"id": 710390108,
					"content": "모르겠어… 잠시 한눈판 사이에 사라져버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390112
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710390112,
					"content": "지경과 얘길 나눠봤는데… 그래도 끝까지 떠나겠대. 구슬려도 보고, 윽박도 질렀어. 심지어 무력으로도 만류할 수 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390113
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710390113,
					"content": "휴… 자기가 뭘 하고 있는지 알고 있었으면 좋겠는데. 그러길 바라야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390114
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710390114,
					"content": "그러길 바라야지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390115
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710390115,
					"content": "참, 반드시 목영한테 이 일을 알려서 한시라도 빨리 수색팀을 파견하고 지경을 찾아야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390116,
						710390117
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710390116,
					"content": "우리가 갈게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390118
					]
				},
				{
					"id": 710390118,
					"content": "어휴, 정말… 지경은 왜 또 사라진 거야! 얼른 지상으로 올라가서 목영을 찾아가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710390117,
					"content": "걱정 마세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390118
					]
				},
				{
					"id": 710390109,
					"content": "떠날 때 상태는 어땠어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390110
					]
				},
				{
					"id": 710390110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390111
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710390111,
					"content": "헤디브가 검사를 했는데 상황이 많이 안 좋다고 했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390112
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710390103,
					"content": "잘 지내세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390104
					]
				}
			]
		},
		{
			"id": 7103902,
			"completionStepIds": [
				7103903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103903",
							"2"
						],
						"stepId": 7103903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"목영",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710390201,
					"content": "응? 지경은 같이 안 왔어? 총무부의 추천서가 내려왔거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390202
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390202,
					"content": "지경이 그린 지도가 휘산청에 큰 도움이 돼서 총무부에서 특례로 지경을… 음, 어디 보자, 자문 가이드로 임명했어. 물론 정직원과 같은 대우로 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390203
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390203,
					"content": "진짜 잘됐네, 여기저기 탐색하러 다니던 게 헛수고가 아니었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390204
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390204,
					"content": "지경이 떠났어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390205
					]
				},
				{
					"id": 710390205,
					"content": "떠났다고? 그게 무슨 뜻이야…? 잠시 떠난 거야? 하지만 층암거연을 떠난 인원이 있다는 천암군의 보고는 없었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390206
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390206,
					"content": "지경이 탐사대에서 나갔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390207
					]
				},
				{
					"id": 710390207,
					"content": "아? 그래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390208
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390208,
					"content": "잠깐! 잠깐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390209
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390209,
					"content": "아니, 아니… 네 말은, 지경이, 탐사대에서 나갔다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390210
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390210,
					"content": "지경이, 나갔다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390211
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390211,
					"content": "그래! 대체 어느 부분이 이해가 안 된 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710390212,
					"content": "…알겠어. 바로 수색팀을 파견할게. 아직 층암거연에 있다면 찾을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390213
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390213,
					"content": "또 바보병이 도졌든, 아니면 다른 이유든… 지경을 빨리 찾아야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390214
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390214,
					"content": "그런 몸 상태로 팀을 이탈하고 단독 행동을 하는 건 완전히 말도 안 되는 짓이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390215,
						710390217
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390215,
					"content": "도움이 필요하신가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390216
					]
				},
				{
					"id": 710390216,
					"content": "미안, 이번엔 신세 지지 않으려고… 나도 가끔은 도움이 돼야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390233
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390233,
					"content": "도움이 필요하면 최대한 빨리 달려올게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390234
					]
				},
				{
					"id": 710390234,
					"content": "응응, 나도! 후배를 혼자 내버려 둘 순 없지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390235
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710390235,
					"content": "우리도 길에서 주의 깊게 살펴보자. 언제 어디서 지경을 만날지 모르잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710390217,
					"content": "지경에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390218
					]
				},
				{
					"id": 710390218,
					"content": "철없는 녀석이지. 하지만 우린 무슨 일이 있어도 친구야. 내가 미움받는 성격이라는 건 알아… 그래도 그렇게 쉽게 친구를 잊어버릴 수는 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390219
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390219,
					"content": "그 녀석은 모험가가 꿈이라는 터무니없는 소리만 해대거든. 심하게 다친 적도 있고… 죽을 뻔하기도 했었어. 최근에야 겨우 좀 얌전해졌나 싶었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390220
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390220,
					"content": "그 말도 안 되는 꿈은 이제 포기한 줄 알았는데… 로알드, 스탠리처럼 되는 건 쉬운 일이 아니잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390221
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390221,
					"content": "휴… 이렇게 될 줄은… 널 층암거연 탐사대에 초대한 것부터가 잘못이었을 지도 몰라. 네가 안 왔더라면 지경도 다시 불타오르지 않았을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390222,
						710390226
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390222,
					"content": "지경의 노력에 아무런 수확이 없었던 건 아니잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390223
					]
				},
				{
					"id": 710390223,
					"content": "성과…? 그건 너무 실리적인 얘기잖아. 지경은 대부분의 지하 지역을 지도로 그려냈어. 물론 우리도 무척 고맙긴 해… 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390224
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390224,
					"content": "막연한 「꿈」을 좇는 것이 목숨보다 더 중요하다고…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390225
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390225,
					"content": "난 절대 이해할 수 없어. 그걸 위해서 스스로를 위험에 빠뜨리는 사람이 있을 거라곤 상상이 안 가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390232
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390232,
					"content": "그러니까, 지경을 찾는 일은 나한테 맡겨…. 음, 그러니까, 천암군의 수색팀한테 맡겨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390233
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390226,
					"content": "하지만 그건 지경의 선택이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390227
					]
				},
				{
					"id": 710390227,
					"content": "선택, 선택, 선택…. 그게 무슨 핑계야! 그건 그냥 죽으러 가는 거나 다름 없다고! 아직도 모르겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390228
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390228,
					"content": "크흠… 미안, 말이 너무 심했어. 하지만… 우리 같은 일반인들이 바꿀 수 없는 사태에 처했을 땐… 조금 더 참을성 있게 행동하는 게 좋은 거잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390229
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390229,
					"content": "조금만 더 기다리면…. 이삼십 년, 아니, 어쩌면 10년만 지나도 보다 안전한 광산 설비가 개발될지도 모르잖아? 그땐 지금처럼 급하게 지하 지도를 그릴 필요도 없을 테고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390230
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710390230,
