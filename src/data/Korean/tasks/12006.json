			},
			"dialogs": [
				{
					"id": 120060401,
					"content": "아야카 아가씨, 옷은 다 됐습니다. 선물 상자에 포장해뒀어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060402
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120060402,
					"content": "아, 맞다, 특별히 부탁하신 것도 준비해놨습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060403
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120060403,
					"content": "정말 감사해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060404
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120060404,
					"content": "정말 귀여운 옷이더군요. 저희도 만들면서 즐거웠답니다! 다음에도 또 들러주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060405
					],
					"speakerTitle": "오구라 미오"
				},
				{
					"id": 120060405,
					"content": "여행자님, 제가 선물을 준비했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060406
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120060406,
					"content": "어? 정말?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060407
					]
				},
				{
					"id": 120060407,
					"content": "우와… 엄청 고급진데, 머리 장신구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120060408,
					"content": "백로를 본따 만든 비녀예요. 장신구뿐만 아니라 소품으로도 활용할 수 있답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060409
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120060409,
					"content": "도와주신 게 고마워서, 이건… 답례예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060410,
						120060411
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120060410,
					"content": "정말 예쁘다, 고마워",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060412
					]
				},
				{
					"id": 120060412,
					"content": "네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060413
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120060413,
					"content": "그러고 보니 아야카의 칭호가 「백로공주」잖아. 아야카처럼 우아한 선물이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120060414,
					"content": "과찬이세요. 그래도 이걸 볼 때마다 절 생각해주시면 정말 좋겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060415
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 120060415,
					"content": "헤헤, 그럴게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060416
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120060416,
					"content": "좋아, 옷도 찾았으니 이제 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060417
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120060417,
					"content": "「츠바키」가 사는 곳으로 출발!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120060411,
					"content": "소중히 간직할게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060412
					]
				}
			]
		},
