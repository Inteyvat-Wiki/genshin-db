						700200109
					],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 700200108,
					"content": "순조로운 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200110
					]
				},
				{
					"id": 700200110,
					"content": "도움이 필요한 것 같아서 물어봤는데 역시나였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200111
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700200111,
					"content": "Dada odomu! Kundala dada! Kundala zido, mi dada! Muhe yeye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200112
					],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 700200112,
					"content": "흠… 대충 강력한 적을… 처치해달란 말 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200113
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700200113,
					"content": "Ya zido? Ye? Mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200114
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700200114,
					"content": "Mi! Mi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200115
					],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 700200115,
					"content": "됐어, 그 녀석 위치는 지도에 표시해뒀으니까 이제 네가 나설 차례야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700200116
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700200116,
					"content": "Dada, Valo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 700200109,
					"content": "무슨 말을 하는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700200110
					]
				}
