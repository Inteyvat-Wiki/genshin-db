			"dialogs": [
				{
					"id": 711209101,
					"content": "또 너희들이야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209102
					],
					"speakerTitle": "뒷산 호랑이"
				},
				{
					"id": 711209102,
					"content": "호기심은 좀 접어두라고, 친구. 그냥 우릴 못 본 척하면 돼. 우리도 널 못 본 걸로 할 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209103,
						711209111
					],
					"speakerTitle": "똬리 튼 뱀"
				},
				{
					"id": 711209103,
					"content": "뭘 지키고 있는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209104
					]
				},
				{
					"id": 711209104,
					"content": "친구, 우리가 왜 월급을 받는지 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209105
					],
					"speakerTitle": "똬리 튼 뱀"
				},
				{
					"id": 711209105,
					"content": "왜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711209106,
					"content": "크흠…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209107
					],
					"speakerTitle": "똬리 튼 뱀"
				},
				{
					"id": 711209107,
					"content": "(너희 둘한테만 말해주는 거야. 다른 사람한테는 비밀이라고…. 자자, 그러니까…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209108
					],
					"speakerTitle": "똬리 튼 뱀"
				},
				{
					"id": 711209108,
					"content": "(응응! 나 지금 듣고 있어!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711209109,
					"content": "너희처럼 한가한 인간들을 쫓아내기 위해서다!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209110
					],
					"speakerTitle": "똬리 튼 뱀"
				},
				{
					"id": 711209110,
					"content": "으악!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711209111,
					"content": "동굴에서 이상한 소리가 나던데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209112
					]
				},
				{
					"id": 711209112,
					"content": "내 방귀 소리다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209113
					],
					"speakerTitle": "뒷산 호랑이"
				},
				{
					"id": 711209113,
					"content": "어… 맞아, 얘가 방귀 뀐 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209114
					],
					"speakerTitle": "똬리 튼 뱀"
				},
				{
					"id": 711209114,
					"content": "그, 그렇구나… 알겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
