			"dialogs": [
				{
					"id": 750711001,
					"content": "#하하, {NICKNAME}, 페이몬. 내 뮤즈와… 꼬마 뮤즈!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711002
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750711002,
					"content": "#아, {REALNAME[ID(2)|SHOWHOST(true)]}도 있었지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711003
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750711003,
					"content": "진짜 꼬마가 누군지 모르겠네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711004
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750711004,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711005
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711005,
					"content": "하하, 신경 쓰지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711006
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750711006,
					"content": "흥, 너무 신경 쓰이거든?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711007,
						750711011
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750711007,
					"content": "새로운 영감이 떠올랐나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711008
					]
				},
				{
					"id": 750711008,
					"content": "당연하지. 근데… 후후, 새로운 영감이 떠올랐다는 건… 너희의 도움이 또 필요하단 뜻이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711009
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750711009,
					"content": "괜찮아! 어차피 매번 돈을 챙겨줬잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711010
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750711010,
					"content": "하하, 좋았어. 우리 꼬마 용병!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750711017,
					"content": "저길 봐, 이번에 촬영할 대상은 산룡인데… 쉿, 녀석이 깨지 않도록 조심하는 게 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711018
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750711018,
					"content": "이런 용을 본 건 처음이지만, 한동안 녀석들을 관찰해 보니… 정말 매력적인 동물인 것 같아. 단단한 갑각 아래 저마다의 개성이 있더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711019
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750711019,
					"content": "후후, 먹이를 몇 번 줬더니 이젠 내 지시도 대충 알아듣는 수준이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711020
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750711020,
					"content": "하지만 무리에서 벗어난 산룡을 데려와서 동족과 같이 있는 사진을 찍으려면, 용 훈련사의 도움이 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711021
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750711021,
					"content": "후후, 어때. 정말 간단하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711022
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750711022,
					"content": "응, 정말 간단하네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711023,
						750711024
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750711023,
					"content": "(어차피 네가 하는 것도 아니잖아…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711025,
					"content": "하하, 의욕이 넘치는데! 자, 그럼 지금 바로 무리에서 벗어난 산룡을 찾아줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750711024,
					"content": "(그렇게 간단하지 않거든…!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711011,
					"content": "또 무스들의 도움이 필요한 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711012
					]
				},
				{
					"id": 750711012,
					"content": "무스… 나도 먹고 싶다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711013
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750711013,
					"content": "꼬르륵… 꼬륵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711014
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711014,
					"content": "아… 「뮤즈」는 먹는 게 아니야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711015
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750711015,
					"content": "헤헤, 네가 돈만 주면 먹을 걸로 바꿀 수 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711016
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750711016,
					"content": "그래, 그러든지…. 어쨌든 너희가 헛수고할 일은 없을 거야. 내겐 돈이 있으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "마니피코"
				}
			]
		},
