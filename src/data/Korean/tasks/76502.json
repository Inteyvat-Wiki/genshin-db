			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아이노"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765020101,
					"content": "#{NICKNAME}와(과) 페이몬이잖아? 무슨 일이야? 설마 이 천재 엔지니어가 나서야 할 만큼 대단한 의뢰라도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020102
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 765020102,
					"content": "헤헤, 너희는 지인이니까 20% 할인해 줄게! 몰래 간식만 갖다줘——쉿, 이네파한테는 비밀이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020103,
						765020104
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 765020103,
					"content": "그냥 여기저기 둘러보고 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				},
				{
					"id": 765020105,
					"content": "그럼 잘 찾아왔어. 이 아이노의 공방은 반짝반짝 빛나는 것들로 가득하니까. 다른 데선 절대 못 보는 것들이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020106
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 765020106,
					"content": "하지만 너희 걸어 다닐 때 발밑 조심해. 부품에 걸려 넘어지지 말고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020107,
						765020108
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 765020107,
					"content": "이 로봇, 모양이 참 특이하네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020109,
					"content": "흥흥, 당연하지. 이름은 「강펀치 오리」야. 원래는 쓰레기 분류 로봇으로 만들어서 고철을 정리하려고 했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020110
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 765020110,
					"content": "실수로 너무 튼튼하게 만들고 팔도 엄청 잘 움직이게 만들어버리는 바람에 번뜩이는 아이디어로 엄청 강력한 방어 기능을 추가했지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020111
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 765020111,
					"content": "이렇게 하면 어느 멍청한 도둑놈이 몰래 내 공방에 기어들어 와도 얘가 전부 「재활용 불가 쓰레기」로 치워 버릴 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020112
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 765020112,
					"content": "아이노의 아이디어는 여전히 기상천외하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020113,
						765020114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 765020113,
					"content": "기회란 왔을 때 잡는 법…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020115,
					"content": "나, 나? 「강펀치 오리」랑 같이? 다들 평소엔 내 발명품에만 관심을 가지고 날 찍고 싶어 하는 사람은 거의 없었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020116
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 765020116,
					"content": "하지만 너희가 이 천재 엔지니어님과 무적의 부하의 업무 일상을 찍고 싶다면 안 될 것도 없지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020117
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 765020117,
					"content": "하지만… 난 평소에 사진도 잘 안 찍고 어떤 포즈를 취해야 멋진지도 잘 모르는데… 못생기게 나오면 어떡해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020118,
						765020119
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 765020118,
					"content": "평소처럼 하면 돼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020120,
					"content": "알겠어. 그럼 너한테 맡길게. 「강펀치 오리」의 용맹함도 잘 찍어줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아이노"
				},
				{
					"id": 765020119,
					"content": "가장 멋진 순간을 찍을 수 있도록 노력할게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020114,
					"content": "내가 네 사진을 찍어도 될까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020108,
					"content": "이것도 아이노의 「부하」야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020104,
					"content": "촬영 소재 찾으면서",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				}
			]
		},
