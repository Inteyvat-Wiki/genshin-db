					"마죠리"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200590101,
					"content": "이거 큰일이군. 어쩌지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590102
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 200590102,
					"content": "왜?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590103
					]
				},
				{
					"id": 200590103,
					"content": "여행자! 마침 잘 왔어! 여긴 우리 집에서 연 기념품 상점이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590104
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 200590104,
					"content": "예전에 아버지가 다른 모험가들이 가져온 전리품을 사들여 상점에서 팔았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590105
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 200590105,
					"content": "그러나 모험가 길드가… 썰렁해지고 나서 사들일 수 있는 물건이 점점 줄었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590106
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 200590106,
					"content": "게다가 전부 값도 안 나가는 것들이라 손님들이 영 사질 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590107
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 200590107,
					"content": "여행자, 넌 여기저기 모험을 다니지? 잘 팔릴 것 같은 전리품 좀 찾아줄 수 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590108,
						200590110
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 200590108,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590109
					]
				},
				{
					"id": 200590109,
					"content": "그럼 부탁할게! 찾게 되면 값을 잘 쳐줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마죠리"
				},
				{
					"id": 200590110,
					"content": "페이몬이 사실…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590111
					]
				},
				{
					"id": 200590111,
					"content": "미안, 사려는 사람이 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590112
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 200590112,
					"content": "왜냐면… 분명 도망칠 거니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마죠리"
				}
			]
		},
