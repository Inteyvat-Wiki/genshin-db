			"dialogs": [
				{
					"id": 2005902001,
					"content": "음, 「잘 팔릴만한 물건」이란 말만으론 뭘 찾아야 할지 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902002
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 2005902002,
					"content": "음, 그럼 <color=#00E1FFFF>「츄츄족과 관련된 전리품」</color>을 찾아봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902003
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 2005902003,
					"content": "자신의 실력을 뽐내고 싶어 하는 모험가들이 관심을 가질지도 모르지",
					"roleType": "TALK_ROLE_NPC",
