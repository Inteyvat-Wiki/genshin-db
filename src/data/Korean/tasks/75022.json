			"dialogs": [
				{
					"id": 750220404,
					"content": "으… 깨울 수가 없는 건가? 나 진짜 화나! 일부러 자는 척하는 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750220405,
					"content": "음우?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220406,
						750220407
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220406,
					"content": "진짜 자는 것 같아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				},
				{
					"id": 750220408,
					"content": "(잠꼬대 내용을 말한다…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220409
					]
				},
				{
					"id": 750220409,
					"content": "음식을 얻어먹기 위해 일부러 입구를 막았다고? 완전 사기꾼이잖아… 뭔가 속은 느낌이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750220410,
					"content": "흥흥! 이러면 우리도 세게 나갈 수밖에 없지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750220411,
					"content": "#차라리 {REALNAME[ID(2)|SHOWHOST(true)]}을(를) 들여보내서 보물상자를 가져오라고 하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220412
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750220412,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220413,
					"content": "이건 다 이 녀석이 자초한 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750220407,
					"content": "잠꼬대를 하는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				}
