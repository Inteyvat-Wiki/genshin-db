			},
			"dialogs": [
				{
					"id": 740430201,
					"content": "노동할 권리를 보장하라! 보장하라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430202,
						740430204,
						740430206
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 740430202,
					"content": "당신이 찾던 코어 가져왔어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430203
					]
				},
				{
					"id": 740430203,
					"content": "응? 어디 봐봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엔리"
				},
				{
					"id": 740430204,
					"content": "왜 여기서 이러고 계세요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430205
					]
				},
				{
					"id": 740430205,
					"content": "넘어진 곳에서 다시 일어나야 하는 법이니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엔리"
				},
				{
					"id": 740430206,
					"content": "제가 할 일이 뭐였죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430207
					]
				},
				{
					"id": 740430207,
					"content": "너도 참…. 땅 위나 물 아래의 일부 지역에 누군가가 이런 이상한 기계들을 배치해 뒀어. 기계 근처에서는 이상한 빛이 나니까 쉽게 알아볼 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430208
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 740430208,
					"content": "그걸 처리하고 이런 코어를 내게 가져다주면 돼. <color=#00E1FFFF>총 7개</color>야. 부탁 좀 할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엔리"
				}
			]
		},
