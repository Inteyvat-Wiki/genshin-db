			"dialogs": [
				{
					"id": 400040201,
					"content": "#{NICKNAME}, 오랜만이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040202
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 400040202,
					"content": "케이아, 우리 리월 해등절에 갔었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400040203,
					"content": "어때? 해등절은 재밌었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040204
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 400040204,
					"content": "엄청 맛있었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400040205,
					"content": "그럼 몬드의 하르파스툼 축제도 기대해. 절대 실망하지 않을 테니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040206
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 400040206,
					"content": "본론으로 들어가자, 페이몬",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040207
					]
				},
				{
					"id": 400040207,
					"content": "아, 맞다. 케이아, 실은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400040208,
					"content": "음… 등을 만들기 위한 목재, 종이, 기름이라… 아무리 생각해도 위험한 결말만 떠오르는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040209
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 400040209,
					"content": "후훗, 재밌군. 근데 왜 내가 이 부호를 알 거라고 생각한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040210,
						400040215
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 400040210,
					"content": "케이아 씨는 못하는 게 없는 데다 믿을 수 있으니까요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040211
					]
				},
				{
					"id": 400040211,
					"content": "맞아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400040212,
					"content": "하하하, 천만에. 그 정도까진 아냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040213
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 400040213,
					"content": "나왔군! 기사의 「겸손함」!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400040214,
					"content": "하하, 리월에서 지내더니 아부가 많이 늘었는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 400040220,
					"content": "본론으로 돌아가지. 이건 국제 범죄조직 「보물 사냥단」의 부호야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040221
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 400040221,
					"content": "관심 있으면 첩보원과 만나게 해줄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040222
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 400040222,
					"content": "페보니우스 기사단은 적과 거래 하지 않는다며?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040223
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400040223,
					"content": "——그건 나 케이아의 첩보원이지, 페보니우스 기사단의 첩보원이 아니잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040224
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 400040224,
					"content": "이따가 첩보원을 바람이 시작되는 곳으로 보낼 테니, 거기로 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040225
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 400040225,
					"content": "고마워, 케이아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040226
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400040226,
					"content": "「참된 지식은 술에서 나온다」, 기억해둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040227
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 400040227,
					"content": "응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400040215,
					"content": "빛과 어둠의 세계를 잘 알고 있는 케이아 씨라면, 기댈 수 있을 것 같아서요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040216
					]
				},
				{
					"id": 400040216,
					"content": "맞아맞아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400040217,
					"content": "명예 기사라면 말을 신중하게 해야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040218
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 400040218,
					"content": "뭐가 빛과 어둠의 세계를 모두 잘 알고 있다는 거야? 우리 페보니우스 기사단은 적과 거래하지 않는다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040219
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 400040219,
					"content": "이게 바로 기사의 「정직함」이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "케이아"
