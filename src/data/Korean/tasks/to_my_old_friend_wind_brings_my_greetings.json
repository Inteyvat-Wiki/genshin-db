					"nextDialogs": [
						400040328
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400040328,
					"content": "그건 잘 모르겠어. 하지만 그 편지가 보물 사냥단의 어느 지부에 있는지는 알려줄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040329
					],
					"speakerTitle": "니므롯"
				},
