			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"에펜디"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736730201,
					"content": "대략 이런 의뢰 내용입니다. 의뢰를 수락할 시간과 의향이 있으시다면 더할 나위 없겠군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730202
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 736730202,
					"content": "저와 보급관은 당신이 이 일을 수락한 이후, 매일 업무를 하나씩 처리할 때마다 충분한 보수를 제공하도록 결정했습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730203
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 736730203,
					"content": "비록 사소한 의뢰들이 대부분이지만, 이 임무를 얕봐선 안 됩니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730204
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 736730204,
					"content": "주민들이 생활하며 맞닥뜨리는 다양한 어려움을 해결해 주면, 주민들 모두 고마워하고 당신을 존중할 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730205
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 736730205,
					"content": "꾸준히 하기만 하면 주민들 사이에서 명성이 높아져서 당신을 받아들일 거고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730206
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 736730206,
					"content": "그때가 되면 더 복잡하고 중요한 일을 맡기도록 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730207
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 736730207,
					"content": "이 업무의 대략적인 상황은 이렇습니다. 신중히 고려해 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730208
					],
					"speakerTitle": "에펜디"
				},
				{
					"id": 736730208,
					"content": "이 일을 받아들이기로 결정하셨다면, 언제든지 여기 와서 등록을 마친 후 의뢰를 수락하면 됩니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "에펜디"
				}
			]
		}
	]
}