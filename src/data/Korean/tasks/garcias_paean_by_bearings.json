					"아한가르"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150301,
					"content": "알았어! 알았다고! 그만해! 톱니바퀴를 만들러 갈 테니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150302
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230150302,
					"content": "아직 기계의 원리를 제대로 설명하지도 못했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150303
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230150303,
					"content": "철광은 이미 구했으니 바로 작업을 시작해야겠어. 빨리 사라져!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150304
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230150304,
					"content": "아한가르가 망치를 휘두르기 시작하자 가르시아는 어쩔 수 없이 멀리 피한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230150305
					]
				},
				{
					"id": 230150305,
					"content": "아한가르 씨가 일하게 내버려 두세요. 여행자님 이건 당신의 보수입니다. 잘 받아주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150306
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230150306,
					"content": "꼭 성공하길 빌게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150307
					]
				},
				{
					"id": 230150307,
					"content": "응원해 주셔서 감사합니다. 여행자님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150308
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230150308,
					"content": "하지만 전… 안 될 거라고 예상해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150309
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230150309,
					"content": "가르시아 선생님은 기계 천재예요. 그건 의심할 여지가 없는 사실이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150310
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230150310,
					"content": "하지만 가르시아 선생님이 만드시는 그 기계는… 「천재」, 그 이상의 뭔가가 필요해요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "루통"
				}
			]
		},
		{
			"id": 2301550,
			"completionStepIds": [],
