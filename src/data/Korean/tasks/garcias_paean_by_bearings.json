			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"가르시아",
					"아한가르",
					"루통"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150101,
					"content": "이 베어링은 사이즈가 너무 커서 다른 베어링과 연결할 수 없어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150102
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230150102,
					"content": "아까는 너무 작다더니 이건 또 너무 크다고? 내 철광을 전부 털어갈 셈이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150103
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230150103,
					"content": "그리고 이제 돈도 부족해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150104
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230150104,
					"content": "왜 싸우는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150105
					]
				},
				{
					"id": 230150105,
					"content": "이 사람이 철관과 톱니바퀴를 아주 많이 주문했는데, 요구하는 철관과 톱니바퀴의 사이즈가 다 다르더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150106
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230150106,
					"content": "이 사람의 요구에 맞추기 위해 철광을 전부 사용했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150107
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230150107,
					"content": "그런데도 부족하다며 더 많은 톱니바퀴를 만들어달라고 하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150108
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230150108,
					"content": "제 일에 대해 설명해 드릴게요. 듣고 나면 분명… 이해하실 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150109
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230150109,
					"content": "또 뭘 하시는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150110
					]
				},
				{
					"id": 230150110,
					"content": "일단 가르시아 선생님이 아한가르 씨한테 설명하게 해주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150111
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230150111,
					"content": "여행자님, 그게… 가르시아 선생님은 여행자님이 철광을 모아주길 바라세요. 이 일을 맡아주실 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150112,
						230150113
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230150112,
					"content": "시간이 있긴 한데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				},
				{
					"id": 230150114,
					"content": "기계를 제작하던 도중… 미리 예상했던 장애물을 만났죠. 가르시아 선생님은 이 문제를 어떻게 돌파할지 고민하고 계세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150115
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230150115,
					"content": "관심이 있으시다면 직접 가르시아 선생님한테 여쭤보세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150116
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230150116,
					"content": "어차피… 가르시아 선생님 말고 그 기계의 원리를 제대로 설명할 수 있는 사람은 없을 테니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150117
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230150117,
					"content": "하지만 그전에 먼저 철광부터 구해야 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "루통"
				},
				{
					"id": 230150113,
					"content": "기계 개조는 어떻게 됐나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				}
			]
		},
