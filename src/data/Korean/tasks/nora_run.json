					"노라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580101,
					"content": "아… 어떻게 하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580102
					],
					"speakerTitle": "노라"
				},
				{
					"id": 200580102,
					"content": "왜?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580103
					]
				},
				{
					"id": 200580103,
					"content": "바람 신의 신상 봤어? 위를 봐. 아주 아주 높은 곳… 바람 신의 손이 있는 곳",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580104
					],
					"speakerTitle": "노라"
				},
				{
					"id": 200580104,
					"content": "저기 가서 놀고 싶은데…. 그레이스 아줌마가 허락하지 않을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580105
					],
					"speakerTitle": "노라"
				},
				{
					"id": 200580105,
					"content": "제발 부탁해. 그레이스 아줌마가 보지 못하게 가서 말을 걸어줘. 나 정말 빨리 올라갈 수 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580106,
						200580108
					],
					"speakerTitle": "노라"
				},
				{
					"id": 200580106,
					"content": "그래…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580107
					]
				},
				{
					"id": 200580107,
					"content": "그럼 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "노라"
				},
				{
					"id": 200580110,
					"content": "어쨌든 그레이스 아줌마의 주의를 돌려줘. 나 그럼 올라간다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580111
					],
					"speakerTitle": "노라"
				},
				{
					"id": 200580111,
					"content": "노라, 안 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580112
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200580112,
					"content": "후… 한눈 좀 팔았더니 저 아이가 귀찮게 했네요. 미안해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580113
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200580113,
					"content": "이런 게 어딨어! 그냥 좀 놀려고 그런 건데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580114
					],
					"speakerTitle": "노라"
				},
				{
					"id": 200580114,
					"content": "안 되는 건 안 돼. 네 아버지도 허락하지 않으실 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580115
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200580115,
					"content": "그리고 저 아이 땡깡 받아주지 마세요. 당신이 이런 위험한 행동을 한다면 누군가가 걱정할 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200580108,
					"content": "너무 위험해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580109
					]
				},
				{
					"id": 200580109,
					"content": "괜찮아. 내 실력 대단하다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "노라"
				}
			]
		},
		{
