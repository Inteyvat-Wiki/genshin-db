				"points": []
			},
			"dialogs": [
				{
					"id": 200580901,
					"content": "아, 노라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580902,
						200580907
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200580902,
					"content": "그녀를 돌보고 계세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580903
					]
				},
				{
					"id": 200580903,
					"content": "아, 그녀의 어머니가 당분간 집에 안 계셔서 내가 돌보고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580904
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200580904,
					"content": "그 아이 외에 다른 아이들도 다 내가 돌보고 있지. 이것도 수녀의 책임 중 하나란다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580905
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200580905,
					"content": "아이들이 갑자기 많아진 것 같아. 다 착한 애들이고 글로리와도 잘 지내",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580906
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200580906,
					"content": "음… 내가 가장 오래 돌본 아이는 티미야. 날 그레이스 엄마라고 부르기 시작했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200580907,
					"content": "노라의 아버지는…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580908
					]
				},
				{
					"id": 200580908,
					"content": "페이튼 씨, 그는 예전에 술을 너무 좋아하는 바람에 집에서 큰 문제를 일으켰지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580909
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200580909,
					"content": "성당과 페보니우스 기사단에서 몇 번이나 경고했는데 반성이 없었어. 결국 다이루크 어르신이 도와줬지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580910
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200580910,
					"content": "빅토리아 수녀의 뜻은 지금 페이튼 씨가 노라를 돌보기 어려우니 성당에 맡기고, 페이튼 씨에겐 반성의 시간을 갖도록 하라는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580911
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200580911,
					"content": "하지만 노라도 커서 「아빠는 열심히 일하고 계시니 방해하면 안 돼」라는 변명이 안 먹혀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580912
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 200580912,
					"content": "바람 신의 민들레가 어디라도 다 갈 수 있는 건 아냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "그레이스"
				}
			]
		},
