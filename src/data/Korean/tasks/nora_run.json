			"dialogs": [
				{
					"id": 200580201,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580202
					],
					"speakerTitle": "노라"
				},
				{
					"id": 200580202,
					"content": "올라가서 뭐하려고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580203
					]
				},
				{
					"id": 200580203,
					"content": "그레이스 아줌마가 누군가에게 귓속말을 하고 싶으면 민들레에 말한 다음 날려보내라고 했어. 바람의 신께서 민들레와 귓속말을 그 사람에게 보내주신대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580204
					],
					"speakerTitle": "노라"
				},
				{
					"id": 200580204,
					"content": "높은 곳에서 날려보낼수록 소원이 빨리 전달된대…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580205
					],
					"speakerTitle": "노라"
				},
				{
					"id": 200580205,
					"content": "글로리 언니도 모험가에게 바람 신의 신상에서 민들레를 날려달라고 부탁했어…. 그리고 며칠 후에 갓윈 오빠에게 편지가 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580206
					],
					"speakerTitle": "노라"
				},
				{
					"id": 200580206,
					"content": "노라도 아빠한테 하고 싶은 말이 있어. 민들레도 찾았구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580207
					],
					"speakerTitle": "노라"
				},
				{
					"id": 200580207,
					"content": "근데… 그레이스 아줌마는 허락하지 않으셔. 내가 더 커야 돌아가서 아빠와 함께 살 수 있을 거래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580208
					],
					"speakerTitle": "노라"
				},
				{
					"id": 200580208,
					"content": "어떻게 해야 빨리 자랄 수 있을까? 열심히 단련하고 있는데 아직도 이렇게 키가 작아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580209
					],
					"speakerTitle": "노라"
				},
				{
					"id": 200580209,
					"content": "응… 네가 성에서 날아다니는 걸 자주 봤어. 나한테 가르쳐줘. 평소에 어떻게 날아다니는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580210,
						200580212
					],
					"speakerTitle": "노라"
				},
				{
					"id": 200580210,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580211
					]
				},
				{
					"id": 200580211,
					"content": "히히, 그럼 난 옆에서 지켜볼게. 이번엔 그레이스 아줌마가 허락하는 범위잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "노라"
				},
				{
					"id": 200580212,
					"content": "같이 날아볼래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580213
					]
				},
				{
					"id": 200580213,
					"content": "안 돼, 그레이스 아줌마가 보면 또 혼내실 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "노라"
				}
			]
		},
