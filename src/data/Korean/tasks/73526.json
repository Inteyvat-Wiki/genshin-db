	],
	"talks": [
		{
			"id": 7352601,
			"completionStepIds": [
				7352601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352601",
							"2"
						],
						"stepId": 7352601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"마디하"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735260101,
					"content": "이럴 줄 알았다면 처음부터 다른 사람한테 맡기는 건데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260102
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260102,
					"content": "1차 테스트부터 이런 시련을 주다니, 이건 너무하잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260103
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260103,
					"content": "괜찮아? 힘이 없어 보이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735260104,
					"content": "#{NICKNAME}, 탈진하기 일보 직전인 것 같으니까 뭐라도 만들어 주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735260105,
					"content": "탈진한 낯선 사람이 기운을 차릴 수 있도록, 근처 부뚜막에서 따끈따끈한 무완자 튀김과 스테이크를 만들었다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735260106
					]
				},
				{
					"id": 735260106,
					"content": "으하하하! 다시 살아났다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260107
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260107,
					"content": "요리 실력이 제법이네. 재료와 조미료 품질이 별로라 식감이 퍼석퍼석한 게 아쉽지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260108
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260108,
					"content": "배만 채우면 되지, 지금은 이것저것 따질 때가 아니잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735260109,
					"content": "아니, 틀렸어! 힘든 상황일수록 호화로운 생활을 상상해야 해. 그래야 계속 나아갈 수 있는 원동력이 되니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260110
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260110,
					"content": "자금 융통이 안 될수록 어떻게든 고액 대출을 받아야 해. 그래야 상황을 뒤집을 만한 기회를 잡을 수 있거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260111
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260111,
					"content": "이게 나 「환상의 장난감 왕·마디하」가 너희에게 주는 선물이야——전세를 역전시킬 수 있는 사업 비결!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260112
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260112,
					"content": "화… 환상의 장난감 왕? 멋진 이름이긴 한데, 지금 네 모습과는 거리가 좀 있는 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260113,
						735260114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735260113,
					"content": "장난감을 아직 못 만든 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260115
					]
				},
				{
					"id": 735260115,
					"content": "너희! 도대체 날 뭐라고 생각하는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260116
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260116,
					"content": "조금 전까지 배고픔에 시달리면서 테스트니 다른 사람한테 맡기느니 하는 말을 중얼거렸잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735260117,
					"content": "딱 보니까 아직 대표 장난감을 못 만든 거지? 끼니까지 굶고 다니다니 너무 불쌍해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735260118,
					"content": "드, 듣다 보니 진짜 짜증 나네! 내 「후후 여우」는 곧 생산을 앞두고 있다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260119
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260119,
					"content": "「후후 여우」의 비행 영역만 측정하면 버섯몬도 이해하는 설명서를 만들 수 있어. 그리고 돈을 빌려서 대량 생산하면 돈방석에 앉게 되겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260120
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260120,
					"content": "비행 영역? 설명서? 전문 용어 얘기 좀 그만해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735260121,
					"content": "백문이 불여일견이라고, 직접 보여줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260122
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260122,
					"content": "마디하가 배낭에서 남색 꾸러미를 꺼내 들더니 바람을 불어넣었다.\\n그러자 두 사람 앞에 정체불명의 장난감이 공중으로 두둥실 떠올랐다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735260123
					]
				},
				{
					"id": 735260123,
					"content": "이게 네가 말한 그 대단한 장난감이야? 전혀 여우 같지 않은데…. 차라리 「귀 달린 일몰 열매 폭탄·한정판 블루 에디션」 같은 이름이 낫겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735260124,
					"content": "게다가 「후후」는 뭐야? 웃는 표정도 아닌 것 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735260125,
					"content": "그게 아니라 제트 엔진을 가동할 때 나는 소리가 꼭 웃음소리 같아서 그래! 못 믿겠으면 직접 들어봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260126
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260126,
					"content": "(형언할 수 없는 저음이라 「후후」라고 표현할 수밖에 없다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260127
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260127,
					"content": "#대체 뭐가 웃음소리 같다는 걸까…. {NICKNAME}, 마디하의 정신 상태가 좀 걱정돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735260128,
					"content": "어쨌든 「후후 여우」는 소형 열기구의 양력과 숨어 있는 공기 분출구의 추진력이 더해져 조작감이 상당히 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260129
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260129,
					"content": "자유롭게 날아다니는 장난감을 떠올려 봐! 아이들뿐만 아니라 어른들도 그 유혹을 뿌리칠 수 없을걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260130,
						735260131
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260130,
					"content": "듣고 보니 신기하긴 해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260132
					]
				},
				{
					"id": 735260132,
					"content": "왠지 익숙한 냄새가 나는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735260133,
					"content": "이제 마디하가 「내 마지막 테스트를 도와주면 보수를 줄게」라고 말하겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260134
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735260134,
					"content": "하지만 좀 상의해 봐야겠어. 우린 바쁜 몸이라 보수가 적으면 손해거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260135
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735260135,
					"content": "아니, 아니야. 소소한 답례로는 부족하지. 어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260136
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260136,
					"content": "「후후 여우」 연 매출의 60%, 아니지… 70%를 배당금으로 줄게, 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260137
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260137,
					"content": "70%! 그건 너무 많은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260138
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735260138,
					"content": "크흠… 이제야 「환상의 장난감 왕」답네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260139,
						735260140
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735260139,
					"content": "1년 안에 대량 생산할 수 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260141
					]
				},
				{
					"id": 735260141,
					"content": "그게 핵심이야! 너희가 테스트를 빨리 완성해서 「후후 여우」의 생산, 판매 일자를 앞당기면 배당금을 더 많이 받을 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260142
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260142,
					"content": "힘을 모아 최고의 제품을 만들어 내야 윈윈할 수 있는 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260143
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260143,
					"content": "그건 그렇네. 생각할수록 맞는 말 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260144
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735260144,
					"content": "#헤헤, {NICKNAME}. 이제 우리도 장난감 사업에 진출한 셈이니 상인이라고 할 수 있겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260145
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735260145,
					"content": "그럼 우선 다른 모험가들에게 전수받아 설치한 비행 영역 테스트 도전 장치가 어딨는지부터 알려줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735260146
					],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260146,
					"content": "그럼 「후후 여우」의 미래와 「환상의 장난감 왕」 브랜드를 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마디하"
				},
				{
					"id": 735260140,
					"content": "대량 생산이 꼭 수익으로 이어지진 않던데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260141
					]
				},
				{
					"id": 735260131,
					"content": "잘 팔릴지도 몰라요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260132
					]
				},
				{
					"id": 735260114,
					"content": "이미 파산한 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735260115
					]
				}
			]
		}
	]
}