			"listShowType": "QUEST_SHOW",
			"description": "이상한 상인과 대화하기",
			"finishConditions": [
				{
					"type": "QUEST_CONTENT_COMPLETE_TALK",
					"rawParams": [
						7352601,
						0
					],
