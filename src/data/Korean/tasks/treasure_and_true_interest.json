			"trigger": {
				"objectNames": [
					"아비드",
					"아디르"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780801,
					"content": "그거 들었어? 알카미가 카베를 강사로 초청했대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780802
					],
					"speakerTitle": "아비드"
				},
				{
					"id": 190780802,
					"content": "우와, 그럼 학원도 더 잘되겠네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780803
					],
					"speakerTitle": "아디르"
				},
				{
					"id": 190780803,
					"content": "부러워 죽겠네. 알카미 그 녀석, 건축 디자이너로 일할 땐 평범했잖아. 남을 가르칠 자격이 없다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780804
					],
					"speakerTitle": "아비드"
				},
				{
					"id": 190780804,
					"content": "홍보를 잘한 덕이지, 뭐…. 게다가 입학시험을 통과해 아카데미아에서 건축을 배우기란 쉽지 않잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780805
					],
					"speakerTitle": "아디르"
				},
				{
					"id": 190780805,
					"content": "아카데미아에 입학하지 못한 사람과 「속성 교육」을 추구하는 사람들이 알카미의 학원에 모이는 건 당연한 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780806
					],
					"speakerTitle": "아디르"
				},
				{
					"id": 190780806,
					"content": "정말 장사 수완이 뛰어나다니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아비드"
				}
			]
		},
