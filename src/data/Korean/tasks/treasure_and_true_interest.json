			"trigger": {
				"objectNames": [
					"아단"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780401,
					"content": "안녕. 나한테 무슨 볼일 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780402,
						190780403
					],
					"speakerTitle": "아단"
				},
				{
					"id": 190780402,
					"content": "혹시 알카미가 누군지 아세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				},
				{
					"id": 190780404,
					"content": "알카미? 요즘 유명한 그 부자 말이지? 전에 나한테서 가구를 주문 제작했는데, 통이 엄청 크더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780405
					],
					"speakerTitle": "아단"
				},
				{
					"id": 190780405,
					"content": "녀석은 유명한 건축가라서 많은 부를 쌓았다고 들었어. 지금은 학원을 세워서 부자가 된 노하우를 공유 중이래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780406
					],
					"speakerTitle": "아단"
				},
				{
					"id": 190780406,
					"content": "수강료가 비싸지만 않았어도 우리 아이를 등록시켰을 텐데. 건축가는 정말 돈을 쓸어 담는 직업이라니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아단"
				},
				{
					"id": 190780403,
					"content": "알카미에 대해 알고 싶어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				}
			]
		},
