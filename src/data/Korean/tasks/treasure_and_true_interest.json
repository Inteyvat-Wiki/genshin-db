			"dialogs": [
				{
					"id": 190785001,
					"content": "카베 선생님이 단단히 화가 나신 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785002
					],
					"speakerTitle": "우자이"
				},
				{
					"id": 190785002,
					"content": "신경 쓰지 마. 우리한테 일자리를 뺏길까 봐 걱정하는 걸지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785003
					],
					"speakerTitle": "와이즈"
				},
				{
					"id": 190785003,
					"content": "으음… 그건 아니지 않을까? 카베 선생님은 엄청 유명하잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785004
					],
					"speakerTitle": "타니샤"
				},
				{
					"id": 190785004,
					"content": "누가 알겠어? 아버지가 그러는데 유명한 사람일수록 잘난 척한대. 알카미 선생님 같은 분은 거의 없다고 하셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "와이즈"
				}
			]
		},
