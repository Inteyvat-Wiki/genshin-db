				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750080101,
					"content": "망코, 우리 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750080102,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080103,
					"content": "음, 정말 애타게 너희를 기다렸어. 시간이 지날수록 초조해졌지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080104
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750080104,
					"content": "내가 제안했으니까… 만약에 너희가 돌아오지 못했다면 죄책감에 시달렸을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080105
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750080105,
					"content": "그런데 「불을 훔친 현자」가 유적에 남긴 증표는 찾았겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080106,
						750080107
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750080106,
					"content": "꽤 고생했어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				},
				{
					"id": 750080108,
					"content": "너희가 분명 성공할 거라고 믿었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080109
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750080109,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080110,
					"content": "봐, 이 원반 같은 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750080111,
					"content": "와… 전설의 「통첩의 금 원반」이 진짜로 있었구나. 대단해, 이걸 연구 성과에 기록해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080112
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750080112,
					"content": "이걸 「통첩의 금 원반」이라고 불렀구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750080113,
					"content": "으, 응… 미안, 내가 너무 흥분했네. 이건 「불을 훔친 현자」의 손을 친히 거친 물건이라고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080114
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750080114,
					"content": "잠깐이었지만, 이걸 가보로 삼고 싶었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080115
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750080115,
					"content": "#그건 안 돼, 우린 이걸로 {REALNAME[ID(2)|SHOWHOST(true)]}을(를) 구해야 한다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750080116,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080117,
					"content": "알아… 하지만 증표에 대한 단서는 이게 다야. 다른 하나가 어디 있는지는 나도 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080118
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750080118,
					"content": "오치카나타…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080119
					]
				},
				{
					"id": 750080119,
					"content": "#방금 오치카나타라고 했니, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080120
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750080120,
					"content": "(비석을 만졌을 때 본 것에 대해 설명한다…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080121
					]
				},
				{
					"id": 750080121,
					"content": "음, 오치카나타에 있었다니… 그곳은 꽃깃회 북쪽에 있는 바다 건너에 있는 고대 도시 유적이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080122
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750080122,
					"content": "오치카나타라면 미안하지만 난 도울 수 없어. 그곳은 부족 사람들의 금지구역이자, 용 유물 연구 협회의 금지구역이기도 하거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080123
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750080123,
					"content": "아주 오래전, 용 유물 연구 협회의 회원이 누군가의 의뢰를 받고 조사하러 갔다가, 물에 빠진 돌멩이처럼 소식이 끊겼대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080124
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750080124,
					"content": "그 후로 우리 협회는 오치카나타와 관련된 일은 더 이상 관여하지 않게 되었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080125
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750080125,
					"content": "괜찮아, 충분한 정보였어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750080126,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080127,
					"content": "다시 한번 고맙다는 인사를 하고 싶어. 「통첩의 금 원반」을 볼 수 있게 되어서 정말 다행이야. 아, 지금 이럴 때가 아니지, 빨리 가서 이 기록을 적어놔야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080128
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750080128,
					"content": "#다시 한번 고마워. {NICKNAME}, 페이몬. 모든 여정이 순조롭길 바랄게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080129
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750080129,
					"content": "#그리고 {REALNAME[ID(2)|SHOWHOST(true)]}, 너도 「불꽃 주인의 축복」의 낙인을 제거할 수 있기를 바랄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080130
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750080130,
					"content": "나중에 봐요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080131
					]
				},
				{
					"id": 750080131,
					"content": "음… 여행의 종착지이자 모든 영혼이 돌아가는 곳에서, 우린 분명 다시 만날 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "망코"
				},
				{
					"id": 750080107,
					"content": "식은 죽 먹기죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				}
			]
		},
