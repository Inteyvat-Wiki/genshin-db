			"dialogs": [
				{
					"id": 790000301,
					"content": "으으, 안 열려…. 비밀번호가 틀렸나봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000302
					],
					"speakerTitle": "잠겨진 상자"
				},
				{
					"id": 790000302,
					"content": "소라에서 나는 소리를 다시 자세히 들어 봐. 단서가 있을지도 몰라",
