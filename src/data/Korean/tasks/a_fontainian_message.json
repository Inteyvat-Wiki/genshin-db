						740090311
					],
					"speakerTitle": "소니"
				},
				{
					"id": 740090311,
					"content": "알겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090312
					],
					"speakerTitle": "루카"
				},
				{
					"id": 740090312,
					"content": "흥! 어떠냐, 버질, 잘못했어 안 했어?",
