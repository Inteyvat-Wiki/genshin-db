			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"이디이아"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790531301,
					"content": "이디이아, 큰일 났어! 긴급 사태야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790531302,
					"content": "회중시계를 찾았어! 이것 좀 봐봐, 전설의 모라 회중시계인 걸까!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531303,
						790531304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790531303,
					"content": "표면이 반짝반짝해요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531305
					]
				},
				{
					"id": 790531305,
					"content": "오오? 한번 볼게요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531306
					],
					"speakerTitle": "이디이아"
				},
				{
					"id": 790531306,
					"content": "지, 진짜네요! 설마 이 모든 게 운명일까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531307
					],
					"speakerTitle": "이디이아"
				},
				{
					"id": 790531307,
					"content": "수수께끼의 모험가가 남긴 궁극의 이스터 에그가 전설의 여행자에 의해 발견되다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531308
					],
					"speakerTitle": "이디이아"
				},
				{
					"id": 790531308,
					"content": "뭔가… 정신적 계승이 이루어진 것 같네요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531309
					],
					"speakerTitle": "이디이아"
				},
				{
					"id": 790531309,
					"content": "그렇게까지 말해주니 기분 좋긴 하지만… 그보다 회중시계를 찾은 다음에 무슨 일이 일어날지가 더 궁금한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531310,
						790531311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790531310,
					"content": "추가적인 보상 같은 게 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531312
					]
				},
				{
					"id": 790531312,
					"content": "두… 둘 다 아닌데요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531313
					],
					"speakerTitle": "이디이아"
				},
				{
					"id": 790531313,
					"content": "실은 저도 누가 이 회중시계를 찾으리라고는 전혀 생각 못 했어요…. 저조차 어디에 묻어뒀는지 잊었을 정도니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531314
					],
					"speakerTitle": "이디이아"
				},
				{
					"id": 790531314,
					"content": "하지만 회중시계 그 자체만으로도 충분히 가치 있지 않나요? 추가로 보상을 드리지 않아도 될 정도로 말이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531315
					],
					"speakerTitle": "이디이아"
				},
				{
					"id": 790531315,
					"content": "좌우간 이 일을 기록해야겠어요. 적절한 묘사를 추가해 가슴을 울리는 이야기로 만들어서 앞으로 올 방문객들에게 생생하게 들려줄 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531316
					],
					"speakerTitle": "이디이아"
				},
				{
					"id": 790531316,
					"content": "이제부터는 두 분이 묻어둔 보물이 모라 회중시계의 상징성을 대신할 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531317
					],
					"speakerTitle": "이디이아"
				},
				{
					"id": 790531317,
					"content": "생각해 보니 맨 처음 그런 얘길 했었지. 중요한 건 보물에 담긴 이야기라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790531318,
					"content": "#뭐, 일단 이 회중시계를 찬찬히 살펴보자, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790531319,
					"content": "이디이아, 부디 우리 이야기를 흥미진진하게 만들어 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531320
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790531320,
					"content": "안심하고 맡겨주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이디이아"
				},
				{
					"id": 790531311,
					"content": "숨겨진 이벤트라도 발동하나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531312
					]
				},
				{
					"id": 790531304,
					"content": "모라 무늬가 새겨져 있어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531305
					]
				}
			]
		},
		{
			"id": 7905314,
