			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"바하르"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736960101,
					"content": "안녕, 여행자. 보아하니… 학부 홍보전에 놀러왔나 봐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960102
					],
					"speakerTitle": "바하르"
				},
				{
					"id": 736960102,
					"content": "관심 있으면 우리 하라바타트 학부의 행사에 참여해보지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960103
					],
					"speakerTitle": "바하르"
				},
				{
					"id": 736960103,
					"content": "하라바타트 학부의 연구 과제가…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960104
					]
				},
				{
					"id": 736960104,
					"content": "적당한 단어로 말하자면… 「언어」야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960105
					],
					"speakerTitle": "바하르"
				},
				{
					"id": 736960105,
					"content": "그게 바로 우리 하라바타트가 연구하는 것이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960106
					],
					"speakerTitle": "바하르"
				},
				{
					"id": 736960106,
					"content": "어떻게 생각해? 학부 홍보전의 가벼운 분위기랑은 좀 안 맞는 것 같지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960107
					],
					"speakerTitle": "바하르"
				},
				{
					"id": 736960107,
					"content": "우리 학부에도 그렇게 생각하는 사람이 많아. 다들 즐겁게 축제를 즐기고 있는데, 수수께끼 같은 걸 낼 순 없잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960108
					],
					"speakerTitle": "바하르"
				},
				{
					"id": 736960108,
					"content": "수수께끼 같은 미니 게임은 사람들의 흥미를 끌기도 쉽지 않고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960109
					],
					"speakerTitle": "바하르"
				},
				{
					"id": 736960109,
					"content": "그래서 우리는 며칠에 걸친… 우호적인 토론 끝에, 「진실 추리」라는 미니 게임을 생각해 냈어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960110
					],
					"speakerTitle": "바하르"
				},
				{
					"id": 736960110,
					"content": "이 게임은 많은 도구가 필요하지 않고, 자신의 사고만 잘 정리하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960111
					],
					"speakerTitle": "바하르"
				},
				{
					"id": 736960111,
					"content": "게임이 시작되면, 내가 짧은 이야기를 들려줄 거야. 이 이야기는 종잡을 수 없거나, 심지어 일부는 논리에 어긋난다고 느껴질 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960112
					],
					"speakerTitle": "바하르"
				},
				{
					"id": 736960112,
					"content": "넌 나한테 「질문」할 수 있고, 난 네 질문에 <color=#00E1FFFF>「그렇다」</color>, <color=#00E1FFFF>「아니다」</color>, <color=#00E1FFFF>「관련이 없다」</color>, 총 3가지 답변 중 하나로 대답할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960113
					],
					"speakerTitle": "바하르"
				},
				{
					"id": 736960113,
					"content": "넌 「질문」을 통해 이야기의 「진실」을 추리해 내야 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960114
					],
					"speakerTitle": "바하르"
				},
				{
					"id": 736960114,
					"content": "하지만 너무 긴장할 건 없어. 이야기의 진실은 그다지 복잡하지 않거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960115
					],
					"speakerTitle": "바하르"
				},
				{
					"id": 736960115,
					"content": "어때? 관심 있으면 지금 시작해볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960116,
						736960118
					],
					"speakerTitle": "바하르"
				},
				{
					"id": 736960116,
					"content": "네, 시작해봐요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960117
					]
				},
				{
					"id": 736960117,
					"content": "좋아. 그럼 첫 번째 이야기야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바하르"
				},
				{
					"id": 736960118,
					"content": "다른 일이 있어서요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960119
					]
				},
				{
					"id": 736960119,
					"content": "난 여기 계속 있을 테니까, 해보고 싶으면 언제든지 찾아와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바하르"
				}
			]
		}
	]
}