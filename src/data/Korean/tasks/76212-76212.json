				"points": []
			},
			"dialogs": [
				{
					"id": 762120301,
					"content": "옆에 있는 책장에 착륙했다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762120304
					]
				},
				{
					"id": 762120304,
					"content": "여긴 안전해. 금발 친구, 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120305,
						762120306
					],
					"speakerTitle": "키야우케찰"
				},
				{
					"id": 762120305,
					"content": "그냥 좀 궁금해서요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120308
					]
				},
				{
					"id": 762120308,
					"content": "여긴 나무 선반이 높고, 시야도 트여 있어. 몸을 숨기기엔 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120309
					],
					"speakerTitle": "키야우케찰"
				},
				{
					"id": 762120309,
					"content": "내가 있던 큰 {RUBY#[D]부족}집에선, 땅에 머무는 게 위험했어. 머리 위의 지배{RUBY#[S]지고한 영주}자가 변덕으로 우릴 죽이지 않더라도, 다른 큰 {RUBY#[D]부족}집 약탈자들이 와서 우리를 털어갔으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120310
					],
					"speakerTitle": "키야우케찰"
				},
				{
					"id": 762120310,
					"content": "비단날개새처럼 절벽이나 나무 꼭대기에서 살아야만, 재앙이 닥치기 전에 도망칠 수 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120311
					],
					"speakerTitle": "키야우케찰"
				},
				{
					"id": 762120311,
					"content": "게다가 빈디아는 내가 나는 모습을 보고 싶다고 했어. 거대한 새를 타고 모험하는 이야기를 노{RUBY#[D]쓰고}래하고 싶대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120312
					],
					"speakerTitle": "키야우케찰"
				},
				{
					"id": 762120312,
					"content": "속은 건가요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120313
					]
				},
				{
					"id": 762120313,
					"content": "아니야. 빈디아는 아주아주 좋은 사람이야. 어쩌면 십자로의 주인만큼이나 좋을지도 몰라. 정말 다정해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120314
					],
					"speakerTitle": "키야우케찰"
				},
				{
					"id": 762120314,
					"content": "그나저나 너희는 아주 높이 날더라. 정말 대단해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120315
					],
					"speakerTitle": "키야우케찰"
				},
				{
					"id": 762120315,
					"content": "이거 줄게. 친구의 증표야. 나는 이제 붙잡히지 않도록 더 높이 날 방법을 고민해 봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120316
					],
					"speakerTitle": "키야우케찰"
				},
				{
					"id": 762120316,
					"content": "물론 여긴 고귀한 지배{RUBY#[S]지고한 영주}자도 없고, 가죽 벗기기를 좋아하는 정복자도 없어서 안전하지만, 난 아직도 도주로를 찾아두는 버릇이 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "키야우케찰"
				},
				{
					"id": 762120306,
					"content": "혹시 못 내려오나 싶었거든요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120307
					]
				},
				{
					"id": 762120307,
					"content": "고마워. 하지만 갇힌 건 아니야. 높은 곳은 안전해. 살해당하지도 않고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120308
					],
					"speakerTitle": "키야우케찰"
				}
			]
		}
	]
}