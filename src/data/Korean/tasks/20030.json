				"points": []
			},
			"dialogs": [
				{
					"id": 200300201,
					"content": "길드 가입을 진심으로 환영해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300202
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200300202,
					"content": "이건 너의 <color=#00E1FFFF>「모험 핸드북」</color>이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300203,
						200300205
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200300203,
					"content": "핸드북도 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300204
					]
				},
				{
					"id": 200300204,
					"content": "신인 가입이 얼마나 중요한 일인데 당연히 형식은 차려야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200300207,
					"content": "여기엔 길드와 관련된 수많은 의뢰와 보상 정보가 기록되어 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300208
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200300208,
					"content": "또 이건 회원 증명서이기도 해. 자주 살펴보고 잃어버리지 않게 잘 보관해 둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300209
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200300209,
					"content": "맞다, 그리고 또 하나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300210
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200300210,
					"content": "「모험 등급」을 올리다 보면 한계에 부딪히게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300211
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200300211,
					"content": "그럴 땐 「인상적인 임무」를 완료해서 길드의 인정을 받으면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300212
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200300212,
					"content": "인상적인… 임무?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200300213,
					"content": "「모험 등급」의 최대치를 돌파할 수 있는 「돌파 임무」라고 할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300214
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200300214,
					"content": "아직 너한텐 이르지만, 네 「경력」이 충분해지면 자연스레 모두의 인정을 받게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300215
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200300215,
					"content": "그럼 오늘은 여기까지. 앞으로 자주자주 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300216
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200300216,
					"content": "열심히 해봐. 별과 심연을 향해~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐서린"
				},
				{
					"id": 200300205,
					"content": "이건… 홍보 책자?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300206
					]
				},
				{
					"id": 200300206,
					"content": "그렇게 생각해도 되지만, 홍보 책자보다는 효율적이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "캐서린"
				}
			]
		}
	]
}