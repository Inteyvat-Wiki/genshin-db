			"trigger": {
				"objectNames": [
					"두라프"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020101,
					"content": "아이고, 그 애가 어떻게 됐는지도 모르겠고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020102
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 201020102,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020103
					]
				},
				{
					"id": 201020103,
					"content": "응? 오, 마침 잘왔어. 저번에 그 편지 기억나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020104
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 201020104,
					"content": "시간 있으면 그레이스 수녀님에게 이 편지 좀 전해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020105,
						201020107
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 201020105,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020106
					]
				},
				{
					"id": 201020106,
					"content": "그럼 부탁 좀 할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "두라프"
				},
				{
					"id": 201020107,
					"content": "왜 제가 가야 하죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020108
					]
				},
				{
					"id": 201020108,
					"content": "저번에 그런 사고가 있었는데 어떻게 계속 비둘기로 편지를 보낼 수 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020109
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 201020109,
					"content": "그리고 내가 직접 이 편지를 몬드성으로 갖고 갔다간 틀림없이 그 애를 만나게 될 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020110
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 201020110,
					"content": "휴… 그만 물어봐. 부탁 좀 할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "두라프"
				}
			]
		},
		{
			"id": 2010202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"두라프"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020201,
					"content": "응? 아직도 안 갔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020202,
						201020205
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 201020202,
					"content": "편지에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020203
					]
				},
				{
					"id": 201020203,
					"content": "…오래된 이야기를 적었어. 저번에 안 봤니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020204
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 201020204,
					"content": "안 봤다면 보지 마. 시시콜콜한 잔소리일 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "두라프"
				},
				{
					"id": 201020205,
					"content": "그 애가 누군데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020206
					]
				},
				{
					"id": 201020206,
					"content": "알아서 뭐 하게. 다리 위에서 계속 비둘기한테 먹이를 주는 애 있잖아. 기억하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020207
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 201020207,
					"content": "바로 걔야, 티미. 사정이 좀 있어서 지금은 내가 직접 가기가 뭣해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020208
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 201020208,
					"content": "이제 됐어? 빨리 가서 편지 좀 전해줘. 안 그럼 그레이스 수녀님이 또 딴생각을 할거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "두라프"
				}
			]
		},
		{
			"id": 2010203,
			"completionStepIds": [
				2010202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"그레이스"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020301,
					"content": "이상하네. 왜 아직도 안 오지? 무슨 일이 생긴 건가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020302
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020302,
					"content": "여기 두라프 씨가 수녀님께 드리라고 한 편지예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020303
					]
				},
				{
					"id": 201020303,
					"content": "어라? 어째서 네가 갖고 왔니? 평소엔 비둘기가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020304
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020304,
					"content": "비둘기한테 무슨 일 생긴 거야? 샘물 마을도 참… 매번 「이변」이 생긴다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020305
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020305,
					"content": "편지 전해줘서 고마워. 잠깐만 기다려줄래? 답례를 준비해 올게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020306
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020306,
					"content": "편지에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020307
					]
				},
				{
					"id": 201020307,
					"content": "봤니? 괜찮아. 대단한 비밀은 아니거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020308
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020308,
					"content": "두라프 씨의 말을 빌리자면 이건 「오래된 이야기」야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020309
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020309,
					"content": "다만, 우리가 영원히 잊을 수 없는 「오래된 이야기」지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020310
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020310,
					"content": "그 「오래된 이야기」라는 게 대체…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020311
					]
				},
				{
					"id": 201020311,
					"content": "듣고 싶니? 좋아, 넌 믿을 만한 사람이니까…. 하지만 약속해. 이 일을 아무에게도 말해서는 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020312,
						201020313
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020312,
					"content": "약속해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020316
					]
				},
				{
					"id": 201020316,
					"content": "…티미의 아빠와 두라프 씨는 함께 사냥도 하고, 술도 마시고, 같이 말썽도 부리는 절친한 친구 사이였어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020317
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020317,
					"content": "기사단한테 얼마나 경고받았는지, 빅토리아 수녀님께서 얼마나 훈계를 했는지 셀 수가 없을 정도였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020318
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020318,
					"content": "티미가 태어나고 나서야 정신을 차렸지. 술도 끊고 열심히 일해서 돈을 벌기 시작했어. 「아빠는 아들에게 모범을 보여야 한다」면서 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020319
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020319,
					"content": "그는 티미에게 나쁜 본보기가 되지 않겠다고 다짐했고 덩달아 두라프 씨도 술을 끊게 만들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020320
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020320,
					"content": "진짜 참을 수 없을 땐 직접 만든 무알코올 사과주를 조금씩 마셨어. 가끔은 나도 같이 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020321
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020321,
					"content": "하지만 사냥하러 갔다가 뜻밖에 사고가 일어났어. 티미의 아빠는 그 사고로 심각한 부상을 입었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020322
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020322,
					"content": "바로 데려왔고 우리도 최선을 다해 치료했지만… 안타깝게도 그는 세상을 떠났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020323
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020323,
					"content": "그후, 두라프 씨는 티미를 돌봐달라는 부탁을 남긴 채 샘물 마을로 돌아가 계속 사냥꾼으로 살고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020324
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020324,
					"content": "그는 매달 편지와 돈을 보내오지만 티미를 만나려 하지는 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020325
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020325,
					"content": "하지만 최근엔 티미에게 진실을 알려주겠다고 했어. 에휴, 도대체 무슨 일이 있었던 건지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020326,
						201020332,
						201020336
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020326,
					"content": "티미에게 진실을 알려주고 싶지 않나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020327
					]
				},
				{
					"id": 201020327,
					"content": "응, 티미는 아직 어리잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020328
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020328,
					"content": "사나이라고 하면서 날 도와 노라와 글로리를 돌봐주긴 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020329
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020329,
					"content": "이런 가혹한 진실을 어떻게 감당하겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020330
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020330,
					"content": "티미가 진실을 감당할 수 있을 만큼 충분히 크면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020331
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020331,
					"content": "속이는 거지만 괜찮아. 난 그저 행복한 어린 시절을 만들어 주고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020341,
					"content": "하지만 티미도 이젠 컸는지 생각도 많이 하고, 질문도 많아졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020342
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020342,
					"content": "나도 이제 점점 이 아이를 상대하기 버거워지고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020343
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020343,
					"content": "노라 말로는 그동안 티미가 자기를 끌고 다니면서 아빠에게 줄 선물을 준비하고 편지도 부쳤다고 하는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020344
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020344,
					"content": "요즘은 티미가 영 우울해하고 멍하니만 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020345
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020345,
					"content": "시간 있다면 티미를 보러 가줄 수 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020346,
						201020348
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020346,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020347
					]
				},
				{
					"id": 201020347,
					"content": "그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020348,
					"content": "왜 직접 가지 않으세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020349
					]
				},
				{
					"id": 201020349,
					"content": "미안하잖아…. 티미에게 진실을 알려주지 않을 거라 했지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020350
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020350,
					"content": "그 아이가 아빠에게 편지를 쓰겠다고 할 때마다 마음이 약해져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020351
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020351,
					"content": "어느 날 못 참고 진실을 전부 말해버릴까 봐 정말 무서워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020352
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020352,
					"content": "…절대 그러면 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020353
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020353,
					"content": "그래서 너한테 티미를 보러 가달라고 부탁하는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020332,
					"content": "평생을 속일 순 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020333
					]
				},
				{
					"id": 201020333,
					"content": "…그래, 나도 알아. 하지만 티미는 아직 어린걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020334
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020334,
					"content": "난 그저… 티미가 행복한 어린 시절을 보내길 바랄 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020335
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020335,
					"content": "그럼 앞으로 어떤 시련이 닥치더라도 위로가 될만한 좋은 추억이 있을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020336,
					"content": "진실을 아는 게 뭐가 나쁘죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020337
					]
				},
				{
					"id": 201020337,
					"content": "휴… 너는 경험도 많고 용감하고 강하기 때문에 당연히 그렇게 생각할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020338
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020338,
					"content": "너를 이렇게 비범하게 만들어준 경험들도 분명 고통스러웠겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020339
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020339,
					"content": "하지만 티미는 아직 어리잖아. 내 이기심이라 해도 좋아. 나도 티미가 너무 많은 짐을 짊어지는 건 원치 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020340
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020340,
					"content": "…최소한 추억할만한 행복한 어린 시절로 만들어 주고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020313,
					"content": "최선을 다할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020314
					]
				},
				{
					"id": 201020314,
					"content": "휴, 못 말려…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020315
					],
					"speakerTitle": "그레이스"
				},
				{
					"id": 201020315,
					"content": "하지만 난 너의 인성을 믿어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020316
					],
					"speakerTitle": "그레이스"
				}
