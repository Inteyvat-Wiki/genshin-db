					"content": "무명의 보물에 대해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160302
					]
				},
				{
					"id": 710160302,
					"content": "내 추측이 맞다면, 저번에 네가 가져온 물건은 총 3개일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160303
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 710160303,
					"content": "3개를 합쳐야 비로소 완전해지지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160304
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 710160304,
					"content": "만약 전부 찾아낸다면, 내가 높은 가격에 사들일게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160305
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 710160305,
					"content": "근데 너무 오래돼서 전부 찾으려면… 쉽진 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "임랑"
				}
			]
		},
