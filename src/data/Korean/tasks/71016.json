			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"임랑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160201,
					"content": "무명의 보물에 대해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160202
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 710160202,
					"content": "그 물건… 꽤 좋아 보이는데? 무늬를 보니 좀 오래된 모양이야. 잠깐만 기다려줘, 한번 열어볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160203
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 710160203,
					"content": "흠이 좀 있긴 한데, 급하게 파는 거라면 내가 살게. 다만 그리 높은 가격은 아닐 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160204
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 710160204,
					"content": "문양을 보니 확실히 리월에서 나온 거 같네. 그리고 위에 기록돼 있는 것도 「야타용왕」과 관련된 일화야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160205
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 710160205,
					"content": "전설에 따르면 야타용왕은 리월의 바위 원소 정수가 모여 생겨난 마룡이었다고 해. 암왕제군이신 모락스도 쉽게 제압하실 수 없었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160206
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 710160206,
					"content": "암왕제군께선 그 마룡을 진압하기 위해 먼저 선인 세 분을 모아 그들에게 선계를 만들어 달라고 하셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160207
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 710160207,
					"content": "그리고 암왕제군께서 친히 그와 싸우셔 그를 선계 속으로 물리치셨지. 그리고 선인들에게 힘을 모아 통로를 봉쇄하라고 명하신 후에야 야타용왕이 진압됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160208
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 710160208,
					"content": "이 물건에 있는 문양은 아마 그 당시 3명의 선인이 힘을 합쳐 선계를 만들었던 장면을 묘사하고 있는 걸 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160209
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 710160209,
					"content": "그래서 이런 물건은 아마 최소 3개 있을 거야. 세 부분을 합쳐야 비로소 완전해지는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160210,
						710160212
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 710160210,
					"content": "정말 잘 아시네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160211
					]
				},
				{
					"id": 710160211,
					"content": "이쪽 장사를 하는 사람이니, 다양한 지식을 알고 있어야 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 710160215,
					"content": "아, 주제에서 벗어났네. 아무튼 아까 말한 것처럼, 이 물건은 총 3개 있어. 하나씩 팔면 가격이 그리 높지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160216
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 710160216,
					"content": "하지만 3개를 다 찾는다면 가격이 달라지겠지. 보아하니 꽤 오래된 것 같은데, 3개를 전부 찾으려면 쉽진 않을 거 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "임랑"
				},
				{
					"id": 710160212,
					"content": "리월은 정말 신기해요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160213
					]
				},
				{
					"id": 710160213,
					"content": "그건 잘 모르겠어. 하지만 리월은 너무 커서 그만큼 역사도 오래됐다고 예전에 어떤 선배가 그랬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160214
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 710160214,
					"content": "리월에서 아주 이상하고 오래된 물건을 발견한다 해도 놀랄 것 없어. 리월의 유구한 역사에 비해 우리가 아는 건 극히 일부일 뿐이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "임랑"
				}
			]
		},
