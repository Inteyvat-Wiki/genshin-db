	"talks": [
		{
			"id": 1050201,
			"completionStepIds": [
				1050202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050202",
							"2"
						],
						"stepId": 1050202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"모나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020101,
					"content": "곧 수제자를 만날 텐데 준비됐어? 이 스승인 날 부끄럽게 만들지 말라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020102,
						105020103
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020102,
					"content": "난 점칠 줄 모른다니까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020104
					]
				},
				{
					"id": 105020104,
					"content": "그렇긴 하지만… 아니! 아무리 가짜 제자라고 해도 아무것도 모르면 안 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020105
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020105,
					"content": "외부인에게 전수하면 안 되는 규정이 있긴 하지만… 너라면 안될 것도 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020106
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020106,
					"content": "내 점성술은 「수점술」이야. 말 그대로 물에 비친 그림자를 통해 진정한 별하늘을 보는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020107
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020107,
					"content": "내가 먼저 시범을 보여줄게, 잘 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020108
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020108,
					"content": "지금 별의 모양과 흐름으로 봐선, 음… 그 수제자는 페보니우스 기사단의 젊고 유능한… 여자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020109
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020109,
					"content": "이건… 음… 리사를 말하는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105020110,
					"content": "여기서 곧 그녀를 만나게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020111
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020111,
					"content": "좋아, 이 정도 정보면 충분해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020112,
						105020113
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020112,
					"content": "이게 끝이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020114
					]
				},
				{
					"id": 105020114,
					"content": "휴, 가장 기본적인 점성술이라고 해도 한눈에 보이는 건 아닌가 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020115
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020115,
					"content": "됐어, 조금 있다가 자세히 설명해줄게. 그녀가 벌써 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020116
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020116,
					"content": "#와, 명예 기사 {F#언니}{M#오빠}! 그리고 페이몬! 돌아왔구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020117
					],
					"speakerTitle": "클레"
				},
				{
					"id": 105020117,
					"content": "——이 아이가 바로 위대한 학식을 계승 받은 수제자야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020118,
						105020119
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020118,
					"content": "…클레가?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020120
					]
				},
				{
					"id": 105020120,
					"content": "수제자…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020121
					],
					"speakerTitle": "클레"
				},
				{
					"id": 105020121,
					"content": "그래. 내가 바로 별바다의 비밀을 꿰뚫는 그 점성술사야! 너도 내가 올 줄 알고 있었지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020122
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020122,
					"content": "별바다? 별바다가 뭐야? 거기에도 물고기가 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020123
					],
					"speakerTitle": "클레"
				},
				{
					"id": 105020123,
					"content": "물고기…? 모르는 척하지 마. 설마 내 도전이 두려운 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020124
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020124,
					"content": "언니야말로 무슨 말을 하는 거야! 하나도 못 알아듣겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020125,
						105020126
					],
					"speakerTitle": "클레"
				},
				{
					"id": 105020125,
					"content": "이렇게 얘기하다간 끝도 없겠어!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020127
					]
				},
				{
					"id": 105020127,
					"content": "하지만 내 점성술이 틀릴 리 없는걸…음, 그럼 혹시 모르니 물어볼게, 너희 엄마 이름이 「앨리스」 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020128
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020128,
					"content": "맞아. 아! 언니는 엄마의 친구구나! 하지만 엄마는 지금 엄청 먼 곳에 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020129
					],
					"speakerTitle": "클레"
				},
				{
					"id": 105020129,
					"content": "그건 나도 알아. 점성의 결과로 알아냈어. 하지만 그녀가 떠나기 전에 너에게 오컬트적 지식을 남겨주지 않았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020130
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020130,
					"content": "오컬트 지식… 그게 뭐야? 엄마는 나한테 통통 폭탄을 만드는 법밖에 안 가르쳐 줬는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020131
					],
					"speakerTitle": "클레"
				},
				{
					"id": 105020131,
					"content": "그럼 클레의 엄마가 모나의 사부님과 「친구이자 라이벌」인 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020132
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105020132,
					"content": "응. 사부님은 점성술에 뛰어나긴 하지만 점성술 외의 것들은 잘 몰라. 그런데 앨리스는 모든 오컬트 분야에 정통한 천재지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020133
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020133,
					"content": "…클레는 어리니까 그런 수준 높은 지식은 못 알아듣지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020134
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105020134,
					"content": "음, 혈통만 물려받고 지식은 아직 물려받지 않은 모양이군… 계산 착오야. 이래선 겨룰 수가 없겠는걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020135
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020135,
					"content": "참, 꼬마야. 앨리스가 가기 전에 「50년의 약속」이라며 그 상자에 관해 얘기해 준 적 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020136
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020136,
					"content": "아아, 그건 알아! 상자를 가지러 온 거였구나. 찾아볼게, 잠깐만 기다려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020137
					],
					"speakerTitle": "클레"
				},
				{
					"id": 105020137,
					"content": "이건 아니고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020138
					],
					"speakerTitle": "클레"
				},
				{
					"id": 105020138,
					"content": "이것도 아닌데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020139
					],
					"speakerTitle": "클레"
				},
				{
					"id": 105020139,
					"content": "아냐 아냐, 이것도 아냐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020140
					],
					"speakerTitle": "클레"
				},
				{
					"id": 105020140,
					"content": "아! 생각났다. 그 상자랑 내 새로운 보물을 전부 <color=#00E1FFFF>바람이 시작되는 곳</color>에 숨겨놨어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020141,
						105020142
					],
					"speakerTitle": "클레"
				},
				{
					"id": 105020141,
					"content": "또 폭탄은 아니겠지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020143,
					"content": "잠깐만 기다려줘, 지금 바로 갖다줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020144
					],
					"speakerTitle": "클레"
				},
				{
					"id": 105020144,
					"content": "어디가! 가방에 있는 물건은 다 필요 없는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020145
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105020145,
					"content": "이건 내가 치울 테니까 너넨 그 애를 쫓아가 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020146
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105020146,
					"content": "휴, 저렇게 덤벙대는 걸 보니 상자가 걱정되는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "모나"
				},
				{
					"id": 105020142,
					"content": "왜 중요한 걸 자꾸 밖에 묻어두는 거야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020143
					]
				},
				{
					"id": 105020126,
					"content": "그러니까 뭔가 잘못된 거라니까…",
