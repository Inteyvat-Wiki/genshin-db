							"2401002",
							"2"
						],
						"stepId": 2401002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"부시코"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100201,
					"content": "어서 와, 필요한 거 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100202
					],
					"speakerTitle": "부시코"
				},
				{
					"id": 240100202,
					"content": "드피에리스의 물감에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100203
					]
				},
				{
					"id": 240100203,
					"content": "아, 드피에리스 대신 물감을 가지러 온 거야? 여기 준비해뒀어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100204
					],
					"speakerTitle": "부시코"
				},
				{
					"id": 240100204,
					"content": "하여간 드피에리스는 물감을 너무 빨리 쓴다니까. 누가 보면 물감을 사서 바로 물에 풀어버리는 줄 알겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100205
					],
					"speakerTitle": "부시코"
				},
				{
