					"content": "너한테 맡길게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722620625
					]
				},
				{
					"id": 722620625,
					"content": "#으앗, {NICKNAME}(이)가 이런 말을 하는 건 흔치않아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620626
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722620626,
					"content": "응, 맡겨줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722620627
					],
					"speakerTitle": "페이몬"
				},
				{
