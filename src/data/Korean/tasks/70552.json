						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"유라"
				],
				"points": [
					{
						"sceneId": 51207,
						"position": [
							2191.087,
							230.089,
							-781.388
						],
						"pointId": 1
					},
					{
						"sceneId": 51207,
						"position": [
							2193.858,
							230.219,
							-782.875
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705520201,
					"content": "유라 대장님을 위한 「반짝이는 별하늘」 나왔습니다. 드셔보세요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520202
					]
				},
				{
					"id": 705520202,
					"content": "흐응, 말투를 보니 자신 있나 보네? 그럼 어디 맛을 봐볼까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520203
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520203,
					"content": "오? 좋은데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520204
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520204,
					"content": "달콤하고 톡 쏘는 게, 상쾌한 느낌이야. 탄산수가 포인트네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520205
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520205,
					"content": "몸속의 활력이 깨어나는 것 같아. 한 잔으론 모자란데… 조금 더 강한 걸로 한 잔 더 주겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520206,
						705520207
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520206,
					"content": "더 강한 술이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520208
					]
				},
				{
					"id": 705520208,
					"content": "하하, 조심스럽게 굴 필요 없어! 두어 잔에 쓰러질 정도로 약하진 않다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520209,
						705520210
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520209,
					"content": "그럼 얘기 나누면서 다시 생각해 볼게요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520211
					]
				},
				{
					"id": 705520211,
					"content": "좋아, 오늘 밤은 1소대에서 서류 작업을 맡기지 않았으니까 여유가 있어. 옛날 얘기라도 나누면서 새로운 레시피를 시도해 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520212
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520212,
					"content": "한동안 못 봤는데, 계속 설산 근처에서 근무하신 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520213
					]
				},
				{
					"id": 705520213,
					"content": "응, 좀 복잡한 상황이 있었어. 어떤 엔지니어 도적단이 기계 제어 기술을 개발해서, 유적 가디언을 조종해 상단을 약탈하려 들었거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520214
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520214,
					"content": "게다가 돈만 항구에 상주하던 노기사 몇 명이 내 부대로 배속됐는데, 「로렌스가의 아가씨」인 나를 인정하려 들지 않았지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520215
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520215,
					"content": "임무 수행 과정에도 우여곡절이 많았어. 눈밭에서 불도 못 피우고 추위에 떨며 3주간 잠행해서, 겨우 적의 거점을 찾아냈거든?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520216
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520216,
					"content": "그런데 선배들 몸이 얼어붙어서 적이 밀수한 전투 기계에 당할 뻔했지 뭐야… 다행히 전투가 무사히 끝나서, 다들 날 인정해 줬지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520217,
						705520218
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520217,
					"content": "고생 많으셨네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520219
					]
				},
				{
					"id": 705520219,
					"content": "나? 전혀 문제없지…. 걱정해 줘서 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520220
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520220,
					"content": "그때는 마음고생을 하긴 했지만, 이번 작전으로 선배들도 진이 빠졌을 테니 더 이상 나를 책잡진 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520221
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520221,
					"content": "앞으로 나한테 시비 거는 신입이 있으면, 이 선배들한테 지도를 맡길까 봐. 문제를 단번에 해결할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520222
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520222,
					"content": "그러고 보니 유라 씨가 가져오신 건… 수입산 과즙인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520223
					]
				},
				{
					"id": 705520223,
					"content": "맞아. 상인이 「바다 이슬 꽃 과일 추출 원액」이라고 부르더라… 향이 엄청 독특해. 너도 한 병 줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520224,
						705520225
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520224,
					"content": "요즘 이걸 자주 마시나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520226
					]
				},
				{
					"id": 705520226,
					"content": "흠… 이건 필수적인 예의범절에 필요한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520227
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520227,
					"content": "메기스토스 씨가 빌려준 《검무자의 20년 후》라는 책에 이렇게 적혀 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520228
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520228,
					"content": "「폰타인의 검객들은 검을 겨룬 뒤, 승자가 예의를 갖춰 패자를 대접한다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520229
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520229,
					"content": "클로린드 씨를 품격 있게 대접하려고 한참 찾아다니다가, 돈만 항구에서 희귀품 상인을 만나 이 절판된 물건을 구할 수 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520230
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520230,
					"content": "그건 그냥 소설 속 이야기 같은데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520231
					]
				},
				{
					"id": 705520231,
					"content": "음… 처음엔 나도 의심했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520232
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520232,
					"content": "근데 엠버가 그러더라. 폰타인에 실제로 이런 관습이 없더라도, 이건 우리가 폰타인의 문화를 열심히 공부했다는 증거가 된다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520233
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520233,
					"content": "그리고 다 떠나서, 새로운 미식을 싫어하는 사람은 없잖아. 안 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520234
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520234,
					"content": "검술 교류 후 모임 자리에서, 클로린드 씨에게 이걸 대접할 생각이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520235
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520235,
					"content": "검술 교류 후 모임 자리에서, 클로린드 씨가 이걸 아주 맛있어 하시더라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520236
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520236,
					"content": "곧 대결이 있을 텐데, 기분이 어떠세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520237
					]
				},
				{
					"id": 705520237,
					"content": "음… 솔직히 말하면 엄청 설레…. 조금 긴장되기도 하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520238
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520238,
					"content": "지난번 대결 후, 기분이 어땠나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520239
					]
				},
				{
					"id": 705520239,
					"content": "아… 솔직히 클로린드 씨와 대결하기 전에는 엄청 설렜어…. 조금 긴장되기도 했고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520240
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520240,
					"content": "클로린드 씨의 전투 유파는 신비한 「그림자 사냥꾼」이거든…. 도서관에 있는 백 년 전 폰타인 신문에도 그 조직의 막강함이 언급돼 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520241
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520241,
					"content": "심지어 몇 년 전 신문에는 이런 글도 있었어. 클로린드 씨가 어느 해저 왕국의 마지막 자손이라, 전투 전 의식을 발동해 검에 영혼을 깃들게 한다는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520242
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520242,
					"content": "뒷이야기는 모르지만, 일단 소문을 사실이라고 상정할까 해. 아니, 실제 실력은 그 이상이라고 생각하고 마음의 준비를 해둬야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520243
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520243,
					"content": "뒷이야기는 모르지만, 클로린드 씨의 실력을 볼 때 그 기사는 과장이 아니었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520244,
						705520245
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520244,
					"content": "검술 역사에 길이 남을 대결이니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520246
					]
				},
				{
					"id": 705520246,
					"content": "음료에 「검술」 요소를 담는다고? 꽤 창의적인 생각이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520247
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520247,
					"content": "기운을 끌어올릴 필요는 있지만… 음료로 그걸 어떻게 표현하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520248
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520248,
					"content": "그런 기념 칵테일이라면 한 잔 마셔보고 싶은걸…. 하지만 음료로 그걸 어떻게 표현하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520249
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520249,
					"content": "제가 관찰한 바로는… 레이피어를 사용하는 폰타인 검사들은 대부분 찌르기에 능하고… 정확한 압박을 지속적으로 이어가는 스타일이었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520250
					]
				},
				{
					"id": 705520250,
					"content": "음… 책에서 본 묘사와 일치해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520251
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520251,
					"content": "음료로 비유하자면, 커피나 풍선귤 아이스와인… 또는 몬드의 과일주 같은 느낌이랄까요. 첫맛은 자극적이지 않지만, 긴 여운이 남죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520252
					]
				},
				{
					"id": 705520252,
					"content": "그래서 이번 특제 칵테일의 베이스도 과일주로 잡아봤어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520253
					]
				},
				{
					"id": 705520253,
					"content": "일리 있어…. 역시 전문가답네. 티바트에서 이런 해석을 할 수 있는 사람은 너밖에 없을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520254
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520254,
					"content": "반면 유라 씨의 검술은 달라요. 마치 리드 댄서처럼, 양손검의 넓은 검날을 자유롭게 휘두르며 회전하고 날아오르죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520255
					]
				},
				{
					"id": 705520255,
					"content": "한 번 명중하면 눈사태처럼 몰아치는 파괴력을 보여주고요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520256
					]
				},
				{
					"id": 705520256,
					"content": "부딪치는 순간의 충격을 더 강조하는 느낌이라고 할까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520257
					]
				},
				{
					"id": 705520257,
					"content": "그… 그렇게 예술적으로 표현 안 해도 돼! 난 그냥 왕실 유파의 페보니우스 검술을 변형한 거에, 약간의 해석을 더한 것뿐이니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520258
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520258,
					"content": "그러니까 유라 씨의 스타일은… 입에 닿는 순간 엄청난 임팩트로 승부를 주면서도, 얼음처럼 깔끔한 마무리감이 있는 독주라고 할 수 있죠. 예를 들면——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520259
					]
				},
				{
					"id": 705520259,
					"content": "불의 물!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520260
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520260,
					"content": "최근 몇 년 사이에, 스네즈나야 상인 덕분에 불의 물이 각지에서 유행하기 시작했어. 웬만한 술집에선 이걸 베이스로 한 메뉴를 볼 수 있지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520261
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520261,
					"content": "우리 함께 최고의 답을 찾았네요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520262
					]
				},
				{
					"id": 705520262,
					"content": "정말 대단해! 그럼 베이스를 과일주에서 불의 물로 바꿔볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520263
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520263,
					"content": "도수라면… 문제없어! 원정대 동료들이 불의 물에 픽픽 쓰러지긴 했지만, 난… 자신 있다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520264
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520264,
					"content": "요즘엔 바쁠 때 뭘 드세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520265
					]
				},
				{
					"id": 705520265,
					"content": "요즘의 식사? 그걸 말하려면 보급 소대의 새로운 성과부터 얘기해야 해——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520266
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520266,
					"content": "보급 소대가 「기사 식단 개선 프로젝트」를 시작하면서, 우리 같은 야외 작전 소대에게 표준화된 통조림을 배급하기 시작했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520267
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520267,
					"content": "예전엔 건조 식량만 받아서, 식사 때마다 냄비와 불을 준비하고, 주사위를 굴려 요리 담당을 정하고, 나머지는 교대로 경계를 서야 했어…. 번거로웠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520268
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520268,
					"content": "하지만 이제는 「표준 전장 보급품」 세트만 챙기면 돼. 통조림 다섯 개랑 종이팩 아홉 개가 들어 있어서, 모닥불 옆에서 데우기만 하면 끝이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520269,
						705520270
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520269,
					"content": "꽤 편리할 것 같네요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520271
					]
				},
				{
					"id": 705520271,
					"content": "하하, 너도 확신은 없지? 통조림 공급 업체 평판도 꽤 괜찮고, 일반 통조림은 맛도 나쁘지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520272
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520272,
					"content": "문제는… 군용 통조림은 오래 보관 가능하도록 만들다 보니까, 너무 짜다는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520273
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520273,
					"content": "짓궂은 농담을 좋아하는 5소대의 부대장은 이렇게 평가했지. 「이 통조림을 여는 순간 리월의 조왕신이 쳐들어올걸」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520274
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520274,
					"content": "아무튼, 일주일 동안 통조림만 먹었더니 미각이 완전 마비돼 버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520275,
						705520276
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520275,
					"content": "정말 무섭네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520277
					]
				},
				{
					"id": 705520277,
					"content": "보급 소대를 탓할 순 없지. 모두의 입맛을 맞추긴 어려우니까. 피드백을 제출했으니, 부족한 점도 곧 개선될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520278
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520278,
					"content": "물론, 야영지에서 소대 전속 요리사가 만든 신선한 음식을 먹는 게 제일이지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520279
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520279,
					"content": "음, 이제 두 번째 잔을 어떻게 만들어야 할지 알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520280
					]
				},
				{
					"id": 705520280,
					"content": "좋아, 그럼 네 두 번째 즉흥 공연을 시작해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "유라"
				},
				{
					"id": 705520276,
					"content": "누구한테 따져야 하는 거죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520277
					]
				},
				{
					"id": 705520270,
					"content": "별문제 없는 것 같은데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520271
					]
				},
				{
					"id": 705520245,
					"content": "검술 테마의 음료를 만들어 기념하는 건 어떨까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520246
					]
				},
				{
					"id": 705520225,
					"content": "왜 들고 다니세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520226
					]
				},
				{
					"id": 705520218,
					"content": "감기 걸리진 않았어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520219
					]
				},
				{
					"id": 705520210,
					"content": "레시피를 완전히 바꿔야겠어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520211
					]
				},
				{
					"id": 705520207,
					"content": "이게 약하다고요?",
					"roleType": "TALK_ROLE_PLAYER",
