				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"유라"
				],
				"points": [
					{
						"sceneId": 51207,
						"position": [
							2191.087,
							230.089,
							-781.388
						],
						"pointId": 1
					},
					{
						"sceneId": 51207,
						"position": [
							2193.858,
							230.219,
							-782.875
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705520101,
					"content": "응? 네가 이 음료 가게를 관리하고 있는 거야? 진작 알았으면 오전부터 왔을 텐데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520102,
						705520103
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520102,
					"content": "환영합니다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520104
					]
				},
				{
					"id": 705520104,
					"content": "벌써 궁금해지는걸——네 음료 제조 실력이 상당하다는 소문을 들었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520105
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520105,
					"content": "글렌피디아가 준비한 재료로, 과연 어떤 음료를 만들어내려나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520106,
						705520107
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520106,
					"content": "근데 유라 씨, 요즘 바쁘신 것 같던데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520108
					]
				},
				{
					"id": 705520108,
					"content": "어쩔 수 없지. 중요한 일이 연달아 있거든… 먼저 기사단 전원이 참여하는 연례 전투 기술 평가가 있는데, 이번에 평가 기준이 크게 높아졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520109
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520109,
					"content": "유격대 대장으로서 내가 모범을 보여야 하지 않겠어? 최소한 대장급 실전 대결에서 3위 안에는 들어야 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520110
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520110,
					"content": "그래서 요즘 훈련을 계속 강화하고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520111,
						705520112
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520111,
					"content": "유라 대장이 이런 성격이었다니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520113
					]
				},
				{
					"id": 705520113,
					"content": "흥, 죄인의 후예가 이 자리를 지키는 건 쉬운 일이 아니라고. 난 한 번도 직무를 소홀히 한 적 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520114
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520114,
					"content": "그리고 행정 소대가 기사들의 전투 경험을 늘리기 위해 검술 교류 자리를 마련했어. 폰타인의 유명한 결투 대리인을 초청했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520115
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520115,
					"content": "나는 출근율이 높은 대장들 중에 양손검을 다루는 실력이 좋은 편이라, 이번 교류 대표로 뽑히게 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520116
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520116,
					"content": "열심히 준비해서 그 결투 대리인과 승부를 펼치고, 결과에 따라 최소 여섯 개의 보고서를 작성해야 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520117
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520117,
					"content": "게다가 이전에 클로린드 씨와 몇 차례 겨루는 데에도 상당한 에너지를 쏟았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520118
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520118,
					"content": "레이피어와 총의 이중 공격을 어떻게 막고 반격해야 할지, 어떻게 주도권을 빼앗을지… 지금도 계속 곱씹는 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520119
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520119,
					"content": "이번 교류 결과는 훌륭해. 양측 모두에게 큰 도움이 되고 있지. 서로 다른 관점의 보고서 여섯 개? 스물네 개도 받아들일 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520120,
						705520121
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520120,
					"content": "조금 센 걸로 한 잔 드릴까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520122
					]
				},
				{
					"id": 705520122,
					"content": "맞아. 기운을 북돋아 주는 거라면 어떤 종류든 상관없어. 너한테 맡길게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705520123
					],
					"speakerTitle": "유라"
				},
				{
					"id": 705520123,
					"content": "(유라 씨의 상태를 보면, 「반짝이는 별하늘」을 만들어 주는 게 좋겠다)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705520121,
					"content": "에너지 충전이 필요하실 것 같아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520122
					]
				},
				{
					"id": 705520112,
					"content": "유라 씨의 이런 면은 처음 알았네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520113
					]
				},
				{
					"id": 705520107,
					"content": "일을 열심히 하시는 것 같았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520108
					]
				},
				{
					"id": 705520103,
					"content": "필요한 게 있으면 말씀해 주세요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705520104
					]
				}
			]
		},
		{
			"id": 7055202,
			"completionStepIds": [
				7055206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
