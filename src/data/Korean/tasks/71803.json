					"nextDialogs": [
						718030402,
						718030404
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 718030402,
					"content": "처치했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030403
					]
				},
				{
					"id": 718030403,
					"content": "수고했어, 의뢰를 완료했으니 길드의 실력을 인정받겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "란 누님"
				},
				{
					"id": 718030404,
					"content": "처치했죠. 그레이도 찾았는 걸요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030405
					]
				},
				{
					"id": 718030405,
					"content": "수고했어… 뭐라고?",
					"roleType": "TALK_ROLE_NPC",
