			},
			"dialogs": [
				{
					"id": 718030301,
					"content": "야옹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030302
					],
					"speakerTitle": "그레이"
				},
				{
					"id": 718030302,
					"content": "어라? 여기에 웬 고양이가 있지? 방금 쟤가 소리낸 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 718030303,
					"content": "야옹… 야옹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030304,
						718030308
					],
					"speakerTitle": "그레이"
				},
				{
					"id": 718030304,
					"content": "회색 고양이…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030305
					]
				},
				{
					"id": 718030305,
					"content": "회색 고양이… 밖에서 실종된…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 718030306,
					"content": "어랏! 란 언니가 말했던 고양이를 찾아달라는 의뢰…. 그게 저 고양이인가? 이름이 그레이였던 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 718030307,
					"content": "여기서 찾게 될 줄은 몰랐네…. 계속 이 근처에 숨어있던 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 718030311,
					"content": "츄츄 바위왕이 여기에 있어서 다들 겁먹고 찾으러 오지 않았나봐…. 그레이도 무서워서 숨어있던 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 718030312,
					"content": "우리가 안 왔으면 여기 계속 처박혀있어야 했을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 718030313,
					"content": "야옹… 야옹야옹!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030314,
						718030317
					],
					"speakerTitle": "그레이"
				},
				{
					"id": 718030314,
					"content": "야옹… 야옹…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030315
					]
				},
				{
					"id": 718030315,
					"content": "야, 뭐 하는 거야. 그런다고 의사소통이 되겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 718030316,
					"content": "란 언니에게 데러다주자. 그럼 의뢰인에게 돌려줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 718030319,
					"content": "야옹… 야옹! 야옹!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030320,
						718030322
					],
					"speakerTitle": "그레이"
				},
				{
					"id": 718030320,
					"content": "야옹… 야옹! 야옹!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030321
					]
				},
				{
					"id": 718030321,
					"content": "아무리 용을 써도 못 알아듣는다니까! 얼른 데려다주자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 718030322,
					"content": "대답한 거 같은데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030323
					]
				},
				{
					"id": 718030323,
					"content": "그걸 어떻게 알아… 됐고, 어서 데리고 돌아가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 718030317,
					"content": "길드에 데려다주자…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030318
					]
				},
				{
					"id": 718030318,
					"content": "응, 그 수밖에 없겠어. 그레이를 란 언니에게 데려다주면, 알아서 의뢰인에게 돌려주겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 718030308,
					"content": "설마 쟤가 그레이…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030309
					]
				},
				{
					"id": 718030309,
					"content": "회색 고양이… 밖에서 실종된…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 718030310,
					"content": "앗! 란 언니가 말했던 고양이를 찾아달라는 의뢰, 여기서 찾게 되다니…. 계속 여기 근처에 숨어있었던 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "페이몬"
				}
			]
