						718030502
					],
					"speakerTitle": "그레이"
				},
				{
					"id": 718030502,
					"content": "이 고양이는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030503
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 718030503,
					"content": "그레이일지도 몰라요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030504
					]
				},
				{
					"id": 718030504,
					"content": "잠깐, 의뢰서를 찾아서 특징을 대조해봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030505
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 718030505,
					"content": "어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030506
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 718030506,
					"content": "거의 비슷한데… 의뢰가 들어온 그 고양이 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030508
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 718030508,
					"content": "의뢰인이 무척 기뻐하겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030509
					]
				},
				{
					"id": 718030509,
					"content": "휴… 돌고 돌아서 결국 또 고양이 찾아달라는 의뢰로군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030510
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 718030510,
					"content": "정말 뭐라고 해야 할지 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030511
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 718030511,
					"content": "상황을 의뢰인들에게 보고할게. 수고했고, 이건 보수니까 받아둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030512
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 718030512,
					"content": "근데 고양이를 찾아달라던 의뢰인은… 이사 간 것 같아. 연락이 되려면 시간이 좀 걸리겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030513
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 718030513,
					"content": "의뢰인이 찾으러 오기 전까지, 내가 이 녀석 집사 노릇을 해야겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030514
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 718030514,
					"content": "야옹야옹, 야옹!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "그레이"
				}
			]
		}
