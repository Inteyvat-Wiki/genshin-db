				"points": []
			},
			"dialogs": [
				{
					"id": 111030101,
					"content": "푸른 물과 산 위에 영혼이 노닐고, 속세에서 한가로이 부채질하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030102
					],
					"speakerTitle": "동작"
				},
				{
					"id": 111030102,
					"content": "저기, 방해해서 미안한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030103,
					"content": "향로와 등을 빌리러 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030104
					]
				},
				{
					"id": 111030104,
					"content": "…그것참 희한한 일이군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030105
					],
					"speakerTitle": "동작"
				},
				{
					"id": 111030105,
					"content": "사당에 와서 신선을 찾지 않고 오히려 향로를 가져가려 하다니, 하하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030106
					],
					"speakerTitle": "동작"
				},
				{
					"id": 111030106,
					"content": "우리도 무례한 요구인 거 아는데, 잠깐만 좀 쓰면 안 될까…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030107,
					"content": "「몽유제경법」 의식에 필요한 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030108
					],
					"speakerTitle": "동작"
				},
				{
					"id": 111030108,
					"content": "앗… 어떻게 알았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030109,
					"content": "이곳에 너희가 상상할 수도 없을 만큼 오래 머물렀기 때문이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030110
					],
					"speakerTitle": "동작"
				},
				{
					"id": 111030110,
					"content": "진심이 닿은 덕분인지 「선법」도 몇 가지 깨우쳤다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030111
					],
					"speakerTitle": "동작"
				},
				{
					"id": 111030111,
					"content": "그런 일이 가능하다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030112,
					"content": "자자, 어서 가져가게. 이렇게 누군갈 도울 수 있다는 것도 기쁜 일이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030113
					],
					"speakerTitle": "동작"
				},
				{
					"id": 111030113,
					"content": "…더 이상 여기 남아봤자 아무 의미 없으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030114,
						111030116
					],
					"speakerTitle": "동작"
				},
				{
					"id": 111030114,
					"content": "무슨 고민이라도 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030115
					]
				},
				{
					"id": 111030115,
					"content": "난 신경 쓰지 말고 어서 원하는 걸 가져가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동작"
				},
				{
					"id": 111030116,
					"content": "아무튼… 정말 감사해요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030117
					]
				},
				{
					"id": 111030117,
					"content": "괜찮으니까 어서 원하는 걸 가져가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동작"
				}
			]
		},
		{
