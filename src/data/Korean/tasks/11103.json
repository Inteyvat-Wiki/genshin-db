						111030704
					],
					"speakerTitle": "소"
				},
				{
					"id": 111030704,
					"content": "여긴… 음? 너희들 뭔가 낯이 익은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030705
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111030705,
					"content": "내 몸이 왜 이러지? 무게가 안 느껴질 만큼 가벼워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030706,
						111030709
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111030706,
					"content": "선법으로 당신의 영혼을 불러냈어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030707
					]
				},
				{
					"id": 111030707,
					"content": "…선법? 하하하하하, 감히 선인인 내 앞에서 선인인 척을 하다니, 겁도 없구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030708
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111030708,
					"content": "그나저나 여긴 어딘가? 난 분명 망서 객잔에서 편히 자고 있었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111030712,
					"content": "맞아, 음~ 그랬던 거군. 역시 나야, 하하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030713
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111030713,
					"content": "난 꿈을 꾸고 있는 거구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030714
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111030714,
					"content": "음… 정말 답이 없는 녀석이네. 이래선 계획대로 될 수 없겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030715,
						111030716
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030715,
					"content": "이건 꿈이 아니에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030717,
					"content": "그래서 어쩔건데? 이 선인님의 꿈속에서 감히 뭘 하려는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030718
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111030718,
					"content": "응… 시작하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030716,
					"content": "왜냐하면… 통증이 느껴지니까요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030709,
					"content": "당신은 이미 죽었거든요",
