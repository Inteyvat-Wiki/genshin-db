			},
			"dialogs": [
				{
					"id": 111030201,
					"content": "이 향로… 정말 괜찮은 거겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030202,
					"content": "이 사당처럼 낡진 않았으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030203,
					"content": "향로 다음은… 근처에 있는 「칠성등」도 찾아야 하지? 빨리 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 1110303,
			"completionStepIds": [
				1110303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110303",
							"2"
						],
						"stepId": 1110303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030301,
					"content": "응? 왜 아무도 없지? 아깐 분명 여기 있었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030302,
					"content": "필요한 물건만 가지고 갈 줄 알았는데, 내 행방까지 신경 쓸 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030330
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030330,
					"content": "아! 아까 그 목소리야! 어, 어딨는 거야!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030303,
					"content": "내 몸은 천 년 전에 이미 없어졌어. 너희가 방금 본 건 「부세유형법」이 만들어낸 허상이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030304,
					"content": "너희들이 「부세유형법」에 필요한 향로와 칠성등을 가져갔으니 당연히 내가 안 보이는 거네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030305,
						111030306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030305,
					"content": "당신은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030308
					]
				},
				{
					"id": 111030308,
					"content": "난 원래 야차 중에서 보잘것없는 선인이었는데 암왕제군께서 내게 「동작」이란 이름을 내려주셨지. 그리고 수천 년 전 실력이 부족해 전투 중 목숨을 잃었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030309,
					"content": "오늘은 내 기일이야. 지금의 리월을 보는 게 내 마지막 소원이어서 이렇게 주제넘게 의식을 행한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030310,
					"content": "그나저나… 너희들은 「항마대성」이 보내서 온 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030311,
					"content": "뭐야, 아는 사이였어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030312,
					"content": "너희한테서 그의 기운이 느껴져…. 점점 더 강해지는 「업장」의 기운도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030313,
					"content": "하아… 수천 년 동안 계속 그런 고통을 견디고 있었던 건가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030314,
					"content": "…정말 면목 없군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030315,
					"content": "그런 말 마. 「동작」 씨도 리월을 위해 목숨을 바쳤잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030316,
					"content": "목숨이 귀하긴 하지만… 「항마대성」이 짊어진 것에 비하면 죽음도 일종의 해방일 뿐이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030317,
					"content": "「동작」 씨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030318,
					"content": "하하, 이런. 생일은 즐거운 날이지만, 기일은 결국 슬퍼지기 마련이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030319,
					"content": "「부세유형법」의 효력이 거의 끝나가는군. 그럼 잘 있게. 「항마대성」한테 안부도 좀 전해주고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030320,
						111030321
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030320,
					"content": "꼭 전할게요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030322,
					"content": "제대로 된 「흘호어 구이」를 한 번 더 먹어보고 싶구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030323,
					"content": "「거센 파도 속에서 흘호어를 찾고, 눈보라 부는 산으로 돌아와 요마를 죽이네…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030324
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030324,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030325
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030325,
					"content": "…벌써 사라졌어. 누군가 「동작」이라고 하는 이 야차를 기억해줬으면 좋겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030326
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030326,
					"content": "우리도 갈까? 나중에 시간 있을 때 분향하러 오자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111030321,
					"content": "「동작」 씨도 잘 지내세요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030306,
					"content": "귀, 귀신?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030307
					]
				},
				{
					"id": 111030307,
					"content": "하하하… 틀린 말은 아니군. 「선인」과 「귀신」은 종이 한 장 차이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030308
					],
					"speakerTitle": "페이몬"
				}
			]
		},
