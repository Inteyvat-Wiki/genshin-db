			},
			"dialogs": [
				{
					"id": 80030601,
					"content": "가버렸어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030602,
					"content": "#으… {NICKNAME}, 너무 슬퍼하지 마…. 다시 찾을 수 있을 거야! 좋은 쪽으로 생각하자구! 적어도 이번엔 아주 중요한 단서를 찾았잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030603,
						80030605
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030603,
					"content": "…슬픈 거 아니야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030604
					]
				},
				{
					"id": 80030604,
					"content": "앗? 그래…? 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030607,
					"content": "어쨌든 지금 상황으로 봐선 「일곱 신」뿐만 아니라 「데인」도 가족을 찾는 데 중요한 돌파구가 될 것 같아, 그치?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030608,
						80030609
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030608,
					"content": "이나즈마에 가서도 계속 신경 써야겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030610,
					"content": "맞아~ 참, 방금 들은 말 엄청 난해하던데, 넌 이해했어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030611,
						80030612
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030611,
					"content": "대충 이해했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030613,
					"content": "흠… 그럼 정리 좀 해볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030614
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030614,
					"content": "#일단 그 심연 사도는 네 {F#오빠를}{M#동생을} {F#왕자 전하}{M#공주 전하}라고 불러",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030615
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030615,
					"content": "#아무래도 네 {F#오빠는}{M#동생은} 심연 교단을 이끌고 있고, 심연 사도보다 지위도 더 높은 것 같아…. 최고 통솔자인지는 아직 잘 모르겠지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030616
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030616,
					"content": "#네 {F#오빠}{M#동생}의 목표는 「신좌를 덮고 천리와 싸우는 거」랬는데… 무슨 뜻일까? …일곱 신과 일곱 나라를 멸망시키려는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030617
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030617,
					"content": "게다가 심연 교단이 켄리아 백성들이 뒤틀려서 변한 몬스터였다니…. 너무 끔찍해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030618
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030618,
					"content": "켄리아 사람인 데인은 500년 전에 모든 걸 겪었지만 괴물이 되지 않았고, 500년 후인 지금 심연 교단에 맞서고 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030619
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030619,
					"content": "#그래서 네 {F#오빠가}{M#동생이} 「데인은 자신의 적」이라고 한 거겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030620
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030620,
					"content": "그치만 심연 교단의 몬스터가 그때 데인이 지키려던 백성들이라면, 데인은 왜 심연 교단에 적대적인 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030621
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030621,
					"content": "#게다가… 우리가 찾던 네 {F#오빠는}{M#동생은} 왜 지금 심연 교단의 몬스터들 편에 서 있는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030622,
						80030623
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030622,
					"content": "정보가 너무 적어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030624,
					"content": "응, 맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030625
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030625,
					"content": "그럼—— 기운 내자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030626
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030626,
					"content": "우리의 여행은 끝난 게 아니잖아. 움직여보자고! 일단 이 지긋지긋한 곳에서 벗어나 햇살이 닿는 곳으로 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030627
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030627,
					"content": "#네 {F#오빠가}{M#동생이} 너한테 「종착지」로 향하라고 한다면… 좋아, 가서 보여주자구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030628
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030628,
					"content": "「여행자」, 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030623,
					"content": "더 생각해봤자 의미 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030612,
					"content": "#{F#오빠}{M#동생}한테 집중하느라 자세히 못 들었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030609,
					"content": "「여행」의 목적이 하나 더 생겼어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030605,
					"content": "페이몬 말이 맞아. 희망이 보여",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030606
					]
				},
				{
					"id": 80030606,
					"content": "맞아, 맞아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
