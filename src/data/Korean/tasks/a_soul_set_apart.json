				"points": []
			},
			"dialogs": [
				{
					"id": 80030101,
					"content": "어! 데인 여기 있네. 진 단장은 만났어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030102,
					"content": "봤지만, 일부러 피했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030103
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80030103,
					"content": "그녀는 「라이언 기사」이자 단장 대행이니, 분명 날 경계할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030104
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80030104,
					"content": "섣불리 행동했다간 언젠가 조사 대상이 되고 말 테지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030105
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80030105,
					"content": "어쨌든, 내 쪽은 마물만 처리했을 뿐 정보는 못 찾았어. 너흰 뭐 알아낸 거 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030106
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80030106,
					"content": "그렇군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030107
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80030107,
					"content": "그럼 「최초의 경작기」의 동향을 대략 파악할 수 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030108
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80030108,
					"content": "에? 정말? 「왕랑」이 한 말만 가지고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030109,
					"content": "그 정보뿐만 아니라 좀 더 종합적으로 생각해봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030110
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80030110,
					"content": "예를 들어, 너희가 그전에 성당에서 들었던 그 「오래된 이야기」라든지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030111
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80030111,
					"content": "「폭군의 원한」?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030112
					]
				},
				{
					"id": 80030112,
					"content": "맞아, 그 수녀가 폭군의 원한으로 오인됐다고 한 그 기괴한 사건 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030113,
						80030114,
						80030126
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80030113,
					"content": "만약 하늘에서 떨어진 불덩이가 미사일이라면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030115,
					"content": "아, 알았다! 그러니까 「폭군의 원한」은 사실 울프 영지에서 도망친 그 기계가 자동으로 발사한 미사일이었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030116,
					"content": "「늑대의 시련」에서 망가진 뒤로 방황하다가 「옛 몬드」의 폐허에 자리를 잡은 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030117,
					"content": "그리고 사람이 다가가면 탕탕탕——미사일을 쏘다가 결국 완전히 망가져서 하늘에서 내리던 불덩이도 사라지게 된 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030118,
					"content": "그때의 몬드 사람들은 「유적 가디언」을 접해본 경험이 적어서 「폭군의 원한」이라고밖에 생각을 못 한 거구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030119,
					"content": "아무래도 <color=#00E1FFFF>「바람 드래곤의 폐허」</color>라고 불리는 그곳에 가서 본격적으로 조사를 시작해야겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030120,
						80030121
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80030120,
					"content": "아뇨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030122,
					"content": "호오? 그 말은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030123
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80030123,
					"content": "「기억」나는 게… 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030124
					]
				},
				{
					"id": 80030124,
					"content": "엥… 그게 무슨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030125,
					"content": "오! 알겠다! 맞아, 그 <color=#00E1FFFF>「고탑에 앉아있는 가디언」</color> 정말 인상 깊었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030121,
					"content": "그럴 필요 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030114,
					"content": "당시 몬드는 그 불덩이가 뭔지 몰랐죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030126,
					"content": "사실 바바라는 부제예요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				}
			]
		},
