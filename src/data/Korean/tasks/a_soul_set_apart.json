			"dialogs": [
				{
					"id": 80030201,
					"content": "호, 혹시 저 사람이 바로…?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030202,
					"content": "#{F#오빠}{M#루미네}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030203
					]
				},
				{
					"id": 80030203,
					"content": "#{F#루미네}{M#오빠}…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030204,
						80030205
					]
				},
				{
					"id": 80030204,
					"content": "얼마나 찾았다구!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				},
				{
					"id": 80030206,
					"content": "#잠… 잠깐, {NICKNAME}, {M#니 동생이}{F#니 오빠가} 방금 심연 사도 대신 공격을 막아줬어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030207,
					"content": "#네 {M#동생}{F#오빠} 아무래도 「심연」이랑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030208,
					"content": "#{M#오빠가}{F#네가} 왜 데인이랑 같이 있는 거지?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030209,
						80030210
					]
				},
				{
					"id": 80030209,
					"content": "…뭐?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030211,
					"content": "(얼마 만에 본 건데…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030213,
					"content": "엥?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030214,
					"content": "#{NICKNAME}, 네 {M#동생이}{F#오빠가}… 데인을 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030215,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030216
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80030216,
					"content": "#{M#오랜만이군, 루미네}{F#오랜만이군, 아이테르}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030217
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80030217,
					"content": "#이… 이게 도대체 무슨 일이야?! 데인도 네 {M#동생을}{F#오빠를} 알잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030218,
					"content": "#{F#그 사람하고 같이 있어선 안 돼}{M#그 사람하고 같이 있어선 안 돼, 오빠}",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030219
					]
				},
				{
					"id": 80030219,
					"content": "그 사람은… 내 「적」이야",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030220
					]
				},
				{
					"id": 80030220,
					"content": "#{M#루미네…}{F#아이테르…}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030221,
						80030222
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80030221,
					"content": "잠깐!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030223,
					"content": "……",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030224
					]
				},
				{
					"id": 80030224,
					"content": "#이건 꼭 해야 하는 말이야 {M#, 오빠}. 데인과 함께 나를, 그리고 「심연」을 막지 마",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030225
					]
				},
				{
					"id": 80030225,
					"content": "켄리아 마지막 왕조 친위대의 「여광의 검」, 데인슬레이프. 그는 500년 전 켄리아의 멸망을 막지 못했어",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030226
					]
				},
				{
					"id": 80030226,
					"content": "그때 그는 불사의 저주를 받은 채 황야를 떠돌아다녔어…. 그가 지키려던 백성들이 심연의 괴물이 되는 걸 지켜만 보면서 말이지",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030227
					]
				},
				{
					"id": 80030227,
					"content": "지금… 데인이 켄리아 사람이라는 거야?! 500년 전에 역사 속으로 사라진 그 켄리아?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030228
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030228,
					"content": "게다가 백성들이 괴물이 됐다니…. 그러니까 지금의 심연 교단은 「켄리아와 관계」가 있는 정도가 아니라 아예 켄리아의 「유민」들이라고?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030229
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030229,
					"content": "으… 그리고 「데인이 네 적」이라니, 뭐가 뭔지 하나도 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030230,
						80030231
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80030230,
					"content": "#{F#오빠!}{M#루미네!} 일단 나랑 집에 가자!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030232,
					"content": "집이라…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030233
					]
				},
				{
					"id": 80030233,
					"content": "#음, 맞아. {M#오빠가}{F#네가} 있는 곳이 바로 「집」이지",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030234
					]
				},
				{
					"id": 80030234,
					"content": "#하지만 지금은 {F#너와}{M#오빠와} 다음 세상으로 갈 수도, 새로운 보금자리를 찾을 수도 없어…. 적어도 지금은 안 돼…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030235
					]
				},
				{
					"id": 80030235,
					"content": "「심연」이 신좌를 덮기 전까지, 나와 「천리」 사이의 전쟁은 끝나지 않아…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030236
					]
				},
				{
					"id": 80030236,
					"content": "천… 리?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030237
					]
				},
				{
					"id": 80030237,
					"content": "#내 말 잘 들어, {M#오빠}{F#루미네}",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030238
					]
				},
				{
					"id": 80030238,
					"content": "#난 이미 여행을 다녀왔어. {F#너도}{M#오빠도} 나처럼 종착지에 도착하면, 이 세계에 남겨진 진실을 보게 될 거야",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				},
				{
					"id": 80030231,
					"content": "그런 건 일단 집에 가서 얘기해!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030222,
					"content": "#그게 대체 무슨 말이야! {F#오빠!}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030212,
					"content": "(왜 그런 얘기부터… 하는 거야?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030210,
					"content": "왜… 데인 씨에 대한 걸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030205,
					"content": "어서 나랑 같이 가자! 여긴 위험해!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				}
			]
		},
