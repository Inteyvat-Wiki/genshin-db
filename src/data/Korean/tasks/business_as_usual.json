			"dialogs": [
				{
					"id": 191320401,
					"content": "안녕하세요, 무슨 일이시죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320402
					],
					"speakerTitle": "란양"
				},
				{
					"id": 191320402,
					"content": "응광 씨의 옷을 가지러 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320403
					]
				},
				{
					"id": 191320403,
					"content": "아, 이야기 들었어요. 잠시만 기다려 주세요, 바로 가져올게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320404
					],
					"speakerTitle": "란양"
				},
				{
					"id": 191320404,
					"content": "오랜 시간 기다린 후, 란양이 드디어 돌아왔다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						191320405
					]
				},
				{
					"id": 191320405,
					"content": "여기요, 응광 님께 전해주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320406
					],
					"speakerTitle": "란양"
				},
				{
					"id": 191320406,
					"content": "꽤 오래 걸렸네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320407
					]
				},
				{
					"id": 191320407,
					"content": "네, 이 방엔 응광 님의 소장품이 아주 많거든요. 옷뿐만 아니라, 각종 공예품과 옥기까지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320408
					],
					"speakerTitle": "란양"
				},
				{
					"id": 191320408,
					"content": "요새 응광 님 뜻에 따라 배치를 조정 중이다 보니 방이 좀 난잡해서 드나들기가 쉽지 않네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320409,
						191320410
					],
					"speakerTitle": "란양"
				},
				{
					"id": 191320409,
					"content": "(소장품이 많긴 많네…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				},
				{
					"id": 191320411,
					"content": "아무튼 고마워요. 이 옷을 부탁드려요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "란양"
				},
				{
					"id": 191320410,
					"content": "(가진 자의 고민이겠지)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				}
			]
