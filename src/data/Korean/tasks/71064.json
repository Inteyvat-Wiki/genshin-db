			"dialogs": [
				{
					"id": 710640401,
					"content": "찾아야 하는 공물은 각각 「왕관」, 「깃털」, 「잔」, 「해시계」, 「꽃」, 그리고 「창」이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640402
					],
					"speakerTitle": "아망"
				},
				{
					"id": 710640402,
					"content": "하지만 지금까지 공물을 전부 찾은 사람은 아무도 없었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아망"
				}
			]
		},
