			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 240070401,
					"content": "이건… 찢어진 옷인가? 완전히 변색됐네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070402
					],
					"speakerTitle": "로위"
				},
				{
					"id": 240070402,
					"content": "혹시 누가 이미 싹 훑고 갔나? 왜 부품이 하나도 없지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베루"
				}
			]
		},
