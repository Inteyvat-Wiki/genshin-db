			},
			"dialogs": [
				{
					"id": 240070301,
					"content": "찾았다! 멀쩡한 톱니바퀴야. 봐봐, 베어링도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070302
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240070302,
					"content": "좋았어! 쓸 만한 걸 손에 넣었네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "로위"
				}
			]
		},
		{
			"id": 2400704,
			"completionStepIds": [
				2400704
