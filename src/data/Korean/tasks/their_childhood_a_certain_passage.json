			},
			"dialogs": [
				{
					"id": 240070101,
					"content": "로위? 뭐 좋은 것 좀 찾았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070102
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240070102,
					"content": "아니! 여긴 아무것도 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070103
					],
					"speakerTitle": "로위"
				},
				{
					"id": 240070103,
					"content": "여기서 뭐 해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070104
					]
				},
				{
					"id": 240070104,
					"content": "#{M#형아}{F#누나}, 우리 지금 「보물찾기」 하는 중이야. 헤헤, {M#형아}{F#누나}도 같이 할래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070105,
						240070108
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240070105,
					"content": "보물찾기?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070106
					]
				},
				{
					"id": 240070106,
					"content": "베루가 하는 말은 듣지 마. 우린 그냥 부품을 찾는 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070107
					],
					"speakerTitle": "로위"
				},
				{
					"id": 240070107,
					"content": "부품이 보물이나 마찬가지지 뭐… 음? 여기 있을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240070114,
					"content": "흠… 여기는 없는 것 같아. 다른 데로 가볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070115
					],
					"speakerTitle": "로위"
				},
				{
					"id": 240070115,
					"content": "그래! 좀 더 앞으로 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070116,
						240070117
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240070116,
					"content": "나도 같이 가줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070118,
					"content": "#으엑, {M#형아}{F#누나} 말투가 우리 형이랑 똑같아졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070119
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240070119,
					"content": "그럼 조금만 더 앞으로 가보자. 이 근처 물속에 부품이 많았던 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베루"
				},
				{
					"id": 240070117,
					"content": "함부로 뛰어다니면 안 돼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070108,
					"content": "오렐은 어디 갔어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070109
					]
				},
				{
					"id": 240070109,
					"content": "형은 질문할 게 있다면서 들르뤼 아저씨 만나러 갔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070110
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240070110,
					"content": "우린 어쩔 수 없이 여기서 얌전히 「보물찾기」나 하고 있었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070111
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240070111,
					"content": "#헤헤… {M#형아}{F#누나}도 우리랑 같이 할래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070112
					],
					"speakerTitle": "베루"
				},
				{
					"id": 240070112,
					"content": "베루가 하는 말은 듣지 마. 우린 그냥 부품을 찾는 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070113
					],
					"speakerTitle": "로위"
				},
				{
					"id": 240070113,
					"content": "부품이 보물이나 마찬가지지 뭐… 음? 여기 있을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
					],
					"speakerTitle": "베루"
				}
			]
		},
