				"points": []
			},
			"dialogs": [
				{
					"id": 412140101,
					"content": "짜잔! 우리 또 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412140102,
					"content": "여행자, 페이몬, 잘 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140103
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140103,
					"content": "이렇게 알베도랑 만나는 게 익숙해졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140104,
						412140105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412140104,
					"content": "네가 부탁한 거 완료했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				},
				{
					"id": 412140106,
					"content": "정말 고마워. 역시 너에게 맡기길 잘했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140107
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140107,
					"content": "도움이 됐어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140108
					]
				},
				{
					"id": 412140108,
					"content": "물론이지, 넌 내 연구에 엄청난 도움을 줬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140109
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140109,
					"content": "헤헤, 알면 됐다구~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412140110,
					"content": "이 은혜는 잊지 않을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140111
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140111,
					"content": "이 검 돌려줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140112
					]
				},
				{
					"id": 412140112,
					"content": "이제 충분히 강해졌겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412140113,
					"content": "이 정도면 됐어. 몸은 좀 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140114
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140114,
					"content": "평소랑 똑같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140115
					]
				},
				{
					"id": 412140115,
					"content": "그럼 부작용은 없는 거네. 오염되거나 독에 걸리지도 않았고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140116
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140116,
					"content": "역시… 내 생각이 맞았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140117
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140117,
					"content": "뭐든지 다 알고 있다는 저 표정, 왕재수!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412140118,
					"content": "검은 쓸 만해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140119,
						412140120
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140119,
					"content": "응",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140121,
					"content": "그렇구나. 어찌 됐건 검도 내가 원하는 상태가 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140122
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140122,
					"content": "검을 들었어… 알베도, 그걸로 뭘 하려는 거야? 어, 어리석은 짓 하지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412140123,
					"content": "너로 인해 정화된 순수한 생명의 힘을 빼내야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140124
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140124,
					"content": "검에서 힘을 빼낼 수 있다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412140125,
					"content": "다른 사람은 몰라도 난 가능해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140126
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140126,
					"content": "…됐다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140127
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140127,
					"content": "와! 힘이 빛나는 구슬처럼 됐어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412140128,
					"content": "엇! 이상한 병 속으로 들어갔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412140129,
					"content": "이 검은 전설의 무기까진 아니지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140130
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140130,
					"content": "기념으로 가져가. 앞으로 네 여정에 도움이 됐으면 좋겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140131,
						412140132
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140131,
					"content": "진짜 괜찮겠어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140133,
					"content": "내가 원한 건 이와 관련된 실험 결과였어. 이제 원하는 걸 얻었으니 검은 잘 다루는 네가 가져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140134
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140134,
					"content": "연구를 도와줘서 고마워, 여행자. 그럼, 또 보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140135
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140135,
					"content": "나와 공명을 일으킬 수 있는, 드래곤의 생명력이라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140136
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140136,
					"content": "드래곤이라서 그런 게 아니라 나 때문이겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140137
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140137,
					"content": "라인도티르… 스승님… 이게 바로 스승님이 창조하신 거대한 드래곤 「두린」인가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140138
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140138,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140139
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140139,
					"content": "이 만남이, 과연 좋은 일인 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "알베도"
				},
				{
					"id": 412140132,
					"content": "넌 필요 없는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140120,
					"content": "아니",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140105,
					"content": "약속한 일 다 끝냈어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				}
			]
		}
	]
}