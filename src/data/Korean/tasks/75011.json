							8514.19
						],
						"pointId": 9103
					}
				]
			},
			"dialogs": [
				{
					"id": 750110501,
					"content": "수면이 조금 상승했고… 샘물에 열소가 가득 차 있네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110503
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110503,
					"content": "종아리까지 차오른 물이 아주 따뜻해서 온기가 몸을 타고 흘러들어오는 것이 느껴져. 모두 좋은 징조지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110504
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110504,
					"content": "그러니까 「불을 훔친 현자」의 선물은 「모든 상처를 치료하는 비약」이 아니라 여기 있는 온천이었던 거구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750110505,
					"content": "역시 샘물 무리 주변답게 결국 온천이랑 관련 있었네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750110506,
					"content": "꺄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110507
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110507,
					"content": "#호호, {REALNAME[ID(2)|SHOWHOST(true)]}은(는) 참 편안해 보이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110508
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110508,
					"content": "이건 평범한 온천이 아니야 붕붕 페이몬. 선택받은 용사가 이곳에서 온천욕을 하고 나오면 「열소 사용법」을 터득할 수 있다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110509
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110509,
					"content": "아, 그래? 그럼 내가 들어가면 어떻게 되는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110510
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750110510,
					"content": "음… 어디 보자, 축축한 페이몬으로 변할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110511
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110511,
					"content": "에이, 나도 열소 사용법을 배워서 엄청 강력한 불꽃 페이몬이 될 수 있을 줄 알았는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110512
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750110512,
					"content": "아마 안 될걸. 선택받지 못했으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110513
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110513,
					"content": "잠깐! 치키야, 넌 선물이 온천이라는 걸 알면서도 「모든 상처를 치료하는 비약」을 찾으면 우리한테 나눠주겠다고 한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110514
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750110514,
					"content": "헤헤, 세상엔 수많은 종류의 상처가 있는데, 비약 하나로 다 치료할 수 있을 리가 없잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110515
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110515,
					"content": "하지만 지혜는 모든 고민을 해결해 주지. 나한테 속았으니까, 이번 실수를 통해 교훈과 지혜를 얻으면 고민 해결에 한 발짝 더 다가가는 거야. 오히려 잘 된 것 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110516
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110516,
					"content": "그런 거였어? 음… 일리 있는 말이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110517,
						750110519
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750110517,
					"content": "그럼 당신의 상처는 나았나요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110518
					]
				},
				{
					"id": 750110518,
					"content": "아니, 내 마음은 아직도 다양한 상처 때문에 아파. 그런 점에 있어서 나도 나 자신한테 된통 속은 셈이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110520
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110520,
					"content": "열소로 가득 찬 온천에 있어도 열소를 사용할 수 없네. 고대 두루마리에 따르면 열소를 사용하지 못하는 부족 사람들은 시련을 통해서 열소 사용법을 터득했다고 하는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110521
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110521,
					"content": "쳇, 전혀 효과가 없잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110522
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110522,
					"content": "…어? 치키야는 나타 사람인데 열소를 사용할 수 없는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110523
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750110523,
					"content": "웅?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110524
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110524,
					"content": "페이몬 넌 정말 슬플 정도로 둔감하구나! 모든 나타 사람이 다 열소를 사용할 수 있는 게 아니야. 소수 사용할 수 없는 사람도 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110525
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110525,
					"content": "난 어렸을 때 심연 때문에 중상을 입었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110526
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110526,
					"content": "살아 있는 것 자체가 기적이지. 몸이 안 좋아서 명룡을 업고 뛸 수 있다는 것도 사실은 거짓말 아닌 거짓말이었어. 명룡은 가벼워서 무게가 없다시피 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110527
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110527,
					"content": "아마 그 상처 때문에 열소의 힘을 쓸 수 없는 걸지도 몰라. 그래서 온갖 두루마리를 찾아봐도 열소를 쓸 수 없었던 거겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110528
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110528,
					"content": "난 더 이상 아무도 연구하지 않는 「열소 각인」 문양 분석법을 능숙하게 익혔고, 그 뒤에 담긴 뜻을 기억하고자 애썼어. 덕분에 기억력이 좋아졌지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110529
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110529,
					"content": "부족 아이들에게 열소 계몽 교육을 시켜주는 것도 가까이서 열소를 사용하는 법을 깨닫게 된 아이들을 관찰하기 위함이었어. 그러고 보니 난 제법 아이들한테 인기가 있다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110530
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110530,
					"content": "아무튼 열소에 대해 알면 알수록 열소는 대단한 것이라고 느껴졌고 그럴수록 열소를 사용할 수 없다는 사실이 아쉽게 느껴지더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110531
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110531,
					"content": "#휴, 지금까지의 시련은 전부 {NICKNAME} 덕분에 통과한 거였지. 선조들이 그랬던 것처럼 기술을 배우려면 희생이 따른다는 것은 알아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110532
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110532,
					"content": "하지만 나한텐 그런 용기가 없었어. 아마도 그게 바로 내가 열소를 사용하지 못하는 이유가 아닐까? 하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110533
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110533,
					"content": "치키야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110534
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750110534,
					"content": "우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110535
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110535,
					"content": "괜찮아, 이미 오래전에 받아들였으니까. 이번에는 실패했으니까 다음에 또 시도해 보면 되지. 언젠간 방법을 찾을 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110536
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110536,
					"content": "#음, {NICKNAME}, 정말 정말 고마워. 앞날이 창창한 넌 정말 굳건하면서도 상냥하구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110537
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110537,
					"content": "#이 {M#누나}{F#언니}는 말이야, 인생이 곧 고정될 것 같아… 하지만 네 앞날에는 대단한 모험이 기다리고 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110538
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110538,
					"content": "좋겠다, 정말 부러운걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110539
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110539,
					"content": "#{NICKNAME}, 앞날이 창창한 학생, 앞으로의 여정이 순조롭기를 바랄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110540
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110540,
					"content": "당신도 조심하세요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110541
					]
				},
				{
					"id": 750110541,
					"content": "분명 소원을 이룰 수 있을 거예요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110542
					]
				},
				{
					"id": 750110542,
					"content": "「모든 상처를 치료하는 비약」은 없을지 모르지만 「너의 상처를 치료하는 비약」은 꼭 찾아낼 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110543
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750110543,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110544
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110544,
					"content": "#하하, 고마워. 페이몬, {NICKNAME}… 그리고 {REALNAME[ID(2)|SHOWHOST(true)]}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110545
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110545,
					"content": "#…음, {NICKNAME}, 네 말에 좀 감동했어. 정말이야. 넌 믿음직한 학생이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110546
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110546,
					"content": "자, 그럼 나는 여기서 좀 더 쉴게. 온천을 좀 즐기다가 두루마리에서 다른 방법을 찾아보지 뭐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110547
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110547,
					"content": "휴, 가출했다고 혼날지도 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110548
					],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110548,
					"content": "#하지만 {NICKNAME}, 네 말처럼 자신의 꿈을 이루기 위해서는 노력이 필요하겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "치키야"
				},
				{
					"id": 750110519,
					"content": "열소 사용법을 익혔나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110520
					]
				}
			]
		}
	]
}