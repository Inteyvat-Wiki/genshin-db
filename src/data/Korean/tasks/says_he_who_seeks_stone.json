					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740401,
					"content": "「노석」이 맞네, 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740402
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740402,
					"content": "당신들에게 의뢰한 건 정말 잘한 일이네. 모험가 길드에 의뢰했어도 이렇게 빨리 찾지는 못했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740403
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740403,
					"content": "그건 또 모르지, 모험가 길드도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710740404,
					"content": "우리에게 바로 의뢰를 넘겼을 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740405
					]
				},
				{
					"id": 710740405,
					"content": "그렇겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740406
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740406,
					"content": "음… 옛날에는 모험가가 부러웠어. 매일 이곳저곳에 돌아다니며 못 가는 곳이 없는 것처럼 보였거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740407
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740407,
					"content": "난 층암거연에 온 지 오래되었지만 층암거연의 가장 높은 곳… 아 그러니까 단사(丹砂) 절벽은 한 번도 가본 적이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740408
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740408,
					"content": "한 번도 가본 적이 없다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710740409,
					"content": "단사 절벽은, 음 어떻게 설명해야 하나, 「엄청 유명하지만 현지인들은 잘 안 가는 여행지」 같은 곳이랄까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740410
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740410,
					"content": "가까우니까 시간이 있으면 언젠가는 가겠지라는 생각을 하지만… 결국에는 한 번도 가 보지 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740411
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740411,
					"content": "그럼 지금 가보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740412
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710740412,
					"content": "가고 싶으면 가는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710740413,
					"content": "아냐 아냐, 아직은 「한가」하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740414
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740414,
					"content": "게다가 이곳저곳 돌아다니는 일 같은 건 모험가들에게 맡기면 되거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740415
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740415,
					"content": "모험가들이 가는 곳은 다 위험한 곳인데, 내가 갔다가 만약 다치기라도 한다면… 큰일이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740416
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740416,
					"content": "맞아, 다치면 큰일이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740417
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710740417,
					"content": "내가 다치면 탐사팀을 관리하고 광부들의 안전 검사를 책임지는 사람이 없어지거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740418
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740418,
					"content": "무슨 일이라도 생긴다면 엄청 심각한 문제로 번질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740419
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740419,
					"content": "그게 그렇게 심각한 일이었다니…. 난 그냥 다치는 게 무서워서 그러는 건 줄 알았는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740420
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710740420,
					"content": "층암거연 주변에 높은 절벽들과, 깊은 산골짜기… 그리고 암왕제군이 남긴 고대 전쟁터 모두 다 정말 위험한 곳이라서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740421
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740421,
					"content": "난 조금이라도 가까이 가기 싫어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740422
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740422,
					"content": "알았어, 이건 너희들이 찾은 노석에 대한 보상금이야. 휘산청이 노석에 대한 요구가 커서 만약 노석을 빨리 발견한다면 3개를 한 묶음으로 받을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740423
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740423,
					"content": "물론 그에 맞는 보수도 챙겨줄 거야, 노석을 찾으면 나에게 알려줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740424
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740424,
					"content": "알겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
