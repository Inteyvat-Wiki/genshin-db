				"points": []
			},
			"dialogs": [
				{
					"id": 710740801,
					"content": "저번 「노석」까지 합치면 총 9개니, 충분할 거 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740802
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740802,
					"content": "휘산청의 요구를 이렇게 빨리 충족시키다니…. 역시 대단하네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740803
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740803,
					"content": "우리에겐 섞은 죽 먹기인걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740804
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710740804,
					"content": "「식은 죽 먹기」겠지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740805
					]
				},
				{
					"id": 710740805,
					"content": "아! 그러니까… 음… 죽을 섞으면 식으니까, 그게 그 말이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740806
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710740806,
					"content": "페이몬 이제 억지도 부릴 줄 알고, 대단한걸?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740807
					]
				},
				{
					"id": 710740807,
					"content": "하하… 페이몬 말도 일리 있어. 두 사람이 힘을 합쳐 바다의 마수와 싸운 업적은 다 기억하고 있으니까. 이번 일도 그리 어렵지 않았을 거라 믿어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740808,
						710740809
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740808,
					"content": "그렇긴 하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740810
					]
				},
				{
					"id": 710740810,
					"content": "그나저나 총무부가 「암층에서 노석 찾는」 일을 담당하게 될 줄은 전혀 몰랐는걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740811
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740811,
					"content": "참, 예전에 맨날 아빠랑 싸웠다고 했잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740812
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710740812,
					"content": "근데 어쩌다가 총무부에 가게 된 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740813
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710740813,
					"content": "옛날에 엄청난 빚을 지고 궁지에 몰려서 가출했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740814
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740814,
					"content": "근데 채권자들이 성로청에 있는 아버지를 찾아갔다더라…. 그 말을 듣고 아버지가 절대 날 가만두지 않을 거라는 생각이 들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740815
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740815,
					"content": "근데 아무 일 없어 보이는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740816
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710740816,
					"content": "맞아… 말하기 부끄럽지만, 아버지가 대신 돈을 갚아주시고 길가에서 낙담하는 내게 「네 차용증은 지금 나한테 있으니, 넌 지금 나에게 빚진 거야」라고 하셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740817
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740817,
					"content": "그걸 빌미로 내게 강제로 일을 시키고… 돈을 갚으라고 한 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740818
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740818,
					"content": "그럼 지금 빚진 건 다 아빠의 돈이구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740819
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710740819,
					"content": "맞아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740820
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740820,
					"content": "물론 빚 독촉에 시달리던 난, 만약 기회가 생긴다면 개과천선할 거라고 일찌감치 결심을 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740821
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740821,
					"content": "하지만 그 기회를 매일 다투기만 했던 아버지가 내게 줄 거라곤 상상도 못 했지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740822
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740822,
					"content": "아버지는 처음으로 나와 싸우지 않고, 오히려 허심탄회하게 대화를 나눴어. 조금 더 일찍 그런 대화를 나누었으면 좋았을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740823
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740823,
					"content": "하지만 아버지는 줄곧 그러고 싶었을지 몰라도 그때의 나는 들을 기분 아니었을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740824
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740824,
					"content": "아버지가 너를 정말 아끼는 거 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740825
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710740825,
					"content": "맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740826
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740826,
					"content": "그래서 무슨 일이 있어도 지금 일을 잘해 내야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740827
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740827,
					"content": "층암에 관한 일이든지, 휘산청을 위해 「노석」을 찾는 심부름이든지 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740828
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740828,
					"content": "이번 일은 제가 해결한 거잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740829
					]
				},
				{
					"id": 710740829,
					"content": "의뢰를 맡기는 것도 일 처리 방법 중 하나잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740830
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740830,
					"content": "아무튼 당신 덕분에 정말 뜻밖에 일을 빨리 마칠 수 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740831
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710740831,
					"content": "알면 됐어~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710740809,
					"content": "어려움이라면 있었긴 하지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740810
					]
				}
			]
		}
	]
