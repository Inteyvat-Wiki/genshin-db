			"dialogs": [
				{
					"id": 3830201,
					"content": "유후——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3830202,
					"content": "「드발린 보호협회」! 재집결!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3830203,
					"content": "그럼 얼른 수집한 결정을 꺼내 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830204
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3830204,
					"content": "아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830205
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3830205,
					"content": "결정의 색이 더 혼탁해진 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830206
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3830206,
					"content": "드발린… 대체 어떤 고통을 참고 있는 거니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830207
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3830207,
					"content": "우선 결정들을 정화하자. 타향에서 온 여행자, 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830208
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3830208,
					"content": "직접 본 게 아니라면 믿지 못했을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830209
					],
					"speakerTitle": "진"
				},
				{
					"id": 3830209,
					"content": "재미있군. 술을 거를 때처럼 기분이 상쾌해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830210
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 3830210,
					"content": "눈물은 이 정도면 충분해. 그럼 이제…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "벤티"
				}
			]
		},
