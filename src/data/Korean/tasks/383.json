			"dialogs": [
				{
					"id": 3830401,
					"content": "됐어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3830402,
					"content": "느낌이 완전 달라졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830403
					],
					"speakerTitle": "진"
				},
				{
					"id": 3830403,
					"content": "바람 원소가… 가득 넘치고 있어. 이 정도면 충분해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830404
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3830404,
					"content": "#정말 고마워, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830405
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3830405,
					"content": "그러면 어디서 풍마룡을 불러내지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830406
					],
					"speakerTitle": "진"
				},
				{
					"id": 3830406,
					"content": "몬드성은 안 돼. 만약 실패하면 엄청난 피해를 볼 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830407
					],
					"speakerTitle": "진"
				},
				{
					"id": 3830407,
					"content": "이 와이너리에서 해도 분명…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830408
					],
					"speakerTitle": "진"
				},
				{
					"id": 3830408,
					"content": "아, 와이너리가 사라져도 큰 손해는 없겠지만, 피하는 게 좋지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830409
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 3830409,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830410
					],
					"speakerTitle": "진"
				},
				{
					"id": 3830410,
					"content": "바닷바람이나 높은 곳의 바람이라면 시인의 노랫소리를 더 멀리 퍼지게 해 줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830411
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3830411,
					"content": "건조하고 답답한 공기는 시인뿐만 아니라 드발린을 화나게 할 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830412
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3830412,
					"content": "그렇구나. 바닷바람이나 높은 곳의 바람, 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3830413,
					"content": "그렇다면 가장 좋은 장소는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830414,
						3830415,
						3830416
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3830414,
					"content": "절벽?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830418,
					"content": "별이 떨어지는 호수에서 동쪽으로 조금 가면, 해안의 남쪽에 산이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830419
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 3830419,
					"content": "…아! 저번에 네가 낮잠 잤던 그 해안 말하는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830420
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3830420,
					"content": "산을 따라 올라가면 <color=#00E1FFFF>별을 따는 절벽</color>이란 곳에 도착할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830421
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 3830421,
					"content": "네가 말하는 그런 곳은 거기에서 얼마든지 찾을 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830422
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 3830422,
					"content": "음, 별을 따는 절벽이란 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830423
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3830423,
					"content": "…확실히 괜찮은 장소야. 내 노랫소리에 딱 어울리겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830424
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3830424,
					"content": "좋아. 그럼 어서 준비해서 별을 따는 절벽에서 보자구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830425
					],
					"speakerTitle": "진"
				},
				{
					"id": 3830425,
					"content": "모두 중요한 일이라고 생각하고 늦지 않게 와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830426
					],
					"speakerTitle": "진"
				},
				{
					"id": 3830426,
					"content": "넵, 단장님!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830427
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3830427,
					"content": "앗… 미안해. 단장을 하던 버릇이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "진"
				},
				{
					"id": 3830415,
					"content": "해변?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830416,
					"content": "비행하면서 연주해야 하나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830417
					]
				},
				{
					"id": 3830417,
					"content": "그런 건 엠버도 못할걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830418
					],
					"speakerTitle": "진"
				}
			]
		}
	]
}