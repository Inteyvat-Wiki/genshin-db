				"points": []
			},
			"dialogs": [
				{
					"id": 20130101,
					"content": "잠깐! 「통행증」을 제시해주시죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130102
					],
					"speakerTitle": "코바야시"
				},
				{
					"id": 20130102,
					"content": "미안, 우린 급히 나루카미섬으로 가봐야 하는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20130103,
					"content": "「통행증」이 없으면 돌아가 주세요. 규칙입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130104
					],
					"speakerTitle": "코바야시"
				},
				{
					"id": 20130104,
					"content": "힝… 역시",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20130105,
					"content": "여행자, 방법을 생각해 봐! 이제 어떡하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130106,
						20130107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20130106,
					"content": "야시로 봉행 사람들이 우리에 대해 들었다면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				},
				{
					"id": 20130108,
					"content": "그러니까, 간조 봉행 가주를 직접 만나러 가자고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20130109,
					"content": "…부하들은 맘에 안 들지만, 만나보는 수밖에 없겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20130110,
					"content": "그 사람이 우리의 열혈팬일 수도 있잖아! 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20130107,
					"content": "간조 봉행에서도 들었겠지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				}
			]
		},
		{
			"id": 201302,
			"completionStepIds": [
				201302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
