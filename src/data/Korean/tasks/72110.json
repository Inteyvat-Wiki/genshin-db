			"trigger": {
				"objectNames": [
					"이와쿠라 코죠"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100101,
					"content": "나는 대체 왜 도관을 떠나 쿠죠 님의 검술 사범이 되었을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100102
					],
					"speakerTitle": "이와쿠라 코죠"
				},
				{
					"id": 721100102,
					"content": "야나기하와 오카자키, 그리고 미후네는… 또 왜 나를 떠났을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이와쿠라 코죠"
				}
			]
		},
		{
			"id": 7211002,
			"completionStepIds": [
				7211015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211007",
							"3"
						],
						"stepId": 7211007,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211015",
							"2"
						],
						"stepId": 7211015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"오카자키 토라에몬",
					"야나기하 아라시"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100201,
					"content": "…이제 이와쿠라 코우인의 검만 남았군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100202
					],
					"speakerTitle": "오카자키 토라에몬"
				},
				{
					"id": 721100202,
					"content": "이와쿠라 가문 대대로 전해지는 「하쿠엔 미치미츠 아메노마」 말인가. 당초 너와 쿠니히코가 막 입양됐을 때, 선대의 에이인 어르신이 눈치채지 못한 사이에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100203
					],
					"speakerTitle": "야나기하 아라시"
				},
				{
					"id": 721100203,
					"content": "우리는 「파문」 되었다. 어르신이라고 부를 필요 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100204
					],
					"speakerTitle": "오카자키 토라에몬"
				},
				{
					"id": 721100204,
					"content": "하지만, 오카자키…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100205
					],
					"speakerTitle": "야나기하 아라시"
				},
				{
					"id": 721100205,
					"content": "「진정한 검사는 『정』과 『의』 사이에서 『의』의 길을 걷는다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100206
					],
					"speakerTitle": "야나기하 아라시"
				},
				{
					"id": 721100206,
					"content": "사부님은 우리를 쫓아내고 싶지 않아서 이렇게 말씀하셨지만, 다른 선택지는 없었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100207
					],
					"speakerTitle": "야나기하 아라시"
				},
				{
					"id": 721100207,
					"content": "당연히 내키지 않으셨겠지. 하지만 사부님이 쇼군의 검이 되어 안수령을 시행하기로 한 이상, 우리는 할 수 없이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100208
					],
					"speakerTitle": "오카자키 토라에몬"
				},
				{
					"id": 721100208,
					"content": "우리도 자신의 도의를 선택할 수밖에 없었지. 「진정한 검사는 『의』의 길을 걷는다」는 말이 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100209
					],
					"speakerTitle": "야나기하 아라시"
				},
				{
					"id": 721100209,
					"content": "하지만 사부님의 도의도 결국 꺾여 버렸다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100210
					],
					"speakerTitle": "야나기하 아라시"
				},
				{
					"id": 721100210,
					"content": "맞아. 쿠니히코의 원한뿐만 아니라, 다른 사람의 원한, 이와쿠라 코우인의 원한까지 우리가 다 갚아야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100211
					],
					"speakerTitle": "오카자키 토라에몬"
				},
				{
					"id": 721100211,
					"content": "그것이 파문된 제자의 도의다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100212
					],
					"speakerTitle": "오카자키 토라에몬"
				},
				{
					"id": 721100212,
					"content": "첫 번째 원수는 제 발로 찾아오다니, 이것도 사부님의 가호가 아닐까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100213
					],
					"speakerTitle": "야나기하 아라시"
				},
				{
					"id": 721100213,
					"content": "#그렇겠지. {NICKNAME}, 네 이야기는 이미 들었다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100214
					],
					"speakerTitle": "오카자키 토라에몬"
				},
				{
					"id": 721100214,
					"content": "검사의 세계에서는 피로만 「피」를 깨끗이 씻을 수 있다. 이와쿠라류 「면허개전(免許皆傳)」을 상대할 준비는 다 되었겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "오카자키 토라에몬"
				}
			]
		},
