					"하팀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050201,
					"content": "음… 나쁘지 않군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050202
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230050202,
					"content": "돈을 많이 버신 모양이네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050203
					]
				},
				{
					"id": 230050203,
					"content": "오, 여행자! 자네 덕분에 수익이 좀 났어. 역시 「황금 요리」가 효과가 있었던 게지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050204
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230050204,
					"content": "하지만 많이 벌진 못했네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050205
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230050205,
					"content": "「황금 요리」를 먹었으니 더 많은 수익을 올려야 하는데. 혹시 요리 선택이 잘못된 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050206
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230050206,
					"content": "여행자, 다시 한번 해보자. 날 도와 「황금 요리」를 골라주렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050207
					],
					"speakerTitle": "하팀"
				},
				{
					"id": 230050207,
					"content": "룰은 똑같아. <color=#00E1FFFF>모라육</color>, <color=#00E1FFFF>버터 치킨</color> 그리고 <color=#00E1FFFF>「높이 쌓기」</color> 중에서 진짜 「황금 요리」를 골라주렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하팀"
				}
			]
		},
		{
			"id": 2300503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
