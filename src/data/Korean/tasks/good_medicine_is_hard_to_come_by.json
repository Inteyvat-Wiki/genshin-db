			"dialogs": [
				{
					"id": 230370801,
					"content": "여행자, 왔구나! 자카리야 선생님은 뭐라고 하셔?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370802
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230370802,
					"content": "자카리야의 처방전에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370803
					]
				},
				{
					"id": 230370803,
					"content": "전에 줬던 처방전을 베이스로 하라고? 그렇군… 좀 더 자세히 연구해 봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370804
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230370804,
					"content": "음? 이 처방전은… 자카리야 선생님은 여전히 악필이시라니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370805
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230370805,
					"content": "여행자, 자카리야 선생님이 약을 조제하는 방법과 필요한 약재에 대해 설명해 주셨지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370806
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230370806,
					"content": "한번 잘 떠올려 봐. 혹시 내가 실수하면 알려줘야 하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370807
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230370807,
					"content": "여기에 쓰여 있는 약재는… 윽… 뭐라고 쓴 건지 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370808,
						230370809,
						230370810
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230370808,
					"content": "별 버섯이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370811
					]
				},
				{
					"id": 230370811,
					"content": "약을 달일 때는 어떻게 해야 하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370812,
						230370813,
						230370814
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230370812,
					"content": "쭉 센 불에 달여야 해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370815
					]
				},
				{
					"id": 230370815,
					"content": "얼마나 달여야 해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370816,
						230370817,
						230370818
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230370816,
					"content": "약재가 위로 떠 오를 때까지요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370819
					]
				},
				{
					"id": 230370819,
					"content": "음, 알겠어. 그래도 혹시 모르니까 처방전을 한 번 더 확인해 보는 게 좋을 것 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230370820
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230370820,
					"content": "마루프가 약을 달이기 시작한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230370817,
					"content": "약재가 완전히 무를 때까지요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370819
					]
				},
				{
					"id": 230370818,
					"content": "탕약 색깔이 진해질 때까지요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370819
					]
				},
				{
					"id": 230370813,
					"content": "쭉 약불에 달여야 해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370815
					]
				},
				{
					"id": 230370814,
					"content": "먼저 센 불로 달이다 약불로 줄여야 해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230370815
					]
				},
				{
					"id": 230370809,
					"content": "적념과예요",
