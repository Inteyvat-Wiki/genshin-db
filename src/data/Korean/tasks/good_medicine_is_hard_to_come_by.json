			},
			"dialogs": [
				{
					"id": 230371001,
					"content": "여행자, 왔구나! 자카리야 선생님은 뭐라고 하셔?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230371002
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230371002,
					"content": "자카리야의 처방전에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230371003
					]
				},
				{
					"id": 230371003,
					"content": "전에 줬던 처방전을 베이스로 하라고? 그렇군… 좀 더 자세히 연구해 봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230371004
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230371004,
					"content": "음? 이 처방전은… 자카리야 선생님은 여전히 악필이시라니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230371005
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230371005,
					"content": "여행자, 자카리야 선생님이 약을 조제하는 방법과 필요한 약재에 대해 설명해 주셨지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230371006
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230371006,
					"content": "한번 잘 떠올려 봐. 혹시 내가 실수하면 알려줘야 하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230371007
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230371007,
					"content": "여기에 쓰여 있는 약재는… 윽… 뭐라고 쓴 건지 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230371008,
						230371009,
						230371010
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230371008,
					"content": "별 버섯이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230371011
					]
				},
				{
					"id": 230371011,
					"content": "약을 달일 때는 어떻게 해야 하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230371012,
						230371013,
						230371014
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230371012,
					"content": "쭉 센 불에 달여야 해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230371015
					]
				},
				{
					"id": 230371015,
					"content": "얼마나 달여야 해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230371016,
						230371017,
						230371018
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230371016,
					"content": "약재가 위로 떠 오를 때까지요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230371019
					]
				},
				{
					"id": 230371019,
					"content": "음, 알겠어. 그래도 혹시 모르니까 처방전을 한 번 더 확인해 보는 게 좋을 것 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230371020
					],
					"speakerTitle": "마루프"
				},
				{
					"id": 230371020,
					"content": "마루프가 약을 달이기 시작한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230371017,
					"content": "약재가 완전히 무를 때까지요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230371019
					]
				},
				{
					"id": 230371018,
					"content": "탕약 색깔이 진해질 때까지요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230371019
					]
				},
				{
					"id": 230371013,
					"content": "쭉 약불에 달여야 해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230371015
					]
				},
				{
					"id": 230371014,
					"content": "먼저 센 불로 달이다 약불로 줄여야 해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230371015
					]
				},
				{
					"id": 230371009,
					"content": "적념과예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230371011
					]
				},
				{
					"id": 230371010,
					"content": "민트예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230371011
					]
				}
			]
		},
