						],
						"pointId": 9634
					}
				]
			},
			"dialogs": [
				{
					"id": 750790301,
					"content": "환영해…. 음, 너희 중 적어도 한 명은 비행의 요령을 깨우쳤나 보네. 그럼 이 꼬마 친구가 비행 기술을 배우고 싶은 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790302,
						750790304
					],
					"speakerTitle": "테마치"
				},
				{
					"id": 750790302,
					"content": "전 이미 비행 허가증이 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790303
					]
				},
				{
					"id": 750790303,
					"content": "비행 허가증? 그것참 신선한 단어네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790305
					],
					"speakerTitle": "테마치"
				},
				{
					"id": 750790305,
					"content": "여긴 사람과 용이 함께 성장하는 곳이야. 네 동료는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790306
					],
					"speakerTitle": "테마치"
				},
				{
					"id": 750790306,
					"content": "웅, 꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790307
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790307,
					"content": "…음, 꼬마야, 파파카 비행 학교는 네 실력을 뽐낼 수 있는 곳이 아닌 것 같아. 너무 개의치는 마, 이건 당연히 네 문제가 아니니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790308
					],
					"speakerTitle": "테마치"
				},
				{
					"id": 750790308,
					"content": "우웅?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790309,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}은(는) 아직 어리니까 잠재력이 많아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790310
					]
				},
				{
					"id": 750790310,
					"content": "산룡의 잠재력이 아무리 좋아도 깃룡이랑 명룡 같은 비행 능력이 생기겠냐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750790311,
					"content": "어쨌든, 꼬마 친구가 우리 비행 훈련에 관심이 있다면 개방된 훈련 코스를 체험해 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790313
					],
					"speakerTitle": "테마치"
				},
				{
					"id": 750790313,
					"content": "장애물을 피하거나 민첩하게 방향을 바꾸는 것 모두 깃룡을 다루는 데 필요한 기술이야. 얼마나 실력이 있는지는 훈련 코스에서 확인해 보면 알겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790312
					],
					"speakerTitle": "테마치"
				},
				{
					"id": 750790312,
					"content": "솔직히 홍보를 위해서 우리도 많은 노력을 했거든. 상품을 준비하고 대회도 준비했지. 혹시 꼬마 친구가 순조롭게 통과하면 라미자나한테 가서 상을 받아 가도록 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "테마치"
				},
				{
					"id": 750790304,
					"content": "저한테 뭘 가르쳐줄 수 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790305
					]
				}
			]
		},
