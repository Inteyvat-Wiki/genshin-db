			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"상구야"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160301,
					"content": "긴장감 넘치는 열혈 전투요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160302
					]
				},
				{
					"id": 221160302,
					"content": "열혈 전투… 열혈 전투라, 음… 일리 있군, 이목을 집중시킬 수 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160303
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 221160303,
					"content": "하지만 이 경책 산장엔 「긴장감 넘치는 열혈 전투」는 고사하고 「전투」도 없는 걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160304
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 221160304,
					"content": "소재를 찾으러 가봐야겠군. 참! 야외엔 모험가들이 많다고 들었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160305
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 221160305,
					"content": "그들은 보물을 찾기 위해 여기저기 뛰어다니고 야외에 있는 몬스터들과도 자주 싸운다던대…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160306
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 221160306,
					"content": "마침 몬스터가 많은 곳을 알고 있어. 거기라면… 그럴싸해. 모험가가 와서 몬스터와 제대로 붙을 때까지 거기서 기다려보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160307
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 221160307,
					"content": "헤헤, 그럼 소재를 수집할 수 있잖아? 좋아, 거긴 좀 머니까… 내가 먼저 갈 테니 너희도 빨리 따라와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "상구야"
				}
			]
		},
		{
			"id": 2211605,
			"completionStepIds": [
				2211608
			],
