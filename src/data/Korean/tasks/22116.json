			"dialogs": [
				{
					"id": 221160201,
					"content": "안목이요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160202
					]
				},
				{
					"id": 221160202,
					"content": "자, 장난치지 말고. 나 지금 진지하단 말이야. 한번 잘 생각해봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "상구야"
				}
			]
		},
		{
			"id": 2211603,
			"completionStepIds": [
				2211601,
				2211602
			],
