						221161003
					],
					"speakerTitle": "기명"
				},
				{
					"id": 221161003,
					"content": "에? 아직 아무 말도 안 했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161004
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221161004,
					"content": "할 필요 없어. 무슨 말인지 알고 있으니까. 오늘은 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161005
					],
					"speakerTitle": "기명"
				},
				{
					"id": 221161005,
					"content": "그럼 언제가 좋을까요? 기명 누님, 아니면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161006
					],
					"speakerTitle": "지화"
				},
				{
					"id": 221161006,
					"content": "응. 때가 되면 자연스럽게 그런 날이 오겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161007
					],
					"speakerTitle": "기명"
				},
				{
					"id": 221161007,
					"content": "그럼 말하지 않은 거나 마찬가지잖아요! 기명 누님, 그러지 말고 내 말 좀 들어봐요…",
