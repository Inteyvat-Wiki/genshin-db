			},
			"dialogs": [
				{
					"id": 221161201,
					"content": "룰루, 이번엔 정말 아비가 선장할 차례야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161202
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 221161202,
					"content": "맞아, 몇 번이나 말했는데. 나한텐 항상 종업원 역할만 시키고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161203
					],
					"speakerTitle": "아비"
				},
				{
					"id": 221161203,
					"content": "하지만 소몽이 선장할 때가 제일 재밌는걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161204
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 221161204,
					"content": "룰루, 그렇게 말하면 안 되지. 아비도 잘하잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161205
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 221161205,
					"content": "맞아. 그러니까 네가 선장이고, 내가 돈 많은 상인이고 아비가 종업원일 때 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161206
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 221161206,
					"content": "이렇게 할 때가 제일 재밌잖아, 안 그래, 아비?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161207
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 221161207,
					"content": "룰루, 너…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161208
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 221161208,
					"content": "룰루가 이렇게까지 말한다면 뭐, 어… 어쩔 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161209
					],
					"speakerTitle": "아비"
				},
				{
					"id": 221161209,
					"content": "아비, 너 또…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161210
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 221161210,
					"content": "괜찮아! 괜찮다니까, 룰루가 좋으면 됐어, 그럼 계속하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161211
					],
					"speakerTitle": "아비"
				},
				{
					"id": 221161211,
					"content": "선장 따위 누가 하고 싶다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161212
					],
					"speakerTitle": "아비"
				},
				{
					"id": 221161212,
					"content": "…너희들, 휴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소몽"
				}
			]
