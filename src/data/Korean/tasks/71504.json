					"호세이니"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715040101,
					"content": "쿨럭쿨럭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040102
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715040102,
					"content": "호세이니, 왜 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715040103,
					"content": "아까 「푸르시나 볼트」를 지맥 분출구로 옮길 방법을 생각하느라 갱도 쪽에 너무 오래 머물러 있었나? 그래서인지 약간 영향을 받은 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040104
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715040104,
					"content": "하지만 별 탈 없을 거야. 좀 쉬었더니 많이 좋아졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040105
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715040105,
					"content": "그러면서 해결책을 생각해 봤는데 답이 나왔어. 고작 「푸르시나 볼트」를 옮길 방법을 찾는 게 연구 보고서 제출을 미룰 핑계를 찾는 것보다 더 어려울 리가 없잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040106
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715040106,
					"content": "검은 진흙이 갱도 지면을 뒤덮었으면 열기구를 이용해 장치를 살짝 띄워서 운반하면 되잖아. 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040107
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715040107,
					"content": "그러고 보니 열기구가 좋은 대안인 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715040108,
					"content": "물론 이러면 검은 진흙 문제는 어느 정도 해결되겠지만 통로가 대량의 검은 진흙에 막혀버린 경우라면 열기구의 이동이 영향을 받을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040109
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715040109,
					"content": "그리고 검은 진흙 주변에는 이끌려온 몬스터들이 있을 테고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040110
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715040110,
					"content": "이건 너희한테 부탁할 수밖에 없겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040111
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715040111,
					"content": "#안심해, 나와 {NICKNAME}이(가) 손을 잡으면 어떤 몬스터도 열기구에 다가오지 못할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040112,
						715040113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715040112,
					"content": "너만 믿어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				},
				{
					"id": 715040114,
					"content": "나, 난 응원 담당이라구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715040115,
					"content": "하하하, 켁! 켁… 쿨럭쿨럭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040116
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715040116,
					"content": "살짝 웃었더니 이 몹쓸 기침이… 아무튼 도 씨와 지호는 「푸르시나 볼트」를 포장하며 열기구를 준비하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040117
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715040117,
					"content": "원래는 내가 직접 「푸르시나 볼트」를 포장하려 했는데, 조금만 서있어도 몹쓸 기침 때문에 손이 부들부들 떨려서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040118
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715040118,
					"content": "정말 부끄럽네. 앞으로 학술 연구뿐만 아니라 운동에도 신경을 써야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715040119
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715040119,
					"content": "서둘러 그들에게 가줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715040113,
					"content": "이 검을 잠시 빌려줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715040114
					]
				}
			]
		},
