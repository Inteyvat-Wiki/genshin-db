			"dialogs": [
				{
					"id": 3090201,
					"content": "휴… 드디어 다 끝냈네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3090202,
					"content": "이러면 몬드성의 원소 흐름과 지맥 순환도 다 정상으로 회복되겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3090203,
					"content": "<color=#00E1FFFF>기사단</color>에 한번 들러볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3090204,
					"content": "당연히 다른 곳에 관심이 있다면 함께 가줄 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3090205,
					"content": "몬드에서 쇼핑… 아니면 같이 <color=#00E1FFFF>일곱신상</color>을 보러 갈래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3090206,
					"content": "아까 바람 사신수의 사당에서 굳어버린 바람 같은 걸 얻은 걸 기억해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3090207,
					"content": "몬드의 사람들은 그걸 「바람 신의 눈동자」라고 불러",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3090208,
					"content": "이름이 말해주듯이 신상의 눈에 상감될 자격이 있는 물건이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3090209,
					"content": "동화 속에서는 제비가 눈에 박혀있던 보석을 물어갔다고 전해지지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3090210,
					"content": "사실 「바람 신의 눈동자」는 실체가 없는 존재야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3090212,
					"content": "「신의 눈」을 갖고 있는 사람들은 그걸 <color=#00E1FFFF>일곱신상</color>에 바쳐 복을 빌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3090213,
					"content": "넌 「신의 눈」을 가지고 있지 않지만 이 세계의 상식을 벗어나는 존재니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3090214,
					"content": "한번 시도해 보고 싶다면 이제 출발하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3090215,
					"content": "저기 바람이 시작되는 곳에 있는 일곱신상이 우리와 가장 가까운 신상일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3090216,
					"content": "이번에… 신명이 어떻게 응답해 줄지 정말 기대되는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
