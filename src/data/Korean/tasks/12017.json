			},
			"dialogs": [
				{
					"id": 120170201,
					"content": "그래서, 지금은 뭘 하려는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170202
					],
					"speakerTitle": "에이(影)"
				},
				{
					"id": 120170202,
					"content": "사진을 남겨줄게. 자세한 건 우리한테 맡기고, 넌 저쪽에 서서 포즈만 취하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120170203,
					"content": "쉽게 말해서 사진은 지금 이 순간의 널 기록해두는 거야. 기념으로 딱이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120170204,
					"content": "포즈를 취한다는 건 또 무슨 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170205
					],
					"speakerTitle": "에이(影)"
				},
				{
					"id": 120170205,
					"content": "화면을 기록해야 하거든요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170206
					]
				},
				{
					"id": 120170206,
					"content": "그렇군. 그러니까 너희를 향해 멋진 자세를 취하면 되는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170207
					],
					"speakerTitle": "에이(影)"
				},
				{
					"id": 120170207,
					"content": "생각해 보니 좀 민망하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "에이(影)"
				},
				{
					"id": 120170208,
					"content": "어떤 포즈가 좋을지 의견 좀 내줘. 멋지지만 너무 과하진 않게. 민망해서 잘 못할 거 같거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170209,
						120170211,
						120170213
					],
					"speakerTitle": "에이(影)"
				},
				{
					"id": 120170209,
					"content": "단정한 자세를 취해봐요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170210
					]
				},
				{
					"id": 120170210,
					"content": "그럼… 이렇게 할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "에이(影)"
				},
				{
					"id": 120170215,
					"content": "이렇게 하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170218
					]
				},
				{
					"id": 120170218,
					"content": "좋아, 그럼 시작하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170219
					],
					"speakerTitle": "에이(影)"
				},
				{
					"id": 120170219,
					"content": "좋은 각도에서 찍어주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120170216,
					"content": "다른 것도 시도해보죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170217
					]
				},
				{
					"id": 120170217,
					"content": "그래, 너한테 맡길게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "에이(影)"
				},
				{
					"id": 120170211,
					"content": "근엄한 자세를 취해봐요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170212
					]
				},
				{
					"id": 120170212,
					"content": "적응이 안 되네, 이렇게?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "에이(影)"
				},
				{
					"id": 120170213,
					"content": "아무렇게나 편안한 자세를 취해봐요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170214
					]
				},
				{
					"id": 120170214,
					"content": "아무렇게나? 그럼 이렇게 할게. 편하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "에이(影)"
				}
			]
		},
