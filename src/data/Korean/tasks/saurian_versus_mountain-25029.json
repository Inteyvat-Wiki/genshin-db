					"content": "같이 힘내자!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290206
					]
				},
				{
					"id": 250290206,
					"content": "#어? {M#형아}{F#누나} 안녕! 우리 등반 훈련 중이야",
					"roleType": "TALK_ROLE_NPC",
