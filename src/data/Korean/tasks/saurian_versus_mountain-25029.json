					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290218
					]
				},
				{
					"id": 250290218,
					"content": "#고마워! 이번엔 {M#형아}{F#누나}의 동작을 확실하게 볼 수 있겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290219
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250290219,
					"content": "치카, 너도 눈 크게 뜨고 잘 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290220
					],
					"speakerTitle": "틀라터"
				},
