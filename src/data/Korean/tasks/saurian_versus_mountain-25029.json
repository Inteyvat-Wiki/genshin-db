					"id": 250290220,
					"content": "꺄우!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "치카"
				},
				{
					"id": 250290223,
					"content": "#그럼 부탁할게, {M#형아}{F#누나}",
