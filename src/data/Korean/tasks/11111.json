			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"맹우"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110101,
					"content": "맹우 씨, 저 왔어요! 아쉽지만 대범 씨는 못 찾았어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110102
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110102,
					"content": "그렇군요. 일이 복잡해졌네요. 짐작 가는 곳은 다 찾아봤는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110103
					],
					"speakerTitle": "맹우"
				},
				{
					"id": 111110103,
					"content": "대범 씨가 도대체 누구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111110104,
					"content": "역시 처음부터 설명해 줄게. 내 고향은 무망의 언덕 근처야. 어릴 적 함께 놀던 친구 몇 명이 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110105
					],
					"speakerTitle": "맹우"
				},
				{
					"id": 111110105,
					"content": "대범이는 그중 하나야. 나랑 정말 친해서 그림자처럼 붙어 다녔지만, 어느 날 불의의 사고로 세상을 떠났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110106
					],
					"speakerTitle": "맹우"
				},
				{
					"id": 111110106,
					"content": "그 일이 도저히 잊혀지지가 않더라. 아마 내가 미련 많은 사람이라 그렇겠지. 그래서 지금도 자주 무망의 언덕을 돌아보곤 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110107
					],
					"speakerTitle": "맹우"
				},
				{
					"id": 111110107,
					"content": "그러다가 얼마 전 무망의 언덕을 다녀온 뒤부터 상태가 이상해지더니 매일 밤 꿈에 대범이가 나오더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110108
					],
					"speakerTitle": "맹우"
				},
				{
					"id": 111110108,
					"content": "혹시나 내가 그를 깨운 게 아닌가 싶었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110109,
						111110110
					],
					"speakerTitle": "맹우"
				},
				{
					"id": 111110109,
					"content": "판타지 소설 같네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110111
					]
				},
				{
					"id": 111110111,
					"content": "글쎄, 증거는 없지만, 도저히 마음이 안 놓여. 생각할수록 걱정돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110112
					],
					"speakerTitle": "맹우"
				},
				{
					"id": 111110112,
					"content": "어릴 적 친구가 악귀가 됐을지도 모르는데, 어떻게 마음이 편하겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110113
					],
					"speakerTitle": "맹우"
				},
				{
					"id": 111110113,
					"content": "그래서 맹우 씨가 왕생당에 들어온 거야. 내가 이 일을 도와주고 있어서 그에게 보수를 챙겨줄 필요도 없고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110114
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110114,
					"content": "맹우 씨 말도 불가능한 건 아니야. 가끔 현세를 떠도는 귀신이 있는 게 사실이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110115
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110115,
					"content": "하지만 악귀 같은 건 혼자 지레 겁먹어서 그렇게 느끼는 경우가 많아. 나도 거의 본 적 없거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110116
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110116,
					"content": "그렇다고 대범이가 안 위험하다고 장담할 순 없죠. 그가 사람을 해치는 모습은 보고 싶지 않아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110117
					],
					"speakerTitle": "맹우"
				},
				{
					"id": 111110117,
					"content": "봐봐, 이렇다니까. 대범 씨를 못 찾으면 내가 무슨 말을 해도 맹우 씨는 믿지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110118
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110118,
					"content": "아까 우리가 찾아간 그 사람들도 맹우 씨의 어릴 적 친구들이야. 대범 씨가 거기 숨어있을 줄 알았는데 전부 허탕이었지 뭐야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110119
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110119,
					"content": "무망의 언덕에도 가보고 예전 친구들도 찾아가 봤지만 더 이상 단서가 없네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110120
					],
					"speakerTitle": "맹우"
				},
				{
					"id": 111110120,
					"content": "실례합니다. 혹시 왕생당 분들이신가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110121
					],
					"speakerTitle": "낙성"
				},
				{
					"id": 111110121,
					"content": "저는 낙성이에요. 요즘 찝찝한 기분이 들고 뭔가가 저를 쳐다보고 있는 것 같아서요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110122
					],
					"speakerTitle": "낙성"
				},
				{
					"id": 111110122,
					"content": "며칠 전, 친구와 담력 시험을 한다고 무망의 언덕에 갔는데 돌아온 뒤부터 몸이 아프더니 매일 악몽을 꾸고 의사를 찾아가도 아무런 이상 없대요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110123
					],
					"speakerTitle": "낙성"
				},
				{
					"id": 111110123,
					"content": "저주에 걸린 게 틀림없어요! 마신의 저주 말이에요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110124
					],
					"speakerTitle": "낙성"
				},
				{
					"id": 111110124,
					"content": "네네네, 맞아요. 마신의 저주, 정말 무서운 거죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110125
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110125,
					"content": "그쵸! 바로 그거예요. 전설에 의하면 마신 전쟁에서 죽은 마신이 이 세상에 고통의 저주를 내렸다고 하잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110126
					],
					"speakerTitle": "낙성"
				},
				{
					"id": 111110126,
					"content": "그 저주를 풀지 못하면 장기가 타들어 가고 온몸이 갈기갈기 찢겨 처참히 죽고 말 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110127
					],
					"speakerTitle": "낙성"
				},
				{
					"id": 111110127,
					"content": "전설 속 그 저주의 증상이 저한테 똑같이 나타나고 있다고요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110128
					],
					"speakerTitle": "낙성"
				},
				{
					"id": 111110128,
					"content": "무망의 언덕, 저주…. 아니, 그건 저주가 아닐 거예요. 아마 대범이가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110129
					],
					"speakerTitle": "맹우"
				},
				{
					"id": 111110129,
					"content": "휴, 잠시만요. 두 분 다 자기 할 말만 하고 있잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110130
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110130,
					"content": "맨날 자기 할 말만 하는 게 누구더라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111110131,
					"content": "귀신과 마신 관련된 일은 왕생당 전문이잖아요! 제발 저 좀 도와주세요! 아직 죽기 싫다구요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110132
					],
					"speakerTitle": "낙성"
				},
				{
					"id": 111110132,
					"content": "제대로 찾아오셨네요. 문제없죠, 제게 맡기세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110133
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110133,
					"content": "하지만 저주를 풀기 위해선 적당한 장소가 필요해요. 미리 준비도 해야 하고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110134
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110134,
					"content": "네 도움이 필요해, 신입. 나랑 같이 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110135
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110135,
					"content": "그, 그럼 저도 같이 가죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110136
					],
					"speakerTitle": "맹우"
				},
				{
					"id": 111110136,
					"content": "맹우 씨는 먼저 저분을 도와 준비해주세요. 제가 알려드렸던 향을 피워서 귀신을 쫓는 거 말이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110137
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110137,
					"content": "준비가 끝나면 제게 말씀해주세요. 대범 씨 일은 이 일이 끝나면 다시 얘기하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110138
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110138,
					"content": "알겠습니다. 어쩔 수 없죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110139
					],
					"speakerTitle": "맹우"
				},
				{
					"id": 111110139,
					"content": "그럼, 우린 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호두"
				},
				{
					"id": 111110110,
					"content": "말도 안 돼요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110111
					]
				}
			]
		},
		{
			"id": 1111102,
			"completionStepIds": [
				1111102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111102",
							"2"
						],
						"stepId": 1111102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111110201,
					"content": "그래서, 이렇게 비밀스럽게 도대체 뭘 하려는 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111110202,
					"content": "아무것도 안 하고 그냥 여기서 기다릴 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110203
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110203,
					"content": "뭐?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111110204,
					"content": "마신의 저주니 뭐니 그런 걸 진짜로 믿는 건 아니겠지? 그런 건 진작에 다 없어졌다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110205
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110205,
					"content": "그럼 왜 여기로 온 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110206
					]
				},
				{
					"id": 111110206,
					"content": "그 두 사람 봤지? 한 명은 자신이 저주에 걸린 줄 알고, 한 명은 친구가 악귀로 변했다고 믿잖아. 사람이 하는 말은 제대로 듣지도 않고 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110207
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110207,
					"content": "휴, 그래서 내가 평범한 사람들은 모르는 게 약이라고 하는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110208
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110208,
					"content": "이런 일로 마음을 못 추스르는 사람을 너무 많이 봤어. 진정시키려면 뭔가 믿을만한 걸 보여줘야 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110209
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110209,
					"content": "귀신을 믿는 사람들은 보는 앞에서 귀신을 없애줘야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110210
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110210,
					"content": "흠… 뭔가 세 살짜리 아기를 달래는 느낌인데…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110211,
						111110213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111110211,
					"content": "그래도 알려주는 게 좋지 않을까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110212
					]
				},
				{
					"id": 111110212,
					"content": "맞아! 몰라서 더 무서운 걸지도 모르잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111110216,
					"content": "그건 무지한 사람에게 진실을 알려줘서 상황이 더 나아질 거란 보장이 없기 때문이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110217
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110217,
					"content": "생사의 「경계」 가까이에 멀쩡한 사람이 있다면 난 그들을 돌려보내야 해. 기분 탓인 거면 그냥 그렇게 믿게 하는 게 최선이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110218
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110218,
					"content": "일리 있네…. 그럼, 저주에 대해선 어떻게 설명할 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111110219,
					"content": "음~ 너희 혹시 「야차」의 역사에 대해 들어봤어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110220,
						111110221
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110220,
					"content": "아니",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110222
					]
				},
				{
					"id": 111110222,
					"content": "그들은 예전에 마신과 사방이 캄캄해지도록 치열하게 싸웠어. 결국 마신을 무찌르긴 했지만, 그 원한은 오래도록 사라지지 않았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110223
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110223,
					"content": "원한은 역병이 되어 인간들 사이로 퍼져나갔고 공포에 떨던 사람들은 그게 「마신의 저주」라고 생각했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110224
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110224,
					"content": "역병은 수많은 목숨을 앗아갔고, 그로 인해 죽은 사람들이 또 온상이 되어 계속해서 퍼졌지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110225
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110225,
					"content": "나중에 그 역병을 막는 방법이 발견됐는데 공기를 정화하고 시신을 태우는 거였어. 그걸 처음으로 시작한 사람이 바로 「왕생당」의 초대 당주셨고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110226
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110226,
					"content": "그, 그런 거였어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110227
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111110227,
					"content": "응, 그 뒤로 몇 년이 흘렀고, 그 역병은 완전히 박멸됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110228
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110228,
					"content": "예로부터 「왕생당」은 비슷한 사건을 수도 없이 처리했어. 그 결과, 리월은 항상 생과 사의 균형을 유지할 수 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110229
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110229,
					"content": "간단히 말해 우린 「문지기」 같은 존재야. 살아있는 사람뿐만 아니라 사람이 아닌 것들의 문도 지키지, 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110230,
						111110231
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110230,
					"content": "「생사의 경계」를 지키는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110232
					]
				},
				{
					"id": 111110232,
					"content": "그래서 「저주」가 착각일 뿐이란 걸 누구보다 잘 알고 있어. 하지만 이런 일이 있었다고 사람들에게 알릴 수는 없는 노릇이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110233
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110233,
					"content": "일단 기다려보자. 조금 있다가 이 지맥 제압석으로 재밌는 거 보여줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110234
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110234,
					"content": "오셨군요! 저희도 방금 막 준비를 마쳤어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110235
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110235,
					"content": "이게 바로 귀신을 쫓는 특수 장치입니다. 이걸로 손님 몸에 있는 저주를 끌어내고 형상화할 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110236
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110236,
					"content": "걱정 마세요. 전투 경험이 많은 이 여행자가 있는 한 위험한 일은 없을 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110237,
						111110238
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110237,
					"content": "왜 귀찮은 일은 항상 나야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110239
					]
				},
				{
					"id": 111110239,
					"content": "아앗, 맞다. 말하는 걸 깜빡했네, 후후. 뭐, 상관없잖아~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110240
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110240,
					"content": "정말 문제없는 겁니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110241
					],
					"speakerTitle": "낙성"
				},
				{
					"id": 111110241,
					"content": "당주를 믿어보세요. 좀 이상해 보이긴 해도 일할 때만큼은 진지하답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110242
					],
					"speakerTitle": "맹우"
				},
				{
					"id": 111110242,
					"content": "저기요, 이상하다뇨! '천진난만하고 자유로운' 같은 좋은 단어 많잖아요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110243
					],
					"speakerTitle": "호두"
				},
				{
					"id": 111110243,
					"content": "아무튼 빨리빨리 시작하자구요! 그럼 신입, 가서 장치를 가동시켜 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호두"
				},
				{
					"id": 111110238,
					"content": "싸워야 한다는 말은 없었잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110239
					]
				},
				{
					"id": 111110231,
					"content": "역사가 그렇게 깊을 줄 몰랐네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110232
					]
				},
				{
					"id": 111110221,
					"content": "조금",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110222
					]
				},
				{
					"id": 111110213,
					"content": "페이몬은 몇 살이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111110214
					]
				},
				{
					"id": 111110214,
					"content": "갑자기 그런 걸 왜 물어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111110215,
					"content": "나는 왜 진실을 말해줄 수 없는지가 더 궁금하다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111110216
					],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 1111103,
			"completionStepIds": [],
