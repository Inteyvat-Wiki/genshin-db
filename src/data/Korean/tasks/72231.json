				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722310101,
					"content": "대리 궁사님이 그렇게 좋아하는 걸 보니 정말 소중한 사람인가 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310102
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 722310102,
					"content": "근데 어디 있는지 아무도 몰라요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7223102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223101",
							"2"
						],
						"stepId": 7223101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"에츠코",
					"타이유"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722310201,
					"content": "역시 「히비키」… 「아사세 신사」 그리고 「도메키」 모두 신경이 좀 쓰이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310202,
						722310207
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310202,
					"content": "갑자기 어디서 나타난 거예요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310203
					]
				},
				{
					"id": 722310203,
					"content": "섬이 갑자기 시끄러워졌는데 당연히 와봐야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310204
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310204,
					"content": "이 일은 꼭 알려줘야 할 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310205
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310205,
					"content": "타이유, 네가 설명해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310206
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310206,
					"content": "아… 알겠어요, 에츠코 씨. 사실은… 세이라이섬에 관한 이야기예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310208
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722310208,
					"content": "세이라이섬의 역사는 정말 오래되었죠, 길드에서 자료를 찾아봤지만, 쓸모 있는 정보는 찾지 못했어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310209
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722310209,
					"content": "길드에서 받은 자료에는 몇백 년 전 이곳은 「해적」의 집결지였다고 해요. 당시에 막부에서 직접 나서서 모든 해적을 소탕하고 섬에 있는 주민들을 다른 곳으로 이주시켰다고 해요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310210
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722310210,
					"content": "그 「도메키」라는 사람, 이변이 없는 한, 막부가 해적을 소탕할 당시의 해적 두목 「아코 도메키」일 거예요. 공문에 그의 이름이 기록되어 있거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310211
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722310211,
					"content": "길드에서 제공한 자료를 보면 「아코 도메키」가 해적 함대를 지휘하고, 막부와 해상 전쟁을 일으켰어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310212
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722310212,
					"content": "그가 이끌던 함대는 막부에 의해 제압되고 어쩔 수 없이 세이라이섬으로 도망쳤죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310213
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722310213,
					"content": "막부가 그를 추격할 때 세이라이섬에서 갑자기 뇌폭이 몰아치기 시작했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310214
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722310214,
					"content": "아코 도메키의 함대와 막부의 함대가 같이 번개에 맞았고… 그 뒤로 행방불명 되었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310215
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722310215,
					"content": "뇌폭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310216
					]
				},
				{
					"id": 722310216,
					"content": "그다음은 내가 말할게… 여기서 제일 큰 의문점은 갑작스러운 뇌폭이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310217
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310217,
					"content": "아코 도메키의 함대도 번개에 맞아서 거의 전멸했지만… 막부 함대도 거의 전멸 위기에 놓여 어쩔 수 없이 세이라이섬으로 물러나고 재정비의 시간을 가졌지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310218
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310218,
					"content": "그 뇌폭이 나타난 시기, 나타난 위치가 정말…누군가 조종한 것처럼 꼭 들어맞았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310219
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310219,
					"content": "봉인이 해제되어 있는 「제압석」들을 기억하고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310220
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310220,
					"content": "그리고, 「제압석」을 봉인한 후 뇌폭도 잠잠해진 것도",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310221
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310221,
					"content": "함부로 판단하면 안 되지만… 이 모든 것이 다 연관되어 있다고 생각해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310222
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310222,
					"content": "아니면, 네코 님에게 직접 물어보면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310223
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722310223,
					"content": "…됐어. 도메키가 실종되었다고 기록되었지만 그 번개를 맞았다면 아마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310224
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310224,
					"content": "우린 계속 이 섬에 남아 탐사하면서 이 일에 관한 단서도 수집하고 어느 정도 정리되면 길드에 돌아가서 보고할 생각이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310225
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310225,
					"content": "하하, 여행자, 아마 앞으로 자주 볼 수도 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310226
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310226,
					"content": "그때도 잘 부탁드려요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310227
					]
				},
				{
					"id": 722310227,
					"content": "우리도 잘 부탁해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310228
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310228,
					"content": "타이유, 탐사 계획서를 작성하러 갈 준비하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310229
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310229,
					"content": "음… 에츠코 씨, 그럼 네코 님은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310230
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722310230,
					"content": "하던 대로 똑같이 지내면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310231
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310231,
					"content": "하지 않아도 될 말만 조심하면 돼. 꼭 기억해둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310232
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310232,
					"content": "지금은… 기분이 좋을 텐데, 분위기 깨는 말 하지 말자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310233
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310233,
					"content": "알겠어요! 에츠코 씨 당신은 정말…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310234
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722310234,
					"content": "…의뢰 때문이니 이상한 생각하지 마, 빨리 가서 일이나 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722310235
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310235,
					"content": "세이라이섬에는…아직 비밀이 많이 남아있는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722310207,
					"content": "뭔가 알고 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722310208
					]
				}
			]
		}
	]
}