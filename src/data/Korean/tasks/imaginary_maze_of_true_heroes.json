					{
						"sceneId": 3,
						"position": [
							2207.723,
							230.089,
							-799.45
						],
						"pointId": 8531
					}
				]
			},
			"dialogs": [
				{
					"id": 746760101,
					"content": "으흠, 좋은 예감이 들어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760102
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760102,
					"content": "수많은 고생 끝에 두 전설적인 인물의 이야기가 시작된 곳에 도착했으니까, 내 노력을 봐서라도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760103
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760103,
					"content": "운명은 내게 행운을 내릴 거야! 곧 그들과 다시 만날 수 있겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760104
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760104,
					"content": "뭘 저렇게 혼자 중얼거리는 거지? 차림새를 봤을 때 몬드 사람은 아닌 것 같은데… 이나즈마 출신인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746760105,
					"content": "역시, 바로 나타나셨군요! 「지혜롭고 용감한 한 쌍의 별」이여, 우리의 재회에 환호를!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760106,
						746760108
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760106,
					"content": "정말 오랜만이에요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760107
					]
				},
				{
					"id": 746760107,
					"content": "소우카잖아? 몬드에서 널 만날 줄이야, 깜짝 놀랐어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746760111,
					"content": "그런데 넌 늘 하니야 곁에서 대회 준비를 도와줬잖아? 왜 혼자 몬드까지 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746760112,
					"content": "앞에 쌓아둔 책을 보아하니… 지나가는 사람한테 소설을 홍보하고 있었던 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746760113,
					"content": "아, 그건 사실——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760114
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760114,
					"content": "제가 야에 출판사의 편집자한테 쫓기고 있거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760115
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760115,
					"content": "쫓기다니?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746760116,
					"content": "걱정 마세요. 절 해치려는 게 아니라 무슨 방법을 써서라도 제 원고를 받아내려고 하는 것뿐이에요. 결국은 다 저를 위한 일이죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760117
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760117,
					"content": "인기 라이트 노벨 작가로서, 전 끊임없이 작품을 창작해 독자들을 만족시키고 인기를 유지해야 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760118
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760118,
					"content": "독자는 책 읽는 속도가 무척 빨라서, 제가 사력을 다해 쓰지 않으면 다른 수많은 신작들에 밀려 사라지겠죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760119
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760119,
					"content": "하지만 그렇다고 버섯몬 파트너와의 이야기를 시간에 쫓겨 대충 완성하고 싶진 않아요. 좋은 소설에는 긴 구상 시간이 필요하니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760120
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760120,
					"content": "가능하면 버섯몬 파트너 이야기를 완성한 다음, 몇 번 더 살펴보고 수정을 거친 후에 공개하고 싶어요. 마감일에 쫓기듯이 발표하는 건 싫다고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760121
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760121,
					"content": "그래서 상대적으로 쉽고 쓰기 편한 작품을 새로 공개할 수밖에 없었어요. 그래야 독자들이 저를 잊지 않을 테니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760122,
						746760123
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760122,
					"content": "정말 힘들겠네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760124
					]
				},
				{
					"id": 746760124,
					"content": "그랬구나… 라이트 노벨은 라이트하게 쓰는 건 줄 알았는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746760125,
					"content": "여기저기 놀러 다니며 겸사겸사 소재를 찾다가, 영감이 떠오르면 빨리빨리 원고를 작성한 다음에 고료로 탱자탱자 노는 게 아니었구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746760126,
					"content": "그런 건 타고난 작가만 할 수 있는 거예요. 대부분의 작가는 당일에 써야 할 챕터와 소재에 대한 고민만으로도 진이 빠지죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760127
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760127,
					"content": "글을 많이 쓰다 보면 슬럼프에 빠지기 마련이에요. 저도 예외는 없죠. 그게 아니었다면 민간 전설을 따라 몬드까지 오지 않았을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760128,
						746760129
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760128,
					"content": "그 민간 전설이 핵심이겠네요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760130
					]
				},
				{
					"id": 746760130,
					"content": "딩동댕! 그것뿐만 아니라 이미지와 방송 장치를 결합해서 시각과 청각을 합친 입체적인 독서 경험을 구현할 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760131
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760131,
					"content": "이 새로운 개념을 탑재한 작품의 주제는 「초월적인 강자의 미궁 모험」이랍니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760132
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760132,
					"content": "실수로 사악한 마법사가 만든 미궁에 진입한 강자가, 복잡한 장치와 함정을 끊임없이 격파하며 깊은 곳에 숨겨진 비밀을 파헤치는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760133
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760133,
					"content": "그리고 어떻게 써야 할지 잘 모르겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760134
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760134,
					"content": "이봐! 갑자기 흥이 깨졌잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760135
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746760135,
					"content": "이야기의 갈등과 서사를 풀어나가는 속도 같은 건 제가 열심히 고민해 볼게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760136
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760136,
					"content": "연재작에서 가장 중요한 건 독자의 마음을 사로잡는 건데, 미궁에서 만난 다양한 시련이 바로 핵심이 되겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760137
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760137,
					"content": "마침 몬드에 기묘한 장치로 가득 찬 비경이 있다고 들었거든요. 그래서 바로 가서 조사해 봤죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760138
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760138,
					"content": "넌 여전히 즉흥적이네… 그럼 미궁의 시련에 대한 영감이 좀 떠올랐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746760139,
					"content": "영감은 찾았는데, 시련의 좋은 해결 방법은 찾지 못했어요. 그래서 제대로 된 줄거리를 짤 수 없죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760140
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760140,
					"content": "평범한 함정 장치에 만신창이가 될 정도로 혼쭐이 나고서야 겨우 몇 단락을 쓸만한 정보를 얻었어요. 그 와중에 하니야 씨는 옷이 찢어졌고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760141
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760141,
					"content": "이게 다 제가 초월적인 강자가 아니기 때문에 벌어진 일이겠죠. 특별한 능력이 없으니까 구체적인 방법을 상상할 수도 없고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760142
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760142,
					"content": "물론 유명하신 「지혜롭고 용감한 한 쌍의 별」이라면 전혀 문제 되지 않을 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760143
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760143,
					"content": "우리가 특별한 능력이 있는 것도 아닌데, 어쩌다 우리가 생각난 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760144
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746760144,
					"content": "그야 소재를 수집한다고 각계의 능력자를 모두 불러올 수는 없잖아요. 그래서 다양한 강자를 아는 사람을 찾아 비경 시뮬레이션을 도와달라고 부탁하는 게 더 빠를 거라고 생각했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760145
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760145,
					"content": "#그리고 {NICKNAME} 님은 제가 아는 사람 중에 아는 게 가장 많고, 발이 가장 넓고, 티바트에서 가장 인기 있는 사람이거든요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760146
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760146,
					"content": "제가 드린 대본에 따라 텍스트와 영상 화면 그리고 상상 속의 세계에 빠져보세요. 그리고 최고의 상태가 되었을 때…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760147
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760147,
					"content": "필요한 능력에 맞춰 적합한 강자를 떠올리고, 그 강자들이 험악한 미궁을 헤쳐 나갈 방법을 추측하는 거죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760148,
						746760149
					],
					"speakerTitle": "소우카"
				},
				{
					"id": 746760148,
					"content": "앗, 제가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760150
					]
				},
				{
					"id": 746760150,
					"content": "꽤 흥미로운 경험이 될 것 같아! 소설 속 텍스트와 이미지를 따라 상상의 나래를 펼친다니… 한 번도 해본 적 없는 일이잖아? 작가가 된 기분이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760151
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746760151,
					"content": "우리가 아는 사람들이 장치로 가득한 비경을 어떻게 헤쳐 나갈지를 상상해 보면… 확실히 일반인들이 생각할 수 없는 줄거리가 완성될지도?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760152
					],
