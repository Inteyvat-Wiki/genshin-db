				"points": []
			},
			"dialogs": [
				{
					"id": 722480301,
					"content": "잔혼이 나타났어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722480302,
					"content": "난…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480303
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480303,
					"content": "난 헬리오스를 건축한 자, 이름하여 아베라쿠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480304
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480304,
					"content": "내가 이따위 얄팍한 중상모략에 당할 것 같으냐! 내가 고작 너희들의 꼭두각시 어린 왕에게 유폐될소냐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480305
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480305,
					"content": "난… 아니, 난… 이미… 죽은 몸인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480306
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480306,
					"content": "죽은 몸? 이미 죽었다는 걸 알아차린 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722480307,
					"content": "그걸 눈치채는 잔혼은 엄청 드문데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722480308,
					"content": "부끄럽지만 왜 목숨을 잃었는지는 기억이 안 나는군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480309
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480309,
					"content": "기억나는 건… 한 아이에 의해 죽을 때까지 갇혀 있었다는 것뿐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480310
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480310,
					"content": "아이?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722480311,
					"content": "그렇다네. 하지만 난 그 아이를 원망하지 않아. 그저 가여울 뿐이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480312
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480312,
					"content": "잘못한 건 그 아이가 아니야. 잘못은 그 아이를 꼭두각시로 여긴… 됐네. 이 얘기는 그만하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480313
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480313,
					"content": "그 후로 난 유폐됐다네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480314
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480314,
					"content": "유폐된 곳은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480315
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480315,
					"content": "어디야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722480316,
					"content": "아주 높은 곳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480317
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480317,
					"content": "높지만 어둡고 빛이 없는, 얼음 동굴처럼 차가운 곳이었네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480318
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480318,
					"content": "…음, 이상하군. 왜지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480319
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480319,
					"content": "왜 갑자기 난, 높은 곳은 원래 따스하고 편안한 곳이어야 된다고 생각되는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480320
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480320,
					"content": "왜… 왜 난 아무것도 기억이 안 나는 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480321
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480321,
					"content": "배가 고파서 그런 건 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480322
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722480322,
					"content": "난 배가 고프면 머리 쓰는 건 물론, 말도 제대로 못 하겠더라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480323,
						722480325
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722480323,
					"content": "그 이유가 아닌 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480324
					]
				},
				{
					"id": 722480324,
					"content": "틀림없다니까! 봐, 말도 제대로 못 하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722480327,
					"content": "#{NICKNAME}, 한번 찾아보자. 공물 중에 먹을 수 있는 게 있을지도 모르잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480328
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722480328,
					"content": "맞아! 공물!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480329
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480329,
					"content": "어? 공물이 먹고 싶어졌어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480330
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722480330,
					"content": "아니, 갑자기 어떤 일이 떠올랐을 뿐이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480331
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480331,
					"content": "유폐되고 죽은 뒤에 헬리오스를 건축한 공으로 인해 나의 잔해와 옷들이 어디선가 공양되고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480332
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480332,
					"content": "그로 인해 영혼이 따로 분리되어 안식을 취하지 못하고 있는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480333
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480333,
					"content": "이곳은 나의 성관을 공양했던 곳이지만 지금은 다 썩어버렸지… 그래서 나의 정신이 온전치 않았던 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480334
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480334,
					"content": "그렇게 오랜 시간이 흘렀고, 지금의 상태도 유지하기 어려운 지경에 이른 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480335
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480335,
					"content": "하지만 이 공물들이 있기에 내 유골과 옷을 대신해 의식을 조금이나마 담을 수 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480336
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480336,
					"content": "부탁하네. 이 공물들을 가져다 주었으면 하는 곳이 있네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480337
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480337,
					"content": "하지만 그 과정은 험난할 거라네. 실례가 된다는 걸 알지만 이번 시련을 받아줄 수 있겠는가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480338
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480338,
					"content": "시련? 무슨 시련?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480339
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722480339,
					"content": "나의 혼을 감시하고 있는 이 마물들을 무찔러 주시게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480340
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480340,
					"content": "매우 위험한 일이네. 여행자여, 준비되면 나한테 말해주게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722480325,
					"content": "여기에 비상식량이 있어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480326
					]
				},
				{
					"id": 722480326,
					"content": "야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7224805,
			"completionStepIds": [
