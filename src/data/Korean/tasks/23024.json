			"dialogs": [
				{
					"id": 230240101,
					"content": "너희 둘, 드디어 왔구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240102
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230240102,
					"content": "마침 잘 왔어, 모두 준비 완료야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240103
					],
					"speakerTitle": "구르겐"
				},
				{
					"id": 230240103,
					"content": "왜 이렇게 기분이 좋아 보이는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240104
					]
				},
				{
					"id": 230240104,
					"content": "설마 장미가 꽃을 피운 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230240105,
					"content": "맞아. 하하하! 이게 다 네가 도와준 덕분이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240106
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230240106,
					"content": "아직 장미가 완전히 핀 건 아니지만 형태만 봐도 얼마나 왕성한 생명력을 가지고 있을지 짐작이 가지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240107
					],
					"speakerTitle": "구르겐"
				},
				{
					"id": 230240107,
					"content": "관심 있으면 가까이 와서 관찰해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240108
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230240108,
					"content": "하하하, 바로 너희 앞에서 활짝 필지도 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240109
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230240109,
					"content": "그럼 제대로 봐야겠어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240110
					]
				},
				{
					"id": 230240110,
					"content": "정, 정말? 벌써 꽃이 핀다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230240111,
					"content": "너무 기대돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
