			"completionStepIds": [
				7154101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7154101",
							"2"
						],
						"stepId": 7154101,
						"stateName": "QUEST_STATE_UNFINISHED"
