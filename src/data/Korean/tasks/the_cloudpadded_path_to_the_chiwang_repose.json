				]
			},
			"dialogs": [
				{
					"id": 711270401,
					"content": "#{NICKNAME}, 페이몬. 왔군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270402
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711270402,
					"content": "어라, 영연? 왜 네가 여기에 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711270403,
					"content": "난 들어갈 수 없으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270404
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711270404,
					"content": "들어갈 수 없다구? 어디에 들어갈 수 없는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711270405,
					"content": "부금이 쉬고 있는 장소, 금락정",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270406
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711270406,
					"content": "금락정이라… 음, 부금이 처음 우리를 데려갔던 곳을 말하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711270407,
					"content": "거긴 부금이 선력으로 봉쇄한 거처다. 난 그녀의 선력이 없어서 들어갈 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270408
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711270408,
					"content": "뭐? 하지만 저번에 부금이 쉬러 갈 때는 그런 말 안 했었잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711270409,
					"content": "그때는 미처 생각하지 못했다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270410,
						711270412
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711270410,
					"content": "도와줄까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270411
					]
				},
				{
					"id": 711270411,
					"content": "너희는 그녀의 선력을 가지고 있으니 금락정의 문을 열 수 있겠지. 그래 도와줬으면 좋겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711270416,
					"content": "엥? 잠깐만, 그러면 여기서 계속 우릴 기다렸던 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270417
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711270417,
					"content": "너희를 기다린 건 아니다. 금락정에 들어갈 방법을 찾고 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270418
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711270418,
					"content": "뭐가 다른지 모르겠지만…. 어, 어쨌든 우리도 부금의 상태가 신경 쓰이니까. 그럼 영연, 너도 같이 갈래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270419
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711270419,
					"content": "그래, 고맙군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270420
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711270420,
					"content": "날 따라와라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "영연"
				},
				{
					"id": 711270412,
					"content": "파랑이, 우둔해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270413
					]
				},
				{
					"id": 711270413,
					"content": "맞아, 맞아! 그렇게 중요한 일을 잊어버리다니, 정말이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711270414,
					"content": "난 우둔한 짐승일 뿐이니까. 그녀를 보면 많은 걸 생각하고 많은 걸 잊게 되지. 다 내 잘못이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270415
					],
					"speakerTitle": "영연"
				},
				{
					"id": 711270415,
					"content": "너희는 그녀의 선력을 가지고 있으니 금락정의 문을 열 수 있겠지. 도와줬으면 좋겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "영연"
				}
			]
