				"points": []
			},
			"dialogs": [
				{
					"id": 400771101,
					"content": "어? 저기 저 사람, 우리가 도착한 첫날에 본 그 사람 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400771102,
					"content": "아하하… 딸꾹! 다 미쳤어, 다 꺼져버려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771103
					],
					"speakerTitle": "페르시코프"
				},
				{
					"id": 400771103,
					"content": "우리는… 영원히 깨어나지 않을 거야…. 하지만 난 틀리지 않았어. 내 보물은 무적이라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771104
					],
					"speakerTitle": "페르시코프"
				},
				{
					"id": 400771104,
					"content": "보물? 뭘 말하는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771105
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400771105,
					"content": "기적을 만드는 기계는… 불가능한 게 아니야… 딸꾹!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771106
					],
					"speakerTitle": "페르시코프"
				},
				{
					"id": 400771106,
					"content": "저 장치를 말하는 것 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771107
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400771107,
					"content": "인사불성이 따로 없군, 흥",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771108
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 400771108,
					"content": "정말 지독한 술 냄새군요…. 아가씨 제가 날개로 냄새를 날려드리겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771109
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 400771109,
					"content": "좋은 생각이야, 나도 좀 부탁해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771110
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400771110,
					"content": "그럼 나도",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400771111
					]
				},
				{
					"id": 400771111,
					"content": "물론이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771112
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 400771112,
					"content": "주변을 다 둘러봤는데 다른 사람은 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771113
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400771113,
					"content": "이상하지 않아? 우인단은 조직인데 여긴 저 사람밖에 없잖아. 게다가 저번에는 저 사람도 없었고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771114
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400771114,
					"content": "심지어 저번에 봤던 그 뚱뚱한 남자도 안 보여. 분명… 다른 곳에 숨어있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771115
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400771115,
					"content": "이유는 저 사람에게 물어봐야겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771116
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400771116,
					"content": "근데 저렇게 만취했는데, 조금 기다려야 하지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400771117,
					"content": "응징의 샘물을 내리겠노라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771118
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 400771118,
					"content": "물을 뿌리자고 하십니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771119
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 400771119,
					"content": "좋은 생각이야. 뿌려보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400771120,
					"content": "일행이 배낭에서 물을 꺼내 우인단 연구원을 향해 인정사정없이 들이붓는다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400771121
					]
				},
				{
					"id": 400771121,
					"content": "앗, 눈을 떴어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400771122,
					"content": "으… 음?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771123
					],
					"speakerTitle": "페르시코프"
				},
				{
					"id": 400771123,
					"content": "이봐, 너 우인단이지? 여기서 무슨 일이 있었는지 알려줄 수 있을까? 저 장치는 어디에 쓰는 물건이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771124
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400771124,
					"content": "…우인… 단…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771125
					],
					"speakerTitle": "페르시코프"
				},
				{
					"id": 400771125,
					"content": "…하하하! 우인단이라니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771126
					],
					"speakerTitle": "페르시코프"
				},
				{
					"id": 400771126,
					"content": "아, 음… 어리석고 무식한 고위층 녀석들, 후회되지? 하하, 내 연구를 부정하고 날 강제로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771127
					],
					"speakerTitle": "페르시코프"
				},
				{
					"id": 400771127,
					"content": "날 강제로… 무인도로 보내서 실험을 하게 만들다니… 보물! 내 보물, 흑흑흑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771128
					],
					"speakerTitle": "페르시코프"
				},
				{
					"id": 400771128,
					"content": "갑자기 왜 우는 거야. 억울한 일이 많았나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400771129,
					"content": "…나와… 내 발명품을 무시하다니! 너, 너희들은… 미래의 승산을 전혀 모르는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771130
					],
					"speakerTitle": "페르시코프"
				},
				{
					"id": 400771130,
					"content": "나의 발명만이… 세상을 지배할 수 있지… 하하, 하하하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771131
					],
					"speakerTitle": "페르시코프"
				},
				{
					"id": 400771131,
					"content": "바보, 멍청한 녀석, 하하하하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771132
					],
					"speakerTitle": "페르시코프"
				},
				{
					"id": 400771132,
					"content": "으악…! 때리지 마, 이제 실험실 폭발 안 시킬게… 미안해! 고의가 아니었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771133
					],
					"speakerTitle": "페르시코프"
				},
				{
					"id": 400771133,
					"content": "안 되겠어. 이 사람 정신이 오락가락해서 대화가 전혀 안 통하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771134
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400771134,
					"content": "첫날에 봤을 때만 해도 이 정도는 아니었는데, 그 뒤로 또 충격을 받아서 완전히 정신이 나간 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771135
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400771135,
					"content": "흑, 흑… 내 원고, 원고! 그것만이… 날 살… 살릴 수 있… 흑흑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771136
					],
					"speakerTitle": "페르시코프"
				},
				{
					"id": 400771136,
					"content": "원고? 그게 어디 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771137
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 400771137,
					"content": "화내지 마, 화내지 말아 줘, 흑흑흑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771138
					],
					"speakerTitle": "페르시코프"
				},
				{
					"id": 400771138,
					"content": "피슬, 겁주지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400771139,
					"content": "흥! 그럼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771140
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 400771140,
					"content": "내가 해볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771141
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400771141,
					"content": "저기, 여기 좀 봐줘. 원고를 어디에 숨겼는지 알려줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771142
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400771142,
					"content": "흑… 흑… 무서워, 보고서 쓰라고 하지 마… 흑흑… 저리 비켜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771143
					],
					"speakerTitle": "페르시코프"
				},
				{
					"id": 400771143,
					"content": "이럴 수가, 완전히 자기만의 세상에 빠져있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771144
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400771144,
					"content": "내가 해볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771145
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400771145,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771146
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400771146,
					"content": "실례할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771147
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400771147,
					"content": "조용히 앞에 서 있던 카즈하가 갑자기 연구원을 업어치기로 들어 올린 후 넘어뜨린다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400771148
					]
				},
				{
					"id": 400771148,
					"content": "흐아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771149
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400771149,
					"content": "우으! 아이고 내 엉덩이야, 흑흑… 뇌가 드디어 다시 작동하는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771150
					],
					"speakerTitle": "페르시코프"
				},
				{
					"id": 400771150,
					"content": "원고를 어디 숨겼는지 알려줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771151
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400771151,
					"content": "원고… 원고는… 저기 있는 돌 틈 사이에 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771152
					],
					"speakerTitle": "페르시코프"
				},
				{
					"id": 400771152,
					"content": "말했다! 다행이야, 안 그랬으면 귀에 로큰롤을 쏴주려고 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771153
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400771153,
					"content": "카즈하, 저 사람을 제압하기 전에 한참을 고민하던데, 정말 착하다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771154
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400771154,
					"content": "맞아, 큰일을 하는 사람은 확실히 달라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400771155
					]
				},
				{
					"id": 400771155,
					"content": "원고가 근처의 돌 틈 사이에 있는 것 같으니, 원고부터 찾아보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카에데하라 카즈하"
				}
			]
		}
	]
}