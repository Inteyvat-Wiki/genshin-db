				"points": []
			},
			"dialogs": [
				{
					"id": 200660101,
					"content": "골치 아프네…. 이걸 어떻게 해결해야 하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660102
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200660102,
					"content": "뭐 하는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660103
					]
				},
				{
					"id": 200660103,
					"content": "다음 기사단 선발을 위해 훈련 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660104
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200660104,
					"content": "음… 하지만 난 진 단장님 같은 힘이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660105
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200660105,
					"content": "「힘」을 단련하는 것보다는 「기술」을 익히는 게 나한테 더 맞는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660106
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200660106,
					"content": "예를 들어, 이 통나무들을 단숨에 모두 파괴하는 방법 같은… 이 통나무들이 좀 부실해 보이긴 하지만 아빠가 고생해서 구해온 거니까, 절대 실망시켜선 안 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660107
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200660107,
					"content": "시간 있으면 너도 나랑 같이 생각해보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660108,
						200660109
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200660108,
					"content": "한번 생각해볼게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660110
					]
				},
				{
					"id": 200660110,
					"content": "괜찮아. 통나무는 어디 도망 안 가니까 천천히 생각해도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660111
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200660111,
					"content": "홀로 도망갈 수 있는 건 흘러가는 시간과 생명체밖에 없으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200660114,
					"content": "이 정도 거리라면 한쪽은 자기가 막고 다른 한쪽으론 폭탄을 던지는 게 최고의 선택이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660115
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200660115,
					"content": "하하하, 장난이야. 폭탄 같은 걸 내가 어디서 구하겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엘린"
				},
				{
					"id": 200660109,
					"content": "우리 둘이 같이 하는 건…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660112
					]
				},
				{
					"id": 200660112,
					"content": "단체 전투 해봤어? 언제든지 도움을 요청할 수 있으니…. 정말 부러운 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660113
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200660113,
					"content": "나 같은 사람은 그냥 독자적인 전투만 배워야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "엘린"
				}
			]
		},
