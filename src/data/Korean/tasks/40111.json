					"케이아"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111301,
					"content": "여, 또 궁금한 게 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111306,
						401111310
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 401111302,
					"content": "「일곱 성인의 소환」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111303
					]
				},
				{
					"id": 401111303,
					"content": "요즘 인기 정말 좋더라. 모두의 삶의 일부가 된 것 같아. 어딜 가든 게임 중인 사람들이 보이더라니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111304
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 401111304,
					"content": "심지어 멀쩡한 정신으로 하겠다며 술을 끊은 사람도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111305
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 401111305,
					"content": "정말이지, 디오나가 들으면 좋아할 소식이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111306,
						401111310
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 401111306,
					"content": "기사단 사람들은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111307
					]
				},
				{
					"id": 401111307,
					"content": "다들 잘 있으니 걱정 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111308
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 401111308,
					"content": "진 단장도 끌어들이려고 했는데 중간에 끌려가 버렸어. 남은 게임은 결국 나 혼자 했다니까? 하아, 어쩔 수 없지. 「역할 분담」이라고 생각할 수밖에",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111309
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 401111309,
					"content": "그래도 대회는 성공적이었고 다들 기뻐했으니, 진 단장도 한시름 놓겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111310
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 401111310,
					"content": "나중에 또 얘기 나눠요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111311
					]
				},
				{
					"id": 401111311,
					"content": "좋아. 나중에 또 「일곱 성인의 소환」 한 판 하자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "케이아"
				}
			]
		},
