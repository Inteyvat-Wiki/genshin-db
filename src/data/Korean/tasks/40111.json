					"티미"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111101,
					"content": "이겼다! 내가 이겼어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111102,
						401111106
					],
					"speakerTitle": "티미"
				},
				{
					"id": 401111102,
					"content": "축하해, 티미!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111103
					]
				},
				{
					"id": 401111103,
					"content": "고마워. 엄마도 기뻐하시겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111104
					],
					"speakerTitle": "티미"
				},
				{
					"id": 401111104,
					"content": "엄마가 대회에 참여해보라고 한 거니까, 상품은 엄마한테 줄 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111105
					],
					"speakerTitle": "티미"
				},
				{
					"id": 401111105,
					"content": "아빠도 이 모습을 볼 수 있으면 좋을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "티미"
				},
				{
					"id": 401111106,
					"content": "그럼 이만",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111107
					]
				},
				{
					"id": 401111107,
					"content": "잘 가, 「일곱 성인의 소환」은 정말 재밌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "티미"
				}
			]
		},
		{
			"id": 4011112,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4011101",
							"2"
						],
						"stepId": 4011101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"미카",
					"호프만"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111201,
					"content": "끝난 건가? 느, 늦어버렸네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111202
					],
					"speakerTitle": "미카"
				},
				{
					"id": 401111202,
					"content": "미카, 못 봐서 아쉽게 됐네. 근데 결과는… 케이아 대장님의 패배야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111203
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 401111203,
					"content": "뭐?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111204
					],
					"speakerTitle": "미카"
				},
				{
					"id": 401111204,
					"content": "형, 뭐가 어떻게 된 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111205
					],
					"speakerTitle": "미카"
				},
				{
					"id": 401111205,
					"content": "난 「일곱 성인의 소환」은 잘 몰라서 사람들이 하는 얘기로 상황을 파악했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111206
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 401111206,
					"content": "처음엔 케이아 대장님이 상대의 첫 번째 카드를 제거했어. 앞서고 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111207
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 401111207,
					"content": "하지만 그건 함정이었어! 티미라는 아이는 지난 턴 동안 모아놓은 카드들을 이용해… 무시무시한 폭발력을 보여줬지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111208
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 401111208,
					"content": "아니… 어쩌면 이번 시합의 승부는 케이아 대장님이 「후공」을 뽑는 순간 정해진 걸지도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111209
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 401111209,
					"content": "아, 한잔하러 가고 싶다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111210
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 401111210,
					"content": "형, 진정해. 지금은 술로 마음을 달랠 때가 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111211
					],
					"speakerTitle": "미카"
				},
				{
					"id": 401111211,
					"content": "내가 아는 케이아 대장님이라면 형이 슬퍼하는 걸 원치 않으실 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111212
					],
					"speakerTitle": "미카"
				},
				{
					"id": 401111212,
					"content": "우리도 이참에 카드 게임을 배울까? 다음번에 케이아 대장님과 겨룰 수 있을지도 모르잖아! 아마 지겠지만… 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111213
					],
					"speakerTitle": "미카"
				},
				{
					"id": 401111213,
					"content": "하핫, 네 말이 맞아, 미카",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호프만"
				}
			]
		},
		{
