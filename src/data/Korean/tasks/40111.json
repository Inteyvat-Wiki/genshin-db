				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111501,
					"content": "「페보니우스 기병대장 VS 천재 불패 소년. 인재를 배출하는 호수의 도시」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111502
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 401111502,
					"content": "흠, 긍정적인 요소는 이 정도면 된 것 같지만 「화제성」이 부족해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111503
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 401111503,
					"content": "「페보니우스 기사단 최고의 두뇌, 5턴 만에 다리 위 소년에게 패배하다」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111504
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 401111504,
					"content": "「밀처럼 반짝이는 역전승」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111505
					],
					"speakerTitle": "샤를로트"
				},
				{
					"id": 401111505,
					"content": "아, 그냥 첫 번째 거로 할까?…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "샤를로트"
				}
			]
		},
