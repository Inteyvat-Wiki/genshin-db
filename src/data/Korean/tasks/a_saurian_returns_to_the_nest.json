							"7503203",
							"2"
						],
						"stepId": 7503203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"마뇨야"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320201,
					"content": "어때, 한 판 해볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320202
					],
					"speakerTitle": "마뇨야"
				},
				{
					"id": 750320202,
					"content": "용을 타고 제한된 시간 내에 정해진 비행 코스를 따라 날면서 최대한 높은 점수를 획득해야 해. <color=#00E1FFFF>2단계만 넘으면 날 이긴 걸로 쳐줄게</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320203,
						750320205
					],
					"speakerTitle": "마뇨야"
				},
				{
					"id": 750320203,
					"content": "준비 됐어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320204
					]
				},
				{
					"id": 750320204,
					"content": "시원시원하네! 그럼 출발 지점으로 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마뇨야"
				},
				{
					"id": 750320205,
					"content": "아직 준비가 안 됐어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320206
					]
				},
				{
					"id": 750320206,
					"content": "괜찮아, 그럴 마음이 생기면 말해. 비행은 원래 편안하고 즐거운 일이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마뇨야"
				}
			]
		},
