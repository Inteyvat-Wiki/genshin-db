				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20100201,
					"content": "#어이, {NICKNAME}. 왔구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100202
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100202,
					"content": "산고노미야 님과 약속한 날이 다가오고 있어. 우리도 슬슬 출발하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100203
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100203,
					"content": "준비 다 했지? 우선 <color=#00E1FFFF>와타츠미섬</color> 군영에 들렀다가 산고노미야 님을 뵈러 갈 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100204
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100204,
					"content": "혹시라도 뱃멀미하면 말해 줘. 남십자함대에 있었다고 하니 별일 없겠지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100205
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100205,
					"content": "그럼, 출항!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "텟페이"
				}
			]
		},
		{
			"id": 201004,
			"completionStepIds": [
				201004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201004",
							"2"
						],
						"stepId": 201004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"텟페이"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20100401,
					"content": "여기가 바로 와타츠미섬 군대의 훈련장이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100402
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100402,
					"content": "현재 저항군은 거의 와타츠미섬의 현지 병사들로 구성돼 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100403
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100403,
					"content": "일부는 타타라스나에서 막부군과 정면 교전을 치르고 있고, 일부는 와타츠미섬에 남아 백성들을 지키고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100404
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100404,
					"content": "텟페이도 여기서 훈련했었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20100405,
					"content": "응, 근데 아직 교관님께 완전히 인정받은 건 아니어서, 타타라스나 전투의 보급 부대에서 작은 일부터 도와야 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100406
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100406,
					"content": "난 당분간 여기서 지내니까 필요한 게 있으면 찾아와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100407
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100407,
					"content": "내가 없으면 쪽지를 써서 근처 벽에 붙여줘. 보면 바로 찾아갈게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100408
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100408,
					"content": "…이런, <color=#00E1FFFF>산고노미야 님</color>과 약속한 시간이 거의 다 됐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100409
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100409,
					"content": "와타츠미섬은 다음에 구경시켜줄게. 일단 <color=#00E1FFFF>산호궁</color>에 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100410
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100410,
					"content": "산호궁이 바로 <color=#00E1FFFF>산고노미야 코코미</color>가 사는 곳이겠지…? 어서 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 201006,
			"completionStepIds": [
				201006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201006",
							"2"
