						"stepId": 201006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"산고노미야 코코미"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20100601,
					"content": "어찌 됐든 군량과 마초가 가장 중요하니, 절대 문제가 생겨선 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100602
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100602,
					"content": "막부군과의 갈등이 격화되고 있으니 후방의 안정성을 우선적으로 확보해야 하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100603
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100603,
					"content": "예, 방법을 더 생각해 보겠습니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100604
					],
					"speakerTitle": "오오쿠보 다이스케"
				},
				{
					"id": 20100604,
					"content": "걱정 마. 지난번에 보내온 물자도 있고 나도 병력을 확충하고 있으니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100605
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100605,
					"content": "일손이 부족해서 고생이 많았겠지만, 앞으로는 상황이 나아질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100606
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100606,
					"content": "병력 확충이요? 잘됐군요. 누가 우리를 후원해 주는지는 모르겠지만, 정말 다행입니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100607
					],
					"speakerTitle": "오오쿠보 다이스케"
				},
				{
					"id": 20100607,
					"content": "어? 텟페이잖아? 너 이 녀석 와타츠미섬에 돌아온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100608
					],
					"speakerTitle": "오오쿠보 다이스케"
				},
				{
					"id": 20100608,
					"content": "이분은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100609
					],
					"speakerTitle": "오오쿠보 다이스케"
				},
				{
					"id": 20100609,
					"content": "헤헤, 산고노미야 님 손님이에요. 제가 와타츠미섬으로 데려왔어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100610
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100610,
					"content": "어? 설마 최근 부대에서 소문이 자자한… 강력한 힘과 엄청난 궁술 실력을 갖고 있다는 그 괴물 신인?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100611
					],
					"speakerTitle": "오오쿠보 다이스케"
				},
				{
					"id": 20100611,
					"content": "어째서 그런 소문이 난 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100612
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20100612,
					"content": "먼 길 온 걸 보니 중요한 일인가 보군. 그럼 난 이만 가볼 테니, 시간 될 때 놀러 오시게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100613
					],
					"speakerTitle": "오오쿠보 다이스케"
				},
				{
					"id": 20100613,
					"content": "먼저 가보겠습니다, 산고노미야 님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100614
					],
					"speakerTitle": "오오쿠보 다이스케"
				},
				{
					"id": 20100614,
					"content": "산고노미야 님, 방금 오오쿠보 형님이 「후원」이라고 하는 걸 들었는데, 그게 무슨 소리인가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100615
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100615,
					"content": "얼마 전에 누군가가 와타츠미섬의 항쟁을 지원해 주고 싶다는 편지와 함께 대량의 물자를 보내왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100616
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100616,
					"content": "덕분에 우린 마침내 마음 놓고 더 많은 병력을 모집해서 막부군과 정면전을 펼칠 수 있게 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100617,
						20100619
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100617,
					"content": "정말 다행이다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100618
					]
				},
				{
					"id": 20100618,
					"content": "사실 좀 의심되긴 하지만… 풍요롭지 않은 와타츠미섬에 이 물자는 하늘이 내린 동아줄이나 다름없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100621
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100621,
					"content": "상대가 무리한 요구를 한 것도 아니고. 전력을 다해 막부군에 대항하라는 것뿐이었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100622
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100622,
					"content": "그들의 목적이 무엇이든 간에 이 점에 관해선 의견이 일치하니, 그냥 베일에 싸인 동맹이 생긴 셈 치려고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100623
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100623,
					"content": "물론 경계를 완전히 풀진 않을 거야. 이상한 낌새라도 보이면 즉시 내게 보고해 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100624
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100624,
					"content": "산고노미야 님, 그럼 전선의 급식도 좋아지겠네요? 며칠 전에 부상병 군영에 갔는데 고기 먹고 싶다고 난리도 아니었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100625
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100625,
					"content": "하하… 내가 다 준비해뒀으니 안심해. 고기는 배부르게 먹어도 좋지만, 술은 절대 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100626
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100626,
					"content": "좋습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100627
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100627,
					"content": "너희도 고생이 많아. 안수령이 내려지고 저항전을 일으킨 이래로 식단이 거의 안 바뀌었으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100628
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100628,
					"content": "보급 부대와 잘 상의해서 식단을 개선해볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100629
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100629,
					"content": "다만 물자가 제한적이니, 승리하기 전까진 좀 참아줬으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100630
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100630,
					"content": "안수령은 대체 언제 끝날까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100631
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20100631,
					"content": "그건… 나도 답해줄 수가 없네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100632
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100632,
					"content": "안수령의 반포 자체가 너무 이상해. 텐료 봉행도 그렇고 쇼군님도 그렇고 태도가 묘하단 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100633
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100633,
					"content": "텐료 봉행은 갑자기 안수령에 극도로 열광하고, 쇼군님도 안수령이 불러온 전쟁에 무심한 것 같거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100634
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100634,
					"content": "이 수수께끼들이 풀리기 전까지 안수령은 끝나지 않을 거야. 내가 장담하는 건 안수령이 있는 한 우린 저항을 포기하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100635
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100635,
					"content": "#{NICKNAME}, 그러니까 다시 한번 확인할게. 와타츠미섬과 저항군의 상황을 알게 된 지금도 넌 우리와 함께 싸울 거니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100636
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100636,
					"content": "난 포기하지 않아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100637
					]
				},
				{
					"id": 20100637,
					"content": "좋아, 그럼 정식으로 선포하지——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100638
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100638,
					"content": "지금부터 널 와타츠미섬의 특수 행동대, 「황새치 2번대」의 대장으로 임명한다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100639
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100639,
					"content": "화화화황새치 2번대? 제가 알고 있는 「황새치」라는 타이틀을 가진 그 특수 행동대 말입니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100640
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100640,
					"content": "거기에 들어가는 것만으로도 힘든데 단번에 대장 자리까지 올라가다니… 정말 대단해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100641
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100641,
					"content": "좀 파격적인 임명 방식이지만, 너의 지혜와 용기와 힘으로 부대를 승리로 이끌 것이라 믿어 의심치 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100642
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100642,
					"content": "좋아! 그럼 우린 언제 취임해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100643
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20100643,
					"content": "황새치 2번대는 지금 섬의 <color=#00E1FFFF>남서쪽</color> 산골짜기에 대기하고 있어. 최근 <color=#00E1FFFF>유랑 무사</color>들이 난동을 부려서 특수 행동대가 후방을 평정해야 하는 상황이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100644
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100644,
					"content": "위임장은 이미 준비해뒀으니 그들에게 보여주기만 하면 돼. 그리고 그 유랑 무사들도 같이 소탕해 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100645
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100645,
					"content": "특수 행동대의 대원은 모두 와타츠미섬의 정예다 보니 다소 오만하지만, 너라면 그들의 신임을 얻을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100646
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100646,
					"content": "그, 그럼 저는요? 산고노미야 님, 제게 맡겨주실 임무는 없으신가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100647
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100647,
					"content": "저도 저항군을 위해 많은 걸 기여하고 싶어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100648
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100648,
					"content": "물론 있지. 이따 바로 말해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100649
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 20100649,
					"content": "#반드시 완수하겠습니다! 헤헤. {NICKNAME}, 네가 황새치 2번대의 대장이 됐지만, 나도 절대 지지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100650
					],
					"speakerTitle": "텟페이"
				},
				{
					"id": 20100650,
					"content": "그래, 너무 무리하지 말고 조심하라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100651
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20100651,
					"content": "#{NICKNAME}, 우리도 출발하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20100619,
					"content": "믿어도 되는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20100620
					]
				},
				{
					"id": 20100620,
					"content": "나도 의심되긴 하지만… 풍요롭지 않은 와타츠미섬에 이 물자는 하늘이 내린 동아줄이나 다름없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20100621
					],
					"speakerTitle": "산고노미야 코코미"
				}
			]
		},
