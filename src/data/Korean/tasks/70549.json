				]
			},
			"dialogs": [
				{
					"id": 705490101,
					"content": "음, 역시",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490102
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490102,
					"content": "주변을 거닐다가 익숙한 기운이 느껴져서 와본 건데, 역시 너였구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490103,
						705490104
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490103,
					"content": "안녕하세요, 클로린드 씨!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490105
					]
				},
				{
					"id": 705490105,
					"content": "샤를로트 씨가 이 장면을 봤으면, 사진을 수백 장씩 찍어가서 이런 기사를 썼을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490106
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490106,
					"content": "#《{NICKNAME}의 아르바이트 생활! 돈 주고도 못 구하는 스페셜 음료》…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490107
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490107,
					"content": "이튿날이면 각종 신문의 헤드라인에 네가 도배되고, 수많은 폰타인 관광객이 몰려와 여기가 발 디딜 틈 없이 붐비겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490108,
						705490109
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490108,
					"content": "상상만 해도 어지럽네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490110
					]
				},
				{
					"id": 705490110,
					"content": "다행히 이번에는 내가 샤를로트 씨의 동행 요청을 거절해서, 그런 상황은 발생하지 않을 거야. 이 한가로운 순간에 기뻐하자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490111
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490111,
					"content": "그럼, 「불꽃 캐러멜의 시」 한 잔 부탁할게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490112
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490112,
					"content": "…나한테 물어볼 게 많은 표정이네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490113,
						705490114
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490113,
					"content": "칵테일부터 만들어 드릴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490115
					]
				},
				{
					"id": 705490115,
					"content": "침착하고 여유롭군. 이 일에는 꽤 경험이 있는 모양이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490114,
					"content": "마시면서 얘기 나누시죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490115
					]
				},
				{
					"id": 705490109,
					"content": "그러면 감당하기 힘들 것 같아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490110
					]
				},
				{
					"id": 705490104,
					"content": "손님, 여기 앉으세요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490105
					]
				}
			]
		},
		{
			"id": 7054902,
			"completionStepIds": [
				7054906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
