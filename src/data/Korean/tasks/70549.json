						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705490201,
					"content": "주문하신 「불꽃 캐러멜의 시」 나왔습니다. 맛있게 드세요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490202
					]
				},
				{
					"id": 705490202,
					"content": "이름 그대로군. 불꽃 같은 색감에… 향도 꽤 강렬해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490203
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490203,
					"content": "크흠… 조금 독하군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490204,
						705490205
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490204,
					"content": "괜찮으세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490206
					]
				},
				{
					"id": 705490206,
					"content": "괜찮아, 적응할 시간이 조금 필요할 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490207
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490207,
					"content": "술은 작년에 나비아가 초대해 준 와인 시음회에서 「사시까」를 한 모금 맛본 게 마지막이었거든. 근데 이게 훨씬 독하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490208,
						705490209
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490208,
					"content": "그럼 전혀 안 마시는 거나 다름없잖아요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490210
					]
				},
				{
					"id": 705490210,
					"content": "이성적으로 보면, 알코올은 정신을 흐리게 하고 일을 방해하니 안 마시는 게 맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490211
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490211,
					"content": "근데 푸리나 씨가 항구로 마중 나오면서, 몬드를 「술과 시의 나라」라고 하시더라고. 이왕 왔으니, 이곳의 특색을 조금 맛보는 것도 좋겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490212,
						705490213
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490212,
					"content": "안 그러면 아쉽긴 하겠네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490214
					]
				},
				{
					"id": 705490214,
					"content": "게다가 내가 수집한 정보에 따르면, 곧 나와 겨루게 될 유격대 대장은… 뛰어난 술 감별사라고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490215
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490215,
					"content": "그 대장의 대외 공개된 전보를 봤는데, 정말 눈이 부실 정도였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490216
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490216,
					"content": "게다가 전에 나와 겨뤘던 유라 대장은… 뛰어난 술 감별사라고 들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490217
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490217,
					"content": "폰타인 본토에서는 이미 생산이 중단되어, 해외에만 재고가 남아 있는 바다 이슬 꽃 과일즙까지 내게 선물해 줬지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490218
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490218,
					"content": "상대에게 최대한의 경의를 표하기 위해서라도, 몬드의 술을 더 이해할 필요가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490219,
						705490220
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490219,
					"content": "그럼 더 고민해 보고, 한 잔 더 만들어 드릴게요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490221
					]
				},
				{
					"id": 705490221,
					"content": "고마워, 그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490222
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490222,
					"content": "몬드성은 좀 둘러보셨나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490223
					]
				},
				{
					"id": 705490223,
					"content": "응, 몬드에 도착한 첫날 오전부터 여기저기 돌아다녔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490224
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490224,
					"content": "나비아가 찾아봤는데, 「테이블 극단」의 여러 배경 및 일러스트의 모티브가 몬드성이라고 하더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490225
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490225,
					"content": "하지만 실제 몬드의 분위기는 대본 속 성과 많이 달랐어. 그중에서도 가장 인상적이었던 건 검과 방패의 기운이었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490226,
						705490227
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490226,
					"content": "검과 방패요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490228
					]
				},
				{
					"id": 705490228,
					"content": "아마 내가 대장간과 훈련장을 주로 둘러봐서 그런 거 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490229
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490229,
					"content": "최근 몬드에서 제작된 무기와 갑옷은 폰타인과 전혀 다른 열처리 방식을 사용해서, 표면의 탄소 함량이 더 높아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490230
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490230,
					"content": "강도는 조금 떨어졌지만, 충격 저항력은 크게 올라갔지. 마치… 오래 끓인 커피, 음, 거기다 소금까지 세 스푼 넣은 그런 향 같았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490231,
						705490232
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490231,
					"content": "전혀 몰랐어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490233
					]
				},
				{
					"id": 705490233,
					"content": "이런 느낌 덕분에 첫인상이 좋았지. 폰타인 특유의 방식으로 만든 합금은 마코트 풀 성분이 들어간 보호제로 관리하거든?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490234
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490234,
					"content": "시간이 지나면 그 은은한 향이 지나치게 달아서… 이가 시릴 정도야. 하지만 몬드의 검과 방패에서는 그런 불편한 기운이 느껴지지 않더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490235,
						705490236
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490235,
					"content": "새로운 지식을 배웠네요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490237
					]
				},
				{
					"id": 705490237,
					"content": "물론 이것도 해결 방법은 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490238
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490238,
					"content": "다음에 폰타인에서 만날 때, 물처럼 가벼운 질감에 불필요한 향이 첨가되지 않은 보호제를 추천해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490239
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490239,
					"content": "너도 달콤한 향이 오래 나는 걸 안 좋아하면, 분명 마음에 들 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490240
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490240,
					"content": "평소에는 어떤 음료를 드시나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490241
					]
				},
				{
					"id": 705490241,
					"content": "평소에? 업무 시간엔 주로 커피를 마시고, 식사할 땐 가벼운 풍선귤 주스를 곁들이는 편이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490242
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490242,
					"content": "난 고기 요리를 자주 먹는데, 새콤한 주스가 느끼함을 덜어주더라고. 시간이 지나면서 습관이 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490243
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490243,
					"content": "오늘 교류가 끝난 뒤에, 친절한 기사들이 몬드의 특색 요리를 대접해 줬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490244
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490244,
					"content": "여덟 가지 고기 요리를 맛봤는데, 전부 훌륭하더라. 양도 많고, 고기 질도 좋고, 불 조절도 완벽했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490245
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490245,
					"content": "물론 개선의 여지도 있었지. 허니캐럿그릴이나 높이 쌓기 같은 경우에는… 타지 손님을 위한 버전은 소스 맛을 조금 약하게 해도 좋을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490246,
						705490247
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490246,
					"content": "꽤 많이 드셨나 보네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490248
					]
				},
				{
					"id": 705490248,
					"content": "붉은 고기 한정이라면, 맞아. 이 식사로만 3일치 칼로리를 먹어서, 이후의 식사 초대는 모두 거절했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490249
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490249,
					"content": "지금은 느끼함을 해소하는 게 먼저야… 뭔가 방법이 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490250
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490250,
					"content": "이건 기사들이 준 선물인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490251
					]
				},
				{
					"id": 705490251,
					"content": "맞아. 코드 네임 「헤이즐넛 03」이랑 「헤이즐넛 05」인 기사가 이 휘장을 선물해 줬어. 디자인이 상당히 정교해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490252
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490252,
					"content": "이런 기념 휘장은 중요한 손님한테 증정되는 용도로, 디자인이 막 정해졌다고 들었어. 네 건 아직도 설계 중이래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490253,
						705490254
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490253,
					"content": "그런 이름의 기사는 처음 들어봐요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490255
					]
				},
				{
					"id": 705490255,
					"content": "…맞아. 나도 멜모니아궁 직원의 이름을 전부 기억하진 못해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490256
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490256,
					"content": "하지만 너도 언젠간 만나게 될 거야. 딱 봐도 경험 많은 베테랑이던데? 행정직인데도 갑옷을 입고 출근하더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490257
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490257,
					"content": "내 일을 처리한 뒤엔 술집으로 갔어. 누가 더 잘 마시는지, 어젯밤의 대결을 마무리해야 한다면서 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490258
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490258,
					"content": "전날 밤 맥주를 그만큼 마시고도 다음 날 멀쩡히 출근하는 데다, 실수도 안 한다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490259,
						705490260
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490259,
					"content": "몬드가 원래 좀 자유분방하잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490261
					]
				},
				{
					"id": 705490261,
					"content": "몬드 사람들은 겉으론 자유분방해 보여도, 술을 마실 때 「선」을 지킬 줄 아는 것 같아. 대단해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490262
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490262,
					"content": "참, 에밀리도 왔었어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490263
					]
				},
				{
					"id": 705490263,
					"content": "오? 벌써 의뢰를 끝냈나 보군. 빠르네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490264
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490264,
					"content": "폰타인으로 돌아가면, 시그윈한테 새 향수 살 준비를 하라고 전해 줘야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490265
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490265,
					"content": "어, 에밀리를 잘 아시나 보네요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490266
					]
				},
				{
					"id": 705490266,
					"content": "잘 아는 건 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490267
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490267,
					"content": "몬드로 오는 길에, 우연히 같은 배를 타게 돼서 잠깐 이야기를 나눴지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490268
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490268,
					"content": "전에 시그윈이 그 사람 작품을 자주 칭찬했는데, 이번에 직접 대화해 보니… 정말 흔치 않은, 담백한 사람이더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490269,
						705490270
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490269,
					"content": "담백한 사람?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490271
					]
				},
				{
					"id": 705490271,
					"content": "온화하고 침착하면서도, 타인과 적당한 거리를 유지할 줄 알아. 아마 직업적인 이유겠지. 마음의 평온을 유지하기 좋은, 이상적인 상태라고 생각해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490272,
						705490273
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490272,
					"content": "잘 모르겠어요…. 나중에 만날 자리를 만들어 볼까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490274
					]
				},
				{
					"id": 705490274,
					"content": "고마워. 하지만 일부러 친해질 자리를 만들어 줄 필요는 없어. 일적으로든 친구 관계로든 겹치는 부분이 거의 없거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490275
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490275,
					"content": "자연스럽게 두는 게 나아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490276
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490276,
					"content": "에밀리는 차를 좋아하던데, 클로린드 씨는 어떠세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490277
					]
				},
				{
					"id": 705490277,
					"content": "설마, 벌써 우리한테 뭘 대접할지 생각하고 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490278
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490278,
					"content": "지금까지의 경험으로 보면, 내가 감당할 수 있는 도수는 에밀리 씨와 비슷할 거야. 과일 리큐르 정도가 한계일걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490279
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490279,
					"content": "그때는 이런 음료를 준비해 두는 게 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490280
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490280,
					"content": "레시피를 개선할 방법을 찾았어요. 잠시만 기다려 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490281
					]
				},
				{
					"id": 705490281,
					"content": "그래, 나도 마음의 준비는 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490282
					],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490282,
					"content": "술이 조금 독하더라도, 최대한 다 마셔볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "클로린드"
				},
				{
					"id": 705490273,
					"content": "폰타인으로 돌아간 뒤에 같이 만나는 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490274
					]
				},
				{
					"id": 705490270,
					"content": "심오한 표현이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490271
					]
				},
				{
					"id": 705490260,
					"content": "몬드에선 퇴근하고 술 한잔하며 쉬는 게 일상이죠!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490261
					]
				},
				{
					"id": 705490254,
					"content": "기사단은 정말 인원이 많네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490255
					]
				},
				{
					"id": 705490247,
					"content": "몬드의 고기 요리는 다 맛보신 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490248
					]
				},
				{
					"id": 705490236,
					"content": "검의 재료도 되게 복잡하네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490237
					]
				},
				{
					"id": 705490232,
					"content": "비유가 정말 독특하시네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490233
					]
				},
				{
					"id": 705490227,
					"content": "왜요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490228
					]
				},
				{
					"id": 705490220,
					"content": "만족하실 수 있도록 레시피를 조정해야겠어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490221
					]
				},
				{
					"id": 705490213,
					"content": "양 조절만 잘하면 괜찮을 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490214
					]
				},
				{
					"id": 705490209,
					"content": "평소에 술을 안 드시면 무리하지 마세요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490210
					]
				},
				{
					"id": 705490205,
					"content": "물 한 잔 드릴까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490206
					]
				}
			]
		},
