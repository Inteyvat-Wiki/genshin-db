			"dialogs": [
				{
					"id": 705490301,
					"content": "이 신메뉴의 이름은… 「여유로운 뇌광」입니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490302
					]
				},
				{
					"id": 705490302,
					"content": "결투 대리인 전용 특제 칵테일이에요, 드셔보세요!",
					"roleType": "TALK_ROLE_PLAYER",
