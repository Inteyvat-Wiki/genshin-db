					"nextDialogs": [
						150020309
					],
					"speakerTitle": "와이나",
					"speakerSubtitle": "나무살이 족장"
				},
				{
					"id": 150020309,
					"content": "다만 부탁이 있어. 너희가 산왕의 안전을 지켜줬으면 해",
