			"dialogs": [
				{
					"id": 150020201,
					"content": "#{NICKNAME}, 페이몬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020202
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 150020202,
					"content": "키니치! 여기서 다 보네! 안 그래도 너한테 가볼까 했었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150020203,
					"content": "안녕, 또 만났네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020204
					]
				},
				{
					"id": 150020204,
					"content": "단도직입적으로 말할게. 너희, 트리니다드 장로의 초청을 받았지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020205
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 150020205,
					"content": "아! 그 회고의 밤 말이야? 어… 장로도 원래는 널 초청하려고 했대…. 근데 그게… 뭐랄까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150020206,
					"content": "긴장할 거 없어. 난 중요한 일을 알려주러 온 거야. 그 사람은 진짜 목적을 숨기고 있을지도 몰라. 그자는 산왕 문제를 영구히 해결하려고 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020207
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 150020207,
					"content": "영구히 해결한다고? 앞으로 회고의 밤을 안 연다는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150020208,
					"content": "맞아. 너희 손을 빌려 산왕을 밤의 신의 나라로 돌려보내려는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020209
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 150020209,
					"content": "밤의 신의 나라로 돌려보낸다니…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150020210,
					"content": "산왕을 죽이겠다는 뜻이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020211
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 150020211,
					"content": "잠깐, 잠깐만! 너무 단도직입적이라… 잘 믿겨지지가 않아…. 그게 진짜야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150020212,
					"content": "돌려 말해주길 바라는 거야? 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020213
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 150020213,
					"content": "혹시 어쩌면 아마도 장로는… 너희가 산왕을 죽여주길 바라고 있는지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020214
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 150020214,
					"content": "세상에… 산왕은 너희의 살아있는 영광이라며?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150020215,
					"content": "영광에는 대가가 따르는 법이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020216
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 150020216,
					"content": "그래. 산왕은 우리의 살아있는 영광이야. 하지만 그 영광엔 대가도 따르고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020217
					],
					"speakerTitle": "트리니다드",
					"speakerSubtitle": "나무살이 장로"
				},
				{
					"id": 150020217,
					"content": "하아… 게다가 희생된 건 난나가 처음이 아니야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020218
					],
					"speakerTitle": "트리니다드",
					"speakerSubtitle": "나무살이 장로"
				},
				{
					"id": 150020218,
					"content": "용 동료 난나 때문인가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020219
					]
				},
				{
					"id": 150020219,
					"content": "어. 난나 뒤에도 피해자는 더 있었을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020220
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 150020220,
					"content": "그치만… 그렇다고 산왕을 죽인다니? 너무 극단적인 거 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150020221,
					"content": "근데 산왕을 어떻게 죽여?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020222
					]
				},
				{
					"id": 150020222,
					"content": "산왕 몸의 심연 오염은 평범한 재해와 달라. 수백 년 동안 사악한 힘에 잠식된 육신은 돌이킬 수 없을 정도로 심연화됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020223
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 150020223,
					"content": "심연의 힘은 그를 광기에 빠뜨렸지만, 동시에 그의 생명을 유지하고 있어. 한 마디로 그 힘을 완전히 제거하면 산왕은 영원히 잠든다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020224
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 150020224,
					"content": "지금까지의 의식은 심연의 힘을 절반 정도만 걷어냈어. 죽지도 깨지도 않는 균형을 이뤘다고 볼 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020225
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 150020225,
					"content": "장로한테 그 힘을 얼마나 없애야 하는지는 아직 못 들었어…. 오늘 자세히 얘기해 준다고 했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020226
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150020226,
					"content": "그럼 곧 알게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020227
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 150020227,
					"content": "…장로가 정말 산왕을 죽이고 싶어 하면, 우린 어떻게 해야 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020228,
						150020229
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150020228,
					"content": "곤란한 상황이 됐네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020230
					]
				},
				{
					"id": 150020230,
					"content": "너희에겐 다소 충격적인 정보겠지만 일단 모른척해줘. 이따 트리니다드 장로와 이야기를 마치면 족장님 쪽으로 와줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020231
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 150020231,
					"content": "너희랑 거래를 하고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020232
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 150020232,
					"content": "거래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020233
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150020233,
					"content": "꽤 괜찮은 가격을 제시할 생각이야. 너희도 아직 궁금한 게 많을 테니, 좋은 기회가 되겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020234
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 150020234,
					"content": "이따 바로 갈게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020235
					]
				},
				{
					"id": 150020235,
					"content": "그럼 이따 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "키니치"
				},
				{
					"id": 150020229,
					"content": "이제 와서 발을 빼기도 그렇고",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020230
					]
				}
			]
		},
