			"dialogs": [
				{
					"id": 701080401,
					"content": "안녕, 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080402
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 701080402,
					"content": "당신한테 보내는 편지예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080403
					]
				},
				{
					"id": 701080403,
					"content": "편지? 음… 그녀잖아? 이번에도 분명 탐험대 일 때문이겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080404
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 701080404,
					"content": "휴, 이건 나도 어쩔 수 없어. 설산은 너무 위험해서 거길 갈 수 있는 탐험대도 몇 없단 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080405
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 701080405,
					"content": "답신을 금방 써 줄 테니까 가서 그녀에게 설명 좀 잘 해줘. 그리고 편지 전해줘서 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080406
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 701080406,
					"content": "참, 이건 저번에 그녀가 부탁해서 준비해둔 보수니까 받아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080407
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 701080407,
					"content": "그리고… 한마디만 더 하자면, 꽤 능력 있는 모험가 같은데 그래도 설산에서는 뭐든지 조심하도록 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080410
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 701080410,
					"content": "휴, 설산이라… 나도 기회만 된다면 탐험대를 이끌고 가보고 싶군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사이러스"
				}
