			"dialogs": [
				{
					"id": 701080301,
					"content": "비콘은 잘 놓고 왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080302
					],
					"speakerTitle": "에스더"
				},
				{
					"id": 701080302,
					"content": "잘 두고 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080303
					]
				},
				{
					"id": 701080303,
					"content": "우와, 고마워. 이제 설산의 고도를 정확히 측정할 수 있겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080304
					],
					"speakerTitle": "에스더"
				},
				{
					"id": 701080304,
					"content": "참, 보수는 사이러스 씨에게 부탁해뒀으니까 가서 받도록 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080305
					],
					"speakerTitle": "에스더"
				},
				{
					"id": 701080305,
					"content": "그리고 가는 김에 이 편지도 전해줘. 저번에 2차 설산 탐험대를 꾸려주겠다더니 지금까지 감감무소식이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080306
					],
					"speakerTitle": "에스더"
				},
				{
					"id": 701080306,
					"content": "비콘들을 고치고 나면 다시 한번 싹 배치하러 산에 가봐야 해. 이 설산에는 조사할 게 아직도 산더미라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "에스더"
				}
			]
		},
