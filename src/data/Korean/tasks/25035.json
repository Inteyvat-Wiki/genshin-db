			"dialogs": [
				{
					"id": 250350801,
					"content": "두 개… 세 개… 다 모았네. 다행이다, 잃어버린 우편물을 모두 찾았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350802
					],
					"speakerTitle": "미치카"
				},
				{
					"id": 250350802,
					"content": "…잠깐, 이 우편물 툰다마가 보내기로 한 거잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350803
					],
					"speakerTitle": "미치카"
				},
				{
					"id": 250350803,
					"content": "도와줘서 고마워, 이건 보수니까 받아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350804
					],
					"speakerTitle": "미치카"
				},
				{
					"id": 250350804,
					"content": "후… 툰다마 이 녀석이랑 담판을 지어야겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "미치카"
