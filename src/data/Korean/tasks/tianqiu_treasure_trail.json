			"dialogs": [
				{
					"id": 718120201,
					"content": "어때? 뭐 찾은 거 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120202
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 718120202,
					"content": "이걸 찾았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120203
					]
				},
				{
					"id": 718120203,
					"content": "이건… 한 번도 본적 없는 물건인데, 어디서 찾았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120205
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 718120205,
					"content": "둔옥릉 근처에서…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120206
					]
				},
				{
					"id": 718120206,
					"content": "둔옥릉? 왜 거기에 그런 게 있는 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120207
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 718120207,
					"content": "단서를 풀어줘서 고마워. 모험가 길드의 규칙에 따라, 이 물건은 네게 줄게. 이 보수도 받아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120208
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 718120208,
					"content": "나도 최대한 빨리 사람을 구해서 둔옥릉 쪽을 더 자세히 수색해 봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120209
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 718120209,
					"content": "이상하네…. 둔옥릉 일대는 몇 번이나 수색했는데, 어째서 빠진 곳이 있는 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "란 누님"
				}
			]
		},
