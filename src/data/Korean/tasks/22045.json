			"dialogs": [
				{
					"id": 220450401,
					"content": "어때요, 사진은 좀 건졌나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450402
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220450402,
					"content": "찍어 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450403
					]
				},
				{
					"id": 220450403,
					"content": "어디 보자… 오오! 이 각도, 이 자세, 정말 좋은데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450404,
						220450405
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220450404,
					"content": "기세가…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450406
					]
				},
				{
					"id": 220450406,
					"content": "완전, 참고 자료로 쓰기에 딱 좋은 사진들이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450407
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220450407,
					"content": "도와줘서 고마워, 여행자. 이걸 받아줘, 난 조금 이따 마저 조각 연습하러 가야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450408
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220450408,
					"content": "이야, 정말 괜찮은 사진이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220450405,
					"content": "이런 걸로 참고가 될까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450406
					]
				}
			]
