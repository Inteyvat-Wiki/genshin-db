				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"동욱",
					"카메이 무네히사"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210201,
					"content": "이거면 되겠다. 고마워, 여행자. 음~ 이 향기, 냄새만 맡아도 군침이 도는 걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210202
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220210202,
					"content": "먼저 맛 좀 볼게… 유후, 맛있는데! 딱 알맞게 익었고 냄새도 끝내줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210203
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220210203,
					"content": "「완벽한 진주비취백옥탕」이라고 할 만해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210204
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220210204,
					"content": "무네히사 아저씨, 잘 돼 가요? 아저씨도 얼른 여행자한테 시식을 부탁해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210205
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220210205,
					"content": "윽, 실수했습니다. 요리를 시작하고 나서야 새알이 부족하다는 것을 알아차렸어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210206
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220210206,
					"content": "곧바로 근처의 숲에서 새알을 수집했지만, 다른 식자재들은 조리 타이밍을 놓쳤습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210207
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220210207,
					"content": "신선도가 떨어진 식자재들로 요리한 「삼미 꼬치」는 이제 훌륭한 요리라고 할 수 없습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210208
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220210208,
					"content": "이런 실수를 하다니, 면목이 없습니다. 요리의 길은 아직 멀군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210209
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220210209,
					"content": "이번엔 제가 졌습니다. 하지만 다음엔 이길 겁니다, 동욱 님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210210,
						220210214
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220210210,
					"content": "파이팅입니다, 아저씨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210211
					]
				},
				{
					"id": 220210211,
					"content": "헤헤, 하지만 나도 쉽게 져주진 않을 거라구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210212
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220210212,
					"content": "참, 이거 받아줘. 나랑 아저씨의 대결 때문에 고생했잖아, 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210213
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220210213,
					"content": "다음번 대결에도 꼭 와줘야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동욱"
				},
				{
					"id": 220210214,
					"content": "맛은 그럭저럭 괜찮은 거 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210215
					]
				},
				{
					"id": 220210215,
					"content": "아닙니다. 요리라 해도 최고를 좇는 마음으로 임해야 합니다. 요리의 「극한」를 추구해야지 「그럭저럭」에 만족해서는 절대 안 됩니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210216
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220210216,
					"content": "그래야만 요리의 길에서 난관을 극복할 수 있습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210217
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220210217,
					"content": "아… 넵!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210218
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220210218,
					"content": "아… 넵!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210219
					]
				},
				{
					"id": 220210219,
					"content": "그건 무예의 길이자 요리의 길이고, 제 길이이기도 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210220
					],
					"speakerTitle": "카메이 무네히사"
				},
				{
					"id": 220210220,
					"content": "아… 네! 파이팅이에요, 무네히사 아저씨… 파이팅, 하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210221
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220210221,
					"content": "으윽… 난… 진지한 사람들과는 대화를 못 하겠어… 무네히사 아저씨를 상대할 수 있는 건 줄리뿐인데 하필 지금 여기 없고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210222
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220210222,
					"content": "완전히 기세에 눌렸어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210223
					]
				},
				{
					"id": 220210223,
					"content": "크흠, 어쨌든 수고했어, 여행자. 이 이걸 받아줘, 난…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210224
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 220210224,
					"content": "동욱 님, 요리에 대해 궁금한 점이 있는데 지금 혹시 시간 괜찮으십니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210225
					],
					"speakerTitle": "카메이 무네히사"
