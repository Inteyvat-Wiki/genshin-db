			},
			"dialogs": [
				{
					"id": 728120201,
					"content": "좋아, 이야기는 여기까지야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120202
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 728120202,
					"content": "한 번도 이렇게 힘들었던 적이 없는데, 이 이야기가 그렇게 복잡한가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120203
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 728120203,
					"content": "이게 네가 사전에 설정을 정하지 않은 결과야. 설정에 제한받지 않으니까, 소설의 요소들이 전부 엉망진창 충돌하는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120204
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 728120204,
					"content": "이런 상황에서, 네 이야기는 아무런 장악력도 없고, 뭘 쓰든 간에 엄청나게 힘들어질 걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120205
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 728120205,
					"content": "에휴, 너랑 싸울 힘도 없어… 여행자, 대신 판단 내려줘서… 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120206
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 728120206,
					"content": "덕분에… 얻은 게 많네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120207
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 728120207,
					"content": "여기 사례를 받아줘, 좀 이따 마저 소설을 쓰러 가야겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120208
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 728120208,
					"content": "설정과 스토리, 에휴… 도대체 뭐가 더 중요할까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쥰키치"
				}
			]
		}
