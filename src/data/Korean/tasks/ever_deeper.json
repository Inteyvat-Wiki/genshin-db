			"dialogs": [
				{
					"id": 1903201201,
					"content": "어휴, 피곤해. 드디어 쉴 수 있겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201202
					],
					"speakerTitle": "주양"
				},
				{
					"id": 1903201202,
					"content": "너무 심했나. 몇 명은 놀라서 기절할뻔한 것 같던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201203
					],
					"speakerTitle": "주양"
				},
				{
					"id": 1903201203,
					"content": "당신은?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201204
					]
				},
				{
					"id": 1903201204,
					"content": "으아, 여긴 출입 금지야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201205
					],
					"speakerTitle": "주양"
				},
				{
					"id": 1903201205,
					"content": "아이, 됐어. 다 들었지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201206
					],
					"speakerTitle": "주양"
				},
				{
					"id": 1903201206,
					"content": "난 여기서 귀신 역할을 맡고 있는 사람이야. 마침 쉬는 시간이라 덥고 바람도 안 통하는 그 옷을 벗어버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201207,
						1903201208
					],
					"speakerTitle": "주양"
				},
				{
					"id": 1903201207,
					"content": "역시 여기에 귀신은 없는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				},
				{
					"id": 1903201209,
					"content": "당연하지. 세상에 귀신이 어디 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201210
					],
					"speakerTitle": "주양"
				},
				{
					"id": 1903201210,
					"content": "우리나 담력 시험에 참가한 사람이나, 진짜 귀신을 만나고 싶어 하는 사람은 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201211
					],
					"speakerTitle": "주양"
				},
				{
					"id": 1903201211,
					"content": "사람들이 원하는 건 무서운 분위기 혹은 어떤 계기야. 중요한 건 그 짜릿한 스릴이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201212
					],
					"speakerTitle": "주양"
				},
				{
					"id": 1903201212,
					"content": "긴장한 상태에서 예상치 못한 일이 생기면, 분위기에 휩쓸려 평소에 못 했던 말을 할 수 있어. 그게 바로 담력 시험의 역할이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201213,
						1903201214
					],
					"speakerTitle": "주양"
				},
				{
					"id": 1903201213,
					"content": "저도 그렇게 생각해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201215,
					"content": "자, 난 이제 일하러 가봐야겠어. 너도 친구랑 좋은 시간 보내",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "주양"
				},
				{
					"id": 1903201214,
					"content": "(중운이 실망하겠네)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201208,
					"content": "역시 다 속임수죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				}
			]
		}
	]
