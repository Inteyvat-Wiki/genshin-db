				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205040101,
					"content": "어서 와, 여기 있는 보물은 세상에 단 하나뿐이란다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040102
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 205040102,
					"content": "전부 처음 보는 것들이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 205040103,
					"content": "하하하, 당연하지. 이것들은 모두 모험가들이 세계 각지에서 찾아낸 희귀한 보물들이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040104
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 205040104,
					"content": "어때, 마음에 드는 거 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040105,
						205040106
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 205040105,
					"content": "다 비싸보이는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				},
				{
					"id": 205040107,
					"content": "아니야. 내가 깜빡하고 말을 안 했네, 우리 상점은 모라를 받는 대신 물물교환을 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040108
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 205040108,
					"content": "요즘 내가 특별한 공예품을 만들려 하는데, 장식에 <color=#00E1FFFF>「바람의 인장」</color>이 많이 필요하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040109
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 205040109,
					"content": "너희들 <color=#00E1FFFF>「바람의 인장」</color>을 가지고 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040110,
						205040112
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 205040110,
					"content": "몇 개 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040111
					]
				},
				{
					"id": 205040111,
					"content": "하하, 바람의 신께서 네 모험을 인정하셨나보구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 205040114,
					"content": "어쨌든, <color=#00E1FFFF>「바람의 인장」</color>만 있다면 우리 상점의 모든 상품과 교환할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040115
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 205040115,
					"content": "상품 고르기",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205040112,
					"content": "그게 뭐예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040113
					]
				},
				{
					"id": 205040113,
					"content": "그건 바람의 신께서 인정한 모험가들한테만 주는 인장이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 205040106,
					"content": "가격을 물어보기 무섭네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				}
			]
		},
