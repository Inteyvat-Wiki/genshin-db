			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"자등"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320101,
					"content": "음, 그림과 시를… 아니아니, 시를 그림과…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320102
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320102,
					"content": "어… 아니지, 이 두 문장은 같은 뜻인 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320103,
						250320104
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320103,
					"content": "무슨 말을 하시는 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				},
				{
					"id": 250320105,
					"content": "안녕. 맞아, 나타의 풍경을 주제로 시를 쓰고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320106
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320106,
					"content": "그런데… 솔직히 나타 풍경은 리월이랑 전혀 다른 데다, 나타의 역사나 이야기도 몰라서. 어떻게 써야 할지 도무지 감이 안 잡혀",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320107
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320107,
					"content": "게다가 난 전문 시인도 아니거든. 운율감이 뛰어난 것도 아니고, 해학시도 잘 못 쓰니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320108
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320108,
					"content": "휴, 그래도 이렇게 나왔는데 빈손으로 돌아갈 순 없잖아. 그럼 총무부 동료들이 나한테 「영감을 찾으러 간다더니 빈손으로 왔다」고 하지 않겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320109
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320109,
					"content": "총무부에서 일하세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320110
					]
				},
				{
					"id": 250320110,
					"content": "뭐, 그런 셈이지. 얼마 전에 총무부에 고용되어서 토지 측량 업무를 맡았거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320111
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320111,
					"content": "하하, 정확히 말하자면 사람들과 함께 리월을 돌아다니면서 물과 흙의 변화를 살펴보고 지도에 수정이 필요한지 알아보는 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320112
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320112,
					"content": "리월을 한 바퀴 돌았더니 얼마나 힘든지 몰라. 신발 몇 켤레를 갈아치웠는지도 모르겠어… 그래서 휴가를 내고 기분 전환 겸 나온 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320113
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320113,
					"content": "그때… 대체 내가 무슨 생각을 했는지는 모르겠지만, 휴가 신청서에 「시를 짓고 싶으니, 영감 찾으러 가겠습니다」라고 썼거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320114
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320114,
					"content": "그런데 총무부의 휴가 신청을 승인하는 사람이 「시의 길이 순조롭길」이라고 진지한 답장을 보내온 거야… 그리고 보름 정도의 휴가를 줬어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320115,
						250320117
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320115,
					"content": "좋은 거 아니에요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320116
					]
				},
				{
					"id": 250320116,
					"content": "좋아? 내 휴가 신청서를… 총무부 전체가 다 아는 상황이라니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320119,
					"content": "후우, 나타가 재밌는 곳이긴 해. 풍경도 좋고 음식도 맛있고, 재미있는 생물도 많지. 특히 그 아기 용들도 너무 귀엽게 생겼고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320120
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320120,
					"content": "하지만 아직까지 시 한 줄도 못 썼어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320121
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320121,
					"content": "소재 때문에 특별히 사진기를 빌려왔는데, 전혀 쓸모가 없더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320122
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320122,
					"content": "자연 경관을 찍는 건 괜찮은데, 가게나 사람들을 찍으면 볼 수도 없는 사진이 나와버리니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320123,
						250320124
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320123,
					"content": "저기, 제가 좀 도와드릴까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320125,
					"content": "정말?! 다행이다, 드디어 날 도와줄 사람이 생겼네… 어쨌든 먼저 시를 쓸 소재를 모아야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320126
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320126,
					"content": "어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자등"
				},
				{
					"id": 250320124,
					"content": "사진 찍는 건 제 전문이거든요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320117,
					"content": "그래서 시의 길은 순조롭나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320118
					]
				},
				{
					"id": 250320118,
					"content": "아니, 전혀. 하지만… 내 휴가 신청서는 아주 「순조롭게」 진행됐어. 총무부 모두가 내가 시를 쓰러 나타에 간 걸 알고 있다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320104,
					"content": "시 쓰고 계신 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				}
			]
		},
		{
			"id": 2503206,
