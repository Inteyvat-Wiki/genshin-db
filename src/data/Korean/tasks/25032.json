			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"자등"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320601,
					"content": "왔어? 사진은 다 찍었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320602
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320602,
					"content": "다 찍었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320603
					]
				},
				{
					"id": 250320603,
					"content": "허… 잘 찍었군. 내 조수보다 더 잘 찍었어. 조수는 탐사 장소를 사진으로 남길 때마다 몇 번씩 찍어야 했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320604
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320604,
					"content": "네가 나랑 토지 측량을 하러 가면, 사진기를 훨씬 덜 쓸 수 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320605
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320605,
					"content": "이 사진들로 정말 시를 쓸 수 있을까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320606
					]
				},
				{
					"id": 250320606,
					"content": "아마도… 가능할 거야. 휴, 정 안 되면 이 사진들을 엽서로 써야지 뭐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320607
					],
					"speakerTitle": "자등"
				},
				{
					"id": 250320607,
