			"dialogs": [
				{
					"id": 191170106,
					"content": "멍! 멍멍!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170107
					],
					"speakerTitle": "닌자견"
				},
				{
					"id": 191170107,
					"content": "사나워라! 또 물릴 뻔했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170108
					],
					"speakerTitle": "토마"
				},
				{
					"id": 191170108,
					"content": "너 말이야, 쫄쫄 굶었지? 이제 뭐라도 좀 먹어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170109
					],
					"speakerTitle": "토마"
				},
				{
					"id": 191170109,
					"content": "나랑 같이 갈 생각이 없다 해도, 아무것도 안 먹을 필욘 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170110
					],
					"speakerTitle": "토마"
				},
				{
					"id": 191170110,
					"content": "설마 음식에 독이 있을까 봐 그래? 내가 직접 먹어볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170121
					],
					"speakerTitle": "토마"
				},
				{
					"id": 191170121,
					"content": "봐, 괜찮잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170111,
						191170112
					],
					"speakerTitle": "토마"
				},
				{
					"id": 191170111,
					"content": "토마 씨…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				},
				{
					"id": 191170113,
					"content": "자, 조금이라도 먹어. 먹으면 오늘은 더 방해 안 할게, 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170114
					],
					"speakerTitle": "토마"
				},
				{
					"id": 191170114,
					"content": "멍! 멍멍!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170115
					],
					"speakerTitle": "닌자견"
				},
				{
					"id": 191170115,
					"content": "전혀 먹으려고 하지 않네…. 왠지 초조해 보여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170116
					],
					"speakerTitle": "토마"
				},
				{
					"id": 191170116,
					"content": "바다에 뭐가 있는 걸까? 아님 주변에 경계할 거라도 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170117
					],
					"speakerTitle": "토마"
				},
				{
					"id": 191170117,
					"content": "마물들 때문 아닐까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170118
					]
				},
				{
					"id": 191170118,
					"content": "주변 마물에게 공격받았단 거야…? 그럴 수도 있겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170119
					],
					"speakerTitle": "토마"
				},
				{
					"id": 191170119,
					"content": "사람도 위험한 상황에선 밥이 안 넘어가니까, 우리가 대신 주변을 처리하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170120
					],
					"speakerTitle": "토마"
				},
				{
					"id": 191170120,
					"content": "#{NICKNAME}, 같이 해줘서 고마워. 여길 좀 치워주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "토마"
				},
				{
					"id": 191170112,
					"content": "엄청 열심이네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				}
			]
		}
