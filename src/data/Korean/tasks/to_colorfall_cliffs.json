					"speakerTitle": "베넷"
				},
				{
					"id": 150400715,
					"content": "경쟁 요소가 있는 도전이야말로 평범한 이벤트를 설레는 모험으로 바꿔주니까, 그 스릴을 즐기고 싶대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400716
					],
					"speakerTitle": "베넷"
				},
