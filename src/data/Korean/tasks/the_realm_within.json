				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140101,
					"content": "세상만사 인생무상…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140102,
						10140105
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140102,
					"content": "안녕하세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140103
					]
				},
				{
					"id": 10140103,
					"content": "음? 젊은이, 꽃을 보러 왔나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140104
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140104,
					"content": "아쉽지만, 이 「유리 백합」은 곧 시들 것 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140107,
					"content": "이 꽃들은… 어째서 시들어버린 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10140108,
					"content": "그때 그 시절엔 다들 「유리 백합」이 인간의 감정을 이해한다고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140109
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140109,
					"content": "웃음소리나 노랫소리 같은 좋은 소리가 들리면… 이 꽃들도 같이 기뻐하며 잘 자라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140110
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140110,
					"content": "반대로 유언비어 같은 안 좋은 소리를 들으면, 빨리 시들어 버린다지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140111
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140111,
					"content": "…그러니까 지금 리월의 상황이 이 모양이라 꽃들도 시들어 버린 거네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10140112,
					"content": "그래. 암왕제군님이 돌아가셨다는 소문이 퍼지고 나서, 온 동네에 별의별 이야기가 다 떠돌고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140113
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140113,
					"content": "우인단의 음모라고 하는 이들도 있고, 「바닷속의 그것」이 날뛰기 시작했다는 이들도 있고, 칠성이 꾸민 자작극이라는 이들도 있다네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140114
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140114,
					"content": "이 항구 도시는 장작더미와 같아. 작은 불씨로도 걷잡을 수 없을 정도로 불타오르지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140115
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140115,
					"content": "에휴, 그만하마. 나이가 들어서 그런지 말이 길어졌군…. 그래서 젊은이, 이 늙은이한텐 무슨 볼일인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140116,
						10140121
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140116,
					"content": "「척진령」을 빌리러 왔어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140117
					]
				},
				{
					"id": 10140117,
					"content": "아, 그 낡은 물건 말인가…. 내가 보관하고 있긴 한데, 어디에 뒀는지는… 기억이 가물가물하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140118
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140118,
					"content": "그건 내가 젊었을 때, 내 친구가 몸에 지니고 다니던 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140119
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140119,
					"content": "내가 계속 뚫어져라 쳐다보니, 그 방울을 선물로 주더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140120
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140120,
					"content": "하지만 그는 만약 나중에 누가 이 방울을 빌리러 오면, 주저 없이 내어주라고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140127,
					"content": "옛날엔 사람들이 종종 빌려가곤 했었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140128
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140128,
					"content": "언제부턴가는 아무도 빌리러 오지 않더구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140129
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140129,
					"content": "에휴, 이 늙은 몸으로 그걸 찾으려면 시간이 좀 걸릴 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140130,
						10140133
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140130,
					"content": "저희가 찾을게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140131
					]
				},
				{
					"id": 10140131,
					"content": "맞아, 할머니, 우리가 집으로 모셔다드릴게. 그러고 나서 우리가 직접 찾으면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140132
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10140132,
					"content": "음… 그리고 찾는 김에 집 청소도 해줄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10140135,
					"content": "하하, 방울이 그리 멀리 있진 않으니 너무 걱정 말렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140136
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140136,
					"content": "엥? 그럼 할머니 이 근처에 사는 거야? 우와… 여긴 옥경대인데, 부자다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140137
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10140137,
					"content": "허허, 이 늙은이가 무슨 능력으로 시내에서 살겠나——내가 가진 모든 가산은 이 주전자 안에 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140138
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140138,
					"content": "모든 가산…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140139,
						10140140,
						10140143
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10140139,
					"content": "집 열쇠를 안에 넣으셨다는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140146
					]
				},
				{
					"id": 10140146,
					"content": "허허허… 어쨌든 방울은 이 주전자 안에 있으니, 방울을 찾고 싶다면 직접 찾아 보렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140140,
					"content": "전 재산이 고작 방울 하나라고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140141
					]
				},
				{
					"id": 10140141,
					"content": "그런 말은 너무 무례하잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140142
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10140142,
					"content": "어, 엄청 비싼 방울일 거야…! 그치, 할머니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10140143,
					"content": "페이몬이 주전자 안에 들어가서 찾아보면 되겠다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140144
					]
				},
				{
					"id": 10140144,
					"content": "못 들어가! 내가 저길 어떻게 들어가?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140145
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10140145,
					"content": "그리고 왜 내가 들어가야 되는데? 그냥 뚜껑 열고 보면 되잖아!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10140133,
					"content": "페보니우스 기사단의 단장에게 물건 찾는 법을 배운 적이 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140134
					]
				},
				{
					"id": 10140134,
					"content": "음… 이상한 포인트에서 갑자기 의기양양해지네?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10140121,
					"content": "할머니께 뭐 좀 빌리려구요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140122
					]
				},
				{
					"id": 10140122,
					"content": "응? 아… 「척진령」을 빌리러 왔구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140123
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140123,
					"content": "그 낡은 물건 말고는 젊은이한테 줄 만한 게 없다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140124
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140124,
					"content": "하지만 그 방울은 내 물건이 아닐세. 내 오랜 친구가 지니고 다녔던 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140125
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140125,
					"content": "젊었을 땐 예쁜 물건을 좋아해서 그걸 달라고 어찌나 졸라댔는지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140126
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140126,
					"content": "내 고집은 꺾을 수 없었는지 선물로 주더구나. 하지만 나중에라도 누군가 그 방울을 빌리러 온다면, 주저 없이 내어주라고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140105,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140106
					]
				},
				{
					"id": 10140106,
					"content": "아무것도 아니야. 그냥 「유리 백합」이 시드는 게 안타까워서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "평 할머니"
				}
			]
		},
		{
			"id": 101402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101406",
							"2"
						],
						"stepId": 101406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"평 할머니"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140201,
					"content": "너희들 방울 찾으러 온 거 아니었니? 어서 찾아봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140202
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140202,
					"content": "이 주전자는 오랫동안 청소를 안 했으니 조심하렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140203
					],
					"speakerTitle": "평 할머니"
				},
				{
					"id": 10140203,
					"content": "그 예쁜 옷이 더러워지면 빨래하기 힘들 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "평 할머니"
				}
			]
		},
