			"dialogs": [
				{
					"id": 20160601,
					"content": "여기야? 앞에 있는 저 <color=#00E1FFFF>장치</color>는…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160602,
					"content": "라이덴 쇼군의 기술을 재현할 수 있는 법구라고 해두자. 기억을 되살려 만들어봤어… 그녀의 무예가 퇴보하지만 않았다면 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160603
					],
