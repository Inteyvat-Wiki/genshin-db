	"talks": [
		{
			"id": 201601,
			"completionStepIds": [
				201601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201601",
							"2"
						],
						"stepId": 201601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"야에 미코"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20160101,
					"content": "따라해 봐, 「셋둘하나, 하나둘셋, 아아——」, 어서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160102,
						20160104
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160102,
					"content": "「셋둘하나, 하나둘셋, 아아——」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160103
					]
				},
				{
					"id": 20160103,
					"content": "그래, 잘했어. 적어도 머리엔 문제없어 보여. 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160106
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160106,
					"content": "땅에 꼬라박은 녀석을 겨우 건져 올렸는데, 망가지기라도 하면 너무 아깝잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160107
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160107,
					"content": "음, 미코, 아까부터 묻고 싶었는데 네 말투와 행동이 처음 봤을 때랑은 완전히 다른 거 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160108,
					"content": "그래? 다른 무녀들이 없어서 그런가. 그리고 난 항상 이랬는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160109
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160109,
					"content": "사람들은 늘 자기가 보여주고 싶은 모습을 보여주잖아. 이건 내가 잘 알지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160110
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160110,
					"content": "그러니 어떤 모습이든 다 진짜 「나」야. 사람들은 무의미한 정의를 내리는 걸 좋아할 뿐이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160111
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160111,
					"content": "인간에게 속한 사회에서 나도 내 마음 가는 대로 따라 하는 것뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160112
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160112,
					"content": "무슨 말인지 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160113,
					"content": "하하, 인간을 더 연구해 보면 너도 차차 알게 될 거야, 꼬마야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160114,
						20160115
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160114,
					"content": "대체 어떻게…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160116
					]
				},
				{
					"id": 20160116,
					"content": "그러게 말이야! 여행자 신경 쓰느라 네가 뭘 했는지 전혀 못 봤어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160117,
					"content": "「나루카미 다이샤 비전」으로 단번에 그 스카라무슈란 녀석을 무릎 꿇렸지. 믿겨져?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160118
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160118,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160119
					]
				},
				{
					"id": 20160119,
					"content": "후후, 그런 것보단 어떻게 내게 보답할지 생각해봐야지… 안 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160120
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160120,
					"content": "아니면 머리에 진짜 문제라도 생긴 건가…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160121
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160121,
					"content": "정말 고맙습니다, 야에 미코 님",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160122
					]
				},
				{
					"id": 20160122,
					"content": "이런 정중한 인사치레는 됐고 행동으로 보여줘, 후후",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160123
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160123,
					"content": "아직도… 「사안」 사건을 생각하고 있겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160124,
						20160125
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160124,
					"content": "맞아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160126
					]
				},
				{
					"id": 20160126,
					"content": "걱정 마. 와타츠미섬의 지도자가 부하들과 함께 소탕하러 갔어. 군대에 사안 사용 금지령도 내렸고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160127
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160127,
					"content": "거점이 다 드러난 마당에 스카라무슈도 굳이 동료 대신 나서서 망신을 자초하진 않겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160176
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160176,
					"content": "에휴, 시간 있으면 우인단이 애먹는 모습을 구경했을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160128
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160128,
					"content": "산고노미야 코코미란 여자, 정말 대단해. 만나서 얘기해보고 싶군. 신앙이 다른 게 걸림돌이라 아쉽지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160129
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160129,
					"content": "걸림돌? 넌 나루카미 다이샤의 궁사잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160130,
					"content": "어쨌든 다 너 안심시키려고 한 말이야. 그리고… 네가 해줘야 할 일이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160131,
						20160132
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160131,
					"content": "무슨 일이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160133
					]
				},
				{
					"id": 20160133,
					"content": "그녀를… 이미 만나봤겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160134,
						20160135
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160134,
					"content": "라이덴 쇼군?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160136
					]
				},
				{
					"id": 20160136,
					"content": "내가 말하는 건 그 「인형」이 아니야… 「그녀」를 본 적 있냐고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160137,
						20160138
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160137,
					"content": "혹시…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160139
					]
				},
				{
					"id": 20160139,
					"content": "그래, 「자기 자신」을 유지하고자 「일심정토」에서 끊임없이 명상하는 진정한 라이덴 쇼군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160140
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160140,
					"content": "——「에이(影)」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160141
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160141,
					"content": "의식에 등장하는 건 인형일 뿐이고, 진정한 라이덴 쇼군은 여행자가 나중에 본 그 사람이란 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160142
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160142,
					"content": "그러니까 그때 「장소」뿐만 아니라 「상대」도 바뀌었다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160143,
						20160144
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160143,
					"content": "나도 미묘한 차이를 느끼긴 했어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160145
					]
				},
				{
					"id": 20160145,
					"content": "그게 바로 라이덴 쇼군의 「영원함」이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160146
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160146,
					"content": "이 나라의 영원함을 추구하려면 먼저 스스로 영원함에 닿아야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160147
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160147,
					"content": "육신은 결국 흙으로 돌아가게 되니 「인형」의 몸을 빌리는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160148
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160148,
					"content": "정신도 결국엔 닳기 마련이니 그녀는 차고 다니는 검에 의식을 담고 명상으로 모든 혼돈을 회피했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160149
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160149,
					"content": "그럼 그녀가 검으로 벤 공간이 바로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160150
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160150,
					"content": "「일심정토」, 그녀의 「내면세계」와 같은 공간이고 「자기 자신」의 존재만 수용하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160151
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160151,
					"content": "자기만의 세계에 갇혀서, 외부의 모든 번잡함은 영원만을 좇는 인형에게 넘기는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160152
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160152,
					"content": "…이게 바로 에이(影)가 찾아낸 영원의 길이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160153,
						20160154
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160153,
					"content": "종려 씨도 「마모」를 언급한 적 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160155
					]
				},
				{
					"id": 20160155,
					"content": "모락스 말하는 건가? 오랫동안 못 봤는데, 리월의 신이 그런 선택을 했구나. 역시 재밌는 신이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160156
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160156,
					"content": "라이덴 쇼군의 방법으론 확실히 종려가 말한 문제를 피할 수 있을 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160157
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160157,
					"content": "후후, 근데… 꼭 화나서 방에 틀어박힌 어린애가 할 법한 행동 같지 않니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160158
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160158,
					"content": "그녀가 말하는 「영원함」도 이미 그녀가 생각하는 「영원함」이 돼버렸고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160159
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160159,
					"content": "결국… 잃는 게 두려운 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160160
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160160,
					"content": "뭘 부탁하려는 건지 모르겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160161
					]
				},
				{
					"id": 20160161,
					"content": "사실… 우리 둘의 입장은 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160162
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160162,
					"content": "나도 너처럼 안수령에서 이나즈마 백성을 구하고 싶어. 난 더 나아가서 이 나라와 그녀까지도 구하고 싶은 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160163
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160163,
					"content": "중요한 건——「일심정토」가 에이(影)의 내면세계를 대변하는 이상, 거기서 그녀를 쓰러트리면 라이덴 쇼군의 의지를 「뒤바꿀」 수도 있다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160164
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160164,
					"content": "그게 네가 생각한 안수령을 폐지하는 방법이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160165
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160165,
					"content": "말로 반박하는 것도, 저항군의 힘을 빌려 정변을 일으키는 것도 아니라… 아예 라이덴 쇼군의 내면세계를 뒤바꾼다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160166
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160166,
					"content": "이해가 빠르네. 요컨대 이건 「어둠의 영원」에 빠지기 전에 이나즈마를 정상으로 되돌릴 수 있는 유일한 방법이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160167,
						20160168
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160167,
					"content": "근데 왜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160169
					]
				},
				{
					"id": 20160169,
					"content": "아직도 네가 어디가 특별한지 모르겠어? 「일심정토」는 자기 자신만이 존재할 수 있는 공간이라고 했잖아. 네가 그곳에 나타났다는 건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160170
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160170,
					"content": "…그녀가 너한테 흥미를 느꼈다는 거지. 어쩌면… 그녀도 영원함에 있어 이렇게 「불안정」해 보이는 개체는 처음 봤을 수도",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160171
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160171,
					"content": "다른 사람이 들어간 적은 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160172
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160172,
					"content": "그 영원함의 신도가 그곳에 자기 자신을 가둔 이래로 단 한 번도 없었어. 그 공간이 어떻게 생겼는지조차 아무도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160173
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160173,
					"content": "네 존재는 기회이자 「열쇠」지… 역시 넌 내 기대를 저버리지 않았구나, 꼬마야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160174
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160174,
					"content": "어, 갑자기 어디 가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160175
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160175,
					"content": "<color=#00E1FFFF>「반 라이덴 쇼군 특훈」</color>. 널 위해 특별히 준비했으니 따라와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160168,
					"content": "하필 나예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160169
					]
				},
				{
					"id": 20160154,
					"content": "그가 신위에서 물러난 이유 중 하나이기도 하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160155
					]
				},
				{
					"id": 20160144,
					"content": "근데 왜 그렇게까지 하는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160145
					]
				},
				{
					"id": 20160138,
					"content": "그 「공간」 속에 있는?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160139
					]
				},
				{
					"id": 20160135,
					"content": "신상 아래의 의식에서 봤어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160136
					]
				},
				{
					"id": 20160132,
					"content": "그래서 절 구해준 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160133
					]
				},
				{
					"id": 20160125,
					"content": "그 뒤로 어떻게 됐죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160126
					]
				},
				{
					"id": 20160115,
					"content": "스카라무슈한테서 절 구한 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160116
					]
				},
				{
					"id": 20160104,
					"content": "야에 미코!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160105
					]
				},
				{
					"id": 20160105,
					"content": "어? 날 바로 알아보네. 적어도 머리엔 문제없어 보여. 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160106
					],
					"speakerTitle": "야에 미코"
				}
			]
		},
