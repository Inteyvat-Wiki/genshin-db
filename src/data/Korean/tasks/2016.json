			},
			"dialogs": [
				{
					"id": 20160701,
					"content": "좋은 훈련이었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160702,
						20160703
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160702,
					"content": "별거 없네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160704
					]
				},
				{
					"id": 20160704,
					"content": "그나저나 미코 넌 라이덴 쇼군에 대해 어떻게 이렇게 많이 아는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160705
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160705,
					"content": "음, 나한테 묻는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160706
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160706,
					"content": "아마… 내가 「번개 신의 권속」이라 그렇겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160707
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160707,
					"content": "아! 드발린과 바르바토스의 관계 같은 거야? 전혀 몰랐네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160708
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160708,
					"content": "후후, 「여우 아가씨」인 내 모습에 더 관심 있어 보이네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160709,
						20160710
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160709,
					"content": "보고 싶어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160711
					]
				},
				{
					"id": 20160711,
					"content": "꿈 깨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160712
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160712,
					"content": "에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160713
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160713,
					"content": "사실 이상한 건 내 모습이 아니라 내가 그녀랑 더 이상 만나지 않는다는 거지, 안 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160714
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160714,
					"content": "「영원불변의 나라」는 우리 둘의 공통된 꿈이지만, 난 그게 완전한 「정지」를 의미한다고 생각하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160715
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160715,
					"content": "어느 순간부터 그녀는 내가 닿을 수 없는 길을 걷기 시작했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160716
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160716,
					"content": "「일심정토」를 밟기 전 에이는 내게 작별조차 하지 않았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160717
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160717,
					"content": "나 혼자만의 바람이었나 봐. 이게 그녀가 우정을 영원히 유지하는 방법일 수도 있겠다 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160718
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160718,
					"content": "작별하지 않고 만나지도 않으면 우리의 관계가 영원히 그때처럼 유지될 거라고 생각하는 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160719,
						20160720
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160719,
					"content": "오히려 그 반대일 수도 있죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160721
					]
				},
				{
					"id": 20160721,
					"content": "서로 다른 영원의 길을 선택한 이상 난 현 상태를 유지할 수도 있고, 어떡해서든 그녀를 되돌려놓을 수도 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160722
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160722,
					"content": "내가 후자를 택한 이유는… 「일심정토」에 들어간 게 영원에 대한 그녀의 독단적인 결정이라면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160723
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160723,
					"content": "그녀를 자신만의 세계에서 빼내는 게 「영원의 권속」으로서의 내 역할이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160724
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160724,
					"content": "미코는… 정말 좋은 친구네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160725
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160725,
					"content": "훗, 내 계획을 쉽게 이해시키려고 말해준 것뿐이니까 우쭐거리지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160726
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160726,
					"content": "자, 얘기는 그만하고 <color=#00E1FFFF>「두 번째 반 라이덴 쇼군 훈련」</color>을 시작해볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160727
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160727,
					"content": "또 있었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20160720,
					"content": "라이덴 쇼군은 너무 편파적이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160721
					]
				},
				{
					"id": 20160710,
					"content": "완전 관심 있어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20160711
					]
				},
				{
