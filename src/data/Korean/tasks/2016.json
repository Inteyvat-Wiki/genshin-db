				},
				{
					"id": 20160502,
					"content": "계획을 세우기 전에 가장 중요한 게 뭔지 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20160503
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20160503,
					"content": "뭔데?",
