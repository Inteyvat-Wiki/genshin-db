						760440306
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 760440306,
					"content": "레셰크한테 가서 물어봐야겠어. 내 노련한 실력으로 뭔가 알아낼 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440307
					],
					"speakerTitle": "야호다"
				},
				{
					"id": 760440307,
