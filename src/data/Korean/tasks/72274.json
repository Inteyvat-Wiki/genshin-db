				"points": []
			},
			"dialogs": [
				{
					"id": 722740201,
					"content": "작전 계획이 누설되다니, 재수도 더럽게 없군!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740202
					],
					"speakerTitle": "우인단 선발대"
				},
				{
					"id": 722740202,
					"content": "그러게, 선생님은 급하게 명을 받고 스네즈나야로 돌아가셨다는군. 근데 와타츠미섬 계획은 계속 진행한다고 하던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740203
					],
					"speakerTitle": "우인단 선발대"
				},
				{
					"id": 722740203,
					"content": "너무 독단적인 결정 아니야? 이 임무는 「아를레키노」 님께 보고도 안 한 거 같던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740204
					],
					"speakerTitle": "우인단 선발대"
				},
				{
					"id": 722740204,
					"content": "선생님의 개인적인 결정이야. 칫, 안 좋은 예감이 들어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740205
					],
					"speakerTitle": "우인단 선발대"
				},
				{
					"id": 722740205,
					"content": "그러니까, 네 말은 우리가 실패하면 선생님이 우리에게 모든 책임을 떠넘길 거란 거네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "우인단 선발대"
				}
			]
		}
	]
}