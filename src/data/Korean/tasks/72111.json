			},
			"dialogs": [
				{
					"id": 721110701,
					"content": "이것은… 이것은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110702
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110702,
					"content": "짐수레를 부술 때 발견하지 못했군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110703
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110703,
					"content": "와, 인정했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110704
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110704,
					"content": "어쩔 수 없지, 여기까지 조사를 했다니, 더 이상 속일 순 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110705
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110705,
					"content": "무슨 일인지 너도 얼추 알아냈겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110706
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110706,
					"content": "잘 알고 있어! 콘다 할아버지, 당신이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110707
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110707,
					"content": "할아버지는 관아의 화물을 강탈하고 짐수레를 부쉈어. 그러던 도중에 화물이 날아가 도랑에 빠진 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110708
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110708,
					"content": "막부 사람은 목숨을 지키기 위해 돈주머니를 우물 속에 던져 할아버지의 주의를 돌렸을 테고, 할아버지는 누군가 돈을 주워가는 걸 막으려고 우물 입구를 잠근 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110709
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110709,
					"content": "맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110710
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110710,
					"content": "아? 아냐, 그게 아니라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110711
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110711,
					"content": "아니라고? 할아버지한테 있는 열쇠를 가져와서 우물 안에 있는 모라를…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110712
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110712,
					"content": "…막부 어른들에게 돌려 주려고 했는데! 그래! 당연히 관아에 돌려줘야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110713
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110713,
					"content": "휴, 사실은 이렇단다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110714
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110714,
					"content": "마을에 젊은이들이 있는데, 술김에 막부의 짐수레를 탈취했어. 이 화물과 주머니는 모두 막부 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110715
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110715,
					"content": "나는 마을의 치부가 밖으로 새어나갈까 봐 숨기려 했고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110716
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110716,
					"content": "그럼 돈주머니 횡령한 일을 인정한 건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110717
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110717,
					"content": "진상을 숨기기 위해서였군요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110718
					]
				},
				{
					"id": 721110718,
					"content": "맞아. 이렇게 하면 너희들이 더 이상 캐묻지 않을 거라 생각했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110719
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110719,
					"content": "나 혼자라면… 다른 사람에게 피해만 안 끼치면 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110720
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110720,
					"content": "부탁이니 막부에 고발하지 말아 다오. 이건 내 체면 문제가 아니야. 난 우리 마을 전체가 이 일에 연루될까 봐 두렵단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110721,
						721110724
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110721,
					"content": "고발할 생각은 없어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110722
					]
				},
				{
					"id": 721110722,
					"content": "그래, 우린 이 일 때문에 온 게 아냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110723
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110723,
					"content": "그럼 됐어, 그럼 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110727,
					"content": "이런 일을 해서, 너무 불안했어. 그래서 이 일을 기록해 두었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110728
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110728,
					"content": "메모를 지붕에 던져 놨지. 읽고 싶다면, 직접 가서 찾아봐. 최근에 새로 고친 지붕이 망가지지 않게 조심하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110729
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110729,
					"content": "잠긴 우물의 입구에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110730
					]
				},
				{
					"id": 721110730,
					"content": "그래, 내가 우물 문을 잠갔어. 열쇠 숨긴 곳도 메모에 있으니까 직접 가 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110731
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110731,
					"content": "덴스케 할아버지, 콘다 마을의 「결계」에 대해 아는 거 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110732
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110732,
					"content": "「결계」? 아이고, 그렇게 오래된 전설을 아직도 아는 사람이 있을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110733
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110733,
					"content": "옛날 우리 마을 땅속에는 번개의 벚나무 뿌리가 있었는데, 그게 나루카미섬의 평안을 수호하는 나무뿌리 5개 중 하나였다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110734
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110734,
					"content": "그 뿌리와 결계를 수호하는 것이 「호재궁 어르신」이 우리 콘다 일족에게 맡긴 역할이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110735
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110735,
					"content": "근데 너무 오래전 일이라, 자세한 건 나도 잘 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110724,
					"content": "전 그저 진실을 알고 싶었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110725
					]
				},
				{
					"id": 721110725,
					"content": "그래, 우린 이 일 때문에 온 게 아냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110726
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110726,
					"content": "진실을 알고 싶다? 허허… 요즘 젊은이들은 참 재미있군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "콘다 덴스케"
				}
			]
		},
