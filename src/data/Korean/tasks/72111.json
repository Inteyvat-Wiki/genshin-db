					"nextDialogs": [
						721110306
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110306,
					"content": "어쨌든 너도 증거가 없잖아, 두 물건 사이에 무슨 연관이 있는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110307
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110307,
					"content": "연관이 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110308,
					"content": "어이없군. 둘 사이에 무슨 연관이 있겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110309
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110309,
					"content": "모라에, 무슨 암호라도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110310
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110310,
					"content": "모라에는 없지만, 다른 곳에는 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110311,
					"content": "그건 우리가 짐수레 잔해 근처에서 찾아낸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110304,
					"content": "마을 어귀의 나무 꼭대기에서 주웠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110305
					]
				},
				{
					"id": 721110305,
					"content": "말도 안 돼… 이렇게 떠봐도 소용없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110306
					],
					"speakerTitle": "콘다 덴스케"
