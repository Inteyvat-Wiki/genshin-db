			},
			"dialogs": [
				{
					"id": 721110201,
					"content": "모라가 담긴 주머니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110202
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110202,
					"content": "이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110203
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110203,
					"content": "…이건 우리 집 물건이야. 의심의 여지도 없어. 맞아, 확실해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110204
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110204,
					"content": "수상한데! 분명히 문제가 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110205,
						721110206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110205,
					"content": "주머니 위쪽의 부호를 그려보세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				},
				{
					"id": 721110210,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110211
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110211,
					"content": "그래. 이것은 내 돈주머니가 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110212
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110212,
					"content": "우리 집 뒤뜰은 사람이 오고 가는 곳인데, 누가 뭘 놓고 가는 게 이상한 일은 아니지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110213
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110213,
					"content": "이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110214
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110214,
					"content": "이게 어떻게 된 일이죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110215
					]
				},
				{
					"id": 721110215,
					"content": "아! 영리한 녀석들이군. 내가 귀신에 홀려서 너희 돈주머니를 쓱삭하려 했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110216
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110216,
					"content": "나이 지긋이 먹어서 이런 한심한 생각을 하다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110217,
						721110218
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110217,
					"content": "아니에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110219,
					"content": "그 돈을 차지하려 했다고 다 인정했잖아, 또 뭐가 문제야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110220
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110220,
					"content": "곧 돈주머니를 관아에 보낼 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110221
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110221,
					"content": "좀 이상한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110222,
						721110223
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110222,
					"content": "돈주머니는 누군가 고의로 버린 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110227,
					"content": "그, 그렇게 말하는 증거라도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110228
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110228,
					"content": "돈주머니는 그냥 일부일 뿐이야. 우린 이런 거도 찾았다구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110229
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110229,
					"content": "#…무엇을 찾았더라? 우웅, 너한테 맡길게, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110230
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110230,
					"content": "#({NICKNAME}, 우리가 전에 도랑에서 뭘 발견했더라…?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110231
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110231,
					"content": "이게 바로 비 오는 밤을 틈타 버리려 했던…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110223,
					"content": "아니야, 페이몬이 생각이 많은 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110224
					]
				},
				{
					"id": 721110224,
					"content": "#(아니야! {NICKNAME}, 덴스케 할아버지가 정말 이 모라를 원했을까?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110225
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110225,
					"content": "(뭔가 다른 걸 숨기는 거지?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110226
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110226,
					"content": "돈주머니는 누군가 고의로 버린 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110227
					]
				},
				{
					"id": 721110218,
					"content": "뭔가 숨기고 있어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110219
					]
				},
				{
					"id": 721110206,
					"content": "안에 모라가 얼마나 있는지 말해보세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110207
					]
				},
				{
					"id": 721110207,
					"content": "하하하, 이상한 걸 묻는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110208
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110208,
					"content": "배낭을 열어 확인하지 않으면, 너도 가방에 모라가 얼마나 들어 있는지 모르잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110209
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110209,
					"content": "주머니 위쪽의 부호를 그려보세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110210
					]
				}
			]
		},
