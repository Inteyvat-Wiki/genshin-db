			},
			"dialogs": [
				{
					"id": 721110101,
					"content": "무슨 일인가? 젊은이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110102
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110102,
					"content": "증거를 찾았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110103
					]
				},
				{
					"id": 721110103,
					"content": "「증거」? 무슨 증거, 사실 여부도 모르잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110104
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110104,
					"content": "마을의 이상한 일 말이야, 그만 둘러대라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110105,
					"content": "헛소리 말아. 우리 마을에 무슨 이상한 일이 있겠어. 좋아, 증거가 있으면 내놔봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110106
					],
					"speakerTitle": "콘다 덴스케"
				},
				{
					"id": 721110106,
					"content": "#(야, {NICKNAME}, 우물가에서 찾은 것부터 시작하자. 너에게 맡길게!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721110107,
					"content": "이것은 뒤뜰 마른 우물에서 주운 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7211102,
			"completionStepIds": [
				7211105
			],
