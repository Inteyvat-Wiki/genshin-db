			"dialogs": [
				{
					"id": 80040401,
					"content": "광부 아저씨가 우리한테 조사해달라고 한 게 여기일까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80040402,
					"content": "이 도시를 보고 뭐 떠오르는 거 없어…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80040403,
					"content": "음, 뭐였더라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80040404,
					"content": "「뒤집힌 불결한 신상」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040405
					]
				},
				{
					"id": 80040405,
					"content": "맞아, 맞아! 바로 그거야. 기괴하고 거꾸로 돼 있고 소름 돋는 느낌까지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80040406,
					"content": "그럼, 층암거연 지하가 정말 심연 교단과 관련 있는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80040407,
					"content": "조사할 방법을 생각해 봐야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80040408,
					"content": "…아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80040409,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040410,
						80040411
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040410,
					"content": "데인슬레이프?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040412
					]
				},
				{
					"id": 80040412,
					"content": "나도 여기서 너희를 만날 줄은 몰랐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040413
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040413,
					"content": "오랜만이야, 데인…. 아니지, 네가 왜 갑자기 층암거연에 나타난 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80040414,
					"content": "층암거연… 이곳은 층암거연 밑인가? 나조차도 발을 들인 적이 없는 곳…. 그런 거였군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040415
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040415,
					"content": "묻고 싶은 게 많아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040416
					]
				},
				{
					"id": 80040416,
					"content": "지난번엔 「만남」도, 「이별」도 다소 조급했지. 네 기분 이해해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040417
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040417,
					"content": "이렇게 다시 만나게 될 줄이야. 운명의 해명이 필요할 것 같군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040418,
						80040419
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040418,
					"content": "당신이 왜 여기에 있는지부터 설명해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040420
					]
				},
				{
					"id": 80040420,
					"content": "쉽게 알 수 있을 텐데. 난 얼마 전에 다시 심연 사도 한 명의 동향을 포착해서 그 뒤를 쫓았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040421
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040421,
					"content": "그런데, 막다른 길로 몰린 녀석이 또 수작이나 부리는 바람에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040422
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040422,
					"content": "그 뒤를 따라 포털을 통과했지만, 역시나 잘못된 장소에 도착했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040423,
						80040424
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040423,
					"content": "그러고 보니, 전에 포털을 통과할 때도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040425
					]
				},
				{
					"id": 80040425,
					"content": "그래, 내 최근 경험에 따라 추측해보면… 심연이 제어하는 포털 능력은 단순히 점과 점을 연결하는 게 아닌, 완전한 네트워크 구조야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040426
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040426,
					"content": "포털의 맞은편은 네트워크 중 임의의 지점일 수 있어. 어디일지는 그들이 결정하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040427
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040427,
					"content": "워프 포인트랑 비슷한 거 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040428
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80040428,
					"content": "어쨌든, 그때 난 네 가족을 따라 곧장 포털로 들어갔지만, 주위를 둘러봤을 땐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040429
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040429,
					"content": "…나 홀로, 그 풍마룡의 둥지에 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040430
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040430,
					"content": "아, 그나저나 그 최초의 「경작기」의 눈은 어떻게 됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040431
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80040431,
					"content": "이미 처리했어. 「운명의 베틀」이라는 계획의 정체를 똑똑히 알아내기 전까지는, 그게 심연의 손에 들어갈 걱정은 하지 않아도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040432,
						80040433
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040432,
					"content": "다시 한번 자기소개 부탁할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040434
					]
				},
				{
					"id": 80040434,
					"content": "흥, 그 호칭을 기억하고 있는 건가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040435
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040435,
					"content": "일부러 숨긴 건 아니야. 그 호칭은 과거 켄리아의 영광을 누렸지만, 지금은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040436
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040436,
					"content": "…풍자에 더 가까운 일종의 저주일 뿐이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040437
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040437,
					"content": "나라가 멸망하는 걸 지켜본 왕조 친위대 대장으로서, 그 호칭을 꺼리는 이유는 충분하다고 생각하는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040438
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040438,
					"content": "#그럼 네 {M#동생이}{F#오빠가} 한 말이 다 사실인가 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040439,
						80040440
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80040439,
					"content": "#{M#동생}{F#오빠}의 과거에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040441
					]
				},
				{
					"id": 80040441,
					"content": "우린 「길동무」였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040442
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040442,
					"content": "고통 속에서 끊임없이 운명을 찾는 여정이었지. 하지만… 우린 함께 「종점」에 다다르지 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040443
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040443,
					"content": "「여정의 종점」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040444
					]
				},
				{
					"id": 80040444,
					"content": "네 질문 공세 전에 이건 미리 말해두지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040445
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040445,
					"content": "「전송 네트워크」에 대한 내 추측이 맞다면, 내가 마침 이곳으로 워프된 건 여기가 심연 교단이 전송 지점으로 삼을 만큼 중요한 곳이라는 걸 말하는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040446
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040446,
					"content": "그 말은 심연 교단이 여기서 무언가를 꾸밀 계획이라는 거지? 우리 예상이랑 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040447
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80040447,
					"content": "그렇다면, 우리는 지금… 「심연」에 감시당하고 있을 가능성이 커",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040448
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040448,
					"content": "그, 그런 얘기 하지 마! 소름 돋잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040449,
						80040450
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80040449,
					"content": "일단 조사부터 하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040451
					]
				},
				{
					"id": 80040451,
					"content": "흥, 현명하군. 저쪽 바위벽 근처에 불빛이 있는 것 같은데, 한번 가 보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80040450,
					"content": "일단은 믿을게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040451
					]
				},
				{
					"id": 80040440,
					"content": "대체 두 사람 사이에 무슨 일이 있었던 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040441
					]
				},
				{
					"id": 80040433,
					"content": "「여광의 검」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040434
					]
				},
				{
					"id": 80040424,
					"content": "#제 {M#동생을}{F#오빠를} 못 따라잡은 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040425
					]
				},
				{
					"id": 80040419,
					"content": "아까 그 포털은 뭐죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040420
					]
				},
				{
					"id": 80040411,
					"content": "독특한 등장 방식이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040412
					]
				}
			]
		},
