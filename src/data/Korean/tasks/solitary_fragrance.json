				"points": []
			},
			"dialogs": [
				{
					"id": 10220601,
					"content": "이건 유리백합이 아니잖아. 유리백합이 사람을 공격할 리 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10220602,
					"content": "상상을 초월하는 적이네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220603
					]
				},
				{
					"id": 10220603,
					"content": "그건 「구라구라꽃」이라고 하는 마물이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220604
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10220604,
					"content": "음? 이 꽃잎들은…? 재밌군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220605
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10220605,
					"content": "위장용으로 사용되는 유리백합이 「구라구라꽃」과 오랫동안 같이 있다 보니 오히려 좋은 약재가 됐군. 화가 복이 된 셈이지…. 이 꽃잎들을 잘 챙겨둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220606
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10220606,
					"content": "완전 이득이잖아? 그럼 이 꽃잎들도 송신의례에 쓸 수 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220607
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10220607,
					"content": "아쉽지만 못 써",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220608
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10220608,
					"content": "아, 어째서——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220609
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10220609,
					"content": "저기…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220610
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220610,
					"content": "혹시 유리백합을 찾고 계시나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220611
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220611,
					"content": "아! 넌! 으, 음… 이름이 뭐더라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220612,
						10220614
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10220612,
					"content": "안녕하세요, 감우 씨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220613
					]
				},
				{
					"id": 10220613,
					"content": "안녕하세요, 여행자. 제 이름을 기억하고 계시다니 의외네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220617,
					"content": "그나저나 「군옥각」에 다녀오신 소감은 어떠신가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220618
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220618,
					"content": "네가 올라가는 길을 안 알려줘서 길 찾느라 엄청 고생했다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220619
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10220619,
					"content": "네? 제, 제가 말씀 안 드렸나요?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220620
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220620,
					"content": "우리가 직접 알아냈거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220621,
						10220622
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10220621,
					"content": "당연히 알 거라 생각해서 말을 안 했나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220623,
					"content": "그… 그러게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220624
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220624,
					"content": "(까먹고 말을 안 했어…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220625
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220625,
					"content": "음? 감우 안색이 좀 안 좋아 보이는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220626
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10220626,
					"content": "게다가 처음 봤을 때랑 분위기가 좀 달라…. 뭔가 그때만큼 진지하지 않달까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220627
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10220627,
					"content": "아… 그땐 「천권성의 사절」이었으니까요. 지금은 꽃을 보러 온 것뿐이구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220628
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220628,
					"content": "엥? 왜 시내에서 안 보고 굳이 여기까지 온 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220629
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10220629,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220630
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220630,
					"content": "옥경대는 암왕제군이 돌아가신 곳이잖아요. 그곳에서 꽃을 보면 울적해질 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220631
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220631,
					"content": "요즘 옥경대에서 일할 때도 창밖의 풍경이 보이지 않도록 항상 창문을 닫아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220632
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220632,
					"content": "아… 미안, 그 얘길 꺼내는 게 아니었는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220633
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10220633,
					"content": "아니에요, 제가 아직 마음을 추스르지 못해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220634
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220634,
					"content": "2천 년 전 마신들의 전쟁이 끝나고 최초의 일곱 신들은 리월에 모여 제군과 함께 술을 마셨어요…. 근데 신위가 교체되면서 그때의 신은 두 분만 남게 되었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220635
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220635,
					"content": "그렇다는 건…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220636
					]
				},
				{
					"id": 10220636,
					"content": "네. 암왕제군께서 돌아가셨으니 세상에 남아계신 최초의 일곱 신은 이제 몬드의 바르바토스 님뿐이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220666
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220666,
					"content": "이나즈마의 라이덴 쇼군을 포함한 나머지 다섯 분은 모두 2천 년 전 그분들이 아니세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220637
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220637,
					"content": "현재 「7명의 집정관」 중 가장 젊은 분은 500세이신 수메르의 풀의 신이에요. 그리고 가장 오래된 분은 6천여 년을 사신 암왕제군이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220638
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220638,
					"content": "리월은 3,700년 전 처음 세워졌을 때부터 암왕제군의 통치를 받았으니, 한 번도 신을 「떠나보낸」 적이 없어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220639
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220639,
					"content": "그럼 자넨 이번 「작별」에 대해 어떻게 생각하나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220640
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10220640,
					"content": "네? 그렇게 갑자기 물어보시면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220641
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220641,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220642
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220642,
					"content": "「인간」으로선 암왕제군이 없는 리월을 상상할 수 없지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220643
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220643,
					"content": "「선인」으로선… 아마 언젠간 그 사실을 받아들이게 되겠죠. 제군께서 돌아가셨으니 선인과 리월이 「계약」을 맺는 시대는 사실상 종결된 거니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220644
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220644,
					"content": "응? 「선인」으로서… 라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220645
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10220645,
					"content": "아… 전 기린과 인간의 피가 섞인 선인의 혈통이거든요. 마신 전쟁에서 제군과 리월을 위해 싸우기도 했었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220646
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220646,
					"content": "그리고 전쟁이 끝난 뒤 제군과 「계약」을 맺어 지금까지 칠성의 비서로 일했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220647,
						10220648
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220647,
					"content": "그래서 머리에 뿔이 있었군요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220649,
					"content": "흠… 흠흠. 다른 얘기 할까요? 방금 유리백합을 찾는다고 하셨죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220650
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220650,
					"content": "저도 야생 유리백합이 숨겨져 있는 곳을 알거든요. 마침 하나 꺾었는데 괜찮다면 받아주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220651
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220651,
					"content": "그럼 사양하지 않겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220652
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10220652,
					"content": "엥? 그럼 꽃을 꺾기 전에 노래도 불렀어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220653
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10220653,
					"content": "네, 그 전통이라면 잘 알고 있으니깐요. 걱정마세요, 전 리월 현지 민요를 불렀어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220654
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220654,
					"content": "우와, 너도 이런 거에 빠삭하구나! 고마워, 감우!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220655
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10220655,
					"content": "아닙니다. 오히려 제가 감사하죠. 이렇게 우연히 만난 덕분에 저도 「오랜 신과의 작별」에 기여할 수 있게 됐으니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220656
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220656,
					"content": "그럼 전 일하러 가볼게요. 행운을 빕니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220657
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220657,
					"content": "이제 「송신의례」에 필요한 준비가 얼추 다 끝났군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220658
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10220658,
					"content": "꽃을 꺾는 건 여러 의미로 어렵지 않으니 마지막에 남겨뒀어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220659
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10220659,
					"content": "종려 씨는 황무지 개척을 잘할 거 같아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220660
					]
				},
				{
					"id": 10220660,
					"content": "응. 리월에서 창업하면 엄청 잘할 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220661
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10220661,
					"content": "하하… 사실 나한테도 그런 날이 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220662
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10220662,
					"content": "새로운 일을 시작한다는 건… 어렵기도하고 신경도 많이 쓰여. 자리 잡을 때까지 기다리는 것도 오래 걸리고 점점 지치기 마련이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220663
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10220663,
					"content": "그럴 땐 한 발짝 물러서서 자신을 살펴봐야 해. 방치해둔다면, 영혼이 피폐해 질 테고 돌이킬 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220664
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10220664,
					"content": "이거 봐! 뭔가 사연 있는 말투 같은데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220665
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10220665,
					"content": "좋아. 이제 모든 일을 끝냈으니 그만 리월항으로 돌아가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10220648,
					"content": "그래서 알려줘야 할 일을 자꾸 잊어버렸군요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220622,
					"content": "물어볼 걸 괜히 헛걸음쳤네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220614,
					"content": "안녕하세요, 왕미소 씨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220615
					]
				},
				{
					"id": 10220615,
					"content": "왕미소? 그, 그게 누구예요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220616
					],
					"speakerTitle": "감우"
				},
				{
					"id": 10220616,
					"content": "어떻게 감우랑 왕미소를 헷갈릴 수가 있죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "감우"
				}
			]
		},
		{
			"id": 102208,
