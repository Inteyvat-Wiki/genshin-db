			"dialogs": [
				{
					"id": 200460101,
					"content": "좋아… 오늘도 의뢰를 열심히 완수해야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460102,
						200460106
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200460102,
					"content": "정말 의욕이 넘치네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460103
					]
				},
				{
					"id": 200460103,
					"content": "물론이지, 모험가는 정말 재미있는 직업이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460104
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200460104,
					"content": "근데… 헤헤, 의뢰를 진행할 때 모르는 게 너무 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460105
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200460105,
					"content": "여행자, 아직 배우고 싶은 게 많은데 한 번만 같이 가주면 안 될까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460108
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200460108,
					"content": "그럼 어서 출발하자, 오늘의 의뢰는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460109
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200460109,
					"content": "아… 또 화물 열기구 호송하기네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "안나"
				},
				{
					"id": 200460106,
					"content": "내가 같이 가줄까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460107
					]
				},
				{
					"id": 200460107,
					"content": "그래도 될까? 헤헤, 마침 물어보고 싶은 게 많았는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460108
					],
					"speakerTitle": "안나"
				}
			]
		},
		{
