			"dialogs": [
				{
					"id": 220020201,
					"content": "준비됐어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020202
					]
				},
				{
					"id": 220020202,
					"content": "그럼 시작할게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020203
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020203,
					"content": "#그럼 {M#오빠}{F#언니}부터 시작해주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020204
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020204,
					"content": "안녕, 난 강도야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020205
					]
				},
				{
					"id": 220020205,
					"content": "흥! 천암군 아저씨가 바로 옆에 있는데 대낮부터 강도질이라니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020206
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220020206,
					"content": "룰루, 이쪽으로 와, 어서 도망가자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020207
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220020207,
					"content": "안녕하세요, 뭘 뺏으러 왔죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020208,
						220020209
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020208,
					"content": "음… 돈 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					]
				},
				{
					"id": 220020212,
					"content": "하지만 전 돈이 별로 없는걸요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020213
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020213,
					"content": "아빠가 배에서 가장 비싼 건 바로 상인들의 화물이라고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020214
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020214,
					"content": "#음… 그럼 {M#오빠}{F#언니}가 가서 돈이 되는 물건을 좀 구해다 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020215
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020215,
					"content": "그럼 저한테도 뺏길 물건이 생길 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020216
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020216,
					"content": "어디 보자…. 그럼 연꽃받침을 좀 구해오세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020217
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020217,
					"content": "#우리 셋 다 연꽃받침을 좋아하니까, 나쁜 해적인 {M#오빠}{F#언니}가 연꽃받침을 빼앗으면 딱 이겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020209,
					"content": "널 뺏으러 왔어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020210
					]
				},
				{
					"id": 220020210,
					"content": "#{M#오빠}{F#언니}! 게임이긴 하지만 주의해주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020211
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020211,
					"content": "봐요! 천암군 아저씨들이 모두 이쪽을 보고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					],
					"speakerTitle": "룰루"
				}
			]
		},
