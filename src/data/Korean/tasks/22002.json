			"dialogs": [
				{
					"id": 220020101,
					"content": "룰루, 왜 또 내가 선장이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020102
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 220020102,
					"content": "소몽이 선장할 때가 제일 재밌잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020103
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020103,
					"content": "룰루가 괜찮다면, 나… 나도 괜찮아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020104
					],
					"speakerTitle": "아비"
				},
				{
					"id": 220020104,
					"content": "여기서 뭐 해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020105
					]
				},
				{
					"id": 220020105,
					"content": "#{M#오빠}{F#언니}, 우리 지금 게임 하려구요~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020106
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020106,
					"content": "소몽은 선장, 아비는 종업원, 그리고 전 돈 많은 상인이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020107
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020107,
					"content": "이제 해적만 있으면 딱인데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020108
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020108,
					"content": "#{M#오빠}{F#언니}가 해적 해주면 안 돼요? 같이 놀아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020109,
						220020111
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020109,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020110
					]
				},
				{
					"id": 220020110,
					"content": "#고마워요, {M#오빠}{F#언니}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020113,
					"content": "#그럼 {M#오빠}{F#언니}, 준비되면 저한테 와요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020111,
					"content": "난 착한 사람하고 싶은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020112
					]
				},
				{
					"id": 220020112,
					"content": "#그냥 게임일 뿐이잖아요. {M#오빠}{F#언니}가 착한 사람인 건 저도 알아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "룰루"
				}
			]
		},
		{
