					"nextDialogs": [
						220020302
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020302,
					"content": "찾았어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020303
					]
				},
				{
					"id": 220020303,
					"content": "#고마워요, {M#오빠}{F#언니}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020304
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020304,
					"content": "소몽, 아비, 어서 와서 연꽃받침 먹어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020305
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020305,
					"content": "이… 이봐, 우리 아직 해적이거든?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220020306,
					"content": "아, 맞다. 그럼 이 돈이랑 물건을 줄게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020307
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020307,
					"content": "#{M#오빠}{F#언니}, 해적 연기 정말 잘하는데요? 어린애들한테서 이렇게 많은 걸 뺏어 가다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020308
					],
					"speakerTitle": "룰루"
				},
				{
					"id": 220020308,
					"content": "이 꼬마… 말에 뼈가 있는 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220020309,
					"content": "#수고했어요, {M#오빠}{F#언니}! 다음에도 우리랑 같이 놀아줘야 돼요~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "룰루"
				}
			]
		},
