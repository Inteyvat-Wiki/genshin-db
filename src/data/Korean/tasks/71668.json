			"completionStepIds": [
				7166804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166804",
							"2"
						],
						"stepId": 7166804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"라미야",
					"진진"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680401,
					"content": "좋아, 그럼 이 음식들은 내가 도시락통에 잘 넣어서 전달할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680402
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680402,
					"content": "모든 동물은 각자 자신만의 독특한 습성을 가지고 있어. 우리는 동물을 우리에 가두지 않고, 전문 사육사를 고용해서 그들을 추적하고 신체 상태를 확인하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680403
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680403,
					"content": "동물을 찾는 건 쉬운 일이 아니야. 라미야 씨가 개발한 특수 장치 「투영 거울」이 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680404
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680404,
					"content": "이 내용은 제가 잘 모르니까, 설명을 부탁드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680405
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680405,
					"content": "네, 제가 설명할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680406
					],
					"speakerTitle": "라미야"
				},
				{
					"id": 716680406,
					"content": "「투영 거울」이라는 장치의 기반 기술은 허공과 관련이 있어요. 구체적인 작동 원리는 좀 복잡하지만 안심하세요. 안전 테스트는 이미 통과했거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680407
					],
					"speakerTitle": "라미야"
				},
				{
					"id": 716680407,
					"content": "동물들의 몸에 이미 소형 발신 장치가 부착되어 있어서 장치의 신호를 읽기만 하면 거울 속에 동물의 시야 속 사물들이 나타날 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680408
					],
					"speakerTitle": "라미야"
				},
				{
					"id": 716680408,
					"content": "장치에 아직 개선해야 할 부분이 있긴 하지만, 이 영상으로 활동 중인 동물들의 위치를 알아낼 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680409
					],
					"speakerTitle": "라미야"
				},
				{
					"id": 716680409,
					"content": "대략적인 설명은 이 정도면 된 것 같네. 준비가 됐다면 언제든지 「동물 친구와 동행」에 가입해 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680410
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680410,
					"content": "「투영 거울」을 사용해 동물 친구들을 찾아봐. 입양인의 선물과 동물들이 네가 찾아주길 기다리고 있다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "진진"
				}
			]
		},
