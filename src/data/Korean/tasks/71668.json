				"points": []
			},
			"dialogs": [
				{
					"id": 716680101,
					"content": "「동물 친구와 동행」 동물 구조 협회에 온 걸 환영해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680102
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680102,
					"content": "안녕하세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680104
					]
				},
				{
					"id": 716680104,
					"content": "#{NICKNAME}(이)구나, 안녕",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680105
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680105,
					"content": "우리 상회에서 행사를 하고 있는데 혹시 관심 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680106
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680106,
					"content": "무슨 행사인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680107
					]
				},
				{
					"id": 716680107,
					"content": "간단히 말하자면 비운 상회가 후원하는 「동물 친구와 동행」 동물 구조 협회에 가입해서, 우리와 함께 버려진 동물이나 멸종 위기에 처한 동물들을 입양하는 행사야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680108
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680108,
					"content": "비운 상회는 계속 세계 각국의 자원봉사자들과 힘을 합쳐 입양을 통해 광범위하게 퍼져있는 유기 동물 문제를 해결하기 위해 노력해 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680109
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680109,
					"content": "최근 몇 년 간 구조 협회 규모가 점점 커지면서, 멸종 위기 동물 보호 문제에 대해 라미야 씨 같은 학자들과 협력할 생각을 하기 시작했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680110
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680110,
					"content": "연구 성과를 이런 일에 쓸 수 있다니 저도 기뻐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680111
					],
					"speakerTitle": "라미야"
				},
				{
					"id": 716680111,
					"content": "하하, 함께 일할 수 있어서 저희도 매우 기쁩니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680112
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680112,
					"content": "우리 자원봉사자들과 라미야 씨처럼 훌륭한 연구원들 덕분에 많은 유기 동물들은 집을 찾았고, 멸종 위기에 처한 동물들은 보호를 받을 수 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680113
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680113,
					"content": "리월 본토뿐만 아니라 몬드와 수메르까지… 비운 상회가 활동하는 국가라면 그 어디라도 「동물 친구와 동행」의 동물 보호소를 찾아볼 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680114
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680114,
					"content": "자원봉사자들에게 감사를 전하고, 모두에게 「동물 친구와 동행」의 동료가 이렇게 많다는 걸 알리기 위해 우리가 주최한 행사야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680115
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680115,
					"content": "입양된 동물들이 사는 지역에 가서, 동물들의 실제 생활환경을 살펴보고, 작은 선물도 받을 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680116
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680116,
					"content": "선물은 구조 협회 직원과 다른 입양인들이 함께 준비한 거야. 물론 선물을 받기 전에 너도 다른 입양인들을 위해 뭔가 준비해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680117
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680117,
					"content": "그럼, 전문가가 선물을 회수해서 입양한 사람에게 전달해 주는 방식이야. 선물은 너무 비싸지 않아도 괜찮아, 마음만 전달할 수 있으면 되거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680118
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680118,
					"content": "#어때 {NICKNAME}, 관심 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680119,
						716680120
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680119,
					"content": "한번 둘러볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				},
				{
					"id": 716680121,
					"content": "정말 잘됐다. 너처럼 유명한 사람이 동참해 줘서 정말 기쁜걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680122
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680122,
					"content": "준비됐으면 지금 선물을 나한테 주면 돼. 우리 직원이 행사가 끝난 후에 입양인한테 선물을 나눠줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680123
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716680123,
					"content": "참, 입양인들이랑 얘기해 보니까 지역 특산물에 관심이 있는 사람들이 있는 것 같아. 맛있는 음식을 좋아하는 사람도 있었고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "진진"
				},
				{
					"id": 716680120,
					"content": "저도 참가할래요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				}
			]
		},
