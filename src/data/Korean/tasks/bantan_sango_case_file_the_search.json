			"dialogs": [
				{
					"id": 220340203,
					"content": "이 녀석들, 정말 잽싸네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340204
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340204,
					"content": "아마 정보를 전하러 돌아갔을 거야. 우리의 목적도 달성한 셈이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340205
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340205,
					"content": "수고했어, 여행자. 이건 보수니까 받아둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340206
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340206,
					"content": "나도 사장님에게 상황을 보고하러 가봐야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340207
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340207,
					"content": "사장님이 새로운 추리를 생각해 내셨을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "류지"
				}
			]
		},
