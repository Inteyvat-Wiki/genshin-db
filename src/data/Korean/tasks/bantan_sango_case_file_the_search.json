				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"류지"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220340101,
					"content": "여행자, 잠깐만. 사장님이 부탁할 게 있으시대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340102
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340102,
					"content": "사건 수사에 진전이 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340103
					]
				},
				{
					"id": 220340103,
					"content": "그 말씀은 없으셨어. 아직 준비가 필요하다고만 하셨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340104
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340104,
					"content": "그리고 널 기다렸다가 같이 야외 조사를 진행하라고 하시더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340105,
						220340107
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340105,
					"content": "대체 산고는 무슨 생각인 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340106
					]
				},
				{
					"id": 220340106,
					"content": "그렇게 묻는다면… 솔직히 잘 모르겠어. 하지만 사장님이 분부하신 대로만 하면, 대부분은 사건이 해결되더라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340112,
					"content": "흠, 잡담은 그만하고 본론으로 들어갈게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340113
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340113,
					"content": "사장님은 아마노 씨와 안도 씨가 그 사건을 보고한 후로 성안의 순찰이 강화됐다고 하셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340114
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340114,
					"content": "하지만 이상한 게 성안의 상가에 아직도 도둑이 출몰하고 있어. 게다가 범인은 목표물 외에는 털끝 하나 건드리지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340115
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340115,
					"content": "이런 상황이다 보니, 사장님은 성 밖의 보물 사냥단이 잠입해 벌인 사건일 가능성이 희박하다고 보셔",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340116
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340116,
					"content": "그리고 범인… 또는 범인들의 범행에는 분명한 목적이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340117
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340117,
					"content": "현재로서는 성안에 대기하고 있는 「내통자」가 성 밖의 공범들에게 정보를 전달하고 있을 가능성이 가장 커",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340118
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340118,
					"content": "그럼 도신들은 헛수고를 하고 있는 거잖아요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340119
					]
				},
				{
					"id": 220340119,
					"content": "아니, 도리어 도신들의 목표가 자신이 아니라는 걸 알아차렸기 때문에 계속 범죄가 일어나고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340120
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340120,
					"content": "그놈이 범행을 저지를수록 남긴 흔적은 더 많을 테고, 사장님이 범인을 잡아낼 기회도 더욱 많아지지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340121
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340121,
					"content": "그러니까, 범인의 경계를 늦추려면 지금처럼 보여주기식 작전을 계속해야 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340122
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340122,
					"content": "그래서 네게 도움을 청하러 온 거야. 나와 같이 야외로 가서 보물 사냥단을 들쑤셔줬으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340123
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340123,
					"content": "물론, 보수를 지불할게. 그리고… 이번 사건을 해결하면 다른 선물이 또 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340124
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340124,
					"content": "이것도 산고가 지시한 일인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340125
					]
				},
				{
					"id": 220340125,
					"content": "음… 티 많이 나나? 변함없이 예리하군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340126
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340126,
					"content": "널 설득하려고 한 말은 사장님의 알려주신 거 맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340127
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340127,
					"content": "하지만 날 믿어줘. 내가 한 말 중에 거짓은 없어. 적어도… 네게 줄 보수는 내 수중에 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340128
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340128,
					"content": "그러니까 부탁 좀 할게, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340129
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340129,
					"content": "그런데 제가 구체적으로 뭘 하면 되죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340130
					]
				},
				{
					"id": 220340130,
					"content": "간단해, 우린 그저… 야외에 있는 보물 사냥단을 들쑤시고 다니면 돼. 소란스러울수록 좋고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340131
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340131,
					"content": "사장님이 보물 사냥단 야영지를 알려주셨어. 네 지도에도 표시해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340132
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340132,
					"content": "자, 이 장소에서 만나기로 하자. 바로 출발하자구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "류지"
				},
				{
					"id": 220340107,
					"content": "산고는 왜 직접 오지 않았나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340108
					]
				},
				{
					"id": 220340108,
					"content": "사장님의 오랜 습관이야. 사장님은… 「추리에는 능하지만, 작전에는 재능이 전혀 없다」고 하셨거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340109
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340109,
					"content": "전에 어떤 소설가가 사장님 스토리를 작품으로 쓰려고 인터뷰하러 온 적이 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340110
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340110,
					"content": "그 소설가는 사장님에게… 「안락의자 탐정」이라는 별명을 지어줬지. 사장님은 그 별명이 꽤 마음에 드시는지 안락의자를 구매하려고 하셨고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340111
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220340111,
					"content": "하지만 탐정소의 경비 문제 때문에 지금까지도 구매하지 못했지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "류지"
				}
			]
		},
		{
