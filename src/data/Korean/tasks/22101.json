			"dialogs": [
				{
					"id": 221010101,
					"content": "끝이 없네… 끝이 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010102
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221010102,
					"content": "왜요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010103
					]
				},
				{
					"id": 221010103,
					"content": "어휴, 여기서 객잔을 여는 것도 쉽지 않네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010104
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221010104,
					"content": "내 착각인지는 모르겠지만, 주변에 마물이 자꾸 늘어나는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010105
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221010105,
					"content": "비록 객잔 가까이는 다가오지 않지만 손님들이 드나드는 데다가 천암군이 계속 지켜줄 순 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010106
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221010106,
					"content": "만약 시간 있으면 객잔 주변의 마물들 좀 정리해 줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010107,
						221010108
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221010107,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010109
					]
				},
				{
					"id": 221010109,
					"content": "하하, 말투가 직설적인 게 마음에 드는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221010113,
					"content": "귀찮게 해서 정말 미안해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010114
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221010114,
					"content": "일 끝내면 보수는 두둑이 줄 테니까, 걱정 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010115
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221010115,
					"content": "그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "회안"
				},
				{
					"id": 221010108,
					"content": "이 객잔은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010110
					]
				},
				{
					"id": 221010110,
					"content": "이런 곳에다가 객잔을 열게 되면 이런 문제는 피할 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010111
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221010111,
					"content": "그래도 우리 객잔이 없으면 지나가는 행인들이 묵을 곳이 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010112
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221010112,
					"content": "힘들긴 하지만 그래도 열고 있으면 얼마나 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
