				"points": []
			},
			"dialogs": [
				{
					"id": 741920101,
					"content": "난 보았다. 왕좌 위 불꽃은 꺼졌고 타버린 잿더미는 다시 나무로 변했다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920102
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741920102,
					"content": "꽃이 네 걸음을 따라 피어나고, 넌 쇠퇴할 운명의 미래에 변화를 불러올 것이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920103
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741920103,
					"content": "카노틸라?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920104
					]
				},
				{
					"id": 741920104,
					"content": "#어, {NICKNAME} {M#오빠}{F#언니}였군요! 여긴 어쩐 일인가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920105
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741920105,
					"content": "아, 맞다! 금색 나비가 돌아왔으니까 어서 가봐야 해요! 그럼 다음에 봬요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카노틸라"
				}
			]
		},
