			"dialogs": [
				{
					"id": 741920201,
					"content": "흑흑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920202
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741920202,
					"content": "카노틸라…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920203
					]
				},
				{
					"id": 741920203,
					"content": "#어? {M#오빠}{F#언니}는… 누구예요? 여긴 저 말고 아무도 못 들어오는 줄 알았는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920204
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741920204,
					"content": "제 이름을 어떻게 알았어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920205,
						741920207
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741920205,
					"content": "우리는 서로 아는 사이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920206
					]
				},
				{
					"id": 741920206,
					"content": "거짓말 마세요! 당신도 그 마물들처럼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741920207,
					"content": "(거짓말)세린이 널 찾아달라고 했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920208
					]
				},
				{
					"id": 741920208,
					"content": "그랬군요… 항상 세린 언니에겐 폐를 끼치네요. 전 정말 나쁜 아이예요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920209
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741920209,
					"content": "#내 이름은 {NICKNAME}, 기억나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920210
					]
				},
				{
					"id": 741920210,
					"content": "#{NICKNAME} {M#오빠}{F#언니}, 떠올랐어요…. 이 세계를 단숨에 삼킬 법한 괴물로 보이지만 아주 상냥하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920211,
						741920213
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741920211,
					"content": "정말 무례하네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920212
					]
				},
				{
					"id": 741920212,
					"content": "죄송해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920214
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741920214,
					"content": "무슨 일 있었어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920215
					]
				},
				{
					"id": 741920215,
					"content": "몇몇 사람들이 천천히 녹아서 마물이 되는 걸 봤어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920216
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741920216,
					"content": "아아, 너무 무서워요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741920213,
					"content": "고마워",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920214
					]
				}
			]
		},
		{
