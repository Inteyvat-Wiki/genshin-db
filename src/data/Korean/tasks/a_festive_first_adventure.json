						413380304
					]
				},
				{
					"id": 413380304,
					"content": "헤헤, 그야 당연하지! 내가 특별히 준비한 거잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380305
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 413380305,
					"content": "그럼 이제 다른 비행 통로로 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "첨아"
				},
				{
					"id": 413380303,
