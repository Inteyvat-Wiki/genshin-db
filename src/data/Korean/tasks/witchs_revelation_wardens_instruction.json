				]
			},
			"dialogs": [
				{
					"id": 746950101,
					"content": "안녕하세요, 트리스메기스토스 씨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950102
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950102,
					"content": "오? 이 이름을 정확히 알다니, 우리에게 겹치는 지인이 있나 보군?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950103
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950103,
					"content": "콜롬비나 씨가 여길 추천해 줬거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950104
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950104,
					"content": "참 예측 불가한 아가씨지. 두 사람의 만남은 꽤나 흥미로웠겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950105
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950105,
					"content": "아주 흥미로웠죠. 「예측 불가」라는 평가에 전적으로 동의해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950106
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950106,
					"content": "처음 뵙겠습니다. 라이오슬리라고 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950107
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950107,
					"content": "그래. 물 아래를 지키는 공작 씨, 만나서 반가워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950108
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950108,
					"content": "위대한 마녀 중 한 분이 저를 알고 계시다니, 이거 영광이네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950109
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950109,
					"content": "아니면, 트리스메기스토스 씨는 점성술사인 만큼 제 방문을 미리 예견하고 계셨던 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950110
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950110,
					"content": "후후… 이미 서로를 아는 이상, 쓸모없는 격식은 이만 줄이지. 바르벨로스라고 부르도록",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950111
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950111,
					"content": "그럼 저도 편하게 라이오슬리라고 불러주세요. 지금은 공무 시간도 아니고, 저도 폰타인성의 평범한 시민일 뿐이니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950112
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950112,
					"content": "마침 오는 길에 막 구운 수정 소라 케이크를 샀어요. 마녀분들은 차를 마시며 담소 나누길 좋아하신다고 들었는데, 괜찮다면 받아주시죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950113
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950113,
					"content": "오, 이건 티타임에서 아주 인기 있는 디저트야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950114
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950114,
					"content": "이곳에 오랫동안 머무르며 많은 이들에게 예언을 전했지만, 이렇게 먼저 선물을 받는 건 처음이군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950115
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950115,
					"content": "고마워, 라이오슬리 씨. 마녀들과 잘 나눠 먹도록 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950116
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950116,
					"content": "…다 들었어, 바르. 내 거 꼭 남겨둬!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950117
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950117,
					"content": "저번처럼 내가 좀 늦는다고 해서 니콜이 다 가져가게 두면 안 돼——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950118
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950118,
					"content": "크흠! 그래그래, 알겠어. 이번엔 꼭 남겨두지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950119
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950119,
					"content": "허, 타이밍 한 번 기가 막히군. 새 친구 앞에서 마녀회의 체면을 좀 세우려고 했는데 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950120
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950120,
					"content": "하하, 문제 될 거 없죠. 능력이 뛰어난 사람이 활발하면 안 된다는 법은 없으니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950121
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950121,
					"content": "맞아! 밝고 긍정적인 성격은 우리 마녀회의 가입 조건 중 하나라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950122
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950122,
					"content": "그런 조건은 처음 듣는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950123
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950123,
					"content": "방금 내가 정했어! 마녀회는 세상에 즐거움을 주는 조직이잖아? 그럼 우리부터 밝고 즐거워야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950124
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950124,
					"content": "개인적으로 전 여러분이 자유롭게 삶을 즐기시는 걸 지지합니다. 물론, 법을 어기지 않는다는 전제하에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950125
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950125,
					"content": "그런 전제는 앨리스 앞에선 아무 소용 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950126
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950126,
					"content": "이런, 그건 좀 난감한데요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950127
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950127,
					"content": "얘들아, 나 아직 여기 있거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950128
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950128,
					"content": "걱정 마, 아무리 나라도 메로피드 요새 관리자 앞에서까지 소란을 피우진 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950129
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950129,
					"content": "게다가… 혹시 사고를 쳐도, 그 감옥이 페보니우스 기사단의 감금실보단 넓지 않나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950130
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950130,
					"content": "하하, 설마 감금실 하나로 전설의 마녀를 가둘 수 있을 리가요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950131
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950131,
					"content": "앨리스 씨가 기꺼이 벌을 받는 건, 신뢰를 중요시하고 겸손한 성품 때문이겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950132
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950132,
					"content": "방금 그거, 완~전 맞는 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950133
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950133,
					"content": "그만, 그만. 라이오슬리 씨, 앨리스를 더 이상 띄우지 말아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950134
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950134,
					"content": "기분이 좋아지면 앨리스가 무슨 짓을 할지 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950135,
						746950136
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950135,
					"content": "너무 알죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				},
				{
					"id": 746950137,
					"content": "#맞아, {NICKNAME}은(는) 기사단의 명예 기사라구. 감금실의 권위를 지킬 의무가 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950138
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746950138,
					"content": "명예 기사가 도망치는 마녀를 막는다? 꽤 흥미로운 장면이겠는데. 나도 꼭 구경하게 해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950139
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950139,
					"content": "남 일이라고 너무 재밌어하는 거 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950140
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746950140,
					"content": "근데 네가 이미 여기 와 있을 줄은 몰랐어. 널 찾으러 물 아래까지 내려갈 수고를 덜었네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950141
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746950141,
					"content": "이게 바로 점술의 힘인가 봐요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950142
					]
				},
				{
					"id": 746950142,
					"content": "아, 말이 나온 김에, 슬슬 본론으로 들어가 볼까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950143
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950143,
					"content": "라이오슬리 씨, 콜롬비나 양의 소개로 오기도 했고, 디저트의 답례도 겸해서, 「달 계시 카드」를 한 장 뽑아보는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950144
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950144,
					"content": "어쩌면 운명의 선물이 숨어 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950145
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950145,
					"content": "그것도 일종의 예언인가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950146
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950146,
					"content": "그렇다고 할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950147
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950147,
					"content": "그렇다면 폰타인 사람으로서 가볍게 대할 수 없죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950148
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950148,
					"content": "「가볍게 대할 수 없다」는 말과 다르게, 라이오슬리는 바로 맨 위에 놓인 카드를 집어 들었다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746950149
					]
				},
				{
					"id": 746950149,
					"content": "이런 카드에 대해선 잘 모릅니다만, 이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950150
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950150,
					"content": "정방향 「황제」로군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950151
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950151,
					"content": "말을 아끼시는 걸 보니, 안 좋은 뜻인가요? 솔직하게 말해 주셔도 괜찮습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950152
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950152,
					"content": "아니, 오히려 그 반대야. 이 카드는 변치 않는 리더십과 흔들리지 않는 권위를 상징하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950153
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950153,
					"content": "만약 이게 미래의 길을 나타낸다면, 사실상 이미 목적지에 도달한 거나 다름없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950154
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950154,
					"content": "하지만… 우후후, 네 「운명」은 계속해서 앞으로 나아가며 변화할 거야. 그렇다는 건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950155
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950155,
					"content": "변하는 게 사람이 아니라, 환경일 수도 있겠군요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950156
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950156,
					"content": "그래… 현재로선 그런 경향이 보이는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950157
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950157,
					"content": "그렇다면 제 직감에 좀 더 확신을 가져도 되겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950158
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950158,
					"content": "예전에 공무차 노드크라이에 갔다가 식견을 넓힌 뒤로, 자연스럽게 그 지역 소식에 관심을 갖게 됐어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950159
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950159,
					"content": "그런데 어느 날 밤, 유난히 밝은 달을 보다 문득 이런 생각이 들더군요. 이 세계는 지금 변하고 있는 게 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950160
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950160,
					"content": "세상 만물은 언제나 변하고 있어. 그러나 거대한 변수가 개입한 뒤에는, 우리 모두 미지의 변화를 맞이할 준비를 해야 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950161
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950161,
					"content": "다만 이 카드의 결과만 놓고 보면 별로 걱정할 필요는 없어. 환경이 어떻게 변하든, 넌 거기에 적응하거나 맞서 싸울 힘을 가졌으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950162
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950162,
					"content": "그거참 기쁜 소식이네요. 그때 그 주먹을 괜히 맞은 건 아니었나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950163,
						746950164
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950163,
					"content": "좋은 의미를 담은 한 방이었죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950165,
					"content": "궁금한 게 하나 있습니다만, 상당히 실례되는 질문이라 해도 될지 모르겠네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950166
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950166,
					"content": "교활하게 굴긴. 일부러 우리 호기심을 자극하는 거지! 이렇게 된 이상, 말하기 싫다 해도 들어야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950167
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950167,
					"content": "그럼 실례를 무릅쓰고 여쭤보죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950168
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950168,
					"content": "계속 궁금했어요. 예언은 대체 어떻게 그 실현이 보장되는 거죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950169
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950169,
					"content": "저를 예로 들자면, 저는 장기적으로 안정적인 상태가 이어진다는 점괘가 나왔잖아요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950170
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950170,
					"content": "근데 제가 이 예언을 거스르려고 일부러 비정상적인 행동을 하면, 그땐 어떻게 되죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950171
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950171,
					"content": "예를 들어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950172
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950172,
					"content": "메로피드 요새를 폭파해 버린다든지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950173
					]
				},
				{
					"id": 746950173,
					"content": "좋아, 그걸로 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950174
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950174,
					"content": "아직도 그걸 생각하고 있었어?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950175
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746950175,
					"content": "오",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950176
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950176,
					"content": "아니, 잠깐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950177
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950177,
					"content": "하하! 잘됐네! 내가 실력 좋은 폭파 전문가 한 명을 소개해 줄 수 있거든——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950178
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950178,
					"content": "대신 명예 기사가 그 폭파 전문가의 보호자로 따라다니면서, 결정적인 순간에 모든 사고를 막아줄 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950179
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950179,
					"content": "…보다시피, 예언은 이런 식으로 실현돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950180
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950180,
					"content": "상당한 파괴력을 지닌 전문가겠군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950181
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950181,
					"content": "게다가 엄청 깜찍해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950182
					]
				},
				{
					"id": 746950182,
					"content": "아, 클레 얘기구나! 넌 모르겠지만, 클레는 앨리스의 딸이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950183
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746950183,
					"content": "아니, 정확히는 「여러 세계의 대모험가」, 「사악한 대마왕」, 「옛 몬드의 수호자」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950184
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950184,
					"content": "너무 길어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950185
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950185,
					"content": "…아무튼 대마왕 앨리스의 가장 사랑스러운 딸이자, 명실상부한 「불꽃 기사」——클레지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950186
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950186,
					"content": "아, 역시 원래 계획대로 다 불러 모아서 파티를 열었어야 했어. 그럼 직접 소개시켜 줄 수 있었을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950187
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950187,
					"content": "그러면 클레가 폰타인에 놀러 왔을 때, 새 친구들이랑 티타임을 가질 수 있을 거 아냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950188
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 746950188,
					"content": "그거 좋은 계획이네요. 벌써부터 기대되는데요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950189
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950189,
					"content": "저는 좋은 차를 마다하는 사람이 아니거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 746950164,
					"content": "큰 고비를 넘기면 복이 온다잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950136,
					"content": "그리고 부디 감금실의 권위를 존중해 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				}
			]
		},
