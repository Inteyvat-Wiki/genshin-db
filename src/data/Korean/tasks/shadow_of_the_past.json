			"dialogs": [
				{
					"id": 101200801,
					"content": "안녕, 이 근처에서 슈베르트라는 귀족을 본 적 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200802
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101200802,
					"content": "음… 그런 이름은 처음인데. 하지만 요새 이곳에 자주 나타나는 이상한 사람이 있긴 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200803
					],
					"speakerTitle": "미셸"
				},
				{
					"id": 101200803,
					"content": "여기저기 돌아다니면서 때론 그림을 그리기도 하고, 대체 뭘 하려는 건지 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200804
					],
					"speakerTitle": "미셸"
				},
				{
					"id": 101200804,
					"content": "너희들이 찾는 게 그 사람이라면, 성벽 쪽으로 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "미셸"
				}
			]
