					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200201,
					"content": "응? 너흰 누구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200202
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101200202,
					"content": "안녕, 우린…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101200203,
					"content": "안녕이라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200204,
						101200206
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101200204,
					"content": "아, 안녕하세요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200205
					]
				},
				{
					"id": 101200205,
					"content": "안녕? 내가 잘못 들은 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200208
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101200208,
					"content": "흥, 거칠고 경박한 것들. 감히 제멋대로 말을 걸다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200209
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101200209,
					"content": "내가 누군지 모르는 걸 보니, 역시 무지한 외지인인가 보군. 난 진정한 귀족의 후예 슈베르트·로렌스야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200210
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101200210,
					"content": "내게 말을 걸고 싶으면 정제된 어휘를 써야 한다고! 이렇게 되는 대로 내뱉는 건 정말이지 못 들어주겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200211
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101200211,
					"content": "내 말 알아들었으면, 바로 한쪽 무릎을 꿇고 겸손하게 사과와 인사를 올려. 그게 올바른 예절이라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200212
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101200212,
					"content": "엥? 그런 복잡한 예절에 대해서는 들어본 적이 없는데?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101200213,
					"content": "흥, 모두가 예의범절을 중시하던 시대엔 이런 예절이 귀족을 대하는 기본 상식이었다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200214
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101200214,
					"content": "귀족에게 예의를 표하지 않으면 채찍질은 기본이었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200215
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101200215,
					"content": "허나 지금은 규칙도 예의도 다 무너졌어. 세상이 엉망진창이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200216,
						101200217
