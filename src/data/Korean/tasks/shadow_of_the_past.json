						101200703
					],
					"speakerTitle": "헤르타"
				},
				{
					"id": 101200703,
					"content": "로렌스 가문 사람들은 페보니우스 기사 앞에 모습을 드러내기를 꺼려해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200704
					],
					"speakerTitle": "헤르타"
				},
				{
					"id": 101200704,
					"content": "그래도 괜찮아요. 군수품 조달에 문제가 생기면 귀찮아지거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200705
					],
					"speakerTitle": "헤르타"
				},
				{
					"id": 101200705,
					"content": "한번 위쪽으로 가보세요, 그 사람이 있을지도 몰라요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
