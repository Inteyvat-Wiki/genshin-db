					"nextDialogs": [
						101200702
					]
				},
				{
					"id": 101200702,
					"content": "이상한 옛 귀족 말씀이신가요? 그 사람은 못 봤어요, 죄송해요",
					"roleType": "TALK_ROLE_NPC",
