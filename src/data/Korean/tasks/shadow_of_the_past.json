				},
				{
					"id": 101200331,
					"content": "그 맘을 알 것도 같아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200332
					]
				},
				{
					"id": 101200323,
					"content": "로렌스 가문 사람도 기사단에 입단할 수 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200324
