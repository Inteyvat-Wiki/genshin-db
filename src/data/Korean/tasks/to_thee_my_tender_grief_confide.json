			},
			"dialogs": [
				{
					"id": 726610701,
					"content": "이 돌멩이 비싼가? 광석 안에 숨겨져 있는 걸 보면 비싸겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610702
					],
					"speakerTitle": "흑칠 어르신"
				},
				{
					"id": 726610702,
					"content": "돌멩이는 무슨 돌멩이야, 책 좀 안 읽을래? 이건 화석이라고 하는 거야, 알겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610703
					],
					"speakerTitle": "임은둔"
				},
				{
					"id": 726610703,
					"content": "이거 엄청 비싼 거야. 이거 한 개만 있으면 리월항을 살 수 있을 거야! 가서 공부 좀 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610704
					],
					"speakerTitle": "임은둔"
				},
				{
					"id": 726610704,
					"content": "정말이야? 이게 그렇게 비싸? 그러면 우리 벼룩 부자 되는 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610705
					],
					"speakerTitle": "촌뜨기"
				},
				{
					"id": 726610705,
					"content": "벼락부자겠지! 책 좀 읽어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610706
					],
					"speakerTitle": "임은둔"
				},
				{
					"id": 726610706,
					"content": "거기! 너희들, 그 화석 내놔!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610707
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726610707,
					"content": "어! 누구야?! 젠장… 들켰네, 다들 본때를 보여줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "임은둔"
				}
			]
