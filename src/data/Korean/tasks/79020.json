			"trigger": {
				"objectNames": [
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790200101,
					"content": "어디 보자… 이거 어쩌면 보물지도일지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790200102,
					"content": "정말?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200103
					]
				},
				{
					"id": 790200103,
					"content": "흥, 보물의 냄새가 느껴져. 분명 보물지도일 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790200116,
					"content": "이것 좀 봐. 이 지도를 남긴 건 「해적 아코 도메키 일당」이야. 왠지 익숙한 이름인걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790200104,
					"content": "그리고 이것 좀 봐! 「보물이 숨겨진 곳…」이라니. 역시 보물이 있었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790200105,
					"content": "그리고… 「네 개로 나뉘었다」라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790200106,
					"content": "네 개로 나뉘었다고? 무언가를 네 개로 나누었다는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200107,
						790200108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790200107,
					"content": "보물이 네 개나 있다는 뜻인가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				},
				{
					"id": 790200109,
					"content": "잘 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790200110,
					"content": "여기엔 「네 개의 큰 암초에 숨겨두었다」라고 적혀있어. 금사과 제도의 네 개 섬에 숨겨져 있다는 뜻인 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790200111,
					"content": "아, 여기가 바로 암초잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790200112,
					"content": "그렇다면 보물 단서가 네 개라는 뜻이겠네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200113
					]
				},
				{
					"id": 790200113,
					"content": "그리고 네 개 섬의 암초 근처에 있는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790200114,
					"content": "금사과 제도의 네 개 섬이라면 가장 큰 네 개의 섬을 가리키는 것이겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790200115,
					"content": "그럼 다른 섬의 암초 근처도 찾아보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790200108,
					"content": "보물에 대한 단서가 네 개나 있다는 뜻인가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				}
			]
		},
