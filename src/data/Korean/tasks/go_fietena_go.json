			"dialogs": [
				{
					"id": 402200101,
					"content": "자책하지 마, 민니. 이건 네 잘못이 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200102
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 402200102,
					"content": "넌 충분히 잘해줬어…. 콜록",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200103
					],
					"speakerTitle": "탕의강"
				},
				{
					"id": 402200103,
					"content": "의강 오빠, 위로 안 해줘도 돼. 몸도 아픈데 여기까지 오느라 힘들었겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200104,
						402200105
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402200104,
					"content": "경기 결과는 어떻게 됐어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402200106
					]
				},
				{
					"id": 402200106,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402200107,
					"content": "내가 말할게. 미안해, 명예 기사. 내가 부상자를 데리고 결승점에 도착했을 땐, 이미 다른 팀 선수들이 완주를 끝낸 상태였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200108
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402200108,
					"content": "부상자는 구조원이 와서 데려갔고, 우리는… 좋은 성적을 내지 못했어. 미안해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200109
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402200109,
					"content": "다들 앞에서 그렇게 잘해줬는데, 결국 내가 발목을 잡았네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200110
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402200110,
					"content": "민니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200111
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402200111,
					"content": "그 사람을 봤을 때, 솔직히 많이 망설였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200112
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402200112,
					"content": "다들 정말 열심히 준비했잖아. 내가 그 사람을 도우러 가지 않았으면, 절대 지금 같은 성적은 아니었을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200113
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402200113,
					"content": "구조원이랑 엠버 씨도 있고, 너희도 근처에 있었으니 굳이 내가 나서지 않아도 괜찮았을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200114
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402200114,
					"content": "근데 그냥 지나칠 수가 없었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200115
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402200115,
					"content": "괜찮아, 민니. 다 이해해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200116
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402200116,
					"content": "눈앞에 다친 사람이 있는데 어떻게 내버려두겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200117
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402200117,
					"content": "「열혈 투사는 도움을 바라는 손을 절대 외면하지 않아」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200118
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402200118,
					"content": "어? 그 대사는 어디에 나오는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200119
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 402200119,
					"content": "제가 지어낸 거예요, 헤헤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200120
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402200120,
					"content": "…고마워, 대장",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200121
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402200121,
					"content": "민니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200122
					],
					"speakerTitle": "셸린"
				},
				{
					"id": 402200122,
					"content": "무사해서 정말 다행이야. 아깐 얼마나 놀랐는지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200123
					],
					"speakerTitle": "셸린"
				},
				{
					"id": 402200123,
					"content": "우리 딸… 세상에 네 목숨보다 중요한 건 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200124
					],
					"speakerTitle": "모리츠"
				},
				{
					"id": 402200124,
					"content": "다음부턴 이렇게 놀라게 하지 말렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200125
					],
					"speakerTitle": "셸린"
				},
				{
					"id": 402200125,
					"content": "엄마 아빠, 죄송해요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200126
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402200126,
					"content": "일행은 작은 해프닝으로 인해 원하는 성적을 얻지 못했다. 아쉽지만 이게 현실이다. 땀을 흘린다고 해서 반드시 꽃이 피진 않는다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402200127
					]
				},
				{
					"id": 402200127,
					"content": "하지만 함께 웃으며 노력했던 시간은 사라지지 않고, 언젠가 다른 결실로 돌아올지도 모른다.\\n민니는 아쉬우면서도 어딘가 홀가분한 표정이다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402200128
					]
				},
				{
					"id": 402200128,
					"content": "민니 선수, 몸은 좀 괜찮나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200129
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 402200129,
					"content": "아, 심판 선생님, 저는 괜찮아요. 아무 문제 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200130
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402200130,
					"content": "…그쪽은 아까 그…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200131
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402200131,
					"content": "전 「비뢰번개」 팀의 켄조라고 합니다. 그쪽 덕분에 무사할 수 있었어요. 정말 감사합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200132
					],
					"speakerTitle": "헤매는 이나즈마 선수"
				},
				{
					"id": 402200132,
					"content": "여러분, 「비뢰번개」 팀과 조직 위원회의 논의 결과를 말씀드리겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200133
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 402200133,
					"content": "민니 선수가 다른 선수를 구하러 간 행위는 칭찬받아 마땅합니다. 이 사고가 아니었다면 더 높은 성적을 거뒀으리란 점에 위원회 전원이 동의했고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200134
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 402200134,
					"content": "따라서 「열혈 투사」 팀은 현재 순위권이 아니지만, 특별한 포상을 받을 자격이 있다고 판단했습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200135
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 402200135,
					"content": "하여 조직 위원회는 한 사람의 목숨을 구한 선행을 치하하는 의미로, 여러분께 특별 메달을 수여하고자 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200136
					],
					"speakerTitle": "두라프"
				},
				{
					"id": 402200136,
					"content": "감사해요, 두라프 아저씨. 그리고 엄마 아빠, 약속은 지킬게요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200137
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402200137,
					"content": "그래. 그럼 우리 약속대로 하자꾸나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200138
					],
					"speakerTitle": "모리츠"
				},
				{
					"id": 402200138,
					"content": "…안전하게만 다닌다고 약속하면, 밖으로 여행을 다녀도 좋아, 민니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200139
					],
					"speakerTitle": "모리츠"
				},
				{
					"id": 402200139,
					"content": "네? 아빠, 하지만 전 순위가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200140
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402200140,
					"content": "내가 보기엔 충분히 높은 「순위」를 거뒀어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200141
					],
					"speakerTitle": "모리츠"
				},
				{
					"id": 402200141,
					"content": "후후, 그래. 자, 여기 메달도 있잖니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200142
					],
					"speakerTitle": "셸린"
				},
				{
					"id": 402200142,
					"content": "아니면 온 가족이 다 같이 갈까? 네가 제일 좋아하는 야에 출판사로",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200143
					],
					"speakerTitle": "모리츠"
				},
				{
					"id": 402200143,
					"content": "네 엄마 아빠 취향에도 맞는 만화가 있을지 한번 보자꾸나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200144
					],
					"speakerTitle": "모리츠"
				},
				{
					"id": 402200144,
					"content": "잘됐다, 민니! 멋진 시작이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200145
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402200145,
					"content": "나… 너무 기뻐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200146
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402200146,
					"content": "이렇게 기념할 만한 순간에 사진이 빠질 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200147
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 402200147,
					"content": "옳소! 우리 다 같이 사진 찍어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200148
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402200148,
					"content": "「열혈 투사 전기」 2권에서 피에티나가 처음으로 마비카랑 같이 싸웠던 장면 있지? 그 장면대로 한 장 찍자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엘라니"
				},
				{
					"id": 402200105,
					"content": "민니 몸은 좀 괜찮아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402200106
					]
				}
			]
		},
