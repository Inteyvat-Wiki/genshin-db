			"dialogs": [
				{
					"id": 402200201,
					"content": "곧 대회 시작인데 다들 준비 잘했어? 오는 길에 사람이 진짜 많더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402200202,
					"content": "난 수건이랑 따뜻한 국, 담요를 챙겼어. 음… 이 정도면 부족한 건 없겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200203
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 402200203,
					"content": "전에 얘기한 대로면, 대장 쪽은 지금 준비 운동을 하고 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200204
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 402200204,
					"content": "경기가 시작되면 난 바로 결승점으로 가서, 언제든 물이랑 담요를 줄 수 있게 대기하려고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200205
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 402200205,
					"content": "방금 오는 길에 봤는데, 대회가 곧 시작될 것 같아요. 다들 아직도 몸 풀고 있어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200206
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402200206,
					"content": "좀 오래 걸리긴 하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200207
					],
					"speakerTitle": "엘라니"
				},
				{
					"id": 402200207,
					"content": "바레사랑 실로닌이 늦을 사람들은 아닌데… 우리가 가서 살펴볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402200208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402200208,
					"content": "응, 부탁해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "민니"
				}
			]
