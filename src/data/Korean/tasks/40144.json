			"dialogs": [
				{
					"id": 401440101,
					"content": "안녕 귀염둥이, 오늘은 무슨 일로 왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440102
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440102,
					"content": "책 보러 왔니? 아니면 날 보러 왔을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440103,
						401440105
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440103,
					"content": "당연히 리사 씨 보러 왔죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440104
					]
				},
				{
					"id": 401440104,
					"content": "후후, 여전히 다정하구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440107,
					"content": "근데 어쩌지, 오늘 마침 처리해야 할 업무가 있어서 같이 차 마실 시간은 없을 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440108
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440108,
					"content": "와, 리사가 열심히 일하고 있다니, 흔치 않은 일인데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401440109,
					"content": "그러게, 마지막으로 연구를 열심히 한 건 아카데미아에 있을 때였지 아마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440110
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440110,
					"content": "진지하게 머리를 쓰는 건 오랜만이라 정말 힘드네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440111,
						401440112
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440111,
					"content": "설마 논문을 쓰시는 건가요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440113,
					"content": "후후, 관심이 있어 보이네? 너도 같이 하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440114
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440114,
					"content": "그럼 나랑 같이 학창 시절로 돌아가 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440115
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440115,
					"content": "갑자기 업무를 다른 사람에게 떠넘기지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401440116,
					"content": "싫어? 나랑 같이 난관을 헤쳐나갈 수 있는 흔치 않은 기회인데. 한마디 덧붙이자면 보수도 상당하단다?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440117,
						401440118
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440117,
					"content": "자세히 들려주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440119,
					"content": "너도 알겠지만, 기사단에선 연금술에 관련된 연구를 계속하고 있었잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440120
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440120,
					"content": "하지만 연구가 대부분 실험실에서 진행되는 만큼, 일반 사람들은 연금술에 대한 이해도가 그리 높지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440121
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440121,
					"content": "그 결과 그동안 연구에 투자한 비용에 비해 그 효과가 널리 퍼지지 못했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440122
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440122,
					"content": "그래서 진은 민간에 연금술의 산물을 보급할 계획이야…. 현 단계에서는 연금 포션이 되겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440123
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440123,
					"content": "난 평소에 도서관 일을 마치면 기사단의 포션 보급 관리를 도와주고 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440124
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440124,
					"content": "게다가 약물학은 내가 전에 연구했던 주제 중 하나라, 진은 내가 이 일에 가장 적합하다고 생각하나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440125
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440125,
					"content": "하지만 사람들의 일상 수요를 맞추려면 재료도 조절해야 하고, 제조 방식도 간소화할 필요가 있어서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440126
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440126,
					"content": "처음엔 간단했던 과제가 점점 복잡해지더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440127
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440127,
					"content": "설마 우리더러 연구를 도와달라는 건 아니지? 우린 연금술 이론에 대해 아는 게 별로 없는걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401440128,
					"content": "후후, 아니야. 너희한텐 더 알맞은 업무를 생각해 뒀어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440129
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440129,
					"content": "제조 기술 연구는 안정적으로 진행 중이지만, 사람들의 사용 피드백이 수집되지 않아서 수요를 만족하는지 파악하지 못하고 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440130
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440130,
					"content": "포션을 개발하면서 피드백도 수집하려면 더 효율적인 방법이 필요하겠더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440131
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440131,
					"content": "그래서 생각해 낸 방법이 바로 연금 포션을 판매하는 상점을 여는 거야. 그러면 포션을 제조하는 동시에 사람들의 일상 수요도 파악할 수 있을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440132
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440132,
					"content": "와! 두 업무를 하나로 합치다니, 역시 리사다운 발상이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401440133,
					"content": "#맞아. 그리고 이 일에 가장 적합한 사람은 역시 우리 기사단의 에이스, {NICKNAME}(이)겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440134
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440134,
					"content": "아카데미아에 있을 땐 학생들끼리 서로 과제를 도와주곤 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440135
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440135,
					"content": "우리 귀염둥이도 청춘의 삶을 느껴보고 싶지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440136
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440136,
					"content": "어휴, 하여간 말은 듣기 좋게 잘한다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440137,
						401440139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401440137,
					"content": "리사 씨를 위해서 그렇게 할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440138
					]
				},
				{
					"id": 401440138,
					"content": "후후, 역시 믿음직하다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440141,
					"content": "업무가 어느 정도 마무리되면 내가 직접 보수를 준비해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440142
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440142,
					"content": "가게의 사전 준비는 다 해놨어. 앞으로 어떻게 할지는 자리를 옮겨서 얘기하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리사"
				},
				{
					"id": 401440139,
					"content": "하나의 도전이라고 생각하죠, 뭐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440140
					]
				},
				{
					"id": 401440140,
					"content": "좋아, 역시 열정이 넘치는구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "리사"
				},
				{
					"id": 401440118,
					"content": "일단 무슨 일인지 들어보고요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440112,
					"content": "설마 과제를 하시는 건가요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440105,
					"content": "마침 지나가던 길이라…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440106
					]
				},
				{
					"id": 401440106,
					"content": "지나가는 길에 나랑 얘기하고 싶어서 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "리사"
				}
			]
		},
