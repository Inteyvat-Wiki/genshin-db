					}
				]
			},
			"dialogs": [
				{
					"id": 715310101,
					"content": "둥글둥글 푹신푹신, 말랑말랑 탱글탱글…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310102
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310102,
					"content": "어! 손님이다. 안녕, 해피 해등절!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310103
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310103,
					"content": "해피 해등절, 문심!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715310104,
					"content": "방금 뭔가를 중얼거리는 거 같던데, 무슨 말을 하고 있었던 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310105,
						715310106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715310105,
					"content": "맛있는 간식 생각 중이었나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310107
					]
				},
				{
					"id": 715310107,
					"content": "거의 비슷해. 누룽지와 월계가 만들 미식에 대해 생각하고 있었거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310108
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310108,
					"content": "음? 갑자기 익숙한 이름이 튀어나왔네…. 너도 누룽지와 월계를 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715310109,
					"content": "헤헤, 당연하지! 난 만민당의 단골인걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310110
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310110,
					"content": "여행이라도 떠나지 않는 이상 매주 만민당에서 최소 일곱 끼는 먹는다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310111
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310111,
					"content": "집에서 자주 먹는 메뉴에 곁들여서 한 끼는 담백하게, 한 끼는 매콤하게 번갈아 먹으면 진짜 최고야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310112
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310112,
					"content": "매워서 탈이 나도, 약 먹고 이틀 정도 쉬면 다시 먹을 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310113,
						715310114
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310113,
					"content": "굉장하네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310115
					]
				},
				{
					"id": 715310115,
					"content": "나, 나도 저런 삶을 살아보고 싶어졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715310116,
					"content": "아무튼 난 거의 매주 누룽지와 향릉을 만나. 가끔은 요요도 보고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310117
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310117,
					"content": "요요가 월계를 데리고 향릉을 만나러 오면 누룽지도 옆에서 월계랑 놀곤 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310118
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310118,
					"content": "누룽지와 월계가 움직이는 모습만 봐도 업무 피로가 싹 가신다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310119
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310119,
					"content": "하지만 나만 누룽지와 월계에게 치유받을 순 없지! 모두에게 누룽지와 월계의 귀여움을 전파하겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310120
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310120,
					"content": "음! 그거 정말 중요한 일인걸! 그런데 구체적으로 어떻게 할 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715310121,
					"content": "설마 탁자에 있는 물건이 바로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715310122,
					"content": "맞아! 방금 누룽지와 월계를 주인공으로 한 「종이 공연」을 완성했어. 이 노점에 있는 물건은 전부 「종이 공연」의 도구지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310123
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310123,
					"content": "「종이 공연」… 어디선가 들어본 거 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715310124,
					"content": "너희도 「종이극」에 대해서는 들어봤지? 그건 리월에서 오래전에 유실된 예술이야. 그림과 조명을 이용해 은막 위에서 「살아」 움직이는 화면을 연출하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310125
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310125,
					"content": "난 어릴 적부터 「종이극」을 좋아해서 응공 사부님께 약간의 가르침을 받았어. 크고 나서는 화가가 돼서 각지로 유학을 다녔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310126
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310126,
					"content": "그러다 폰타인을 여행할 때 몇 가지 그림과 영화 기술을 배우고 여러 영감을 얻었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310127
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310127,
					"content": "그래서 「종이극」에 기반한 새로운 놀이를 고안해 냈지. 그게 바로 지금 너희 앞에 있는 「종이 공연」이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310128
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310128,
					"content": "「종이 공연」은 「종이극」과 스타일이 달라. 간단하고 명쾌한 이야기로 관객들에게 웃음을 주는 데 중점을 두지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310129
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310129,
					"content": "그래서 올해 첫 「종이 공연」의 내용은 모두에게 매우 친숙한 이야기——누룽지와 월계가 함께 식재료를 찾아 미식을 만드는 이야기야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310130
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310130,
					"content": "누룽지와 월계가 같이 음식을 만든다고? 정말 흥미로운걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310131,
						715310132
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715310131,
					"content": "맛도 있고 재미도 있고!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310133
					]
				},
				{
					"id": 715310133,
					"content": "헤헤, 너희가 그렇게 반응해 주니 나도 의욕이 샘솟는걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310134
					],
					"speakerTitle": "문심"
				},
				{
					"id": 715310134,
					"content": "그럼 당장 시작하자. 마음 편히 「종이 공연」을 즐겨봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "문심"
				},
				{
					"id": 715310132,
					"content": "저도 보고 싶어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310133
					]
				},
				{
					"id": 715310114,
					"content": "너무 무리하진 마세요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310115
					]
				},
				{
					"id": 715310106,
					"content": "새로운 요리 생각 중이었나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310107
					]
				}
			]
		}
	]
}