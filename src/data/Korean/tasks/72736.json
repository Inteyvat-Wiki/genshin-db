			"trigger": {
				"objectNames": [
					"「하나카도 장군」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360101,
					"content": "보기 드문 재능이군, 보기 드문 재능이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360102
					],
					"speakerTitle": "「하나카도 장군」"
				},
				{
					"id": 727360102,
					"content": "아라타키파가 그 수많은 곤충 싸움 강자를 쓰러트릴 줄이야. 아무래도 너희에겐 독특한 싸움 철학이 있는 것 같군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360103
					],
					"speakerTitle": "「하나카도 장군」"
				},
				{
					"id": 727360103,
					"content": "선입견은 이제 버리겠어. 이제부터 너희를 인정하고 풀파워로 싸우겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360104
					],
					"speakerTitle": "「하나카도 장군」"
				},
				{
					"id": 727360104,
					"content": "소몰이 청년, 이제 형님인 네가 등장할 차례야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 727360105,
					"content": "전에 했던 말은 진심으로 여기지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360106,
						727360107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 727360106,
					"content": "나오시죠, 「곤충 싸움의 진검 대귀왕」!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				},
				{
					"id": 727360108,
					"content": "아하하하하하하, 당연하지! 마지막 결투도 당연히 나의 승리다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360109
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 727360109,
					"content": "부하를 어떻게 가르친 건진 모르겠지만, 승패는 이미 판가름 났어. 이 몸의 아라타키파가 승리다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360110
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 727360110,
					"content": "이제 남은 건 너다! 「하나카도 장군」!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 727360107,
					"content": "대격전, 귀왕 대 장군!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				}
			]
		},
		{
			"id": 7273602,
			"completionStepIds": [
				7273603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273603",
							"2"
						],
						"stepId": 7273603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「하나카도 장군」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360201,
					"content": "그래, 그랬군… 한 판 더 하자. 이번엔 네 곤충 싸움 방식을 반드시 파악해낼 테니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360202
					],
					"speakerTitle": "「하나카도 장군」"
				},
				{
					"id": 727360202,
					"content": "이젠 시합의 승패는 중요하지 않을 듯한데, 그냥 통쾌하게 싸워보는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360203
					],
					"speakerTitle": "「하나카도 장군」"
				},
				{
					"id": 727360203,
					"content": "모처럼 죽이 맞는 상대를 만났는데, 몇 분 만에 끝내기에는 아쉽잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360204
					],
					"speakerTitle": "「하나카도 장군」"
				},
				{
					"id": 727360204,
					"content": "하! 얼마든지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360205
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 727360205,
					"content": "근데… 이 몸의 곤충 싸움 비결을 파악하겠다고? 꿈도 크시네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360206
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 727360206,
					"content": "뭐, 내 곤충 싸움 실력이 더 대단하다고 인정하면, 몇 판이라도 싸워주지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360207
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 727360207,
					"content": "흠, 소몰이 청년이랑 「하나카도 장군」은 여전히 열정이 넘치네. 완전히 만족할 때까지 계속 싸우게 내버려 두자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
