				"points": []
			},
			"dialogs": [
				{
					"id": 220060101,
					"content": "대체 어디에 있는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060102
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220060102,
					"content": "이번엔 뭘 잃어버린 거죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060103
					]
				},
				{
					"id": 220060103,
					"content": "아직 안 「잃어버렸어」, 지금 막 찾는 중이라고! 근데——아무리 찾아도 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060104
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220060104,
					"content": "대체 어딨는 거야. 그 위치를 어떻게 찾아낸 건데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060105
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220060105,
					"content": "너도 같이 찾아줘. 그런 귀중한 유물은 절대 밖으로 유출돼선 안 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060106,
						220060107
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220060106,
					"content": "알겠어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060108
					]
				},
				{
					"id": 220060108,
					"content": "그럼 넌 저쪽을 찾아봐. 난 계속 여길 찾아볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060109
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220060109,
					"content": "꼭 찾아야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "보아"
				},
				{
					"id": 220060107,
					"content": "이번엔 또 무슨 유물인가요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060110
					]
				},
				{
					"id": 220060110,
					"content": "음… 그러니까… 엄청 오래된 거야! 천년… 아니, 마신들의 전쟁이 있던 시대까지 거슬러 올라갈지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060111
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220060111,
					"content": "아무튼 엄청 귀중한 유물이니까 절대 밖으로 유출돼선 안 돼! 너도 같이 찾아줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "보아"
				}
			]
		},
