			"dialogs": [
				{
					"id": 220060601,
					"content": "왜 이렇게 늦었어. 뭐 찾은 거 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060602,
						220060603
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220060602,
					"content": "이걸 찾았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060604
					]
				},
				{
					"id": 220060604,
					"content": "하… 상태는 괜찮아 보이는데, 내가 찾는 것과는 너무 다른걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060605
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220060605,
					"content": "하지만 이것도 유물이니 일단 내가 보관할게. 걱정 마, 내가 그 가치를 충분히 발휘시킬 테니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060609
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220060609,
					"content": "수고했어. 이건 너한테 주는 거니까 받아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060610
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220060610,
					"content": "휴, 근데 그 유물을 아직 못 찾아서 정말 걱정이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "보아"
				},
				{
					"id": 220060603,
					"content": "이게 당신이 찾던 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060606
					]
				},
				{
					"id": 220060606,
					"content": "상태는 괜찮아 보이는데, 내가 찾는 물건은 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060607
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220060607,
					"content": "아 맞다, 넌 유물을 어떻게 보관하는지 모르니, 이걸 파손시킬 수도 있겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060608
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220060608,
					"content": "이건 내가 보관하고 있을게. 그 가치를 충분히 발휘하게 할 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060609
					],
					"speakerTitle": "보아"
				}
			]
