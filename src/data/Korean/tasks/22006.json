			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"소라야"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060301,
					"content": "고마워, 여행자. 휴… 아깐 진짜 깜짝 놀랐어. 보물 사냥단이 점점 더 날뛰는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060302
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060302,
					"content": "누구세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060303
					]
				},
				{
					"id": 220060303,
					"content": "난 떠돌이 학자 소라야라고 해. 지금 여기서 연구를 진행 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060304
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060304,
					"content": "며칠 전 단서를 쫓다 유적을 발견했고 거기서 마신 전쟁 시기의 역사가 적혀있는 옥쟁반을 찾았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060305
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060305,
					"content": "근데 옥쟁반을 가지고 유적 밖으로 나왔을 때 보물 사냥단의 습격을 받았지 뭐야. 도망을 쳐봤지만, 결국엔 따라잡히고 말았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060306
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060306,
					"content": "너희가 아니었다면 나랑 옥쟁반 모두 위험했을 거야. 다시 한번 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060307
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060307,
					"content": "당신도 학자인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060308
					]
				},
				{
					"id": 220060308,
					"content": "…도? 여기서 연구하고 있는 다른 학자가 더 있다고? 그럼 그 사람 이름이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060309
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060309,
					"content": "보아… 잠시만, 아까 날 습격한 보물 사냥단 중에 한 명이 「어떻게 하면 보아가 보물을 독식하게 할 수 있을까」라고 말하는 걸 들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060310
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060310,
					"content": "이런 우연이 다 있다니…. 미안, 네가 만난 「보아」에 대해 자세히 말해줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060311
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060311,
					"content": "사실…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060312
					]
				},
				{
					"id": 220060312,
					"content": "…그 「보아」가 너한테 알려준 위치가 공교롭게도 전부 내가 선택한 곳이네. 「우연」도 참 이런 우연이 다 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060313
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060313,
					"content": "만약 그녀가 진짜로 보물 사냥단의 일원이라고 한다면, 보물 사냥단은 오래전부터 날 미행했고 날 따라다니면서… 「따끈한 현물을 주우려 했다는」 걸로 추측할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060314
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060314,
					"content": "「보아」는 재물을 독식하고파서 홀로 먼저 진행하려고 했는데 혼자서는 이 넓은 범위를 다 수색 못하니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060315
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060315,
					"content": "보아하니… 여행자, 너도 이용당한 거네. 이번의 위치도 그녀가 벌써 찍어둔 곳이었나 보네. 다만 그녀의 동료와 내가 너보다 일찍 왔다 뿐이고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060316
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060316,
					"content": "긴장하지 마. 이건 전부 추측일 뿐이야. 하지만 「보아」라는 이름… 엄청 수상하게 들려. 어쩌면 가명이거나 별명일 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060317
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060317,
					"content": "여행자, 그녀를 속여줄 수 있어? 어찌됐든 이 옥쟁반을 수상한 사람한텐 넘길 순 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060318,
						220060319
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060318,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060320
					]
				},
				{
					"id": 220060320,
					"content": "고마워. 근데 이렇게 빈손으로 돌아가게 되면, 분명 널 의심할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060321
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060321,
					"content": "그렇다면 나한테 별로 안 귀중한 물건이 있는데, 이걸 가지고 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060322
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060322,
					"content": "비록 보잘것없는 거지만, 그래도 그녀의 의심을 피할 순 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060325,
					"content": "됐으니까, 어서 빨리 돌아가 봐. 네가 그녀의 동료들을 쫓아내긴 했지만, 그녀는 홀로 행동하니까 동료들이 너의 일을 그녀한테 알릴 순 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060326
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060326,
					"content": "맞다! 만약 그녀가 다음에도 너한테 뭘 찾으라고 시켜서 진짜로 뭔가를 찾는다면 나한테 가져와. 난 평소에 망서 객잔에 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060327
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060327,
					"content": "휴, 내 능력에 한계가 있지만… 그래도 문화재 하나는 지킬 수 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060319,
					"content": "빈손으로 들어가면 그녀가 의심하지 않을까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060323
					]
				},
				{
					"id": 220060323,
					"content": "음… 맞아. 그렇다면 나한테 별로 안 귀중한 물건이 있는데, 이걸 가지고 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060324
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220060324,
					"content": "비록 보잘것없는 거지만, 그래도 그녀의 의심을 피할 순 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "소라야"
				}
			]
		},
