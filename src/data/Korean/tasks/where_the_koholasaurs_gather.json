			"dialogs": [
				{
					"id": 150080101,
					"content": "#{NICKNAME}, 페이몬, 여기야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080102
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150080102,
					"content": "말라니, 벌써 왔구나. 앗, 그 이상한 아저씨도 있네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150080103,
					"content": "안녕, 좋은 아침이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080104
					],
					"speakerTitle": "카르야"
				},
				{
					"id": 150080104,
					"content": "좋은 아침!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150080105,
					"content": "출발은 언제야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080106
					],
					"speakerTitle": "비람드라"
				},
				{
					"id": 150080106,
					"content": "하하, 여행 가기 전에 들뜬 어린애처럼 구시네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080107
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150080107,
					"content": "할 일을 빨리 시작하고 싶을 뿐이야…. 이건 가벼운 봄 소풍이 아니잖아. 서로 조금 더 전문적인 태도로 임했으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080108
					],
					"speakerTitle": "비람드라"
				},
				{
					"id": 150080108,
					"content": "걱정 마세요, 저도 가이드 일엔 프로니까요. 크흠… 그럼, 신비의 섬 여행을 정식으로 시작합니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080109
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150080109,
					"content": "오예!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150080110,
					"content": "우선, 다들 이 조각상을 봐주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080111
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150080111,
					"content": "응응, 무슨 중요한 단서인 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150080112,
					"content": "단서는 아니고, 우리 「샘물 무리」의 초대 족장이 신비의 섬에서 돌아온 후에 세운 거야. 기념물에 가깝지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080113
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150080113,
					"content": "출발하기 전에 우선 조각상을 만지면서 선조님께 기도를 드려야 해. 그럼 섬으로 향하는 여정이 훨씬 더 순탄해지거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080114
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150080114,
					"content": "…그 주장에 이론적 근거가 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080115
					],
					"speakerTitle": "비람드라"
				},
				{
					"id": 150080115,
					"content": "근거요? 그런 건 없어요. 그치만 스승님은 이걸 신비의 섬에 갈 때 반드시 거쳐야 하는 첫 단계라고 하셨죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080116
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150080116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080117
					],
					"speakerTitle": "비람드라"
				},
				{
					"id": 150080117,
					"content": "훌륭해요. 자기 분야가 아닌 일에 이러쿵저러쿵 지적하지 않는 건 아주 프로다운 행동이었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080118
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150080118,
					"content": "그래… 다만 이러면 이건 논문에 쓸 수 없겠군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080119
					],
					"speakerTitle": "비람드라"
				},
				{
					"id": 150080119,
					"content": "자, 다 같이 해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080120
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150080120,
					"content": "존경하는 선조님, 당신의 후손이 과거의 발자취를 따라 그 위업을 재현하려 합니다. 부디 저희가 당신의 시선 아래 출발해, 당신의 보살핌 아래 돌아오게 해주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080121
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 150080121,
					"content": "뭔가 진짜로 위대한 모험이 시작되는 느낌이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150080122,
					"content": "이제 다들 준비하세요. 첫 번째 단서를 찾으러 갈 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "말라니"
				}
			]
		},
