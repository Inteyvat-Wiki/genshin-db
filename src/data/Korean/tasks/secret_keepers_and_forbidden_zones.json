				"points": []
			},
			"dialogs": [
				{
					"id": 40090101,
					"content": "리니… 저기, 미안해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090102
					],
					"speakerTitle": "프레미네"
				},
				{
					"id": 40090102,
					"content": "나도 미안해, 오빠. 좀 더 조심했어야 했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090103
					],
					"speakerTitle": "리넷"
				},
				{
					"id": 40090103,
					"content": "그런 말 마. 다 내 잘못이야…. 조심했어야 하는 건 나였는데, 하마터면 너희 둘 다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090104
					],
					"speakerTitle": "리니"
				},
				{
					"id": 40090104,
					"content": "내가 더 실력이 있었으면 지금쯤 「타르탈리아」 님을 찾았을 수도 있는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090105
					],
					"speakerTitle": "프레미네"
				},
				{
					"id": 40090105,
					"content": "아냐! 왜 그런 소리를 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090106
					],
					"speakerTitle": "리니"
				},
				{
					"id": 40090106,
					"content": "어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090107
					],
					"speakerTitle": "프레미네"
				},
				{
					"id": 40090107,
					"content": "…미안…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090108
					],
					"speakerTitle": "리니"
				},
				{
					"id": 40090108,
					"content": "그러니까 우리 모두 충분히 조심하지 않았다는 거지? 결국 공동 책임이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090109
					],
					"speakerTitle": "리넷"
				},
				{
					"id": 40090109,
					"content": "아, 맞아! 공동 책임!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090110
					],
					"speakerTitle": "프레미네"
				},
				{
					"id": 40090110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090111
					],
					"speakerTitle": "리니"
				},
				{
					"id": 40090111,
					"content": "오빠, 우리를 걱정하는 거 알아. 하지만 우리도 오빠를 걱정하고 있어. 그러니까 그런 표정 하지 말고… 기운 내",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090112
					],
					"speakerTitle": "리넷"
				},
				{
					"id": 40090112,
					"content": "…응",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리니"
				}
			]
		},
