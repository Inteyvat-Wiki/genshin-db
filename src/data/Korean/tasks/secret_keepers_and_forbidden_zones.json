					{
						"sceneId": 1086,
						"position": [
							5.4,
							0.056,
							-4.372
						],
						"pointId": 58
					},
					{
						"sceneId": 1086,
						"position": [
							4.946,
							0.056,
							-5.116
						],
						"pointId": 59
					}
				]
			},
			"dialogs": [
				{
					"id": 40090901,
					"content": "여기야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090902
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090902,
					"content": "공작님! 마침 잘 오셨어요. 최신 데이터가 지금…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090903
					],
					"speakerTitle": "쥐리에"
				},
				{
					"id": 40090903,
					"content": "잠깐만, 쥐리에. 다른 사람이 있잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090904
					],
					"speakerTitle": "루르빈"
				},
				{
					"id": 40090904,
					"content": "엥? 쥐리에랑 루르빈이잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090905
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 40090905,
					"content": "괜찮아. 이 둘은 이미 우리 계획을 알고 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090906
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090906,
					"content": "네? 누구에게도 계획을 발설하면 안 된다면서요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090907
					],
					"speakerTitle": "루르빈"
				},
				{
					"id": 40090907,
					"content": "제 생각도 같습니다. 정말 믿을 수 있는 겁니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090908
					],
					"speakerTitle": "쥐리에"
				},
				{
					"id": 40090908,
					"content": "대답은 이미 알고 있잖아? 이 둘은 너희가 생각하는 것보다 훨씬 많이 알고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090909
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090909,
					"content": "…알겠습니다. 그렇게 말씀하신다면야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090910
					],
					"speakerTitle": "쥐리에"
				},
				{
					"id": 40090910,
					"content": "확실히 적의는 느껴지지 않으니… 믿을 수 있을지도 모르겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090911
					],
					"speakerTitle": "루르빈"
				},
				{
					"id": 40090911,
					"content": "다시 소개하지. 이쪽은 쥐리에, 폰타인 과학원의 최고급 인재 중 하나야. 전에는 에드윈 밑에서 일했는데, 에드윈이라고 알지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090912,
						40090914
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090912,
					"content": "알고 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090913
					]
				},
				{
					"id": 40090913,
					"content": "좋아, 설명하는 수고를 덜었군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090916
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090916,
					"content": "에드윈은 주로 아르케 광석과 중력 장치를 연구했는데, 쥐리에는 그의 조수로서 관련 기술을 알고 있어. 그래서 내 기술 고문으로 고용했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090917
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090917,
					"content": "서… 설마 메로피드 요새를 날려버릴 생각이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090918
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 40090918,
					"content": "하, 그거 멋진데. 절로 그 광경이 떠올랐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090919
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090919,
					"content": "저도 가슴이 뛰네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090920
					],
					"speakerTitle": "쥐리에"
				},
				{
					"id": 40090920,
					"content": "여러분, 선 넘지 마세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090921
					],
					"speakerTitle": "루르빈"
				},
				{
					"id": 40090921,
					"content": "이쪽의 성실한 루르빈 씨도 내 기술 고문이야. 공교롭게도 쥐리에는 에드윈의 조수였고, 루르빈은 쥐리에의 조수였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090922
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090922,
					"content": "그게 가능하다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090923
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 40090923,
					"content": "일부러 그런 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090924
					]
				},
				{
					"id": 40090924,
					"content": "봐, 다들 이렇게 묻잖아. 너희들 사실 일을 핑계로 연애하고 있는 거 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090925
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090925,
					"content": "그게 무슨… 공작님, 우리 사귀고 있는 거 아니에요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090926
					],
					"speakerTitle": "루르빈"
				},
				{
					"id": 40090926,
					"content": "제가 미치지 않은 이상에야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090927
					],
					"speakerTitle": "쥐리에"
				},
				{
					"id": 40090927,
					"content": "어이쿠, 그냥 못 들은 걸로 해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090928
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090928,
					"content": "자, 날 따라와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090929
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090929,
					"content": "우왓, 또 올라가는 문이 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090930
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 40090930,
					"content": "자꾸 그렇게 감탄해 주면 메로피드 요새에 대한 불필요한 자긍심이 생길 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090931
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090931,
					"content": "헤헤… 난 진짜 굉장하다고 생각한 것뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090932
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 40090932,
					"content": "평범한 방이네요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090933
					]
				},
				{
					"id": 40090933,
					"content": "절차가 좀 더 필요하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090934
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090934,
					"content": "잘 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090935
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090935,
					"content": "이건…?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090936
					]
				},
				{
					"id": 40090936,
					"content": "커다란… 배인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090937
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 40090937,
					"content": "게다가 여기는 처음 보는 공장 구역인데…. 어떻게 된 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090938
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 40090938,
					"content": "폰타인 역사에 대해 얼마나 알고 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090939
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090939,
					"content": "으음… 별로 잘 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090940
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 40090940,
					"content": "그럼 레무리아 이야기는 아직 모르겠군. 간단히 말하자면, 고대 폰타인은 레무리아 왕조가 통치했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090941
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090941,
					"content": "전설에 따르면 레무리아 황제 레무스는 계시를 받고 황금 벌로 변신한 예언자 시빌을 찾아갔어. 그리고 황금 벌과 함께 커다란 함선 포르투나호를 이끌고 바다 위에 자신의 나라를 건설했다고 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090942
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090942,
					"content": "그는 나라의 국호를 레무리아라 명명하고는, 포르투나호를 타고 새로운 섬과 부족을 찾아다니면서 그들을 제국의 통치하에 두었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090943
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090943,
					"content": "그 이야기에도 배가 나오네…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090944
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 40090944,
					"content": "물이 있는 곳에는 언제나 배가 있지. 사람들은 배가 모두를 희망으로 인도한다고 믿거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090945
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090945,
					"content": "너도 그렇게 믿어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090946
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 40090946,
					"content": "나는… 반신반의랄까. 하지만 너도 봤다시피 내겐 공장 단위의 재료와 기술, 그리고 인력이 있잖아? 그럼 한번 시도해 볼 만하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090947
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090947,
					"content": "그래서 처음 저 수문 아래에 원시 모태 바다가 있을 수 있겠다고 추측했을 때부터 이렇게 해야겠다고 생각했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090948
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090948,
					"content": "전설 속의 포르투나호에서 영감을 받은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090949
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 40090949,
					"content": "재앙이 코앞인데, 폰타인에 이 정도 수단은 있어야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090950,
						40090951
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090950,
					"content": "원대한 계획이네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090952
					]
				},
				{
					"id": 40090952,
					"content": "여기 죄수들이 배 뒤에 숨겨진 재앙에 대해 알면, 진짜 재앙이 오기도 전에 폭동으로 메로피드 요새를 파괴해 버릴 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090953
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090953,
					"content": "관리자로서 그런 무모한 짓은 할 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090954
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090954,
					"content": "자, 이 정도면 충분하겠지? 차 세 잔 분량은 말한 것 같은데, 더 궁금한 거 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090955
					],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090955,
					"content": "없는 것 같네. 그럼 돌아가자. 바래다줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "라이오슬리"
				},
				{
					"id": 40090951,
					"content": "왜 몰래 진행하는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090952
					]
				},
				{
					"id": 40090914,
					"content": "저야 모르죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40090915
					]
				},
				{
					"id": 40090915,
					"content": "에드윈은 폰타인 과학원을 통째로 폭발시켜버린 녀석이야. 공인된 미친놈이지. 하지만 넌 이곳 사람도 아니고 모르는 게 이상할 건 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40090916
					],
					"speakerTitle": "쥐리에"
				}
			]
		},
