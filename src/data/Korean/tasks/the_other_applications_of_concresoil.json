			"dialogs": [
				{
					"id": 230090201,
					"content": "재료를 더 사 와야겠군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090202
					],
					"speakerTitle": "아킴"
				},
				{
					"id": 230090202,
					"content": "「젤리 진흙」에 관한 연구는 잘 되어가나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090203
					]
				},
				{
					"id": 230090203,
					"content": "물론이지! 이 진흙의 응용 범위는 내 상상을 훨씬 넘어섰어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090204
					],
					"speakerTitle": "아킴"
				},
				{
					"id": 230090204,
					"content": "도자기에 쓸 수 있는 건 물론 집에 생긴 구멍도 메울 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090205
					],
					"speakerTitle": "아킴"
				},
				{
					"id": 230090205,
					"content": "진흙의 혼합 비율을 조금만 조정하면 집을 지을 수도 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090206
					],
					"speakerTitle": "아킴"
				},
				{
					"id": 230090206,
					"content": "그런데… 개발된 진흙이 너무 잘 팔려서 재료가 또 부족하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090207
					],
					"speakerTitle": "아킴"
				},
				{
					"id": 230090207,
					"content": "제일 중요한 슬라임 응축액까지 다 써버렸어. 여행자, 슬라임 응축액을 세 개만 더 갖다줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090208,
						230090209
					],
					"speakerTitle": "아킴"
				},
				{
					"id": 230090208,
					"content": "맡겨만 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090212
					]
				},
				{
					"id": 230090212,
					"content": "그러니까 부탁할게. 슬라임 응축액 세 개를 갖다줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아킴"
				},
				{
					"id": 230090209,
					"content": "다른 재료는요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230090210
					]
				},
				{
					"id": 230090210,
					"content": "다른 재료는 벌써 구매 예약하거나 부탁해뒀지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090211
					],
					"speakerTitle": "아킴"
				},
				{
					"id": 230090211,
					"content": "그치만 슬라임 응축액은 내 생각보다 훨씬 빨리 줄어들더라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230090212
					],
					"speakerTitle": "아킴"
				}
			]
		},
