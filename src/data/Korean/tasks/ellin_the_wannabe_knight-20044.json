			},
			"dialogs": [
				{
					"id": 200440101,
					"content": "골치 아프네…. 이걸 어떻게 해결해야 하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440102
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200440102,
					"content": "뭐 하는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440103
					]
				},
				{
					"id": 200440103,
					"content": "다음 기사단 선발을 위해 훈련 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440104
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200440104,
					"content": "음… 하지만 난 진 단장님 같은 힘이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440105
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200440105,
					"content": "「힘」을 단련하는 것보다는 「기술」을 익히는 게 나한테 더 맞는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440106
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200440106,
					"content": "예를 들어, 이 통나무들을 단숨에 모두 파괴하는 방법 같은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440107
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200440107,
					"content": "시간 있으면 너도 나랑 같이 생각해보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440108,
						200440109
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200440108,
					"content": "한번 생각해볼게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440110
					]
				},
				{
					"id": 200440110,
					"content": "괜찮아. 통나무는 어디 도망 안 가니까 천천히 생각해도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440111
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200440111,
					"content": "홀로 도망갈 수 있는 건 흘러가는 시간과 생명체밖에 없으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200440114,
					"content": "더 큰 무기를 사용하거나 진 단장님처럼 원소의 힘을 사용할 수 있다면, 통나무를 손쉽게 전부 부술 수 있을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엘린"
				},
				{
					"id": 200440109,
					"content": "우리 둘이 같이 하는 건…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440112
					]
				},
				{
					"id": 200440112,
					"content": "단체 전투 해봤어? 언제든지 도움을 요청할 수 있으니…. 정말 부러운 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440113
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200440113,
					"content": "나 같은 사람은 그냥 독자적인 전투만 배워야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "엘린"
				}
			]
		},
