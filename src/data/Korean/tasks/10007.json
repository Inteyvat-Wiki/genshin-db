			"dialogs": [
				{
					"id": 100070701,
					"content": "#좋아, 여기까지야. 정말 아름다운 합주였어. 고마워, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070702
