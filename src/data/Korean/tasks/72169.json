			"dialogs": [
				{
					"id": 721690201,
					"content": "여행자, 수확이 좀 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690202
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690202,
					"content": "오! 이 꽃게 괜찮아 보이네, 너 대단하구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690203
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690203,
					"content": "재료도 다 갖춰졌으니까 요리를 시작해볼까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690204
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690204,
					"content": "여행자, 요리할 준비를 할 테니 잠시만 기다려 줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동욱"
				}
			]
		},
		{
