			},
			"dialogs": [
				{
					"id": 721690101,
					"content": "이 음식 이름이 딱 줄리 스타일이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690102
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690102,
					"content": "맞아, 나도 처음 봤을 때 몬드의 음식인 줄 알았는데, 이나즈마 특산 요리였어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690103
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721690103,
					"content": "이름이 좋은 만큼 틀림없이 맛도 좋을 거야. 그럼 동욱, 잘 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690104,
						721690105
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 721690104,
					"content": "또 만났네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				},
				{
					"id": 721690106,
					"content": "오! 여행자구나, 헤헤, 내가 또 만날 수 있을 거라 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690107
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690107,
					"content": "동욱이 새로운 레시피를 얻었어! 「게딱지 구이」라는 건데 맛있겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690108
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 721690108,
					"content": "이 음식은 간단한데 꽃게가 많이 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690109
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690109,
					"content": "일반 꽃게는 이미 구했고, 조금… 특별한 꽃게를 찾는 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690110
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690110,
					"content": "특별한 꽃게?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690111
					]
				},
				{
					"id": 721690111,
					"content": "응, 바로 번개의 벚나무 아래서 사는 꽃게야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690112
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690112,
					"content": "그냥… 벼락 맞은 꽃게라고 말하면 되는걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690113
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721690113,
					"content": "하하하, 어쨌든 이런 환경에서 자라는 꽃게는 무슨 맛일지 정말 궁금해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690114
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690114,
					"content": "하지만… 번개의 벚나무엔 벼락이 끊기질 않아 우린 접근할 수가 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690115
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690115,
					"content": "책에선… 이전과 같이 「번개의 벚나무 가지」를 먼저 만지고, 「번개 씨앗」이 몸에 부착되면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690116
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721690116,
					"content": "번개의 벚나무 근처의 벼락을 안 맞을 수 있다고 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690117
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721690117,
					"content": "하지만 벼락이 저렇게 치고 있는데, 대충 적혀있는 기록만 믿고 가기에는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690118
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721690118,
					"content": "근데 달리기가 빠르면 문제없지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690119
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690119,
					"content": "네가 아무리 빨라도… 번개 속도보다 빠를까?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690120
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721690120,
					"content": "그럼 멀리서 나뭇가지 같은 거로 꽃게를 집어내면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690121
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 721690121,
					"content": "차라리 옆에 도랑을 만들어서 꽃게를 유인해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690122
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721690122,
					"content": "하하하… 다들 아이디어가 넘치네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690123
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690123,
					"content": "괜찮으면 너도 한번 번개의 벚나무 옆에 있는 꽃게 잡아봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690124
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690124,
					"content": "잡아서 나한테 주면 맛있는 음식을 대접할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690125
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690125,
					"content": "아, 잠시만… 이 미끼를 받아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690126
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690126,
					"content": "꽃게를 잡을 거면 먼저 이 미끼를 사용해서 꽃게들을 유인해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690127
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690127,
					"content": "그러면 시간이 조금 절약될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690128
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690128,
					"content": "번개의 벚나무 옆에서 사는 꽃게라… 음, 무슨 맛일지 궁금하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690105,
					"content": "이번엔 어떤 맛있는 요리야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				}
			]
		},
