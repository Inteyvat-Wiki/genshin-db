			"dialogs": [
				{
					"id": 721690301,
					"content": "게딱지 구이는… 왜 게딱지 구이라고 할까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690302
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690302,
					"content": "모르겠다, 일단 만들고 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690303
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690303,
					"content": "완성! 이게 바로「게딱지 구이」야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690304
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690304,
					"content": "나도 먹을래! 음… 난 이거!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690305
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 721690305,
					"content": "난 작은 거 하나만 줘, 큰 거는 다 못 먹을 거 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690306
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721690306,
					"content": "자, 이건 네 몫이야, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690307
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690307,
					"content": "그리고 이건 「게딱지 구이」 레시피야, 이것도 가져가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690308
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690308,
					"content": "간단한 요리니까 나중에 시간 되면 한번 직접 요리해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690311
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690311,
					"content": "다음엔 <color=#00E1FFFF>야시오리섬</color> 근처로 갈 거야. 시간 있으면 만나러 와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690309
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690309,
					"content": "나도 이제 먹어야겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690310
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721690310,
					"content": "잠깐! 줄리! 다 먹지 말고 내 거 좀 남겨줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동욱"
				}
			]
		},
