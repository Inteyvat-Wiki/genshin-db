			},
			"dialogs": [
				{
					"id": 220430101,
					"content": "나무를 벌써 또 다 써버렸네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430102
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430102,
					"content": "아! 여행자, 마침 잘 왔어. 뭐 좀 도와줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430103,
						220430104
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430103,
					"content": "뭐를요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				},
				{
					"id": 220430105,
					"content": "요즘 대리 궁사님의 모습을 본뜬 아주 작은 사이즈의 나무 조각상을 만들고 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430106
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430106,
					"content": "좀 잘하게 되면, 이 조각상들을 가지고 나루카미섬으로 돌아가서 팔아볼까 생각 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430107
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430107,
					"content": "만약 팔린다면, 안정적인 수입이 생기게 되겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430108,
						220430111
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430108,
					"content": "팔릴 수 있을 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430109
					]
				},
				{
					"id": 220430109,
					"content": "하하하, 그 말 믿어볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430110
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430110,
					"content": "하지만, 나도 대리 궁사님이 매력적이라고 생각해, 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430118,
					"content": "아… 이런 건 됐고, 본론을 말할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430119
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430119,
					"content": "사실, 요즘 연습용으로 쓰는 목재가 좀 부족해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430120
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430120,
					"content": "여행자, 밖에서 「오토기나무」를 10개 정도만 좀 찾아줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430121,
						220430123
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430121,
					"content": "제게 맡겨요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430122
					]
				},
				{
					"id": 220430122,
					"content": "그럼 부탁해, 여행자. 정말 도와줘서 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430126,
					"content": "오토기나무를 다 모으면 가져다 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430123,
					"content": "그렇게나 많이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430124
					]
				},
				{
					"id": 220430124,
					"content": "시작한 지 얼마 안 됐으니까… 재료를 넉넉히 준비해두면 좋지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430125
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430125,
					"content": "그럼 부탁해, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430111,
					"content": "어쩌다 갑자기 나무 조각상을 시작한 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430112
					]
				},
				{
					"id": 220430112,
					"content": "물어보니까 대답하는데… 그, 대리 궁사님이 「보수」로 뭘 주는지 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430113
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430113,
					"content": "그런… 깡통이나 찻잔 같은 것들이라니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430114
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430114,
					"content": "보기에는 낡은 것 같지만, 남들한테 보여주고 나니, 이것들이 꽤나 골동품인 데다 괜찮은 가격에 팔 수 있다고 하더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430115
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430115,
					"content": "근데 그 물건들을 파는 과정이 정말 귀찮고, 매번 힘이 많이 들어서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430116
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430116,
					"content": "게다가, 이런 식의 수입은 안정적이지 않으니까… 만약에 대리 궁사님이 이런 걸 찾아내지 못하면, 난 실업한 거나 마찬가지라서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430117
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430117,
					"content": "그래서, 살길을 개척해 보는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "오오시마 준페이"
				},
				{
					"id": 220430104,
					"content": "뭐 하고 계세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				}
			]
		},
