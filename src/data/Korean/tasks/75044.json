			},
			"dialogs": [
				{
					"id": 750440701,
					"content": "위층 용 소환대는 온종일 개방하오니, 마타카 특별 훈련소에 참여하실 분과 용은 상층 용소환대에서 이륙하시기 바랍니다. 주의:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440702
					],
					"speakerTitle": "눈에 띄는 슬로건"
				},
				{
					"id": 750440702,
					"content": "노력은 영광이고 게으름은 수치다!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440703
					],
					"speakerTitle": "눈에 띄는 슬로건"
				},
				{
					"id": 750440703,
					"content": "오늘 노력하지 않으면 내일 끼니는 쓰레기로 때운다!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440704
					],
					"speakerTitle": "눈에 띄는 슬로건"
				},
				{
					"id": 750440704,
					"content": "밝은 미래를 위해 용감하게 앞으로 나아가자!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "눈에 띄는 슬로건"
				}
			]
		},
		{
			"id": 7504408,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
