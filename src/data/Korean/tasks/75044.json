			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440801,
					"content": "암호: 왼쪽 나팔을 불고 오른쪽 나팔을 분 다음 왼쪽 나팔을 불고 마지막으로 오른쪽 나팔을 부십시오. 멋대로 불어서 생긴 문제는 직접 책임져야 합니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440802
					],
					"speakerTitle": "마타카! 명심해!!"
				},
				{
					"id": 750440802,
					"content": "화난 용이 당신을 쪼을 수 있으니, 먹이로 줄 새고기를 챙겨 가십시오!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440803
					],
					"speakerTitle": "마타카! 명심해!!"
				},
				{
					"id": 750440803,
					"content": "(마타카가 자신에게 쓴 비망록인 듯하다. 글자에서 열정이 느껴진다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440804
					],
					"speakerTitle": "마타카! 명심해!!"
				},
				{
					"id": 750440804,
					"content": "(하지만 모든 문구 뒤에 느낌표를 추가해서 느낌표의 강조 의미가 퇴색된 것 같다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마타카! 명심해!!"
				}
			]
		},
		{
			"id": 7504417,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
