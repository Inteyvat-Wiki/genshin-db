			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443801,
					"content": "(폰타인 극작가 진·브루클린의 작품. 두껍고 무거워서 작은 사람이 받침대로 쓰기 알맞다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "《티바트 세계사·첫 번째》"
