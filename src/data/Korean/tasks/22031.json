				"points": []
			},
			"dialogs": [
				{
					"id": 220310301,
					"content": "집중을 못 하는 것 같은데? 몸놀림도 어지럽고, 공격할 때의 힘도 일정하지 않고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310302
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220310302,
					"content": "안 되지, 안 돼. 더 준비해서 이따가 다시 대련하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아사쿠라"
				}
			]
		},
		{
