			"dialogs": [
				{
					"id": 220310401,
					"content": "헥, 헥… 네 무예는 나보다 훨씬 뛰어나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310402
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220310402,
					"content": "다음엔 살살 할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310403
					]
				},
				{
					"id": 220310403,
					"content": "아니! 전력으로 임해줘! 고난과 역경 없이는 성장할 수 없는 법이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310404
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220310404,
					"content": "네가 강한 것도 고난을 무수히 겪어왔기 때문이겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310405
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220310405,
					"content": "실례가 안 된다면 물어보고 싶은 게 있어, 넌… 어떻게 그렇게 강해진 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310406,
						220310408
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220310406,
					"content": "드래곤이 비행 훈련을 도와줬어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310407
					]
				},
				{
					"id": 220310407,
					"content": "드, 드래곤과 함께 비행이라니, 믿기지 않는군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220310410,
					"content": "어쩌다 보니… 이렇게 됐어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310411
					]
				},
				{
					"id": 220310411,
					"content": "하하하, 그래? 그럼 넌 천부적인 재능을 타고난 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310412
					],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220310412,
					"content": "나랑 대련해줘서 고마워. 오늘의 비무를 마음 깊이 새길게. 이 보수를 받아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아사쿠라"
				},
				{
					"id": 220310408,
					"content": "거대한 늑대가 무예 수련을 도와줬어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310409
					]
				},
				{
					"id": 220310409,
					"content": "엄청난… 수련이었겠군. 언젠가는 네가 그 늑대와 전투하는 걸 보고 싶어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "아사쿠라"
				}
			]
		},
