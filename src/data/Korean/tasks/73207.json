			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"사바"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030619,
					"content": "아루 마을에서의 생활은 어때요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030620
					]
				},
				{
					"id": 732030620,
					"content": "그런대로 괜찮아. 먹을 것도 있고 살 곳도 있으니 기본적인 생활이 보장되는 것만으로도 만족해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030621
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030621,
					"content": "난 쫓겨난 사람이잖아. 책이나 연구 물품은 바라지도 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030622
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030622,
					"content": "게다가 이 마을은 예전부터 아카데미아에서 추방된 자들의 마을이었어. 생활 여건과 연구 환경이 수메르보다 한참 부족하니 학술적인 분위기가 형성될 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030623
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030623,
					"content": "난 첫 번째 추방자가 아니야. 아마 마지막 추방자도 아닐 테지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030624
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030624,
					"content": "이미 왔으니 적응하면 괜찮아질 거라고 생각하는 수밖에",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030625,
					"content": "어머 나 좀 봐, 갑자기 말이 많아졌네. 그래도 속이 후련하다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030626
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030626,
					"content": "네가 오기 전까진 이렇다 할 친구가 없어서 좀 외로웠거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030629
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030629,
					"content": "이 마을엔 한가하게 꽃이나 심고 있는 사람이 거의 없거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030630
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030630,
					"content": "아… 아니다, 마을 북쪽에 사는 어르신도 땅을 모밭으로 개간해 꽃을 심고 계시지 참",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030631
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030631,
					"content": "한번 찾아간 적이 있었는데, 좀 특이하신 분 같더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030632
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030632,
					"content": "분명 심고 계신 건 「돌」이었는데 꽃을 심는 중이라고 하시질 않나, 날 쫓아내기까지 하시더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030633
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030633,
					"content": "혼자 사시면 적적하실 테니 그 마음도 이해가 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030634
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030634,
					"content": "넌 내 수메르 장미가 피어나도록 도와줬으니까, 그 어르신도 도와드릴 수 있지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030635
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030635,
					"content": "기회가 된다면 두 사람이 어르신을 찾아가 보는 것도 좋을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사바"
				}
			]
		},
