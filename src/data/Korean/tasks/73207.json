			},
			"dialogs": [
				{
					"id": 732030602,
					"content": "이건 제가 채집한 수메르 장미예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030603
					]
				},
				{
					"id": 732030603,
					"content": "정말 그리웠던 꽃이네. 네게 줄 선물도 준비했으니 가져가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030604
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030604,
					"content": "전부 여기서는 싹을 틔울 수 없는 식물들의 씨앗이야. 너도 어딘가에 정원이 딸린 저택이 있다면 꽃들이 자라는 모습을 볼 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사바"
				}
			]
		},
		{
			"id": 7320307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320709",
							"2"
						],
						"stepId": 7320709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"사바"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030701,
					"content": "나랑 이야기 나누러 온 거야? 하고 싶은 말이 정말 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사바"
				}
			]
		},
		{
			"id": 7320308,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320709",
							"2"
						],
						"stepId": 7320709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"사바"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030605,
					"content": "어느 학파의 학자세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030606
					]
				},
				{
					"id": 732030606,
					"content": "내 학파에 관해 이야기하고 싶은 거야? 그 이야기라면 삼일을 꼬박 새워도 모자랄 텐데, 하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030607
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030607,
					"content": "난 예전에 생론파에서 식물 진화를 전공했어. 일종의 실증 연구 학과였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030608
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030608,
					"content": "그건 새로운 재료가 없으면 새로운 결론에 도달하기 힘들다는 걸 의미해. 쉽게 설명하자면, 과거의 식물을 조사하려면 기본적으로 역사적 표본이 필요하다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030609
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030609,
					"content": "그런데 수집하기 쉬운 표본이 어찌나 많은지, 수집 안 된 표본이 없다고 봐도 무방할 정도였어. 아카데미아가 제공할 수 있는 새로운 표본에도 한계가 있었고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030610
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030610,
					"content": "객관적 상황이 이런데도 아카데미아는 계속해서 연구 지표를 요구했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030611
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030611,
					"content": "어떤 사람은 예전의 연구 성과를 들고 와서는 살짝 바꾸고 끼워 맞춰서 제출하기도 했어. 정말 의미 없는 행동이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030612
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030612,
					"content": "사실 우리가 역사 지리적 관점에서 새로운 재료를 찾아본다면 분명히 새로운 발견을 할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030613
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030613,
					"content": "생론파가 중요시하지 않는 문학 소재들도 이용할 수 있을 거야. 그런데 이렇게 하면 인론파와 지론파의 연구 분야를 건드릴 수밖에 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030614
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030614,
					"content": "난 그 분야에 관한 지식이 전혀 없는데, 관련 「지식」을 신청하는 과정은 굉장히 복잡해. 관련 분야의 학자들과 협력하는 건 더더욱 힘든 일이고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030615
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030615,
					"content": "하지만 난 만약 우리가 학문 분야를 뛰어넘은 협력을 할 수만 있다면, 과거 수많은 문제의 돌파구를 찾게 될 거라 믿어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030616
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030616,
					"content": "단지 이런 시도를 해볼 수 없다는 게 슬플 뿐이야. 인론파와 지론파의 괴짜들은 무언가에 관해 이야기를 나눌 때 관점이 너무… 음… 특이해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030617
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030617,
					"content": "그들에게 제안서를 제출할 때는 모든 단어를 심사숙고해서 써야 해. 그렇지 않으면 오해가 생길 수 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030618
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030618,
					"content": "아카데미아에서 쫓겨나기 전에도 난 지론파의 어떤 녀석과 다투고 있었어. 이제는 싸우래도 싸울 수 없지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030625,
					"content": "어머 나 좀 봐, 갑자기 말이 많아졌네. 그래도 속이 후련하다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030626
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030626,
					"content": "네가 오기 전까진 이렇다 할 친구가 없어서 좀 외로웠거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030629
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030629,
					"content": "이 마을엔 한가하게 꽃이나 심고 있는 사람이 거의 없거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030630
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030630,
					"content": "아… 아니다, 마을 북쪽에 사는 어르신도 땅을 모밭으로 개간해 꽃을 심고 계시지 참",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030631
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030631,
					"content": "한번 찾아간 적이 있었는데, 좀 특이하신 분 같더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030632
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030632,
					"content": "분명 심고 계신 건 「돌」이었는데 꽃을 심는 중이라고 하시질 않나, 날 쫓아내기까지 하시더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030633
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030633,
					"content": "혼자 사시면 적적하실 테니 그 마음도 이해가 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030634
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030634,
					"content": "넌 내 수메르 장미가 피어나도록 도와줬으니까, 그 어르신도 도와드릴 수 있지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030635
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030635,
					"content": "기회가 된다면 두 사람이 어르신을 찾아가 보는 것도 좋을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사바"
				}
			]
		},
		{
			"id": 7320309,
