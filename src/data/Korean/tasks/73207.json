				"points": []
			},
			"dialogs": [
				{
					"id": 732900201,
					"content": "정말 그리웠던 꽃이네. 네게 줄 선물도 준비했으니 가져가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900202
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732900202,
					"content": "전부 여기서는 싹을 틔울 수 없는 식물들의 씨앗이야. 너도 어딘가에 정원이 딸린 저택이 있다면 꽃들이 자라는 모습을 볼 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900203
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732900203,
					"content": "어머 나 좀 봐, 갑자기 말이 많아졌네. 그래도 속이 후련하다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900204
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732900204,
					"content": "네가 오기 전까진 이렇다 할 친구가 없어서 좀 외로웠거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900207
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732900207,
					"content": "이 마을엔 한가하게 꽃이나 심고 있는 사람이 거의 없거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900208
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732900208,
					"content": "아… 아니다, 마을 북쪽에 사는 어르신도 땅을 모밭으로 개간해 꽃을 심고 계시지 참",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900209
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732900209,
					"content": "한번 찾아간 적이 있었는데, 좀 특이하신 분 같더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900210
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732900210,
					"content": "분명 심고 계신 건 「돌」이었는데 꽃을 심는 중이라고 하시질 않나, 날 쫓아내기까지 하시더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900211
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732900211,
					"content": "혼자 사시면 적적하실 테니 그 마음도 이해가 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900212
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732900212,
					"content": "넌 내 수메르 장미가 피어나도록 도와줬으니까, 그 어르신도 도와드릴 수 있지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900213
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732900213,
					"content": "기회가 된다면 두 사람이 어르신을 찾아가 보는 것도 좋을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사바"
				}
			]
		}
