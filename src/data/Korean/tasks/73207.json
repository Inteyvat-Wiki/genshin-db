			},
			"dialogs": [
				{
					"id": 732060402,
					"content": "아판 할아버지에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060403
					]
				},
				{
					"id": 732060403,
					"content": "응? 뭔데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060404
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732060404,
					"content": "아판의 고민을 사바에게 말한다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732060405
					]
				},
				{
					"id": 732060405,
					"content": "아, 그래서 내게 도움을 요청하러 온 거구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060406
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732060406,
					"content": "그런 상황에 나를 떠올려 주다니 정말 영광이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060407
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732060407,
					"content": "하지만 나도 종자 재배를 전공한 학자가 아니라서 한계가 있어. 도움이 될 거라고 확신할 순 없네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060408
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732060408,
					"content": "하지만 노력해 볼게. 네가 말한 새로운 품종의 장미를 재배했다는 사람이 어떤 분인지 궁금하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060409
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732060409,
					"content": "시간 되는 날 아판 어르신의 모밭으로 갈게. 나중에 그곳에서 나를 찾아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사바"
				}
			]
		},
		{
			"id": 7320606,
