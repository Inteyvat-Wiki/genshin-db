					"아판",
					"사바"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070321,
					"content": "조용히 기다리자 어린 새싹이 흙에서 모습을 드러낸다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732070301
					]
				},
				{
					"id": 732070301,
					"content": "사바의 방법이 먹혔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732070302,
					"content": "드디어 싹이 텄데이, 드디어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070303
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732070303,
					"content": "샤파카트 어르신의 생전 소원이 이루어질 수 있을 것 같네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070304
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732070304,
					"content": "아판 어르신, 이 장미는 샤파카트 어르신이 재배한 거라고 하셨죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070305
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732070305,
					"content": "새로운 품종을 재배할 수 있었다면 샤파카트 어르신도 저처럼 이곳으로 쫓겨난 학자였던 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070306
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732070306,
					"content": "…맞다. 아재는 이 마을로 쫓겨나 우리 뒤에 있는 이 집에서 한평생을 사셨데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070307
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732070307,
					"content": "그랬군요. 역시 추방자의 최후는 다 이런 거겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070308
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732070308,
					"content": "새로운 품종을 만들어 냈다는 건 일류 학자들만 가능한 일인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070309
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732070309,
					"content": "그런 분이 아카데미아 밖에서 아무런 업적도 남기지 못하고 사라지셨다니 정말 안타깝네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070310
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732070310,
					"content": "사바가 자신의 미래를 생각하는 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070311,
						732070314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732070311,
					"content": "힘내세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070312
					]
				},
				{
					"id": 732070312,
					"content": "그래, 아가. 아직 갈 길도 멀고 해야 할 일도 많다 아이가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070313
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732070313,
					"content": "슬픔에 사로잡히지 말래이. 또 다른 망태 할아범은 보고 싶지 않데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732070317,
					"content": "맞아요, 이렇게 즐거울 때 울상 짓고 있을 순 없죠. 하던 얘기로 돌아올게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070318
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732070318,
					"content": "지금 황금 장미는 이제 막 싹을 틔운 거지 꽃을 피운 게 아니에요. 전 황금 장미가 활짝 피는 걸 보고 싶어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070319
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732070319,
					"content": "저희도 그래요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070320
					]
				},
				{
					"id": 732070320,
					"content": "그럼 우리 씨앗들이 양분을 흡수하도록 조금 더 기다렸다가, 나중에 다시 와서 꽃이 활짝 피는 걸 지켜보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사바"
				},
				{
					"id": 732070314,
					"content": "(어떻게 사바 씨를 위로해 주지…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070315
					]
				},
				{
					"id": 732070315,
					"content": "슬퍼하지 말고 보래이, 아재는 결국 우리에게 황금 장미를 남겼다 아이가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070316
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732070316,
					"content": "꽃들이 샤파카트 아재가 이 세계에 있었음을 말해주고 있데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "아판"
				}
			]
		},
