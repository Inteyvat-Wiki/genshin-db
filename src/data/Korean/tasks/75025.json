			"dialogs": [
				{
					"id": 750250101,
					"content": "우와, 여기는 또 어떤 곳이지? 조그만 산룡이 엄청 많네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750250102,
					"content": "혹시, 산룡들의… 서식지 같은 곳인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750250103,
					"content": "꺄! …우웅?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250104
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250104,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}도 엄청 신이 난 것 같아! 모처럼 친구들이 잔뜩 있어서 그런가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750250105,
					"content": "뀨우?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250106,
					"content": "#아, 저쪽으로 가서 쟤네들이랑 놀고 싶은 거야? 으음, {NICKNAME}, 그러고 보니 {REALNAME[ID(2)|SHOWHOST(true)]}, 얘가 다른 산룡이랑 같이 지냈던 적이 거의 없었던 것 같긴 한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250107,
						750250108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750250107,
					"content": "조심해야 한다?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				},
				{
					"id": 750250109,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250110,
					"content": "#조금 걱정되기는 하지만, 일단 잠깐 앉아서 뭐라도 먹으면서 쉬자. {REALNAME[ID(2)|SHOWHOST(true)]}도 금방 돌아올 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750250111,
					"content": "#근처에서 괜찮은 휴식 장소를 찾은 당신과 페이몬은 {REALNAME[ID(2)|SHOWHOST(true)]}이(가) 돌아오기를 기다린다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250112
					]
				},
				{
					"id": 750250112,
					"content": "그런데, 생각보다 시간이 길어지는 것 같다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250113
					]
				},
				{
					"id": 750250113,
					"content": "#…응? {REALNAME[ID(2)|SHOWHOST(true)]}, 얘 왜 아직도 안 오는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750250114,
					"content": "무슨 일 생긴 건 아니겠지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750250115,
					"content": "너무 신나서 그러는 걸까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250116
					]
				},
				{
					"id": 750250116,
					"content": "그럼 잘 달래봐야지. 이러다 해 떨어지겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750250117,
					"content": "으으… 얼른 가서 찾아보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750250108,
					"content": "너무 오래 놀지는 마!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				}
			]
		},
