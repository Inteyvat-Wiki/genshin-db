						],
						"stepId": 7320111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011101,
					"content": "「『30인단』에서 은퇴한 뒤로 매일 여기서 커피를 한 잔씩 마시고 있어」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011102
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732011102,
					"content": "「점장 대행은 매일 같은 커피를 내려주고 이야기꾼은 매일 똑같은 이야기를 하지」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011103
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732011103,
					"content": "「어쩌면 이렇게 반복적인 삶이야말로 수메르다운 삶일지도 모르겠군」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "게시판"
				}
			]
		},
		{
			"id": 7320112,
			"completionStepIds": [
				7320112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320112",
							"2"
						],
						"stepId": 7320112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011201,
					"content": "「마다흐 씨의 이야기는 식상하긴 해도 이야기를 할 때 흐름 조절은 아주 능숙하죠」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011202
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732011202,
					"content": "「하지만 이제 다들 허공을 통해 정보를 획득하다 보니 자연스레 이러한 기술에 대한 『탐구』와 예술에 대한 『숙성』을 소홀히 하게 될 수밖에요」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011203
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732011203,
					"content": "「그건 아주 경솔한 발언이야. 모든 예술 형식에는 기한이 있지. 예술이 창조한 『실리』가 전부 소모되면 결국 도태될 수밖에 없어」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011204
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732011204,
					"content": "「열매가 너무 익어 썩으면 토양으로 다시 돌아가 새로운 식물을 위해 영양분을 제공하는 것처럼 말이지」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011205
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732011205,
					"content": "「난 너 같은 실리주의자들을 경멸해. 예술 창작은 소중한 여유를 기반으로 만들어지는 거야. 그런 상업적인 마인드로는 예술을 분석할 수 없다고」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011206
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732011206,
					"content": "「여유로운 사람이란 존재하지 않아, 대지가 둥글다는 헛소리나 다름없지. 잘 생각해 봐. 그 누구의 삶도 상업 교환을 떠나서 존재할 수 없어」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011207
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732011207,
					"content": "「두 분의 발언은 여전히 날카로우시네요. 하지만 카베 씨, 이번 달 외상값을 갚으셔야 해요. 이번에도 알하이탐 씨한테 걸어둘까요?」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011208
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732011208,
					"content": "「아니요. 이제 저 자식도 상업 사회의 무서움에 대해 겪어봐야 할 것 같아요」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011209
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732011209,
					"content": "「점장 대행 아가씨, 이 사람 외상은 산게마 바이 어르신 앞으로 달아두세요. 커피가 충분해야 예술을 할 수 있으니까요!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "게시판"
				}
			]
		},
