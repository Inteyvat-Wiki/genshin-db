			"dialogs": [
				{
					"id": 60080101,
					"content": "며칠이 지났는데, 여기는 어떻게 됐을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60080102,
					"content": "생각보다 바뀐 게 별로 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080103
					]
				},
				{
					"id": 60080103,
					"content": "벌써 조금씩 안정되고 있나 봐. 라우마는 역시 대단해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60080104,
					"content": "라우마, 우리 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60080105,
					"content": "요즘 어때요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080106
					]
				},
				{
					"id": 60080106,
					"content": "뒤처리가 생각보다 복잡했어요. 쌓인 문제를 해결하는 건 쉬운 일이 아니네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080107
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60080107,
					"content": "진척을 보면 앞으로 몇 주는 더 걸릴 것 같지만, 다들 마음속에 안개가 걷힌 덕분인지 더 적극적으로 일해주고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080108
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60080108,
					"content": "마치 이 순간, 마침내 자신의 신앙을 만난 것처럼요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080109
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60080109,
					"content": "다 네 덕분이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60080110,
					"content": "그런 말 마세요. 원래는 진작에 했어야 하는 일인 걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080111
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60080111,
					"content": "최근에 몸 회복에 집중하기도 했고, 「달의 정수」도 당신이 보관해 주셔서 이제는 과거를 살펴볼 수 있을 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080112
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60080112,
					"content": "기억하고 계셨네요. 감사해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080113
					]
				},
				{
					"id": 60080113,
					"content": "참, 그 그림자에 관한 새로운 소식은 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60080114,
					"content": "네, 사람들에게 물어봤지만 쓸만한 정보는 없었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080115
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60080115,
					"content": "여러분은요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080116
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60080116,
					"content": "큰 진전은 없지만, 대충 이런 상황이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60080117,
					"content": "이해했습니다…. 여러분의 일도 만만치 않네요. 부디 몸조심하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080118
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60080118,
					"content": "#그럼, {NICKNAME}, 이쪽으로",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080119
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60080119,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080120
					]
				},
				{
					"id": 60080120,
					"content": "뭐 좀 보여?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60080121,
					"content": "(여긴… 노드크라이? 어디서 본 듯한 풍경인데…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080122
					]
				},
				{
					"id": 60080122,
					"content": "(저건… 별똥별?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080123
					]
				},
				{
					"id": 60080123,
					"content": "(…! 아냐! 저건 우리 우주선이야!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080124
					]
				},
				{
					"id": 60080124,
					"content": "끄, 끝났어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60080125,
					"content": "아주 오래전에 있었던 일 같네요. 기억의 흐름이 불안정해서, 제가 확인할 수 있는 건 여기까지예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080126
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60080126,
					"content": "(적어도 우주선이 불시착한 위치는 알아냈어…. 별모래 해변 근처인 것 같아)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080127
					]
				},
				{
					"id": 60080127,
					"content": "#({M#루미네}{F#오빠}가 알려준 것과도 일치해…. 하지만, 역시 더 자세히 알고 싶어…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080128
					]
				},
				{
					"id": 60080128,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080129
					],
					"speakerTitle": "루오노타르"
				},
				{
					"id": 60080129,
					"content": "앗, 갑자기 왜 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60080130,
					"content": "꽃의 색이 변했군요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080131
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60080131,
					"content": "(이 꽃은 「콜롬비나」의 힘을 반영해. 설마 콜롬비나의 몸이 또…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080132
					]
				},
				{
					"id": 60080132,
					"content": "(콜롬비나는 「달의 정수」로 힘을 회복하고 싶다고 했었지…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080133
					]
				},
				{
					"id": 60080133,
					"content": "페이몬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080134
					]
				},
				{
					"id": 60080134,
					"content": "응, 알았어! 빨리 가서 콜롬비나를 도울 수 있는지 확인해 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080135
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60080135,
					"content": "그럼 부탁드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080136
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60080136,
					"content": "참, 이거! 네가 「비밀의 집」에 부탁한 약이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080137
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60080137,
					"content": "전달해 주셔서 감사합니다. 큰 도움이 됐어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080138
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60080138,
					"content": "그리고… 이건 제 추측이지만, 우주선에 관한 거라면 「쿠타{RUBY#[S]달의 소녀}르」 님이 더 많은 장면을 보여주실 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080139
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60080139,
					"content": "그러네! 걔는 「달의 신」이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080140
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60080140,
					"content": "그치만 일단 무사한지부터 봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080141
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60080141,
					"content": "그럼 이따 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
