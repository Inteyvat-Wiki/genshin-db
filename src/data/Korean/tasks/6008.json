					"nextDialogs": [
						60080436
					]
				},
				{
					"id": 60080436,
					"content": "뭐?! 어… 어떻게 그럴 수 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080437
					],
					"speakerTitle": "페이몬"
				},
