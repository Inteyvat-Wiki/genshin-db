					"nextDialogs": [
						60080421
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 60080421,
					"content": "손 줘. 준비해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080422
					],
					"speakerTitle": "「콜롬비나」"
				},
