					"nextDialogs": [
						60080416
					]
				},
				{
					"id": 60080416,
					"content": "뭔데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080417
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 60080417,
					"content": "#혹시 나랑 {M#동생의}{F#오빠의} 우주선이 노드크라이에 착륙했을 때 일어난 일을 보여줄 수 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080418
					]
				},
				{
					"id": 60080418,
					"content": "물론이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080419
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 60080419,
					"content": "엄청 시원시원하네!",
