						210220316
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 210220316,
					"content": "어쩌면 그 비석에 이후의 이야기가 기록되어 있을 수도 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220317
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 210220317,
					"content": "하지만 이 비석에 기록들은 일부 문헌에 기재된 내용이랑 다른 부분도 있는 것 같아…",
