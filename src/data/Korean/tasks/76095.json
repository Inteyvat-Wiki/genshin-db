			"dialogs": [
				{
					"id": 760950101,
					"content": "#{NICKNAME}, 페이몬, 고마워. 마지막에 너희를 알게 되어서 정말 운이 좋았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950102
					],
					"speakerTitle": "차이틀린트"
				},
				{
					"id": 760950102,
					"content": "아니야. 오히려 넌 우리 때문에 이번 일에 휘말렸는걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760950103,
					"content": "잠깐만. 마지막이라니, 그게 무슨 소리야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760950104,
					"content": "비록 위험한 모험이었지만, 신기한 걸 잔뜩 볼 수 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950105
					],
					"speakerTitle": "차이틀린트"
				},
				{
					"id": 760950105,
					"content": "나쁘지 않았다고 생각해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950106
					],
					"speakerTitle": "차이틀린트"
				},
				{
					"id": 760950106,
					"content": "차이틀린트, 중요한 부분을 슬쩍 넘기지 말라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760950107,
					"content": "내가 그랬나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "차이틀린트"
				}
			]
		},
