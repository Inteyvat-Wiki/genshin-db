			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"카타리나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591101,
					"content": "왜? 휴식을 방해하려고 일부러 찾아온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591102
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710591102,
					"content": "아냐, 너 혼자 있으면 외로울 거 같아서 같이 수다 떨려고 온 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591103,
						710591104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710591103,
					"content": "혼자서 술 마시는 거 심심하죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				},
				{
					"id": 710591105,
					"content": "…그래? 고마워. 너희를 보면 말이지… 류다치카라는 녀석이 떠올라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591106
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710591106,
					"content": "그 녀석도 너처럼 따뜻했어… 종일 나한테 찰싹 달라붙어서 뭐든 얘기하고 싶어 했지… 종종 나한테만 말하기도 했다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591107
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710591107,
					"content": "휴, 류다치카도 여기 있었으면 좋았을 텐데…. 류다치카는 무척 재밌는 사람이거든, 너도 분명 좋아할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591108,
						710591113
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710591108,
					"content": "류다치카? 그게 누군데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591109
					]
				},
				{
					"id": 710591109,
					"content": "류다치카는… 내 친구야. 진지해 보이지만 사실은 재밌는 바보지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591110
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710591110,
					"content": "전에 「벽난로의 집」에 있었을 땐 친자매처럼 스스럼없이 지냈어… 친자매보다도 더 친했을지도 몰라. 류다치카는 내 장난을 좋아했고… 나도 그녀의 보살핌을 많이 받았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591111
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710591111,
					"content": "하하, 어쨌든, 류다치카는 잘 지내고 있을 것 같은 예감이 들어. 그걸 생각하면 이런 곳에서 입은 상처쯤은 별거 아니란 느낌이 든다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591112
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710591112,
					"content": "류다치카도 임무를 잘 수행하고 있길 바라야지…. 그녀가 내 생각은 안 했으면 좋겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710591113,
					"content": "류다치카라면… 이나즈마의 그…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591114
					]
				},
				{
					"id": 710591114,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591115
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710591115,
					"content": "그럼 정체가 들킨 거구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591116
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710591116,
					"content": "어… 어떻게 알았어…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591117,
						710591118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710591117,
					"content": "하지만… 무사히 빠져나갔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591119,
					"content": "그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591120
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710591120,
					"content": "하하… 그럼 다행이고. 류다치카도 임무를 잘 수행하고 있길 바라야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591121
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710591121,
					"content": "하지만 그 녀석이 여왕님의 뜻을 저버린 채 구차하게 연명하고 있다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591122
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710591122,
					"content": "…내 생각은 하지 말았으면 좋겠지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710591118,
					"content": "아직 살아 있어요, 잘 지내고 있구요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591104,
					"content": "같이 수다 떨려고 온 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				}
			]
		},
