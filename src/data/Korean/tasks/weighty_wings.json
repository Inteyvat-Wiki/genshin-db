				},
				{
					"id": 750280205,
					"content": "오랫동안 이 녀석을 돌봐줄 수는 없는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280206
					]
				},
				{
					"id": 750280206,
					"content": "잠깐만이라도 좋으니, 이 녀석을 아프지 않게 해줬으면 좋겠어…",
					"roleType": "TALK_ROLE_NPC",
