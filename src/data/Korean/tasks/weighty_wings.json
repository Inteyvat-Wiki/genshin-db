				{
					"id": 750280208,
					"content": "#왜 그래, {REALNAME[ID(2)|SHOWHOST(true)]}? 무슨 좋은 생각이라도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280209
					],
					"speakerTitle": "페이몬"
				},
				{
