			"dialogs": [
				{
					"id": 731961501,
					"content": "「바자르에 왔다면 꼭 주바이르 극장에 가봐야죠」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961502
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 731961502,
					"content": "「그리고 주바이르 극장에서 꼭 봐야 할 게 바로 닐루 아가씨의 춤입니다!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961503
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 731961503,
					"content": "「수메르에 왔다면 꼭 닐루 아가씨의 화신(꽃의 신)의 춤을 보셔야죠」",
					"roleType": "TALK_ROLE_NPC",
