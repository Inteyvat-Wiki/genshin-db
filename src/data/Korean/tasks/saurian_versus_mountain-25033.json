			"dialogs": [
				{
					"id": 250330201,
					"content": "#{M#형아}{F#누나} 대단해! 마이타랑 똑같이 빠르네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330202,
						250330203
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330202,
					"content": "실수가 좀 있었어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330204
					]
				},
				{
					"id": 250330204,
					"content": "이미 충분히 아주 대단한데? 나랑 치카는 비교도 못 할 정도야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330205
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330205,
					"content": "#휴, {M#형아}{F#누나}를 따라잡으려면 아주 더 많이 훈련해야 하나 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330206
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330206,
					"content": "우, 우우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330207,
						250330208
					],
					"speakerTitle": "치카"
				},
				{
					"id": 250330207,
					"content": "파이팅, 치카!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330209
					]
				},
				{
					"id": 250330209,
					"content": "우?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330210
					],
					"speakerTitle": "치카"
				},
				{
					"id": 250330210,
					"content": "착하지, 치카. 야와르 아저씨가 우리가 노력하면 분명 더 대단해질 수 있다고 했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330211
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330211,
					"content": "꺄우",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330212
					],
					"speakerTitle": "치카"
				},
				{
					"id": 250330212,
					"content": "#{M#형아}{F#누나}, 도와줘서 고마워. 이 열매를 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330213
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330213,
					"content": "치카가 방금 따온 거야. 전보다 훨씬 더 빨라졌어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330214
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330214,
					"content": "#헤헤, 다 {M#형아}{F#누나}가 좋은 본보기가 되어준 덕분이야. 그래서 치카가 이렇게 강해질 수 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330215
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330215,
					"content": "우우, 우!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330216
					],
					"speakerTitle": "치카"
				},
				{
					"id": 250330216,
					"content": "좋아, 그럼 우리는 부족으로 돌아가서 마이타를 찾아봐야겠어. 음… 마이타는 부락에 있겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330208,
					"content": "너희라면 할 수 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330209
					]
				},
				{
					"id": 250330203,
					"content": "최고 기록이 아냐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330204
					]
				}
			]
