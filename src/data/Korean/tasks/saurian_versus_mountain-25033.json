			"dialogs": [
				{
					"id": 250330101,
					"content": "착하지, 오늘은 배부르게 잘 먹었어? 훈련할 힘은 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330102
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330102,
					"content": "우, 우우, 우!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330103
					],
					"speakerTitle": "치카"
				},
				{
					"id": 250330103,
					"content": "우와, 힘이 넘치네? 좋아! 오늘은 더 열심히 해보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330104
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330104,
					"content": "같이 힘내자!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330106
					]
				},
				{
					"id": 250330106,
					"content": "#어? {M#형아}{F#누나} 안녕! 우리 등반 훈련 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330107
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330107,
					"content": "우우! 우우!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330108
					],
					"speakerTitle": "치카"
				},
				{
					"id": 250330108,
					"content": "우우, 우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330109,
						250330112
					],
					"speakerTitle": "치카"
				},
				{
					"id": 250330109,
					"content": "훈련은 잘돼가고 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330110
					]
				},
				{
					"id": 250330110,
					"content": "음… 적어도 「발전」은 있었어. 이번엔 치카가 더 높은 곳까지 올라갔거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330111
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330111,
					"content": "근데 산을 올라 갈 때 치카의 등반 동작이 아직 어색한 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330116,
					"content": "#{M#형아}{F#누나}, 시범을 다시 한번 더 보여줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330117,
						250330121
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330117,
					"content": "문제없지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330118
					]
				},
				{
					"id": 250330118,
					"content": "#고마워! 이번엔 {M#형아}{F#누나}의 동작을 확실하게 볼 수 있겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330119
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330119,
					"content": "치카, 너도 눈 크게 뜨고 잘 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330120
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330120,
					"content": "우!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "치카"
				},
				{
					"id": 250330123,
					"content": "#그럼 부탁할게, {M#형아}{F#누나}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330124
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330124,
					"content": "#우린 여기서 {M#형아}{F#누나}를 지켜보면서 시간을 재볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330125
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330125,
					"content": "우, 우우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "치카"
				},
				{
					"id": 250330121,
					"content": "이번엔 내 동작을 꼭 제대로 봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330122
					]
				},
				{
					"id": 250330122,
					"content": "응, 우리 둘 다 눈 크게 뜨고 자세히 볼게, 똑똑히 볼 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330112,
					"content": "많이 회복된 것 같아 보여",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330113
					]
				},
				{
					"id": 250330113,
					"content": "당연하지, 엄마도 내가 치카를 아주 잘 돌본다고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330114
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330114,
					"content": "치카는 꽤 많이 좋아져서 저번보다 훨씬 더 높은 곳까지 갔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330115
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250330115,
					"content": "근데 산을 올라 갈 때 치카의 동작이 아직 어색한 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "틀라터"
				}
			]
