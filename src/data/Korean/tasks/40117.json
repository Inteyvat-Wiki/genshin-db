			"dialogs": [
				{
					"id": 401171501,
					"content": "앨리스 씨에게 호언장담했는데 신기루가 이런 꼴이 되어버렸어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171502
					],
					"speakerTitle": "이디이아"
				},
				{
					"id": 401171502,
					"content": "하지만 「군사」 씨가 말한 것처럼 신기루를 원래대로 되돌린다면…",
					"roleType": "TALK_ROLE_NPC",
