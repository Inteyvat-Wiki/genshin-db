	"talks": [
		{
			"id": 1300301,
			"completionStepIds": [
				1300301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300301",
							"2"
						],
						"stepId": 1300301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"캐서린"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030101,
					"content": "…아무튼 오염 구역은 숲속 깊은 곳에 지맥이 누출돼서 생겨난 거야. 지금은 정상으로 돌아왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130030102,
					"content": "그랬었구나, 정말 고생 많았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030103
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 130030103,
					"content": "공기 중에 남은 지맥 에너지가 흩어지면 주민들에게 예전처럼 정상 출입이 가능하다고 공지를 내보내도 되겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030104
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 130030104,
					"content": "이건 일전에 말했던 보상이니 받아둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030105
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 130030105,
					"content": "모험가 길드에서 나온 뒤 페이몬에게 이끌려 조용한 곳으로 향한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130030106
					]
				},
				{
					"id": 130030106,
					"content": "카르카타… 아카데미아로 보내지는 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130030107,
					"content": "이미 망가진 상태이긴 하지만, 해체된다고 생각하니까 마음이 안 좋네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130030108,
					"content": "나도 그래",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030109
					]
				},
				{
					"id": 130030109,
					"content": "그럼 내일 같이 타이나리를 찾아가서 사정해볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130030110,
					"content": "지금 당장 가고 싶지만 나머지는 내일 이야기하자고 했잖아. 지금 가면 오히려 화내겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130030111,
					"content": "그럴 수 있을 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030112
					]
				},
				{
					"id": 130030112,
					"content": "그럼 약속한 거다! 내일 타이나리를 찾아가서 카르카타를 해체하지 말아 달라고 하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 1300303,
			"completionStepIds": [
				1300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300303",
							"2"
						],
						"stepId": 1300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"타이나리",
					"카르카타"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030301,
					"content": "타이나리——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130030302,
					"content": "쉿, 목소리 낮춰",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030303
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030303,
					"content": "팥꽃나무, 서향과 서향속. 항경련 효과가 있어 마취 가루로 사용이 가능하다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030304
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030304,
					"content": "두 실험 데이터에 의하면 어류에 엄청난 독성을 가지고 있으니… 잘 기록해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030305
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030305,
					"content": "꾸륵!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030306
					],
					"speakerTitle": "카르카타"
				},
				{
					"id": 130030306,
					"content": "카르카타?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130030307,
					"content": "꾸륵! 꾸륵!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030308
					],
					"speakerTitle": "카르카타"
				},
				{
					"id": 130030308,
					"content": "목소리 좀 낮춰달라니까. 식물들은 괜찮아도 난 귀가 울려서 아프거든?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030309
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030309,
					"content": "카, 카르카타를 해체한 거 아니었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130030310,
					"content": "녀석을 왜 해체해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030311
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030311,
					"content": "「아카데미아 규칙상」 그래야 한다고 했잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130030312,
					"content": "아침부터 날 찾아와서 소란 피운 이유가 그것 때문이었구나. 음, 어제 내가 정확히 말을 안 한 탓도 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030313
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030313,
					"content": "난 아카데미아 규칙상 모든 연구 성과를 소각해야 하니, 아카데미아가 그곳을 발견하게 둬서는 안 된다는 뜻이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030314
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030314,
					"content": "타이나리가 그곳에 남은 건…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030315
					]
				},
				{
					"id": 130030315,
					"content": "어찌 됐든 카르카타를 일단 고쳤어. 아카데미아에서 소론파 수업을 들은 적이 있는데 이렇게 써먹을 줄은 몰랐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030316
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030316,
					"content": "그리고 카르카타와 함께 아바투이를 좋은 곳에 묻었어. 실험 자료도 정리했는데, 일부는 기념으로 가지고 나왔고 대부분은 태운 뒤 땅속에 묻어서 증거를 없앴지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030317
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030317,
					"content": "난 아카데미아 소속도 아닌데 그런 규칙이 나랑 무슨 상관이겠어? 난 아비디야 숲의 순찰관이니 숲속 생명을 지킬 의무가 있다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030318
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030318,
					"content": "이 세상에 탄생한 모든 생명체는 의미가 있는 거야. 녀석도 예외가 아니지. 존재하는 이상 함부로 버리거나 소각해서는 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030319
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030319,
					"content": "헤헤! 정말 다행이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030320
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130030320,
					"content": "꾸르륵?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030321
					],
					"speakerTitle": "카르카타"
				},
				{
					"id": 130030321,
					"content": "근데 방금 「모든 생명체」라고 했잖아. 그럼 카르카타를 「진정한 생명체」라고 인정한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030322
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130030322,
					"content": "그럴 가능성이 있다는 거지. 아바투이를 「고치려고」 했던 건 아무리 생각해도 이해가 안 되거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030323
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030323,
					"content": "하지만 아바투이가 남긴 실험 기록은 극히 일부분이라 그가 명령을 얼마나 설정했을지는 아무도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030324
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030324,
					"content": "명령 사이에 충돌이 있어서 카르카타가 그런 행동을 보였을 수도 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030325
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030325,
					"content": "엄밀히 말하면 「카르카타가 진정한 생명체이다」라는 결론을 내릴 순 없지만 그런 가능성이 있다면 난 믿고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030326
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030326,
					"content": "꾸륵!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030327
					],
					"speakerTitle": "카르카타"
				},
				{
					"id": 130030327,
					"content": "그나저나 난 이 연구에 관심 없어. 녀석을 이곳에 남겨두는 건 이곳이 은폐된 곳이라서야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030328
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030328,
					"content": "지금 보니 녀석을 실험 조수로 삼아도 괜찮을 것 같아. 실험 기록 같은 건 적을 수 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030329
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030329,
					"content": "넌 어떻게 생각해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030330
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 130030330,
					"content": "꾸륵! 꾸륵!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카르카타"
				}
			]
		},
