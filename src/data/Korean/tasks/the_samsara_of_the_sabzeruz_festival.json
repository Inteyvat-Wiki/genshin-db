			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"데히야"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100201,
					"content": "여기 있었구나. 그 도적들은 내가 처리했어. 아가씨는 안 다쳤지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100202
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 30100202,
					"content": "잠깐, 뭔가 이상해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100203
					]
				},
				{
					"id": 30100203,
					"content": "어… 데히야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100204,
					"content": "왜 그래? 왜 그렇게 쳐다봐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100205
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 30100205,
					"content": "이, 이번에는 왜 안 다친 거야!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100206,
					"content": "어? 그게 무슨 뜻이야? 내가 다치긴 왜 다쳐? 어설픈 실력을 가진 도적이었을 뿐이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100207,
						30100208
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 30100207,
					"content": "새로 산 대검이 손에 아직 안 익지 않았어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				},
				{
					"id": 30100209,
					"content": "쉿… 대검에 대해 어떻게 알고 있는 거지? 그 누구에게도 말한 적이 없는데, 아가씨에게 절대 말해선 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100210
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 30100210,
					"content": "역시 데히야의 기억은 다 사라졌구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100211,
						30100212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100211,
					"content": "이번 전투에서…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100213,
					"content": "이상한 점이라… 굳이 말하자면 두 사람도 알다시피 내가 대검을 바꿨는데도 손에 익다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100214
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 30100214,
					"content": "마치… 이 대검으로 무수히 많은 전투를 치른 것처럼 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100215
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 30100215,
					"content": "기억 속에는 이 대검으로 전투를 한 경험이 없지만 몸은 기억한다… 대충 이런 느낌인 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100216,
					"content": "맞아, 용병이나 무사나, 「신체 기억」이 가장 중요하거든. 초식을 머리로 기억하는 건 겉만 번지르르하고 실용성이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100217
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 30100217,
					"content": "여행자, 어떻게 생각해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100218,
						30100219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100218,
					"content": "설마 어제 허공을 제거해서 그런 건가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100220,
					"content": "맞아, 드디어 희망이 보이기 시작했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100221,
					"content": "혹시 이미… 문제가 해결된 게 아닐까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100222
					]
				},
				{
					"id": 30100222,
					"content": "어! 맞아, 「화신 탄신일의 윤회」에서는 이런 상황이 일어날 리 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100223
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100223,
					"content": "오늘이 끝나면 알게 되겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100224
					]
				},
				{
					"id": 30100224,
					"content": "지금 무슨 이야기를 하는지 모르겠지만 아직 위험이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100225
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 30100225,
					"content": "위험 요소가 남아있을 수 있으니 우리 보고 두냐르자드를 데리고 가서 휴식을 취하게 하고, 넌 도적들의 동료가 남아있는지 보려고 했지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100226
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100226,
					"content": "내가 하고 싶은 말을 어떻게 안 거야…? 설마 독심술?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100227
					],
					"speakerTitle": "데히야"
				},
				{
					"id": 30100227,
					"content": "알겠으니 어서 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100219,
					"content": "이런 변화가 있는 건 이번이 처음이야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100212,
					"content": "이상한 점은 없었어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100208,
					"content": "그래서 조금이라도 다칠 줄 알았거든요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				}
			]
		},
		{
			"id": 301003,
			"completionStepIds": [
				301003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301003",
							"2"
						],
						"stepId": 301003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"나히다"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100301,
					"content": "…휴, 드디어 저녁이다. 그 일을 제외하고는 딱히 변화가 없었던 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100302,
					"content": "나히다, 원래는 그 도적들과 싸우다가 데히야가 상처를 입었어야 했는데 오늘은 멀쩡했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100303,
					"content": "「화신 탄신일의 윤회」가 이미 끝난 게 아닐까? 두냐르자드도 이제 살릴 수 있는 거 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100304,
					"content": "오? 그런 진전이 있었다니 정말 훌륭해, 기왕 이렇게 된 거 오늘은 푹 쉬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100305
					],
					"speakerTitle": "나히다"
				},
				{
					"id": 30100305,
					"content": "뭐야, 그 애매모호한 대답은",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100306,
					"content": "내일이 오는 건 모든 사람에게 일반 상식이지만 내일이 올지 안 올지는 내일이 되어야 알 수 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100307
					],
					"speakerTitle": "나히다"
				},
				{
					"id": 30100307,
					"content": "오늘이 도대체 몇 번째 오늘이지? 오늘이 지나면 어제가 될 가능성은 없는 건가? 내일이라는 단어는 날조된 개념이 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100308
					],
					"speakerTitle": "나히다"
				},
				{
					"id": 30100308,
					"content": "아니면 모든 세상이 다 가짜일 수도 있잖아, 이 대륙의 역사는 기나긴 「화신 탄신 축제」로 이루어진 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100309
					],
					"speakerTitle": "나히다"
				},
				{
					"id": 30100309,
					"content": "됐어, 지금 머리가 안 그래도 복잡하니까 더 이상 말하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100310,
					"content": "후후… 그러니까 내일이 되면 자연스레 알게 될 테니 오늘은 의미 없는 생각 그만해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100311
					],
					"speakerTitle": "나히다"
				},
				{
					"id": 30100311,
					"content": "푹 쉬어, 시원하게 화장실이나 다녀오던가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100312
					],
					"speakerTitle": "나히다"
				},
				{
					"id": 30100312,
					"content": "뭐? 잠깐, 방금 뭐라고 했어? 내가 잘못 들은 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100313,
					"content": "음? 사람들이 화장실을 다녀오면 정신이 맑아진다고 해서 추천한 건데, 많이 이상해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100314
					],
					"speakerTitle": "나히다"
				},
				{
					"id": 30100314,
					"content": "윽… 상식이 의심될 정도로 이상해, 뭐라고 대답을 해야 할지도 모르겠네…. 아까는 분명 엄청난 이치에 대해 말했던 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100315,
					"content": "그럼 우린 먼저 가서 쉴게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100316
					]
				},
				{
					"id": 30100316,
					"content": "응, 매일이 화신 탄신 축제라서 즐겁고 시끌벅적하지만 오랫동안 푹 쉬지 못한 것 같아. 방으로 어서 돌아가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100317,
					"content": "「삑——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30100318,
					"content": "「수확」을 계속 진행해, 결과에 비하면 이런 건 아무것도 아니니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아자르"
				}
			]
		},
