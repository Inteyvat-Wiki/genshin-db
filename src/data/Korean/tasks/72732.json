				"points": []
			},
			"dialogs": [
				{
					"id": 727320101,
					"content": "아라타키파, 결투하러 왔다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320102
					],
					"speakerTitle": "「괴력 33」"
				},
				{
					"id": 727320102,
					"content": "뭐야? 「하나카도 장군」이 또 웬 꼬맹이를 보냈어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320103
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 727320103,
					"content": "설마 사람이 없다고 대충 얼버무리려는 거냐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320104
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 727320104,
					"content": "…넌 중요하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320105
					],
					"speakerTitle": "「괴력 33」"
				},
				{
					"id": 727320105,
					"content": "시끄러운 녀석은 대개 졸병이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320106
					],
					"speakerTitle": "「괴력 33」"
				},
				{
					"id": 727320106,
					"content": "#이 {M#금발 오빠}{F#금발 언니}한테는 묵직한 강자의 기운이 느껴져. 역시 {M#오빠}{F#언니}가 아라타키파의 대장인 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320107
					],
					"speakerTitle": "「괴력 33」"
				},
				{
					"id": 727320107,
					"content": "후후후, 제법 눈썰미가 있는 친구잖아! 빨리, 더 칭찬해줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 727320108,
					"content": "뭐? 지금 무슨 헛소리를 하는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320109
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 727320109,
					"content": "내 친구가 강한 건 사실이지만, 그냥 지원군으로 온 거라고! 이름 보면 모르겠어? 아라타키파의 대장은 영원히 나 아라타키 이토지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320110,
						727320111
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 727320110,
					"content": "그럼 제 이름에 기간 한정을 붙일게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				},
				{
					"id": 727320112,
					"content": "응응, 실력은 그렇다 쳐도 대장을 하는 건 어떤 느낌일까? 나도 궁금해졌어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 727320113,
					"content": "나도 「아라타키(3일 후 만료)페이몬」이나 「아라타키파 페이몬(임시 대장)」이라고 할래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 727320114,
					"content": "어이! 너희 둘! 상대의 말에 휘둘리지 말라고! 저건… 저건 분명 내분을 일으키려는 속셈이야! 음모라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320115
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 727320115,
					"content": "이 몸이 네 대장을 이기면 허겁지겁 그 말을 후회하면서 취소하게 될걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320116
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 727320116,
					"content": "퍽이나… 너희 아라타키파 내부의 일에는 관심 없어. 난 그저 강자와 겨루고 싶을 뿐이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320117
					],
					"speakerTitle": "「괴력 33」"
				},
				{
					"id": 727320117,
					"content": "#그럼 먼저 {M#오빠}{F#언니}의 곤충 싸움 실력부터 보여 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「괴력 33」"
				},
				{
					"id": 727320111,
					"content": "며칠만 대장 자리를 빌려주지 않을래요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				}
			]
		}
	]
}