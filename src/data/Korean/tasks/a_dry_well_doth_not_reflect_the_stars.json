						"position": [
							452.578,
							52.995,
							6035.06
						],
						"pointId": 6
					}
				]
			},
			"dialogs": [
				{
					"id": 100040201,
					"content": "후, 여름의 추억이 가득한 방법으로 오니까 기분이 상쾌한걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100040202,
					"content": "여기가 바로 지하 고대 국가——켄리아의 문인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040203
					],
					"speakerTitle": "모나"
				},
				{
					"id": 100040203,
					"content": "분명 많은 비밀과 슬픔이 숨겨져 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040204
					],
					"speakerTitle": "모나"
				},
				{
					"id": 100040204,
					"content": "이제 두 번째 편지를 읽어보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100040205,
					"content": "응, 그러자. 두 번째 편지가 어딨더라… 아, 이거다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040206
					],
					"speakerTitle": "모나"
				},
				{
					"id": 100040206,
					"content": "「수메르엔 이런 말이 있다. 『경전을 읽는다고 도를 깨우치는 것은 아니다. 지혜의 샘물로 메마른 지혜를 적셔야 한다』 이 땅에는 『불타는 기상』이라는 현상이 있지」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040207
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 100040207,
					"content": "「하지만 『불타는 기상』은 진리를 향한 과도한 갈증으로 불타오르는 현상이니, 『진실을 갈망하는 기상』이라고 부르는 게 본질에 더 적합할지도 몰라」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040208
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 100040208,
					"content": "「지하 고대 국가의 기록에 따르면, 켄리아의 몇몇 거대한 지하 거울 호수는 진실된 우주 별바다를 비춘다고 한다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040209
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 100040209,
					"content": "「그건 물이 열어준 『진실을 갈망하는 기상』이 거짓된 하늘을 넘어, 우주와 연결되었기 때문이지」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040210
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 100040210,
					"content": "그런 거구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040211
					],
					"speakerTitle": "모나"
				},
				{
					"id": 100040211,
					"content": "「거짓된 하늘을 넘어야만 우주 성체의 인력과 영향을 관측할 수 있다. 그리고 세계 밖의 매개변수를 확보해야만 비로소 세계의 운명을 계산할 수 있지」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040212
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 100040212,
					"content": "「자, 이제 과제를 내주마. 켄리아의 문 앞에서, 『진실을 갈망하는 기상』을 열어보거라」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040213
					],
					"speakerTitle": "바르벨로스"
				},
				{
					"id": 100040213,
					"content": "뒤에는 할망구가 계산한 의식과 방법이 적혀있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040214
					],
					"speakerTitle": "모나"
				},
				{
					"id": 100040214,
					"content": "그러네. 난 이런 행성 궤적이나 룬 문자는 뭔지 하나도 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100040215,
					"content": "모나, 지금 바로 시도해 볼 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100040216,
					"content": "방금 할망구가 개발한 의식의 매개변수를 빠르게 계산해 봤는데, 인정하고 싶진 않지만, 정말 가능할 것도 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040217
					],
					"speakerTitle": "모나"
				},
				{
					"id": 100040217,
					"content": "나 지금 좀 흥분돼. 의욕이 불타올라! 게다가 나중으로 미루면 또 하루치 숙박비가 나가잖아. 기다릴 게 뭐 있어? 바로 시작할래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040218
					],
					"speakerTitle": "모나"
				},
				{
					"id": 100040218,
					"content": "모든 항성을 통하는 사자여, 황도와 적도를 다스리는 나그네여, 그리고 천상의 빛나는 무리여——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040219
					],
					"speakerTitle": "모나"
				},
				{
					"id": 100040219,
					"content": "공허의 동굴과 굽어진 길. 나 아스트로지스트·모나·메기스토스, 이곳에서 물로 균형을 맞추노니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040220
					],
					"speakerTitle": "모나"
				},
				{
					"id": 100040220,
					"content": "갈증을 풀 지혜와 진리를 찾아, 나 아스트로지스트·모나·메기스토스, 별들의 현현을 명하노라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040221
					],
					"speakerTitle": "모나"
				},
				{
					"id": 100040221,
					"content": "서, 성공했나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040222
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100040222,
					"content": "으악, 갑자기 마물들이 잔뜩 나타났어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040223
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100040223,
					"content": "완전히 성공하진 못한 것 같아. 아주 잠깐만 열렸는데, 그 틈에 마물들이 「진실을 갈망하는 기상」을 넘어왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040224
					],
					"speakerTitle": "모나"
				},
				{
					"id": 100040224,
					"content": "으, 화나! 진짜 별하늘은 보지도 못했네. 너희가 내 화풀이 대상이 돼줘야겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "모나"
				}
			]
		},
