				"points": []
			},
			"dialogs": [
				{
					"id": 220050101,
					"content": "대체 어딨는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050102
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220050102,
					"content": "여기서 뭐 해요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050103
					]
				},
				{
					"id": 220050103,
					"content": "으악! 넌 갑자기 어디서 튀어나온 거야? 기척도 없이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050104
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220050104,
					"content": "나? 난… 학자야. 귀리 평원의 고대 건축물과 유물에 대해 연구 중이지. 보아…라고 불러줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050105
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220050105,
					"content": "그런데 연구에 너무 집중한 나머지 갖고 있던 짐가방을 잃어버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050106
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220050106,
					"content": "그 안엔 내가 어렵게 찾은 보… 유물이 있는데, 네가 좀 찾아줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050107,
						220050108,
						220050109
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220050107,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050110
					]
				},
				{
					"id": 220050110,
					"content": "정말 다행이다. 아마 근처에 떨어졌을 거야…. 좀 더 멀리에 있을 수도 있고. 아무튼 잘 찾아봐줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "보아"
				},
				{
					"id": 220050108,
					"content": "어떤 짐가방이에요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050111
					]
				},
				{
					"id": 220050111,
					"content": "음… 그냥 흔하게 볼 수 네모난 상자야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050112
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220050112,
					"content": "왜 유물을 그런 데에 넣고 다니냐고? 윽, 그건… 이런 상자가 훨씬 편하니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050113
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220050113,
					"content": "그리고 상자 안에 옷도 몇 겹 깔아둬서 절대 유물이 파손될 일은 없을 거야. 빨리 가서 찾아봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "보아"
				},
				{
					"id": 220050109,
					"content": "어떤 유물이에요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050114
					]
				},
				{
					"id": 220050114,
					"content": "음… 그냥 엄청 무거운 유물이야. 어차피 말해도 넌 모를걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050115
					],
					"speakerTitle": "보아"
				},
				{
					"id": 220050115,
					"content": "나 같은 전문가만이 그 가치를 판단할 수 있어. 그러니까 부탁할게, 빨리 좀 찾아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "보아"
				}
			]
		},
