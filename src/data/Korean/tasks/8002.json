			"dialogs": [
				{
					"id": 80020301,
					"content": "여긴, 널 환영하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020302
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 80020302,
					"content": "후후후… 잔혼만 남은 늑대한테 후손을 기르는 습성이 있을 줄이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020303
					],
					"speakerTitle": "심연 사도"
				},
				{
					"id": 80020303,
					"content": "호위견으로라도 쓸 생각인가? 하지만 이 녀석의 힘은 과거 마신과는 비교도 안 되는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020304
					],
					"speakerTitle": "심연 사도"
				},
				{
					"id": 80020304,
					"content": "우리한테 복종하기만 하면, 옛날처럼 신에 필적하는 권능을 얻을 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020305
					],
					"speakerTitle": "심연 사도"
				},
				{
					"id": 80020305,
					"content": "허튼… 소리…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020306
					],
					"speakerTitle": "보레아스"
				},
				{
					"id": 80020306,
					"content": "무슨 의식이지? 엄청 고통스러워하고 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020307,
					"content": "음… 드발린의 마음을 「타락」시켰을 때랑 같은 건가?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020308,
					"content": "늑대는 굴복하지 않아. 하지만, 더는 무리야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020309,
						80020310
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 80020309,
					"content": "저놈은 내가 막을게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				},
				{
					"id": 80020311,
					"content": "너희가 몇 번을 시도하든 다 소용없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "심연 사도"
				},
				{
					"id": 80020310,
					"content": "사도를 다시 한번 쓰러뜨려 주지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				}
			]
