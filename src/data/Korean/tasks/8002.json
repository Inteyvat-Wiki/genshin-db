				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020201,
					"content": "후——여기 적들이 엄청 많아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020202,
					"content": "목표에 가까워질수록 적이 많아지네. 흥, 정말 교단답군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020203
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020203,
					"content": "빨리 「왕랑」을 찾아야 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020204
					]
				},
				{
					"id": 80020204,
					"content": "응! 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020205,
					"content": "난… 여기 남겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020206
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020206,
					"content": "엥? 왜? 설마 털 많은 생물이 무서운 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020207,
						80020208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020207,
					"content": "그런 이유는 아니겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				},
				{
					"id": 80020209,
					"content": "「늑대」와는 상관없어. 과거의 마신이었던 그가 지금은 일곱 신을 섬기고 있어서야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020210
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020210,
					"content": "그런 행동은 인정할 수 없어. 그를 만날 생각도 없고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020211
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020211,
					"content": "그리고 남의 호감을 사는 건 네 특기잖아. 난 못 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020212,
						80020214
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020212,
					"content": "일곱 신을 정말 싫어하시는군요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020213
					]
				},
				{
					"id": 80020213,
					"content": "신은 원래 믿을 수 없는 존재야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020216,
					"content": "개인적으로 충고 하나 해주자면, 신에 대해 항상 경계심을 가져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020217
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020217,
					"content": "너무 믿어서도 안 되지만, 그렇다고… 「찬탈」 혹은 「살육」의 길로 빠져서도 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020218
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020218,
					"content": "그때 마주했던 네 「원수」일지라도 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020219
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020219,
					"content": "믿지도 말고 죽이지도 말라니…. 너무 이상하잖아? 데인은 대체 일곱 신을 증오하는 거야, 옹호하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020220,
					"content": "왜 그런 모순적인 생각을…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020221
					]
				},
				{
					"id": 80020221,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020222
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020222,
					"content": "과거에 얻은 교훈 때문이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020223
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020223,
					"content": "마지막으로… 한 가지 사실을 알려주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020224
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020224,
					"content": "응? 뭔데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020225
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020225,
					"content": "「켄리아는 신에 의해 멸망한 나라야. 그리고 그게 바로… 심연 교단이 일곱 신의 나라를 멸망시키려는 이유야」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020226
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020226,
					"content": "이제 잡담은 그만하고 할 일을 하자고. 난 남은 심연 교단을 처리할 테니, 너희도 어서 가봐. 다 끝나면 울프 영지 입구에서 만나자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020227
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020227,
					"content": "아… 가버렸어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020228
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020228,
					"content": "정말 이상한 사람이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020229
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020229,
					"content": "그가 조금은 이해돼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020230
					]
				},
				{
					"id": 80020230,
					"content": "음, 그러고 보니까 너도 「낯선 신」을 엄청 경계하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020231
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020231,
					"content": "그때 리월의 청신의례에서 너도 데인과 비슷한 선택을 했었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020232
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020232,
					"content": "믿음이 없어서 대화가 안 되니 피할 수밖에 없지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020233
					]
				},
				{
					"id": 80020233,
					"content": "휴… 정말 어렵네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020234
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020234,
					"content": "명예 기사, 페이몬! 너희들이 왜 여기에?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020235
					],
					"speakerTitle": "진"
				},
				{
					"id": 80020235,
					"content": "아, 진 단장! 드디어 찾았네, 다행이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020236
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020236,
					"content": "로자리아한테 진 단장이 여기서 싸운다는 걸 듣고 도와주러 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020237
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020237,
					"content": "그렇구나, 정말 고마워. 이번 폭동은 아주 이상해. 심연 교단이 울프 영지를 겹겹이 둘러싸고 있어서 마침 병력을 동원하려던 참이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020238
					],
					"speakerTitle": "진"
				},
				{
					"id": 80020238,
					"content": "방금 울프 영지를 정찰했는데… 너희들을 만날 줄은 몰랐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020239
					],
					"speakerTitle": "진"
				},
				{
					"id": 80020239,
					"content": "로자리아 씨의 말에 따르면, 그들의 목표는 아마 「보레아스」일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020240
					],
					"speakerTitle": "진"
				},
				{
					"id": 80020240,
					"content": "하지만 심연 교단과 「보레아스」는… 과연 무슨 관계일까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020241
					],
					"speakerTitle": "진"
				},
				{
					"id": 80020241,
					"content": "단순히 말썽 피우는 덴 아무 이유 없다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020242
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020242,
					"content": "심연 교단은 드발린도 괴롭혔는데, 또 다른 바람 신의 권속을 찾아간다고 해도 전혀 이상할 거 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020243
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020243,
					"content": "그것도 일리 있네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020244
					],
					"speakerTitle": "진"
				},
				{
					"id": 80020244,
					"content": "어쨌든 드러났든 드러나지 않았든 이 일대의 위험한 건 모두 내게 맡겨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020245
					],
					"speakerTitle": "진"
				},
				{
					"id": 80020245,
					"content": "명예 기사는 가서 「왕랑」의 상황을 확인해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020246
					],
					"speakerTitle": "진"
				},
				{
					"id": 80020246,
					"content": "마신의 잔혼은… 인간에게 모습을 잘 드러내지 않지만, 넌 그와 일면식이 있다고 하니 네가 가는 게 좋을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020247
					],
					"speakerTitle": "진"
				},
				{
					"id": 80020247,
					"content": "제게 맡기세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020248
					]
				},
				{
					"id": 80020248,
					"content": "응, 조심해. 전방의 임무는 너한테 맡길게, 「페보니우스의 명예 기사」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "진"
				},
				{
					"id": 80020214,
					"content": "사교성이 좀 부족하시네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020215
					]
				},
				{
					"id": 80020215,
					"content": "인간을 상대하는 건 문제 없지만, 신이라면… 얘기가 달라지지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020208,
					"content": "털이 많으면 귀엽지 않아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				}
			]
		},
		{
			"id": 800203,
