				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"데인슬레이프"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020401,
					"content": "거대한 신상과 웅장한 성당. 몬드 사람들은 이걸 만들기 위해 엄청난 자원과 노력을 쏟았겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020402
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020402,
					"content": "하지만 선물을 받은 바람 신은 그 마음을 얼마나 느끼고, 또 얼마나 보답했을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020403
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020403,
					"content": "「신앙」은 대가를 바라지 않잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020404,
					"content": "흥, 신이 그걸로 마음 편하다면 더 할 말 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020405
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020405,
					"content": "쉿——! 곧 성당에 들어가니까 바람 신 뒷담화는 그만해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020406,
					"content": "게다가 바람 신은 사실… 아, 음, 아무것도 아냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020407,
					"content": "처음부터 성당에 들어갈 생각은 없었어. 수녀를 상대하는 건 너희한테 맡기지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020408
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020408,
					"content": "뭐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020409,
						80020410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020409,
					"content": "여태까지 계속 같이 움직였잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				},
				{
					"id": 80020411,
					"content": "넌 몬드성의 신뢰받는 명예 기사니까, 그들도 네가 개입하는 것에 대해 뭐라고 안 할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020412
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020412,
					"content": "내가 가봤자 경계만 더 할 테지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020413,
						80020414
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020413,
					"content": "낯선 사람이라서요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020415,
					"content": "맞아. 그리고 이 작은 친구의 말처럼, 내가 성당 사람들이 듣기 싫어하는 말을 할지 모르거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020416
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020416,
					"content": "「신앙을 거부하는 자」가 「신성한 곳」에 발을 들여봤자 좋을 거 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020417
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020417,
					"content": "난 한 번도 신의 은혜를 입은 적이 없지. 지금도 그리고 앞으로도 없을 테고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020418
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020418,
					"content": "됐어, 이런 얘기는 그만하지. 우리가 얘기하는 동안에도 심연 교단은 움직이고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020419
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020419,
					"content": "음, 그럼 우리 둘이 물어보고 오자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020420
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80020420,
					"content": "한마디 더 해야겠군. 성당 사람들한테 「뒤집힌 불결한 신상」에 대해선 말하지 않는 게 좋을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020421
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020421,
					"content": "신상에 대한 일을 페보니우스 성당이 가만둘 리 없어. 그들이 개입되면 일만 더 커지겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020422
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020422,
					"content": "그리고… 누구든 「심연」과 관련된 걸 접촉하면 항상 결과가 좋지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80020414,
					"content": "환영받지 못할 거 같나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020410,
					"content": "궁금하지 않아요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				}
			]
		},
