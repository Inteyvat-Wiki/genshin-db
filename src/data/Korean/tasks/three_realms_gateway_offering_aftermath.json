			"dialogs": [
				{
					"id": 400511101,
					"content": "헐, 페이몬 놀랐어. 정말로 효과가 있다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400511102,
					"content": "그 녀석, 이번엔 거짓말 안 했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400511103,
					"content": "엄밀히 말하자면 우릴 속인 적은 별로 없지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511104
					]
				},
				{
					"id": 400511104,
					"content": "그 녀석 궤변대로라면 그렇긴 하지. 근데 왜 이해해 주는 건데! 그러면 안 되지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400511105,
					"content": "지금 다이니치 미코시의 통로가 다시 열렸을 거야. 빨리 가서 확인해보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
