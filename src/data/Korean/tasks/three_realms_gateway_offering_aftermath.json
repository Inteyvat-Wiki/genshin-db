				"points": []
			},
			"dialogs": [
				{
					"id": 400511501,
					"content": "앗, 츠미다! 다이니치 미코시 앞에서 뭘하는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400511502,
					"content": "두 분이 돌아왔으니 묻는 거지만, 구출 작전은 성공했나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511503
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511503,
					"content": "일부 어린 용 도마뱀은 이미 구출됐고 늙고 약한 용 도마뱀은 우리가 정예를 쓰러트리자 물속으로 숨어버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400511504,
					"content": "츠미, 근데 너 진짜 용 도마뱀이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400511505,
					"content": "두 사람에게 해명할 생각은 없어요. 우린 서로 소통할 수 있지만, 인간과의 교류는 결국 배신으로 끝맺을 뿐이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511506
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511506,
					"content": "두 종족은 서로 싸울 수밖에 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511507
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511507,
					"content": "전 떠나기 전에 이 등대를 파괴할 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511508
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511508,
					"content": "혼자 할 수 있겠어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511509
					]
				},
				{
					"id": 400511509,
					"content": "가까이 오지 마세요. 절 습격할 생각도 하지 말고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511510
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511510,
					"content": "이 탑은… 제 소원에 반응하는 것 같더군요. 제가 원한다면 빛과 어둠을 조종할 수도 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511511
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511511,
					"content": "심지어 탑을 바로 무너트릴 수도 있죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511512
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511512,
					"content": "주먹을 쥐는만큼의 염원으로 용 도마뱀에 고통을 안겨준 탑을 파괴할 수 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511513
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511513,
					"content": "근데 왜 전… 이 탑을 파괴하지 못하는 걸까요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511514
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511514,
					"content": "#으악. 이건 핏빛 산호를 잃는 것보다 훨씬 심각한 일이잖아! {NICKNAME}, 무슨 방법 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511515,
						400511516
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400511515,
					"content": "츠미 씨, 이걸 알아보겠어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511517
					]
				},
				{
					"id": 400511517,
					"content": "이건… 아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511518
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511518,
					"content": "츠미는 자신의 목걸이를 떠올린다. 그리고 목걸이와 조각을 합쳤다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400511519
					]
				},
				{
					"id": 400511519,
					"content": "이건, 뱀 세 마리가 얽힌 모양의… 목걸이?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511520
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400511520,
					"content": "이 목걸이는 제가 어렸을 때부터 갖고 있던 건데 왜 당신 거랑 합칠 수 있는 거죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511521
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511521,
					"content": "그 답은 이미 알 텐데요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511522
					]
				},
				{
					"id": 400511522,
					"content": "웃기는 소리. 설마… 당신의 뜻은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511523
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511523,
					"content": "이해가 안 돼… 이건 코코미의 목걸이고, 저건 다이니치 미코시에서 얻었고, 츠미 건 어렸을 때부터 갖고 있던 거잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511524
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400511524,
					"content": "츠미 씨는 와타츠미섬 사람이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511525
					]
				},
				{
					"id": 400511525,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511526
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511526,
					"content": "전 어렸을 때부터 용 도마뱀과 함께 자랐어요. 이 목걸이 외에도, 서책이 몇 상자 있었죠. 전 그 책으로 인간의 언어와 글을 배웠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511527
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511527,
					"content": "하지만 얼마 안 가서 연하궁엔 인간이 전부 사라졌어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511528
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511528,
					"content": "최근에서야 인간과 접촉할 기회가 생겼죠. 그리고 서책의 내용과 의미를 깨달았어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511529
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511529,
					"content": "츠미…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511530
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400511530,
					"content": "이때까지 줄곧 이해할 수 없었지만, 지금은 이해할 수 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511531
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511531,
					"content": "「인간은 태어난 곳에 속하고, 짐승은 먹이가 있는 곳에 속한다.」 전 용 도마뱀이지 사람이 아니에요. 그러니 전 제가 있어야 할 곳으로 돌아갈 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511532
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511532,
					"content": "다이니치 미코시는 아무래도 좋아요. 우린 언젠가 다시 돌아올 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511534
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400511534,
					"content": "츠미가 가버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511535
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400511535,
					"content": "츠미는 왜 마지막에 마음을 바꾼 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511536
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400511536,
					"content": "코코미는 알고 있을지도 몰라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511537
					]
				},
				{
					"id": 400511537,
					"content": "응응, 코코미라면 이런 상황도 예상했겠지. 그래서 목걸이를 우리한테 줬을 테고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400511538
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400511538,
					"content": "이제 다 해결했으니, 돌아가서 보고하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400511516,
					"content": "츠미 씨, 이걸 받으세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400511517
					]
				}
			]
		},
