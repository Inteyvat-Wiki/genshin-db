				"objectNames": [
					"「엔죠」라고 자칭하는 자"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510301,
					"content": "호오. 이걸 의외라고 해야 하나, 전혀 의외가 아니라고 해야 하나. 이런 어둠 속에서 안개를 뚫고 내 앞까지 찾아오다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510302
					],
					"speakerTitle": "「엔죠」라고 자칭하는 자"
				},
				{
					"id": 400510302,
					"content": "너만이 할 수 있는 일이지. 근데, 저들이랑 손을 잡은 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510303
					],
					"speakerTitle": "「엔죠」라고 자칭하는 자"
				},
				{
					"id": 400510303,
					"content": "또 말하면서 시간 끌려는 수작이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400510304,
					"content": "…그렇군. 너희들은 진짜 아무것도 모르는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510305
					],
					"speakerTitle": "「엔죠」라고 자칭하는 자"
				},
				{
					"id": 400510305,
					"content": "날 보고 피가 끓어오르는 건 이해하지만, 이렇게 먼 길을 뛰고도 기운이 넘치는 건 좀 귀찮달까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510306
					],
					"speakerTitle": "「엔죠」라고 자칭하는 자"
				},
				{
					"id": 400510306,
					"content": "네가 내 말을 얌전히 들어줄 때까지 몸 좀 푸는 셈 치고 어울려주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「엔죠」라고 자칭하는 자"
				}
			]
		},
