			},
			"dialogs": [
				{
					"id": 400510101,
					"content": "츠미, 우리 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400510102,
					"content": "두 분의 성과는 이미 확인했어요. 탑 3개를 전부 처리했더군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510103
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400510103,
					"content": "연하궁이 원래대로 회복되면서 부상자와 군인들이 빠르게 철수할 수 있었어요. 음, 대부분은요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510104
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400510104,
					"content": "하지만 예상치 못한 일이 벌어지기도 했죠. 두 분, 절 따라오세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "츠미"
				}
			]
		},
		{
			"id": 4005102,
			"completionStepIds": [
				4005102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005102",
							"2"
						],
						"stepId": 4005102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"츠미"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400510201,
					"content": "다이니치 미코시 내부에 어둠이 꿈틀대고 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400510202,
					"content": "원래대로라면 연하궁의 전역이 정상으로 회복됐어야 하는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510203
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400510203,
					"content": "안타깝게도 지금 여긴 가장 위험한 장소가 됐네요. 저도 왜 이렇게 됐는지, 뭘 해야 할지 모르겠군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510204
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400510204,
					"content": "다만 배후의 흑막이 지금 어디 있는지는 알려줄 수 있어요. 지금으로선 그와 대질해서 모든 계획을 털어놓게 할 수밖에 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510205
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400510205,
					"content": "어떻게 찾아낸 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400510206,
					"content": "전 검은 안개의 동향을 줄곧 관찰해왔으니 이상한 낌새를 어느 정도 알아차릴 수 있었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510207
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400510207,
					"content": "미세한 소용돌이가 검은 안개를 계속 흡수하고 있었어요. 아마도 그자가 심연의 힘을 흡수하면서 생긴 미세한 흐름 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510208
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400510208,
					"content": "그자는 너무 위험해요. 평범한 용 도마뱀은 그의 상대가 안 될지도 몰라요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510209,
						400510210
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400510209,
					"content": "걱정하지 마세요. 예전부터 혼내주고 싶었던 녀석이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510211
					]
				},
				{
					"id": 400510211,
					"content": "그럼 더할 나위 없이 좋죠. 이 일은 두 분께 부탁할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400510212
					],
					"speakerTitle": "츠미"
				},
				{
					"id": 400510212,
					"content": "제 추측이 맞는다면, 그자는 아마 <color=#00E1FFFF>도서관</color> 일대에 있을 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "츠미"
				},
				{
					"id": 400510210,
					"content": "걱정하지 마세요. 원래 맞는 걸 좋아하는 녀석이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400510211
					]
				}
			]
		},
		{
			"id": 4005103,
			"completionStepIds": [
				4005103
			],
