				"objectNames": [
					"신염",
					"모나",
					"카에데하라 카즈하"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701001,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701002
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400701002,
					"content": "드디어 때가 됐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701003
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400701003,
					"content": "그 누구도 예상하지 못한 사람과 콘서트를 열고 싶다는 소원을 빈 적이 있는데, 오늘 이 섬에서 그 답을 찾은 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701004
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400701004,
					"content": "오래전 이 섬을 거대한 악기로 만든 사람의 이름도 생김새도 모르지만, 그는 분명 티바트의 가장 위대한 음악가 중 하나일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701005
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400701005,
					"content": "이런 악기는 생전 처음이야. 게다가 조석 간에 맞춰 연주할 수 있을 줄 상상도 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701006
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400701006,
					"content": "로큰롤을 연주하는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701007
					]
				},
				{
					"id": 400701007,
					"content": "아니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701008
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400701008,
					"content": "음악은 친구에게 주는 선물이야, 그래서… 난 이곳 주민들에게 어울리는 방식으로 연주할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701009
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400701009,
					"content": "오늘은 로큰롤 말고 새로운 모습을 보여줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701010
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400701010,
					"content": "…휴우",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701011
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400701011,
					"content": "어때? 나쁘지 않은 무대였지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701012
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400701012,
					"content": "무척 좋았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701013
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400701013,
					"content": "이런 합주는 처음이야, 정말 즐거웠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701014
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400701014,
					"content": "게다가 엄청 우아했어! 뭐라고 표현해야 할지 모르겠지만… 끝내줬어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701015,
						400701016
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400701015,
					"content": "정말 개성 넘치는 공연이었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				},
				{
					"id": 400701017,
					"content": "후후, 다들 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701018
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400701018,
					"content": "이제 내 소원은 이루어졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701019
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400701019,
					"content": "또 하고 싶은 건 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701020
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400701020,
					"content": "없어, 오늘은 정말 푹 잘 수 있을 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701021
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400701021,
					"content": "혹시 제안할 게 하나 있는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701022
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400701022,
					"content": "우인단 야영지에 다시 가서 상황을 확인해 보고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701023
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400701023,
					"content": "음? 너희도 우인단 야영지를 발견했구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701024
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400701024,
					"content": "잠깐만, 너도 알고 있었어?",
