					],
					"speakerTitle": "신염"
				},
				{
					"id": 400701027,
					"content": "맞아, 오늘 피슬과 헤어지면서 말해줬어. 만약 우인단을 만나면 숨으라고 했으니까 위험하지는 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701028
					],
					"speakerTitle": "모나"
