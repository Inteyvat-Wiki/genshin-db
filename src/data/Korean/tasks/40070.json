			"dialogs": [
				{
					"id": 400700401,
					"content": "섬에 있는 산 일부는 식물과 수맥을 잃었는데, 다시 뚫는 방법을 알고 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700402
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400700402,
					"content": "그 문제를 도와줄 수 있는 사람이 하나 있어. 위층에 나의 동료 얼어붙은 마음이 살고 있으니 가서 물어봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이글거리는 마음"
				}
			]
		},
		{
			"id": 4007005,
			"completionStepIds": [
				4007005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007005",
							"2"
						],
						"stepId": 4007005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"얼어붙은 마음",
					"신염"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700501,
					"content": "너희들은 누구지? 여기에 어떻게 왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700502
					],
					"speakerTitle": "얼어붙은 마음"
				},
				{
					"id": 400700502,
					"content": "반가워, 너의 힘을 빌려 이 섬에 있는 산들을 연결시키고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700503
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400700503,
					"content": "산? 아, 알겠다…. 너희들도 음악가가 되고 싶은 거구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700504
					],
					"speakerTitle": "얼어붙은 마음"
				},
				{
					"id": 400700504,
					"content": "뭐? 그게 무슨 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400700505,
					"content": "맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700506
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400700506,
					"content": "그렇다면 우리는 같은 길을 추구하는 동지군. 난 약하지만 너희들을 도울게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700507
					],
					"speakerTitle": "얼어붙은 마음"
				},
				{
					"id": 400700507,
					"content": "내 꽃잎을 들고 음률이 만나는 끝자락에 심어, 지하에 묻힌 산맥이 음악 소리에 다시 솟아오를 거야. 음악만 있으면 생명이 모든 땅에 흐를 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700508
					],
					"speakerTitle": "얼어붙은 마음"
				},
				{
					"id": 400700508,
					"content": "…고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "신염"
				}
			]
		},
		{
			"id": 4007010,
			"completionStepIds": [
				4007010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
