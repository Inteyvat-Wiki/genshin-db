			"dialogs": [
				{
					"id": 200230201,
					"content": "하하하, 난 매일 이 잔을 가리키며…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230202
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 200230202,
					"content": "술 끊는다고 하지 않았어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230203
					]
				},
				{
					"id": 200230203,
					"content": "헉?! 깜짝 놀랐네…. 난 또 마누라인 줄 알았잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230204
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 200230204,
					"content": "가끔 한 잔 하는 건 괜찮아. 하루 종일 힘들게 일했으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230205
					],
					"speakerTitle": "니므롯"
				},
				{
					"id": 200230205,
					"content": "조금만 더 마시고 돌아갈 거야…. 유리도 살 거 다 샀겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "니므롯"
				}
			]
		},
