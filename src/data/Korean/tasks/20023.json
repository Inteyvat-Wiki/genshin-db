					"nextDialogs": [
						200230303
					]
				},
				{
					"id": 200230303,
					"content": "그는 거의 한나절 동안 술을 마셨어. 봐, 이게 술값 계산서야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230304
					],
					"speakerTitle": "찰스"
				},
				{
					"id": 200230304,
					"content": "계속 이러면 유리 아가씨를 부르는 수밖에 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230305
					],
					"speakerTitle": "찰스"
				},
				{
					"id": 200230305,
					"content": "빌려달라고? 안 되는 건 아닌데 이걸로 뭐 하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "찰스"
				}
			]
		},
