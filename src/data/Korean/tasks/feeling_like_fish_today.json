					}
				]
			},
			"dialogs": [
				{
					"id": 750150401,
					"content": "#짜잔! 역시 {NICKNAME}(이)야. 건방진 물고기를 잡았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750150402,
					"content": "미끼를 한꺼번에 다 뿌린 다음에, 물고기들이 먹고 배불러서 자동으로 배를 뒤집고 둥둥 떠오르게 하면, 그것도 「낚시」로 칠 수 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750150403,
					"content": "아… 아웅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150404
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150404,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}도 좋은 생각 같아? 기대에 찬 눈빛이네! 헤헤, 우리 다음에 같이 해보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750150405,
					"content": "아웅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150406,
					"content": "#아앗! 아직 다 안 구웠어. {NICKNAME}이(가) 다 만들 때까지 기다려야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750150407,
					"content": "생선을 구운 후 다 함께 만족스러운 한 끼를 먹었다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150408
					]
				},
				{
					"id": 750150408,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150409
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150409,
					"content": "이번 생선구이는 특히나 맛있었던 것 같아. 역시 내가 낚은 물고기라니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750150410,
					"content": "역시 페이몬이야, 앞으로 전부 너한테 맡길게!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150411
					]
				},
				{
					"id": 750150411,
					"content": "어휴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150412
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750150412,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150413,
					"content": "#공짜는 안 돼. 물고기를 먹고 싶으면 {REALNAME[ID(2)|SHOWHOST(true)]} 너도 다음부터 도와야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750150414,
					"content": "우웅?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150415
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150415,
					"content": "이럴 때만 모르는 척하기야! 요 녀석이!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
