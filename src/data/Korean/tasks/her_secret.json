					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220101,
					"content": "응? 코코미는 아직 안 왔나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120220102,
					"content": "이상하네. 코코미가 지각할 사람이 아닌데… 조금만 더 기다려보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120220103,
					"content": "코코미가 지금까지 안 오다니. 무슨 일이라도 생겼나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120220104,
					"content": "저기 있는 병사한테 물어보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120220701,
					"content": "산고노미야 님을 찾고 있다고요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220702
					],
					"speakerTitle": "시바타"
				},
				{
					"id": 120220702,
					"content": "죄송하지만 산고노미야 님은 여기 안 계십니다. 어디로 가셨는지는 저도 몰라요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220703
					],
					"speakerTitle": "시바타"
				},
				{
					"id": 120220703,
					"content": "여기 없다고…? 그럼 우린 돌아가야 하나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220704
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120220704,
					"content": "꼭 돌아가야 되는 건 아닙니다. 산고노미야 님이 남기신 상비 묘책 모음집에 이런 상황의 해결법이 있던 것 같거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220705
					],
					"speakerTitle": "시바타"
				},
				{
					"id": 120220705,
					"content": "흠, 제98조… <color=#00E1FFFF>「멀리서 온 손님이 날 찾으실 때 내가 없다면, 남쪽의 자엽나무 앞으로 모시면 된다」</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220706
					],
					"speakerTitle": "시바타"
				},
				{
					"id": 120220706,
					"content": "비고에 산고노미야 님이 아무런 당부를 하지 않으셨고 특별한 손님일 때만 해당된다고 적혀 있네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220707
					],
					"speakerTitle": "시바타"
				},
				{
					"id": 120220707,
					"content": "두 분은 멀리서 온 손님이시겠죠. 이 묘책 모음집은 제가 계속 갖고 있었으니 맞을 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220708
					],
					"speakerTitle": "시바타"
				},
				{
					"id": 120220708,
					"content": "역시 코코미는 모든 경우의 수를 생각했구나. 코코미가 말한 곳으로 가보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 1202202,
			"completionStepIds": [
				1202208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
