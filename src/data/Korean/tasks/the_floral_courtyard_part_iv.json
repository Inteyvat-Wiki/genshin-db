				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726900101,
					"content": "드디어 이날이 왔네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900102
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726900102,
					"content": "두 분은 「꽃 그림자가 드리운 정원」의 구도의 정수를 충분히 터득하신 것 같네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900103
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726900103,
					"content": "이젠 원예의 본격적인 시련을 맞이할 차례입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900104
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726900104,
					"content": "잠깐, 우리가 벌써 정수를 터득했다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726900105,
					"content": "본격적인 시련이라면 가장 어려운 문제를 말하는 거잖아! 갑자기 좀 무서워지는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726900106,
					"content": "우린 꽃꽂이를 접한 지 얼마 안 됐잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900107
					]
				},
				{
					"id": 726900107,
					"content": "꽃꽂이의 기법은 확실히 장기적이고 꾸준한 단련이 필요하지만, 「화원」의 경관과 구조는 이해와 영감이 더 중요하답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900108
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726900108,
					"content": "그리고 후자로만 따지면, 두 분은 이미 놀라운 재능을 보여주고 있어서 더 이상 「꽃 퀴즈」의 수련을 받지 않아도 될 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900109
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726900109,
					"content": "어쩌면 두 분은 아름다운 여정을 겪으면서, 제가 상상조차 수 없는 경치를 보았기에 평범한 사람들과는 다른 심경을 갖게 된 걸지도 모르겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900110
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726900110,
					"content": "그, 그런가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726900111,
					"content": "#{NICKNAME}, 그러고 보니 우리 진짜 여기저기 많이 가봤구나. 함께 여행하면서도 많은 영감을 받게 되네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726900112,
					"content": "그동안 원예를 배우면서 영감을 다 쓰진 않았을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900113,
						726900114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726900113,
					"content": "여정은 계속될 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				},
				{
					"id": 726900115,
					"content": "응, 맞는 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726900116,
					"content": "고마워, 후시조메! 네가 이끌어주지 않았다면, 우린 우리가 이런 쪽으로 재능이 있었는지도 몰랐을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726900117,
					"content": "별말씀을요. 완벽한 「화원」으로 이번 원예 체험에 종지부를 찍어주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900118,
						726900122
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726900118,
					"content": "시작해 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900119
					]
				},
				{
					"id": 726900119,
					"content": "그럼, 오늘의 꽃 퀴즈는——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900120
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726900120,
					"content": "「곁가지는 무지개처럼 알록달록한 무늬를 물들이네」입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900121
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726900121,
					"content": "두 분의 완벽한 기예로 만들어진 「꽃 그림자가 드리운 정원」을 기대할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726900122,
					"content": "다른 할일이 있어서…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900123
					]
				},
				{
					"id": 726900123,
					"content": "괜찮아요, 「꽃꽂이」는 정신을 가다듬는 게 중요하거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726900124
					],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726900124,
					"content": "급한 일을 해결하고 번잡함에서 벗어나면 분명 퀴즈에서 언급한 「화원」을 더욱 완벽하게 만들 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "후시조메"
				},
				{
					"id": 726900114,
					"content": "영감은 점점 더 많아질 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726900115
					]
				}
			]
		},
		{
			"id": 7269003,
