				},
				{
					"id": 150470402,
					"content": "여기 명룡 직원이 있어! 도움을 받아야 하나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150470403,
					"content": "있잖아, 설비를 만들어 주지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470404
