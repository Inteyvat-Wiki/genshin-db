						150470405
					],
					"speakerTitle": "어린 명룡"
				},
				{
					"id": 150470405,
					"content": "그러니까… 여기에다… 만드는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470406
					],
