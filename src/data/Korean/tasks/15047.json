					"nextDialogs": [
						150470508
					]
				},
				{
					"id": 150470508,
					"content": "어머, 붙임성이 좋네! 형광 뿔버섯 먹을래? 조금 먹어봐",
					"roleType": "TALK_ROLE_NPC",
