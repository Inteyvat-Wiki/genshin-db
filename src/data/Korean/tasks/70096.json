				{
					"id": 700960701,
					"content": "휴, 처음으로 직접 나선 건데 이렇게 되어버렸네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960702,
						700960704
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 700960702,
					"content": "뭐든 시작이 제일 어려운 법이잖아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960703
					]
				},
				{
					"id": 700960703,
					"content": "게다가 결과도 나쁘지 않았잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700960704,
					"content": "처음이라니 뭐가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960705
					]
				},
				{
					"id": 700960705,
					"content": "음… 「마녀의 과제」. 나중에 다시 설명해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "니콜"
				}
			]
		},
