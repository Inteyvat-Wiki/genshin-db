					"nextDialogs": [
						140250542
					],
					"speakerTitle": "「아를레키노」"
				},
				{
					"id": 140250542,
					"content": "좋아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250543
					]
				},
				{
					"id": 140250543,
					"content": "그렇다면 교섭 성립이군. 날 따라와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「아를레키노」"
				},
				{
					"id": 140250513,
					"content": "저도 못 봤어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250514
					]
				}
			]
