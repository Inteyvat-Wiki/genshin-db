			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"알베도"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440500,
					"content": "흠, 실험적인 측면으로 보면 평범한데 맛은 정말 기가 막히네. 요리에 재능이 있구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440502
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440502,
					"content": "내가 가장 기대했던 증식 현상이 안 나타난 걸 보면, 네가 온 세계도 음식에서 자유롭지 못한가 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440503
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440503,
					"content": "아니면 이 세계의 법칙이 네 특별한 능력을 제한해버린 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440504
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440504,
					"content": "일단 원소의 힘을 어떻게 조미료처럼 음식에 넣어야 할지 모르겠다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110440505,
					"content": "괜찮아. 맛있는 음식을 낭비하지 않았으니까 너무 속상해할 필요 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440506
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440506,
					"content": "이건 너한테 주기로 했던 거니까 천천히 먹어. 포장해가도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440507
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440507,
					"content": "고마워! 기억하고 있다니 감동이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440508,
						110440509
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110440508,
					"content": "페이몬한테 정말 친절하네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				},
				{
					"id": 110440510,
					"content": "너랑 정말 좋은 친구 같아 보였거든. 실험 중에도 계속 널 걱정하며 이것저것 알려주던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440511
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440511,
					"content": "그렇다고 그게 썩 도움이 된 건 아니었지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440512
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440512,
					"content": "이봐, 왜 갑자기 험담하는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440513
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110440513,
					"content": "그래도 맛있는 걸 줬으니 이번엔 용서해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440514
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110440514,
					"content": "우리 둘을 부러워할 거 없어. 너도 친구나 학생들이 있잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440515
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110440515,
					"content": "…응, 맞아. 나도 운이 좋은 편이지. 이 얘긴 그만하고 다음 실험으로 넘어가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440516
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440516,
					"content": "연금술 용품은 종류가 너무 많아서 보관하는 게 일이야. 얼마 전에도 예상치 못한 사고로 내 소장품이 전부 쏟아졌거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440517
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440517,
					"content": "대부분 찾았지만 수정 나비의 원소 추출물이랑 무상의 뇌전 가루는 어디에도 없더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440518
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440518,
					"content": "이젠 요리 말고 물건 찾는 거까지 시키려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440519
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110440519,
					"content": "걱정 마. 원래는 다시 만들려고 했는데, 찾을 수만 있다면 그럴 필요 없을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440520
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440520,
					"content": "만약 너한테 「야간 시력」이나 「진동 감지」 같은 초능력이 있으면, 물건 찾는 것쯤은 식은 죽 먹기일 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440521
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440521,
					"content": "아마 너희가 구경했던 곳 구석 어딘가에 떨어져 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440522
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440522,
					"content": "그럼… 찾아볼 수밖에 없겠네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440523
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110440523,
					"content": "잃어버린 물건에 원소의 힘이 깃들어 있나 봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440524
					]
				},
				{
					"id": 110440524,
					"content": "맞아! 원소 시야를 사용해보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110440509,
					"content": "페이몬한테 이렇게 친절한 사람은 드문데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				}
			]
		}
	]
}