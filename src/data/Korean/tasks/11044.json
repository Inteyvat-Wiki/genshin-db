					"알베도"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440141,
					"content": "나 왔어. 뭐 재밌는 거라도 있었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440142,
						110440144
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440142,
					"content": "뭐가 뭔지 모르겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440143
					]
				},
				{
					"id": 110440143,
					"content": "괜찮아. 연금술에 쓰이는 물건들이라 일상생활에선 볼 일 없거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440146,
					"content": "어쨌든 빨리 다음 연구로 넘어가 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440101
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440101,
					"content": "서로 다른 세계 간엔 매우 큰 차이점이 존재할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440102
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440102,
					"content": "예를 들어 티바트에선 신의 눈만 있다면 누구든 원소의 힘을 사용할 수 있지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440103
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440103,
					"content": "「단 한 명만 원소를 사용하는 세계」 또는 「누구나 원소를 사용할 수 있는 세계」도 있을 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440104
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440104,
					"content": "#그래서 {NICKNAME}, 혹시 원소 외에… 이 세상엔 없는 다른 특별한 힘은 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440105
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440105,
					"content": "이것도 역시 아까 했던 방법으로 실험해볼 수밖에 없겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440106,
						110440107
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440106,
					"content": "또 슬라임이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440108,
					"content": "아니, 이번엔 그렇게 복잡하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440109
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440109,
					"content": "여기 있는 기둥을 네 의지력만으로 부러뜨려 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440110,
						110440113
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440110,
					"content": "미안, 난 못 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440111
					]
				},
				{
					"id": 110440111,
					"content": "벌써 시도해봤어? 그렇구나… 괜찮아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440112
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440112,
					"content": "못 하는 게 정상이지. 뭘 그렇게 실망해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110440116,
					"content": "참, 원소로 음식을 만들어 본 적 있어? 원소의 힘으로 요리하는 거 말고 원소를 아예 음식에 넣는 거 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440117
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440117,
					"content": "음식이 더 맛있어지거나 식감이 변하는지 궁금해. 아니면… 증식된다거나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440118,
						110440119
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440118,
					"content": "연금술사들은 사고방식이 독특하네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440120,
					"content": "하하, 남들이 쉽게 지나치는 것에 호기심을 두면 더 놀라운 걸 발견할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440121
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440121,
					"content": "그럼 「버터 생선 구이」 하나만 만들어줘. 이건 내가 방금 준비한 레시피야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440151
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440151,
					"content": "뭐 이상한 걸 준비하러 간 줄 알았더니 레시피였어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110440122,
					"content": "평소에도 자주 먹거든. 실험용으로든 시식용으로든 아주 좋은 선택지지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440123
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440123,
					"content": "그냥 네가 배고픈 거잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110440124,
					"content": "하지만 맛있는 걸 만드는 거라면 찬성이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440125,
						110440126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110440125,
					"content": "좋아, 알겠다구",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440127,
					"content": "응응! 역시 우린 마음이 잘 맞아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110440128,
					"content": "그럼 부탁해. 실험 결과를 기대하고 있을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440130
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440130,
					"content": "혹시 우리끼리 다 못 먹으면 데마로우스 씨한테도 좀 나눠주면 되겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440131
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440131,
					"content": "이 페이몬 님이 있으니까 그건 걱정 안 해도 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110440126,
					"content": "페이몬 것도 잊지 않고 만들어줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440119,
					"content": "그냥 네가 배고픈 거 아냐?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440113,
					"content": "부러뜨려 봐, 페이몬",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440114
					]
				},
				{
					"id": 110440114,
					"content": "우린 둘 다 불가능하거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110440115,
					"content": "벌써 시도해봤어? 그렇구나… 괜찮아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110440107,
					"content": "또 약을 마셔야 해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440144,
					"content": "정리가 안 되어있네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440145
					]
				},
				{
					"id": 110440145,
					"content": "응, 나도 동의해. 시간 내서 대청소라도 하려고 했는데 실험이 끊이질 않으니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "알베도"
				}
			]
		},
		{
			"id": 1104403,
