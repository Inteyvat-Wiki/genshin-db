			"dialogs": [
				{
					"id": 700280301,
					"content": "어때? 잘 작동돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280302
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700280302,
					"content": "네. 아무 문제 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700280303
					]
				},
				{
					"id": 700280303,
					"content": "다행이야, 이제 고장만 안 나면 정말 좋을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280304
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700280304,
					"content": "이제 특이 기체가 볼트 범위 내에 들어오면 에너지 공급원이 차단되겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280305
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700280305,
					"content": "이제 그 녀석을 무찌를 수 있을 거야. 가서 실력을 발휘해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700280306
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700280306,
					"content": "난 네 실력을 믿어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호세이니"
				}
			]
		}
	]
