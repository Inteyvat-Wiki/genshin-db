			"dialogs": [
				{
					"id": 411230401,
					"content": "으악! 오, 오지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230402
					],
					"speakerTitle": "겁 많은 모로"
				},
				{
					"id": 411230402,
					"content": "어라? 마물이 아니잖아…. 너, 넌 누구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230403
					],
					"speakerTitle": "겁 많은 모로"
				},
				{
					"id": 411230403,
					"content": "지금 마물은 어떤 상황이죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230404
					]
				},
				{
					"id": 411230404,
					"content": "어떤 상황이긴…. 보면 몰라? 방금 마물 떼들을 지나왔다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230405
					],
					"speakerTitle": "겁 많은 모로"
				},
				{
					"id": 411230405,
					"content": "바로 저 옆이야. 벌써 저기 모여서 마을을 습격할 것처럼 보였다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230406
					],
					"speakerTitle": "겁 많은 모로"
				},
				{
					"id": 411230406,
					"content": "내 달리기가 느렸으면 아마 지금처럼 너랑 얘기할 수도 없었겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230407
					],
					"speakerTitle": "겁 많은 모로"
				},
				{
					"id": 411230407,
					"content": "그 마물들은 어디 있죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230408
					]
				},
				{
					"id": 411230408,
					"content": "마을 바로 옆에 있어. 가까워서 잘 보일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230409
					],
					"speakerTitle": "겁 많은 모로"
				},
				{
					"id": 411230409,
					"content": "너도 빨리 대피해. 난 여기서 좀 쉬다가 마을 사람들한테 상황을 알리러 갈게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "겁 많은 모로"
				}
			]
		},
