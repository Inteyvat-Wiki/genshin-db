				"points": []
			},
			"dialogs": [
				{
					"id": 411230101,
					"content": "안녕, 여행자. 지금은 가능한 성 밖으로 나가지 말아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230102
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230102,
					"content": "무슨 일이에요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230103
					]
				},
				{
					"id": 411230103,
					"content": "밖에 떨어져 있는 운석들, 너도 봤지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230104
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230104,
					"content": "어째서인지 요즘 들어 운석이 더 많이 떨어지고 있어서 성 밖이 더 위험해졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230105
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230105,
					"content": "가뜩이나 업무가 많아져서 기사단에 일손이 부족한 상황인데, 몬드성 주변에 보물 사냥단의 흔적이 여러 차례 발견됐지 뭐야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230106
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230106,
					"content": "돈을 위해서라면 뭐든 하는 녀석들이니까. 이 틈을 타서 무슨 짓이라도 하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230107
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230107,
					"content": "괜찮으면 네가 가서 보물 사냥단을 쫓아내 줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230108
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230108,
					"content": "원래는 기사단이 할 일이지만, 도무지 이 일을 처리할 사람이 없어서 너한테 부탁할 수밖에 없네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230109,
						411230111
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230109,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230110
					]
				},
				{
					"id": 411230110,
					"content": "그럼 부탁할게. 이런 상황에서 일을 맡겨서 정말 미안해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230111,
					"content": "보물 사냥단은 운석이 안 무서운가 봐요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230112
					]
				},
				{
					"id": 411230112,
					"content": "흥, 돈을 위해서라면 두려울 게 없는 놈들이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230113
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230113,
					"content": "그럼 부탁할게. 이런 상황에서 일을 맡겨서 정말 미안해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호프만"
				}
			]
		},
