			"dialogs": [
				{
					"id": 411230301,
					"content": "보물 사냥단을 쫓아냈니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230302
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230302,
					"content": "네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230303
					]
				},
				{
					"id": 411230303,
					"content": "다행이다. 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230304
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230304,
					"content": "교훈을 얻었으니 이젠 더 이상 안 오겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230305
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230305,
					"content": "다른 일이 없으면 이만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230306
					]
				},
				{
					"id": 411230306,
					"content": "아, 잠깐만…. 너한테 부탁하고 싶은 게 한 가지 더 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230307
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230307,
					"content": "사실 운석이 떨어진 뒤부터 기사단에 마물이 이상해졌다는 보고가 수도 없이 들어왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230308
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230308,
					"content": "보고된 바에 따르면, 마물이 운석의 영향을 받아 평소보다 더 난폭해진 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230309
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230309,
					"content": "몬드성은 제대로 방어되고 있어서 걱정 없지만, 샘물 마을 바로 옆에 운석이 하나 떨어졌대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230310
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230310,
					"content": "샘물 마을에 사냥꾼들도 많고 우리 쪽에서 기사도 보냈지만, 거긴 도저히 완벽히 방어할 수 있는 지형이 아니라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230311
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230311,
					"content": "만약 마을에 마물이 침입하기라도 하면 큰일이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230312
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230312,
					"content": "네가 샘물 마을 근처에 가서 마물이 있는지 확인해줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230313,
						411230315
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230313,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230314
					]
				},
				{
					"id": 411230314,
					"content": "그럼 부탁할게. 나도 최대한 빨리 기사들을 보낼 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230315,
					"content": "샘물 마을 상황은 어때요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411230316
					]
				},
				{
					"id": 411230316,
					"content": "솔직히 좋진 않아…. 운석에 관한 것 외에 마물과 보물 사냥단까지 신경 써야 되니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230317
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230317,
					"content": "동시에 이 많은 걸 처리하려니 너무 버거워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411230318
					],
					"speakerTitle": "호프만"
				},
				{
					"id": 411230318,
					"content": "아무튼 이 일은 네게 맡길게. 나도 최대한 빨리 기사들을 보낼 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호프만"
				}
			]
		},
