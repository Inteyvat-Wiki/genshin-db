			"dialogs": [
				{
					"id": 200090301,
					"content": "Biat ye, ye pupu dada mosi! Plama ye upa dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090302
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 200090302,
					"content": "Dala beru yo?! Kundala muhe, kucha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090303
					],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 200090303,
					"content": "Kundala gusha! Hahaha!",
					"roleType": "TALK_ROLE_NPC",
