			"dialogs": [
				{
					"id": 200090601,
					"content": "Olah! Muhe mimi, nye, eh… mosi aba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090602
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 200090602,
					"content": "Yo mimi beru si?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090603
					],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 200090603,
					"content": "Buka…mita nye, guru-guru… yo mosi ka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090604
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 200090604,
					"content": "Ya odomu, Todo yo, buka guru-guru nye",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090605
					],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 200090605,
					"content": "Mi? Dada! Valo",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090606
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 200090606,
					"content": "Valo, ya odomu",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090607
					],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 200090607,
					"content": "히히, 이 츄츄족의 움직임을 보니 기분이 좋은 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
