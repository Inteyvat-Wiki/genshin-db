						200090304
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 200090304,
					"content": "Biat ye, plata ye pupu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090305
					],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 200090305,
					"content": "Movo unta nye kucha, mi dada tiga mitono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090306
					],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 200090306,
					"content": "내 말을 알아듣고 우리에게 선물을 주려는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090307
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 200090307,
					"content": "이, 이건 무기잖아! 으아아아아, 여행자! 살려줘!",
					"roleType": "TALK_ROLE_NPC",
