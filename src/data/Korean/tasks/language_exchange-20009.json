			"dialogs": [
				{
					"id": 200090201,
					"content": "여기 마침 깨어있는 츄츄족이 하나 있네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090202
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 200090202,
					"content": "쟤랑 하면 되겠다, 빨리 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090203
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 200090203,
					"content": "조심해. 다른 츄츄족이 깨지 않게 조심히 다가가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090204
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 200090204,
					"content": "안 그러면 우리가 공격하러 온 줄 알 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090205
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 200090205,
					"content": "그럼 분명 그들과 대화할 수 없을 거야",
