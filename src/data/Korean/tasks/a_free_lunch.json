			"dialogs": [
				{
					"id": 741660301,
					"content": "상의는 해봤어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660302
					],
					"speakerTitle": "이상한 사람"
				},
				{
					"id": 741660302,
					"content": "응, 공짜로 해주는 거 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741660303,
					"content": "그야 물론이지, 확실히 「공짜」라니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660304
					],
					"speakerTitle": "이상한 사람"
				},
				{
					"id": 741660304,
					"content": "자자, 어서 가자. 함께 메로피드 요새에 대해 알아보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이상한 사람"
				}
			]
		},
