			"dialogs": [
				{
					"id": 741660501,
					"content": "여기가 바로 세 티켓 극단이 있는 곳이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660502
					],
					"speakerTitle": "이상한 사람"
				},
				{
					"id": 741660502,
					"content": "엥? 소개 문구는 그걸로 끝이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741660503,
					"content": "뭔가가 연상되지 않아? 극단 하면 희극! 희극 하면 로맨스! 로맨스 하면 사랑!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660504
					],
					"speakerTitle": "이상한 사람"
				},
				{
					"id": 741660504,
					"content": "듣자 하니 매일 이곳에 와서 연극을 관람하면 진정한 사랑을 찾을 수 있다더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660505
					],
					"speakerTitle": "이상한 사람"
				},
				{
					"id": 741660505,
					"content": "그런 소문이 있다고? 그럼 모두들 여기 모여 있어야 하는 거 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741660506,
					"content": "다만 소문에는 전제 조건이 하나 있어. 바로 당사자가 메로피드 요새의 죄수도, 교도관도 아니어야 한다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660507
					],
					"speakerTitle": "이상한 사람"
				},
				{
					"id": 741660507,
					"content": "애초에 그게 가능할 리가 없잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741660508,
					"content": "그게 문제일 수도 있겠네. 어쨌든 다음으로 넘어가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이상한 사람"
				}
			]
		},
