			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"하니야",
					"레일라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400860301,
					"content": "왔어? 마침 잘 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860302
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 400860302,
					"content": "다른 참가자들의 「지혜의 구슬」을 회수하고 버섯몬들이 지내기 적합한 장소를 선정했어. 주변 생태에 나쁜 영향을 미칠 일은 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860303
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 400860303,
					"content": "자, 「기쁨의 화염」, 모두한테 인사해야지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860304
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 400860304,
					"content": "「기쁨의 화염」이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860305
					]
				},
				{
					"id": 400860305,
					"content": "「화염 1호」의 새 이름이야. 처음에 말을 잘 듣는 녀석을 보고 사실 아주 기뻤거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860306
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 400860306,
					"content": "조금 더 일찍 고집을 버리고 내 감정에 솔직해져서 버섯몬을 증오하지 않았더라면… 그 감정을 쭉 이어갈 수 있었을지도 모르지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860307
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 400860307,
					"content": "드디어 마음속 매듭이 전부 풀린 것 같네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860308
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 400860308,
					"content": "진작 이렇게 나왔어야지! 「화염 1호」라는 이름에 익숙해지긴 했지만, 새 이름도 아주 깊은 뜻이 담긴 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860309,
						400860310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400860309,
					"content": "축하해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860311
					]
				},
				{
					"id": 400860311,
					"content": "내가 최선을 다해 온화한 버섯몬들을 보살필 테니까, 안심하고 맡겨줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860312
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 400860312,
					"content": "이제 정말 헤어져야 할 시간이네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860313
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 400860313,
					"content": "「빙글빙글몬」, 이제 가야 할 때야. 하니야 씨 말 잘 들어야 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860314
					],
					"speakerTitle": "레일라"
				},
				{
					"id": 400860314,
					"content": "「백뢰차나」, 다음 「훈련사 대회」 때 미코가 다시 널 만나러 올 거니까 기다리고 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400860315,
					"content": "「둥둥 모자」… 마지막으로 하이파이브 하자! 그동안 즐거웠어. 앞으로도 행복하게 잘 지내야 돼? 우리가 다시 만날 날을 기대하면서 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400860316,
					"content": "분명 다시 만날 수 있을 거야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860317
					]
				},
				{
					"id": 400860317,
					"content": "하루빨리 버섯몬과 인간이 사이좋게 지낼 수 있었으면 좋겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860318
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 400860318,
					"content": "난 너희들을 믿어! 좋은 소식 기다릴게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하니야"
				},
				{
					"id": 400860310,
					"content": "「기쁨의 화염」도 축하해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860311
					]
				}
			]
		}
	]
}