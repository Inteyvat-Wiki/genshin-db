				{
					"id": 200150601,
					"content": "Olah! Muhe mimi, nye, eh… mosi aba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150602
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 200150602,
					"content": "Yo mimi beru si?",
					"roleType": "TALK_ROLE_NPC",
