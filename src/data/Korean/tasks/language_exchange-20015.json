						200150603
					],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 200150603,
					"content": "Buka…mita nye, guru-guru… yo mosi ka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150604
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 200150604,
					"content": "Ya odomu, Todo yo, buka guru-guru nye",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150605
					],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 200150605,
					"content": "Mi? Dada! Valo",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150606
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 200150606,
					"content": "Valo, ya odomu",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150607
					],
					"speakerTitle": "츄츄족"
				},
				{
