			"dialogs": [
				{
					"id": 4880101,
					"content": "물건이 여기 있었구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4880102,
					"content": "도와주러 온 거야? 드디어 왔구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880103
					],
					"speakerTitle": "에르네스트"
				},
				{
					"id": 4880103,
					"content": "와이너리에서 오랫동안 일을 해왔지만 츄츄족한테 물건을 빼앗긴 건 처음이야…. 휴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880104
					],
					"speakerTitle": "에르네스트"
				},
				{
					"id": 4880104,
					"content": "너희가 조금만 늦게 왔더라면 난 정말 어쩔 줄 몰랐을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880105
					],
					"speakerTitle": "에르네스트"
				},
				{
					"id": 4880105,
					"content": "#안심해, 츄츄족일 뿐이니까. {NICKNAME}은(는) 싸움을 엄청 잘한다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4880106,
					"content": "싸움을 잘하면 됐어, 그럼 이 <color=#00E1FFFF>화물용 열기구</color>는 너희한테 맡길게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880107
					],
					"speakerTitle": "에르네스트"
				},
				{
					"id": 4880107,
					"content": "츄츄족을 처치하는 데만 신경 쓰지 말고 꼭 <color=#00E1FFFF>화물의 안전을 최우선으로 확보해 줘</color>. 이건 우리가 배상하지도 못할 만큼 비싸니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880108
					],
					"speakerTitle": "에르네스트"
				},
				{
					"id": 4880108,
					"content": "그럼 앞에서 먼저 기다리고 있을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880109
					],
					"speakerTitle": "에르네스트"
				}
			]
		},
