			"dialogs": [
				{
					"id": 4880001,
					"content": "리사, 세금 신고서를 가져온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880002
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4880002,
					"content": "어라, 귀염둥이. 맞아. 진이 쓰러졌단 소식은 들었어. 그래서 문서 관련 업무는 내가 맡게 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880003
					],
					"speakerTitle": "리사"
				},
				{
					"id": 4880003,
					"content": "그래, 그럼 이제 여기에 우리가 볼일은 없는 것 같네. 먼저 가볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880004
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4880004,
					"content": "아, 잠깐만. 사실 찰스 씨가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880005
					],
					"speakerTitle": "리사"
				},
				{
					"id": 4880005,
					"content": "제가 말하죠, 리사 아가씨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880006
					],
					"speakerTitle": "찰스"
				},
				{
					"id": 4880006,
					"content": "방금 새로운 주문을 받았는데 지금 창고에 남은 재고가 부족한 데다 와이너리의 물건이 아직 오지 않은 상황이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880007
					],
					"speakerTitle": "찰스"
				},
				{
					"id": 4880007,
					"content": "괜찮다면 너희가 <color=#00E1FFFF>화물의 상황을 좀 봐줬으면 하는데</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880008
					],
					"speakerTitle": "찰스"
				},
				{
					"id": 4880008,
					"content": "그렇게 급한 주문이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880009
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4880009,
					"content": "그래, 조금 전에 억지로 받게 된 주문이라서, 방.금.전.에. 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880010
					],
					"speakerTitle": "찰스"
				},
				{
					"id": 4880010,
					"content": "맞아~ 찰스 씨가 말한 대로야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880011
					],
					"speakerTitle": "리사"
				},
				{
					"id": 4880011,
					"content": "알았어요, 바로 가볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880012
					]
				},
				{
					"id": 4880012,
					"content": "알았어요. 다음에 밥 한 끼 꼭 사줘야 돼요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880013
					]
				},
				{
					"id": 4880013,
					"content": "하하, 다이루크 사장님이 다음에 꼭 술 한잔 대접해 줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880014
					],
					"speakerTitle": "찰스"
				},
				{
					"id": 4880014,
					"content": "음, 진작에 이렇게 나왔어야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
