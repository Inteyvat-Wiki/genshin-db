			"dialogs": [
				{
					"id": 10230301,
					"content": "우와——여기가 바로 <color=#00E1FFFF>「황금옥」</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10230302,
					"content": "겉보기에도 근사했는데 안이 더 화려할 줄이야! 게, 게다가 온통 모라야!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10230303,
					"content": "티바트 전역에 있는 모라를 다 여기서 만들어내는데, 좀 없어져도 모르지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230304,
						10230305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10230304,
					"content": "손대지 마, 손대면 분명 잡혀갈 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230306
					]
				},
				{
					"id": 10230306,
					"content": "함정이었구나! 넘어갈 뻔했어! 네가 알려줘서 다행이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10230307,
					"content": "가져가진 않고 가까이서 보기만 하는 건 괜찮지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10230308,
					"content": "여기에 누워서 한숨 자고 싶어! 모라를 덮고 자면 꿈도 더 달콤할 것 같아, 헤헤헤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230309,
						10230310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10230309,
					"content": "우선 「선조의 허물」부터 확인해보자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230311
					]
				},
				{
					"id": 10230311,
					"content": "아, 그래! 할 일부터 해야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10230312,
					"content": "여기… 너무 조용하지 않아? 「선조의 허물」처럼 중요한 걸 왜 아무도 안 지키고 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10230313,
					"content": "#——엥?! {NICKNAME}, 봐봐, 저게 뭐야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230314,
						10230315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10230314,
					"content": "천암군이네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230315
					]
				},
				{
					"id": 10230315,
					"content": "다 쓰러져 있는 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230316
					]
				},
				{
					"id": 10230316,
					"content": "…흠, 뭔가 심상치 않은걸?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10230317,
					"content": "「선조의 허물」은 괜찮은지 빨리 확인해 보자!",
					"roleType": "TALK_ROLE_NPC",
