					"nextDialogs": [
						10230535
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10230535,
					"content": "물론 「깨울」 준비는 이미 끝났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230536
					],
					"speakerTitle": "「타르탈리아」"
				},
