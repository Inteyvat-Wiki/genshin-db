			"dialogs": [
				{
					"id": 761710301,
					"content": "다음엔 모험가 길드랑 같이, 나샤 마을에서 제일 예쁜 광석 선정 대회를 열어 볼까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710302
					],
					"speakerTitle": "린네아"
				},
				{
					"id": 761710302,
					"content": "그럼 도로타는 참가 못 하게 해야 하지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710303
					],
					"speakerTitle": "유르바"
				},
				{
					"id": 761710303,
					"content": "으, 도로타가 나오면 무슨 수를 써서든 달빛 은을 우승시킬 게 뻔해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710304
					],
					"speakerTitle": "미크호"
				},
				{
					"id": 761710304,
					"content": "그, 그래도 참가를 막는 건 너무 불공평하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710305
					],
					"speakerTitle": "메이시"
				},
				{
					"id": 761710305,
					"content": "너도 달빛 은 파라 그런 거면서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "미크호"
				}
			]
