			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"카에데하라 카즈하"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400570101,
					"content": "#{NICKNAME}, 페이몬, 안녕. 이로도리 축제에 가이드가 있다는 말은 들었는데, 너희 일 줄은 몰랐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570102
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400570102,
					"content": "헤헤, 우리도 카즈하가 손님으로 이나즈마로 돌아올 줄은 몰랐는걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400570103,
					"content": "초대장을 받았을 때 나도 의아했어. 하지만 밖에서 떠돌다가 이번 기회에 고향에 돌아와서 옛 친구를 추모하는 것도 나쁘지 않다고 생각했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570104
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400570104,
					"content": "카즈하, 멀리서 봤을 때 뭘 찾고 있는 것 같던데, 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400570105,
					"content": "그게, 방금 사람들이랑 배에서 내릴 때 갑자기 주변에서 아주 가벼운 발소리가 들렸거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570106
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400570106,
					"content": "절대 평범한 승객의 발소리가 아니었어. 고개를 돌렸을 땐 이미 사라지고 없었고, 다리 아래서 「풍덩」 소리만 들렸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570107
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400570107,
					"content": "상대방을 찾진 못했지만, 발밑에서 이상한 종이 한 장을 발견했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570108
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400570108,
					"content": "카즈하, 네가 주운 종이에 혹시 시가 적혀 있었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400570109,
					"content": "어, 어떻게 알았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570110
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400570110,
					"content": "그동안 일어난 일을 카즈하에게 알려준다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570111
					]
				},
				{
					"id": 400570111,
					"content": "그런 일이 있었다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570112
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400570112,
					"content": "카즈하, 그 종이 좀 보여줄 수 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570113
					]
				},
				{
					"id": 400570113,
					"content": "응, 여기",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570114
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400570114,
					"content": "「아오이 노 오키나」의 시 마지막에 「아카히토」를 언급했잖아. 역시 이번 편은 아카히토 이야기네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400570115,
					"content": "이번 이야기는 아카히토(赤人)가 붉은 도장을 좋아해서 이 이름을 얻었는데, 그가 표절한 걸 쇼군이 발견해서 유배됐다는 내용이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400570116,
					"content": "뭐랄까. 굳이 평가하자면 오늘 건 좀 불길하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400570117,
					"content": "이전 것들도 사실 별 차이 없었어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570118
					]
				},
				{
					"id": 400570118,
					"content": "난 괜찮은 이야기라고 생각해. 나도 전에 막부가 지명 수배를 내린 중범이었으니, 이야기 속 아카히토랑 비슷하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570119
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400570119,
					"content": "이야기 속 아카히토는 나쁜 짓을 했다구. 쇼군에게 유배당한 건 자업자득이야. 카즈하랑 하나도 안 비슷해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400570120,
					"content": "이봐, 무슨 생각 해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570121,
						400570122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400570121,
					"content": "이야기 속 「도장」 말이야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570123
					]
				},
				{
					"id": 400570123,
					"content": "참, 방금 너희 친구가 사인하는 속도가 너무 느려서 고민이라고 했지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570124
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400570124,
					"content": "리월과 이나즈마에는 「도장이 곧 사인」이란 말이 있으니까, 괜찮은 생각일지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570125
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400570125,
					"content": "항해할 때 가끔 물건을 조각하면서 시간을 보내는데, 도장 만드는 건 내가 도울 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570126
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400570126,
					"content": "와. 다행이다! 그럼 당장 알베도한테 가서 상의하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400570122,
					"content": "행추에게 도움이 될 수도 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570123
					]
				}
			]
		},
