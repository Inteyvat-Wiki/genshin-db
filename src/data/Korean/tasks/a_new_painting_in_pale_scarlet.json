			},
			"dialogs": [
				{
					"id": 400570201,
					"content": "알베도, 행추를 도울 방법을 찾았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400570202,
					"content": "방금 일어난 일을 알베도에게 알려준다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400570203
					]
				},
				{
					"id": 400570203,
					"content": "역시 다섯 가선의 이야기가 또 나타났구나. 게다가 이런 방법이 생기다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570204
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400570204,
					"content": "도장이라. 음. 생각 좀 해볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570205
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400570205,
					"content": "확실히 효율적인 방법이야. 더는 필체로 고민하지 않아도 되겠어. 다만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570206,
						400570207
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400570206,
					"content": "「다만」?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570208
					]
				},
				{
					"id": 400570208,
					"content": "사인이 독자들에게 공개된 적이 있는데, 이번 신간에서 행추 씨만 도장을 쓰면 성의 없어 보이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400570209
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400570209,
					"content": "다른 방법이 떠올랐어. 물론 도장도 그중 일부분이야. 지금 바로 오유정으로 가서 상의하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "알베도"
				},
				{
					"id": 400570207,
					"content": "무슨 문제 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400570208
					]
				}
			]
		},
