			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"소루쉬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736990601,
					"content": "헛, 지난번에 미히르를 찾아갈 때 지나간 길이잖아? 미히르는 지금 없겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990602,
					"content": "주변의 가시들은… 미히르의 동료들이겠지? 다들 건강해 보여. 그러고 보니 지난번엔 이 녀석들에게 도움을 받았네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990603
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990603,
					"content": "흰두둥실이도 참… 내 공로를 잊은 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990604
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736990604,
					"content": "그럴 리가. 소루쉬는 겉으론 툴툴댔어도 결국 동족의 일을 마음에 두고 있었어, 그렇지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990605,
						736990607
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990605,
					"content": "소루쉬가 무슨 일을 했더라… 기억이 안 나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990606
					]
				},
				{
					"id": 736990606,
					"content": "「찬{RUBY#[D]야스나}송의 주인」이면서 잊다니!? 벌로 찬송 시 더 써와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990609
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736990609,
					"content": "헤헤, 알았다. 소루쉬는 「입은 독해도 마음은 여린」 거구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990610
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990610,
					"content": "아니거든. 난 그냥 화관을 손에 넣으려고 그런 거야…. 선배가 시키지만 않았어도… 흥",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990611
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736990611,
					"content": "아무튼 소루쉬가 「쌍각 화관」을 얻을 수 있었던 건 미히르가 있었기 때문이잖아. 제대로 감사 인사를 해야 하지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990612
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990612,
					"content": "오염된 주제에 추하게 발버둥 친 녀석 따위… 「죄를 정화하는 순례길」을 한 10번 정도는 더 걸어야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990613
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736990613,
					"content": "10번은 너무 많잖아! 잠깐… 잘 생각해보니, 못 받아들일 정도는 아닐지도?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990614,
						736990616
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990614,
					"content": "그리 긴 길은 아니니까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990615
					]
				},
				{
					"id": 736990615,
					"content": "응, 가끔 단련하는 것도 나쁘지 않지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990618
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990618,
					"content": "이름만 들으면 열흘 밤낮을 걸어야 할 것 같은데, 사실은 그리 길지 않잖아. 뭐랄까, 길이 너무 짧아서 효과가 있긴 할지 의심된달까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990619
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990619,
					"content": "그 길이 물의 정령들의 순례길만큼 길었다면 나도 미히르를 존경했을지도 모르지만, 아니잖아. 딱 녀석답다고 할 수밖에",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990620
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736990620,
					"content": "물의 정령의 순례길?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990621
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990621,
					"content": "대재앙이 발생한 후 물의 정령들이 하나둘 폰타인에서 수메르로 넘어왔는데, 그들이 지나간 길을 순례길이라 불러",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990622
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736990622,
					"content": "이상하네. 물의 정령들이 수메르로 온 이유가 뭐야? 순례는… 또 무엇을 위한 순례인 거고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990623
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990623,
					"content": "음… 나도 선배한테 들은 게 다야. 예전에 폰타인에서 물의 정령들이 넘어오는 걸 보긴 했지만, 이유는 묻지 않았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990624
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736990624,
					"content": "「씨앗의 어머니 나무」 때문일까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990625
					]
				},
				{
					"id": 736990625,
					"content": "그러게. 그 나무는 페리들을 만든 신이라며, 순례라면 분명 가장 존귀한 씨앗의 어머니 나무가 목적이었겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990626
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990626,
					"content": "하지만 물의 정령이랑 씨앗의 어머니 나무 사이에 무슨 관계가 있길래…. 아, 설마 물의 정령들과 페리는 사실 먼 친척인 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990627
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990627,
					"content": "으음… 소루쉬를 자세히 보니까, 보면 볼수록 물의 정령이랑 조금 닮은 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990628
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990628,
					"content": "하하, 나 엄청난 비밀을 알아낸 거 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990629,
						736990630
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990629,
					"content": "별로 안 닮았는데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990631
					]
				},
				{
					"id": 736990631,
					"content": "흰두둥실이가 또 헛소리를 하는군… 난 물의 정령 따위 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990632
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736990632,
					"content": "앗, 그러고 보니 소루쉬가 그랬잖아, 물의 정령들의 순례길이 미히르가 걸은 죄를 정화하는 순례길보다 훨씬 길다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990633
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990633,
					"content": "그렇다면 물의 정령이 페리보다 대단한 거네! 소루쉬는 물의 정령에게 못 이길 거야, 흑흑",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990634
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990634,
					"content": "뭐, 뭐라고!? 그런 뜻으로 말한게 아닌데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990635
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736990635,
					"content": "…정확히 말하면, 「죄를 정화하는 순례길」은 일종의 상승과 복귀를 상징하는 행위라서, 얼마나 걸었느냐가 중요한 게 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990636
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736990636,
					"content": "오… 대단한 것처럼 들리긴 하는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990637
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990637,
					"content": "어찌 됐든 단편적인 요소만으로 페리가 물의 정령보다 못하다고 하는 건 불합리해! 미히르를 감싸려고 하는 말은 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990638
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736990638,
					"content": "그나저나 주르반은 왜 이번 훈련이 소루쉬에게 딱 맞다고 한 걸까? 별로 특별할 건 없어 보이는데, 미히르도 없고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990639
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990639,
					"content": "뭐, 미히르가 여기 있었다면 소루쉬가 또 투덜댔겠지. 둘은 여러모로 정 반대니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990640,
						736990642
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990640,
					"content": "하나는 둥글둥글하고 하나는 뾰족뾰족하고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990641
					]
				},
				{
					"id": 736990641,
					"content": "그것도 맞긴 한데….그 말 하려던 건 아니거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990644
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990644,
					"content": "멍청하기는… 녀석의 존재도, 녀석이 몇백 년 동안 쏟은 노력도 잊히면 이 모든 게 무슨 의미가 있는 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990645
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736990645,
					"content": "주르반은 네가 그 문제에 대해 생각하길 바란 것이 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990646
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990646,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990647
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736990647,
					"content": "소루쉬에게 시간이 더 필요한 모양이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990642,
					"content": "미히르에겐 「찬송의 주인」이 필요하지 않지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990643
					]
				},
				{
					"id": 736990643,
					"content": "응, 게다가 잊히는 편이 좋은 거라고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990644
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736990630,
					"content": "나도 닮았다고 생각해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990631
					]
				},
				{
					"id": 736990616,
					"content": "긴 길은 아니지만 반복해서 걸으면 힘들 거야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990617
					]
				},
				{
					"id": 736990617,
					"content": "응? 모험가는 그런 생활에 익숙할 거라 생각했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990618
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 736990607,
					"content": "주인공은 소루쉬였지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736990608
					]
				},
				{
					"id": 736990608,
					"content": "바로 그거지, 후후",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736990609
					],
					"speakerTitle": "소루쉬"
				}
			]
		}
	]
}