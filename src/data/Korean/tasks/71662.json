			"dialogs": [
				{
					"id": 716620401,
					"content": "와! 역시 여행자네요. 이렇게 빨리 비경을 조작하는 방법을 이해하다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620402
					],
					"speakerTitle": "홍랑"
				},
				{
					"id": 716620402,
					"content": "그럼 부탁할게요. 당신의 상상력을 발휘해서 이 비경을 변화시켜 보세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716620403
					],
					"speakerTitle": "홍랑"
				},
				{
					"id": 716620403,
					"content": "부디… 비경의 변화 규칙을 빨리 알아낼 수 있길",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "홍랑"
				}
			]
