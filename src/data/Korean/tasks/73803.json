			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아한가르",
					"가르시아",
					"루통"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738030201,
					"content": "전에 나한테 준 부품 설계도를 확인해 봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030202
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 738030202,
					"content": "만들기 힘든 건 아니지만 자네가 원하는 정밀도를 만족시키려면 시간이 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030203
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 738030203,
					"content": "얼마나 걸릴까요? 오늘 안으로 가능한가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030204
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030204,
					"content": "당연히 안 되지! 부품 만드는 게 무슨 유치원생 글쓰기인 줄 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030205
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 738030205,
					"content": "오늘 안에 받지 못하면 「숫자 기계」를 개조할 수 없을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030206
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030206,
					"content": "왜 그렇게 급해? 그 기계는 이미 완성된 거 아니었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030207
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 738030207,
					"content": "그건 제가 설명드리죠. 그러니까 저희가 지금… 음… 예상하지 못했던 문제에 부딪혔거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030208
					],
					"speakerTitle": "루통"
				},
				{
					"id": 738030208,
					"content": "루통이 자초지종을 설명한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						738030209
					]
				},
				{
					"id": 738030209,
					"content": "한 마디로 카이아한테 첫눈에 반했다는 거로군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030210
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 738030210,
					"content": "네?! 아니에요! 저희는 그냥 협력 관계, 비즈니스 파트너일 뿐이에요! 세상에! 이건 정말이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030211
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030211,
					"content": "카이아한테 마음은 표현했고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030212
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 738030212,
					"content": "마음이요? 무슨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030213
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030213,
					"content": "그러니까 카이아한테 자네가 카이아를 그렇고 그런…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030214
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 738030214,
					"content": "제가 증명하죠. 가르시아 선생님은 분명 표현하셨습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030215
					],
					"speakerTitle": "루통"
				},
				{
					"id": 738030215,
					"content": "뭐?! 너… 루통! 네가 그걸 어떻게 알아?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030216
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030216,
					"content": "선생님, 절 다른 곳으로 보내려던 핑계는 너무 허접했습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030217
					],
					"speakerTitle": "루통"
				},
				{
					"id": 738030217,
					"content": "그리고 그날 카페에서 카이아 씨와 반나절 동안 「숫자 기계」 얘기는 한 마디도 나누지 않으셨죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030218
					],
					"speakerTitle": "루통"
				},
				{
					"id": 738030218,
					"content": "가르시아 선생님이 이런 대화를 하다니, 이건 평범한 일이 아니란 걸 확신했죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030219
					],
					"speakerTitle": "루통"
				},
				{
					"id": 738030219,
					"content": "그거참 고맙군! 루통, 부탁건대 자네의 좋은 기억력은 올바른 일에 사용해 주게",
					"roleType": "TALK_ROLE_NPC",
