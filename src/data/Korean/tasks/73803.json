			},
			"dialogs": [
				{
					"id": 738030601,
					"content": "이봐, 근데 왜 굳이 그 이상한 기계로 악보를 만들려는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030602
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 738030602,
					"content": "이것 좀 보라고. 수메르성에는 향신료도 있고, 장신구 가게도 많잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030603
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 738030603,
					"content": "기성품이 마음에 안 들면 내가 직접 만들어줄 수도 있단 말이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030604
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 738030604,
					"content": "아하하, 뭐랄까… 저랑 카이아는 「숫자 기계」 덕분에 만날 수 있었거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030605
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030605,
					"content": "그래서 「숫자 기계」와 관련된 선물을 주고 싶었어요. 그게 바로 이 「계산식 악보」인 거죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030606
					],
