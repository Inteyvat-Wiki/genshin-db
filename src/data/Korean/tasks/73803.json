	"talks": [
		{
			"id": 7380301,
			"completionStepIds": [
				7380301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7380301",
							"2"
						],
						"stepId": 7380301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_HIDE",
			"trigger": {
				"objectNames": [
					"가르시아",
					"루통"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738030101,
					"content": "선생님, 솔직히 말씀드리면 이 「악보」는 흥얼거리는 방법조차 상상이 가질 않습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030102
					],
					"speakerTitle": "루통"
				},
				{
					"id": 738030102,
					"content": "진심으로 건의하는 겁니다만, 정말 충분히… 어… 정상적인 악보를 쓰고 싶으시다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030103
					],
					"speakerTitle": "루통"
				},
				{
					"id": 738030103,
					"content": "돈을 써서라도 극단의 다른 배우분들께 부탁하는 게 어떨까요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030104
					],
					"speakerTitle": "루통"
				},
				{
					"id": 738030104,
					"content": "싫어! 안 돼, 안 돼. 절대 안 돼! 그럼 의미가 없단 말이야. 계산식을 고쳐서 다시 도전해 볼게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030105
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030105,
					"content": "게다가 그렇게 하면… 분명 시간도 더 많이 걸릴 거야. 조금 더 고민해 봐야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030106
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030106,
					"content": "뭐 하고 계세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030107
					]
				},
				{
					"id": 738030107,
					"content": "여행자님, 마침 잘 오셨어요. 저와 가르시아 선생님은 지금 「숫자 기계」를 훈련시켜서 작곡가로 만들려는 중이랍니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030108
					],
					"speakerTitle": "루통"
				},
				{
					"id": 738030108,
					"content": "잘 이해가 안 가실 수도 있는데, 쉽게 말씀드리면 가르시아 선생님은 「숫자 기계」로 계산식을 입력해 악보를 만들려고 하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030109,
						738030110
					],
					"speakerTitle": "루통"
				},
				{
					"id": 738030109,
					"content": "「숫자 기계」로요? 그게 가능해요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030111
					]
				},
				{
					"id": 738030111,
					"content": "「숫자 기계」의 본질은 계산 기계이니, 당연히 직접 악보를 만들 수는 없죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030112
					],
					"speakerTitle": "루통"
				},
				{
					"id": 738030112,
					"content": "「숫자 기계」가 결과를 계산해 내면 가르시아 선생님이 또 다른 계산식을 통해 이 숫자를 수동으로 음표로 바꿔야 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030113,
						738030114
					],
					"speakerTitle": "루통"
				},
				{
					"id": 738030113,
					"content": "머, 머리가 깨질 것 같아요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030115
					]
				},
				{
					"id": 738030115,
					"content": "그래! 루통, 아주 훌륭한 설명이었어. 내 말이 바로 그 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030116
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030116,
					"content": "설명은 여기까지 하고, 여행자! 네 도움이 필요해… 무조건, 무조건 들어줘야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030117
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030117,
					"content": "모라도 좋고 다른 보수도 좋아! 지금은 일손이 너무 부족해서 그래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030118,
						738030119
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030118,
					"content": "누구한테 원한이라도 사셨어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030120
					]
				},
				{
					"id": 738030120,
					"content": "전부 아니야. 그런 것보다 훨씬 더 심각한 문제라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030121
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030121,
					"content": "카이아를… 음, 카이아 씨를 기억해? 오늘 극단을 따라 수메르를 떠난대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030122
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030122,
					"content": "난 카이아에게 이별 선물을 주겠다고 약속했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030123
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030123,
					"content": "그리고 이 계산식으로만 제작한 「계산식 악보」가 바로 내가 카이아를 위해 준비한 선물이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030124
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030124,
					"content": "하지만… 하지만 이 악보로는 노래조차 부를 수 없어… 이런 걸 선물로 줄 수는 없다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030125,
						738030126
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030125,
					"content": "다른 선물로 바꾸는 건 어때요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030127
					]
				},
				{
					"id": 738030127,
					"content": "안 돼. 선물이 너무 평범하면 혹시라도 카이아가… 미안, 지금 너무 혼란스러워서 진정 좀 해야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030128
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030128,
					"content": "아, 아무튼 난 「숫자 기계」를 더 개조해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030129
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030129,
					"content": "여행자, 나랑 같이 아한가르 씨를 만나러 가자. 넌 분명 날 도와줄 수 있을 거야. 부탁해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "가르시아"
				},
				{
					"id": 738030126,
					"content": "다른 선물을 사는 건 어때요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030127
					]
				},
				{
					"id": 738030119,
					"content": "폰타인에서 당신을 잡아가겠대요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030120
					]
				},
				{
					"id": 738030114,
					"content": "음, 완벽하게 이해한 것 같아요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030115
					]
				},
				{
					"id": 738030110,
					"content": "「숫자 기계」가 그렇게 엄청난 거였나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030111
					]
				}
			]
		},
		{
			"id": 7380302,
