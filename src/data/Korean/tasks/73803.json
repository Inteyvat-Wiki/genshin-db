					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738030222
					]
				},
				{
					"id": 738030222,
					"content": "다… 다음 날 커피는 자기가 사겠대…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738030223
