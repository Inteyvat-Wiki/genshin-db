					"파르가니"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250201,
					"content": "저기, 잠깐 혹시 지금 시간 괜찮니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250202,
						230250203
					],
					"speakerTitle": "파르가니"
				},
				{
					"id": 230250202,
					"content": "무슨 일이시죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250208
					]
				},
				{
					"id": 230250208,
					"content": "만약 하늘이 무너지면 어떡하지? 같은 문제를 생각해 본 적 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250209,
						230250210
					],
					"speakerTitle": "파르가니"
				},
				{
					"id": 230250209,
					"content": "괜한 생각인 것 같은데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250212,
					"content": "그럴지도 모르지. 하지만 왜 하늘이 무너지지 않을까? 땅은 왜 꺼지지 않는 거지? 정확한 측량을 거치지 않는다면 이 질문에 대한 답은 영원히 찾을 수 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250213
					],
					"speakerTitle": "파르가니"
				},
				{
					"id": 230250213,
					"content": "사실 내가 이런 질문들에 답할 수 있는 완벽한 모형을 연구해냈어. 그런데 모형을 입증할 더 많은 실험 데이터가 필요해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250214,
						230250215
					],
					"speakerTitle": "파르가니"
				},
				{
					"id": 230250214,
					"content": "도움이 필요하신가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250223,
					"content": "그럼 도와준다는 거지? 정말 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250224
					],
					"speakerTitle": "파르가니"
				},
				{
					"id": 230250224,
					"content": "사실 이미 최고의 관측 장소를 찾았어. 그런데 그 근처에는 마물들이 아주 많아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250225
					],
					"speakerTitle": "파르가니"
				},
				{
					"id": 230250225,
					"content": "내가 안심하고 관측할 수 있도록 그곳의 마물들을 내쫓아 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250226,
						230250228
					],
					"speakerTitle": "파르가니"
				},
				{
					"id": 230250226,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250227
					]
				},
				{
					"id": 230250227,
					"content": "고마워, 그럼 어서 출발하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "파르가니"
				},
				{
					"id": 230250228,
					"content": "당신도 가는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250229
					]
				},
				{
					"id": 230250229,
					"content": "일부 데이터는 내가 직접 확인해야 해. 그래야 오차가 생기는 이유를 발견할 수 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250230
					],
					"speakerTitle": "파르가니"
				},
				{
					"id": 230250230,
					"content": "매일 종이만 바라보고 계산만 한다면 정확한 수치와는 점점 더 멀어질 거야. 빨리 출발하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "파르가니"
				},
				{
					"id": 230250215,
					"content": "행운을 빌게요, 그럼 이만",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250216
					]
				},
				{
					"id": 230250216,
					"content": "잠, 잠깐만! 다시 한번 생각해 봐. 이 성과를 발표한다면 분명 세상이 바뀔 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250217
					],
					"speakerTitle": "파르가니"
				},
				{
					"id": 230250217,
					"content": "그럼 너도 이 위대한 이론의 협력자가 되는 거지. 논문 끝에 네 이름을 적어줄 수도 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250218
					],
					"speakerTitle": "파르가니"
				},
				{
					"id": 230250218,
					"content": "음… 만약 원한다면 제2 저자로 기재해 줄 수도 있고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250219
					],
					"speakerTitle": "파르가니"
				},
				{
					"id": 230250219,
					"content": "뭐가 그렇게 급한 거죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250220
					]
				},
				{
					"id": 230250220,
					"content": "결과를 도출해 내지 못하면 연구 경비가 부족할 거야… 그리고 그건 하늘이 무너지는 것보다 훨씬 더 끔찍한 일이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250221,
						230250222
					],
					"speakerTitle": "파르가니"
				},
				{
					"id": 230250221,
					"content": "「제2 저자」는 됐어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250222,
					"content": "보수만 합리적이면 돼요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250210,
					"content": "하늘은 무너지지 않을 거예요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250203,
					"content": "전 지금 굉장히 바쁜데요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250204
					]
				},
				{
					"id": 230250204,
					"content": "아! 그러지 말고 들어봐. 자기 집이 무너지는 것보다 더 중요한 일이 뭐가 있겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250205
					],
					"speakerTitle": "파르가니"
				},
				{
					"id": 230250205,
					"content": "당신의 집이… 무너지려 한다는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250206
					]
				},
				{
					"id": 230250206,
					"content": "크큼, 그건 아니야. 하지만 만약 제대로 된 모습을 본 적도 없고 튼튼한지 알 수도 없는 집에 살고 있다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250207
					],
					"speakerTitle": "파르가니"
				},
				{
					"id": 230250207,
					"content": "매일 그런 집에서 산다면 분명 불안하겠지? 같은 도리로 그런 세상에 살면 불안할 수밖에 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250208
					],
					"speakerTitle": "파르가니"
				}
			]
		},
