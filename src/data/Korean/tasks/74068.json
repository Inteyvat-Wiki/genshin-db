							4675.246
						],
						"pointId": 6108
					}
				]
			},
			"dialogs": [
				{
					"id": 740680201,
					"content": "음… 여기 마지막 대사는, 「하지만 원수의 두 눈과 진흙탕 속 그림자에 비친 내 모습은 복수로 인해 초췌해졌구나…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680202
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680202,
					"content": "아니, 여기서 갑자기 복수를 후회하는 건 너무 이상하잖아. 게다가 공범한테 보복할 때는 가차 없었는데, 막상 주범 앞에서 마음이 약해지다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680203
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680203,
					"content": "이, 이건 다 복선이 있어. 봐, 그녀는 복수를 할 때마다 원수의 처참한 모습을 보고는 태도가 조금씩 흔들리기 시작했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680204
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680204,
					"content": "어쨌든 우리 취지는 복수에 미친 삶을 권장하는 게 아니잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680205
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680205,
					"content": "안 돼. 이런 결말은 납득할 수 없어. 이런 식으로 극본을 쓰면 욕을 얻어먹을 게 분명해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680206
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680206,
					"content": "네 잣대만으로 판단하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680207
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680207,
					"content": "후, 또 시작됐네. 너야말로 관중들에게 교훈을 주려고 하지 좀 마. 아, 마침 관중이 왔네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680208
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680208,
					"content": "금발 친구, 널 어떻게 부르면 좋을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680209
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680209,
					"content": "#{NICKNAME}요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740680210
					]
				},
				{
					"id": 740680210,
					"content": "안녕, 거기 앉은 걸 보면 연극에 관심이 많나 보네. 잘됐다! 일단 자기소개를 할게. 내 이름은 메일라야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680211
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680211,
					"content": "이쪽은 포몽이고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680212
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680212,
					"content": "안녕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680213
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680213,
					"content": "우리가 바로 그 유명한——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680214
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680214,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680215
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680215,
					"content": "너도 같이 해야지. 우리가 바로 그 유명한 「세 티켓 극단」이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680216
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680216,
					"content": "아, 알았어. 보다시피 우리가 바로 그 유명한 「세 티켓 극단」이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680217
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680217,
					"content": "하하, 사실은 전혀 유명하지 않아. 상시 출연 멤버도 우리 둘뿐이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680218
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680218,
					"content": "그럼 처음부터 그런 소개를 하지 마. 그리고 로셸 확성기로 홍보할 때 날 「유명 공연 예술가」라고 부르지도 말고. 난 거기에 동의한 적 없다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680219
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680219,
					"content": "그건 그냥 홍보 수단일 뿐이야. 그리고 난 포몽이 언젠가 유명한 공연 예술가가 될 거라고 믿어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680220
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680220,
					"content": "으… 그러지 마. 난 그냥 취미로 연기하는 거란 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680221
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680221,
					"content": "넌 재능이 있어. 언젠간 에피클레스 오페라 하우스의 무대를 밟을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680222
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680222,
					"content": "하하, 그렇게 칭찬해도… 잠깐만, 난 이미 무대를 밟았잖아! 거기서 심판을 받았으니까 여기에 있는 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680223
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680223,
					"content": "#음, 그렇긴 하네. 아무튼 {NICKNAME}, 우리는 《몬테쿠리스도 여백작》이라는 이름의 연극을 리허설 중이야. 그런데 결말에 대한 다른 사람의 의견을 듣고 싶거든?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680224,
						740680226
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680224,
					"content": "전 연극에 대해 잘 몰라요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740680225
					]
				},
				{
					"id": 740680225,
					"content": "괜찮아, 이 연극은 모두를 위한 연극이니까. 재미있으면 재미있다고, 시시하면 시시하다고 말하면 돼. 복잡한 연극 이론은 몰라도 의견은 얼마든지 낼 수 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680228
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680228,
					"content": "#어때, 포몽? 우리 {NICKNAME}에게 공연을 보여주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680229
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680229,
					"content": "크흠… 그럼 시작할게. 「누가 그랬던가, 죄악을 치료할 수 있는 약은 오직 시간과 침묵뿐이라고…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680230
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680230,
					"content": "「누가 그랬던가, 죄악을 치료할 수 있는 약은 오직 시간과 침묵뿐이라고」\\n이야기는 「몬테쿠리스도」라는 유배지에서 시작된다.\\n줄리예트라는 여인의 약혼자는 잔인하게 살해당했고, 그녀 또한 유배당했다.\\n하지만 분노의 불길은 그녀의 가슴속에서 불타올랐다. 그녀는 시간과 침묵에 굴하지 않았다.\\n결국 그녀는 그곳을 탈출하여 악당들이 치러야 할 대가를 치르게 할 것이다!",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740680231
					]
				},
				{
					"id": 740680231,
					"content": "우연한 기회를 틈타 그녀는 「몬테쿠리스도」에서 탈출했을 뿐만 아니라, 산에 있는 보물도 손에 넣었다.\\n그녀는 원수들에게 차례대로 복수했다.\\n하지만 복수의 쾌감에 빠져 점차 선량한 마음을 잃게 됐다.\\n몰락한 과거의 원수를 만난 그녀는 이 사실을 깨달았을까?\\n마지막 순간에 날카로운 칼이 목표를 비껴간 이유는 바로 이 때문일지도 모른다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740680232
					]
				},
				{
					"id": 740680232,
					"content": "줄리예트… 어째서 하필 너인 것이냐, 줄리예트!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680233
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680233,
					"content": "그래, 바로 나야. 넌 생각지도 못했겠지. 직접 내 약혼자를 죽이고, 날 「몬테쿠리스도」로 보냈는데… 설마 이렇게 되리라고는 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680234
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680234,
					"content": "아앗…! 너, 너 이 악녀! 기억났어, 기억났다고…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680235
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680235,
					"content": "2주 전 법정에서 넌 이렇게 말했지. 「가슴살 1파운드는 원금으로, 피와 나머지 살은 이자로 치겠다!」 그리고는 안토니를 죽였어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680236
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680236,
					"content": "그는 창백한 얼굴로 심판청 한가운데에 쓰러졌어. 주위 사람들은 그의 심장이 멈추는 걸 지켜봤고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680237
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680237,
					"content": "…흥, 위증한 사내가 수년 전에 지은 죄를 드디어 내가 이자까지 회수한 거야. 그 결말은 자업자득이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680238
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680238,
					"content": "그리고 주연 남자 배우 라울은 갑자기 떨어진 샹들리에에 맞아 죽었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680239
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680239,
					"content": "녀석의 뱀처럼 교활한 꼬드김이 아니었다면, 나와 내 연인은 결코 네 함정에 빠지지 않았을 거니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680240
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680240,
					"content": "그… 그래서 나에게 접근한 것이었나. 내 태엽 탁장 시계가 한밤중에 칼날을 발사하게끔 개조해서, 날 죽이려고…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680241
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680241,
					"content": "맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680242
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680242,
					"content": "줄리예트… 제발 나를 용서해 줘. 안토니가 죽자 그 아내도 뒤따라 자살해서, 부모 잃은 아이들이 슬피 우는 걸 너도 봤잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680243
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680243,
					"content": "정말 그런 광경을 보고 싶은 거야? 라울을 떠올려 봐. 초췌한 백발의 노모가 산산조각이 난 자식의 유해를 수습하던 모습을 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680244
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680244,
					"content": "내 죄가 무겁다는 것은 나도 잘 알아. 하지만 우리가 네 약혼자를 죽인 것은, 그가 우리 형제를 죽였기 때문이었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680245
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680245,
					"content": "말도 안 돼! 전부 거짓말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680246
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680246,
					"content": "믿느냐, 아니냐는 너에게 달렸지. 아아, 줄리예트! 죄악의 사슬이 우리를 뒤틀린 운명의 기둥에 묶었도다. 너는 그것이 어떠한 것인지 아는가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680247
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680247,
					"content": "복수가 너를 해방시켜줄 수 있다면, 그 단도를 내 심장에 찔러넣어도 좋아! 하지만 내 장담하지. 복수를 끝내봤자 그로부터 풀려날 수는 없어…. 오로지 더한 고통만이 기다릴 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680248
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680248,
					"content": "내 비참한 꼴을 봐. 그것만큼은 누구보다 내가 잘 알고 있다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680249
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680249,
					"content": "어떻게 이럴 수가…. 술에 취한 채 매일 고통받고 있던 사내가, 내 불길한 미래를 예언하고 있구나. 복수에 성공하면 해방될 줄 알았는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680250
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680250,
					"content": "하지만 원수의 두 눈과 진흙탕 속 그림자에 비친 내 모습은 복수로 인해 초췌해졌구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680226,
					"content": "제가 다른 건 별로 없어도 의견은 많죠!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740680227
					]
				},
				{
					"id": 740680227,
					"content": "음, 의견이 많다는 건 좀 이상한데… 아무튼 지금 우리에겐 의견이 필요하니까 얼마든지 제시해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680228
					],
					"speakerTitle": "메일라"
				}
			]
		},
		{
