					}
				]
			},
			"dialogs": [
				{
					"id": 740680301,
					"content": "#좋아, {NICKNAME}. 여기가 바로… 의견이 필요한 부분이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680302
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680302,
					"content": "극본상으로는 두 가지 결말이 있어. 하나는 여주인공 줄리예트가 복수를 포기하고, 남은 보물을 사용해서 세계를 여행하며 즐겁게 산다는 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680303
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680303,
					"content": "또 다른 결말은… 줄리예트는 복수를 마치지만, 허무함을 느끼고는 보물을 모두 기부해 버려. 그러고는 약혼자와 만난 곳에서 쓸쓸하게 살다가 늙어 죽는다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680304
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680304,
					"content": "어때? 관중 입장에서 봤을 때 어느 쪽 결말이 더 마음에 들어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680305,
						740680312
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680305,
					"content": "복수를 포기하는 것 또한 일종의 해방이죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740680306
					]
				},
				{
					"id": 740680306,
					"content": "아, 그런가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680307
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680307,
					"content": "봐, 내가 말했잖아. 관중들은 이해할 수 있을 거라고. 복수에 성공했지만 행복하지 못했던 제롬이 바로 눈앞에 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680308
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680308,
					"content": "「복수를 하면 행복해질 것이다」… 당사자라면 이런 생각을 할 수도 있겠지. 하지만 행복은 만들어 내는 것이지, 복수라는 파멸적인 방법으로 얻을 수 있는 게 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680309
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680309,
					"content": "복수는 행복을 낳을 수 없어. 다만 죄악감이 서린 쾌감만을 만들어 낼 뿐이야. 그 쾌감이 사라진 이후에 다른 목표를 찾아내지 못한다면… 그 허무감은 감당하기 어려울 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680310
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680310,
					"content": "복수를 하는 동시에, 또 다른 구원의 길을 찾는 것도 매우 중요하다는 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680311
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680311,
					"content": "음… 일리가 있긴 한데, 인정하긴 싫네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680318
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680318,
					"content": "#후… 고마워, {NICKNAME}. 덕분에 큰 도움이 됐어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680319
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680319,
					"content": "음, 확실히 이렇게 토론을 해보니까 결말에 수정할 부분이 보이는 것 같아. 잘 표현이 되었으면 좋겠는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680320
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680320,
					"content": "#정식 공연 때도 꼭 참석해 줘, {NICKNAME}. 그땐 네 예상을 뛰어넘는 결말을 볼 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680321,
						740680322
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680321,
					"content": "저, 정말인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740680323
					]
				},
				{
					"id": 740680323,
					"content": "하하… 그거야 모르지. 아직 수정하지도 않았으니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680324
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680324,
					"content": "#그럼 왜 {NICKNAME}한테 그런 소리를 한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680325
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680325,
					"content": "#이것도 일종의 홍보잖아. 참! {NICKNAME}, 의견 정말 고마웠어. 이건 그 보답이야. 앞으로도 자주 놀러 와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680322,
					"content": "좋은 의미로 예상을 뛰어넘는 거겠죠…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740680323
					]
				},
				{
					"id": 740680312,
					"content": "당연히 먼저 복수를 끝내야죠!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740680313
					]
				},
				{
					"id": 740680313,
					"content": "#봐봐, {NICKNAME}도 나랑 똑같이 생각하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680314
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680314,
					"content": "제롬은 스토리에서 복수의 「종점」을 상징해. 복수가 제대로 끝나지 않는다면, 「종점」에 다다르지 못했다는 찝찝한 느낌을 줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680315
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680315,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680316
					],
					"speakerTitle": "포몽"
				},
				{
					"id": 740680316,
					"content": "캐릭터가 원수의 현재 모습을 보고 복수를 한 이후의 고통과 허무를 상상하는 것과, 복수에 성공한 다음 고통과 허무를 느끼는 것은 설득력에 큰 차이가 있다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680317
					],
					"speakerTitle": "메일라"
				},
				{
					"id": 740680317,
					"content": "그건 그렇네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740680318
					],
					"speakerTitle": "포몽"
				}
			]
		}
	]
}