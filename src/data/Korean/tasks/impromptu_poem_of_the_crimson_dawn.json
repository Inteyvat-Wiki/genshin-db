					"id": 741780416,
					"content": "매운맛을 보고 싶은 거라면 얼마든지 환영해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741780417
					],
					"speakerTitle": "블루"
				},
