						],
						"pointId": 350100078
					}
				]
			},
			"dialogs": [
				{
					"id": 150121405,
					"content": "왜 더 이상 「고대 이름」을 안 만드는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121406
					]
				},
				{
					"id": 150121406,
					"content": "…딸 때문이야. 가여운 네히자가 몹쓸 병에 걸려서, 트라졸리는 모든 일을 내려놓고 간병에만 전념하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121407
					],
					"speakerTitle": "쉐븐"
				},
				{
					"id": 150121407,
					"content": "네히자의 병세가 가장 심각했을 때의 트라졸리는 꼭 수렁에 빠진 횃불 같았어. 필사적으로 빛과 열을 내뿜었지만 발밑의 흙탕물은 점점 차올랐지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121408
					],
					"speakerTitle": "쉐븐"
				},
				{
					"id": 150121408,
					"content": "아, 그래도 괜찮아! 의사가 준 약이랑 대영혼의 가호 덕분에 네히자의 생명의 불꽃이 다시 타올랐으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121409
					],
					"speakerTitle": "쉐븐"
				},
				{
					"id": 150121409,
					"content": "그 후로 네히자의 병세는 점차 호전됐어. 몸은 여전히 약해서 집에서 안정을 취해야 하지만, 편지 쓸 힘 정도는 생겼지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121410
					],
					"speakerTitle": "쉐븐"
				},
				{
					"id": 150121410,
					"content": "네히자는 종종 실로닌에게 편지를 보낸대. 자기도 고대 이름을 단조하는 장인이 돼서 어머니의 자부심이었던 중책을 이어받고 싶다고 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121411
					],
					"speakerTitle": "쉐븐"
				},
				{
					"id": 150121411,
					"content": "이제 며칠 뒤면 네히자의 생일이라, 네히자의 생일 선물로 줄 순수한 「화산 수정」을 찾아달라고 트라졸리가 부탁하더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121412,
						150121413
					],
					"speakerTitle": "쉐븐"
				},
				{
					"id": 150121412,
					"content": "그래서 혼자 광석을 캐러 온 거군요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121414
					]
				},
				{
					"id": 150121414,
					"content": "진짜 중요한 광석이었구나. 이렇게 예쁜 선물이라면 분명 네히자의 병도 훨씬 빨리 나을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121415
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150121415,
					"content": "트라졸리랑 네히자가 그 말을 들으면 기뻐하겠는걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121416
					],
					"speakerTitle": "쉐븐"
				},
				{
					"id": 150121416,
					"content": "그럼 일단 돌아가자. 이믹스를 너무 기다리게 할 순 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121417
					],
					"speakerTitle": "쉐븐"
				},
				{
					"id": 150121417,
					"content": "참, 괜찮다면 내일 같이 트라졸리에게 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121418
					],
					"speakerTitle": "쉐븐"
				},
				{
					"id": 150121418,
					"content": "네가 도와준 덕분에 도적들에게 수정을 빼앗기지 않았잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121419
					],
					"speakerTitle": "쉐븐"
				},
				{
					"id": 150121419,
					"content": "이렇게 뜻깊은 수정을 지켜줬으니, 너도 뜻깊은 선물을 받아야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121420,
						150121423
					],
					"speakerTitle": "쉐븐"
				},
				{
					"id": 150121420,
					"content": "네히자가 좋아했으면 좋겠네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121421
					]
				},
				{
					"id": 150121421,
					"content": "응, 기분이 좋아지면 병도 훨씬 빨리 나을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121422
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150121422,
					"content": "물론, 그… 작은 선물이라도 받으면 우리도 기분이 무척 좋아질 거고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121426
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150121426,
					"content": "하하하, 안심해. 분명 너희 마음에 들 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121427
					],
					"speakerTitle": "쉐븐"
				},
				{
					"id": 150121427,
					"content": "선물이 뭔지는… 내일 트라졸리에게 직접 들어 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쉐븐"
				},
				{
					"id": 150121423,
					"content": "설마 고대 이름을?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121424
					]
				},
				{
					"id": 150121424,
					"content": "고대 이름은 이미 하나 있잖아? 하나면 충분하다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121425
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150121425,
					"content": "우린… 약~간의 평범한 선물이면 돼, 헤헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121426
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150121413,
					"content": "확실히 쉽게 포기할 수 없는 수정이었네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121414
					]
				}
			]
		}
	]
}