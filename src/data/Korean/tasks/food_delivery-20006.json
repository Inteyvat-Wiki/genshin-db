			"dialogs": [
				{
					"id": 200060201,
					"content": "고마워, 이 슬라임들 진짜 짜증 나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060202
					],
					"speakerTitle": "활기찬 오를레앙"
				},
				{
					"id": 200060202,
					"content": "배고파서 힘이 없는 것만 아니었으면, 저 녀석들을…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060203
					],
					"speakerTitle": "활기찬 오를레앙"
				},
				{
					"id": 200060203,
					"content": "주문하신 요리 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060204
					]
				},
				{
					"id": 200060204,
					"content": "음——당근과 고기 냄새… 진작 먹었다면 슬라임들은 벌써 나한테 아작 났을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060205
					],
					"speakerTitle": "활기찬 오를레앙"
				},
				{
					"id": 200060205,
					"content": "어쨌든. 이건 식사비야. 사라 아가씨에게 가져다줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "활기찬 오를레앙"
				}
