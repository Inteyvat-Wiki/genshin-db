			"dialogs": [
				{
					"id": 200060101,
					"content": "식사 배달 주문",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060102
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200060102,
					"content": "디어 헌터에 오신 걸 환영… 여행자? 마침 잘 왔어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060103
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200060103,
					"content": "미안해요, 배고프겠지만 나 좀 도와줄래요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060104
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200060104,
					"content": "샘물 마을의 오를레앙 씨가 <color=#00E1FFFF>허니캐럿그릴</color> 1인분을 주문했어요. 근데 최근 샘물 마을에 슬라임이 출몰한다고 들어서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060105
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200060105,
					"content": "난 도저히 못 가겠어요…. 음식을 <color=#00E1FFFF>샘물 마을의 오를레앙</color> 씨에게 가져다주실래요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060106,
						200060107
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200060106,
					"content": "알겠어요. 근데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060108
					]
				},
				{
					"id": 200060108,
					"content": "돌아오면 한 상 거하게 차려줄게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060109
					],
					"speakerTitle": "사라"
				},
				{
					"id": 200060109,
					"content": "부탁 좀 할게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사라"
				},
				{
					"id": 200060107,
					"content": "너무 배고파요. 난 그냥 밥 먹으러 온 건데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060110
					]
				},
				{
					"id": 200060110,
					"content": "부탁을 들어주면, 내, 내가 디어 헌터의 스페셜 요리를 대접할게요. 제발 도와주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사라"
				}
			]
		},
