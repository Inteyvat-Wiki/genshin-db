					}
				]
			},
			"dialogs": [
				{
					"id": 790750301,
					"content": "후아… 바람이 드디어 바람이 멈췄네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750302,
						790750303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790750302,
					"content": "우리 얘길 들어줘",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750304
					]
				},
				{
					"id": 790750304,
					"content": "그래, 들어줄게. 하지만 그 전에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750305
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750305,
					"content": "놀란 표정을 보니, 분명 「어떻게 꽃이 말을 하지」라고 묻고 싶은 거겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750306
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750306,
					"content": "아니면 「어쩌다 꽃으로 변했냐」든가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750307
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750307,
					"content": "많이들 물어보나 봐?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750308
					]
				},
				{
					"id": 790750308,
					"content": "밖에 있을 땐 많이 물어봤어. 집에 돌아온 후론… 아무도 안 물어보지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750309
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750309,
					"content": "「밖」이라는 건 바깥세상을 말하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790750310,
					"content": "먼 여행을 다녀온 후로 이렇게 됐다고 들었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750311
					]
				},
				{
					"id": 790750311,
					"content": "잘 알아보고 왔구나? 파뉴엘이 알려준 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750312
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750312,
					"content": "맞아. 난 먼 여행을 갔다가 이렇게 변했어. 후후, 로젤 그 녀석의 말을 빌리자면… 이건 내가 자발적으로 이뤄낸 「변화」겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750313
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750313,
					"content": "변화까지는 알겠는데, 왜 하필 꽃으로 변한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750314,
						790750315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790750314,
					"content": "혹시 식물을 너무 좋아해서 그런 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750316,
					"content": "아니, 난 그냥… 내 「자리」를 찾고 싶었을 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750317
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750317,
					"content": "난 이 세계 밖에서 많은 사람을 만났어. 요리사도 있었고, 원예사도 있었고, 선생님도 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750318
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750318,
					"content": "거의 모두가 스스로 안심할 수 있는 「자리」를 찾아냈어. 그래야만 삶 속에서 자립할 수 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750319
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750319,
					"content": "그런데 나는? 난 멀리 여행할 줄이나 알지, 안정적인 자신의 「자리」를 찾는다는 생각은 해본 적이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750320
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750320,
					"content": "이 「화분」이 네 「자리」구나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750321
					]
				},
				{
					"id": 790750321,
					"content": "맞아, 이해가 빠르네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750322
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750322,
					"content": "화분 속의 꽃이 되면, 난 언제든 안심할 수 있는 자신의 「자리」를 가진 게 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750323
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750323,
					"content": "그렇지만… 휴, 이제 나만의 「자리」가 생겼는데, 난 왜 여행을 떠나야 할까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750324
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750324,
					"content": "하지만 난 모험객이기도 해. 먼 여행을 떠나지 않으면 내게 무슨 가치가 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750325
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750325,
					"content": "모르겠어. 바깥세상을 알면 알수록… 「자리」와 「먼 여행」 중 대체 뭐가 더 중요한지 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750326
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750326,
					"content": "생각할수록 머리만 아파… 그래서 파뉴엘이랑 얘기할 때도 제대로 대답을 못 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750327
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750327,
					"content": "파뉴엘이 잘못된 생각을 하게 될까 봐 무서워. 원래 먼 여행을 좋아했는데 내 모습을 보고 싫어지면 어떡해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750328
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750328,
					"content": "하지만 파뉴엘은 내 영원히 내 친구야. 난 파뉴엘에게 솔직해야 해서, 물어보는 모든 질문에 대답했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750329
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750329,
					"content": "내가… 꽃으로 변한 이유가 안심할 수 있는 자신의 「자리」를 원하기 때문이란 것까지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750330
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750330,
					"content": "어쩌면 파뉴엘은 내 대답 때문에 슬프거나…. 아니면 지금 내 모습이 싫어졌을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750331
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750331,
					"content": "우린 점점 멀어질 거야. 하지만 화분 속 꽃인 나는 직접 걸어 올라갈 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750332
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750332,
					"content": "하지만 괜찮아. 파뉴엘도 내가 보기 싫을 테니까. 분명 나한테 화나 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750333
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750333,
					"content": "아… 그랬구나. 너희는 서로 「나한테 화나 있을 거」라고 생각하고 있었던 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750334
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790750334,
					"content": "그래서 상대를 안 만난 거였어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750335
					]
				},
				{
					"id": 790750335,
					"content": "뭐? 그, 그러니까, 파뉴엘이 나한테 화가 난 게 아니라는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750336,
						790750337
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750336,
					"content": "둘이 지금 똑같은 생각을 하고 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750338,
					"content": "파뉴엘의 생각을 쇼비네에게 모두 알려준다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790750339
					]
				},
				{
					"id": 790750339,
					"content": "세상에, 난 그렇게 생각한 적 없어. 난 파뉴엘의 입꼬리가 조금만 아래로 내려가도 마음이 무너진단 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750340
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750340,
					"content": "부탁할게! 날 데리고 올라가 줘. 빨리 파뉴엘을 만나야겠어! 1분 1초도 못 기다려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750341
					],
					"speakerTitle": "쇼비네"
				},
				{
					"id": 790750341,
					"content": "그 말만 기다렸어, 친구",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750342
					]
				},
				{
					"id": 790750342,
					"content": "#히히, 그 말만 기다렸다구. 바로 출발하자! {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790750337,
					"content": "파뉴엘은 네가 화난 줄 알아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750315,
					"content": "식물학자가 되는 게 꿈이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750303,
					"content": "파뉴엘이 할 말이 있대",
