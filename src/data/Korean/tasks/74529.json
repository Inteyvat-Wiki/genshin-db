			"dialogs": [
				{
					"id": 745290401,
					"content": "#오, {NICKNAME}. 왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290402,
						745290403
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 745290402,
					"content": "시틀라리, 오랜만이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				},
				{
					"id": 745290404,
					"content": "말이 섭섭하네, 이 할머니도 가끔 산책하러 나오거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290405
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 745290405,
					"content": "그리고 어젯밤 점괘에서, 밖에 나가면 좋은 일이 생긴다고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290406
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 745290406,
					"content": "봐, 이렇게 집 밖을 나서자마자 좋은 일이 생겼잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290407,
						745290408
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 745290407,
					"content": "그럼 좋은 일이 두 배로 되게 해줄게!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290409,
					"content": "안 될 건 없는데, 얼마 전에 최신 라이트 노벨 보느라고 밤을 새웠거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290410
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 745290410,
					"content": "봐봐, 지금 나 어때? 다크서클 좀 가라앉았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290411,
						745290412
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 745290411,
					"content": "평소처럼 기운 넘쳐 보여",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290413,
					"content": "정말? 거짓말하면 안 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290414
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 745290414,
					"content": "미리 말해두는데, 사진이 예쁘게 안 나오면 내가 다 가져가 버릴 거야… 제일 예쁜 사진만 남겨줄 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 745290412,
					"content": "반짝반짝 빛나고 있어!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290408,
					"content": "사진을 찍게 해줘!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290403,
					"content": "웬일로 집에서 낮잠을 안 자고 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				}
			]
		}
	]
