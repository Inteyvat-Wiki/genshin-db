			"dialogs": [
				{
					"id": 700100201,
					"content": "의뢰에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100202
					]
				},
				{
					"id": 700100202,
					"content": "무슨 일이야, 부탁한 일은 다 끝낸 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100203
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 700100203,
					"content": "다 끝냈어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100204
					]
				},
				{
					"id": 700100204,
					"content": "수고했어. 그 녀석한테 줄 물건을 포장해놨는데 한번 다녀와 줄래? 전해주고 다시 돌아오는 거 잊지 마. 보수는 그때 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100205
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 700100205,
					"content": "이걸로 충분할지는 모르겠지만, 신인 모집하는 데에 마물 기록과 광석이라면 분명 사람들이 몰려들겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "옥희"
				}
			]
		},
		{
			"id": 7001003,
			"completionStepIds": [
				7001009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
