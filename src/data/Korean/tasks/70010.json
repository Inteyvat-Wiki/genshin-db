				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"사이러스"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100301,
					"content": "휴, 모집 계획도 소용없나 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100302
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 700100302,
					"content": "옥희가 보낸 물건에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100303
					]
				},
				{
					"id": 700100303,
					"content": "어, 누나가 보냈다고? 아, 그랬지… 저번에 부탁해놓고 바빠서 잊어버렸네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100304
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 700100304,
					"content": "윈드블룸 축제를 즐기느라 바쁜 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100305
					]
				},
				{
					"id": 700100305,
					"content": "윈드블룸 축제? 전에 세워놨던 모집 계획이 다 무용지물이 돼서 새로 짜느라 바쁜걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100306
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 700100306,
					"content": "우선 누나가 뭘 보냈는지부터 볼까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100307
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 700100307,
					"content": "광석… 필요 없어… 요즘 광석 좋아하는 젊은 사람이 어딨어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100308
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 700100308,
					"content": "지형도… 휴, 길드 사람이라면 필요할지 몰라도 모집할 땐 아무도 거들떠보지도 않을 테지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100309
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 700100309,
					"content": "마물 조사 노트… 이건 몇 권 베껴서 길드 모험가한테나 줘야겠군… 모집할 땐 쓸모 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100310
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 700100310,
					"content": "어? 이 사진, 이 사진 괜찮은데? 경치도 좋고 위험해 보이지도 않고, 분명 관심 갖는 사람이 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100311
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 700100311,
					"content": "그걸 고른 이유가 뭐죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100312
					]
				},
				{
					"id": 700100312,
					"content": "뭔가 모험가랑 관련 있는 물건은 다 빠진 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700100313,
					"content": "네가 길드 상황을 모르나 본데, 요즘 젊은 사람들은 마물이라든가 광석, 지형도 같은 물건엔 관심 없다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100314
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 700100314,
					"content": "사람들의 관심을 끌려면 좀 더… 「현실」적인 물건이 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100315
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 700100315,
					"content": "지금이 윈드블룸 축제 기간이잖아. 분명 젊은 사람들은 특별하지만 위험하지 않은 방식으로 매력을 뽐내고 싶어 할 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100316
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 700100316,
					"content": "설산 탐험 같은 걸로 말이지. 누군가 관심 갖고 물어보러 오면 길드에 가입시킬 수 있을지도 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100317
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 700100317,
					"content": "휴, 그래도 길드에 가입하기 싫다고 하면… 우리한테 의뢰라도 맡겨줬으면 좋겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100319
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 700100319,
					"content": "게다가 사진 찍은 곳이 다 큰길 옆이라 조금만 조심하면 위험할 일은 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100320
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 700100320,
					"content": "그렇게까지 해야 하나요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100321
					]
				},
				{
					"id": 700100321,
					"content": "상황이 그런 걸 어떡해. 그게 아니라면 나도 이렇게까진 안 했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100322
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 700100322,
					"content": "휴, 그래도 못 믿겠다면 이 사진들 갖고 주변 사람들한테 가서 물어봐봐",
					"roleType": "TALK_ROLE_NPC",
