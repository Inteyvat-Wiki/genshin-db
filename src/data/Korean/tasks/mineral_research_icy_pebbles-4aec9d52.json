			"dialogs": [
				{
					"id": 761970120,
					"content": "(test)대본",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						761970101
					]
				},
				{
					"id": 761970101,
					"content": "예전에 바다를 떠돌 때, 어디선가 들려오는 부름을 들은 적이 있었어. 다른 사람들은 아무렇지 않아 했지만, 난 금세 그 소리에 홀리고 말았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970102
					],
					"speakerTitle": "빌야미"
				},
				{
					"id": 761970102,
					"content": "그건 이세계의 소리가 분명해요. 저도 들은 적이 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970103
					],
					"speakerTitle": "아우니"
				},
				{
					"id": 761970103,
					"content": "나중에야 그 부름에는 피안에 닿지 못한 모든 꿈이 담겨 있다는 것을 깨달았지. 원념의 집합체라고도 할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970104
					],
					"speakerTitle": "빌야미"
				},
				{
					"id": 761970104,
					"content": "냉기석을 챙기셨어야죠. 가운데의 구멍으로 들여다보면 누가 부른 건지 볼 수 있었을걸요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970105
					],
					"speakerTitle": "아우니"
				},
				{
					"id": 761970105,
					"content": "하지만 그때의 난 혈기 왕성한 풋내기였단다. 위험한 상황도 그저 기회라고만 생각해서 무작정 뛰어들었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970106
					],
					"speakerTitle": "빌야미"
				},
				{
					"id": 761970106,
					"content": "냉기석 가운데의 구멍이 이세계로 통하는 문이라고 들었어요…. 근데 어떻게 통과해야 할까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970107
					],
					"speakerTitle": "아우니"
				},
				{
					"id": 761970107,
					"content": "그 후에는… 바다의 풍랑이 나의 재산과 명예, 그리고 가족을 앗아가 버렸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970108
					],
					"speakerTitle": "빌야미"
				},
				{
					"id": 761970108,
					"content": "야심과 욕망에 이끌린 모험은 결코 좋은 결말을 맺지 못하는 법이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970109
					],
					"speakerTitle": "빌야미"
				},
				{
					"id": 761970109,
					"content": "아, 끼어버렸다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970110
					],
					"speakerTitle": "아우니"
				},
				{
					"id": 761970110,
					"content": "내가 빼줄게. 다음부턴 이러면 안 된다?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970111
					],
					"speakerTitle": "린네아"
				},
				{
					"id": 761970111,
					"content": "린네아 언니, 웬일로 돌아왔네요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970112
					],
					"speakerTitle": "아우니"
				},
				{
					"id": 761970112,
					"content": "이 근처에 냉기석을 수집하러 왔다가 얘기하는 걸 보고 인사나 하러 왔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970113
					],
					"speakerTitle": "린네아"
				},
				{
					"id": 761970113,
					"content": "참, 린네아 언니라면 정말로 냉기석을 써서 이세계로 통하는 문을 열 수 있을지도 몰라요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970114
					],
					"speakerTitle": "아우니"
				},
				{
					"id": 761970114,
					"content": "아무리 나라도 그건 무리야. 전에도 말했잖아? 그건 그냥 그럴싸하게 꾸며낸 민간 전설이라고. 믿을 만한 근거는 전혀 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970115
					],
					"speakerTitle": "린네아"
				},
				{
					"id": 761970115,
					"content": "안 되는 거였나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970116
					],
					"speakerTitle": "빌야미"
				},
				{
					"id": 761970116,
					"content": "듣고 계셨군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970117
					],
					"speakerTitle": "린네아"
				},
				{
					"id": 761970117,
					"content": "크흠… 아니, 난 더 이상 과거의 내가 아니야. 지금의 난 만족할 줄 알아서 더 바라는 것도 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970118
					],
					"speakerTitle": "빌야미"
				},
				{
					"id": 761970118,
					"content": "그렇군요. 정말 아쉽네요. 그럼 저도 린네아 언니를 도와 냉기석을 수집할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970119
					],
					"speakerTitle": "아우니"
				},
				{
					"id": 761970119,
					"content": "좋아, 그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970124
					],
					"speakerTitle": "린네아"
				},
				{
					"id": 761970124,
					"content": "아우니의 도움으로 빠르게 수집을 끝냈다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761970122
					]
				},
				{
					"id": 761970122,
					"content": "고마워, 하지만 이미 다 수집했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970123
					],
					"speakerTitle": "린네아"
				},
				{
					"id": 761970123,
					"content": "알겠어요. 그럼 전 몰리 할아버지를 만나러 몰리 계곡으로 갈게요. 잘 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아우니"
				}
			]
		},
