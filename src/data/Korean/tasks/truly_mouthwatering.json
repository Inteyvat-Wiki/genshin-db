						],
						"pointId": 6136
					}
				]
			},
			"dialogs": [
				{
					"id": 741210801,
					"content": "자유다! 아아, 자유는 참으로 달콤하구나! 닭 요리만큼은 아니지만 그래도 달아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210802
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210802,
					"content": "…그래서, 네 손에 든 그건 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210803
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210803,
					"content": "아, 이거? 「항의」란 뜻이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210804
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210804,
					"content": "무슨 항의를 하시는 건데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210805
					]
				},
				{
					"id": 741210805,
					"content": "음, 뭐랄까… 그 사람들, 그러니까 날 땅에 파묻은 사람들은 내가 열심히 일하는 걸 원하지 않아. 그래서 항의하는 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210806
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210806,
					"content": "이상하네, 왜 네가 열심히 일하는 걸 원하지 않는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210807
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210807,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210808
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210808,
					"content": "비밀 지켜줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210809
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210809,
					"content": "응! 당연하지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210810
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210810,
					"content": "그런 말은 나도 해. 이게 얼마나 말하기 힘든지 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210811
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210811,
					"content": "뜸 들이지 마! 대체 뭔데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210812
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210812,
					"content": "그냥 다른 얘기 하자…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210813
					]
				},
				{
					"id": 741210813,
					"content": "알겠어…. 그럼 이 통은 또 뭐야? 이것도 일종의 항의 방식이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210814
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210814,
					"content": "응? 그건 나도 몰라…. 그 사람들이 날 파묻기 전에 이 통을 씌웠어. 정말 악취미라니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210815
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210815,
					"content": "넌 어쩌다 그 사람들한테 파묻히게 된 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210816
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210816,
					"content": "녀석들이 나쁜 놈들이니까! 이유 없이 날 잡아들여서 묻어버렸어! 날 죽이려던 거라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210817
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210817,
					"content": "정말 이유가 없었던 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210818
					]
				},
				{
					"id": 741210818,
					"content": "다, 당연하지! 날 땅에 묻었다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210819
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210819,
					"content": "날 죽이려던 게 아니면 왜 이런 짓을 했겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210820
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210820,
					"content": "#음, 나름 일리 있는 것 같은데… {NICKNAME}, 어떻게 생각해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		}
