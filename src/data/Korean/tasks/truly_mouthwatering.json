			"dialogs": [
				{
					"id": 741210101,
					"content": "고마워! 정말 고마워! 너희는 내 은인이야. 영원히 이 은혜를 잊지 않을게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210102
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210102,
					"content": "그보다 넌 어쩌다 이렇게 된 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210103,
					"content": "아, 그 꽃게들이 닭 요리 냄새에 이끌려온 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210104
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210104,
					"content": "나도 닭 요리 냄새에 이끌려온 거긴 한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210105,
					"content": "꽃게들은 너랑 달라! 먼저 날 먹을지 닭 요리를 먹을지 고민하는 것 같았다니까? 그러다 더 신선한 걸 먹기로 한 거고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210106,
						741210109
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210106,
					"content": "일리 있네요. 신선한 게 좋죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210107
					]
				},
				{
					"id": 741210107,
					"content": "아니, 너 말이야! 왜 땅에 파묻힌 거냐고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210108,
					"content": "도움이 필요해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210111,
					"content": "당연하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210112
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210112,
					"content": "앗, 아니!! 다시 파낼 필요 없어!!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210113
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210113,
					"content": "#으악, 알았어, 알았다고. 그렇게 소리 지르지 마! 이만 가자, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210114,
					"content": "잠깐, 조금만 기다려줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210115
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210115,
					"content": "뭐? 왜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210116,
					"content": "나… 으, 흠흠! 이건 그거야!! 잘 들어!! 이건 새로 개발한 미용법이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210117
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210117,
					"content": "시끄러워! 소리 지르지 말라니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210118,
					"content": "의심하지 말아줘!! 난 정신이 멀쩡한 사람이라 이런 과학적이고 건강한 미용법을 택한 거라고!! 내 힘으로 직접 축축한 모래에 들어온 거야!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210119
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210119,
					"content": "그러니 햇빛 막지 말고 빨리 떠나줘!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210120
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210120,
					"content": "어, 그럼 우리 진짜 간다…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210121,
					"content": "그렇게까지 궁금하다면 어쩔 수 없지!!! 이 미용법의 훌륭한 점을 알려줄게!! 음, 모래 속의 갯지렁이 같은 생물이 미용에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210122
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210122,
					"content": "#(으아, 시끄러워. {NICKNAME}, 뭐가 문제인 걸까? 말이 두서가 없어…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210123,
					"content": "(수상한데…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210124
					]
				},
				{
					"id": 741210124,
					"content": "(그래? 뭔가 떠오른 게 있는 거야?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210125,
					"content": "(일단 주변 상황을 살펴보자)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210126
					]
				},
				{
					"id": 741210126,
					"content": "앗, 벌써 가려고…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210127
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210127,
					"content": "주변 좀 둘러보고 다시 올게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210128,
					"content": "그래!!! 빨리 가버려!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210109,
					"content": "왜 땅속에 묻혔는지가 더 궁금한데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210110
					]
				},
				{
					"id": 741210110,
					"content": "맞아! 우리 도움이 필요한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "페이몬"
				}
			]
