			"dialogs": [
				{
					"id": 741210601,
					"content": "흠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210602
					],
					"speakerTitle": "테너"
				},
				{
					"id": 741210602,
					"content": "으아… 난 아무것도… 이건 최신 미용법…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210603
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210603,
					"content": "앗, 대체 언제 온 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210604,
					"content": "산책 중입니다. 산책은… 일종의 운동이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210605
					],
					"speakerTitle": "헌트"
				},
				{
					"id": 741210605,
					"content": "운동이란 이동을 동반하지. 이동이 우릴 여기로 데려온 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210606
					],
					"speakerTitle": "테너"
				},
				{
					"id": 741210606,
					"content": "두 분 짓인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210607
					]
				},
				{
					"id": 741210607,
					"content": "그렇다고 한다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210608
					],
					"speakerTitle": "헌트"
				},
				{
					"id": 741210608,
					"content": "헌트, 생각났어. 이 사람을 자세히 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210609
					],
					"speakerTitle": "테너"
				},
				{
					"id": 741210609,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210610
					],
					"speakerTitle": "헌트"
				},
				{
					"id": 741210610,
					"content": "그가 말한 사람이군요. 절대 엮이면 안 되는",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210611
					],
					"speakerTitle": "헌트"
				},
				{
					"id": 741210611,
					"content": "맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210612
					],
					"speakerTitle": "테너"
				},
				{
					"id": 741210612,
					"content": "그게 무슨 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210613
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210613,
					"content": "아무것도 아닙니다. 우린 그저 산책 중이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210614
					],
					"speakerTitle": "헌트"
				},
				{
					"id": 741210614,
					"content": "맞아, 산책 중이야. 다른 볼일 없으면 우린 이만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210615
					],
					"speakerTitle": "테너"
				},
				{
					"id": 741210615,
					"content": "다른 곳으로 산책하러 가보겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210616
					],
					"speakerTitle": "헌트"
				},
				{
					"id": 741210616,
					"content": "어라? 나한테 무서운 짓 안 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210617
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210617,
					"content": "교훈은 충분할 테니까. 내 말을 알아들었다면 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210618
					],
					"speakerTitle": "테너"
				},
				{
					"id": 741210618,
					"content": "교훈이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210619
					]
				},
				{
					"id": 741210619,
					"content": "별거 아냐. 닭 요리는 이상한 걸 불러들일 수 있다는 교훈을 말한 거였어. 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210620
					],
					"speakerTitle": "테너"
				},
				{
					"id": 741210620,
					"content": "하지만 닭 요리는… 드보르 호…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210621
					],
					"speakerTitle": "헌트"
				},
				{
					"id": 741210621,
					"content": "닭 요리는 됐다고! 이만 계속 산책이나 하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210622
					],
					"speakerTitle": "테너"
				},
				{
					"id": 741210622,
					"content": "「다음에 또 소니 형님께 닭 요리를 사달라고 해야겠네」\\n테너가 중얼거리며 헌터와 함께 자리를 뜬다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741210623
					]
				},
				{
					"id": 741210623,
					"content": "너희 둘! 정말 고마워! 내 뜻을 이해해 줄 거라 믿고 있었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210624
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210624,
					"content": "#{NICKNAME} 네 말이 맞았네…. 이제 엔리를 꺼내주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210625
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210625,
					"content": "근데 이건 체력이 많이 필요한 작업이니까 닭 요리는 우리가 먹을게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210626
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741210626,
					"content": "뭐? 쳇… 어쩔 수 없지. 알겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210627
					],
					"speakerTitle": "엔리"
				},
				{
					"id": 741210627,
					"content": "시간을 들여 엔리를 땅속에서 파낸 뒤, 어째서인지 그의 몸에 씌워져 있던 통을 빼줬다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741210628
					]
				},
				{
					"id": 741210628,
					"content": "페이몬과 함께 맛있는 닭 요리를 먹기 시작했다.\\n엔리도 먹고 싶은 듯했지만, 그는 약속과 존엄을 지켜냈다.\\n그런 그의 모습을 본 페이몬은 그에게 닭 요리를 나눠줬다.\\n쫄깃쫄깃한 닭 요리는 먹음직스러운 냄새를 풍겼다. 정말 맛있었다!",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
