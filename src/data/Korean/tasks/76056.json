				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"테르호"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560401,
					"content": "죄송합니다, 형님…. 제가 우리 체면을 구겼네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560402
					],
					"speakerTitle": "비엘로프"
				},
				{
					"id": 760560402,
					"content": "에이, 그냥 시간 때우려고 한 건데 져도 돼. 비엘로프, 옆에서 쉬고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560403
					],
					"speakerTitle": "테르호"
				},
				{
					"id": 760560403,
					"content": "이봐, 몸놀림이 상당히 괜찮던데! 내 이름은 테르호야. 만나서 반가워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560404
					],
					"speakerTitle": "테르호"
				},
				{
					"id": 760560404,
					"content": "#전 {NICKNAME}(이)라고 해요. 반갑습니다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560405
					]
				},
				{
					"id": 760560405,
					"content": "딱 보니 실전 경험이 많은 고수인 것 같은데 조금 진지하게 임해야겠어. 아까 건 무효야. 한 번 더 겨루자! 인켈리, 네 차례야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560406
					],
					"speakerTitle": "테르호"
				},
				{
					"id": 760560406,
					"content": "형님은 항상 곤란할 때만 절 찾으시네요…. 정말 못 말린다니까. 그럼 고수님, 시작해 보죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "인켈리"
				}
			]
		},
		{
			"id": 7605605,
			"completionStepIds": [
				7605603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
