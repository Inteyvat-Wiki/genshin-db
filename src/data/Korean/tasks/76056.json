					"테르호"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560501,
					"content": "내, 내가 지다니…. 그냥 행인한테 졌어…. 이, 이게 어떻게 가능해?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560502
					],
					"speakerTitle": "인켈리"
				},
				{
					"id": 760560502,
					"content": "음, 인켈리를 이기다니…. 내가 너무 얕잡아봤구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560503
					],
					"speakerTitle": "테르호"
				},
				{
					"id": 760560503,
					"content": "형님 잘못이 아니에요. 이렇게 강한 상대가 여길 지나갈 줄 누가 알았겠어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560504
					],
					"speakerTitle": "비엘로프"
				},
				{
					"id": 760560504,
					"content": "형님! 얘들을 그냥 보내면 안 돼요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560505
					],
					"speakerTitle": "인켈리"
				},
				{
					"id": 760560505,
					"content": "음? 싸우려던 게 아니었나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560506
					]
				},
				{
					"id": 760560506,
					"content": "오해하지 마. 인켈리는 이대로 패배를 인정할 수 없단 뜻이니까. 우리도 어느 정도 체면이 있는 보물 사냥꾼이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560507
					],
					"speakerTitle": "테르호"
				},
				{
					"id": 760560507,
					"content": "#{NICKNAME}, 정식으로 도전을 신청할게. 이번엔 겨루기가 아니라 진짜 실력으로 붙어보는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560508
					],
					"speakerTitle": "테르호"
				},
				{
					"id": 760560508,
					"content": "그럼 한꺼번에 와주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560509
					]
				},
				{
					"id": 760560509,
					"content": "좋아, 그럼 사양하지 않지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "테르호"
				}
			]
		},
		{
