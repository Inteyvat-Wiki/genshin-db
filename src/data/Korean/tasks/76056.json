					"테르호"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560301,
					"content": "죄송하지만 다른 일이 있어서…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560302
					]
				},
				{
					"id": 760560302,
					"content": "괜찮아. 어차피 우린 여기서 시간을 때우고 있을 뿐이니까. 나중에 시간 남아돌 때 다시 와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "테르호"
				}
			]
		},
		{
			"id": 7605604,
			"completionStepIds": [
				7605602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605602",
							"2"
