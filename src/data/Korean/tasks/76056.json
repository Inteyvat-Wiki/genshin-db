				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"테르호"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560201,
					"content": "두 판이 아니라 세 판도 문제없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560202
					]
				},
				{
					"id": 760560202,
					"content": "하하, 통쾌하네! 역시 사람 간의 대결이 재밌다니까! 비엘로프, 네가 먼저 이 친구랑 겨뤄볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560205
					],
					"speakerTitle": "테르호"
				},
				{
					"id": 760560205,
					"content": "네, 형님! 단번에 승기를 잡을게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "비엘로프"
				}
			]
		},
		{
			"id": 7605603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
