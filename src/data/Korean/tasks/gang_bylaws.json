			"dialogs": [
				{
					"id": 191430901,
					"content": "방금 온천탕에서 청소하고 있는데 밖에서 싸우는 소리가 들렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430902
					],
					"speakerTitle": "아이카와 스스무"
				},
				{
					"id": 191430902,
					"content": "밖으로 나오자마자… <color=#00E1FFFF>검은 그림자 하나가 갑자기 나무 밑에서 튀어나왔지 뭐야!</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430903
					],
					"speakerTitle": "아이카와 스스무"
				},
				{
					"id": 191430903,
					"content": "여긴 오가는 사람도 많은데, 도둑이나 강도는 아니겠지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
