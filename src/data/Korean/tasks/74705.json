			"dialogs": [
				{
					"id": 747050101,
					"content": "…이 물고기인 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050102
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 747050102,
					"content": "음, 일리 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050103
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 747050103,
					"content": "왜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050104
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 747050104,
					"content": "이 꼬리 색을 봐. 이 수족관에 얘만큼 트렌디한 녀석은 없을걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050105
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 747050105,
					"content": "색이 좀 요란하긴 하지만, 뭐 좋아. 칭찬으로 받아들일게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050106
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 747050106,
					"content": "우와! 사람 엄청 많네! 다들 수족관 구경하러 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 747050107,
					"content": "응, 방금 촬영을 마치고 쉬는 시간에 잠깐 들렀어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050108
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 747050108,
					"content": "방금 무슨 얘기 하고 있었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 747050109,
					"content": "어떤 물고기가 치오리랑 닮았는지 얘기 중이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050110
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 747050110,
					"content": "너희도…?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 747050111,
					"content": "아… 하하, 전에 수다 떨다가 콜롬비나가 이 얘기를 하더라고. 재밌어 보여서 우리도 따라 해봤지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050112
					],
					"speakerTitle": "푸리나"
				},
				{
					"id": 747050112,
					"content": "이런 게 전염될 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 747050113,
					"content": "응? 저건 너 닮았다, 슈브르즈",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050114
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 747050114,
					"content": "어떤 점에서?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050115
					],
					"speakerTitle": "슈브르즈"
				},
				{
					"id": 747050115,
					"content": "한가해지니까 수조를 빙빙 돌면서 운동하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050116
					],
					"speakerTitle": "치오리"
				},
				{
					"id": 747050116,
					"content": "…내가 너한테 그런 이미지인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "슈브르즈"
				}
			]
		}
	]
