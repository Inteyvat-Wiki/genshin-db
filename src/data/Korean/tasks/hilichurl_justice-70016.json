					"nextDialogs": [
						700160110
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700160110,
					"content": "걔가 적을 처치할 수 있게 도와주면 돼. 그럼 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160111
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700160111,
					"content": "Dada, Valo!",
