					"nextDialogs": [
						700160103
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700160103,
					"content": "Mita…? Gusha… Dada ika odomu Plata mimi, mimi mosi gusha…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160104
					],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 700160104,
					"content": "Mimi tomo, mimi plata yaya ika! Mimi mani ye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160105
					],
					"speakerTitle": "엘라·머스크"
				},
				{
					"id": 700160105,
					"content": "Mani…? Dada! Kundala zido mi, mi dada, mimi tomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160106
					],
					"speakerTitle": "츄츄족"
				},
				{
					"id": 700160106,
					"content": "대화가 즐거워 보이네…",
