			"trigger": {
				"objectNames": [
					"클레"
				],
				"points": [
					{
						"sceneId": 51205,
						"position": [
							2198.146,
							230.219,
							-780.029
						],
						"pointId": 1
					},
					{
						"sceneId": 51205,
						"position": [
							2198.069,
							230.089,
							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500101,
					"content": "#어? 어라라? 명예 기사 {M#오빠}{F#언니}? 와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500102,
						705500103
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500102,
					"content": "와! 클레다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				},
				{
					"id": 705500104,
					"content": "히히, 유라 언니가 그랬어. 헤르타 이모가 대단한 조수를 데려왔다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500105
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500105,
					"content": "#명예 기사 {M#오빠}{F#언니}가 있으니까, 여기는 티바트에서 최고로 대단한 음료 가게일 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500106,
						705500107
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500106,
					"content": "고마워 클레, 꼭 최고가 될게!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500108,
					"content": "어… 아직 아닌 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500109
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500109,
					"content": "그럼… 클레가 가본 음료 가게 중에 최고로 대단한 가게야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500110
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500110,
					"content": "#명예 기사 {M#오빠}{F#언니}가 만든 음료라면 클레는 다 맛있으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500111,
						705500112
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500111,
					"content": "이번엔 좀 더 엄격하게 봐줘!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500113,
					"content": "어… 어? 정말? 하지만 클레는 명예 기사한테 엄격한 거 못 하는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500114
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500114,
					"content": "음… 그럼 알베도 오빠를 따라 해볼게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500115
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500115,
					"content": "알베도 오빠가 데마로우스 삼촌의 숙제를 봐줄 때 진짜 진지했거든! 클레가 한마디도 안 놓치고 다 들어놨어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500116,
						705500117
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500116,
					"content": "좋아 좋아! 클레가 선생님이 되어줘!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500118,
					"content": "히… 그럼 클레가 멋지게 주문해 볼게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500119
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500119,
					"content": "조금 있다가 클레랑 엄마랑 같이 물고기 폭파하러 가기로 했어. 진 단장님한테는 비밀이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500120
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500120,
					"content": "오늘 클레랑 엄마랑 물고기를 엄청 많이 폭파했어…. 진 단장님한테는 비밀이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500121
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500121,
					"content": "요 며칠 동안 클레랑 엄마랑 되게되게 많이 놀았어! 엄청 신나! 감금실에 갇혀도 상관없을 만큼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500122
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500122,
					"content": "그러니까 클레, 「좋은 날씨」를 주문할래——하늘도 맑고 햇살도 따뜻하면 기분 좋으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500123,
						705500124
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500123,
					"content": "알겠습니다, 클레 선생님!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500125,
					"content": "헤헤, 무슨 맛이 나올까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "클레"
				},
				{
					"id": 705500124,
					"content": "알겠습니다, 클레 연금술사님!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500117,
					"content": "좋아 좋아! 위대한 연금술사 클레네!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500112,
					"content": "부디 마음껏 지적해 줘!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500107,
					"content": "고마워 클레, 실력을 더 키워볼게!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500103,
					"content": "와! 클레가 손님으로 왔다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				}
			]
		},
		{
			"id": 7055002,
			"completionStepIds": [
				7055006
			],
