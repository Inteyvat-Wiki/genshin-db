					},
					{
						"sceneId": 51205,
						"position": [
							2198.069,
							230.089,
							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500201,
					"content": "「좋은 날씨」 나왔습니다. 클레, 한번 마셔봐!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500202
					]
				},
				{
					"id": 705500202,
					"content": "우와, 「좋은 날씨」가 이런 색이었구나? 보라색 하늘… 밝은 밤 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500203,
						705500204
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500203,
					"content": "해가 진 후의 맑은 저녁이랄까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				},
				{
					"id": 705500205,
					"content": "클레가 마셔보고 진지하게 생각해 볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500206
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500206,
					"content": "아, 다 마셨다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500207
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500207,
					"content": "맛있어! 새콤달콤해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500208
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500208,
					"content": "생선구이랑 먹으면, 생선을 몇 마리도 먹을 수 있을 것 같아! 식욕 폭발이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500209
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500209,
					"content": "이걸론 모자란데, 한 잔 더 마시고 싶어… 케이크 같은 음료로!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500210,
						705500211,
						705500212
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500210,
					"content": "아하, 클레는 「액체로 된 디저트」를 원하는 거구나!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500213,
					"content": "#음… 클레 어떤 레시피로 해야 할지 모르겠어. 명예 기사 {M#오빠}{F#언니}랑 같이 생각해 볼래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500214
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500214,
					"content": "클레가 가져온 사탕, 되게 특이하네!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500215
					]
				},
				{
					"id": 705500215,
					"content": "이거? 헤헤… 엄마가 연금 테이블로 만드는 법을 가르쳐줬어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500216
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500216,
					"content": "설탕 잔~뜩에다가, 엄마의 폰타인 친구가 준 꽃, 바르벨로스 이모의 별 꿀, 옥타 이모가 엄마한테 준 마법 잼까지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500217
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500217,
					"content": "재료를 연금 테이블 위에 올려놓고, 모양을 상상하면서 엄마를 따라 주문을 외우면, 「펑~」하고 도도코 모양 사탕이 나타나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500218,
						705500219
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500218,
					"content": "성분도 제작 방식도 굉장하네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500220,
					"content": "#명예 기사 {M#오빠}{F#언니}한테도 도도코 사탕 몇 개 줄게! 마음에 들면 엄마가 외우는 주문도 가르쳐줄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500221
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500221,
					"content": "#그러면 명예 기사 {M#오빠}{F#언니}도 원하는 사탕을 만들 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500222,
						705500223
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500222,
					"content": "멋진 레시피를 알려줘서 고마워, 클레!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500224,
					"content": "헤헤, 모르는 거 생기면 클레한테 물어봐! 마법 사탕에 관한 건 클레가 전문가니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500225
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500225,
					"content": "클레, 오늘 다른 할 일 남았어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500226
					]
				},
				{
					"id": 705500226,
					"content": "응! 엄마가 얼마 전에 대단한 책을 한 권 줬거든. 매일 밤마다 한 장씩 공부하고, 일찍 자야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500227
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500227,
					"content": "클레 그 책으로 「추진제」 만드는 법도 배웠어! 통통 폭탄이 더 「통~」하고 높이 튕기게 만드는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500228,
						705500229
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500228,
					"content": "이… 이런 걸 공부한다고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500230,
					"content": "안 어려워…. 폭탄이랑 비슷한 데가 많아. 크레용 깎듯이 조심히만 다루면 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500231
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500231,
					"content": "잠들기 전 시간도 엄청 중요해! 엄마가 클레 옆에 앉아서 여러 이야기를 들려주거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500232
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500232,
					"content": "엄마가 보석으로 만든 등불? 같은 걸 꺼내면, 그게 「따란~」 하고 빛을 내면서 천장을 비춰",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500233
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500233,
					"content": "천장이 스토리보드가 되는 거네?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500234
					]
				},
				{
					"id": 705500234,
					"content": "응응, 이야기를 따라서 천장의 불빛이 예쁜 그림으로 바뀌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500235
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500235,
					"content": "가끔은 엄마가 이야기를 하다가 먼저 잠들 때도 있어. 그럼 클레가 엄마한테 이불을 덮어줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500236
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500236,
					"content": "#클레가 이 등불 쓰는 법을 배우고 나면, 명예 기사 {M#오빠}{F#언니}한테 이야기를 들려줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500237,
						705500238
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500237,
					"content": "좋아!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500239,
					"content": "헤헤, 이제 클레는 아는 이야기가 엄청 많아서, 모두한테 새로운 즐거움을 줄 수 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500240
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500240,
					"content": "클레, 저녁에도 뭐 먹을 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500241
					]
				},
				{
					"id": 705500241,
					"content": "응! 돌아가면 클레는 책을 읽으면서… 소금 묻힌 견과류를 먹을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500242
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500242,
					"content": "예전에는 저녁 먹고 나서 케이크를 먹었는데, 진 단장님이 케이크는 설탕이 너무 많으니까 자기 전에 먹으면 안 된대. 살도 찌고, 이도 아프다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500243
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500243,
					"content": "그래서 엄마가 바르벨로스 이모 말을 듣고 클레한테 견과류를 줬어. 기억을 더 잘하게 해준대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500244
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500244,
					"content": "견과류는 별맛이 없어서 풀을 씹는 거 같아. 그래도 소금을 뿌리면 먹을 만해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500245
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500245,
					"content": "좋은 방법이네. 영양과 건강은 잘 챙겨야지!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500246
					]
				},
				{
					"id": 705500246,
					"content": "건강하면서도 달콤한 재료가 있는지 찾아볼까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500247
					]
				},
				{
					"id": 705500247,
					"content": "으음…. 그치만 클레는 역시 달달한 게 좋아! 케이크의 크림을 조금 줄여도 돼… 아니면, 과일을 많이 넣든지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500248
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500248,
					"content": "아, 엄마의 안경 쓴 친구가 폰타인 과일도 한 봉지 줬어. 풍선귤이라고, 동글동글한 과일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500249
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500249,
					"content": "되게되게 달아서, 연속으로 몇 개나 먹었어. 진 단장님도 그건 괜찮대! 왜냐하면, 「과일의 단맛은 설탕이랑 다르니까!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500250
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500250,
					"content": "그러니까, 견과류를 꼭 먹어야 할 땐 과일 주스에 담가두면 되지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500251
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500251,
					"content": "그러고 보니, 클레는 보통 하루 세 끼를 어떻게 먹어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500252
					]
				},
				{
					"id": 705500252,
					"content": "세 끼? 흐흥, 클레는 다섯 끼도 먹을 수 있어. 일곱 끼를 먹을 때도 있다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500253
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500253,
					"content": "그렇게나 많이?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500254
					]
				},
				{
					"id": 705500254,
					"content": "모험하려면 체력이 많이 들잖아! 근데 한 번에 너무 배부르게 먹으면 뛰어다니기 힘드니까… 조금씩 여러 번 먹는 게 좋아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500255
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500255,
					"content": "전에는 알베도 오빠가 클레 밥을 챙겨줬는데, 항상 도시락을 그림처럼 예쁘게 꾸며줬어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500256,
						705500257
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500256,
					"content": "알베도답네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500258,
					"content": "알베도 오빠가 설산에서 일하느라 바쁘면, 클레는 기사단 사람들이랑 야영지에서 밥을 먹어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500259
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500259,
					"content": "케이아 오빠의 야영지는 제일 깔끔하고, 엠버 언니의 야영지는 가끔 나무 위에 있어서 재밌어! 헤르타 이모는 음식을 진짜 잘해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500260
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500260,
					"content": "엄마가 돌아오고 나서는 재미있는 먹을 게 많아졌어. 예를 들면, 여러 가지 생선 살이랑 국물을 푸딩처럼 네모낳게 만든 알록달록 물고기 푸딩 같은 거!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500261,
						705500262
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500261,
					"content": "듣다 보니 군침이 도네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500263,
					"content": "바삭 초코도 맛있어! 엄마가 초콜릿이랑 과자로 만든 신메뉴야! 조금 쓰지만 바삭하고 고소해서, 쓴맛이 사라지고 나면 훨씬 달아져!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500264
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500264,
					"content": "#먹고 나면 힘이 솟아나…. 다음에 명예 기사 {M#오빠}{F#언니}한테도 몇 개 가져다줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500265
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500265,
					"content": "좋아, 이제 어떻게 조정해야 할지 알겠어!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500266
					]
				},
				{
					"id": 705500266,
					"content": "맛있는 음료를 한 잔 더 만들어 줄게!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500267
					]
				},
				{
					"id": 705500267,
					"content": "벌써? 좋아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500268
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500268,
					"content": "다음 건 얼마나 맛있을까…. 클레 기대돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "클레"
				},
				{
					"id": 705500262,
					"content": "역시 대모험가야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500257,
					"content": "나도 알베도의 솜씨를 보고 싶은걸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500238,
					"content": "기다릴게!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500229,
					"content": "어… 어렵지 않아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500223,
					"content": "열심히 배워서 사탕을 만들어 볼게!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500219,
					"content": "엄청난 디저트야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500211,
					"content": "좋아, 한 잔 더 만들어 줄게!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500212,
					"content": "클레가 원하는 거라면 뭐든지 만들어 줄 수 있어!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500204,
					"content": "이름이 조금 안 어울리는 것 같네. 다시 생각해 볼게!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				}
			]
		},
		{
			"id": 7055003,
