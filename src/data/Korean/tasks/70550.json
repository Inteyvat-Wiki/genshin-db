					{
						"sceneId": 51205,
						"position": [
							2198.069,
							230.089,
							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500301,
					"content": "짜잔! 다 됐어——이 신메뉴, 분명 클레 마음에 들 거야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500302
					]
				},
				{
					"id": 705500302,
					"content": "와아! 음료 위에 도도코 사탕도 있네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500303
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500303,
					"content": "컵 안에 주황색이 엄청 많아. 도도코가 하얀 구름 위에 엎드려 있는 것 같아…. 훨씬 더 대단하게 좋은 날이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500304
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500304,
					"content": "한번 마셔볼래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500305
					]
				},
				{
					"id": 705500305,
					"content": "응응… 맛있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500306
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500306,
					"content": "클레 천천히 마실래. 꿀꺽꿀꺽 다 삼켜버리면 맛을 놓쳐버리니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500307
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500307,
					"content": "#신기하다…. 명예 기사 {M#오빠}{F#언니}는, 주스에 햇빛을 담은 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500308
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500308,
					"content": "노느라 피곤해졌던 게 싹 나았어. 따뜻하고 차분한 느낌이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500309
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500309,
					"content": "#…후아~ 명예 기사 {M#오빠}{F#언니} 최고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500310,
						705500311
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705500310,
					"content": "이 음료, 클레가 이름을 지어주지 않을래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				},
				{
