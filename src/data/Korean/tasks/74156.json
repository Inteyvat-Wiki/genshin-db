			"dialogs": [
				{
					"id": 741560401,
					"content": "#긴장되네. {NICKNAME}, 우린 쪽지에 적힌 대로 여기서 그를 기다리기만 하면 되겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560402,
						741560403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741560402,
					"content": "인내심을 갖고 기다리자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				},
				{
					"id": 741560404,
					"content": "응, 네 말대로 할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741560405,
					"content": "조용히 기다리자 「삐걱」 하는 소리와 함께 익숙한 사람이 창문을 열었다. 브누아는 밖을 둘러보더니 당신을 발견하곤 조심스럽게 창문을 통해 밖으로 기어 나왔다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741560406
					]
				},
				{
					"id": 741560406,
					"content": "브누아, 대체 어떻게 된 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741560407,
					"content": "어서 가자, 녀석들한테 들키면 큰일 날 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741560403,
					"content": "그 사람한테 묻고 싶은 게 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				}
			]
		},
