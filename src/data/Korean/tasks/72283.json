			},
			"dialogs": [
				{
					"id": 722830201,
					"content": "너도 실패했구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830202
					],
					"speakerTitle": "아카시"
				},
				{
					"id": 722830202,
					"content": "오늘은 운이 진짜 별로인가 봐. 분명 뭔가 안 좋은 게, 네 실력 발휘를 방해했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "아카시"
				},
				{
					"id": 722830203,
					"content": "더 해볼래? 어차피 과녁은 육지 뱀장어 새끼처럼 헤엄쳐서 도망치지 않으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "아카시"
				}
			]
		},
		{
			"id": 7228303,
			"completionStepIds": [
				7228303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
