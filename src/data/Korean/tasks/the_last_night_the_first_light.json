					"id": 761010201,
					"content": "일루가! 드디어 왔구나, 니키타 등지기장님이 기다리고 계셔!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010202
					],
					"speakerTitle": "올라브"
				},
				{
					"id": 761010202,
					"content": "엥? 니키타… 등지기장?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761010203,
					"content": "#{NICKNAME}, 「니키타」는 우리한테 「은빛 심지」 찾는 걸 의뢰한 할아버지 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761010204,
					"content": "분명 평범한 등지기라고 했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010205,
						761010206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761010205,
					"content": "그러게…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				},
				{
					"id": 761010207,
					"content": "어르신도 참… 그냥 장난치신 거라고 생각해 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010208
					],
					"speakerTitle": "일루가"
				},
				{
					"id": 761010208,
					"content": "아무튼, 상황을 보고 하러 갈까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "일루가"
				},
				{
					"id": 761010206,
					"content": "아니, 아무리 봐도 평범한 등지기 같진 않았어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				}
			]
