			"dialogs": [
				{
					"id": 200340301,
					"content": "베넷 선배님은 여전히 듬직하시구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340302
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200340302,
					"content": "피슬 선배님도… 여전히 기백이 넘치시는 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340303,
						200340308
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200340303,
					"content": "베넷에 대해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340304
					]
				},
				{
					"id": 200340304,
					"content": "베넷 선배?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340305
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200340305,
					"content": "길드에 들어온 지 얼마 안 됐을 때 베넷 선배가 많이 알려주고 도와줬거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340306
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200340306,
					"content": "근데 베넷 선배는 항상 운이 안 따라준다고 들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340307
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200340307,
					"content": "정말 불공평해, 이렇게 좋은 사람인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200340313,
					"content": "후… 이번 의뢰도 잘 끝냈다. 정말 고마워, 지금 바로 길드에 돌아가서 보고할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340314
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200340314,
					"content": "근데 난 왜 며칠 동안 열기구 호송 의뢰만 받는 거지… 협회에 다른 의뢰는 없는 걸까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "안나"
				},
				{
					"id": 200340308,
					"content": "피슬에 대해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340309
					]
				},
				{
					"id": 200340309,
					"content": "피슬 선배님은… 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340310
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200340310,
					"content": "정, 정말 믿음직한 선배야! 활도 잘 쏘고, 의뢰도 많이 맡으시고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340311
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200340311,
					"content": "근데 무슨 말을 하는지… 잘 못 알아듣겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340312
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200340312,
					"content": "하지만 그래도… 정말 경험이 풍부한 모험가야! 아, 아니, 조사원이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "안나"
				}
			]
		},
		{
			"id": 2003404,
