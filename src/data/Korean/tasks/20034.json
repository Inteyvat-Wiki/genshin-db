			"trigger": {
				"objectNames": [
					"베넷",
					"피슬",
					"안나",
					"오즈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340201,
					"content": "피슬, 그렇게 빨리 뛰어다니면 위험해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340202
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 200340202,
					"content": "본 황녀의 신성한 번개 아래에서는 그 누구도 도망갈 수 없다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340203
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 200340203,
					"content": "피슬 선배님과 베넷 선배님이다, 안녕하세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340204
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200340204,
					"content": "안나랑 여행자구나, 길드 의뢰를 수행하러 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340205
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 200340205,
					"content": "아! 본 황녀의 축복을 받은 자여, 운명의 실이 너를 이곳으로 인도했나 보구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340206
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 200340206,
					"content": "이런 곳에서 보다니 정말 놀랍군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340207
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 200340207,
					"content": "안나를 데리고 의뢰를 수행하고 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340208
					]
				},
				{
					"id": 200340208,
					"content": "맞아, 여행자는 나랑 같이 화물 열기구를 호송하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340209
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200340209,
					"content": "근데 갑자기 보물 사냥단이 우리를 향해 달려와서는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340210
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200340210,
					"content": "정말 미안해, 다 나 때문이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340211
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 200340211,
					"content": "나랑 피슬이 보물 사냥단의 행방을 알아내는 의뢰를 받았거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340212
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 200340212,
					"content": "오즈가 어렵게 그들의 행방을 알아내고, 그들을 덮치려고 하는 순간… 내가 길가에 있던 나뭇가지에 걸려 넘어지고 말았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340213
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 200340213,
					"content": "보물 사냥단이 기척을 느끼고 바로 도망가 버렸어. 우리는 계속 쫓았지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340214
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 200340214,
					"content": "자책할 필요 없다네, 죄를 벌하는 빛이 언젠가는 나쁜 녀석들을 심판하게 되어있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340215
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 200340215,
					"content": "하지만 나쁜 녀석들을 잡은 건 여행자님이지 않습니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340216
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 200340216,
					"content": "오, 오즈!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340217
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 200340217,
					"content": "그, 그나저나 정말 고마워, 너희들이 앞에서 막아줘서 정말 다행이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340218
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 200340218,
					"content": "오늘 내 운이 나쁘지만은 않은 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340219
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 200340219,
					"content": "도움이 됐다니 다행이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340220
					]
				},
				{
					"id": 200340220,
					"content": "헤헤, 그럼 이 보물 사냥단은 일단 협회로 데리고 갈게. 너희들도 의뢰를 수행할 때 항상 조심해, 특히 발밑은 더!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베넷"
				}
			]
		},
