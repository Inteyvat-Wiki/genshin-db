					"앤서니"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200340401,
					"content": "그럼 안나 좀 잘 부탁해, 요즘 기분이 너무 좋아 보이는 거 같아서 걱정이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340402
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200340402,
					"content": "동생이 모험가가 되는 게 싫어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340403
					]
				},
