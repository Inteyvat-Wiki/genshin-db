			"dialogs": [
				{
					"id": 20010601,
					"content": "땀을 쫙 뺐더니 좋네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010602
					],
					"speakerTitle": "세웅"
				},
				{
					"id": 20010602,
					"content": "인정해, 널 따라잡으려면 분발해야겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010603,
						20010604
					],
					"speakerTitle": "세웅"
				},
				{
					"id": 20010603,
					"content": "아저씨도 만만치 않으시던걸요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010605
					]
				},
				{
					"id": 20010605,
					"content": "맞아, 정말 아슬아슬했다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20010606,
					"content": "아저씨한테 신의 눈이 있었다면 장난 아니었을걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010607
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20010607,
					"content": "어렸을 땐 나도 신의 눈이 갖고 싶었어. 다들 강해지면 기회가 있을 거랬지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010608
					],
					"speakerTitle": "세웅"
				},
				{
					"id": 20010608,
					"content": "하지만 얻지 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010609
					],
					"speakerTitle": "세웅"
				},
				{
					"id": 20010609,
					"content": "나중에 흥미가 떨어지고 보니까 근육만 한 게 없더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010610
					],
					"speakerTitle": "세웅"
				},
				{
					"id": 20010610,
					"content": "신의 눈을 가진 사람과 싸워서 이긴 적도 있지. 신이 준 힘 따위, 부럽지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010611
					],
					"speakerTitle": "세웅"
				},
				{
					"id": 20010611,
					"content": "엥? 그럼 임자 없는 신의 눈을 노리고 온 게 아니란 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010612
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20010612,
					"content": "그래, 난 그냥 누가 더 강한지 겨뤄보고 싶었던 것뿐이야",
					"roleType": "TALK_ROLE_NPC",
