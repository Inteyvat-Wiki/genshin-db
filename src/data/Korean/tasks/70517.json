			},
			"dialogs": [
				{
					"id": 705170101,
					"content": "이 일대는 굉장히 평범해 보이는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705170102,
					"content": "먹을 것도 없어 보이고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170103,
						705170104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705170103,
					"content": "페이몬, 그러려고 여기까지 온 거였어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				},
				{
					"id": 705170105,
					"content": "흠흠, 비밀 조사도 식후경이지. 이건 당연한 거 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705170106,
					"content": "그리고 귀찮다고 맨날 바비큐만 먹었잖아. 너도 질리지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705170107,
					"content": "바닷가에서 조개나 소라를 주울 수 있다면 과일이랑 같이 쪄 먹을 수도 있을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705170108,
					"content": "신선하고 달콤하고 쫄깃하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170109,
						705170111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705170109,
					"content": "별로일 것 같은데. 난 그딴 거 안 먹어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170110
					]
				},
				{
					"id": 705170110,
					"content": "한번 도전해 보는 거지. 누가 알아? 새로운 맛을 느끼게 될지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705170113,
					"content": "#잠깐, {NICKNAME}, 저기 좀 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705170114,
					"content": "갑자기 장치가 나타났어… 수상한?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705170115,
					"content": "게다가 그 주위에는 짐들도 잔뜩 쌓여있고. 우인단의 물건인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705170116,
					"content": "우와, 페이몬 네 말이 맞았네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170117
					]
				},
				{
					"id": 705170117,
					"content": "역시 내 예감은 정확하다니까, 좋았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705170118,
					"content": "좋았어는 개뿔! 퉷! 또 괜한 일에 엮이게 된 거잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705170119,
					"content": "우인단과 관련된 물건이 여기 나타났다는 건 분명 음모가 일어나고 있다는 뜻이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705170120,
					"content": "이대로 둔다면 일이 더 커지게 될지도 모르지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705170121,
					"content": "어쨌든 일단 저 장치부터 처리하자. 우인단의 물건은 그다음에 조사해 보는 걸로",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705170122,
					"content": "#{NICKNAME}, 힘내! 이것들만 처리하면 마음 놓고 식재료를 찾을 수 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705170111,
					"content": "널 먹으면 새로운 맛을 느낄 수 있을 것 같긴 한데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170112
					]
				},
				{
					"id": 705170112,
					"content": "야! 내가 해산물이냐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705170113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705170104,
					"content": "어쩐지 적극적이더라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705170105
					]
				}
			]
		}
	]
}