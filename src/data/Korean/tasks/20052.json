			"dialogs": [
				{
					"id": 200520301,
					"content": "그럼 안나 좀 잘 부탁해, 요즘 기분이 너무 좋아 보이는 거 같아서 걱정이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520302
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200520302,
					"content": "동생이 모험가가 되는 게 싫어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520303
					]
				},
				{
					"id": 200520303,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520304
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200520304,
					"content": "난 동생의 꿈을 응원해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520305
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200520305,
					"content": "몸도 건강해졌고, 자신의 꿈을 좇아갈 기회도 얻었으니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520306
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200520306,
					"content": "오빠로서… 최선을 다해서 응원해 줘야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520307
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200520307,
					"content": "그게 다야",
