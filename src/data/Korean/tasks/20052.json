			"dialogs": [
				{
					"id": 200520101,
					"content": "좋아… 오늘도 의뢰를 열심히 완수해야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520102,
						200520106
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200520102,
					"content": "정말 의욕이 넘치네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520103
					]
				},
				{
					"id": 200520103,
					"content": "물론이지, 모험가는 정말 재미있는 직업이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520104
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200520104,
					"content": "근데… 헤헤, 의뢰를 진행할 때 모르는 게 너무 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520105
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200520105,
					"content": "여행자, 아직 배우고 싶은 게 많은데 한 번만 같이 가주면 안 될까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520108
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200520108,
					"content": "그럼 어서 출발하자, 오늘의 의뢰는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520109
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200520109,
					"content": "아… 또 화물 열기구 호송하기네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "안나"
				},
				{
					"id": 200520106,
					"content": "내가 같이 가줄까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520107
					]
				},
				{
					"id": 200520107,
					"content": "그래도 될까? 헤헤, 마침 물어보고 싶은 게 많았는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520108
					],
					"speakerTitle": "안나"
				}
			]
		},
