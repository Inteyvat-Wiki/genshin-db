				"points": []
			},
			"dialogs": [
				{
					"id": 722120301,
					"content": "휴, 언제쯤 일자리를 찾을 수 있을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120302
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120302,
					"content": "날 찾아왔어? 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120303,
						722120304
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120303,
					"content": "혹시 조각하실 줄 아시나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				},
				{
					"id": 722120305,
					"content": "어? 잘… 잘됐군!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120306
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120306,
					"content": "내 정신 좀 봐, 아직 자기소개도 안 했지… 난 오오시마 준페이라고 해. 타타라스나에서 일을 했었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120307
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120307,
					"content": "사고가 난 후 난 다른 사람들과 같이 쫓겨났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120308
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120308,
					"content": "하지만… 언제 다시 일을 할 수 있는지 소식도 없고, 계속 이렇게 기다리고 있을 수밖에 없는 상황이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120309
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120309,
					"content": "석조 조각을 하는 사람을 찾는 거야? 난 전공은 아니지만 어느 정도 실력은 있는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120310
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120310,
					"content": "어떤 모양의 조각상을 원하는지 알려줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120311
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120311,
					"content": "그러니까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120312
					]
				},
				{
					"id": 722120312,
					"content": "아, 말하는 고양이가 장인을 찾아서 돌을 조각해달라고 부탁을 했다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120313
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120313,
					"content": "아, 안 믿는 게 아니라, 조금… 조금 황당해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120314
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120314,
					"content": "다른 건 모르겠고, 내가 한다고 하면, 그… 「대리 궁사」 님이 결제는 어떤 식으로 한데? 무료 봉사를 할 수는 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120315
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120315,
					"content": "그건 걱정하지 마세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120316
					]
				},
				{
					"id": 722120316,
					"content": "(저, 정말 걱정 안 해도 되겠지…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722120317,
					"content": "그래, 그게… 날 속이고 있는 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120318
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120318,
					"content": "아니다… 어차피 이곳에 계속 있는다고 해결되는 것도 아니니, 일단 같이 가자",
