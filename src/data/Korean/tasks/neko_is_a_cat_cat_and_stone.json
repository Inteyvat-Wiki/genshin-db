				"points": []
			},
			"dialogs": [
				{
					"id": 722120101,
					"content": "자네들 잘 왔네, 어서 와서 나 좀 도와주게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120102
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722120102,
					"content": "무슨 일이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120103
					]
				},
				{
					"id": 722120103,
					"content": "나는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120104
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722120104,
					"content": "신사 옆에 엄청 엄청 높고, 엄청 엄청 큰 나 같은 바위를 놓고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120105
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722120105,
					"content": "어, 어디서 그런 바위를 찾아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722120106,
					"content": "석상 말하는 거지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120107
					]
				},
				{
					"id": 722120107,
					"content": "어쨌든 내가 원하는 것은 엄청 엄청 멀리 있는 섬에 있는 여우 바위 같은 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120108
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722120108,
					"content": "히비키가 그 섬에 여우 바위가 많다고 알려줬어, 내게도 하나 준다고 했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120109
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722120109,
					"content": "히비키가 가지고 싶어 하는 건 다 좋은 물건일 거야, 그러니 바위 좀 구해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120110,
						722120113
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722120110,
					"content": "난 조각하는 재주는 없어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120111
					]
				},
				{
					"id": 722120111,
					"content": "음, 어떡하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722120112,
					"content": "맞다, 타이유를 찾아가면 되겠다! 고양이를 좋아하니까 네코를 위해 조각을 해줄 수도 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722120113,
					"content": "타이유를 찾으러 가보자…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120114
					]
				},
				{
					"id": 722120114,
					"content": "그래! 고양이를 좋아하니 도움이 될 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7221202,
			"completionStepIds": [
				7221202
			],
