					"에츠코"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120201,
					"content": "와! 안녕하세요, 오늘은 뭐 하고 계신 거죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120202
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722120202,
					"content": "네코의 조각상을 만드는 중이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120203
					]
				},
				{
					"id": 722120203,
					"content": "네… 네? 여기서 조각상을요? 정말요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120204
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722120204,
					"content": "지, 지금 조각 기술을 배워올게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120205
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722120205,
					"content": "늦, 늦지 않을까요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120206
					]
				},
				{
					"id": 722120206,
					"content": "또 네코가 부탁한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120207
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722120207,
					"content": "타타라스나 문제 때문에 많은 장인이 일을 찾고 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120208
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722120208,
					"content": "길드에서 이에 관련된 의뢰를 꽤 받은 적 있어. 내가 알기로는 아직 타타라스나에 남아 일을 찾고 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120209
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722120209,
					"content": "길드 의뢰를 해결하러 갔을 때 비슷한 야영지를 본 적이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120210
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722120210,
					"content": "괜찮다면 가서 운에 맡겨 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120211,
						722120212
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722120211,
					"content": "고마워요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120214
					]
				},
				{
					"id": 722120214,
					"content": "하하… 신경 쓰지마, 어차피 별거 아냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120215
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722120215,
					"content": "나도 이 신사가 많이 알려지면… 무슨 일이 일어날지… 알고 싶어서 그런 거라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120216
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722120216,
					"content": "특히 그 「히비키」라는 사람… 은 도대체 어떤 사람인데 네코가 그렇게 기다리는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120217
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722120217,
					"content": "아, 내 혼잣말은 신경 쓰지 말고 어서 가서 장인이나 찾아봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120218
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722120218,
					"content": "너희가 찾은 그 장인이… 조각을 할 줄 아는 장인일지는 운에 맡겨야 겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120219
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722120219,
					"content": "에츠코 씨도 사실은 네코 님을 돕고 싶은 거죠? 하하하, 당신도 정말…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120220
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722120220,
					"content": "타이유, 조사 계획안은 다 썼어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120221
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722120221,
					"content": "아! 다, 다 써가요, 미안해요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타이유"
				},
				{
					"id": 722120212,
					"content": "에츠코 씨, 평소의 모습과 조금 다르네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120213
					]
				},
				{
					"id": 722120213,
					"content": "응? 내가 먼저 정보를 줘서 놀랐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120214
					],
					"speakerTitle": "에츠코"
				}
			]
		},
