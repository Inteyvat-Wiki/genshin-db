				]
			},
			"dialogs": [
				{
					"id": 700501501,
					"content": "…이런 상태라면, 주인공은 혼자서 마을로 돌아갈 순 없겠죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501502
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700501502,
					"content": "기하로!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700501503,
					"content": "일단 일으켜 세우자…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501504
					]
				},
				{
					"id": 700501504,
					"content": "기하로를 일으켜서 바닥에 앉힌다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501505
					]
				},
				{
					"id": 700501505,
					"content": "이런… 느낌이군요… 정말 괴롭네요. 몸만 힘든 게 아니라 사고력까지 둔해졌어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501506
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700501506,
					"content": "그럼 소재 수집은 성공인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501507
					]
				},
				{
					"id": 700501507,
					"content": "물론이죠. 대성공이에요. 드디어 묶인 채 야외에서 밤을 새우는 것이 어떤 느낌인지 확실히 알게 됐어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501508
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700501508,
					"content": "네 소설 속 주인공도 참 강인하다… 보통이 아니네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501509
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700501509,
					"content": "맞아요. 게다가 주인공이 「현문 야수」를 쫓아내는 방법도 생각해 뒀는데, 그 방법으로 결말을 맺으면, 분명… 분명…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501510
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700501510,
					"content": "와! 뭔가 대단한 방법을 생각해 낸 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501511
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700501511,
					"content": "분명… 멋질…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501512
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700501512,
					"content": "기하로가 다시 바닥에 쓰러진다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501513
					]
				},
				{
					"id": 700501513,
					"content": "으악! 기하로! 괜찮아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501514
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700501514,
					"content": "방법은 말하고 기절하셔야죠!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501515
					]
				},
				{
					"id": 700501515,
					"content": "어, 아, 아무튼 먼저 의사한테… 일단 마을로 데리고 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501516
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700501516,
					"content": "홍분 말이 맞았어. 기하로는 교영 마을을 떠나면 안 됐다구——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
