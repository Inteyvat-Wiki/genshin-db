					}
				]
			},
			"dialogs": [
				{
					"id": 700500601,
					"content": "어때요? 이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500602
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700500602,
					"content": "차솥",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500603
					]
				},
				{
					"id": 700500603,
					"content": "맞아요! 차… 차 뭐였더라? 어쨌든… 아주 특이한 물건이죠! 게다가 마을의 정중앙에 있다니, 분명 뭔가 더 특별한 의미가 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500604
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700500604,
					"content": "음… 혹시 현문 야수가 이 안에 사는 건 아닐까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500605,
						700500606
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700500605,
					"content": "그렇게 썼다간 판타지 소설이 될걸요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				},
				{
					"id": 700500607,
					"content": "그렇게 쓰다 보면 나중에 선인 같은 판타지 요소가 등장할 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500608
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700500608,
					"content": "그런 주제의 범죄 소설이라면 좀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500609
					]
				},
				{
					"id": 700500609,
					"content": "…오! 두 분 표정이 좋은데요? 혹시 현문 야수를 주제로 한 범죄 소설을 쓴다고 하면 사건이 너무 「황당」하게 느껴질까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500610
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700500610,
					"content": "응? 어, 어… 그런 느낌이 조금 있달까? 아무래도 범죄 소설이라고 하면 이런 주제로 이야기가 전개되지는 않잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500611
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700500611,
					"content": "잠깐만요. 설마…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500612
					]
				},
				{
					"id": 700500612,
					"content": "#음, 아주 예리하군요, {NICKNAME}. 역시 명불허전이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500613
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700500613,
					"content": "맞아요. 제가 쓰려는 건 「너무 황당해서 일어날 리가 없는 범죄 사건」이에요. 홍분 씨와 여러분의 반응이 너무 재밌어서 꼭 소설에 넣어야겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500614
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700500614,
					"content": "그리고 현문 야수는… 제가 구상 중인 「범인」이에요. 마을의 악인을 삼킨다고 전해지지만, 진짜 본 사람은 아무도 없는 전설의 「현문 야수」죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500615
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700500615,
					"content": "어느 명절, 한 마을 사람이 야외에서 맹수의 습격받은 듯한 모습으로 사망했고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500616
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700500616,
					"content": "이튿날 축제에서, 주인공은 사망했어야 할 그 피해자를 다시 만나게 되고, 이어서 또 다른 사망자가 나타나게 되는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500617
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700500617,
					"content": "그래서? 그래서 어떻게 됐는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500618
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700500618,
					"content": "아직 구상 중이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500619
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700500619,
					"content": "…전 이만 가볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500620
					]
				},
				{
					"id": 700500620,
					"content": "으앙, 그러지 마요. 책을 다 쓰고 나면 꼭 선물로 두 권 보내드릴게요. 아직도 부탁드릴 게 엄청 많단 말이에요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500621
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700500621,
					"content": "홍분 씨가 계속 혼자서 마을을 벗어나지 말라고 그랬잖아요? 전 그 말을 허투루 듣지 않았다구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500622
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700500622,
					"content": "하지만 지금은… 여러분이 오셨잖아요? 그럼 「혼자」가 아니니까, 마을 밖을 돌아다녀도 되는 거죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500623
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700500623,
					"content": "물론 너무 멀리 가지는 않을 거예요! 그러니까 저 좀 도와주세요, 네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500624,
						700500625
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700500624,
					"content": "알겠어요… 소설의 결말은 봐야 하니까요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500627
					]
				},
				{
					"id": 700500627,
					"content": "자! 그럼 저쪽으로 가볼까요? 가고 싶은 곳이 있거든요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "기하로"
				},
				{
					"id": 700500625,
					"content": "보수는 규정대로 받겠습니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500626
					]
				},
				{
					"id": 700500626,
					"content": "그야 당연하죠. 그건 걱정 마세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500627
					],
					"speakerTitle": "기하로"
				},
				{
					"id": 700500606,
					"content": "그게 범죄 소설이랑 무슨 관련이 있는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				}
			]
		},
