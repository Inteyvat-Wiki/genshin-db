			"dialogs": [
				{
					"id": 721650201,
					"content": "어서들 오시게나, 젊은이들. 오늘은 무슨 일이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650202
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721650202,
					"content": "운세 좀 보고 싶어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650203
					]
				},
				{
					"id": 721650203,
					"content": "후후, 오늘은 또 어떤 운세가 있을까~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721650204,
					"content": "음… 「영초」의 예언에 따르면… 오늘 액운이 있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650205
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721650205,
					"content": "와타츠미섬 남쪽 동굴에는 도적 소굴이 있는데 그곳에서 액운이 예고 없이 찾아올 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650206
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721650206,
					"content": "엥, 액운이라고! 그럼 거길 피해 가면 되잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721650207,
					"content": "허허, 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650208
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721650208,
					"content": "액운을 극복하면 뜻밖의 수확이 있을 걸세",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650209
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721650209,
					"content": "수확…? 보물인가? 보물이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721650210,
					"content": "난 그렇다고 말한 적 없다네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650211
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721650211,
					"content": "어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721650212,
					"content": "아니라고도 말한 적 없고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650213
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721650213,
					"content": "와! 정말 너무해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
