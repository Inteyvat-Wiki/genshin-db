			"dialogs": [
				{
					"id": 721650101,
					"content": "왔구나, 무슨 일인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650102
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721650102,
					"content": "운세 좀 보고 싶어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650103
					]
				},
				{
					"id": 721650103,
					"content": "#나도 {NICKNAME}의 오늘의 운세를 알고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721650104,
					"content": "음… 「영초」의 무늬를 보니… 행운이 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650105
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721650105,
					"content": "와타츠미섬의 제일 높은 곳에서 신의 영지를 공양하면 행운이 있을 걸세",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650106
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721650106,
					"content": "음… 난 왜 아무것도 안 보이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721650107,
					"content": "허허, 이게 노인들의 지혜라네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650108
					],
					"speakerTitle": "코마키"
				},
				{
					"id": 721650108,
					"content": "얼렁뚱땅 넘어가는 거 보니 의심스러워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
