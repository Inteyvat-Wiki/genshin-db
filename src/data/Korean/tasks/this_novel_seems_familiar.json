			]
		},
		{
			"id": 2201704,
			"completionStepIds": [
				2201706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201706",
							"2"
						],
						"stepId": 2201706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"시게루",
					"쥰키치"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170401,
					"content": "내 기억이 맞다면 이 추리 소설은 꽤 오래 붐이었잖아? 인기가 많지 않았나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170402
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170402,
					"content": "이 소설이 성공할 수 있었던 이유는, 교묘한 트릭과 재치 있는 스토리 때문이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170403
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170403,
					"content": "많은 독자들이 스토리가 너무 예상 밖이고 이해가 안 된다는 피드백을 주긴 했지만, 작가는 자신만의 원칙을 꿋꿋이 지켜나갔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170404
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170404,
					"content": "그게 바로 이 소설이 다른 추리 소설들 사이에서 돋보이게 된 이유지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170405
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170405,
					"content": "하지만 이 소설은 설정이 탄탄하잖아. 탄탄하면서도 설정을 함부로 바꾸지 않아서 스토리에 안정감이 있고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170406
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170406,
					"content": "윽… 그건… 여행자, 다른 책은 없어…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쥰키치"
				}
			]
		},
		{
			"id": 2201705,
			"completionStepIds": [
				2201705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201705",
							"2"
						],
						"stepId": 2201705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"시게루",
					"쥰키치"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170501,
					"content": "이 소설? 필력이 대단한 작가로 기억하는데. 스토리며 글의 짜임새 모두 매끈해서 흠잡을 데가 없었어. 편집 담당자들 모두 칭찬 일색이었지. 당시 판매량도 꽤 좋았고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170502
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170502,
					"content": "…그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170503
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170503,
					"content": "하지만 이 소설은 빈틈없는 스토리와 설정에 너무 신경을 쓴 나머지, 후속 스토리에 조금의 여지도 남겨두지 않았어. 결국 후반부에 가서는 독자들이 이미 알고 있던 이야기를 끊임없이 되풀이하는 수밖에 없었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170504
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170504,
					"content": "더 이상 신선한 스토리를 보여주지 못한 탓에, 독자들은 하나둘씩 흥미를 잃고 떠나고 말았지. 결국 마지막 독자마저 떠나버린 후, 이 작품은 조용히 묻히게 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170505
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170505,
					"content": "설정이든 스토리든, 프레임에 갇히게 되면 모든 스토리가 비슷해져. 그리고 점점 생명력을 잃은 고인 물웅덩이가 돼 버리지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170506
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170506,
					"content": "난 내 소설이 그렇게 되길 바라지 않아! 좋은 소설은 무엇보다도 활력이 넘쳐야 한다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170507
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170507,
					"content": "게다가, 만약… 만약 작가마저도 자신의 스토리에 흥미를 잃게 된다면, 독자들에게 어떻게 감명을 줄 수 있겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170508
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170508,
					"content": "시게루!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170509
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170509,
					"content": "…알겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170510
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170510,
					"content": "네가 그렇게까지 진지하게 생각하고 있을 줄이야, 역시 《귀무도》의 작가야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170511
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170511,
					"content": "사실 나도 네 창작을 제한하고 싶은 마음은 아니었어. 하지만 나는 작가들이 과도한 상상력과 창작 욕구로 자신의 작품을 망치는 걸 많이 봐왔거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170512
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170512,
					"content": "쥰키치, 네가 작가로서 창작을 어떻게 생각하고 있는지 알고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170513
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170513,
					"content": "난 창작 욕구가 없는 작가는 절대 독자를 감동시키는 소설을 써낼 수 없다고 생각해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170514
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170514,
					"content": "하지만 난 작가에게 더욱 중요한 건 창작 욕구에 대한 자제력 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170515,
						220170516
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170515,
					"content": "아직도 의견이 엇갈리네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170517
					]
				},
				{
					"id": 220170517,
					"content": "시게루, 난…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170518
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170518,
					"content": "그렇지만 소설을 쓰는 사람은 내가 아니지. 이 작품의 작가는 너야. 난 너의 창작을 돕는 편집 담당자일 뿐이고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170519
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170519,
					"content": "네가 확고한 생각과 신념이 있다면, 네 구상대로 써 내려가도록 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170520
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170520,
					"content": "네 의견에 동의한다고는 못 하겠지만, 적어도 이해하려고 노력은 해볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170521
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170521,
					"content": "아… 고마워! 시게루!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170522
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170522,
					"content": "아니야, 내가 당연히 해야 될 일인걸. 물론, 내가 널 이해하는 만큼 너도 날 이해해 줘야지, 예를 들면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170523
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170523,
					"content": "윽, 뭔데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170524
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170524,
					"content": "예를 들면, 오늘 하루가 다 가고 있는데, 네… 원고는?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170516,
					"content": "설득에 실패했나 보네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170517
					]
				}
			]
		},
