				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"쥰키치",
					"시게루"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170101,
					"content": "안 써, 나 안 써! 이번만은 아무리 재촉해도 소용없어! 나 작가 때려칠래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170102
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170102,
					"content": "이 녀석… 너 그 소리로 날 협박한 게 벌써 일곱 번째야. 진심도 아니잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170103
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170103,
					"content": "왜 또 싸우세요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170104
					]
				},
				{
					"id": 220170104,
					"content": "드디어 왔구나, 여행자! 제발 도와줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170105
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170105,
					"content": "저번에 네가 이 녀석의 편을 든 후로, 시게루 녀석… 점점 도를 넘더니 규칙을 벌써 몇십 개나 정했다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170106
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170106,
					"content": "능력의 명칭 같은 사소한 거부터 스토리의 반전까지, 뭐라더라… 문장의 기준을 세우고 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170107
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170107,
					"content": "이런 상황에서 소설을 어떻게 쓰냐구! 본인이나 그렇게 쓰라지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170108
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170108,
					"content": "전부 성공한 소설에서 도출해낸 문장의 원칙이야. 성공한 작가들의 경험이라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170109
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170109,
					"content": "그건 다른 소설의 클리셰를 내 소설에 억지로 집어넣는 거잖아? 대체 소설을 쓰는 사람이 나야, 그 「성공한 작가들」이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170110
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170110,
					"content": "난 절대 이런… 고리타분한 내용을 쓰지 않을 거야! 쓰려면 네가 직접 써!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170111
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170111,
					"content": "게다가, 「야에 출판사」에는 판매량이 저조한 이런 류의 소설이 잔뜩 있잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170112
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170112,
					"content": "마케팅 전략의 실수일 뿐이야, 소설과는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170113
					],
					"speakerTitle": "시게루"
				},
				{
					"id": 220170113,
					"content": "마케팅 전략 같은 소리 하네. 이딴 소설을 쓴 작가의 창작 방식에 문제가 있는 거라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170114
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170114,
					"content": "넌 출간된 책을 전부 읽어보지는 않았겠지. 하지만 난 독자로서, 「야에 출판사」에서 출판한 책들을 전부 읽어봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170115
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170115,
					"content": "여행자, 소설 몇 권 가져다줄래? 시게루와 진지하게 얘기 좀 해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170116,
						220170117
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170116,
					"content": "맡겨만 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220170117,
					"content": "무슨 소설을 가져오면 될까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170118
					]
				},
				{
					"id": 220170118,
					"content": "근처에 놔둔 소설들을 가져오면 돼. 난 이 소설들로… 수시로 날 일깨우고 있어. 절대 이렇게 쓰진 말아야겠다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쥰키치"
				}
			]
		},
