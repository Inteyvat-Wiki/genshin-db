			"dialogs": [
				{
					"id": 220170201,
					"content": "여행자, 소설 몇 권 가져다줄래? 시게루와 진지하게 얘기 좀 해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170202
					],
					"speakerTitle": "쥰키치"
				},
				{
					"id": 220170202,
					"content": "흥, 그 녀석이 멋대로 쓰게 내버려 두는 게 소설을 망치는 지름길이야",
					"roleType": "TALK_ROLE_NPC",
