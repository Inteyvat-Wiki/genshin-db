			"dialogs": [
				{
					"id": 752475001,
					"content": "어떻게, 재밌게 놀았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475002
					],
					"speakerTitle": "이파"
				},
				{
					"id": 752475002,
					"content": "세상에, 형씨!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475003
					],
					"speakerTitle": "카쿠쿠"
				},
				{
					"id": 752475003,
					"content": "기분이 좋은가 보네. 생일 축하해, 형씨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475004
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 752475004,
					"content": "그나저나 왜 미리 계획을 말해주지 않았어? 날 형씨로 생각하지 않는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475005
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 752475005,
					"content": "후후… 솔직히 네가 이날을 기억하는지 보고 싶었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475006
					],
					"speakerTitle": "이파"
				},
				{
					"id": 752475006,
					"content": "…이파, 변했구나. 음흉해졌어. 앞으로 난 널 경계할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475007
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 752475007,
					"content": "카쿠쿠한테 줄 꿀을 남겨둬서 다행이야. 아니면 1년 내내 머리를 쪼아댔겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475008
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 752475008,
					"content": "그건 아니지, 형씨, 네가 최고야, 형씨!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카쿠쿠"
				}
			]
