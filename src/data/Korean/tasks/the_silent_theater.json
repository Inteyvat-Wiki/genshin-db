							494.111
						],
						"pointId": 5
					},
					{
						"sceneId": 20360,
						"position": [
							588.836,
							904.613,
							494.721
						],
						"pointId": 6
					},
					{
						"sceneId": 20360,
						"position": [
							589.08,
							904.586,
							495.725
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 762030201,
					"content": "으악, 깜짝이야! 갑자기 그림 속으로 빨려 들어왔어. 잠깐만, 이건… 마녀들이 모이는 테이블이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762030202,
					"content": "——이건 내가 처음 앨리스에게 티타임 초대를 받았을 때의 이야기부터 시작해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030203
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 762030203,
					"content": "그날 나는 직접 참석하지 않았어. 그때까지만 해도 마녀회에 정식으로 들어갈지 말지 고민 중이었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030204
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 762030204,
					"content": "그 자리에 내 정체를 아는 건 앨리스뿐이었어. 앨리스는 나보고 괜히 말하다가 들키지 말고, 조용히 지켜보기만 하라고 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030205
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 762030205,
					"content": "그다음엔 어떻게 됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762030206,
					"content": "…아무리 생각해도, 그건 내 망설임에 대한 보복이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030207
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 762030207,
					"content": "그렇게 흥미진진한 얘기를 나누는데, 어떻게 끼어들지 말고 참으란 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030208
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 762030208,
					"content": "내가 정답을 명확히 아는 질문이 나오는데, 어떻게 답하지 않을 수가 있겠냐구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030209
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 762030209,
					"content": "대화는 앨리스와 바르벨로스의 내기, 라인도티르의 금지된 창조, 이바노브나의 정치적 수완 이야기까지 이어졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030210
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 762030210,
					"content": "전부 찻잔에 응축된 아름다운 희극 같아서, 얘기만 들어도 진실을 밝히고 싶은 내 본능이 마구 불타올랐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030211
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 762030211,
					"content": "그럼 그 사람들 머릿속으로 말을 걸었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762030212,
					"content": "그럴 리가. 난 책임감 있는 천사라구. 숨이 막힐 정도로 답답해도, 「하고 싶은 말」과 「해도 되는 말」은 구분할 줄 알아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030213
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 762030213,
					"content": "결국 난 앨리스를 따로 찾아가서 속 시원하게 마구 떠든 뒤, 마녀회 가입 제안을 승낙했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030214
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 762030214,
					"content": "앨리스는 내 마녀회 가입은 반겼지만… 내 수다 때문에 며칠 동안 머리가 아파서 리월의 의사까지 찾아갔대. 하지만 그건 절대 내 탓만은 아니야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "니콜"
				}
			]
		},
