			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"벤티"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130701,
					"content": "하아~ 역시 여기 경치가 제일 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130702,
						414130703
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130702,
					"content": "정말 예쁘다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				},
				{
					"id": 414130704,
					"content": "그치? 한가할 때마다 찾는 내가 제일 좋아하는 곳이야. 경치 좀 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130705
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130705,
					"content": "땡땡이 치러 오는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130706
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414130706,
					"content": "하하하, 들켰네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130707
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130707,
					"content": "이런 아름다운 경치엔 사과주 한 잔이 딱인데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130708
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130708,
					"content": "여행자, 몬드의 윈드블룸 축제는 재밌었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130709,
						414130710
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130709,
					"content": "인정이 넘치고 시끌벅적했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130711,
					"content": "하지만 궁금증도 생기고, 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130712
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130712,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130713
					]
				},
				{
					"id": 414130713,
					"content": "도대체 「바람의 꽃」이 뭔지, 바람의 신 바르바토스한텐 「바람의 꽃」과 「윈드블룸 축제」가 무슨 의미일지 궁금할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130714
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130714,
					"content": "너도 봤다시피, 몬드 사람들에겐 선택권이 있어. 수많은 꽃 중에 어떤 사람은 민들레를, 또 어떤 사람은 풍차 국화를 택하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130715
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130715,
					"content": "각자 마음속의 「바람의 꽃」은 다 다른 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130716
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414130716,
					"content": "맞아. 정답은 없어, 실존하는 「바람의 꽃」도 없고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130717
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130717,
					"content": "엥… 없는 거였어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130718
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414130718,
					"content": "「바람의 꽃」이란 단어는 옛 몬드 시절, 서로 연락하고 반란을 공모할 때 사용하던 암호였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130719
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130719,
					"content": "그 당시 사람들은 바람이 커질수록 「바람의 꽃」 뿌리는 더 견고해지고, 꽃도 더 화려해진다고 말했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130720
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130720,
					"content": "굳이 말하자면 존재하진 않지만, 어디에나 있는 그런 존재랄까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130721
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130721,
					"content": "자유를 향한 영혼, 바람을 쫓는 용기… 아름답고 축복받을 만한 것이라면 모두 「바람의 꽃」이 될 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130722
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130722,
					"content": "보이진 않지만, 어디에나 있는, 바람이랑 똑같네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130723
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414130723,
					"content": "하하, 네 말이 맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130724
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130724,
					"content": "그러니까 바람의 신 바르바토스는 「바람의 꽃」을 특정해놓지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130725
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130725,
					"content": "축복의 꽃, 존경의 꽃, 사랑의 꽃. 사람들은 모두 자신만의 「바람의 꽃」이 있고, 그것들을 정의할 자유가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130726
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130726,
					"content": "자유의 도시 몬드는 바람의 신에게 바치는 꽃도 자유롭구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130727
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414130727,
					"content": "나도 자유로운 기분이 좋아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130728
					]
				},
				{
					"id": 414130728,
					"content": "알아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130729
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130729,
					"content": "뜻이 같은 사람은 함께하게 되지. 우릴 만나게 한 건 분명 자유의 바람일 거고,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130730
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130730,
					"content": "그건 여정의 끝, 세상의 끝자락으로부터 불어와 우리의 마음속에서 영원히 멈추지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130731
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130731,
					"content": "「시냇가에서\\n거암 옆에서\\n누가 상처 입었지만 의연한 네 얼굴을 어루만졌는가」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130732
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130732,
					"content": "「꿈속에서\\n높은 하늘에서\\n누가 네 지치고 고귀한 영혼을 안아주었는가」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130733
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130733,
					"content": "「사랑하는 친구여\\n내가 네 손을 잡고\\n깊은 밤 화려한 등불 속으로 이끌고」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130734
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130734,
					"content": "「너를 위해 처음부터 노래하리라\\n축제 속 자유와 꿈의 악장을」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "벤티"
				},
				{
					"id": 414130710,
					"content": "사람들과 함께여서 너무 좋았어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130703,
					"content": "분위기 좋다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				}
			]
		},
