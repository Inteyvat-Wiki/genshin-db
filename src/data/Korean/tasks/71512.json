			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"조근"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715120101,
					"content": "정말이지… 이 구역은 정리를 하긴 한 건가? 으… 하긴 한 거 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120102
					],
					"speakerTitle": "조근"
				},
				{
					"id": 715120102,
					"content": "아, 머리야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120103
					],
					"speakerTitle": "조근"
				},
				{
					"id": 715120103,
					"content": "윽… 넌… 여행자! 미, 미안. 너무 바빠서 미처 못 봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120104
					],
					"speakerTitle": "조근"
				},
				{
					"id": 715120104,
					"content": "뭐 때문에 바쁜데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120105
					]
				},
				{
					"id": 715120105,
					"content": "크흠, 올해 해등절에 우리 리월항 모험가 길드가 총무부 지시에 따라 일을 좀 도와주기로 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120106
					],
					"speakerTitle": "조근"
				},
				{
					"id": 715120106,
					"content": "천암군은 도시 내부랑 중점 지역 순찰을 맡았고, 우리는 야외에 돌아다니는 마물 처치랑… 문제만 일으키는 도적들을 쫓아내는 일을 맡았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120107
					],
					"speakerTitle": "조근"
				},
				{
					"id": 715120107,
					"content": "그러고 보니… 너도 협회에 등록된 모험가잖아. 네 모험 이야기는 정말 많이 들었다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120108
					],
					"speakerTitle": "조근"
				},
				{
					"id": 715120108,
					"content": "너만 괜찮다면 같이 좀 도와줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120109,
						715120110
					],
					"speakerTitle": "조근"
				},
				{
					"id": 715120109,
					"content": "축제인데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120111
					]
				},
				{
					"id": 715120111,
					"content": "크흠, 그게… 축제 기간에 총무부를 도와서 일하면 우리한테도 특별 보너스가 주어지거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120112
					],
					"speakerTitle": "조근"
				},
				{
					"id": 715120112,
					"content": "이런 의뢰를 완료하면 훨씬 많은 보수를 받을 수 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120113,
						715120115
					],
					"speakerTitle": "조근"
				},
				{
					"id": 715120113,
					"content": "정확히… 얼마나 주는데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120114
					]
				},
				{
					"id": 715120114,
					"content": "날 믿어, 절대 실망하지 않을 테니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120123
					],
					"speakerTitle": "조근"
				},
				{
					"id": 715120123,
					"content": "일단 해야 할 일이 얼마나 되는지 확인부터 하고요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120116
					]
				},
				{
					"id": 715120116,
					"content": "하하하! 그래! 역시 모른 척하지 않을 줄 알았다니까! 협회에서 확정한 구역부터 표시해 줄게. 그리고 이 작은 폭죽통도 가져가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120117
					],
					"speakerTitle": "조근"
				},
				{
					"id": 715120117,
					"content": "정말 의뢰를 받을 생각이 있다면… 구역 하나를 싹 정리한 뒤에 이 폭죽통으로 불꽃을 터트리면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120118
					],
					"speakerTitle": "조근"
				},
				{
					"id": 715120118,
					"content": "불꽃이 터지면 우리가 파견한 기록관들이 그 구역을 「정리 완료」라고 표시할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120119
					],
					"speakerTitle": "조근"
				},
				{
					"id": 715120119,
					"content": "그다음 우리가 각 구역의 정리 상황을 보고 실시간으로 계획을 조정해 주는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120120
					],
					"speakerTitle": "조근"
				},
				{
					"id": 715120120,
					"content": "꽤 체계적인데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120121
					]
				},
				{
					"id": 715120121,
					"content": "에이… 해등절이잖아. 절대 문제가 생기면 안 된다고. 우린… 다들 바짝 긴장하고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120122
					],
					"speakerTitle": "조근"
				},
				{
					"id": 715120122,
					"content": "이런 얘기는 나중에 하자. 난 상황을 보러 다시 가봐야 해. 이따가 란 누님께 보고해야 하거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "조근"
				},
				{
					"id": 715120115,
					"content": "일단… 할 일이 얼마나 되는지 보여주세요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120116
					]
				},
				{
					"id": 715120110,
					"content": "해등절은 어쩌고…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120111
					]
				}
			]
		}
	]
}