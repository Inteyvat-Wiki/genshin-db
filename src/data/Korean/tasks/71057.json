					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710570219,
					"content": "#{NICKNAME}, 얼른 하 씨를 데리고 근우한테 돌아가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710570210,
					"content": "아무거나 주워 먹지 마!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570211
					]
				},
				{
					"id": 710570211,
					"content": "알, 알았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "페이몬"
				}
