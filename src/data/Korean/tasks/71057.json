				"points": []
			},
			"dialogs": [
				{
					"id": 710570133,
					"content": "뒤에서 갑자기 누군가의 말소리가 들려온다.\\n「헤헤헤… 버섯 고기… 헤헤헤…」",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570101
					]
				},
				{
					"id": 710570101,
					"content": "너희는, 헤헤헤, 왜 여기 있는 거니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570102
					],
					"speakerTitle": "하 씨"
				},
				{
					"id": 710570102,
					"content": "으앗! 이 사람, 안색이 엄청 이상해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710570103,
					"content": "#게다가 {NICKNAME}, 이 사람이 뒤에서 다가올 때 아무 소리도 안 났어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710570104,
					"content": "설마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710570105,
					"content": "아닐 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570106
					]
				},
				{
					"id": 710570106,
					"content": "헤헤헤… 너희는 왜… 여기 있는 거니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570107
					],
					"speakerTitle": "하 씨"
				},
				{
					"id": 710570107,
					"content": "너희도 먹을 게 다 떨어졌니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570108
					],
					"speakerTitle": "하 씨"
				},
				{
					"id": 710570108,
					"content": "설마 당신이 하 씨인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570109
					]
				},
				{
					"id": 710570109,
					"content": "아… 뭐라고? 젊은이, 잘 안 들려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570110
					],
					"speakerTitle": "하 씨"
				},
				{
					"id": 710570110,
					"content": "당신이! 하 씨가 맞냐고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710570111,
					"content": "오오, 맞아. 헤헤헤, 내가 하 씨야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570112
					],
					"speakerTitle": "하 씨"
				},
				{
					"id": 710570112,
					"content": "너희들도 설마… 나처럼 여기 갇혀서 먹을 게 다 떨어진 건 아니겠지… 에휴, 너도 참 운이 없구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570113
					],
					"speakerTitle": "하 씨"
				},
				{
					"id": 710570113,
					"content": "헤헤헤, 하지만 괜찮아. 여기 먹을 게 있으니까… 오래 굶었지? 헤헤헤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570114
					],
					"speakerTitle": "하 씨"
				},
				{
					"id": 710570114,
					"content": "그러고 보니 배가 좀 고프네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570115,
						710570116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710570115,
					"content": "버섯 고기는 함부로 먹으면 안 돼!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				},
				{
					"id": 710570117,
					"content": "그, 그러네. 정신 상태도 안 좋아 보이고, 안색도… 엄청 이상하잖아. 설마 버섯 고기를 먹어서 저렇게 된 건 아니겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710570118,
					"content": "버섯 고기? 헤헤헤, 버섯 고기가 얼마나 맛있는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570119
					],
					"speakerTitle": "하 씨"
				},
				{
					"id": 710570119,
					"content": "자, 내가 버섯 고기 좀 줄게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570120
					],
					"speakerTitle": "하 씨"
				},
				{
					"id": 710570120,
					"content": "헤헤헤, 버섯 고기…. 응? 아니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570121
					],
					"speakerTitle": "하 씨"
				},
				{
					"id": 710570121,
					"content": "왜 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710570122,
					"content": "버섯 고기가, 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570123
					],
					"speakerTitle": "하 씨"
				},
				{
					"id": 710570123,
					"content": "그럼 버섯 고기는 일단 놔두고 함께 야영지에 돌아가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710570124,
					"content": "안 돼, 버섯 고기가 없다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570125
					],
					"speakerTitle": "하 씨"
				},
				{
					"id": 710570125,
					"content": "버섯 고기가 없으면 걸을 힘이 없어, 난 아무 데도 안 갈 거야…. 버섯 고기가 없으면… 여긴 먹을 수 있는 게 아무것도 없다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570126
					],
					"speakerTitle": "하 씨"
				},
				{
					"id": 710570126,
					"content": "버섯 고기가 있으면 어디든 갈 수 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570127
					],
					"speakerTitle": "하 씨"
				},
				{
					"id": 710570127,
					"content": "그… 그럼 그 버섯 고기가 어디 있는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710570128,
					"content": "버섯 고기… 헤헤헤… 난 버섯 고기가 어디 있는지 알아. 버섯 고기를 구해서 먹자, 그럼 기운이 날 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570129
					],
					"speakerTitle": "하 씨"
				},
				{
					"id": 710570129,
					"content": "바로 근처에 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570130
					],
					"speakerTitle": "하 씨"
				},
				{
					"id": 710570130,
					"content": "#어쩔 수 없네, {NICKNAME}, 일단 버섯 고기를 찾아서 먹게 해주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710570131,
					"content": "그 방법밖에 없겠네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570132
					]
				},
				{
					"id": 710570132,
					"content": "버섯 고기… 헤헤헤… 커다란 버섯 고기…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하 씨"
				},
				{
					"id": 710570116,
					"content": "위험한 음식을 함부로 먹으면 안 돼!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				}
			]
		},
