					"nextDialogs": [
						705120702
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120702,
					"content": "근데 지금 여기엔 과거의 환영뿐이잖아. 다른 위험은 없는 것 같은데?",
					"roleType": "TALK_ROLE_NPC",
