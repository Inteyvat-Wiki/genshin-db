			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아델린"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120201,
					"content": "안녕하세요. 오랜만이네요. 여전히 기운 넘치시는군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120202
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120202,
					"content": "아델린 하녀장, 안녕!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120203,
					"content": "다이루크 어르신에게 중요한 볼일이 있으신 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120204,
						705120205
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120204,
					"content": "포도 주스 때문에요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				},
				{
					"id": 705120206,
					"content": "응, 아델린이 입구에 서 있으니까, 그냥 아델린에게 부탁하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120207,
					"content": "아델린, 우리가 매번 다운 와이너리의 특가 포도 주스를 놓쳐서, 이번엔 일찍 예약하러 왔어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120208,
					"content": "예약금을 더 지불해도 좋으니까, 한 병만 남겨주라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120209,
					"content": "물론이죠. 예약금은 지불 안 하셔도 됩니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120210
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120210,
					"content": "다만, 조금 기다리셔야 해요. 다운 와이너리의 특가 포도 주스는 준비하는 데 시간이 좀 걸리거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120211
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120211,
					"content": "매년 여름이면 다이루크 어르신께서 특가 포도 주스에 들어갈 품질 좋은 포도를 직접 두 통 정도 고르세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120212
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120212,
					"content": "왜 좋은 걸 저가에 파는 거야? 「품질 좋은 포도」면 엄청 비쌀 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120213,
					"content": "어르신이 명확하게 말씀하신 적은 없지만, 제가 추측하자면——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120214
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120214,
					"content": "특가는 일종의 수단일 뿐이죠. 특가 상품에는 손님이 몰리기 마련이니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120215
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120215,
					"content": "어르신은 이런 방법으로 주스를 유행시켜서 사람들에게 새로운 음료를 즐길 기회를 제공하시려는 거겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120216
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120216,
					"content": "주당들은 이상적인 대체품을 찾았으니 취해서 술주정을 부리는 일이 없을 테고, 술을 못 마시는 분은 색다른 재미를 느낄 수 있죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120217,
						705120218
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120217,
					"content": "와이너리 매출이 줄지 않을까요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120219,
					"content": "어르신은 푼돈을 신경 쓰시는 분이 아니세요. 수익을 무한대로 늘리기보다, 사람들이 적당히 음주를 즐기는 것을 원하실 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120220
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120220,
					"content": "술과 삶을 즐기는 동시에 이성을 잃지 않고 타인에게 피해 주지 않는다면… 정말 좋지 않겠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120221
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120221,
					"content": "다이루크 어르신도 참 고생하는구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120222
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120222,
					"content": "그래서 다이루크는 지금 올해의 포도를 고르는 중이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120223
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120223,
					"content": "아직이에요. 처리하던 성가신 일을 끝내시면 바로 시작하실 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120224
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120224,
					"content": "혹시 관심 있으시면, 어르신이 두 분을 초대해서 조언을 구할지도 모르겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120225
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120225,
					"content": "성가신 일이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120226
					]
				},
				{
					"id": 705120226,
					"content": "아시다시피, 어르신은 무례하고 부도덕한 자들이 왔다는 소문을 듣고 미리 그들을 「응대」하러 가시곤 해요. 이번에도 마찬가지고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120227
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120227,
					"content": "오늘은 아마도 매의 해안 근처로 가셨을 거예요. 조급해하지 마시고, 일단 와이너리에 앉아서 기다려주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120228
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120228,
					"content": "전 입구에서 손님을 맞이해야 하니, 하일리와 모코가 안내해 드릴 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120229
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120229,
					"content": "부도덕… 무례? 아델린의 말이 무슨 뜻인지 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120230,
						705120234
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120230,
					"content": "다이루크 씨가 하는 「아르바이트」를 말하는 게 아닐까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120231
					]
				},
				{
					"id": 705120231,
					"content": "뭐? 설마 다크…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120232
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120232,
					"content": "크흠! 다크한 심연 교단을 상대하는 일 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120233
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120233,
					"content": "다이루크 어르신의 동료로서 가만히 있을 수 없지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120238,
					"content": "두 분이 도와주시는 것도 좋지요. 어르신이 신뢰하시는 실력 있는 분들이니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120239
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120239,
					"content": "두 분의 도움에 감사드려요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120240
					],
					"speakerTitle": "아델린"
				},
				{
					"id": 705120240,
					"content": "천만에! 다이루크 어르신이 빨리 한가해져야 맛있는 포도 주스를 마실 수 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120241
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120241,
					"content": "#가자, {NICKNAME}, 매의 해안으로 출발!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120234,
					"content": "그럼 와이너리에서 다이루크 씨를 기다리자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120235
					]
				},
				{
					"id": 705120235,
					"content": "음, 다이루크는 바쁜데 우린 집에서 가만히 기다리는 건 좀 아닌 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120236
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120236,
					"content": "역시 매의 해안으로 가서 성가신 일을 해결해 주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120237
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120237,
					"content": "다이루크 어르신이 강하긴 해도, 도와주는 사람은 많을수록 좋잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120238
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120218,
					"content": "사업을 확장한 건가요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120219
					]
				},
				{
					"id": 705120205,
					"content": "중요한 볼일까진 아니에요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120206
					]
				}
			]
		},
		{
			"id": 7051204,
			"completionStepIds": [
				7051204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051204",
							"2"
						],
						"stepId": 7051204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 705120401,
					"content": "다이루크의 텐트가 아닌 것 같아. 모험가의 야영지일까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120402,
					"content": "저기 쪽지랑 수첩이 있는데? 읽어보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120403,
					"content": "「다크 히어로」에게, 그때의 이상 현상이 다시 나타났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120404
					],
					"speakerTitle": "조사"
				},
				{
					"id": 705120404,
					"content": "네가 문제를 완벽하게 해결했지만, 지맥에 또다시 어떠한 자극이 가해져 기록 속의 마물이 다시 풀려난 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120405
					],
					"speakerTitle": "조사"
				},
				{
					"id": 705120405,
					"content": "넌 가장 먼저 달려와서 제일 위험한 마물을 처리하겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120406
					],
					"speakerTitle": "조사"
				},
				{
					"id": 705120406,
					"content": "난 행동 수칙에 따라 중요 관계자에게 연락할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120407
					],
					"speakerTitle": "조사"
				},
				{
					"id": 705120407,
					"content": "음… 쪽지의 말투를 봐선, 다이루크와 아는 사람 같아. 일단 「어르신의 친구」라고 부르자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120408,
					"content": "그는 여기서 뭔가 엄청난 일을 발견하고, 다이루크 어르신에게 쪽지를 남기고 가버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120409,
					"content": "너무 부주의하잖아. 다른 사람이 쪽지를 발견하면 어쩌려고? 그리고 수첩도 안 가져갔어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120410,
					"content": "그렇다면, 해안에 있는 이상한 지맥 침적 포인트가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120411,
					"content": "방금 언급된 「이상 현상」이겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120412
					]
				},
				{
					"id": 705120412,
					"content": "주변엔 마물도 없고, 이상한 점도 없는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120413,
					"content": "#{NICKNAME}, 어르신 친구의 수첩을 읽어볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120414,
					"content": "읽고 싶지 않으면, 바로 거기로 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
