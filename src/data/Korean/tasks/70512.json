			"dialogs": [
				{
					"id": 705120501,
					"content": "으악! 마물이 이렇게나 많이 나타나다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120502,
					"content": "잠깐만… 저건 다이루크 어르신?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120503,
					"content": "평소의 다이루크랑 좀 다르네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120504,
					"content": "날카롭고 의욕 넘치는 모습이야! 이게 바로 최대 화력의 「정의의 사도」인가 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120505,
						705120506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120505,
					"content": "예전에 여기서 전투했던 모습이겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				},
				{
					"id": 705120507,
					"content": "그렇네. 자세히 보니까 이 다이루크는 조금 더 젊어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120508,
					"content": "근데 이곳에서 무슨 일이 있었던 걸까? 다이루크는 왜 여기서 싸운 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120509
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120509,
					"content": "음. 나중에 본인에게 물어보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120510
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120510,
					"content": "#{NICKNAME}, 이제 어떡하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705120511,
						705120512
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120511,
					"content": "섣불리 행동하면 안 돼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120513,
					"content": "좋아. 그럼 다이루크의 예전 전투 스타일을 관찰해 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705120512,
					"content": "일단 지켜보자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120513
					]
				},
				{
					"id": 705120506,
					"content": "지맥이 당시의 상황을 기록하고 재현한 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705120507
					]
				}
			]
		},
