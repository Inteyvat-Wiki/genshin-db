			"dialogs": [
				{
					"id": 223030301,
					"content": "일단 리월의 방식으로 이 민들레를 빚을 수 있을지 한번 해보지 뭐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030302
					],
					"speakerTitle": "덕귀"
				},
				{
					"id": 223030302,
					"content": "참, 이걸 받게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030303
					],
					"speakerTitle": "덕귀"
				},
				{
					"id": 223030303,
					"content": "이 민들레로 술을 빚으려면 분명 몇 번은 실패할 거야. 민들레가 다 떨어지면 그때 또 부탁하겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "덕귀"
				}
			]
		}
	]
