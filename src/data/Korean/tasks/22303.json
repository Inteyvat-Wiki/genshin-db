					"덕귀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223030101,
					"content": "장사하기가 점점 어려워지는군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030102
					],
					"speakerTitle": "덕귀"
				},
				{
					"id": 223030102,
					"content": "무슨 일이죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030103
					]
				},
				{
					"id": 223030103,
					"content": "응? 아, 내 말은 가게 장사가 점점 어려워진다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030104
					],
					"speakerTitle": "덕귀"
				},
				{
					"id": 223030104,
					"content": "우리처럼 숙식을 모두 제공하는 가게는 장사를 오래 하면 좋은 점도 있고 나쁜 점도 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030105
					],
					"speakerTitle": "덕귀"
				},
				{
					"id": 223030105,
					"content": "좋은 점은 장사한 시간이 길었던 만큼 명성도 얻고, 명성이 높아지면 자연스럽게 돈도 많이 벌게 되는 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030106
					],
					"speakerTitle": "덕귀"
				},
				{
					"id": 223030106,
					"content": "나쁜 점은 음식이 한정적이라는 거야. 만약 가게가 커서 종류가 많으면 상관없지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030107
					],
					"speakerTitle": "덕귀"
				},
				{
					"id": 223030107,
					"content": "우린 큰 음식점도 아니고 조그만 술집이라서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030108
					],
					"speakerTitle": "덕귀"
				},
				{
					"id": 223030108,
					"content": "단골손님들도 점점 음식에 질려 방문을 줄이고 있으니, 에휴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030109
					],
					"speakerTitle": "덕귀"
				},
				{
					"id": 223030109,
					"content": "몬드성은 주류업도 굉장히 발달했다고 하던데, 민들레로 빚은 「민들레주」가 아주 유명해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030110
					],
					"speakerTitle": "덕귀"
				},
				{
					"id": 223030110,
					"content": "민들레로 정말 술을 빚을 수 있는진 모르겠지만 나도 한번 빚어봐야겠구먼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030111
					],
					"speakerTitle": "덕귀"
				},
				{
					"id": 223030111,
					"content": "몬드에 가서 민들레 좀 가져다주겠나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030112,
						223030114
					],
					"speakerTitle": "덕귀"
				},
				{
					"id": 223030112,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030113
					]
				},
				{
					"id": 223030113,
					"content": "그럼 부탁하네. 보수는 제대로 드릴 테니. 우리 리월 사람들은 한번 뱉은 말은 꼭 지키니 걱정 말게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "덕귀"
				},
				{
					"id": 223030114,
					"content": "민들레주라…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030115
					]
				},
				{
					"id": 223030115,
					"content": "왜? 술맛이 이상한가? 내가 듣기론 몬드 사람들이 엄청 좋아한다던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030116
					],
					"speakerTitle": "덕귀"
				},
				{
					"id": 223030116,
					"content": "하지만 민들레주의 레시피를 베끼는 것 만으론 분명히 안 팔릴 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030117
					],
					"speakerTitle": "덕귀"
				},
				{
					"id": 223030117,
					"content": "일단 <color=#00E1FFFF>민들레</color>를 좀 가져와 주게. 그 뒤에 리월 방식으로 술을 빚을 수 있나 보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "덕귀"
				}
			]
		},
