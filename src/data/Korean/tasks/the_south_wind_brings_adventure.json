					"잭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110401,
					"content": "헉… 헉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110402
					],
					"speakerTitle": "스탠리"
				},
				{
					"id": 101110402,
					"content": "방금 전엔 죽는 줄 알았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110403
					],
					"speakerTitle": "잭"
				},
				{
					"id": 101110403,
					"content": "진짜 아슬아슬했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110404
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101110404,
					"content": "참, 네가 모험가 잭이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110405
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101110405,
					"content": "응, 근데 넌 누구야…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110406
					],
					"speakerTitle": "잭"
				},
				{
					"id": 101110406,
					"content": "우린 널 만나러 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101110407,
					"content": "엘린이 너한테 말 좀 전해주라고 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110408
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101110408,
					"content": "윽… 그랬구나. 여기 오게 한 것도 미안한데…. 날 구해주기까지 하다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110409
					],
					"speakerTitle": "잭"
				},
				{
					"id": 101110409,
					"content": "하! 오지랖은! 구해줄 필요도 없었어. 설마 이 스탠리가 이런 쉬운 일조차 처리 못 했겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110410
					],
					"speakerTitle": "스탠리"
				},
				{
					"id": 101110410,
					"content": "와, 당신이 바로 「잿더미 바다」에 발을 디뎠다는, 몬드에서 모르는 사람이 없다는 그 대모험가!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101110411,
					"content": "그래, 내가 바로 스탠리야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110412
					],
					"speakerTitle": "스탠리"
				},
				{
					"id": 101110412,
					"content": "하하, 이렇게 전설적인 인물을 만나게 되다니 영광이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110413
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101110413,
					"content": "그럼 다들 이제 어떻게 할 생각이야? 더 가볼까? 아니면 돌아갈까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110414,
						101110417
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101110414,
					"content": "스탠리 씨 생각은 어때요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110415
					]
				},
				{
					"id": 101110415,
					"content": "#하하하, {F#아가씨}{M#젊은이}, 너희와 함께하는 사람은 몬드에서 이름을 떨친 대탐험가 스탠리라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110416
					],
					"speakerTitle": "스탠리"
				},
				{
					"id": 101110416,
					"content": "돌아갈 필요가 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "스탠리"
				},
				{
					"id": 101110419,
					"content": "만장일치, 그럼 계속 전진~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "벤티"
				},
				{
					"id": 101110417,
					"content": "잭 씨는 어떻게 생각해요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110418
					]
				},
				{
					"id": 101110418,
					"content": "앞으로 가보자. 스탠리 씨가 계시니 문제없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "잭"
				}
			]
		},
		{
			"id": 1011106,
			"completionStepIds": [
				1011106
			],
