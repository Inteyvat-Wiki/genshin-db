				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110601,
					"content": "여행자, 내가 뭘 좀 발견했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110602
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101110602,
					"content": "탐지기 좀 가동해 볼 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110603
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101110603,
					"content": "엥? 스탠리한테도 「상상 속 친구」가 있다고?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101110604,
					"content": "온몸이 상처투성이고 표정도 아주 강인한 거로 봐서 그의 친구는 오랫동안 전장을 누빈 전사 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110605,
						101110608
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101110605,
					"content": "스탠리 씨가 묘사한 자신의 모습 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110606
					]
				},
				{
					"id": 101110606,
					"content": "상상 속 친구가 설마 이상화된 자신의 모습인 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110607
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101110607,
					"content": "재미있네. 이럴 수가 있는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101110611,
					"content": "그럼, 난 먼저 갈게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110612
					],
					"speakerTitle": "스탠리"
				},
				{
					"id": 101110612,
					"content": "스탠리 씨, 안녕히 가세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110613
					],
					"speakerTitle": "잭"
				},
				{
					"id": 101110613,
					"content": "너희 시간 좀 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110614
					],
					"speakerTitle": "잭"
				},
				{
					"id": 101110614,
					"content": "응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110615
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101110615,
					"content": "사실 며칠 전에 스탠리 씨께서 술에 취해 엄청난 비밀을 말해주셨거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110616
					],
					"speakerTitle": "잭"
				},
				{
					"id": 101110616,
					"content": "모험하실 때 사용하셨던 무기가 영웅 바네사의 유물인 <color=#00E1FFFF>「눈부신 용기의 검」</color>과 <color=#00E1FFFF>「빛나는 의지의 방패」</color>라는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110617
					],
					"speakerTitle": "잭"
				},
				{
					"id": 101110617,
					"content": "못 믿겠지만, 이 무기가 지금 몬드 <color=#00E1FFFF>타타우파 협곡</color>에 숨겨져 있대!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110618
					],
					"speakerTitle": "잭"
				},
				{
					"id": 101110618,
					"content": "너희 실력 좋잖아. 나랑 같이 이 무기를 찾으러 가지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110619,
						101110621
					],
					"speakerTitle": "잭"
				},
				{
					"id": 101110619,
					"content": "그렇게 대단한 무기가 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110620
					]
				},
				{
					"id": 101110620,
					"content": "물론이지! 스탠리 씨가 사용한 거잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "잭"
				},
				{
					"id": 101110623,
					"content": "나 자신을 증명할 만큼 대단한 무언가를 발견한다면, 식구들이 모험가가 되는 걸 응원해줄지도 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110624
					],
					"speakerTitle": "잭"
				},
				{
					"id": 101110624,
					"content": "지금 난 아직 능력이 부족한 초짜잖아. 게다가 부모님도 내 꿈을 반대하시거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110625
					],
					"speakerTitle": "잭"
				},
				{
					"id": 101110625,
					"content": "그러니까 부탁할게. 나 좀 도와줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110626
					],
					"speakerTitle": "잭"
				},
				{
					"id": 101110626,
					"content": "사적인 욕심을 스탠리 씨께 말씀드릴 수 없었어…. 하지만 다 쓰면 바로 돌려드릴 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110627
					],
					"speakerTitle": "잭"
				},
				{
					"id": 101110627,
					"content": "불쌍하다…. 이봐, 우리가 도와주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110628,
						101110629
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101110628,
					"content": "좋아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110630,
					"content": "벤티는?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110631
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101110631,
					"content": "그게… 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110632
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 101110632,
					"content": "재작년에 진귀한 명주를 구해놨거든. 신기만 찾을 수 있게 도와주면 그걸 넘길게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110633
					],
					"speakerTitle": "잭"
				},
				{
					"id": 101110633,
					"content": "<color=#00E1FFFF>타타우파 협곡</color>이라고 했지?! 꾸물거리지 말고 지금 바로 출발하자!",
