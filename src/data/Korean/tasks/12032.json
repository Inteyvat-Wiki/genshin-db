			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"라이덴 쇼군",
					"야에 미코"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120320101,
					"content": "이제부터 이나즈마는 더 많은 도전에 마주해야겠지. 하지만 마음의 준비는 끝냈어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320102,
						120320107,
						120320112,
						120320117,
						120320122,
						120320128
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120320102,
					"content": "「도전」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320103
					]
				},
				{
					"id": 120320103,
					"content": "쇄국령 폐지에 연루된 일이 너무 많아. 긍정적인 효과만 있고 피해가 아예 없다고는 할 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320104
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120320104,
					"content": "예를 들어 지금 예측할 수 있는 건, 바깥세상이 이나즈마의 상업에 미칠 영향 같은 문제들이 있어. 다 내가 이제부터 처리할 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320105
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120320105,
					"content": "에이는 진짜 진지하네. 난 나루카미 다이샤 티켓 판매 같은 일만 생각했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320106
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120320106,
					"content": "너어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120320107,
					"content": "신의 주목에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320108
					]
				},
				{
					"id": 120320108,
					"content": "마코토의 시선은 줄곧 이나즈마 사람에게 있었어. 그게 마코토의 책임인 줄 알았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320109
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120320109,
					"content": "하지만 지금 보니, 그 주목은 칭찬과 기대가 어린 시선이야. 책임을 제외해도 마코토는 즐거웠을 거야. 마코토는 인간을 사랑하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320110
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120320110,
					"content": "과거의 사람은 주목할만하지. 지금과 미래의 사람도 똑같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320111
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120320111,
					"content": "응, 이제 그들의 열정과 꿈을 무시하지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120320112,
					"content": "몇백 년의 전투에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320113
					]
				},
				{
					"id": 120320113,
					"content": "솔직히 말하자면, 그건 끝이 안 보이는 고통이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320114
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120320114,
					"content": "끝없는 전투에서 언제나 집중해야 했지. 조금만 경계를 풀면 쇼군의 검이 내 목숨을 가져갔을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320115
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120320115,
					"content": "만약 이전의 경험과 검의 힘이 없었다면, 난 분명 졌을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320116
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120320116,
					"content": "승리엔 네 덕도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120320117,
					"content": "신성한 벚나무의 상처에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320118
					]
				},
				{
					"id": 120320118,
					"content": "걱정하지 마. 잊지 않았으니까. 텐료 봉행과 야시로 봉행에 당부할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320119
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120320119,
					"content": "마물의 위협 외에도, 신성한 벚나무에서 다른 게 흘러나올까 봐 걱정했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320120
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120320120,
					"content": "그거야 모르지. 지맥에는 기억 외에도 다른 것들이 많으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320121
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120320121,
					"content": "너도 알면 게으름 피우지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120320122,
					"content": "야에 미코 씨가 얘기하길, 미코 씨의 신이…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320123
					]
				},
				{
					"id": 120320123,
					"content": "응? 누가 내 앞에서 헛소리를 지어내지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320124
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120320124,
					"content": "어떤 말은 다시 말하면 안 된다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320125
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120320125,
					"content": "날 팔아먹으면 무슨 대가가 따르는지 알고 싶지 않겠지. 내 말은 우리만의 비밀로 남겨두자고. 알겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320126
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120320126,
					"content": "무슨 얘기를 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320127
					],
					"speakerTitle": "라이덴 쇼군"
				},
				{
					"id": 120320127,
					"content": "아무것도 아니야. 유부가 먹고 싶어졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 120320128,
					"content": "더 이상 궁금한 건 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}