			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"산고"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720501,
					"content": "와카무라사키는 만나봤어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720502
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720502,
					"content": "「사방팔방의 그물」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720503
					]
				},
				{
					"id": 726720503,
					"content": "「사방팔방의 그물」… 이름은 좋은데, 그 술식은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720504
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720504,
					"content": "그 술식, 정말 사람의 외형을 잡아낼 수 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720505
					]
				},
				{
					"id": 726720505,
					"content": "음… 불가능하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720506
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720506,
					"content": "그런 음양술은 기록만 있을 뿐 구체적인 발동 방식은 아주 오래전에 실전됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720507
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720507,
					"content": "내가 와카무라사키에게 준 술식은 동물의 외형밖에 잡아낼 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720508
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720508,
					"content": "근데 왜 와카무라사키에게는…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720509
					]
				},
				{
					"id": 726720509,
					"content": "그건 말이지. 와카무라사키가 나 대신 소문을 퍼트리게 하기 위해서야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720510
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720510,
					"content": "「만능 산고 탐정소의 사장, 카무나 음양술을 이용해 진실만을 말하게 하는 그물을 만들다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720511
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720511,
					"content": "실전된 지 오래된 카무나 음양술, 만능 산고 탐정소. 그리고 동물의 외형을 확실히 잡아내는 그물",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720512
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720512,
					"content": "이런 요소들이 합쳐지면 그럴싸한 「도시 전설」이 만들어지기에 충분하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720513
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720513,
					"content": "이런 「도시 전설」은 일반인에게는 조그만 가십거리일 뿐이지만… 뒤가 구린 범인들에게는 단순한 전설이 아니지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720514
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720514,
					"content": "그렇군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720515
					]
				},
				{
					"id": 726720515,
					"content": "또 다른 이유는… 와카무라사키가 계속 나한테 「아주 강력한 음양술식」을 달라고 귀찮게 하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720516
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720516,
					"content": "없다고 해도 믿지 않고. 어쩔 수 없이 그 음양술식을 와카무라사키에게 줬지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720517
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720517,
					"content": "만약 와카무라사키가 이 일을 남에게 알리지 않는다면?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720518
					]
				},
				{
					"id": 726720518,
					"content": "그건 걱정하지 않아도 돼. 그 녀석이 입이 가볍다는 걸 난 너~어~무 잘 알고 있거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720519
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720519,
					"content": "이건 수고해 준 답례야. 받아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720520
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720520,
					"content": "와카무라사키가 이제 날 귀찮게 하지 않았으면 좋겠어. 난 탐정이지 음양사가 아니거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "산고"
				}
			]
		},
