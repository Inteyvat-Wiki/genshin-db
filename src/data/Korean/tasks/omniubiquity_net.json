				"points": []
			},
			"dialogs": [
				{
					"id": 726720101,
					"content": "와카무라사키 녀석… 카게로마루의 일은 그녀에게 비밀로 했어야 했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720102
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720102,
					"content": "왜 그래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720103
					]
				},
				{
					"id": 726720103,
					"content": "여행자구나. 「사방의 그물」 기억하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720104
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720104,
					"content": "지난번 사건을 해결 후에, 너의 일을 내 친구한테 들려줬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720105
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720105,
					"content": "그녀의 이름은 와카무라사키. 음… 자칭 「디자이너」야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720106
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720106,
					"content": "와카무라사키 녀석이 네가 그물을 다루는 방식을 듣고 힌트를 얻은 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720107
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720107,
					"content": "「사방의 그물」을 개조할 수 있게 나한테 새로운 술식을 찾아달라며 조르기 시작했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720108
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720108,
					"content": "그래서 어쩔 수 없이 그 옛 서적에서 새로운 술식을 찾아줬어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720109
					],
					"speakerTitle": "산고"
				},
				{
					"id": 726720109,
					"content": "관심 있으면 와카무라사키에게 한번 가봐. 어쩌면 이미 그물을 업그레이드했을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "산고"
				}
			]
		},
		{
			"id": 7267202,
			"completionStepIds": [
				7267202
