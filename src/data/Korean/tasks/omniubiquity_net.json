				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720201,
					"content": "이제 거의 다 완성한 것 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720202
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720202,
					"content": "혹시 와카무라사키 씨인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720203
					]
				},
				{
					"id": 726720203,
					"content": "맞아, 나한테 무슨 볼일이라도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720204
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720204,
					"content": "「사방의 그물」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720205
					]
				},
				{
					"id": 726720205,
					"content": "어? 기억났어. 넌 그 여행자지? 산고한테 들은 적 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720206
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720206,
					"content": "네가 「사방의 그물」을 다루는 방식은 정말 기발해. 많은 힌트가 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720207
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720207,
					"content": "그물을 개조하고 있다고 들었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720208
					]
				},
				{
					"id": 726720208,
					"content": "맞아. 헤헤… 산고가 새로운 음양술식을 줬거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720209
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720209,
					"content": "그 술식으로 다시 그물을 업그레이드했어. 이름은 「사방팔방의 그물」이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720210
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720210,
					"content": "산고가 말하길 이 술식은 생물의 외형을 잡아낸 후, 물질을 매개체로 그 생물의 형체를 만들어낼 수 있다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720211
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720211,
					"content": "산고가 이 음양술식의 효과가 극치에 이르면, 사람의 외형까지 잡아낼 수 있다고 했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720212
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720212,
					"content": "잡은 사람의 외형은 질문에 대답할 수 있고, 절대 거짓말을 하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720213
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720213,
					"content": "이런 술식은 산고 같은 탐정에게는 최고의 아이템이라고 할 수 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720214
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720214,
					"content": "그래서 산고가 이 술식을 나한테 알려준 것 같아. 그물을 업그레이드할 때 도움이 되라고 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720215
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720215,
					"content": "아, 그리고! 네가 산고의 친구라서 말해주는 거야. 남한테 절대 말하면 안 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720216,
						726720217
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720216,
					"content": "가슴이 웅장해지네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				},
				{
					"id": 726720218,
					"content": "어… 아직…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720219
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720219,
					"content": "아무리 개조해도 현재로서는 동물한테만 사용할 수 있고 사람에게는 먹히지 않아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720220
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720220,
					"content": "여행자가 한번 사용해 봐, 어쩌면… 너의 사용 방식이 또 힌트가 되어 줄지도 모르니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720221
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720221,
					"content": "자, 이건 너한테 줄게. 그물의 이름은 「사방팔방의 그물」이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720222
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720222,
					"content": "빨리 그물을 동물한테 써봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720217,
					"content": "업그레이드는 성공했나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				}
			]
		},
		{
