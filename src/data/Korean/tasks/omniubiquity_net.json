				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720401,
					"content": "어때, 그물은 손에 맞아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720402
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720402,
					"content": "한 번 쓰니까 망가져 버렸어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720403
					]
				},
				{
					"id": 726720403,
					"content": "음… 그건 어쩔 수 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720404
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720404,
					"content": "내가 말했잖아. 술식은 동물의 외형을 잡아낼 수 있지만 외형을 보존하거나 다시 동물의 형체를 만들어내려면 또 다른 매개체가 필요하다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720405
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720405,
					"content": "나는 술식을 「사방팔방의 그물」 안에 융합했어. 외형를 보존하고 만들어내는 매개체가 바로 이 그물이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720406
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720406,
					"content": "어렵네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720407
					]
				},
				{
					"id": 726720407,
					"content": "쉽게 말하면, 한 장의 그물은 한 번만 쓸 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720408
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720408,
					"content": "내가 아직까지 해결하지 못 한 난제야. 매개체를 재활용하지 못하면 비용이 너무 많이 들어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720409
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720409,
					"content": "계속 연구해서 최대한 빨리 문제를 해결하도록 할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720410
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720410,
					"content": "「사방팔방의 그물」이 필요하다면 언제든지 날 찾아와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720411
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720411,
					"content": "그리고, 그… 이런 그물로는 비록 동물밖에 못 잡지만, 만드는 방식은 꽤 까다로워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720412
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720412,
					"content": "그래서 말인데… 헤헤, 다음에 그물이 필요하게 되면 「재료비」 정도는 줬으면 하는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720413
					],
					"speakerTitle": "와카무라사키"
				},
				{
					"id": 726720413,
					"content": "걱정 마! 넌 산고의 친구니까. 절대 바가지는 안 씌워. 가격은 정말 합리적일 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "와카무라사키"
				}
			]
		},
