			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746680101,
					"content": "어라? 방금 일곱신상이 갑자기 엄청 빛나지 않았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746680102,
					"content": "이상하네. 전에도 이런 적이 있었던가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680103,
						746680105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746680103,
					"content": "일곱신상이 빛나는 건 정상적인 일이잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680107
					]
				},
				{
					"id": 746680107,
					"content": "#{NICKNAME}, 어디 불편한 데는 없지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680108,
						746680110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746680108,
					"content": "헉, 무, 물이 나한테 말을 한다…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680109
					]
				},
				{
					"id": 746680109,
					"content": "말하는 물이 있으면 참 좋겠네! 농담할 기분이 드는 걸 보니 아무 문제 없어 보여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746680112,
					"content": "그나저나 그 빛이 나온 후로 주변 공기가 조금 습해진 것 같아. 아까 방출된 물 원소의 힘 때문일까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746680113,
					"content": "흐흐, 폰타인에서는 원소의 힘을 잘 이용하면 물속을 헤엄칠 수 있다던데, 물속에 떨어진 보물을 찾을 수 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746680114,
					"content": "보물을 건지는 일은 네게 맡기고, 나는… 뭍에서 주변을 감시하고 있을게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680115,
						746680116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746680115,
					"content": "혼자 물속에 들어가면 외로울 거야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680117,
					"content": "윽, 하, 하지만 물속은 무섭단 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746680118,
					"content": "실수로 물살에 휩쓸려서 빙글빙글 돌아가면, 어지러워서 날지도 못할 거라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746680119,
					"content": "몬드에서 널 만나기 전처럼 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746680120,
					"content": "그럼 내가 또 건져주면 되지!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680121
					]
				},
				{
					"id": 746680121,
					"content": "…정말? 그, 그럼 같이 못 들어가 줄 것도 없지. 너, 방금 한 말 꼭 지켜야 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746680116,
					"content": "힘을 내봐, 페이몬!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680110,
					"content": "와! 아가미로 숨 쉴 수 있을 것 같아!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680111
					]
				},
				{
					"id": 746680111,
					"content": "그럼 먼저 아가미가 생겨야 되는 거 아냐? 흥, 기운이 넘치는 걸 보니 괜히 걱정했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746680105,
					"content": "물이 흘러나온 것 같지 않아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680106
					]
				},
				{
					"id": 746680106,
					"content": "일곱신상에서도 물이 흘러나오다니 역시 물의 신의 나라네…. 그보다 방금 그 빛은 아무리 생각해도 정상적인 반응이 아니었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680107
					],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
}