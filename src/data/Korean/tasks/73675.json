{
	"id": 73675,
	"type": "WQ",
	"name": "미래의 별이 추락한 곳",
	"description": "바누가 혼자 야외에서 무언가를 찾고 있다…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 5096,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
