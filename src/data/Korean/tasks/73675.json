			"order": 1,
			"listShowType": "QUEST_SHOW",
			"description": "바누와 대화하기",
			"finishConditions": [
				{
					"type": "QUEST_CONTENT_COMPLETE_TALK",
					"rawParams": [
						7367501,
						0
					],
					"talkId": 7367501
