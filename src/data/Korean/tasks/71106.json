			"dialogs": [
				{
					"id": 711060801,
					"content": "나 씨 아저씨! 대산이랑 같이 세 곳의 장치를 모두 조정했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711060802
