					"nextDialogs": [
						200040704
					]
				},
				{
					"id": 200040704,
					"content": "맞아! 그 이름이야, 아이고… 이름이 너무 길어서 외우기 힘들어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
