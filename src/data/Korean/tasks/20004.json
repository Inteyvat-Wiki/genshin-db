			"dialogs": [
				{
					"id": 200040301,
					"content": "너희들이 여긴 어쩐 일이야, 오랜만이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040302
					],
					"speakerTitle": "모나"
				},
				{
					"id": 200040302,
					"content": "뭐가 이렇게 급해, 무슨 일 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040303
					],
					"speakerTitle": "모나"
				},
				{
					"id": 200040303,
					"content": "모나, 너 어디에 있었던 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200040304,
					"content": "우리가 얼마나 찾아다녔는데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040305
					]
				},
				{
					"id": 200040305,
					"content": "그래? 《스팀버드사》에서 새로운 원고를 보내 달라고 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040306
					],
					"speakerTitle": "모나"
				},
				{
					"id": 200040306,
					"content": "이번 테마는 「별의 형상 변화와 개인의 운명 변화와의 관계」야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040307
					],
					"speakerTitle": "모나"
				},
				{
					"id": 200040307,
					"content": "원고를 쓰기 위해 며칠 동안 야외에서 별을 관측하느라고 밤늦게 집에 들어갔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040308
					],
					"speakerTitle": "모나"
				},
				{
					"id": 200040308,
					"content": "모나, 돈을 버느라 고생이 많구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200040309,
					"content": "이번에 폰타인에서 신형 천문 관측기를 출시한다고 해서 이미 예약금을 냈거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040310
					],
					"speakerTitle": "모나"
				},
				{
					"id": 200040310,
					"content": "이 작품의 원고료가 입금되는 대로 잔금을 치르면 정식으로 신형 천문 관측기를 받을 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040311
					],
					"speakerTitle": "모나"
				},
				{
					"id": 200040311,
					"content": "고트 씨한테 낼 월세는 남아있는 거야…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040312
					]
				},
				{
					"id": 200040312,
					"content": "월세?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040313
					],
					"speakerTitle": "모나"
				},
				{
					"id": 200040313,
					"content": "아…! 아, 아마 남겨뒀을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040314
					],
					"speakerTitle": "모나"
				},
				{
					"id": 200040314,
					"content": "잠깐만, 한번 찾아볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040315
					],
					"speakerTitle": "모나"
				},
				{
					"id": 200040315,
					"content": "(모나가 자신의 지갑을 뒤지기 시작한다…)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						200040316
					]
				},
				{
					"id": 200040316,
					"content": "이거랑… 이거랑! 이 정도면 월세 내기에는 충분할 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040317
					],
					"speakerTitle": "모나"
				},
				{
					"id": 200040317,
					"content": "(있는 돈 없는 돈 다 끌어모았네…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040318
					]
				},
				{
					"id": 200040318,
					"content": "이 돈을 고트 씨에게 좀 전해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "모나"
				}
			]
		},
