			"dialogs": [
				{
					"id": 760780101,
					"content": "보통 광란의 사냥과 함께 나타난 모든 마물을 소멸시키면, 그 부정한 기운도 사라집니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780102
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 760780102,
					"content": "하지만, 이 균열은 아직도 남아 있군요. 드문 상황이지만, 전례가 전혀 없는 건 아닙니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780103
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 760780103,
					"content": "아직 이곳에 오염된 무언가가 남아 있는 것 같군요. 주변을 좀 더 살펴봐야겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "플린스"
				}
			]
		},
		{
			"id": 7607802,
			"completionStepIds": [
				7607804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
