				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2423.771,
							211.958,
							9661.866
						],
						"pointId": 13639
					}
				]
			},
			"dialogs": [
				{
					"id": 760780201,
					"content": "저건, 등불이군요. 등지기에게는 아주 중요한 소지품이자, 광란의 사냥을 물리치는 데 반드시 필요한 물건이죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780202
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 760780202,
					"content": "등불은 여기에 남아 있지만, 등피에는 광란의 사냥 기운만 남아 있고, 그걸 들고 있던 사람은 보이지 않습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780203
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 760780203,
					"content": "안타깝지만, 이곳에서 무슨 일이 있었는지는 어느 정도 짐작할 수 있을 것 같군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780204
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 760780204,
					"content": "등지기의 희생은 때로 소리 없이 이루어집니다. 이렇게 예상치 못한 방식으로 동료의 죽음을 마주할 때마다 마음이 참 아프군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780205
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 760780205,
					"content": "…무명의 등지기여, 당신이 남긴 이 등불은 제가 맡겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780206
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 760780206,
					"content": "등은 깨끗이 정리되고, 불도 다시 밝혀져 노드크라이를 수호하기로 맹세한 다음 등지기에게 전해질 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780207
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 760780207,
					"content": "플린스는 등을 깨끗이 정리한 뒤, 신중하게 보관한다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780208
					]
				},
				{
					"id": 760780208,
					"content": "이게 바로 광란의 사냥이 완전히 사라지지 않은 이유인 것 같군요. 이 등불은 본부에서 사람이 와서 회수할 때까지 임시로 보관해야겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780209
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 760780209,
					"content": "…등불 밑에 뭔가 더 있는 것 같네요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780210
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 760780210,
					"content": "동료의 유품이군요. 등불과 함께 두는 게 좋겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "플린스"
				}
			]
		},
