				"points": []
			},
			"dialogs": [
				{
					"id": 230140101,
					"content": "선생님, 진심으로 충고하는데 돈을 벌 방법을 생각해 보는 게 좋을 것 같습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140102
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230140102,
					"content": "상인들은 다 날강도야! 그깟 인장 몇 개를 이런 말도 안 되는 가격에 팔아치우다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140103
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230140103,
					"content": "그건 선생님의 두 눈이 그 인장을 본 순간 너무 반짝였기 때문이 아닐까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140104
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230140104,
					"content": "그 인장으로 뭘 하려고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140105
					]
				},
				{
					"id": 230140105,
					"content": "여행자! 꼭 필요할 때 나타나는군!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140106
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230140106,
					"content": "저번에 자네가 도와준 덕에 쓸만한 윤활제를 만들어냈네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140107
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230140107,
					"content": "하지만 곧 다른 문제가 생겼지. 다시 부품을 제작하려고 보니… 단단한 재료로 만들면 서로 부딪혀 흠집을 내는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140108
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230140108,
					"content": "게다가 단단한 부품들은 조금만 충격을 가해도 바로 부서져 버렸지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140109
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230140109,
					"content": "그래서 경도와 유연성을 겸비한 재료를 찾기 시작했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140110
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230140110,
					"content": "끝없는 연구 끝에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140111
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230140111,
					"content": "그리고 아한가르 씨를 끊임없이 괴롭힌 끝에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140112
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230140112,
					"content": "보물 사냥단이 지닌 그… 인장을 내가 찾는 재료 대신 쓸 수 있을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140113
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230140113,
					"content": "하지만 상인들은 보물 사냥단과 똑같은 족속이더군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140114,
						230140115
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230140114,
					"content": "또 제가 나설 때인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				},
				{
					"id": 230140116,
					"content": "여행자의 이름을 「숫자 기계」에 새기고 싶어질 정도야. 정말 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230140115,
					"content": "제가 도와드릴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				}
			]
		},
