			"dialogs": [
				{
					"id": 230145001,
					"content": "선생님, 얼른 돈을 벌 수 있는 방법을 찾아야 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145002
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230145002,
					"content": "수메르성에 극장이 있다고 들었어요. 극단에는 계산 능력이 필요한 일이 있겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145003
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230145003,
					"content": "그리고 극단의 배우들은… 돈은 많지만, 자신의 재산을 어떻게 관리해야 하는지 전혀 모르죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145004
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230145004,
					"content": "이건 저희에게도 기회예요, 선생님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145005
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230145005,
					"content": "루통, 넌 계산과 장사에는 머리가 참 비상하다니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145006
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230145006,
					"content": "좀 더 생각해 봐야겠어… 좀 더…",
