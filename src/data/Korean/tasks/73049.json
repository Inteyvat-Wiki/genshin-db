				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730492501,
					"content": "이렇게 많은 사람들이 달려들었는데도… 이길 수가 없다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492502
					],
					"speakerTitle": "올레그"
				},
				{
					"id": 730492502,
					"content": "실험만 성공하면 바로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492503
					],
					"speakerTitle": "올레그"
				},
				{
					"id": 730492503,
					"content": "꿈 깨. 실험이 성공할 리가 없으니까. 카심이 말했어. 그 사피 뭔가 하는 장치로는 죽음의 땅의 에너지를 추출할 수 없다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730492504,
					"content": "그러니까 처음부터 너희들을 속인 거라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730492505,
					"content": "어떻게 이럴 수가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492506
					],
					"speakerTitle": "올레그"
				},
				{
					"id": 730492506,
					"content": "반성은 30인단 앞에서 해. 그리고 다시는 수메르에 오지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730492507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730492507,
					"content": "30인단의 전령관 루크 샤에게 알렸다.\\n루크 샤의 부하는 우인단을 압송했다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7304926,
			"completionStepIds": [
				7304926
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7304926",
							"2"
						],
						"stepId": 7304926,
						"stateName": "QUEST_STATE_UNFINISHED"
