	"talks": [
		{
			"id": 7304903,
			"completionStepIds": [
				7304903
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7304903",
							"2"
						],
						"stepId": 7304903,
