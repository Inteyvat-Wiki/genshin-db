					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"올레그",
					"카심",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730490317,
					"content": "#쉿, {NICKNAME}, 저기 좀 봐봐. 도금 여단과 우인단이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490301
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730490301,
					"content": "카심… 사피라 빛 장치는 제대로 작동하고 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490302
					],
					"speakerTitle": "올레그"
				},
				{
					"id": 730490302,
					"content": "제대로 작동하고 있어, 올레그",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490303
					],
					"speakerTitle": "카심"
				},
				{
					"id": 730490303,
					"content": "이건 이번 테스트 결과 보고서야. 이대로만 진행된다면 곧 너희 우인단이 원하는 물건을 얻을 수 있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490304
					],
					"speakerTitle": "카심"
				},
				{
					"id": 730490304,
					"content": "좋아. 하하하, 네가 있으니 곧 집행관님의 명령을 완수할 수 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490305
					],
					"speakerTitle": "올레그"
				},
				{
					"id": 730490305,
					"content": "하지만 만약 날 속인 거라면… 그 결과가 어떨지 알고 있겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490306
					],
					"speakerTitle": "올레그"
				},
				{
					"id": 730490306,
					"content": "널 속여서 내가 얻을 게 없잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490307
					],
					"speakerTitle": "카심"
				},
				{
					"id": 730490307,
					"content": "알면 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490308
					],
					"speakerTitle": "올레그"
				},
				{
					"id": 730490308,
					"content": "트로핀·스네즈비치 그 자식은 몇 년이 지나도록 아무런 성과도 내지 못했는데 난 이렇게나 빨리 성공했잖아. 이번엔 또 뭐라고 변명하는지 지켜보겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490309
					],
					"speakerTitle": "올레그"
				},
				{
					"id": 730490309,
					"content": "트로핀·스네즈비치… 수메르에서는 한 번도 들어보지 못한 이름인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490310
					],
					"speakerTitle": "카심"
				},
				{
					"id": 730490310,
					"content": "하하하, 당연하지. 본명을 사용했을 리가 없잖아. 신분을 바로 들킬 테니까… 집행관님이 그에게 임무를 맡긴 지 몇 년이나 됐는데 아직 아무런 진전도 없는 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490311
					],
					"speakerTitle": "올레그"
				},
				{
					"id": 730490311,
					"content": "…뭐야. 거, 거기 누구야? 여긴 어떻게 들어온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490312
					],
					"speakerTitle": "올레그"
				},
				{
					"id": 730490312,
					"content": "#앗, {NICKNAME}, 들켰다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730490313,
					"content": "…난 이만 가봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490314
					],
					"speakerTitle": "카심"
				},
				{
					"id": 730490314,
					"content": "흥, 그 대단한 우인단이 이름도 없는 모험가에게 당하진 않겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490315
					],
					"speakerTitle": "카심"
				},
				{
					"id": 730490315,
					"content": "그건 도금 여단의 사람이 신경 쓸 일은 아니지… 흥, 몰래 들어온 쥐새끼를 없애고 약속한 실험 야영지로 찾아갈게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730490316
					],
