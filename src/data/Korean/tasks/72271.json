			"dialogs": [
				{
					"id": 722710102,
					"content": "팔고 싶은 보물이 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710103
					]
				},
				{
					"id": 722710103,
					"content": "또 무슨 희귀한 걸 찾았어? 어디 한번 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710104
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 722710104,
					"content": "용 뼈의 꽃 결정의 이야기를 임랑에게 얘기한다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722710105
					]
				},
				{
					"id": 722710105,
					"content": "듣자 하니 진짜 대단한 골동품이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710106
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 722710106,
					"content": "다만 내가 살펴본 바로는 눈에 띄게 특별한 곳은 없는데, 오래 사용해야 하는 건가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710107
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 722710107,
					"content": "내가 보기에 네가 얘기한 신비한 효능은 과장됐거나… 단순한 실패자의 핑계일지도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710108
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 722710108,
					"content": "하하. 그냥 해본 얘기야. 진지하게 듣지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710122
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 722710122,
					"content": "우리 골동품 업계에서 이런 일은 흔해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710109
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 722710109,
					"content": "그리고 밀봉 보관하지 않은 것 같네. 대충 살펴보니 표면이 이미 훼손된 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710110
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 722710110,
					"content": "그래서 가격을 조금 더 내려야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710123
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 722710123,
					"content": "80000모라는 어때? 거기에다 특제 요리 풍요로운 한 해 5인분을 추가할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 722710111,
					"content": "분명 나쁘지 않은 가격일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710112,
						722710116,
						722710119
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 722710112,
					"content": "이걸로 뭐 하려고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710113
					]
				},
				{
					"id": 722710113,
					"content": "사실 난 효능보다 물건에 얽힌 이야기의 가치가 더 크다고 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710114
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 722710114,
					"content": "항구의 이야기꾼이나 극단, 어쩌면 옥경대의 귀인들이 이 물건에 관심을 가질지도 모르지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710115
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 722710115,
					"content": "가게 진열대에 전시만 해도 희귀한 골동품이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 722710116,
					"content": "적당한 가격이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710117
					]
				},
				{
					"id": 722710117,
					"content": "깔끔한 거래였어. 그럼 모라 잘 넣어둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710118
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 722710118,
					"content": "또 이런 물건을 얻으면 언제든지 가게로 찾아와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "임랑"
				},
				{
					"id": 722710119,
					"content": "생각해 볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710120
					]
				},
				{
					"id": 722710120,
					"content": "응. 이렇게 희귀한 보물은 여러 곳에서 비교할… 아니, 가격을 여러 곳에서 따져볼 만하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710121
					],
					"speakerTitle": "임랑"
				},
				{
					"id": 722710121,
					"content": "그럼 결정하면 다시 찾아와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "임랑"
				}
			]
