							"2"
						],
						"stepId": 7308102,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308103",
							"2"
						],
						"stepId": 7308103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"아란카비",
					"아란마"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730810301,
					"content": "아란마와 금빛의 나라네. 키가 너무 크다. 근데 그 옆에 은빛은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810302
					],
					"speakerTitle": "아란카비"
				},
				{
					"id": 730810302,
					"content": "음? 은빛이 왜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730810303,
					"content": "뭐랄까… 좁은 나무 구멍도 들어갈 수 있을 것 같아. 너무너무 편하겠다! 정말 잘됐어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810304
					],
					"speakerTitle": "아란카비"
				},
				{
					"id": 730810304,
					"content": "#나라의 관습에 따라 먼저 소개부터 할게! 이쪽은 나라{NICKNAME}, 페이몬이야. 여긴 아란카비. 서로 악수해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810305
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730810305,
					"content": "조금 어색하게 아란카비와 악수한다….\\n너무 세게 잡지는 못했다.\\n신기한 촉감이 느껴진다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730810306
					]
				},
				{
					"id": 730810306,
					"content": "흥미로워. 나라에 대한 얘기는 많이 들어봤지만, 나라와 접촉해 본 건 처음이야. 기분이 묘해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810307
					],
					"speakerTitle": "아란카비"
				},
				{
					"id": 730810307,
					"content": "나라가 여기에 온 건 참 오랜만이야. 많은 씨앗이 큰 나무로 자랐고, 많은 이야기가 전설로 남았지. 지난번에 왔던 나라는 아주 착한 나라였다고 들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810308
					],
					"speakerTitle": "아란카비"
				},
				{
					"id": 730810308,
					"content": "#나라{NICKNAME}도 좋은 나라야. 암벽에서 자라는 작은 나무처럼 용감하고 강해. 아란나를 돕기 위해 여기 온 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810309
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730810309,
					"content": "오오, 아란나… 못 본 지 오래됐네. 비마라 마을의 어린 나라들도 그렇고, 모두 잘 지냈으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810310
					],
					"speakerTitle": "아란카비"
				},
				{
					"id": 730810310,
					"content": "비마라 마을의 아이들을 알고 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810311
					]
				},
				{
					"id": 730810311,
					"content": "당연히 알지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810312
					],
					"speakerTitle": "아란카비"
				},
				{
					"id": 730810312,
					"content": "우린 다 알고 있어! 아란나가 돌아와서 어린 나라에 대한 이야기를 해줬거든. 나라이오탐, 나라바흐람, 나라나까지 모두 우리의 나라 친구야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810313
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730810313,
					"content": "그건 아는 사이라고 할 수 없는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730810314,
					"content": "그럼 어떻게 하면 아는 사이가 될 수 있어? 나라처럼 「소개」한 후 「악수」해야 할까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810315
					],
					"speakerTitle": "아란카비"
				},
				{
					"id": 730810315,
					"content": "음, 페이몬 말이 뭔지 알겠어. 나라는 같이 밥도 먹고, 「보물」도 함께 찾아야 아는 사이라고 할 수 있는 거야, 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810316,
						730810317,
						730810318
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730810316,
					"content": "그렇게 간단한 일은 아닌데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810321,
					"content": "아란나라는 이야기만 알아도 아는 사이라고 해. 아란나라의 세계는 노래의 세계이자 꿈의 세계이기 때문이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810322
					],
					"speakerTitle": "아란카비"
				},
				{
					"id": 730810322,
					"content": "#응, 아란카비의 말이 맞아. 아란나라에겐 나라{NICKNAME}을(를) 묘사한 노래를 듣거나, 꿈에서 나라{NICKNAME}의 모습을 봤다면 아는 사이라고 할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810323
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730810323,
					"content": "그건 나중에 따져도 될 것 같아… 왜냐면 우린 이미 아란나라의 친구니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810324
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730810324,
					"content": "좋은 친구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810325,
						730810327
					],
					"speakerTitle": "아란마와 아란카비"
				},
				{
					"id": 730810325,
					"content": "좋은 친구!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810328,
					"content": "응, 우리는 우트사바 축제를 열려고 해. 아란카비, 준비 잘 해야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810329
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730810329,
					"content": "역시, 비야의 열매를 위한 거지? 이미 아란야사, 아란다사, 아란슈드라카에게 「아슈바타 전당」을 찾아 달라고 부탁했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810330
					],
					"speakerTitle": "아란카비"
				},
				{
					"id": 730810330,
					"content": "육감 한번 정확하네… 근데 왜 아슈바타 전당이 어디 있는지는 몰라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810331
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730810331,
					"content": "아슈바타 전당은 아주 신성한 곳이라 평소에는 못 가. 모든 기억이 사르바에서 만날 때까지 바사라 나무가 조용히 잠들게 내버려 둬야 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810332
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730810332,
					"content": "숲이 모든 걸 기억할 거야. 모든 아름다운 것은 사라지지 않을 거고, 모든 고통은 아름다운 것의 영양소가 될 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810333
					],
					"speakerTitle": "아란카비"
				},
				{
					"id": 730810333,
					"content": "지금 아란야사, 아란다사, 아란슈드라카가 밖에서 아슈바타 전당을 찾고 있어. 아란마, 네가 가서 친구들을 도와줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810334
					],
					"speakerTitle": "아란카비"
				},
				{
					"id": 730810334,
					"content": "#응, 알겠어. 나라{NICKNAME}, 페이몬. 만약 숲에서 우리를 만나면 함께 모험을 떠나자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810335
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730810335,
					"content": "#좋아, 좋아. 만나서 반가웠어. 나라{NICKNAME} 그리고 페이몬!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란카비"
				},
				{
					"id": 730810327,
					"content": "본론으로 들어가자…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810317,
					"content": "뭐라고 설명해야 할까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810318,
					"content": "나랑 페이몬은 함께 밥도 먹고, 보물도 찾았어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810319
					]
				},
				{
					"id": 730810319,
					"content": "맞아! 우린 아는 사이일 뿐만 아니라 최고의 파트너이기도 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810320
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730810320,
					"content": "#나라{NICKNAME}, 페이몬. 참 좋겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810321
					],
					"speakerTitle": "아란마"
				}
			]
		},
		{
			"id": 7308104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
