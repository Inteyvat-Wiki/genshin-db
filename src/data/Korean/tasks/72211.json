					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110101,
					"content": "에츠코 씨 이제 어디를 탐사할까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110102
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722110102,
					"content": "후, 잠시만 쉬었다 하자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110103
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722110103,
					"content": "어? 너희, 무슨 볼일이라도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110104
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722110104,
					"content": "믿을만한 요리사에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110105
					]
				},
				{
					"id": 722110105,
					"content": "세이라이섬에서 요리사를 찾으시는 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110106
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722110106,
					"content": "사실은 네코가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722110107,
					"content": "그럼… 네코 님이 음식을 준비해달라고 부탁한 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110108
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722110108,
					"content": "아… 젠장! 내가 요리만 할 줄 알았다면!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110109
					],
					"speakerTitle": "타이유"
				},
				{
					"id": 722110109,
					"content": "그러면… 「이 식자재로 고양이가 좋아할 만한 음식을 하는」 요리사를 찾아야 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110110
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722110110,
					"content": "생각 좀 해볼게… 요리사라… 요리사…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110111
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722110111,
					"content": "아, 이나즈마성 「키미나미 요정」의 키미나미 안나 씨를 찾아가 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110112
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722110112,
					"content": "키미나미 씨는 사람도 착하고 요리 솜씨도 뛰어나서 도움을 줄 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110113
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722110113,
					"content": "고마워요, 지금 바로 가볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110114
					]
				},
				{
					"id": 722110114,
					"content": "천만에, 어서 가봐. 난 타이유랑 남아서 탐사 계획을 세워야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110115
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722110115,
					"content": "하하, 신사가 정말 활기차졌으면 좋겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110116
					],
					"speakerTitle": "에츠코"
				},
				{
					"id": 722110116,
					"content": "그래야 그간의 우리 노력이 헛되지 않을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "에츠코"
				}
			]
		},
		{
