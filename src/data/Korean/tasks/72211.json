			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"키미나미 안나",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110201,
					"content": "어서 오세요, 「키미나미 요정」입니다! 필요한 거 있으신가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110203
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 722110203,
					"content": "네코의 밥에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110204
					]
				},
				{
					"id": 722110204,
					"content": "「네코」? 고양이 이름 같네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110205
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 722110205,
					"content": "네코를 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722110206,
					"content": "앗, 아니요. 그냥 네코라는 이름이 고양이랑 어울려서요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110207
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 722110207,
					"content": "정말 무서운 직감이네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110208
					]
				},
				{
					"id": 722110208,
					"content": "일단 본론부터 말할게, 사실은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722110209,
					"content": "세이라이섬에는… 아사세 신사가 있는데, 신사 안에 말하는 고양이가 있다고요?! 그 고양이가 음식을 부탁했다고요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110210
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 722110210,
					"content": "에? 와! 정말이에요? 처음 들어보네요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110211,
						722110212
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 722110211,
					"content": "응, 정말이야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110213
					]
				},
				{
					"id": 722110213,
					"content": "세이라이섬이라고 했죠? 기회가 되면 꼭 가봐야겠네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110214
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 722110214,
					"content": "그… 네코 밥은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110215
					]
				},
				{
					"id": 722110215,
					"content": "아… 맞다, 내 정신 좀 봐… 생각 좀 해볼게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110216
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 722110216,
					"content": "음… 고양이가 좋아할 만한 음식이라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110217
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 722110217,
					"content": "어려워?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722110218,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110219
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 722110219,
					"content": "많, 많이 어려워?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110220
					]
				},
				{
					"id": 722110220,
					"content": "「키미나미」 가문의 새로운 도전이에요! 꼭 극복해야 해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110221
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 722110221,
					"content": "생선 살코기, 짐승고기, 해초, 쌀로 고양이들이 좋아할 만한 음식을 만들 수 있을 거 같네요, 저한테 맡겨주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110222
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 722110222,
					"content": "나, 나도 먹고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110223,
						722110224
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722110223,
					"content": "나도 먹고 싶네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
				{
					"id": 722110225,
					"content": "문제없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110226
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 722110226,
					"content": "레시피 좀 생각해 볼게요. 일단 해초 세 개만 부탁드려요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110227,
						722110229
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 722110227,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110228
					]
				},
				{
					"id": 722110228,
					"content": "그럼 부탁할게요. 해초 세 개만 있으면 되니까 찾으면 바로 가져다주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 722110229,
					"content": "어떻게 할지 생각났어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110230
					]
				},
				{
					"id": 722110230,
					"content": "아이디어가 좀 떠올랐는데, 아직 다 끝난 건 아니라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110231
					],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 722110231,
					"content": "일단 해초 세 개만 구해주세요, 부탁드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "키미나미 안나"
				},
				{
					"id": 722110224,
					"content": "그럼 부탁 좀 할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
