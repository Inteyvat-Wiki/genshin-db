				"points": []
			},
			"dialogs": [
				{
					"id": 412130601,
					"content": "드래곤의 힘과 생명력으로 말라 죽은 식물을 이렇게 부활시킬 수 있다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130602
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130602,
					"content": "정말 놀라워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130603
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130603,
					"content": "그냥 죽은 나무인 줄 알았는데 몬스터였다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130604,
					"content": "하마터면 먹힐 뻔했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130605
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130605,
					"content": "근데 왜 오늘 갑자기 이런 일이 생긴 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130606,
					"content": "아마 검이 땅에 떨어진 충격으로 힘이 유출돼서 그럴 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130607
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130607,
					"content": "내가 잘못했어. 제발 날 쫓아내지 말아줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130608
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 412130608,
					"content": "진짜 그냥 얌전히 있을게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130609
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 412130609,
					"content": "아, 팔라드 씨… 그렇게 버섯처럼 쭈그려 있지 마세요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130610
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130610,
					"content": "휴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130611
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130611,
					"content": "얼음 나무가 이런 곳에서 말라 죽다니, 오염된 힘은 흡수할 수 없는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130612
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130612,
					"content": "여행자는 오염된 걸 정화할 수 있지. 정화된 순수한 원소의 힘이 나무를 부활시키고 더 강하게 만들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130613
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130613,
					"content": "순수한 생명의 힘이 나무를 거듭 부활시킬 거야… 아무래도 앞으로 전투가 계속될 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130614,
						412130615
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130614,
					"content": "생각보다 훨씬 더 골치 아픈 일이 생겼네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				},
				{
					"id": 412130616,
					"content": "나도 이런 일은 처음이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130617
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130617,
					"content": "이렇게 보기 드문 상황도 예상치 못한 수확이라고 봐야겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130618
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130618,
					"content": "설탕",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130619
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130619,
					"content": "앗, 네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130620
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130620,
