					"알베도"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130501,
					"content": "소리가 들려서 와봤는데, 너희들이었구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130502
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130502,
					"content": "무슨 일이야? 누구랑 싸웠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130503
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130503,
					"content": "아, 알베도 님… 일부러 그런 게 아니에요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130504
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130504,
					"content": "설탕, 넌 자료 정리하고 있었잖아? 어째서 여기 있는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130505
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130505,
					"content": "게다가 추운 설원에서 이렇게 위험한 적과 싸우다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130506
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130506,
					"content": "나, 나도 같이 싸웠어. 미안…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130507
					]
				},
				{
					"id": 412130507,
					"content": "왜 나까지 미안해지는 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130508,
					"content": "으아아, 저, 전 그냥…. 죄송해요. 지나가다가 그만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130509
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130509,
					"content": "휴, 보아하니 또 흥미로운 물건을 찾았나 보군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130510
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130510,
					"content": "내가 설탕에게 검 이야기를 했어, 미안",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130511
					]
				},
				{
					"id": 412130511,
					"content": "전부 말해버린 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130512
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130512,
					"content": "검의 속성과 출처만 말하고 절대 못 만지게 했어! 그 정도 센스는 있다구~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130513
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130513,
					"content": "됐어, 어차피 곧 탄로 날 일이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130514
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130514,
					"content": "설탕은 지식과 비밀을 탐구하려는 정신이 강해. 연금술 연구에 적합한 인재지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130515
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130515,
					"content": "으아아… 다시는 폐 끼치지 않을게요! 제가 새로 개발한 씨앗이 4배 큰 달콤달콤꽃을 걸고 맹세해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130516
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130516,
					"content": "그런 뜻이 아니야. 너희가 다칠까 봐 걱정이지. 다음부턴 조심해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130517
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130517,
					"content": "아, 근데 저기 쭈그리고 있는 모험가는 뭐지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130518
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130518,
					"content": "방금 전 전투에서 제가 팔라드 씨를 보호했어요. 다치진 않았을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130519
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130519,
					"content": "추… 추워 죽겠다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130520
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 412130520,
					"content": "조금 전 전투 때문에 감기라도 걸렸나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130521
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130521,
					"content": "아아, 그건 생각 못 했어요…. 제가 부주의했어요, 죄송해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130522
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130522,
					"content": "알베도 님, 제가 상태를 보고 올게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130523
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130523,
					"content": "그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130524
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130524,
					"content": "고지식한 줄만 알았는데 마음이 따뜻한 아이였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130525
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130525,
					"content": "너보다 큰 사람한테 아이라고 하지 마",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130526
					]
				},
				{
					"id": 412130526,
					"content": "그건 맞네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130527
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130527,
					"content": "설탕 녀석, 조금만 방심하면 이상한 곳으로 가버리니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130528
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130528,
					"content": "이 나이대엔 다 그렇지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130529
					]
				},
				{
					"id": 412130529,
					"content": "그건 그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130530
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130530,
					"content": "설탕도 일부러 그런 거 아니니까 화내지 마",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130531
					]
				},
				{
					"id": 412130531,
					"content": "화 안 났으니까 걱정 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130532
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130532,
					"content": "응? 검에서 뭔가 반짝이고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130533
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130533,
					"content": "뭐? 또 변했구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130534
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130534,
					"content": "검의 힘이 전보다 훨씬 강해졌어. 어떻게 된 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130535
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130535,
					"content": "우인단과 전투가 있었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130536
					]
				},
				{
					"id": 412130536,
					"content": "이 일대의 우인단 병사들 중에 여태껏 본 적 없는 난폭한 놈들이 있더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130537
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130537,
					"content": "접해본 적이 없는 힘이라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130538
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 412130538,
					"content": "그래서 검도 훌쩍 성장했군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "알베도"
				}
			]
		},
		{
			"id": 4121306,
