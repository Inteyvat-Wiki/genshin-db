			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"설탕"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130201,
					"content": "정말 대단해요. 이런 무기는 생전 처음 봤어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130202
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130202,
					"content": "당신도 정말 대단하세요. 전투 자세나 검을 휘두르는 기세도 정말 완벽했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130203
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130203,
					"content": "에이, 뭘…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130204
					]
				},
				{
					"id": 412130204,
					"content": "이 검은 정말 특별하군요. 자세히 연구할 생각은 없었는데 도저히 눈을 뗄 수가 없네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130205
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130205,
					"content": "검이 특별해서라기보단, 연구 안 하곤 못 배기는 네 성격 때문 아닐까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130206,
					"content": "위험하지만 매력적이고 신비로운 한손검, 음! 확실해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130207
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130207,
					"content": "이렇게 중요한 물건을 맡기다니, 알베도 님은 당신을 진짜~ 진짜 신임하고 계시나 봐요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130208,
						412130209
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130208,
					"content": "이걸 맡겨서 나도 놀랐어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				},
				{
					"id": 412130210,
					"content": "후후, 이게 다 뛰어난 능력 덕분이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130211,
					"content": "저도 그렇게 생각해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130212
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130212,
					"content": "하지만 당신께 맡기기 전에 저 검은 별다른 힘이 없었는데… 알베도 님은 그 잡동사니 속에서 어떻게 저 검이 특별하단 걸 아신 걸까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130213
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130213,
					"content": "갑자기 뭔가 번뜩이는 데엔 이유가 없다구. 내 머릿속에 갑자기 허니캐럿그릴이 떠오른 것처럼 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130214,
					"content": "아… 그러고 보니 오늘 뭐 먹은 게 없네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130215
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130215,
					"content": "실험이 끝나자마자 여러분을 만나러 왔는데 도중에 눈에 파묻힌 모험가를 구한다고 시간을 꽤 많이 허비했거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130216
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130216,
					"content": "(꼬르륵…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130217
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130217,
					"content": "방금 네 배에서 난 소리야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130218
					]
				},
				{
					"id": 412130218,
					"content": "아, 아아아! 그, 그게 아니라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130219
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130219,
					"content": "부끄러워하지 말고 속마음을 말해봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130220,
					"content": "으, 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130221
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130221,
					"content": "그럼 내가 먼저 말할게. 배고파! 밥 먹을래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130222,
						412130223
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130222,
					"content": "배고파!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130224,
					"content": "배… 고파요. 밥, 밥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130225
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130225,
					"content": "으아아, 역시 창피해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130226
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130226,
					"content": "창피하긴, 배고픈 걸 인정했으니 밥이 더 꿀맛일 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130227
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130227,
					"content": "앗, 그런가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130228
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130228,
					"content": "당근이지! 그러니까 기운 내고 먹을 거나 찾으러 가자~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130229
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130229,
					"content": "얼음과 눈으로 뒤덮인 이곳에서 맛있는 허니캐럿그릴을 먹으면 얼마나 좋을까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130223,
					"content": "밥 먹을래!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130209,
					"content": "날 믿어주니 고마울 따름이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				}
			]
		},
