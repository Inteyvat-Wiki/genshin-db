			"dialogs": [
				{
					"id": 412130301,
					"content": "우우… 으아아아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130302
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 412130302,
					"content": "팔라드 씨?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130303
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130303,
					"content": "왜, 왜 아직 안 가셨어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130304
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130304,
					"content": "몬드의 그 경솔한 모험가잖아? 사이러스 씨를 따라 설산에 탐험하러 왔구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130305,
					"content": "추추추추워 죽겠어, 에취!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130306
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 412130306,
					"content": "제가 눈구덩이에서 구해드린 뒤부터 계속 여기 계셨던 거예요?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130307
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130307,
					"content": "나도 돌아가고 싶었다고. 근데 길을 잃었어! 미안…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130308
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 412130308,
					"content": "으아아아… 추워 죽겠네. 꼼짝도 못 하겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130309
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 412130309,
					"content": "휴, 팔라드 씨, 설산을 너무 쉽게 보셨군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130310
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130310,
					"content": "우리가 데리고 가자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130311
					]
				},
				{
					"id": 412130311,
					"content": "네? 하지만 지금 상태론 부축을 받아야 걸을 수 있을 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130312
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130312,
					"content": "그렇다고 여기 그냥 두고 갈 순 없잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130313,
					"content": "그렇긴 하네요…. 미안해요, 여행자님. 제, 제가 대신 사과할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130314
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130314,
					"content": "지금 남 걱정할 때야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130315
					],
					"speakerTitle": "???"
				},
				{
					"id": 412130315,
					"content": "앗! 또 우인단이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130316,
					"content": "우리가 왜 왔는지 알고 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130317
					],
					"speakerTitle": "바딤"
				},
				{
					"id": 412130317,
					"content": "검을 내놔. 안 그러면 여기서 한 발짝도 못 나갈 줄 알아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130318
					],
					"speakerTitle": "바딤"
				},
				{
					"id": 412130318,
					"content": "검을 넘기면 안 돼요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130319,
						412130320
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130319,
					"content": "넘겨줄 리 없잖아!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				},
				{
					"id": 412130321,
					"content": "바로 그 기세야! 놈들을 때려눕히자고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130322
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130322,
					"content": "팔라드 씨, 안전한 곳으로 모셔드릴게요! 이쪽이에요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130323
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130323,
					"content": "순진하군. 아무도 여기서 빠져나갈 수 없다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130324
					],
					"speakerTitle": "바딤"
				},
				{
					"id": 412130324,
					"content": "이 검은 존귀하신 집행관 「시뇨라」 님께 바칠 예물이라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바딤"
				},
				{
					"id": 412130320,
					"content": "누구에게도 빼앗길 수 없어!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				}
