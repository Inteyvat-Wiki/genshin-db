			},
			"dialogs": [
				{
					"id": 412130101,
					"content": "알베도! 우리 또 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130102,
					"content": "엥? 여기 없나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130103,
					"content": "조사하러 나간 걸까? 아니면 또 알 수 없는 그림을 그리러 간 걸까…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130104,
					"content": "앗! 여러분은!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130105
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130105,
					"content": "어라, 설탕이잖아? 네가 왜 여기서 나와?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130106,
					"content": "마침 연구가 끝났거든요. 오늘은 5시간 26분 정도 여유시간이 생겼어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130107
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130107,
					"content": "그래서 일전에 부탁드렸던 의뢰에 대해 여쭤보러 온 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130108
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130108,
					"content": "시간개념 한번 확실하네. 너 인간 자명종이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130109,
					"content": "아, 아뇨, 과찬이세요. 뭐 이런 일로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130110
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130110,
					"content": "칭찬 아니거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130111,
					"content": "저, 저기, 좀 여쭤봐도 될까요? 전에 알베도 님의 비밀을 조사해달라는 부탁드렸는데, 잘 돼 가고 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130112
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130112,
					"content": "내 감이 맞다면, 그건 벌써 일주일 전의 일 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130113,
					"content": "네가 잊은 줄 알았어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130114
					]
				},
				{
					"id": 412130114,
					"content": "네…?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130115
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130115,
					"content": "이, 일주일 전이라구요?! 분명… 앗!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130116
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130116,
					"content": "우으, 실험에 몰두하느라 완전히 잊고 있었어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130117
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130117,
					"content": "뭐야. 시간 개념이 좋은 거야, 나쁜 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130118,
					"content": "그, 그러니까! 이미 답을 알고 계신 거 맞죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130119,
						412130120
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130119,
					"content": "응, 그렇다고 할 수 있지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				},
				{
					"id": 412130121,
					"content": "다행이에요. 그럼 알려주실 수 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130122
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130122,
					"content": "페이몬, 네 생각은 어때?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130123
					]
				},
				{
					"id": 412130123,
					"content": "음… 알려줘도 되지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130124,
					"content": "보기만 하면 괜찮잖아. 만지지만 않으면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130125,
					"content": "잠깐, 무슨 말씀을 하시는 거죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130126
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130126,
					"content": "이건…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130127,
						412130128
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130127,
					"content": "이게 바로 알베도의 비밀이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130129,
					"content": "엄청 무시무시한 검이니까 만지면 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130130,
					"content": "음… 이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130131
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130131,
					"content": "이, 이건!! 제가 한 번도 본 적 없는…!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130132
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130132,
					"content": "후후, 맘껏 감상하라고! 왠지 나도 이상한 성취감이 드는걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130133,
					"content": "정말 대단해요. 이런 신기한 무기는 처음 봐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130134
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130134,
					"content": "검의 내부에서 서서히 움직이는 힘이 희미하게 느껴져요…. 마치 살아있는 것처럼요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130135
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130135,
					"content": "그런 것까지 느껴진단 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130136
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130136,
					"content": "제가 연금술을 공부한 덕분일 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130137
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130137,
					"content": "장담할 순 없지만, 확실히 뭔가 「움직이는」 느낌이 들어요. 워, 원래 이런 정확하지 않은 표현을 사용하진 않지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130138
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130138,
					"content": "믿어 주세요. 저 평소엔 이런 애매 모호한 말은 절대 안 해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130139
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130139,
					"content": "알았어, 알았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130140
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130140,
					"content": "실례지만… 여행자님, 이 검을 사용해서 싸워 줄 수 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130141
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130141,
					"content": "더 연구해 보고 싶지만 저는 이걸 사용할 수 없으니, 부탁 좀 드리고 싶어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130142,
						412130143
					],
					"speakerTitle": "설탕"
				},
				{
					"id": 412130142,
					"content": "알베도한텐 비밀이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130144,
					"content": "그럼 이 주변에서 적당한 곳을 찾아보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 412130143,
					"content": "사람들의 눈에 띄지 않는 곳에서 하는 게 좋겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130128,
					"content": "이게 바로 네가 알고 싶어 했던 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130120,
					"content": "완벽하게 조사했다구",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				}
			]
		},
		{
			"id": 4121302,
			"completionStepIds": [
				4121305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
