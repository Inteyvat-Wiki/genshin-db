			"dialogs": [
				{
					"id": 120230201,
					"content": "으으… 술 냄새 엄청 심해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120230202,
					"content": "음? 넌… 「황새치 2번대」 대장? 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230203
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230203,
					"content": "와타츠미섬에 돌아왔구나. 소대를 버리고 혼자 달아난 줄 알았다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230204
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230204,
					"content": "우린 도망 안 가거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120230205,
					"content": "흥, 그건 모르지. 평화나 안정… 다들 그런 것만 얘기한다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230206
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230206,
					"content": "저항군한테 가장 중요한 게 뭔지 기억해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230207
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230207,
					"content": "「전투 의지」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230208
					]
				},
				{
					"id": 120230208,
					"content": "맞아. 그럼 네가 진정한 저항군인지 아닌지 내가 실험해보지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230209
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230209,
					"content": "뭘 묻고 싶든지 간에, 날 이기기만 하면 알려줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230210
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230210,
					"content": "윽… 이 사람이랑은 말이 잘 안 통하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120230211,
					"content": "#어떡하지, {NICKNAME}, 싸울 거야？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230212,
						120230213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120230212,
					"content": "응. 우린 지지 않아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				},
				{
					"id": 120230214,
					"content": "흥… 그런 말은 날 이기고 나서 하시지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230213,
					"content": "아는 정보를 뱉으라고 해야지!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230214
					]
				}
			]
		},
