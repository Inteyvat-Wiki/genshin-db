			"dialogs": [
				{
					"id": 120230301,
					"content": "강하군… 역시 산고노미야 님이 택한 자야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230302
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230302,
					"content": "너한텐 아직 전투 의지가 남아 있어… 너라면 우릴 이해할 수도 있겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230303
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230303,
					"content": "황새치 2번대 대장… 우리의 동료가 될 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230304
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230304,
					"content": "먼저 무슨 일이 있었는지 알려줘요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230305
					]
				},
				{
					"id": 120230305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230306
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230306,
					"content": "「텐료 봉행이 우인단과 결탁」했다는 건 사실 우리가 지어낸 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230307
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230307,
					"content": "뭐, 뭐!? 코코미가 계속 걱정한 문제가 실은 너희가 지어낸 거라니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120230308,
					"content": "왜 그런 짓을 한 거야? 텐료 봉행과 전쟁을 계속하게 될 수도 있다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120230309,
					"content": "그게 우리가 바라던 바야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230310
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230310,
					"content": "평화 회담? 흥, 다들 그런 생각이나 하니까 와타츠미섬에 미래가 없는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230311
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230311,
					"content": "텐료 봉행이 중간에 마음을 안 바꿀 거라는 보장 있어? 라이덴 쇼군이 다음 안수령을 공포하면?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230312
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230312,
					"content": "우리 저항군에게 가장 중요한 건 전투 의지라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230313
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230313,
					"content": "텐료 봉행과 라이덴 쇼군은 믿을 수 없어. 믿을 수 있는 건 우리 자신뿐이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230314
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230314,
					"content": "너도 그렇게 생각하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230315
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230315,
					"content": "일리는 있는 것 같은데, 뭔가 이상해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120230316,
					"content": "그냥 당신들이 싸우고 싶은 거잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230317
					]
				},
				{
					"id": 120230317,
					"content": "맞아, 방금 한 말도 결국 다 네 추측이잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120230318,
					"content": "그 추측 때문에 이런 소문을 지어내고, 모두가 힘들게 기다려온 평화를 파괴하려는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120230319,
					"content": "별 관심도 없으면서 나한테 훈수 두지 마! 너희가 뭘 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230320
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230320,
					"content": "이기기 위해서 우린 전투 의지를 극도의 경지까지 고수했어. 근데 이제 와서 갑자기 이게 다 쓸모없는 일이라니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230321
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230321,
					"content": "우리 보고 무기를 내려놓고 일반인처럼 생활하라고? 그게 어떻게 가능하지? 눈을 감으면 전쟁에서 희생한 동료들이 자꾸 떠오르는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230322
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230322,
					"content": "동료들의 모습이 아른거릴 때마다 난 텐료 봉행, 그리고 안수령을 절대 용서할 수가 없다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230323
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230323,
					"content": "너흰 우리와 같은 부류가 아닌가 보군… 내가 한 얘기를 산고노미야 님께 말해도 좋아. 하지만 이제 와서 우릴 막기엔 늦었을걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230324
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230324,
					"content": "늦었다니? 그게 무슨 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230325
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120230325,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230326
					],
					"speakerTitle": "코우젠"
				},
				{
					"id": 120230326,
					"content": "윽… 대답하지 않을 건가 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230327
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120230327,
					"content": "#어쩌지, {NICKNAME}? 긴급 사태니까 우선 코코미한테 알려주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
