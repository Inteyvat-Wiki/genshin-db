				"points": []
			},
			"dialogs": [
				{
					"id": 120230101,
					"content": "축하연 준비는 대충 끝난 것 같네. 근데 시작하기 전에 간단하게 연설을 해야 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230102
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120230102,
					"content": "음… 코코미, 에너지는 충분해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120230103,
					"content": "걱정 마, 충분해. 너희 덕분에 에너지를 빨리 회복했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230104
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120230104,
					"content": "다행이다. 우리도 응원해 줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120230105,
					"content": "다들 고생 많았다. 오늘은 우리만의 축하연이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230106
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120230106,
					"content": "최근 우리와 막부군의 전쟁이 일단락되면서 안수령의 폐지도 보았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230107
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120230107,
					"content": "이나즈마의 미래가 어떨지는 나도 예측할 수 없지만, 와타츠미섬의 평화를 위해 난 내일 텐료 봉행과 평화 회담을 가질 것이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230108
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120230108,
					"content": "제군들의 노력이 있었기에 우린 이 험난한 전쟁에서 승리할 수 있었다. 감사의 마음을 표하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230109
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120230109,
					"content": "이 축하연은 여기 있는 모두를 위해 준비한 것이니, 어렵게 얻은 승리를 만끽하길 바란다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230110
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120230110,
					"content": "오——!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230111
					],
					"speakerTitle": "덴지로"
				},
				{
					"id": 120230111,
					"content": "축하연이 순조롭게 진행된 것 같아서 정말 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230112
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120230112,
					"content": "#사람은 즐거울 때 속마음을 쉽게 털어놓곤 하지. {NICKNAME}, 네가 가서 정보를 좀 더 수집해 줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230113
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120230113,
					"content": "아직 「텐료 봉행이 우인단과 결탁했다」는 일에 대한 결정적인 단서가 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230114
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120230114,
					"content": "내일 회담에서 무슨 일이라도 생길까 봐 걱정이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230115
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 120230115,
					"content": "그래, 우리가 가서 더 물어볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
