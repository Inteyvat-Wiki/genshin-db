						"pointId": 7522
					},
					{
						"sceneId": 3,
						"position": [
							3594.826,
							435.073,
							4532.51
						],
						"pointId": 7523
					}
				]
			},
			"dialogs": [
				{
					"id": 741530101,
					"content": "계십니까, 신문 필요 없으십니까? 저기요, 문 좀 열어주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530102
					],
					"speakerTitle": "핍"
				},
				{
					"id": 741530102,
					"content": "안녕하세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530103
					]
				},
				{
					"id": 741530103,
					"content": "브누아 씨는 집에 안 계신가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530104
					]
				},
				{
					"id": 741530104,
					"content": "제가 어떻게 알겠어요, 이상하네요. 자기가 구독한 신문조차 가지러 오질 않다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530105
					],
					"speakerTitle": "핍"
				},
				{
					"id": 741530105,
					"content": "전에 제가 신문 배달을 왔을 때, 르로아 씨는 적어도 대답 정도는 해주셨거든요. 그런데 최근에는 아예 보이지 않아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530106
					],
					"speakerTitle": "핍"
				},
				{
					"id": 741530106,
					"content": "그분이 구독하신 스팀버드 신문이 많이 쌓였는데, 여러분은 르로아 씨와 아는 사이이신가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530107
					],
					"speakerTitle": "핍"
				},
				{
					"id": 741530107,
					"content": "맞아. 우린 브누아의 친한 친구야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530108,
					"content": "친한 친구…? 좋아요. 제가 신문을 여러분께 드릴 테니, 그를 만나면 전달해 주실 수 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530109,
						741530110
					],
					"speakerTitle": "핍"
				},
				{
					"id": 741530109,
					"content": "네, 맡겨주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530111
					]
				},
				{
					"id": 741530111,
					"content": "저도 최선을 다한 거니까, 나중에 신문 배달이 안 왔다고 불평하시면 안 돼요. 저는 이만 다른 일이 있어서요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530112
					],
					"speakerTitle": "핍"
				},
				{
					"id": 741530112,
					"content": "근데 최근엔 우리도 당사자를 본 적은 없는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530113,
					"content": "여러분도 그를 본 적이 없으시다고요? 르로아 씨는 도대체 어디서 뭘 하시는 건지. 설마 옛집으로 돌아가 버리신 건가? 그런 말은 못 들었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530114
					],
					"speakerTitle": "핍"
				},
				{
					"id": 741530114,
					"content": "옛집이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530115
					]
				},
				{
					"id": 741530115,
					"content": "네, 잿빛의 강에 있는 옛집이요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530116
					],
					"speakerTitle": "핍"
				},
				{
					"id": 741530116,
					"content": "브누아는 잿빛의 강에 살았었구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530117,
					"content": "르로아 씨가 잿빛의 강에서 이사 왔다는 것도 모르시다니, 정말 친한 친구 맞나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530118
					],
					"speakerTitle": "핍"
				},
				{
					"id": 741530118,
					"content": "어… 우린…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530119,
					"content": "됐어요. 설명할 필요는 없어요. 여러분이 르로아 씨와 어떤 관계인지 관심 없으니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530120
					],
					"speakerTitle": "핍"
				},
				{
					"id": 741530120,
					"content": "신문만 전달해 주시면 정말 감사하겠습니다. 자, 가져가세요. 저는 가볼게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530121
					],
					"speakerTitle": "핍"
				},
				{
					"id": 741530121,
					"content": "브누아에게는 우리가 모르는 사정이 많은 것 같아. 이 단서가 우리의 조사와 관련이 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530122,
						741530123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530122,
					"content": "관련이 있을 가능성이 높지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530124
					]
				},
				{
					"id": 741530124,
					"content": "좋아, 그럼 이제 브누아의 집 근처를 조사해 보자. 브누아에 대한 정보를 더 많이 알아낼 수 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530125,
					"content": "하지만 조심히 움직여야 해. 그 부부의 주의를 끌게 될지도 모르니까 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530123,
					"content": "정보는 많을수록 좋지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530124
					]
				},
				{
					"id": 741530110,
					"content": "페이몬이 가지고 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530111
					]
				}
			]
		},
