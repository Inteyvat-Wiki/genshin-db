						],
						"pointId": 7525
					}
				]
			},
			"dialogs": [
				{
					"id": 741530701,
					"content": "아, 지겨워… 일하기 싫다…. 언제쯤 벼락부자가 될 수 있을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530702
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530702,
					"content": "브누아·르로아에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530703
					]
				},
				{
					"id": 741530703,
					"content": "…르로아? 그 이름은 어디서 들어본 적 있는 것 같은데, 어디서 들어봤더라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530704
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530704,
					"content": "아, 생각났어요. 브누아·르로아, 잡화 노점의 주인아저씨예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530705
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530705,
					"content": "무슨 일이죠? 당신들은 누구시죠? 이걸 알아서 뭐 하시려는 거예요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530706
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530706,
					"content": "사실 우린 그저…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530707,
						741530708
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530707,
					"content": "그분 상황이 조금 복잡하거든요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530709
					]
				},
				{
					"id": 741530709,
					"content": "아, 그… 설마… 그 사람이 무슨 범죄를 저지른 건 아니겠죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530710
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530710,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530711
					]
				},
				{
					"id": 741530711,
					"content": "아, 알겠어요… 그래도 하나 더 물어볼 게 있어요. 당신들은 가시 장미회에서 온 건가요, 아니면 법률 집행청에서 온 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530712
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530712,
					"content": "당신은 묵비권을 행사할 수 있고…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530713
					]
				},
				{
					"id": 741530713,
					"content": "당신의 모든 말은 법정에서 증거로 채택될 수 있으며…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530714
					]
				},
				{
					"id": 741530714,
					"content": "#(연기도 꽤 잘하네, {NICKNAME}. 역시 너다워!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530715
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530715,
					"content": "아, 알겠어요, 이해했어요. 그 녀석은 돈을 버는 수단이 떳떳하지 않고, 폰타인은 법 조항이 엄청 많으니까, 분명히 그중 하나를 위반했겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530716
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530716,
					"content": "나으리, 잘 찾아오셨어요. 다 말해드릴게요. 그 녀석 일가는 제가 잘 알아요. 브누아 그 나쁜 녀석이 했던 일이 적지 않거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530717
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530717,
					"content": "휴, 저도 결혼해서 가정을 꾸릴 나이가 됐으니 녀석도 나이를 많이 먹었겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530718
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530718,
					"content": "제 기억에 녀석의 딸인 첼은 정말 예뻤어요, 헤헤. 아쉽게도 녀석은 우리가 첼에게 말도 걸지 못하게 했지만요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530719
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530719,
					"content": "첼?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530720
					]
				},
				{
					"id": 741530720,
					"content": "맞아요. 첼·르로아, 브누아·르로아의 양녀죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530721
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530721,
					"content": "잘 생각해 보세요. 녀석은 그저 잡화나 팔며 푼돈이나 만지던 사람일 뿐이라고요. 어떻게 갑자기 부자가 돼서 저 위로 이사 갈 수 있었겠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530722
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530722,
					"content": "딸인 첼 덕분이거든요. 녀석은 그렇게 예쁘고 어린 소녀를 돈 많은 늙은이와 결혼시켰다고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530723
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530723,
					"content": "몇 년도 되지 않아 그 늙은이는 죽어버렸고, 늙은이의 집은 당연히 첼의 몫이 됐죠. 그리고 첼은 녀석의 것이니, 그렇게 녀석은 단숨에 「위쪽 사람」이 된 거죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530724
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530724,
					"content": "쯧쯧, 하루아침에 부자가 될 수 있는 좋은 일이 왜 그런 녀석에게 일어난 건지. 퉤, 전 그 늙은 녀석이 자기 딸의 고혈을 빨아먹는 게 아니꼬울 뿐이에요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530725
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530725,
					"content": "(어떻게 이런 일이 있을 수 있는 거지?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530726
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530726,
					"content": "(계속 물어보자)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530727
					]
				},
				{
					"id": 741530727,
					"content": "나으리, 이 정보를 조사하러 오신 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530728
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530728,
					"content": "제 말이 당신께 도움이 됐다면, 전 폰타인의 사회 안전을 위해 공헌한 거겠죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530729
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530729,
					"content": "그럼 법률 집행청에서 사회에 공헌한 시민인 제게 포상을 주실 계획은 혹시 없으실까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530730,
						741530732
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530730,
					"content": "그런 건 우리도 이미 알고 있는 것들이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530731
					]
				},
				{
					"id": 741530731,
					"content": "조급해하지 마세요. 말씀드릴 수 있는 또 다른 정보가 있거든요. 어쨌든 저도 잿빛의 강에 사는지라 다른 사람의 비밀을 모르고서는 잠을 푹 잘 수 없답니다, 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530734
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530734,
					"content": "첼의 두 번째 남편… 네, 맞아요, 그녀는 금방 재혼했거든요. 게다가 이번에는 먼 곳으로 시집을 가서 우리는 그녀를 볼 수 없었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530735
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530735,
					"content": "우리가 첼의 소식을 다시 듣게 됐을 때는, 이미 그녀가 그런 일을 저지른 후였죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530736
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530736,
					"content": "그런 일이라는 게 어떤 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530737
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530737,
					"content": "네? 첼이 두 번째 남편을 죽여서 메로피드 요새에 갇혔잖아요. 나으리, 브누아를 조사하시면서 그것도 모르셨어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530738,
						741530739
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530738,
					"content": "여기 관련자 기록에 있어, 페이몬 대원",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530740
					]
				},
				{
					"id": 741530740,
					"content": "#앗… 죄송합니다, {NICKNAME} 대장! 다시는 이런 실수를 하지 않겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530741,
						741530742
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530741,
					"content": "계속 말해보세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530743
					]
				},
				{
					"id": 741530743,
					"content": "네, 지금 말하려던 참이었어요. 저도 들은 건데 첼이 심판을 받을 때, 첼은 브누아의 출석을 요구했지만 녀석은 거절했대요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530744
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530744,
					"content": "브누아는 결혼도 안 했고, 오직 딸인 첼 하나만 있었는데도요. 아, 제가 기억하기로 첼은 다른 가족에게서 데려온 수양딸이어서 브누아와 약간의 혈연관계가 있었다고 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530745
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530745,
					"content": "어쨌든 유일한 아버지조차 법정에 출석하지 않았으니까, 첼이 메로피드 요새에 갇히는 판결을 받은 것도 정상이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530746
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530746,
					"content": "그 나쁜 녀석이 집을 독차지하려고 그랬던 건지, 아니면 딸과 어떤 갈등이 있어서 법정에 출석하지 않았던 건지는, 제가 함부로 추측하진 않을게요, 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530747
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530747,
					"content": "녀석은 평소에 친절해 보이죠? 녀석이 저한테 간식을 준 적도 있었는데, 그런 사람이 냉혈한일 거라고는 누가 생각이나 했겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530748
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530748,
					"content": "굉장히 침착하시네요. 이런 얘기를 듣고도 미간조차 찌푸리지 않으시다니. 녀석이 냉정하다고 생각하지 않으세요? 저도 나름 침착하다고 생각했는데, 나으리는 저보다 더하시네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530749
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530749,
					"content": "공무 중이니까요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530750
					]
				},
				{
					"id": 741530750,
					"content": "프로페셔널하시네요. 존경스럽습니다. 그래서 나으리, 브누아의 죄는 심각한 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530751
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530751,
					"content": "그건 말씀드릴 수 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530752
					]
				},
				{
					"id": 741530752,
					"content": "하, 말할 수 없을 정도로 심각한 건가요…. 그럼 녀석의 집은 몰수되겠죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530753,
						741530754
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530753,
					"content": "아마도요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530755
					]
				},
				{
					"id": 741530755,
					"content": "아하, 그럴 줄 알았죠. 늙은 시궁쥐는 높은 곳에 올라가도 늙은 시궁쥐일 뿐이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530756
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530756,
					"content": "제게 즐거운 하루를 선물해 주신 두 나으리께 감사를 드릴게요. 다음에 잿빛의 강에서 다시 뵙기를 기대하겠습니다, 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530757
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530757,
					"content": "뭐랄까… 나 지금 기분이 조금 복잡해. 원래 브누아에 대한 이미지가 굉장히 좋았었거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530758,
						741530760
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530758,
					"content": "사람을 겉모습만으로 판단해선 안 돼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530759
					]
				},
				{
					"id": 741530759,
					"content": "어휴, 내가 너무 둔한 걸까. 전혀 그런 사람으로는 보이지 않는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530763
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530763,
					"content": "이렇게 복잡한 일은 소화할 시간이 필요해. 마음이 싱숭생숭해서 더는 잿빛의 강에 있고 싶지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530764
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530764,
					"content": "가자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530765
					]
				},
				{
					"id": 741530765,
					"content": "응, 햇볕이라도 쬐러 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530760,
					"content": "누군가의 일방적인 주장을 맹신할 필요는 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530761
					]
				},
				{
					"id": 741530761,
					"content": "네 말이 맞아. 하지만 나도 이제는 브누아를 완전히 믿을 수 없게 됐어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530762
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530762,
					"content": "이런 느낌은 정말 싫은걸. 그래도 너만은 믿을 수 있어서 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530763
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741530754,
					"content": "그럴 수도 있죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530755
					]
				},
				{
					"id": 741530742,
					"content": "비밀이라는 건?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530743
					]
				},
				{
					"id": 741530739,
					"content": "공문을 자세히 읽지 않았다니 실망스럽군",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530740
					]
				},
				{
					"id": 741530732,
					"content": "당신이 무슨 정보를 제공할 수 있는지 보죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530733
					]
				},
				{
					"id": 741530733,
					"content": "제가 말씀해 드릴 수 있는 것들이 너무 많은걸요. 어쨌든 저도 잿빛의 강에 사는지라 다른 사람의 비밀을 모르고서는 잠을 푹 잘 수 없답니다, 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741530734
					],
					"speakerTitle": "스노드그라스"
				},
				{
					"id": 741530708,
					"content": "협조 좀 부탁드릴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741530709
					]
				}
			]
		},
