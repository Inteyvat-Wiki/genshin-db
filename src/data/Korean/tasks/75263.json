			"dialogs": [
				{
					"id": 752630501,
					"content": "경기 종료! 경기 종료! 놀라운 결과가 나왔습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630502
					],
					"speakerTitle": "키노아"
				},
				{
					"id": 752630502,
					"content": "#이번 대결의 최종 우승자는 바로——{NICKNAME}입니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630503
					],
					"speakerTitle": "키노아"
				},
				{
					"id": 752630503,
					"content": "우와! 진짜 대단하다! 「전광」과 「석화」를 이기다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630504
					]
				},
				{
					"id": 752630504,
					"content": "꼭 금빛 번개 같은 모습이군요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630505
					]
				},
				{
					"id": 752630505,
					"content": "이봐, 은빛 번개는? 은빛 번개는 못 봤어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 752630506,
					"content": "완전한 패배군…. 이건 내가 영원히 도달할 수 없는 스피드야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
