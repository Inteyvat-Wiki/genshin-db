			},
			"dialogs": [
				{
					"id": 401570501,
					"content": "#오! {NICKNAME}(이)랑 페이몬이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570502
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401570502,
					"content": "앗! 시노부! 헤이조도 있네! 너도 여기 왔구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401570503,
					"content": "예상 밖이긴 하지만 엄청 놀랍지는 않네. 안 그래도 시노부 씨랑 너희를 곧 만날 거 같다는 얘기 중이었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570504
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401570504,
					"content": "하하, 시카노인 도신이 오는 내내 너희 얘길 몇 번이나 했는지 몰라. 염원이 강하면 이뤄진다는 게 이런 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570505
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 401570505,
					"content": "감이에요, 감. 전 결정적인 순간에 결정적인 인물을 떠올리곤 하거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570506
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401570506,
					"content": "반가워",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570507
					]
				},
				{
					"id": 401570507,
					"content": "우리 빼고 제일 먼저 도착한 사람이 헤이조일 줄이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401570508,
					"content": "형님이 텐료 봉행에 최대한 빨리 초대장을 보내라고 당부하셨거든. 쿠죠 사라 님과 시카노인 도신을 초대하라고 하셨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570509
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 401570509,
					"content": "어… 그럼 사라는 왜 안 왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570510
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401570510,
					"content": "이토 형씨를 보고 싶지 않아서겠지. 그도 그럴 게, 초대장 맨 밑에 이렇게 적혀 있었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570511
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401570511,
					"content": "「쿠죠 텐구! 산호궁 정상에서 이 몸과 피 끓는 스모 대결을 펼쳐 보자!!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570512
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401570512,
					"content": "내가 쿠죠 사라 님이었으면 형님을 산호궁 정상에서 밀어버리고 싶었을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570513
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 401570513,
					"content": "그리고 코코미가 사라까지 밀어버리겠지? 집 천장에서 소란을 피우니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570514
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401570514,
					"content": "하하하, 아무튼 쿠죠 사라 님은 성격이 너무 좋으신 것 같아. 축하 선물로 제비꽃 열매를 한 바구니나 주시더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570515
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 401570515,
					"content": "성격이 좋다고? 흐음, 난 다른 뜻이 있는 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570516
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401570516,
					"content": "다른 뜻?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570517
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401570517,
					"content": "「자꾸 시비 걸면 봉행소에서 제비꽃 열매를 먹게 될 줄 알아」라든지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570518
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401570518,
					"content": "에이, 헤이조, 너무 많이 갔다! 제비꽃 열매 바구니가 두 개던데, 하나는 네가 선물한 거지? 그럼 너도 다른 뜻이 있는 거겠네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570519
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401570519,
					"content": "하하, 그건 봉행소 사람들이랑 다 같이 산 거야. 나나 이토 형씨를 체포한 적 있는 다른 도신들, 그리고 이토 형씨의 감옥 친구들까지 함께",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570520
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401570520,
					"content": "그러니까 이 제비꽃 열매 바구니에는 「자주 놀러 와!」 정도의 뜻이 담겨 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570521
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401570521,
					"content": "그런 뜻은 형님한테 전하지 않는 게 좋겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570522
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 401570522,
					"content": "네. 제비꽃 열매도 전했고 보고 싶은 사람도 만났으니 난 이만 가볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570523
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401570523,
					"content": "응? 헤이조는 이번 행사에 참여 안 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570524
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401570524,
					"content": "마지막 축제 땐 꼭 올 테니 걱정 마. 지금은 잠깐 볼일이 있어서 이도에 가봐야 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570525
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401570525,
					"content": "이도라니, 탐정은 정말 바쁘구나…. 아 참! 헤이조, 혹시 전장을 누비는 닌자견에 대한 소문 들어봤어? 이도에서 퍼진 소문 같던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570526
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401570526,
					"content": "아… 이번 음악회의 계기가 되었다는 그 개 말이지? 시노부 씨한테 테마와 배경 이야기를 대충 들은 적이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570527
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401570527,
					"content": "그렇구나… 봉행소라면 어떻게 된 일인지 알까 싶었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570528
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401570528,
					"content": "내 경험상… 그런 개는 없을 거야. 그냥 동네에 떠도는 소문이겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570529
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401570529,
					"content": "뭐야, 표정을 보니 신경 쓰이나 보구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570530
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401570530,
					"content": "재밌네…. 좋아, 어차피 이도에 들러야 하니까 겸사겸사 알아봐 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570531,
						401570532
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401570531,
					"content": "네 업무에 지장이 가지 않겠어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570533
					]
				},
				{
					"id": 401570533,
					"content": "우리 사이에 뭘. 네가 신경 쓰는 일엔 나도 보통 관심이 가거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570534
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401570534,
					"content": "하하, 어쨌든 내 소식 기다리고 있어. 나중에 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570535
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401570535,
					"content": "시카노인 도신은 역시 자유로운 행동파네. 나도 다시 초대장을 보내러 가야겠어. 어쨌든 가장 중요한 건 마지막 축제 행사니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570536
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 401570536,
					"content": "우리도 놀고만 있을 순 없지! 리스트는 다 됐으려나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570537
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401570537,
					"content": "오래 기다렸지? 자, 이 리스트대로 해주면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570538
					],
					"speakerTitle": "드보르작"
				},
				{
					"id": 401570538,
					"content": "#타이밍 딱 맞춰 왔네! {NICKNAME}, 그럼 우리도 슬슬 준비하고 출발하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401570539
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401570539,
					"content": "그럼 잘 부탁해. 혹시 음악 연주하면서 쉬고 싶으면 내가 있는 곡 연습 구역으로 찾아와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "드보르작"
				},
				{
					"id": 401570532,
					"content": "의뢰 비용은?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401570533
					]
				}
			]
		},
