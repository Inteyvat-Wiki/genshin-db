				"points": []
			},
			"dialogs": [
				{
					"id": 220320501,
					"content": "어? 이… 이건 이나즈마 요리 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320502
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320502,
					"content": "내가 원했던 건 이 음식이 아닌 것 같은데… 아, 상관없어, 이걸로도 배를 채울 수 있으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320503
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320503,
					"content": "아무튼 고마워, 여행자. 이것들을 받아",
