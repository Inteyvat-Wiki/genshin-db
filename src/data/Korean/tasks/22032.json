					"탕운"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320401,
					"content": "음, 이 맛은… 리…리월 요리도 아니고 이나즈마 요리도 아닌 것 같고, 새롭긴 한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320402
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320402,
					"content": "내가 원한 요리는 아니지만, 이 참신한 요리를 맛본 것만으로도 만족스러워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320403
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320403,
					"content": "고마워, 여행자. 이것들을 받아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "탕운"
				}
			]
		},
		{
			"id": 2203205,
			"completionStepIds": [
				2203205
			],
