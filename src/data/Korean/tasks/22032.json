					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320701,
					"content": "그러니까 어떤 생선을 구워서 요리할까? 우리가 그녀를 대신해서 고르자.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320702
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220320702,
					"content": "생각해보자… 요즘 내가 좋아하는 생선 요리는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320703
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220320703,
					"content": "마라맛 삶은 검정 농어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320704
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220320704,
					"content": "새콤달콤한 탕수어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320705
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220320705,
					"content": "그리고 만능의 몬드 생선구이!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320706
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220320706,
					"content": "이건 다 네가 좋아하는 거잖아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320707
					]
				},
				{
					"id": 220320707,
					"content": "헤헤, 괜찮아, 내 취향을 믿고 골라봐~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320708,
						220320710,
						220320712,
						220320714
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220320708,
					"content": "그럼 삶은 검정 농어로 하자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320709
					]
				},
				{
					"id": 220320709,
					"content": "좋은 생각이야! 어서 삶은 검정 농어를 만들어 탕운에게 주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220320710,
					"content": "그럼 탕수어로 하자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320711
					]
				},
				{
					"id": 220320711,
					"content": "좋지! 어서 탕수어를 만들어 탕운에게 주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220320712,
					"content": "그럼 몬드 생선구이로 하자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320713
					]
				},
				{
					"id": 220320713,
					"content": "좋았어! 어서 몬드 생선구이를 만들어 탕운에게 주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220320714,
					"content": "생각 좀 해볼게…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320715
					]
				},
				{
					"id": 220320715,
					"content": "응~ 생각 다 했으면 어서 탕운에게 만들어주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
