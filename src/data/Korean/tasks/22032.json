				"points": []
			},
			"dialogs": [
				{
					"id": 220320101,
					"content": "음…리월 요리를 먹을 수 있다면 좋을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320102
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320102,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320103
					]
				},
				{
					"id": 220320103,
					"content": "이 차림은… 너 여행자니? 미안, 그냥 집 생각이 좀 나서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320104,
						220320105
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320104,
					"content": "방금 리월 요리가 먹고 싶다고 했죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320118
					]
				},
				{
					"id": 220320118,
					"content": "어? 설마… 리월 요리할 줄 알아? 잘됐다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320119
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320119,
					"content": "그럼, 어, 빨리 도와줘. 제대로 된 리월 요리 좀 만들어 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320120
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320120,
					"content": "지금 내가 가장 먹고 싶은 건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320121
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320121,
					"content": "음… 난 생선이 먹고 싶어! 어릴 적 어머니가 만들어 주셨던 생선을 생각하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320122
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320122,
					"content": "생선을 깨끗이 씻어서 양쪽에 칼집을 내고 향신료와 술을 넣어 소금에 살짝 절인 후, 양면이 노릇노릇해지게 지지면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320123
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320123,
					"content": "뜨거운 물과 양념을 넣고 끓이다가 센 불로 졸이면서 간을 하고, 전분을 넣고 접시에 담으면… 아! 그건 정말 완벽함 그 자체야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320124
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320124,
					"content": "어린 동생이 옆에서 냄새 맡고는 손뼉을 치면서 「딱 좋아! 딱 좋아!」하고 탄성을 지르지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320125
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320125,
					"content": "어우… 우리 엄마 생선요리 정말 잘하는데, 언제쯤 가서 먹을 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320105,
					"content": "무슨 문제가 생겼나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320106
					]
				},
				{
					"id": 220320106,
					"content": "먼저 내 소개를 할게, 내 이름은 탕운이야. 리월에서 온 역사학자로 이나즈마의 특색있는 풍습과 민화를 연구하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320107
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320107,
					"content": "원래 자료를 거의 다 수집해서 리월로 돌아가려던 참이었는데, 이나즈마의 쇄국령으로 발이 묶인 지 꽤 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320108
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320108,
					"content": "사실 난 이게 좋은 일이라고 생각하고 있어. 왜냐하면 지금 이나즈마는 역사적인 순간을 맞았거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320109
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320109,
					"content": "난 이 특별한 시기가 티바트의 역사에 한 획을 그을 것이라고 확신해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320110
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320110,
					"content": "이 역사를 눈으로 직접 보고 가감 없이 온전하고 분명하게 기록해서 후세에 남기는 것이 역사학자들이 해야 할 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320111
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320111,
					"content": "그런데… 사명감이 불타긴 하지만, 배가 고프긴 하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320112
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320112,
					"content": "배고프세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320113
					]
				},
				{
					"id": 220320113,
					"content": "말하기 민망한데… 배고파… 하하하, 이나즈마 음식이 정말 맛있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320114
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320114,
					"content": "난 이곳의 「모둠튀김」이 정말 좋아. 뭐랄까… 튀김옷을 입혀서 모든 것을 튀길 것 같은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320115
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320115,
					"content": "하지만 이나즈마 요리를 많이 먹다 보니, 리월 요리가 더 생각나네. 근데 제대로 된 리월 요리를 하는 식당을 찾지 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320116
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320116,
					"content": "며칠 전 마음을 단단히 먹고 모험가 길드에 가서 「요리 의뢰」를 신청했는데 아직까지 연락이 없네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320117
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320117,
					"content": "제가 한번 해볼까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320118
					]
				}
			]
		},
