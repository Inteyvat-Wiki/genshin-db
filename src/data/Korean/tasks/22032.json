			},
			"dialogs": [
				{
					"id": 220320301,
					"content": "그래, 이거야! 이게 바로 내가 꿈꾸던 고향의 맛이야… 정말… 우으… 정말 감동적이잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320302
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320302,
					"content": "고마워. 이런 맛있는 음식들이 있어서 힘이 나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320303
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220320303,
					"content": "이것들을 받아줘. 앞으로의 여행이 순조롭길!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "탕운"
				}
			]
		},
		{
			"id": 2203204,
			"completionStepIds": [
				2203204
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
