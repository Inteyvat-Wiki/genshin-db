	"talks": [
		{
			"id": 7368901,
			"completionStepIds": [
				7368901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368901",
							"2"
						],
						"stepId": 7368901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아나톨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736890101,
					"content": "휴, 이 실험을 재현할 수 있는 조건이 전혀 갖춰지지 않았어. 패트리스, 내가 널 돕기 싫은 게 아니야…. 이번에는 그냥 운에 기댈 수밖에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890102
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890102,
					"content": "방법이 없네. 차라리 맛있는 걸 먹을 생각이나 해야겠는걸. 그래, 죽순 수프는 어떨까? 죽순 수프 먹으러 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890103
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890103,
					"content": "뭐어? 죽순 수프 가게는 엄청나게 먼 곳에 있다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890104,
					"content": "그건 그렇네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890105
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890105,
					"content": "으악! 너희들은 누구지? 인적도 드문 곳엔 무슨 일로…. 수상한데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890106
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890106,
					"content": "잉, 진짜 수상해 보여?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890107,
						736890108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890107,
					"content": "그래, 페이몬. 이런 곳에 나타나면 어떡해!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890109
					]
				},
				{
					"id": 736890109,
					"content": "으, 너도 나랑 같이 왔잖아. 왜 너도 맞장구치는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890110,
					"content": "짜증 나, 이걸 어떻게 반박해야 하지…. 아, 맞다. 우리가 수상한 거면 폰타인 사람인 너도 수상하잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890111,
					"content": "…그런가? 다른 사람 눈엔 내가 그렇게 수상해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890112
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890112,
					"content": "아무래도 폰타인 사람이니까요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890113
					]
				},
				{
					"id": 736890113,
					"content": "#맞아 맞아. 나랑 {NICKNAME}(은)는 모험가니까… 이곳에 있는 게 지극히 정상이지만 넌 폰타인 사람이잖아, 우리보다 훨씬 이상해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890114,
					"content": "#그것도 그렇네…. 흠, 이 여행자는 {NICKNAME}(이)고 그럼 날아다니는 꼬맹이, 네 이름은?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890115
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890115,
					"content": "내 이름은 페이몬이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890116,
					"content": "그렇구나, 나도 자기소개를 해야겠네. 난 폰타인 과학원의 엔지니어 아나톨이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890117
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890117,
					"content": "사실 먼 폰타인에서 온 데는 다 그럴만한 이유가 있어. 폰타인 과학원 어르신들의 명을 받고 연구하러 왔지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890118
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890118,
					"content": "리월의 먹거리 연구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890119
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890119,
					"content": "리월의 먹거리, 헤헤…. 아, 아니지. 과학원은 기계랑 에너지의 구조를 연구하는 기구야. 그나저나 말 참 잘했네. 먹거리를 연구하는 부서가 있으면 좋겠다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890120
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890120,
					"content": "딴 길로 샜네. 내 폰타인 과학원 동기 중 줄곧 광석과 원소의 힘을 연구해온 친구가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890121
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890121,
					"content": "참, 이 근처를 자주 돌아다녔다면 만났을 수도 있겠네. 패트리스라는 녀석인데, 혹시 만난 적 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890122,
						736890125
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890122,
					"content": "모르겠네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890123
					]
				},
				{
					"id": 736890123,
					"content": "전혀 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890124,
					"content": "휴, 패트리스…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890128
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890128,
					"content": "그 녀석의 연구엔 엄청나게 많은 특정 리월 광석이 필요해. 그렇지만 말이지, 예산이나 실험 장소 비용 같은 이런저런 문제가 있어서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890129
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890129,
					"content": "실험할 수 없다는 거구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890130,
					"content": "맞아… 그러던 어느 날 걔가 남은 연구비와 실험 기재들을 갖고 사라져버렸어. 폰타인 과학원의 압박에 못 이겨 도망친 거라고 다들 말하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890131
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890131,
					"content": "하지만 난 그 녀석이라면 해낼 수 있을 거라 믿어왔어. 뒷담화나 하는 그런 녀석들이랑은 전혀 다르다고, 크흠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890132
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890132,
					"content": "아무튼… 얼마 전 녀석이 살아서 폰타인 과학원으로 돌아왔어. 그것도 실험 결과를 가지고 말이야. 휴, 정말 놀라운 연구 정신이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890133
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890133,
					"content": "그 녀석이 말하길, 직접 리월로 가서 현지에 실험실을 차렸고… 온갖 상상하기조차 힘든 역경을 넘어 과제를 완성했다는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890134
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890134,
					"content": "와, 그거참 대단한데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890135,
						736890137
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890135,
					"content": "그러게요, 정말 잘됐어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890136
					]
				},
				{
					"id": 736890136,
					"content": "여기까지만 들으면 후배들에게 본보기가 될 이야기겠지만… 휴, 그렇게 단순하지만은 않아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890139
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890139,
					"content": "리월까지 와서 실험을 한다는 것 자체가 규정에 어긋나는 행동이거든…. 사실 이해는 돼. 규정대로 절차를 밟으려면 이런저런 신청서랑 설명을 작성하는 데만 보름이 걸릴 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890140
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890140,
					"content": "당연히 실험 과정을 검증한 사람은 없었고 데이터는 또 너무 구체적이다 보니… 문서 심사 결과에 따르면 「위조한 듯이 데이터가 구체적이다」고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890141
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890141,
					"content": "패트리스는 데이터가 구체적인 이유를 반복해서 설명했어. 현지 모험가 길드의 도움을 받은 덕분이라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890142
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890142,
					"content": "하지만 윗분들은 믿지 않았어. 그래서 규정에 따라 녀석의 실험 데이터를 검증할 사람을 보낸 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890143
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890143,
					"content": "으… 한마디로 검증을 위해 폰타인에서 리월까지 와서 패트리스가 했던 실험을 그대로 반복할 불쌍한 사람이 필요했다는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890144
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890144,
					"content": "그래서, 그 재수가 없는 사람은 누구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890145
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890145,
					"content": "그러게, 누굴까. 하하하, 그 재수 없는 놈이 바로 나야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890146
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890146,
					"content": "패트리스는 좋은 녀석이라 나도 도와주고는 싶지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890147
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890147,
					"content": "하지만 직접 와서 보니, 실험에 맞는 광석은 널렸어도 혼자선 절대 할 수 없다는 걸 깨달았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890148
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890148,
					"content": "그럴 수가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890149
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890149,
					"content": "패트리스가 혼자 실험을 진행했으니 나도 그래야만 한다는 것 같은데…. 어휴, 망할 과학원 같으니, 폭발해도 싸지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890150
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890150,
					"content": "포… 폭발이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890151
					]
				},
				{
					"id": 736890151,
					"content": "크흠, 폰타인 과학원이 예전에 한 번 실험에 실패해서 폭발했던 적이 있거든. 하지만 별거 아니야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890152
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890152,
					"content": "이상한 공정이랑 쓸데없이 복잡한 관리 시스템도 같이 터졌어야 했는데. 오히려 더 「강화」됐다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890153
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890153,
					"content": "휴… 데이터 검증 실험은 포기해야겠어. 신청한 경비를 써버리지 않으면 내년 예산만 깎일 테니, 차라리 리월의 맛집 탐방이나 할래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890154
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890154,
					"content": "죽순 수프 얘기를 하던 이유가 그거였구나. 음… 하지만 그러면 패트리스는 어떡해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890155
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890155,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890156
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890156,
					"content": "#너희를 안 만났다면 난 정말로 포기했을지도 몰라. 모험가 {NICKNAME}… 그리고 페이몬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890157
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890157,
					"content": "이 실험에 대한 검증을 도와줄래? 너희에겐 그럴만한 실력이 있다는 걸 척 보면 알 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890158
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890158,
					"content": "보수는… 왕복 비용을 제외하면 경비가 30% 정도 남으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890159
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890159,
					"content": "#돈 문제가 아니야. {NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890160,
						736890162
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890160,
					"content": "알았어, 패트리스 씨를 위해서예요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890161
					]
				},
				{
					"id": 736890161,
					"content": "그렇게 말할 줄 알았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890164
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890164,
					"content": "둘 다 정말 고마워. 후우… 그럼 실험 내용에 관해 설명해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890165
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890165,
					"content": "패트리스가 남긴 기록에 따르면 「진동 수정」이라는 이름의 광석이 있다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890166
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890166,
					"content": "「진동 수정」 중에 「울림 수정」이 특정한 자극을 받으면 에너지를 방출해 「응답 수정」의 공명을 활성화시킬 수 있어. 둘 사이엔 「영사 관계」가 있지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890167
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890167,
					"content": "「영사 관계」를 통해 어떤 힘…과 공명이 발생하는데… 특정 대상에 영향을 준다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890168
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890168,
					"content": "음, 아나톨, 너 패트리스의 메모를 제대로 본 거 맞아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890169
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890169,
					"content": "어쨌든 크게 다르진 않을 거야. 흐음, 용어는 단지 장식일 뿐, 실험에선 데이터만이 사실이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890170
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890170,
					"content": "어쨌든 「진동 수정 영사」의 영향 아래 실험 장소에서 전투를 치르는 게 너희들의 역할이야, 괜찮겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890171
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890171,
					"content": "#진작 그렇게 말하지! 걱정하지 마, {NICKNAME} 얘가 싸움을 얼마나 잘하는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890172
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890172,
					"content": "제게 맡기세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890173
					]
				},
				{
					"id": 736890173,
					"content": "좋아! 조금 뒤에 실험을 시작하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890174
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890174,
					"content": "다만, 후우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890175
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890175,
					"content": "뭔데, 왜 또 뜸 들이는 건데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890176
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890176,
					"content": "죽순 수프가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890177
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890177,
					"content": "죽순 수프는 잊어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890162,
					"content": "그러면 페이몬 몫은 저한테 주세요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890163
					]
				},
				{
					"id": 736890163,
					"content": "아, 진짜 치사해. 그런 뜻이 아닌 거 알면서! 크흠… 도와는 줄게. 하지만 보상도 받아 갈 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890164
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890137,
					"content": "그래도 당신과는 상관없지 않나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890138
					]
				},
				{
					"id": 736890138,
					"content": "아, 방금도 말했지만 일이 그리 단순하게 흘러가진 않았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890139
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890125,
					"content": "알 것도 같고…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890126
					]
				},
				{
					"id": 736890126,
					"content": "기억은 잘 안 나지만 이 근처에서 광석이랑 씨름 중인 폰타인 사람을 본 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 736890127,
					"content": "맞는 것 같네, 가여운 패트리스",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736890128
					],
					"speakerTitle": "아나톨"
				},
				{
					"id": 736890108,
					"content": "페이몬, 정말 수상해!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736890109
					]
				}
			]
		}
	]
}