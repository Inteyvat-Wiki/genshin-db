				]
			},
			"dialogs": [
				{
					"id": 402270101,
					"content": "흠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270102
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 402270102,
					"content": "아이노, 이네파! 안녕!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402270103,
					"content": "#안녕하세요, {NICKNAME} 님, 페이몬 님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270104
					],
					"speakerTitle": "이네파"
				},
				{
					"id": 402270104,
					"content": "네페르의 의뢰로 참가 업체들을 안내하러 왔어. 뚝딱뚝딱 크룸카케 공방도 이번 전시회에 참가하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402270105,
					"content": "네. 지금 아이노 님께서 「우당탕탕 경비대」의 최종 테스트를 진행하고 계세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270106
					],
					"speakerTitle": "이네파"
				},
				{
					"id": 402270106,
					"content": "우당탕탕… 아, 그게 공방의 전시 물품인가 보구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402270107,
					"content": "항상 두더지 같은 동물들이 공방의 물건을 훔치려 해서, 아이노 님이 그 모습을 본떠 공방의 자산을 보호할 경비 장치를 제작하셨어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270108
					],
					"speakerTitle": "이네파"
				},
				{
					"id": 402270108,
					"content": "한 차례 테스트해 보니, 결과는 「매우 효과적」이었죠. 그래서 이번에는 그걸 전반적으로 업그레이드해 전시회에 출품할 계획이세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270109
					],
					"speakerTitle": "이네파"
				},
				{
					"id": 402270109,
					"content": "직접 만든 작품을 거래하려는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402270110,
					"content": "주문을 받고 만드는 물품이 아닌 이상, 직접 만든 작품을 판매하는 일은 거의 없습니다. 이번 전시회에 내놓으려는 건 설계도예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270111
					],
					"speakerTitle": "이네파"
				},
				{
					"id": 402270111,
					"content": "그렇구나…. 아, 그래서 전시회에 갈 준비는 다 됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402270112,
					"content": "야호다가 너흴 재촉해 달라고 부탁했어. 일부러 좋은 자리를 남겨뒀는데, 계속 비워두면 자기가 곤란해진대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402270113,
					"content": "야호다한텐 이미 말했잖아? 모든 조정이 끝나야 옮길 수 있다고! 아무리 급해도 소용없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270114
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 402270114,
					"content": "와, 아이노가 이렇게 진지한 건 처음 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402270115,
					"content": "최근 공방은 심각한 자금난에 처해 있습니다. 아이노 님은 이번 전시회를 통해 재정 상황을 개선하려 하시니, 신중하실 만하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270116
					],
					"speakerTitle": "이네파"
				},
				{
					"id": 402270116,
					"content": "자금난? 설마 엄청난 모라가 들어가는 연구라도 하고 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402270117,
					"content": "부족한 건 「연구 자금」이 아니라 「디저트 자금」입니다. 과거 기록에 따르면, 디저트를 과다 구매해 연구 자금에 구멍이 난 사례가 총 47회 있었습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270118
					],
					"speakerTitle": "이네파"
				},
				{
					"id": 402270118,
					"content": "그래서 전 공방의 원활한 운영을 위해 「연구 자금」과 「디저트 자금」을 분리하고, 아이노 님이 함부로 사용하시지 못하게 했죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270119
					],
					"speakerTitle": "이네파"
				},
				{
					"id": 402270119,
					"content": "그런데 얼마 전, 아이노 님이 한 달 치 「디저트 자금」을 전부 써버리셨습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270120,
						402270121
					],
					"speakerTitle": "이네파"
				},
				{
					"id": 402270120,
					"content": "그렇구나…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				},
				{
					"id": 402270122,
					"content": "완성이다! 우당탕탕 경비대, 가서 잘해야 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270123
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 402270123,
					"content": "이제 행사장으로 안내해 주시죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이네파"
				},
				{
					"id": 402270121,
					"content": "놀랍진 않네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				}
			]
		},
