				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080201,
					"content": "선인님, 제발 좀 살려주세요! …한 번만 봐주세요. 제발…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080202
					],
					"speakerTitle": "이정"
				},
				{
					"id": 10080202,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080203
					]
				},
				{
					"id": 10080203,
					"content": "다, 당신… 누구야? 어째서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080204
					],
					"speakerTitle": "이정"
				},
				{
					"id": 10080204,
					"content": "우리가 먼저 물어봤잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10080205,
					"content": "아, 알겠다! 절운간에서 이렇게 돌아다닐 수 있는 걸 보니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080206
					],
					"speakerTitle": "이정"
				},
				{
					"id": 10080206,
					"content": "당신은… 선인의 사절이시군요! 선인께서 저희 형제를 구하기 위해 보내신 사절 맞죠?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080207
					],
					"speakerTitle": "이정"
				},
				{
					"id": 10080207,
					"content": "이 사람 대체 뭐라는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10080208,
					"content": "사절님, 제발 저희 좀 도와주세요! 우린 너무 가난해서 도저히 가족을 부양할 수 없었어요. 그래서 호로산의 호박에 보물이 숨겨져 있다는 말을 듣고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080209
					],
					"speakerTitle": "이정"
				},
				{
					"id": 10080209,
					"content": "잠깐 어떻게 됐었나봐요. 호박 안에 있는 보물 몇 개만 팔아서 가족부터 먹여 살리자 싶었죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080210
					],
					"speakerTitle": "이정"
				},
				{
					"id": 10080210,
					"content": "그렇게 <color=#00E1FFFF>산길을 따라</color> 올라가고 있었는데, 갑자기 제 형제 이당이 호박에게 잡… 잡아 먹혀버렸지 뭐예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080211
					],
					"speakerTitle": "이정"
				},
				{
					"id": 10080211,
					"content": "그래서 부랴부랴 여기로 도망쳤는데, 생각해보니 아무래도 저희가 선인의 거처에 발을 들여 벌을 받은 것 같아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080212
					],
					"speakerTitle": "이정"
				},
				{
					"id": 10080212,
					"content": "제 형제를 어떻게 구해야 할지 몰라 이곳에서 줄곧 선인께 용서를 구했더니… 이렇게 사절님들이 오셨네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080213
					],
					"speakerTitle": "이정"
				},
				{
					"id": 10080213,
					"content": "사절? 우린 선인의 사절이 아니야. 우리도 선인을 찾으러 왔다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10080214,
					"content": "아, 아뇨. 당신들은 분명 선인의 사절일 거예요. 사절이어야만 해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080215
					],
					"speakerTitle": "이정"
				},
				{
					"id": 10080215,
					"content": "이당이 어느 호박 안에 갇혀 있는지 모르겠어요. 자비를 베푸셔서 제발 저 좀 도와주세요, 사절님…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080216,
						10080218
					],
					"speakerTitle": "이정"
				},
				{
					"id": 10080216,
					"content": "그러지… 내 한번 찾아보지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080217
					]
				},
				{
					"id": 10080217,
					"content": "아이고! 자비로우신 사절님, 정말 감사합니다. 다음부턴 절대 안 그럴게요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이정"
				},
				{
					"id": 10080218,
					"content": "알겠네. 다음부턴 그러지 말도록",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080219
					]
				},
				{
					"id": 10080219,
					"content": "모야, 모야… 이 연기력! 진짜 「선인의 사절」이라도 된 줄 알았잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10080220,
					"content": "감사합니다, 정말 감사합니다. 반드시 명심하겠습니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이정"
				}
			]
		},
