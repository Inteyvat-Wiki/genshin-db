				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010301,
					"content": "누구냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010302,
						120010304
					],
					"speakerTitle": "대무"
				},
				{
					"id": 120010302,
					"content": "몬드에서 온 상인이다. 무재공과 약속이 있어서 왔지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010303
					]
				},
				{
					"id": 120010303,
					"content": "응? 그렇다면 미리 알려줬을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "대무"
				},
				{
					"id": 120010306,
					"content": "어르신은 오늘 중요한 일이 생겨서 모든 약속을 취소하셨습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010307
					],
					"speakerTitle": "대무"
				},
				{
					"id": 120010307,
					"content": "「중요한 일」…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010308,
					"content": "요즘 어르신께선 중요한 사업 때문에 바쁘십니다. 그래서 아침 일찍 귀빈을 모시러 나갔습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010309
					],
					"speakerTitle": "대무"
				},
				{
					"id": 120010309,
					"content": "어디로 가셨나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010310,
					"content": "죄송합니다. 어르신께서 말하지 말라고 특별히 당부하셔서 알려드릴 수 없습니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010311
					],
					"speakerTitle": "대무"
				},
				{
					"id": 120010311,
					"content": "그럼 우린 귀빈이 아니라는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010312
					]
				},
				{
					"id": 120010312,
					"content": "아,아닙니다. 기분을 상하게 해드릴 생각은 없었습니다. 신경 쓰지 마십시오!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010313,
						120010314
					],
					"speakerTitle": "대무"
				},
				{
					"id": 120010313,
					"content": "무재공을 못 만나게 한다면, 큰일 날 줄 알아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010315,
					"content": "죄송합니다, 죄송합니다! 어르신은 지금 신월헌에 계십니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010316
					],
					"speakerTitle": "대무"
				},
				{
					"id": 120010316,
					"content": "노여움을 푸십시오. 제발 어르신에게 이르지 말아 주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010317
					],
					"speakerTitle": "대무"
				},
				{
					"id": 120010317,
					"content": "우리 어르신께선 또 중요한 일이 있으시니, 여기까지만 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010318,
					"content": "우리 어르신과 무재공의 사업 얘기가 잘 끝나서 네 무례함을 잊길 바라라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010319,
					"content": "고, 고맙습니다! 어르신들의 모든 사업에 암왕제군의 가호가 있길!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010320
					],
					"speakerTitle": "대무"
				},
				{
					"id": 120010320,
					"content": "#{NICKNAME}한테 이런 재능이 있는 줄은 몰랐네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010321,
						120010323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010321,
					"content": "그냥 어쩌다 보니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010322
					]
				},
				{
					"id": 120010322,
					"content": "이제부터 너한테 속지 않으려면 조심해야겠는걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010325,
					"content": "경비병이 말한 귀빈은 「우인단」인 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010326,
						120010327
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010326,
					"content": "나도 그렇게 생각해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010328,
					"content": "응, 그럼 신월헌으로 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010327,
					"content": "타이밍을 맞추는 게 제일 중요하지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010323,
					"content": "너도 연기 잘하던데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010324
					]
				},
				{
					"id": 120010324,
					"content": "헤헤, 고마우면 맛있는 디저트 사줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010314,
					"content": "어르신이 돌아오면 너에게 어떤 형벌을 내릴지 두고 보지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010304,
					"content": "#난 {NICKNAME}, 네 주인님의 귀한 손님이다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010305
					]
				},
				{
					"id": 120010305,
					"content": "이상하네, 명단에 그런 이름은 없는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "대무"
				}
			]
		},
