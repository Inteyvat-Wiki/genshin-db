			},
			"dialogs": [
				{
					"id": 120010801,
					"content": "다른 볼일이 있다면서 신비한 척은 혼자 다 하더니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010802
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010802,
					"content": "장소만 바꿔서 책을 읽고 있잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010803
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010803,
					"content": "무재공의 사업에 대해 대충 파악했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010804
					]
				},
				{
					"id": 120010804,
					"content": "그렇군, 내 예상과 비슷해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010805
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120010805,
					"content": "정말 예상이란 걸 해보긴 한 거야…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010806
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010806,
					"content": "방법은 이미 생각해뒀어. 이 편지를 「비운 상회」의 가복에게 좀 전달해줘. 그럼 알아서 처리해 줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010807
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120010807,
					"content": "난 사정이 있어서 너희와 함께 갈 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010808
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120010808,
					"content": "편지의 내용은 굳이 볼 필요 없어, 때가 되면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010809
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120010809,
					"content": "윽, 이게 글씨야? 봐도 무슨 말인지 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010810,
						120010811
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010810,
					"content": "고대 문자인가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				},
				{
					"id": 120010812,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010813
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120010813,
					"content": "그러니까 볼 필요 없다고 했잖아, 안 봐도… 전혀 문제 없다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010814
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120010814,
					"content": "그 사람은 이 편지를 읽을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010815
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120010815,
					"content": "근데 「비운 상회」에 가서 도움을 요청하려고? 거긴 리월에서도 명성이 자자한 상회잖아. 우릴 도울 이유가 없을 텐데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010816
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010816,
					"content": "「비운 상회」?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010817
					]
				},
				{
					"id": 120010817,
					"content": "리월에 와서 자주 들었던 이름이야. 이것저것 벌이는 사업이 많다던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010818
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010818,
					"content": "그렇게 큰 상회가 도와준다면야 좋겠지만… 정말 우릴 도와줄까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010819
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010819,
					"content": "그건 걱정 마. 내가 알기론 그들도 나처럼 의협심이 넘치니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010820
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120010820,
					"content": "이 진심이 담긴 감동적인 편지를 읽는다면 반드시 도와줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010821,
						120010822
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120010821,
					"content": "정말 효과가 있을까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010823,
					"content": "무재공을 단단히 혼내주려면 우리의 힘만으론 부족해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010824
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120010824,
					"content": "그리고 난, 이 일에 내가 개입됐다는 사실이 알려지길 원치 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010825
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120010825,
					"content": "어째서? 상구야에게 은혜를 갚으려는 거 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010826
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010826,
					"content": "「거사를 마치면 옷을 털고 자신의 공로와 이름을 숨긴다」, 이게 바로 협객의 근본이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010827
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120010827,
					"content": "물 한 방울의 은혜라도 넘치는 샘물로 보답하라. 난 그저 은혜를 갚는 것일 뿐, 인정을 베푸는 것도 보답을 바라는 것도 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010828
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120010828,
					"content": "말은 그럴싸하지만, 그냥 책이 읽고 싶은 거잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010829
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010829,
					"content": "그럼 「비운 상회」의 가복에게 편지를 전해줘. 지금 아마 유리정 근처에 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010830
					],
					"speakerTitle": "행추"
				},
				{
					"id": 120010830,
					"content": "내 말 무시하지 말라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120010822,
					"content": "왜 그들을 찾아가야 하지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010811,
					"content": "암호가 적힌 비밀문서?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				}
			]
