					"content": "쉿…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660249
					],
					"speakerTitle": "타이나리"
				},
				{
					"id": 401660249,
					"content": "아차차… 신나서 깜빡할 뻔했어…. 비밀 지켜야지, 비밀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
