			"dialogs": [
				{
					"id": 761000701,
					"content": "길 막지 말고 저리 비켜!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000702
					],
					"speakerTitle": "일루가"
				},
				{
					"id": 761000702,
					"content": "후후… 왜 그렇게 서두르지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000703
					],
					"speakerTitle": "마물의 목소리"
				},
				{
					"id": 761000703,
					"content": "어차피 너희는… 결국 다 죽게 될 거다… 그저… 누가 먼저 가느냐의 차이일 뿐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000704
					],
					"speakerTitle": "마물의 목소리"
				},
				{
					"id": 761000704,
					"content": "저놈은 3년 전에… 못 죽은 게 한이라 했다… 그래서… 내가 대신 끝내줬지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000705
					],
					"speakerTitle": "마물의 목소리"
				},
				{
					"id": 761000705,
					"content": "…비에른? 너 무슨 짓을 한 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000706
					],
					"speakerTitle": "일루가"
				},
				{
					"id": 761000706,
					"content": "놈은 약했다… 약자는 쓰레기나 벌레랑 다를 바 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000707
					],
					"speakerTitle": "마물의 목소리"
				},
				{
					"id": 761000707,
					"content": "…저런 놈은 밟혀 죽는 게 순리 아니겠는가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000708
					],
					"speakerTitle": "마물의 목소리"
				},
				{
					"id": 761000708,
					"content": "비에른을 모욕하지 마! 비에른은 약한 사람이 아니야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000709
					],
					"speakerTitle": "일루가"
				},
				{
					"id": 761000709,
					"content": "오… 네 눈엔… 그가 강자로 보였나 보군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000710
					],
					"speakerTitle": "마물의 목소리"
				},
				{
					"id": 761000710,
					"content": "하지만… 강하다고… 죽지 않는 건 아니지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000711
					],
					"speakerTitle": "마물의 목소리"
				},
				{
					"id": 761000711,
					"content": "너도… 잘 알고 있을 텐데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000712
					],
					"speakerTitle": "마물의 목소리"
				},
				{
					"id": 761000712,
					"content": "너보다 강한 놈은… 모조리 죽었다… 3년 전에도… 10년 전에도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000713
					],
					"speakerTitle": "마물의 목소리"
				},
				{
					"id": 761000713,
					"content": "…그 입 다물어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000714
					],
					"speakerTitle": "일루가"
				},
				{
					"id": 761000714,
					"content": "그래… 결국 약한 건… 너뿐이었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000715
					],
					"speakerTitle": "마물의 목소리"
				},
				{
					"id": 761000715,
					"content": "아니라면 왜… 매번… 너만 살아남은 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000716
					],
					"speakerTitle": "마물의 목소리"
				},
				{
					"id": 761000716,
					"content": "…매번 전장에서 구차하게 도망친 겁쟁이 주제에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000717
					],
					"speakerTitle": "마물의 목소리"
				},
				{
					"id": 761000717,
					"content": "일루가! 저런 헛소리 듣지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000718
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761000718,
					"content": "헛소리는 그만하고, 사라져라!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761000719
					]
				},
				{
					"id": 761000719,
					"content": "#…{NICKNAME}! 빨리 처리하죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "일루가"
				}
			]
		},
