			"dialogs": [
				{
					"id": 4700201,
					"content": "와! 맛있어! 맛있다궁!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4700202,
					"content": "「디어 헌터」의 어부 토스트는 진짜 대박이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4700203,
					"content": "그래도 사실 버터 송이구이는 레시피가 공개된 전통 요리 가운데 하나야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4700204,
					"content": "식자재만 충분하다면 나중에 너도 만들어 볼 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4700205,
					"content": "너의 실력이라면 「디어 헌터」보다 더 맛있는 요리를 만들 수 있지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4700206,
					"content": "너의 전용 시식원이 되어줄게!",
