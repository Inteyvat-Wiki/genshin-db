						4700102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4700102,
					"content": "<color=#00E1FFFF>어부 토스트</color> 냄새야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4700103,
					"content": "응… 응…. 「디어 헌터」 레스토랑 쪽에서 나는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4700104,
					"content": "부드러운 토스트야…. 심지어 두툼하다구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4700105,
					"content": "양파를 가득 올리고 노르스름하게 구워 한입 베어 물면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4700106,
					"content": "좋아! 결정했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4700107,
					"content": "지금 바로 <color=#00E1FFFF>「디어 헌터」</color>에 가서 <color=#00E1FFFF>어부 토스트</color>를 하나 사자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4700108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4700108,
					"content": "물론 네가 쏘는 거지",
					"roleType": "TALK_ROLE_NPC",
