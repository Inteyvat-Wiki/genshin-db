			"dialogs": [
				{
					"id": 752440101,
					"content": "오, 너도 낚시하러 왔어? 낚시를 하려면 말이야, 아주 단단한 모자를 써야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440106
					],
					"speakerTitle": "란티"
				},
				{
					"id": 752440106,
					"content": "왜 모자를 써야 하나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440102
					]
				},
				{
					"id": 752440102,
					"content": "모자를 써야 안전하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440107
					],
					"speakerTitle": "란티"
				},
				{
					"id": 752440107,
					"content": "당신도 모자를 안 쓰고 있잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440103
					]
				},
				{
					"id": 752440103,
					"content": "그래서 너한테 말을 건 거야… 부끄럽지만, 내 모자가 바람에 날아가 버렸거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440104
					],
					"speakerTitle": "란티"
				},
				{
					"id": 752440104,
					"content": "괜찮다면 같이 찾아줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440108
					],
					"speakerTitle": "란티"
				},
				{
					"id": 752440108,
					"content": "왜 직접 찾으러 가지 않으세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440105
					]
				},
				{
					"id": 752440105,
					"content": "모자를 찾으러 가면 낚싯대를 내려놔야 하고, 낚싯대를 들면 모자를 찾으러 갈 수가 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440109
					],
					"speakerTitle": "란티"
				},
				{
					"id": 752440109,
					"content": "그러니까 제발 날 좀 도와줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "란티"
				}
			]
		},
