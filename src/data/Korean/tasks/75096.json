			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"티조크"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750960201,
					"content": "「산왕 화염류탄」이 드디어 익었군. 한시름 놓았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960202
					],
					"speakerTitle": "티조크"
				},
				{
					"id": 750960202,
					"content": "어라, 너구나. 왜 그래? 들어갈 거면 얼른 서두르라고. 부족 사람들한테 들키지 않게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960203,
						750960208,
						750960212
					],
					"speakerTitle": "티조크"
				},
				{
					"id": 750960203,
					"content": "「산왕」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750960204
					]
				},
				{
					"id": 750960204,
					"content": "아, 「산왕」님에 대해 알고 싶은 거구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960205
					],
					"speakerTitle": "티조크"
				},
				{
					"id": 750960205,
					"content": "「산왕」 콩가마토는 옛날에 영웅들과 함께 심연에 맞서 싸웠던 용이야. 그래서 부족 사람들의 존경을 받고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960206
					],
					"speakerTitle": "티조크"
				},
				{
					"id": 750960206,
					"content": "「산왕」님이 먹을 수 있도록 「산왕 화염류탄」을 따다 바치는 전문 인력도 있어. 다른 숲룡들도 몰래 그분에게 열매를 바친다는 이야기가 있는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960207
					],
					"speakerTitle": "티조크"
				},
				{
					"id": 750960207,
					"content": "그래서 「산왕」님이 다른 숲룡보다… 음, 풍채가 좋은 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "티조크"
				},
				{
					"id": 750960208,
					"content": "화염류탄 열매에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750960209
					]
				},
				{
					"id": 750960209,
					"content": "그건 또 내가 잘 알지. 화염류탄 열매 나무는 정말 놀라운 열소 식물이야. 뿌리를 액체 열소 위로 내릴 수 있다니…. 정말 대단한 용기라고밖에 할 수 없다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960210
					],
					"speakerTitle": "티조크"
				},
				{
					"id": 750960210,
					"content": "게다가 열매에도 열소가 가득해서 숲룡의 훌륭한 먹이지. 녀석들이 그걸 던지지만 않는다면 좋을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960211
					],
					"speakerTitle": "티조크"
				},
				{
					"id": 750960211,
					"content": "세게 부딪히면 화염류탄 열매는 폭발하거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "티조크"
				},
				{
					"id": 750960212,
					"content": "그냥 지나가는 중이었어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750960213
					]
				},
				{
					"id": 750960213,
					"content": "그렇구나…. 진짜 「산왕 화염류탄」 구경 안 할 거야? 보기만 해도 기분이 좋아질 텐데…. 고민이 생기면 꼭 보러 오도록 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "티조크"
				}
			]
		}
	]
}