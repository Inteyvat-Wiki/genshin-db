					"아판"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050301,
					"content": "좋데이, 아주 좋데이. 자네들 억수로 대단하다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050302
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050302,
					"content": "전문가의 손길을 받았으니 이번에는 확실히 잘 자랄 기다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050303
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050303,
					"content": "저번에 줬던 샤와르마랑 타친은 맛이 어땠나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050304,
						732050306
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050304,
					"content": "맛있었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050305
					]
				},
				{
					"id": 732050305,
					"content": "맛있었다니 그라믄 또 해줘야겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050307
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050307,
					"content": "먼저 간 아내만큼은 아니지만 내 솜씨도 나쁘진 않다. 이번엔 조금 적긴 하지만 그래도 가져가래이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050308
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050308,
					"content": "맛있었어! 아판 할아버지, 정말 대단해! 앞으로도 자주 올게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732050309,
					"content": "하하, 자네들 전에 이게 무슨 꽃인지 궁금해하지 않았나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050310
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050310,
					"content": "자네들이라면 알려줘도 될 것 같데이. 내가 심은 건 장미다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050311
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050311,
					"content": "수메르 장미랑 같은 꽃인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050312
					]
				},
				{
					"id": 732050312,
					"content": "내가 심은 꽃은 「황금 장미」라고 부른다. 크흠, 수메르 장미보다 훨씬 귀한 기다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050313
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050313,
					"content": "이 꽃씨는 어떤 친구에게 받은 거라고 말했는데 기억나나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050314
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050314,
					"content": "사실 이 씨앗들과 내가 지금 사는 낡은 집은 이미 세상을 떠난 망태 할아범이 내한테 준 기다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050315
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050315,
					"content": "아, 맞나. 자네들은 아루 마을 사람이 아니니 그 이름을 들어본 적이 없나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050316
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050316,
					"content": "몰라도 상관없다. 그저 꽃을 좀 심을 줄 아는 늙은이였다는 것만 기억해 주면 된데이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050317
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050317,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050318
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050318,
					"content": "아판 할아버지, 갑자기 왜 가만있는 거야? 아판 할아버지, 할아버지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732050319,
					"content": "아이고, 내가 또 정신을 딴 데다 뒀나? 나이가 많으면 자주 이런다. 못 볼 꼴을 보였데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050320
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050320,
					"content": "이번에도 자네들한테 정말 고맙데이. 또 보고 싶은 게 있으면 이곳저곳 돌아다녀 보래이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050321
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050321,
					"content": "더 이상 사람을 쫓아내지 않을 기다. 그래도 모밭은 밟지 않도록 주의하래이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아판"
				},
				{
					"id": 732050306,
					"content": "아직 안 먹어봤어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050307
					]
				}
			]
		},
