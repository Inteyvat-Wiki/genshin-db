					"아판"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040701,
					"content": "아이고, 아직 밥을 안 지어서 자네들에게 줄 게 없는데 우야노",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040702,
						732040703
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732040702,
					"content": "저희는 괜찮아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				},
				{
					"id": 732040704,
					"content": "저 얼라는 네 친구 맞제, 귀엽데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040705
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732040705,
					"content": "내가 심은 씨앗이 꽃을 피우면 와서 한번 보겠나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040706
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732040706,
					"content": "물론이죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040707
					]
				},
				{
					"id": 732040707,
					"content": "좀만 있으면 활짝 피어날 테니 나중에 다시 와봐라. 자네들이 심은 거나 다름없다 아이가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040708
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732040708,
					"content": "그럴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040709
					]
				},
				{
					"id": 732040709,
					"content": "그래, 알았데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040710
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732040710,
					"content": "♪으흥흥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아판"
				},
				{
					"id": 732040703,
					"content": "배 안 고파요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				}
			]
		},
		{
			"id": 7320501,
			"completionStepIds": [
				7320501
			],
