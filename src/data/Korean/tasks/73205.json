			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"아판"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050101,
					"content": "왔나, 와서 씨앗들 좀 보래이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050102
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050102,
					"content": "아무 변화 없는 것 같은데요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050103
					]
				},
				{
					"id": 732050103,
					"content": "맞나, 내가 농사는 꽤 지어봤지만 꽃을 심는 건 또 다르더래이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050104
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050104,
					"content": "그게 아니라면 이렇게 오래도록 자라지 않을 이유가 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050105
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050105,
					"content": "어디 보자, 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732050106,
					"content": "아판 할아버지, 모밭이 너무 건조한 것 같아. 아루 마을 근처 땅은 양분도 부족한 것 같고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732050107,
					"content": "전에 아루 마을에서 꽃 심는 걸 도와준 경험이 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732050108,
					"content": "오호, 맞나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050109
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050109,
					"content": "일리가 있다. 이런 희귀한 꽃씨는 일반 화초보다 연약해서 물이랑 비료가 확실히 부족하긴 하데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050110
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050110,
					"content": "하지만 이 모밭은 물이 있는 곳에서 멀리 떨어져 있어서 물을 끌어오기가 아주 복잡하데이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050111
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050111,
					"content": "내가 사용하려고 모아둔 물도 별로 없다이가. 모밭의 씨앗에 자주 물을 주는 건 쪼매 힘들다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050112
					],
					"speakerTitle": "아판"
				},
				{
					"id": 732050112,
					"content": "제가 도와드릴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050113
					]
				},
				{
					"id": 732050113,
					"content": "맞나, 일단 자네들이 이 씨앗 3개에 물을 좀 줄 수 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아판"
				}
			]
		},
		{
			"id": 7320503,
