					"화청"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200401,
					"content": "멈춰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200402
					],
					"speakerTitle": "화청"
				},
				{
					"id": 10200402,
					"content": "누구냐! 감히 중요 구역에 침입하다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200403,
						10200404
					],
					"speakerTitle": "화청"
				},
				{
					"id": 10200403,
					"content": "침입? 우린 그냥 지나가는 길인데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				},
				{
					"id": 10200405,
					"content": "맞아! 대체 무슨 말을 하는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10200406,
					"content": "우린 초대를 받고 온 귀빈이라고! 왜 우리한테 이런 대접을…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10200407,
					"content": "아니… 잠깐… 설마 응광이… 일부러!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10200408,
					"content": "우릴 군옥각에 초대하는 척하고 여기에 천암군을 매복시켜서 우릴 잡으려고 했나 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200409,
						10200410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10200409,
					"content": "그건 아닐 거야….",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200411,
					"content": "으으——나 화났어! 이거 함정 수사 맞지?! 이 뻔뻔한 녀석들!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200412
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10200412,
					"content": "뭐…? 우린 그냥 경비 임무 중인데 뭐가 뻔뻔하다는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200413
					],
					"speakerTitle": "화청"
				},
				{
					"id": 10200413,
					"content": "허튼소리뿐이군. 수상하니 일단 잡고 보자고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200414
					],
					"speakerTitle": "단양"
				},
				{
					"id": 10200414,
					"content": "온다! 전부 때려눕혀 버려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10200410,
					"content": "아직 초대받았다는 말은 안 했어….",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200404,
					"content": "중요 구역? 여긴 천형산 들판인걸요….",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				}
			]
		},
