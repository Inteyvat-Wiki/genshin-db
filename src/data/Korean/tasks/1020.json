			"dialogs": [
				{
					"id": 10200101,
					"content": "봐! 하늘에 있는 저게 바로 「군옥각」이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200102,
						10200103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10200102,
					"content": "엄청 높다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				},
				{
					"id": 10200104,
					"content": "흐음… 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10200105,
					"content": "계산 착오야! 가이드인 나도 「하늘」로 가는 길을 잘 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200106,
						10200107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10200106,
					"content": "그걸 이제 안 거야…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200108,
					"content": "우으…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10200109,
					"content": "지도에서 군옥각 위치를 직접 찾아보는 것도 좋은 방법이라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10200110,
					"content": "이 근처에 분명 올라가는 길이 있을 거야! 찾아보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10200107,
					"content": "감우라는 그 사절에게 물어볼걸",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200103,
					"content": "어떻게 올라가지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				}
			]
		},
		{
			"id": 102002,
			"completionStepIds": [
				102002
