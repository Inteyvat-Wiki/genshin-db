			},
			"dialogs": [
				{
					"id": 10200201,
					"content": "봐! 저기 장치가 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10200202,
					"content": "저기에 나타난 걸 보면 분명 군옥각과 관련 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200203,
						10200205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10200203,
					"content": "군옥각으로 통하는 길이 아닐까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200204
					]
				},
				{
					"id": 10200204,
					"content": "틀림없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10200205,
					"content": "그냥 함정 아닐까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200206
					]
				},
				{
					"id": 10200206,
					"content": "뭐래!? 내 직감을 못 믿는 거야!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
