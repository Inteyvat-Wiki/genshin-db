				},
				{
					"id": 100030403,
					"content": "그럴 수밖에 없겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 100030404,
					"content": "하지만 여기 안 계신 걸 보면… 정말로 이분이 노드크라이에 납치된 구 작가 선생님은 아닐까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030405
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 100030405,
					"content": "이분의 거처를 살펴보면 어떻겠습니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100030406
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 100030406,
					"content": "남의 집을 멋대로 뒤지는 건 좋지 않지만, 만약 상구야가 진짜 구 작가 선생이면… 역시 한번 살펴보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
