				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730180801,
					"content": "와——지하로 향하는 입구가… 정말 열렸네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180802
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180802,
					"content": "왠지 엄청 낯선 느낌이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180803
					]
				},
				{
					"id": 730180803,
					"content": "확실히 큰 구멍이 뚫렸어… 다행히 중심이 뚫리진 않았나보네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180804
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180804,
					"content": "#나라{NICKNAME}, 페이몬, 우리 같이 내려가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180805
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730180805,
					"content": "앞으로 가는 길을 매우 조심해야 해. 지하는 햇빛이 거의 들지 않는 어두운 곳이야. 과거에는 씨앗들이 잠들어 있던 곳이었지만, 지금은 아마도「버섯」의 소굴일지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180806
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730180806,
					"content": "#나라{NICKNAME}와(과) 페이몬은 아란나라의 파트너야, 비록 아란나라의 힘이 크진 않지만, 위험이 닥치면 아란나라는 최선을 다해 너희를 보호할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180807
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730180807,
					"content": "아란바리카가 있으니 두려울 것이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180808
					],
					"speakerTitle": "아란바리카"
				},
				{
					"id": 730180808,
					"content": "#오! 나와 {NICKNAME}은(는) 수많은 질풍노도를 경험해 왔어! 이런 사소한 일로는 두려워하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180809
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180809,
					"content": "아래에는 강풍과 물이 없을 걸, 아, 있을 수도 있지만 파도는 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180810
					],
					"speakerTitle": "아란쿤티"
				},
				{
					"id": 730180810,
					"content": "음… 아란쿤티는 여전히 다른 사람의 말을 들리는 대로만 이해하는구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180811
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180811,
					"content": "「질풍노도」는 많은 일들을 경험 해 봤다는 뜻이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180812
					]
				},
				{
					"id": 730180812,
					"content": "이젠 알겠어. 페이몬의 말은 이해하기가 참 어려워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180813
					],
					"speakerTitle": "아란쿤티"
				},
				{
					"id": 730180813,
					"content": "피차일반이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180814
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180814,
					"content": "아무튼 버섯몬 따윈 하나도 안 무서워, 정말 버섯몬의 소굴이라면… 오늘 저녁은 버섯 요리 풀코스다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180815
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180815,
					"content": "#{NICKNAME}, 준비되었으면 얼른 내려가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
