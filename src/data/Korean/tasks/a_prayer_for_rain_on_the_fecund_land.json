	"talks": [
		{
			"id": 7301802,
			"completionStepIds": [
				7301802
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301802",
							"2"
						],
						"stepId": 7301802,
