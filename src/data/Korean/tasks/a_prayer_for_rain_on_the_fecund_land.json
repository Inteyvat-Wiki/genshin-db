				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730182101,
					"content": "지금은… 일단 안전한 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730182102,
					"content": "#나라{NICKNAME}, 너의 용감함에 고마워. 바루나 신기의 뿌리를 갉아 먹던 나쁜 벌레들을 해치웠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182103
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730182103,
					"content": "바나 각지에 흩어진 나뭇가지 들도 힘을 전송하였으니, 이제는 아란나라가 바루나 신기를 수리할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182104
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730182104,
					"content": "식은 죽 먹기지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730182105
					]
				},
				{
					"id": 730182105,
					"content": "내가 말했지, 버섯몬들을 두려워할 필요가 없다니까! 열 개가 더 온다고 해도 무섭지 않아! 흥흥",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182106,
						730182108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730182106,
					"content": "몸 푸는 느낌이지 뭐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730182107
					]
				},
				{
					"id": 730182107,
					"content": "#난 알고 있었어, {NICKNAME}는 버섯몬을 무서워하지 않아, 흥흥",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730182110,
					"content": "아까 다들 열심히 나쁜 녀석을 상대하고 있는데, 페이몬만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182111
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730182111,
					"content": "전혀 도와주지 않았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182112
					],
					"speakerTitle": "아란쿤티"
				},
				{
					"id": 730182112,
					"content": "#그럴 리가! 나… 나는 최선을 다해 {NICKNAME}를 응원했어, {NICKNAME}도 내 마음을 느꼈지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182113,
						730182115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730182113,
					"content": "느꼈지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730182114
					]
				},
				{
					"id": 730182114,
					"content": "#헤헤, 과연 나와 {NICKNAME}는 마음이 통하는군!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730182117,
					"content": "#아무튼, 나라{NICKNAME}와(과) 페이몬한테 정말 고마워, 아란나라에게 정말로 많은 도움을 주었어. 다음은 우리가 나설 차례야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182118
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730182118,
					"content": "좋았어! 코를 간질거리게 하는 이 포자들과 이제 곧 작별할 수 있겠네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730182115,
					"content": "아닌데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730182116
					]
				},
				{
					"id": 730182116,
					"content": "#그럴 리가! {NICKNAME}, 내 마음을 열심히 느껴야 하는데… 틀림없이 느낄 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730182108,
					"content": "진짜 열 개가 나타나면 페이몬에게 부탁할게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730182109
					]
				},
				{
					"id": 730182109,
					"content": "어? 그럼 안 되지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730182110
					],
					"speakerTitle": "페이몬"
				}
			]
		},
