				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730180401,
					"content": "가까이에서 보니까 더욱 놀라운걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180402,
					"content": "바루나 신기는 초목의 왕의 창조에서 유래 되었지. 생명을 가져다주는 물을 가져오고, 바루카를 바나로 바꾸고, 과거의 노란색을 녹색으로 대체해서 불모지에 생기가 넘치도록 하였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180403
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730180403,
					"content": "듣고 보니 너무 신기해, 「생명을 가져다주는 물」… 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180404,
					"content": "그럼 이 물 마셔도 돼? 특별한 효과라도 있진 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180405,
						730180414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180405,
					"content": "다시 어려질지도 모르지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180406
					]
				},
				{
					"id": 730180406,
					"content": "#응? {NICKNAME}일까 나일까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180407,
						730180411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180407,
					"content": "물론 꼬마 페이몬이지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180408
					]
				},
				{
					"id": 730180408,
					"content": "지금보다 더 작으면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180409,
					"content": "치친 같겠다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180410
					]
				},
				{
					"id": 730180410,
					"content": "그 정도로 작지는 않거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180418
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180418,
					"content": "페이몬에겐 물이 필요해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180419
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730180419,
					"content": "만약 페이몬이 씨앗이 되면, 아란나쿨라는 페이몬을 잘 보살펴 줄 거야, 물도 주고, 햇볕이 드는 곳에 자리도 잡아주고 흙도 부드럽게 해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180420
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730180420,
					"content": "페이몬에게 음악을 연주해 주며, 페이몬이 모르는 바나의 일을 얘기 해 주면서 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180421
					],
					"speakerTitle": "아란쿤티"
				},
				{
					"id": 730180421,
					"content": "아란바리카는 페이몬을 보러 자주 오는 건 아니지만, 올 때마다 버섯을 갖고 와서 삶아 줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180422
					],
					"speakerTitle": "아란쿤티"
				},
				{
					"id": 730180422,
					"content": "아란바리카는 그런 짓 절대 안 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180423
					],
					"speakerTitle": "아란바리카"
				},
				{
					"id": 730180423,
					"content": "오, 이런 생활을 들어보니 참 재밌는 걸… 잠깐! 나는 씨앗 같은 건 되지 않을 거야! 여기가 바로 들어오면 나갈 생각을 하지 말아야 한다는 무서운 숲인가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180424
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180424,
					"content": "… 이런 말들이 귀여운 얼굴을 한 아란나라 입에서 나왔다고 생각하면 더 끔찍한데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180425
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180425,
					"content": "페이몬 무럭무럭 자라서 하루빨리 열매를 맺어줘",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180426
					]
				},
				{
					"id": 730180426,
					"content": "#{NICKNAME}! 너까지 이런 말로 사람 놀라게 할 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180427
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180427,
					"content": "나라와 페이몬은 아란나라처럼 줄곧 바나에 머물지 않을 거란걸 아란나쿨라도 알고 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180428
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730180428,
					"content": "#알아… 나라{NICKNAME}와(과) 페이몬은 다른 사명이 있어서 바나를 떠날 거란걸, 다른 나라들처럼 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180429
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730180429,
					"content": "이제 우리는 아란나라의 사명을 완수해야 해. 바루나 신기를 정지한 후 아래로 내려가서 나쁜 벌레들을 제거하면 바루나 신기를 수리할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730180411,
					"content": "나는 아닐 거 아냐?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180412
					]
				},
				{
					"id": 730180412,
					"content": "그런 거라면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180413,
					"content": "#헤헤, 「귀여운 {NICKNAME}, 페이몬이 널 보살펴 줄게, 내가 안아줄게~」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180418
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180414,
					"content": "불로장생할지도 모르겠다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180415
					]
				},
				{
					"id": 730180415,
					"content": "와, 그러면 티바트를 깡그리 다 먹을 수 있잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180416
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180416,
					"content": "하지만 맛있는 음식을 함께 즐길 파트너는 점차 죽어가겠지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180417
					]
				},
				{
					"id": 730180417,
					"content": "음… 너무 오래 살아도, 꼭 좋은 건 아니야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180418
					],
					"speakerTitle": "페이몬"
				}
			]
