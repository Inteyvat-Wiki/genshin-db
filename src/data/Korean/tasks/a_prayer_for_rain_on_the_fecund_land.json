					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아란판두",
					"페이몬",
					"아란바리카"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730180201,
					"content": "#나라{NICKNAME}, 그리고 페이몬, 아란나라를 도와줘서 정말 고마워. 곳곳에서 계곡을 가로막고 있었던 잔가지들이 제거된 걸 느낄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180202
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730180202,
					"content": "오! 이제 우리 바루나 신기를 수리하러 가도 되겠네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180203,
					"content": "곧 가도 되는데 아직이야. 뿌리는 아주 깊은 땅속에 있고, 지하로 통하는 입구는 바루나 법보의 중심에 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180204
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730180204,
					"content": "「바루나 법보」, 아란판두가 얘기했던 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180205,
					"content": "#바루나 신기 힘이 표출되는 거지, 바루나 신기가 힘을 발휘할 때, 바나의 가장 큰 나무보다 더 높이 솟아 있어. 나라{NICKNAME}와(과) 페이몬은 이미 본 적이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180206
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730180206,
					"content": "가끔 물줄기가 솟는 그곳 말하는 거야? …설마 우리가 그 물줄기의 중심으로 들어가야 하는 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180207,
						730180209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180207,
					"content": "입구가 아닌 것 같던데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180208
					]
				},
				{
					"id": 730180208,
					"content": "맞아, 맞아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180211,
					"content": "만약 우리가 들어가려고 할 때 그게 마침 작동하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180212,
					"content": "그렇게 높은 물줄기라니, 물살도 엄청 강해 보이던데… 어떻게 그 중심으로 들어가야 할지 도무지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180213,
						730180215,
						730180217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180213,
					"content": "위로 들어갈 방법을 찾아야겠다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180214
					]
				},
				{
					"id": 730180214,
					"content": "#난 날아서 올라간다고 해도 {NICKNAME}는 안 되잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180219,
					"content": "왜 그래야 하지? 그걸 그냥 멈추면 되잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180220
					],
					"speakerTitle": "아란바리카"
				},
				{
					"id": 730180220,
					"content": "멈출 수도 있는 거였어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180221,
					"content": "#전에는 불가능했지만, 나라{NICKNAME}와(과) 페이몬의 도움으로 바루나 신기의 힘이 일부 회복되었으니 이제 아란나라가 그것을 멈추게 할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180222
					],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730180222,
					"content": "우린 우리도 모르는 사이에 이렇게 대단한 일을 해냈구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180223,
						730180225
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180223,
					"content": "사실 우리도 모르는 사이에 그런 건 아니지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180224
					]
				},
				{
					"id": 730180224,
					"content": "아, 하긴, 꿈의 숲부터 찾느라 힘들긴 했지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180227
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180227,
					"content": "#나라{NICKNAME}, 페이몬, 우리 같이 가자. 푸른 가지에 꽃이 피었으니, 곧 열매 맺을 때가 되었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란판두"
				},
				{
					"id": 730180225,
					"content": "페이몬 진짜 대단한걸!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180226
					]
				},
				{
					"id": 730180226,
					"content": "#{NICKNAME}도 대단해, 헤헤, 우리 둘 다 모두 대단해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180227
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180215,
					"content": "정면으로 부딪치는 수밖에 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180216
					]
				},
				{
					"id": 730180216,
					"content": "폭포수 밑에 서서 물살의 충격을 받는 수행법이 있다고 하긴 하던데… 우리처럼 생각 없이 그냥 뛰어들면 분명 휩쓸려 버릴 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730180217,
					"content": "옆에 터널을 파서 내려갈 수 있지 않을까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180218
					]
				},
				{
					"id": 730180218,
					"content": "이건 무슨 참신한 해결책이지? … 잠깐, 혹시 한번 해볼 만한 가치가 있지 않을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180219
					],
					"speakerTitle": "페이몬"
				},
				{
