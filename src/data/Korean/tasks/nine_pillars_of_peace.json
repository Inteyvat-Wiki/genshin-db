			},
			"dialogs": [
				{
					"id": 710050401,
					"content": "팔게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050402
					]
				},
				{
					"id": 710050402,
					"content": "좋아, 시원시원하군! 자, 여기 돈 받아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050403
					],
					"speakerTitle": "박래"
				},
				{
					"id": 710050403,
					"content": "어이쿠, 이 반지는 엄청난 보물이군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050404
					],
					"speakerTitle": "박래"
				},
				{
					"id": 710050404,
					"content": "그 유적에 분명 다른 보물도 있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "박래"
				}
			]
		},
		{
			"id": 7100505,
			"completionStepIds": [
				7100535
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7100532",
							"2"
						],
						"stepId": 7100532,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"박래"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050501,
					"content": "생각 좀 해볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050502
					]
				},
				{
					"id": 710050502,
					"content": "그래…. 알았어, 잘 생각해봐. 가격으로 따지면 내가 최고가가 아닐 수도 있지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050503
					],
					"speakerTitle": "박래"
				},
				{
					"id": 710050503,
					"content": "장사의 시각으로 따져보면, 이 반지를 나한테 팔아서 손해 보진 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050504
					],
					"speakerTitle": "박래"
				},
				{
					"id": 710050504,
					"content": "이 귀한 반지로 어떻게 거래를 딱 한 번만 하겠어. 나한테 팔면 나중에 좋은 장삿거리를 너한테 제일 먼저 알려줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050505
					],
					"speakerTitle": "박래"
				},
				{
					"id": 710050505,
					"content": "그리고 다른 물건도 당연히 몇 개 서비스로 주고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050506
					],
					"speakerTitle": "박래"
				},
				{
					"id": 710050506,
					"content": "잘 생각해봐, 알았지? 반지를 나한테 판다면 언제든 환영이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "박래"
				}
			]
		},
