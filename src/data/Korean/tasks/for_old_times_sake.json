						221150605
					],
					"speakerTitle": "약심"
				},
				{
					"id": 221150605,
					"content": "됐어, 너희도 너무 걱정 안 해도 돼. 이건 상 씨 본인 일이니까",
					"roleType": "TALK_ROLE_NPC",
