			"dialogs": [
				{
					"id": 221150301,
					"content": "그냥 바로 가버렸네…. 우리도 돌아가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 221150302,
					"content": "엥? 땅에 뭔가가 있어…. 상구야 어르신이 떨어뜨린 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 221150303,
					"content": "음… 일단 주워보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 2211505,
			"completionStepIds": [
				2211507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
