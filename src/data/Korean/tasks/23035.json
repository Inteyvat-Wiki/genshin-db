				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350101,
					"content": "아, 이나즈마로 돌아가고 싶다…. 왜 나한테 이런 일이 생긴 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350102,
						230350103
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350102,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				},
				{
					"id": 230350104,
					"content": "여행자구나? 에휴, 소설 이야긴 꺼내지도 마. 내가 볼 땐 「일곱 성인의 소환」의 제작자들이 더는 못 버틸 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350105
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350105,
					"content": "나랑 친분 있는 학자가 그러는데, 「일곱 성인의 소환」을 제작하면서 이런저런 뜬금없는 문제를 겪었대…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350106
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350106,
					"content": "예를 들면, 하라바타트 학부의 학자가 어느 날 갑자기 이런 문제를 제기했다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350107
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350107,
					"content": "카드 효과 설명이 너무 길면 3줄 이상 안 읽는 사람들이 「일곱 성인의 소환」을 꺼릴 수도 있대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350108
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350108,
					"content": "학자들이야 장문에 익숙하니까 별생각 없겠지만, 긴 글을 읽기 싫어하는 사람들은 긴 설명 때문에 「일곱 성인의 소환」을 안 할 수도 있다는 소리잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350109
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350109,
					"content": "그래서 그 학자가 가독성을 위해 일부 카드의 설명을 절반으로 줄이는 게 어떻겠냐는 제안을 했다고 하더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350110,
						230350111
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350110,
					"content": "그, 그렇게까지 할 필요가 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350112,
					"content": "나도 별문제가 아니라고 생각하지만… 학자들은 그 문제를 진지하게 생각하고 있어. 사용자 경험과 관련된 거라 학자들은 그와 관련해서 어떠한 문제도 없길 바라고 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350113
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350113,
					"content": "휴우, 이건 문제도 아냐…. 지금 더 큰 문제는 모델 섭외에 차질이 생겼다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350114
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350114,
					"content": "전에 얘기한 적 있지? 학자들이 타이나리 씨와 사이노 씨를 모델로 섭외해주겠다고 약속한 것 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350115
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350115,
					"content": "근데 지금 학자들이 너무 바빠서, 한동안은 가망이 없을 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350116,
						230350117
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350116,
					"content": "그럼 어떡하죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350118,
					"content": "예전에 만났던 학자는 바빠서 도와주지 못한다고 하기는 했는데, 대신 한가지 방법을 알려줬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350119
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350119,
					"content": "사이노 씨는 가끔 푸스파 커피숍에서 카드 게임을 한대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350120
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350120,
					"content": "그러니까 학자들에게 여유가 생길 때까지 기다리기 싫으면, 커피숍에 가서 사이노를 찾아보라고 하더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350121
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350121,
					"content": "그럼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350122
					]
				},
				{
					"id": 230350122,
					"content": "어휴, 학자들이 한가해질 때쯤이면 아마 내 소설은 완성되어있을걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350123
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350123,
					"content": "그래서 그냥 내가 직접 사이노 씨를 찾아보려고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350124
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350124,
					"content": "근데 운 좋게 커피숍에서 사이노 씨를 만난다고 해도 어떻게 말을 걸지? 아이고, 머리야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350128,
						230350129
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350128,
					"content": "제가 도와드릴 수 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350130,
					"content": "정말이야?! 다행이다! 근데 어쩌다가 알게 된… 아니, 됐다. 거기까진 안 물어볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350131
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350131,
					"content": "그럼 시간이 없으니까 어서 푸스파 커피숍으로 가자. 사이노 씨를 만날 수 있다면 좋겠는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350129,
					"content": "저 사이노랑 친해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350117,
					"content": "그럼 어떻게 연락해야 하죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350111,
					"content": "그렇게 길진 않을 텐데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350103,
					"content": "소설이 잘 안 풀리세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				}
			]
		},
		{
			"id": 2303503,
			"completionStepIds": [
				2303503
