			},
			"dialogs": [
				{
					"id": 230350401,
					"content": "…음, 이런 덱도 나쁘지 않을 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350402
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 230350402,
					"content": "근데 이 덱은 속공 능력이 너무 약한 게 아닐까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350403
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 230350403,
					"content": "사이노, 뭐 하고 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350404
					]
				},
				{
					"id": 230350404,
					"content": "#{NICKNAME}? 이런 곳에서 만날 줄은 몰랐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350405
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 230350405,
					"content": "난 지금 「일곱 성인의 소환」에서 템포가 느린 덱을 짜는 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350406
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 230350406,
					"content": "풍부한 자원과 강력한 카드로 구성된 덱이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350407
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 230350407,
					"content": "그런데 솔직히 말처럼 쉽지가 않네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350408
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 230350408,
					"content": "요즘 「일곱 성인의 소환」플레이어들 사이에서는 속공 덱이 주목받고 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350409
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 230350409,
					"content": "속공 덱이란 초반부터 대량의 카드를 내보내서 속전속결을 노리는 덱이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350410
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 230350410,
					"content": "하지만 난 이런 전술을 선호하지 않아. 난 다양한 방식으로 자원을 축적하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350411
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 230350411,
					"content": "시시각각 기회를 포착해 계속해서 우세를 굳혀 나가면서 안정적으로 승리하는 걸 선호하거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350412
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 230350412,
					"content": "맞아요! 바로 그거예요! 딱 제 소설 속의 주인공이랑 판박이네요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350413
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350413,
					"content": "앗, 죄송합니다! 어… 저는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350414,
						230350415
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350414,
					"content": "이쪽은 후쿠모토 씨야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350415,
					"content": "이분은 소설 《소환왕》의 작가님이셔",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350416,
					"content": "안녕하세요, 대풍기관님. 그… 저에 대해 들어보신 적은 없겠지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350417
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350417,
					"content": "소설은 읽어봤어. 잘 썼더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350418
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 230350418,
					"content": "정말 영광입니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350419
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350419,
					"content": "그 소설에서 가장 인상 깊었던 부분은 주인공이 열세에 처하게 될 때마다 늘 다양한 방법으로 카드 덱에 존재하지 않는 카드를 뽑아서 승리하는 거였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350420
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 230350420,
					"content": "스토리 전개상 필요한 부분이라는 건 알고 있지만, 그런 승리 방식은 「일곱 성인의 소환」이라는 게임의 본질에 어긋나지 않나 싶기도 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350421
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 230350421,
					"content": "아, 그게… 실은 저도 「일곱 성인의 소환」을 종종 하고 있긴 하지만, 실력이 별로거든요…. 게다가 실제 경기 방식을 토대로만 쓰면 재미가 반감될 테니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350422
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350422,
					"content": "음, 그래? 마침 잘됐네. 방금 덱을 두 개 짜봤는데, 여기서 「일곱 성인의 소환」을 잠깐 해보는 건 어때? 새로운 아이디어가 떠오를지도 모르니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350423,
						230350424
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 230350423,
					"content": "(기승전 카드 게임이네…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350424,
					"content": "(사이노는 그냥 카드 게임이 하고 싶었던 게 아닐까…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350425,
					"content": "네? 사, 사이노 씨와 카드 게임을요? 물론 영광입니다만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350426,
						230350427
					],
					"speakerTitle": "후쿠모토"
				},
				{
					"id": 230350426,
					"content": "제가 설명할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350427,
					"content": "후쿠모토의 부탁에 관해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350428,
					"content": "여행자는 후쿠모토의 부탁을 설명했다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230350429,
					"content": "《소환왕》 일러스트의 모델? 당연히 괜찮지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350430
					],
					"speakerTitle": "사이노"
				},
				{
					"id": 230350430,
					"content": "정말 감사합니다! 여행자! 빨리, 빨리 사진 몇 장 찍어 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "후쿠모토"
				}
			]
		},
