					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552601,
					"content": "미안… 아직 감정이 잘 조절되지 않네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552602
					],
					"speakerTitle": "제트"
				},
				{
					"id": 730552602,
					"content": "사과할 필요 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552603
					]
				},
				{
					"id": 730552603,
					"content": "그래… 제트가 매우 힘들다는 거, 우리도 다 알아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730552604,
					"content": "고마워… 앞으로 순조로운 여행이 되길 바랄게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552605
					],
					"speakerTitle": "제트"
				},
				{
					"id": 730552605,
					"content": "음… 제트의 모든 게 순조롭길 바라… 분명 그럴 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
