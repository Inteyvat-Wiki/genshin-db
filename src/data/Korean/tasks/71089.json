					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890101,
					"content": "윽… 정말 긴 편지야, 지경이 남긴 편지인 거 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710890102,
					"content": "맞아, 지경의 편지야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890103
					]
				},
				{
					"id": 710890103,
					"content": "쳇… 아직도 그녀가 어디 있는지 못 찾겠어. 일단 근우에게 말해주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7108902,
			"completionStepIds": [
				7108903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108903",
							"2"
						],
						"stepId": 7108903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"근우"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890201,
					"content": "근우, 이걸 찾았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710890202,
					"content": "자, 자 침착해. 뭘 찾았는데? 지경의 행방과 관련이 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890203
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710890203,
					"content": "그녀가 남긴 편지예요. 층암거연의 더 깊은 곳으로 간 것 같아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890204
					]
				},
				{
					"id": 710890204,
					"content": "…고마워, 뭘 썼는지 한번 확인해 봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890205
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710890205,
					"content": "근우는 지경의 편지를 꼼꼼히 읽는다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710890206
					]
				},
				{
					"id": 710890206,
					"content": "이 녀석… 단 한 번도 이렇게 큰 문제를 생각해 본 적이 없어. 그녀의 선택을 평가하기도 그렇고, 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890207
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710890207,
					"content": "그녀의 발견을 중요시하지 않았고, 그녀에게 충분한 존중과 이해를 주지 못한 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890208
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710890208,
					"content": "그녀의 지도가 없다면 후속 탐사는 완성할 수 없어… 그녀의 건강 상태가 걱정이지만 그녀의 노력으로 열심히 얻은 성취감을 무시했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890209
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710890209,
					"content": "그녀는 우리 광부들과는 처음부터 달랐어. 왜 이 생각을 못 했을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890210
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710890210,
					"content": "그녀는 그냥 잊혀지고 싶지 않은 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890211
					]
				},
				{
					"id": 710890211,
					"content": "우리 같이 신에게 한 번도 선택을 받지 못한 일반인들은 모두 다 그러지 않을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890212
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710890212,
					"content": "모두 다 그렇겠지만… 누가 또 그녀처럼 그렇게 집착을 할 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890213
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710890213,
					"content": "하지만 어느 순간에 자신을 위대하게 만들고 싶다는 집착을 포기했다는 걸 생각하면… 자신의 습관이 하루 또 하루 평범해지는 걸 의식한다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890214
					],
					"speakerTitle": "근우"
				},
				{
					"id": 710890214,
					"content": "지경 같은 젊은 사람을 평가하기엔 면목이 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "근우"
				}
			]
		}
	]
}