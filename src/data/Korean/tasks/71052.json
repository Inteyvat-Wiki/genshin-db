					"헤디브"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500601,
					"content": "이상한 돌에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500602
					]
				},
				{
					"id": 710500602,
					"content": "이상한 돌의 사진을 찍었다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500603
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500603,
					"content": "어서 보여줘 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500604
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500604,
					"content": "이거예요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500605
					]
				},
				{
					"id": 710500605,
					"content": "오, 역시 폰타인에서 만든 새로운 기종이야, 사진이 엄청 선명하게 찍혔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500606
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500606,
					"content": "전에 테스트용 모델들을 구입한 적이 있는데, 흐리게 찍히더군. 게다가 두 사람이 힘을 합쳐서 옮겨야 할 정도라, 결국엔 아카데미아에서 먼지만 쌓이게 됐어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500607,
						710500608
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500607,
					"content": "먼지가 쌓이다니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				},
				{
					"id": 710500609,
					"content": "맞아, 그래도 내 한 끼 밥값 정도는 됐는데 말이야. 음… 새 모델들을 들여올 때도 됐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500610
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500610,
					"content": "삼천포로 빠졌군. 어디 보자, 이 돌은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500611
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500611,
					"content": "음, 이건 화석이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500612
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500612,
					"content": "화석이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500613
					]
				},
				{
					"id": 710500613,
					"content": "맞아, 그리고 다양한 해양 생물도 있어… 흥미롭군. 리월에… 「숲과 논밭이 망망대해에 잠겼네」라는 말이 있잖아? 이걸 얘기한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500614
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500614,
					"content": "층암거연에 화석이 있다는 건 이 생물들이 과거 급속도로 지하에 매장됐다는 걸 의미해. 그러니까 골격이 이렇게 완전한 형태를 유지할 수 있었던 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500615
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500615,
					"content": "그러고 보니, 여긴 지진이 자주 일어난다고 하던데… 그럼 말이 되네. 활발한 지질 운동은 화석이 형성되는 필수 조건 중 하나니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500616
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500616,
					"content": "이건 이 일대 고대 생물 군체의 연구에 큰 도움이 될 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500617
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500617,
					"content": "하지만 한 장만으로는 부족해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500619
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500619,
					"content": "이렇게 하자. 비슷한 화석이 더 있으면 사진으로 찍어서 나한테 보여줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500620
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500620,
					"content": "얼마나 필요한데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500621
					]
				},
				{
					"id": 710500621,
					"content": "어디 보자, 보고서에 첨부할 사진은 4, 5장이면 충분할 테니… 5장 정도면 되겠어. 비슷한 화석 사진을 5장만 더 찍어줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500622
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500622,
					"content": "적당한 가격으로 구매하겠어. 이건 엄청난 발견이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500608,
					"content": "낭비네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				}
			]
		},
