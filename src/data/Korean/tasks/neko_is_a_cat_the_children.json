				"points": []
			},
			"dialogs": [
				{
					"id": 722100101,
					"content": "냐앙, 야옹, 어디 갔지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100102
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100102,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100103
					]
				},
				{
					"id": 722100103,
					"content": "자네들이군. 꼬마 녀석들이 어디 갔는지 안 보여서 걱정이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100104
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100104,
					"content": "밖이 위험하다고 몇 번이나 가르쳐줬는데. 밖에는 몽둥이 들고 있는 털북숭이에… 둥근 물과 불이 있어서 얼마나 위험한데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100105
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100105,
					"content": "찌릿찌릿한데 가면 털이 곤두설 거라고. 그 녀석들에게 그 느낌만은 느끼게 하고 싶지 않은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100106
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100106,
					"content": "하지만 말을 안 듣는 녀석들이 꼭 있어서 매번 찾는 데 어려움을 겪고 있네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100107
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100107,
					"content": "오늘도 몇 마리가 집을 나가버려서, 정말 걱정이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100108
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100108,
					"content": "나 대신 「콘부마루」와 「팔보」를 좀 찾아주게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100109
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100109,
					"content": "「콘부마루」는…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100110
					]
				},
				{
					"id": 722100110,
					"content": "착한 아이지. 이번 세대의 콘부마루는 엄청 똑똑해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100111
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100111,
					"content": "「이번 세대」?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100112
					]
				},
				{
					"id": 722100112,
					"content": "히비키가 가끔 하는 말이야. 나도 정확히는 잘 몰라, 말할 때 표정을 봐서는 좋은 말 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100113
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100113,
					"content": "좋은 물건의 이름을 따서 녀석들 이름을 지어주고 있어, 녀석들이 다 자라고 떠나면 더 작은 녀석들에게 이름을 물려주고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100114
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100114,
					"content": "「콘부마루」는 높은 곳에서 잠자는 걸 좋아해. 엄청 엄청 높은 곳에 가서 찾아보게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100115
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100115,
					"content": "그럼, 「팔보」는…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100116
					]
				},
				{
					"id": 722100116,
					"content": "영리한 녀석이지, 물고기를 좋아해서 가끔 해안가에서 파도에 휩쓸려온 물고기를 찾으러 다녀",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100117
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100117,
					"content": "하지만 물은 무서운 물건이야. 오래전에 「와타」라는 녀석이 물에 빠져서 영원히 못 돌아올 뻔했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100118
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100118,
					"content": "「팔보」는 바다에 있을 거야, 작은 물고기나 꽃게가 있는 곳이랑 소금물이 있는 곳을 찾아보게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100119
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100119,
					"content": "너무 광범위한데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100120
					]
				},
				{
					"id": 722100120,
					"content": "어쨌든 아주아주 높은 곳과 소금물이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100121
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100121,
					"content": "아, 아무튼 네코에게 지도를 보여주자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722100122,
					"content": "아주 멍청하군. 여기 보게, 이곳이 아주아주 높은 곳이고, 이곳이 소금물이지 않나. 분명 이 두 곳에 있을 걸세",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100123,
						722100125
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100123,
					"content": "우리에게 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100124
					]
				},
				{
					"id": 722100124,
					"content": "그럼 부탁하지, 야옹, 이 녀석들이 정말…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100125,
					"content": "난 고양이는 잘 못 잡아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100126
					]
				},
				{
					"id": 722100126,
					"content": "야옹, 괜찮아, 그 녀석들은 사람을 무서워하지 않아… 어떻게 보면 그 녀석들을 돌봐주는 사람이 없어서 여기저기 뛰어다니는 걸 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100127
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722100127,
					"content": "그럼 부탁하지, 야옹, 이 녀석들이 정말…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「네코」"
				}
			]
