						721540313
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540313,
					"content": "예를 들면 나루카미 다이샤의 전통이나, 이나즈마에 전해지는 너구리와 여우의 전설도 좋고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540314
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540314,
					"content": "이나즈마에는 섬이 많아서 만들 수 있는 스토리가 너무 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540315
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540315,
					"content": "어찌 됐든 먼저 이 《제7의 무사》부터 먼저 완성해야겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540316
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540316,
					"content": "만약 어르신이 만족하면 다음에 이나즈마에서 「활동 사진」 제작할 때 좀 더 편해지지 않을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
