	"talks": [
		{
			"id": 7215401,
			"completionStepIds": [
				7215401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215401",
							"2"
						],
						"stepId": 7215401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"자비에"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540101,
					"content": "잠깐! 아까 대사를 읽을 때 그 느낌이 아니었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540102
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540102,
					"content": "「무사, 무사는 마치 대지에 휘몰아치는 청량한 바람 같다.」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540103
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540103,
					"content": "예전에 얘기한 거 기억하지? 소탈하면서도 산전수전을 다 겪은 느낌. 소탈함, 소탈함! 알겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540104
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540104,
					"content": "이 대사가 가장 중요한 포인트라고, 완벽하게 느낌을 표현해내야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540105
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540105,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540106
					],
					"speakerTitle": "토라노스케"
				},
				{
					"id": 721540106,
					"content": "그리고 검을 휘두를 때 그렇게 빨리 휘두르면 안 되고 항상 카메라에 잡혀야 해. 그렇지 않으면 「영사기」로 찍을 수 없게 되니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540107
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540107,
					"content": "먼저 자세를 취하고 잠시 멈추라고, 알겠지? 잠시 멈춰, 그리고 베어버리는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540108
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540108,
					"content": "근데 대결할 때 그렇게 검을 휘두를 순 없는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540109
					],
					"speakerTitle": "토라노스케"
				},
				{
					"id": 721540109,
					"content": "스토리와 제작을 위해서잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540110
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540110,
					"content": "다시 준비해서, 한 번만 더 해보자고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540111,
						721540112
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540111,
					"content": "뭐 하고 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540114
					]
				},
				{
					"id": 721540114,
					"content": "#아! 너구나! 내 친애하는 {F#소녀여}{M#소년이여}, 바람이 널 보낸 게 틀림없다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540115
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540115,
					"content": "보다시피, 나와 이 병사님은 「검진 활동 사진」을 찍고 있어. 제목은 《제7의 무사》야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540116
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540116,
					"content": "아, 「검진 활동 사진」은 내가 이런 종류의 「활동 사진」에 붙여준 이름이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540117
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540117,
					"content": "검을 들고 싸우는 화면을 기록해서, 보는 사람으로 하여금 마치 검진을 누비는 듯한 느낌을 받게 하는 「활동 사진」… 대충 그런 의미야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540118,
						721540121
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540118,
					"content": "토라노스케 씨가 시간이 있으시다니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540119
					]
				},
				{
					"id": 721540119,
					"content": "높은 분들의 허가를 받았다고. 막부 무사의 위용을 널리 전파하는 데 도움이 된다고도 하셨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540120
					],
					"speakerTitle": "토라노스케"
				},
				{
					"id": 721540120,
					"content": "자비에가 어떻게 어르신을 설득했는지는 모르겠지만 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "토라노스케"
				},
				{
					"id": 721540123,
					"content": "하지만 솔직히, 겐지로 님은 정말로… 정말로 진지하면서도 배려심이 깊은 어르신이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540124
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540124,
					"content": "간절한 마음을 품고 어르신과 대화를 나눈 후, 겐지로 님은 내 부탁을 흔쾌히 수락하셨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540125
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540125,
					"content": "하지만… 그 대신, 먼저 막부와 관련된 「활동 사진」을 제작해야 해. 무사가 주인공이면 더 좋고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540126
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540126,
					"content": "난 예전부터 이런 쪽에 관심이 많았거든, 당연히 그러겠다고 대답했어. 겐지로 님도 무척 기뻐하셨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540127
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540127,
					"content": "겐지로 님은 직접 병사님을 파견해 나와 동행하도록 하셨어. 그뿐만 아니라 실력 좋은 무사 몇 분을 지원해 주시기도 하셨지. 그리고 겐지로 님은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540128
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540128,
					"content": "「검으로 대결하는 장면은 무사와 막부의 위엄이 드러나야 한다」고 말씀하셨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540129
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540129,
					"content": "겐지로 님은 정말 몇 수 앞을 내다보시는 분인 거 같아, 「활동 사진」을 이용해 홍보할 생각을 하시다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540130
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540130,
					"content": "하지만 나는 「활동 사진」을 제작하는 데 도움이 되는 일이라면 뭐든 마다하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540131,
						721540135
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540131,
					"content": "제작은 순조롭게 되고 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540132
					]
				},
				{
					"id": 721540132,
					"content": "솔직히… 그다지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540133
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540133,
					"content": "병사님들의 실력은 정말 흠잡을 데 없지만, 이런 「연기 무예」식의 전투에는 익숙하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540134
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540134,
					"content": "검을 너무 빨리 휘둘러서 「영사기」가 기록을 못하는가 하면, 또 가끔 카메라 밖으로 나가기까지 해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540140,
					"content": "여행자. 너만 괜찮다면 내가 쓴 대본으로 병사들에게 시범을 보여주지 않겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540141
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540141,
					"content": "네 이해력과 실력이라면, 카메라 앞에서 연기할 때도 능수능란하게 할 수 있을 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540142
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540142,
					"content": "다른 사람의 연기를 관찰하게 되면, 병사님들도 스토리를 이해하게 되겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540143
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540143,
					"content": "자자자, 대본 좀 봐봐. 이 부분은 주로 전투 장면이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540144,
						721540145,
						721540146,
						721540156
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540144,
					"content": "「이번 싸움은, 패배한 것과 다름없다」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540147,
					"content": "아, 이건 다른 장면의 대사야… 이번 장면은 전투씬이 대부분이라 대사가 별로 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540148
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540148,
					"content": "대사 좀 볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540149
					]
				},
				{
					"id": 721540149,
					"content": "아 참, 네 배역은 「쥬사브로」라고 하는 캐릭터야. 동료들과 함께 한 마을의 주민들에게 고용 당해 마을을 지키고 있지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540150
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540150,
					"content": "음, 이 장면에는 「큐조」라고 하는 동료도 대사가 있는데… 이 대사는 내가 할게, 일단 한번 가보자구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540151
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540151,
					"content": "꼭 캐릭터에 몰입해야 해, 캐릭터를 이해해야 한다고! 네가 「쥬사브로」라고 생각하는 거야, 알겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540152,
						721540153
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540152,
					"content": "알, 알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540154,
					"content": "좋아, 정말 훌륭해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540155
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540155,
					"content": "준비가 되면 말해줘, 「영사기」의 위치도 조정해야 하니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540153,
					"content": "난 쥬사브로다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540145,
					"content": "「몰락했어도 무사는 무사다」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540146,
					"content": "「당신들은 합격한 허수아비들이야…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540156,
					"content": "「하지만 적은 참새가 아니지」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540135,
					"content": "저도 배역을 하나 맡을 수 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540136
					]
				},
				{
					"id": 721540136,
					"content": "#그럼 물론이지! 넌 내 마음속에서 영원히 우선순위에 있어, {F#소녀}{M#소년}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540137
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540137,
					"content": "난 지금까지도 그 《타타라 모노가타리》를 기억하고 있는 걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540138
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540138,
					"content": "병사님들의 실력은 정말 흠잡을 데 없지만, 이런 「연기 무예」식의 전투에는 익숙하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540139
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540139,
					"content": "검을 너무 빨리 휘둘러서 「영사기」가 기록을 못하는가 하면, 또 가끔 카메라 밖으로 나가기까지 해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540121,
					"content": "어떻게 설득하셨어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540122
					]
				},
				{
					"id": 721540122,
					"content": "병사님은 예전부터 날 이해하고 있었거든. 더 중요한 건, 미코시 겐지로 님을 설득해서 이나즈마에서 「활동 사진」을 제작할 수 있도록 허락을 받는 거였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "자비에"
				},
				{
					"id": 721540112,
					"content": "「무사, 마치 대지에 휘몰아치는 청량한 바람」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540113
					]
				},
				{
					"id": 721540113,
					"content": "감정이 너무 격양됐어, 그게 아니라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540114
					],
					"speakerTitle": "자비에"
				}
			]
