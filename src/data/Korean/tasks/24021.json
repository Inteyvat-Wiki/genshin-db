				]
			},
			"dialogs": [
				{
					"id": 240210101,
					"content": "아이고… 이 상자는 왜 이렇게 무거운 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210102
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240210102,
					"content": "괜찮아요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210103
					]
				},
				{
					"id": 240210103,
					"content": "명예 선임 연구원, 또 만났네. 미안… 내가… 허리를 다친 것 같아. 엄청 아프네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210104
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240210104,
					"content": "전에 상자를 옮겨와서 그 안에 든 자료를 정리하려고 했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210105
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240210105,
					"content": "나… 난 그 상자가 그렇게 무거울 줄은 몰랐어. 들어 올리다가 제대로 못 일어나서 허리가 그 무게를 다 받았나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210106
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240210106,
					"content": "지금은… 허리가 끊어질 것 같은 느낌이야. 아이고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210107,
						240210108
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240210107,
					"content": "제가 업어서 의사한테 데려다줄까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				},
				{
					"id": 240210109,
					"content": "아, 아냐… 전에도 허리를 다쳐 봐서 아는데 조금 쉬면 괜찮아질 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210110
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240210110,
					"content": "도대체 문서가 얼마나 많이 들어있길래 그렇게 무거운 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 240210111,
					"content": "아마… 아주 많은 공문이 들어있을 거야. 한때 과학원에서 「흔적을 남기는 업무 방식」을 추진했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210112
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240210112,
					"content": "간단히 말하자면 과학원에 있는 모든 연구 업무는 종이로 된 증명 서류를 남겨야 했었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210113
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240210113,
					"content": "이런 업무 방식이 추진된 이후로 과학원의 종이 소모량이 다섯 배나 늘었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210114
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240210114,
					"content": "문서가 너무 많다 보니까 사무실마다 서류를 분류하는 「문서 정리」 포지션까지 생겼었고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210115
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240210115,
					"content": "그러니까 모든 일을 종이에 기록해야 했다는 거지? 듣기만 해도 귀찮았을 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 240210116,
					"content": "응, 나중엔 점점 어영부영되더니 제한적으로 실행되고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210117
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240210117,
					"content": "이 얘긴 그만하고… 명예 선임 연구원, 나 대신 공문 상자를 가져다줄 수 있을까? 허리는 아프지만 공문을 빨리 정리해야 하거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210118,
						240210119
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240210118,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240210119,
					"content": "푹 쉬고 계세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210120
					]
				},
				{
					"id": 240210120,
					"content": "괜찮아, 공문 정리는 손만 있으면 충분해. 허리 쓸 일은 없으니까 걱정 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240210108,
					"content": "제가 사람을 불러올게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				}
			]
		},
