			"dialogs": [
				{
					"id": 50130801,
					"content": "메아리 아이 쪽 마물은 전부 소탕했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130802
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 50130802,
					"content": "심연 종양석은 내가 파괴했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130803
					],
					"speakerTitle": "카치나"
				},
				{
					"id": 50130803,
					"content": "샘물 무리 쪽도 한 방에 해결 완료야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130804
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 50130804,
					"content": "연기 주인도 이제 안전해. 꽃깃회를 도우러 갈까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130805
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 50130805,
					"content": "그쪽 상황이 심각해 보여서, 이미 가는 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130806
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 50130806,
					"content": "그럴 필요 없어, 다 처리했으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130807
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 50130807,
					"content": "벌써?! 너 방금까지만 해도 경기장에 있었잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130808
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 50130808,
					"content": "흠씬 패줄 대상이 필요했거든. 내가 지금까지 얼마나 참았는지 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130809
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 50130809,
					"content": "그, 그렇구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130810
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 50130810,
					"content": "얀사, 비옥한 터전은 어떡하지? 경기장에서 멀리 떨어져 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130811
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 50130811,
					"content": "아, 걱정 마. 방금 바레사랑 연락했는데, 그쪽도 해결됐대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130812
					],
					"speakerTitle": "얀사"
				},
				{
					"id": 50130812,
					"content": "슬슬 다 끝난 것 같네. 심연도 많이 약해졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130813
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 50130813,
					"content": "응! 숫자로 밀어붙일 줄밖에 모르는 놈들, 이제 우리 쪽엔 환혼시가 있다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130814
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 50130814,
					"content": "잠깐만, 심연이 마물들을 집결시켜 경기장으로 돌격하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130815
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 50130815,
					"content": "환혼시가 관건이라는 걸 깨닫고, 성화를 파괴하려는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130816
					],
					"speakerTitle": "키니치"
				},
				{
					"id": 50130816,
					"content": "그렇게 둘 순 없지. 친구들, 경기장으로 집합!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130817
					],
					"speakerTitle": "말라니"
				},
				{
					"id": 50130817,
					"content": "심연 종양석이 새로 떨어졌어. 전부 경기장 주변이니까 나눠서 파괴하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130818
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 50130818,
					"content": "참, 문을 지킬 사람도 필요한데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50130819
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 50130819,
					"content": "저한테 맡기세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50130820
					]
				},
				{
					"id": 50130820,
					"content": "좋았어, 이번이 진짜 마지막 전투야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "말라니"
				}
			]
		}
	]
