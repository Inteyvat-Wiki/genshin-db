			"dialogs": [
				{
					"id": 708270101,
					"content": "…멍멍?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708270102
					],
					"speakerTitle": "물고기"
				},
				{
					"id": 708270102,
					"content": "#어라? {NICKNAME}, 여기 봐. 이 강아지, 엄청 배고파 보이지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708270103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 708270103,
					"content": "음, 떠돌이 개 같지는 않는데… 주인을 잃어버린 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708270104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 708270104,
					"content": "끼잉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708270105
					],
					"speakerTitle": "물고기"
				},
				{
					"id": 708270105,
					"content": "#그냥 두고 가기엔 마음이 쓰인다구. 배고픈 건 정말 견디기 힘들잖아… {NICKNAME}, 혹시 남는 고기가 있으면 조금 나눠주는 거 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
