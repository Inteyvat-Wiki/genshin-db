				]
			},
			"dialogs": [
				{
					"id": 746750101,
					"content": "좋은 하루예요. 그렇지 않나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750102
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750102,
					"content": "여러분만큼 유명해지면, 명함을 건네주려는 사람이 끊이질 않겠죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750103
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750103,
					"content": "#음… 우릴 알아? {NICKNAME}, 이 꼬마 엄청 노련해 보여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746750104,
					"content": "상대방이 어리다는 이유만으로 얕잡아보는 건 무지한 사람이 범하는 고질적인 잘못이죠. 두 분은 최소한 그 정도 수준은 아닐 거라고 생각해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750105
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750105,
					"content": "자화자찬하겠다는 건 아니지만, 저와 형은 현지에서 조금 유명한 영화 감독이에요. 다들 저를 꼬마 뤼미에르 씨라고 부르죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750106,
						746750107
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750106,
					"content": "안녕",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750108
					]
				},
				{
					"id": 746750108,
					"content": "맞아요. 저는 당신들의 모험 이야기에 관심이 많아요. 이 업계에서 비범한 이야기는 영원토록 사랑받거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750109
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750109,
					"content": "여러분은 절 모르시니까, 자기소개를 한번 할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750110
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750110,
					"content": "저랑 형은 함께 영화를 찍기 시작한 지 꽤 오래됐어요. 유명해진 것도 몇 편 있죠. 혹시 《공장을 나서는 노동자들》을 본 적 있으신가요…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750111
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750111,
					"content": "아니",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750112
					]
				},
				{
					"id": 746750112,
					"content": "아, 괜찮아요. 그럼 《열차의 도착》은요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750113
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750113,
					"content": "그것도 본 적 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746750114,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750115
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750115,
					"content": "아, 그렇군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750116
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750116,
					"content": "…이상한 일은 아니죠. 저희 형제는 아직 영화인으로서 가야 할 길이 머니까요. 앞으로는 더 많은 사람이 알 수 있는 유명한 영화를 찍을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750117
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750117,
					"content": "영화는 이야기를 구상하고, 배우가 연기하고, 카메라맨과 감독이 함께 촬영하고, 이것들을 하나로 묶는 것까지 상당히 흥미로운 제작 과정을 거쳐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750118
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750118,
					"content": "저는 그중에서도 기술적인 면모가 가장 드러나는 곳이 촬영 과정이라고 생각해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750119
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750119,
					"content": "어떤 장면을 촬영하는지에 따라서 관객이 어떤 정보를 얻고, 어떤 분위기를 느낄지가 결정되거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750120
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750120,
					"content": "내레이션도 중요하긴 하지만, 내레이션에만 의지해서 이야기가 만들어질 거라고 기대해선 안 돼요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750121
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750121,
					"content": "네 컷! 저는 이야기의 가장 작은 서술 단위를 만들어 내기 위해서는 네 컷이면 충분하다고 생각해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750122
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750122,
					"content": "천재라면 이 네 컷 안에서 기적을 일으킬 수 있죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750123
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750123,
					"content": "두 분이 한번 해보시겠어요? 이 기회를 통해 영화의 매력을 느껴보세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750124
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750124,
					"content": "우리가 어떻게 해야 하는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 746750125,
					"content": "간단해요. 제가 여러분께 이미 만들어진 단편 이야기를 촬영 테마로 제공해 드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750126
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750126,
					"content": "중요한 건 카메라와 내레이션을 다양하게 활용해서 몇 편의 단편 영화를 만들어 보는 거죠. 두 분, 관심 있으신가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746750127
					],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750127,
					"content": "재밌어 보이네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750128
					]
				},
				{
					"id": 746750128,
					"content": "좋아요! 두 분의 준비만 끝나면 언제든지 제가 선택해 둔 촬영 장소에 가서 촬영해 보실 수 있어요. 저도 여러분이 촬영한 결과물에 대해서 피드백해 드릴 거고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "꼬마 뤼미에르"
				},
				{
					"id": 746750107,
					"content": "그럼 너도 우리한테 명함을 줄 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746750108
					]
				}
			]
		}
	]
}