				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"모나",
					"신염",
					"피슬",
					"카에데하라 카즈하",
					"오즈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761301,
					"content": "이곳에 돌아온 걸 보니 환각 비경에서 완전히 벗어난 것 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400761302,
					"content": "이상하다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761303
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400761303,
					"content": "내 환각 비경은 그 우인단과 장치에 대한 단서가 없었는데… 설마 이 일들이 그들과 전혀 관계가 없는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761304
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400761304,
					"content": "아니면 우리랑 관련 있는 이 환각 비경들이 처음부터 「과정」이 아니라 「결과」였던 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761305
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400761305,
					"content": "뭐? 그게 무슨 뜻이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400761306,
					"content": "그러니까 그 환각 비경은 수수께끼를 푸는 단서가 아니라 단순한 결과물인 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761307
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400761307,
					"content": "누군가의 행동으로 인해 이 환각 비경들이 탄생했어. 자발적으로 생겨난 산물이 아니니 우리에게 단서를 줄 수 없는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761308
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400761308,
					"content": "오히려 환각 비경은 우리랑만 연관되어 있다고 하는 게 이해하기 쉬울 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761309
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400761309,
					"content": "단순한 자아의 결정체인가… 음",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761310
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 400761310,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761311
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400761311,
					"content": "이 사건은 가장 처음으로 돌아가야 되는 걸지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761312
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400761312,
					"content": "#섬에 도착한 첫날, 나랑 {NICKNAME}(이)가 우인단 야영지를 조사했어. 거기에 이상한 장치와 제정신이 아닌 우인단이 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761313
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400761313,
					"content": "맞아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761314
					]
				},
				{
					"id": 400761314,
					"content": "우리와 이야기를 나눈 연구원은 이 장치는 우인단의 공업적인 발명일 뿐이라면서, 우리에게 방해되지 않을 거라고 재차 강조했고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761315
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400761315,
					"content": "맞아, 그 모자 쓴 뚱보는 잠이 덜 깬 것처럼 이상한 소리만 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400761316,
					"content": "「정신 이상」 또는 「환각 상태」가 장치에 의한 두 가지 결과일 가능성은 없을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761317
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400761317,
					"content": "이 모든 건 그 고장 난 장치와 관련 있다고 생각해. 하지만 차이점이 되는 건 장치가 아니라 영향을 받은 사람들이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761318
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400761318,
					"content": "……!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761319
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400761319,
					"content": "그러고 보니, 꿈과 환각은 확실히 구분하기 어려워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761320
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400761320,
					"content": "그러니까 네 말은 우리가 그들과 어딘가가 달라서 영향을 받는 결과도 다르다는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761321
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400761321,
					"content": "맞아. 며칠 동안 관찰해 본 결과… 우리와 그 사람들의 차이점은 우리에게 더 견고한 의지가 있다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761322
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400761322,
					"content": "…음, 말이 되는 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761323
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400761323,
					"content": "의지가 강한 사람은 미치지 않고 환각만 일어나는 거고, 무너지기 쉬운 사람은 그렇게 안정적인 환각 비경을 유지할 수가 없는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761324
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400761324,
					"content": "그러니까 지금 우인단 야영지로 돌아가서 그 장치를 파괴해야 한다는 거네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761325
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400761325,
					"content": "아니, 「파괴」하는 것보다 「복구」를 해야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761326
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 400761326,
					"content": "갑자기 정체불명의 장치를 파괴하면 더 심각한 결과를 초래할 수 있으니, 복구할 방법부터 생각하자는 말씀이십니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761327
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 400761327,
					"content": "그래, 조심해서 나쁠 건 없으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761328
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400761328,
					"content": "만약 내 추측이 맞다면, 그 장치는 사람의 뇌에 영향을 주는 것 같으니 조심하는 게 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761329
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400761329,
					"content": "그럼 지금 당장 출발하자! 어서!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 4007615,
			"completionStepIds": [
				4007615
