						150480816
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150480816,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480817
					],
					"speakerTitle": "아샤"
				},
				{
					"id": 150480817,
					"content": "이상하네, 너무 벅차올랐나? 갑자기 눈시울이 뜨겁네, 말도 잘 안 나오고, 하하…",
					"roleType": "TALK_ROLE_NPC",
