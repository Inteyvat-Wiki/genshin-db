					"nextDialogs": [
						150480810
					],
					"speakerTitle": "가운"
				},
				{
					"id": 150480810,
					"content": "아샤, 들었어? 우리가 해냈어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480811
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 150480811,
					"content": "당신의 이름을 잊지 않을게요, 열정적이고 용감한 모험가 베넷 씨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480812
					],
					"speakerTitle": "가운"
				},
				{
					"id": 150480812,
					"content": "모험이 아직 끝나지도 않았는데, 벌써부터 아샤와 헤어지기 아쉬워",
					"roleType": "TALK_ROLE_NPC",
