						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"언쇼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740000601,
					"content": "쉬운 임무일 줄 알았는데, 녀석들이 이렇게나 제멋대로일 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000602,
					"content": "젊은이, 이제 알았겠지. 제멋대로 굴수록 규칙을 더 알려줘야 된다는 걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000603,
						740000605
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000603,
					"content": "꽃을 밟으면 안 된다는 규칙은 알겠는데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000604
					]
				},
				{
					"id": 740000604,
					"content": "#{NICKNAME}, 너도 날 수 있으면 좋았을 텐데. 땅 밟는 거 참 힘들겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000607
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000607,
					"content": "힘드니까 조금만 쉬었다 가게. 타스 스튜를 좀 만들었는데 자네들도 들게나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000608
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000608,
					"content": "맛있는 거다! 아… 그, 근데 이러면 안 되잖아… 괜찮아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000609
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000609,
					"content": "왜 그러지? 내 요리 솜씨를 못 믿는 겐가? 딴 건 몰라도 타스 스튜는 내가 제일 잘하는 요리일세",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000610
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000610,
					"content": "그러니까, 이렇게 하는 건 규칙을 깨는 거 아닌가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000611
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000611,
					"content": "자네들이 힘써줬으니 받는 게 당연하지. 배불리 먹어야 또 힘을 내지 않겠나. 그래, 게다가 자네들은 모험가지 않나… 당연히 더 많이 먹어야 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000612
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000612,
					"content": "그리고 정식 의뢰에 대한 보수는 나중에 챙겨주겠네. 이건 의뢰 규칙을 어기는 게 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000613
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000613,
					"content": "헤헤, 그런 거라면 잘 먹을게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000614
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000614,
					"content": "노인에게 초대를 받아 집 안에서 타스 스튜를 먹는다. 스튜의 온기에 기운이 나고 피로가 날아간다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740000615
					]
				},
				{
					"id": 740000615,
					"content": "일하고 나서 먹는 음식은 참 맛있다니까! 게다가 타스 스튜는 뭐랄까, 정말 집밥 같달까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000616
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000616,
					"content": "식재료와 요리 방법이 평범해서 그럴 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000617
					]
				},
				{
					"id": 740000617,
					"content": "평범하지만 맛있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000618
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000618,
					"content": "당연하지. 우리 집 말괄량이 딸도 이 요리를 참 좋아했는데. 삐져도 이 요리 냄새만 맡으면 고분고분 부엌으로 오곤 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000619
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000619,
					"content": "지금은 너무 멀리 가서 냄새도 못 맡나 보구먼. 집에 돌아오는 길도 까먹었을 게야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000620
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000620,
					"content": "그… 맞다, 우리가 사람 찾아 주는 일도 하거든. 언쇼 할아버지, 딸의 특징을 알려주면 우리가 찾아줄 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000621
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000621,
					"content": "만약에 가던 중에 만나게 된다면요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000622
					]
				},
				{
					"id": 740000622,
					"content": "젊은이, 고맙네. 내 딸을 찾는 건 그리 어려운 일이 아니야. 전에 딸이 사람을 통해 편지도 몇 장 보내왔거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000623
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000623,
					"content": "하지만 자신이 잘못했다고는 생각하지 않는 것 같아. 안 그러면 편지만 보내고 집엔 안 돌아올 리가 없지 않겠나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000624
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000624,
					"content": "그래서 딸의 편지는 아직 한 글자도 읽지 않았네. 뜯지도 않았어. 동물은 말을 안 듣는다 쳐도 다 큰 아가씨가 아직 이런 것도 모를 리가 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000625
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000625,
					"content": "그러고 보니 요즘엔 편지도 안 오는구먼… 아무래도 자기도 좀 멋쩍은가 보지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000626
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000626,
					"content": "어쨌든 난 사람을 고용해서 딸을 찾아 집에 돌아오게 하지는 않을 걸세. 딸이 자기가 돌아와서 잘못을 인정하든가 아니면 다시는 돌아오지 말라지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000627
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000627,
					"content": "아, 알겠어… 그렇다면야 뭐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000628
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000628,
					"content": "어찌 됐든 용사 놈들을 찾아줘서 고맙다네. 보수가 많진 않지만… 여기 타스 스튜도 넣어뒀으니 가지고 가게나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000629
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000629,
					"content": "모험가는 밖에서 자주 노숙하겠지? 항상 많이 먹고 따뜻하게 지내야지, 추운 데서 굶고 다니진 말게나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000630
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000630,
					"content": "알겠어! 언쇼 할아버지도 다리가 빨리 낫길 바랄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000631
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000631,
					"content": "항상 조심하고, 몸 잘 돌보게나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000605,
					"content": "페이몬에게도 규칙을 하나 만들어줘야겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000606
					]
				},
				{
					"id": 740000606,
					"content": "내가 언제 제멋대로 굴었냐구… 그런 적 없거든! 내가 말 안 듣는 애완견도 아니고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000607
					],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7400007,
			"completionStepIds": [
				7400016
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7400004",
							"3"
						],
						"stepId": 7400004,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7400002",
							"2"
