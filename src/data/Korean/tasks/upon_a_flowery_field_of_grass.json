					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"라느와",
					"언쇼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740000701,
					"content": "이거 생각보다… 성가신 임무네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000702
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000702,
					"content": "그거야 꽃밭 안의 거인은 보라색 꽃을 아끼는 데다 지켜야 할 규칙이 많으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000703
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 740000703,
					"content": "말썽꾸러기는 어릴 때부터 규칙 지키는 법을 배워둬야 해. 그렇지 않으면 나중에 더 버릇이 없어질 테니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000704,
						740000706
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000704,
					"content": "페이몬, 들었지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000705
					]
				},
				{
					"id": 740000705,
					"content": "엥? 왜 나한테 그래! 내가 말썽꾸러기 어린애도 아니고, 흥!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000708
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000708,
					"content": "노느라 힘들었지? 마침 오늘도 타스 스튜를 했으니 같이 와서 먹겠나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000709
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000709,
					"content": "#{NICKNAME} {M#오빠}{F#언니}, 페이몬 언니. 같이 먹자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000710
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 740000710,
					"content": "#좋아! 라느와가 이렇게까지 부탁하는데 어쩔 수 없지. 그치, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000711
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000711,
					"content": "감사합니다. 그럼 실례할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000712
					]
				},
				{
					"id": 740000712,
					"content": "실례는 무슨, 다 라느와의 친구 아닌가. 격식 차릴 것 없네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000713
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000713,
					"content": "안으로 들어가 투박하지만 맛있는 타스 스튜를 먹는다.\\n식사 중에 나눈 여행담에 노인은 감탄하고, 소녀는 꺄르르 웃었다.\\n그렇게 담소를 나누며 모두는 즐거운 시간을 보냈다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740000714
					]
				},
				{
					"id": 740000714,
					"content": "어때? 울지 아저씨가 만든 것보다 훨씬 맛있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000715,
						740000716
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 740000715,
					"content": "그러네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000718
					]
				},
				{
					"id": 740000718,
					"content": "#{NICKNAME} {M#오빠}{F#언니}, 페이몬 언니. 그거 알아? 나도 요리를 도왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000719
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 740000719,
					"content": "지금은 조금 돕는 것뿐이지만, 할아버지가 그러는데 많이 연습하면 언젠가 맛있는 타스 스튜를 만들 수 있을 거래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000720
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 740000720,
					"content": "#헤헤, 그날이 오면 {M#오빠랑 언니}{F#언니들}한테도 꼭 만들어줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000721
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 740000721,
					"content": "좋아, 약속한 거다? 정말 기대돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000722
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000722,
					"content": "에고, 정신없이 떠들다 보니 벌써 헤어질 시간이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000723
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000723,
					"content": "힝, 벌써 가려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000724
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 740000724,
					"content": "라느와, 착하지? 둘에게도 할 일이 있단다. 언제까지고 너랑 놀아줄 수만은 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000725
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000725,
					"content": "으으… 알겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000726
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 740000726,
					"content": "너무 슬퍼하지 마. 기회가 된다면 또 만날 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000727
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000727,
					"content": "정말? 그럼 다음엔 캐터 오빠도 같이 만날 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000728
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 740000728,
					"content": "글쎄… 그럴지도 모르지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000729
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000729,
					"content": "신난다! 그럼 다음에 만날 때까지 재밌는 이야기를 잔뜩 준비해뒀다가 들려줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000730
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 740000730,
					"content": "응, 캐터필러도 분명 네 이야기를 기대하고 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000731
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000731,
					"content": "여기까지 온 걸로 모자라 라느와와 놀아주기까지 하다니, 정말 고맙네. 여기 타스 스튜가 더 있으니 챙겨가서 가는 길에 먹게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000732
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000732,
					"content": "모험가는 밖에서 자주 노숙하고 그러지? 항상 잘 챙겨 먹고 다니게나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000733
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 740000733,
					"content": "응! 언쇼 할아버지랑 라느와도 잘 지내야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000716,
					"content": "비슷한 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000717
					]
				},
				{
					"id": 740000717,
					"content": "난 언쇼 할아버지가 만든 타스 스튜가 더 맛있는 것 같아. 뭐랄까, 집밥 같은 느낌이랄까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000718
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740000706,
					"content": "말썽꾸러기는 꽃밭에 가둬야겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740000707
					]
				},
				{
					"id": 740000707,
					"content": "흐흥, 하지만 난 꽃을 밟을 일이 없지! 게다가 마녀의 도움 없이도 담장 너머로 날 수 있다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740000708
					],
					"speakerTitle": "페이몬"
				}
			]
		},
