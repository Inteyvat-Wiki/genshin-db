			"dialogs": [
				{
					"id": 150220301,
					"content": "차스카, 드디어 왔구나. 부족 내 분위기가 점점 더 안 좋아지고 있어. 조사는 좀 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220302
					],
					"speakerTitle": "무토타"
				},
				{
					"id": 150220302,
					"content": "우리가 캐러밴 사람들을 체포한 게 비행 부대를 두둔하고 「열소 날개」 파를 탄압하기 위해서라고 의심하는 사람들까지 있더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220303,
						150220304
					],
					"speakerTitle": "알파"
				},
				{
					"id": 150220303,
					"content": "캐러밴 사람들을 제압했는데도 갈등이 커지고 있다니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				},
				{
					"id": 150220305,
					"content": "단서를 찾긴 했는데, 확실한 증거를 구하려면 해결해야 할 문제가 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220306
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220306,
					"content": "차스카가 테팔의 상황과 하늘 공방에 대한 추측을 설명했다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220307
					]
				},
				{
					"id": 150220307,
					"content": "잿더미성의 「유물」? 이렇게 오랜 시간이 지나도록 오치칸이 남긴 독이 아직도 갈등을 일으키고 있다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220308
					],
					"speakerTitle": "무토타"
				},
				{
					"id": 150220308,
					"content": "하늘 공방… 시험장 상공의 열기구라… 그게 너희들의 다음 목적지야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220309
					],
					"speakerTitle": "알파"
				},
				{
					"id": 150220309,
					"content": "올라갈 방법이 없을까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220310
					]
				},
				{
					"id": 150220310,
					"content": "깃룡을 타든 「열소 날개」를 쓰든, 그렇게 높은 곳까지 나는 건 무리야…. 테팔이 정말 거기에 있긴 할까…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220311
					],
					"speakerTitle": "알파"
				},
				{
					"id": 150220311,
					"content": "음… 방법이라… 아예 없진 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220312
					],
					"speakerTitle": "무토타"
				},
				{
					"id": 150220312,
					"content": "——정말?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150220313,
					"content": "시험장에 있던 분출구 기억나? 전에 지맥 이상과 막힘 현상으로 기체 열소가 부족해졌었잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220314
					],
					"speakerTitle": "무토타"
				},
				{
					"id": 150220314,
					"content": "기체 열소가 충만한 지금, 분출구를 다시 막아버린다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220315
					],
					"speakerTitle": "무토타"
				},
				{
					"id": 150220315,
					"content": "그러니까… 가장 높은 곳의 분출구만 남겨서, 거기에 모든 압력을 집중시키자는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220316
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220316,
					"content": "그럼 기체 열소는 가장 높은 지점에서 모여 강한 풍압을 생성할 테니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220317
					],
					"speakerTitle": "무토타"
				},
				{
					"id": 150220317,
					"content": "——그 바람을 타고 위로 올라가면 되겠네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150220318,
					"content": "맞아. 좀 위험하긴 하지만, 차스카의 실력이라면 문제없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220319
					],
					"speakerTitle": "무토타"
				},
				{
					"id": 150220319,
					"content": "위험한 방법이지만… 확실히 가능성은 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220320
					],
					"speakerTitle": "알파"
				},
				{
					"id": 150220320,
					"content": "분출구를 막는 방법은 시험장에 가서 잉카낙에게 물어보면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220321
					],
					"speakerTitle": "무토타"
				},
				{
					"id": 150220321,
					"content": "차스카… 하늘에 있는 증거를 찾는 일은, 이제 너희에게 달렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "무토타"
				},
				{
					"id": 150220304,
					"content": "여론을 부채질하는 게 캐러밴 사람만이 아닐지도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				}
			]
		},
