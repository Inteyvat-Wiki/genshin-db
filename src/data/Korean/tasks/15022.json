				]
			},
			"dialogs": [
				{
					"id": 150220201,
					"content": "실로닌의 공방 앞에서 잠시 기다린다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220202
					]
				},
				{
					"id": 150220202,
					"content": "오래 기다렸지? 이분이 테팔의 어머니, 푸마 씨야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220203
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 150220203,
					"content": "안녕, 우린…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150220204,
					"content": "인사치레는 됐다. 그 애에 관한 얘기는 별로 하고 싶지 않구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220205
					],
					"speakerTitle": "푸마"
				},
				{
					"id": 150220205,
					"content": "엥…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150220206,
					"content": "우린 이미 연을 끊은 사이야…. 난 그런 아들 둔 적 없다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220207
					],
					"speakerTitle": "푸마"
				},
				{
					"id": 150220207,
					"content": "그 애의 머릿속엔 온통 하늘을 날겠다는 헛된 망상뿐이었어…. 아무리 말려봐도 소용이 없었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220208
					],
					"speakerTitle": "푸마"
				},
				{
					"id": 150220208,
					"content": "흥… 마지막으로 떠나기 전엔 이런 말도 하더구나. 지상 사람들에게 손가락질받지 않도록 하늘 위에 공방을 짓겠다나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220209
					],
					"speakerTitle": "푸마"
				},
				{
					"id": 150220209,
					"content": "이건 그 아이가 두고 간 노트야. 난 더 할 말 없으니, 궁금한 게 있으면 직접 읽어봐라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220210
					],
					"speakerTitle": "푸마"
				},
				{
					"id": 150220210,
					"content": "난 그런 아들 둔 적 없어…. 어차피 그 아이도 날 엄마로 인정한 적 없으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220211
					],
					"speakerTitle": "푸마"
				},
				{
					"id": 150220211,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220212
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220212,
					"content": "어… 사이가 되게 안 좋은가 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150220213,
					"content": "얼마 전에 푸마 씨의 남편… 그러니까 테팔의 아버지가 세상을 떠났는데, 테팔은 장례식에도 나타나지 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220214
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 150220214,
					"content": "그래서 푸마 씨도 테팔을 완전히 내려놓았는지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220215
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 150220215,
					"content": "난 푸마 씨를 위로하러 가볼게. 나중에 또 얘기하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220216
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 150220216,
					"content": "번거롭게 해서 미안",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220217
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220217,
					"content": "그럼 지금 단서는… 이 노트밖에 없는 건가? 뭐라고 적혀 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150220218,
					"content": "음… 「열소 날개」의 초기 구상이랑… 「하늘 공방」에 대한 아이디어가 적혀 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220219
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220219,
					"content": "「잿더미성」 오치카나타… 「열소 날개」 기술의 원형이 거기서 비롯된 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220220
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220220,
					"content": "정말 하늘을 나는 공방을 만들려고 했던 걸까? 그것도 혼자서… 그게 정말 가능해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220221,
						150220222
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150220221,
					"content": "근데 이 도면에 그려진 열기구…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				},
				{
					"id": 150220223,
					"content": "——앗! 시험장에서 본 거잖아? 엄청 높이 떠 있던 그거!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220224
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150220224,
					"content": "그게 나타난 지는 꽤 됐지만, 어떻게 거기까지 올라간 건진 아무도 몰라…. 혹시… 누가 「올려보낸」 게 아니라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220225
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220225,
					"content": "어떤 고장으로 인해 더 높은 구름 위에서… 지금의 높이까지 「내려온」 건 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220226
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220226,
					"content": "설마 그게…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220227
					]
				},
				{
					"id": 150220227,
					"content": "——하늘 공방의 일부?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220228
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150220228,
					"content": "그럴 가능성이 커. 구름 위에 숨겨져 있으니, 이시도르도 테팔의 아지트를 찾아내지 못한 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220229
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220229,
					"content": "진짜 하늘에 숨어 있었다니…. 그럼 거기까진 어떻게 올라가지? 차스카 너… 그렇게 높이 날 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220230
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150220230,
					"content": "#어려워. {NICKNAME}을(를) 데리고 올라가는 건 더더욱",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220231
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220231,
					"content": "「열소 날개」를 사용해도 그렇게까지 높이 날진 못할 거야…. 이 노트에 적힌 「유물」이라도 있다면 모를까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220232
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220232,
					"content": "「유물」은 테팔이 갖고 있을 테니… 그쪽으론 가망이 없네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220233
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150220233,
					"content": "페이몬은 저 높이까진 못 날아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220234
					]
				},
				{
					"id": 150220234,
					"content": "못 날아! 아무리 생각해도 무리라구! 게다가 나 혼자 올라가서 테팔을 상대하라고 할 셈이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220235
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150220235,
					"content": "걱정 마, 우리가 해결책을 떠올리지 못한다 해서 남들도 그러리란 보장은 없어. 꽃깃회의 「비행 고수」는 나뿐만이 아니거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220236
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220236,
					"content": "음… 그래! 알파 장로랑도 상의해 보면 되겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220237
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150220237,
					"content": "무토타도 한때 비행 부대의 엘리트였으니, 꽃깃회로 돌아가서 두 사람한테 조언을 구해보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220222,
					"content": "어디서 본 것 같지 않나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				}
			]
		},
