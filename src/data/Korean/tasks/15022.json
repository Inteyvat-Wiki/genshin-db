			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"실로닌"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1350.876,
							161.634,
							7851.647
						],
						"pointId": 350400213
					}
				]
			},
			"dialogs": [
				{
					"id": 150220101,
					"content": "알파가 분명… 테팔이 메아리 아이에서 왔다고 했지? 하지만 어떻게 찾지? 한 명씩 붙잡고 물어봐야 하나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150220102,
					"content": "메아리 아이의 지인에게 도움을 받는 편이 빠를 거야. 이 시간에 여기서 제일 찾기 쉬운 사람이라면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220103
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220103,
					"content": "——실로닌, 그만 일어나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220104
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220104,
					"content": "하암… 너희구나… 으음… 조금만 기다려… 금방 내려갈게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220105
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 150220105,
					"content": "으음… 하암…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220106
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 150220106,
					"content": "두 분 다 나무 위에 있는 걸 좋아하시네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220107
					]
				},
				{
					"id": 150220107,
					"content": "난 더 오래 날고 더 멀리 보려고 나무를 오르는 거지, 나무 위에서 자는 일은 거의 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220108
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220108,
					"content": "모든 사람이 너처럼 하루 종일 돌아다녀도 지칠 줄 모르는 건 아니거든…. 그래서, 이번에는 또 무슨 일로 내 소중한 휴식 시간을 방해한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220109
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 150220109,
					"content": "미안, 실로닌. 급한 일이라서 어쩔 수 없었어. 혹시 테팔이라는 장인 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220110
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220110,
					"content": "테팔? 들어본 것 같은데… 푸마 씨네 애였지 아마?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220111
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 150220111,
					"content": "지금도 메아리 아이에 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220112
					]
				},
				{
					"id": 150220112,
					"content": "아니, 여길 떠난 지 몇 년은 됐어…. 근데 테팔은 왜?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220113
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 150220113,
					"content": "말하자면 긴데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220114
					]
				},
				{
					"id": 150220114,
					"content": "사건의 자초지종을 최대한 간략하게 설명한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220115
					]
				},
				{
					"id": 150220115,
					"content": "「열소 날개」? 테팔 녀석, 정말 만들어냈을 줄이야…. 아무래도 오늘 휴식은 여기서 끝내야 할 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220116
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 150220116,
					"content": "「정말」 만들어냈다니? 설마 전에도 비슷한 연구를 했던 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150220117,
					"content": "응. 테팔은 꽃깃회에서 돌아온 뒤, 인공물을 이용해 하늘을 나는 법을 연구하기 시작했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220118
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 150220118,
					"content": "「날개 잃은 자」가 된 후인가…. 인공물이라면… 네가 나한테 만들어준 총 같은 걸 말하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220119
					],
					"speakerTitle": "차스카"
				},
				{
					"id": 150220119,
					"content": "네 「총」은 가장 긍지 높은 깃룡보다도 길들이기 어렵잖아? 테팔이 바라는 건 재능 없는 평범한 사람도 자유롭게 비행할 수 있는 거였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220120
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 150220120,
					"content": "하지만 그땐 번번이 실패해서, 공방을 수차례 날려 먹고 목숨까지 잃을 뻔했지. 그 뒤론 나도 별로 관심을 가지지 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220121
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 150220121,
					"content": "테팔의 부모님은 젊었을 때 많은 곳을 여행하다, 테팔을 가지고 나서야 부족에 돌아왔어. 그 후에도 외진 곳에 살아서 남들과 교류가 거의 없었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220122
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 150220122,
					"content": "부족 사람들도 친분이 깊은 편은 아니라서… 테팔에 관한 자세한 상황은 직접 물어보는 게 나을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220123
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 150220123,
					"content": "지금 가서 푸마 씨를 모셔 올 테니까, 내 공방 앞에서 기다리고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "실로닌"
				}
			]
		},
