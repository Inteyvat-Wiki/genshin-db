					"마르다바"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730101,
					"content": "저 덩치랑 붙어보고 싶어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730102
					]
				},
				{
					"id": 700730102,
					"content": "훌륭하도다! 주인님께서도 가끔은 옥체를 풀어 주셔야만, 떨어져 나오는 버섯 조각의 식감도 살아나는 법! 부디 전력을 다하거라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마르다바"
				}
			]
		},
		{
			"id": 7007302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"마르다바"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730201,
					"content": "나의 주인님, 마하바수{RUBY#[D]세상을 하사한 신의 후예}데바야푸트라시여! 원컨대 당신의 지비{RUBY#[D]생명의 뿌리}틴드리야가 이 암반의 초석까지 파고들어, 당신의 풍미가 이 세상 모든 신을 능가하기를…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마르다바"
				}
			]
		},
		{
			"id": 7007303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"마르다바"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730301,
					"content": "저게 뭔가요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730302
					]
				},
				{
					"id": 700730302,
					"content": "좋은 질문이다! 저분은 세상을 {RUBY#[S]비프론스}하사한 신의 후예이자, 풍미가 정점에 달한 버섯님이시다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730303
					],
					"speakerTitle": "마르다바"
				},
				{
					"id": 700730303,
					"content": "나가흐바야는 늘 초목의 주인과 꽃밭의{RUBY#[D]푸시파바티카} 주인의 이름을 외쳤고, 마르카니 카간은 적색 사막의 신에게 기도를 올렸지. 허나 그 셋 중에 나의 주인님보다 맛이 있는 분이 있더냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730304
					],
					"speakerTitle": "마르다바"
				},
				{
					"id": 700730304,
					"content": "불살이야말로 올바른 업을 쌓는 행위임을 알지어다. 저 신성한 육체가 없었다면 우리 또한 생존을 위해 짐승과 식물의 목숨을 앗아야만 했을 터… 오오, 참으로 애석한 일이로다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730305
					],
					"speakerTitle": "마르다바"
				},
				{
					"id": 700730305,
					"content": "공간의 주인께서 나를 발탁하셨을 때, 지{RUBY#[D]포자}비께서 동행하여 주신 것은 실로 천운이었도다. 보라, 덕분에 지금은 이렇게 자라나 우리에게 더없이 훌륭한 맛을 선사하고 있지 않은가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마르다바"
				}
			]
		},
		{
			"id": 7007304,
