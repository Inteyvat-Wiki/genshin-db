			},
			"dialogs": [
				{
					"id": 705140301,
					"content": "돌아오셨군요. 부품은 어떻게 되었나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705140302
					],
					"speakerTitle": "펠릭스·요그"
				},
				{
					"id": 705140302,
					"content": "찾는 게 이건 가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
