					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570701,
					"content": "어떤 기억이 적혀 있었어? 뭘 본 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570702
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 730570702,
					"content": "메모장의 주인이 너를 아는 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570703
					]
				},
				{
					"id": 730570703,
					"content": "그렇단 말이지… 난 아무것도 기억 안 나는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570704
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 730570704,
					"content": "메모장의 주인도… 너를 볼 수 없다고 적혀 있었어, 어른이 되어서 그런 거겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570705
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730570705,
					"content": "흠… 어른이 된다는 건 정말 골치 아픈 일이라니깐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570706
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730570706,
					"content": "참, 메모장에 적혀 있던 건데… 이 꽃을 너에게 주고 싶대!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570707
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730570707,
					"content": "여기 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570708
					]
				},
				{
					"id": 730570708,
					"content": "음…? 아앗! 이건 아주 중요한 꽃이야! 어째서… 메모장의 주인이 이 꽃을 가지고 있는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570709
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 730570709,
					"content": "실은 너도 이 꽃을 우리에게 준 적이 있어… 단지 네가 기억하지 못할 뿐이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570710
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730570710,
					"content": "그렇구나… 너희와 다시 친구가 되는 건 문제없지만… 난 그 노트의 주인이 어떻게 생겼는지도 모르는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570711
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 730570711,
					"content": "괘, 괜찮아… 상심하지 마. 꽃이 더 있으니까 분명 다른 기억을 떠올리게 해줄 수 있을 거야? 내 말이 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570712
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730570712,
					"content": "응, 하얀 둥실이 말이 맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570713
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 730570713,
					"content": "이 꽃을 가져갈게. 「마우티이마」라면 어떻게 깨울지 알고 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570714
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 730570714,
					"content": "#흠… 나라{NICKNAME}(이)랑 하얀 둥실이, 난 아란나가에게 가서 이걸 심고 노래를 들을래. 너희도 시간이 된다면 언제든 와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570715
					],
					"speakerTitle": "아란나킨"
				},
				{
					"id": 730570715,
					"content": "응! 꼭 그렇게 할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
