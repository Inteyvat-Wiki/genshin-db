					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570101,
					"content": "으으, 가 버렸어…. 하긴 우리가 함께 모험했던 걸 기억하지 못하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570102,
						730570103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730570102,
					"content": "너무 실망하지 마",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570104
					]
				},
				{
					"id": 730570104,
					"content": "응, 네 말이 맞아… 아, 맞다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730570105,
					"content": "지난번에 아란나킨이 가르쳐준 곡을 연주해 보자! 어쩌면 우릴 알아볼지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570106,
						730570108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730570106,
					"content": "일리 있는 말인데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570107
					]
				},
				{
					"id": 730570107,
					"content": "헤헤, 난 페이몬이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730570108,
					"content": "간만에 쓸모 있는 제안을 한 거 같아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570109
					]
				},
				{
					"id": 730570109,
					"content": "무슨 말을 그렇게 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730570103,
					"content": "다시 친구가 되면 되잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570110
					]
				}
			]
		},
		{
			"id": 7305702,
			"completionStepIds": [
				7305707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
