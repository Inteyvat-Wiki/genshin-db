					"잭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010501,
					"content": "스읍, 아파…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010502
					],
					"speakerTitle": "잭"
				},
				{
					"id": 206010502,
					"content": "살아 돌아갈 수 없을 줄 알았는데, 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010503
					],
					"speakerTitle": "잭"
				},
				{
					"id": 206010503,
					"content": "괜찮아요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010504
					]
				},
				{
					"id": 206010504,
					"content": "하, 이 정도쯤이… 윽! 이 정도… 쯤이야. 난 괜찮아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010505
					],
					"speakerTitle": "잭"
				},
				{
					"id": 206010505,
					"content": "난 앞쪽 야영지에 츄츄족들이 모여드는 걸 발견하고, 무슨 짓을 하려는지 보려고 뒤따라갔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010506
					],
					"speakerTitle": "잭"
				},
				{
					"id": 206010506,
					"content": "…하지만 너무 가까이 가버리는 바람에 조사하던 도중 들켜 버렸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010507
					],
					"speakerTitle": "잭"
				},
				{
					"id": 206010507,
					"content": "아, 이럴 때가 아니지. 내 걱정은 말고 빨리 저 앞에 있는 츄츄족을 무찔러줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010508
					],
					"speakerTitle": "잭"
				},
				{
					"id": 206010508,
					"content": "츄츄족의 숫자가 갈수록 많아지고 있어. 절대 그들 뜻대로 되게 해선 안 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010509
					],
					"speakerTitle": "잭"
				},
				{
					"id": 206010509,
					"content": "난… 난 혼자서도 괜찮아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "잭"
				}
			]
		},
		{
			"id": 2060106,
			"completionStepIds": [
				2060108
			],
