			"dialogs": [
				{
					"id": 206010701,
					"content": "돌아왔구나, 잭도 돌아왔네. 근데 왜 그렇게 절뚝거려…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010702
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 206010702,
					"content": "도대체 무슨 일이 있었던 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010703
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 206010703,
					"content": "잭이 무모하게 뛰어들다가 다쳤어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010704
					]
				},
				{
					"id": 206010704,
					"content": "역시 내 예상대로야, 휴… 평소에 내가 했던 말들은 하나도 기억 못하나 보군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010705
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 206010705,
					"content": "용맹함을 증명하고 싶어 하는 건 알지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010706
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 206010706,
					"content": "됐네, 이 일은 알겠어. 내가 잭과 한번 이야기해보지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010707
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 206010707,
					"content": "이건 너에게 주는 모험 보상이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사이러스"
				}
			]
