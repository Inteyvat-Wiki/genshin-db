			"dialogs": [
				{
					"id": 20180301,
					"content": "날 따라온 건가? 간도 크군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180302
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 20180302,
					"content": "내가 가주님에게 해명을 요구하기 전까진 증인으로서 너희를 체포하지 않겠다고 약속하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180303
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 20180303,
					"content": "단… 지금까지 한 말이 모두 가짜인 게 밝혀지면, 너흰 돌아갈 수 없을 뿐 아니라 다른 죄목까지 추가될 거야, 알겠나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180304,
						20180305
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 20180304,
					"content": "바라던 바예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				},
				{
					"id": 20180306,
					"content": "흥, 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쿠죠 사라"
				},
				{
