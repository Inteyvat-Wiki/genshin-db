			},
			"dialogs": [
				{
					"id": 20180201,
					"content": "야에 궁사님, 약속대로 왔습니다. 아무에게도 알리지 않고 혼자 왔으니 안심하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180202
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 20180202,
					"content": "약속 지킬 줄 알았어. 짐작건대… 요즘 심란해서 잠도 제대로 못 잤겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180203
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20180203,
					"content": "나… 난 가주님을 의심하지 않습니다. 지나친 추측입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180204
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 20180204,
					"content": "그래서, 증거는 어디 있죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180205
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 20180205,
					"content": "여기요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180206
					]
				},
				{
					"id": 20180206,
					"content": "오~ 약속을 지킨 사람이 한 명 더 왔군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180207
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20180207,
					"content": "이걸 손에 넣겠다고 우리가 얼마나 고생했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20180208,
					"content": "스스로 판단하도록 사라에게 보여줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180209
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20180209,
					"content": "이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180210
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 20180210,
					"content": "…가주의 직인이 찍혀 있는 걸 보니 조작된 것 같진 않군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180211
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 20180211,
					"content": "저항군, 산호궁, 전선의 일에 관해선 일절 언급도 없다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180212
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 20180212,
					"content": "전선에서 사망한 장병들, 고통받고 있는 백성들은 언급할 가치도 없단 말인가?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180213
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 20180213,
					"content": "사람 목숨을 우습게 보다니… 대체 왜 이렇게까지 숨기는 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180214
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 20180214,
					"content": "그야 안수령을 추진하기 위함이지. 이런 걸 다 적었다가 쇼군이 후회라도 하면 큰일이잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180215
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20180215,
					"content": "텐료 봉행은… 일부러 쇼군을 속이고 있던 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180216
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 20180216,
					"content": "맞아, 잘 생각해봐. 안수령이 시행되면… 누구한테 더 유리할까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180217
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20180217,
					"content": "또 다른 밀서가 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180218
					]
				},
				{
					"id": 20180218,
					"content": "쿠죠 가문의 가주가 숨긴 텐료 봉행과 우인단이 주고받은 편지야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20180219,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180220
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 20180220,
					"content": "어때? 이제 네가 보고 싶어하는 것과 보고 싶지 않은 것 모두 네 앞에 놓여 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180221
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20180221,
					"content": "설마… 또 회피하려는 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180222
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20180222,
					"content": "지금까지 내가 해왔던 모든 게 다… 어떻게 이럴 수가… 젠장!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180223
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 20180223,
					"content": "배신은 용납할 수 없어요… 가주한테 직접 묻겠습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180224
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 20180224,
					"content": "쿠죠 사라가 화가 단단히 났어. 작전 성공이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180225,
						20180226
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20180225,
					"content": "막부군도 당분간은 지도자가 없겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				},
				{
					"id": 20180227,
					"content": "응, 쿠죠 사라를 따라가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180228
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20180228,
					"content": "잠시만, 여행자. 너한테 더 할 말이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180229
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20180229,
					"content": "응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180230
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20180230,
					"content": "처음 「일심정토」에 들어갔을 때 천수백안 신상 앞에 있었지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180231
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20180231,
					"content": "맞아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180232
					]
				},
				{
					"id": 20180232,
					"content": "그때를 재현할 방법을 생각해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180233
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20180233,
					"content": "천수백안 신상 앞에서 다시 라이덴 쇼군의 「마음을 열게」 하면, 반드시 기회가 있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180234
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20180234,
					"content": "노력해볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180235
					]
				},
				{
					"id": 20180235,
					"content": "자, 받아. 작별의 선물이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180236
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20180236,
					"content": "이건…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180237
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20180237,
					"content": "아주 영험한 나루카미 다이샤의 부적이지. 특별히 널 위해 남겨뒀어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180238,
						20180239
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20180238,
					"content": "고마워요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180240,
					"content": "후후, 위기에 닥쳤을 때 그걸 꺼내면, 위기가 해결될지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180241
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20180241,
					"content": "물론 내가 보고 싶을 때 꺼내 봐도 돼. 갑자기 내가 툭 튀어나올지도 모른다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180242
					],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20180242,
					"content": "이럴 땐 여행자 좀 그만 놀리라구, 여우 아가씨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180243
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20180243,
					"content": "하하하… 미안. 그럼 바보 같은 내 친구 잘 좀 부탁해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야에 미코"
				},
				{
					"id": 20180239,
					"content": "소중히 간직할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180226,
					"content": "따라가면 라이덴 쇼군을 만날지도 몰라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				}
			]
		},
