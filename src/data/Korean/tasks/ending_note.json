					"바바라"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960201,
					"content": "이분은 성당의 천공 하프 회수 전담원, 바바라 부제야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960202
					],
					"speakerTitle": "진"
				},
				{
					"id": 3960202,
					"content": "부디 바람 신의 가호가 함께하길",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960203
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 3960203,
					"content": "단장 대행님과 비교해, 제게 말할 자격이 없을지도 모르겠으나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960204
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 3960204,
					"content": "몬드를 대신해 여러분께 감사의 인사를 전하고 싶군요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960205
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 3960205,
					"content": "평화적으로 해결되어 정말 다행입니다! 용과 정면으로 충돌했다면 그 결과가 어땠을지 상상하기도 싫군요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960206
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 3960206,
					"content": "그리고 「우인단」 쪽은 더 말할 것도 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960207
					],
					"speakerTitle": "진"
				},
				{
					"id": 3960207,
					"content": "일이 이렇게 됐으니, 뒤에서 속으로 분통을 터뜨리고 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960208
					],
					"speakerTitle": "진"
				},
				{
					"id": 3960208,
					"content": "이번 일로 페보니우스 기사단을 압박할 최고의 명분이 사라진 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960209
					],
					"speakerTitle": "진"
				},
				{
					"id": 3960209,
					"content": "스네즈나야 왕국의 사신이 얼마나 억지스러운지만 증명했을 뿐, 실질적으로 외교가 진전된 건 없으니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960210
					],
					"speakerTitle": "진"
				},
				{
					"id": 3960210,
					"content": "자, 그래서 천공의 하프는 가져오셨나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960211
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 3960211,
					"content": "단장 대행님의 담보도 무한한 건 아니라서요, 추기경님이 계속 재촉하셔서 말입니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960212
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 3960212,
					"content": "가… 가져오긴 했는데, 단지… 음… 그러니까… 아주 약간…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3960213,
					"content": "아아, 걱정 마세요. 대여금은 받지 않겠습니다. 성당은 항상 따로 헌금을 받고 있으니까요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바바라"
				}
			]
		},
		{
			"id": 39605,
			"completionStepIds": [
				39605
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
