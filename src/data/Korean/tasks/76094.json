			},
			"dialogs": [
				{
					"id": 760940201,
					"content": "잘됐다. 역시 너라면 방법이 있을 줄 알았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940202
					],
					"speakerTitle": "바카랑"
				},
				{
					"id": 760940202,
					"content": "늘보양은 달의 힘이 없는 곳에서는 오래 못 버티지만, 적어도 노드크라이에 머무는 동안에는 그 분에게 큰 위안이 되겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940203
					],
					"speakerTitle": "바카랑"
				},
				{
					"id": 760940203,
					"content": "그럼 난 이만 가볼게. 이건 작은 성의 표시야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바카랑"
				}
			]
		},
