			"dialogs": [
				{
					"id": 1903102101,
					"content": "이런 데서 혼자 다니면 위험해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102102
					],
					"speakerTitle": "부삼"
				},
				{
					"id": 1903102102,
					"content": "뭘 마주치게 될지 모르거든. 이를테면 사람이 아닌 존재랄까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102103,
						1903102104
					],
					"speakerTitle": "부삼"
				},
				{
					"id": 1903102103,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				},
				{
					"id": 1903102105,
					"content": "호오? 꽤 침착하네. 「강가를 걷다 보면 신발이 젖기 마련이다」라는 속담이 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102106
					],
					"speakerTitle": "부삼"
				},
				{
					"id": 1903102106,
					"content": "이런 으스스한 곳을 걷다 보면, 봐선 안 될 것들을 볼 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102107
					],
					"speakerTitle": "부삼"
				},
				{
					"id": 1903102107,
					"content": "한번 봤다 하면 악몽이 돼서 평생을 괴롭힐지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102108,
						1903102109
					],
					"speakerTitle": "부삼"
				},
				{
					"id": 1903102108,
					"content": "아, 그래요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102110,
					"content": "아니, 너무 침착한 거 아냐? 보통은 내 말이 다 끝나기도 전에 무서워서 냅다 튀던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102111,
						1903102114
					],
					"speakerTitle": "부삼"
				},
				{
					"id": 1903102111,
					"content": "당신은 평범한 사람처럼 보이거든요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102112
					]
				},
				{
					"id": 1903102112,
					"content": "그렇긴 한데, 진정한 고수는 상대의 공포심을 이용해 무서운 분위기를 만드는 법이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102113
					],
					"speakerTitle": "부삼"
				},
				{
					"id": 1903102113,
					"content": "내가 어떤 모습인지는 별로 중요하지 않지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "부삼"
				},
				{
					"id": 1903102117,
					"content": "그러니까 너처럼 귀신의 존재를 안 믿는 사람한텐 내가 무슨 방법을 써도 소용없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102118
					],
					"speakerTitle": "부삼"
				},
				{
					"id": 1903102118,
					"content": "그냥 게으른 거 아니에요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102119
					]
				},
				{
					"id": 1903102119,
					"content": "그런 말 마. 자, 난 이제 다른 겁쟁이들을 찾으러 가볼래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102120
					],
					"speakerTitle": "부삼"
				},
				{
					"id": 1903102120,
					"content": "너도 얼른 네 친구한테 가봐. 무서워서 덜덜 떨고 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "부삼"
				},
				{
					"id": 1903102114,
					"content": "복장은 따로 없나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102115
					]
				},
				{
					"id": 1903102115,
					"content": "있긴 있는데 너무 더워서…. 게다가 진정한 고수는 상대의 공포심을 이용해 무서운 분위기를 만드는 법이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102116
					],
					"speakerTitle": "부삼"
				},
				{
					"id": 1903102116,
					"content": "내가 어떤 모습인지는 별로 중요하지 않지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "부삼"
				},
				{
					"id": 1903102109,
					"content": "못 알아듣겠네요. 무슨 일이시죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102104,
					"content": "안녕하세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				}
			]
		}
