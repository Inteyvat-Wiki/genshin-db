				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000701,
					"content": "찾았어! 이 반지인 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000702
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105000702,
					"content": "정말 예쁘다. 분명 엄청 비싸겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000703
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105000703,
					"content": "으, 나쁜 생각 안 했어! 빨리 <color=#00E1FFFF>주 사장님</color>한테 돌려주자!",
					"roleType": "TALK_ROLE_NPC",
