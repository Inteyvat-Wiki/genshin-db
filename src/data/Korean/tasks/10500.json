					"주 사장"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000201,
					"content": "(객잔이 이런 곳에 있으니 장사가 잘될 리 없지…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105000202,
					"content": "모나, 마침 잘 왔어! 오는 길에 옥석 반지 못 봤니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000203
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 105000203,
					"content": "옥석 반지? 못 본 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000204
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105000204,
					"content": "거참 골치 아프게 됐네…. 잠깐 방심한 사이에 슬라임이 그 반지를 삼켜버렸지 뭐야. 그건 우리 어머니가 주신 건데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000205
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 105000205,
					"content": "응? 그런 일은 걱정할 필요 없다구. 점괘를 잘 보는 모나가 있잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105000206,
					"content": "그건 안 돼. 점성술은 진실을 통찰하고 운명을 관측하기 위한 진지한 학문이지 잡일이나 해결하는 게 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000207
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105000207,
					"content": "그치만 사장님이 잘 챙겨줬다고 하지 않았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105000208,
					"content": "이건 점성술사의 긍지와 마음가짐의 문제야. 만약 점성술이 모든 걸 해결해줄 거라고 생각한다면 별들에 버림받고 말 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000209
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105000209,
					"content": "그럼 점괘는 인도하는 힘을 잃어 더 이상 미지의 안개를 꿰뚫어 볼 수 없게 돼. 원칙은 원칙이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000210
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105000210,
					"content": "그렇게 대단한 능력으로 돈 벌 생각을 안 하다니, 아쉽네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105000211,
					"content": "휴, 너희가 도와주면 사례로 2만 모라를 주려고 했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000212
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 105000213,
					"content": "왜 그래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000214,
					"content": "너 표정이 좀 이상해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000212,
					"content": "2만…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000213,
						105000214
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105000216,
					"content": "점성술사의 긍지에 대해 얘기하던 게 누구더라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000217,
					"content": "원칙은 원칙이라고 얘기하던 게 누구더라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000215,
					"content": "아, 아니야! 그냥… 반지를 줍는 사람은 이렇게 2만 모라를 벌 수 있으니 좋겠다고 생각한 것뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000216,
						105000217
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105000218,
					"content": "크흠, 그렇긴 하지만… 사장님이 힘들게 장사하면서 그렇게 큰돈을 들여 그 반지를 찾는다는 건, 분명 남다른 의미가 있는 거 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000219
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105000219,
					"content": "이렇게 가버리는 것도 좀 아닌 것 같으니 한번 잘 찾아보자. 점성술 말고 다른 방법이 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000220
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105000220,
					"content": "나랑 같은 생각이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105000222,
					"content": "어쩔 수 없네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000223,
					"content": "또 내가 해야 해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000221,
					"content": "#{NICKNAME}, 이번 일은 너한테 맡길게! 이건 스승이 너한테 맡긴 첫 번째 임무야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000222,
						105000223
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105000224,
					"content": "음… 슬라임이 삼킨 거라면 「원소 미끼」로 근처의 슬라임을 전부 불러들이는 거 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000225
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105000825,
					"content": "그거 알아? 다운 와이너리에서 술을 빚을 때 어쩌다 정제된 건데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000826
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105000826,
					"content": "제조법은 비밀이지만 슬라임을 끌어들이는 효과가 아주 강력한 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000827
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105000227,
					"content": "역시 페이몬이야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000228
					]
				},
				{
					"id": 105000229,
					"content": "간식이라고 쟁여둔 건 아니겠지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000230
					]
				},
				{
					"id": 105000226,
					"content": "헤헤, 사실은 내가 몰래 좀 챙겨놨어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000227,
						105000229
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105000228,
					"content": "정말 믿음직한 파트너지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105000230,
					"content": "에잇, 그런 사소한 건 신경 쓰지 말고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105000231,
					"content": "좋은 방법이라도 찾은 모양이네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000232
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105000232,
					"content": "응, 금방 다녀올게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
