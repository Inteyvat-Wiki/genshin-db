			"dialogs": [
				{
					"id": 762000501,
					"content": "루미, 네가 보기에도 여기 있을 것 같아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000502
					],
					"speakerTitle": "린네아"
				},
				{
					"id": 762000502,
					"content": "야호오!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000503
					],
					"speakerTitle": "루미"
				},
				{
					"id": 762000503,
					"content": "갇혀 있던 범무늬 고양이를 구조했다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762000504
					]
				},
				{
					"id": 762000504,
					"content": "그들이 찾는 게 바로 너였구나. 다행히 다치진 않았네. 조금만 늦었으면 위험할 뻔했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000505
					],
					"speakerTitle": "린네아"
				},
				{
					"id": 762000505,
					"content": "어쨌든, 어서 동료한테 가보렴!",
					"roleType": "TALK_ROLE_NPC",
