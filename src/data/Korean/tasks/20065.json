			"dialogs": [
				{
					"id": 200650101,
					"content": "골치 아프네…. 이걸 어떻게 해결해야 하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650102
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200650102,
					"content": "뭐 하는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200650103
					]
				},
				{
					"id": 200650103,
					"content": "다음 기사단 선발을 위해 훈련 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650104
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200650104,
					"content": "음… 하지만 난 진 단장님 같은 힘이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650105
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200650105,
					"content": "「힘」을 단련하는 것보다는 「기술」을 익히는 게 나한테 더 맞는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650106
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200650106,
					"content": "예를 들어, 이 통나무들을 단숨에 모두 파괴하는 방법 같은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200650107
					],
					"speakerTitle": "엘린"
				},
				{
					"id": 200650107,
					"content": "이 통나무들은 엄청 단단해서 쉽게 생각해선 안 돼…. 이것들을 어디서 구한 건진 모르겠지만 아빠가 엄청 고생했을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엘린"
				}
			]
		},
