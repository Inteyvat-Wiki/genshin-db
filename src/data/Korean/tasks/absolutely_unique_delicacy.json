					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250401,
					"content": "우와, 전혀 다른 답을 얻었네. 절운 누룽지와 죽순 수프, 둘 다 맛있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220250402,
					"content": "뭘 만드는 게 좋을까? 고민이네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220250403,
					"content": "페이몬은 뭐가 좋다고 생각해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250404
					]
				},
				{
					"id": 220250404,
					"content": "응? 나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220250405,
					"content": "둘 중에… 하나를 고른다면… 난…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220250406,
					"content": "나는 흘호어 구이로 할래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220250407,
					"content": "흘호어 구이는 패기 있어 보이잖아. 이걸 먹는다면 탕운의 문제도 해결되지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250408,
						220250409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220250408,
					"content": "페이몬은 먹는 것에는 도가 텄다니까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250410
					]
				},
				{
					"id": 220250410,
					"content": "에고, 그러니까 네가 결정해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250411,
						220250412,
						220250413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220250411,
					"content": "그럼… 맛있는 절운 누룽지!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250414
					]
				},
