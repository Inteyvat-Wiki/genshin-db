					"이효"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250201,
					"content": "무슨 일이지? 아… 탕운 씨?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250207
					],
					"speakerTitle": "이효"
				},
				{
					"id": 220250207,
					"content": "식욕부진… 이상한 냄새가 입안 가득하고… 특별한 음식이 있어야 해결할 수 있다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250202
					],
					"speakerTitle": "이효"
				},
				{
					"id": 220250202,
					"content": "그런 문제가 생기다니… 좀 골치 아픈 일이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250203
					],
					"speakerTitle": "이효"
				},
				{
					"id": 220250203,
					"content": "근데 특별히 유명하고 진귀한 요리가 필요한 것 같진 않고, 식감과 풍미가 독특하고 거기에 약간의 임팩트를 주면 될 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250204
					],
					"speakerTitle": "이효"
				},
				{
					"id": 220250204,
					"content": "그래서 난 절운 누룽지를 추천할게! 바삭바삭한 식감과 불같은 매콤함까지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250205
					],
					"speakerTitle": "이효"
				},
				{
					"id": 220250205,
					"content": "예전에 경책 산장에서 처음 맛본 절운 누룽지가 십수 년 지난 지금도 자주 생각나는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250206
					],
					"speakerTitle": "이효"
				},
				{
					"id": 220250206,
					"content": "절운 누룽지라면 어떤 문제든 쉽게 풀릴 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이효"
				}
			]
		},
