			"trigger": {
				"objectNames": [
					"탕운",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220250101,
					"content": "아… 배고파… 못 참겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250102
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220250102,
					"content": "무슨 일 있었어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250103
					]
				},
				{
					"id": 220250103,
					"content": "나… 나도 잘 모르겠어… 아무튼 정신이 하나도 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250104
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220250104,
					"content": "어제 저녁인가, 네가 만든 음식을 집으로 가져가서 제대로 먹어봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250105
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220250105,
					"content": "그 요리 맛은 확실히 「참신」했지만 그래도 배를 채울 수 있었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250106
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220250106,
					"content": "그 후 잠을 푹 자고 오늘 열심히 일하려고 했는데, 결국… 결국…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250107
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220250107,
					"content": "잠을 청할 때마다 그 요리의 묘한 냄새가 올라와서 순간 정신이 번쩍 들더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250108
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220250108,
					"content": "그 뒤로 이 상태가 계속 반복돼서 몽롱한 상태로 날이 밝았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250109
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220250109,
					"content": "잠을 조금 덜 잔 건 별일 아닌데 그전에도 가끔 야근에 시달렸으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250110
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220250110,
					"content": "문제는 오늘이야! 일어나서 뭐 좀 먹으면 괜찮을 줄 알았거든. 근데 막상 뭘 먹기만 하면 입안 가득 그 요리 냄새가 풍길 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250111
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220250111,
					"content": "그 요리가 그렇게 위력이 있나요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250112
					]
				},
				{
					"id": 220250112,
					"content": "에휴, 아무래도… 독특한 맛의 음식이라야 그 이상한 냄새를 씻어낼 수 있을 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250113
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220250113,
					"content": "독특한 맛의 음식? 그렇다면 독특한 맛의 음식이 뭔지 다른 사람에게 물어볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220250114,
					"content": "그다음에 탕운에게 만들어 주면… 어쩌면 문제를 해결할 수 있을지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220250115,
					"content": "정말? 정말 잘됐네, 고마워! 혹시 괜찮다면, 이도에 가서 물어봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250116
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220250116,
					"content": "내 기억에… 이도의 상인 이효는 음식에 대한 조예가 깊고, 초유 상회의 추월은 거의 미식가야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "탕운"
				}
			]
		},
		{
			"id": 2202502,
			"completionStepIds": [
				2202502
