					"타이페르"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240801,
					"content": "여긴 경치가 참 아름다운 것 같아. 매년 마을에서 많은 악기를 주문했지만, 여행객 신분으로 방문한 건 이번이 처음이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240802,
						742240803
					],
					"speakerTitle": "타이페르"
				},
				{
					"id": 742240802,
					"content": "악보에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742240803,
					"content": "별일 아니에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240804
					]
				},
				{
					"id": 742240804,
					"content": "그럼 부탁해. 너희가 돌아오기 전까지 난 마을에서 좋은 소식 기다리고 있을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타이페르"
				}
			]
		},
		{
			"id": 7422409,
			"completionStepIds": [
				7422409
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422409",
							"2"
						],
						"stepId": 7422409,
						"stateName": "QUEST_STATE_UNFINISHED"
