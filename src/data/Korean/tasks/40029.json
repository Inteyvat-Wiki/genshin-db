			"dialogs": [
				{
					"id": 400290101,
					"content": "알베도!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290102,
					"content": "여행자, 페이몬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290103
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290103,
					"content": "이야기를 다 짰나 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290104
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290104,
					"content": "그럼그럼~ 넌? 시간 더 필요해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290105,
					"content": "아니, 나도 다 짜놨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290106
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290106,
					"content": "선착순이니까 내가 먼저 할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290107,
					"content": "응, 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290108
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290108,
					"content": "그럼 시작한다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290109,
					"content": "옛날 옛적에 한 사악한 학자가 산에 있는 구라구라꽃을 잡아다 개조했어. 그 구라구라꽃들은 고통을 안고 인간의 모습으로 변해 산길을 오가는 행인들을 기다렸지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290110,
					"content": "그들은 관심 있어 하는 사람들한테 항상 이런 식의 질문을 했어. 내가 누구게? 넌 누구지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290111,
					"content": "만약 대답이 틀리면… 우앙하고 잡아먹히고 말아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290112,
					"content": "음, 정말 무섭군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290113
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290113,
					"content": "페이몬 무서워",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290114
					]
				},
				{
					"id": 400290114,
					"content": "뭐야, 하나도 안 놀랬잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290115,
					"content": "담력이 센 걸 어떡해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290116
					]
				},
				{
					"id": 400290116,
					"content": "트집 잡지 마! 불만이면 네가 직접 써보든가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290117,
					"content": "그럼, 공포 요소를 더 넣어서…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290118,
						400290119
					]
				},
				{
					"id": 400290118,
					"content": "구라구라꽃이 사람을 먹고 나면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290120
					]
				},
				{
					"id": 400290120,
					"content": "그러니까 범인인 구라구라꽃이 피해자의 모습으로 변해버리는 거네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290121
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290121,
					"content": "그리고 그 신분을 이용하는 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290122
					]
				},
				{
					"id": 400290122,
					"content": "그럼 구라구라꽃이 성에 진입하게 되는 거야?! 평범한 인간의 모습으로 집에 돌아가서 가족들을 전부 먹어 치우는 거지… 으악…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290123,
					"content": "내가 시작한 거지만 진짜 무섭다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290124,
					"content": "괜찮은 이야기네. 좀 기록해둬도 될까? 다른 사람이랑 얘기할 때 유용할 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290125
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290125,
					"content": "사람들 놀래키려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290126,
					"content": "응",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290127
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290127,
					"content": "정말 사악하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290128,
					"content": "그럼 알베도는 어떤 이야기를 만들었어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290129
					]
				},
				{
					"id": 400290129,
					"content": "내 이야기는 페이몬 것보다 좀 더 길어. 모든 건 한 연금술사로부터 시작돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290130
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290130,
					"content": "위대한 연금술사는 1호를 창조했어. 1호는 그녀의 자랑을 한 몸에 안고 평범한 인간들 사이로 완벽하게 스며들었지. 아무도 곁에 있는 친구가 인조인간이라고는 상상 못 했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290131
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290131,
					"content": "하지만 1호는 자신이 탄생하기 전에 연금술사가 무수한 실험을 했었단 걸 몰랐어. 실패한 불량품은 버려졌지만, 죽지는 않았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290132
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290132,
					"content": "실패작 2호는 거대한 드래곤의 배에 삼켜져 드래곤과 함께 설산에 남게 됐어. 그러다 몇 년이 흐른 후, 그는 어떤 신비한 드래곤의 힘에 의해 깨어났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290133
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290133,
					"content": "그는 설산의 다양한 사람들을 보게 됐어. 그리고… 사람들과 신기하게도 잘 어울려 지내는 1호도 보게 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290134
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290134,
					"content": "2호는 실험체가 사람들의 눈을 완벽하게 속일 수 있을 거라곤 상상도 못 했어. 사람들은 1호를 친구로 받아들였고 살갑게 그의 이름을 불렀지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290135
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290135,
					"content": "그게 2호가 바라던 일이었고, 2호는 1호를 대신해 그 행복한 사람이 되고 싶었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290136
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290136,
					"content": "우으… 가, 갑자기 왜 이렇게 춥지? 무서워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290137
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290137,
					"content": "2호는 자신의 계획을 실행하기 시작했어. 1호의 책과 노트를 훔쳐 1호가 연금술사에게서 전수받은 지식을 연구하기 시작했지. 똑똑한 그는 지식을 빠르게 배워나갔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290138
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290138,
					"content": "그 후, 그는 자신의 얼굴을 1호와 완전히 똑같이 바꿨어. 그리고 의태가 가능한 설산 식물을 찾아 드래곤의 피와 연금술로 식물을 개조했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290139
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290139,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290140
					]
				},
				{
					"id": 400290140,
					"content": "2호는 자신을 1호와 완전히 똑같게 만들었고, 세 번째 개체인 3호를 제작했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290141
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290141,
					"content": "엥?! 세 번째?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290142
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290142,
					"content": "하지만 좀 달랐던 건, 2호는 완벽한 인간이 되고 싶었어. 그래서 그는 자신과 3호 목에 있는 결점의 표식을 일부러 지웠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290143
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290143,
					"content": "일부러… 지웠다고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290144
					]
				},
				{
					"id": 400290144,
					"content": "내 생각엔, 일부러 표식을 지운 건 무의식중에 한 걸 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290145
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290145,
					"content": "완벽한 인간이 되는 걸 지나치게 갈망했던 그는 인간은 불완전하기에 더 생동감 넘치는 존재란 걸 잊었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290146
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290146,
					"content": "2호의 계획은 무척 치밀했어. 3호가 사람들의 주의를 돌리고, 그런 3호를 처리한 1호는 위협이 사라졌다고 믿고 분명 방심할 거라 생각했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290147
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290147,
					"content": "1호가 혼자 남았을 때가 2호가 움직일 최적의 찬스였어. 1호를 제거하면 그가 유일한 개체가 될 수 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290148
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290148,
					"content": "그는 아무도 모르게 사람들 기억 속에 있는 1호를 대체할 거고, 1호의 신분, 거처, 옷, 검, 이름 그리고 친구까지 이어받게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290149
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290149,
					"content": "하지만 사람들은 어제 만난 사람과 오늘 만난 사람이 다른 사람이란 걸 모를 테고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290150
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290150,
					"content": "무서워, 진짜 무섭다고…. 이제 아무도 못 믿어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290151
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290151,
					"content": "하지만 2호가 계획을 실행하기 전, 좀 특별한 낯선 이가 나타났어. 2호는 그 사람에게 다가가려 했지만, 그는 은연중에 2호와 1호가 다르다는 걸 눈치채고 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290152
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290152,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290153
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290153,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290154
					]
				},
				{
					"id": 400290154,
					"content": "왜? 놀랐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290155
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290155,
					"content": "그래서? 그 낯선 이는 어떻게 됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290156
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290156,
					"content": "물론 2호 계획 중의 일환이 됐지. 2호가 반드시 제거해야 할 대상이 하나 더 추가된 셈이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290157
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290157,
					"content": "정원에 있는 장미 세 송이처럼 외관은 똑같지만, 그중 하나만 독 가시가 없는 양질의 꽃인 거고, 나머지 두 개는 독 가시가 달린 조악품인 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290158
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290158,
					"content": "하지만 이 세상에선 그들을 돌본 원예사만이 어떤 장미가 양질의 꽃인지 구분해낼 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290159
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290159,
					"content": "사람들은 독이 있는 식물을 좋아하지 않아. 완벽한 장미만이 높은 가격에 팔리지. 하자가 있는 꽃은 자신의 낮은 가치를 숨기기 위해 독 가시로 원예사를 제거할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290160
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290160,
					"content": "2호도 그렇게 생각했어. 그래서 그는 인내심을 갖고 어둠 속에 숨어 기다리기로 했지. 좀 더 기다리면 기회가 올지도 모르니까. 진정한 「인간」이 될 수 있는 기회 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290161
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290161,
					"content": "(이건 단순한 이야기가 아니야…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290162
					]
				},
				{
					"id": 400290162,
					"content": "(전부 진짜 있었던 일이야. 알베도는 잔인하고 믿기 힘든 진상을 알려주려는 거야)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290163
					]
				},
				{
					"id": 400290163,
					"content": "암울한 이야기네, 나중엔 어떻게 됐어? 2호가 성공한 거야? 상상조차 하기 싫어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290164
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290164,
					"content": "실제로 일어날 수 없는 이야기이라 다행이지. 2호는 이 이야기에서도 결국 성공하지 못했어. 하지만 설산에선 절대 경계를 늦추지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290165
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290165,
					"content": "두린의 힘과 육신을 통해 변이된 괴물도 라인도티르의 창조물인 건 나와 다를 게 없으니까. 이런 생물을 조심해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290166
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290166,
					"content": "그렇지 않아! 넌 내 친구지 괴물이 아니야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290167
					]
				},
				{
					"id": 400290167,
					"content": "그렇게 말해줘서 고마워. 괜찮아, 난 내 정체를 잘 알고 있어. 너와 난 같은 이류니까, 네 앞에서만큼은 진실을 숨기지 않아도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290168
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290168,
					"content": "하지만 가끔은 연금술이 너무 위대한 학문이라는 느낌이 들어서 좀 무력해져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290169
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290169,
					"content": "대륙에서 살아가는 생명 중 하나로서 운명을 손에 쥐고 창조를 갈망하는 우리는 대체 얼마나 오만한 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290170
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290170,
					"content": "여행자, 창조는 오만한 행위일까? 아니라면, 우릴 제어하고 창조한 걸 「신」이라고 부르는 이유는 뭘까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290171
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290171,
					"content": "반대로 그게 맞다면, 우린 무슨 자격으로 「창조자」의 신분을 자처하는 거지? 우리의 경외와 존중은 어디까지이며, 무슨 쓸모가 있는 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290172
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290172,
					"content": "사칭범을 처리할 때 무슨 느낌이었어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290173
					]
				},
				{
					"id": 400290173,
					"content": "특별한 느낌은 없었어. 단지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290174
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290174,
					"content": "…그 사실을 떠올릴 때면 어쩐지 좀 슬퍼져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290175
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290175,
					"content": "알베도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290176
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290176,
					"content": "이봐——! 여행자! 여기 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290177
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 400290177,
					"content": "응? 엠버 목소리잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290178
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290178,
					"content": "역시 여기 있었구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290179
					],
					"speakerTitle": "유라"
				},
				{
					"id": 400290179,
					"content": "여행자, 사이러스 씨의 말을 전하러 왔어. 산 밑 캠프에 중요한 일이 있는 것 같으니 너도 같이 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290180
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 400290180,
					"content": "겨울 캠프가 거의 막바지야. 명목상의 교관이라도 얼굴은 비춰줘야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290181
					],
					"speakerTitle": "유라"
				},
				{
					"id": 400290181,
					"content": "이만 가봐야겠다, 알베도, 나중에 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290182
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290182,
					"content": "가서 볼일 봐, 난 아직 할 일이 있어서 여기 남을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290183
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 400290183,
					"content": "괜찮아, 요샌 산길이 엄청 순조롭거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290184
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 400290184,
					"content": "준비됐으면 출발하자, 다들 기다리겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "유라"
				},
				{
					"id": 400290119,
					"content": "그 사람의 모습으로 변해버리는 거야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290120
					]
				}
			]
		},
		{
			"id": 4002902,
			"completionStepIds": [
				4002904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002904",
							"2"
						],
						"stepId": 4002904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"사이러스",
					"요엘",
					"경솔한 팔라드",
					"요세프",
					"베넷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400290201,
					"content": "엥? 이 사람은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290202,
						400290203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290202,
					"content": "설마 요엘의 아버지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290204
					]
				},
				{
					"id": 400290204,
					"content": "소개할게. 이분은 요세프, 요엘의 아버지야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290205
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 400290205,
					"content": "아빠! 이분이 내가 얘기한 여행자예요. 전에 날 엄청 많이 도와줬고, 이번에 같이 눈사람도 만들었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290206
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 400290206,
					"content": "요엘한테 얘기 많이 들었어요. 아이고, 정말 고마워요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290207,
						400290208
					],
					"speakerTitle": "요세프"
				},
				{
					"id": 400290207,
					"content": "다시 만나서 다행이에요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290209
					]
				},
				{
					"id": 400290209,
					"content": "맞아, 정말 잘됐다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290210,
					"content": "잠깐, 사이러스 회장이 몰래 눈물을 훔치고 있어. 팔라드도 여기 있었잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290211,
					"content": "이번 일은 팔라드 씨 공이 커! 팔라드 씨, 직접 얘기하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290212
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 400290212,
					"content": "크흠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290213
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 400290213,
					"content": "그날은 날씨가 좋았어. 어쩐지 행운이 찾아올 것 같아서 나만의 이념을 굳게 믿고 위험한 곳으로 향했지. 위험한 곳일수록 엄청난 보물이 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290214
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 400290214,
					"content": "벌써부터 뭔가 신빙성이 없네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290215
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290215,
					"content": "근데 팀에서 혼자 벗어난지 얼마 안 돼서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290216
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 400290216,
					"content": "발을 헛디딘 바람에 언덕에서 굴러떨어졌지 뭐야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290217
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 400290217,
					"content": "으아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290218
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 400290218,
					"content": "(설마 산에서 나랑 잠깐 마주친 것 때문에 불운이 옮은 건 아니겠지…?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290219
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 400290219,
					"content": "그러다 평소에 잘 가지 않던 곳으로 떨어졌어… 거기에 가벼운 부상까지 입었지. 운이 나빠도 너무 나쁘다고 생각하고 있던 중…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290220
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 400290220,
					"content": "(윽…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290221
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 400290221,
					"content": "내 소리를 듣고 달려 나온 요세프 씨를 만나게 된 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290222
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 400290222,
					"content": "에…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290223
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 400290223,
					"content": "와, 완전 우연이었네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290224
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290224,
					"content": "요세프 씨도 행사에 참여하러 온 모험가 길드 사람인 줄 알았어. 근데 몇 마디 나눠보니 많은 걸 기억 못 하시더라고. 자기 이름조차 모르더라니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290225
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 400290225,
					"content": "어떻게 된 건지 생각할 겨를도 없었어. 너무 추웠거든. 다른 건 나중에 생각하고 일단 같이 산 넘어 캠프로 돌아가자고 재촉했지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290226
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 400290226,
					"content": "캠프에 돌아온 우린 요엘을 만났는데, 요엘은 요세프 씨를 보자마자 잠깐 벙찌더니 「아빠!」하고 외쳤어. 그때 기억이 일부 돌아온 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290227
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 400290227,
					"content": "아직 기억이 전부 회복되진 않았지만, 요엘과 내 아내… 이 두 사람만은 절대로 잊지 않아요… 아니, 잊을 수 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290228
					],
					"speakerTitle": "요세프"
				},
				{
					"id": 400290228,
					"content": "아빠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290229
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 400290229,
					"content": "그래, 요엘, 아빠 여기 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290230
					],
					"speakerTitle": "요세프"
				},
				{
					"id": 400290230,
					"content": "요세프, 정말 다른 건 아무것도 기억 안 나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290231
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290231,
					"content": "《멧돼지 공주》랑 설산에서 네가 먹이 줬던 여우들도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290232
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290232,
					"content": "죄송하지만 기억이 안 나요. 머리에 외상을 입어서 그런가? 잘 모르겠군요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290233
					],
					"speakerTitle": "요세프"
				},
				{
					"id": 400290233,
					"content": "깨어났을 땐 온몸이 피범벅이었어요. 짐도 잃어버렸고, 신분을 증명할 수 있는 것도 없었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290234
					],
					"speakerTitle": "요세프"
				},
				{
					"id": 400290234,
					"content": "그래서 한 동굴로 기어들어 가 천천히 상처를 회복했어요. 다리를 어느 정도 회복한 뒤엔 사냥을 하며 살아남았고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290235
					],
					"speakerTitle": "요세프"
				},
				{
					"id": 400290235,
					"content": "아빠… 진짜 걱정했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290236
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 400290236,
					"content": "괜찮아, 요엘, 울지 마. 아빠 이제 아무 데도 안 가고 네 옆에만 있을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290237
					],
					"speakerTitle": "요세프"
				},
				{
					"id": 400290237,
					"content": "흑… 다행이야, 정말 다행이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290238
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 400290238,
					"content": "정말 잘됐다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290239
					]
				},
				{
					"id": 400290239,
					"content": "그러고 보니 산에서 베넷을 만난 뒤부터 평소보다 운이 나빠진 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290240
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 400290240,
					"content": "역시! 휴… 난… 난 정말…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290241
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 400290241,
					"content": "아니, 내 말은 그 사고가 아니었더라면 이 큰 설산에서 요세프 씨를 절대 만날 수 없었을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290242
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 400290242,
					"content": "게다가 결국 다들 무사히 돌아왔잖아. 그러니까 너무 자책하지 마. 불운이 극한에 달하면 기적이 생길지도 모른다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290243
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 400290243,
					"content": "…팔라드 씨… 헤헤, 언제 화술이 그렇게 는 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290244
					],
					"speakerTitle": "베넷"
				},
				{
					"id": 400290244,
					"content": "어? 그래? 사, 사실을 말한 것뿐인데 뭐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290245
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 400290245,
					"content": "#아, 참, 여행자 {F#누나}{M#형아}, 사이러스 아저씨, 유라 누나랑 엠버 누나 정말 고마워요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290246
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 400290246,
					"content": "다들 엄청 잘 해주셨잖아요. 이 추억 절대 잊지 않을게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290247
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 400290247,
					"content": "눈사람은 설산을 떠나면 녹아버리겠죠? 같이 가져갈 수 없어서 아쉽네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290248
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 400290248,
					"content": "…그거라면 내게 방법이 있어, 기다려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290249
					],
					"speakerTitle": "유라"
				},
				{
					"id": 400290249,
					"content": "응? 유라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290250
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290250,
					"content": "…됐어. 요엘, 이거 받아. 견고한 얼음의 분말이야. 이걸 눈사람에 넣으면 영원히 녹지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290251
					],
					"speakerTitle": "유라"
				},
				{
					"id": 400290251,
					"content": "와! 진짜요? 짱이다! 유라 누나 대단해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290252
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 400290252,
					"content": "아빠, 영원히 안 녹는 눈사람이 생겼어요! 너무 좋아요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290253
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 400290253,
					"content": "정말 어떻게 보답해야 될지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290254,
						400290255
					],
					"speakerTitle": "요세프"
				},
				{
					"id": 400290254,
					"content": "괜찮아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290256
					]
				},
				{
					"id": 400290256,
					"content": "다들, 정말 고맙습니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290257
					],
					"speakerTitle": "요세프"
				},
				{
					"id": 400290257,
					"content": "아빠, 우리 같이 눈사람 옮기러 가요. 지금 당장요, 네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290258
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 400290258,
					"content": "그래. 그럼 여러분, 이만 요엘이랑 놀아주러 가겠습니다. 또 뵙죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290259
					],
					"speakerTitle": "요세프"
				},
				{
					"id": 400290259,
					"content": "그래요…. 나랑 팔라드도 가서 모험 중에 겪는 규율 문제에 관해 좀 얘기해야겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290260
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 400290260,
					"content": "엥? 사, 사이러스 회장님… 이건 공을 세워서 잘못을 만회한 셈이잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290261
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 400290261,
					"content": "다들 조심히 가——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290262
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290262,
					"content": "참, 너랑 엠버를 위해서도 이걸 만들었어. 겨울에 대한 기념이라고 생각하고 받아둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290263
					],
					"speakerTitle": "유라"
				},
				{
					"id": 400290263,
					"content": "그래도 돼? 유라한테 엄청 중요한 물건이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290264
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 400290264,
					"content": "엠버 너, 지금 그런 얘긴 할 필요 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290265
					],
					"speakerTitle": "유라"
				},
				{
					"id": 400290265,
					"content": "#와, 이제 우리가 만든 눈사람도 안 녹겠다. {NICKNAME}, 너무 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290266,
						400290267
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290266,
					"content": "고마워요, 유라 씨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290268
					]
				},
				{
					"id": 400290268,
					"content": "…사양 말고 받아둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290269
					],
					"speakerTitle": "유라"
				},
				{
					"id": 400290269,
					"content": "그럼 나랑 엠버는 해야 할 일이 있어서 이만 가볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290270
					],
					"speakerTitle": "유라"
				},
				{
					"id": 400290270,
					"content": "응! 나중에 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290271
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290271,
					"content": "가버렸네. 요즘 다들 각자 할 일들이 많나 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290272
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290272,
					"content": "아! 그러고 보니 설산에 이렇게 오래 있었는데, 알베도한테 열매를 주스로 만들 수 있는 기계 만들어달란 얘기는 못 했네… 윽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290273
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290273,
					"content": "아니면 데마로우스한테 다시 부탁해보자. 제일 만만하잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400290267,
					"content": "소중히 간직할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290268
					]
				},
				{
					"id": 400290255,
					"content": "다들 요세프 씨와 요엘 때문에 기뻐하고 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290256
					]
				},
				{
					"id": 400290208,
					"content": "무사하면 된 거죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290209
					]
				},
				{
					"id": 400290203,
					"content": "어른 버전의 요엘이야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290204
					]
				}
			]
		},
