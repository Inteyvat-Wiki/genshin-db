			"dialogs": [
				{
					"id": 740760101,
					"content": "이제 남은 건 여기뿐이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760102
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740760102,
					"content": "다행히 입구가 아직 봉인돼 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760103
					],
					"speakerTitle": "안"
				},
				{
					"id": 740760103,
					"content": "그 야코브라는 사람도 아직 이곳의 수수께끼는 풀지 못했나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760104
					],
					"speakerTitle": "안"
				},
				{
					"id": 740760104,
					"content": "아니면 답을 찾았지만, 그걸 제출할 수는 없었거나요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760105
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740760105,
					"content": "어디 보자… 이전의 답이 「그림자」랑 「생명」, 「사랑」이었던가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740760106,
					"content": "지금까지의 패턴을 기반으로 논리 모듈을 사용해서 추론해 본 결과, 이번 비석의 내용은 다음과 같습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760107
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 740760107,
					"content": "「절대 떨어지지 않았으니」…「찰나에 태어나 늘 서로 맞지 않아도, 기나긴 잠을 함께 했으며」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760108
					],
					"speakerTitle": "시모어"
				},
				{
					"id": 740760108,
					"content": "마지막 구절은——「그것은 원초의 한 방울이로다」네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740760109,
					"content": "캐터필러랑 시모어는 이 수수께끼의 답이 뭔지 알겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
