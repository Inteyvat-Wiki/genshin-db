	"talks": [
		{
			"id": 7214301,
			"completionStepIds": [
				7214301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7214301",
							"2"
						],
						"stepId": 7214301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_BILLBOARD_ONLY",
			"trigger": {
				"objectNames": [
					"츠유코"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721430101,
					"content": "안녕하세요. 외부에서 온 손님 여러분, 전 츠유코에요. 산호궁의 무녀죠. 손님 여러분은 제 부탁을 들어주러 오신 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430102
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430102,
					"content": "부탁이요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430103
					]
				},
				{
					"id": 721430103,
					"content": "초면에 바로 부탁이라니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721430104,
					"content": "하하, 이거 실례했네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430105
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430105,
					"content": "소원을 빌고 점괘를 봤는데, 모든 고민과 걱정거리는 귀인의 도움으로 원만하게 해결될 것이라고 나왔거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430106
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430106,
					"content": "저를 도와주러 오신 운명 속의 귀인님이시죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430107,
						721430109
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430107,
					"content": "다 핑계 아니에요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430108
					]
				},
				{
					"id": 721430108,
					"content": "어쩔 수 없지만, 츠유코 말을 먼저 들어보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721430111,
					"content": "정말 감사해요. 그럼 잠깐 소개를 해드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430112
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430112,
					"content": "산호궁을 마주 보고 있는 심연은 「연하궁」의 입구입니다. 전해져 내려오는 이야기에 따르면 와타츠미인의 기원이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430113
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430113,
					"content": "고대에는 「와타츠미 미인」이라는 말이 있을 정도로 피부가 희어, 7개의 죄악에 필적할 수 있었다고 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430114
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430114,
					"content": "이런 말이 나온 이유는 선조들이 연하궁에서 햇빛을 못 받고 지냈기 때문이죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430115,
						721430116
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430115,
					"content": "큼… 크흠!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430117
					]
				},
				{
					"id": 721430117,
					"content": "아, 죄송해요. 평소에 여행자들에게 와타츠미섬을 소개하던 습관이 그만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430118
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430118,
					"content": "와타츠미 신과 선조를 기념하기 위해 제물을 연하궁에 바쳐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430119
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430119,
					"content": "저희 선조는 「백야국」을 기원으로 만들어졌다는 말이 있었습니다. 문헌 기록에 다이니치 미코시의 미세한 빛에 의존하여 심해 용의 자손의 발톱 아래서 목숨을 부지하며 살았어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430120
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430120,
					"content": "수천 년 전 와타츠미 신이 강림하여 심해 용의 자손을 무찌르고 저희를 땅 위로 데리고 와 산호궁을 지었고 와타츠미섬을 새로운 고향으로 삼았죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430121
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430121,
					"content": "바다 아래 있는 백야국은 그때부터 연하궁이라 불리고 해수면 위에 있는 산호궁과 적대적으로 변했습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430122
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430122,
					"content": "당연히… 전설은 전설일 뿐, 나루카미인의 마신 정복론에 관해서는 막부군과 같거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430123
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430123,
					"content": "희생과 기억의 주제는 우리를 지키는 무기이기도 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430124
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430124,
					"content": "그게 무녀가 할 말이야…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721430125,
					"content": "무녀가 하면 안 되는 말이긴 하지만, 사람을 위해 살아간다면 비판의 눈으로 역사와 민속을 바라봐야 한다고 생각해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430126
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430126,
					"content": "죄송해요, 주제를 또 벗어났네요… 지금 와타츠미섬의 「성토」에 문제가 가면 갈수록 심해지고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430127
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430127,
					"content": "「성토」… 가 뭐죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430128
					]
				},
				{
					"id": 721430128,
					"content": "사람의 마음과 물은 아래로 흐르듯, 와타츠미섬의 「영」도 연하궁의 심연으로 흡수되고 있어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430129
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430129,
					"content": "그래서 현재 토지는 점점 백화하고 있어요. 다른 말로 성토화하고 있다고 하죠. 이렇게 가다가는 와타츠미섬은 언젠가는 달빛처럼 창백한 사막으로 변할 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430130,
						721430132
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430130,
					"content": "듣기만 해도 무섭네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430131
					]
				},
				{
					"id": 721430131,
					"content": "그런가요? 저는 어르신들이 무서운 소문을 일부러 내는 것 같다고 생각 들어요. 일리 있는 말도 있지만 논리적인 근거가 부족하니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430133
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430133,
					"content": "전통적인 방법으로는, 몇백 년에 한 번씩 영맥 유동이 안정적일 때 연하궁과 산호궁 연결을 막고 있는 결계를 끊어야 해요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430134
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430134,
					"content": "연하궁에 잠입해 신이 남겨주신 심해 용의 자손을 억누르고 있는 산호 옥빛 가지를 가지고 나와야 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430135
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430135,
					"content": "옥빛 가지를 빌려 와타츠미 어령 제사를 지내면 가라앉은 「영」을 돌려받아 성토의 침식을 억제할 수 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430136
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430136,
					"content": "심해 용의 자손을 억누르고 있는 물건이 빠진다면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430137
					]
				},
				{
					"id": 721430137,
					"content": "예리한 통찰력을 가지고 있군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430138
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430138,
					"content": "진압용 산호 옥빛 가지는 엄청 많아요. 하지만 계속 이렇게 가면 심해룡 후계자도 억눌림에서 벗어나 와타츠미 영토를 침입할 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430139
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430139,
					"content": "그러니 부탁드려요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430140,
						721430142
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430140,
					"content": "산호 옥빛 가지를 가지고 오라고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430141
					]
				},
				{
					"id": 721430141,
					"content": "#{NICKNAME}, 물건 하난 잘 찾지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430144
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721430144,
					"content": "아직 더 있긴 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430145
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430145,
					"content": "여기서 더 도와줘야 한다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430146
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721430146,
					"content": "나중에 일은… 음… 나중에 다시 생각하죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430147
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430147,
					"content": "…점괘 보고 정하려고 하는 거지?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430148
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721430148,
					"content": "흠흠, 저 대신 와타츠미섬의 「오상암」 방문해 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430149
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430149,
					"content": "오상암은 산호궁과 연하궁을 차단하고 있는 결계의 5개의 접점 지역이에요. 산호궁의 초대 신들과 와타츠미 신들이 같이 만들었답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430150
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430150,
					"content": "만약 결계를 풀고 연하궁에 들어가려면 이 5곳의 접점 지역의 봉인을 풀어야 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430151
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430151,
					"content": "많이 위험해 보이는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430152
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721430152,
					"content": "확실히 함부로 봉인을 풀기에는 위험해요. 많은 시간이 흘렀고 저희 세대에는 안에 어떤 위험이 있는지 아무도 모르고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430153
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430153,
					"content": "믿을만한 기록도 적고, 대부분이 구체적이지 못해 참고할 가치가 없는 고대 문서들뿐이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430154
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430154,
					"content": "심해 용의 자손이 안에서 기다리고 있을 수도 있고 아니면 그보다 더 위험한 마물이 봉인이 풀리기를 기다리고 있다던가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430155
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430155,
					"content": "과거의 폐허가 산호와 해면동물에 파묻혀 못 찾을 수도 있을지도 모르죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430156
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430156,
					"content": "아니면 제일 최악의 경우는——안에 아무것도 없고 바닷물만 있을 수도 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430157
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430157,
					"content": "어쨌든 여기서 상상만 하고 있는다고 알 수 있는 것들이 아니에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430158
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430158,
					"content": "네 말이 맞는 것 같기는 한데, 어차피 힘쓰는 건 우리잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430159
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721430159,
					"content": "그래도 연하궁엔 오랫동안 아무도 방문하지 않았으니, 선조들이 남겨둔 보물들이 아직 남아 있을 수도 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430160
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430160,
					"content": "#보… 흠흠. {NICKNAME}, 현지인을 도와 문제를 해결하는 건 경험 쌓는 데 큰 도움이 될 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430161
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721430161,
					"content": "…츠유코 님 말은 정말 잘하네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430162
					]
				},
				{
					"id": 721430162,
					"content": "감사합니다, 그럼 본론부터 말씀드릴게요. 오상암은 다섯 곳으로 나뉘어 있습니다, 각각 「눈」, 「이빨」, 「지느러미」, 「꼬리」 그리고 「심장」입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430163
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430163,
					"content": "우선 <color=#00E1FFFF>서쪽 섬</color>에는 「눈」이라 불리는 봉인이 있습니다. 바로 저기죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430164
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430164,
					"content": "그럼 직접 가면 되잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430165
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721430165,
					"content": "헤헤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430166
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430166,
					"content": "난 진지하다구!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430167
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721430167,
					"content": "봉인이 오랫동안 되어 봉인을 해제하는 의식을 대부분 잘 모르고 있어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430168
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430168,
					"content": "그리고 아라히토가미 무녀님은 상태로 봐서는 다섯 겹의 봉인을 해제할 시간이 없을 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430169
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430169,
					"content": "외부인에게 이런 말을 전해야 한다니 정말 부끄러운 일이네요. 아, 지금 의지할 수 있는 사람은 아는 것도 많고 능력 있는 외국인뿐이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430170
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430170,
					"content": "만약 일이 잘못되어도, 외부인이라는 신분으로…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430171
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430171,
					"content": "희생양이 되라는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430172
					]
				},
				{
					"id": 721430172,
					"content": "아뇨… 「무지는 무죄」라는 말이 있잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430173
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430173,
					"content": "만약 <color=#00E1FFFF>산호궁</color>을 기준으로 하면, 「이빨」은 <color=#00E1FFFF>서북쪽</color>에 있고,「지느러미」는 <color=#00E1FFFF>북쪽</color>에 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430174
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430174,
					"content": "마지막으로, <color=#00E1FFFF>동쪽의 여울</color>이 「꼬리」예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430175
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430175,
					"content": "봉인된 4곳 근처에는 비석이 세워져 있어요. 의식 관련된 문구가 기록되어있지만… 시간이 오래되어 글자가 희미해졌죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430176
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430176,
					"content": "봉인된 이 4곳의 「어령 진주」를 획득하면 5번째 「심장」의 봉인을 해제할 수 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430177
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430177,
					"content": "복잡할 것 같은데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430178
					]
				},
				{
					"id": 721430178,
					"content": "괜찮아요, 모르겠으면 산호궁에서 저를 찾으세요. 다시 천천히 설명해드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430179
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430179,
					"content": "마지막으로… 길을 막고 개인적인 부탁을 해서 정말 실례가 많았어요. 다시 한번 죄송하다는 말을 전해드리고 싶어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430180
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430180,
					"content": "어쨌든 이번 일은 와타츠미섬에 있어서 매우 중대한 사안이랍니다… 만약 도와주실 수 있다면 산호궁은 이 은혜를 절대 잊지 않겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721430142,
					"content": "심해 용의 자손을 처치하라고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430143
					]
				},
				{
					"id": 721430143,
					"content": "#{NICKNAME}, 싸움 하난 잘하지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430144
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721430132,
					"content": "그럼 어떻게 해결해야 하죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430133
					]
				},
				{
					"id": 721430116,
					"content": "부탁에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430117
					]
				},
				{
					"id": 721430109,
					"content": "문제없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430110
					]
				},
				{
					"id": 721430110,
					"content": "부탁하는 이유도 정말 가지각색이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430111
					],
					"speakerTitle": "페이몬"
				}
			]
		},
