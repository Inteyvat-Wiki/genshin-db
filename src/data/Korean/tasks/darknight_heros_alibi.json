			"dialogs": [
				{
					"id": 4660901,
					"content": "오, 돌아왔군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660902
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4660902,
					"content": "소개하지, 이분은 와이너리의 양조사…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660903
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4660903,
					"content": "서리꽃이 이렇게나 많다니! 「그것」의 효과가 벌써부터 기대되는군!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660904
					],
					"speakerTitle": "코너"
				},
				{
					"id": 4660904,
					"content": "정제 설비가 이런 순도를 감당할 수 있을지, 문제가 생기진 않겠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660905
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4660905,
					"content": "오… 오오오—— 사장님이 직접 저한테 말을 거시다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660906
					],
					"speakerTitle": "코너"
				},
				{
					"id": 4660906,
					"content": "안심하십시오, 주인어른! 어르신의 뜻이라면 이 목숨까지도 기꺼이 바치겠습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660907
					],
					"speakerTitle": "코너"
				},
				{
					"id": 4660907,
					"content": "목숨까지 걸 일은 아닌 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660908
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4660908,
					"content": "먼저 얘기하고 계세요, 전 지금 바로 시작하겠습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660909
					],
					"speakerTitle": "코너"
				},
				{
					"id": 4660909,
					"content": "저 많은 서리꽃을 어디에 쓰려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660910
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4660910,
					"content": "사실…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660911
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4660911,
					"content": "며칠 전 다운 와이너리에서 새로운 술을 개발할 때, 상쾌한 맛을 내기 위해 서리꽃을 넣어 봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660912
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4660912,
					"content": "정제를 거친 서리꽃은 확실히 강한 매력이 있더군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660913
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4660913,
					"content": "엄청 잘 팔리나 보네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660914
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4660914,
					"content": "아니, 손님이 아닌 슬라임을 이끄는 매력이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660915
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4660915,
					"content": "원소의 힘을 흡수하면서 사는 이런 생물들은 그 유혹을 이겨낼 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660916
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4660916,
					"content": "그래서, 이 점을 잘 이용하기만 하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660917
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4660917,
					"content": "쿵! 덜컹덜컹… 쾅쾅!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660918
					],
					"speakerTitle": "코너"
				},
				{
					"id": 4660918,
					"content": "으아! 방금 무슨 소리지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660919
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4660919,
					"content": "너… 너무 추워! 다, 다이루크… 어르신, 정, 정제를… 다… 끝냈습니다, 하지만 설, 설비가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660920
					],
					"speakerTitle": "코너"
				},
				{
					"id": 4660920,
					"content": "수고하셨어요. 설비는 신경 쓰지 마세요, 집사에게 새로 주문하도록 할 테니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660921
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4660921,
					"content": "역시 부자야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660922
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4660922,
					"content": "바로 이거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660923
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4660923,
					"content": "정제한 후의 서리꽃——「원소 미끼」라고 부르자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660924
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 4660924,
					"content": "대단해, 이 엄청난 원소의 기운! 근데 어떻게 효과를 증명하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660925
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4660925,
					"content": "저쪽 바닥에 조금 뿌려봐, 조심해…. 아주 조금만 뿌려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "다이루크"
				}
			]
		},
