			"dialogs": [
				{
					"id": 105010201,
					"content": "안녕, 무슨 일로 왔니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010202
					],
					"speakerTitle": "회안"
				},
				{
					"id": 105010202,
					"content": "여기 주방을 좀 빌리고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010203,
						105010204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105010203,
					"content": "친구가 특별한 음식을 먹고 싶어 해서요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				},
				{
					"id": 105010205,
					"content": "그렇구나, 그럼 그렇게 하렴. 식자재만 준비해 온다면 주방은 얼마든지 빌려줄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010206
					],
					"speakerTitle": "회안"
				},
				{
					"id": 105010206,
					"content": "하나 물어보고 싶은 게 있는데, 요리 좀 잘하니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010207,
						105010209
					],
					"speakerTitle": "회안"
				},
				{
					"id": 105010207,
					"content": "당연하죠, 뭘 만들어도 「꿀맛」이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010208
					]
				},
				{
					"id": 105010208,
					"content": "하하, 역시 비범하구먼. 사실 제안할 게 있는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "회안"
				},
				{
					"id": 105010211,
					"content": "옷을 보아하니 외국인 같은데, 리월에 왔으니 리월 요리를 해보는 건 어떤가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010212
					],
					"speakerTitle": "회안"
				},
				{
					"id": 105010212,
					"content": "내게 「골든크랩」 레시피가 있어. 아주 전통적인 「월 요리」지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010213
					],
					"speakerTitle": "회안"
				},
				{
					"id": 105010213,
					"content": "밀가루를 입힌 게를 기름에 튀긴 뒤, 생강, 마늘과 함께 볶아 접시에 담으면 게가 마치 황금 위에 누워있는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010214
					],
					"speakerTitle": "회안"
				},
				{
					"id": 105010214,
					"content": "고… 골든크랩!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010215,
						105010216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105010215,
					"content": "번거로울 것 같네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010217,
					"content": "#골든크랩! {NICKNAME}, 골든크랩!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010218,
						105010219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105010218,
					"content": "그래그래. 알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010220,
					"content": "헤헤, 그럼 당장 가서 해 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105010221,
					"content": "넌 요리에 소질이 있으니까 분명 한 번에 배울 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105010219,
					"content": "…널 위해 배우는 셈 칠게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010216,
					"content": "모나를 위해 요리까지 배우는 건 좀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010209,
					"content": "그럭저럭이요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010210
					]
				},
				{
					"id": 105010210,
					"content": "하하, 정말 겸손하네. 사실 제안할 게 있는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "회안"
				},
				{
					"id": 105010204,
					"content": "친구가 제가 직접 만든 음식을 먹고 싶어 해서요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				}
			]
		},
