			"dialogs": [
				{
					"id": 105010401,
					"content": "드디어 몬드야! 휴, 피곤하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010402
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105010402,
					"content": "위대하고 심오한 지식을 얻는 건 역시 쉽지 않아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010403
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105010403,
					"content": "난 별로 안 피곤해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105010404,
					"content": "넌 날아다니니까 그렇지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010405
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105010405,
					"content": "흠, 점성술사도 그리 대단하진 않나 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105010406,
					"content": "그건 네가 점성술에 대해 비현실적인 환상을 갖고 있어서 그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010407
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105010407,
					"content": "너희도 쉬었다 가려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010408
					],
					"speakerTitle": "테일러"
				},
				{
					"id": 105010408,
					"content": "넌 누구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105010409,
					"content": "아, 우리 형제는 모두 상인이야. 리월항에서 장사를 끝내고 막 몬드로 돌아가던 중이었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010410
					],
					"speakerTitle": "테일러"
				},
				{
					"id": 105010410,
					"content": "피곤해 보이는데 우리랑 같이 가지 않을래? 예약한 마차가 곧 올 거거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010411,
						105010413
					],
					"speakerTitle": "테일러"
				},
				{
					"id": 105010411,
					"content": "사실 좀 피곤해요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010412
					]
				},
				{
					"id": 105010413,
					"content": "공짜예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010414
					]
				},
				{
					"id": 105010412,
					"content": "하하, 그럼 같이 가자. 가면서 수다나 떨자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "테일러"
				},
				{
					"id": 105010414,
					"content": "그럼 그럼~ 어차피 가는 길인걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "테일러"
				},
				{
					"id": 105010415,
					"content": "필요 없으니까, 썩 물러가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010416
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105010416,
					"content": "어라? 무슨 문제라도…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010417
					],
					"speakerTitle": "테일러"
				},
				{
					"id": 105010417,
					"content": "꼴값 떨지 마, 이 강도야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010418
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105010418,
					"content": "만만해 보이는 사람을 골라서 차에 태운 다음 허허벌판에서 깡그리 털어가려는 거잖아, 맞지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010419
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105010419,
					"content": "너, 너 무슨 소리 하는 거야?! 호의로 말 걸어줬더니 못된 놈 취급이나 하고 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010420
					],
					"speakerTitle": "테일러"
				},
				{
					"id": 105010420,
					"content": "안 탈 거면 말아. 미친 거 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010421
					],
					"speakerTitle": "테일러"
				},
				{
					"id": 105010421,
					"content": "그럼 너희가 가지고 있는 것 중에 어떤 게 약탈한 건지, 내가 한번 맞혀 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010422
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105010422,
					"content": "인정 못하겠으면 바로 사람을 불러 물어보면 다 알게 되겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010423
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105010423,
					"content": "내 말이 틀리면 너희한테 2만 모라를 줄게. 하지만 내가 맞으면, 너희는 리월항에 가서 콩밥을 먹어야 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010424
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105010424,
					"content": "어때, 떳떳하게 장사하는 사람이라면 못 할 것도 없지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010425
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105010425,
					"content": "너, 너…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010426
					],
					"speakerTitle": "테일러"
				},
				{
					"id": 105010426,
					"content": "짜증 나는 녀석! 나 지금 엄청 화났다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427
					],
					"speakerTitle": "테일러"
				},
				{
					"id": 105010427,
					"content": "어떻게 안 건지 모르겠지만 너만 없애면 아무도 모를 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427,
						105010428
					],
					"speakerTitle": "테일러"
				},
				{
					"id": 105010428,
					"content": "모나, 조심해!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010429,
					"content": "당신들이 모나를 해치게 놔두지 않을 겁니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010430,
					"content": "걱정 마, 강도들일 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010431
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105010431,
					"content": "아까 너희가 점성술사도 「그리 대단하진 않나 보네」라고 했었지… 내가 스승의 위엄을 보여주겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "모나"
				}
			]
		},
