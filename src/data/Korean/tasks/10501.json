			"dialogs": [
				{
					"id": 105011201,
					"content": "그럼 그거 다 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011202
					]
				},
				{
					"id": 105011202,
					"content": "그, 그걸 다?! 우린 셋… 아니 두 명 반인데? 너무 많아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011203
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105011203,
					"content": "페이몬은 그렇게 세는 거 아냐! 그리고 내가 먹고 싶은 건 아직 주문도 안 했다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105011204,
					"content": "「탕수어」, 「절운고추 치킨」, 그리고 「진주비취백옥탕」!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105011205,
					"content": "알겠습니다. 그럼 이쪽 손님은 뭘 더 주문하시겠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011206
					],
					"speakerTitle": "육화"
				},
				{
					"id": 105011206,
					"content": "그, 그나저나 지금까지 주문한 거 말이야, 다 합해서 얼마야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011207
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105011207,
					"content": "음~ 2만 모라쯤 되는 것 같네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011208
					],
					"speakerTitle": "육화"
				},
				{
					"id": 105011208,
					"content": "그럼… 윽——나, 난 소면 한 그릇만 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011209
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105011209,
					"content": "알겠습니다. 소면 한 그릇 맞으시죠? 잠시만 기다려주세요. 바로 요리해드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011210
					],
					"speakerTitle": "육화"
				},
				{
					"id": 105011210,
					"content": "사실 밥 먹을 때부터 궁금했던 건데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105011211,
					"content": "모나는 왜 소면 한 그릇만 시킨 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011212
					]
				},
				{
					"id": 105011212,
					"content": "흠… 돈이 별로 없어서 그런가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105011213,
					"content": "다 들리거든! 내가 한턱내겠다고 했는데 그깟 모라 때문에 그랬을 리가 없잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011214
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105011214,
					"content": "점성술사는 별들을 연구하는 데 전념해야 해. 만약 마음이 세속적인 것의 방해를 받으면 판단력이 흐려지지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011215
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105011215,
					"content": "특히 모라로 생리적 욕구를 과도하게 충족시키는 건 저속하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011216
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105011216,
					"content": "꼬르륵——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011217
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105011217,
					"content": "…또 위험한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011218
					],
					"speakerTitle": "모나"
				},
				{
					"id": 105011218,
					"content": "그래서 우리가 주문한 음식도 안 먹었구나. 그것도 점성술사의 자존심이라는 건가? 정말 까다롭네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105011219,
					"content": "그래도 우리만 배 터지게 먹은 것 같아서 좀 그렇네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 105011220,
					"content": "내가 뭐라도 만들어 줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011221
					]
				},
				{
					"id": 105011221,
					"content": "아 참, 그러면 되겠다! 잠깐만 기다려 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
