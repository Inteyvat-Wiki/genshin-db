						710701903
					]
				},
				{
					"id": 710701903,
					"content": "난 복고파 음유시인이야, 여긴 당연히 영감을 찾으러 왔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701904
					],
