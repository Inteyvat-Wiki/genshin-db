			"trigger": {
				"objectNames": [
					"클리토퍼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701701,
					"content": "안녕! 여행은 잘 돼 가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701702
					],
					"speakerTitle": "클리토퍼"
				},
				{
					"id": 710701702,
					"content": "그럭저럭, 넌 어떻게 지내?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701703
					]
				},
				{
					"id": 710701703,
					"content": "기회를 줘서 고마워. 포탄의 기폭 장치를 성공적으로 조제한 후로, 다들 내가 여기 남아 있는 걸 받아들이게 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701704
					],
					"speakerTitle": "클리토퍼"
				},
				{
					"id": 710701704,
					"content": "위에 갈 계획은… 하하, 아직 없어! 어쨌든 보물 사냥단은 아마 안 할 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701705,
						710701706
					],
					"speakerTitle": "클리토퍼"
				},
				{
					"id": 710701705,
					"content": "아마…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				},
				{
					"id": 710701707,
					"content": "정말 안 해, 안 한다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701708
					],
					"speakerTitle": "클리토퍼"
				},
				{
					"id": 710701708,
					"content": "다음에 또 봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701709
					]
				},
				{
					"id": 710701709,
					"content": "몸 잘 챙겨!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "클리토퍼"
				},
				{
					"id": 710701706,
					"content": "진짜…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				}
			]
		},
		{
			"id": 7107018,
			"completionStepIds": [
				7107003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
