							"7107003",
							"2"
						],
						"stepId": 7107003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"헤디브"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701801,
					"content": "이 녀석… 휴… 응? 아, 안녕. 미안한데 내가 방해했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701802
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710701802,
					"content": "그럼 우리 쌤쌤인 거지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701804
					]
				},
				{
					"id": 710701804,
					"content": "됐어, 말장난은 그쯤 해. 지금 상황이 좋지 않아. 알아? 엄청 안 좋다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701805
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710701805,
					"content": "저 그 빛나는 수정석 파편 보이지? 내 추측대로라면 깊은 곳에 더 큰 수정석 조각이 있을 것 같은데… 너도 이미 예상했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701806
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710701806,
					"content": "이론상으로는 위의 큰 조각이 「복귀」하면 에너지 눈금이 안정돼야 하는데… 음, 틀림없이 그렇게 돼야 해. 하지만… 파형이 완전히 틀려… 완전히 다르다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701807,
						710701808
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710701807,
					"content": "무슨 말을 하고 있는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				},
				{
					"id": 710701809,
					"content": "공부를 안 했다고? 어쩔 수 없지… 쉽게 말해 우리가 대면하고 있는 건 두 갈래의 강력한 힘이 싸우고 있는 상황이야. 마치 맷돌에 갈리고 있는 콩처럼. 이해돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701810
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710701810,
					"content": "더 큰 시간 표준으로 따지면, 우린 위와 아래에서 오는 힘에 의해 빠르게 콩물로 갈려지고 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701811
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710701811,
					"content": "안 믿기면 두고 보라구, 그 지경이라는 모험가… 난 그것과 가까이 접촉했던 사람을 본 적이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701812
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710701812,
					"content": "오늘 피를 토했다면, 내일은 폐 조직까지 함께 토해낼 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701813
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710701813,
					"content": "우리가 도울 일은 없어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701814
					]
				},
				{
					"id": 710701814,
					"content": "너? 음… 어디 보자, 어디 보자… 시간을 좀 줘, 방법이 있을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701815
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710701815,
					"content": "하지만 현재의 급선무는 네가 탐사를 계속해서 아래에 대체 무슨 일이 일어난 건지 알아내는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701816
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710701816,
					"content": "걱정 마, 이렇게 심각한 일을 보고만 있을 수는 없으니까… 최소한 우리 탐사대에 있는 탐사원의 안전은 책임져야지, 돈 낭비는 하면 안 되거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701817
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710701817,
					"content": "내 안전도 책임져 주는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701818
					]
				},
				{
					"id": 710701818,
					"content": "음… 네 능력은 내 예상을 훨씬 벗어났어, 그건 인정할게. 그러니까… 넌 스스로를 책임질 능력이 충분할 거 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701819
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710701819,
					"content": "휴, 됐다. 엉뚱한 소리는 그만해… 너한테 사고라도 생기면 내가 책임지고 보상할게, 됐지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710701808,
					"content": "내가 알아들을 수 있는 말로 얘기해 줘",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				}
			]
		},
