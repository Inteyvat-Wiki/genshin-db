					"nextDialogs": [
						710702503
					]
				},
				{
					"id": 710702503,
					"content": "야, 백수 취급하지 말라고. 너희가 날 필요로 할 땐 엄청 바쁠지도 모르니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
