	"talks": [
		{
			"id": 7265001,
			"completionStepIds": [
				7265001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7265001",
							"2"
						],
						"stepId": 7265001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"시부카와"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726500101,
					"content": "안녕한가. 난 무예 유파 「심류」의 당주 시부카와라네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500102
					],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500102,
					"content": "외국인 여행자 같아 보이는데, 어때? 「심류」에 관심 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500103,
						726500104
					],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500103,
					"content": "「심류」…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500106
					]
				},
				{
					"id": 726500106,
					"content": "어쨌든, 이건 내가 독창적으로 고안해낸 기술이라네. 이와쿠라류, 키타인류, 그리고 외국의 「페보니우스 검술」 등 무기로 전투하는 유파와는 달리, 내 기술의 정수는 「심류」의 연마에 있지. 그리고 「심류」로 전투 기교를 연마하는 유파라네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500107
					],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500107,
					"content": "과거 외국에 있으면서 무예에 대한 연구를 할 때, 나타 사람의 「권투술」을 관찰한 적이 있었거든. 이 무예는 연습할 때 가상의 적과 싸운다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500108
					],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500108,
					"content": "「가상의 적」?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726500109,
					"content": "네 「상상 속 친구」을 때리는 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500110
					]
				},
				{
					"id": 726500110,
					"content": "그렇다네. 적의 행동을 상상해서, 그 가상에 따라 반격을 취하는 거지. 현지에서 「쉐도우 복싱」라고도 불리는 이 연습 기교는 정말 대단한 수행 방법인 거 같다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500111
					],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500111,
					"content": "그리고 「심류」는 이런 수행을 극한까지 끌어올리는 무제한 격투 유파지. 내 지도 아래 그 어떤 가상의 적도 완벽하게 재현해낼 수 있다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500112
					],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500112,
					"content": "슬라임부터 낙무자, 또는 스네즈나야에서 온 외부인 전사들까지. 심류를 정통하게 되면 전투 장면을 재현해내 무술을 연마할 수 있다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500113
					],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500113,
					"content": "말이 나와서 하는 말인데, 이 세상에서 가장 무서운 생물은 아마 「번개수정 나비」일 거라네. 이와쿠라류 전대의 에이인은 과거 내 「심류」를 빌어 인간 체형의 번개수정 나비에 도전한 적이 있었지. 그런데 단 십 초도 버티지 못했다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500114
					],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500114,
					"content": "상대뿐만 아니라, 바람의 방향, 기후, 장치, 심지어는 「지맥 이상」까지도 심류를 통해 상상해낼 수 있지. 정말 가장 실용적인 기술이라고 할 수 있다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500115
					],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500115,
					"content": "그렇게 대단한데 왜 직접 제자를 스카우트하고 있는 거죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726500116,
					"content": "내 심류는 너무… 생동하기 때문이라네. 그래서 가끔 제자들이 가상의 적과 전투할 때 현실에서 상처를 입기도 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500128
					],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500128,
					"content": "심류가 상상해낸 「검」이라 할지라도, 몸에 상처를 입힌다네. 심류 환상 「화승총」은 몸을 꿰뚫을 수도 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500117
					],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500117,
					"content": "그러다 보니, 무예에 전념하지 않는 자들은 두려움으로 심류를 떠났고, 무예에 모든 걸 쏟는 자들은 심류에 적합하지 않아 내가 다 돌려보냈다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500118,
						726500119
					],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500118,
					"content": "그렇게 대단해요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500120
					]
				},
				{
					"id": 726500120,
					"content": "그래. 자네도 심류와 퍽 인연이 있어 보이는데, 내 「심류」를 한번 시험해 보겠는가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500121,
						726500122
					],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500121,
					"content": "흥미롭군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500124
					]
				},
				{
					"id": 726500124,
					"content": "어쨌든, 관심이 있으면 앞에 있는 플랫폼을 심류의 「시합장」으로 삼게나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500125
					],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500125,
					"content": "그럼 자네에게 가장 적합한 「심류 전장」을 만들어 줄 테니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500126
					],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500126,
					"content": "다만, 조심해야 한다네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500127
					],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500127,
					"content": "「심류」는 무정하니까 말일세",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500122,
					"content": "관심 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500123
					]
				},
				{
					"id": 726500123,
					"content": "그런가, 아쉽게 됐구만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500124
					],
					"speakerTitle": "시부카와"
				},
				{
					"id": 726500119,
					"content": "그렇게 무서워요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500120
					]
				},
				{
					"id": 726500104,
					"content": "관심 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726500105
					]
				},
				{
					"id": 726500105,
					"content": "#그렇게 말하지 말게나. {F#소년}{M#소녀}, 자넨 발걸음도 날렵하고 자세도 무척 곧아. 호흡도 흠잡을 데 없지. 보아하니 자네도 「무」의 길을 걷고 있는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726500106
					],
					"speakerTitle": "시부카와"
				}
			]
		}
	]
}