					"nextDialogs": [
						200700502
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200700502,
					"content": "저번에 설산에 묻어달라고 부탁했던 꽃들 기억하세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700503
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200700503,
					"content": "하루가 지났으니 냉장 효과를 보고 싶어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700504
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200700504,
					"content": "설산에 가서 그 꽃들을 가지고 와줄 수 있어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700505,
						200700507
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200700505,
					"content": "나한테 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700506
					]
				},
				{
					"id": 200700506,
					"content": "그럼 부탁할게요. 전 여기서 기다릴 테니 서둘러주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "플로라"
				},
				{
					"id": 200700507,
					"content": "꽃을 어디다 뒀더라…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700508
					]
				},
				{
					"id": 200700508,
					"content": "기억 안 나세요? <color=#00E1FFFF>일곱신상 옆</color>과 <color=#00E1FFFF>산속의 물가</color>, 그리고 <color=#00E1FFFF>동굴 근처</color>였어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700509
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200700509,
					"content": "제가 다시 지도에 표시해드릴게요",
					"roleType": "TALK_ROLE_NPC",
