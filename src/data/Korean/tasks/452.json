			},
			"dialogs": [
				{
					"id": 4520301,
					"content": "고, 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520302
					],
					"speakerTitle": "지크프리야"
				},
				{
					"id": 4520302,
					"content": "별거 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4520303,
					"content": "늑대 무리의 위세에 츄츄족까지 제멋대로 날뛰고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520304
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520304,
					"content": "그래. 하지만 내가 볼 땐 츄츄족보다 늑대 무리가 더 날뛰고 있는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520305
					],
					"speakerTitle": "지크프리야"
				},
				{
					"id": 4520305,
					"content": "그들은… 오전에 샘물 마을을 습격했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520306
					],
					"speakerTitle": "지크프리야"
