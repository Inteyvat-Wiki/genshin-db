			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"엠버"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4520201,
					"content": "저쪽이 뭔가 소란스러워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520202
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520202,
					"content": "늑대 무리는 아니야, 츄츄족이 화물차를 습격하고 있는 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4520203,
					"content": "음… 이건 자주 있는 상황이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520204
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520204,
					"content": "잡담은 그만하고, 어서 도와주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				}
			]
		},
		{
