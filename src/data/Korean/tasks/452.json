			"trigger": {
				"objectNames": [
					"엠버"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4520101,
					"content": "#아, 페이몬과 {NICKNAME}(이)구나. 무슨 일로 날 찾는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520102
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520102,
					"content": "안녕, 엠버",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520103,
						4520124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4520103,
					"content": "엠버, 그게…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520104
					]
				},
				{
					"id": 4520104,
					"content": "엠버, 울프 영지의 남자애랑 아는 사이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4520105,
					"content": "어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520106
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520106,
					"content": "너랑 친하다는 그 사람 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4520107,
					"content": "대체 무슨 말을 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520108
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520108,
					"content": "이상하네, 늘 보던 곳에서 널 기다린다고 했는데… 설마 벌써 그를 잊은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4520109,
					"content": "페이몬 너야말로, 버섯을 잘못 먹어서 환각이 보이는 거 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520110
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520110,
					"content": "무슨 소린지 전혀 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520111
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520111,
					"content": "으어… 먹으면 안 되는 버섯이 무슨 색이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4520112,
					"content": "보라색이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520113
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520113,
					"content": "…이틀 전쯤에 먹었네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4520114,
					"content": "이게 중요한 게 아니라! 난 지금 멀쩡하다구——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4520115,
					"content": "울프 영지에서 늑대 무리와 함께 생활하는 남자애를 진짜 몰라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4520116,
					"content": "대체 무슨 말이야——이해를 못 하겠네——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520117
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520117,
					"content": "그러고 보니, 요즘 늑대에 대해서 조사 중인 게 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520118
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520118,
					"content": "「울프 영지」에서만 활동하던 늑대 무리가 요즘 들어 겁이 없어졌는지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520119
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520119,
					"content": "「주정뱅이 협곡」 근처의 운송 행렬을 습격한 모양이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520120
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520120,
					"content": "시간 있으면 조사하는 것 좀 도와줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520121,
						4520122
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520121,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520123,
					"content": "후후, 아주 듬직한데. 그럼 출발하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520122,
					"content": "당연히 해야 할 일인걸",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520124,
					"content": "안녕, 잘 지내?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520125
					]
				},
				{
					"id": 4520125,
					"content": "어, 너 되게 한가해 보이는걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520126
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520126,
					"content": "윽, 뒤에 무슨 말을 할지 너무 뻔해——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4520127,
					"content": "내가 요즘 너무 바쁜 거 있지. 정찰 기사는 책임이 막중하잖아? 어때 너도 도울래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520129
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520129,
					"content": "그 말 할 줄 알았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520130,
						4520131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4520130,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				},
				{
					"id": 4520132,
					"content": "최근 늑대 무리가 「주정뱅이 협곡」 주변의 운송 행렬을 습격하기 시작했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520133
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520133,
					"content": "늑대 무리가 위험하긴 해도 그들만의 원칙이 있다는 건 너도 알지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520134
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520134,
					"content": "몬드의 늑대가 크라운 마운틴과 울프 영지를 벗어나는 일은 거의 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520135
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520135,
					"content": "응, 생태 환경은 원시적이지만 그곳만의 독특한 규칙이 있다고 들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520136
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4520136,
					"content": "맞아. 그래서 늑대 무리가 주정뱅이 협곡까지 와서 사람들을 습격했다는 게 너무 이상해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520137
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520137,
					"content": "늑대 이야기가 나와서 말인데, 너 혹시 울프 영지에 있는 남자애랑 아는 사이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520138
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4520138,
					"content": "아니, 몬드에 그런 사람도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520139
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520139,
					"content": "엥?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520140
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4520140,
					"content": "「붉은색의 뜨거운 소녀」는 엠버가 아닌 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520141
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4520141,
					"content": "대체 무슨 말을 하는 거야? 그게 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520142
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520142,
					"content": "어쨌든 곧 주정뱅이 협곡으로 가서 조사해 볼 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520143
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520143,
					"content": "너희도 같이 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				},
				{
					"id": 4520131,
					"content": "무슨 일인데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				}
			]
		},
		{
			"id": 45202,
