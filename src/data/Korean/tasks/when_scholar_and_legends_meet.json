			},
			"dialogs": [
				{
					"id": 718220301,
					"content": "샘플 가져왔니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220302
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220302,
					"content": "여기요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220303
					]
				},
				{
					"id": 718220303,
					"content": "고생했어. 어디 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220304
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220304,
					"content": "…음, 별로 특별한 건 없네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220305
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220305,
					"content": "뭘 찾고 싶은 거죠…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220306
					]
				},
				{
					"id": 718220306,
					"content": "전설에 의하면, 「이소도천진군」은 리월항을 지키기 위해 단단한 뿔로 무너질 뻔한 천형산을 지탱했다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220307
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220307,
					"content": "「뿔」의 파편이 조금이라도 남아있을 줄 알았는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220308
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220308,
					"content": "역시 전설은 전설일 뿐인가? 아니면, 너무 오랜 시간이 지나서 흔적이 다 사라졌나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220309
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220309,
					"content": "그래도 천형산의 토양 샘플을 얻었으니 나쁘지 않지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220310
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220310,
					"content": "여행자, 난 좀 더 올라가 볼 생각인데, 혹시 같이 가줄 수 있을까? 멀리는 안 갈 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220311,
						718220312
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220311,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				},
				{
					"id": 718220313,
					"content": "이번엔… 높은 곳에서 천형산의 지형을 관찰해보고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220314
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220314,
					"content": "전설에 의하면, 「암왕제군」과 선인들이 참여한 그 대전 때문에 천형산이 무너질 뻔했다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220315
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220315,
					"content": "그렇게 격렬한 전투였다면… 지형을 관찰해서 무언가 알아낼 수 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220312,
					"content": "또 뭘 찾으려구요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220313
					]
				}
			]
		},
		{
			"id": 7182206,
			"completionStepIds": [
				7182206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182206",
							"2"
						],
						"stepId": 7182206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"소라야"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718220601,
					"content": "드디어 여기까지 왔네…. 길도 험한데 마물들까지 잔뜩 있다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220602
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220602,
					"content": "이 주변의 지형은… 별로 특별한 게 없어 보여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220603
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220603,
					"content": "응? 나무 위에 뭐가 있어. 소등이네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220604
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220604,
					"content": "소등이 왜 이런 곳에 있지? 누가 선인한테 제사라도 지내러 왔었나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220605
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220605,
					"content": "소등에 뭐라고 적혀있는지 볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220606
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220606,
					"content": "「천하가 오래도록 태평하길」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220607,
						718220608
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220607,
					"content": "아주 거창한 소원이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718220609
					]
				},
				{
					"id": 718220609,
					"content": "맞아. 근데 이 소원은… 뭐랄까, 너무 거창하지 않아? 제사도 아니고, 「소원」이라고 하기엔 애매해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220610
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220610,
					"content": "오히려 리월 전설 속에 나오는 선인들이 빌 법한 소원이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220611
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220611,
					"content": "대체 누가 소등에 이런 소원을 적었을까? 이상해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220612
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220612,
					"content": "음, 어쨌든 여기에 소등을 날리러 온 사람이 있었으니 그 선인도 기뻐하겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220613
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 718220613,
					"content": "이렇게 먼 길 같이 와줘서 고마워. 난 여기서 좀 더 연구하다 갈게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718220614
					],
					"speakerTitle": "소라야"
				},
				{
