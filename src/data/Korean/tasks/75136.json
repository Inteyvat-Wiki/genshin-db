			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-306.442,
							1277.558,
							9810.905
						],
						"pointId": 8612
					}
				]
			},
			"dialogs": [
				{
					"id": 751360101,
					"content": "후, 후아…. 겨, 겨우 살았네. 다시 단단한 땅을 밟으니 마음이 놓여…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360102,
					"content": "넌 아직도 날고 있잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360103
					]
				},
				{
					"id": 751360103,
					"content": "이봐! 땅 위에서 나는 거랑 바람에 휘날리는 거랑은 천지 차이라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360104,
					"content": "이쪽 땅은 좀 부실해 보이는데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360105
					]
				},
				{
					"id": 751360105,
					"content": "#진짜?! 거, 겁주지 마! 진짜로 땅이 꺼지면 나 혼자서는 너랑 {REALNAME[ID(2)|SHOWHOST(true)]} 둘 다 못 끌어당긴다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360106,
					"content": "끼꾸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360107
					],
					"speakerTitle": "「터키석」"
				},
				{
					"id": 751360107,
					"content": "저게 그 하늘뱀선이야? 우리가 성공했구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360108,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360109
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360109,
					"content": "배라기보단 커다란 털 뭉치 같네! 얽혀있는 게 뱀처럼 보이기도 하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360110,
					"content": "일단 저쪽으로 가는 방법을 생각해 보자. 적어도 이쪽보다는 안전할 것 같아…. 어라? 파우나는 어디로 간 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360111,
					"content": "비행 경험이 풍부하다고 들었지만, 그래도 좀 걱정되네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360112,
					"content": "바람의 방향이 틀리지 않았다면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360113
					]
				},
				{
					"id": 751360113,
					"content": "으응——그렇네. 바람의 방향이 틀리지만 않았다면 이 근처에 착륙했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360114,
					"content": "여기서 기다린다고 답이 나오는 것도 아니니까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360115
					]
				},
				{
					"id": 751360115,
					"content": "으응——그렇네. 여기서 걱정해 봤자 아무 소용없겠지. 어쩌면 지금쯤 하늘뱀선 위에서 우릴 기다리고 있을지도 모르고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360116,
					"content": "그럼 바로 가볼까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
