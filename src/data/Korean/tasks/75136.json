						],
						"pointId": 9733
					}
				]
			},
			"dialogs": [
				{
					"id": 751360201,
					"content": "이건 뭐지? 화린석이랑 비슷하게 생겼는데, 빛이 나고 불을 뿜어대네. 파우나가 가지고 있던 화린석보다 더 굉장한 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360202,
					"content": "혹시 이게 화린석의 본모습 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360203,
					"content": "앗 뜨거!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360204
					]
				},
				{
					"id": 751360204,
					"content": "#으앗, {NICKNAME}! 처음 보는 물건을 함부로 만지지 말라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360205,
					"content": "나도 모르게 그만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360206
					]
				},
				{
					"id": 751360206,
					"content": "네가 할 말은 아닌 거 같은데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360207
					]
				},
				{
					"id": 751360207,
					"content": "꺄! 꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360208,
					"content": "#응? {REALNAME[ID(2)|SHOWHOST(true)]} 너, 뭔가 짚이는 게 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360209,
					"content": "#와! 대단해, {REALNAME[ID(2)|SHOWHOST(true)]}! 드디어 활약할 기회를 찾았구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360210,
					"content": "#앞으로 뜨거운 보물을 발견하면 {REALNAME[ID(2)|SHOWHOST(true)]}에게 부탁하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360211,
					"content": "우웅, 꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360212,
					"content": "어이! 여기야, 여기!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360213
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360213,
					"content": "오! 저거 파우나 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360214,
					"content": "근데 왜 저쪽에 있는 거지? 혹시 저쪽에 착륙한 건가…? 아무튼 얼른 파우나에게 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7513603,
