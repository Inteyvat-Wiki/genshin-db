						],
						"pointId": 10150
					}
				]
			},
			"dialogs": [
				{
					"id": 751360301,
					"content": "#드디어 만났다. {NICKNAME}, 페이몬, 그리고 {REALNAME[ID(2)|SHOWHOST(true)]}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360302
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360302,
					"content": "헤헤, 파우나! 무사해서 정말 다행이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360303,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360304
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360304,
					"content": "응? 페이몬, 혹시 날 걱정한 거야? 난 꽃깃회의 에이스 모험가라고! 명줄이 엄청 질기단 말씀이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360305
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360305,
					"content": "무사해서 다행이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360306
					]
				},
				{
					"id": 751360306,
					"content": "헤헤, 네 덕분일지도 몰라. 너를 만난 이후로 행운이 따라주고 있거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360307
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360307,
					"content": "아까 구름 속에서 너희와 흩어지고 부유섬 위로 떨어지는 바람에 정신을 잃었어. 시간이 얼마나 지났는지는 몰라도 눈을 떠보니 여기였고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360308
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360308,
					"content": "어쩌다 여기로 오게 된 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360309
					]
				},
				{
					"id": 751360309,
					"content": "실은 아까 구름 속에서 너희와 흩어지고 부유섬 위로 떨어지는 바람에 정신을 잃었어. 시간이 얼마나 지났는지는 몰라도 눈을 떠보니 여기였고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360310
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360310,
					"content": "지금까지 여기저기 돌아다녀 봤지만 너희가 보이지 않아서… 난 또 너희들이…. 그나저나 너희도 명줄이 엄청 질기구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360311
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360311,
					"content": "음, 부유섬이랑 여기는 연결되지 않았는데 어떻게 온 거야? 설마 날아오기라도 한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360312,
					"content": "하하, 그건 나중에 얘기하자. 우리가 성공했어! 여기가 바로 우리가 찾던 하늘뱀선이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360313
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360313,
					"content": "흠——하지만 전설과 달리 보물이 널려있는 것 같지는 않은데? 혹시 누가 보물을 다 가져가 버린 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360314,
					"content": "그 하늘뱀선의 보물 이야기는 아마 부족의 이야기꾼들이 지어낸 이야기일 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360315
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360315,
					"content": "뭐? 진짜? 그럼 우리 헛걸음한 거잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360316,
					"content": "보물은 거짓이지만 우리가 찾는 「복원의 옥」까지 거짓이라는 법은 없지. 아직 포기하기엔 너무 일러",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360317
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360317,
					"content": "뭣보다, 저길 좀 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360318
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360318,
					"content": "안에 뭔가 있는 것 같지 않아? 너희가 통솔의 심장에 있는 공에서 화린석을 찾은 것처럼 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360319
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360319,
					"content": "모험가로서의 내 경험에 따르면, 저 안에 우리가 찾는 「복원의 옥」이 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360320
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360320,
					"content": "그럼 위쪽으로 올라가서 저걸 부숴버리면 되겠네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360321
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360321,
					"content": "그거라면 나한테 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360322
					]
				},
				{
					"id": 751360322,
					"content": "잠깐만, 그렇게 간단한 일이 아니야. 나도 아까 해봤지만 힘으로 부술 수 있는 게 아니더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360323
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360323,
					"content": "그렇게 간단할 것 같지는 않은데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360324
					]
				},
				{
					"id": 751360324,
					"content": "맞아. 힘으로 열 수 없는 거 같더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360325
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360325,
					"content": "모험가로서의 내 경험에 따르면, 화린석을 얻었을 때처럼 이 근처에 분명 어떤 장치가 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360326
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360326,
					"content": "그 장치는 아마도… 바로 우리 눈앞에 있는 이거겠지. 전에 봤던 근원의 불 제단과 똑같네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360327
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360327,
					"content": "이런 우연이… 아니, 이건 우연이 아니야. 분명 어떤 단서일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360328
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360328,
					"content": "그렇다면 화린석을…. 아, 지금 남아있는 화린석이 없구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360329
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360329,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} 등 뒤에 있어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360330
					]
				},
				{
					"id": 751360330,
					"content": "아, 맞다. 아까 오는 길에 하나 주웠었지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360331
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360331,
					"content": "역시나! 혹시 「모험가의 열쇠」라는 법칙 들어본 적 있어? 모험의 마지막 단계에 필요한 중요한 아이템은 반드시 모험의 시작 단계에서 얻게 된다는 뜻이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360332
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360332,
					"content": "또 지어낸 말 아냐? 뭣보다 이건 방금 얻은 거라구! 흠, 확실히 화린석처럼 생기기는 했지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360333
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360333,
					"content": "…아니, 반짝거리고 불을 뿜어대는 것만 빼면 완전 화린석이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360334
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360334,
					"content": "정말이네. 역시 페이몬이야. 네가 아니었으면 전혀 몰랐을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360335
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360335,
					"content": "네가 둔감한 거야! 아무튼 네 말대로 이런 돌을 수집하면 되는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360336
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360336,
					"content": "응, 이런 화염석이라면 하늘뱀선에 총 네 개가 있어. 저쪽 부유섬에 하나 있을 거야.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360337
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360337,
					"content": "음… 잠깐, 넌 어떻게 그렇게 자세히 알고 있는 거야? 마치 전에 여기 왔던 것처럼…. 이건 모험가로서의 경험만으로는 설명이 안 되는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360338
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360338,
					"content": "음… 모험가로서의 직감이라고 해야 하려나? 이유는 모르겠지만, 제단을 딱 보자마자 사용하는 방법이 떠올랐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360339
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360339,
					"content": "그리고 난 너희와 만나기 전부터 조사해 뒀거든. 우수한 모험가라면 충분한 사전 조사를 빼먹어서는 안 되니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360340
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360340,
					"content": "그렇군요, 한 수 배웠네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360341
					]
				},
				{
					"id": 751360341,
					"content": "#와, {NICKNAME} 넌 지금까지 사전 조사도 없이 다녔던 거야? 강하면 그런 것도 가능하구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360342
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360342,
					"content": "전 늘 맨땅에 헤딩하는데요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360343
					]
				},
				{
					"id": 751360343,
					"content": "#{NICKNAME}, 너는 예외로 해야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360344
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360344,
					"content": "#그나저나 저쪽으로 가려면 어떻게 해야 하지? {NICKNAME}도 힘들 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360345
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360345,
					"content": "헤헤, 아까 어떻게 여기까지 온 거냐고 물었었지? 지금 보여줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360346
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360346,
					"content": "어때? 이 장치를 이용하면 부유섬 사이를 자유롭게 넘어 다닐 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360347
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360347,
					"content": "화염석을 찾는 건 너희에게 맡길게. 부유섬으로 갔다가 돌아오지 못하면 나를 부르도록 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360348
					],
					"speakerTitle": "파우나"
				},
				{
					"id": 751360348,
					"content": "#좋아, 그럼 화염석 회수 작업은 {REALNAME[ID(2)|SHOWHOST(true)]}에게 맡기고 우린 출발하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360349
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751360349,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
