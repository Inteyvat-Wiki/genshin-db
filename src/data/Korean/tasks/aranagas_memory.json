					"nextDialogs": [
						730560504,
						730560506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730560504,
					"content": "페이몬도 갑자기 입담이 늘었네!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560505
					]
				},
				{
					"id": 730560505,
					"content": "그게 무슨 뜻이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730560508,
					"content": "음… 샘플은 이 정도면 충분할 거야. 나와 함께 와줘서 고맙네. 더 할 일이 없으니 이만 떠나지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560509
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560509,
					"content": "하하, 아주 좋아…. 이 샘플만 있으면 「죽음의 땅」의 비밀과 약점에 관한 연구를 진행할 수 있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560510
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560510,
					"content": "자네들도 수고 많았네. 왔던 길 그대로 돌아가지…. 두 사람한테 줄 게 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560511
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560511,
					"content": "오예! 선물이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560512
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730560512,
					"content": "하하, 그렇다고 볼 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560506,
					"content": "좋아!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560507
					]
				},
				{
					"id": 730560507,
					"content": "뭔지 모르겠지만 어쨌든 좋아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "페이몬"
				}
