						],
						"stepId": 7305601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"하이얌",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560101,
					"content": "하하, 재밌네… 참 재밌어. 다시 살아났어, 이 숲이 다시 살아났다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560102
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560102,
					"content": "안녕! 할아버지, 혹시 길을 잃은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730560103,
					"content": "음…? 길을 잃어…? 아, 나한테 말하는 거니? 하하, 그게 아니란다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560104
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560104,
					"content": "반갑네, 꼬마친구들. 나는 생론파의 다스터 기아스·하이얌일세. 허허… 그냥 하이얌이라고 부르게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560105
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560105,
					"content": "오… 안녕, 하이얌 할아버지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730560106,
					"content": "그게 아니지. 혀끝은 바닥에 붙이고… 하—— 그다음 입술을 양쪽으로 최대한 끌어올린 채… 이—— 그리고 입을 자연스럽게 오므리면서… 얌——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560107
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560107,
					"content": "윽… 하——이——얌——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730560108,
					"content": "그래! 아주 좋아! 금발의 아이야, 너도 한번 해보렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560109,
						730560111
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560109,
					"content": "하——이——얌——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560110
					]
				},
				{
					"id": 730560110,
					"content": "그래, 아주 좋아! 백발인 아이보다 훨씬 낫구나! 역시 나한테 음성학 선생이 될 자질이 있을 줄 알았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560113,
					"content": "그보다 하이얌 할아버지, 길을 잃은 것도 아니면서 여기서 뭐 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730560114,
					"content": "뭐 하냐고? 하하… 난 삼림학자거든. 나 같은 삼림학자들에게 숲은 집이나 마찬가지야. 집에서 길을 잃을 리가 없잖니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560115
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560115,
					"content": "그렇구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730560116,
					"content": "이 숲은 「죽음의 땅」의 영향을 크게 받은 곳이야. 지난 30년간 식물의 종류와 수량 모두 급격히 줄어들었지. 반면 유해종인 버섯류는 점점 늘어났어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560117
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560117,
					"content": "그런데 최근 갑자기 「죽음의 땅」이 사라졌어. 오래전에 사라졌던 식물들도 다시 자라났고 버섯류의 번식 속도도 많이 줄어들었더구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560118
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560118,
					"content": "이런 상황은 나도 60년 전에 딱 한 번밖에 못 봤단다…. 나의 미숙한 추측을 검증해 보기 위해 직접 여기로 와본 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560119
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560119,
					"content": "그렇구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560120,
						730560123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730560120,
					"content": "검증 방법에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560121
					]
				},
				{
					"id": 730560121,
					"content": "하하, 60년 전에 있었던 일이라 제대로 기억을 못 할 수도 있어. 하지만 난 「죽음의 땅」이 사라진 게, 분명 그 일과 관련이 있다고 믿는단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560122
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560122,
					"content": "내 추측을 검증하기 위해 난 동굴로 들어가서 샘플을 채취할 예정이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560126,
					"content": "그렇구나… 동굴 안에 있던 「마라나」는 사라졌지만 그래도 위험한데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730560127,
					"content": "하하, 그 정도는 괜찮단다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560128
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560128,
					"content": "음, 잠깐… 방금 뭐라고? 동굴 안에…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560129,
						730560130
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560129,
					"content": "「마라나」요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560131,
					"content": "음… 좀 더 생각해 보는 게 좋겠구나. 어쩌면 정말 너희들의 도움이 필요할지도 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560132
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560132,
					"content": "흥, 내가 뭐랬어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730560133,
					"content": "하하, 내가 실례를 범했군…. 아직 너희들의 이름도 묻지 않았구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560134
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560134,
					"content": "#{NICKNAME}(이)라고 불러주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560135
					]
				},
				{
					"id": 730560135,
					"content": "난 페이몬이야! 페——이——몬——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560136
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730560136,
					"content": "페이몬? 페이몬… 하하, 참 재밌는 이름이구나… 이런 이름을 가진 인간이나… 정령은 처음 보는걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560137
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560137,
					"content": "아 미안, 미안. 기분을 상하게 하려는 건 아니었단다…. 이 꼬마한테 하는 말이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560138
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560138,
					"content": "꼬마라니! 충분히 기분 나쁘거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730560139,
					"content": "그래, 잡담은 그만하지. 두 「자반스」는 날 따라오게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560140
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560140,
					"content": "「자반스」…? 그게 무슨 뜻이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560141
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730560141,
					"content": "아주 오래전 내 고향에서 사용하던 언어란다. 「용감한 젊은이」라는 뜻이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560142
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560142,
					"content": "더 정확히 말하면 「거대한 악을 목격했을 때 가만히 있지 않고, 불의와 마주했을 때 피하지 않는 젊은이」라는 뜻이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560143
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560143,
					"content": "크흠, 딱 우리를 지칭하는 말이군!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560144
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730560144,
					"content": "그래? 자신감이 넘치는군. 하하, 그럼 날 따라오게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560145
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560145,
					"content": "엥, 하이얌 할아버지. 그 다리로 정말 우리를 따라올 수 있겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560146
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730560146,
					"content": "하하… 이삼십 년 동안 숲을 탐사한 이 늙은이의 체력을 무시하지 말게! 난 신경 쓰지 말고 먼저 가게나. 금방 따라잡을 테니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560130,
					"content": "「죽음의 땅」이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560123,
					"content": "저희가 도와드릴까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560124
					]
				},
				{
					"id": 730560124,
					"content": "하하… 고마워라, 참 착한 아이들이구나. 내가 나이가 들어서 몸은 조금 불편해도 정신은 아직 쌩쌩하니 걱정 말렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560125
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560125,
					"content": "난 숲을 기쁘게 만드는 방법을 알고 있단다. 그러니 숲도 나를 도와줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "하이얌"
				},
				{
					"id": 730560111,
					"content": "하이얌 씨, 여기서 뭐 하고 계셨어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560112
					]
				},
				{
					"id": 730560112,
					"content": "음… 발음 속도가 너무 빨라. 급하지 않으니까 천천히 내뱉으면 괜찮을 게야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "하이얌"
				}
			]
		},
