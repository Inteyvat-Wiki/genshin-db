			"dialogs": [
				{
					"id": 726750101,
					"content": "설산이랑 달라, 안 추워. 눈도 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750102
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726750102,
					"content": "여긴 고운각이야! 전설에 따르면 암왕제군이 그… 그… 머리가 엄청 많은 뱀, 이름이 뭐였더라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750103,
						726750104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726750103,
					"content": "소용돌이의 마신?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				},
				{
					"id": 726750105,
					"content": "아, 맞아! 소용돌이의 마신 오셀! 그때 이곳에서 암왕제군이 석창으로 오셀을 쓰러뜨리고 제압했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726750106,
					"content": "와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750107
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726750107,
					"content": "헤헤, 대단하지? 근데 우리도 오셀이랑 싸운 적 있어! 응광의 군옥각에서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726750108,
					"content": "금색 수정 나비!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750109
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726750109,
					"content": "수정 나비에 감탄한 거야? 사람이 말을 하면 좀 들어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726750110,
					"content": "이나즈마의 수정 나비랑은 다르니까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750111
					]
				},
				{
					"id": 726750111,
					"content": "보라색이 아닌 수정 나비는 처음 봐서 그렇겠지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750112
					]
				},
				{
					"id": 726750112,
					"content": "#음… 그렇긴 하네. 정말 못 말린다니까. {NICKNAME}, 수정 나비 한 마리 잡아서 길법사한테 주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750113,
						726750115,
						726750117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726750113,
					"content": "왜 네가 안 잡고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750114
					]
				},
				{
					"id": 726750114,
					"content": "네가 나보다 훨씬 더 잘 잡잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726750118,
					"content": "할 수 있긴 한데, 수정 코어만 잡을 수 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750119
					]
				},
				{
					"id": 726750119,
					"content": "대단해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 726750115,
					"content": "날 수 있는 건 너잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750116
					]
				},
				{
					"id": 726750116,
					"content": "하지만 수정 나비 잡는 건 나보다 네가 더 잘하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726750118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726750117,
					"content": "알았어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750118
					]
				},
				{
					"id": 726750104,
					"content": "오셀?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726750105
					]
				}
			]
