			"dialogs": [
				{
					"id": 722641401,
					"content": "낭! 수행 재밌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641402,
						722641412
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722641402,
					"content": "재밌으면 됐어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641403
					]
				},
				{
					"id": 722641403,
					"content": "노란 털 엄청 강해. 펑펑, 하니까 크고 동그란 게 사라졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641404
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722641404,
					"content": "평소에도 꾸준히 단련하고 있거든",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641405
					]
				},
				{
					"id": 722641405,
					"content": "낭! 노란 털처럼 강해지고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641406
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722641406,
					"content": "그러면 수행 해야 해. 수행, 수행, 강해져, 튼튼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641407
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722641407,
					"content": "길법사는 강해지면 뭘 하고 싶어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641408
					]
				},
				{
					"id": 722641408,
					"content": "교부 코반한테 복수할 거야, 낭하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641409
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722641409,
					"content": "이오로이를 돌이 아니게 만들 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722641410
					],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722641410,
					"content": "힘내, 수행은 우리한테 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641411
					]
				},
				{
					"id": 722641411,
					"content": "낭!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「길법사」"
				},
				{
					"id": 722641412,
					"content": "즐거우면 됐어, 나중에 봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722641413
					]
				},
				{
					"id": 722641413,
					"content": "오예!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「길법사」"
				}
			]
