			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"소라야"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220090101,
					"content": "보물 사냥단 놈들이 점점 더 날뛰고 있군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090102
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220090102,
					"content": "무슨 일이에요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090103
					]
				},
				{
					"id": 220090103,
					"content": "참, 너한테 부탁할 게 있어. 저번에 네가 말한 「보아」라는 사람 말이야, 확인해보니까 확실히 보물 사냥단 사람이더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090104
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220090104,
					"content": "단독 행동을 하는 이유는… 아마 보물을 독차지하려거나 나중에 올 대원들을 위해 선발대로 온 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090105
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220090105,
					"content": "혼자 행동하면 정체를 숨기기도 편하고. 너처럼 경험이 풍부한 여행자도 속였잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090106
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220090106,
					"content": "이대로 놔두면, 다른 보물 사냥단 단원들이 주위의 유물들을 싹 쓸어가게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090107
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220090107,
					"content": "그러니까 네가 그들을 막아줬으면 좋겠어. 아예 저지할 순 없더라도 그들이 훔쳐 간 유물들을 좀 되찾아 줬으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090108,
						220090110,
						220090117
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220090108,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090109
					]
				},
				{
					"id": 220090109,
					"content": "그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소라야"
				},
				{
					"id": 220090110,
					"content": "그들이 어딨는지 어떻게 알아요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090111
					]
				},
				{
					"id": 220090111,
					"content": "흥, 내 예상이 맞다면, 그 보물 사냥단 놈들은 아마 계속 날 미행하고 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090112
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220090112,
					"content": "내가 발굴해낸 걸 「날로 먹는」 것은 성에 안 차나봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090113
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220090113,
					"content": "내가 머물렀던 곳은 전부 파내서 뭐라도 건지고 싶은 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090114
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220090114,
					"content": "그러니까 좀 생각해보면 그들이 어딨는지 알 수 있어. 난 학자니까 머리로 추리하고 판단하는 건 문제 없는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090115
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220090115,
					"content": "몸으로 싸우는 건 너처럼 경험이 풍부한 여행자에게 맡길게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090116
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220090116,
					"content": "부탁할게. 어서 그 유물들을 되찾아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소라야"
				},
				{
					"id": 220090117,
					"content": "지금 당장 그들을 끝장내고 올게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090118
					]
				},
				{
					"id": 220090118,
					"content": "잠깐. 그들을 「저지」하라고는 했지만, 지금 당장 그 보아라는 자와 결판을 내라는 건 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090119
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220090119,
					"content": "보물 사냥단은 뿔뿔이 흩어져 있어서 행방을 찾기가 매우 어려워. 그들과 이렇게 접촉이 있는 건 좀처럼 얻기 힘든 좋은 기회야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090120
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220090120,
					"content": "그들은 분명 무슨 꿍꿍이가 있어서 이 「귀리 평원」에 나타난 거야. 네가 보아 옆에 있으면, 그들의 계획을 알아낼 수 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090121
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220090121,
					"content": "그러니까 네 정체를 아직 들켜선 안 돼. 난 네 실력을 믿어. 잘 은폐된 공격 포인트를 찾아서… 얼른 끝내버려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090122
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 220090122,
					"content": "유물만 챙기면 바로 자리를 떠야 해, 알았지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소라야"
				}
			]
		},
