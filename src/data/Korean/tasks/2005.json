				"points": []
			},
			"dialogs": [
				{
					"id": 20050501,
					"content": "구호 식량? 나는 그런 거 들어 본 적도 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050502
					],
					"speakerTitle": "쿠로사와 쿄노스케"
				},
				{
					"id": 20050502,
					"content": "어디서 그딴 소문을 듣고 날 협박하는 건지, 웃기는 일이군. 혼자 꿀꺽할 구호 식량 같은 게 있으면 내가 지금처럼 가난하겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050503
					],
					"speakerTitle": "쿠로사와 쿄노스케"
				},
				{
					"id": 20050503,
					"content": "지금 내 가족들도 다 굶어 죽게 생겼는데…. 별일 없으면 비켜, 난 할 일이 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050504
					],
					"speakerTitle": "쿠로사와 쿄노스케"
				},
				{
					"id": 20050504,
					"content": "신의 눈을 잃었다고 들었어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050505
					]
				},
				{
					"id": 20050505,
					"content": "맞아, 막부군은 내가 안수령에 불만을 품고 업무 태도가 태만하다고 하더군. 내가 라이덴 쇼군께 죄송해야 한다면서 내 신의 눈을 가져갔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050506
					],
					"speakerTitle": "쿠로사와 쿄노스케"
				},
				{
					"id": 20050506,
					"content": "엥? 넌 안수령의 집행자잖아. 근데 왜 안수령에 불만을 품었던 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20050507,
					"content": "그건… 솔직히, 나도 기억이 잘 안 나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050508
					],
					"speakerTitle": "쿠로사와 쿄노스케"
				},
				{
					"id": 20050508,
					"content": "전엔 매달 어떤 일을 했던 거 같은데, 지금은 전혀 그럴 마음이 없어졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050509
					],
					"speakerTitle": "쿠로사와 쿄노스케"
				},
				{
					"id": 20050509,
					"content": "기억이 안 날 뿐 아니라, 뭔가 찜찜한 느낌도 들어…. 꼭 누가 나한테 빚이라도 진 것처럼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050510
					],
					"speakerTitle": "쿠로사와 쿄노스케"
				},
				{
					"id": 20050510,
					"content": "「구호 식량」과 관련 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050511
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20050511,
					"content": "구호 식량을 꿀꺽한 적 없다니까! 말했잖아, 만약 구호 식량이 있었다면 지금처럼 힘들게 살 필요도 없겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050512
					],
					"speakerTitle": "쿠로사와 쿄노스케"
				},
				{
					"id": 20050512,
					"content": "게다가 우리 집은 방금 보물 사냥단에게 약탈당했다고…. 참, 방금까지도 보물 사냥단을 쫓던 중이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050513
					],
					"speakerTitle": "쿠로사와 쿄노스케"
				},
				{
					"id": 20050513,
					"content": "못 믿겠으면 너희가 가서 보물 사냥단을 해치운 다음 물어봐, 우리 집에 「구호 식량」이란 게 있었는지 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050514
					],
					"speakerTitle": "쿠로사와 쿄노스케"
				},
				{
					"id": 20050514,
					"content": "음… 거짓말 같진 않은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050515
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20050515,
					"content": "그래도 확실하진 않으니까… 보물 사냥단 사람한테 한번 물어보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050516
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20050516,
					"content": "보물 사냥단이 남긴 흔적을 따라가다 보면 찾을 수 있을 거야. 멀리 가기 전에 빨리 쫓아가자",
					"roleType": "TALK_ROLE_NPC",
