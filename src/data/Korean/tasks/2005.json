				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050201,
					"content": "젠장… 내 돈, 그건 우리가 개고생하면서 훔쳐 온 건데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050202
					],
					"speakerTitle": "켄"
				},
				{
					"id": 20050202,
					"content": "형님, 뭐라도 좀 해보세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050203
					],
					"speakerTitle": "켄"
				},
				{
					"id": 20050203,
					"content": "큼큼, 음… 실력이 나쁘지 않군. 보물 사냥단에 들어올 생각 없나? 같이 크게 한탕 해보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050204,
						20050205
					],
					"speakerTitle": "타다오"
				},
				{
					"id": 20050204,
					"content": "쿠로사와 씨의 일부터 알려줘요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				},
				{
					"id": 20050206,
					"content": "쿠로사와? 아아… 생각났다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050207
					],
					"speakerTitle": "타다오"
				},
				{
					"id": 20050207,
					"content": "그자가 보내서 온 놈들인가? 재수도 더럽게 없군. 그 집에 들르는 게 아니었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050208
					],
					"speakerTitle": "타다오"
				},
				{
					"id": 20050208,
					"content": "쿠로사와 집 어땠어? 식량이 많았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20050209,
					"content": "식량? 없었어, 집안도 난장판이었고… 정교한 상자 하나가 있긴 했는데, 아마 거기에 보물이 들어 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050210
					],
					"speakerTitle": "타다오"
				},
				{
					"id": 20050210,
					"content": "누가 볼까 무서워서 원래는 돌아가서 열어보려고 했는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050211
					],
					"speakerTitle": "타다오"
				},
				{
					"id": 20050211,
					"content": "근데 어차피 붙잡혔으니까, 그냥 이 상자를 가져가고 우릴 용서해 줘, 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050212
					],
					"speakerTitle": "타다오"
				},
				{
					"id": 20050212,
					"content": "그래도 양심은 있네. 빨리 열어봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20050213,
					"content": "아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050214
					],
					"speakerTitle": "켄"
				},
				{
					"id": 20050214,
					"content": "이건!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050215
					],
					"speakerTitle": "타다오"
				},
				{
					"id": 20050215,
					"content": "차, 차용증?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050216
					],
					"speakerTitle": "고우"
				},
				{
					"id": 20050216,
					"content": "게다가 엄청 많아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20050217,
					"content": "잡화점 아오이 씨한테 빌린 거 같은데, 와… 대체 얼마를 빚진 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20050218,
					"content": "대체 어떻게 된 거지…. 잡화점에 가서 물어보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20050219,
					"content": "너희는 이제 가! 우리한테 또 안 걸리게 조심하라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 20050220,
					"content": "네! 네! 감사합니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050221
					],
					"speakerTitle": "켄"
				},
				{
					"id": 20050221,
					"content": "차용증으로 값을 치른 거니까… 결국 우리가 돈을 번 거 아닐까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050222
					],
					"speakerTitle": "고우"
				},
				{
					"id": 20050222,
					"content": "빨리 가기나 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타다오"
				},
				{
					"id": 20050205,
					"content": "쿠로사와 씨의 집을 약탈했다면서요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				}
			]
		},
