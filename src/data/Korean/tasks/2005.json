			"dialogs": [
				{
					"id": 20050301,
					"content": "「99 잡화점」엔 없는 게 없답니다. 손님, 뭘 찾으세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050302
