				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"이브"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170201,
					"content": "탐욕스러운 녀석 같으니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170203
					],
					"speakerTitle": "이브"
				},
				{
					"id": 240170203,
					"content": "잠수복은 어떻게 됐어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170204
					]
				},
				{
					"id": 240170204,
					"content": "아, 너였구나. 오늘의 가장 큰 행운은 널 만났다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170205
					],
					"speakerTitle": "이브"
				},
				{
					"id": 240170205,
					"content": "그거 알아? 골드만이 새로운 방법으로 우릴 괴롭히기 시작했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170206
					],
					"speakerTitle": "이브"
				},
				{
					"id": 240170206,
					"content": "우리가 하루에 얼마나 건져낼 수 있는지를 따져보기 위해 글쎄 계산에 능한 사람을 고용했더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170222
					],
					"speakerTitle": "이브"
				},
				{
					"id": 240170222,
					"content": "그러고는 「계산 결과」에 따라 일정량의 물건을 건져내라고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170207
					],
					"speakerTitle": "이브"
				},
				{
					"id": 240170207,
					"content": "우리도 지치거나 다칠 때가 있고, 배고프거나 기운이 안 날 때도 있는 거잖아. 매일 같은 양을 건져내는 건 무린데… 골드만은 그런 것 따윈 전혀 개의치 않더라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170223
					],
					"speakerTitle": "이브"
				},
				{
					"id": 240170223,
					"content": "「계산 결과」만큼 물건을 건져내지 못하면 욕을 퍼부으며 급여를 깎았지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170208
					],
					"speakerTitle": "이브"
				},
				{
					"id": 240170208,
					"content": "하지만 그게 계산을 위해 고용된 피나단 씨 잘못은 아니야. 그분은 동정심이 넘치는 좋은 사람이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170209
					],
					"speakerTitle": "이브"
				},
				{
					"id": 240170209,
					"content": "피나단 씨는 작업량을 계산하기 위해 우리에게 구체적인 작업 내용을 물어봤어. 그러다 어느 날은 계산을 마치더니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170224
					],
					"speakerTitle": "이브"
				},
				{
					"id": 240170224,
					"content": "갑자기 벌떡 일어나서 골드만의 거처로 뛰어가 냅다 소리를 질렀지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170210
					],
					"speakerTitle": "이브"
				},
				{
					"id": 240170210,
					"content": "「…너무하시네요. 작업자들은 기계가 아니라 사람이라고요!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170211
					],
					"speakerTitle": "이브"
				},
				{
					"id": 240170211,
					"content": "…골드만의 부하들에 의해 내동댕이쳐진 피나단 씨는 물웅덩이에 쓰러졌고, 우리가 그를 일으켜 세웠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170212
					],
					"speakerTitle": "이브"
				},
				{
					"id": 240170212,
					"content": "피나단 씨는 울면서 우리에게 사과했지만 우린 그를 탓하지 않았어. 우리처럼 골드만에게 당한 피해자일 뿐이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170213
					],
					"speakerTitle": "이브"
				},
				{
					"id": 240170213,
					"content": "피나단 씨는 어떻게든 우리의 권리를 되찾을 방법을 찾겠다고 했지만… 우리는 한마음으로 그가 다시는 이 진흙탕으로 돌아오지 않기를 바랐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170214,
						240170215
