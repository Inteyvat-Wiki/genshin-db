						221120203
					]
				},
				{
					"id": 221120203,
					"content": "지하에 놔뒀으니까 쉽게 찾을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120204
					],
					"speakerTitle": "회안"
				},
				{
					"id": 221120204,
					"content": "사람이 떨어지면 안 되니까 난 여기서 지키고 있을게, 네가 가서 찾아봐",
