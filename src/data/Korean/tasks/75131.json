			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310301,
					"content": "생, 생물 화염비!? 설마 불이 살아있는 것처럼 머리 위로 쏟아져 내린다고? 으악, 나타의 화산은 정말 끔찍하네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751310302,
					"content": "#{NICKNAME}, 나도 조금 궁금해졌어. 헤헤, 우리 앞으로 가서 탐색해 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7513104,
			"completionStepIds": [
				7513102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513102",
							"2"
						],
						"stepId": 7513102,
						"stateName": "QUEST_STATE_UNFINISHED"
