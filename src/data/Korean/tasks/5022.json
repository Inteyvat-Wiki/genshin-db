					}
				]
			},
			"dialogs": [
				{
					"id": 50220701,
					"content": "(빛의 벽을 지나는 순간, 몸이 마치 얼어붙는 것 같았어)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220702
					]
				},
				{
					"id": 50220702,
					"content": "(밤의 신의 가호도 여기까진 닿지 못하는 것 같아. 차가움과 어둠이 오관을 파고들고, 귓가엔 오로지 지치고 고통스러운 탄식뿐이야)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220703
					]
				},
				{
					"id": 50220703,
					"content": "(저 사람들은 얼마나 오래 걸은 걸까, 또 얼마나 더 걸어야 하는 걸까…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220704
					]
				},
				{
					"id": 50220704,
					"content": "(어, 저 사람은…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220705
					]
				},
				{
					"id": 50220705,
					"content": "고향은 아득하고, 전화는 타오르는구나. 우리는 최후의 피까지 모두 흘렸다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220706
					],
					"speakerTitle": "「카피타노」"
				},
				{
					"id": 50220706,
					"content": "조금만 더 기다려 다오, 전사들이여…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220707
					],
					"speakerTitle": "「카피타노」"
				},
				{
					"id": 50220707,
					"content": "(어째서 「카피타노」가 여기에? 무슨 말을 하는 거지…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220708
					]
				},
				{
					"id": 50220708,
					"content": "언젠가 반드시, 너희를 약속한 곳으로 데려가마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「카피타노」"
				}
