			"dialogs": [
				{
					"id": 50220401,
					"content": "(여긴 어디지? 설마… 밤의 신의 나라인가?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220402
					]
				},
				{
					"id": 50220402,
					"content": "(근데 내가 왜 여기 있지? 방금까지 분명… 윽…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220403
					]
				},
				{
					"id": 50220403,
					"content": "(어지러워서 머리가 제대로 안 돌아가. 일단 주변을 둘러보자)",
					"roleType": "TALK_ROLE_PLAYER",
