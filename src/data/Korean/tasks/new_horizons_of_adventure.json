			"dialogs": [
				{
					"id": 221110101,
					"content": "새로운 의뢰에 대해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110102
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 221110102,
					"content": "모험가, 안녕. 몬드의 수많은 사람들이 네 공을 알고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110103
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 221110103,
					"content": "이런 추세로 계속 노력하다 보면 분명히 위대한 모험가가 될 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110104,
						221110107
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 221110104,
					"content": "무슨 일 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110105
					]
				},
				{
					"id": 221110105,
					"content": "만약 위대한 모험가가 되고 싶다면 익숙한 지역에서만 모험하면 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110106
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 221110106,
					"content": "모험 경험이 많으니까 새로운 지역을 탐색해보는 건 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 221110110,
					"content": "이 편지 받아. 이걸 리월항의 캐서린 아가씨에게 전해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110111,
						221110113
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 221110111,
					"content": "리월항의… 캐서린?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110112
					]
				},
				{
					"id": 221110112,
					"content": "맞아. 엄청 쉽게 찾을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 221110115,
					"content": "이 편지가 있다면 그녀도 나처럼 다양한 모험 활동을 위한 최고의 서비스를 제공할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110116
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 221110116,
					"content": "만약 몬드성으로 다시 돌아온다면 내가 서비스를 제공할 테니까, 걱정 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110117
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 221110117,
					"content": "맞다! 이 편지를 함부로 뜯지 마. 뜯다가 뭘 하나라도 잃어버린다면 큰일이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110118
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 221110118,
					"content": "별과 심연을 향해! 앞으로 나가봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐서린"
				},
				{
					"id": 221110113,
					"content": "그럼 이제부터 당신을 「몬드성의 캐서린」이라고 불러야 하나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110114
					]
				},
				{
					"id": 221110114,
					"content": "네가 모험하기 편한 호칭으로 부르면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 221110107,
					"content": "그냥 몬드에서…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110108
					]
				},
				{
					"id": 221110108,
					"content": "너도 지금까진 몬드 주변에서만 모험을 진행했잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110109
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 221110109,
					"content": "그래도 너라면 금방 외부 세상으로 나아갈 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "캐서린"
				}
			]
		},
