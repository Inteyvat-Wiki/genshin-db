			"dialogs": [
				{
					"id": 401730301,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730302
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730302,
					"content": "(노… 놓쳐 버렸잖아, 체면 다 구기게시리…. 방금 전까지 자신만만하게 굴었는데, 으으! 내 이미지 어떡해…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730303
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730303,
					"content": "(타니나카라는 놈, 도망치는 데 일가견이 있네. 뭔가 적당한 변명을 생각해 두지 않으면…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730304
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730304,
					"content": "시틀라리! 그 타니나카라는 녀석은 잡았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401730305,
					"content": "동굴에 할머니 혼자 있는 걸 보면 놓쳤나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730306
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401730306,
					"content": "…내가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730307
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730307,
					"content": "일단은 그냥 놔줬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730308
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730308,
					"content": "대신 녀석한테 표식을 남겨뒀으니까, 근처에 나타나면 바로 추적할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730309
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730309,
					"content": "동굴에서 나가는 척하고 숨어 있다가, 독 안에 든 쥐를 잡으려던 거였구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730310
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401730310,
					"content": "아! 처음 올로룬을 잡을 때처럼 말이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401730311,
					"content": "근데 시틀라리, 어떻게 타니나카가 올 줄 알았던 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401730312,
					"content": "미끼를 던졌거든. 잿더미 바다의 지도와 활의 조각을 일부러 책상 위에 놔뒀지. 그게 타니나카의 목적일 수 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730313
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730313,
					"content": "아니나 다를까, 우리가 떠난 지 얼마 안 돼서 내가 남겨둔 함정이 발동했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730314
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730314,
					"content": "뭐어? 정말로 동굴에 함정이 있었던 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401730315,
					"content": "물론이지, 너희 둘은 자동으로 무시하도록 설정했을 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730316
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730316,
					"content": "봐, 내 말이 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730317
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401730317,
					"content": "타니나카 씨, 정말 나를 이용한 거였군요…. 잿더미 바다의 정보가 목적이었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730318
					],
					"speakerTitle": "레이라"
				},
				{
					"id": 401730318,
					"content": "그래. 난 처음부터 녀석이 왜 조각을 야영지에 남겼는지 의아했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730319
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730319,
					"content": "그러다 잿더미 바다의 위치를 알아냈을 때, 그 조각이 미끼였다는 걸 눈치챘지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730320
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730320,
					"content": "녀석은 레이라에게 문제가 생기면 부족의 누군가가 반드시 도우러 오리라는 걸 알고 있었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730321
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730321,
					"content": "앗! 녀석도 낚시를 하고 있었구나! 진짜 능력이 있는 사람이 그 조각을 영력 투시하도록!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730322
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401730322,
					"content": "맞아, 그리고 그 낚인 사람이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730323
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730323,
					"content": "미안해, 나구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730324
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401730324,
					"content": "그리고 할머니도",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730325
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401730325,
					"content": "이 자식! 내가 너 때문에 진짜!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730326
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730326,
					"content": "어쨌든, 이 타니나카란 놈은 꽤 교활하게 위험을 최소화하는 방법을 취한 셈이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730327
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401730327,
					"content": "그러게, 직접 시틀라리를 찾아왔으면 1분도 안 돼서 들통났을 텐데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730328
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401730328,
					"content": "그나저나 시틀라리, 왜 그 녀석을 놓아준 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730329
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401730329,
					"content": "크흠… 여긴 내가 전력을 다하기엔 불편하기도 하고, 녀석도 도망치는 데 선수라 억지로 잡으려다간 문제가 생길 수 있었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730330
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730330,
					"content": "내가 장소를 잘못 택해서인가…. 미안해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730331
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401730331,
					"content": "레이라를 구하기 위해 영력이 풍부한 지역을 찾다가, 미친 현자의 영역에 오게 됐거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730332
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401730332,
					"content": "미친 현자?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730333
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401730333,
					"content": "맞아, 바로 저 벽 뒤에 있는 녀석인데, 깨기라도 하면 더 문제라 그냥 포기할 수밖에 없었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730334
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730334,
					"content": "그래도 좋은 소식을 알려주자면, 지도와 조각을 다시 되찾았어. 이 할머니도 그리 호락호락하진 않다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730335
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730335,
					"content": "다행이다! 그 녀석도 자기 몸 하나 빼내는 게 고작이었나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730336
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401730336,
					"content": "음… 근데 나쁜 소식도 있어. 아마 그 녀석은 이미 지도를 봤을 거야. 잿더미 바다가 사라진 위치가 딱히 비밀은 아니지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730337
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730337,
					"content": "휴, 걱정이네. 그 녀석이 무슨 나쁜 짓이라도 하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730338
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401730338,
					"content": "내가 추적하면 되니까 너무 걱정 안 해도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730339
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730339,
					"content": "#그리고 레이라, 너만 괜찮다면 이 지도와 조각을 {NICKNAME}에게 주고 싶어. {NICKNAME}의 여정에 도움이 될지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730340
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730340,
					"content": "#물론이죠! 무조건 찬성이에요! 당연히 {NICKNAME}한테 줘야죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730341
					],
					"speakerTitle": "레이라"
				},
				{
					"id": 401730341,
					"content": "진짜 그래도 돼?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730342
					]
				},
				{
					"id": 401730342,
					"content": "우린 어차피 이거에 관심도 없어. 이게 가리키는 곳이 정말 잿더미 바다라면, 너 같은 모험가에겐 놓치고 싶지 않은 곳일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730343
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730343,
					"content": "이건 흑요석 할머니의 감이라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730344
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730344,
					"content": "저기, 흑요석 할머니, 하나 더 물어보고 싶은 게 있는데요. 전 아직도 영적 무능자인가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730345
					],
					"speakerTitle": "레이라"
				},
				{
					"id": 401730345,
					"content": "무슨 바보 같은 질문이야? 이 할머니의 환영술을 눈치챘잖아? 일부러 허점을 보이긴 했지만, 영적 무능자가 알아챌 수준은 절대 아니었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730346
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730346,
					"content": "올로룬, 나중에 시간 되면 이 녀석 좀 제대로 가르쳐줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730347
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730347,
					"content": "얼마나 배울 수 있을지는, 레이라, 너한테 달렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730348
					],
					"speakerTitle": "시틀라리"
				},
				{
					"id": 401730348,
					"content": "잘 됐다. 역시 인생이란 참 신기해. 앞으로 나아가다 보면, 비료를 만나게 될지도 모르니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730349
					],
					"speakerTitle": "올로룬"
				},
				{
					"id": 401730349,
					"content": "정말 기뻐, 레이라. 앞으로 같이 힘내자. 우리 모두 예쁜 양배추가 되면 좋겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "올로룬"
				}
			]
		},
