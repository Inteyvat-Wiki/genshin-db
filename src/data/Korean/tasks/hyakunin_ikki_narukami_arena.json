			"dialogs": [
				{
					"id": 727270201,
					"content": "도착했어, 바로 여기야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270202
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 727270202,
					"content": "규칙은 언제나와 같아. 이 수상해 보이는 문만 통과하면 결투장으로 갈 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270203,
						727270204
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 727270203,
					"content": "…언제 봐도 수상하네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270207
					]
				},
				{
					"id": 727270207,
					"content": "아무튼 이번에도 나는 네 멋진 모습을 기록할 거고, 또 목이 쉬도록 응원할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270208,
						727270209
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 727270208,
					"content": "좋아요. 벌써 몸이 근질거리네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270210
					]
				},
				{
					"id": 727270210,
					"content": "자, 이번에도 너의 빛나는 검무를 보여줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 727270209,
					"content": "역시 귀찮은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270210
					]
				},
				{
					"id": 727270204,
					"content": "「백 명의 봉기」 규칙은요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727270205
					]
				},
				{
					"id": 727270205,
					"content": "규칙은 저번과 비슷해. 싸움에 굶주린 티바트의 마물과 모험가, 무사들이 무대 위에서 마음껏 무예를 겨루게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270206
					],
					"speakerTitle": "카야부키 잇케이"
				},
				{
					"id": 727270206,
					"content": "물론 저번처럼 뜻이 맞는 동료나 전우와 함께 참가해도 돼. 「백 명」의 봉기니까 사람이 많으면 많을수록 좋겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727270207
					],
					"speakerTitle": "카야부키 잇케이"
				}
			]
		}
	]
