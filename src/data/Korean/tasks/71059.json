				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590603,
					"content": "엇… 그 휘장은… 그 우인단 녀석이 남긴 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590601
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710590601,
					"content": "윽… 그림자도 안 보이네. 돌아가서 어떻게 얘기하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710590602,
					"content": "응, 별다른 방법이 없네. 일단 돌아갈까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7105913,
			"completionStepIds": [
				7105909
			],
