			"dialogs": [
				{
					"id": 710590301,
					"content": "돌아왔구나, 여기 너희한테 나눠줄 불의 물이 조금 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590302
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590302,
					"content": "하하… 같이 마시자는 얘긴 아니야. 부상을 입었을 경우, 불의 물은 상처를 소독하는 용도로도 쓰이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590303
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590303,
					"content": "어때? 뭐 좀 찾았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590304
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590304,
					"content": "이것들을 찾았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
