			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"카타리나",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590101,
					"content": "왔구나! 편하게 앉아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590102
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590102,
					"content": "미안, 전에는 너흴 급하게 보내느라 부탁이 뭔지 제대로 설명도 못 했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590103,
						710590104
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590103,
					"content": "괜찮으니까 얘기해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590107
					]
				},
				{
					"id": 710590107,
					"content": "걱정 마, 나쁜 일은 시키지 않을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590108,
						710590109
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590108,
					"content": "그럼 말해 봐요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590113
					]
				},
				{
					"id": 710590113,
					"content": "사실은… 우리 콜리야… 우리 팀원 니콜라이랑 흩어졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590114
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590114,
					"content": "그래서… 그가 남긴 단서를 찾아달라고 부탁하고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590115
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590115,
					"content": "그가 아직 살아 있다면, 데리고 나한테 와 줘. 혹시 이 세상에 없다 해도… 내게 알려주길 바라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590116
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590116,
					"content": "이런 일을 부탁해서 미안해…. 하지만 도와줬으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590117
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590117,
					"content": "그런 부탁이었구나… 난 또 우리한테 나쁜 짓이라도 시키려는 건 줄 알았지! 예를 들면 천암군 파괴공작 같은 거 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710590118,
					"content": "천암군… 왜? 천암군을 적으로 돌리는 건 우인단한테도 좋을 게 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590119
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590119,
					"content": "그게 무슨 뜻이에요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590120
					]
				},
				{
					"id": 710590120,
					"content": "오히려 내가 묻고 싶은 말이야…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590121
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590121,
					"content": "잠깐… 알겠다…. 우인단이 지상에서 리월과 분쟁이 난거야…? 그럼 보급이 끊긴 것도 설명이 되네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590122
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590122,
					"content": "젠장… 위에서 대체 무슨 일이 벌어진 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590123,
						710590124
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590123,
					"content": "말하자면 긴데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590125,
					"content": "흥… 그건 나중에 얘기하자고. 전쟁은 그런 거지… 적과 아군은 상황에 따라 순식간에 변하기도 해. 그게 우인단이 처해 있는 환경이고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590126
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590126,
					"content": "하지만 지금은… 적어도 지금만큼은, 오직 콜리야한테만 관심이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590127
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590127,
					"content": "우리가 철수하던 도중, 콜리야는 팀과 흩어졌어…. 그리고 콜리야를 찾으러 온 나까지 다른 사람들과 흩어지게 됐고. 휴, 정말 부끄러운 일이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590128
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590128,
					"content": "콜리야가 마지막으로 나타난 장소는… 지도에 표시해 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590129
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590129,
					"content": "그곳에서 우리와 헤어졌어. 콜리야는 추적하는 적을 따돌리고 있었거든…. 그는 훌륭한 전사야. 난 콜리야가 그렇게 허무하게 죽지 않았을 거라 믿고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590130
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590130,
					"content": "콜리야가 그곳에 단서를 남겼길… 그러길 바라야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590124,
					"content": "분쟁은 우인단에서 먼저 일으켰어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590109,
					"content": "우인단에 방해가 되는 일은 부탁하지 않겠죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590110
					]
				},
				{
					"id": 710590110,
					"content": "맞아, 우리가 하는 좋은 일이 너희 같은 나쁜 놈들한테는 나쁜 일이잖아. 우릴 막지 말라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710590111,
					"content": "좋은 일… 나쁜 일… 내가 너희를 막는다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590112
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590112,
					"content": "휴… 성가신 녀석들 같으니, 내 말 좀 끝까지 들어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590113
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710590104,
					"content": "괜찮아요, 우리도 아직 부탁을 들어주겠다고 하진 않았으니까요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590105
					]
				},
				{
					"id": 710590105,
					"content": "맞아, 너희는 우인단이잖아! 나쁜 일이라도 시키면 우린 절대 안 할 거라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710590106,
					"content": "푸흡… 일리 있는 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590107
					],
					"speakerTitle": "카타리나"
				}
			]
		},
		{
			"id": 7105902,
