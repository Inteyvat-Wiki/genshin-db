			"dialogs": [
				{
					"id": 710580601,
					"content": "쉬고 싶어, 상처가 아파서…. 미안",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580602
					],
					"speakerTitle": "카타리나"
				},
				{
					"id": 710580602,
					"content": "볼일이 있다면 다음에 다시 찾아와 줘…. 마침 나도 너희한테 부탁할 일이 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카타리나"
				}
			]
		},
		{
			"id": 7105901,
			"completionStepIds": [
				7105901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
