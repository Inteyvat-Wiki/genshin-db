			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730980401,
					"content": "음… 어디 보자… 새로운 보물지도가 또 나타난 거 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730980402,
					"content": "「곤란에 처한 아란나라를 도와주자」며?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980403
					]
				},
				{
					"id": 730980403,
					"content": "#크흠! 맞아, 이번에도 집주인을 찾지 못했으니 정말 걱정되네! 그러니까 {NICKNAME}, 그림 속에 표시된 장소로 가봐야 할 거 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730980404,
					"content": "그 장소에 가서 표시된 곳을 살펴보면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980405,
						730980407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730980405,
					"content": "더 많은 보물을 찾을 수 있다고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980406
					]
				},
				{
					"id": 730980406,
					"content": "그렇지! 아, 아니야! 도움이 필요한 아란나라를 찾으러 가는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730980409,
					"content": "음… 이 「우편함」이라는 거 정말 신기한 거 같아. 나중에 새로운 그림이 더 전송될 수 있으니 기억해 둬야겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730980407,
					"content": "「곤란에 처한 아란나라」를 찾게?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980408
					]
				},
				{
					"id": 730980408,
					"content": "응! 게다가 보물을 찾을 수도 있잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
