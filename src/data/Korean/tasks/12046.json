				]
			},
			"dialogs": [
				{
					"id": 120460301,
					"content": "오늘 고기잡이를 나가서 큰 그물을 던지다가, 실수로 놓쳐서 잃어버렸어. 뭐, 아무렴 어때, 하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460302
					],
					"speakerTitle": "우미히코"
				},
				{
					"id": 120460302,
					"content": "나도 한 건 망쳤어. 근데 지금 생각해 보면, 범죄자 몇 명 놓친 게 뭐 대수인가 싶군, 하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460303
					],
					"speakerTitle": "스스키다"
				},
				{
					"id": 120460303,
					"content": "야, 거기 둘! 너희 악몽 때문에 시온이랑 무라사키가 얼마나 힘들어했는지 알아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460304,
					"content": "꼬맹이가 화가 많이 났구만. 재미있어, 하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460305
					],
					"speakerTitle": "스스키다"
				},
				{
					"id": 120460305,
					"content": "그러게 말이야, 하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460306
					],
					"speakerTitle": "우미히코"
				},
				{
					"id": 120460306,
					"content": "이게 무슨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460307,
					"content": "왜 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460308
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460308,
					"content": "저 둘 뭔가 이상해. 내가 이렇게까지 험하게 말해도 전혀 화를 안 내잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460309,
					"content": "…내가 얘기해 볼게. 두 분, 어젯밤에 아이사 대중탕에서 꿈의 조율을 받은 거 기억하시죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460310
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460310,
					"content": "그랬나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460311
					],
					"speakerTitle": "우미히코"
				},
				{
					"id": 120460311,
					"content": "그런 일이 있었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460312
					],
					"speakerTitle": "스스키다"
				},
				{
					"id": 120460312,
					"content": "무슨… 그럼 최근에 악몽을 꾼 적은요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460313
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460313,
					"content": "뭔 소리야? 악몽을 꿀 이유가 뭐가 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460314
					],
					"speakerTitle": "스스키다"
				},
				{
					"id": 120460314,
					"content": "나도… 전혀 없어. 정상적인 사람이 악몽을 왜 꿔? 바다와 꽃을 감상하며 사는 삶이 얼마나 아름다운데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460315
					],
					"speakerTitle": "우미히코"
				},
				{
					"id": 120460315,
					"content": "어떻게 된 거지? 어젯밤 일을 완전히 잊었나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460316,
					"content": "게다가 지금 상태는 정말로 악몽을 꿀 사람처럼 안 보여…. 설마 「에무라 이치겐사이」가 사기꾼이 아니었나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460317,
					"content": "#아니, 저 심리 상태는 비정상적이야…. {NICKNAME}, 페이몬, 집중해. 조금 특별한 방법을 써야 할 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460318
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460318,
					"content": "이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460319,
					"content": "저들의 잠재의식이 표류하고 있었어. 그래서 꿈에 빠지는 거랑 비슷한 방식으로 잠재의식에 들어올 수 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460320
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460320,
					"content": "빌어먹을! 젠장! 절대 놓치지 않겠어, 절대!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460321
					],
					"speakerTitle": "스스키다",
					"speakerSubtitle": "분노한 스스키다"
				},
				{
					"id": 120460321,
					"content": "파도가 너무 세, 나는 뭍에 남을래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460322
					],
					"speakerTitle": "우미히코",
					"speakerSubtitle": "두려워하는 우미히코"
				},
				{
					"id": 120460322,
					"content": "어?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460323,
					"content": "보다시피, 두 사람의 「고민」은 사라지지 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460324
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460324,
					"content": "이쪽 스스키다 씨는 충동적이고 다혈질인 성격이야. 그 때문에 과격한 행동을 일삼아서 문제가 많았겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460325
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460325,
					"content": "또 이쪽 우미히코 씨는 한 차례 재난을 겪고 살아남은 뒤로 파도를 두려워하게 됐어. 바다에 나가기를 꺼리니 생계도 크게 기울었을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460326
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460326,
					"content": "지금 이들의 부정적인 감정은 마음속에서 강제로 격리되어 잠재의식 속을 떠돌고 있어. 그래서 겉으로는 「행복」해 보였지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460327
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460327,
					"content": "억눌린 감정은 잠재의식 속에서 계속 곪아서, 시온과 무라사키가 소화하지 못할 악몽으로 변한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460328
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460328,
					"content": "왜 이런 일이 일어난 거지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460329
					]
				},
				{
					"id": 120460329,
					"content": "「에무라 이치겐사이」는 생각만큼 단순한 인물이 아닌 것 같아. 정말로 인간의 감정에 영향을 주는 힘이 있어서, 다들 이상한 낌새를 눈치채지 못한 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460330
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460330,
					"content": "어제는 여기서 이상한 일 없었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460331
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460331,
					"content": "그때까지만 해도 둘 다 멀쩡했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460332
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460332,
					"content": "굳이 말하자면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460333
					]
				},
				{
					"id": 120460333,
					"content": "당신은 어제의 그 이상한 꿈을 미즈키에게 들려줬다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120460334
					]
				},
				{
					"id": 120460334,
					"content": "그런 일이 있었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460335
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460335,
					"content": "그땐 대수롭지 않게 생각했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460336
					]
				},
				{
					"id": 120460336,
					"content": "설마… 당장 「에무라 이치겐사이」를 찾아내야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460337
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460337,
					"content": "미즈키, 갑자기 왜 그래…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460338
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460338,
					"content": "확실해. 「에무라 이치겐사이」는 결코 평범한 인간이 아냐. 「지도」를 받은 사람들은 전부 피해자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460339
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460339,
					"content": "문제의 근원인 「에무라 이치겐사이」를 해결하지 않으면, 피해자들의 인격은 돌이킬 수 없는 손상을 입을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460340
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460340,
					"content": "그럴 수가… 그럼 이 둘에게 물어보는 수밖에 없겠어. 이봐, 너희 「에무라 이치겐사이」가 언제 오는지 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460341
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460341,
					"content": "뭘 그렇게 서둘러? 언제 오든 딱히 상관없잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460342
					],
					"speakerTitle": "스스키다"
				},
				{
					"id": 120460342,
					"content": "그럼 그럼, 언제든 좋다고, 하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460343
					],
					"speakerTitle": "우미히코"
				},
				{
					"id": 120460343,
					"content": "아잇, 정말!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460344
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460344,
					"content": "두 사람… 사실은 기억하죠? 어젯밤 일",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460345
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460345,
					"content": "당신들은 어젯밤 자신을 괴롭힌 악몽과 지금의 「행복」이 너무 동떨어져서, 언급하길 꺼리는 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460346
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460346,
					"content": "잠깐이라도 떠올리면 말로 표현할 수 없는 괴리감이 느껴지고, 마음이 찢어질 듯이 괴로우니까요. 맞죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460347
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460347,
					"content": "…그만해. 떠올리지만 않으면, 그러면 다 괜찮아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460348
					],
					"speakerTitle": "우미히코"
				},
				{
					"id": 120460348,
					"content": "그게 바로 「에무라 이치겐사이」가 남긴 위험 요소예요. 하지만 당신들의 자기기만을 억지로 바로잡을 생각은 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460349
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460349,
					"content": "방금 질문에만 제대로 대답해 준다면요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460350
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460350,
					"content": "알겠어… 근데 우리도 진짜 몰라. 아까 듣기론 오늘 안 오신댔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460351
					],
					"speakerTitle": "스스키다"
				},
				{
					"id": 120460351,
					"content": "맞아, 어제 너무 힘드셨다나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460352
					],
					"speakerTitle": "우미히코"
				},
				{
					"id": 120460352,
					"content": "또 일부러 날 피하는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460353
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460353,
					"content": "결국 도움이 되는 정보는 못 알아냈네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460354
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460354,
					"content": "「에무라 이치겐사이」가 어디 사는지는 수소문해 봤어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460355
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460355,
					"content": "어제 물어봤는데, 문지기도 모른다더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460356
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460356,
					"content": "그렇다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460357,
						120460358
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460357,
					"content": "미즈키, 이제…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				},
				{
					"id": 120460359,
					"content": "저 두 사람의 악몽을 알아냈으니까, 지금이라면 치료할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460360,
						120460361
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460360,
					"content": "그럼 치료부터 하러 가",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460362,
					"content": "…아니, 여기까지 데려다준 걸로 충분해. 더는 너희에게 폐 끼칠 이유가 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460363
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460363,
					"content": "우리는 다음 심리 치료도 받아야 하는걸! 근데 미즈키가 그 녀석 때문에 마음 상하면 치료가 미뤄질지도 모르잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460364
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460364,
					"content": "그러니까 미즈키가 걱정 없이 아이사 대중탕을 운영할 수 있도록, 끝까지 도울게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460365
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460365,
					"content": "…무라사키와 시온의 상태가 심각해서 주저할 틈이 없네. 이번에도 신세 져야 할 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460366
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460366,
					"content": "대신 하나만 부탁할게. 「에무라 이치겐사이」를 발견하면, 절대 싸우지 마. 일단 감시하면서 내게 사람을 보내 소식을 전해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460367
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460367,
					"content": "너희를 위험에 처하게 하고 싶지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460368
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460368,
					"content": "걱정 마. 우리가 지금까지 쓰러뜨린 적이 몇 명인데, 그 녀석은 상대도 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460369
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460369,
					"content": "페이몬?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460370
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460370,
					"content": "알겠어, 꼭 너한테 먼저 알릴게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460371
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460371,
					"content": "좋아, 그럼 이제 흩어지자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460372
					],
					"speakerTitle": "유메미즈키 미즈키"
				},
				{
					"id": 120460372,
					"content": "아까는 미즈키를 걱정시키지 않으려고 그런 거지? 큰소리는 다 쳐놨는데, 녀석을 못 찾으면 어쩐담?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460373
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460373,
					"content": "두 사람한테는… 더 물어도 소용없을 것 같고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460374,
						120460375
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460374,
					"content": "그 둘은 알 리가 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460376,
					"content": "미코? 그러고 보니 어제도 미코가 흘린 주소를 듣고 여기까지 찾아올 수 있었지. 미코는 분명 많은 걸 알고 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460377
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460377,
					"content": "한시가 급해, 바로 나루카미 다이샤로 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 120460375,
					"content": "하지만 미코라면 알 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460361,
					"content": "「에무라 이치겐사이」를 찾는 건 나에게 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460358,
					"content": "무라사키와 시온을 치료할 수 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				}
			]
		},
