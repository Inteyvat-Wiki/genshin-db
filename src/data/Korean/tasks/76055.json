			"dialogs": [
				{
					"id": 760550101,
					"content": "(<color=#FFCC33FF>라우마</color>가 무언가를 들은 것 같다…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760550102
					]
				},
				{
					"id": 760550102,
					"content": "…이상하네. 방금 무슨 소리가 들린 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550103
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 760550103,
					"content": "(또 손님이다! 룰렛 돌린다! 멈춘다! 맛있는 거!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550104
					],
					"speakerTitle": "파블로프"
				},
				{
					"id": 760550104,
					"content": "(어? 왜 안 돌리지? 빨리, 빨리! 맛있는 거! 먹고 싶다!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550105
					],
					"speakerTitle": "파블로프"
				},
				{
					"id": 760550105,
					"content": "강아지 소리 같은데…? 룰렛 돌린다, 맛있는 거… 무슨 뜻이지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550106
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 760550106,
					"content": "(손님! 나랑 대화할 수 있다! 손님, 룰렛 돌린다. 안 돌리면 맛있는 거 못 먹어)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550107
					],
					"speakerTitle": "파블로프"
				},
				{
					"id": 760550107,
					"content": "배고픈 거야? 자, 과자 좀 가져왔어. 일단 이거라도 먹어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550108
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 760550108,
					"content": "(멍? 손님이 룰렛 안 돌린다! 먹을 걸 준다… 멍, 일단 먹어, 냠)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550109
					],
					"speakerTitle": "파블로프"
				},
				{
					"id": 760550109,
					"content": "(고마워, 손님. 난 파블로프. 과자 고마워. 맛있다, 맛있다. 근데 룰렛 안 돌렸어)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550110
					],
					"speakerTitle": "파블로프"
				},
				{
					"id": 760550110,
					"content": "천만에. 그런데… 아까 말했던 룰렛, 그게 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550111
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 760550111,
					"content": "(룰렛 돌린다! 멈춘다! 맛있는 거 떨어져. 항상 그랬어)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550112
					],
					"speakerTitle": "파블로프"
				},
				{
					"id": 760550112,
					"content": "(손님, 정말 룰렛 안 돌려? 다들 돌렸다! 돌리면 신나!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550113
					],
					"speakerTitle": "파블로프"
				},
				{
					"id": 760550113,
					"content": "난 괜찮아. 보니까… 여기서 꽤 잘 지내고 있는 것 같네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550114
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 760550114,
					"content": "(좋다, 좋다! 사람들이 나랑 놀아준다! 룰렛이 나랑 놀아준다! 맛있는 것도 있어)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550115
					],
					"speakerTitle": "파블로프"
				},
				{
					"id": 760550115,
					"content": "다행이네. 네 주인에게 안부 전해줘. 난 이만 가볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550116
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 760550116,
					"content": "(멍… 손님 안녕. 손님, 다음에 또 봐)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "파블로프"
				}
			]
		},
