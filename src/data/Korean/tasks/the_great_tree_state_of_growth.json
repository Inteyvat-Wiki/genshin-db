			},
			"dialogs": [
				{
					"id": 230290101,
					"content": "그럴 때도 됐지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290102
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230290102,
					"content": "아직도 신성한 나무의 뿌리를 연구하고 있는 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290103
					]
				},
				{
					"id": 230290103,
					"content": "여행자, 넌 항상 도움이 필요할 때 나타나더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290104
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230290104,
					"content": "전에 도와줘서 정말 고마웠어. 신성한 나무 상태는 아주 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290105
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230290105,
					"content": "라데프와 상의했는데 한동안은 좋은 상태를 유지할 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290106
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230290106,
					"content": "이제 드디어 손을 털고 논문 준비 작업을 할 시간이 생겼어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290107
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230290107,
					"content": "이것 봐. 페레즈한테서 빌린 「사진기」야. 지금 신성한 나무 상태를 기록하러 가려는 중이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290108
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230290108,
					"content": "여행자, 너도 신성한 나무 모습을 기록해줘. 위치는 지도에 표시해 뒀어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290109,
						230290110
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230290109,
					"content": "맡겨만 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230290110,
					"content": "왜 직접 안 가고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290111
					]
				},
				{
					"id": 230290111,
					"content": "윽, 그게… 거긴… 너무 높거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290112
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230290112,
					"content": "혼자서 높은 곳에 올라가는 건 너무 무서워… 바람이 나랑 내 원고를 모두 날려버릴 것 같은 느낌이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290113
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230290113,
					"content": "평소에는 항상 페레즈가 갔는데 오늘은 다른 볼일이 있는 것 같았어. 그래서 너밖에 날 도와줄 사람이 없어, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야스민"
				}
			]
		},
