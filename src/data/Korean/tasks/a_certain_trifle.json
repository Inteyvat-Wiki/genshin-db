							0,
							6.033
						],
						"pointId": 15
					},
					{
						"sceneId": 1083,
						"position": [
							1.877,
							0,
							-1.993
						],
						"pointId": 31
					},
					{
						"sceneId": 1083,
						"position": [
							1.88,
							0,
							-0.955
						],
						"pointId": 32
					}
				]
			},
			"dialogs": [
				{
					"id": 740350201,
					"content": "여행자, 다시 와 줘서 고마워. 커피 한잔할래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350202,
						740350203
					],
					"speakerTitle": "로이알트"
				},
				{
					"id": 740350202,
					"content": "그러고 보니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				},
				{
					"id": 740350204,
					"content": "나도 궁금했어. 다… 다들 목소리가 너무 커서 차마 물어보진 못했지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350243
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740350243,
					"content": "솔직히 바로 쫓겨날 줄 알았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350205
					]
				},
				{
					"id": 740350205,
					"content": "왜냐고? 하하하, 걱정 마. 경비원도 당신을 들여보냈는데 우리가 무슨 자격으로 두 사람을 쫓아내겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350206
					],
					"speakerTitle": "로이알트"
				},
				{
					"id": 740350206,
					"content": "우린 각자 권한과 책임이 분명하니까. 안녕, 여행자. 만나서 반가워, 난 세멘이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350207,
						740350208
					],
					"speakerTitle": "세멘"
				},
				{
					"id": 740350207,
					"content": "안녕하세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350209,
					"content": "세멘 씨는 원래 심판청에서 보조 서기원으로 일했는데… 조금 복잡한 사정 때문에 행정청에서 일하게 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350210
					],
					"speakerTitle": "로이알트"
				},
				{
					"id": 740350210,
					"content": "세멘 씨의 이성적이고 정확한 사고 방식은 그동안 우리가 좀처럼 처리하지 못했던 문제들에 대한 해결 방법을 찾아줬지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350211
					],
					"speakerTitle": "로이알트"
				},
				{
					"id": 740350211,
					"content": "과찬하시는 거야. 난 그저 업무 경력을 살려서 사물의 가치를 통해 관련된 일들을 파악할 뿐이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350212
					],
					"speakerTitle": "세멘"
				},
				{
					"id": 740350212,
					"content": "실무를 처리할 땐 파악하기 어려운 일들도 많은데, 로이알트 씨가 워낙 인간 관계에 능숙하시니까 많은 도움을 받았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350213
					],
					"speakerTitle": "세멘"
				},
				{
					"id": 740350213,
					"content": "그러니까 그 말은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350214
					]
				},
				{
					"id": 740350214,
					"content": "쉽게 말하면 세멘 씨는 사람들의 정신적 균형을 잘 잡아서 스스로를 중요한 사람이라고 생각하게 만들어. 마치 저울의 균형을 맞추는 것처럼 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350215
					],
					"speakerTitle": "로이알트"
				},
				{
					"id": 740350215,
					"content": "이런 방법으로 처리가 힘들 땐 내가 언어적 도움을 줘서 「무게」를 실어 주기도 하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350216,
						740350217
					],
					"speakerTitle": "로이알트"
				},
				{
					"id": 740350216,
					"content": "윤 씨가 굉장히 힘들어 보이던데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350218,
					"content": "그래! 지금 당장 쓰러져도 전혀 이상하지 않을 것 같은 얼굴이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740350219,
					"content": "누구나 겪는 시련이야. 지금 내가 윤을 도와 서류를 완료한다면 이번 일을 통해 배울 수 있는 게 없겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350220
					],
					"speakerTitle": "로이알트"
				},
				{
					"id": 740350220,
					"content": "윤은 행정청에 대해 지나친 환상을 품고 있어. 젊은이들이라면 다들 갖는 환상이긴 하지만 행정청 직원에겐 어울리지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350221
					],
					"speakerTitle": "로이알트"
				},
				{
					"id": 740350221,
					"content": "난 서류 작성을 못해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350222
					],
					"speakerTitle": "세멘"
				},
				{
					"id": 740350222,
					"content": "굉장히 직설적이시네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350223
					]
				},
				{
					"id": 740350223,
					"content": "아, 이 얘기는 이쯤 하고. 여긴 대체 무슨 일로 온 거야? 얘기해 봐, 내가 도와줄 수 있을지도 모르니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350224
					],
					"speakerTitle": "로이알트"
				},
				{
					"id": 740350224,
					"content": "갑자기 윤이 당황한 얼굴로 달려온다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350225
					]
				},
				{
					"id": 740350225,
					"content": "아, 젠장…. 로이알트 씨, 혹시 타자기 키캡 여분 가지고 계세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350226
					],
					"speakerTitle": "윤"
				},
				{
					"id": 740350226,
					"content": "한창 타이핑 중이었는데 키캡 하나가 어딜 갔는지 안 보여서요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350227
					],
					"speakerTitle": "윤"
				},
				{
					"id": 740350227,
					"content": "주변은 찾아봤어? 바닥에 떨어졌을 수도 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350228
					],
					"speakerTitle": "로이알트"
				},
				{
					"id": 740350228,
					"content": "책 사이에 끼었거나 서류 밑에 들어갔을 수도 있는데… 거기까지 다 찾아봤어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350229
					],
					"speakerTitle": "세멘"
				},
				{
					"id": 740350229,
					"content": "필통이나 소매 안에 떨어졌을 수도 있고요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350230
					]
				},
				{
					"id": 740350230,
					"content": "머리카락 사이나 찻잔에 들어갔을 수도 있지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350231
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740350231,
					"content": "다 찾아봤어요. 옷 주머니부터 신발 밑창까지 다 찾아봤는데 안 보여요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350232
					],
					"speakerTitle": "윤"
				},
				{
					"id": 740350232,
					"content": "아, 그럼 코넬리아 씨한테 가 봐. 만약 「예비 부품」이 있다면 그쪽에 신청해야 할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350233
					],
					"speakerTitle": "로이알트"
				},
				{
					"id": 740350233,
					"content": "아니면 제가 그냥 하나 새로 사는 게 좋겠어요. 에스타블레한테 부탁하면 금방 받을 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350234
					],
					"speakerTitle": "윤"
				},
				{
					"id": 740350234,
					"content": "윤, 왜 굳이 네 사비를 쓰려고 해? 이건 행정청 공공 물품이야. 코넬리아 씨한테서 받는 게 당연한 일이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350235
					],
					"speakerTitle": "로이알트"
				},
				{
					"id": 740350235,
					"content": "별로 비싼 것도 아니잖아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350236
					],
					"speakerTitle": "윤"
				},
				{
					"id": 740350236,
					"content": "가격이 문제가 아니야. 권한과 책임의 문제라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350237
					],
					"speakerTitle": "세멘"
				},
				{
					"id": 740350237,
					"content": "행정청의 공공 물품 수리 비용은 당연히 행정청의 공금으로 지출하는 게 맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350238
					],
					"speakerTitle": "세멘"
				},
				{
					"id": 740350238,
					"content": "네 개인 돈으로 사고 비용도 청구하지 않으면 연말 공금 결산에 영향을 미치게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350239
					],
					"speakerTitle": "세멘"
				},
				{
					"id": 740350239,
					"content": "아, 알겠어요! 지금 바로 코넬리아 씨한테 갈게요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350240,
						740350241
					],
					"speakerTitle": "윤"
				},
				{
					"id": 740350240,
					"content": "물건 하나 사는 것도 번거롭네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350242,
					"content": "행정청에선 당연한 일이에요. 그럼 코넬리아 씨한테 가 보죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "윤"
				},
				{
					"id": 740350241,
					"content": "돈 쓰는 것도 이렇게 번거롭나요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350217,
					"content": "왜 도와주지 않는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350208,
					"content": "당신은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350203,
					"content": "왜 전에 절 만났을 때 놀라지 않으셨던 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				}
			]
		},
