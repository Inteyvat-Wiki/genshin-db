			"dialogs": [
				{
					"id": 740350301,
					"content": "타자기 키캡이라… 세멘 씨, 그게 영수증 청구가 가능한 물품이었나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350302
					],
					"speakerTitle": "로이알트"
				},
				{
					"id": 740350302,
					"content": "저도 잘 모르겠네요. 타자기는 청구 가능한 물품이니까… 키캡도 가능하지 않을까요?",
					"roleType": "TALK_ROLE_NPC",
