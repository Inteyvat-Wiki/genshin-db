			"dialogs": [
				{
					"id": 402170301,
					"content": "안녕, 엠버",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402170302,
					"content": "아, 명예 기사랑 페이몬, 또 만났네! 미안, 얘기하느라 바빠서 너희가 온 줄도 몰랐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170303,
						402170304
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170303,
					"content": "안녕, 엠버",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170305
					]
				},
				{
					"id": 402170305,
					"content": "하인츠 씨랑 대회 일 얘기를 하고 있었어. 그런데 너희는 설산에 무슨 일이야? 또 의뢰하러 왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170306
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170306,
					"content": "아냐~ 대회 홍보 전단지를 받았거든. 궁금해서 보러 와봤지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170307,
						402170308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402170307,
					"content": "이런 건 바로 달려와야지!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170309
					]
				},
				{
					"id": 402170309,
					"content": "그럼 잘 찾아왔어! 마침 나랑 하인츠 씨가 이 대회의 조직 위원회 스태프거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170310
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170310,
					"content": "안녕, 명예 기사. 그리고 이쪽은 페이몬이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170311
					],
					"speakerTitle": "하인츠"
				},
				{
					"id": 402170311,
					"content": "난 기사단 제1소대 좌관 하인츠라고 한다. 만나서 반가워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170312
					],
					"speakerTitle": "하인츠"
				},
				{
					"id": 402170312,
					"content": "대회는 아직 개막 전이야. 지금은 일반 티켓이랑 VIP 티켓을 배부하는 중이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170313
					],
					"speakerTitle": "하인츠"
				},
				{
					"id": 402170313,
					"content": "자, 받아. 너희를 위해 준비한 VIP 티켓이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170314
					],
					"speakerTitle": "하인츠"
				},
				{
					"id": 402170314,
					"content": "감사합니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170315
					]
				},
				{
					"id": 402170315,
					"content": "별말씀을",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170317
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170317,
					"content": "전단지에 「드래곤 스파인 국제 크로스컨트리 대회 조직 위원회」라고 적혀 있던데, 그거 말하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402170318,
					"content": "맞아. 이번 위원회는 페보니우스 기사단과 샘물 마을 주민 대표로 구성됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170319
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170319,
					"content": "나랑 하인츠 씨는 신청 절차랑 대회장의 안전 관리를 맡았고, 샘물 마을 책임자들은 심판이랑 지원을 맡았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170320
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170320,
					"content": "혹시 무슨 문제 생기면 우리한테 와! 참가자와 관중 모두 즐겁게 즐길 수 있도록 최선을 다할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170321,
						402170322
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170321,
					"content": "여전히 믿음직스럽네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170323
					]
				},
				{
					"id": 402170323,
					"content": "이번 대회는 전에 없던 규모로 열려. 외국인 참가자도 많은데, 무려 나타 사람도 있지. 분명 재밌을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170324
					],
					"speakerTitle": "하인츠"
				},
				{
					"id": 402170324,
					"content": "아, 누구 얘긴지 알겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170325
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170325,
					"content": "그 팀이라면… 분홍 머리에 멋있고 커다란 흰 뿔이 달린 참가자가 있거든요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170326
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170326,
					"content": "그 친구는 진짜 잘 먹더라고요! 다른 스태프들도 다 그 친구랑 먹길 좋아해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170327
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170327,
					"content": "하하, 워낙 복스럽게 먹어서, 보고 있으면 자기도 한 그릇 더 먹고 싶어진다나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170328
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170328,
					"content": "그리고 예쁜 줄무늬 꼬리를 가진 참가자도 있었어요. 엄청 만져보고 싶었지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170329
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170329,
					"content": "왠지 시크한 분위기를 풍겨서, 말을 걸기가 어렵더라구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170330
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170330,
					"content": "어째… 우리가 아는 사람 같지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170331,
						402170332
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402170331,
					"content": "바레사랑 실로닌 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170333
					]
				},
				{
					"id": 402170333,
					"content": "오! 너희랑 아는 사이구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170334
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170334,
					"content": "그 사람들을 만나고 싶으면 그 팀의 캠프로 가 봐. 저기, 독특한 무늬의 텐트가 있는 곳이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170335
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170335,
					"content": "캠프가 정말 예쁘더라, 만화책도 엄청 많고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170336
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170336,
					"content": "아, 보인다. 이따 꼭 가볼게. 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170337
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402170337,
					"content": "참, 혹시 괜찮으면 거기서 만화책 한 권만 빌려와 줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170338
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170338,
					"content": "그 팀 선수들이 항상 만화 얘기를 해서 나도 보고 싶은데, 일이 많아서 자리를 비우기가 어렵거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170339
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 402170339,
					"content": "알겠어, 우리한테 맡겨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402170332,
					"content": "우리 가서 인사하자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170333
					]
				},
				{
					"id": 402170322,
					"content": "우리는 구경하러 왔어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170323
					]
				},
				{
					"id": 402170308,
					"content": "아는 얼굴이 있을까 싶어서 와봤어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170309
					]
				},
				{
					"id": 402170304,
					"content": "뭐 하고 있었어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170305
					]
				}
			]
		},
