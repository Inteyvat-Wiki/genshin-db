			},
			"dialogs": [
				{
					"id": 402170501,
					"content": "바레사, 우리 훈련하는 거 구경 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402170502,
					"content": "#어? 페이몬 목소리잖아? 페이몬——{NICKNAME}——보고 싶었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170503
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170503,
					"content": "실로닌과 함께 모두를 만난 과정을 말해준다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402170504
					]
				},
				{
					"id": 402170504,
					"content": "아하하! 엘라니 언니랑 의강이도 참, 대뜸 만화 대사를 날리면 어떡해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170505
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170505,
					"content": "내 말이, 순간 말문이 막혔다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402170506,
					"content": "나였으면 이렇게 외쳤을 거야. 「힘이여! 폭발하라!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170507
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170507,
					"content": "그것도 말문이 막히긴 매한가지야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170508
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170508,
					"content": "넌 다른 사람들이랑 처음 만났을 때, 사람들이 말문을 열기도 전에 민니를 번쩍 들어서 빙글빙글 돌기까지 했잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170509
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170509,
					"content": "으아, 지금 생각하니까 엄청 부끄럽네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170510
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170510,
					"content": "계속 편지랑 일러스트만 주고받다가, 그때 처음 만난 거였거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170511
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170511,
					"content": "그래서 민니를 보자마자 나도 모르게 오버해버렸지 뭐야, 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170512
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170512,
					"content": "근데 둘이 같이 온 거 아니었어? 실로닌은 왜 아까 「『열혈 투사 특전대』랑 나」라고 한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170513
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402170513,
					"content": "꼭 한 팀이 아닌 것처럼요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170514
					]
				},
				{
					"id": 402170514,
					"content": "왜냐하면 이 동아리의 멤버는 내가 아니라 니페카거든. 난 니페카 대신 온 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170515,
						402170516
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170515,
					"content": "니페카?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170517
					]
				},
				{
					"id": 402170517,
					"content": "어. 잘 먹고 잘 자고 공부도 잘하고 있어. 최근에는 만화책에 푹 빠져서, 민니라는 펜팔 친구까지 사귀었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170518
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170518,
					"content": "그림도 잘 그리고, 만화 소품도 잘 만들고, 인생 조언까지 해주는 좋은 사람이라면서 얼마나 칭찬하던지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170519
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170519,
					"content": "그래서 대체 민니라는 사람이 몇 살인가 싶었는데, 이번에 와서 보니까 생각보다 되게 어리더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170520
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170520,
					"content": "아무튼 민니가 「설산 크로스컨트리 대회」 참가를 제안해서, 니페카도 오고 싶어 했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170521
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170521,
					"content": "니페카는… 자기 몸 상태를 아니까, 나보고 대신 가서 안부를 전해 달라고 한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170522
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170522,
					"content": "에헤헤, 난 여행 갈 준비를 미리 다 해뒀어서, 자연스럽게 언니랑 같이 온 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170523
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170523,
					"content": "맞아. 그리고 다짜고짜 나한테 부대장 자리를 쥐여주더라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170524
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170524,
					"content": "그, 그야 당연하지! 언니의 실력은 대장급인걸! 그러니까… 대장급 부대장이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170525
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170525,
					"content": "대장급이라면서 왜 부대장인 건데? 아니, 아니야. 하마터면 말려들 뻔했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170526
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170526,
					"content": "아무튼 내가 여기 온 건, 니페카한테 《열혈 투사 전기》의… 어… 뭐더라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170527
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170527,
					"content": "굿즈!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170528
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170528,
					"content": "아, 그래, 굿즈. 배지, 일러스트, 원고 복사본, 만화 캐릭터가 그려진 나무패… 이런 걸 사다주기 위해서야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170529
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170529,
					"content": "바레사, 왜 그런 이상한 표정으로 봐? 내가 뭐 잘못 말했어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170530
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170530,
					"content": "응? 아냐 아냐. 그냥 언니가 진지하게 굿즈 애기를 하니까 좀 신기해서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170531
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170531,
					"content": "만능 장인 실로닌이 굿즈를 한 아름 안고 돌아가는 장면이라니… 오, 전혀 상상이 안 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170532
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170532,
					"content": "근데 니페카가 그 많은 걸 다 사다 달래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170533
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170533,
					"content": "아니. 니페카는 자기 입으로 뭔가를 조르는 애가 아냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170534
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170534,
					"content": "하지만 내가 아는 니페카는, 어… 굿즈를 받으면, 분명 기뻐할 테지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170535
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170535,
					"content": "그럼 그럼! 이런 선물을 받으면 분명 엄청 좋아할 거야! 헤헤, 실로닌 언니는 니페카를 정말 잘 안다니까. 꼭 친언니 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170536
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170536,
					"content": "틀린 말은 아니야, 우린 실제로 가족이니까. 다만… 아직 알고 지낸 시간이 얼마 안 돼서, 많이 알아가는 중이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170537
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170537,
					"content": "후아… 바레사 언니… 나 푸시업… 다 했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170538
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170538,
					"content": "좋아, 그럼 네 세트까지 끝낸 거니까, 음, 잠깐 쉬자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170539
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170539,
					"content": "#민니, 소개할게. 이 둘은 나랑 실로닌 언니가 나타에서 사귄 친구, {NICKNAME}(이)랑 페이몬이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170540
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170540,
					"content": "금빛 머리에… 흰색 비행 물체… 설마… 몬드의 명예 기사?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170541,
						402170542
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170541,
					"content": "응, 맞아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170543
					]
				},
				{
					"id": 402170543,
					"content": "우와! 우리 오빠가 술집에서 일해서 이런저런 얘기를 많이 듣거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170544
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170544,
					"content": "손님들이 그랬대. 둘은 만화 속 주인공처럼, 어느 나라를 가든 금세 유명해진다고. 완전 대단해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170545
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170545,
					"content": "제일 기억에 남는 모험이 뭐였는지 물어봐도 될까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170546
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170546,
					"content": "당신은 잠시 생각하다, 옆에 있는 두 나타 친구를 보곤 나타에서 겪은 일을 일부 이야기해 준다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402170547
					]
				},
				{
					"id": 402170547,
					"content": "대박, 피에티나가 살던 나라가 그렇게 신비한 곳이었구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170548
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170548,
					"content": "또 있어. 우리 「비옥한 터전」 옆에는 대화산이 있는데, 거기서 가끔 불덩이가 떨어져! 위험하긴 해도, 영웅의 시련에 완전 어울리지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170549
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170549,
					"content": "바레사 언니도 알지? 난 예전부터 몬드를 떠나 바깥세상을 구경해 보고 싶어 했잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170550
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170550,
					"content": "알지! 몬드 사람은 되게 자유롭다고 들었는데… 어디든 가면 되지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170551
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170551,
					"content": "그치만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170552
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170552,
					"content": "명예 기사처럼 어떤 위험 앞에서도 위축되지 않고 나아가려면, 엄청나게 강인한 의지가 필요할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170553
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170553,
					"content": "#물론 {NICKNAME} 같은 사람은 드물지… 하지만 우리도 우리 방식대로 노력하면 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170554
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170554,
					"content": "잊지 마! 꿋꿋하게 앞으로 나아가는 것도 피에티나 님의 정신 중 하나야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170555
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170555,
					"content": "응. 나 최선을 다할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170556
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170556,
					"content": "부모님과의 약속을 위해서라도, 꼭 열심히 훈련해서 좋은 성적을 거둘 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170557
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170557,
					"content": "약속? 그건 처음 듣는 얘긴데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170558
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170558,
					"content": "아… 그게요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170559
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170559,
					"content": "에이, 나도 대회 나갈 때마다 얀사 쌤이랑 약속해. 이번엔 꼭 지난번보다 잘해보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170560
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170560,
					"content": "실제로 얼마나 잘 해낼 수 있을진 몰라도, 가끔은 약간의 부담이 있어야 동력도 생기는 법이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170561
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170561,
					"content": "아, 그래도 즐기는 마음은 잊으면 안 돼! 애초에 이 설산 모임은 다 같이 재미있게 놀려고 성사된 거니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170562
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170562,
					"content": "알겠어! 그래도 나… 이건 어쨌든 대회잖아. 헤헤, 꼭 좋은 성적을 거두고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170563
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170563,
					"content": "응! 네가 원한다면, 얼마든지 계속 훈련시켜 줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170564
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170564,
					"content": "응! 바레사 언니, 열심히 따라갈게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170565
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170565,
					"content": "아니, 너희 지금까지 계속 훈련했잖아. 바레사는 몰라도 민니는 좀 쉬어야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170566
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170566,
					"content": "전 아직 괜찮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170567
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170567,
					"content": "꼬르륵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170568
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170568,
					"content": "아무래도 밥 먹을 시간이 된 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170569
					],
					"speakerTitle": "실로닌"
				},
				{
					"id": 402170569,
					"content": "그래. 잘 챙겨 먹어야 훈련도 잘하지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170570,
						402170571
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402170570,
					"content": "밥은 잘 챙겨 먹어야 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170572
					]
				},
				{
					"id": 402170572,
					"content": "맞아. 식단도 훈련의 일부야! 내가 얀사 쌤의 스페셜 식단을 알려줄게. 내일 기운이 펄펄 날 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170573
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170573,
					"content": "진짜? 바레사 언니, 그럼 훈련 끝나고 먹기 좋은 몬드 음식도 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170574
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170574,
					"content": "몬드 음식은 잘 모르겠지만, 이런 건… 배의 직감을 믿으면 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170575
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170575,
					"content": "회오리 짐승고기로 시작해서… 민트 소스 생선구이, 타코, 카우사, 알갱이 고기 수프, 아펠슈트루델까지 먹는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170576
					],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170576,
					"content": "뭐——?! 그걸 전부 다 먹어?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402170577
					],
					"speakerTitle": "민니"
				},
				{
					"id": 402170577,
					"content": "응응, 배를 열고 음식의 맛을 느끼다 보면 어느새 싹 비워져 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바레사"
				},
				{
					"id": 402170571,
					"content": "훈련도 적당히 하고",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170572
					]
				},
				{
					"id": 402170542,
					"content": "나를 알아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170543
					]
				},
				{
					"id": 402170516,
					"content": "니페카는 잘 지내나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402170517
					]
				}
			]
		},
