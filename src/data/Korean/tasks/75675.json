			"dialogs": [
				{
					"id": 756750101,
					"content": "헤이! 하!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750102
					],
					"speakerTitle": "안지안느"
				},
				{
					"id": 756750102,
					"content": "내 머릿속은 이미 음악으로 가득 찼어, 춤을 추자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750103
					],
					"speakerTitle": "안지안느"
				},
				{
					"id": 756750103,
					"content": "흔들흔들~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750104
					],
					"speakerTitle": "세딜"
				},
				{
					"id": 756750104,
					"content": "즐겁게——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750105
					],
					"speakerTitle": "마나이아"
				},
				{
					"id": 756750105,
					"content": "우아우아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750106
					],
					"speakerTitle": "모오"
				},
				{
					"id": 756750106,
					"content": "부수입도 챙겼고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750107
					],
					"speakerTitle": "마린"
				},
				{
					"id": 756750107,
					"content": "어라? 요 녀석, 언제 그런 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750108
					],
					"speakerTitle": "안지안느"
				},
				{
					"id": 756750108,
					"content": "누스타 씨가 너무 바쁘셔서, 제가 짬을 내서 누스타 씨의 제자들을 지원하러 갔었거든요. 마물 소굴 몇 개를 소탕하고 왔어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750109
					],
					"speakerTitle": "마린"
				},
				{
					"id": 756750109,
					"content": "나타에서는 전투가 춤추는 것만큼 신나네요. 마음에 들어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750110
					],
					"speakerTitle": "마린"
				},
				{
					"id": 756750110,
					"content": "정말 번거롭게 했네, 마린. 신입들을 더 단련시키려고 한 건데, 아직도 스스로 그 임무들을 완료하지 못할 줄은 몰랐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750111
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 756750111,
					"content": "돌아가면 아주 호되게 추가 훈련을 시킬 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750112
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 756750112,
					"content": "괜찮아요, 다들 아주 잘 싸웠거든요. 다만 소굴에 예상보다 7배나 많은 마물이 있었을 뿐이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750113
					],
					"speakerTitle": "마린"
				},
				{
					"id": 756750113,
					"content": "「꽃깃회」에서 꽤 많이 줘서, 아이벨한테 줄 선물 살 돈은 충분해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750114
					],
					"speakerTitle": "마린"
				},
				{
					"id": 756750114,
					"content": "하지만 네 휴가 시간도 거의 다 된 것 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750115
					],
					"speakerTitle": "안지안느"
				},
				{
					"id": 756750115,
					"content": "며칠 더 놀면 배표를 예매하고 돌아갈 생각을 해야 할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750116
					],
					"speakerTitle": "안지안느"
				},
				{
					"id": 756750116,
					"content": "급한 건 없으니까, 춤을 더 춰도 돼요. 록산느, 르텔리에, 체니랑 프레쥐스가 요즘 서로 임무를 하겠다고 다투고 있는데, 제가 그걸 뺏을 순 없죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750117
					],
					"speakerTitle": "마린"
				},
				{
					"id": 756750117,
					"content": "그럼 계속 춤추면서 즐기자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750118
					],
					"speakerTitle": "세딜"
				},
				{
					"id": 756750118,
					"content": "춤추다 지치면 먹고, 배부르면 자고, 아무 걱정 없이!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750119
					],
					"speakerTitle": "마나이아"
				},
				{
					"id": 756750119,
					"content": "우웅——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750120
					],
					"speakerTitle": "모오"
				},
				{
					"id": 756750120,
					"content": "멜뤼진들과 어린 어룡들이 줄을 지어 무대를 향해 폴짝폴짝 뛰어갔다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756750121
					]
				},
				{
					"id": 756750121,
					"content": "정말 귀여운 손님들이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750122
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 756750122,
					"content": "헤헤, 너도 즐기고 있잖아, 누스타",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750123,
						756750124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 756750123,
					"content": "미소가 한결 편안하고 밝아졌네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				},
				{
					"id": 756750125,
					"content": "정말? 그럼 앞으로 매번 「댄스 파티」에는 무조건 와야겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750126
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 756750126,
					"content": "만나기만 하면 날 누님, 심지어 이모라고 부르는 후배 녀석들한테… 언젠가 내 정신이 녀석들보다 젊다는 걸 깨닫게 해줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750127
					],
					"speakerTitle": "누스타"
				},
				{
					"id": 756750127,
					"content": "앞으로의 「댄스 파티」는 이번 파티를 참고해서, 자주 열면 열수록 좋을 것 같은데! 매달 열리게 되어도 전혀 이상하지 않을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "누스타"
				},
				{
					"id": 756750124,
					"content": "훨씬 젊어진 것 같아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				}
			]
		}
	]
}