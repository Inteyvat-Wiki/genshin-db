					"nextDialogs": [
						230430206
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430206,
					"content": "이렇게 하면 되겠지. 그럼 부탁하네, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
