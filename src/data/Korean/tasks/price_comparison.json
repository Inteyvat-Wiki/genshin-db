			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아잘라이"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230430101,
					"content": "이거 리프한테 사람 좀 구해달라고 해야 하나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430102
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430102,
					"content": "표정이 안 좋으시네요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430103
					]
				},
				{
					"id": 230430103,
					"content": "아, 여행자. 혹시 뭐 사게? 미안하지만 지금은 찾는 물건이 없을 수도 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430104
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430104,
					"content": "그래서 표정이 안 좋으셨던 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430105
					]
				},
				{
					"id": 230430105,
					"content": "맞아… 우리 마을은 주변이 온통 사막이라 물건 운반하는 게 여간 어려운 게 아니거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430106
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430106,
					"content": "우리는 물건이 필요해지면 마을 바깥으로 나가는 사람한테 주문해달라고 한 다음, 리프랑 같이 물건을 마을로 들여오고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430107
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430107,
					"content": "그런데 이런 식으로 하다 보니 점점 들어가는 비용이 올라서 말이야. 수지타산을 맞추려면 물건 가격도 계속 조금씩 올려야만 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430108
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430108,
					"content": "마을 사람들이 내 입장을 이해해주고, 내 가게를 찾아와줘서 망정이지. 안 그랬으면… 이 구멍가게는 이미 문을 닫았을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430109
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430109,
					"content": "그런데… 후우, 나도 항상 마을 밖으로 나가는 사람을 찾을 수 있는 것도 아니고, 리프 쪽도 항상 시간이 있는 게 아니라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430110
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430110,
					"content": "운이 나빠서 일이 꼬이면 재고가 적은 물건은 금방 동나버리거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430111,
						230430114
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430111,
					"content": "보통 어떤 물건이…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430112
					]
				},
				{
					"id": 230430112,
					"content": "전부 다 일상생활에 필요한 물건들이야. 꽤 자주 들여오는 편인데도 금방 팔려나가지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430113
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430113,
					"content": "애초에 소자본 장사라 물건을 많이 들일 수도 없지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430117
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430117,
					"content": "크흠, 넋두리는 여기까지만 하지. 여행자，혹시 마을에서 나갈 생각인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430118
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430118,
					"content": "슬슬 향신료를 들여와야 해서 도움이 필요한데… 혹시 협력해 줄 수 있겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430119,
						230430120
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430119,
					"content": "제게 맡겨주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430122
					]
				},
				{
					"id": 230430122,
					"content": "어디 보자… <color=#00E1FFFF>라마</color>네 가게에서 판매하는 향신료는 가격도 합리적이고, 품질도… 꽤 괜찮은 편이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430123
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430123,
					"content": "<color=#00E1FFFF>주트</color>네 가게도 새로운 향신료를 입고시킨 것 같더라고. 몇 가지를 좀 들여오고 싶은데, 가격이 어떨지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430124
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430124,
					"content": "근데 돈이 얼마 없어서 어디서 사는 게 더 합리적일지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430125
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430125,
					"content": "여행자, 내가 말한 가게 두 곳에 가서 향신료 가격을 확인한 다음, 적당한 곳에 주문을 좀 해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430126
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430126,
					"content": "아, 참. 전에 대리 주문을 부탁했을 때는 가격이 저렴한 물건으로 주문해달라고 했었거든?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430127
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430127,
					"content": "이번에도 다른 곳보다 저렴한 가게에서 주문 부탁하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430128
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430128,
					"content": "아루 마을에서 장사할 땐 「박리다매」를 원칙으로 삼는 편이 좋거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430129,
						230430130
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430129,
					"content": "먼저 <color=#00E1FFFF>라마</color>네 가게에 가볼게요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430131
					]
				},
				{
					"id": 230430131,
					"content": "도와줘서 고마워. 가게 위치는 지도에 표시해놨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430133
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430133,
					"content": "그럼 잘 부탁해. 만약 궁금한 게 있다면 언제든 물어보도록 하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430130,
					"content": "먼저 <color=#00E1FFFF>주트</color>네 가게에 가볼게요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430132
					]
				},
				{
					"id": 230430132,
					"content": "도와줘서 고마워. 가게 위치는 지도에 표시해놨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430133
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430120,
					"content": "가게에 향신료가 전부 동난 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430121
					]
				},
				{
					"id": 230430121,
					"content": "아직 동나지는 않았지만… 인기 상품이라 떨어지기 전에 미리 사둬야 해서 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430122
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430114,
					"content": "장기 협력자를 구하면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430115
					]
				},
				{
					"id": 230430115,
					"content": "하하하… 나도 그 생각을 해봤지. 하지만 마을을 좀 둘러보면 알 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430116
					],
					"speakerTitle": "아잘라이"
				},
				{
					"id": 230430116,
					"content": "이런 마을에서 사업을 한다는 건 그렇게 쉬운 일이 아니거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430117
					],
					"speakerTitle": "아잘라이"
				}
			]
		},
		{
			"id": 2304302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
