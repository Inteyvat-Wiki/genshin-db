			"dialogs": [
				{
					"id": 751970505,
					"content": "오르방이 무기를 제작하기 시작한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751970501
					]
				},
				{
					"id": 751970501,
					"content": "완성됐어! 하하하, 자, 어때? 아주 묵직하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970502
					],
					"speakerTitle": "오르방"
				},
				{
					"id": 751970502,
					"content": "얼마를 내면 될까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970503
					]
				},
				{
					"id": 751970503,
					"content": "돈? 필요 없어. 이 재료들로 무기를 만들게 해준 것만으로도 만족해. 돈은 따로 안 내도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970504
					],
					"speakerTitle": "오르방"
				},
				{
					"id": 751970504,
					"content": "자, 그럼 이 무기를 가지고 모험을 떠나도록 해. 소중히 다루라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "오르방"
				}
			]
