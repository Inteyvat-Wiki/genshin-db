			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"응광"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400350201,
					"content": "…이 공지는 총무부에 전달하도록. 리스트에 있는 업무를 각 부서에 분배하라고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350202
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350202,
					"content": "해등절이라 번잡한 일이 많지만, 사소한 것 하나하나 신경 써야 한다고도 전하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350203
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350203,
					"content": "응광! 헤헤, 우리 또 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350204,
					"content": "방해된 건 아니죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350205
					]
				},
				{
					"id": 400350205,
					"content": "귀한 손님이 왔는데 방해라니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350206
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350206,
					"content": "보아하니 리월에 해등절 보내러 왔구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350207
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350207,
					"content": "맞아! 이번 해등절엔 뭐가 준비돼 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350208,
					"content": "똑같지 뭐, 이것저것. 참, 올해는 총무부에서 「불꽃축제」를 준비했는데 볼만할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350221
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350221,
					"content": "「명소등」 날리는 게 해등절의 핵심이었지만, 최근 리월에 워낙 많은 일이 있었잖아. 지금 사람들에게 필요한 건 온기와 단결심이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350222
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350222,
					"content": "그래서 적어도 올해는 시민 한 명 한 명에게 더 가깝게 다가갈 수 있는 방식으로 축제를 진행하려고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350223
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350223,
					"content": "「폭죽」을 리월 각지에 배달해서 적절한 때에 전부 같이 터뜨리는 거지. 열렬한 빛과 온기를 사람들의 마음에 전달하자는 게 총무부의 결정이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350209
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350209,
					"content": "불꽃축제? 다른 곳에서도 본 적 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350210,
					"content": "리월의 불꽃은 뭔가 더 특별한 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350211,
					"content": "불꽃놀이는 리월의 한 발명품에서부터 비롯된 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350212
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350212,
					"content": "리월의 선조들은 당시에 「폭죽」이라고 불렀어. 커다란 소리와 밝은 불빛을 내뿜어 독사와 맹수들을 내쫓는 용도로 사용됐었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350213
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350213,
					"content": "예전엔 사람들이 늘 밖에서 농사 짓느라 연락하기 불편했잖아. 그럴 때마다 시끄러운 「폭죽」으로 신호를 보냈어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350214
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350214,
					"content": "리월항이 건립된 후 사람들은 더 이상 멀리 가서 농사지을 필요가 없어졌고, 위험에 처했을 때 「폭죽」을 사용하는 일도 점점 줄었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350215
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350215,
					"content": "하지만 선조들이 「폭죽」을 쥐고 힘겹게 황무지를 개척하던 정신은 지금까지 이어져서 일종의 풍습으로 자리 잡았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350216
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350216,
					"content": "「폭죽」이 「불꽃놀이」의 시초인 셈이지. 우린 선조들의 정신을 기념하기 위해 폭죽을 개량해 해등절 기간에 터뜨리고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350217
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350217,
					"content": "역시 리월답네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350218
					]
				},
				{
					"id": 400350218,
					"content": "우와… 리월에 있는 것들은 전부 유구한 역사가 있구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350219,
					"content": "너희도 익숙해졌겠지. 역사가 오래될수록 사물은 더 많은 가치를 지니게 돼. 그게 바로 리월이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350220
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350220,
					"content": "불꽃축제와 관련된 건 각청에게 맡겼으니, 관심 있으면 같이 각청을 만나러 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "응광"
				}
			]
		},
		{
			"id": 4003503,
			"completionStepIds": [
				4003503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003503",
							"2"
						],
						"stepId": 4003503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"각청",
					"의웅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400350301,
					"content": "음… 폭죽을 더 많이 배치해야 할 것 같아요. 성안에서 보이는 효과뿐만 아니라 전체적인 그림을 생각해야죠. 경책 산장 사람들은 해등절 지내지 말라는 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350302
					],
					"speakerTitle": "각청"
				},
				{
					"id": 400350302,
					"content": "하, 하지만 그러면 예산이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350303
					],
					"speakerTitle": "의웅"
				},
				{
					"id": 400350303,
					"content": "예산이 뭔가요? 「어떤 일을 잘 처리하기 위한 가장 적당한 비용」이잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350304
					],
					"speakerTitle": "각청"
				},
				{
					"id": 400350304,
					"content": "예산이 부족해서 일을 못 할 것 같으면, 총무부에 신청해서 다시 허가를 받으세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350305
					],
					"speakerTitle": "각청"
				},
				{
					"id": 400350305,
					"content": "저희의 목표는 최고의 해등절을 개최하는 거예요. 예산은 더 나은 계획을 위한 거죠. 중요한 걸 잊으면 안 돼요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350306
					],
					"speakerTitle": "각청"
				},
				{
					"id": 400350306,
					"content": "네, 알겠습니다, 각청 님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350307
					],
					"speakerTitle": "의웅"
				},
				{
					"id": 400350307,
					"content": "네, 안전이 제일입니다. 명심하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350308
					],
					"speakerTitle": "각청"
				},
				{
					"id": 400350308,
					"content": "응광, 여행자. 여긴 어쩐 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350309
					],
					"speakerTitle": "각청"
				},
				{
					"id": 400350309,
					"content": "여행자, 해등절 보내러 온 거야? 마침 준비가 다 끝나가고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350310
					],
					"speakerTitle": "각청"
				},
				{
					"id": 400350310,
					"content": "각청 넌 뭘 하고 있었어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350311
					]
				},
				{
					"id": 400350311,
					"content": "폭죽 위치를 점검하고 관련 장비들이 문제없는지 확인 중이었어. 일상적인 업무지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350312
					],
					"speakerTitle": "각청"
				},
				{
					"id": 400350312,
					"content": "이런 말 해서 미안하지만, 그런 업무는 부하들한테 시켜도 되잖아. 며칠 동안 쉬지도 못했으니, 좀 쉬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350313
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350313,
					"content": "괜찮아, 난 상관없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350314
					],
					"speakerTitle": "각청"
				},
				{
					"id": 400350314,
					"content": "의웅 씨, 기획안을 다시 짜서 서면으로 정리한 다음 총무부로 좀 보내주시겠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350315
					],
					"speakerTitle": "각청"
				},
				{
					"id": 400350315,
					"content": "전 성안의 폭죽 설치 장소의 상황을 좀 살펴보고 올게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350316
					],
					"speakerTitle": "각청"
				},
				{
					"id": 400350316,
					"content": "여행자, 넌 귀한 손님이니 성안에 머무르면서 해등절의 분위기를 마음껏 즐겨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350317
					],
					"speakerTitle": "각청"
				},
				{
					"id": 400350317,
					"content": "의웅 씨, 제가 부탁드린 일 다 기억했죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350318
					],
					"speakerTitle": "각청"
				},
				{
					"id": 400350318,
					"content": "네, 그럼요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350319
					],
					"speakerTitle": "의웅"
				},
				{
					"id": 400350319,
					"content": "좋아요. 그럼 응광, 여행자 난 먼저 가볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350320
					],
					"speakerTitle": "각청"
				},
				{
					"id": 400350320,
					"content": "응광 님, 그리고… 여행자님, 저도 이만 가보겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350321
					],
					"speakerTitle": "의웅"
				},
				{
					"id": 400350321,
					"content": "각청 님이 많은 계획을 알려주셨으니, 기획안을 다시 써야겠어요…. 시간이 없어요, 서둘러야겠군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350355
					],
					"speakerTitle": "의웅"
				},
				{
					"id": 400350355,
					"content": "참! 잊을 뻔했네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350356
					],
					"speakerTitle": "의웅"
				},
				{
					"id": 400350356,
					"content": "여행자님, 이건 「폭죽통」입니다. 각청 님께서 여행자님이 좋아하실 거라고 저보고 전해드리라 하셨거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350357
					],
					"speakerTitle": "의웅"
				},
				{
					"id": 400350357,
					"content": "손재주가 좋은 분은 그것만 있으면 자신만의 폭죽을 만들 수 있답니다. 시간 있을 때 한번 도전해 보세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350322
					],
					"speakerTitle": "의웅"
				},
				{
					"id": 400350322,
					"content": "대화에 끼어들 틈이 없었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350323
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350323,
					"content": "아니, 무서워서 못 끼어든 게 맞지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350324
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350324,
					"content": "각청, 엄청 포스 있어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350325
					]
				},
				{
					"id": 400350325,
					"content": "너도 그렇게 생각하지? 각청의 포스가 전보다 훨씬 강해진 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350326
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350326,
					"content": "게다가 더 바빠 보이던데… 왜 그런 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350327
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350327,
					"content": "선인들이 리월항을 인간에게 맡긴 뒤로, 우리 칠성이 백성들을 이끄는 중책을 맡게 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350328
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350328,
					"content": "우린 각 분야의 중요 업무를 맡아 눈코 뜰 새 없이 행사의 각종 사항을 준비하고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350329
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350329,
					"content": "그렇다 해도, 모든 일을 직접 하는 건 힘들어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350330
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350330,
					"content": "예전엔 해등절 관련 총괄 업무는 모두 강주의 몫이었는데, 연로한 아버지를 보살펴야 해서 올해는 다른 부서로 옮겨갔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350331
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350331,
					"content": "그래서 해등절 관련 업무를 나와 각청이 도맡아 하게 된 거야. 난 총책임자를 맡고, 가장 주목받는 불꽃축제는 각청에게 맡겼지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350332
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350332,
					"content": "중요한 일인 만큼 제일 믿을만한 사람에게 맡겨야 한다고 생각했거든. 각청은 매사에 엄격하고 일에 대한 열정이 넘치니 딱이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350333
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350333,
					"content": "각청이 엄격하긴 하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350334
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350334,
					"content": "맞아, 자신에게나 타인에게나 모두 엄격해. 며칠 동안 쉬지 않고 과하게 일하는 게 문제지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350335
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350335,
					"content": "장기적으로 봤을 때 좋은 대책은 아니라고 생각해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350336
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350336,
					"content": "뭐든 과하면 오히려 독이 되거든. 리월 사람은 다 아는 이치야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350337
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350337,
					"content": "물론 나도 말려봤지만, 각청 성격이 어떤지 잘 알잖아. 아무리 말주변 좋은 사람이라도 각청을 말릴 순 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350338
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350338,
					"content": "여행자, 넌 각청이랑 사이도 좋고, 이런저런 경험이 많잖아. 네가 가서 좀 말려보는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350339,
						400350340
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350339,
					"content": "저한테 맡겨요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350341
					]
				},
				{
					"id": 400350341,
					"content": "역시 여행자야. 각청을 설득하는 게 쉬운 일은 아니지만, 네가 있어서 마음이 좀 놓이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350342
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350342,
					"content": "난 군옥각에 처리할 업무가 남아서 먼저 가볼게. 각청에 대한 건, 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350343
					],
					"speakerTitle": "응광"
				},
				{
					"id": 400350343,
					"content": "응광이 떠난다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400350344
					]
				},
				{
					"id": 400350344,
					"content": "정말 각청을 설득할 방법이 있는 거야? 응광도 속수무책인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350345
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350345,
					"content": "게다가 누군가를 설득하려면, 그 사람이 무슨 생각을 하는지부터 알아야 하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350346
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350346,
					"content": "각청은 지금 일하느라 며칠 동안 쉬지도 못한 상황이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350347
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350347,
					"content": "그럼… 「피곤」하겠지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350348
					]
				},
				{
					"id": 400350348,
					"content": "그건 누구나 할 수 있는 생각이잖아! 각청이 마음 깊숙이 어떤 생각을 하고 있을지 잘 고민해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350349
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350349,
					"content": "아니면, 이런 걸 알만한 친구한테 물어보는 건 어떨까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350350
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350350,
					"content": "그럼 종려 씨를 찾아가자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350351
					]
				},
				{
					"id": 400350351,
					"content": "응? 종려…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350352
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350352,
					"content": "리월 사람들을 잘 알잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350353
					]
				},
				{
					"id": 400350353,
					"content": "응, 확실히 믿을 만하지! 그럼 종려한테 물어보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350354
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350354,
					"content": "종려는 지금 「왕생당」의 객경이니까, 「왕생당」에 가면 만날 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400350340,
					"content": "방법을 생각해 볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350341
					]
				}
			]
		},
