	"talks": [
		{
			"id": 4003502,
			"completionStepIds": [
				4003502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
