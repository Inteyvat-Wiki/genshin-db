	"talks": [
		{
			"id": 303201,
			"completionStepIds": [
				303201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
