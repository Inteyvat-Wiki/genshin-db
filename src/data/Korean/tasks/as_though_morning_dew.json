			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"하늘의 소리",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320501,
					"content": "후——! 드디어 휴식 시간이다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30320502,
					"content": "긴장이 풀리니까 갑자기 배가 고프네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320503,
						30320504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30320503,
					"content": "푹 쉬어, 페이몬",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				},
				{
					"id": 30320505,
					"content": "오우예!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30320506,
					"content": "…어? 저 병은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30320507,
					"content": "…응?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320508
					]
				},
				{
					"id": 30320508,
					"content": "방을 청소하다 깨트린 건가? 그런데 누가 방 청소를 했다는 말은 없었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320509
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30320509,
					"content": "(그날 밤 스카라무슈의 이야기를 듣고 놀란 페이몬이 탁자를 건드려서 깨트린 병이었지)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320510
					]
				},
				{
					"id": 30320510,
					"content": "(그런데 그다음 스카라무슈가 자신의 존재를 지우고 세상을 바꾸었잖아? 그런데 왜 저 병은… 여전히 깨진 상태 그대로인 거지?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320511
					]
				},
				{
					"id": 30320511,
					"content": "혼란스러워 보이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320512
					],
					"speakerTitle": "하늘의 소리"
				},
				{
					"id": 30320512,
					"content": "…누구야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320513
					]
				},
				{
					"id": 30320513,
					"content": "네 고민을 이해해, 그걸 알면 누구나 머리가 아플 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320514
					],
					"speakerTitle": "하늘의 소리"
				},
				{
					"id": 30320514,
					"content": "어? 누군가 우리 귓가에서 속삭이고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320515
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30320515,
					"content": "아쉽지만 티바트의 운명은 쉽게 바꿀 수 있는 게 아니야. 신이라면 조금의 가능성이 있을지 모르지만 신이 아닌 존재라면… 글쎄",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320516
					],
					"speakerTitle": "하늘의 소리"
				},
				{
					"id": 30320516,
					"content": "작은 동물이 나무에 부딪힌다면 나무는 살짝 기울 뿐, 위치가 바뀌진 않지. 운명도 마찬가지야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320517
					],
					"speakerTitle": "하늘의 소리"
				},
				{
					"id": 30320517,
					"content": "마치 저 병처럼 말이야. 고양이가 깨트렸든, 새가 깨트렸든 결국은 깨졌잖아. 안 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320518
					],
					"speakerTitle": "하늘의 소리"
				},
				{
					"id": 30320518,
					"content": "너, 넌 누구야! 어떻게 이런 것들을 알고 있는 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320519
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30320519,
					"content": "역사는 쉽게 바뀌지 않지만 인간의 마음은 바꿀 수 있지. 자신의 눈을 믿으렴. 네가 본 것만이 진실이며, 보지 못한 것은 허상에 불과해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320520
					],
					"speakerTitle": "하늘의 소리"
				},
				{
					"id": 30320520,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320521
					]
				},
				{
					"id": 30320521,
					"content": "목소리가 사라졌잖아…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320522
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30320522,
					"content": "아까 그 사람 도대체 누구야! 갑자기 튀어나오더니 이상한 말이나 늘어놓고, 도대체 뭐 하자는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320523
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30320523,
					"content": "(눈을 믿으라고? 내 기억을 지키라는 뜻인가?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320524
					]
				},
				{
					"id": 30320524,
					"content": "깨진 병은 아직도 바닥에 있네, 직원한테 치워달라고 부탁해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320525
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30320525,
					"content": "…그냥 두면 왠지 찝찝할 것 같단 말이야. 바로 다녀올게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320526
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30320526,
					"content": "(……)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320527
					]
				},
				{
					"id": 30320527,
					"content": "(앞으로 어떤 일들이 기다리고 있을까?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 30320504,
					"content": "포상으로 맛있는 거 주문해 줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				}
			]
		},
