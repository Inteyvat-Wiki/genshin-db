						250250412
					],
					"speakerTitle": "게으른 어룡"
				},
				{
					"id": 250250408,
					"content": "(바로 안아 본다…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250250409
					]
				},
				{
					"id": 250250409,
					"content": "우! 우, 우우!",
