					"nextDialogs": [
						250250407
					],
					"speakerTitle": "게으른 어룡"
				},
				{
					"id": 250250407,
					"content": "(얌전히 물가에 있는 어린 어룡의 기분이 좋아 보인다. 지금이라면 어린 어룡을 땅 위로 데려올 수 있을 것 같다…)",
					"roleType": "TALK_ROLE_NPC",
