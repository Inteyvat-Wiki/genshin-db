			"dialogs": [
				{
					"id": 30170101,
					"content": "거기 서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170102
					],
					"speakerTitle": "타슈핀"
				},
				{
					"id": 30170102,
					"content": "금발의 여행자, 그리고 공중에 떠 있는 정령. 틀림없군. 주위를 둘러보시지. 너희는 우리의 함정에 걸려들었다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170103
					],
					"speakerTitle": "타슈핀"
				},
				{
					"id": 30170103,
					"content": "너희들! 「30인단」 녀석들이지? 우리를 잡으러 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30170104,
					"content": "「30인단」… 우리는 그 녀석들처럼 정부를 위해 쓸데없는 심부름이나 하는 충견들이 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170105
					],
					"speakerTitle": "타슈핀"
				},
				{
					"id": 30170105,
					"content": "우리는 수메르에서 가장 몸값이 비싼 최정예 용병들이지. 「추방자」라고 불리는 분의 의뢰를 완수하기 위해 찾아왔다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170106
					],
					"speakerTitle": "타슈핀"
				},
				{
					"id": 30170106,
					"content": "「추방자」… 아카데미아의 추방자?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30170107,
					"content": "「도토레」가 시킨 것 같네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170108
					]
				},
				{
					"id": 30170108,
					"content": "왜 바로 우인단을 보내지 않는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170109,
						30170110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30170109,
					"content": "현지 용병단이 더 유리하거든",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170111
					]
				},
				{
					"id": 30170111,
					"content": "이 상황에 잡담할 여유도 있나? 각오해라. 모조리 해치워버려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170112
					],
					"speakerTitle": "타슈핀"
				},
				{
					"id": 30170112,
					"content": "#{NICKNAME}, 우… 우리도 공격하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30170110,
					"content": "아카데미아 자원을 이용해서 그럴 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170111
					]
				}
			]
		},
		{
