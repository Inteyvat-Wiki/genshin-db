			"dialogs": [
				{
					"id": 30170301,
					"content": "정말 성가시네. 그래도 정예 용병들이라는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30170302,
					"content": "이 정도로 매복이 끝날 리 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170303
					]
				},
				{
					"id": 30170303,
					"content": "맞아, 앞으로도 조심해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30170304,
					"content": "근데 「도토레」 정말 무서운 녀석이네. 우리가 타이나리를 찾아갈 거란 것까지 계산해서 용병들을 잠복시킨 거잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30170305,
					"content": "똑똑한 사람이랑 싸우는 건 정말 머리 아프다구. 우선 계속 가 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 301704,
			"completionStepIds": [
