				"points": []
			},
			"dialogs": [
				{
					"id": 726630101,
					"content": "왔어? 귀찮게 해서 정말 미안해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630102
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630102,
					"content": "안색이 많이 좋아졌네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630103
					]
				},
				{
					"id": 726630103,
					"content": "하하, 고마워, 나도 드디어 이해가 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630104
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630104,
					"content": "어떤 일은 억지로 한다고 될 일이 아니라는 걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630105
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630105,
					"content": "저녁에 같이 서쪽 해안가를 같이 가줄 수 있어? 줄 게 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630106
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630106,
					"content": "와, 바다의 보물 같은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726630107,
					"content": "가보면 알아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쿠지라이 모미지"
				}
			]
		},
		{
			"id": 7266302,
			"completionStepIds": [
				7266304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266304",
							"2"
						],
						"stepId": 7266304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"쿠지라이 모미지",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726630201,
					"content": "바로 이곳이 아버지가 마지막으로 바다로 나간 곳이야. 그때도 지금 같은 밤이었어, 그 뒤로는 다시는 보지 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630202
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630202,
					"content": "많이 보고 싶겠다. 쿠지라이의 소원은 아빠를 다시 한번 보는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726630203,
					"content": "하하, 많이 보고 싶긴 하지만 바다의 자식들은 언젠간 바다로 돌아가게 되어있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630204
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630204,
					"content": "내 소원은 아버지를 뛰어넘는 낚시꾼이 되는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630205
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630205,
					"content": "어릴 때는 항상 아버지랑 같이 바다를 나가고 싶어 했는데 아버지는 항상 엄마랑 돌려보냈어. 어떨 때는 동네 오빠는 데려가면서 난 절대 안 데리고 갔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630206
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630206,
					"content": "항상 「모미지, 해안가에서 놀지 말고, 여자애들처럼 놀아」「가서 치마도 사 입고, 배 위로는 올라오지 마」라고 말했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630207
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630207,
					"content": "난 이해가 안 됐어, 도대체 왜? 여자는 왜 바다를 나가면 안 되는 건데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630208
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630208,
					"content": "사탕 사고, 꽃밭에서 뛰어놀고, 공주 놀이하는 것은 되는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630209
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630209,
					"content": "왜 바다로 나가서 모험하고 여행하는 건 안 되는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630210
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630210,
					"content": "하지 말라고 하면 더 하고 싶어지는 법이지. 아버지가 떠난 뒤 나도 낚시꾼이 되었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630211
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630211,
					"content": "아버지가 탐색하지 못했던 지역을 탐색하고, 아버지가 잡지 못했던 물고기를 잡았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630212
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630212,
					"content": "「쿠지라이」 가문의 낚시 기술은 내가 계승할 거고, 「쿠지라이」 가문이 최고의 낚시꾼 가문이라는 걸 내가 널리 알릴 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630213
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630213,
					"content": "「해중월」이 그냥 전설 속 존재라고 해도 멈추지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630214
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630214,
					"content": "그래요, 꼭 성공하길 바랄게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726630215
					]
				},
				{
					"id": 726630215,
					"content": "다들 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630216
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630216,
					"content": "전설의 대어가 존재하지 않는다고 하니 나의 소원을 바다로 던져야겠어. 아버지가 보실 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630217
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630217,
					"content": "너희들은 소원 없어? 같이 쓰자, 소원을 쓰고 해류병에 넣어서 힘껏 던지면 언젠가는 이루어질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630218
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630218,
					"content": "우와——정말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726630219,
					"content": "근데 소원이 너무 많은데 무슨 소원을 쓰지… 정말 고민되네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726630220,
					"content": "그동안 정말 고마웠어! 어떻게 보답을 해야 할지 모르겠네, 여기 엄청난 선물은 아니지만 섭섭하게 생각하진 말아줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630221
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630221,
					"content": "와——저기 봐, 저게 뭐야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630222
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726630222,
					"content": "엄청난 물고기 떼야, 우리 해류병에 관심이 있나 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630223
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726630223,
					"content": "이 녀석들이 모여있으니까 바다 안에 달이 떠 있는 거 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630224
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726630224,
					"content": "이… 이 물고기들은 「월광 나비고기」야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630225
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630225,
					"content": "아! 알았다… 드디어 알았어! 그런 거였어, 이게 바로 「해중월」이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630226
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630226,
					"content": "뭐? 「해중월」이라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630227
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726630227,
					"content": "맞아, 이 모습을 잊을 수가 없어, 달빛처럼 반짝이는 모습… 그날 봤던 「해중월」도 가온이 해류병을 던지고 나타났어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630228
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630228,
					"content": "어쩐지 오랫동안 「해중월」을 본 사람이 없다 했더니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630229
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630229,
					"content": "「월광 나비고기」가 모여서 만들어진 거구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630230
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630230,
					"content": "「월광 나비고기」가… 이런 일반 해류병을 좋아했다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630231
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630231,
					"content": "헤헤, 해류병 안에 있는 소원을 좋아하는 것일 수도 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630232
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726630232,
					"content": "하하! 그런 건가, 그럼 이 쿠지라이 모미지 님께서 저 녀석들을 다 잡아 올려주겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630233
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630233,
					"content": "나도! 나도 할래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630234
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 726630234,
					"content": "그러면 이 낚싯대를 선물로 줄게, 이건 쿠지라이 가문이 「해중월」을 잡기 위해 특수 제작한 낚싯대야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630235
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630235,
					"content": "이 정도로 내 감사한 마음을 다 표현할 수 없지만, 작은 성의니 꼭 받아줬으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726630236
					],
					"speakerTitle": "쿠지라이 모미지"
				},
				{
					"id": 726630236,
					"content": "그 낚싯대로 「월광 나비고기」를 전부 낚아버리자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "쿠지라이 모미지"
				}
			]
		}
	]
}