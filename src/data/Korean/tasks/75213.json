			"dialogs": [
				{
					"id": 752130401,
					"content": "덥다 더워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130402
					],
					"speakerTitle": "파란 옷의 여행객"
				},
				{
					"id": 752130402,
					"content": "안녕하세요, 음료 배달왔습니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130403
					]
				},
				{
					"id": 752130403,
					"content": "음료? 음료 안 시켰는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130404
					],
					"speakerTitle": "파란 옷의 여행객"
				},
				{
					"id": 752130404,
					"content": "이 사람이 아니야. 우리가 찾는 건 파란색 바지를 입은 사람이라구! 파란색 옷이 아니라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
