						721610316
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610316,
					"content": "너 지금 완전 애 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721610317,
					"content": "지금 상황이 안 좋아서 울고불고 도와달라 해야 하는데 자존심 때문에 참고 있잖아… 솔직하지 못하게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721610318,
					"content": "애들이 항상 이런 식으로 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721610319,
					"content": "그리고 큐조, 잊지마——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
