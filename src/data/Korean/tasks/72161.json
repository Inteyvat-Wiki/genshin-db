			"trigger": {
				"objectNames": [
					"이나바 큐조"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721611301,
					"content": "외국인이야? 재밌네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611302
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611302,
					"content": "여행객이라면 길을 잘 못 찾아온 거 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611303
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611303,
					"content": "뭐 하고 계세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611304
					]
				},
				{
					"id": 721611304,
					"content": "뭐, 너 막부 사람이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611305
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611305,
					"content": "아니요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611306
					]
				},
				{
					"id": 721611306,
					"content": "그럼 본인 일이나 잘 신경 써",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611307
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611307,
					"content": "이 녀석 정말 짜증 나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721611308,
					"content": "막부에서 왔습니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611309
					]
				},
				{
					"id": 721611309,
					"content": "역시 외국인들은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611310
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611310,
					"content": "봉행 어르신 앞에서는 꼬리 내리고 구걸하면서, 이나즈마 무사한테는 큰소리치고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611311
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611311,
					"content": "여기저기 돌아다니면서 분위기 흐리고… 이런 누추한 곳까지는 어쩐 일이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611312
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611312,
					"content": "아쉽네, 부상당해서 대접을 못 해주겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611313
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611313,
					"content": "그러니 알아서 돌아가 주길",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611314
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611314,
					"content": "이 녀석, 말이 안 통하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721611315,
					"content": "너희 정말 시끄럽네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611316
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611316,
					"content": "가기 전 충고 한마디 하지. 야시오리섬에 오래 머물지 마, 이 섬은 저주받았으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611317
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611317,
					"content": "저주…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611318
					]
				},
				{
					"id": 721611318,
					"content": "못 알아듣겠어? 이 섬은 저주받았다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611319
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611319,
					"content": "전쟁의 정체기, 윗선의 욕망, 아랫사람들의 절망, 무고한 부상자의 원한, 노인들 임종 때 코를 찌르는 약 냄새…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611320
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611320,
					"content": "어쨌든 저주받았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611321
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611321,
					"content": "너도 저주받기 전에 여길 떠나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611322
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611322,
					"content": "으… 뭐라고 하는지 전혀 모르겠어. 정말 이상한 사람이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
