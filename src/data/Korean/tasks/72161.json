				},
				{
					"id": 721610305,
					"content": "외부인한테 이렇게 어려운 일 시켜서 정말 미안해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610306,
						721610307
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610306,
