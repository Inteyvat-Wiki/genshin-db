					"speakerTitle": "페이몬"
				},
				{
					"id": 721610320,
					"content": "우리한테 빚진 게 있잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610322,
					"content": "흥… 정말 너희한테 못 당하겠다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610323
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610323,
					"content": "그럼 이 울림풀 좀 구해줘, 구하기 쉬울 거야. 그리고 잎이 좀 큰 게 좋아. 즙을 내서 상처에 덮기 쉽거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610324
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610324,
					"content": "난 좀 잘 테니 더 이상 귀찮게 하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이나바 큐조"
