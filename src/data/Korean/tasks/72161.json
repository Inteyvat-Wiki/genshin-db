			},
			"dialogs": [
				{
					"id": 721610101,
					"content": "흥, 정말 창피하군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610102
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610102,
					"content": "살려줬는데 우리보고 창피하다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610103,
						721610104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721610103,
					"content": "스스로가 창피하다는 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				},
				{
					"id": 721610105,
					"content": "외국인에 구조되고 평가받는 지경까지 왔다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610106
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610106,
					"content": "음… 그건 그렇고 괜찮아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721610107,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610108,
						721610109
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610108,
					"content": "괜찮아 보이네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610110,
					"content": "내가 너희들한테 빚졌네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610111
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610111,
					"content": "그리고, 아까 제법이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610112
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610112,
					"content": "#전 {NICKNAME}, 만나서 영광이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610113
					]
				},
				{
					"id": 721610113,
					"content": "외국인 기어오르지 마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610114
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610114,
					"content": "…이나즈마 토사부로 큐조라고 해, 큐조라고 불러",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610115,
						721610116
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610115,
					"content": "저 사람들은 뭐 하는 사람이에요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610117,
					"content": "해적들이야, 나즈치 해안에 저들의 거점이 많아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610118
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610118,
					"content": "도망 다니는 도적, 직업을 잃은 광부와 어민, 「안수령(眼狩令)」 도주범, 또는 전쟁 탈영병들이 하나둘 모여 강도로 타락해서… 쇼군의 통제를 벗어나려고 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610119
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610119,
					"content": "「부랑인」이든, 「해란귀」든 다 극악무도한 놈들이야…. 반군이 섬의 주술 도구를 파괴하기 전까지 난 놈들을 쭉 소탕해왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610120
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610120,
					"content": "타타라스나와 광산의 난민이 하나둘 도망가기 시작했고 일부 소인배들이 여기로 도망을 와, 해적 팀으로 들어간 거지, 그래서 지금 더 난폭해지고 있는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610121
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610121,
					"content": "그 해적들은 남쪽 지역에서 온 거야, 이 배에 있는 화물들을 노리고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610122
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610122,
					"content": "내가 그들을 방해했지 뭐야, 허허…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610123
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610123,
					"content": "당신 배가 아닌가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610124
					]
				},
				{
					"id": 721610124,
					"content": "이거? 산호궁 반군의 배인데. 나도 잘 모르겠어… 아무튼 내가 왔을 때 배에 이미 사람이 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610125
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610125,
					"content": "그래서 소라게처럼 지금까지 들어와 살기 시작했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610126
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610126,
					"content": "긴 시간 동안 이렇게 많이 말해본 건 처음이네, 정말 피곤한 일이군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610127
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610127,
					"content": "괜찮다면 내 부탁 하나만 들어줘… 내 상처가 다 아물면 빚은 꼭 갚을 테니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610128
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610128,
					"content": "아까 말한 주변의 해적 소굴을 소탕해 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610129
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610129,
					"content": "그래야만 들개 같은 해적들이 날 방해하러 오지 않고, 더 나아가 다른 해적 소굴에 이 배를 건드리지 말라는 경고를 남길 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610130
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610130,
					"content": "그럼 실력 한번 볼까, 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610131,
						721610132
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610131,
					"content": "식은 죽 먹기죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610133,
					"content": "흥, 큰소리만 칠 줄 알고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610134
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610134,
					"content": "맞다, 외국인——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610135
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610135,
					"content": "너무 우쭐대지 마, 내려갈 때는 다리가 부러지지 않게 조심하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721610132,
					"content": "갔다 올게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610116,
					"content": "왜 공격당하고 있던 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610109,
					"content": "자존심이 상한 거 같네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610104,
					"content": "무사 특유의 허세야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				}
			]
		},
