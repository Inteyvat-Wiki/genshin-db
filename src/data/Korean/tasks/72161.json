			"dialogs": [
				{
					"id": 721611401,
					"content": "또 너야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611402
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611402,
					"content": "내가 말 했잖아——어휴, 됐어 알아서 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611403
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611403,
					"content": "어지르지 말고, 필요하면 배에 있는 보급품이라도 좀 줄 테니 어서 떠나줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611404
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611404,
					"content": "도와드릴까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611405
					]
				},
				{
					"id": 721611405,
					"content": "됐어, 잘 지내는 거 안 보여?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611406
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611406,
					"content": "하지만 상처가…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611407
					]
				},
				{
					"id": 721611407,
					"content": "내가 다쳤지, 네가 다쳤어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611408
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611408,
					"content": "야 우리는 네가 걱정돼서 물어본 건데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721611409,
					"content": "그럼 날 더 이상 귀찮게 하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611410
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611410,
					"content": "제가 도와드릴 수 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611411
					]
				},
				{
					"id": 721611411,
					"content": "어떻게 도와주려고, 막부한테 넘기게?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611412
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611412,
					"content": "하하, 바보짓 하지 마… 날 탈영병이라 생각할 거야. 쿠죠 어르신은 탈영병을 살려두지 않거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611413
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611413,
					"content": "정말 날 도와주고 싶다면, 나 좀 혼자 있게 해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611414
					],
					"speakerTitle": "이나바 큐조"
				},
				{
					"id": 721611414,
					"content": "와, 진짜 말이 안 통하는 녀석이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
