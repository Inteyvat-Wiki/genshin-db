			"dialogs": [
				{
					"id": 3700201,
					"content": "저기 진 단장 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3700202,
					"content": "누구랑 대화하고 있는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3700203,
					"content": "조금 이따가 인사나 하러 갈까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3700204,
					"content": "…이게 우리의 입장입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700205
					],
					"speakerTitle": "아나스타시아"
				},
				{
					"id": 3700205,
					"content": "만약 날뛰는 마룡을 처치하지 못한다면 몬드성의 방위는 우리 「우인단」에게 넘기셔야 할 것입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700206
					],
					"speakerTitle": "아나스타시아"
				},
				{
					"id": 3700206,
					"content": "몬드의 재난은 우리 선에서 처리할 수 있습니다. 그 야수만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700207
					],
					"speakerTitle": "아나스타시아"
				},
				{
					"id": 3700207,
					"content": "[야수]… 라뇨?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700208
					],
					"speakerTitle": "진"
				},
				{
					"id": 3700208,
					"content": "네? 왜 그러시죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700209
					],
					"speakerTitle": "아나스타시아"
				},
				{
					"id": 3700209,
					"content": "후…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700210
					],
					"speakerTitle": "진"
				},
				{
					"id": 3700210,
					"content": "귀국에서는 좀 외교관다운 태도를 취하실 필요가 있어 보이네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700211
					],
					"speakerTitle": "진"
				},
				{
					"id": 3700211,
					"content": "몬드의 사신수를 「처리」한다고 하셨나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700212
					],
					"speakerTitle": "진"
				},
				{
					"id": 3700212,
					"content": "우리 페보니우스 기사단 앞에서 그런 정신 나간 소리를 하는 사람은 없었으면 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700213
					],
					"speakerTitle": "진"
				},
				{
					"id": 3700213,
					"content": "하… 하하하하… 정신이 나간 소리라, 그 정도는 아닌 것 같은데요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700214
					],
					"speakerTitle": "아나스타시아"
				},
				{
					"id": 3700214,
					"content": "좋습니다. 오늘의 논의는 여기까지인 걸로 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700215
					],
					"speakerTitle": "아나스타시아"
				},
				{
					"id": 3700215,
					"content": "그럼 이번의 성과는 「양측 모두 허심탄회하게 건설적인 의견을 교환했다」 정도로 이해하면 되겠죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700216
					],
					"speakerTitle": "아나스타시아"
				},
				{
					"id": 3700216,
					"content": "확실히… 기록해 두겠습니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700217
					],
					"speakerTitle": "아나스타시아"
				},
				{
					"id": 3700217,
					"content": "#어, {NICKNAME}, 왔구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700218
					],
					"speakerTitle": "진"
				},
				{
					"id": 3700218,
					"content": "도와줘서 정말 고마워. 성 주위의 원소 순환이 드디어 원래대로 돌아왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700219
					],
					"speakerTitle": "진"
				},
				{
					"id": 3700219,
					"content": "지난번 풍마룡 습격의 여파가 얼추 일단락됐지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700220
					],
					"speakerTitle": "진"
				},
				{
					"id": 3700220,
					"content": "사절단 쪽 압박이 이젠 무시하기 어려운 지경이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700221
					],
					"speakerTitle": "진"
				},
				{
					"id": 3700221,
					"content": "사절단?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700222
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3700222,
					"content": "외교 사절단… 리월에서 온 거야? 아니면 이나즈마성?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700223
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3700223,
					"content": "스네즈나야, 일곱 신 중 얼음신을 믿고 있는 나라야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700224
					],
					"speakerTitle": "진"
				},
				{
					"id": 3700224,
					"content": "그들의 사절단은 독특한 이름을 가지고 있어. 우인단이라고 들어봤어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700225
					],
					"speakerTitle": "진"
				},
				{
					"id": 3700225,
					"content": "아하, 우인단이었구나. 들어본 적 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700226
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3700226,
					"content": "소문이 좋진 않던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700227
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3700227,
					"content": "영문도 모른 채 풍마룡을 바로 처치하는 건 납득할 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700228
					],
					"speakerTitle": "진"
				},
				{
					"id": 3700228,
					"content": "게다가 얼음신이 이끌고 있는 우인단은 풍마룡의 힘을 노리고 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700229
					],
					"speakerTitle": "진"
				},
				{
					"id": 3700229,
					"content": "왠지 너무 수상해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700230
					],
					"speakerTitle": "진"
				},
				{
					"id": 3700230,
					"content": "「힘」이라…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700231
					]
				},
				{
					"id": 3700231,
					"content": "#무슨 일이야, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700232
					],
					"speakerTitle": "진"
				},
				{
					"id": 3700232,
					"content": "기사단에 보여주고 싶은 물건이 있어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3700233
					]
				},
				{
					"id": 3700233,
					"content": "응? 그래, 그럼 일단 기사단 본부로 돌아가지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3700234
					],
					"speakerTitle": "진"
				},
				{
					"id": 3700234,
					"content": "이런… 곳에서 중요한 이야기를 하고 싶지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "진"
				}
			]
		},
		{
			"id": 37005,
