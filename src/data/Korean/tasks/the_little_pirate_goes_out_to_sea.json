				"points": []
			},
			"dialogs": [
				{
					"id": 210270201,
					"content": "여행자, 그리고 소몽이? 무슨 일 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270202
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 210270202,
					"content": "#아? 윽… 저기… 그… {F#누나}{M#형}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270203
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270203,
					"content": "주방을 좀 빌리고 싶어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270204
					]
				},
				{
					"id": 210270204,
					"content": "빌려줄 순 있지만, 갑자기 주방은 왜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270205
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 210270205,
					"content": "그렇구나… 좋아, 마음껏 써",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270206
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 210270206,
					"content": "소몽아, 밖에서 여행할 땐 편식해서는 안 된단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270207
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 210270207,
					"content": "알, 알겠어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270208
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270208,
					"content": "#{F#누나}{M#형}, 그럼 부탁할게요. 맛있는 요리를 가르쳐 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270209
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270209,
					"content": "여행할 때 깜짝 서프라이즈로 아빠한테 보여드리고 싶어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270210
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270210,
					"content": "우리한테 맡겨줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 210270211,
					"content": "#{NICKNAME}, 어떤 요리가 좋을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
