			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"소몽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270101,
					"content": "#{F#누나}{M#형}! 마침 잘 왔어요! {F#누나를}{M#형을} 찾아가려던 참이었는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270102
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270102,
					"content": "응? 소몽아, 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 210270103,
					"content": "저번에 제가 고민을 담은 해류병을 같이 띄워달라고 부탁했잖아요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270104
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270104,
					"content": "거의 포기했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270105
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270105,
					"content": "며칠 전에 우리 아빠가 그러는데 아빠의 사업 파트너가 갑자기 찾아왔대요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270106
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270106,
					"content": "그 아저씨는 친구들과 버섯 관련 사업을 계획하고 있어서 조만간 수메르에 답사를 갈 거라고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270107
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270107,
					"content": "아저씨들이 아빠한테 함께 수메르로 가보지 않겠냐고 물어봤대요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270108
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270108,
					"content": "그리고… 저도 데려갈 수 있대요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270109
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270109,
					"content": "아빠가 처음에는 반대했는데… 갑자기 어떤 아저씨가 편지를 꺼내더니 아빠랑 얘기하고 싶다고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270110
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270110,
					"content": "둘이 얘기를 나누더니, 아빠가 수메르에 데려가 준다고 했어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270111
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270111,
					"content": "음, 아빠가 갑자기 왜 생각을 바꾼 건지는 모르겠지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270112
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270112,
					"content": "#저 수메르에 여행 갈 수 있어요! {F#누나}{M#형}! 저 수메르로 여행 가요! 너무 신나요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270113,
						210270115
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270113,
					"content": "축하해!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270114
					]
				},
				{
					"id": 210270114,
					"content": "#그 해류병 덕분인 게 틀림없어요. {F#누나}{M#형}, 고마워요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270117,
					"content": "아빠가 수메르에 도착하고 나서 「교영 마을」이라는 곳에 갈 거라고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270118
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270118,
					"content": "교영 마을?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270119
					]
				},
				{
					"id": 210270119,
					"content": "네, 아빠가 차 나무가 많고, 찻잎 품질이 좋은 차 마을이라고 했어요, 근데 정말 외우기 힘든 이름이에요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270120
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270120,
					"content": "이건 나중에 생각할래요! 그곳에 가기 전에 수메르를 먼저 가야 하니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270121
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270121,
					"content": "수메르는 엄청 멀어서 가는 데 엄청 오래 걸릴 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270122
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270122,
					"content": "다들 여행이 길어지면 이런저런 상황이 부딪힐 수 있어서 밖에서 여행하려면 준비를 많이 해야 된대요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270123
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270123,
					"content": "#{F#누나는}{M#형은} 여행을 자주 가잖아요. 혹시 여행 노하우 알려줄 수 있어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270124
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270124,
					"content": "예를 들면… 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270125
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270125,
					"content": "밖에서 여행하면 보통 뭘 먹나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270126
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270126,
					"content": "아빠는 다들 스스로 요리를 해 먹는다고 했어요. 근데 전 간단한 요리밖에 못해요. 맛이 있는지도 솔직히 잘 모르겠고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270127
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270127,
					"content": "#헤헤, 요리는 우리가 전문이야. 맞지? {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270128,
						210270129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 210270128,
					"content": "내가 가르쳐 줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270130,
					"content": "그럼 일단 부뚜막이 필요한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 210270131,
					"content": "음… 우리 묘 사부한테 주방 좀 빌려달라고 하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270132
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 210270132,
					"content": "묘 사부요? 으악, 그 아저씨 평소에 진짜 무서운데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270133
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270133,
					"content": "묘 사부가 뭐가 무서워? 엄청 착한데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270134
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 210270134,
					"content": "그, 그래요? 하지만 아빠랑 그 가게에서 밥 먹을 때마다, 제가 청심을 골라내면 아저씨가 미간을 찌푸리는걸요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소몽"
				},
				{
					"id": 210270129,
					"content": "내게 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270115,
					"content": "나도 수메르에 가게 될지도 몰라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270116
					]
				},
				{
					"id": 210270116,
					"content": "진짜요? 그럼 우리 수메르에서 만나요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "소몽"
				}
			]
		},
		{
