						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"플로베르",
					"아우렐",
					"에스탕프"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700201,
					"content": "에스탕프! 어딜 다녀온 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700202
					],
					"speakerTitle": "플로베르"
				},
				{
					"id": 790700202,
					"content": "아, 주변을 둘러보면서 시련에 도전하고 왔는데, 나름 재밌더라. 조금 다른 방법으로 통과해야 했지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700203
					],
					"speakerTitle": "에스탕프"
				},
				{
					"id": 790700203,
					"content": "너희 소식은 아우렐 씨에게 들었어. 실력이 제법이던데 「수호자 씨」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700204
					],
					"speakerTitle": "에스탕프"
				},
				{
					"id": 790700204,
					"content": "으으으… 그 자리에 네가 있었으면 널 밀쳐버렸을 거야! 열 번이면 열 번 다 밀쳐버렸을 거라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700205
					],
					"speakerTitle": "플로베르"
				},
				{
					"id": 790700205,
					"content": "그래서 시련에 도전하고 온 거야, 플로베르. 난 네가 해낼 줄 알았어. 봐, 정말 해냈잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700206
					],
					"speakerTitle": "에스탕프"
				},
				{
					"id": 790700206,
					"content": "하하하하하, 너희도 참. 오늘은 빗노래 연못의 경삿날이군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700207
					],
					"speakerTitle": "아우렐"
				},
				{
					"id": 790700207,
					"content": "드디어 진정한 우승자가 탄생했어. 비록 플로베르한테 공주님을 구할 기회가 오지 않았지만, 언젠가 실력 발휘할 날이 오겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700208
					],
					"speakerTitle": "아우렐"
				},
				{
					"id": 790700208,
					"content": "아휴, 아우렐 씨. 전 한 것도 없는걸요. 그저 곁에서 공주님을 도왔을 뿐이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700209
					],
					"speakerTitle": "플로베르"
				},
				{
					"id": 790700209,
					"content": "그럼 잘된 일 아닌가? 설마 공주님이 위험에 빠지길 바라는 건 아닐 테지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700210
					],
					"speakerTitle": "아우렐"
				},
				{
					"id": 790700210,
					"content": "그… 그게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700211
					],
					"speakerTitle": "플로베르"
				},
				{
					"id": 790700211,
					"content": "자자, 넌 무려 그 시브레루스에게 사명을 부탁받잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700212
					],
					"speakerTitle": "아우렐"
				},
				{
					"id": 790700212,
					"content": "천만에요! 그가 진짜 시브레루스인지도 모르는걸요! 이름만 들어봤지 목소리는 모르니까요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700213
					],
					"speakerTitle": "플로베르"
				},
				{
					"id": 790700213,
					"content": "게다가 넌 공주님의 시련도 받아들였잖아. 역시 우승자다워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700214
					],
					"speakerTitle": "에스탕프"
				},
				{
					"id": 790700214,
					"content": "그 이야기는 이제 그만하면 안 될까? 부탁이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700215
					],
					"speakerTitle": "플로베르"
				},
				{
					"id": 790700215,
					"content": "어쨌든 우리 빗노래 연못의 미래를 부탁하겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700216
					],
					"speakerTitle": "아우렐"
				},
				{
					"id": 790700216,
					"content": "이제 부담 없이 점프할 수 있겠군. 점프 대회에 재밌는 내용을 더 많이 추가하자고 위원회에 건의해야겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700217
					],
					"speakerTitle": "아우렐"
				},
				{
					"id": 790700217,
					"content": "좋은 생각이에요, 사회자는 제가 맡을게요. 그럼 바로 가시죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700218
					],
					"speakerTitle": "에스탕프"
				},
				{
					"id": 790700218,
					"content": "나만 여기 두고 가지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "플로베르"
				}
			]
		},
		{
			"id": 7907003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7907001",
							"3"
						],
						"stepId": 7907001,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"프룬",
					"사부랑",
					"소파쉬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700301,
					"content": "그 종이 개구리와 같이 수호자로 인정받으셨다고요?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700302
					],
					"speakerTitle": "사부랑"
				},
				{
					"id": 790700302,
					"content": "이럴 수가, 이런 경우는 처음 봅니다! 기록에도 없는 일이지요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700303
					],
					"speakerTitle": "소파쉬"
				},
				{
					"id": 790700303,
					"content": "게다가 시련까지 개조하시겠다니… 그건 안 됩니다, 공주님!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700304
					],
					"speakerTitle": "사부랑"
				},
				{
					"id": 790700304,
					"content": "오랫동안 전승된 전통을 함부로 바꾸시면 안 됩니다, 공주님!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700305
					],
					"speakerTitle": "소파쉬"
				},
				{
					"id": 790700305,
					"content": "알겠으니까 다들 목소리 좀 낮추세요. 귀가 아파요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700306
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700306,
					"content": "이미 결정한 일이에요. 지금의 전 공주이자 성물의 인정을 받은 수호자이니까 더더욱 막으실 수 없겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700307
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700307,
					"content": "하지만 공주님…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700308
					],
					"speakerTitle": "사부랑"
				},
				{
					"id": 790700308,
					"content": "걱정 마세요, 훈련 행사를 주최해서 왕국을 보호할 수 있는 날다람쥐를 많이 키워낼게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700309
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700309,
					"content": "그리고 그 후에 왕국을 떠날 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700310
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700310,
					"content": "공주님, 저희는… 휴, 공주님…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700311
					],
					"speakerTitle": "소파쉬"
				},
				{
					"id": 790700311,
					"content": "걱정 마세요. 제 몸은 제가 잘 챙길게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700312
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700312,
					"content": "전 공주로서 언젠가는 바깥세상의 사나운 바람에 맞서야 할 운명이니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700313
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700313,
					"content": "…알겠습니다, 공주님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사부랑"
				}
			]
