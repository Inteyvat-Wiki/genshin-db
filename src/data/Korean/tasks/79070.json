			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"사부랑",
					"소파쉬",
					"프룬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700101,
					"content": "#방울바람 왕국을 대표해 {NICKNAME} 님을 환영합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700102
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700102,
					"content": "앞으로 어떻게 하실 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700103
					]
				},
				{
					"id": 790700103,
					"content": "음… 우선 왕국 전역에 성물이 판단을 내렸다는 소식을 알릴 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700104
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700104,
					"content": "수호자는… 먼 곳에서 오신 플로베르 씨고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700105
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700105,
					"content": "응?! 어째서?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790700106,
					"content": "모두에게 저희가 겪었던 일을 설명하는 건 너무 복잡하잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700107
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700107,
					"content": "게다가 다들 제가 공주이자 수호자인 이유를 쉽게 이해하지 못할 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700108
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700108,
					"content": "적당한 때가 되면 모든 일을 자세히 기록해 서면 형태로 모든 백성에게 알리겠지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700109
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700109,
					"content": "그전까진 계속 공주의 신분으로 왕국의 각종 업무를 주관하려고 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700110
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700110,
					"content": "그리고 「시련장」이 「훈련장」으로 개조되면 바로 여정을 떠날 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700111,
						790700112
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700111,
					"content": "여정을 떠나신다고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				},
				{
					"id": 790700113,
					"content": "공주님… 동굴에서 그 성물이 누굴 위해 빛났는지 기억하시나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700114
					],
					"speakerTitle": "플로베르"
				},
				{
					"id": 790700114,
					"content": "응? 누굴 위해… 빛났냐고요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700115
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700115,
					"content": "네, 그때 저희 모두가 성물 근처에 있었잖아요. 물론 공주님은 인정받을 만한 분이지만 저, 저는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700116
					],
					"speakerTitle": "플로베르"
				},
				{
					"id": 790700116,
					"content": "넌 우승자에게 인정받은 우승자잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700117
					]
				},
				{
					"id": 790700117,
					"content": "맞아. 그 우승자가 너한테 부탁까지 했다며. 그런데 인정받지 못했다는 게 말이 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790700118,
					"content": "공주님의 빛이 너무 눈부셔서 다들 잘못 본 걸지도 모르잖아요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700119
					],
					"speakerTitle": "플로베르"
				},
				{
					"id": 790700119,
					"content": "풉… 그럼 우승자님, 다시 한번 시련을 겪어보실래요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700120
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700120,
					"content": "방울바람 왕국의 공주인 제가 직접 성물로 증인이 되어드리죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700121
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700121,
					"content": "그럼요! 좋아요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700122,
						790700123
					],
					"speakerTitle": "플로베르"
				},
				{
					"id": 790700122,
					"content": "진정해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700124,
					"content": "공주님 얘기만 나오면 흥분하네. 헤헤, 플로베르 너…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790700125,
					"content": "오해하지 마세요! 이, 이건 모두 빗노래 연못의 사명을 위해서예요! 그 많은 훈련을 거친 건 공주님을 구하… 아니, 지키기 위해서고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700126
					],
					"speakerTitle": "플로베르"
				},
				{
					"id": 790700126,
					"content": "중요한 임무인 만큼 절대 실수해선 안 되죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700127
					],
					"speakerTitle": "플로베르"
				},
				{
					"id": 790700127,
					"content": "공주님과 함께 떠나고 싶어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700128
					]
				},
				{
					"id": 790700128,
					"content": "그, 그럼요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700129
					],
					"speakerTitle": "플로베르"
				},
				{
					"id": 790700129,
					"content": "후후, 좋아요. 그럼 우승자 플로베르 씨, 제 시련을 겪을 준비가 되셨나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700130
					],
					"speakerTitle": "프룬"
				},
				{
					"id": 790700130,
					"content": "네, 공주님! 준비됐습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700131
					],
					"speakerTitle": "플로베르"
				},
				{
					"id": 790700131,
					"content": "으앗! 성물이 또 빛나고 있어! 너, 너무 눈부셔!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790700123,
					"content": "아이고, 귀야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700112,
					"content": "뭘 하시려고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				}
			]
		},
		{
			"id": 7907002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
