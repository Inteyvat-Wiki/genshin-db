			},
			"dialogs": [
				{
					"id": 230230601,
					"content": "후… 이 정도면 됐네. 한동안은 토양이 촉촉함을 유지할 수 있겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230602
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230602,
					"content": "고마워, 여행자. 네가 도와주지 않았다면 정말 힘들었을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230603
					],
					"speakerTitle": "구르겐"
				},
				{
					"id": 230230603,
					"content": "이상하네. 토양을 적시는 데 물이 왜 이렇게 많이 필요한 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230604
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230604,
					"content": "물을 평소보다 두 배는 더 많이 준 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230605
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230605,
					"content": "너무 힘들어서 그렇게 느껴지는 것뿐이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230606
					],
					"speakerTitle": "구르겐"
				},
				{
