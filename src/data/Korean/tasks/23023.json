			},
			"dialogs": [
				{
					"id": 230230101,
					"content": "이러면 곤란한데. 아빠, 장미가 제대로 자라지 않아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230102
					],
					"speakerTitle": "구르겐"
				},
				{
					"id": 230230102,
					"content": "어떻게든 방법을 생각해야지. 이대로라면 올해엔 약초를 납품하지 못할지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230103
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230103,
					"content": "토양도 문제없고 잡초와 해충도 전부 제거했는데 도대체 뭐가 문제지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230104
					],
					"speakerTitle": "구르겐"
				},
				{
					"id": 230230104,
					"content": "무슨 일이죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230105
					]
				},
				{
					"id": 230230105,
					"content": "음? 약초를 구매하러 온 손님인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230106
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230106,
					"content": "우린 「비마르{RUBY#[D]건강의 집}스탄」에 정기적으로 약초를 납품하고 있네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230107
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230107,
					"content": "그중에서 가장 중요한 게 바로 이 「수메르 장미」야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230108
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230108,
					"content": "장미도 약재로 사용할 수 있는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230109
					]
				},
				{
					"id": 230230109,
					"content": "그건 「비마르{RUBY#[D]건강의 집}스탄」의 의사들한테 물어봐야겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230110
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230110,
					"content": "의사 선생님들 말로는 장미와 다른 약재를 조합하면 더위를 물리칠 수 있고 위염도 완화시킬 수 있다고 했어. 그리고 다른 효능도 있다고 했는데… 기억이 잘 안 나네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230111,
						230230113
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230111,
					"content": "그렇다면 도와드려야죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230112
					]
				},
				{
					"id": 230230112,
					"content": "정말 고맙네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230113,
					"content": "이 장미에 무슨 문제가 생긴 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230114
					]
				},
				{
					"id": 230230114,
					"content": "이상하게 장미의 성장 속도가 너무 느려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230115
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230115,
					"content": "지금까지의 경험에 따르면 흙에 문제가 생겼거나 해충이 생긴 게 분명하다고 생각했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230116
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230116,
					"content": "하지만 같은 흙을 사용해서 심은 다른 약초는 무럭무럭 잘 자라더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230117
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230117,
					"content": "게다가 매일 구충 작업도 하니 해충이 생겼을 리도 없고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230118
					],
					"speakerTitle": "구르겐"
				},
				{
					"id": 230230118,
					"content": "휴, 그래서 고민이 이만저만이 아니야. 이런 상황이 지속된다면 이 장미는 제때 「비마르{RUBY#[D]건강의 집}스탄」에 납품할 수 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230119
					],
					"speakerTitle": "구르겐"
				},
				{
					"id": 230230119,
					"content": "그래서 토양을 비옥하게 만들 수 있는 특제 비료를 만들려고 하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230120
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230120,
					"content": "그런데 우리 두 사람은 다른 약초들을 돌봐야 해서 비료 제작에 필요한 재료를 수집할 시간이 없네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230121
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230121,
					"content": "여행자, 「비마르{RUBY#[D]건강의 집}스탄」의 환자들을 생각해서라도… 우리를 도와줄 수 있겠나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230122
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230122,
					"content": "도와드릴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230123
					]
				},
				{
					"id": 230230123,
					"content": "정말 고맙네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230124
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230124,
					"content": "지금 상황에서는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바르단"
				}
			]
		},
