			"dialogs": [
				{
					"id": 230230301,
					"content": "이 정도면 충분할 거야. 정말 고맙네, 여행자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230302
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230302,
					"content": "특제 비료를 뿌리면 토양이 비옥해지고 장미도 더 빨리 자랄 수 있을 테지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230303
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230303,
					"content": "저번처럼 아무런 효과도 없으면 안 되는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230304
					],
					"speakerTitle": "구르겐"
				},
				{
					"id": 230230304,
					"content": "다른 비료도 사용했던 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230305
					]
				},
				{
					"id": 230230305,
					"content": "일반 비료도 사용했었는데 효과가 별로 없었어… 아니, 효과가 아예 없었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230306
					],
					"speakerTitle": "바르단"
				},
				{
					"id": 230230306,
					"content": "다른 밭에 사용했을 때는 효과가 좋았었는데 도대체 뭐가 잘못된 건지 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230307
					],
					"speakerTitle": "구르겐"
				},
				{
					"id": 230230307,
					"content": "이 얘기는 그만하자. 이건 답례니 받아줘, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바르단"
				}
			]
		},
