			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"카즈칼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250210101,
					"content": "호레이, 이번에는 함부로 돌아다니면 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210102
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210102,
					"content": "우, 우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210103
					],
					"speakerTitle": "호레이"
				},
				{
					"id": 250210103,
					"content": "오늘 호레이는 착하네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210104
					]
				},
				{
					"id": 250210104,
					"content": "응. 네 도움을 받아서 만든 「표류공」 덕분이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210105
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210105,
					"content": "이 공만 있으면 호레이를 데리고 목욕, 밥 먹기, 잠자기까지 모든 훈련을 할 수 있어. 아주 편해졌지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210106
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210106,
					"content": "특히 발톱 손질! 그 전엔 도망 다니는 호레이를 쫓아다니는 것만으로도 쓰러질 뻔했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210107
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210107,
					"content": "이제 공을 호레이 앞에 두기만 하면 아주 얌전히 앉아 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210108
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210108,
					"content": "우우, 우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210109
					],
					"speakerTitle": "호레이"
				},
				{
					"id": 250210109,
					"content": "호레이, 기억해? 네 장난감을 만드는 데 도움 준 사람이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210110
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210110,
					"content": "우우, 우우!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210111,
						250210112
					],
					"speakerTitle": "호레이"
				},
				{
					"id": 250210111,
					"content": "착하지, 착하지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				},
				{
					"id": 250210113,
					"content": "오! 널 기억하고 있네. 게다가 기분도 좋아 보여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210114
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210114,
					"content": "이번 기회에 녀석의 발톱을 손질해 주는 게 어때? 뿔도 좀 닦아주고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210115
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210115,
					"content": "산룡에게 있어서 발톱 손질은 중요한 일이야. 녀석들은 땅을 파야 해서 발톱 손질을 꾸준히 해줘야 해. 삐뚤어지거나 부러진 발톱도 잘라줘야 하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210116
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210116,
					"content": "그래야만 다 컸을 때 완벽한 발톱을 가질 수 있거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210117
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210117,
					"content": "자, 이거 받아! 발톱을 손질하면서 호레이도 반짝빤짝하게 만들어 주는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210118,
						250210119
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210118,
					"content": "정말 자세하게 말씀하시네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210120,
					"content": "우우, 우——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210121
					],
					"speakerTitle": "호레이"
				},
				{
					"id": 250210121,
					"content": "크흠… 호레이가 말을 잘 듣는 건 정말 보기 드문 일이거든. 녀석을 쫓으러 온 부족을 돌아다니지 않아도 된다고 생각하니까 나도 모르게 흥분한 모양이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210122
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210122,
					"content": "…그동안 고생 많으셨네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210123
					]
				},
				{
					"id": 250210123,
					"content": "별거 아니야! 그럼 시작하자. 옆에서 알려줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210124
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210124,
					"content": "호레이가 긴장을 풀 수 있도록 먼저 솔로 녀석의 등을 가볍게 닦아주고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210130
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210130,
					"content": "다시 촘촘한 솔로 뿔을 닦아주는데, 이때 틈새에 있는 얼룩도 잘 닦이게 힘을 좀 줘야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210125
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210125,
					"content": "그다음엔 수건으로 호레이의 몸을 닦아주는 거지… 그럼 호레이가 점차 긴장을 풀고, 발톱을 꺼낼 텐데. 그때 발톱을 손질해 주면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210126,
						250210127
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210126,
					"content": "너무 자세한 거 아닌가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210128,
					"content": "당연하지. 호레이는 내가 키웠으니까. 부족에서… 아니, 나타에서 나보다 호레이를 더 잘 아는 사람은 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210129
					],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210129,
					"content": "자, 내가 방금 알려준 대로 호레이의 발톱을 손질해 줘. 난 옆에서 지켜보고 있을 테니까 모르는 게 있으면 언제든지 물어봐도 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카즈칼"
				},
				{
					"id": 250210127,
					"content": "당신은 호레이를 정말 잘 알고 있네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210119,
					"content": "갑자기 흥분하신 거 같네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210112,
					"content": "(호레이를 쓰다듬는다)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				}
			]
		},
