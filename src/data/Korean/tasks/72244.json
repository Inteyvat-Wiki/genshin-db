				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722440301,
					"content": "일곱 개의 영혼의 불이 밝혀진 걸 보니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440302
					],
					"speakerTitle": "클리메네"
				},
				{
					"id": 722440302,
					"content": "이미 위령제를 마친 것 같네요. 이 은혜를 꼭 기억해 둘게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440303
					],
					"speakerTitle": "클리메네"
				},
				{
					"id": 722440303,
					"content": "그럼, 이제 제가… 영혼을 부르는 곳으로 향하는 통로를 열어드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440304
					],
					"speakerTitle": "클리메네"
				},
				{
					"id": 722440304,
					"content": "이방의 여행자여, 이미 제 사사로운 염원으로 많은 폐를 끼쳤지만… 당신이 영혼을 안식시키는 의식의 증인이 되어주셨으면 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440305
					],
					"speakerTitle": "클리메네"
				},
				{
					"id": 722440305,
					"content": "이 길을 따라 앞으로 나아가세요, 그곳에서 기다릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "클리메네"
				}
			]
