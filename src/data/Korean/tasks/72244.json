			"dialogs": [
				{
					"id": 722440501,
					"content": "여행자님, 설마 고삐를 찾으신 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440502
					],
					"speakerTitle": "클리메네"
				},
				{
					"id": 722440502,
					"content": "고삐를… 한 번만 보여주실 수 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "클리메네"
				}
			]
		},
		{
			"id": 7224406,
			"completionStepIds": [
				7224415
