			"dialogs": [
				{
					"id": 402260201,
					"content": "나비아와 클로린드는 당신을 따라 전시회장에 도착했다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402260202
					]
				},
				{
					"id": 402260202,
					"content": "생각보다 훨씬 크네. 근데 사람이 별로 없어서 그런지 조금 썰렁한걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260203
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 402260203,
					"content": "아직 정식 개막 전이라 그럴 거야. 아무래도 야호다 쪽에 도와줄 일이 많겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402260204,
					"content": "그럼 이쪽은 나랑 클로린드한테 맡겨. 시간 나면 우리 전시품도 체험하러 와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "나비아"
				}
			]
		}
