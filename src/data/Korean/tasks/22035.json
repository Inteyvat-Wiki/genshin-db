				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"류지"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220350101,
					"content": "여행자, 또 만났네. 네가 저번에 도와준 덕분에 사장님이 범인을 특정할 수 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350102
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220350102,
					"content": "하지만 범인을 확실하게 검거하려면, 준비가 조금 더 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350103
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220350103,
					"content": "사장님이 다른 일을 처리하실 거니까 우린 저번 업무를 계속하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350104,
						220350107
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220350104,
					"content": "계속 보물 사냥단을 들쑤시고 다니면 되나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350105
					]
				},
				{
					"id": 220350105,
					"content": "응, 범인은 우리가 상대해야 할 보물 사냥단과 상관없을지도 모르지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350106
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220350106,
					"content": "어차피 딱히 선량한 사람들도 아니니까, 이번에도 우리를 「돕는」 셈 치자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220350112,
					"content": "구체적인 장소는 사장님이 알려주셨어. 성에서 멀리 떨어지지 않은 곳이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350113
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220350113,
					"content": "성안의 상황은… 사장님이 아마노 씨와 안도 씨에게 은밀히 알렸다고 하셨어. 그들도 우리 작전에 협조할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350114
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220350114,
					"content": "게다가… 사장님은 이번 사건을 해결하면, 공을 전부 그쪽에 돌릴 것이라고 약속하셨으니 흔쾌히 협조하겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350115
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220350115,
					"content": "추리와 계획은 사장님에게 맡기고, 우린 계속해서 보물 사냥단과 「대화」를 하러 가자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350116
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220350116,
					"content": "네 지도에도 표시해뒀어. 바로 출발하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "류지"
				},
				{
					"id": 220350107,
					"content": "계속해서 범인의 경계를 늦추기 위해서인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350108
					]
				},
				{
					"id": 220350108,
					"content": "맞아, 범인에게 우리의 목표가 보물 사냥단이라고 계속 착각하게 만드는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350109
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220350109,
					"content": "사장님이 완벽한 계획을 세울 수 있도록 시간을 벌 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350110
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220350110,
					"content": "후후… 어차피 보물 사냥단은 평소에도 말썽거리였으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350111
					],
					"speakerTitle": "류지"
				},
				{
					"id": 220350111,
					"content": "이번에도 우리를 「돕는」 셈 치자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "류지"
				}
			]
		},
		{
			"id": 2203502,
			"completionStepIds": [
				2203508
