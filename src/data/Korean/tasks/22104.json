			"dialogs": [
				{
					"id": 221040101,
					"content": "정말 귀찮네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040102
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221040102,
					"content": "왜요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040103
					]
				},
				{
					"id": 221040103,
					"content": "아이고, 미안! 언제 온 거야…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040104
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221040104,
					"content": "실은 주변에 마물이 점점 늘어나고 있어. 내 그이가 그놈들은 객잔에 들어오지 못한다고 하긴 했지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040105
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221040105,
					"content": "그이 혼자서 막는다고 하니 살짝 걱정돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040106
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221040106,
					"content": "만약 시간 있으면 객잔 주변을 둘러봐줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040107,
						221040108
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221040107,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040109
					]
				},
				{
					"id": 221040109,
					"content": "도와준다니 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221040113,
					"content": "아무튼, 사례는 꼭 할 테니까 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221040108,
					"content": "이 객잔은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221040110
					]
				},
				{
					"id": 221040110,
					"content": "음… 평범한 객잔일 뿐이야. 살짝 외진 곳에 있고 손님이 많긴 하지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040111
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221040111,
					"content": "그래도 밖을 떠돌아다니는 사람들에게 숙식을 해결할 수 있는 장소가 있다는 건 좋은 거니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040112
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 221040112,
					"content": "나랑 내 남편 모두 그냥 이렇게 생각하고 있을 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221040113
					],
					"speakerTitle": "베르 고데트"
				}
			]
