					}
				]
			},
			"dialogs": [
				{
					"id": 751260601,
					"content": "이런 일이 있었을 줄이야…. 밀치도 그렇고, 이 일기를 남긴 사람도 그렇고… 다들 정말 용감한 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751260602,
					"content": "꺄!",
