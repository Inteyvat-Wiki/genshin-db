			"dialogs": [
				{
					"id": 190010101,
					"content": "바바라 님… 별일 없겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010102
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190010102,
					"content": "바바라한테 무슨 일 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010103
					]
				},
				{
					"id": 190010103,
					"content": "혼자 약초를 채집하러 가셨는데 아직도 안 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010104
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190010104,
					"content": "페보니우스 기사단에 보고해야 하나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010105
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190010105,
					"content": "제가 바바라를 찾아볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190010106
					]
				},
				{
					"id": 190010106,
					"content": "네가? 아… 넌 「명예기사」니까 괜찮겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010107
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190010107,
					"content": "기사단에 보고한 후 있을 번거로운 일들도 피할 수 있고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010108
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190010108,
					"content": "그럼 부탁할게. 울프 영지 근처에 약초를 채집하러 간다고 하셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190010109
					],
					"speakerTitle": "빅토리아"
				},
				{
					"id": 190010109,
					"content": "그쪽으로 가서 찾아봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "빅토리아"
				}
