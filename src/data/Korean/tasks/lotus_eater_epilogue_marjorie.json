			"dialogs": [
				{
					"id": 722430102,
					"content": "팔고 싶은 보물이 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430103
					]
				},
				{
					"id": 722430103,
					"content": "보물? 의외네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430104
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 722430104,
					"content": "너처럼 강한 모험가가 팔고 싶은 물건이라면 분명 보기 드문 보물이겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430105
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 722430105,
					"content": "빨리 보여줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430106
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 722430106,
					"content": "용 뼈의 꽃 결정의 이야기를 마죠리에게 얘기한다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722430107
					]
				},
				{
					"id": 722430107,
					"content": "꼭 음유시인의 이야기에 나오는 망우의 열매 같네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430108
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 722430108,
					"content": "그런 게 진짜 있었다니… 이걸 용 뼈의 꽃 결정이라고 하는구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430109
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 722430109,
					"content": "네가 얘기한 효과가 진짜 사실이라면, 80000모라랑 특제 요리로 구매하고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 722430110,
					"content": "음… 80000모라에 달빛 파이 5개 추가, 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430111,
						722430114,
						722430120
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 722430111,
					"content": "이걸로 뭘 하시려고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430112
					]
				},
				{
					"id": 722430112,
					"content": "후후, 특이한 보물이잖니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430113
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 722430113,
					"content": "동화처럼 신기한 효능이 있으니까, 연금술사들도 분명 아낌없이 돈을 내놓을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 722430114,
					"content": "적당한 가격이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430115
					]
				},
				{
					"id": 722430115,
					"content": "그럼 보물은 받아둘게, 다음에 또 와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430116
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 722430116,
					"content": "참, 결정 같은 물건은 바람 속에서 천천히 휘발되는 성질이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430117
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 722430117,
					"content": "그러니까 막을 씌우거나 용기에 넣어 밀봉하는 게 좋을 거야, 그럼 발색도 더 예쁘게 될 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430118
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 722430118,
					"content": "노하우를 좀 알려줄게, 모험에 도움이 됐으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430119
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 722430119,
					"content": "또 비슷한 보물을 찾게 되면 네 충성스러운 구매자를 잊지 말아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마죠리"
				},
				{
					"id": 722430120,
					"content": "생각해 볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430121
					]
				},
				{
					"id": 722430121,
					"content": "하하, 문제없어. 하지만 난 내 가격이 가장 합리적이라고 믿어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430122
					],
					"speakerTitle": "마죠리"
				},
				{
					"id": 722430122,
					"content": "그럼 결정하면 다시 찾아와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마죠리"
				}
			]
