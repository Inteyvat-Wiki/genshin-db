			"dialogs": [
				{
					"id": 740410601,
					"content": "으음, 어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410602
					],
					"speakerTitle": "브로글리"
				},
				{
					"id": 740410602,
					"content": "지금껏 수집한 데이터를 취합하면 유의미한 성과를 낼 수 있을 것 같아. 머지않아 수문 관측 사업도 재개되겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410603
					],
					"speakerTitle": "브로글리"
				},
				{
					"id": 740410603,
					"content": "오오, 정말 다행이네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740410604,
					"content": "어라? 근데 데이터 중 일부가 빠진 것 같은데… 내 착각이겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410605
					],
					"speakerTitle": "브로글리"
				},
				{
					"id": 740410605,
					"content": "그걸 나한테 물어보면 어떡해! 데이터 담당자는 너잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740410606,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410607
					],
					"speakerTitle": "말리놉스키"
				},
				{
					"id": 740410607,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410608
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740410608,
					"content": "…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410609
					]
				},
				{
					"id": 740410609,
					"content": "…아이쿠, 방을 잘못 찾았네. 이거 실례…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410610
					],
					"speakerTitle": "말리놉스키"
				},
				{
					"id": 740410610,
					"content": "우인단 지휘관이 덩치에 어울리지 않는 속도로 재빠르게 줄행랑친다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410611
					]
				},
				{
					"id": 740410611,
					"content": "자, 잠깐. 방금 뭐가 지나간 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410612,
						740410613
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740410612,
					"content": "용 도마뱀보다 날쌘데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				},
				{
					"id": 740410614,
					"content": "아니, 지금 그게 중요한 게 아니잖아! 저 우인단 녀석이 왜 여기 있는 건데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410615
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740410615,
					"content": "#{NICKNAME}, 어서 쫓아가서 어떻게 된 건지 알아보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740410613,
					"content": "정말 재빠른 사람이네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				}
