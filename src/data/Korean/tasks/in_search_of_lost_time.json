			"dialogs": [
				{
					"id": 740410101,
					"content": "브로글리, 부탁한 대로 관측소 두 곳의 데이터를 가져왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740410102,
					"content": "정말? 다행이다! 어서 보여줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410103,
						740410104
					],
					"speakerTitle": "브로글리"
				},
				{
					"id": 740410103,
					"content": "자, 여기요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410107
					]
				},
				{
					"id": 740410107,
					"content": "브로글리에게 지금까지 수집한 테이프를 건넨다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410108
					]
				},
				{
					"id": 740410108,
					"content": "아아아, 맞아, 바로 이거야! 너흰 내가 고난에서 떠나 다시금 여유롭고 행복한 삶을 살 수 있게 도와주러 온 천사님들이구나——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410109
					],
					"speakerTitle": "브로글리"
				},
				{
					"id": 740410109,
					"content": "과장이 너무 심하잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740410110,
					"content": "아무튼 한시가 급하니 난 가서 관리자님께 중앙 처리소 열쇠를 받아올게. 잠시만 기다려 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410111
					],
					"speakerTitle": "브로글리"
				},
				{
					"id": 740410111,
					"content": "에휴, 하여간… 빨리 와야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740410112,
					"content": "잠시 후 브로글리가 들뜬 표정으로 돌아온다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410113
					]
				},
				{
					"id": 740410113,
					"content": "열쇠를 받아왔어! 이제 중앙 처리소에 가서 데이터만 정리하면 수문 관측 사업도 별 탈 없이 재개될 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410114,
						740410115
					],
					"speakerTitle": "브로글리"
				},
				{
					"id": 740410114,
					"content": "그렇군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410116,
					"content": "「파트 드 프뤼 관측소」랑 「크레프 쉬제트 관측소」의 상황을 보면, 중앙 처리소에도 분명 스네즈나야 사람들이 주둔하고 있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410117
					],
					"speakerTitle": "브로글리"
				},
				{
					"id": 740410117,
					"content": "그러니까… 제발 같이 가줘! 이렇게 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410118
					],
					"speakerTitle": "브로글리"
				},
				{
					"id": 740410118,
					"content": "에휴… 잊지 말고 보수나 챙겨줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740410115,
					"content": "굳이 저희까지 가야 할까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410104,
					"content": "보수는요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410105
					]
				},
				{
					"id": 740410105,
					"content": "보수는 걱정 마. 내가 다시 수문 연구를 할 수 있게 되면 넉넉히 챙겨줄 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410106
					],
					"speakerTitle": "브로글리"
				},
				{
					"id": 740410106,
					"content": "헤헤, 알겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410107
					],
					"speakerTitle": "페이몬"
				}
			]
		},
