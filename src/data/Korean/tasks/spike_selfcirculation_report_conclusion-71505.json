			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"호세이니"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715050101,
					"content": "#{NICKNAME}, 드디어 왔구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050102
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715050102,
					"content": "장비 튜닝은 잘 되고 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050103
					]
				},
				{
					"id": 715050103,
					"content": "이미 끝냈어. 조금 걱정되지만 당분간은 볼트를 갱도 깊은 곳에 놓아야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050104
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715050104,
					"content": "헤디브에게 약도 부탁했으니까 도 씨와 지호에게 보내줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050105
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715050105,
					"content": "#{NICKNAME}, 볼트를 작동시킨 후 지맥에서 검은 진흙을 분출하는 출구를 봉인해줘… 꼭 성공해야 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050106
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715050106,
					"content": "처음 헤디브의 도움 요청을 받았을 때에는 가볍게 생각했거든. 문제를 해결하지 못하면 그냥 볼트를 갖고 수메르에 돌아가면 된다고 생각했었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050107
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715050107,
					"content": "어차피 「푸르시나 볼트」에 대한 실험도 충분히 했고 연구 보고서 작성에 필요한 데이터도 필요 이상으로 잔뜩 수집했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050108
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715050108,
					"content": "하지만 도 씨와 지호처럼 여기서 살고 있는 사람들은… 평생 검은 진흙의 위협을 받아야 할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050109
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715050109,
					"content": "만약 나의 연구가 그들에게 실제로 도움이 되지 않고 단지 한 편의 보고서 작성을 위한 것이라면… 이런 연구는 별로 가치가 없다고 생각해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050110
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715050110,
					"content": "그래서 다짐했어. 지맥의 검은 진흙 문제를 해결하겠다고. 더군다나 이런 검은 진흙과 접촉하는 것은 수메르 학자인 나에게도 일종의 경각심을 심어줄 수 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050111
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715050111,
					"content": "#네 실력은 의심하지 않아. 하지만 검은 진흙에서 뿜어져 나온 곳은 아주 위험하다는 걸 잊지 마. 조심해야 해, {NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050112,
						715050113
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715050112,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				},
				{
					"id": 715050114,
					"content": "하하하, 켁! 켁… 쿨럭쿨럭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050115
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715050115,
					"content": "#자신의 안전에 조심하라고 당부하는 거야, {NICKNAME}! 「푸르시나 볼트」는 분출구에서 작동하면 검은 진흙이 몬스터에게 주는 영향을 줄일 수 있지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050116
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715050116,
					"content": "이미 검은 진흙에 이끌려온 몬스터 수가 너무 많아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715050117
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715050117,
					"content": "부디 몸 조심해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715050113,
					"content": "볼트를 잘 지킬게요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715050114
					]
				}
			]
		}
	]
}