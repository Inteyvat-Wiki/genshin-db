			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 722320301,
					"content": "(장부에서 찢어낸 종이 같다. 위에는 바른 글씨로 뱀 뼈 광갱의 순찰 보고가 적혀 있었다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320302
					],
					"speakerTitle": "글씨가 반듯한 쪽지"
				},
				{
					"id": 722320302,
					"content": "(대부분의 내용은 광석의 분포 상황, 공업 생산 응용 가능성과 이곳에 전초 기지를 세우는 것에 대한 가능성과 관련되어 있었다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320303
					],
					"speakerTitle": "글씨가 반듯한 쪽지"
				},
				{
					"id": 722320303,
					"content": "(그 외엔 라이덴 쇼군이 남긴 번개 원소 주술 도구 시스템과 마신의 잔재가 유출될 경우 발생할 수 있는 결과, 히기 마을 환자에 대한 관찰기록이 첨부되어 있다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320304
					],
					"speakerTitle": "글씨가 반듯한 쪽지"
				},
				{
					"id": 722320304,
					"content": "(마지막 부분은 「특수 작전」의 완성 상황과 「네이슨」이라는 가명을 사용한 우인단 멤버의 낙관이 적혀있다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320305
					],
					"speakerTitle": "글씨가 반듯한 쪽지"
				},
				{
					"id": 722320305,
					"content": "(쪽지 한쪽에 작은 글자들이 더 있었다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320306
					],
					"speakerTitle": "글씨가 반듯한 쪽지"
				},
				{
					"id": 722320306,
					"content": "「…이 보고서를 찾으러 온 신입 우인단원은, 가능한 한 빨리 서쪽 항구로 가 정보관과 합류하라」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320307
					],
					"speakerTitle": "글씨가 반듯한 쪽지"
				},
				{
					"id": 722320307,
					"content": "「암호는 '웃겨 죽겠네'」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "글씨가 반듯한 쪽지"
				}
			]
