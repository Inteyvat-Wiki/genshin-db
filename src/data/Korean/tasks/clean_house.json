							"7223207",
							"2"
						],
						"stepId": 7223207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"시즈루"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722320501,
					"content": "재미있군요… 이 일의 내막을 아는 사람들을 기꺼이 희생시키다니. 「우인단」은 이런 조직인가요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320502
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320502,
					"content": "하나도 재미없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320503
					]
				},
				{
					"id": 722320503,
					"content": "저희와 생각이 다른 외부인이라면 전 모두 재밌다고 생각합니다만. 하지만 좋은 의미로 재미있는 것도 있지만, 그런 의미가 아닌 것도 있답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320504
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320504,
					"content": "아, 바쁘신 와중에 시간을 내 아라히토가미 무녀님을 위해 사소한 일을 해결해 주셔서 감사합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320505
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320505,
					"content": "이 「네이슨」의 약점이 완전히 우리 손에 들어왔으니, 「우인단」에 대한 대책도 진전이 생겼군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320506
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320506,
					"content": "「네이슨」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320507
					]
				},
				{
					"id": 722320507,
					"content": "몬드 사람이라 자칭하던데… 어쩌면 정말로 몬드에서 태어난 우인단 멤버일지도 모르겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320508
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320508,
					"content": "「우인단」의 무서운 점을 알 수 있는 가장 좋은 예시이죠. 전면전이 아닌, 정교하게 내부 혼란을 야기하고 난국으로부터 이익을 취하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320509
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320509,
					"content": "그들은 우리가 가장 급히 극복해야 할 장애물이 바로 우리 내부에 있다는 것을 잘 알고 있지요… 아무리 억제하려 해도, 피로써 갚고자 하는 복수의 악념은 사라지지 않으니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320510
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320510,
					"content": "그렇게, 「의군」으로 위장하여, 공감을 사는 구호와… 차가운 마음으로, 이 네이슨은 군의 가장 급진적인 무리를 막다른 길로 몰았어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320511
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320511,
					"content": "본인은 그곳에서 발을 뺐고… 아니, 발을 뺄 뻔했죠. 결국 놈은 벌을 받았으니까요… 흥, 개인적으로 고작 감방에 가두는 벌은 너무 가벼운 것 같습니다만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320512
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320512,
					"content": "그리고 야시오리섬 주민은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320513
					]
				},
				{
					"id": 722320513,
					"content": "그리고 야시오리섬의 주민은, 네이슨의 보고서를 봤으니 알 거예요. 그들 눈에 주민들의 생명은 보고서 속 데이터일 뿐이에요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320514
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320514,
					"content": "이 재앙은… 부끄럽지만 아라히토가미 무녀님의 계획을 어지럽혔죠. 게다가 가속되는 충돌도 불가피하게 되었습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320515
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320515,
					"content": "그래도 우리는 인심을 되돌리고 평화를 얻었고, 살아남은 자들은 희생자들의 뜻을 저버리지 않을 수 있었습니다… 비록 소는 잃었지만 적어도 튼튼한 바닥에서 외양간을 고칠 수 있게 된 셈이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320516
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320516,
					"content": "「전쟁은 눈물의 강, 건널 배 하나 없이 세차게도 흐르네」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320517
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320517,
					"content": "이건 저희 와타츠미섬 노래 중 한 구절입니다… 아라히토가미 무녀님께서 전쟁을 원치 않으시는 것도, 이 때문이겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320518
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320518,
					"content": "아쉽군요, 텟페이 그 녀석이 우리와 함께 이 모든 것을 지켜보지 못한 게… 너무나도 아쉽습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320519
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320519,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320520
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320520,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320521
					]
				},
				{
					"id": 722320521,
					"content": "크흠… 어쩌면 우인단은 짧은 시일 내에 실종된 전초를 조사하러 올지도 모르겠군요. 하지만 거리낌 없이 우리 산호궁으로 찾아올 정도로 멍청하진 않겠지요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320522
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320522,
					"content": "물론, 이런 일들은 아라히토가미 무녀님께서 저보다 더 멀리 보고 계시겠지만요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320523
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320523,
					"content": "아무튼… 슬픈 일을 더는 언급하지 않겠습니다. 우인단 잔당 사건을 원만히 해결했네요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320524
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320524,
					"content": "아, 장어구이를 괜찮게 하는 곳을 압니다. 시간이 편하시다면 같이 맛보러 가는 게 어떠신지요… 「황새치」 2번대의 「대장님」?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "시즈루"
				}
			]
		},
