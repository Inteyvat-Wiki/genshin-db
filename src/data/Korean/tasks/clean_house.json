	"talks": [
		{
			"id": 7223201,
			"completionStepIds": [
				7223201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
