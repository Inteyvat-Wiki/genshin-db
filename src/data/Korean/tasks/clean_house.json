						722320403
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320403,
					"content": "우인단 정보관과 교섭하러 왔습니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320404
					]
				},
				{
					"id": 722320404,
					"content": "뭐라는 건지 모르겠군요… 이곳은 개인 사유지입니다. 말 걸지 말아 주시죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320405
					],
					"speakerTitle": "???"
				},
				{
					"id": 722320405,
					"content": "이렇게나 과장된 옷을 입고서 손에는 막부 군인의 것도, 산호궁 군인의 것도 아닌 무기를 들고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320406
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320406,
					"content": "언제든지 도망칠 수 있어 보이고, 무언가를 꾸미고 있을 것만 같은 모습이라니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320407
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320407,
					"content": "위장에 조금 신경 쓰는 게 좋을 듯하군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320408
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320408,
					"content": "장난치는 사람으로 보입니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320409
					],
					"speakerTitle": "???"
				},
				{
					"id": 722320409,
					"content": "#좋아요, 장난은 거두도록 하죠. 저희는 뱀 뼈 광갱에서 왔습니다. {NICKNAME}, 증명해 드리세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722320410
					],
					"speakerTitle": "시즈루"
				},
				{
					"id": 722320410,
					"content": "웃겨 죽겠네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722320411
					]
				},
				{
