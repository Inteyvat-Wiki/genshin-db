				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431501,
					"content": "「역시 장사는 책에 적힌 거랑 완전히 달라. 차라리 그때 바자르에 남아서 장사나 할걸 그랬어」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431502
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732431502,
					"content": "「논문도 안 써지고 돈도 다 떨어지고, 이게 뭐야」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431503
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732431503,
					"content": "「정 안 되면, 차라리 퇴학하고 도금 여단에 들어가던가 해야지」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "게시판"
				}
			]
		},
