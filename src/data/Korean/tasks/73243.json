			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431101,
					"content": "「아카데미아가 매년 크샤흐레와르 학부에 주는 경비는 대스승 카비카부스 이후로 계속 정체되어 있습니다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431102
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732431102,
					"content": "「윗 분은 모두가 안정적인 삶을 살기 위해 반드시 기계 기술의 연구 및 홍보를 엄격하게 통제해야 한다고 말하고 있습니다. 그렇다면 전 차라리 허공을 폐쇄하는 게 낫다고 생각합니다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431103
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732431103,
					"content": "「산게마 바이 어르신 같이 혜안을 가진 상인이 장기적으로 투자하지 않았다면 저희 묘론파는 진작에 사라졌을 겁니다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "게시판"
				}
			]
		},
		{
			"id": 7324312,
			"completionStepIds": [
				7324312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324312",
							"2"
