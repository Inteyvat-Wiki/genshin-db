			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431901,
					"content": "「…『잔디크』 사건 조사 결과… 다스터의 사망 원인은… 타살 가능성도… 있어 보인다…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431902
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732431902,
					"content": "「…『잔디크』는… 제명된 후… 비늘병에 대해… 하지만 증거가 부족하다…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431903
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732431903,
					"content": "「…기록이 갑자기 사라졌다… 비늘병이 언제부터… 전파됐는지 알 수 없다…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431904
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732431904,
					"content": "「…실종 전… 『바루나 전설』 …에 집착했다…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431905
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732431905,
					"content": "[나머지 내용은 심각하게 훼손되어 그 뜻을 알아보기 힘들다]",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "게시판"
				}
			]
		},
