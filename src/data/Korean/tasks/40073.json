						],
						"stepId": 4007306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"피슬",
					"오즈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400730601,
					"content": "여기 성이 있는데 온전하지는 않아. 피슬, 이것도 네 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400730602,
					"content": "음… 본 황녀가 생각 좀 해봐야 겠구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730603
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 400730603,
					"content": "생각할 필요 없습니다, 아가씨. 이건 옛날에 아가씨가 슬픔에 빠지는 바람에 실수로 손이 미끄러져 부순 장난감 성이지 않습니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730604
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 400730604,
					"content": "오즈! 말하지 마!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730605
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 400730605,
					"content": "방금 생각났다. 이 성은 나와 관련된 황성이지만 옛날에 두 부분을 잃어버렸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730606
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 400730606,
					"content": "그러니까 두 조각을 찾아야 한다는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 4007313,
