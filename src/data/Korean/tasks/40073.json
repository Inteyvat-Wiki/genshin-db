			},
			"dialogs": [
				{
					"id": 400730401,
					"content": "후… 아름다우면서 나약하고, 거대하면서 겁이 많고… 정말 감탄스러우면서도 혐오스럽구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400730402
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 400730402,
					"content": "이렇게 과장된 환각 비경은 처음이라 정말 감탄스럽다고 하십니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "오즈"
				}
			]
		},
		{
			"id": 4007306,
			"completionStepIds": [
				4007306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007306",
