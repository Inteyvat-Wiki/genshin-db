					"content": "여기 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109602,
			"completionStepIds": [
				7109602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109602",
							"2"
						],
						"stepId": 7109602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"목영",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710960201,
					"content": "이번에도 「노석」이 3개네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960202
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710960202,
					"content": "그럼 「열성적인 두 분」이 주신 「노석」은 잘 받도록 할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960203
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710960203,
					"content": "이렇게 빨리 찾을 줄은 몰랐어, 게다가 저번에 봤던 것보다 품질이 더 좋은 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960204
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710960204,
					"content": "흠… 이걸 보니 내가 가지고 있던 그 노석이 생각나는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960205
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710960205,
					"content": "네가 가지고 있던 노석?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960206,
						710960207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710960206,
					"content": "가지고 있으면서 우리 보고 또 찾으라고 한 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				},
				{
					"id": 710960208,
					"content": "그건 「옛날」 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960209
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710960209,
					"content": "내 아버지는 성로청에 있었는데, 그 「노석」은 아버지 손을 거쳐 간 재료의 자투리였어. 품질이 좋지 못해서 그 돌멩이를 내 장난감으로 주셨지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960210
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710960210,
					"content": "그 당시 난 맨날 아버지와 말다툼이나 하는 한량이었어. 심지어 암상 찻집에서 놀다가 엄청난 빚을 지게 됐어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960211
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710960211,
					"content": "아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710960212,
					"content": "정말 한심하네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960213
					]
				},
				{
					"id": 710960213,
					"content": "저, 젊을 때는 누구나 사고 칠 수 있잖아, 아무튼 그래서 궁지에 몰렸어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960214
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710960214,
					"content": "마침 누군가가 「노석」을 사고 싶다고 했고, 노석의 가치를 모르는 나는 팔아서 번 모라를 빚 갚는데 썼어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960215
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710960215,
					"content": "근데 며칠 전에 아버지랑 그 이야기를 하는데 아버지가 「목영아, 네가 가지고 놀던 그 돌멩이는 어쨌니…」라고 물으시더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960216
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710960216,
					"content": "「그 돌멩이를 어떻게 지금까지 가지고 있겠어요?」라고 대답할 수밖에 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960217
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710960217,
					"content": "말은 그렇게 했지만 마음속으로는 만약 팔지 않았고 아버지가 이야기할 때 꺼내서 보여줬다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960218
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710960218,
					"content": "…다 지난 이야기인데, 무슨 소용이 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960219
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710960219,
					"content": "지금이라도 알았으면 된 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710960220,
					"content": "맞아… 그래도 옛날에 빌린 돈은 천천히 갚아야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960221
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710960221,
					"content": "그 이야기는 이제 그만하고, 만약 노석을 발견하면 나에게 가져다줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960222,
						710960223
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710960222,
					"content": "아직도 부족한가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960224,
					"content": "세 개만 더 찾아줘, 세 개면 충분할 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960225
					],
					"speakerTitle": "목영"
				},
				{
					"id": 710960225,
					"content": "노석은 희귀 광석이라 휘산청이 더 필요하다고 해도 층암거연에서는 더 이상은 찾을 수 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "목영"
				},
				{
					"id": 710960223,
					"content": "얼마나 더 필요하죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960207,
					"content": "그럼, 일단 당신 것부터 먼저 내놓으세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				}
			]
		}
	]
}