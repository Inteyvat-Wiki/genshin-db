			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090301,
					"content": "으엑, 바닥이 밀가루 천지야. 조심 좀 하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10090302,
					"content": "솥 안에 있는 건 고기 같은데…. 무슨 고기인지는 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10090303,
					"content": "혹시 선인에게 바치려고 만든 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10090304,
					"content": "음… 「고기」와 「밀가루」로 만든 요리라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10090305,
					"content": "어라? 바닥에 종이도 떨어져 있어…. 위에 발자국도 있네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10090306,
					"content": "혹시 이 요리랑 관련 있는 건가…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 100904,
			"completionStepIds": [
				100904
