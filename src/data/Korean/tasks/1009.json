			},
			"dialogs": [
				{
					"id": 10090201,
					"content": "여기서 누군가 요리를 했었나 봐. 선인한테 줄 음식을 만든 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10090202,
					"content": "옆에 식자재도 좀 남았어. 금어초… 연꽃받침… 그리고 두부까지. 어려운 요리인 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10090203,
					"content": "어, 이거 봐. 메모… 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10090204,
					"content": "너무 어려워서 만드는 법을 적어놨나 봐…. 자세히 읽어보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 100903,
			"completionStepIds": [
				100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
