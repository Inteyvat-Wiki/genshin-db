			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090401,
					"content": "엄청 깨끗하다. 여기서 요리했던 사람이 깔끔하게 청소했나 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10090402,
					"content": "혹시 선인한테 바칠 음식을 만들려고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10090403,
					"content": "이건… 「송이버섯」이랑 「짐승고기」야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10090404,
					"content": "레시피도 바로 옆에 있어. 여기서 요리했던 사람은 엄청 꼼꼼한가 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
