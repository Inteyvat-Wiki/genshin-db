			"order": 1,
			"listShowType": "QUEST_SHOW",
			"description": "첨아와 대화하기",
			"finishConditions": [
				{
					"type": "QUEST_CONTENT_COMPLETE_TALK",
					"rawParams": [
						7151401,
						0
					],
