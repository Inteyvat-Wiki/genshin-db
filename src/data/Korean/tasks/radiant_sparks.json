			]
		}
	],
	"talks": [
		{
			"id": 7151401,
			"completionStepIds": [
				7151401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151401",
							"2"
						],
						"stepId": 7151401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"첨아"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715140101,
					"content": "안녕! 선배들! 해피 해등절이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140102
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140102,
					"content": "요즘 재밌게 지냈어? 나랑 특별한 모험 하나 안 해볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140103
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140103,
					"content": "와, 방금 우리한테 선배라고 한 거야? 아주 바람직한 태도야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715140104,
					"content": "요즘뿐만 아니라 우린 늘 재밌게 지내고 있지! 근데… 우리 어디서 본 적이 있던가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715140105,
					"content": "선배는 모험가 길드의 특급 개근왕이잖아. 분명 날 봤겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140106
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140106,
					"content": "난 첨아야. 평소엔 비운 언덕에서 신입 길드원을 모집하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140107
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140107,
					"content": "비운 언덕을 지나는 사람들은 열이면 열 내 목소리를 들어본 적 있을 거야. 아, 함께 있던 고양이와 강아지도 마찬가지고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140108,
						715140110
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140108,
					"content": "그런 것 같기도 해요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140109
					]
				},
				{
					"id": 715140109,
					"content": "그래, 이제야 내 노력이 빛을 보네! 이렇게 된 이상 내 걸작을 체험해 줘야겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140112
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140112,
					"content": "이렇게까지 말하니 선배로서 당연히 거절할 수 없지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715140113,
					"content": "네 특별한 모험이 뭔지 간단히 소개해줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715140114,
					"content": "응! 그럼 바로 본론으로 넘어갈게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140115
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140115,
					"content": "얼마 전에 만문집사에서 새로운 소설… 아니, 새로운 정보를 찾았는데 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140116
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140116,
					"content": "모험에 대한 사람들의 기대치가 높아져서 등산이나 바람의 날개로 활강하는 이벤트 같은 건 예전만큼 재밌다고 생각하지 않는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140117
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140117,
					"content": "길드원을 늘리려면 색다르고 자극적인 체험이 필요한 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140118
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140118,
					"content": "그래서 몇몇 외지 홍보원과 함께 거금을 들여 등산 전문가와 폭죽 장인을 모셨어. 그리고 색다른 스피드 도전을 설계했지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140119
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140119,
					"content": "도전에는 장치가 여러 개 설치되어 있는데 그걸 밟으면 폭죽과 화약 폭발의 추진력으로 하늘 높이 날아오를 거야. 엄청난 스피드를 느낄 수 있는 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140120
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140120,
					"content": "폭죽? 화약? 스피드 도전 중에… 사람을 날려버린다는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140121,
						715140122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715140121,
					"content": "폭죽에 날아가는 페이몬!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140123
					]
				},
				{
					"id": 715140123,
					"content": "왜 이렇게 신났어? 너도 같이 날아가는 거거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715140124,
					"content": "물론 네 실력이라면 코앞에서 폭약통이 터져도 두렵지 않겠지만… 그래도 어질어질할걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715140125,
					"content": "견고한 장치 안에서 폭발하는 거니까 걱정하지 마. 안전장치를 단단히 해뒀으니 절대 다칠 일은 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140126
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140126,
					"content": "게다가 총무부에도 정식으로 보고했고, 홍보할 때도 절대 따라 하지 말라고 당부했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140127
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140127,
					"content": "그렇게까지 했다고? 나름 세심하게 준비했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715140128,
					"content": "예상컨대, 이 스피드 도전에 참가하기만 하면 그게 누구든 모험 욕구가 불타오를 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140129
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140129,
					"content": "선배들 같은 유명 인사가 앞장서서 스피드 도전에 참가하면 다들 따라 하려 할 테고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140130
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140130,
					"content": "푸짐한 보상까지 준비했으니 몰려든 사람들을 모험가 길드원으로 끌어들일 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140131,
						715140133
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140131,
					"content": "좋아요. 폭죽 화약 스피드 도전!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140132
					]
				},
				{
					"id": 715140132,
					"content": "응! 보상을 얻을 기회인데 거절할 이유가 없지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140135
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715140135,
					"content": "결정한 거지? 자, 그럼 어서 도전해 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140136
					],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140136,
					"content": "헤헤, 이번 스피드 도전은 코스가 다양해서 재밌을 거야. 나도 이번 달 실적을 올릴 수 있을 테니 서로 돕는 셈이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "첨아"
				},
				{
					"id": 715140133,
					"content": "무서워요. 페이몬과 같이 날아가다니!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140134
					]
				},
				{
					"id": 715140134,
					"content": "이봐, 그러면서 왜 웃고 있는데? 첨아가 안전하다고 하니 한번 해보고 싶은 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140135
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715140122,
					"content": "화약에 날아가는 페이몬!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140123
					]
				},
				{
					"id": 715140110,
					"content": "전혀 모르겠어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140111
					]
				},
				{
					"id": 715140111,
					"content": "전혀 모르겠다고? 그럼 이번 걸작으로 더 많은 사람이 날 기억하게… 아니, 길드에 가입하게 만들겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140112
					],
					"speakerTitle": "첨아"
				}
			]
		}
	]
}