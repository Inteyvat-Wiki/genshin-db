{
	"id": 71514,
	"type": "WQ",
	"name": "춤추는 불꽃",
	"description": "해등절 기간, 모험가 길드 홍보원 첨아가 재밌는 이벤트를 기획하고 있다…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 2019,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
