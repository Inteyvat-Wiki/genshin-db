			},
			"dialogs": [
				{
					"id": 751850701,
					"content": "너희구나? 실력이 대단하다는 그 이방인 여행자가! 그래서, 흑흑 까만 알은 만들어 봤어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850702,
						751850705,
						751850710
					],
					"speakerTitle": "룬투마"
				},
				{
					"id": 751850702,
					"content": "만들어서 먹어보니까 온몸에 힘이 넘치던걸요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850703
					]
				},
				{
					"id": 751850703,
					"content": "그래, 그렇다니까! 화산의 정수가 담긴 맛이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850704
					],
					"speakerTitle": "룬투마"
				},
				{
					"id": 751850704,
					"content": "매일 먹으면 몸이 점점 건강해진대!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "룬투마"
				},
				{
					"id": 751850705,
					"content": "너무 오래 구워서 먹는 순간 기절할 뻔했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850706
					]
				},
				{
					"id": 751850706,
					"content": "하하하! 그래도 꽤나 인상 깊은 맛이었지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850707
					],
					"speakerTitle": "룬투마"
				},
				{
					"id": 751850707,
					"content": "적응되면 또 그렇게 못 먹을 정도는 아냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "룬투마"
				},
				{
					"id": 751850710,
					"content": "아직이에요. 다음에 시도해 볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850711
					]
				},
				{
					"id": 751850711,
					"content": "그래, 모든 일이 순조롭길 바랄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "룬투마"
				}
