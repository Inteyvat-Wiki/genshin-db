					"룬투마"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850301,
					"content": "흑흑 까만 알이 뭐예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850302
					]
				},
				{
					"id": 751850302,
					"content": "흑흑 까만 알은 우리 화산 지대에서만 만들 수 있는 맛있는 요리야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850303
					],
					"speakerTitle": "룬투마"
				},
				{
					"id": 751850303,
					"content": "새알을 지열 분출구 위에 올려놓고 화산에서 뿜어져 나오는 기체 열소로 굽는 거야. 불 세기가 적당할 때 꺼내면 완벽한 흑흑 까만 알을 얻을 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850304
					],
					"speakerTitle": "룬투마"
				},
				{
					"id": 751850304,
					"content": "단, 너무 오래 구우면 맛이… 음… 조금 특별해질 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "룬투마"
				}
			]
		},
		{
			"id": 7518504,
			"completionStepIds": [
				7518502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
