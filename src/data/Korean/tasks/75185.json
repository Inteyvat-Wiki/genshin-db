				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751850401,
					"content": "너희 둘 정말 대단한데! 슉슉슉 몇 번 만에 도전을 완료하다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850402
					],
					"speakerTitle": "룬투마"
				},
				{
					"id": 751850402,
					"content": "어디 보자… 오오, 이 검은색에 진한 향기까지… 정말 군침 도는데! 식기 전에 얼른 먹어 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850403
					],
					"speakerTitle": "룬투마"
				},
				{
					"id": 751850403,
					"content": "이 레시피도 가져가. 나중에 또 흑흑 까만 알 요리가 먹고 싶어질 땐 한번 직접 요리해서 먹어 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "룬투마"
				}
			]
		},
