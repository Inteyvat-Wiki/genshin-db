			"dialogs": [
				{
					"id": 722160101,
					"content": "바위 인간이 다 완성해간다고 하더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160102
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 722160102,
					"content": "어서 나와 같이 바위 인간이 있는 곳으로 가보자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「네코」"
				}
			]
		},
		{
			"id": 7221602,
			"completionStepIds": [
				7221602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
