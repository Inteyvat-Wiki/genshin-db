			"dialogs": [
				{
					"id": 140160801,
					"content": "시간 낭비하지 마. 보스의 인내심은 한계가 있다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160802
					],
					"speakerTitle": "마르티넷"
				},
				{
					"id": 140160802,
					"content": "내일 바로 움직일 거니까 알아서 잘해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160803
					],
					"speakerTitle": "마르티넷"
				},
				{
					"id": 140160803,
					"content": "태엽 장치가 안 움직인 것도 부품 하나를 빼먹어서 그런 거네. 그렇게 생각하니 나름 공평할지도?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160804
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160804,
					"content": "숫자만 놓고 보면 그렇긴 한데… 하암, 나 안 되겠어. 더는 못 버텨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160805
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140160805,
					"content": "하하하, 어서 가서 자. 오늘 정말 즐거웠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160806
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160806,
					"content": "내일 봐요, 나비아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160807
					]
				},
				{
					"id": 140160807,
					"content": "응, 내일 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160808
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160808,
					"content": "어때? 간밤에 잘 잤어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160809
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160809,
					"content": "불가사리랑 춤추는 꿈을 꿨어…. 그러니까 「불가사의」한 밤이었다고 할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160810
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140160810,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160811
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160811,
					"content": "…그런 말은 어디서 배운 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160812
					]
				},
				{
					"id": 140160812,
					"content": "하하, 제법 재미있는 녀석이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160813
					],
					"speakerTitle": "콜터"
				},
				{
					"id": 140160813,
					"content": "보라구, 콜터는 좋아하잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160814
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140160814,
					"content": "그럼 출발할까? 푸아송 마을로 가는 배를 준비할게. 아델도 너희를 만나고 싶어 할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160815
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160815,
					"content": "네가 준비한 선물을 좋아했으면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160816
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140160816,
					"content": "그러게, 후후",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "나비아"
				}
			]
