			"dialogs": [
				{
					"id": 140160601,
					"content": "저녁 식사를 즐기고 공연을 보며 그렇게 시끌벅적한 밤이 깊어져 간다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140160602
					]
				},
				{
					"id": 140160602,
					"content": "조용해지자 당신과 페이몬은 방으로 돌아갔다. 그때 문 두드리는 소리가 들렸다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140160603
					]
				},
				{
					"id": 140160603,
					"content": "자? 아직 깨어있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160604,
						140160605
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160604,
					"content": "나비아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160606
					]
				},
				{
					"id": 140160606,
					"content": "별일은 아니고 이런 밤은 드물잖아. 이대로 보내기엔 너무 아쉽지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160607
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160607,
					"content": "낚시하러 갈까? 도구는 준비해 뒀어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160608
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160608,
					"content": "밥 먹기 전에 네가 말한 「준비」가 이거였구나! 바로 갈게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160609
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140160609,
					"content": "헤헤, 내가 휴식을 방해한 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160610,
						140160613
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160610,
					"content": "괜찮아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160611
					]
				},
				{
					"id": 140160611,
					"content": "걱정 마, 네가 기운이 없을 걸 예상하고 미리 준비해 둔 게 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160612
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160612,
					"content": "나랑 수다 떠는 셈 치고 같이 가자, 응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160615
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160615,
					"content": "좋아, 낚시하러 출발!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160613,
					"content": "당신의 부탁이라면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160614
					]
				},
				{
					"id": 140160614,
					"content": "헤헤, 역시 내 파트너야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160615
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160605,
					"content": "무슨 일이에요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160606
					]
				}
			]
		},
		{
