					"speakerTitle": "페이몬"
				},
				{
					"id": 140160512,
					"content": "하하하, 농담이야. 먼저 가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "나비아"
				}
