			"dialogs": [
				{
					"id": 140160101,
					"content": "루디빈 씨, 저 왔어요. 요즘 장사는 잘돼요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160102
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160102,
					"content": "가시 장미회의 아가씨가 와주시는 덕분에 문 안 닫고 장사하는 거죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160103
					],
					"speakerTitle": "루디빈"
				},
				{
					"id": 140160103,
					"content": "하하, 자네가 장사 수완 좋은 건 세상 모두가 아는데 그런 농담을 누가 믿어? 그리고 아가씨가 아니라 보스야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160104
					],
					"speakerTitle": "콜터"
				},
				{
					"id": 140160104,
					"content": "어머, 말실수했네요. 저도 모르게 그만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160105
					],
					"speakerTitle": "루디빈"
				},
				{
					"id": 140160105,
					"content": "옷 가지러 오신 거죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160106
					],
					"speakerTitle": "루디빈"
				},
				{
					"id": 140160106,
					"content": "네, 전에 폰타인성에 들렀을 때 찾았어야 했는데 깜빡했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160107
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160107,
					"content": "이런 일은 부하한테 시키면 되지, 왜 아가씨가 직접 오셨나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160108
					],
					"speakerTitle": "루디빈"
				},
				{
					"id": 140160108,
					"content": "사소한 일도 요란스럽게 처리하는 게 나비아의 스타일이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140160109,
					"content": "사소한 일이라니, 기분 전환이라는 중요한 목적이 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160110
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160110,
					"content": "새로운 여정을 떠나는 것만큼 마음이 치유되는 일은 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160111
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160111,
					"content": "하하, 보스 말이 맞아. 혼자 끙끙 앓는 것보다 낫지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160112
					],
					"speakerTitle": "콜터"
				},
				{
					"id": 140160112,
					"content": "금방 가져올 테니까 잠시만 기다리세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160113
					],
					"speakerTitle": "루디빈"
				},
				{
					"id": 140160113,
					"content": "참, 아델은 왜 가시 장미회에 가입하려는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140160114,
					"content": "헤헤, 자세한 이유는 말 안 했는데 그냥 내가 좋대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160115
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160115,
					"content": "그 일이 있은 뒤로 많이 밝아졌어. 아버지가 실망스러운 사람이 아니란 걸 알게 돼서 그런 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160116
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160116,
					"content": "아델은 우리 아버지를 무서워했었는데, 그래서 가시 장미회에는 무서운 사람들만 있다고 생각했나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160117
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160117,
					"content": "하지만 지금의 가시 장미회는 분위기가 많이 달라져서 말을 걸 용기가 생긴 거래. 나라면 자기를 이해해 줄 거라 생각한 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160118
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160118,
					"content": "둘이 비슷한 일을 겪었으니까요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160119
					]
				},
				{
					"id": 140160119,
					"content": "응, 그럴지도 모르지. 난 진실을 찾는 과정에서 아델을 도왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160120
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160120,
					"content": "그래서 그 아이도 가만히 앉아서 도움을 기다리기보단, 나처럼 나서서 다른 사람을 돕고 싶대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160121
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160121,
					"content": "훌륭한 가시 장미회 멤버가 될 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160122
					],
					"speakerTitle": "콜터"
				},
				{
					"id": 140160122,
					"content": "나도 그렇게 생각해. 하지만 우선 그 아이가 건강하게 자랄 수 있는 환경을 만들어줘야 해. 그러고 나서 어른이 됐을 때 선택권을 넘겨주는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160123
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160123,
					"content": "(착각이 아니었어…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160124
					]
				},
				{
					"id": 140160124,
					"content": "응? 왜 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160125,
						140160126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140160125,
					"content": "따라와 봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160127
					]
				},
				{
					"id": 140160127,
					"content": "뭐, 미, 미행!? 지금 바로 갈게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 140160128,
					"content": "나도 따라갈게! 콜터, 옷 좀 챙겨 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160129
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 140160129,
					"content": "어, 그, 그래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "콜터"
				},
				{
					"id": 140160126,
					"content": "누군가 미행하고 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160127
					]
				}
			]
		},
