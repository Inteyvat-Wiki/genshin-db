					"패스벤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705300201,
					"content": "여행자! 여행자, 잠깐 기다려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300202
					],
					"speakerTitle": "패스벤"
				},
				{
					"id": 705300202,
					"content": "무슨 이벤트 담당자세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705300203
					]
				},
				{
					"id": 705300203,
					"content": "이벤트? 아니, 아니. 난 그럴 시간도 능력도 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300204
					],
					"speakerTitle": "패스벤"
				},
				{
					"id": 705300204,
					"content": "난 그저 「사진」에 관심이 많을 뿐이야. 얼마 전에 「사진기」를 구해서 사진을 잔뜩 찍었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300205
					],
					"speakerTitle": "패스벤"
				},
				{
					"id": 705300205,
					"content": "근데 모험가 길드에서 사진이 마음에 든 모양이야…. 사이러스 씨가 사진첩으로 만들어서 기념품으로 나눠줘도 되겠다고 하시더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300206
					],
					"speakerTitle": "패스벤"
				},
				{
					"id": 705300206,
					"content": "게다가 마침 윈드블룸 축제니까 몬드를 돌아다니면서 윈드블룸과 관련된 사진들을 찍어오라고 하셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300207
					],
					"speakerTitle": "패스벤"
				},
				{
					"id": 705300207,
					"content": "윈드블룸 축제 기념 사진첩을 만들어서 소속 모험가들한테 나눠주려는 모양이더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300208
					],
					"speakerTitle": "패스벤"
				},
				{
					"id": 705300208,
					"content": "하지만… 몬드에 찍을 곳은 넘치는데 내 몸은 하나고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300209
					],
					"speakerTitle": "패스벤"
				},
				{
					"id": 705300209,
					"content": "길드 모험가들도 다들 개인적인 사정이 있다며 도와줄 수 없대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300210
					],
					"speakerTitle": "패스벤"
				},
				{
					"id": 705300210,
					"content": "윈드블룸 축제 기간에 도움을 청하는 건 도리가 아니라고 생각하지만…. 여행자! 네가 「사진기」를 잘 다룬다고 들었어, 제발 나 좀 도와줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300211,
						705300213
					],
					"speakerTitle": "패스벤"
				},
				{
					"id": 705300211,
					"content": "잘은 아니고 그냥 조금…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705300212
					]
				},
				{
					"id": 705300212,
					"content": "후우… 그걸로 충분해. 역시 내가 들은 게 맞았군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300216
					],
					"speakerTitle": "패스벤"
				},
				{
					"id": 705300216,
					"content": "흠, 다시 본론으로 돌아와서…. 여행자, 정식으로 부탁할게. 몬드 곳곳을 돌아다니며 「사진기」에 윈드블룸 축제를 담아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300217
					],
					"speakerTitle": "패스벤"
				},
				{
					"id": 705300217,
					"content": "참, 내 「사진기」로 사진을 찍어도 좋아. 항상 정비해 놓으니까 손에 잘 맞을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300218
					],
					"speakerTitle": "패스벤"
				},
				{
					"id": 705300218,
					"content": "좋은 사진을 찍으려면 일단 좋은 「사진기」가 있어야 하지 않겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300219
					],
					"speakerTitle": "패스벤"
				},
				{
					"id": 705300219,
					"content": "그럼 부탁할게. 윈드블룸 축제와 관련이 있는 거라면 어떤 사진이든 괜찮아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300220
					],
					"speakerTitle": "패스벤"
				},
				{
					"id": 705300220,
					"content": "보수는 걱정하지 마, 허탕 칠 일 없게 길드 규정대로 정산해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300221
					],
					"speakerTitle": "패스벤"
				},
				{
					"id": 705300221,
					"content": "난 이곳에서 사진을 정리해야겠어. 일단 분류하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "패스벤"
				},
				{
					"id": 705300213,
					"content": "누구한테 들은 정보인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705300214
					]
				},
				{
					"id": 705300214,
					"content": "길드 모험가들에게 들었지. 그중에 「사진기」 애호가가 꽤 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300215
					],
					"speakerTitle": "패스벤"
				},
				{
					"id": 705300215,
					"content": "「사진기」 동호회를 만들까 생각 중이야. 사이러스 씨가 허락해줄지 모르겠지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705300216
					],
					"speakerTitle": "패스벤"
				}
			]
		}
	]
}