			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"「네코」",
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721640101,
					"content": "야옹… 그 상자가 효과가 있긴 하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640102
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640102,
					"content": "너구나, 그 「봉납함」 정말 효과가 있었다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640103
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640103,
					"content": "자네가 고치고 간 후, 초록 초록한 인간이 신사에 왔다 갔다, 야옹",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640104
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640104,
					"content": "그 키 크고 초록 초록한 인간은 안에다가 돈도 넣고, 내가 말하는 것을 듣고 엄청 좋아했어. 인간들은 정말 알 수가 없구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640105
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640105,
					"content": "「봉납함」은 정말 좋은 물건이구나, 하나 더 설치하면 사람들이 더 많이 오겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640106
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640106,
					"content": "그런 게 아니야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640107
					]
				},
				{
					"id": 721640107,
					"content": "그렇군, 인간들 일은 정말 복잡하군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640108
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640108,
					"content": "그 문제는, 아, 아마 신사의 환경이랑 상관있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721640109,
					"content": "내 신사가 어떻단 말인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640110,
						721640111
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640110,
					"content": "조금 더러운 것 같아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640112
					]
				},
				{
					"id": 721640112,
					"content": "그래? 하지만 그 녀석들은 낙엽 더미에서 노는 것을 좋아하던데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640113
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640113,
					"content": "아, 생각해 보니 히비키도 길쭉하고 삐죽삐죽한 나무 막대기로 낙엽을 한곳으로 모았었다. 히비키가 그렇게 했으면 그게 맞을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640114,
						721640115
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640114,
					"content": "어디 치울까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640116,
					"content": "내가 어떻게 인간들의 생각을 알겠는가. 음… 히비키라면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640117
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640117,
					"content": "해가 뜨기도 전에 히비키는 길쭉한 막대기를 들고 왔다 갔다 했어. 난 그 막대기를 쫓아다니는 것을 좋아했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640118
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640118,
					"content": "하지만 난 지금 「대리 궁사」인 몸. 그런 행동은 어울리지 않아. 난 평범한 녀석이 아니기 때문이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640119
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640119,
					"content": "하지만, 히비키는 바닥에 물을 자주 뿌렸지. 물은 나쁜 물건라네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640120
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640120,
					"content": "도메키도 가끔 와서 교차되어 있는 쇳조각으로 싹둑싹둑하니 나뭇잎이 떨어져 내렸다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640121,
						721640123
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640121,
					"content": "「도메키」?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640122
					]
				},
				{
					"id": 721640122,
					"content": "키도 엄청 크고, 목소리도 엄청 큰 인간이다. 히비키랑 자주 놀고는 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640125,
					"content": "쳇! 매번 내가 제일 좋아하는 나뭇가지를 자르는 얄미운 놈이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640126
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640126,
					"content": "들어보니… 「청소」, 혹은 「정리」가 맞네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721640127,
					"content": "바닥 쓸고, 물 뿌리고, 가지치기까지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721640128,
					"content": "다 익숙한 일이잖아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640129
					]
				},
				{
					"id": 721640129,
					"content": "그게 「청소」인 건가? 알겠으니 잘 부탁하겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640130
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640130,
					"content": "맞다, 싹둑싹둑은 하지 말게. 지금 나뭇가지가 마음에 드니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640131
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640131,
					"content": "길쭉한 막대기와 물만 하면 되네. 알아듣겠나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640132,
						721640133
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640132,
					"content": "우리에게 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640144
					]
				},
				{
					"id": 721640144,
					"content": "야옹, 이 일은 히비키가 나에게 전담하라고 한 나만 할 수 있는 중요한 일이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640133,
					"content": "맞다, 「히비키」는…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640134
					]
				},
				{
					"id": 721640134,
					"content": "히비키가 히비키지, 아사세 신사의 궁사야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640135
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 721640135,
