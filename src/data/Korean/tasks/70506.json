			"dialogs": [
				{
					"id": 705060101,
					"content": "안녕, 귀염둥이. 반가워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060102
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705060102,
					"content": "이런 곳에서 만날 일은 거의 없겠지만, 지금 내 기분도 리사랑 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060103
					],
					"speakerTitle": "진"
				},
				{
					"id": 705060103,
					"content": "어머, 「이런 곳」이라니? 술집은 릴랙스하기 아주 좋은 곳이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060104
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705060104,
					"content": "넌 상상도 못 할 거야. 이 바쁘신 분을 의자에서 일으켜서 데려오는 데 얼마나 오래 걸렸는지 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060105
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705060105,
					"content": "여기 온 지 얼마 되지도 않았는데, 진 얼굴 좀 봐. 또 근심이 가득해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060106
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705060106,
					"content": "리사…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060107
					],
					"speakerTitle": "진"
				},
				{
					"id": 705060107,
					"content": "기사단은 업무가 많으니까요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060108
					]
				},
				{
					"id": 705060108,
					"content": "맞아. 진은 단장 대행이니까 당연히 기사단 일이 마음에 걸리겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705060109,
					"content": "그런데 그런 말 있잖아…「기왕 왔으니까 즐겨라!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705060110,
					"content": "쟤한테 맛있는 거 만들어 달라고 해. 마시면 기분이 좋아질 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705060111,
					"content": "기분 전환하는 셈 치고요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060112
					]
				},
				{
					"id": 705060112,
					"content": "휴~ 릴랙스하는 법을 배워야 하는 건 진뿐인 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060113
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705060113,
					"content": "귀염둥이, 러브 포엠 한 잔 부탁해. 중간 사이즈로, 달콤하게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060114
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705060114,
					"content": "진은? 뭐 마실래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060115
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705060115,
					"content": "나는… 커피면 돼. 중간 사이즈로",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060116
					],
					"speakerTitle": "진"
				},
				{
					"id": 705060116,
					"content": "진 단장은 평소에 커피 많이 마시지 않아? 다른 걸 마셔봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705060117,
					"content": "고마워, 근데 잠 깨는 걸 마시고 싶어서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705060118
					],
					"speakerTitle": "진"
				},
				{
					"id": 705060118,
					"content": "네, 잠시만 기다려주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705060119
					]
				},
				{
					"id": 705060119,
					"content": "응, 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "진"
				}
			]
		},
