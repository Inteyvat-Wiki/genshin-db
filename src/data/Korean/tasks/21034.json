			"dialogs": [
				{
					"id": 210340501,
					"content": "여행자, 그쪽 야영지에 있던 마물은 모두 처리한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340502,
						210340503
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 210340502,
					"content": "모두 처리했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				},
				{
					"id": 210340504,
					"content": "평범한 마물들이라 금방 끝냈지. 게다가 운 좋게 꽤 괜찮은 검 조각을 찾았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340505
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 210340505,
					"content": "저쪽에선 아무것도 못 찾았어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340506
					]
				},
				{
					"id": 210340506,
					"content": "덕분에 그곳엔 아무것도 없다는 걸 알게 됐잖아, 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340507
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 210340507,
					"content": "이번 일의 보수야, 받아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340508,
						210340509
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 210340508,
					"content": "만약 모든 조각을 다 찾는다면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340510,
					"content": "내가 하고 싶은 건 간단해. 그건 바로… 「장봉」을 다시 만드는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340511
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 210340511,
					"content": "비록 「장봉」을 만들 때 사용한 도안도 잃어버렸고 어떤 재료를 사용했는지조차 모르지만… 분명 방법이 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340512
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 210340512,
					"content": "「장봉」을 다시 만든다면 오라버니도 분명… 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "란 누님"
				},
				{
					"id": 210340509,
					"content": "조각을 모아서 뭐 하시려고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340503,
					"content": "여긴 어떻게 됐나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				}
