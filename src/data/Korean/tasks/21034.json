			"dialogs": [
				{
					"id": 210340401,
					"content": "뭐야? 벌써 그쪽에 있던 마물을 처리한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340402
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 210340402,
					"content": "이곳의 마물을… 전부 다 처리하신 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340403
					]
				},
				{
					"id": 210340403,
					"content": "음? 당연하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340404
					],
					"speakerTitle": "란 누님"
				},
				{
					"id": 210340404,
					"content": "난 리월 모험가 길드 지부장이잖아. 평범한 마물 따위는 내 상대가 될 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
