				]
			},
			"dialogs": [
				{
					"id": 401490201,
					"content": "…향기 좋네요, 간도 딱 좋고 쌀알마다 풍미가 가득해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490202
					],
					"speakerTitle": "미카"
				},
				{
					"id": 401490202,
					"content": "막 나온 요리의 따끈따끈한 열기가 정말 그리웠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490203
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 401490203,
					"content": "흐응, 「기사단 최고의 전투 식량」보다 훨씬 맛있다니… 말해 봐, 이 요리 이름이 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490204
					],
					"speakerTitle": "유라"
				},
				{
					"id": 401490204,
					"content": "이… 요리는——이름이 없어, 「아무거나」라고 부를 순 없는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401490205,
					"content": "…이름도 없고, 재료나 조리법도 평범해서 어디서부터 소개해야 할지 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401490206,
					"content": "어, 재료랑 조리법이 평범하다고요? 분명 특별한 재료나 조리법이 있을 거라고 생각했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490207,
						401490208
					],
					"speakerTitle": "미카"
				},
				{
					"id": 401490207,
					"content": "이건 「가장 맛있는」 요리가 아니라…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490208,
					"content": "「가장 적절한」 요리라고 생각했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490209,
					"content": "「가장 맛있는」 게 아니라 「가장 적절한」 요리라니… 대, 대체 무슨 뜻이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490210,
						401490211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401490210,
					"content": "오랫동안 행군했잖아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490211,
					"content": "오랫동안 전투 식량만 먹었잖아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490212,
					"content": "배고파서 더 맛있게 느껴진다는 뜻인가요? 그게 전부는 아닌 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490213
					],
					"speakerTitle": "미카"
				},
				{
					"id": 401490213,
					"content": "…늘 차가운 전투 식량만 먹어서, 따끈따끈한 향기가 그리웠던 게 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490214
					],
					"speakerTitle": "유라"
				},
				{
					"id": 401490214,
					"content": "아, 이런 걸 「불맛」이라고 하죠? 어디서 들어본 것 같아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490215
					],
					"speakerTitle": "미카"
				},
				{
					"id": 401490215,
					"content": "맞아, 향기만 맡아도 「디어 헌터」 식당이 떠올라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490216
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 401490216,
					"content": "응? 「디어 헌터」가 떠오른다면, 리월 요리를 먹으러 온 의미가 없는 거잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401490217,
					"content": "맛이 아니라… 안심되는 느낌이랄까? 아, 집에 돌아온 느낌이랑 비슷해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490218
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 401490218,
					"content": "안심과… 집…? 설마 이게 바로 언소가 말한 「내 집 같은 편안함」인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401490219,
					"content": "세상에 절대적인 「미식」은 없어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490220
					]
				},
				{
					"id": 401490220,
					"content": "사람마다 입맛이 다른 법이니까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490221
					]
				},
				{
					"id": 401490221,
					"content": "하지만 요리사가…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490222
					]
				},
				{
					"id": 401490222,
					"content": "손님의 입장에서 생각하려는 정성은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490229,
					"content": "…누구에게나 통할 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490223,
					"content": "그래서 이 요리의 비결은 바로 「정성」인 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490224
					],
					"speakerTitle": "미카"
				},
				{
					"id": 401490224,
					"content": "뻔하고 케케묵은 말 같지만… 이 요리를 먹고 나니까 이해가 되네. 흠, 좋아. 이 레시피 기억해 두겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490225
					],
					"speakerTitle": "유라"
				},
				{
					"id": 401490225,
					"content": "레시피를 외웠으면 요리 이름도 외워야겠지? 이 요리의 이름을 정했어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490226,
						401490227
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 401490226,
					"content": "아직 생각 안 했는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490228
					]
				},
				{
					"id": 401490227,
					"content": "좋은 아이디어 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490228
					]
				},
				{
					"id": 401490228,
					"content": "음, 그럼… 「내 집 같은 편안함」 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				}
			]
