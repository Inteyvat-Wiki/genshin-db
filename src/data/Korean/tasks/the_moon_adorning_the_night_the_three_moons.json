			"dialogs": [
				{
					"id": 760540301,
					"content": "이렇게 하면 되나…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540302,
					"content": "으음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540303,
					"content": "어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540304,
					"content": "달… 달…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540305,
					"content": "여기는 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540306,
					"content": "이번엔 내가 이겼네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540307,
					"content": "내 달 세 개가 연결됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540308,
					"content": "음, 이러면 이겼다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540309,
					"content": "음… 달이 뜨고 지는 건 끝없는 반복이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540310,
					"content": "우리 달, 막상막하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540311,
					"content": "무승부인가…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540312,
					"content": "너는 신중히 생각하는 편이구나. 괜찮아, 시간은 많으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540313,
					"content": "「밤하늘」에 「달」을 어떻게 놓는지 잊었어? 내가 도와줄까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540314,
					"content": "이 게임 별로야? 난 재밌는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540315,
					"content": "응? 날 보는 거야? 느껴져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540316,
					"content": "내 얼굴에… 「달」에 관한 답이 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540317,
					"content": "「밤하늘」은 저쪽에 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540318,
					"content": "응, 네 「달」이 이겼어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540319,
					"content": "이 밤하늘은 이제 네 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540320,
					"content": "아… 실수했네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540321,
					"content": "콜롬비나와 게임을 하며 즐거운 시간을 보냈다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 761210202,
					"content": "세 개의 달이 한 줄을 이룬다라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210203
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761210203,
					"content": "왜 그래? 아직도 방금 한 달 바둑 생각해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761210204,
					"content": "응? 아니. 그냥… 지금 이 놀이를 다시 보니까 묘한 기분이 들어서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210205
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761210205,
					"content": "그러게. 넌 세 달의 힘을 얻었잖아. 그건 단순히 밤하늘을 다스리는 수준의 힘이 아니지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761210206,
					"content": "응. 문득 이런 생각이 들어. 그때 달의 여신 세 명의 의견이 다르지 않았다면, 세계의 운명이 바뀌지 않았을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210207
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761210207,
					"content": "달의 여신들은 어땠어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210208
					]
				},
				{
					"id": 761210208,
					"content": "음… 제일 처음 만난 건 무지개달 여신 소넷이었어. 상상했던 것보다 더 활발하고, 놀기 좋아하는 여동생 같았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210209
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761210209,
					"content": "영원달의 여신 아리아는 세 여신 중에 가장 차분하고 상냥하면서도 리더십이 있었어. 아, 꼭 라우마처럼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210210
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761210210,
					"content": "그리고 서리달의 여신 캐넌은… 지혜롭고 선견지명이 있는 여신이었지. 나에게 자기 달을 준 신이기도 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210211
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761210211,
					"content": "다 착한 신이었던 것 같네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210212
					]
				},
				{
					"id": 761210212,
					"content": "맞아. 서로 의견차는 있었지만, 셋 다 티바트라는 세계를, 이 집을 진심으로 사랑했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210213
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761210213,
					"content": "내가 미래를 말해 주니까 안도하는 내색이었지. 이 세계에 여전히 풍부한 미래가 있다는 데에 기뻐하는 듯했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210214
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761210214,
					"content": "그래서 내가 「집」으로 돌아갈 수 있도록, 나에게 힘을 준 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210215
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761210215,
					"content": "음… 그 여신들을 만나서 고맙다고 인사라도 하고 싶네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761210216,
					"content": "나도 그러고 싶지만… 그건 아마 불가능할 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210217
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761210217,
					"content": "그래도 이 세계는 계속 나아가고 있고, 그들이 지켜낸 인류도 살아남아서 세 여신의 이야기를 전하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210218
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761210218,
					"content": "맞아! 이 세계를 망치는 나쁜 녀석들을 막고 행복하게 잘 살아가면, 그게 세 여신에게 최고의 감사 인사일 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210219,
						761210220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761210219,
					"content": "말솜씨가 좋네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210220,
					"content": "그럼 페이몬은 매일 감사한 거네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210221,
					"content": "당연하지! 난 매일매일을 즐겁게 살아갈 거라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210222
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761210222,
					"content": "콜롬비나도 마찬가지야! 매일 잘 먹고 잘 자고, 놀고 싶으면 우리한테 와!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210223
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761210223,
					"content": "하하, 알겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210224
					],
					"speakerTitle": "「콜롬비나」"
				},
