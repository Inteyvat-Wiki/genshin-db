				},
				{
					"id": 761210102,
					"content": "콜롬비나, 안녕! 오늘 기분이 좋아 보이네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761210103,
					"content": "하하… 올라와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210104
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761210104,
					"content": "오! 또 「달 바둑」 하려고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761210105,
					"content": "응, 안 한 지 오래돼서 하고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210106
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761210106,
					"content": "규칙은 예전이랑 똑같아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210107
					]
				},
				{
					"id": 761210107,
					"content": "세 달의 여신이 됐다고 한 번에 여러 개를 놓을 수 있다거나 그런 건 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761210108,
					"content": "그건 반칙이잖아. 그런 방식으로 이기진 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210109
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 761210109,
					"content": "헤헤, 알지 알지. 농담이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761210110,
					"content": "그럼 시작해 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「콜롬비나」"
				}
			]
		},
