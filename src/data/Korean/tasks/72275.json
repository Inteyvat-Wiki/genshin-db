	"talks": [
		{
			"id": 7227501,
			"completionStepIds": [
				7227501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
