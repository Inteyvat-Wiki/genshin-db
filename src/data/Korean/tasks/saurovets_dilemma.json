					],
					"speakerTitle": "「쿠루룩」"
				},
				{
					"id": 750180901,
					"content": "정말 다쳐서 치료 중인 용 맞아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180904
					]
				},
				{
					"id": 750180904,
					"content": "웅… 꺅! 꺄꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180902
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180902,
					"content": "완치되면 만만치 않은 상대가 될 것 같아…. 그래도 지금은 기운이 좀 빠진 것 같으니 얼른 마즈카에게 데려다주자!",
					"roleType": "TALK_ROLE_NPC",
