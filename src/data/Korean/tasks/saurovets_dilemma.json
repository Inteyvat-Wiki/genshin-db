			"dialogs": [
				{
					"id": 750180101,
					"content": "——캬오오오!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180102
					],
					"speakerTitle": "「쿠루룩」"
				},
				{
					"id": 750180102,
					"content": "착하지~ 그만 떼쓰고 약 먹자? 안 그럼 몸이 나아지지 않아…. 아얏!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180103
					],
					"speakerTitle": "마즈카"
				},
				{
					"id": 750180103,
					"content": "#위험해! {NICKNAME}, 빨리 도와주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
