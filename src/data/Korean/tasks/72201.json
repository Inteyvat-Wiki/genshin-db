				"points": []
			},
			"dialogs": [
				{
					"id": 722010201,
					"content": "아하하하하하하… 하하… 하하하하!!! 아이고 숨 차… 하하하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010202
					],
					"speakerTitle": "레로"
				},
				{
					"id": 722010202,
					"content": "하하하하하 웃겨서 눈물이 다 나네!! 치카푸 당신도 있었으면 참 좋았을 텐데!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010203,
						722010204
					],
					"speakerTitle": "레로"
				},
				{
					"id": 722010203,
					"content": "조금 화나려고 하네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				},
				{
					"id": 722010205,
					"content": "아하하하, 미안해, 정말 미안해… 화내지 마, 사실은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010206
					],
					"speakerTitle": "레로"
				},
				{
					"id": 722010206,
					"content": "실은 나와 내 아내는 장난치는 걸 아주 좋아했어. 한 번도 같은 장난을 치지 않을 정도로 개구쟁이였지. 사람들도 다 재미있어했고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010207
					],
					"speakerTitle": "레로"
				},
				{
					"id": 722010207,
					"content": "근데, 아내가 병에 걸려서 일찍 떠났어… 떠나기 전에 남긴 말이, 자신의 무덤 앞에서 순진한 사람을 놀려달라는 부탁이었어. 아니면 눈을 감을 수 없다고 해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010208
					],
					"speakerTitle": "레로"
				},
				{
					"id": 722010208,
					"content": "아내의 마지막 소원이라서… 어때, 괜찮았는가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010209,
						722010210,
						722010211
					],
					"speakerTitle": "레로"
				},
				{
					"id": 722010209,
					"content": "정말 재미없었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010212,
					"content": "쯧쯧, 외부인은 정말 재미없군!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010213
					],
					"speakerTitle": "레로"
				},
				{
					"id": 722010213,
					"content": "이런 장난도 못 받아들이다니… 정말 재미없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010214
					],
					"speakerTitle": "레로"
				},
				{
					"id": 722010214,
					"content": "잘 가게, 난 가겠네, 간다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "레로"
				},
				{
					"id": 722010210,
					"content": "놀랐잖아요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010211,
					"content": "이제 어르신 말 안 믿을 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010204,
					"content": "무슨 상황이죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				}
			]
