					"nextDialogs": [
						411520304
					],
					"speakerTitle": "사라"
				},
				{
					"id": 411520304,
					"content": "만약 가는 길에 무슨 일이 생기면, 다시 만들어 드릴 테니 저한테 와주세요",
					"roleType": "TALK_ROLE_NPC",
