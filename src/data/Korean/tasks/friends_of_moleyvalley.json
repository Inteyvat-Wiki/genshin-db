						760240805,
						760240808
					],
					"speakerTitle": "아우니"
				},
				{
					"id": 760240802,
					"content": "소라단에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240803
					]
				},
				{
					"id": 760240803,
					"content": "가입하고 싶은 거예요? 그럼 「스페란자」에 있는 유르바 오빠를 찾아가 봐요. 음, 투표를 하고 싶다면… 헬카가 없네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240804
					],
					"speakerTitle": "아우니"
				},
				{
					"id": 760240804,
					"content": "하지만 괜찮아요. 유르바 오빠라면 다른 방법이 있을 테니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아우니"
				},
				{
					"id": 760240805,
					"content": "킁킁 두더지에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240806
					]
				},
				{
					"id": 760240806,
					"content": "계속 인간과 함께 살다 보니까 어떤 행동은 사람과 같아진 것 같아요. 보물 사냥 족제비도 그렇고요. 나타의 용도 그렇대요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240807
					],
					"speakerTitle": "아우니"
				},
				{
					"id": 760240807,
					"content": "근데 이게 좋은 일일까요, 나쁜 일일까요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아우니"
				},
				{
					"id": 760240808,
					"content": "이만 가 볼게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240809
					]
				},
				{
					"id": 760240809,
					"content": "조심해서 가세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아우니"
				}
			]
