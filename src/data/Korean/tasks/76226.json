			"dialogs": [
				{
					"id": 762260101,
					"content": "말라우스, 빨리 봐! 우리가 네 그림을 다 찾아왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762260102,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260103
					],
					"speakerTitle": "말라우스"
				},
				{
					"id": 762260103,
					"content": "헤헤, 천만에. 어쨌든 이 그림을 완성하는 데 우리도 한몫했으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762260104,
					"content": "페이몬은 언제부터 말라우스의 말을 알아듣게 된 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260105
					]
				},
				{
					"id": 762260105,
					"content": "아이참, 너랑 같이 달빛 정원에 몇 번이나 갔는데, 말라우스의 말을 알아듣는 것도 이상할 건 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762260106,
					"content": "그럼 말라우스는 그림을 어떻게 잃어버린 거래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260107
					]
				},
				{
					"id": 762260107,
					"content": "어… 그게… 내가 좀 생각해 볼게… 말라우스 말로는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762260108,
					"content": "다른 월령이 훔쳐갔을 수도 있고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762260109,
					"content": "음… 달에 있는 그 신기한 운송 장치가 훔쳐 갔을지도 모른대…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762260110,
					"content": "음… 아니면 콜롬비나가 훔쳐 갔거나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762260111,
					"content": "그럴 리가 없잖아!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260112
					]
				},
				{
					"id": 762260112,
					"content": "어? 그러게… 내가 잘못 알아들은 건가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762260113,
					"content": "대충 때려 맞힌 거였구나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260114
					]
				},
				{
					"id": 762260114,
					"content": "흥, 외국어를 배우는 게 쉬운 일은 아니라구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762260115,
					"content": "좋은 선생님이 필요해. 나중에 기회가 생기면 콜롬비나한테 제대로 가르쳐 달라고 부탁해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
