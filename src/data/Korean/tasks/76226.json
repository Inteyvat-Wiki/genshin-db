			"dialogs": [
				{
					"id": 762260201,
					"content": "어? 말라우스잖아? 달에서 만나게 될 줄은 몰랐는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762260202,
					"content": "콜롬비나가 널 데려온 거지? 달에서 전시회를 열겠다고 했으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762260203,
					"content": "참, 전시회 얘기가 나와서 말인데… 네 그림은 어딨어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762260204,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260205
					],
					"speakerTitle": "말라우스"
				},
				{
					"id": 762260205,
					"content": "왜 그래? 설마… 그림을 잃어버린 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762260206,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260207
					],
					"speakerTitle": "말라우스"
				},
				{
					"id": 762260207,
					"content": "뭐라고? 여긴 달이잖아, 도둑맞은 건 아닐 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 762260208,
					"content": "어쨌든 일단 말라우스를 도와 그림을 찾아보자. 근처에 떨어졌을 수도 있으니까",
