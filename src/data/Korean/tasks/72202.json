				"points": []
			},
			"dialogs": [
				{
					"id": 722020101,
					"content": "뇌조 님… 절 버리신 건가요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020102,
						722020103
					],
					"speakerTitle": "치세"
				},
				{
					"id": 722020102,
					"content": "안녕하세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				},
				{
					"id": 722020104,
					"content": "뇌조 님… 화내지 마세요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020105
					],
					"speakerTitle": "치세"
				},
				{
					"id": 722020105,
					"content": "당신의 뜻과 가르침을 읽고 이해하려고 최선을 다했는데… 하지만… 왜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020106
					],
					"speakerTitle": "치세"
				},
				{
					"id": 722020106,
					"content": "도대체… 왜 저를 거절하시는 거죠… 왜… 훌쩍… 훌쩍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020107
					],
					"speakerTitle": "치세"
				},
				{
					"id": 722020107,
					"content": "저는 왜… 당신의 안갯속으로 들어갈 수 없는 건가요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020108,
						722020113
					],
					"speakerTitle": "치세"
				},
				{
					"id": 722020108,
					"content": "읽다니…? 무슨 말씀하시는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020109,
					"content": "뇌조 님이 남기신 뇌석은… 제가 방법을 생각해 볼게요… 은빛 나룻배가 왔으니, 남은 시간도 얼마 없네요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020110
					],
					"speakerTitle": "치세"
				},
				{
					"id": 722020110,
					"content": "뇌석은… 또 뭐죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020111
					]
				},
				{
					"id": 722020111,
					"content": "아우타케 들판의 뇌석… 번개를 다룰 줄 아는 사람만이 그들을 살릴 수 있고… 안개 속에서 길을 찾을 수 있는 사람만이 뇌석을 찾을 수 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020112
					],
					"speakerTitle": "치세"
				},
				{
					"id": 722020112,
					"content": "우뚝 선 뇌조 님처럼… 뇌조 님의 활짝 펼쳐진 날개처럼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "치세"
				},
				{
					"id": 722020113,
					"content": "안개는… 이미 사라지지 않았나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020103,
					"content": "도움이 필요하신가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				}
			]
		},
