					"기란"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210614,
					"content": "좋…아! 이 정도면 됐어, 이제 어떻게 되려나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210601
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210601,
					"content": "으악! 저쪽에서 물이 새고 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210615
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230210615,
					"content": "뭐야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210602
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210602,
					"content": "배, 배가 기울고 있어! 이게 무슨 일이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210603
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230210603,
					"content": "어, 어서 물건들을 밖으로 옮겨. 뭔가 문제가 생긴 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210604
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210604,
					"content": "라픽과 함께 서둘러 모든 물건을 배에서 내린다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230210605
					]
				},
				{
					"id": 230210605,
					"content": "후… 후… 물건이 얼마 없어서 다행이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210606
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210606,
					"content": "도대체… 도대체 뭐가 잘못된 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210607
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210607,
					"content": "제가 말했잖아요? 라픽 씨가 계산한 이론 수치는 너무 극단적이라고. 그런 배가 제대로 움직일 리가 없죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210608
					],
					"speakerTitle": "기란"
				},
				{
					"id": 230210608,
					"content": "후… 나… 난… 알겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210609
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210609,
					"content": "그럴 리가 없는데… 계산은 완벽했단 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210610
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210610,
					"content": "여행자, 도와줘서 고마워. 이건 보수니까 챙겨둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210611
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210611,
					"content": "난 돌아가서 다시 계산해 봐야겠어…. 기란, 날 도와줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210612
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210612,
					"content": "…전 항상 라픽 씨를 도왔잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210613
					],
					"speakerTitle": "기란"
				},
				{
					"id": 230210613,
					"content": "제게 맡겨요. 계산이 끝나면 저한테 커피 사는 거 잊지 마시구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "기란"
				}
			]
		},
