					"기란"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210101,
					"content": "여행자! 마침 잘 왔어, 선박 운행이 방금 막 시작됐는데, 아주 안정적이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210102
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210102,
					"content": "역시 내 계산은 완벽했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210103
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210103,
					"content": "그래서 적재 실험은 언제 시작하는 거죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210104
					],
					"speakerTitle": "기란"
				},
				{
					"id": 230210104,
					"content": "뭐가 그렇게 급해? 여행자도 왔으니까 지금 바로 시작하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210105
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210105,
					"content": "적재 실험이 뭔데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210106
					]
				},
				{
					"id": 230210106,
					"content": "쉽게 말해 무거운 물건으로 배의 적재 능력을 테스트하는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210107
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210107,
					"content": "음… 그러니까 나랑 같이 이 물건들을 배로 옮겨줄 사람이 필요하단 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210108
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210108,
					"content": "여행자, 저번에 보니까 몸도 튼튼하고 힘도 잘 쓰는 것 같더라. 이런 일도 참 잘할 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210109,
						230210110
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210109,
					"content": "그래서 절 부른 거였어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				},
				{
					"id": 230210111,
					"content": "아, 아니야. 나 혼자서는 도저히 감당이 안 돼서 너한테 도와달라고 부탁하는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210112
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210112,
					"content": "그리고 보수는 넉넉하게 챙겨줄 테니까 걱정하지 마! 며칠 전에 큰 선박을 고친 덕분에 돈도 두둑하게 벌었다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210113
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210113,
					"content": "오… 두둑하게 벌었다구요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210114
					],
					"speakerTitle": "기란"
				},
				{
					"id": 230210114,
					"content": "음? 그게, 거의 모든 돈을 배를 만드는 데 사용하긴 했지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210115
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210115,
					"content": "전부요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210116
					],
					"speakerTitle": "기란"
				},
				{
					"id": 230210116,
					"content": "조금 남겨두긴 했어! 알았어, 내가 커피 살게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210117
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210117,
					"content": "여행자, 빨리 시작하자, 빨리!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210110,
					"content": "화가 나네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				}
			]
		},
		{
			"id": 2302106,
			"completionStepIds": [
				2302106
			],
