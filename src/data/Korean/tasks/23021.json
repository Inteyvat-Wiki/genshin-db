			},
			"dialogs": [
				{
					"id": 230210801,
					"content": "아주 좋아. 성공적이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210802
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210802,
					"content": "선박 구조도 문제없고… 워터 라인도 전혀 기울지 않고 안정적이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210803
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210803,
					"content": "기란, 이것 좀 봐. 설계도 계산도 완벽해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210804
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210804,
					"content": "이제 겨우 적재 실험의 첫 단계를 마친 것뿐이에요. 벌써 기뻐하긴 일러요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210805
					],
					"speakerTitle": "기란"
				},
				{
					"id": 230210805,
					"content": "게다가 날씨 변수나 항해 중 화물을 옮길 때 선박의 중심이 이동하는 건 전혀 계산에 넣지 않았잖아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210806
					],
					"speakerTitle": "기란"
				},
				{
					"id": 230210806,
					"content": "윽… 내가 알아서 할 테니까 일단 지금은 마음껏 기뻐하게 해줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210807
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210807,
					"content": "참, 여행자, 이건 보수니까 받아둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210808
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210808,
					"content": "기란, 날 응원해 줄 순 없는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210809
					],
					"speakerTitle": "라픽"
				},
				{
					"id": 230210809,
					"content": "응원을 해준다고 좋은 배를 만들 수 있는 건 아니죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210810
					],
					"speakerTitle": "기란"
				},
				{
					"id": 230210810,
					"content": "어떻게 하면 돈을 벌 수 있을지나 생각해 봐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "기란"
				}
			]
		},
