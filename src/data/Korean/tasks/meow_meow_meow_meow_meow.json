			},
			"dialogs": [
				{
					"id": 230120101,
					"content": "야옹—— 쿨럭, 쿨럭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120102
					],
					"speakerTitle": "사레"
				},
				{
					"id": 230120102,
					"content": "뭐 하고 계세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120103
					]
				},
				{
					"id": 230120103,
					"content": "우리 집 고양이들을 찾고 있어. 평소엔 이렇게 부르면 바로 나타났거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120104
					],
					"speakerTitle": "사레"
				},
				{
					"id": 230120104,
					"content": "혹시 오늘 내 발음이 이상한 건가? 한참 불렀는데도 안 나오네. 이상하게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120105,
						230120109
					],
					"speakerTitle": "사레"
				},
				{
					"id": 230120105,
					"content": "그냥 이름을 부르는 건 어때요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120106
					]
				},
				{
					"id": 230120106,
					"content": "그러게, 고양이 찾을 땐 보통 이름을 부르지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230120107,
					"content": "하지만 인간의 언어로 고양이의 이름을 불러봤자 고양이는 못 알아들을 텐데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120108
					],
					"speakerTitle": "사레"
				},
				{
					"id": 230120108,
					"content": "엥? 그, 그 말도 일리가 있네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230120113,
					"content": "그치만 이렇게 계속 부르기만 하는 것도 능사는 아니야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120114
					],
					"speakerTitle": "사레"
				},
				{
					"id": 230120114,
					"content": "저기 여행자, 진지한 질문 하나 할게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120115,
						230120116
					],
					"speakerTitle": "사레"
				},
				{
					"id": 230120115,
					"content": "맡겨 주세요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120117,
					"content": "…혹시 「고양이 언어」 배우고 싶지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120118
					],
					"speakerTitle": "사레"
				},
				{
					"id": 230120118,
					"content": "엥?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120119
					]
				},
				{
					"id": 230120119,
					"content": "응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230120120,
					"content": "고양이 말을 가르쳐주겠다는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230120116,
					"content": "보수는…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120117
					]
				},
				{
					"id": 230120109,
					"content": "「오늘 발음」이 이상하다뇨?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120110
					]
				},
				{
					"id": 230120110,
					"content": "내가 방금 낸 「야옹」 소리가 고양이들의 이름이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120111
					],
					"speakerTitle": "사레"
				},
				{
					"id": 230120111,
					"content": "고양이들은 인간의 언어로 지어진 이름은 못 알아들을 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120112
					],
					"speakerTitle": "사레"
				},
				{
					"id": 230120112,
					"content": "엥? 그, 그 말도 일리가 있네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120113
					],
					"speakerTitle": "페이몬"
				}
			]
		},
