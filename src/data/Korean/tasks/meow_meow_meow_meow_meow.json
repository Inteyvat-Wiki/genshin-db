			},
			"dialogs": [
				{
					"id": 230120301,
					"content": "고양이를 데려왔구나. 정말 수고했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120302
					],
					"speakerTitle": "사레"
				},
				{
					"id": 230120302,
					"content": "「고양이 언어」를 제대로 배운 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120303
					],
					"speakerTitle": "사레"
				},
				{
					"id": 230120303,
					"content": "도와줘서 고마워. 자, 받아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120304
					],
					"speakerTitle": "사레"
				},
				{
					"id": 230120304,
					"content": "이렇게 빨리 「고양이 언어」를 배운 사람은 정말 드문데. 다음에 또 부탁하게 될지도 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120305
					],
					"speakerTitle": "사레"
				},
				{
					"id": 230120305,
					"content": "야옹!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120306
					]
				},
				{
					"id": 230120306,
					"content": "인간 말을 해! 사레는 고양이가 아니라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230120307,
					"content": "네 표정을 보니 「문제없어」라고 하고 싶은 것 같은데… 발음이 부정확했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120308
					],
					"speakerTitle": "사레"
				},
				{
					"id": 230120308,
					"content": "뭐, 괜찮아. 앞으로도 계속 「고양이 언어」를 배울 거니까. 우리 같이 배우자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사레"
				}
			]
		},
