			"dialogs": [
				{
					"id": 700270101,
					"content": "마침 잘 왔어, 「푸르시나 볼트」의 보수 공사는 순조롭게 진행되고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270102
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700270102,
					"content": "이 부품만 있으면 최대한 빨리 고칠 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270103
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700270103,
					"content": "제가 조금 구해왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270104
					]
				},
				{
					"id": 700270104,
					"content": "다행이다, 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270105
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700270105,
					"content": "이 부품만 있으면 최대한 빨리 고칠 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270106
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700270106,
					"content": "하지만 너랑 상의할 일이 조금 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270107
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700270107,
					"content": "네가 부품을 수집하러 간 사이 「푸르시나 볼트」의 내부 구조를 자세히 연구해봤는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270108
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700270108,
					"content": "구조가 정말 정교해. 과연 푸르시나 선배님의 작품이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270109
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700270109,
					"content": "한 부품의 미세한 조정만으로도 전체적인 기능에 영향을 미쳐. 그래서 우리가 예상했던 효과가 제대로 나올지 걱정이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270110
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700270110,
					"content": "만약의 상황을 대비해서 네가 먼저 시험적으로 사용해봐. 나는 사용 기간의 데이터를 바탕으로 장치를 조정할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270111
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700270111,
					"content": "그렇게 해야 「푸르시나 볼트」의 최종적인 효과를 장담할 수 있을 거 같아. 나중에 특이 기체랑 싸울 때 고장이라도 나면 큰일이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270112,
						700270113
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700270112,
					"content": "정말 신중하시네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				},
				{
					"id": 700270114,
					"content": "나도 「푸르시나 볼트」의 조작은 처음이거든. 신중한 게 좋지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700270115
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700270115,
					"content": "그럼 최대한 많이 사용해 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700270113,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700270114
					]
				}
			]
		}
	]
