			},
			"dialogs": [
				{
					"id": 230180201,
					"content": "이 약은 약초밭의 구르겐한테 전해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180202
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180202,
					"content": "일할 때 힘을 너무 많이 썼나 봐. 팔을 좀 다쳤대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180203
					],
