			},
			"dialogs": [
				{
					"id": 230181401,
					"content": "이번 약은 농가에 있는 아프탑 씨에게 줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181402
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230181402,
					"content": "평소에 어류나 육류를 너무 드신 탓에 위장 건강이 나빠지셨거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181403
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230181403,
					"content": "이 약을 아프탑 씨한테 전해 주면서 이렇게 말해줘. 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181404
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230181404,
					"content": "고기와 술을 줄이고 건강한 음식을 드셔야 풀의 신의 은혜를 더 잘 받을 수 있다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181405,
						230181406
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230181405,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181408
					]
				},
				{
					"id": 230181408,
					"content": "약 배달이 끝나면 다시 나한테 와. 보수는 미리 준비해둘게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230181406,
					"content": "그런 말은 또 어디서 들은 거예요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181407
					]
				},
				{
					"id": 230181407,
					"content": "아카데미아에 진짜 이렇게 하는 학자도 있다고 하더라고. 이유는 잘 모르겠지만 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181408
					],
					"speakerTitle": "자카리야"
				}
			]
		},
