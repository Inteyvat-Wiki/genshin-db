			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"자카리야"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180101,
					"content": "휴, 정말 사람을 귀찮게 한다니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180102,
						230180103
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180102,
					"content": "도와드릴까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180119
					]
				},
				{
					"id": 230180119,
					"content": "요즘 일손이 부족해서 며칠 동안 제대로 못 쉬었거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180120
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180120,
					"content": "여행자, 시간 날 때 근처에 있는 환자들에게 약을 배달해 줄 수 있을까? 환자들 상태도 확인하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180121,
						230180124
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180121,
					"content": "맡겨만 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180122
					]
				},
				{
					"id": 230180122,
					"content": "그럼 부탁할게. 풀의 신을 봐서라도… 난 항상 풀의 신의 가호를 입에 달고 살지 않는 사람의 도움이 필요했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180123
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180123,
					"content": "하, 풀의 신을 봐서라도…라는 말이 자연스럽게 나오다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180124,
					"content": "일단 좀 쉬는 게 좋겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180125
					]
				},
				{
					"id": 230180125,
					"content": "난 아직 쉴 수 없어. 더 심각한 환자들은 다른 곳에 있거든. 그 환자들 약을 만들어야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180126
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180126,
					"content": "휴, 오늘도 환자들은 물어보겠지. 어떻게 해야 풀의 신의 은혜를 더 많이 받을 수 있냐고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180127
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180127,
					"content": "부탁할게, 여행자. 난 풀의 신의 가호를 입에 달고 살지 않는 사람이 날 돕길 간절히 바라고 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180103,
					"content": "무슨 일이에요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180104
					]
				},
				{
					"id": 230180104,
					"content": "여행자구나? 여긴 「비마르{RUBY#[D]건강의 집}스탄」이야. 대중들에게… 풀의 신의 은혜를 내리는 병원이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180105
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180105,
					"content": "가난한 사람이든 부자든, 우리는 모든 사람에게 공평한 의료 서비스를 제공하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180106
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180106,
					"content": "그래서인지… 요즘 진료받으러 오는 환자들이 점점 더 늘고 있어. 요즘은 일손이 너무 부족하다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180107
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180107,
					"content": "휴, 비록 풀의 신께서 우리에게 주시는 은혜는 무한하지만… 병원의 예산과 인력에는 한계가 있단 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180108
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180108,
					"content": "어떤 환자들은 의사의 조언 같은 건 전혀 관심이 없고 어떻게 풀의 신의 은혜를 더 많이 받을 수 있을지 끈질기게 묻곤 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180109
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180109,
					"content": "하하, 풀의 신의 은혜라니… 젠장!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180110
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180110,
					"content": "풀의 신께서 정말 은혜를 베푸셨다면 애초에 아프지도 않았겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180111
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180111,
					"content": "후… 미안, 이런 말은 하면 안 되는데. 골샨한테는 절대 말하지 마. 잔소리 폭격이 시작될 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180112,
						230180115
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180112,
					"content": "당신은 풀의 신을 믿는 독실한 신도가 아닌가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180113
					]
				},
				{
					"id": 230180113,
					"content": "믿긴 믿지. 수메르성에서 풀의 신을 믿지 않는 사람이 어디 있겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180114
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180114,
					"content": "하지만 독실하다는 단어는 빼줘. 난 뭐랄까… 상대적으로 이성적인 신도라고 볼 수 있지. 하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180118,
					"content": "윽… 미안. 내가 너무 피곤해서 짜증이 많이 났나 봐. 너무 진지하게 받아들이진 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180119
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180115,
					"content": "어떤 사람들은 치료 행위 자체가 풀의 신의 은혜라고 하던데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180116
					]
				},
				{
					"id": 230180116,
					"content": "휴, 그런 말은 그냥 한 귀로 듣고 한 귀로 흘려. 환자들 말을 전부 다 믿으면 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180117
					],
					"speakerTitle": "자카리야"
				},
				{
					"id": 230180117,
					"content": "풀의 신이 정말 그렇게 전지전능한 존재라면 환자들에게 대충 버섯이나 먹여도 병이 씻은 듯이 낫겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "자카리야"
				}
			]
		},
