			"dialogs": [
				{
					"id": 80000201,
					"content": "저기… 사람 같은데?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80000202,
					"content": "설마… 「대보물사냥가」?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80000203,
					"content": "저 자세… 뭔가에 「기도」하고 있는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000204
					],
