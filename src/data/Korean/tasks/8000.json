					"nextDialogs": [
						80000213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80000213,
					"content": "이봐, 괜찮아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80000214,
					"content": "(아무 반응도 없고 숨소리도 들리지 않는다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000215
					]
				},
				{
					"id": 80000215,
					"content": "…주, 죽었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80000216,
					"content": "#{NICKNAME}, 느낌이 안 좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000217,
						80000218
					],
					"speakerTitle": "페이몬"
