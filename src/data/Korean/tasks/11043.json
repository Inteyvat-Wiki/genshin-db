					"알베도"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110430101,
					"content": "우리더러 이렇게 높은 곳에서 뛰어내리란 건 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110430102,
					"content": "그럼, 너희에게 훨씬 더 좋은 방법이 있다면 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430103,
						110430104
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430103,
					"content": "방법을 찾아야겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430105
					]
				},
				{
					"id": 110430105,
					"content": "어떻게든 호수 건너편에 도착하면 실험은 끝나는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430106
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430106,
					"content": "도착 시간과 최고 속도로 비교 분석할 생각이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430107
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430107,
					"content": "호수 건너편이라면, 그러니까 얘더러 설산에서 헤엄치라구?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110430108,
					"content": "아무런 조건이 없을 때, 인간은 본능적으로 가장 합리적이라고 생각하는 방법을 택해 목표를 이루지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430109
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430109,
					"content": "얼어붙은 호수를 견딜 수 없는 사람도 있지만, 또 어떤 사람은 이런 차디찬 느낌을 좋아할 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430110
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430110,
					"content": "너희가 어떤 선택을 하건 다 실험의 일부야. 연구 가치가 아주 높다고 할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430111,
						110430112
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430111,
					"content": "내게 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430113
					]
				},
				{
					"id": 110430113,
					"content": "그럼 부탁해. 네 선택이 무척 기대되는 걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430112,
					"content": "초능력에 비하면 이건 식은 죽 먹기야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430113
					]
				},
				{
					"id": 110430104,
					"content": "애매한 대답이 제일 무서워",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430105
					]
				}
			]
		},
		{
			"id": 1104303,
			"completionStepIds": [
				1104303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
