				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"알베도"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110430301,
					"content": "고생했어, 아주 대단하던데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430302
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430302,
					"content": "역시 소문이 자자한 여행자다워. 모든 항목의 수치가 몬드의 평균보다 훨씬 높아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430303
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430303,
					"content": "넌 우릴 계속 따라왔는데 어째 헐떡거리지도 않네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110430304,
					"content": "나? 난 연금술로 게으름 좀 피웠지. 아무튼 그게 중요한 게 아냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430305
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430305,
					"content": "네가 티바트의 법칙에 영향을 받지 않는다면, 네가 온 곳의 문명에 대해 몇 가지 추측해볼 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430306
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430306,
					"content": "네가 티바트의 법칙에 영향을 받는다 해도, 영향을 받지 않으면 어떤 변화가 일어날지 추측해 볼 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430307
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430307,
					"content": "그 안에 담겨있는 무한한 가능성, 정말 흥미로워. 계속 되새겨볼 만해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430308
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430308,
					"content": "근데… 그게 네 연구에 무슨 도움이 되는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110430309,
					"content": "오랫동안 날 괴롭히던 문제가 풀렸어. 야영지로 돌아가면 너희에게 특별한 걸 만들어줄 수 있을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430310
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430310,
					"content": "다른 것도 이렇게 연구해본 적 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430311
					]
				},
				{
					"id": 110430311,
					"content": "이상한 것들이랑 같은 취급 당한다고 언짢을 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430312
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430312,
					"content": "황금, 석화 고목, 8배 큰 태양——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430313
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430313,
					"content": "본질을 탐구하는 과정은 매력적이지. 아쉽게도 이런 황홀한 시간은 잠시뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430314
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430314,
					"content": "그래도 난 온 힘을 다 쏟고 싶어. 하지만 샘플은 한계가 있지. 모르는 걸 알게 되면서 그 재미는 점점 사라져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430315
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430315,
					"content": "그러다가 결국 일몰 열매나 달콤달콤꽃처럼, 더 이상 시간을 쏟을 가치도 없는 평범한 존재가 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430316
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430316,
					"content": "오, 그래서 네가 츄츄족들을 그렇게 차이 나게 그렸던 거구나!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110430317,
					"content": "맞아, 그때 「시간을 낭비할 가치도 없다」고 말했었지. 왜냐하면 그들에게 흥미를 잃은 지 오래였거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430318
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430318,
					"content": "그럼 실험이 끝나고 우리도 재미없는 존재가 되는 거야? …음, 원고 쪼가리처럼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110430319,
					"content": "그건 걱정하지 마. 너희는 날 도와줬잖아. 우정은 절대 잊지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430320
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430320,
					"content": "자, 야영지로 돌아가기 전에 마지막 항목, 지능 테스트를 진행하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430321
					],
					"speakerTitle": "알베도"
				},
				{
					"id": 110430321,
					"content": "날 따라와. 이제 다른 쪽에 있는 유적으로 갈 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "알베도"
				}
			]
		},
