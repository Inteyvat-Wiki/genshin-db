			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아규",
					"소몽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280201,
					"content": "어서 오세요. 약을 지으러 오셨나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280202
					],
					"speakerTitle": "아규"
				},
				{
					"id": 210280202,
					"content": "어? 소몽이구나? 여긴 어쩐 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280203
					],
					"speakerTitle": "아규"
				},
				{
					"id": 210280203,
					"content": "아… 알겠다, 저번에 말한 그 약들 때문에 그런 거구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280204
					],
					"speakerTitle": "아규"
				},
				{
					"id": 210280204,
					"content": "거의 다 준비됐어. 나중에 약이 만들어지는 대로 소몽이의 아빠한테 보내줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280205
					],
					"speakerTitle": "아규"
				},
				{
					"id": 210280205,
					"content": "하지만 주문한 양이 너무 많아서 약재 재고가 부족해. 그래서 시간이 걸리는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280206
					],
					"speakerTitle": "아규"
				},
				{
					"id": 210280206,
					"content": "어디 보자, 음… 민트가 얼마 안 남아서 일사병 방지약은 만들기 어려울 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280207
					],
					"speakerTitle": "아규"
				},
				{
					"id": 210280207,
					"content": "아빠가 주문한 약 외에, 다른 환자들을 위한 약도 조금 남겨둬야 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280208
					],
					"speakerTitle": "아규"
				},
				{
					"id": 210280208,
					"content": "그럼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280209,
						210280211
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280209,
					"content": "내가 나설 차례인 거 같네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280210
					]
				},
				{
					"id": 210280210,
					"content": "#헤헤, 정말 고마워요! {F#누나}{M#형}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280213,
					"content": "그럼 약재를 부탁할게요. 전 이곳에 남아서 약들을 체크해야 하거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280214
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280214,
					"content": "꼬맹이 녀석, 정말 기특하구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280215
					],
					"speakerTitle": "아규"
				},
				{
					"id": 210280215,
					"content": "그럼 날 따라와, 약 목록을 보여줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280216
					],
					"speakerTitle": "아규"
				},
				{
					"id": 210280216,
					"content": "우와… 왜 이렇게 많죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280217
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280217,
					"content": "일단 이것들부터 보고 있어. 남은 것들도 들고 올게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280218
					],
					"speakerTitle": "아규"
				},
				{
					"id": 210280218,
					"content": "네? 더 있다고요?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280211,
					"content": "세상엔 공짜는 없다고",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280212
					]
				},
				{
					"id": 210280212,
					"content": "#헤헤, 알고 있어요, 고마워요! {F#누나}{M#형}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "소몽"
				}
			]
		},
