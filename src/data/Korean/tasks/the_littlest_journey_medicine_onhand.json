			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"소몽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280101,
					"content": "#{F#누나}{M#형}! 마침 잘 왔어요, {F#누나를}{M#형을} 찾아가려고 했는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280102,
						210280103
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280102,
					"content": "무슨 일이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280105
					]
				},
				{
					"id": 210280105,
					"content": "아빠가 수메르까지 긴 여정이 될 거라면서, 필요한 약들을 준비해야 한대요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280106
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280106,
					"content": "두통약, 설사약, 일사병 방지약, 숙취해소제, 소화제 등등… 종류가 엄청 많아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280107
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280107,
					"content": "숙취해소제는 왜 필요한 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 210280108,
					"content": "사업 얘기할 때 쓰려는 건가",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280109
					]
				},
				{
					"id": 210280109,
					"content": "응? 사업 이야기랑 숙취해소제랑 무슨 상관인데? 설마 술을 많이 마시면 사업이 잘 되기라도 해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 210280110,
					"content": "어쨌든 아빠가 저한테 「불복려」에 가서 약들이 다 준비됐는지 확인해 보라고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280111
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280111,
					"content": "#{F#누나}{M#형}, 저랑 같이 가주실 수 있어요? 부탁할게 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280112,
						210280113
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280112,
					"content": "가자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280115
					]
				},
				{
					"id": 210280115,
					"content": "#{F#누나}{M#형}, 그럼 출발!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280113,
					"content": "어떤… 부탁인데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280114
					]
				},
				{
					"id": 210280114,
					"content": "가서 얘기해 줄게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280115
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280103,
					"content": "여행 준비는 잘 돼가고 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280104
					]
				},
				{
					"id": 210280104,
					"content": "준비는 아빠랑 삼촌들이 다 하죠… 근데 아빠가 저한테도 임무를 주셨어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280105
					],
					"speakerTitle": "소몽"
				}
			]
		},
		{
