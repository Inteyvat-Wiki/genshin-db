			"dialogs": [
				{
					"id": 210280401,
					"content": "#{F#누나}{M#형}, 고마워요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280402
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280402,
					"content": "음, 이 정도면 충분할 거 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280403
					],
					"speakerTitle": "아규"
				},
				{
					"id": 210280403,
					"content": "일사병을 치료하는 약은 다음 약들을 보낼 때 같이 보내줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280404
					],
					"speakerTitle": "아규"
				},
				{
					"id": 210280404,
					"content": "그럼 부탁드려요, 아규 형",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280405
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280405,
					"content": "#이거 받아주세요, 도와주셔서 정말 감사해요. {F#누나}{M#형}, 우리는 돌아가요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280406
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280406,
					"content": "헤헤, 아빠가 알면 분명 기뻐하실 거예요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280407
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280407,
					"content": "소몽아, 잠깐만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280408
					],
					"speakerTitle": "아규"
				},
				{
					"id": 210280408,
					"content": "왜요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280409
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280409,
					"content": "약 검사하러 온 거 아니니? 아직 뒤쪽 리스트는 확인 다 안 했단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280410
					],
					"speakerTitle": "아규"
				},
				{
					"id": 210280410,
					"content": "에… 네? 아까 그렇게 오래 검사했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280411
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210280411,
					"content": "얼마나 했다고 그래, 자 그럼 검사를 계속해 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280412
					],
					"speakerTitle": "아규"
				},
				{
					"id": 210280412,
					"content": "윽… 네… 알겠어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소몽"
				}
			]
