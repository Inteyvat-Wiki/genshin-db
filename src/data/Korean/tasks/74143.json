			"dialogs": [
				{
					"id": 741430201,
					"content": "얘들아! …너… 너희… 내가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430202
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 741430202,
					"content": "응? 무슨 일이야? 왜 그렇게 숨을 가쁘게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741430203,
					"content": "라느와, 라느와가 어떤 츄츄족에게 납치를 당했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430204
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 741430204,
					"content": "뭐? 어떻게 그럴 수가!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741430205,
					"content": "저쪽을 향해 갔어! 난 가서 사람을 불러올 테니 너희가 가서 상황을 봐다오. 부탁한다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430206
					],
					"speakerTitle": "언쇼"
				},
				{
					"id": 741430206,
					"content": "알겠어! 빨리 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7414304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
