						"pointId": 6841
					}
				]
			},
			"dialogs": [
				{
					"id": 741430401,
					"content": "너희구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430402
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430402,
					"content": "뭐야! 캐터필러였잖아? 나 참, 내가 얼마나 걱정했는지 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741430403,
					"content": "#와! {NICKNAME} {M#오빠}{F#언니}랑 페이몬 언니다! 나 너무 기뻐. 내가 가장 좋아하는 사람들이 모두 모였잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430404
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430404,
					"content": "게다가 외할아버지가 엄청 크고 달콤한 「생일 케이크」를 구워줬어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430405
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430405,
					"content": "오, 오늘이 라느와 생일이구나! 생일 축하해! 저… 케이크는 좀 남았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741430406,
					"content": "음——우리가 다 먹었지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430407
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430407,
					"content": "뭐!? 치사해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741430408,
					"content": "캐터필러…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430409
					]
				},
				{
					"id": 741430409,
					"content": "너 괜찮아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430410
					]
				},
				{
					"id": 741430410,
					"content": "내 걱정은 마. 오늘은 기쁜 날이니까 분위기 망치는 주제는 꺼낼 필요 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430411
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430411,
					"content": "#아무튼 고마워, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430412
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430412,
					"content": "무슨 말 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741430413,
					"content": "하하, 아무것도 아니야. 「어린이 팀」 팀원들이 마지막으로 모인 게… 아주 먼 옛날 일인 것만 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430414
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430414,
					"content": "근데 캐터 오빠, 왜 날 여기로 데려온 거야? 이상하네. 게다가 외할아버지가 캐터 오빠를 보고 무서워했어. 용사랑 왕자, 공주도 무서워했고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430415
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430415,
					"content": "캐터 오빠 얘기를 들을 때마다 오빠를 집에 초대하겠다고 했으면서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430416
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430416,
					"content": "음, 그건 아무래도 캐터필러의 모습이… 캐터필러, 왜 지난번처럼 인간의 모습을 하지 않은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430417
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741430417,
					"content": "하지 않으려는 게 아니야, 그저…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430418
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430418,
					"content": "응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430419
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741430419,
					"content": "캐터 오빠는 지금 이대로도 좋은걸! 아까 캐터 오빠 어깨에 앉아서 풍선귤도 땄어. 캐터 오빠는 바람처럼 빨리 달린다구! 정말 대단해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430420
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430420,
					"content": "라느와, 꼭 기억해야 해. 나처럼 생긴 「사람」을 보게 되면 가까이 가지 말고 빨리 도망쳐. 하나같이 위험한 것들이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430421
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430421,
					"content": "정말? 하지만 캐터 오빠는 조금도 나쁘지 않은걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430422
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430422,
					"content": "라느와, 내 말대로 하겠다고 약속해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430423
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430423,
					"content": "또 한 번 캐터필러가 「잔재주」를 부려 라느와에게 영향을 끼칠 거라 생각했다.\\n그러나 그는 그러지 않은 채 진지하게 라느와의 대답을 기다린다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741430424
					]
				},
				{
					"id": 741430424,
					"content": "그치만… 응, 알겠어. 약속할게, 캐터 오빠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430425
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430425,
					"content": "하지만 그러면… 앞으로 캐터 오빠를 어떻게 구분하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430426
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430426,
					"content": "참! 캐터 오빠, 메로피드 요새를 나와서 보니까 세상이 엄청 크더라. 나 매일 다른 방향을 향해 걷고 있는데, 아직까지 벽을 보지 못했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430427
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430427,
					"content": "해가 뜰 땐 엄청 덥고 밤엔 해가 없어서 추워. 맞다! 밤엔 호숫가를 향해 바람이 부는데, 환풍기랑은 다르게 엄청 차가워. 왜 그런 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430428
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430428,
					"content": "그리고 또 용사가 나랑 외할아버지 주변에 엎드려 있을 때 자주 고갤 들어 우리를 봐. 왕자는 잘 때 가끔 뒷발로 물건들을 차는데 진짜 재미있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430429
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430429,
					"content": "그리고, 그리고 또… 신발을 신지 않고 풀 위를 걸으면 발가락 사이로 풀이 들어오는데 찌르듯이 아파. 책에서 봤을 땐 풀이 부드러울 거라 생각했는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430430
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430430,
					"content": "게다가 에티앙 아저씨가 나한테 줬던 꽃이 밖에 엄청 많은데 그 꽃들엔 뿌리가 달려 있어서 흙 속으로 파고들더라?! 그건 또 왜일까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430431
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430431,
					"content": "세상은 정말 넓고 이상해. 그리고 여러 색깔의 빛이 정말 많아. 캐터 오빠에게 들려주고 싶은 이야기가 산더미야. 캐터 오빠에게 듣고 싶은 이야기도 그렇구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430432
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430432,
					"content": "그런데 어떻게 해야 캐터 오빠를 만날 수 있는 거야? 마법사의 제자 같아. 그 제자도 계속해서 물고기를 찾고 싶어 했잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430433
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430433,
					"content": "그 이야기를 기억하는구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430434
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430434,
					"content": "당연하지! 캐터 오빠가 돌아와서 이야기를 끝까지 들려주길 기다리고 있었는걸. 마지막에 제자는 물고기를 찾았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430435
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430435,
					"content": "그건 말이지, 아주 오랜 시간이 지나고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430436
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430436,
					"content": "멍청한 마법사의 제자는 용기를 내어 대마법사에게 작별 인사를 고하고 공방을 떠나 물고기를 찾는 여정에 올랐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430437
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430437,
					"content": "하지만 그는 단 한 번도 넓디넓은 바다를 본 적이 없어서 물고기가 말한 고향이 어떤 곳인지 알지 못했지. 그래서 어쩔 수 없이 가는 내내 사람들에게 물었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430438
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430438,
					"content": "제자는 강가의 갈대에게 물었고, 그의 이야기를 들은 갈대는 허리가 굽을 정도로 웃었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430439
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430439,
					"content": "「네가 찾는 건 바다야」 갈대가 말했어. 「거기는 강보다 몇백, 몇천 배는 넓은 곳이야. 그리고 강이 흘러가는 곳이지」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430440
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430440,
					"content": "그는 강의 물살을 따라 바다에 도착했어. 하지만 바다는 넓었고, 그는 어디로 가야 할지 몰랐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430441
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430441,
					"content": "그래서 그 제자는 부두에서 쉬고 있는 보라금 갈매기에게 물었어. 그의 이야기를 들은 보라금 갈매기는 깜짝 놀라 입을 쩍 벌렸어. 그러는 바람에 물고 있던 감자튀김이 바닥에 떨어졌지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430442
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430442,
					"content": "「형씨, 그건 불가능한 일이야」 갈매기가 말했어. 「바다에서 평범한 물고기 한 마리를 찾겠다니, 그런 일을 한 사람은 단 아무도 없어. 게다가 어쩌면 그 물고기는 벌써…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430443
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430443,
					"content": "마법사의 제자는 빵으로 갈매기의 입을 틀어막았어. 그러고는 그와 시끄럽게 떠드는 그 친구를 무시한 채 해안선을 따라 계속 수소문을 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430444
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430444,
					"content": "제자는 멍청했기 때문에 가장 멍청한 방법을 쓸 수밖에 없었어. 그는 오랜 시간을 들여 잠수를 배웠고 매번 잠수할 때마다 더 멀리, 더 깊은 곳을 향했지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430445
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430445,
					"content": "마지막엔 찾았을 것 같아! 열심히 바라고 포기하지 않으면 소원은 이루어지는 거잖아! 외할아버지가 그랬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430446
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430446,
					"content": "넌 해피엔딩을 좋아하지…. 그래, 언쇼 할아버지 말이 맞아. 제자는 비록 멍청했지만 결국엔 가장 멍청한 방법으로 그 물고기를 찾아냈어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430447
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430447,
					"content": "물고기는 그의 가족들과 물속을 누비고 있었어. 물고기 떼는 자유롭게 형태를 바꾸며 헤엄치고 있었지만 그 많은 동족들 사이에서 제자는 그 물고기를 한눈에 알아봤지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430448
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430448,
					"content": "「드디어 찾았다…」 제자는 소원을 이뤘지만 소원을 이루는 순간은 상상했던 것만큼 기쁘진 않았어. 오히려 뭘 어째야 할지 모르게 되어버렸지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430449
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430449,
					"content": "물고기 떼는 호기심에 그를 에워싸며 자초지종을 물었어. 그는 서툴게 그간 있었던 일들을 말했고 마지막엔 무거운 짐을 내려놓듯 물속에서 긴 거품을 토해냈지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430450
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430450,
					"content": "「두 가지에 대해 사과할게」 제자가 말했어. 「하나는 네가 내게 도움을 청했을 때 내가 그 조금의 용기를 내지 못했기 때문이고, 또 하나는 지금의 이 갑작스러운 방문 때문이야」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430451
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430451,
					"content": "「겨우 널 만난 후에야 내가 얼마나 이기적인 사람인지 깨달았어…. 네게 사과하면 과거의 날 용서할 수 있을 거란 생각만 했어」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430452
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430452,
					"content": "「그게 왜?」 물고기가 제자의 예상과 다른 대답을 했지. 「봐, 과거의 네가 날 돕지 않았지만 난 고향에 돌아왔어. 가족들의 곁으로 돌아왔다고」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430453
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430453,
					"content": "「난 아무런 피해도 받지 않았어. 그러니 너도 누군가의 용서를 바라지 않아도 돼」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430454
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430454,
					"content": "「이런 사소한 일을 위해 그 많은 시간과 공을 들이다니, 올곧다고 해야 할지 아니면 멍청하다고 해야 할지. 하지만 멍청해도 상관없어. 우린 멍청한 인간과 친구 해도 괜찮으니까…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430455
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430455,
					"content": "와! 그럼 마지막엔 결국 친구가 된 거야? 그럼 그다음은?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430456
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430456,
					"content": "그다음? 그들은 최고로 좋은 친구가 됐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430457
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430457,
					"content": "응? 끝이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430458
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741430458,
					"content": "캐터 오빠… 그게 끝인 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430459
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430459,
					"content": "응, 내 이야기는 끝났어. 적당한 곳에 도착했는데도 이야기를 끝내지 않으면 재미없잖아. 영웅이 악룡이 되어버릴 거라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430460
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430460,
					"content": "끝내지 않으려는 이야기를 들은 적 있어. 그 이야기의 끝도 좋지 않았지. 이야기 속 사람들은 모두 슬퍼했어. 참 나쁜 이야기지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430461
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430461,
					"content": "하지만 친애하는 라느와, 네 「인생이라는 이름의 모험은 계속되고 있어」… 생일 축하해. 언젠가 내게 너의 이야기를 들려줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430462
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430462,
					"content": "응, 응… 약속할게, 캐터 오빠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430463
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430463,
					"content": "내가 꼭 오빠를 찾아가서 아주 많은 이야기를 해줄게. 그리고 아주 크고 달콤한 생일 케이크를 줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430464
					],
					"speakerTitle": "라느와"
				},
				{
					"id": 741430464,
					"content": "하하하, 생일 케이크는 됐어. 난 내 생일도 모르는걸. 아는 건 깨어난 날뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430465
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 741430465,
					"content": "…고마워, 라느와. 그래서——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐터필러"
				}
			]
		},
