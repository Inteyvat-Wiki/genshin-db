			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「우인단」 경비병"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201010301,
					"content": "으악… 전 맛없다구요! ——윽, 너희들은… 사람?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010302
					],
					"speakerTitle": "「우인단」 경비병"
				},
				{
					"id": 201010302,
					"content": "이 층의 방어가 전부 뚫려버려서… 「심연 교단」의 괴물들이 공격해 오는 줄 알았잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010303,
						201010305
					],
					"speakerTitle": "「우인단」 경비병"
				},
				{
					"id": 201010303,
					"content": "천공의 하프를 돌려받으러 왔다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201010304
					]
				},
				{
					"id": 201010304,
					"content": "「천공의 하프」가 여기 있는지 어떻게 알았지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010309
					],
					"speakerTitle": "「우인단」 경비병"
				},
				{
					"id": 201010309,
					"content": "성물을 보관한 곳은 잠겨있어. 열쇠가 필요하면… 앞으로 가. 날 찾지 말고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010310
					],
					"speakerTitle": "「우인단」 경비병"
				},
				{
					"id": 201010310,
					"content": "열쇠가 선발대 중 누구 손에 있는지 몰라…. 아마도 방 안에 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010311
					],
					"speakerTitle": "「우인단」 경비병"
				},
				{
					"id": 201010311,
					"content": "무서워서 완전 쫄았네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 201010312,
					"content": "흥… 너, 너무 까불지 않는 게 좋을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010313
					],
					"speakerTitle": "「우인단」 경비병"
				},
				{
					"id": 201010313,
					"content": "우리 「우인단」은 몬드에… 집 「집행관」이 있다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010314
					],
					"speakerTitle": "「우인단」 경비병"
				},
				{
					"id": 201010314,
					"content": "「시뇨라」님께서 너희를 찾아 혼쭐을 내주실 거야——그때 나 물고 늘어지지나 말라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「우인단」 경비병"
				},
				{
					"id": 201010305,
					"content": "네 목숨을 거두러 왔다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201010306
					]
				},
				{
					"id": 201010306,
					"content": "으이——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010307
					],
					"speakerTitle": "「우인단」 경비병"
				},
				{
					"id": 201010307,
					"content": "이러지 마…! 나에게 확실한 정보가 있어! 자백할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010308
					],
					"speakerTitle": "「우인단」 경비병"
				},
				{
					"id": 201010308,
					"content": "사실 우리는 몬드의 보물인 「천공의 하프」를 이 유적 깊은 곳에 숨겨뒀어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201010309
					],
					"speakerTitle": "「우인단」 경비병"
				}
			]
		},
