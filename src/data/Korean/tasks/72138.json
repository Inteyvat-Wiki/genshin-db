	"talks": [
		{
			"id": 7213801,
			"completionStepIds": [
				7213801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213801",
							"2"
						],
						"stepId": 7213801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"야스모토"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380101,
					"content": "으악! 나… 난 의심스러운 사람 아니야, 그냥 현지 의사라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380102
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380102,
					"content": "못 믿겠으면 내가 사는 곳까지 같이 가자. 필요한 거 있으면 다 가져가도 좋으니, 살려만 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380103
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380103,
					"content": "아니면 쿠죠 님한테 데려가 줘! 날 아실 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380104,
						721380105
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380104,
					"content": "오해가 있는 거 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				},
				{
					"id": 721380106,
					"content": "음…? 너희는 막부군 사람이 아닌 거 같은데… 산호궁 사람들도 아닌 거 같고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380107
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380107,
					"content": "너흰… 외국인이야? 여기는 무슨 일이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380108,
						721380109
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380108,
					"content": "그건…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380110,
					"content": "음… 아무튼 어서 여기를 떠나. 지금 야시오리섬은 매우 위험해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380111
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380111,
					"content": "아직 「재앙신」이 사라질 징조가 안 보이고 텐료 봉행도 철수할 생각이 없어 보여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380112
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380112,
					"content": "이 섬은 이미 사람이 살기에 적합하지 않아. 관광은 말할 필요도 없고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380113
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380113,
					"content": "만약 봉행을 피해 도망 온 외국인이라면 서쪽으로 가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380144
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380144,
					"content": "텐료 봉행은 정체가 불명확한 도망자를 환영하지 않아. 하지만 해적은 아마 받아줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380114,
						721380115
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380114,
					"content": "섬에 무슨 일이 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380116,
					"content": "흥… 성 사람들이랑 산호궁 녀석들이 무슨 짓을 했는지 보라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380117
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380117,
					"content": "먼저 타타라스나에 폭발이 있었던 그날, 하늘이 온통 이상한 색으로 뒤덮였어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380140
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380140,
					"content": "많은 사람이 일자리를 잃었고 살아가기도 힘든 데다 많이 다치기까지 해서 정말 비참해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380141
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380141,
					"content": "그리고 많은 친구들은… 도망가지도 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380118
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380118,
					"content": "그리고 산호궁 녀석들이 거대한 뱀 유골을 진압하는 주술 도구를 파괴했지. 이것 때문에 「재앙신」이 폭주해서 섬의 사람들이 도망쳤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380119
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380119,
					"content": "「재앙신」의 기괴한 병은 계속 확산됐고 여기 있는 대부분의 주민들이 병들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380142
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380142,
					"content": "두 군영에 병이 퍼지는 것은 시간문제일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380143
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380143,
					"content": "여긴 뭐 하는 곳이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380120
					]
				},
				{
					"id": 721380120,
					"content": "여긴 원래 이나즈마「옥철」을 제조할 때 필요한 수정석을 만드는 주요 생산지였지. 광석이 마르지만 않으면 성 사람들의 제약도 안 받고 잘 살 수 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380121
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380121,
					"content": "지금은 어떤지 알아? 섬에 살아 있는 사람이 별로 없어… 그러니까 내 말은, 나 같은 말을 할 수 있는「사람」 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380122
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380122,
					"content": "왜 안 떠나는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380123
					]
				},
				{
					"id": 721380123,
					"content": "왜 안 떠나고 싶겠어? 텐료 봉행 어르신의 아드님도 날 초빙했는데… 아마 지금은 전쟁을 지휘하고 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380124
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380124,
					"content": "「너의 의술은 일반 백성들과 다르다. 섬에 있으면 위험하니 내가 직접 아버지께 추천할 테니 나의 군의관으로 오는 건 어떤가」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380145
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380145,
					"content": "라고 그가 말했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380125
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380125,
					"content": "전쟁이 일어나기 전에 나루카미섬의 봉행 어르신을 치료하는 건 나 같은 촌구석 의사한테는 상상도 못 할 영광이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380126
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380126,
					"content": "하지만 지금은… 봉행 어르신 옆에는 명의가 많지만 야시오리섬에는? 여기 환자들이 의지할 수 있는 의사는 나뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380127
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380127,
					"content": "그래서 난 떠나지 않을 거야, 막부 병사든 산호궁 병사든 모두 치료할 거야. 내 적은 오직 「재앙신」 뿐이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380128
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380128,
					"content": "뭐 도와줄 거라도 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380129
					]
				},
				{
					"id": 721380129,
					"content": "아니… 음, 아니다, 도움이 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380130
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380130,
					"content": "특수한 약초가 필요해. 「재앙신」 때문에 걸린 괴상한 병을 고칠 수 있을지 모르겠지만… 시도는 해봐야 하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380131
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380131,
					"content": "하지만… 그 약초들은 「재앙신」 영향을 받았고 또 대부분이 위험한 환경에 분포되어 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380146
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380146,
					"content": "지형은 험해서 다치기 쉽고, 그게 아니면 마물이 도사리고 있고 게다가 이쪽 지역은 「재앙신」이 가장 기승을 부리는 곳이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380132
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380132,
					"content": "내 배짱과 능력으로는 감당할 수 없을 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380133
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380133,
					"content": "의사로서 위험을 무릅쓰고 약재를 캐러 갈 수는 없으니, 약효가 늦고 보수적인 치료법을 사용할 수밖에 없었고, 새로운 처방전도 만들 수 없었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380134
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380134,
					"content": "외국인, 넌 「바람의 날개」를 가지고 있는 걸 보니 경험이 풍부한 여행자겠지. 이런 어려움은 쉽게 극복할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380135
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380135,
					"content": "그래서 말인데 이 지점에 가서 약초를 채집해 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380136
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380136,
					"content": "채집이 끝난 후에 여기서 만나자. 내가 모아둔 게 있으니 보수는 걱정 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380137
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380137,
					"content": "비록 잘 모르는 사이긴 하지만 제발 내 부탁을 들어주라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380138
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380138,
					"content": "조심해서 다녀와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380115,
					"content": "많이 속상해 보이네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380109,
					"content": "말하자면 길어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380105,
					"content": "의심스럽긴 하네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				}
			]
		},
		{
			"id": 7213802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
