			"dialogs": [
				{
					"id": 721380401,
					"content": "#고마워, {NICKNAME}. 곤란하게 했다면 사과할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380402,
						721380403
