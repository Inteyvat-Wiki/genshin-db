					"nextDialogs": [
						721380303
					]
				},
				{
					"id": 721380303,
					"content": "좋아, 이 정도면 충분해. 새 처방전 연구를 바로 시작할 수 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380304
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380304,
					"content": "정말 고마워. 약속한 보수야. 부디 받아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380305
					],
					"speakerTitle": "야스모토"
				},
				{
					"id": 721380305,
					"content": "그리고, 외국인…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380306
					],
					"speakerTitle": "야스모토"
				},
				{
