			"dialogs": [
				{
					"id": 205200101,
					"content": "여… 여행자…. 나… 나 좀 도와줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200102
					],
					"speakerTitle": "타미"
				},
				{
					"id": 205200102,
					"content": "이게 어떻게 된 거예요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200103
					]
				},
				{
					"id": 205200103,
					"content": "부… 부탁이야, 먼저 열원 좀 찾아줘…. 얼어 죽을 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200104
					],
					"speakerTitle": "타미"
				},
				{
					"id": 205200104,
					"content": "아, 아니면… 따뜻한 음식도 괜찮아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200105
					],
					"speakerTitle": "타미"
				},
				{
					"id": 205200105,
					"content": "부… 부탁해, 추워서 못 견디겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타미"
				}
			]
		},
