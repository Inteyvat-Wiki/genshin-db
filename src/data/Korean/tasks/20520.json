			"dialogs": [
				{
					"id": 205200501,
					"content": "「냉동 생고기」는 구해 왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200502
					],
					"speakerTitle": "타미"
				},
				{
					"id": 205200502,
					"content": "구했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200503
					]
				},
				{
					"id": 205200503,
					"content": "다행이다. 이게 「냉동 생고기」야? 촉감이 차가운 거 말고 별다른 게 없는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200504
					],
					"speakerTitle": "타미"
				},
				{
					"id": 205200504,
					"content": "됐다, 의뢰만 완료하면 장땡이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200505
					],
					"speakerTitle": "타미"
				},
				{
					"id": 205200505,
					"content": "여행자, 고마워. 네가 아니었으면 큰일 날 뻔했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200506
					],
					"speakerTitle": "타미"
				},
				{
					"id": 205200506,
					"content": "이건 보수니까 받아둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "타미"
				}
			]
		},
