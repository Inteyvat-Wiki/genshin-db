			"dialogs": [
				{
					"id": 766520501,
					"content": "휴, 드디어 잡았네. 이젠 나도 궁금해, 이 「부하」 대체 어떻게 된 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766520502,
					"content": "흥, 무식하긴!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520503
					],
					"speakerTitle": "이상한 채굴 부하"
				},
				{
					"id": 766520503,
					"content": "엥?! 너… 말도 할 줄 알아? 아이노, 원래 이런 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766520504,
					"content": "말도 안 돼…. 「채굴 부하」에 말하는 기능을 넣긴 했지만, 전부 사전 설정한 음성뿐이고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520505
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 766520505,
					"content": "얘네가 이네파 같은 자아를 가지는 건 불가능해. 코어의 수준이 완전히 다르다구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520506
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 766520506,
					"content": "하지만 소통이 가능해 보이는데? 코어가 업그레이드된 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766520507,
					"content": "넌 이름이 뭐야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766520508
					]
				},
				{
					"id": 766520508,
					"content": "왜? 그건 알아서 뭐 하게?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520509
					],
					"speakerTitle": "이상한 채굴 부하"
				},
				{
					"id": 766520509,
					"content": "우와, 얘 성격 좀 봐! 꼭 우리가 지한테 잡힌 것처럼 구네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520510
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766520510,
					"content": "그래서 뭐? 너희들, 지금 당장 떠나지 않으면 싹 다 잡아다가 메로피드로…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520511
					],
					"speakerTitle": "이상한 채굴 부하"
				},
				{
					"id": 766520511,
					"content": "메로피드? 그게 어디죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520512
					],
					"speakerTitle": "이네파"
				},
				{
					"id": 766520512,
					"content": "그게, 그러니까… 그… 어라? 메로피드… 뭐였더라?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520513
					],
					"speakerTitle": "이상한 채굴 부하"
				},
				{
					"id": 766520513,
					"content": "메로피드 요새?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766520514
					]
				},
				{
					"id": 766520514,
					"content": "메로피드 요새… 그런 이름이었던 것 같기도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520515
					],
					"speakerTitle": "이상한 채굴 부하"
				},
				{
					"id": 766520515,
					"content": "넌 폰타인에서 왔니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766520516
					]
				},
				{
					"id": 766520516,
					"content": "뭐야! 만나자마자 숙녀의 사생활을 캐묻다니 실례잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520517
					],
					"speakerTitle": "이상한 채굴 부하"
				},
				{
					"id": 766520517,
					"content": "야! 숙녀는 무슨, 넌 쓰레기 분류 로봇이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520518
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766520518,
					"content": "숙녀 맞거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520519
					],
					"speakerTitle": "이상한 채굴 부하"
				},
				{
					"id": 766520519,
					"content": "이상해. 어떻게 된 일인지는 잘 모르겠지만… 이 녀석은 분명 원래 있던 「채굴 부하」가 아니야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520520
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 766520520,
					"content": "음! 분해해서 어떻게 된 건지 알아봐야겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520521
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 766520521,
					"content": "내 몸에 함부로 손대지 마! 저질!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520522
					],
					"speakerTitle": "이상한 채굴 부하"
				},
				{
					"id": 766520522,
					"content": "나도 여자거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520523
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 766520523,
					"content": "여자여도 안 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520524
					],
					"speakerTitle": "이상한 채굴 부하"
				},
				{
					"id": 766520524,
					"content": "…죄송합니다. 아이노 님은 한번 흥미가 생기면 정신이 팔리셔서요. 시간을 주시면, 어떻게 된 일인지 알아내실 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520525
					],
					"speakerTitle": "이네파"
				},
				{
					"id": 766520525,
					"content": "여러분도 궁금하시면, 내일 이 시간에 공방으로 다시 찾아와 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "이네파"
				}
			]
		},
