			"dialogs": [
				{
					"id": 766520301,
					"content": "아이노, 이네파! 잡아 왔어! 빨리 검사해 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766520302,
					"content": "외관 일체 정상. 외부 공격으로 고장이 생겼을 가능성은 매우 낮습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520303
					],
					"speakerTitle": "이네파"
				},
				{
					"id": 766520303,
					"content": "설마 진짜로 코어 문제인가? 한번 뜯어봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520304
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 766520304,
					"content": "앗! 도망간다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766520305,
					"content": "얼른 쫓아가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520306
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 766520306,
					"content": "어… 저건가…? 어떻게 갑자기 이렇게 커졌지?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 766520307,
					"content": "아뇨, 저건 이미 폐기된 분류 로봇입니다. 서로 연결될 수 있다니 놀랍네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520308
					],
					"speakerTitle": "이네파"
				},
				{
					"id": 766520308,
					"content": "슬슬 궁금해지기 시작했어. 아무래도 단순한 고장 문제가 아닌 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766520309
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 766520309,
					"content": "일단 빨리 저 녀석을 붙잡자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아이노"
				}
			]
