					"nextDialogs": [
						411131203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411131203,
					"content": "저기, 혹시 이 사람 깨어난 적 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411131204,
					"content": "아니, 가끔 잠꼬대만 하던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131205
					],
					"speakerTitle": "화청"
				},
				{
					"id": 411131205,
					"content": "뭐라고 했는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411131206,
					"content": "추워… 못 걷겠어…. 같은 말을 하더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131207
					],
					"speakerTitle": "화청"
				},
				{
					"id": 411131207,
					"content": "춥다구요? 전에도 이렇게 말한 사람이 있었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131208
					]
				},
				{
					"id": 411131208,
					"content": "추운 지역, 산맥…. 대체 어디일까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "오즈"
				}
			]
