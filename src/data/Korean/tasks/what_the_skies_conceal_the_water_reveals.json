						411131102
					],
					"speakerTitle": "고육룡"
				},
				{
					"id": 411131102,
					"content": "저기, 잠들어 있는 동안 혹시 꿈 안 꿨어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411131103,
					"content": "꿨어! 힘들어 죽는 줄 알았다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131104
					],
					"speakerTitle": "고육룡"
				},
				{
					"id": 411131104,
					"content": "대체 무슨 꿈을 꿨길래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131105,
						411131107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411131105,
					"content": "설산에 있는 꿈을 꿨나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131106
					]
				},
				{
					"id": 411131106,
					"content": "어떻게 알았어? 아주 높고 추운 설산이었어… 그렇게 높은 산은 처음 봤지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "고육룡"
				},
				{
					"id": 411131109,
					"content": "설산엔 왜 간 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411131110,
					"content": "나도 몰라. 무슨 귀신 들린 것처럼 계속 산 정상까지 오를 생각뿐이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131111
					],
					"speakerTitle": "고육룡"
				},
				{
					"id": 411131111,
					"content": "산꼭대기에 보물이라도 있는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411131112,
					"content": "누가 알겠어? 잠드니까 다른 사람이 된 것 같았어. 이유는 나도 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131113
					],
					"speakerTitle": "고육룡"
				},
				{
					"id": 411131113,
					"content": "당신이 원해서 올라간 게 아닌가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131114
					]
				},
				{
					"id": 411131114,
					"content": "뭐랄까…. 산을 오르고 싶은 마음이 들게끔 누군가에게 조종당하는 듯했어. 느낌이 얼마나 이상하던지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131115
					],
					"speakerTitle": "고육룡"
				},
				{
					"id": 411131115,
					"content": "설마, 어둠의 플로우?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131116
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411131116,
					"content": "자발적인 게 아니라 무의식중에 이런 생각이 든 거죠. 확실히 세뇌와 비슷하네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131117,
						411131118
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 411131117,
					"content": "이미 적응됐지만 그래도 말해야겠어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131119,
					"content": "그럼 전에 계속 춥고 못 걷겠다고 했던 사람들도… 다 설산에 있었던 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411131120,
					"content": "모든 사람이 같은 꿈을 꾼 건가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131121
					]
				},
				{
					"id": 411131121,
					"content": "정말 신기해….빨리 <color=#00E1FFFF>모나</color>한테 알려주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411131118,
					"content": "둘이 전혀 다른 단어를 말하고 있잖아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131119
					]
				},
				{
					"id": 411131107,
					"content": "설원에 있는 꿈을 꿨나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131108
					]
				},
				{
					"id": 411131108,
					"content": "설원이 아니라 설산이었어. 아주 높고 추웠지… 잠들자마자 내가 산기슭에 서 있는 꿈을 꿨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131109
					],
					"speakerTitle": "고육룡"
				}
