					"모나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411130701,
					"content": "모나, 우리가 알아냈어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130702
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411130702,
					"content": "구름 위로 높이 솟은 설산. 거기가 바로 어둠이 싹 튼 곳일거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130703
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411130703,
					"content": "설산? 그것뿐이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130704
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411130704,
					"content": "모든 사람이 꿈에서 동일한 설산을 봤어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411130705
					]
				},
				{
					"id": 411130705,
					"content": "구름 위로 높이 솟은 처음 보는 설산, 몹시 춥고, 꿈속에서 모두 산꼭대기에 오르고 싶게끔 조종당한 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130706
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411130706,
					"content": "산꼭대기…. 산꼭대기에 올랐다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130707
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411130707,
					"content": "다른 사람을 조종할 정도로 산꼭대기에 오르고 싶어 하는 사람이 누굴까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130708
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411130708,
					"content": "설산에 핍박받아 죽은 사람이 묻혀있는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130709
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411130709,
					"content": "혹은… 설산을 오르길 갈망하는 도전자이거나요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130710
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 411130710,
					"content": "다시 한번 해볼게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130711
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411130711,
					"content": "됐다! 새로운 단서가 희미하게 보여. 그의 이름은… <color=#00E1FFFF>레너드</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130712
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411130712,
					"content": "엥?! 이렇게 빨리?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130713
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411130713,
					"content": "말했잖아, 난 천재라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130714
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411130714,
					"content": "레너드…. 처음 듣는 이름이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 4111308,
			"completionStepIds": [
				4111308
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
