					"nextDialogs": [
						411130904
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411130904,
					"content": "우인단 녀석들, 설마 원소의 힘을 노린 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411130905
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411130905,
					"content": "가능성이 없는 건 아냐. 정말 그렇다면 다른 생물들도 이 힘을 얻으려고 할 텐데",
					"roleType": "TALK_ROLE_NPC",
