						411131302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411131302,
					"content": "아직 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131303
					],
					"speakerTitle": "단양"
				},
				{
					"id": 411131303,
					"content": "그럼 잠꼬대는?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411131304,
					"content": "그러고 보니… 어제 엄청 크게 「너무 높아」라고 했던 거 같아. 무슨 뜻인진 모르겠지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131305
					],
					"speakerTitle": "단양"
				},
				{
					"id": 411131305,
					"content": "높다고? 설산이 너무 높다는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411131306,
					"content": "높이 솟아오른 차가운 악마의 산이 세차게 흐르는 어둠의 힘을 가져왔군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131307
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411131307,
					"content": "저 사람한테도 물어보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
