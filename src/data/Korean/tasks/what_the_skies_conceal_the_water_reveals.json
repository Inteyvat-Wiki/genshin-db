			"dialogs": [
				{
					"id": 411131401,
					"content": "저기, 혹시 여기 깨어난 환자 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411131402,
					"content": "딱 맞춰 왔네, <color=#00E1FFFF>고육룡</color> 씨가 방금 깨어나셨거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131403
					],
					"speakerTitle": "황래"
				},
				{
					"id": 411131403,
					"content": "어서 가보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411131404,
					"content": "근데 지금까지 잠들어 있었어서 몸이 많이 허약한 상태니까, 너무 거칠게 대하진 말아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131405
					],
					"speakerTitle": "황래"
				},
				{
					"id": 411131405,
					"content": "불행한 자여, 곧 황녀의 안부를 받게 될 것이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131406
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411131406,
					"content": "아이고… 배고파…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131407
					],
					"speakerTitle": "고육룡"
				},
				{
					"id": 411131407,
					"content": "괜찮아? 엄청 배고프지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411131408,
					"content": "아이고… 아이고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131409,
						411131410
					],
					"speakerTitle": "고육룡"
				},
				{
					"id": 411131409,
					"content": "뭐가 드시고 싶으세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				},
				{
					"id": 411131411,
					"content": "고… 고향… 음식이… 먹고 싶어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411131412
					],
					"speakerTitle": "고육룡"
				},
				{
					"id": 411131412,
					"content": "고향 음식이라면 아마 <color=#00E1FFFF>경책 가정식</color>일 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411131410,
					"content": "제가 만들어 드릴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411131411
					]
				}
			]
