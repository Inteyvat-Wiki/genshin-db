					}
				]
			},
			"dialogs": [
				{
					"id": 240160101,
					"content": "이 정도면 되겠지…. 부디 이 자료가 쓸모가 있어야 할 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160102
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240160102,
					"content": "아직도 자료 정리 중이세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160103
					]
				},
				{
					"id": 240160103,
					"content": "어머나! 명예 선임 연구원이구나? 또 만났네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160104
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240160104,
					"content": "맞아, 레이먼드 씨의 지시에 따라 자료랑 서류를 정리하고 있었어…. 내가 전에 말했던가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160105
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240160105,
					"content": "이렇게 넓은 곳에서 혼자 일하면 힘들지 않아? 어떻게 레이먼드는 도와줄 사람도 안 보내주는 거람",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 240160106,
					"content": "지금은 과학원 전체가 바쁜 때니까. 도와줄 사람이 없는 것도 당연하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160107
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240160107,
					"content": "그래도 명색이 「주임」이신데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160108
					]
				},
				{
					"id": 240160108,
					"content": "그 「폰타인 과학원 서류회수팀 주임」이라는 직함? 농담 마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160109
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240160109,
					"content": "내가 어딜 봐서 「주임」이야? 처음부터 난 서류 정리만 하는 평범한 직원에 불과했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160110
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240160110,
					"content": "레이먼드 씨로부터 이곳을 정리하라는 지시를 받은 이후에 갑자기 그런 직함이 추가되었다는 통지를 받은 것뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160111
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240160111,
					"content": "누가 그러던데, 사실 그건 슈아죌 씨 아이디어였대. 우리 일이 너무 힘들어서 수당이라도 좀 더 챙겨주기 위해서였다나…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160112
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240160112,
					"content": "아앗! 방금 건 비밀이야! 이… 이런 걸 왜 말한 거람…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160113
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240160113,
					"content": "아무한테도 말 안 할 테니 걱정 마세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160114
					]
				},
				{
					"id": 240160114,
					"content": "좋은 거 아냐? 힘든 일을 하는 사람이 돈을 더 받는 게 문제가 될 것 같지는 않은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 240160115,
					"content": "근데 왜 그렇게 우회적인 방식을 쓰는 걸까? 그냥 모두에게 직접 포상을 주는 편이 낫지 않나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160116,
						240160117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 240160116,
					"content": "과학원답네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				},
				{
					"id": 240160118,
					"content": "하아, 나도 슈아죌 씨랑 레이먼드 씨가 무슨 생각인지 이해가 안 가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160119
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240160119,
					"content": "하지만 어쨌든 난 계속 일을 해야 해. 아직 해야 할 게 많이 남았거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160120
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240160120,
					"content": "명예 선임 연구원, 괜찮다면 나 좀 도와줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160121,
						240160122
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240160121,
					"content": "명예엔 책임이 따르죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160124
					]
				},
				{
					"id": 240160124,
					"content": "그럼 가서 주변의 오염을 좀 제거해 줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160125
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240160125,
					"content": "오염을 제거할 때 <color=#00E1FFFF>옆의 공문들은 건드리지 말아줘</color>. 공문이 오염되면 큰일이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160126
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240160126,
					"content": "그럼 부탁할게. 난 계속 공문을 정리해야겠어. 휴, 평소엔 과학원에 공문이 이렇게나 많은 줄 몰랐는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240160122,
					"content": "제 명예를 한층 더 드높여보죠!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160123
					]
				},
				{
					"id": 240160123,
					"content": "하하하, 그래. 네 착한 마음씨는 내가 보증해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160124
					],
					"speakerTitle": "샬멧"
				},
				{
					"id": 240160117,
					"content": "어쨌든 수중에 돈이 더 들어오면 좋은 거지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				}
			]
		},
