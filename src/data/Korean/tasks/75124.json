				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1640.235,
							200.011,
							10049.76
						],
						"pointId": 10055
					},
					{
						"sceneId": 3,
						"position": [
							-1639.219,
							200.16,
							10051.38
						],
						"pointId": 10424
					},
					{
						"sceneId": 3,
						"position": [
							-1640.835,
							200.051,
							10051.92
						],
						"pointId": 10425
					}
				]
			},
			"dialogs": [
				{
					"id": 751240101,
					"content": "하아, 또 도망쳤네. 어디 보자…. 이런, 튜브를 끼고 있는 게 한 마리뿐이잖아? 이제 어떡하지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240102
					],
					"speakerTitle": "종벨"
				},
				{
					"id": 751240102,
					"content": "대체 언제까지 해야 하는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240103
					],
					"speakerTitle": "종벨"
				},
				{
					"id": 751240103,
					"content": "오, 여기서 사진을 찍고 있는 사람도 있네. 둥둥 펭귄을 찍는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751240104,
					"content": "진짜 귀엽기는 하다, 둥둥 펭귄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240105,
						751240107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751240105,
					"content": "그러게. 느긋하니 요리조리…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240106
					]
				},
				{
					"id": 751240106,
					"content": "응! 걷는 모습이 너무 귀여워. 게다가 둥글둥글한 애들이 물 위에 둥둥 떠 있는 모습을 보면 나도 모르게 미소가 지어지는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751240109,
					"content": "이 아름다운 은발 소녀 말이 맞아! 둥둥 펭귄을 만든 창조자는 이 세상에 존재하는 모든 찬사를 받아야 한다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240110
					],
					"speakerTitle": "종벨"
				},
				{
					"id": 751240110,
					"content": "정말 굉장하다고! 아, 미안. 아직 자기소개를 안 했네. 난 둥둥 펭귄 사진 애호가, 종벨이라고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240111
					],
					"speakerTitle": "종벨"
				},
				{
					"id": 751240111,
					"content": "#응! 난 페이몬이고, 이쪽은 {NICKNAME}(이)야. 근데… 여기 둥둥 펭귄이 잔뜩 있는데 왜 한숨을 쉬고 있었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751240112,
					"content": "설명하자면 길지만… 간단히 말하자면, 둥둥 펭귄 사진 애호가는 정말 많아. 그리고 모두들 재미있는 사진을 찍고 싶어 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240113
					],
					"speakerTitle": "종벨"
				},
				{
					"id": 751240113,
					"content": "그런데 며칠 전에 내 머릿속에 아이디어가 딱 떠올랐어. 사진기 프레임 안을 튜브를 낀 둥둥 펭귄으로 꽉 채워보면 어떨까——하는 생각이 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240114,
						751240117
					],
					"speakerTitle": "종벨"
				},
				{
					"id": 751240114,
					"content": "거기에 무슨 의미가 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240115
					]
				},
				{
					"id": 751240115,
					"content": "없어. 하지만 의미가 없다는 부분에 의미가 있는 거지! 혼자서도 떠다닐 수 있는 둥둥 펭귄이 튜브를 끼고 있다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240116
					],
					"speakerTitle": "종벨"
				},
				{
					"id": 751240116,
					"content": "모라로 모라를 버는 것만큼이나 무의미하지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "종벨"
				},
				{
					"id": 751240120,
					"content": "둥둥 펭귄의 어깨 위에 너무 많은 걸 얹어놓는 거 아냐…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751240121,
					"content": "그런 걸 보고 초현실주의 기법이라고 해. 사진 안에 보다 깊은 의미를 담아내는 거지…. 그런데 그러던 중에 문제가 생겼어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240122
					],
					"speakerTitle": "종벨"
				},
				{
					"id": 751240122,
					"content": "현실에서는 둥둥 펭귄이 튜브를 끼지 않으니… 애초에 그런 사진을 찍을 수가 없다는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240123
					],
					"speakerTitle": "종벨"
				},
				{
					"id": 751240123,
					"content": "뭐, 「초현실」주의 기법이니까요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240124
					]
				},
				{
					"id": 751240124,
					"content": "#잠깐만. 그럼 그냥 둥둥 펭귄들에게 하나하나 튜브를 끼워주면 되는 거 아냐? {NICKNAME}, 같은 둥둥 펭귄 애호가 동지니까 우리가 도와주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240125,
						751240127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751240125,
					"content": "좋아! 둥둥 펭귄 애호가들끼리는 서로 도와야지!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240126
					]
				},
				{
					"id": 751240126,
					"content": "내 말이!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751240129,
					"content": "정말? 정말로 도와줄 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240130
					],
					"speakerTitle": "종벨"
				},
				{
					"id": 751240130,
					"content": "헤헤, 대신 나중에 잘 나온 사진 몇 장만 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751240131,
					"content": "그, 그럼 두 사람한테 부탁 좀 할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "종벨"
				},
				{
					"id": 751240127,
					"content": "난 날다람쥐 쪽이 더 좋지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240128
					]
				},
				{
					"id": 751240128,
					"content": "에잇! 이럴 때 분위기 깨는 소리 하지 말고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751240117,
					"content": "확실히 평범한 사람들은 생각조차 할 수 없겠네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240118
					]
				},
				{
					"id": 751240118,
					"content": "혼자서도 물 위를 떠다닐 수 있는 둥둥 펭귄이 튜브를 끼고 있다. 그 부분이 사진에 의미를 불어넣어 주는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240119
					],
					"speakerTitle": "종벨"
				},
				{
					"id": 751240119,
					"content": "이게 사실 일종의 「과용」과 「낭비」라는 주제를 보여주는 작품이거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "종벨"
				},
				{
					"id": 751240107,
					"content": "사실 난 날다람쥐 쪽이 더 좋지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240108
					]
				},
				{
					"id": 751240108,
					"content": "확실히 날다람쥐도 귀엽긴 하지만, 「날다람쥐가 둥둥 펭귄보다 귀엽다」는 말은 둥둥 펭귄 앞에서 하기엔 너무 잔인하잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "페이몬"
				}
			]
		},
