				"points": []
			},
			"dialogs": [
				{
					"id": 718240101,
					"content": "서둘러야겠군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240102
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718240102,
					"content": "장사가 그렇게 잘돼요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240103
					]
				},
				{
					"id": 718240103,
					"content": "아니. 객잔 직원들이 대부분 명절 쇠러 가서 일손이 부족해. 일을 거의 나 혼자 다 해야 한다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240104
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718240104,
					"content": "다행히 손님이 얼마 없어서 큰 문제는 없지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240105
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718240105,
					"content": "크흠, 그 뭐냐, 지난번에 도와줘서 고마워. 네가 아니었으면 지금도 일을 제대로 못 했을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240106,
						718240107
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718240106,
					"content": "혹시 최근에도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				},
				{
					"id": 718240108,
					"content": "아냐! 절대 아니라고. 맹세해! 한 번 더 그랬다간 내 심장이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240109
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718240109,
					"content": "그 일에 대해 알고 싶다면… 가서 사장님한테 물어봐. 나, 난 진짜 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "언소"
				},
				{
					"id": 718240107,
					"content": "요즘 그 애는…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				}
			]
		},
		{
			"id": 7182402,
			"completionStepIds": [
				7182402
			],
