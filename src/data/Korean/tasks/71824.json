					"베르 고데트"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240201,
					"content": "여행자, 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240202
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 718240202,
					"content": "명이에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240203
					]
				},
				{
					"id": 718240203,
					"content": "아, 그 애라면 지난번 일이 있고 난 뒤부터 많이 얌전해졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240204
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 718240204,
					"content": "근데 그 애도 참 불쌍해. 명절 때 객잔이 시끌벅적할수록 그 애는 더 쓸쓸해 하거든. 그래서 자꾸 손님들을 놀래키고 말썽을 피우는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240205
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 718240205,
					"content": "아마 놀아줄 사람이 필요한 거겠지. 아직 어린애일 뿐이니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240206,
						718240207
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 718240206,
					"content": "명이한테 소등을 주고 싶어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				},
				{
					"id": 718240208,
					"content": "소등? 흠… 좋은 생각이야. 근데 그 애는 찾기가 좀 어려워서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240209
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 718240209,
					"content": "그 애를 찾고 싶다면, 밤이 됐을 때 저쪽 숲에서 소등을 나뭇가지에 걸면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240210
					],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 718240210,
					"content": "그럼 그 애가 볼 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베르 고데트"
				},
				{
					"id": 718240207,
					"content": "명이가 소등을 좋아할까요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				}
			]
		},
