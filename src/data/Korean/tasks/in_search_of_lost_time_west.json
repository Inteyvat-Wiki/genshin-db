			"dialogs": [
				{
					"id": 740121001,
					"content": "당겨 보자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740121002
					]
				},
				{
					"id": 740121002,
					"content": "#으악! {NICKNAME}, 너 지금 뭐 하는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740121003
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740121003,
					"content": "당신은 망설임 없이 레버를 당겼다.\\n그러자 굉음과 함께 고탑 전체가 격렬하게 흔들렸다. 하늘이 무너지고, 땅이 갈라질 것만 같았다…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740121004
					]
				},
				{
					"id": 740121004,
					"content": "그리곤… 기계가 펑! 소리를 내며 당신의 손에 테이프를 뱉어냈다.\\n세상은 또다시 정적에 휩싸였다",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740121005
					]
				},
				{
					"id": 740121005,
					"content": "이… 이게 다야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740121006
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740121006,
					"content": "으음… 뭐라고 적혀 있는지는 모르겠지만 엄청 중요한 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740121007
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740121007,
					"content": "#{NICKNAME}, 일단 테이프는 우리가 챙겨갈까? 언젠가 쓸 일이 생길지도 모르니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
