			},
			"dialogs": [
				{
					"id": 740590201,
					"content": "#{NICKNAME} {M#오빠}{F#언니}랑 페이몬이네. 오랜만이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590202
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740590202,
					"content": "전에 말했던 이상한 돌을 또 모으러 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590203
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740590203,
					"content": "음, 그것도 맞긴 한데 이야기하자면 길어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740590204,
					"content": "체실에게 받은 시계를 푸카에게 전해주고, 체실이 기이한 광석을 이용해 시계를 만들고 싶어한다는 일을 푸카에게 알려준다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590205
					]
				},
				{
					"id": 740590205,
					"content": "저, 정말 대단해. 그 돌로 이런 물건을 만들 수 있었어?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590206
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740590206,
					"content": "응? 아니 그냥 부품에 있는 보석만 그 돌로 만든 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740590207,
					"content": "물속에서도 똑딱거리는 소리가 나다니, 이런 시계는 처음 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590208
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740590208,
					"content": "음, 체실이 무슨 구조로 만들었다고 했는데… 굴이었나? 아님 조개?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740590209,
					"content": "헤헤, 시계에서 나는 소리만 들어도 기분이 좋아져!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590210
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740590210,
					"content": "이런 평범한 돌도 쓸모가 있다니 생각도 못 했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590211
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740590211,
					"content": "줄곧 언니처럼 귀한 보석을 써야지만 굉장한 작품을 만들어낼 수 있는 줄 알았는데, 평범한 돌로도 이렇게 대단한 걸 만들 수 있다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590212
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740590212,
					"content": "뭐든지 다 쓸모가 있는 법이지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590213
					]
				},
				{
					"id": 740590213,
					"content": "응응, 푸카도 스스로한테 갑자기 자신감이 생겼어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590214
					],
					"speakerTitle": "푸카"
				},
				{
					"id": 740590214,
					"content": "푸카는 조심스레 시계를 예쁜 곳에 올려놓는다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590215
					]
				},
				{
					"id": 740590215,
					"content": "아무튼 그래서 푸카가 광석을 준비해서 체실에게 팔면 좋을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740590216,
					"content": "그렇게 하면 푸카도 언니처럼 자신만의 보석 공방을 가질 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740590217,
					"content": "푸카한테 있는 다양한 돌도 어쩌면 각자의 쓸모를 찾을 수 있을지도 모르지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740590218,
					"content": "응, 열심히 준비할게. 고마워!",
					"roleType": "TALK_ROLE_NPC",
