			"dialogs": [
				{
					"id": 750090201,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090202
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090202,
					"content": "이 공은… 무슨 부품 같이 생겼네. 너 이게 마음에 들어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750090203,
					"content": "웅… 꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090204,
					"content": "발굴한 건 아니지만 그래도 여기서 발견했으니… 엄청 값진 걸지도 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750090205,
					"content": "나갈 때 한번 물어보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
