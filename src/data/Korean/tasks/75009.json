			"dialogs": [
				{
					"id": 750090101,
					"content": "…입장료는 300 모라야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090102,
						750090103
					],
					"speakerTitle": "퀴피아"
				},
				{
					"id": 750090102,
					"content": "좀 깎아 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090105
					]
				},
				{
					"id": 750090105,
					"content": "용 유물 연구 협회에서 정한 가격이라 협상의 여지는 없어. 내가 알기로 여긴 가격이 가장 싼 발굴장이야. 아무래도 개발된 지 오래됐으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090106
					],
					"speakerTitle": "퀴피아"
				},
				{
					"id": 750090106,
					"content": "그래도 가끔 너희 같은 몽상가들이 여기서 자신의 운을 시험해보려 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090107
					],
					"speakerTitle": "퀴피아"
				},
				{
					"id": 750090107,
					"content": "혹시 알아? 지금까지 들어간 수천수만의 사람들이 전부 보는 눈이 없어서 평범해 보이지만 사실 엄청 값비싸고 진귀한 용 유물을 놓쳤을지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090108
					],
					"speakerTitle": "퀴피아"
				},
				{
					"id": 750090108,
					"content": "일확천금을 꿈꾸며 300 모라를 기꺼이 내는 사람은 많다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090109
					],
					"speakerTitle": "퀴피아"
				},
				{
					"id": 750090109,
					"content": "그래서, 넌 그 유일무이한 행운아가 너일 거라고 생각해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090110
					],
					"speakerTitle": "퀴피아"
				},
				{
					"id": 750090110,
					"content": "우웅… 꺄악! 꺄꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090111,
						750090112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090111,
					"content": "전 제 운에 자신 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090113,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, 너도 운을 시험해 보고 싶어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750090114,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090115,
					"content": "관심이 많은 것 같은데? 흠흠, 300 모라쯤이야, 내가 낼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750090116,
					"content": "고작 300 모라로 3개의 희망을 살 수 있으니, 완전 수지맞는 장사네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750090117,
					"content": "그럼, 너희에게 행운이 가득하길 빌게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "퀴피아"
				},
				{
					"id": 750090112,
					"content": "괜찮아요. 저에겐 행운의 꼬마 용이 있으니까요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090103,
					"content": "당신을 쓰러뜨리면 무료 입장인 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090104
					]
				},
				{
					"id": 750090104,
					"content": "보통 그런 생각은 안 하거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090105
					],
					"speakerTitle": "페이몬"
				}
			]
		},
