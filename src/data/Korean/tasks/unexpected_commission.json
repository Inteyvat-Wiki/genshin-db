			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"앨리스",
					"리사"
				],
				"points": [
					{
						"sceneId": 1004,
						"position": [
							-16.379,
							-5.223,
							-16.718
						],
						"pointId": 286
					}
				]
			},
			"dialogs": [
				{
					"id": 706900201,
					"content": "휴, 이제 마지막 한 더미만 남았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 706900202,
					"content": "근데 이게 다 뭐람… 《츄츄족 생존 강좌》? 츄츄족은 어차피 책을 안 읽잖아. 《구라구라꽃 재배 가이드》? 그런 걸 누가 길러!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 706900203,
					"content": "그리고 《꼬마 마녀 사전》… 음, 이름부터 수상해. 게다가 아까 이쪽을 정리할 때 이런 책은 못 보지 않았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900204,
						706900206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 706900204,
					"content": "목록에도 없는 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900205
					]
				},
				{
					"id": 706900205,
					"content": "마녀라고 하면 떠오르는 사람이 있긴 한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 706900207,
					"content": "어머, 나 찾았니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900208
					],
					"speakerTitle": "앨리스"
				},
				{
					"id": 706900208,
					"content": "어? 앨리스! 갑자기 어디서 튀어나왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 706900209,
					"content": "아직 눈치 못 챘구나? 내가 갑자기 튀어나온 게 아니라, 사전을 여는 순간 너희가 마녀의 「영역」으로 들어온 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900210
					],
					"speakerTitle": "앨리스"
				},
				{
					"id": 706900210,
					"content": "세상에, 어쩐지 이 책이 수상하더라니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 706900211,
					"content": "후후, 혹시 《꼬마 마녀와 꺼지지 않는 불》이라는 이야기책 읽어봤니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900212,
						706900214
					],
					"speakerTitle": "앨리스"
				},
				{
					"id": 706900212,
					"content": "어디서 읽어본 것 같아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900213
					]
				},
				{
					"id": 706900213,
					"content": "그럼 설명이 쉽겠네. 실제 내용은 전혀 관련이 없지만, 이건 그 이야기책을 쓰기 위한 사전이라고 볼 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900216
					],
					"speakerTitle": "앨리스"
				},
				{
					"id": 706900216,
					"content": "그렇게 말하니까 더 헷갈려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 706900217,
					"content": "흐음, 어디서부터 말해야 하나… 예전에 삼자 회담에서 마녀회가 바르카에게 한 「약속」은 알고 있지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900218
					],
					"speakerTitle": "앨리스"
				},
				{
					"id": 706900218,
					"content": "「훗날, 몬드에 가장 도움이 필요할 때, 마녀들은 이곳으로 돌아와 몬드의 힘이 되겠다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900219
					],
					"speakerTitle": "앨리스"
				},
				{
					"id": 706900219,
					"content": "하지만 위험이 닥칠 때까지 얌전히 기다리는 건 마녀회의 스타일이 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900220
					],
					"speakerTitle": "앨리스"
				},
				{
					"id": 706900220,
					"content": "M이 그랬어. 「이야기 마지막에 갑자기 등장하는 것보다, 사전에 복선을 깔아두는 편이 받아들이기 쉽다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900221
					],
					"speakerTitle": "앨리스"
				},
				{
					"id": 706900221,
					"content": "게다가 위기가 언제 닥칠지 누가 알겠어? 다음 생일 수도 있고, 당장 내일일 수도 있는걸. 미리 대비를 해둬야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900222
					],
					"speakerTitle": "앨리스"
				},
				{
					"id": 706900222,
					"content": "그래서 마녀들한테 이 사전을 써 달라고 부탁한 거야. 물론, 그 이야기책을 명분으로 겨우 불러 모으긴 했지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900223,
						706900224
					],
					"speakerTitle": "앨리스"
				},
				{
					"id": 706900223,
					"content": "고생 많으셨네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900225
					]
				},
				{
					"id": 706900225,
					"content": "간단히 말할게. 이 사전에는 마녀들이 바르의 수점반을 본 뒤, 몬드 친구들을 위해 맞춤형으로 만든 「과제」가 들어있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900226
					],
					"speakerTitle": "앨리스"
				},
				{
					"id": 706900226,
					"content": "공통의 목표를 위해 동료들과 어려움을 이겨내고, 그 안에서 성장하는 것! 이거야말로 위기가 닥치기 전에 할 수 있는 최선의 준비지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900227
					],
					"speakerTitle": "앨리스"
				},
				{
					"id": 706900227,
					"content": "뭔가 엄청난 일이라도 벌어지는 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900228
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 706900228,
					"content": "그런 말은 아니고. 근데 「동료」라… 몬드의 모두가 「동료」라고 부를 만한 사람은, 아무래도 한 명뿐인 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900229,
						706900230
					],
					"speakerTitle": "앨리스"
				},
				{
					"id": 706900229,
					"content": "알아들었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900231
					]
				},
				{
					"id": 706900231,
					"content": "설마 처음부터 이러려고 우리를 끌어들인 건 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900232
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 706900232,
					"content": "응? 설마, 그럴 리가~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900233
					],
					"speakerTitle": "앨리스"
				},
				{
					"id": 706900233,
					"content": "참나, 완전 뻔뻔해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900234
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 706900234,
					"content": "하하하, 하지만 이렇게 중요한 물건을 티바트에 대충 들여올 순 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900235
					],
