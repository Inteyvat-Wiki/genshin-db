					"강성"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718180201,
					"content": "할멈, 왔구만?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180202
					],
					"speakerTitle": "강성"
				},
				{
					"id": 718180202,
					"content": "죄송해요. 사람 잘못 보셨어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180203
					]
				},
				{
					"id": 718180203,
					"content": "휴, 나 아직 멀쩡해…. 내가 어찌 임자를 못 알아보겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180204
					],
					"speakerTitle": "강성"
				},
				{
					"id": 718180204,
					"content": "마침 당신 생각 중이었다오. 명절인데 우리 딸 새 옷 사입혀야 하는 거 아닌가…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180205
					],
					"speakerTitle": "강성"
				},
				{
					"id": 718180205,
					"content": "에구… 이번엔 사람을 많이도 데리고 왔구먼…아, 재봉사를 데려온 거군? 또 마음이 통한 게로지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180206
					],
					"speakerTitle": "강성"
				},
				{
					"id": 718180206,
					"content": "강성 할아버지, 저 소백이에요. 이틀 전에 두부 가져다드렸는데 기억 안 나세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180207
					],
					"speakerTitle": "소백"
				},
				{
					"id": 718180207,
					"content": "아… 소백이… 소백이구나! 기억하다마다! 얼마 전에 네 아비가 와서 칭찬하더구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180208
					],
					"speakerTitle": "강성"
				},
				{
					"id": 718180208,
					"content": "흠… 그게 언제였더라… 임자, 기억하오…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180209,
						718180210
					],
					"speakerTitle": "강성"
				},
				{
					"id": 718180209,
					"content": "…기억해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				},
				{
					"id": 718180211,
					"content": "허! 요즘 왜 이렇게 오락가락하는지…. 그리고, 그리고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180212
					],
					"speakerTitle": "강성"
				},
				{
					"id": 718180212,
					"content": "강성 할아버지, 너무 무리하지 마시고 좀 쉬셔요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180213
					],
					"speakerTitle": "소백"
				},
				{
					"id": 718180213,
					"content": "여행자, 아니면 당신이 먼저 강성 할아버지 댁에 가서 청소 좀 해주실래요? 저는 할아버님과 대화 좀 하고 있을게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180214
					],
					"speakerTitle": "소백"
				},
				{
					"id": 718180214,
					"content": "제게 맡겨요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180215
					]
				},
				{
					"id": 718180215,
					"content": "그럼 부탁드려요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소백"
				},
				{
					"id": 718180210,
					"content": "당연히 기억하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180211
					]
				}
			]
		},
