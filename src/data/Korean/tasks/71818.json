				"points": []
			},
			"dialogs": [
				{
					"id": 718180101,
					"content": "안녕하세요, 여행자. 저번엔 정말 감사했어요~ 경책 산장이 그렇게 떠들썩했던 적은 없었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180102
					],
					"speakerTitle": "소백"
				},
				{
					"id": 718180102,
					"content": "천만에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180103
					]
				},
				{
					"id": 718180103,
					"content": "작년엔 저와 지아 둘이서 아이들에게 소등을 만들어 주고, 어르신들과 수다 떨며, 음식 좀 만들어 먹는 게 다였는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180104
					],
					"speakerTitle": "소백"
				},
				{
					"id": 718180104,
					"content": "올해는 당신 덕분에 왁자지껄한 해등절을 보낼 수 있었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180105
					],
					"speakerTitle": "소백"
				},
				{
					"id": 718180105,
					"content": "그래도 떠들썩한 건 떠들썩한 거고… 전 마을 어르신들께 가보려고요. 오늘은 강성 할아버님을 뵈러 갈까 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180106
					],
					"speakerTitle": "소백"
				},
				{
					"id": 718180106,
					"content": "원한다면 당신도 함께 가실래요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180107
					],
					"speakerTitle": "소백"
				},
				{
					"id": 718180107,
					"content": "그럼, 같이 가요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180108
					]
				},
				{
					"id": 718180108,
					"content": "네, 좋아요. 그럼 우선 강성 할아버님께로 가보죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소백"
				}
			]
		},
		{
			"id": 7181802,
			"completionStepIds": [
				7181802
			],
