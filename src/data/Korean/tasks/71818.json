				"points": []
			},
			"dialogs": [
				{
					"id": 718180401,
					"content": "소등 다 걸었어? 예뻐, 정말 보기 좋군. 새해도 분명 좋은 한 해가 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180402,
						718180403
					],
					"speakerTitle": "강성"
				},
				{
					"id": 718180402,
					"content": "꼭 그럴 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180404
					]
				},
				{
					"id": 718180404,
					"content": "강성 할아버지, 그럼 전 일이 있어서 이만 가고 다음에 또 뵈러 올게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180405
					],
					"speakerTitle": "소백"
				},
				{
					"id": 718180405,
					"content": "그래그래, 젊은이는 항상 바쁘지…. 눈코 뜰 새 없이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718180406
					],
					"speakerTitle": "강성"
				},
				{
					"id": 718180406,
					"content": "안녕히 계세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718180407
					]
				},
				{
					"id": 718180407,
					"content": "후, 임자… 우리 밭 돌보는 거 잊지 말구려…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "강성"
				},
				{
					"id": 718180403,
