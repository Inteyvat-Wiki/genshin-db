			},
			"dialogs": [
				{
					"id": 230400401,
					"content": "어때? 붉은 독수리들은 전부 해치웠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400402,
						230400403
					],
					"speakerTitle": "나자트"
				},
				{
					"id": 230400402,
					"content": "다 끝냈어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				},
				{
					"id": 230400404,
					"content": "정말 고마워. 이제 하바치 씨가 제대로 식사를 할 수 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400405
					],
					"speakerTitle": "나자트"
				},
				{
					"id": 230400405,
					"content": "참, 이건 보수니까 받아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400406
					],
					"speakerTitle": "나자트"
				},
				{
					"id": 230400406,
					"content": "음, 오늘은 어떤 화물이 입고될 예정이더라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "나자트"
				},
				{
					"id": 230400403,
					"content": "아마 한동안은 괜찮을 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				}
			]
		},
		{
			"id": 2304005,
			"completionStepIds": [
				2304005
			],
