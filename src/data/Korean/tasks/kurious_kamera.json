			"dialogs": [
				{
					"id": 414010101,
					"content": "이상하네, 이 「사진기」 대체 왜 이래…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010102
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414010102,
					"content": "「사진기」가 왜요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010103
					]
				},
				{
					"id": 414010103,
					"content": "고장 난 것 같아…. 아무튼 잘 안돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010104
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414010104,
					"content": "전에 폰타인에서 「사진기」를 좀 주문했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010105
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414010105,
					"content": "상인이 그 「사진기」들은 폰타인의 최신 기술을 사용했다고 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010106
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414010106,
					"content": "인화된 색과 효과가 더 특이하다고 해서 한 대 사 왔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010107
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414010107,
					"content": "근데 내 방법이 잘못된 건지 아님 이 「사진기」 자체에 문제가 있는 건지 정상적인 사진이 안 나와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010108
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414010108,
					"content": "설마 정말 사용 방법에 문제가 있는 건가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010109
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414010109,
					"content": "참, 혹시 자네 「사진기」에 대해서 잘 아나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010110,
						414010112
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414010110,
					"content": "그럭저럭 알아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010111
					]
				},
				{
					"id": 414010111,
					"content": "잘됐군. 그럼 나 좀 도와줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414010114,
					"content": "보아하니 여행자 같은데, 여기저기 다녀봤으니 아는 것도 많겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010115
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414010115,
					"content": "이 「사진기」로 「색깔」이 아주 강렬한 걸 좀 찍어줬으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010116
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414010116,
					"content": "찍고 나면 인화된 그림을 나한테 가져와 주게. 대체 어디가 잘못된 건지 봐야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010117
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414010117,
					"content": "정 안되면 이걸 판 사람한테 가서 따져봐야지. 인화된 그림들도 있으니 발뺌은 못하겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010118,
						414010120
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414010118,
					"content": "제게 맡겨요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010119
					]
				},
				{
					"id": 414010119,
					"content": "그럼 부탁해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동식"
				},
				{
					"id": 414010120,
					"content": "「색깔」이 강렬한 거요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010121
					]
				},
				{
					"id": 414010121,
					"content": "음, 그러니까 색조가 선명한 거 말이야. 빨간 절운고추나 파란 서리꽃 같은 거 말이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010122
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414010122,
					"content": "다 찍고 나면 인화된 그림을 나한테 갖다주게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동식"
				},
				{
					"id": 414010112,
					"content": "잘 몰라요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010113
					]
				},
				{
					"id": 414010113,
					"content": "음… 괜찮아. 그렇게 복잡한 물건은 아니니까… 나 좀 도와주지 않겠나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "동식"
				}
			]
		}
	]
}