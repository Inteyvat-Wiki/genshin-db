					"nextDialogs": [
						250261607
					]
				},
				{
					"id": 250261607,
					"content": "우선 그냥 놔두자. 조금 더 크면 우리랑 가까워 질 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
