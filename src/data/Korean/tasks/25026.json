			"dialogs": [
				{
					"id": 250260401,
					"content": "같이 보물 사냥단을 혼내주러 가요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260402
					]
				},
				{
					"id": 250260402,
					"content": "나랑 같이 가줄래? 정말 다행이야. 보아하니 너도… 경험이 풍부한 모험가구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260403
					],
					"speakerTitle": "틀라못"
				},
				{
					"id": 250260403,
					"content": "모험가 규칙에 맞춰서 보수를 준비해 둘게. 그럼, 바로 출발할까? 그놈들한테 본때를 보여주자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "틀라못"
