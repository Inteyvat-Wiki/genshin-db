					"id": 705190301,
					"content": "우리 명예 기사 나으리! 그리고 「티바트 최고의 가이드」 페이몬! 자선 판매 행사 좀 도와줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705190302
					],
					"speakerTitle": "베른하르트"
				},
				{
					"id": 705190302,
					"content": "베른하르트를 도와 자선 판매 가게를 준비한다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705190303
					]
				},
				{
					"id": 705190303,
					"content": "다들 수고했어. 이제 영업을 시작하지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베른하르트"
				}
			]
		}
