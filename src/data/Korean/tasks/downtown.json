					"nextDialogs": [
						10130304
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10130304,
					"content": "나뭇가지 50개랑 목재 20개가 필요해요！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10130305
					]
				},
				{
					"id": 10130305,
					"content": "문제없어. <color=#00E1FFFF>2만 모라</color> 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130306
					],
					"speakerTitle": "대복"
				},
				{
					"id": 10130306,
					"content": "좋아. 거래하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10130307,
						10130308
					],
					"speakerTitle": "종려"
				},
				{
					"id": 10130307,
					"content": "안 돼요, 가격 협상 좀 합시다…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 10130308,
					"content": "좋아요. 거래 성사!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
