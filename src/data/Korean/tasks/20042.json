					],
					"speakerTitle": "엘버트"
				},
				{
					"id": 200420604,
					"content": "맞다, 바바라 아가씨에겐 말하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420605
					],
					"speakerTitle": "엘버트"
				},
				{
					"id": 200420605,
					"content": "그냥 도와주고 싶어서 이런 거니까, 괜히 폐 끼치고 싶지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
