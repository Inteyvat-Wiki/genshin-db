					"nextDialogs": [
						200421006
					]
				},
				{
					"id": 200421006,
					"content": "내 말 끝까지 들어! 바바라가 너무 좋아서 나도 그녀처럼 몬드성을 위해 뭔가를 하고 싶어",
					"roleType": "TALK_ROLE_NPC",
