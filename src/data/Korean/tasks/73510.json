	"talks": [
		{
			"id": 7351001,
			"completionStepIds": [
				7351001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7351001",
							"2"
						],
						"stepId": 7351001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"하자나드"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735100101,
					"content": "하자나드, 우리가 좋은 소식을 갖고 왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735100102,
					"content": "잠깐만, 너희가 들고 있는 「부글부글 장치」의 신호를 느껴볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100103
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735100103,
					"content": "아, 식지 않은 뜨거운 온기와 자성의 메아리가 마치 연금용 포션의 합주곡 같아. 온몸에 전율이 흘러…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100104
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735100104,
					"content": "정말 완벽해! 너희가 확보해준 데이터라면 최고의 보고서를 쓸 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100105
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735100105,
					"content": "정말이야? 난 아무것도 못 느끼겠는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735100106,
					"content": "「날아다니는 하얀색 스마트 도우미 단말기」… 아카데미아 학생 심야어록 같은 걸 읽어보길 추천할게. 어휘력을 크게 향상시킬 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100107
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735100107,
					"content": "그러면 각종 절묘한 비유를 이해하게 되고, 유머 능력이랑 스트레스 저항력도 훨씬 늘어나게 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100108
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735100108,
					"content": "#싫어! 하나도 못 알아듣겠다구. 게다가 내가 스트레스가 어딨어? {NICKNAME}이(가) 나한테 무슨 이상한 연구를 시키는 것도 아닌데 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735100109,
					"content": "중요한 건 그게 아니야. 약속대로 장치를 테스트해 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735100110,
					"content": "이제 보수를 받을 시간이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735100111,
					"content": "줄게, 줄게! 설마 날 못 믿는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100112
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735100112,
					"content": "엥? 이게 50인분의 보수야? 생각했던 액수랑 좀 다른데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735100113,
					"content": "음… 적다는 건 아니긴 한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100114,
						735100115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735100114,
					"content": "그렇다고 「상당한 모라」도 아니네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100116
					]
				},
				{
					"id": 735100116,
					"content": "뭐? 내가 반년이나 모은 돈이 부족하다고?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100117
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735100117,
					"content": "내가 용병의 보수를 너무 과소평가했나? 지도 교수님이 나한테 준 일당만큼 용병들한테 지불하려고 했는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100118
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735100118,
					"content": "내 새로운 교수님은 통이 크셔서, 그분을 따른 후론 매일 샤와르마를 하나씩 사 먹어도 자금이 남거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100119
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735100119,
					"content": "상점에서 밀가루를 사서 밖에서 채집한 뚠뚠 복숭아와 함께 길은 물에 끓여 먹으면… 하루치 자금으로 2주나 먹고살 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100120
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735100120,
					"content": "그렇게 남은 자금은 모두 「부글부글 혼합제」 연구에 투입했고, 이번 용병 보수도 그렇게 모은 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100121,
						735100122
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735100121,
					"content": "음식에 대한 요구 기준이 너무 낮네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100123
					]
				},
				{
					"id": 735100123,
					"content": "대체 어떻게 지금까지 버틴 거야…. 하나자드, 너무 고생하는 것 같은데 몸 좀 챙겨!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735100124,
					"content": "배부를 때까지 먹어 줘야 제대로 한 끼 먹었다 하는 거지. 겨우 샤와르마 하나로 어떻게 충분하다는 거야! 매일 밀가루 반죽이나 먹으면 몸이 망가지고 말 거라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735100125,
					"content": "그래그래, 알았어. 난 잘 지내고 있는 편이야! 어떤 학생들은 학업을 마치기 위해 오히려 모라를 보태기도 하는걸? 나도 예전엔 밥조차 제대로 먹지 못했다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100126
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735100126,
					"content": "난 아주 행복해! 새로운 지도 교수님이 승인해주신 넉넉한 예산 덕분에 매일 배를 채울 수 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100127
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735100127,
					"content": "전혀 이해를 못 했네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100128
					]
				},
				{
					"id": 735100128,
					"content": "여행자! 우리 하자나드를 데리고 호화로운 요리를 먹으러 가자. 그럼 음식에 대한 기준이 올라갈 거야. 적어도 지금처럼 대충 때우진 않겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735100129,
					"content": "아니야, 됐어! 고용주가 의뢰인한테 밥을 얻어먹는 법이 어디 있어! 관심 가져줘서 고맙긴 한데, 진짜 걱정할 필요 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100130
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735100130,
					"content": "학술에 진전이 생기고 내 능력을 증명해 보이기만 한다면 언젠간 출세할 거야! 호화로운 음식을 먹으며 사는 건 지금 고려해야 할 사항이 아니지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100131
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735100131,
					"content": "더 이상 시간 낭비하면 안 되겠다. 난 이만 보고서를 쓰러 가볼게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100132
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735100132,
					"content": "그럼 적어도 과일이랑 채소 좀 챙겨 가서 영양 보충이라도 해. 우리 배낭엔 일몰 열매랑 양배추가 아주 많거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735100133,
					"content": "흐흐… 헤헤… 아하하하하하… 벌써 입이 떡 벌어지는 교수님의 모습이 그려져!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100134
					],
					"speakerTitle": "하자나드"
				},
				{
					"id": 735100134,
					"content": "하자나드는 페이몬의 말을 한 귀로 흘린 채, 미친 듯이 웃으며 휘청거리다 사라졌다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735100135
					]
				},
				{
					"id": 735100135,
					"content": "으, 가버렸네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100136
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735100136,
					"content": "이대로 가다간 하자나드는 영양 부족으로 쓰러질 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100137,
						735100138
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735100137,
					"content": "지도 교수님이 눈치채시겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100139
					]
				},
				{
					"id": 735100139,
					"content": "응… 하자나드 말대로라면 새로운 지도 교수가 꽤 신경 써주는 것 같아. 문제없겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100140
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735100140,
					"content": "하자나드가 연구를 잘 끝내고 모라도 많이 벌어서 정상적인 삶을 살았으면 좋겠다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100141
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735100141,
					"content": "나중에 하자나드를 다시 만났을 땐, 건강 쪽으로 걱정할 필요도 없고, 우리한테 더 많은 보수를 줄 수 있을지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735100138,
					"content": "연구광이 무사했으면 좋겠네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100139
					]
				},
				{
					"id": 735100122,
					"content": "생활 수준이 너무 위태롭네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100123
					]
				},
				{
					"id": 735100115,
					"content": "기대했던 만큼은 아니네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100116
					]
				}
			]
		}
	]
}