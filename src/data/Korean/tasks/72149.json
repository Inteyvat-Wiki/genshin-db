					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721490201,
					"content": "#어서 오세요, {NICKNAME}. 무슨 일로 오셨나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490202
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721490202,
					"content": "의뢰에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490203
					]
				},
				{
					"id": 721490203,
					"content": "「어령 진주」 4개 모두 다 가져왔어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721490204,
					"content": "정말요? 정말 다행이네요, 감사합니다! 그럼 마지막 봉인인 「심(心)」 해제가 얼마 남지 않았네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490205
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721490205,
					"content": "그럼 마지막은 저와 함께 가시죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490206
					],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721490206,
					"content": "#이곳까지 왔는데 더 한다고 죽기야 하겠어? 그렇지, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490207,
						721490208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721490207,
					"content": "알았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				},
				{
					"id": 721490209,
					"content": "한시가 급하니 바로 출발하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "츠유코"
				},
				{
					"id": 721490208,
					"content": "알겠습니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				}
			]
		},
