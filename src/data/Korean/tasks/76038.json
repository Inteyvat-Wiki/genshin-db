			"trigger": {
				"objectNames": [
					"후나야타"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380101,
					"content": "(<color=#FFCC33FF>네페르</color>가 설탕 공예에 관심이 있을지도…?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380102
					]
				},
				{
					"id": 760380102,
					"content": "사탕 공예 하나 부탁해, 후나야타",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380103
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 760380103,
					"content": "네페르 사장님, 어쩐 일로 설탕 공예를 사러 여기까지 오셨어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380104
					],
					"speakerTitle": "후나야타"
				},
				{
					"id": 760380104,
					"content": "가끔 산책하는 게 몸과 정신에 좋거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380105
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 760380105,
					"content": "달콤한 걸 먹으면 생각 정리에도 도움이 되고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380106
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 760380106,
					"content": "좋아요~ 잠시만요, 바로 만들어 드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380107
					],
					"speakerTitle": "후나야타"
				},
				{
					"id": 760380107,
					"content": "그래. 참, 이 돈 받아. 다음에 야호다가 오면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380108
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 760380108,
					"content": "좀 더 크게 만들어 줄까요? 아니면 더 달게?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380109
					],
					"speakerTitle": "후나야타"
				},
				{
					"id": 760380109,
					"content": "그냥 이 돈을 주고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380110
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 760380110,
					"content": "이렇게 전해 줘: 「네페르가 이미 돈을 냈으니까, 게으름 다 피웠으면 올 때 네페르 몫도 하나 더 챙겨 와」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "네페르"
				}
			]
		},
