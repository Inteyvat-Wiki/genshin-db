				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380310,
					"content": "(<color=#FFCC33FF>라우마</color>가 설탕 공예에 관심이 있을지도…?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380301
					]
				},
				{
					"id": 760380301,
					"content": "후나야타 씨, 저도 설탕 공예 몇 개 만들어 주실 수 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380302
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 760380302,
					"content": "그럼요, 라우마 님. 지난번 가져가신 건 아이들이 좋아하던가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380303
					],
					"speakerTitle": "후나야타"
				},
				{
					"id": 760380303,
					"content": "아주 좋아했어요. 어떤 아이는 아까워서 먹지도 못하고, 다 녹을 때까지 쥐고 있다가 천천히 먹어보더군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380304
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 760380304,
					"content": "그랬군요… 음, 다음엔 아예 도구를 가지고 가서, 아이들 앞에서 직접 만들어 드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380305
					],
					"speakerTitle": "후나야타"
				},
				{
					"id": 760380305,
					"content": "그럼 너무 좋죠. 아이들이 아주 기뻐할 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380306
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 760380306,
					"content": "아, 이야기가 다른 쪽으로 새버렸네요… 전 이제 설탕 공예를 하러 가볼게요. 완성되면 사람을 불러서 그쪽으로 가져다드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380307
					],
					"speakerTitle": "후나야타"
				},
				{
					"id": 760380307,
					"content": "하지만 그 전에… 헤헤, 방금 막 영감이 떠올랐어요~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380308
					],
					"speakerTitle": "후나야타"
				},
				{
					"id": 760380308,
					"content": "잠시만 기다려 주세요, 라우마 님. 특별한 걸 하나 만들어 드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "후나야타"
				}
			]
		},
