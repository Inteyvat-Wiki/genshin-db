			"dialogs": [
				{
					"id": 730410101,
					"content": "아, 금빛의 나라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410102
					],
					"speakerTitle": "아란니샤트"
				},
				{
					"id": 730410102,
					"content": "나라 친구, 아란릴라랑 같이 놀자! 아란니샤트는 엄청 약하니까 같이 놀지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410103
					],
					"speakerTitle": "아란릴라"
				},
				{
					"id": 730410103,
					"content": "풋, 저번엔 아란릴라가 아란니샤트한테 졌으니까 아란릴라가 더 약한 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410104
					],
					"speakerTitle": "아란니샤트"
				},
				{
					"id": 730410104,
					"content": "좋아. 입으로만 겨룰 거 없이, 마침 나라 친구도 왔으니 같이 놀 겸 누가 더 강한지 시합해보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410105
					],
					"speakerTitle": "아란릴라"
				},
				{
					"id": 730410105,
					"content": "좋아, 아란니샤트도 바라던 바야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410106
					],
					"speakerTitle": "아란니샤트"
				},
				{
					"id": 730410106,
					"content": "아란릴라가 먼저 숨고 나라 친구가 찾는 거야. 그 다음엔 아란니샤트가 숨고 나라 친구가 찾는 거지. 먼저 잡히는 사람이 지는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410107
					],
					"speakerTitle": "아란릴라"
				},
				{
					"id": 730410107,
					"content": "나라 친구, 같이 놀지 않을래? 준비 됐으면 바로 시작하자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란릴라"
				}
			]
		},
