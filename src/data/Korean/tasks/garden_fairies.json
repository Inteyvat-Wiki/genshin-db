			"dialogs": [
				{
					"id": 730410501,
					"content": "하하하하하하! 역시 아란릴라는 약하다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410502
					],
					"speakerTitle": "아란니샤트"
				},
				{
					"id": 730410502,
					"content": "금빛의 나라는 역시 대단해. 이렇게 빨리 들켜버리다니… 흑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410503
					],
					"speakerTitle": "아란릴라"
				},
				{
					"id": 730410503,
					"content": "금빛의 나라가 대단한 건 맞지만 아란릴라가 약한 게 더 큰 원인이었겠지. 아란니샤트는 쉽게 못 찾을 거야. 그럼 기대하라고~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란니샤트"
				}
			]
