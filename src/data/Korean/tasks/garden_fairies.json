			"dialogs": [
				{
					"id": 730410601,
					"content": "앗! 말도 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410602
					],
					"speakerTitle": "아란니샤트"
				},
				{
					"id": 730410602,
					"content": "아란니샤트도 금방 들켰네. 아란릴라랑 똑같이 약해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410603
					],
					"speakerTitle": "아란릴라"
				},
				{
					"id": 730410603,
					"content": "흑… 다 약해, 금빛의 나라만 강해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410604
					],
					"speakerTitle": "아란니샤트"
				},
				{
					"id": 730410604,
					"content": "이대로는 안 돼, 아란라칼라리를 단련해야겠어. 강력한 아란라칼라리가 있으면 나라 친구도 날 찾지 못하겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410605,
						730410607
					],
					"speakerTitle": "아란릴라"
				},
				{
					"id": 730410605,
					"content": "그거랑은 좀 다른 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730410606
					]
				},
				{
					"id": 730410606,
					"content": "나라 친구, 질까 봐 무서운 거야? 게임에서 승패는 중요하지 않아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410609
					],
					"speakerTitle": "아란릴라"
				},
				{
					"id": 730410609,
					"content": "졌지만 재밌었어. 금빛의 나라는 역시 착한 나라야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410610
					],
					"speakerTitle": "아란릴라"
				},
				{
					"id": 730410610,
					"content": "나라 친구가 이겼어, 정말 굉장해! 우리 꽃을 받아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410611
					],
					"speakerTitle": "아란니샤트"
				},
				{
					"id": 730410611,
					"content": "착한 나라, 고마워! 넌 우리 친구야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란릴라"
				},
