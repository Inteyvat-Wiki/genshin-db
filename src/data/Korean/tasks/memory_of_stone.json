			"dialogs": [
				{
					"id": 730150901,
					"content": "#나라{NICKNAME}, 이건 아란나라가 나라바루나를 위해 남긴 돌의 기억이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150902
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730150902,
					"content": "드디어 도착했네… 버섯몬한테 들키지 않으려고 오는길 내내 조심조심…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150903,
						730150905
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730150903,
					"content": "싸움을 피하는 것도 나쁘지 않아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150904
					]
				},
				{
					"id": 730150904,
					"content": "그렇게 말할 수 있긴 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150907
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730150907,
					"content": "음… 근데, 이게 「돌의 기억」일까? 아란나라가 세운 비석 같아 보이는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150908
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730150908,
					"content": "#나라{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150909
					],
					"speakerTitle": "아란나쿨라"
				},
				{
					"id": 730150909,
					"content": "내가 나쁜 씨앗을 없애줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150910
					]
				},
				{
					"id": 730150910,
					"content": "#아란나쿨라 너무 걱정하지마. 이런 사소한 일은 나라{NICKNAME}한테 맡기면 돼. 식은 죽 먹기 일 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730150905,
					"content": "비상식량을 숲에 비축해 뒀다고 생각하자…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150906
					]
				},
				{
					"id": 730150906,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150907
					],
					"speakerTitle": "페이몬"
				}
			]
