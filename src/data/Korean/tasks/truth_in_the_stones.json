						"stepId": 1112102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"곤균"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210201,
					"content": "균이, 뭐 보고 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210202,
					"content": "왔구나. 마침 잘 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210203
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111210203,
					"content": "발견한 거라도 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210204
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210204,
					"content": "여기 광석이 있어요. 이걸로 단서를 얻을 수 있을지도 몰라요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210205
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111210205,
					"content": "광석? 그게 실종사건이랑 무슨 상관인데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210206,
					"content": "그건 해보면 알 거야. 잠깐 기다려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210207
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111210207,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210208
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111210208,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210209
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210209,
					"content": "엄청 집중하고 있어. 뭘 하려는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210210,
					"content": "보인다. 어른 네 명이… 아이로 보이는 사람을 따라 광산 구역을 나갔군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210211
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111210211,
					"content": "아이? 광산에 웬 아이?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210212,
					"content": "나도 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210213
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111210213,
					"content": "그리고 「보이다」니, 그게 무슨 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210214,
					"content": "아, 말 그대로 눈에 「보인다」고. 다른 사람한테 말하면 안 돼! 좀 이상한 것 같아서 아무한테도 안 알려줬거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210215
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111210215,
					"content": "사실, 난 광석의 기억을 볼 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210216
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111210216,
					"content": "에엥——?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210217,
					"content": "추측과 짐작이 아니라, 실제로 「보인다」는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210218
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210218,
					"content": "방금처럼 손을 돌 위에 올려놓으면 되는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210219,
					"content": "응, 내가 봤을 땐 광석도 「기억」이 있는 것 같아. 그것들은 가끔 주변에서 일어난 일을 기록해서, 손을 올려놓고 마음을 느끼면 그 「기억」들이 보이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210220
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111210220,
					"content": "짱이다! 그럼 모든 일을 알 수 있겠네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210221,
					"content": "어떤 광석인지도 봐야 해. 광석마다 기억력이 조금씩 다르거든. 철광석이나 백철처럼 흔한 것들은 거의 기억이 흐릿해서 쓸모가 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210222
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111210222,
					"content": "근데 콜 라피스나 수정은 기억력이 더 강하고 기록돼 있는 장면도 훨씬 선명하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210223
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111210223,
					"content": "돌을 눈으로 삼는다라…. 재밌군, 아주 희귀한 능력이야. 대웅 씨가 곤균 씨를 부른 건 정말 현명한 처사였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210224
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210224,
					"content": "하하, 도움이 됐다니 다행이네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210225
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111210225,
					"content": "제가 본 바에 따르면, 그분들은 아마 이 길을 따라 간 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210226
					],
					"speakerTitle": "곤균"
				},
				{
					"id": 111210226,
					"content": "이 길은 북쪽으로 향하니 따라가다 보면 광산 구역을 벗어나게 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210227
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210227,
					"content": "북쪽으로 갔다는 단서를 기록해서 대웅 씨한테 알려주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 1112103,
			"completionStepIds": [
				1112103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112103",
							"2"
						],
						"stepId": 1112103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"범이"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210301,
					"content": "여기서 일하는 사람인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210302
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210302,
					"content": "네, 맞아요! 실종 사건을 조사하러 오셨죠? 부탁입니다, 제발 모두를 찾아주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210303
					],
					"speakerTitle": "범이"
				},
				{
					"id": 111210303,
					"content": "대체 무슨 일이 일어난 건지 모르겠어요…. 그날은 하늘이 유독 흐렸고 반장이 동료들 몇 명과 함께 일하러 나갔죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210304
					],
					"speakerTitle": "범이"
				},
				{
					"id": 111210304,
					"content": "전 다른 동료 4명이랑 광산 근처에 남아 일하다가 중간에 잠깐 게으름 좀 피웠어요…. 진짜 아주 잠깐이었어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210305
					],
					"speakerTitle": "범이"
				},
				{
					"id": 111210305,
					"content": "맨 안쪽 텐트에서 자고 일어났더니, 다들 흔적도 없이 사라진 거예요! 분명 조금 전까지도 같이 얘기했는데, 갑자기… 그냥 없어졌다구요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210306
					],
					"speakerTitle": "범이"
				},
				{
					"id": 111210306,
					"content": "서, 설마 다음은 제 차례 아니겠죠…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210307
					],
					"speakerTitle": "범이"
				},
				{
					"id": 111210307,
					"content": "텐트 안에 숨어 있던 사람은 멀쩡하고, 밖에서 일하던 사람은 없어졌다라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210308
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210308,
					"content": "설마 작업구역에서 무슨 일이 있었던 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210309
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210309,
					"content": "으악! 소름 돋아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210310,
					"content": "작업구역에서 무슨 일이 있었을지도 모른다는 단서도 기록하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 1112104,
			"completionStepIds": [
				1112104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
