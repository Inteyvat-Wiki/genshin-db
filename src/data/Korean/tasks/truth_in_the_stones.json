			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210401,
					"content": "저기 봐, 저게 뭐지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210402,
					"content": "흩어진 윗도리하고 바지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210403,
					"content": "광산 안에 널브러진 옷가지라, 분명 대웅 씨와 동료들 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210404
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210404,
					"content": "하나, 둘, 셋, 넷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210405,
					"content": "음… 맞아, 전부 윗도리 10벌이랑 바지 10벌이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210406,
					"content": "이건 갈아입을 옷이겠지? 봐봐, 대웅 씨도 똑같은 옷을 입고 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210407
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210407,
					"content": "6일 넘게 나가 있으면서 갈아입을 옷도 안 가져갔다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210408
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210408,
					"content": "주위에 세수할 때 쓰는 수건이랑 비누 열매도 있고… 허리에 차는 도구 가방도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210409,
					"content": "세면도구와 광석 채굴 장비라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210410
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210410,
					"content": "그러니까, 그 사람들 짐도 안 챙겨 간 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210411,
					"content": "맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210412,
						111210413
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210412,
					"content": "필요 없는 걸까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				},
				{
					"id": 111210414,
					"content": "아니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210415
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210415,
					"content": "채굴용 곡괭이 4개가 없어졌어. 연장은 챙겨 갔을 가능성이 크지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210416
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210416,
					"content": "연장은 챙기면서 생활용품 챙길 시간은 없었다? 그건 말이 안 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210417
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210417,
					"content": "음… 짐도 없이 연장만 챙겨서 나가는 건 무슨 상황일까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210418
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210418,
					"content": "일단 가까운 곳에 일하러 간 거라면 짐이 필요 없지. 하지만 지금까지 돌아오지 않았으니 그건 아닐 테고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210419
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210419,
					"content": "본인들의 의지로 떠난 게 아니라면, 짐 챙길 여유 같은 건 없었을 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210420
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210420,
					"content": "뭐어——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210421
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210421,
					"content": "누군가 강제로 데려갔다는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210422
					]
				},
				{
					"id": 111210422,
					"content": "그럴 가능성이 커. 자세한 걸 알려면 단서가 더 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210423
					],
					"speakerTitle": "종려"
				},
				{
					"id": 111210423,
					"content": "자발적으로 떠난 게 아니라 누군가에게 잡혀갔을 수도 있다는 거지? 기록해뒀다 대웅 씨한테 알려주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111210413,
					"content": "까먹은 걸까요??",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				}
			]
		},
		{
			"id": 1112107,
