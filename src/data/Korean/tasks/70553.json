			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"바르카"
				],
				"points": [
					{
						"sceneId": 51208,
						"position": [
							2200.306,
							230.219,
							-779.82
						],
						"pointId": 1
					},
					{
						"sceneId": 51208,
						"position": [
							2198.789,
							230.089,
							-777.793
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705530101,
					"content": "어이! 우리의 명예 기사도 헤르타한테 「체포」당해서 일하러 왔나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530102
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530102,
					"content": "아까 음료 노점 얘기를 하면서 술 메뉴를 보니까 참을 수가 없더군. 이제 결과물을 확인해 볼까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530103
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530103,
					"content": "조금 전에도 광장에서 몇 잔 마셨지만… 몸에 해롭지 않은 범위 내라면, 좀 더 마셔줘도 괜찮겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530104
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530104,
					"content": "여러 가지 일도 마무리됐으니, 이제부터는 편하게 즐겨야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530105,
						705530106
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530105,
					"content": "저희는 평등한 고용관계예요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530107
					]
				},
				{
					"id": 705530107,
					"content": "그거 대단한데, 제대로 솜씨를 봐야겠는걸! 편안한 대화에 어울리면서도 강력한 걸로 한 잔 부탁하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530108,
						705530109
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530108,
					"content": "정말 말장난 같은 기준이네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530110
					]
				},
				{
					"id": 705530110,
					"content": "모순되는 기준은 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530111
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530111,
					"content": "「강력」하다는 건 한 번에 마실 수 없다는 뜻이고, 「대화」에 어울린다는 건 너무 자극적이지 않고 끝맛이 달단 소리지. 그 절묘한 균형을 맞춰야 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530112
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530112,
					"content": "지금 메뉴에서 가장 추천하는 건 「가시 거울 호수」야. 웬만한 술집에서 다 파는 도수 높은 칵테일이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530113
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530113,
					"content": "물론, 레시피만 안다고 다가 아니야. 만드는 과정이 중요하지. 클래식한 방식을 고수할 수도 있고, 자기만의 해석을 더할 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530114,
						705530115
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530114,
					"content": "한번 해볼게요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530116
					]
				},
				{
					"id": 705530116,
					"content": "기세 좋군! 그럼 실력 한 번 볼까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530115,
					"content": "레시피만 알면 할 수 있어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530116
					]
				},
				{
					"id": 705530109,
					"content": "대단장님, 이건 정식 시험인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530110
					]
				},
				{
					"id": 705530106,
					"content": "전 천재 바텐더라고요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530107
					]
				}
			]
		},
		{
			"id": 7055302,
			"completionStepIds": [
				7055306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
