							2198.789,
							230.089,
							-777.793
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705530201,
					"content": "단장님, 제 「가시 거울 호수」가 어떤지 확인해 보시죠!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530202
					]
				},
				{
					"id": 705530202,
					"content": "음, 색과 향은 좋군. 맛은… 어디 한번 마셔볼까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530203
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530203,
					"content": "나쁘지 않네. 재료의 비율이 아주 정확해. 하지만 뭐랄까, 너무 「예의 바른」 느낌이군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530204,
						705530205
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530204,
					"content": "술이 예의 바르다고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530206
					]
				},
				{
					"id": 705530206,
					"content": "너무 조심스러웠단 뜻이야! 레시피를 철저히 지켜서, 상당히 보수적인 비율로 칵테일을 제조했더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530207
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530207,
					"content": "마치… 조금이라도 맛이 어긋나면 내가 실망할까 봐 걱정한 것처럼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530208,
						705530209
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530208,
					"content": "그렇긴 해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530210
					]
				},
				{
					"id": 705530210,
					"content": "이봐, 우리는 오랫동안 같이 싸워오면서, 신도 골치 아파하는 문제까지 해결했잖아? 생사를 함께한 사이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530211
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530211,
					"content": "우리 사이에 조심할 거 없어. 천재 바텐더다운 기발함을 마음껏 뽐내 보라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530212,
						705530213
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530212,
					"content": "그럼 제대로 개선해 볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530214
					]
				},
				{
					"id": 705530214,
					"content": "그래 그래, 서두를 거 없어! 천천히 얘기 나누면서, 이 술잔에 어떤 영감을 담을지 생각해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530215
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530215,
					"content": "이 「가시 거울 호수」에 또 다른 문제는 없을까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530216
					]
				},
				{
					"id": 705530216,
					"content": "어디 보자… 하나를 더 꼽자면, 「임팩트」가 부족해. 같은 레시피를 사용해도, 재료를 섞는 방식에 따라 맛이 크게 달라지지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530217
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530217,
					"content": "가끔은 술에 레이어를 더하면, 두 가지 술이 따로따로 미각을 자극하며 「파도」 치게 만들 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530218
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530218,
					"content": "이쪽으론 꽤 얌전하게 접근했던데, 좀 더 과감하게 시도해 보면 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530219,
						705530220
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530219,
					"content": "음… 대충 알 것 같아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530221
					]
				},
				{
					"id": 705530221,
					"content": "하하하, 역시 척하면 척이군. 더 설명할 것도 없겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530222
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530222,
					"content": "이 거대한 술잔은 뭐죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530223
					]
				},
				{
					"id": 705530223,
					"content": "멋지지? 망치처럼 생겨서, 술도 담을 수 있고 못도 박을 수 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530224
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530224,
					"content": "호프만이 아이디어를 내고, 찰스가 설계하고, 바그너가 제작했지. 열 명 넘는 기사들이 각자 돈을 보태서 준비해 준 선물이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530225
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530225,
					"content": "다들 나랑 마실 날만 기다리고 있었어. 이 술잔이야말로, 녀석들이랑 공평하게 대결하는 데 필요한 「무기」지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530226,
						705530227
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530226,
					"content": "…공평이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530228
					]
				},
				{
					"id": 705530228,
					"content": "나는 대단장이잖냐. 술을 마셔온 세월도 더 길고, 단련도 더 많이 됐고, 덩치도 더 크니까 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530229
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530229,
					"content": "내가 조금 더 큰 잔으로 마셔야 부하들한테 공평하지. 안 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530230,
						705530231
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530230,
					"content": "이건 조금이 아닌데요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530232
					]
				},
				{
					"id": 705530232,
					"content": "물론, 술을 마셔온 기간이 나랑 비슷한 녀석들도 있어. 그 녀석들한텐 인정사정없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530233
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530233,
					"content": "예를 들면 「헤이즐넛 03」이랑 「헤이즐넛 05」 같은 녀석. 예전에 나랑 같이 일록한테 한 방 먹인 실력자들인데, 지금은 진의 잡무를 도와주고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530234
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530234,
					"content": "오늘 퇴근 후 술자리에서 나한테 덤볐다가, 결국 다트 게임에서 지고 뻗어버렸지! 하하하하!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530235
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530235,
					"content": "진한테 말해놨어. 내일 절대로 휴가 승인해 주지 말라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530236
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530236,
					"content": "정원에서 마시는 술과 술집에서 마시는 술은 느낌이 좀 다르지 않나요? 주변 환경을 고려해서, 식물 향을 조금 가미해 보는 건 어때요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530237
					]
				},
				{
					"id": 705530237,
					"content": "오, 꽤 그럴듯한데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530238
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530238,
					"content": "정원 얘기가 나오니 옛날 일이 떠오르는군그래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530239
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530239,
					"content": "젊었을 때는 유적 가디언을 찾아가서 주먹이나 검을 단련했었어…. 그러다 한 번은 실수로 놈들의 미사일을 놓쳐서, 성벽 감시탑 하나를 날려 먹었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530240
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530240,
					"content": "결국 벌로 성을 50바퀴나 뛰어야 했어. 감시탑을 고친 후에 이 정원에서 부서진 벽을 쌓는 것도 도와야 했고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530241,
						705530242
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530241,
					"content": "엄청 큰 소동이었네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530243
					]
				},
				{
					"id": 705530243,
					"content": "젊었을 때 저지른 실수 중에, 이게 가장 기억에 남아. 왜냐하면 그날… 클립스가 먼지를 뒤집어쓴 나를 봤거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530244
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530244,
					"content": "클립스는 백 년 묵은 술 두 병을 가져와서, 다이루크… 지금의 미카보다도 어렸던 다이루크를 시켜 날 감시하던 페루를 떼어내 줬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530245
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530245,
					"content": "그날은 정말 더웠지…. 기절할 정도의 더위였어…. 그래서 즉흥적으로 민트 몇 잎을 따서 술병에 넣었는데, 맛이 기가 막히더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530246
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530246,
					"content": "클립스도 따라 해보더니 연신 칭찬하더군. 그러더니 나중에는 그걸 정식 레시피로 추가했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530247
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530247,
					"content": "술꾼들의 반응도 꽤 좋았어! 그 후로 클립스는 몇 년이나 편지를 보내서 수익금을 나눠주겠다고 했지만… 내가 그걸 어떻게 받겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530248,
						705530249
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530248,
					"content": "정말 오래된 이야기네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530250
					]
				},
				{
					"id": 705530250,
					"content": "그래, 클립스는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530251
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530251,
					"content": "…페루는 은퇴한 지 몇 년이 지났는데도, 여전히 날 볼 때마다 정색해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530252
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530252,
					"content": "휴, 그 고집불통… 후임인 다이루크도, 그 뒤를 이은 케이아도 일을 얼마나 잘하는데. 새 시대는 젊은이들의 몫이야. 인정할 줄을 모른다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530253
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530253,
					"content": "나중에 케이아한테, 기병 소대가 얼마나 놀라운 발전을 이뤘는지 보여주라고 해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530254
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530254,
					"content": "그나저나, 이 정원도 이젠 이벤트를 여는 인기 장소가 되었네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530255
					]
				},
				{
					"id": 705530255,
					"content": "하하, 여긴 기사단이 오랫동안 정성껏 관리해 온 곳이야. 이벤트를 열기에 최적의 장소지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530256
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530256,
					"content": "원정대가 몬드를 비운 동안, 사람들이 즐길 자리를 마련하는 데, 네가 여러 도움을 줬다고 들었다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530257
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530257,
					"content": "가끔 이벤트 때 찍힌 사진들을 찾아보곤 하는데, 아쉽게도 모든 사람이 찍히진 않았더군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530258
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530258,
					"content": "결론은, 몬드에 사진기 보급률을 높여야 한다는 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530259
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530259,
					"content": "대단장님이 원정을 가지 않았다면, 이런 이벤트들이 어떻게 됐을지 궁금하네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530260
					]
				},
				{
					"id": 705530260,
					"content": "내가 이벤트를 맡았다면? 아마… 모든 테마에 술을 넣거나, 이벤트마다 술파티를 열었을걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530261
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530261,
					"content": "이번 음료 가게 같은 경우도 규모를 키우고 성 전원에게 개방했겠지. 각 소대에서 대표를 뽑아 음료 제조 실력을 겨루게 하고 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530262,
						705530263
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530262,
					"content": "역시 그렇게 되나요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530264
					]
				},
				{
					"id": 705530264,
					"content": "하하하, 그냥 상상만 하는 거야! 너무 요란해지면 안 되지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530265
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530265,
					"content": "대놓고 술파티를 열면, 진이 칼을 들고 찾아올 거야. 아니, 프레데리카까지 날 잡으러 올걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530266
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530266,
					"content": "「근무 중인 대원은 절대 취하지 않는다」, 우리는 노드크라이에서 이 규칙을 지켰어. 그렇지 않으면 직무 태만으로 이어질 수 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530267,
						705530268
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530267,
					"content": "그러는 게 맞다고 생각해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530269
					]
				},
				{
					"id": 705530269,
					"content": "그래. 원정대원들이 소대로 복귀하면서, 이 규칙이 몬드에도 스며들었으면 좋겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530270
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530270,
					"content": "불의 물이나 사워크림 같은 노드크라이의 식자재가 몬드 가정에 자리 잡은 것처럼 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530271
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530271,
					"content": "젊은 친구들도 절제하는 법을 배워야 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530272,
						705530273
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530272,
					"content": "대단장님에게 이런 면이 있으시다니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530274
					]
				},
				{
					"id": 705530274,
					"content": "요점은, 술도 약한 주제에 허세 부리지 말라는 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530275
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530275,
					"content": "주량이 내 삼분의 일도 안 되면서, 평일에 「가볍게 한잔」 같은 소리 하지 말라는 거야. 무조건 취하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530276
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530276,
					"content": "주말에 나랑 천천히 연습하면 돼, 하하하. 곤죽이 되도록 먹여주면, 일주일은 술이 꼴 보기도 싫을걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530277
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530277,
					"content": "괜히 감명받았네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530278
					]
				},
				{
					"id": 705530278,
					"content": "저 영감이 떠올랐어요. 잠깐 술잔 좀 빌릴게요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530279
					]
				},
				{
					"id": 705530279,
					"content": "오? 얼마든지 가져가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705530280
					],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530280,
					"content": "기세가 범상치 않은데! 엄청난 걸 만들어낼 것 같은 예감이 드는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바르카"
				},
				{
					"id": 705530273,
					"content": "이게 바로 주당의 절제력인가요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530274
					]
				},
				{
					"id": 705530268,
					"content": "취미가 본업에 영향을 줘선 안 되죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530269
					]
				},
				{
					"id": 705530263,
					"content": "바르카 씨다워요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530264
					]
				},
				{
					"id": 705530249,
					"content": "제가 몬드에 오기 훨씬 전의 일이군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530250
					]
				},
				{
					"id": 705530242,
					"content": "단장님도 그런 실수를 저지르셨다니 의외예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530243
					]
				},
				{
					"id": 705530231,
					"content": "공평하게 생각할 대상이 좀 잘못된 것 같아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530232
					]
				},
				{
					"id": 705530227,
					"content": "…대결이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530228
					]
				},
				{
					"id": 705530220,
					"content": "전에는 이런 디테일을 신경 쓰지 못했네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530221
					]
				},
				{
					"id": 705530213,
					"content": "안심하고 마음껏 만들어 볼게요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530214
					]
				},
				{
					"id": 705530209,
					"content": "바르카 씨는 전문가니까요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530210
					]
				},
				{
					"id": 705530205,
					"content": "이건 무슨 말장난인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705530206
					]
				}
			]
		},
