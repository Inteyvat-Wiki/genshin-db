						400680912
					],
					"speakerTitle": "이글거리는 마음"
				},
				{
					"id": 400680912,
					"content": "반항을 위한 노래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680913
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400680913,
					"content": "뭘 좀 아는군! 잘됐어, 마음이 맞는 사람을 드디어 만났군. 난 정말 행운아야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680914
					],
					"speakerTitle": "이글거리는 마음"
				},
				{
					"id": 400680914,
					"content": "이상한 꽃이랑도 잘 통하다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680915
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400680915,
					"content": "성격 좋은 사람은 어딜 가나 친구가 많잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680916
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400680916,
					"content": "전당 안으로 들어가고 싶어서 여기 온 거겠지. 전당에 들어가려면 나의 목소리가 필요한데, 미안하게도 지금은 목이 쉬어서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680917
					],
					"speakerTitle": "이글거리는 마음"
				},
				{
					"id": 400680917,
					"content": "괜찮아? 혹시, 음, 감기약이라도 먹을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680918
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400680918,
					"content": "아니, 그냥 오랫동안 「한산 샘물」을 마시지 못해서 그런 거야. 그 물만 있으면 노래를 다시 불러 너희에게 길을 열어줄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680919
					],
					"speakerTitle": "이글거리는 마음"
				},
				{
					"id": 400680919,
					"content": "「한산 샘물」? 샘물 이름이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680920
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400680920,
					"content": "맞아, 그 물만 마시면 지친 어른도, 피곤한 새도, 무지한 어린아이도… 아름다운 노랫소리를 낼 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680921
					],
					"speakerTitle": "이글거리는 마음"
				},
				{
					"id": 400680921,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680922
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400680922,
					"content": "알았어, 내가 한번 찾아볼게. 그 샘물이 있는 위치 좀 알려줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680923
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400680923,
					"content": "고마워! 맑은 물은 식물을 무럭무럭 자라게 하고, 등반하기 어려운 산도 극복하게 하지…. 샘물은 식물로 뒤덮인 산 위에 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680924
					],
					"speakerTitle": "이글거리는 마음"
				},
				{
					"id": 400680924,
					"content": "바닷가에서 그냥 퍼 오면 될 줄 알았는데, 산을 타야 하는 거였구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400680925
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400680925,
