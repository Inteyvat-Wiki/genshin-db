			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"베일"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240201,
					"content": "휴, 드디어 왔네. 오래 기다렸다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240202
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240202,
					"content": "절 왜 기다려요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240203
					]
				},
				{
					"id": 411240203,
					"content": "그렇게 쌀쌀맞게 굴지 마. 너한테 부탁할 중요한 일이 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240204
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240204,
					"content": "너도 그 운석들을 봤지? 몬드성 안으로 떨어진 건 없지만, 운석에 관한 일을 처리하느라 성안과 밖은 이미 엉망이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240205
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240205,
					"content": "이런 혼란한 틈을 타서 무슨 짓을 꾸미려는 녀석들이 절대 가만히 있을 리 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240206,
						411240208
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240206,
					"content": "그렇다는 건… 보물 사냥단?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240207
					]
				},
				{
					"id": 411240207,
					"content": "오~ 역시 경험 많은 모험가야, 예리한데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240212,
					"content": "페보니우스 기사들이 경계 태세를 갖추고 있지만, 주변 지역을 돕다 보면 방어에 빈틈이 생기기 마련이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240213
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240213,
					"content": "돈이라면 물불 안 가리는 보물 사냥단이잖아. 분명 이 틈을 타 성안을 싹 쓸어버릴 계획을 세우고 있을 거라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240214,
						411240217
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240214,
					"content": "그럼 전 뭘 하면 되죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240215
					]
				},
				{
					"id": 411240215,
					"content": "어머, 이렇게 흔쾌히 승낙할 줄이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240216
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240216,
					"content": "하하하, 그분이 알려준 방법은 쓸 필요도 없겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240222,
					"content": "아무튼, 전에 몬드성 주변을 정찰하던 보물 사냥단 단원들은 이미 그분한테 잡혔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240223
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240223,
					"content": "그들 말에 의하면, 3팀의 보물 사냥단이 주위를 어슬렁거리고 있는 모양이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240224
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240224,
					"content": "그래서 우린 그들의 계획을 역으로 이용해서 보물 사냥단들을 위한 「최적 침입 장소」를 만들어놨지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240225,
						411240226
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240225,
					"content": "전 뭘 하면 되죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240231
					]
				},
				{
					"id": 411240231,
					"content": "네가 할 일은 아주 간단해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240232
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240232,
					"content": "한꺼번에 모두 잡힐 수도 있으니, 정찰하러 온 보물 사냥단은 바로 돌아가지 않고 편지로 정찰한 정보를 지정된 장소로 보낼 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240233
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240233,
					"content": "그리고 그들은 혹시 모를 문제에 대비해 정찰원을 3명이나 보내 각자 다른 곳에서 정보를 넘겨주도록 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240234
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240234,
					"content": "근데 그 셋이 전부 그분한테 잡혔을 줄은 생각지도 못했을걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240235
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240235,
					"content": "암튼 정보를 넘겨받은 후에야 다른 단원들이 최적의 침입 장소를 선정하기 위한 계획을 세울 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240236
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240236,
					"content": "근데 이번엔 굳이 그들이 나설 필요 없어. 그분이 대신 계획을 꼼꼼히 세워줬거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240237
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240237,
					"content": "이 편지 3부를 줄게. 각각 3개의 보물 사냥단 접선지에 두면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240238
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240238,
					"content": "그런 다음 다시 나한테 와줘. 나머지 일은… 음, 그때 다시 얘기하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베일"
				},
				{
					"id": 411240226,
					"content": "보물 사냥단 말을 믿어도 되는 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240227
					]
				},
				{
					"id": 411240227,
					"content": "하하하, 너 꽤 치밀하구나? 걱정 마, 보물 사냥단은 전부 줏대 없는 녀석들이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240228
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240228,
					"content": "결국 돈만 밝히는 좀도둑들에 불과해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240229
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240229,
					"content": "「얌전히 협조해주면 더 많이 벌고, 이상한 짓을 하면 가진 돈을 전부 잃을 줄 알아」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240230
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240230,
					"content": "이것만 각인시켜주면 순순히 협조해줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240231
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240217,
					"content": "페보니우스 기사단이 알아서 하겠죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240218
					]
				},
				{
					"id": 411240218,
					"content": "하하하, 그렇게 나올 줄 알았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240219
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240219,
					"content": "걱정 마. 이번엔 그분이 예산을 꽤 많이 주셔서 보수를 넉넉히 챙겨줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240220
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240220,
					"content": "도중에 뭔가 수확이 있어도 다 네 몫이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240221
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240221,
					"content": "게다가 이 일은 네가 아니면 안 된다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240208,
					"content": "그렇다는 건… 츄츄족?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240209
					]
				},
				{
					"id": 411240209,
					"content": "하하하, 설마. 츄츄족한텐 불가능한 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240210
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240210,
					"content": "츄츄족이 성 밖에 가까워지면 페보니우스 기사들이 바로 처리할 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240211
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240211,
					"content": "내가 말한 건 보물 사냥단 녀석들이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "베일"
				}
			]
		},
		{
			"id": 4112406,
			"completionStepIds": [
				4112406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112406",
							"2"
						],
						"stepId": 4112406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"베일"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240601,
					"content": "편지를 다 두고 왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240602
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240602,
					"content": "네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240603
					]
				},
				{
					"id": 411240603,
					"content": "좋아. 이제 보물 사냥단 놈들이 그 3개의 정보를 가지고 침입 계획을 세울 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240604
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240604,
					"content": "그들이 계획한 「최적 침입 시간」은 분명 밤과 새벽 사이겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240605
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240605,
					"content": "그리고 「최적 침입 장소」는… 당연히 거기뿐이고. 음, 네 지도에 표시해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240606
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240606,
					"content": "됐다. 이제 그 녀석들이 그물에 걸려들길 기다리기만 하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240607,
						411240610
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240607,
					"content": "만약 페보니우스 기사한테 들키면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240608
					]
				},
				{
					"id": 411240608,
					"content": "응… 그렇네. 지금 이 방식이 일반적이진 않으니까. 페보니우스 기사들에게 들키면 일이 번거로워질 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240609
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240609,
					"content": "하지만 그분이 그런 일은 절대 없을 거라고 했으니까… 한번 믿어보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240612,
					"content": "자, 그럼 날이 저물면 함정에 빠진 보물 사냥단들을 전부 해치워줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베일"
				},
				{
					"id": 411240610,
					"content": "만약 안 나타나면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240611
					]
				},
				{
					"id": 411240611,
					"content": "반드시 나타날 테니 안심해. 그분이 손수 세운 계획이니까 아무 문제 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "베일"
				}
			]
		},
