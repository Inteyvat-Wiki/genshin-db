					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240803
					]
				},
				{
					"id": 411240803,
					"content": "역시 그분이 직접 지명한 사람답게 일처리가 빠르네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240804
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240804,
					"content": "이건 보수니까 받아. 이번에… 같이 일할 수 있어서 즐거웠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240805
					],
					"speakerTitle": "베일"
				},
				{
					"id": 411240805,
					"content": "아마 앞으로도 자주 보게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "베일"
