	"talks": [
		{
			"id": 4112402,
			"completionStepIds": [
				4112402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112402",
							"2"
						],
						"stepId": 4112402,
						"stateName": "QUEST_STATE_UNFINISHED"
