						],
						"pointId": 311500088
					}
				]
			},
			"dialogs": [
				{
					"id": 711160202,
					"content": "친구, 이거 어떻게 감사를 해야 할지 모르겠네. 뭐 필요한 게 있으면 언제든 불러줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160203
					],
					"speakerTitle": "철두아"
				},
				{
					"id": 711160203,
					"content": "오! 엄청 친절한데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160204,
						711160207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711160204,
					"content": "단도직입적으로 말하면 요즘 돈이 부족해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160205
					]
				},
				{
					"id": 711160205,
					"content": "모라가 필요한 거야? 하하, 잘 알겠어. 다만 조금 귀찮은 일이 있는데——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160206
					],
					"speakerTitle": "철두아"
				},
				{
					"id": 711160206,
					"content": "모라는 모두 두목이 가지고 갔거든. 지금은 우리도 빈털터리야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "철두아"
				},
				{
					"id": 711160210,
					"content": "두목이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160211
					]
				},
				{
					"id": 711160211,
					"content": "우리 철염파의 두목 말이야. 지금 저기 절벽 아래에서 폰타인 녀석들과 밀수품 거래를 하고 있지. 우리 보고는 남아서 여기를 지키라고 했고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160212
					],
					"speakerTitle": "철두아"
				},
				{
					"id": 711160212,
					"content": "근데 방금 너도 봤잖아? 저 폰타인 애송이들, 두목이 거래하는 사이에 은근슬쩍 엉덩이를 걷어차러 왔다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160213
					],
					"speakerTitle": "철두아"
				},
				{
					"id": 711160213,
					"content": "으악… 엉덩이를 걷어차다니…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 711160214,
					"content": "아앗…!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160215
					]
				},
				{
					"id": 711160215,
					"content": "나쁜 녀석들! 감히 우리를 풋내기 취급하다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160216
					],
					"speakerTitle": "철두아"
				},
				{
					"id": 711160216,
					"content": "이쪽에 적이 몰려왔으니까 두목도 아마 함정에 빠졌을 거야. 착한 친구, 우리를 끝까지 도와주지 않겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160217
					],
					"speakerTitle": "철두아"
				},
				{
					"id": 711160217,
					"content": "두목만 무사하다면 너희들도 단단히 한몫 챙길 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160218
					],
					"speakerTitle": "철두아"
				},
				{
					"id": 711160218,
					"content": "어디요? 일단 가볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160219
					]
				},
				{
					"id": 711160219,
					"content": "절벽 아래의 해변인데 저쪽으로 가면 보일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160220
					],
					"speakerTitle": "철두아"
				},
				{
					"id": 711160220,
					"content": "친구, 너희들 먼저 가. 난 짐을 정리하고 바로 따라갈게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "철두아"
				},
				{
					"id": 711160207,
					"content": "불의를 보고 도와준 것뿐이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160208
					]
				},
				{
					"id": 711160208,
					"content": "정의롭네! 정의로워! 아, 기왕 이렇게 된 거 할 말이 있는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160209
					],
					"speakerTitle": "철두아"
				},
				{
					"id": 711160209,
					"content": "두목의 상황이 더 안 좋을지도 몰라. 가서 도와줘야 할 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "철두아"
				}
			]
		},
