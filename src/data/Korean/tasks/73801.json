			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"프르제바"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 738010501,
					"content": "바로 여기야. 여행자, 계획은 아주 간단해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010502
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010502,
					"content": "우리 둘은… 후훗, 나쁜 마음을 품은 우인단인 거야. 이 숲에 와서 나쁜 짓을 벌이는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010503
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010503,
					"content": "그리고 넌, 분노를 이기지 못하고 정의를 지키기 위해 우리의 악행을 제지해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010504
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010504,
					"content": "그 와중에 도망치던 나와 알렉산드라는 갑자기 나타난 마물들에게 쓰러지고 마는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010505
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010505,
					"content": "그리고 넌 마물들의 숫자가 너무 많아 어쩔 수 없이 후퇴하고, 사람들을 데리고 다시 왔을 때, 나와 알렉산드라는 이미 사라져 있는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010506
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010506,
					"content": "이야기는 대충 이 정도야. 네가 볼 땐 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010507,
						738010509
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010507,
					"content": "너무 능숙한걸",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010508
					]
				},
				{
					"id": 738010508,
					"content": "이 이야기를 더 그럴듯하고, 더 자연스럽게 쓰러지게 하기 위해 얼마나 심혈을 기울였는지 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010512
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010512,
					"content": "그런데 알렉산드라는 왜 돌아오지 않는 거지? 마물 미끼를 설치하는 게 이렇게 오래 걸리는 일이었나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010513
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010513,
					"content": "알렉산드라 누나! 알렉산드라 누나! 엉엉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010514
					],
					"speakerTitle": "니카"
				},
				{
					"id": 738010514,
					"content": "저, 저쪽에서 사람 목소리가 들려!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010515
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 738010515,
					"content": "큰일이야! 알렉산드라에게 무슨 일이 생긴 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010516
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010516,
					"content": "이봐! 잠깐! 가서 뭘 어쩔 셈이야!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010517
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 738010517,
					"content": "어서 쫓아가 보자!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010518
					]
				},
				{
					"id": 738010518,
					"content": "대체 무슨 일이 생긴 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 738010509,
					"content": "우인단에게 어울리는 결말인 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010510
					]
				},
				{
					"id": 738010510,
					"content": "맞아. 우인단 중에서 정보 수집을 맡는 「못」들이 보통 이런 결말을 맞이하곤 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010511
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010511,
					"content": "우린 그렇게 사라지는 걸 원치 않으니까 이번 계획을 세운 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010512
					],
					"speakerTitle": "프르제바"
				}
			]
