			"dialogs": [
				{
					"id": 738010201,
					"content": "앗! 상자가 열렸어! 생각했던 것보다 어렵지 않은걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010202,
						738010203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 738010202,
					"content": "어디 보자…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010204
					]
				},
				{
					"id": 738010204,
					"content": "흐음, 어쨌든… 먼저 안에 뭐가 들었는지 살펴보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 738010205,
					"content": "안에는… 낡은 옷과 편지 뭉치가 들어있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 738010206,
					"content": "위에 적힌 건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 738010207,
					"content": "「데반타카산 남쪽, 낡은 배가 항구를 떠난다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 738010208,
					"content": "이게 무슨 뜻이지? 산속에 배가 있을 리가 없잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010209,
						738010210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 738010209,
					"content": "어쩌면 수수께끼일지도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010211
					]
				},
				{
					"id": 738010211,
					"content": "음… 우리도 가보는 수밖에 없겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 738010210,
					"content": "우인단이 뭔가를 꾸미고 있는 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010211
					]
				},
				{
					"id": 738010203,
					"content": "그 우인단 두 명과 관련이 있는 상자인가…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010204
					]
				}
			]
		},
		{
