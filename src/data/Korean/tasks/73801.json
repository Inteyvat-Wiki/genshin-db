			"dialogs": [
				{
					"id": 738010101,
					"content": "…새로운 사업 얘기는 잘됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010102
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010102,
					"content": "낡은 화물선에서 방금 물건을 내렸어, 안심해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010103
					],
					"speakerTitle": "알렉산드라"
				},
				{
					"id": 738010103,
					"content": "배에 물이 새지는 않았지? <color=#00E1FFFF>위에 있는 물건…</color> 전부 잘 숨겼어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010104
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010104,
					"content": "꽁꽁 잘 숨겨놨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010105
					],
					"speakerTitle": "알렉산드라"
				},
				{
					"id": 738010105,
					"content": "하지만… 교환한 낡은 물건은 어떻게 하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010106
					],
					"speakerTitle": "알렉산드라"
				},
				{
					"id": 738010106,
					"content": "오늘 바로 버릴 거야. 새로운 물건이 오는 대로… 낡은 물건을 버리면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010107
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010107,
					"content": "저, 정말 괜찮을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "알렉산드라"
				}
			]
		},
