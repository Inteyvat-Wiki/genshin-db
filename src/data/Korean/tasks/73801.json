			"dialogs": [
				{
					"id": 738010801,
					"content": "미안해… 콜록… 프르제바",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010802
					],
					"speakerTitle": "알렉산드라"
				},
				{
					"id": 738010802,
					"content": "쓸데없는 소리 마. 먼저 붕대를 감아줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010803
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010803,
					"content": "엉엉… 죄송해요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010804
					],
					"speakerTitle": "니카"
				},
				{
					"id": 738010804,
					"content": "여긴 뭐하러 온 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010805
					]
				},
				{
					"id": 738010805,
					"content": "저… 전 버섯을 채집하러 온 거였어요… 엉엉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010806
					],
					"speakerTitle": "니카"
				},
				{
					"id": 738010806,
					"content": "알렉산드라 누나가… 요즘 기분이 안 좋아 보여서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010807
					],
					"speakerTitle": "니카"
				},
				{
					"id": 738010807,
					"content": "그래서 알렉산드라 누나가 깜짝 놀라도록 맛있는 요리를 해주려고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010808
					],
					"speakerTitle": "니카"
				},
				{
					"id": 738010808,
					"content": "예전에 알렉산드라 누나가 우리를 여기로 데리고 와서 맛있는 버섯들을 아주 많이 채집했거든요. 그래서 저 혼자 채집하러 여기로 왔어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010809
					],
					"speakerTitle": "니카"
				},
				{
					"id": 738010809,
					"content": "하지만 숲속에 들어서자마자 길을 잃고 버섯들에게 포위되고 말았어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010810
					],
					"speakerTitle": "니카"
				},
				{
					"id": 738010810,
					"content": "알렉산드라 누나는… 저를 구하려다 그만… 흑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010811
					],
					"speakerTitle": "니카"
				},
				{
					"id": 738010811,
					"content": "콜록… 괘… 괜찮아, 니카… 누나는 괜찮아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010812
					],
					"speakerTitle": "알렉산드라"
				},
				{
					"id": 738010812,
					"content": "…여행자, 계획을 변경해야 할 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010813
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010813,
					"content": "아마 우리가 마음대로 성 밖으로 나온 걸 다른 우인단들이 알아차렸을 거야. 지금 알렉산드라가 심한 부상을 입은 상태로 데리고 돌아간다면 붙잡혀 심문을 받게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010814,
						738010815
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010814,
					"content": "그럼 우리 계획은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010816
					]
				},
				{
					"id": 738010816,
					"content": "후후… 꼼수에는 꼼수를 쓰는 수밖에 없겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010817
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010817,
					"content": "방금 여기로 오다가 도금 여단 한 무리가 이쪽으로 오는 걸 봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010818
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010818,
					"content": "여행자, 일단 이 녀석을 숲 바깥으로 보내 도금 여단에게 맡겨. 난 알렉산드라를 데리고 여길 떠날게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010819
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010819,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010820
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010820,
					"content": "미리 맞춰봤던 대본을 아직 기억하겠지? 이젠 연기가 실제 상황이 되어버린 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010821
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010821,
					"content": "도금 여단 사람은 분명 악행을 저지르는 우인단 둘이 이곳에서 뭔가 음모를 꾸몄을 거라고 생각할 거야. 니카를 구한단 건 속임수에 불과하다고 여기겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010822
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010822,
					"content": "마물들에게 포위 당해 공격받은 건… 인과응보라고 생각할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010823
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010823,
					"content": "엉엉… 알렉산드라 누나… 다시는 장난치지 않을게요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010824
					],
					"speakerTitle": "니카"
				},
				{
					"id": 738010824,
					"content": "…요 녀석은 지금 우리가 무슨 말을 하는지 신경 쓸 겨를이 없을 테니 걱정하지 않아도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010825,
						738010826
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010825,
					"content": "하지만 사람을 구하려고 한 거였잖아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010827
					]
				},
				{
					"id": 738010827,
					"content": "날 믿어. 「우인단의 용맹한 희생」보다는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010828
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010828,
					"content": "「악의를 품은 우인단의 자업자득」이란 말을 훨씬 쉽게 받아들일 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010829
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010829,
					"content": "처음에 나와 알렉산드라가 하는 얘기를 엿들었던 곳, 아직도 기억해? 만약… 우리가 성공하면 그곳에 편지를 남겨둘게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010830
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010830,
					"content": "너흰 처음부터…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010831
					]
				},
				{
					"id": 738010831,
					"content": "우리에겐 단 한 번의 기회밖에 없으니까 신중할 수밖에 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010832
					],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010832,
					"content": "지금은 먼저 알렉산드라를 구해야 할 때잖아!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010833
					]
				},
				{
					"id": 738010833,
					"content": "괜찮아, 여행자… 콜록… 아직 버틸 만해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010834
					],
					"speakerTitle": "알렉산드라"
				},
				{
					"id": 738010834,
					"content": "…이번 기회를 놓치고 다시 우인단 생활을 하느니, 차라리 난… 콜록… 콜록!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010835
					],
					"speakerTitle": "알렉산드라"
				},
				{
					"id": 738010835,
					"content": "알렉산드라 누나, 어딜 간다는 거예요? 우리 같이 돌아가요! 다들 누나를 찾고 있다구요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010836
					],
					"speakerTitle": "니카"
				},
				{
					"id": 738010836,
					"content": "니카… 착하지. 여기 여행자가 널 데리고 나갈 거야… 콜록…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010837
					],
					"speakerTitle": "알렉산드라"
				},
				{
					"id": 738010837,
					"content": "누나는… 여기에서 잠시 쉬다가 돌아갈 거란다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010838
					],
					"speakerTitle": "알렉산드라"
				},
				{
					"id": 738010838,
					"content": "하… 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010839
					],
					"speakerTitle": "니카"
				},
				{
					"id": 738010839,
					"content": "누나가 언제 널 속인 적 있었어? 콜록… 자, 착하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010840
					],
					"speakerTitle": "알렉산드라"
				},
				{
					"id": 738010840,
					"content": "흑… 흑흑… 알겠어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010841
					],
					"speakerTitle": "니카"
				},
				{
					"id": 738010841,
					"content": "여행자, 그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738010842,
						738010843
					],
					"speakerTitle": "알렉산드라"
				},
				{
					"id": 738010842,
					"content": "곧 돌아올게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010844
					]
				},
				{
					"id": 738010844,
					"content": "그럼 부탁할게, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "프르제바"
				},
				{
					"id": 738010843,
					"content": "나한테 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010844
					]
				},
				{
					"id": 738010826,
					"content": "악의를 품은 것도 아닌데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						738010827
					]
				},
				{
					"id": 738010815,
					"content": "너희는 이제 어떻게 하려고?",
