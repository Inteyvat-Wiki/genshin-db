				"points": []
			},
			"dialogs": [
				{
					"id": 210000101,
					"content": "휴, 내가 정말 해낼 수 있을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000102
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000102,
					"content": "소몽, 왜 그래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000103
					]
				},
				{
					"id": 210000103,
					"content": "#여행자 {F#누나}{M#형}… 안녕하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000104
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000104,
					"content": "소몽, 기분 안 좋은 일이라도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 210000105,
					"content": "왜 그래? 애들이 너랑 그… 해적 게임을 같이 안 해줘서 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 210000106,
					"content": "네? 아뇨, 룰루랑 아비는 집에 갔어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000107
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000107,
					"content": "전… 혼자 좀 걷고 싶어서 여기에 있는 거고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000108
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000108,
					"content": "부모님이 걱정하지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 210000109,
					"content": "엄마랑 아빠는 아직 일하느라 집에 안 돌아가셨을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000110
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000110,
					"content": "#{F#누나}{M#형}. 저 질문 하나 해도 돼요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000111,
						210000112
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000111,
					"content": "무슨 질문?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000114
					]
				},
				{
					"id": 210000114,
					"content": "#{F#누나}{M#형}, 사람들이 {F#누나}{M#형}에 대해 얘기하는 걸 자주 들었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000115
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000115,
					"content": "#{F#누나는}{M#형은} 많은 곳에 가봤고 많은 일을 겪었잖아요… 어쩌면 저의 질문에 답해줄 수 있을지도 몰라요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000116
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000116,
					"content": "우와… 소몽이가 갑자기 진지해졌어. 대체 어떤 질문이길래 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 210000117,
					"content": "그러니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000118
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000118,
					"content": "대체 어떻게 해야 「성숙」해질 수 있을까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000119,
						210000122
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000119,
					"content": "시간이 필요해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000120
					]
				},
				{
					"id": 210000120,
					"content": "어른이 되면 성숙해질 수 있다는 말인가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000121
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000121,
					"content": "하지만 어른이 되고 나서 성숙해지는 건 너무 늦지 않을까요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000124,
					"content": "음… 성 밖으로 나가보고 싶은 거라면 우리가 함께 가줄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 210000125,
					"content": "그건 너무 신세 지는 것 같아요. 게다가… 성 밖을 나간다고 해도 무슨 소득이 있을 것 같지도 않고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000126
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000126,
					"content": "#{F#누나}{M#형}, 다른 일을 하나 부탁하고 싶은데요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000127
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000127,
					"content": "누가 그러는데, 해결하기 어려운 고민이 있으면, 고민을 글로 써서 해류병에 담아 물과 함께 흘려보내라고 했어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000128
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000128,
					"content": "그럼 고민이 해결될지도 몰라요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000129
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000129,
					"content": "하지만 밖에는 마물이 많아서 저 혼자는 위험할 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000130
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000130,
					"content": "그래서 말인데 절 보호해 줄 수 있을까요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000131,
						210000132
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000131,
					"content": "물론이지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000133,
					"content": "#고마워요, {F#누나}{M#형}. 꼭 보답할게요. 전부 제가 모은 돈이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000134
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000134,
					"content": "그럼 우리 출발해요, 먼저 벽수강 쪽으로 가봐요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000132,
					"content": "나한테 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000122,
					"content": "특별한 일을 겪어야 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000123
					]
				},
				{
					"id": 210000123,
					"content": "특별한 일이요…? 하지만 전 지금까지 리월항을 떠나본 적이 없는걸요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "소몽"
				},
				{
					"id": 210000112,
					"content": "#지금 {F#누나가}{M#형이} 좀 바빠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000113
					]
				},
				{
					"id": 210000113,
					"content": "하하하, 해적 게임은 그저 제가 룰루랑 아비와 놀아주는 거예요. 걔들이 없으면 딱히 할 생각도 없어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000114
					],
					"speakerTitle": "소몽"
				}
			]
		},
