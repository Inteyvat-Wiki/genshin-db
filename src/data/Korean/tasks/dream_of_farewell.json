				"points": []
			},
			"dialogs": [
				{
					"id": 130150101,
					"content": "여러분도 깨어났군요. 정말 다행이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150102
					],
					"speakerTitle": "페드루시"
				},
				{
					"id": 130150102,
					"content": "사람들이 차례로 깨어나기 시작했고, 성에서도 희소식이 끊이질 않고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150103
					],
					"speakerTitle": "페드루시"
				},
				{
					"id": 130150103,
					"content": "보아하니 일은 잘 해결하신 것 같네요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150104
					],
					"speakerTitle": "페드루시"
				},
				{
					"id": 130150104,
					"content": "응, 우여곡절이 있었지만 잘 해결됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150105
					],
					"speakerTitle": "나히다"
				},
				{
					"id": 130150105,
					"content": "곧 사람들이 많이 몰려올 거야. 현장 질서를 좀 책임져줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150106
					],
					"speakerTitle": "나히다"
				},
				{
					"id": 130150106,
					"content": "난 여행자와 함께 아카데미아에 갔다 올게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "나히다"
				}
			]
		},
		{
			"id": 1301502,
			"completionStepIds": [
				1301502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
