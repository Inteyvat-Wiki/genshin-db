			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"시트",
					"나히다"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150201,
					"content": "풀의 신님이군요, 무슨 일이시죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150202
					],
					"speakerTitle": "시트"
				},
				{
					"id": 130150202,
					"content": "혼수상태에 빠진 크샤흐레와르 학부의 학자를 찾고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150203
					],
					"speakerTitle": "나히다"
				},
				{
					"id": 130150203,
					"content": "알겠습니다, 잠시만 기다려주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150204
					],
					"speakerTitle": "시트"
				},
				{
					"id": 130150204,
					"content": "잠시 후",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130150205
					]
				},
				{
					"id": 130150205,
					"content": "오래 기다리셨습니다, 정말 그런 학자가 있었네요. 이름은 베누니, 허공을 불법 조작해서 혼수상태에 빠졌죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150206
					],
					"speakerTitle": "시트"
				},
				{
					"id": 130150206,
					"content": "아직도 의식을 회복하지 못해서 「비마르{RUBY#[D]건강의 집}스탄」의 치료를 받고 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150207
					],
					"speakerTitle": "시트"
				},
				{
					"id": 130150207,
					"content": "어? 본명이 모세이스가 아니었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 130150208,
					"content": "아마 자신을 알아보는 게 싫었던 것 같아. 방해받고 싶지 않았던 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150209
					],
					"speakerTitle": "나히다"
				},
				{
					"id": 130150209,
					"content": "풍기관에게 이곳에 저장된 지식을 베누니의 뇌에 입력시키라고 전해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150210
					],
					"speakerTitle": "나히다"
				},
				{
					"id": 130150210,
					"content": "알겠습니다. 다만 안전을 위해서 이유에 대해 설명해주실 수 있을까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150211
					],
					"speakerTitle": "시트"
				},
				{
					"id": 130150211,
					"content": "간단해, 이곳에는 얼마 전까지 꿈에 갇혀있었던 베누니의 의식이 들어있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150212
					],
					"speakerTitle": "나히다"
				},
				{
					"id": 130150212,
					"content": "베누니는 꿈에서 수메르의 치안에 악영향을 끼치는 일을 저질렀어. 깨어나면 내가 대풍기관에게 자초지종을 설명할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150213
					],
					"speakerTitle": "나히다"
				},
				{
					"id": 130150213,
					"content": "알겠습니다, 지금 바로 처리하겠습니다. 정말 감사합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150214
					],
					"speakerTitle": "시트"
				},
				{
					"id": 130150214,
					"content": "응",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150215
					],
					"speakerTitle": "나히다"
				},
				{
					"id": 130150215,
					"content": "「꿈꾸는 순간」 쪽에도 사람들이 다 모였을 테니 어서 돌아가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "나히다"
				}
			]
		},
		{
			"id": 1301503,
			"completionStepIds": [
				1301503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
