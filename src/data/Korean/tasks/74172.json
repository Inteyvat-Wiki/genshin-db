			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"레이먼드"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740538901,
					"content": "뭔가 도와줄 일이라도?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538902,
						740538917,
						740538930,
						740538946,
						740538949,
						740538968
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538902,
					"content": "왜 내커 씨가 죽지 않았다고 생각하는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538903
					]
				},
				{
					"id": 740538903,
					"content": "과학원에 이득이 되는 방향과 내 개인적인 바람을 종합해 봤을 때…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538904
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538904,
					"content": "나는 내커 씨가 「아르케 동력 코어」와 함께 폭사해 버리기를 진심으로 바라고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538905
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538905,
					"content": "그럼 에드윈·이스팅하우스가 과학원에 남긴 마지막 영향력이 흔적도 없이 사라지게 되는 거니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538906
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538906,
					"content": "하지만 전에 말했다시피 그 폭발은 아주 작은 범위 안에서 일어난 아르케 광석 조각의 공명에 불과해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538907
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538907,
					"content": "게다가… 폭발 지역 안에 있던 대부분의 아르케 광석 조각은 에너지가 고갈된 폐광석이었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538908
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538908,
					"content": "이론상 대형 아르케 광석이 폭주하고, 그 폐광석들이 공명을 일으켰더라도 그렇게 격렬한 폭발은 일어나선 안 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538909
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538909,
					"content": "유일한 가능성은 누군가가 다른 구역에서 그나마 멀쩡한 아르케 광석들을 모으고 이곳에 쌓아뒀다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538910
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538910,
					"content": "그런 다음 대형 아르케 광석을 과중부하 상태로 만들어 쌓아놓은 광석들과 공명시킨 다음 폭발을 일으킨 거지. 무언가의 흔적을 은폐하기 위해서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538911
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538911,
					"content": "내커 씨는 줄곧 에드윈을 따라 연구했기 때문에 아르케 광석의 성질을 잘 알고 있었을 거야. 때문에 이런 일들을 해내는 데 별다른 어려움은 없었을 테고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538912
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538912,
					"content": "하지만 이건 내 추측일 뿐이야. 추후에… 과학원에서 제대로 조사를 할 때까지 기다려야 하겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538913
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538913,
					"content": "코어는 왜 훔친 걸까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538914
					]
				},
				{
					"id": 740538914,
					"content": "「아르케 동력 코어」는 현재 폰타인 과학원의 최첨단 기술이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538915
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538915,
					"content": "누군가에게 팔아버릴 수도 어떤 프로젝트에 사용할 수도 있다고… 흥, 어느 쪽이건 나쁘지 않은 선택이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538916
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538916,
					"content": "하지만 그의 학술적 능력을 고려하면… 차라리 「아르케 동력 코어」를 비싼 값에 파는 게 낫겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538917,
					"content": "「아르케 동력 코어」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538918
					]
				},
				{
					"id": 740538918,
					"content": "그 전에 내커 씨나 클로니아 씨에게서 들었지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538919
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538919,
					"content": "나와 에드윈·이스팅하우스의 연구 프로젝트는 몇 가지 일치하는 부분이 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538920
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538920,
					"content": "아니, 이건 정확한 설명이 아니겠군…. 실질적으로 「아르케 동력 코어」는 나와 에드윈이 공동으로 만들어 낸 연구 성과야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538921
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538921,
					"content": "이론적으로 운동 에너지 코어에 지속적으로 동력을 공급하면 「실험성 역장 발생 장치」를 쉽게 최대 출력으로 작동시킬 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538922
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538922,
					"content": "코어를 만든 이후 우리는 하나의 문제를 깨닫게 되었지. 코어에 지속적으로 동력을 공급할 방법을 찾을 수가 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538923
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538923,
					"content": "에드윈과 나는 프뉴무시아 소멸 에너지와 아르케 광석의 에너지를 혼합해서 공급해 보기도 했고, 엄청난 양의 아르케 광석을 연결해 거대한 동력원으로 만들어 보기도 했지만… 전부 소용이 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538924
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538924,
					"content": "그러다 저 초대형 아르케 광석을 발견하게 된 거야. 비록 「비활성 상태」였지만, 에드윈과 나는 이 광석이 전례 없는 수준의 순도를 가지고 있다고 확신했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538925
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538925,
					"content": "광석을 약간만 가공하면 우리가 필요로 하는 대량의 에너지를 생산해 낼 게 분명했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538926
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538926,
					"content": "그러나, 나와 에드윈 사이엔 의견 차이가 발생했지. 난 보수적인 방법을 제시했고, 그는… 더 빠른 해결법을 원했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538929
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538929,
					"content": "그 이후의 이야기는 네가 알고 있는 대로야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538930,
					"content": "에드윈에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538931
					]
				},
				{
					"id": 740538931,
					"content": "에드윈은 과학 연구 분야의 천재였어. 그의 재능은 초대 원장인 알랭·기요틴에 비견될 정도였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538932
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538932,
					"content": "하지만 동시에 그는… 정이라는 걸 모르는 괴물이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538933
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538933,
					"content": "과학 연구를 제외한 모든 것이 그에게 무의미했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538934
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538934,
					"content": "연구를 진전시킬 수만 있다면 에드윈은 그 어떤 대가라도 기꺼이 치를 인간이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538935
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538935,
					"content": "심지어 연구 성과 외에는 바라는 것도 없었지. 녀석이 이렇게 말한 적이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538936
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538936,
					"content": "「보수 따위는 필요 없어. 나에게는 연구 그 자체가 보상이니까」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538937
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538937,
					"content": "에드윈은 순수한 연구자였지만 그의 부하들은… 흥, 전부 하나같이 하이에나 같은 것들이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538938
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538938,
					"content": "연구 자산을 몰래 팔아먹는 사람도 있었고, 성과를 갈취하는 사람도 있었지…. 심지어 누군가는 에드윈의 이름을 들먹이면서 사기를 치고 다니더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538939
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538939,
					"content": "그렇게 폰타인 과학원의 명성은 그들에 의해 서서히 무너져 내려갔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538940
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538940,
					"content": "하지만 앞서 말했듯, 연구만 진전시킬 수 있다면 에드윈은 아무래도 상관없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538941
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538941,
					"content": "그리고 그자들은 에드윈을 앞세운 채로 천천히 과학원의 자원을 잠식했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538942
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538942,
					"content": "에드윈의 프로젝트 팀 멤버들과 그들이 사용하는 경비에 대한 감사를 진행하는 것이 과학원이 할 수 있는 유일한 처사였어. 슈아죌 씨는 그런 감사를 몇 번이나 직접 주도했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538943
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538943,
					"content": "하지만 그자들에게 있어 이러한 행동은 「관료주의적 행패」이자 「연구원에 대한 불신」으로 보였나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538944
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538944,
					"content": "과학원 내에 점점 더 많은 갈등이 불거졌지만… 그 누구도 해결할 방법을 알지 못했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538945
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538945,
					"content": "하지만 지금은… 모든 문제가 사라졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538946,
					"content": "과학원의 현재 상황에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538947
					]
				},
				{
					"id": 740538947,
					"content": "하하, 그건 기술 관련 질문이 아니라 행정 문제네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538948
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538948,
					"content": "그런 거라면 나보다는 슈아죌 씨가 더 잘 알 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538949,
					"content": "왜 내커 씨가 코어를 훔쳤다고 생각하세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538950
					]
				},
				{
					"id": 740538950,
					"content": "클로니아 씨가 폐허에서 찍은 사진을 내게 보여줬던 거 기억해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538951
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538951,
					"content": "그중에 내커 씨가 제어기 앞에서 작업을 하는 사진이 있었어. 상당히 흐릿하게 찍혔지만… 확실해. 그가 그때 취한 동작은 절대 조작에 필요한 것이 아니었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538952
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538952,
					"content": "그걸로는 확신할 수 없잖아? 어쩌면… 어쩌면 도둑이 저쪽 산꼭대기에서 날아와서 코어를 훔쳐 갔을 수도 있고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538953
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740538953,
					"content": "하하, 그건 절대 불가능해. 이 폐허 안의 아르케 광석 에너지 흐름을 견딜 수 있는 일반인은 없어. 그 자체로 최고의 방범 대책이라 할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538954
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538954,
					"content": "게다가 그 「실험성 역장 발생 장치」를 가동한 타이밍이 너무 절묘해. 그건 절대로 우연이 아니야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538955
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538955,
					"content": "이건 확실하지 않지만, 내커… 혹은 「코어 도둑」은 미리 「아르케 동력 코어」를 제거해서 예비용 에너지원을 가동시켰을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538956
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538956,
					"content": "하지만 「프뉴무시아 소멸 에너지 코어」는 상대적으로 비효율적인 에너지원이라, 이 커다란 녀석을 움직이게 하려면 지속적으로 에너지를 뿜어내야만 했을 테지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538957
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538957,
					"content": "그래서 그는 일부러 그 대형 아르케 광석을 활성화한 거였어. 너무 크지도, 작지도 않지만 주의를 끌기에는 충분한 폭발을 일으키기 위해서 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538958
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538958,
					"content": "그러면 과학원 사람들이 왔을 때 아르케 광석 제어기를 먼저 수리할 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538959
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538959,
					"content": "그리고 그들이 「실험성 역장 발생 장치」 안에 있는 예비용 에너지원을 꺼내야 한다는 것을 눈치챘을 때는 이미 「실험성 역장 발생 장치」의 충전을 끝낸 상태겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538960
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538960,
					"content": "기술적인 면에선 그랬을 가능성이 매우 커. 뭣보다 폰타인 과학원 내에서 이런 일을 할 수 있는 사람은 나, 에드윈, 그리고 내커 씨뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538961
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538961,
					"content": "에드윈이 이런 짓을 할 수 있을 리는 없으니… 남는 용의자는 나랑 내커 씨, 두 명이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538962
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538962,
					"content": "당신이 한 짓일 수도 있지 않나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538963
					]
				},
				{
					"id": 740538963,
					"content": "맞아. 아까 내커가 거짓말을 한 거라고 했지만, 그건 너도 마찬가지잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538964
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740538964,
					"content": "네가 북 치고 장구 치고 다 하면서 우리를 속여넘긴 것일 수도 있는 거 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538965
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740538965,
					"content": "너희들의 주장에도 일리는 있어. 난 이후에 과학원 내부 감사를 신청할 생각이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538966
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538966,
					"content": "하지만 내가 보기에 이런 범죄를 저지른 사람은 내커 씨일 가능성이 커. 이번 사건에서 가장 큰 이득을 얻은 건 그 사람이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740538967
					],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538967,
					"content": "만약 내가 그와 함께 용의자 명단에 오른다고 해도… 그가 유죄 판결을 받게 될 확률은 나보다 훨씬 높지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "레이먼드"
				},
				{
					"id": 740538968,
					"content": "이만 가볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740538969
					]
				},
				{
					"id": 740538969,
					"content": "응, 좋은 하루 보내",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "레이먼드"
				}
			]
		},
		{
			"id": 7405391,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
