			"dialogs": [
				{
					"id": 201040301,
					"content": "너, 너 뭐 한 거야! 풀 더미를 다 태워버리면 어떡해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040302
					],
					"speakerTitle": "모코"
				},
				{
					"id": 201040302,
					"content": "이건 야단맞는다고 해결될 문제가 아니야. 분명 쫓겨날 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040303
					],
					"speakerTitle": "하일리"
				},
				{
					"id": 201040303,
					"content": "본의 아니게…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040304
					]
				},
				{
					"id": 201040304,
					"content": "이럴 줄 알았으면 우리가 하나하나 천천히 골라내는 건데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040305
					],
					"speakerTitle": "모코"
				},
				{
					"id": 201040305,
					"content": "끝났어…. 이번엔 완전히 끝났어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040306
					],
					"speakerTitle": "하일리"
				},
				{
					"id": 201040306,
					"content": "그게…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040307
					]
				},
				{
					"id": 201040307,
					"content": "여행자, 그만 가 줄래? 이 일은 우리 책임이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040308
					],
					"speakerTitle": "모코"
				},
				{
					"id": 201040308,
					"content": "청소할 줄도 모르는 사람한테 일을 맡기는 게 아니었는데. 우리 잘못이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040309
					],
					"speakerTitle": "하일리"
				},
				{
					"id": 201040309,
					"content": "하녀장님께서 어떤 벌을 내리실까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040310
					],
					"speakerTitle": "모코"
				},
				{
					"id": 201040310,
					"content": "이젠, 완전 끝났어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하일리"
				}
			]
