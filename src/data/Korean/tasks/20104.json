			},
			"dialogs": [
				{
					"id": 201040101,
					"content": "어쩌지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040102
					],
					"speakerTitle": "모코"
				},
				{
					"id": 201040102,
					"content": "하녀장님한테 또 욕먹겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040103
					],
					"speakerTitle": "하일리"
				},
				{
					"id": 201040103,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040104
					]
				},
				{
					"id": 201040104,
					"content": "아델린 씨께서 와이너리 주변를 청소하라고 하셨거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040105
					],
					"speakerTitle": "모코"
				},
				{
					"id": 201040105,
					"content": "다른 곳은 얼추 된 것 같은데 주변엔 아직도 풀 더미가 쌓여 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040106
					],
					"speakerTitle": "하일리"
				},
				{
					"id": 201040106,
					"content": "이건 코너 어르신께서 쓸데가 있으시다며 일부러 여기에 쌓아두신 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040107
					],
					"speakerTitle": "모코"
				},
				{
					"id": 201040107,
					"content": "단단하게 묶어서 폭풍이 왔을 때 날아가지는 않았지만, 낙엽이 더미 속으로 밀려와 버렸어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040108
					],
					"speakerTitle": "하일리"
				},
				{
					"id": 201040108,
					"content": "열심히 치우긴 했는데 풀 더미에 섞인 낙엽을 깨끗이 치우지는 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040109
					],
					"speakerTitle": "모코"
				},
				{
					"id": 201040109,
					"content": "이렇게 시간을 끌다간 하녀장님께 분명 꾸중을 듣고 말 거야. 이걸 어쩌지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040110,
						201040112
					],
					"speakerTitle": "하일리"
				},
				{
					"id": 201040110,
					"content": "제게 맡기세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040111
					]
				},
				{
					"id": 201040111,
					"content": "응? 맡겨도 돼? 잘됐다. 부탁 좀 할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "모코"
				},
				{
					"id": 201040112,
					"content": "치우기 어렵나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040113
					]
				},
				{
					"id": 201040113,
					"content": "낙엽이랑 풀 더미가 뒤섞여 있으니까 하나하나 손으로 골라내는 수밖에 없어. 그러다 보니 느릴 수밖에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040114
					],
					"speakerTitle": "하일리"
				},
				{
					"id": 201040114,
					"content": "무슨 좋은 방법 있으면 우리 좀 도와줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하일리"
				}
			]
		},
