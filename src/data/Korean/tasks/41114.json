			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"모나",
					"피슬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411140101,
					"content": "어라, 피슬. 우릴 기다린 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411140102,
					"content": "딱 맞춰오셨군요. 아쉽지만 여러분께 말씀드릴 때가 왔네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140103
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 411140103,
					"content": "당분간 작별해야겠군, 동행자. 그동안 그대는 비범한 용기를 보여줬다. 이건 널 위해 부는 찬사의 바람이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140104
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411140104,
					"content": "에에엥? 갑자기 웬 작별 인사?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411140105,
					"content": "이제 떠나는 거야, 피슬?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140106
					]
				},
				{
					"id": 411140106,
					"content": "거대 운석으로 더 많은 분들이 잠에 빠졌습니다. 체력이 강한 병사들도 버티지 못해서 일손이 많이 부족한 상황이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140107
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 411140107,
					"content": "황녀님과 전 병사들 대신 환자들을 돌볼 테니, 남은 건 여러분께 맡기겠습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140108
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 411140108,
					"content": "#{NICKNAME}… 잘 가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140109
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411140109,
					"content": "넌 내 이야길 잘 들어주는 좋은 사람이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140110
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411140110,
					"content": "평소에 길드에서 나랑 파트너하겠다는 모험가들은 많아. 하지만 그건 오즈의 정찰 결과를 듣기 위해서 그런 것뿐이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140111
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411140111,
					"content": "짧은 여정이었지만 정말 좋은 모험이었어. 갑자기 가려니까 나도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140112
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411140112,
					"content": "어? 피슬의 말투가 평소랑 다른데…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411140113,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140114
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411140114,
					"content": "(아——아아아방금 나도 모르게 방심했어…!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140115
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411140115,
					"content": "아, 아가씨의 뜻은… 여러분은 용감하고 비범한 지혜를 가졌으니 어떠한 문제도 다 해결할 수 있다는 말씀이세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140116
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 411140116,
					"content": "이번엔 오즈가 완전히 반대로 「통역」하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411140117,
					"content": "크, 크흠… 그러니까 아가씨는 여러분이라면 분명 환상 뒤에 숨겨진 진실에 도달할 수 있다고 하십니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140118
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 411140118,
					"content": "크흠… 그렇다. 그대들은 황녀의 부하. 단죄의 기사여, 그들을 인도하여 어둠에서 벗어나 광명의 땅으로 돌아가라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140119
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411140119,
					"content": "누가 네 부하라는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140120
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411140120,
					"content": "오즈, 피슬, 고마워",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140121
					]
				},
				{
					"id": 411140121,
					"content": "또 만나게 될 겁니다. 모든 게 끝나면 다 같이 술이라도 한잔하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140122
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 411140122,
					"content": "흠, 쓸만한 두 사람이 가버렸네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140123
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411140123,
					"content": "얼굴 좀 펴. 좋은 소식을 알려줄게, 새로 발견한 게 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140124
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411140124,
					"content": "그 거대 운석의 가루를 점괘에 썼더니 효과가 꽤 좋더라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140125
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411140125,
					"content": "이 추락한 바위들은 이미 수천 년 이상 존재했어. 레너드는 아마 아주 옛날 사람일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140126
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411140126,
					"content": "운석엔 그의 의지가 담겨 있어. 즉 수천 년 동안 그의 염원이 약해지지 않았다는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140127
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411140127,
					"content": "산의 정상까지 오르길 갈망하는 옛사람…. 그도 분명 너와 같은 모험가였을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140128
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411140128,
					"content": "모험가? 그래서 그렇게 설산을 오르고 싶어 했구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411140129,
					"content": "지금까지의 방법은 시간과의 싸움이나 마찬가지였지, 너무 수동적이었어. 생각을 아예 바꿔서 근본적인 문제부터 해결해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140130
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411140130,
					"content": "나도 동의해! 지금은 레너드를 찾아내는 게 우선인 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411140131,
					"content": "음… 만약 운석에 어떤 소원이 깃들어 있는 거라면, 이 바위들은 피슬이 말한 것처럼 일종의 「저주」라고 할 수 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140132
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411140132,
					"content": "피슬이 그걸 맞히다니, 말도 안 돼…. 흠흠, 아냐, 우아한 점성술사가 남을 험담하면 안 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140133
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411140133,
					"content": "어쨌든 우리가 저주를 풀기만 하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140134
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411140134,
					"content": "그럼 바로 출발하자, 페이몬",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411140135
					]
				},
				{
					"id": 411140135,
					"content": "응!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140136
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411140136,
					"content": "예전의 모험가를 조사하려면 <color=#00E1FFFF>모험가 길드</color>부터 가봐야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
