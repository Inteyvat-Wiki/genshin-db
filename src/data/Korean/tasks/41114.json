			"dialogs": [
				{
					"id": 411140701,
					"content": "이름이 같은 모험가가 여러 명이라 나도 확실친 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140702
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 411140702,
					"content": "근데 그 이름의 저자가 쓴 책은 있었던 거 같은데, 도서관에 한번 가보는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140703
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 411140703,
					"content": "근데 레너드라는 사람이 쓴 책이 있었던 거 같은데, <color=#00E1FFFF>도서관</color>에 한번 가보는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐서린"
				}
			]
		},
