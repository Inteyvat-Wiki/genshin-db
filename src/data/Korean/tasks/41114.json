			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"모나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141501,
					"content": "정말 치열한 전투였어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411141502,
					"content": "날 화나게 한 대가야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141503
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411141503,
					"content": "엄청 강하구나, 모나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141504
					]
				},
				{
					"id": 411141504,
					"content": "당연하지! 페이몬, 어때? 너도 내가 강하다고 생각하지? 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141505
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411141505,
					"content": "맞아 맞아, 모나가 없었다면 아마 상황이 더 나빠졌을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411141506,
					"content": "흥, 들었지? 우인단 집행관! 이 나쁜 놈아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141507
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411141507,
					"content": "근데 그 녀석이 그렇게 놀란 걸 보면 거짓말 같진 않던데. 설마 스승님이 점성술을 가르쳐 줬을 때 말한 「거짓된 하늘」에 다른 뜻이 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141508
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411141508,
					"content": "아… 크흠, 아무것도 아니야. 그럼 이제 제일 중요한 걸 하러 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141509
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411141509,
					"content": "<color=#00E1FFFF>운석의 핵</color>은 분명 이 근처에 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 4111416,
			"completionStepIds": [
				4111416
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111416",
							"2"
						],
						"stepId": 4111416,
						"stateName": "QUEST_STATE_UNFINISHED"
