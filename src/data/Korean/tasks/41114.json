			},
			"dialogs": [
				{
					"id": 411140801,
					"content": "작가, 레너드… 레너드…. 있다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140802
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411140802,
					"content": "레너드의 모험가 핸드북은 도서관 <color=#00E1FFFF>1층</color>의 <color=#00E1FFFF>북서쪽 코너</color>에 있대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411140803
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411140803,
					"content": "북서쪽 코너면… 저쪽이겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
