			"trigger": {
				"objectNames": [
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141401,
					"content": "찾았다! 모험가 핸드북 《산과 바다의 서》, 작가 레너드!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411141402,
					"content": "근데 이 책 지워진 부분도 많고 없어진 페이지도 있는데? 무슨 말인지 모르겠잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411141403,
					"content": "이럴 수가, 우으…. 헛걸음한 거 아니야…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411141404,
					"content": "아닐 거야, 일단 모나한테 보여주자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141405
					]
				},
				{
					"id": 411141405,
					"content": "아, 맞아. 모나한텐 방법이 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 4111415,
			"completionStepIds": [
				4111415
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111415",
							"2"
