			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"모나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411141601,
					"content": "우와, 이게 바로 운석의 핵? 다른 운석들과는 좀 달라! 뭔가… 더 밝은 느낌?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141602
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411141602,
					"content": "이 바위엔 엄청난 원소의 힘과 집념이 깃들어 있어. 이게 핵이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141603
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411141603,
					"content": "그럼… 파괴해야 되나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141604
					]
				},
				{
					"id": 411141604,
					"content": "응, 안 그러면 사람들이 깨어나지 못할 거야… 이 핵이 바로 모든 문제의 근원이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141605
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411141605,
					"content": "#{NICKNAME}, 해보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141606
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411141606,
					"content": "그런 일이 있었을 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141607,
						411141608
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411141607,
					"content": "산을 오르던 자가 미지의 정상에 도달하려고 했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141609
					]
				},
				{
					"id": 411141609,
					"content": "인간의 신념이 하늘에 수천 년 동안이나 남아있었다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141610
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411141610,
					"content": "응, 역시 점성술은 정말 대단해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141611
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411141611,
					"content": "갑자기 웬 점성술 타령?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141612
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411141612,
					"content": "별들과 교류할 수 있으면 지금까지의 모든 비밀을 알 수 있다고. 물론, 그 정도 실력이 있는 점성술사는 나 말고 별로 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141613
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411141613,
					"content": "이번엔 정말 고마웠어, 모나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141614
					]
				},
				{
					"id": 411141614,
					"content": "뭐, 뭐야. 갑자기 그렇게 진지하게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141615
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411141615,
					"content": "그나저나 그 피슬이라고 하는 애, 정말 신기하단 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141616
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411141616,
					"content": "내 말이! 그 애는… 음… 뭐랄까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141617,
						411141618
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411141617,
					"content": "상상력이 풍부한 사람이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141619
					]
				},
				{
					"id": 411141619,
					"content": "그렇긴 한데, 생각해보면… 피슬의 말이 전부 틀린 건 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141620
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411141620,
					"content": "혹시 잘못된 과정으로 정확한 결과를 얻어내는 타입인 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141621
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411141621,
					"content": "그럴지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141622
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411141622,
					"content": "제일 의외였던 건, 고깔모자 산이 작은 섬이 됐다는 점이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141623
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411141623,
					"content": "과거의 높은 산이 바다 가운데 있는 작은 육지가 되다니. 지금은 배만 타면 다들 갈 수 있는 거 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141624
					],
					"speakerTitle": "모나"
				},
				{
					"id": 411141624,
					"content": "그럼 누구나 고깔모자 산에 오를 수 있는 거네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141625
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411141625,
					"content": "누구나 정상에 오를 수 있겠네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141626
					]
				},
				{
					"id": 411141626,
					"content": "레너드가 좋아하려나? 고깔모자 산은 그렇다 쳐도, 지금 몬드 사람들은 바람의 신 덕분에 비행도 할 수 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141627
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411141627,
					"content": "날개가 있으면 사람들은 더 높고 멀리 갈 수 있어. 더 많은 미지의 땅을 탐구할 수도 있고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141628
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411141628,
					"content": "(당신의 소원이 이루어졌나요, 레너드 씨?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141629
					]
				},
				{
					"id": 411141629,
					"content": "좋아, 운석의 핵을 처리했으니 잠든 사람들도 깨어날 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141630
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411141630,
					"content": "우리도 모험가 길드의 의뢰를 무사히 끝낸 셈이지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411141631
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411141631,
					"content": "응, 다들 빨리 회복했으면 좋겠네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 411141618,
					"content": "공상으로 가득 찬 이상한 사람이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141619
					]
				},
				{
					"id": 411141608,
					"content": "집념이 강한 자가 그 의지를 후세에 전하려 했어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411141609
					]
				}
			]
		}
	]
}