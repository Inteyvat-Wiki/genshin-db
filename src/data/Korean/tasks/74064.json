				"points": []
			},
			"dialogs": [
				{
					"id": 740640201,
					"content": "탱탱 물범 한 마리를 잡아다가 낙서를 향해 물을 뿜게 하면 지워지지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640202
					],
					"speakerTitle": "무푸알"
				},
				{
					"id": 740640202,
					"content": "그거 농담이지? 요즘 힘들어? 제정신 맞아? 배정된 업무가 너무 많은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640203
					],
					"speakerTitle": "갈바리엣"
				},
				{
					"id": 740640203,
					"content": "난 제정신이야. 그저 탱탱 물범이 물을 뿜는 걸 보고 싶었을 뿐이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640204
					],
					"speakerTitle": "무푸알"
				},
				{
					"id": 740640204,
					"content": "너 그냥 푹 쉬는 게 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "갈바리엣"
				}
			]
		},
		{
