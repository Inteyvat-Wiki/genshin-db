			"dialogs": [
				{
					"id": 716665101,
					"content": "멋진 실력이야. 내가 졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665102
					],
					"speakerTitle": "「말할 시간에 한 방이라도 더 먹여야지」"
				},
				{
					"id": 716665102,
					"content": "#{NICKNAME}에게 진 것도 영광이라 할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665103
					],
					"speakerTitle": "「말할 시간에 한 방이라도 더 먹여야지」"
				},
				{
					"id": 716665103,
					"content": "이런 방법을 쓰면 이길 수 있구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665104
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 716665104,
					"content": "맞아, 민첩한 적을 상대할 땐 다양한 전술이 필요하다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716665105,
					"content": "#전술이 안 통할 땐 생각을 바꿔 봐. 나랑 {NICKNAME}은(는) 여행할 때 항상 유연하게 일을 처리하려고 하거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716665106,
					"content": "한 가지 방법에만 매달리면 아무리 애를 써도 문제를 해결할 수 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 716665107,
					"content": "시노부도 비슷한 말을 했던 것 같은데, 음, 일리 있는 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665108
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 716665108,
					"content": "근데 그런 건 나중에 생각하고, 지금은 급한 곤충 싸움에나 집중하자고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아라타키 이토"
				}
			]
