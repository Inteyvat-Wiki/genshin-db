				},
				{
					"id": 718050502,
					"content": "기향 사장님이 보낸 책이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050503
					]
				},
				{
					"id": 718050503,
					"content": "생각났군. 전에 「만문집사」에서 《기형경》 한 권을 주문했었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050504
					],
					"speakerTitle": "천추 아저씨"
				},
				{
					"id": 718050504,
					"content": "맞아, 바로 이 책이야. 드디어 왔군. 하하, 난 또 손님이 너무 많아서 기향 씨가 잊어버린 줄 알았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050505
					],
					"speakerTitle": "천추 아저씨"
				},
				{
					"id": 718050505,
					"content": "이제라도 왔으면 됐어…. 오, 표지도 아주 멋진걸. 신경 좀 써주신 모양이군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050506
					],
					"speakerTitle": "천추 아저씨"
				},
				{
					"id": 718050506,
					"content": "고맙네, 젊은이. 그럼 이 책은 잘 받을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "천추 아저씨"
				}
			]
