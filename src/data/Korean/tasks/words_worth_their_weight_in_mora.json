			"dialogs": [
				{
					"id": 718050401,
					"content": "무슨 일인가, 젊은이?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050402
					],
					"speakerTitle": "덕안공"
				},
				{
					"id": 718050402,
					"content": "기향 사장님이 보낸 책이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050403
					]
				},
				{
					"id": 718050403,
					"content": "《제군의 속세 여행기·Ⅳ》? 이건 한참 전에 주문했던 거 같은데 왜 이제서야 온 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050404
					],
					"speakerTitle": "덕안공"
				},
				{
					"id": 718050404,
					"content": "어디 보자…. 음? 초판본이잖아. 그래서 이렇게 늦었군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050405
					],
					"speakerTitle": "덕안공"
				},
				{
					"id": 718050405,
					"content": "서점에 손님이 너무 많아서 이 책에 관한 건 잊어버린 줄 알았는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050406
					],
					"speakerTitle": "덕안공"
				},
				{
					"id": 718050406,
					"content": "그럼 이 책은 잘 받을게. 고맙네, 젊은이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "덕안공"
				}
			]
		},
