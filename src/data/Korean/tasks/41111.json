			},
			"dialogs": [
				{
					"id": 411111801,
					"content": "청소가 어느 정도 끝난 거 같아. 샘물 마을 주민들한테 도움이 됐으려나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111802
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411111802,
					"content": "원소의 힘이 깃든 운석…. 이게 바로 사건의 원흉일까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111803
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 411111803,
					"content": "축복의 성약으로 맹세하는데 이 운석들이 바로 악몽의 근원인 게 틀림없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111804
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411111804,
					"content": "마을로 돌아가서 확인해보자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111805
					]
				},
				{
					"id": 411111805,
					"content": "응!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
