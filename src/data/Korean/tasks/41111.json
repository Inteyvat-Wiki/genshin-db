					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111409
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411111409,
					"content": "방금 깨어난 아저씨, 꿈에서 뭘 봤어?",
