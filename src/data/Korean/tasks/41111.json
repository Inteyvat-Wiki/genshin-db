				"points": []
			},
			"dialogs": [
				{
					"id": 411110101,
					"content": "여행자, 마침 잘 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110102
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 411110102,
					"content": "캐서린, 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411110103,
					"content": "응, 모험가들한테 도움을 청할 수밖에 없는 큰일이 생겼거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110104
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 411110104,
					"content": "급하게 네게 맡길 임무가 있어, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110142
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 411110142,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110105
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 411110105,
					"content": "으아… 엄청 심각한 모양이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411110106,
					"content": "솔직히 이런 일은 우리도 처음이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110107
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 411110107,
					"content": "길드가 눈코 뜰 새 없이 바빠서 탐험 중인 모험가들의 도움이 필요한 상황이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110108,
						411110109
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 411110108,
					"content": "그럴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				},
				{
					"id": 411110110,
					"content": "잠깐, 혹시 모르니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110111
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 411110111,
					"content": "캐서린! 유야 정토의 백성이여, 설마 나를 부른 게 그대인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110112
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411110112,
					"content": "아, 왔다 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110113
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 411110113,
					"content": "또 만났군요, 캐서린 씨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110114
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 411110114,
					"content": "와! 까마귀가 말을 해?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411110115,
					"content": "하하, 뭘 그렇게 놀라십니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110116
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 411110116,
					"content": "내 충실한 신하여, 근심이 가득한 얼굴을 보니 또 그 간사한 죄인들이 몬드의 평화를 깨트렸나 보구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110117
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411110117,
					"content": "여행자, 이분은 몬드 모험가 길드의 시니어 모험가 피슬이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110118
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 411110118,
					"content": "피슬, 오즈. 이분이 바로 내가 전에 얘기한 여행자야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110119
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 411110119,
					"content": "오? 네가? 훗… 좋은 눈빛이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110120
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411110120,
					"content": "페보니우스 기사단의 명예 기사와 그의 길동무 페이몬. 만나서 정말 반갑습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110121
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 411110121,
					"content": "너도 깊고 그윽한 어둠의 결정에 맞서려는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110122
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411110122,
					"content": "그윽한… 뭐? 어둠의 뭐에 맞선다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411110123,
					"content": "캐서린 씨, 방금 말한 건 이게 아니잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110125
					]
				},
				{
					"id": 411110125,
					"content": "아가씨가 말씀하신 게 바로 그 <color=#00E1FFFF>운석</color>들입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110126
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 411110126,
					"content": "길드 측에선 아직 운석우가 발생한 원인과 부작용을 정확히 파악하지 못했어. 그래서 모험가들이 2인 1조가 돼서 팀을 이뤄줬으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110127
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 411110127,
					"content": "여행자, 피슬. 너희 둘이 서로 협력하면서 안전하게 움직여줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110128
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 411110128,
					"content": "흥, 충실한 캐서린의 부탁이니 이 황녀가 들어주는 수밖에",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110129
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411110129,
					"content": "훗~! 단죄의 황녀 피슬 님과 함께 여정에 오를 수 있는 걸 여생 동안 자랑스러워하라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110130
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411110130,
					"content": "이분은 저의 주인, [이세계]·유야 정토에서 오신 황녀 피슬이십니다. 그리고 전 그녀의 권속, 까마귀 오즈입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110131
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 411110131,
					"content": "엄, 엄청 대단한 사람이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110132
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411110132,
					"content": "#난 페이몬이고, 얜 {NICKNAME}(이)야. 잘 부탁해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110133,
						411110134
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411110133,
					"content": "근데 방금, [이세계]라고 했어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110135,
					"content": "음, 피슬이랑 오래 지내다 보면 차차 알게 될 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110136
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 411110136,
					"content": "여행자 따위가 무한한 유야 정토의 위대함을 깨닫지 못하는 것도 당연한 일이지. 좋아, 용서해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110137
					],
					"speakerTitle": "피슬"
				},
				{
					"id": 411110137,
					"content": "용서?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110138
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411110138,
					"content": "「안녕」이라고 하십니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110139
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 411110139,
					"content": "이 두 사람 아까부터 짜고 연극이라도 하는 건가…? 주인은 신비스러운데 권속은 옆에서 자꾸 태클 걸잖아, 이상해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110140
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411110140,
					"content": "두 분께서 궁금한 게 많으신 것 같군요. 가면서 얘기하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110141
					],
					"speakerTitle": "오즈"
				},
				{
					"id": 411110141,
					"content": "그나저나 이게 어떻게 2인 1조야? 완전히 4인 1조잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 411110134,
					"content": "유야 정토…처음 들어봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
