					"아란리캔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270401,
					"content": "결국 일단락됐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730270402,
					"content": "참 기나긴 모험이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270403,
						730270406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730270403,
					"content": "쟈자리 씨한테 얘기해주면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270404
					]
				},
				{
					"id": 730270404,
					"content": "맞아, 노심의 일을 알려주면 우리를 위해 경비 같은 걸 신청해 주려나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730270405,
					"content": "#하지만, 난 아카데미아에 가기 싫어. {NICKNAME}, 너도 싫지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730270409,
					"content": "「마라나의 화신」이 심연 교단과 대체 무슨 관계가 있는지는 모르겠지만, 숲의 「병」이 치료돼서 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730270410,
					"content": "흑흑흑, 아란리캔은 너희들이 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270411
					],
					"speakerTitle": "아란리캔"
				},
				{
					"id": 730270411,
					"content": "천만에, 아란리캔",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270412
					]
				},
				{
					"id": 730270412,
					"content": "아란리캔은 앞으로 어떻게 할 계획이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730270413,
					"content": "아란리캔은 우트사바 축제에 참가하고 싶은데, 숲의 「병」이 걱정돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270414
					],
					"speakerTitle": "아란리캔"
				},
				{
					"id": 730270414,
					"content": "숲이 병들길 바라는 나쁜 것이 돌아올 수도 있어. 아란리캔은 숲을 보호해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270415
					],
					"speakerTitle": "아란리캔"
				},
				{
					"id": 730270415,
					"content": "그러니까 우트사바 축제가 끝나면 아란리캔은 이곳으로 다시 돌아올 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270416
					],
					"speakerTitle": "아란리캔"
				},
				{
					"id": 730270416,
					"content": "아란나라도 고생이 많아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270417
					]
				},
				{
					"id": 730270417,
					"content": "아란리캔, 도움이 필요하면 꼭 우릴 찾아와야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270418
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730270418,
					"content": "응응, 알겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270419
					],
					"speakerTitle": "아란리캔"
				},
				{
					"id": 730270419,
					"content": "헤헤, 몸조심하고! 우린 꼭 다시 만날 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730270406,
					"content": "로인잔 할아버지한테 말씀드리면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270407
					]
				},
				{
					"id": 730270407,
					"content": "로인잔 할아버지는 「참으로 흥미로운 이야기로구나」라고 하실걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730270408,
					"content": "우리가 정말 숲을 구할 줄 누가 알았겠어",
