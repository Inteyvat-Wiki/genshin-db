					"동식"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020101,
					"content": "아, 왔구나. 마침 자네한테 할 얘기가 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020102,
						414020103
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020102,
					"content": "무슨 일이죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				},
				{
					"id": 414020104,
					"content": "아니, 그럴 필요 없어. 원인을 알아냈거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020105
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020105,
					"content": "며칠 전에 드디어 그 「사진기」를 판 상인을 찾았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020106
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020106,
					"content": "「사진기」가 좀 이상하다고 했더니 그 사람이 도저히 안 믿는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020107
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020107,
					"content": "근데 다행히 자네가 그림을 많이 찍어줬잖아. 그게 없었으면 아마 발뺌했을 테지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020108
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020108,
					"content": "그 그림들을 보더니 돌아가서 내가 산 「사진기」들을 전부 확인해보겠다더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020109
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020109,
					"content": "그래서 그가 어제 어떤 약을 갖다 줬는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020110
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020110,
					"content": "이런 「사진기」는 구조가 좀 달라서 기계 안에 약을 넣어야 정상적인 그림이 나온다네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020111
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020111,
					"content": "아니면 전에 자네가 찍은 그림처럼 색깔만 있고 뚜렷한 이미지는 안 나오게 되는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020112,
						414020113
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020112,
					"content": "불량품이 아니라 다행이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020114,
					"content": "음, 그렇긴 한데 사실 난 「사진기」보다 이 약이 더 흥미로워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020115
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020115,
					"content": "생각해 봐, 「사진기」는 한번 사면 계속 쓸 수 있으니까 다들 하나씩만 사잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020116
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020116,
					"content": "근데 이런 약은 다 쓰면 계속 새로 사야 한다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020117
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020117,
					"content": "그리고 그 상인 말에 의하면, 약의 종류에 따라서 사진의 효과가 달라진대. 그래서 그도 더 많은 약을 연구 중인 모양이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020118
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020118,
					"content": "이거야말로… 큰 사업이 될지도 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020119
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020119,
					"content": "에헴, 혼자 떠들어서 미안하군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020120
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020120,
					"content": "도와줘서 고마워. 약을 넣어줄 테니 일단 「사진기」를 줘보게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동식"
				},
				{
					"id": 414020113,
					"content": "그럼… 더 문제없는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020103,
					"content": "오늘도 「색깔」이 강렬한 걸 찍어야 하나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				}
			]
		},
