			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"동식"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020301,
					"content": "이 「사진기」는 자네한테 주겠네. 잘 간수해둬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020302,
						414020303
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020302,
					"content": "저한테 주신다고요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				},
				{
					"id": 414020304,
					"content": "약은 아마 꽤 오래 쓸 수 있을 거야. 다 쓰면… 나한테 와서 사가면 되지, 하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020305
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020305,
					"content": "그 상인한테서 더 다양한 약을 들일 거거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020306
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020306,
					"content": "관심 있으면 언제든 들러주게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020307
					],
					"speakerTitle": "동식"
				},
				{
					"id": 414020307,
					"content": "이야… 「사진기」 하나로 이렇게 돈 되는 장사를 할 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동식"
				},
				{
					"id": 414020303,
					"content": "약을 다 쓰면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				}
			]
		}
	]
}