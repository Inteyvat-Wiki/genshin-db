			"dialogs": [
				{
					"id": 200710401,
					"content": "여기요, 여기, 이쪽이요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710402
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200710402,
					"content": "저번에 설산에 묻어달라고 부탁했던 꽃들 기억하세요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710403
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200710403,
					"content": "하루가 지났으니 냉장 효과를 보고 싶어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710404
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200710404,
					"content": "설산에 가서 그 꽃들을 가지고 와줄 수 있어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710405,
						200710407
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200710405,
					"content": "내게 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710406
					]
				},
				{
					"id": 200710406,
					"content": "그럼 부탁할게요. 전 여기서 기다릴 테니 서둘러주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "플로라"
				},
				{
					"id": 200710407,
					"content": "꽃을 어디다 뒀더라…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710408
					]
				},
				{
					"id": 200710408,
					"content": "기억 안 나세요? <color=#00E1FFFF>일곱신상 옆</color>과 <color=#00E1FFFF>산속의 물가</color>, 그리고 <color=#00E1FFFF>동굴 근처</color>였어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710409
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200710409,
					"content": "제가 다시 지도에 표시해드릴게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "플로라"
				}
			]
		}
	]
