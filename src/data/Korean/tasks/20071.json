			},
			"dialogs": [
				{
					"id": 200710101,
					"content": "전에 설산에 묻어뒀던 꽃은 어떻게 됐나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710102
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200710102,
					"content": "한 상자밖에 못 건졌어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710103
					]
				},
				{
					"id": 200710103,
					"content": "다른 꽃들은 가져오지 못한 건가요? 음… 괜찮아요. 설산의 상황은 예측 불가니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710104
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200710104,
					"content": "하지만 이것밖에 없으니 비교는 힘들겠어요. 다음 기회를 기약하는 수밖에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710105
					],
					"speakerTitle": "플로라"
				},
				{
					"id": 200710105,
					"content": "도와줘서 고마워요. 이건 보수예요. 앞으로도 잘 부탁해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "플로라"
				}
			]
		},
