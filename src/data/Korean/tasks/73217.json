			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170501,
					"content": "본 항구에 입항하는 모든 선박은 항무 책임자에게 소유인 정보, 입항 사유 등 정보를 등록해야 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170502
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732170502,
					"content": "상선이면 상품 적재에 관한 상세 정보를 제출해야 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170503
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732170503,
					"content": "등록되지 않은 상선일 경우 하역, 무역 활동 등 모든 행위가 금지됩니다. 불법 행위 적발 시 엄벌하니 명심하십시오",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "게시판"
				}
			]
		},
		{
			"id": 7321706,
			"completionStepIds": [
				7321706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321706",
							"2"
						],
