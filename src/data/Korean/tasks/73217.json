			"dialogs": [
				{
					"id": 732172001,
					"content": "바다 괴수 출몰!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732172002
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732172002,
					"content": "최근 바다 괴수가 빈번하게 출몰하고 있습니다. 출항 선박들은 파로스 탑 또는 교령관 공지를 통해 경보 정보 및 해역 정보를 미리 확인하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732172003
