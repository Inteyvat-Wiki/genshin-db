			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170701,
					"content": "바다 괴수가 출몰했습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170702
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732170702,
					"content": "최근 바다 괴수가 빈번하게 출몰하고 있습니다. 출항 선박들은 파로스 탑 또는 허공을 통해 경보 정보 및 해역 정보를 미리 확인하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170703
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732170703,
