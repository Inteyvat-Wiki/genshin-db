					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170601,
					"content": "본 항구는 밀수를 금지합니다. 본 항구를 출입하는 화물은 전부 등록 및 검사를 받아야 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170602
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732170602,
					"content": "등록하지 않은 화물, 수출입이 금지된 불법 물품이 발견될 경우 전부 몰수 처리됩니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170603
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732170603,
					"content": "상기 행위로 인한 모든 결과는 본인이 부담해야 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "게시판"
				}
			]
		},
		{
