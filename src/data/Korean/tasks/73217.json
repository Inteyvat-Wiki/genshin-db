						732170802
					],
					"speakerTitle": "게시판"
				},
				{
					"id": 732170802,
					"content": "아카데미아 학적을 가지고 있는 여행객은 특별 할인을 받을 수 있습니다",
					"roleType": "TALK_ROLE_NPC",
