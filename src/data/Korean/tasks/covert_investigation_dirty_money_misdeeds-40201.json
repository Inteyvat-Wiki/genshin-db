			},
			"dialogs": [
				{
					"id": 402010101,
					"content": "좋네, 시간에 딱 맞춰 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010102,
						402010103
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402010102,
					"content": "진전이 좀 있었나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				},
				{
					"id": 402010104,
					"content": "저번 거점에서 하루 잠복 관찰한 결과, 범인 코더와 도다마니가 그곳의 물건들을 옮기기 시작했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010105
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402010105,
					"content": "저 배 보이지? 저게 도다마니가 화물을 옮기려고 불러온 배야. 자신을 엄폐할 화물 운송 연합이라는 가면까지 쓰고 나타났지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010106
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402010106,
					"content": "오, 엄청 커다란 배야! 배에 실을 화물이 다리에 쌓여있고, 등방울 항구로 가려는 외지인도 제법 많아 보이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010107,
						402010108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402010107,
					"content": "상대의 속임수를 배제하려면",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010109,
					"content": "훌륭해, 벌써 속임수를 예방할 줄도 알고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010110
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402010110,
					"content": "확실히 코더와 도다마니가 자신이 조사 대상일지 의심한다면, 등방울 항구에 「빈 배」를 보내 신중히 집법 기관의 움직임을 관찰할 만하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010111
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402010111,
					"content": "하지만 조심해. 체포된 범인의 정보에 따르면, 「사기광」이라 불리는 보물 사냥단의 베테랑이 「검은돈 영주」와 협력하고 있다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010112
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402010112,
					"content": "「사기광」은 몰래 위험한 일을 꾸미는 데 능한 무법자야. 이전 조사 결과로 볼 때 섬에서 천암군의 등불 신호를 관찰하던 감시자가 녀석이겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010113
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402010113,
					"content": "난 「사기광」이 현장을 감시하지 못하도록 주변을 돌아다닐게. 너흰 그 틈에 물건을 조사해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010114
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402010114,
					"content": "행동할 땐 눈에 띄지 않도록 조심해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010115,
						402010116
					],
					"speakerTitle": "야란"
				},
				{
					"id": 402010115,
					"content": "네, 조심할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010117,
					"content": "#음! 나도 최대한… 낮게 날게! {NICKNAME}의 어깨를 넘지 않을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 402010116,
					"content": "안심해요, 저잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010108,
					"content": "화물부터 미리 조사해야겠죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010103,
					"content": "상대가 움직였나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				}
			]
		},
