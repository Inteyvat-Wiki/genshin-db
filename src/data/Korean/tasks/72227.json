				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270301,
					"content": "이쪽 서목도 다 끝났네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722270302,
					"content": "대단해! 이게 바로 진정한 모험가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270303
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270303,
					"content": "음… 전에도 다른 사람이 온 적 있는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270304
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270304,
					"content": "#모두 {NICKNAME} {F#누나}{M#형아}랑 페이몬만큼 대단하지는 않았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270305
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270305,
					"content": "다른 사람?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722270306,
					"content": "응, 마우시로를 찾으러 왔대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270307,
						722270308
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270307,
					"content": "혹시 스미다 씨…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				},
				{
					"id": 722270309,
					"content": "그나저나, 마우시로가 도대체 뭐야? 츠루미 사람들의 악기라는 것만 알고 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722270310,
					"content": "응~ 소리를 낼 수 있는 장치인 건 맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270311
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270311,
					"content": "우린 안개바다 때문에 앞이 잘 보이지가 않잖아? 그래서 마우시로로 자신의 위치를 알렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270312
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270312,
					"content": "소리 지르는 건 시끄럽기도 하고! 목도 상하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270313
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270313,
					"content": "확실히 아무것도 안 보여…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722270314,
					"content": "그렇지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270315
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270315,
					"content": "아빠… 마타 할아버지가 그랬는데, 마우시로의 소리는 안개 속에서 길을 잃은 영혼이 집으로 돌아갈 수 있도록 인도한다고 했어. 그래서 마우시로는 엄청 중요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270316
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270316,
					"content": "응? 그렇게 중요한 거였어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722270317,
					"content": "그래서 제전에서 필요했던 거구나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270318
					]
				},
				{
					"id": 722270318,
					"content": "#응, 분명 {NICKNAME} {F#누나}{M#형아}랑 페이몬도 제전을 즐길 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270319
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270319,
					"content": "먼저 가! 난 나무 아래에 좀 더 있을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270320
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270320,
					"content": "괜찮겠어? 밖에는 마물이 있을지도 모르는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270321
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722270321,
					"content": "난 괜찮아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "류"
				},
				{
					"id": 722270308,
					"content": "캐서린 씨가 고난도 의뢰라 할 만하네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				}
			]
		},
