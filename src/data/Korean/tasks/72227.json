			},
			"dialogs": [
				{
					"id": 722270101,
					"content": "#{NICKNAME} {F#누나}{M#형아} 싸우는 모습, 진짜 멋있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270102
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270102,
					"content": "류도 여기 있었구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270103,
						722270104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722270103,
					"content": "괜찮아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				},
				{
					"id": 722270105,
					"content": "난 괜찮아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270106
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270106,
					"content": "그 마물들은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270108
					]
				},
				{
					"id": 722270108,
					"content": "이 괴물들이 어디서 온 건지 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270109
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270109,
					"content": "그러게, 이곳 생물 같지는 않아 보이는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722270110,
					"content": "응, 전에 이런 건 없었어. 몸에 털이 아주 많은 사람이랑 커다란 로봇도 없었구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270111
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270111,
					"content": "전에 「엔카무이」라는 동물이 있었는데, 이 동물은 엄청 온순하고 맛있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270112
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270112,
					"content": "들어본 적 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270113
					]
				},
				{
					"id": 722270113,
					"content": "그럴 수밖에. 언젠가부터 엔카무이들이 모두 사라지더니, 저 녀석들이 여기에 나타났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270114
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270114,
					"content": "「안개바다」 밖에서 넘어온 걸까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270115
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270115,
					"content": "밖에도 츄츄족 같은 마물이 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270116
					]
				},
				{
					"id": 722270116,
					"content": "위험할 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270117,
						722270119
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270117,
					"content": "확실히 위험해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270118
					]
				},
				{
					"id": 722270118,
					"content": "하지만, 모험하며 겪었던 일은 엄청 재미있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722270120,
					"content": "나도 모험하고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270121
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270121,
					"content": "그럼 류는 커서, 위대한 모험가가 되는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722270122,
					"content": "응!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270123
					],
					"speakerTitle": "류"
				},
				{
					"id": 722270123,
					"content": "그럼 이쪽 서목도 우리한테 맡겨. 마물이 있어서 류가 함부로 돌아다니면 위험해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722270124,
					"content": "우리한테 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722270119,
					"content": "하지만, 모험은 재미있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270120
					]
				},
				{
					"id": 722270104,
					"content": "다친 곳은 없어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				}
			]
		},
