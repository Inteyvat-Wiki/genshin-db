			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"호세이니"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700290101,
					"content": "어떻게 됐어? 「푸르시나 볼트」가 도움이 좀 됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290102,
						700290103
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290102,
					"content": "많은 도움이 됐어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290104
					]
				},
				{
					"id": 700290104,
					"content": "좋아, 좋아. 지금까지 했던 일이 헛되지 않았네. 이번 의뢰도 이제 끝이 보이는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290105
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290105,
					"content": "다만 이번에 상대했던 특이 기체의 설계는 야외에서 자주 보이는 유적 가디언, 유적 헌터랑 조금 다른 거 같아. 전체적인 설계를 봤을 때 훨씬 더 뛰어나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290106
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290106,
					"content": "하지만 이런 자율 기관은 흔히 볼 수 있는 게 아니야. 아마 일종의 실험 모델인 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290107
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290107,
					"content": "최초 설계자는 도대체 어떤 목적으로 이걸 만든 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290108
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290108,
					"content": "그렇다는 건… 고대 문명 자율 기관의 수준이 지금 학계가 예상하는 수준을 훨씬 웃돈다는 건가? 흥미롭군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290109
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290109,
					"content": "내부 구조를 확인하게 되면, 학계를 뒤흔들 발견을 할 수 있을지도 모르겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290110
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290110,
					"content": "괜찮다면, 특이 기체의 잔해를 보러 같이 가줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290111
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290111,
					"content": "거긴 이제 아무것도 없어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290112
					]
				},
				{
					"id": 700290112,
					"content": "뭐? 설마 기체를 모두 부숴버린 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290113
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290113,
					"content": "오! 신이시여… 이건 정말 낭비! 아니, 이건 엄청난 실수라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290114
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290114,
					"content": "휴, 미리 말하지 않은 내 잘못이지 뭐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290115
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290115,
					"content": "아쉽군, 아쉬워. 이건 고대 문명 기술사 영역에서의 중대한 발견인데, 이렇게 흔적도 없이 사라지다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290116,
						700290119
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290116,
					"content": "죄송해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290117
					]
				},
				{
					"id": 700290117,
					"content": "아니야, 넌 학술 의미를 잘 몰랐으니 어쩔 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290118
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290118,
					"content": "의미를 알고 있으면서도 안 알려준 내 잘못이야, 넌 책임이 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290121
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290121,
					"content": "이번 출장 연구는 정말 순탄치 않은 거 같아. 이도에 장기간 체류도 안 되고, 학술적인 발견도 이렇게 놓쳐버리고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290122
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290122,
					"content": "…아니야, 됐어. 긍정적으로 생각하자. 「푸르시나 볼트」의 기능은 성공적으로 확인했으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290123
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290123,
					"content": "이렇게 정교한 장치를 만드신 푸르시나 선배님과 아에샤 선배님은 정말 대단해. 그분들의 발명품, 아니 위대한 작품은 창고에 박혀있기엔 너무 아까워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290124
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290124,
					"content": "이번 이나즈마 답사가 진행이 안 된다면 과제의 방향을 「푸르시나 볼트」로 바꿔야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290125
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290125,
					"content": "만약 「푸르시나 볼트」 과제가 「아카데미아」의 이목을 끌어서 연구 보고서가 발표만 되면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290126
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290126,
					"content": "하하, 감사의 인사말에 너의 이름을 꼭 넣어주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290127
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290127,
					"content": "그 보고서를 제가 이해할 수 있었으면 좋겠네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290128
					]
				},
				{
					"id": 700290128,
					"content": "하하, 그건 그때 가서 생각하자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290129
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290129,
					"content": "함께해서 정말 즐거웠어. 즐거운 여행 되길 바랄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290119,
					"content": "만약 좀 일찍 알려주셨더라면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290120
					]
				},
				{
					"id": 700290120,
					"content": "이런 일을 예상하지 못한 내 잘못이야. 이미 엎질러진 물이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700290121
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 700290103,
					"content": "이제 모든 문제가 해결됐어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700290104
					]
				}
			]
		}
	]
}