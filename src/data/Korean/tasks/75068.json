			"dialogs": [
				{
					"id": 750680401,
					"content": "아직도 있었구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680402
					],
					"speakerTitle": "퀘닌"
				},
				{
					"id": 750680402,
					"content": "예전에 어떤 학자가 이 잿더미성의 폭군한테… 심연의 침식을 막을 방법이 있다고 했어. 그래서 우리는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680403
					],
					"speakerTitle": "퀘닌"
				},
				{
					"id": 750680403,
					"content": "하지만 여긴 정말 불길한 곳이야. 나도 요즘 이상해지는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680404
					],
					"speakerTitle": "퀘닌"
				},
				{
					"id": 750680404,
					"content": "가끔은 어제까지만 해도 멀쩡했던 길이 깨어나면 폐허가 되기도 하고… 원래는 멀쩡했던 저 건물들도 폐허로 바뀌기도 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680405
					],
					"speakerTitle": "퀘닌"
				},
				{
					"id": 750680405,
					"content": "그리고 가끔은 다시는 나타날 수 없는 친구들이 다시 나타나기도 했어… 아마도 마물이 친구로 위장한 거겠지만 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680406
					],
					"speakerTitle": "퀘닌"
				},
				{
					"id": 750680406,
					"content": "그나저나 내가… 왜 여기서 마물들을 처치해야 하는 거지… 어째서?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680407
					],
					"speakerTitle": "퀘닌"
				},
				{
					"id": 750680407,
					"content": "아무튼 여긴 이상한 곳이니까, 너희도… 빨리 떠나는 게 좋을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "퀘닌"
				}
			]
