			"dialogs": [
				{
					"id": 750680301,
					"content": "왜 아직도 여기 있는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680302
					],
					"speakerTitle": "퀘닌"
				},
				{
					"id": 750680302,
					"content": "모험단의 대장이자 매깃 가면을 쓴 영웅조차도 이미…. 우리는 더 이상 막을 수 없단 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680303
					],
					"speakerTitle": "퀘닌"
				},
				{
					"id": 750680303,
					"content": "어서 가. 여긴 저주받은 땅이야. 용사여, 이곳은 사람이 발을 들일 수 있는 곳이 아니라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "퀘닌"
				}
			]
		},
