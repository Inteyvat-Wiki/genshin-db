						413430502
					],
					"speakerTitle": "게리"
				},
				{
					"id": 413430502,
					"content": "가족들은 어떻게 지내고 있으려나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430503
					],
					"speakerTitle": "프레키"
				},
				{
					"id": 413430503,
					"content": "음, 마침 딱 좋은 기회네… 누나, 누난 소원이 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430504
					],
					"speakerTitle": "게리"
				},
				{
					"id": 413430504,
					"content": "나? 생각 좀 해 볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430505
					],
					"speakerTitle": "프레키"
				},
				{
					"id": 413430505,
					"content": "이렇게 하면 되겠지? 여행자, 또 하나 부탁할 게 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430506
					],
					"speakerTitle": "프레키"
				},
				{
					"id": 413430506,
					"content": "민들레 씨앗은 높은 곳에서 뿌려야 하는데, 리월의 건축물은 몬드랑 달라서 높은 곳으로 어떻게 가야 할지 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430507
					],
					"speakerTitle": "프레키"
				},
				{
					"id": 413430507,
					"content": "우릴 도와 높은 곳에서 민들레 씨앗 좀 뿌려줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430508
					],
					"speakerTitle": "프레키"
				},
				{
					"id": 413430508,
					"content": "맡겨주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430509
					]
				},
				{
					"id": 413430509,
