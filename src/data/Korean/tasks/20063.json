				"points": []
			},
			"dialogs": [
				{
					"id": 200630801,
					"content": "「…그 거친 방패는 마치 내가 저항할 수 없는 악몽과도 같았지. 내가 어떻게 공격해도 그 방패는 끄떡도 없었으니까, 게다가 그 방패 뒤의 몬스터가 날 경멸하듯이 바라보며 내 무력함을 조롱하는듯한 '이야'하는 웃음소리를 냈지…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630802
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200630802,
					"content": "사이러스 씨가 이렇게 말했을 거야…. 내가 정확히 기억하고 있다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630803
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200630803,
					"content": "게다가 그 몬스터를 처치할 수 있었던 관건은 교묘한 방법을 사용해 그 방패를 먼저 파괴한 거라고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630804
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200630804,
					"content": "그게 아니면 아무리 검을 휘둘러도 방패를 든 몬스터에게 생채기 조차 낼 수 없다고 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630805
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200630805,
					"content": "그리고 그 몬스터는 계속 기회를 노리다가 방심한 틈을 타 바로 공격을 한다고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630806
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200630806,
					"content": "그런 몬스터를 처치할 수 있다니…. 사이러스 씨는 정말로 위대한 모험가야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630807
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200630807,
					"content": "안타깝지만 난 그럴 기회가 없겠지..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "잭"
				}
