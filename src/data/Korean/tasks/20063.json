					"잭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630101,
					"content": "아, 직접 한번 보고 싶다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630102
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200630102,
					"content": "뭘?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630103
					]
				},
				{
					"id": 200630103,
					"content": "아이고, 깜짝이야! 언제 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630104
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200630104,
					"content": "실은 어제 스탠리 씨가 술을 마시면서 그가 <color=#00E1FFFF>타타우파 협곡</color>에서 겪었던 모험에 대해 얘기해줬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630105
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200630105,
					"content": "스탠리 씨는 \"…그 몬스터가 맹렬히 불타며 형태 없는 거대한 신체가 천천히 꿈틀 됐지. 내가 어떻게 공격하고 어떻게 포효해도 날 완전히 무시하듯이 무섭기 그지없는 거대한 눈동자만 움직였을 뿐이야…\"라고 말했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630106
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200630106,
					"content": "비록 직접 본건 아니지만, 스탠리 씨도 고전했을 정도였다니 분명 아주 위대한 모험이었을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630107
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200630107,
					"content": "스탠리 씨도 고전하게 만든 몬스터를 직접 한번 보고 싶어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630108
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200630108,
					"content": "하지만 내 실력으론 십중팔구 도망치기 바쁘겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630109
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200630109,
					"content": "만약 관심 있으면…나 대신 그 몬스터 좀 찾아줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630110,
						200630112
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200630110,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630111
					]
				},
				{
					"id": 200630111,
					"content": "그럼 너만 믿는다! 부탁할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "잭"
				},
				{
					"id": 200630112,
					"content": "내가 같이 가줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630113
					]
				},
				{
					"id": 200630113,
					"content": "사실 나도 같이 가고 싶어. 근데 해야 되는 잡다한 일이 많아서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630114
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200630114,
					"content": "무슨 일? 몬드성 안의 모험가 길드를 보면 모험으로도 수입은 충분한 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630115
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200630115,
					"content": "시민들을 도와야 하거든. 예를 들면 고양이를 찾아준다거나 잡초를 뽑아준다거나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630116
					],
					"speakerTitle": "잭"
				},
				{
					"id": 200630116,
					"content": "이 위대한 모험은 너한테 맡길게. 찾는다면 꼭 돌아와서 알려줘야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "잭"
				}
			]
		},
		{
			"id": 2006302,
			"completionStepIds": [
				2006301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
