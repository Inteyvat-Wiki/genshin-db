			"trigger": {
				"objectNames": [
					"엄숙한 표정의 까마귀",
					"매서운 눈빛의 까마귀",
					"모나",
					"카에데하라 카즈하"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720201,
					"content": "거기서, 누구냐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720202
					],
					"speakerTitle": "엄숙한 표정의 까마귀"
				},
				{
					"id": 400720202,
					"content": "모습을 보아하니 유야 정토의 주민은 아닌 것 같은데? 말해! 이곳엔 무슨 일이냐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720203
					],
					"speakerTitle": "매서운 눈빛의 까마귀"
				},
				{
					"id": 400720203,
					"content": "경비병이 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400720204,
					"content": "당황하지 마",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720205
					]
				},
				{
					"id": 400720205,
					"content": "어? 지금 뭐 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400720206,
					"content": "우리는 황녀님의 가신들입니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720207
					]
				},
				{
					"id": 400720207,
					"content": "별바다를 건너온 자이죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720208
					]
				},
				{
					"id": 400720208,
					"content": "그걸 어떻게 증명하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720209
					],
					"speakerTitle": "엄숙한 표정의 까마귀"
				},
				{
					"id": 400720209,
					"content": "흥, 그렇게 어리석은 질문을 하다니, 정말 보는 눈이 없구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720210
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400720210,
					"content": "「나의 백성들에게 자유를 주고, 오래된 법칙에 얽매이지 말게 하라」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720211
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400720211,
					"content": "이, 이건 유야 정토의 암호! 정말 황녀님의 가신이었다니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720212
					],
					"speakerTitle": "매서운 눈빛의 까마귀"
				},
				{
					"id": 400720212,
					"content": "이, 이럴 수가, 제가 결례를 범했군요! 부디 용서해 주십시오…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720213
					],
					"speakerTitle": "엄숙한 표정의 까마귀"
				},
				{
					"id": 400720213,
					"content": "알았으면 물러나지 않고 뭐 해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400720214,
					"content": "네네, 전 이만 물러나겠습니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720215
					],
					"speakerTitle": "엄숙한 표정의 까마귀"
				},
				{
					"id": 400720215,
					"content": "정말 떠났네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720216
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400720216,
					"content": "이게 바로 《신성 왕국의 영창》 제2권이야, 다들 준비됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720217
					],
					"speakerTitle": "카에데하라 카즈하"
				},
				{
					"id": 400720217,
					"content": "출발!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
