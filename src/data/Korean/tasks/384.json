					"nextDialogs": [
						3840205
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3840205,
					"content": "응. 결과가 어떻게 되든 최소한 희망은 봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840206
					],
					"speakerTitle": "진"
				},
				{
					"id": 3840206,
					"content": "그동안 몬드성은 너무 많은 걸 짊어졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840207
					],
					"speakerTitle": "진"
				},
				{
					"id": 3840207,
					"content": "하지만 문제를 해결한 건 결국 여행자와 시인이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840208
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 3840208,
					"content": "흥. 기사단도 아주 조금 도움이 되긴 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840209
					],
					"speakerTitle": "다이루크"
				},
				{
					"id": 3840209,
					"content": "OK,OK, 알았으니까. 모두들 뒤로 좀 물러서줘——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840210
					],
					"speakerTitle": "벤티"
				},
				{
					"id": 3840210,
					"content": "세상에서 가장 뛰어난 음유시인인 내가 지금부터 하프를 연주할 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "벤티"
