				"points": []
			},
			"dialogs": [
				{
					"id": 710500401,
					"content": "이 버섯에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500402
					]
				},
				{
					"id": 710500402,
					"content": "역시 경험이 풍부한 모험가답네. 이렇게 빨리 뭔갈 찾아내다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500403
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500403,
					"content": "응? 여기서 채집한 균류가 확실해? 좀 이상한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500404
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500404,
					"content": "지하에는 버섯이 자랄 수 없는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500405
					]
				},
				{
					"id": 710500405,
					"content": "아니, 그런 문제가 아냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500406
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500406,
					"content": "이 균은 수메르에 서식하는 어떤 균류와 매우 흡사해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500407
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500407,
					"content": "이 정도로는 부족한데…. 샘플을 충분히 확보한다면 뭔가 발견할 수 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500408
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500408,
					"content": "충분한 샘플이라…. 버섯은 네가 가져온 거니까 버섯이 어디 있는지도 분명히 알고 있겠지…. 버섯을 좀 더 구해다줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500409
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500409,
					"content": "버섯을 충분히 채집해 오면, 나도 충분한 모라를 보수로 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500410
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500410,
					"content": "버섯 몇 개 정도가 충분히에요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500411
					]
				},
				{
					"id": 710500411,
					"content": "음… 어디 보자, 일단 8개만 채집해 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500412
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500412,
					"content": "괜찮아, 버섯만 가져온다면 모라는 두둑이 챙겨줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "헤디브"
				}
			]
		},
		{
