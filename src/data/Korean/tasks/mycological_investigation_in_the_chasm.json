				"points": []
			},
			"dialogs": [
				{
					"id": 710500701,
					"content": "버섯 채집해 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500702
					]
				},
				{
					"id": 710500702,
					"content": "응, 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500703
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500703,
					"content": "네 도움이 있다면 내 조사는… 리월 속담에 있는 그, 「호랑이에 날개 달린 격」처럼 순조로울 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500704
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500704,
					"content": "호랑이에 날개 달린 격이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500705
					]
				},
				{
					"id": 710500705,
					"content": "맞아, 그야말로 호랑이에 날개 달린 격이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500706
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500706,
					"content": "이 균류는, 대체 어떻게 된 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500707
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500707,
					"content": "정말 이상하네, 이 균류는 수메르에 있는 균류와 완전히 똑같아. 하지만 어떻게 빛을 내는 거지? 어두운 곳에서 자라서 형광소를 함유한 균류로 진화한 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500708
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500708,
					"content": "하지만 형광소를 함유한 균류로 진화했다면, 왜 균류의 본체에는 아무런 변화도 없는 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500709,
						710500710
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500709,
					"content": "무슨 말인지 전혀 모르겠어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				},
				{
					"id": 710500711,
					"content": "음… 쉽게 말해, 균류는 환경에 따라 진화 하는 게 정상인데, 이 균의 본체는 숲 환경에서 살기 더욱 적합한 품종이라는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500712
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500712,
					"content": "그러니까 이 진균은 수메르에서 서식하던 균류야, 이 점은 확실해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500713
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500713,
					"content": "그럼 빛을 내는 건…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500714
					]
				},
				{
					"id": 710500714,
					"content": "이 진균은 층암거연 토착 생물이 아냐. 즉, 빛을 내는 건, 진화의 산물이 아닌 비정상적인 생태 환경으로 인한 결과물이라는 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500715
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500715,
					"content": "아마 하늘에서 떨어진 그 조각때문이겠지. 그 에너지를 흡수하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500716,
						710500717
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500716,
					"content": "조각이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500718,
					"content": "콜록…. 응? 방금 조각이라고? 아, 내 말은, 진균의 조각이 하늘에 떠다닐 때…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500719
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500719,
					"content": "우발적인 변이가 일어났을 거란 얘기였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500720
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500720,
					"content": "분명 그럴 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500721
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500721,
					"content": "음, 진균을 채집해 줘서 정말 고마워. 수고했어, 일단 푹 쉬어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500722
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500722,
					"content": "난 이 진균들을 조금 더 연구할 생각이야. 옆에 누가 있으면 방해돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710500717,
					"content": "무슨 조각이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500710,
					"content": "무슨 문제라도 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				}
			]
		}
	]
}