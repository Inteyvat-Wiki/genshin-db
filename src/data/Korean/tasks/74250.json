					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 742500204,
					"content": "네, 조심히 가세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리니"
				},
				{
