					"nextDialogs": [
						4541111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4541111,
					"content": "그건 나중에 얘기해, 단서를 또 발견한 것 같아. 날 따라와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541112
					],
					"speakerTitle": "레이저"
				},
