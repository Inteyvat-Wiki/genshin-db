			"dialogs": [
				{
					"id": 4540101,
					"content": "누구야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540102
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4540102,
					"content": "긴장할 필요 없어, 레이저, 우리야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4540103,
					"content": "넌… 너도 기사단이야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540104
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4540104,
					"content": "뭐, 둘이 진짜로 모르는 사이였어?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540105,
						4540106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4540105,
					"content": "「붉은색의 뜨거운 소녀」——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				},
				{
					"id": 4540107,
					"content": "몰라. 빨갛긴 한데, 그 애처럼 뜨겁진 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540108
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4540108,
					"content": "아, 알겠다. 저번에 말한 늑대 소년이 얘구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540109
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4540109,
					"content": "맞아. 레이저라고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4540110,
					"content": "나 좀 도와줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540111
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4540111,
					"content": "응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540112
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4540112,
					"content": "설명할 시간 없어. 루피카들에게 흩어지라고 했어. 나쁜 사람들이 오고 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540113
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4540113,
					"content": "방금 그 녀석들을 말하는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4540114,
					"content": "알겠어. 하지만 그 전에 네게 물어볼 게 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540115
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4540115,
					"content": "피 냄새가 나. 서둘러야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540116
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4540116,
					"content": "설마 그 멍청이들이 늑대한테 당한 건 아니겠지?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				},
				{
					"id": 4540106,
					"content": "엠버가 아니었어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540107
					]
				}
			]
		},
