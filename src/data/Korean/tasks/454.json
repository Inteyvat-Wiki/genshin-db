					"id": 4541108,
					"content": "그…가 누구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541109
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4541109,
					"content": "이 땅의 주인",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541110
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4541110,
					"content": "몬드의 주인은 바르바토스 아냐?",
