			"dialogs": [
				{
					"id": 4540601,
					"content": "제발 노여움을… 풀어줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540602
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4540602,
					"content": "흥, 됐다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540603
					],
					"speakerTitle": "보레아스"
				},
				{
					"id": 4540603,
					"content": "전에 이 녀석이 말했듯, 밖에서 온 늑대 무리가 이곳의 규칙을 어겼다. 놈들은 반드시 제재를 받게 될 것이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540604
					],
					"speakerTitle": "보레아스"
				},
				{
					"id": 4540604,
					"content": "하지만, 레이저. 넌 싸움에 끼면 안 돼. 이건 늑대들의 문제야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540605
					],
					"speakerTitle": "보레아스"
				},
				{
					"id": 4540605,
					"content": "넌 발톱과 이빨이 아닌 강철과 천둥·번개를 쓰잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540606
					],
					"speakerTitle": "보레아스"
				},
				{
					"id": 4540606,
					"content": "넌 인간이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540607
					],
					"speakerTitle": "보레아스"
				},
				{
					"id": 4540607,
					"content": "난 저들과 달라! 난 인간이 아니라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540608
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4540608,
					"content": "넌… 늑대가 아니야. 이건 늑대들의 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540609
					],
					"speakerTitle": "보레아스"
				},
				{
					"id": 4540609,
					"content": "하지만 넌, 레이저가 인간 중에서 사귄 루피카. 넌 고상하고 특별한 사람인 것 같구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540610
					],
					"speakerTitle": "보레아스"
				},
				{
					"id": 4540610,
					"content": "강해지고 싶다면 언제든 내게 와서 시련을 청하거라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540611
					],
					"speakerTitle": "보레아스"
				},
				{
					"id": 4540611,
					"content": "할 말은 여기까지다. 인연이 있으면 또 보지. 레이저와 낯선 인간…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540612
					],
					"speakerTitle": "보레아스"
				},
				{
					"id": 4540612,
					"content": "으음… 레이저, 그런 표정 짓지 마. 맞다! 성에 가서 며칠 머물래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540613
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4540613,
					"content": "맞아. 너 몬드성에 친구도 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540614
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4540614,
					"content": "그 「붉은색의 뜨거운 소녀」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540615
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4540615,
					"content": "지금 너한텐 야외의 행인들도 위험해. 난 네가 그들을 해치고 싶어 하지 않는다는 걸 알아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540616
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4540616,
					"content": "난 괜찮으니까 걱정 마. 난 도시에 속하지 않아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540617
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4540617,
					"content": "여기에도 속하지 않지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540618,
						4540619
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4540618,
					"content": "레이저…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540621
					]
				},
				{
					"id": 4540621,
					"content": "#고마워. {NICKNAME}, 페이몬, 그리고… 또 다른 붉은색 소녀",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540622
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4540622,
					"content": "나랑 이야기를 그렇게 많이 했는데 내 이름을 모른다고——?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540623
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4540623,
					"content": "그럼, 안녕",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "레이저"
				},
				{
					"id": 4540619,
					"content": "너무 상심하지 마…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540621
					]
				}
