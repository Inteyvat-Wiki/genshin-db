			"dialogs": [
				{
					"id": 4540301,
					"content": "우리 왔어! 이 정도면 충분하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4540302,
					"content": "충분해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540303
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4540303,
					"content": "방금 그와 이야기를 나눠봤는데, 늑대 세계의 규칙은 정말 상상 이상이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540304
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4540304,
					"content": "다들 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540305
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4540305,
					"content": "쭉 둘러봤는데 다른 늑대는 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540307
					],
					"speakerTitle": "신통한 홉킨스"
				},
				{
					"id": 4540307,
					"content": "늑대는 보통 그렇지. 방금 잡은 놈은 좀 멍청한가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540308
					],
					"speakerTitle": "요툰"
				},
				{
					"id": 4540308,
					"content": "뭐, 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540309
					],
					"speakerTitle": "신통한 홉킨스"
				},
				{
					"id": 4540309,
					"content": "결판을 내자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540310
					],
					"speakerTitle": "레이저"
				},
				{
					"id": 4540310,
					"content": "늑대에 의해 길러졌다는 자가 바로 저 사람이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540311
					],
					"speakerTitle": "요툰"
				},
				{
					"id": 4540311,
					"content": "호오?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540312
					],
					"speakerTitle": "신통한 홉킨스"
				},
				{
					"id": 4540312,
					"content": "너였구나. 늑대가 어떻게 이렇게 똑똑해졌나 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540313
					],
					"speakerTitle": "신통한 홉킨스"
				},
				{
					"id": 4540313,
					"content": "네가 짐승 편에 서서 인간을 골탕 먹이던 놈이구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540314
					],
					"speakerTitle": "신통한 홉킨스"
				},
				{
					"id": 4540314,
					"content": "먹을 것만 주면 다 부모인가? 네가 뭐였는지 기억도 안 나는 거냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540315
					],
					"speakerTitle": "신통한 홉킨스"
				},
				{
					"id": 4540315,
					"content": "그만하세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540316
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4540316,
					"content": "너희들 지금 레이저가 말을 잘 못한다고 괴롭히는 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4540317,
					"content": "응?! 기사단이 지금 저놈 편드는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540318
					],
					"speakerTitle": "요툰"
				},
				{
					"id": 4540318,
					"content": "마을을 공격한 건, 우리가 아니야——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "레이저"
				}
			]
