					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 4541106,
					"content": "그렇다면 이상하네. 늑대가 언어를 사용할 줄 안다는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541107
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 4541107,
					"content": "그가 정한 이름이야",
