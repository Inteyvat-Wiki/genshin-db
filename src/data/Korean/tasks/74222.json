			},
			"dialogs": [
				{
					"id": 742220701,
					"content": "혹시 뭐 좀 찾았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220702,
						742220703
					],
					"speakerTitle": "지오바니"
				},
				{
					"id": 742220702,
					"content": "이걸 찾았어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742220703,
					"content": "별일 아니에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220704
					]
				},
				{
					"id": 742220704,
					"content": "조심하고 무슨 일 생기면 언제든지 나한테 보고해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "지오바니"
				}
			]
		},
		{
			"id": 7422208,
			"completionStepIds": [
				7422208,
				7422209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422208",
							"2"
						],
						"stepId": 7422208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"지오바니"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220801,
					"content": "이건… 야만족이 소식을 전달할 때 쓰는 신호봉이 틀림 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220802,
						742220803
					],
					"speakerTitle": "지오바니"
				},
				{
					"id": 742220802,
					"content": "정말인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				},
				{
					"id": 742220804,
					"content": "이런, 정말 야만족의 첩자가 잠입했을 줄이야. 메티우스 대장님의 걱정이 진짜였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220805
					],
					"speakerTitle": "지오바니"
				},
				{
					"id": 742220805,
					"content": "이걸 보고하면 나도 내 소임을 다했다고 할 수 있겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220806
					],
					"speakerTitle": "지오바니"
				},
				{
					"id": 742220806,
					"content": "어쨌든 고마워! 네 도움이 아니었다면 야만족의 대군이 도착하기 전에 내부부터 무너졌을지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220807
					],
					"speakerTitle": "지오바니"
				},
				{
					"id": 742220807,
					"content": "메티우스 대장님께 올리는 보고에 네 공로를 반드시 잘 기록해 둘게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "지오바니"
				},
				{
					"id": 742220803,
					"content": "아까는 목검이라고 하셨잖아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				}
			]
		}
	]
}