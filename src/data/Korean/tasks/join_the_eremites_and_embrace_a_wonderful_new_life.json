	"talks": [
		{
			"id": 7326701,
			"completionStepIds": [
				7326701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
