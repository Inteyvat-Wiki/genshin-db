			"dialogs": [
				{
					"id": 750390101,
					"content": "안녕, 어둠, 내 오랜 친구여…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390102
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390102,
					"content": "와… 말투가… 어른 같은 꼬마잖아. 진짜 이상해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750390103,
					"content": "응? 잠깐만, 이 사람은 「대단한 마니피코」잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390104,
						750390107,
						750390110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750390104,
					"content": "마니… 뭐가 많이?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390105
					]
				},
				{
					"id": 750390105,
					"content": "마… 마니피코, 대단한 마니피코!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390106
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390106,
					"content": "윽… 지금 내 모습이 좀 추한 건 사실이지만, 물 좀 줘서 살려줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390119
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390119,
					"content": "물… 물 좀 줘…. 고마워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390120
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390120,
					"content": "와… 또 죽어가는 모습으로 돌아왔어… 어서 구해주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750390107,
					"content": "전혀 「대단하다」는 느낌이 안 드는데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390108
					]
				},
				{
					"id": 750390108,
					"content": "어포처럼 바짝 말랐네, 가여워라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750390109,
					"content": "이봐, 너희는 인간으로서의 공감 능력도 없는 거냐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390119
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390110,
					"content": "안녕하세요, 전 어둠이에요. 당신의 오랜 친구죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390111
					]
				},
				{
					"id": 750390111,
					"content": "엥…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750390112,
					"content": "하하! 맞아, 바로 그 노래야! 나도 좋아해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390113
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390113,
					"content": "아… 사이멍과 가펑쿨 형제의 노래는 아무리 들어도 질리지 않지… 내 저번 직장은 그 형제 때문에 잃은 거야. 그래서 여기에서 이런 위험을 겪고 있는 거고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390114
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390114,
					"content": "윽… 그 이야기는 나중에 하고 지금 중요한 건… 헤헤, 나한테 물 좀 줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390115
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390115,
					"content": "그, 헤헤… 그러니까, 허허. 목이 말라 죽겠어, 헤헤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390116
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390116,
					"content": "죽을 거 같다면서 왜 웃는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750390117,
					"content": "죽을 때가 돼서 주마등이 보이나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390118
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390118,
					"content": "아… 앗?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390119
					],
					"speakerTitle": "페이몬"
				}
			]
		},
