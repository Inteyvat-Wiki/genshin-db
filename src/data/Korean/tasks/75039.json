			"dialogs": [
				{
					"id": 750390201,
					"content": "안녕, 어둠, 내 오랜 친구여…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390202
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390202,
					"content": "와… 말투가… 어른 같은 꼬마잖아. 진짜 이상해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750390203,
					"content": "이봐, 부모님에게 나처럼 작은 어른도 존중하라고 안 배웠어? 작은 사람도 큰일을 해낼 수 있다는 걸 명심하라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390204
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390204,
					"content": "실제로 나처럼 작은 사람들이 수없이 많은 큰일을 이루어냈지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390205
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390205,
					"content": "자세히 보니까 수염까지 났잖아! 윽… 왠지 좀 거북한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750390206,
					"content": "아무리 그래도 수염으로 놀리는 건 아니지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390207,
						750390220
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390207,
					"content": "안녕하세요, 전 어둠이에요. 당신의 오랜 친구죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390208
					]
				},
				{
					"id": 750390208,
					"content": "음… 그런 식으로 장단 맞춰주지 않아도 돼. 난… 곧 죽게 될 거거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390209,
						750390214
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390209,
					"content": "그렇군요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390210
					]
				},
				{
					"id": 750390210,
					"content": "어포처럼 바짝 말랐네…. 가여워라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750390211,
					"content": "흑흑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390212,
					"content": "이봐, 너희는 인간으로서 공감 능력도 없는 거냐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390213
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390213,
					"content": "물 좀 줘! 목말라 죽겠다고! 딱 보면 모르겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390214,
					"content": "뭐가 필요한가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390215
					]
				},
				{
					"id": 750390215,
					"content": "아, 살았다…. 여기에 사흘이나 갇혀 있었는데, 드디어 사람의 목소리를 듣게 됐어…!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390216
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390216,
					"content": "9번 세트 2개 중 하나는 곱빼기로 부탁할게. 또 소스를 추가한 6번 세트와 7번 세트도 1개씩 가져다줘. 45번 세트 2개 중 하나는 치즈랑 폰타 라지 사이즈를 추가해 주고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390217
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390217,
					"content": "알겠어. 더 필요한 건 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750390218,
					"content": "음, 웅?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390219,
					"content": "더 필요한 게 없냐고?! 물 좀 줘! 목말라 죽겠다고! 딱 보면 모르겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390220,
					"content": "기운 내세요. 우리가 어떻게 도와드릴까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390221
					]
				},
				{
					"id": 750390221,
					"content": "물… 물 좀 줘…. 고마워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마니피코"
				}
			]
		},
