			"dialogs": [
				{
					"id": 750390401,
					"content": "우… 웅? 꺄, 꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390402
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390402,
					"content": "<color=#00E1FFFF>물… 물 좀 줘…</color> 고마워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390403
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750390403,
					"content": "빨리 쓰러져 있는 이 녀석을 살펴보자! 상태가 무지 안 좋아 보여!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7503917,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"마니피코"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750391701,
					"content": "목마른 행인을 도와줬다. 바짝 마른 행인은 물에 젖자 몸집이 불어났다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750391702
					]
				},
				{
					"id": 750391702,
					"content": "후아… 콜록, 콜록! 고맙긴 한데… 콜록… 구조 방식이 너무 거칠잖아… 난 수영할 줄 모른단 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391703
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391703,
					"content": "걱정 마, 그럼 우리가 어떻게든 방법을 찾아서 널 건져낼 테니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391704
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750391704,
					"content": "문제가 터지고 방법을 찾는 일은 없었으면 해…. 어쨌든 구해줘서 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391705
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391705,
					"content": "내 이름은 마니피코·드·라·마그니피칸스야. 편하게 마니피코라고 불러줘. 보다시피 난 폰타인 귀족 출신이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391706
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391706,
					"content": "내 친구들은 날 「형사」나 「브루투스」 또는 「자석 씨」라고 부르지만… 너희는 아무렇게나 불러도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391707
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391707,
					"content": "와… 정말 이상한 녀석이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391708
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750391708,
					"content": "웅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391709,
						750391714,
						750391725
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391709,
					"content": "「형사」요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750391710
					]
				},
				{
					"id": 750391710,
					"content": "난 그림자 수사청에서 몇 년간 형사로 일하면서 프랭크·드레빈 경감을 따라 큰 사건을 몇 건 처리했어. 나중에 그는 경정으로 승진했고, 난 퇴직했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391711
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391711,
					"content": "정말 잊지 못할 추억이었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391712
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391712,
					"content": "후… 소년이 소녀를 만났고 소년은 소녀를 잃었는데 소녀는 소년을 찾았으나 소년은 소녀를 잊었으며 소년이 소녀를 떠올렸을 때 소녀는 폰티날리아 축제의 꽃마차에 세 번이나 깔렸지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391713
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391713,
					"content": "그런 혼란스러운 일은 굳이 추억하지 말라구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391732
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750391732,
					"content": "크흠, 어쨌든 그림자 수사청에서 퇴직한 이후 한동안 무직으로 지내다가 사람과 사물이 가진 고유한 생명력을 담아내는 사진가가 되기로 결심했지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391733
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391733,
					"content": "그래서 나타에 온 거야! 여긴 원소 생명력이 놀랄 만큼 눈부시게 빛나는 나라거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391734
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391734,
					"content": "놀랄 만하긴 하지…. 넌 하마터면 여기서 말라 죽을 뻔했잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391735
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750391735,
					"content": "하하. 미안, 너희가 날 구해준 일은 절대 잊지 않을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391736
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391736,
					"content": "자, 내 목적지를… 네 지도에 표시해 둘게. 음… 여기야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391737
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391737,
					"content": "…아차차, 내가 너무 무례했네! 아직 너희 이름을 안 물어봤잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391738
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391738,
					"content": "#전 {NICKNAME}(이)라고 해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750391739
					]
				},
				{
					"id": 750391739,
					"content": "#얜 {REALNAME[ID(2)|SHOWHOST(true)]}, 난 페이몬이라고 불러줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391740
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750391740,
					"content": "우웅!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391741
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391741,
					"content": "#알겠어. {NICKNAME}, 페이몬. 기억해 둘게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391742
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391742,
					"content": "우? 웅? 힝——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391743
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391743,
					"content": "#하하, 진정해! {REALNAME[ID(2)|SHOWHOST(true)]}, 네 이름도 기억해 둘게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391744
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391744,
					"content": "여정 중에 다시 만날 수 있다면 좋겠네. 다음에 너희에게 또 부탁할 일이 있을지도 모르잖아. 어쩌면 내가 너희를 도울 수도 있고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391745
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391745,
					"content": "와… 정말 멀리 가는구나…. 또 말라비틀어지는 일이 없도록 조심해야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391746
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750391746,
					"content": "하하, 당연하지. 기회가 된다면 또 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391747
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391747,
					"content": "재빠르게 짐과 물을 챙긴 마니피코가 두 사람에게 손은 흔들었다\\n이내 왜소한 그의 모습이 시야에서 사라졌다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750391714,
					"content": "「브루투스」요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750391715
					]
				},
				{
					"id": 750391715,
					"content": "아, 모를 수도 있겠네. 난 그림자 수사청에서 몇 년간 형사로 일했어. 당시 프랭크·드레빈 경감이 내 상사였지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391716
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391716,
					"content": "그때 우린 공원에서 토가 옷을 걸친 다섯 녀석이 백여 명 사람들 앞에서 칼로 한 노인을 습격하는 걸 봤어. 그래서 주먹으로 「퍽, 퍽, 퍽, 퍽, 퍽!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391717
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391717,
					"content": "「하, 요행이 따를 거라고 생각했나? 이 도둑놈들아!」 우리는 그 사람들을 모조리 기절시켰어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391718
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391718,
					"content": "우와……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391719
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750391719,
					"content": "와……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391720
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391720,
					"content": "나중에 경장님한테 들은 건데, 그 사람들은 《레무리아》를 리허설하던 과학원 행정과 사람이었대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391721
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391721,
					"content": "뭐?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391722
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750391722,
					"content": "그래서 내 별명이 「브루투스」인 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391723
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391723,
					"content": "우웅?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391724
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391724,
					"content": "뭐 상관없어. 당시 과학원은 인원 감축 중이었으니 그 사람들도 결국 잘렸을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391732
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391725,
					"content": "「자석 씨」요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750391726
					]
				},
				{
					"id": 750391726,
					"content": "내 인간적인 매력 때문에 붙은 호칭이야. 날 알게 된 사람들은 하나같이 내게 끌리게 되거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391727
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391727,
					"content": "엥……!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391728
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750391728,
					"content": "그리고… 작은 금속 물건, 자잘한 모라, 소소한 장신구 같은 것도 어느새 내 주머니에 끌려오고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391729
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391729,
					"content": "그건 「도벽」이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391730
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 750391730,
					"content": "맞아, 그건 우리 가문의 미덕이기도 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391731
					],
					"speakerTitle": "마니피코"
				},
				{
					"id": 750391731,
					"content": "우웅——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391732
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
		{
