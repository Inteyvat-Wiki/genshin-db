			"dialogs": [
				{
					"id": 414210801,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210802
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210802,
					"content": "그녀가 이상한 말을 했어요. 무슨 말인지 모르겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210803
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210803,
					"content": "얽혀… 있다고, 무슨 말인지 몰라요. 물어봐도 답을 안 해주고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210804
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210804,
					"content": "어휘량이 좀 부족한 모양이네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210805
					]
				},
				{
					"id": 414210805,
					"content": "사람들과 만날 수 없는 이유가 있는 거겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210806
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210806,
					"content": "이해할 수 없어요. 우리 물의 정령은, 융합해 함께 있는 걸 좋아해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210807
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210807,
					"content": "하지만 그녀는 혼자, 외롭게 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210808
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210808,
					"content": "다른 생물은 너희와 융합할 수 없어서 그런 거 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210809
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210809,
					"content": "음, 융합할 수 없나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210810
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210810,
					"content": "당연하지, 익사할 거라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210811
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210811,
					"content": "당신들은 정말 고독하군요. 우린, 모든 걸 사랑해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210812
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210812,
					"content": "아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210813
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210813,
					"content": "왜 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210814
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210814,
					"content": "석문 근처에 로데이아의 스파이가 있어요! 작은 물의 동물들은, 정찰병이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210815
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210815,
					"content": "그러고 보니 그 근처에서 물의 동물을 봤던 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210816,
						414210817
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210816,
					"content": "맞아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				},
				{
					"id": 414210818,
					"content": "강력한 물은 동물의 모습으로 변해요. 위험하지만, 그들과 융합하면 많은 걸 배워요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210819
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210819,
					"content": "날 저기로 데려가 줘요. 로데이아가 불안해해서 물이 써졌어요. 엔도라가 말을 배워서 로데이아한테 잘 말할 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210820
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210820,
					"content": "그러니까, 우릴 도와줄 수 있다고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210821
					]
				},
				{
					"id": 414210821,
					"content": "네, 맞아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210822
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210822,
					"content": "#{NICKNAME}, 어차피 지금은 다른 단서가 없으니까 엔도라를 믿어보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210817,
					"content": "그랬나? 못 봤어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				}
