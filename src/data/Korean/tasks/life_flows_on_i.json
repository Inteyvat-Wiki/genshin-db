			"dialogs": [
				{
					"id": 414210701,
					"content": "…자넨 누군가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210702
					],
					"speakerTitle": "핀치 씨"
				},
				{
					"id": 414210702,
					"content": "으아아, 엔도라! 멋대로 나오면 어떡해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210703
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210703,
					"content": "전 엔도라, 샘물의 요정이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210704
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210704,
					"content": "맞다! 이 할아버지, 샘물 요정의 존재를 믿는 사람이었던 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210705
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210705,
					"content": "…그래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210706
					],
					"speakerTitle": "핀치 씨"
				},
				{
					"id": 414210706,
					"content": "그녀와 똑같이 생겼구나. 훨씬 작지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210707
					],
					"speakerTitle": "핀치 씨"
				},
				{
					"id": 414210707,
					"content": "엔도라는 아직 작아요! 엔도라는 아직 배우고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210708
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210708,
					"content": "네가 이렇게 내 앞에 나타났다는 것만으로도 그때의 만남이 꿈이 아니라는 걸 증명했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210709
					],
					"speakerTitle": "핀치 씨"
				},
				{
					"id": 414210709,
					"content": "그녀는 아직 여기 있지만, 이름은 몰라요. 엔도라한테 안 알려줘요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210710
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210710,
					"content": "엔도라가 얘기해볼게요. 전하고 싶은 말 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210711
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210711,
					"content": "그녀가 아직 있다고? 내 말도 전해줄 수 있고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210712
					],
					"speakerTitle": "핀치 씨"
				},
				{
					"id": 414210712,
					"content": "네, 맞아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210713
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210713,
					"content": "…흠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210714
					],
					"speakerTitle": "핀치 씨"
				},
				{
					"id": 414210714,
					"content": "난 이미 늙었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210715
					],
					"speakerTitle": "핀치 씨"
				},
				{
					"id": 414210715,
					"content": "그녀에게… 안부나 좀 전해주게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "핀치 씨"
				}
			]
