					"코너"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414210201,
					"content": "자네들이 길드에서 보낸 자들인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210202
					],
					"speakerTitle": "코너"
				},
				{
					"id": 414210202,
					"content": "맞아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210203,
					"content": "그럼 안심이군. 그 일은 내가 말하는 것보다 너희가 직접 보는 게 더 빠를 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210204
					],
					"speakerTitle": "코너"
				},
				{
					"id": 414210204,
					"content": "이 물은 최근에 받아둔 건데, 이미 정수 처리를 마쳤으니 안심하고 마셔보게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210205
					],
					"speakerTitle": "코너"
				},
				{
					"id": 414210205,
					"content": "나도! 나도 마셔볼래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210206,
					"content": "(한 입 마셔본다…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210207
					]
				},
				{
					"id": 414210207,
					"content": "으악, 퉤퉤퉤. 너무 써…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210208,
					"content": "이 쓴맛은 일반적인 정수 처리 과정으로 안 없어지는 걸 보면, 성분에 문제 있는 게 아니라 원소의 힘으로 생긴 현상인듯해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210209
					],
					"speakerTitle": "코너"
				},
				{
					"id": 414210209,
					"content": "이런 물로는 술을 만들 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210210
					],
					"speakerTitle": "코너"
				},
				{
					"id": 414210210,
					"content": "그럼 설마 근처에 있는 물고기들도…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210211,
					"content": "그래. 쓴 물 때문에 죽은 물고기들로 요리해봤는데, 그것도 쓰더라니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210212
					],
					"speakerTitle": "코너"
				},
				{
					"id": 414210212,
					"content": "…그 정도라구!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210213,
					"content": "아무튼 대충 이런 상황이야. 어디서부터 시작할지 모르겠다면, 내 직감으로는 북쪽을 조사해야 할 것 같네. 리월의 벽수강과 경책 산장의 물은 괜찮은지 모르겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "코너"
				}
			]
		},
		{
