			},
			"dialogs": [
				{
					"id": 414210101,
					"content": "안녕, 여행자. 잘 지냈어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210102
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 414210102,
					"content": "또 이상한 사건이 생긴 거야, 캐서린?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210103,
					"content": "전에 있었던 사건들에 비하면 별거 아닌데, 몬드의 경제에 큰 영향을 미칠 수 있어서 좀 골치 아파",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210104,
						414210105
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 414210104,
					"content": "무슨 일인데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				},
				{
					"id": 414210106,
					"content": "요새 와이너리 근처 수원지의 물에서 갑자기 쓴맛이 난다고 해. 이렇게 가다간 앞으로 몇 년간 주류업이 심각한 타격을 받게 될지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210107
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 414210107,
					"content": "자세한 건 와이너리의 코너 씨가 알려주실 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐서린"
				},
				{
					"id": 414210105,
					"content": "몬드의 경제?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210106
					]
				}
			]
		},
		{
			"id": 4142102,
			"completionStepIds": [
				4142102
			],
