			},
			"dialogs": [
				{
					"id": 414210601,
					"content": "여기 물은, 달아요. 엔도라와 같은 존재예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210602
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210602,
					"content": "엔도라와 동류는, 물을 맛있게 만들기도 하고, 쓰게 만들기도 해요. 이건 로데이아의 짓이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210603
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210603,
					"content": "그러고 보니 샘물 마을엔 샘물 요정의 전설이 있었지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210604
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210604,
					"content": "일단 샘물에 가서 병에 든 쓴 물부터 버리고 새 물을 채워 넣자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
