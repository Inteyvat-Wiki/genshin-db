			"dialogs": [
				{
					"id": 414210501,
					"content": "으앗, 뭔가 떨어졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210502,
					"content": "엔도라는, 물이 없으면, 죽어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210503
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210503,
					"content": "엔도라가 네 이름이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210504,
					"content": "쓴맛은 적이에요. 그게 엔도라를 죽일 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210505
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210505,
					"content": "어, 어떻게 해야 널 구할 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210506
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210506,
					"content": "달콤한 물이 있는 곳으로 가야 해요. 샘물이요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210507
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210507,
					"content": "엔도라는, 물에 의지해서 이동해요. 물이 없으면, 엔도라는 머물 곳이 없어져요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210508
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210508,
					"content": "샘물이 있는 곳까지 어떻게 데려가지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210509
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210509,
					"content": "물이 한 병 있긴 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210510
					]
				},
				{
					"id": 414210510,
					"content": "근데 이 물도 쓴 물이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210511
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210511,
					"content": "엔도라는 버틸 수 있어요. 근데 오래는 못 버텨요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210512
					],
					"speakerTitle": "엔도라"
				},
				{
					"id": 414210512,
					"content": "응, 좋아. 그럼 빨리 샘물이 있는 곳으로 가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210513
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 414210513,
					"content": "그나저나 이 녀석 물 슬라임을 타고 이렇게 먼 길을 왔다니, 우리 둘의 관계랑 비슷하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
