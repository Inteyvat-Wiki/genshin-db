							-804.911
						],
						"pointId": 5742
					}
				]
			},
			"dialogs": [
				{
					"id": 705360101,
					"content": "히히! 도도코가 나쁜 뾰족 물고기 병사들을 물리쳤어! 대왕 뾰족 물고기도 도도코의 상대가 안 된다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360102
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360102,
					"content": "도도코, 통통 폭탄 그리고 쾅쾅 불꽃은 세상에서 제일 강한 조합이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360103,
						705360104
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360103,
					"content": "무적이지!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360105
					]
				},
				{
					"id": 705360105,
					"content": "이 게임을 할 때마다 시드르 호수 사건이 생각나네…. 리사는 그 사건을 게임 테마로 각색한 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705360106,
					"content": "그나저나 외래종 물고기를 못 찾으면… 클레한테 수상해 보이는 암초를 전부 터뜨려 버리라고 하면 되는 거 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705360107,
					"content": "정 안 되면 우리한테 폭탄을 줘도 되잖아. 그럼 해결될 텐데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360108,
						705360109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705360108,
					"content": "클레랑 아주 잘 통하는 것 같네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360110
					]
				},
				{
					"id": 705360110,
					"content": "음~ 표정을 보니 재밌게 즐기고 있나 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360111
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360111,
					"content": "와아, 리사 언니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360112
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360112,
					"content": "리사, 드디어 왔구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705360113,
					"content": "네가 만든 「도도코 쾅쾅 모험기」 정말 재밌었어! 클레랑 엄청 즐겁게 놀았다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705360114,
					"content": "그렇게 말해줘서 고마워. 이 작품의 후속작도 고안해 봐야 하나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360115
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360115,
					"content": "좋아! 클레는… 도도코가 다른 곳에 가서 모험하는 이야기도 보고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360116
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360116,
					"content": "아, 아니지. 게임 만드는 데 엄청 오래 걸렸으니까 언니가 힘들어할 거야. 리사 언니를 힘들게 하면 안 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360117
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360117,
					"content": "후후, 클레가 이렇게 걱정해 주다니, 기분 좋은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360118
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360118,
					"content": "얌전히 몬드성 안에서 게임 한다고 약속해 주면, 시간이 얼마가 걸리든 보람이 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360119
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360119,
					"content": "물론 클레가 자유롭게 모험하는 걸 제일 좋아한다는 건 언니도 알아. 클레한테 이 게임은 그저 조금 색다른 놀이에 불과할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360120
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360120,
					"content": "그래서 좋은 소식을 가져왔어. 귀염둥이들한테 줄 선물도 있고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360121
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360121,
					"content": "선물!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360122
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360122,
					"content": "#클, 클레도 명예 기사 {M#오빠}{F#언니}랑 페이몬한테 줄 선물이 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360123
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360123,
					"content": "선물은 맨 마지막에. 일단 좋은 소식부터 알려줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360124,
						705360125
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360124,
					"content": "시드르 호수의 문제가 해결된 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360126
					]
				},
				{
					"id": 705360126,
					"content": "맞아. 수사대의 두 기사가 외래종 물고기의 둥지를 찾아 제거했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360127
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360127,
					"content": "외래종 물고기가 나타난 이유 역시 기사단에서 조사가 끝났고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360128
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360128,
					"content": "이번 사건은 한 상인이 무심결에 한 행동에서 비롯됐어. 나쁜 뜻으로 그런 게 아니라 기사단은 약간의 훈계와 벌금 정도로 끝냈지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360129
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360129,
					"content": "휴우… 심각한 문제로 이어지지 않아서 다행이야. 근데 그 상인도 참 너무하네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360130,
						705360131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705360130,
					"content": "시드르 호수의 수질이 안전해졌네요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360132
					]
				},
				{
					"id": 705360132,
					"content": "그럼——이제 선물을 공개할 시간이야! 클레가 먼저 말해도 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360133
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360133,
					"content": "물론이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360134
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360134,
					"content": "나도 궁금해지는걸. 요즘 클레는 잔소리를 하지 않아도 매일 일찍 집에 들어갔거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360135
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360135,
					"content": "흐흥~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360136
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360136,
					"content": "밤에 집에서 알베도 오빠의 그림 책자를 보고 배우면서 이걸 만들었어——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360137
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360137,
					"content": "쨔쟌!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360138
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360138,
					"content": "이건… 통통 폭탄을 던지려고 하는 도도코!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705360139,
					"content": "응! 「도도코 쾅쾅 모험기」의 게임 말을 보고 이 도도코 인형을 만들어 봤어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360140
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360140,
					"content": "이 도도코 인형은 통통 폭탄을 진짜로 던지진 못하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360141
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360141,
					"content": "#이 인형을 볼 때마다 명예 기사 {M#오빠}{F#언니}랑 페이몬은 클레랑 재밌게 놀던 기억을 떠올리고, 고민과 심심함을 한 방에 날려버릴 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360142
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360142,
					"content": "도도코 인형이라니! 정말 깜짝 서프라이즈네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360143
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705360143,
					"content": "이제 언제든지 클레와 도도코를 볼 수 있겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360144,
						705360145
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705360144,
					"content": "고마워! 클레는 손 재주도 좋고 세심하네!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360146
					]
				},
				{
					"id": 705360146,
					"content": "#헤헤! 명예 기사 {M#오빠}{F#언니}랑 페이몬이 좋아해 줘서 클레의 노력도 대성공!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360147
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360147,
					"content": "리사 언니 선물은 뭐야? 클레도 궁금해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360148
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360148,
					"content": "후후, 클레의 정성에 비하면 내 선물은 좀 보수적인데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360149
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360149,
					"content": "「도도코 쾅쾅 모험기」의 이야기책이야——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360150
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360150,
					"content": "모험 이야기!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360151
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360151,
					"content": "책으로 만들었구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360152
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705360152,
					"content": "「몬드로 돌아온 귀염둥이들은 클레와 함께 도도코의 모험에 합류했어요」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360153
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360153,
					"content": "「그들은 힘을 합쳐서 나쁜 뾰족 물고기 병사를 물리치고, 즐거운 티타임을 가졌답니다…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360154
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360154,
					"content": "이게 「도도코 쾅쾅 모험기」의 가장 완벽한 결말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360155
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360155,
					"content": "설마 게임을 설계할 때부터 이야기를 미리 생각해 둔 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360156
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705360156,
					"content": "아니. 이 이야기는 귀염둥이와 페이몬, 그리고 클레가 함께 완성한 거야. 이야기를 정하는 주인공은 다름 아닌 너희들이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360157
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360157,
					"content": "내가 특별히 삽화 하나가 들어갈 자리를 남겨뒀어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360158
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360158,
					"content": "이렇게 하는 게 어때? 모처럼 한가할 때 만났으니, 귀염둥이들끼리 사진 한 장 찍는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360159
					],
					"speakerTitle": "리사"
				},
				{
					"id": 705360159,
					"content": "좋아! 친구도 만나고, 재밌는 게임도 하고! 기념할 만한 순간이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360160,
						705360161
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705360160,
					"content": "다 같이 한 장 찍자!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360162
					]
				},
				{
					"id": 705360162,
					"content": "#그럼 얼른 찍자. 명예 기사 {M#오빠}{F#언니}랑 페이몬, 이쪽이야! 부탁할게, 리사 언니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360163
					],
					"speakerTitle": "클레"
				},
				{
					"id": 705360163,
					"content": "오늘도 즐거운 하루야! 하나, 둘, 셋——도도코!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "클레"
				},
				{
					"id": 705360161,
					"content": "평화로운 일상도 소중하지!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360162
					]
				},
				{
					"id": 705360145,
					"content": "클레와 도도코와 함께 여행하는 거야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360146
					]
				},
				{
					"id": 705360131,
					"content": "몬드의 주류업이 무사하겠네요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360132
					]
				},
				{
					"id": 705360125,
					"content": "클레가 더 이상 성안에 갇혀 있지 않아도 되는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360126
					]
				},
				{
					"id": 705360109,
					"content": "페이몬이 폭탄을 막 던지게 둘 순 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360110
					]
				},
				{
					"id": 705360104,
					"content": "나쁜 물고기들을 쫓아내자!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360105
					]
				}
			]
		}
	]
