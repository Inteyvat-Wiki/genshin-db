						],
						"pointId": 9383
					}
				]
			},
			"dialogs": [
				{
					"id": 150240701,
					"content": "후… 드디어 나왔다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240702
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240702,
					"content": "두 사람은 이 사명을 짊어질 능력이 충분한 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240703
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240703,
					"content": "족장님의 추측이 검증됐나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240704
					]
				},
				{
					"id": 150240704,
					"content": "응, 그 공간에서 특별한 두루마리를 많이 봤지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240705
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240705,
					"content": "응, 맞아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240706
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240706,
					"content": "선조들이 남기신 그 두루마리를 자세히 연구한 결과, 그 두루마리들엔 다른 평범한 두루마리에는 없는 「색」이 있다는 걸 발견했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240707
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240707,
					"content": "그 「색」은 무척 신비로워서 나조차도 특별한 방법 없이는 존재를 확인할 수 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240708
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240708,
					"content": "그런데, 「색」을 구별하는 능력을 타고난 사람들이 있더군. 그래서 내가 두 사람을 시험해 봤던 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240709
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240709,
					"content": "그 말은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240710
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240710,
					"content": "두 사람이 방금 들어간 곳은 그 두루마리들을 보관하기 위해 만들어진 보관실이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240711
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240711,
					"content": "수백 년 전, 위칠린이라고 불리는 대샤먼이 이 보관실을 봉인했어. 허락을 받지 못한 외부인이 들어오면 그 안에 갇히게 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240712
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240712,
					"content": "이 봉인은 지금도 존재해. 원리를 완벽히 이해한 건 아니지만, 봉인을 활성화하거나 해제하는 방법을 찾았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240713
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240713,
					"content": "한 번 갇히면, 외부의 도움 없이는 탈출할 가능성이 희박해. 너나 그 대샤먼처럼 「색」을 구별할 수 있는 능력이 없다면 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240714,
						150240715
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240714,
					"content": "기억났어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				},
				{
					"id": 150240716,
					"content": "역시 넌 그 능력을 가지고 있는 것 같네…. 명룡 장로님은 아마 그 능력을 지닌 사람을 구별할 수 있으실 거야. 그리고 그걸 기반으로 두루마리를 제작할 사람을 선택하시는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240717
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240717,
					"content": "너한테는 내가 모르는 비밀이 얼마나 더 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240718
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240718,
					"content": "하지만 그런 능력이 있다고 해도 두루마리 만들기는 어디서부터 시작해야 할지 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240719
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240719,
					"content": "걱정 마. 다른 두루마리와 비교해 본 결과, 직조 기술 자체는 평범한 두루마리와 크게 다르지 않아. 가장 큰 차이는 염료와 염색에 있을 가능성이 커",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240720
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240720,
					"content": "내 추측이 틀리지 않았다면, 이 두루마리를 만드는 열쇠는 특별한 염료에 있을 거야. 그 염료를 구하려면 두 사람의 능력이 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240721
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240721,
					"content": "염색은… 염료만 구할 수 있다면 문제없을 거야. 그 부분은 내가 가르쳐 줄 수 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240722
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240722,
					"content": "…음, 그러면 족장의 지시에 따를게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240723
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240723,
					"content": "그럼 두 사람은 능력을 사용해 필요한 염료를 찾아줘. 그동안 난 염료 테스트에 사용할 두루마리를 준비할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240724
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240724,
					"content": "먼저 샘플을 제작해서 내 추측을 검증하는 게 좋겠어. 성공하면 정식으로 시작할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240725
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240725,
					"content": "일이 끝나면, 감사의 뜻으로 보수를 넉넉하게 챙겨줄게. 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240726
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240726,
					"content": "능력이 있으면 책임도 따르는 법이죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240727
					]
				},
				{
					"id": 150240727,
					"content": "응응, 게다가 보수도 있어! 근데, 맛있는 것도 줄 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240728
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240728,
					"content": "이번 일은 연기 주인 부족에게 아주 중요한 일이야. 감사의 뜻으로 거액의 보수를 준비했는데, 한 끼 식사쯤이야, 문제없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240729
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240729,
					"content": "신난다! 그럼 염료는 어디서 찾아야 해? 나타를 전부 돌아다닐 순 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240730
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240730,
					"content": "물론 그럴 필요는 없어. 염료가 있을 가능성이 큰 장소를 미리 조사해 뒀거든. 너희를 위한 길잡이도 이미 준비됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240731
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240731,
					"content": "너희만 준비되면 바로 출발할 수 있어. 길잡이는 밖에서 기다리고 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "비람"
				},
				{
					"id": 150240715,
					"content": "그 「색」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				}
			]
		},
