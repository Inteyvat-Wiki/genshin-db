						150240305
					],
					"speakerTitle": "트라포"
				},
				{
					"id": 150240305,
					"content": "내가 말실수한 거라면 미안해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240306,
					"content": "거기 누구냐? 장로님께 무례를 범하지 마라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240307
					],
					"speakerTitle": "카홀롬"
				},
				{
					"id": 150240307,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240308
					],
					"speakerTitle": "트라포"
				},
				{
					"id": 150240308,
					"content": "그러니까… 알겠습니다. 초대를 받고 오신 손님께 환대를 해 드렸어야 하는 건데, 방금은 제가 실례를 범했군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240309
					],
					"speakerTitle": "카홀롬"
				},
				{
					"id": 150240309,
					"content": "정식으로 소개 드리겠습니다. 연기 주인의 제사장 중 한 명인 카홀롬이라고 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240310
					],
					"speakerTitle": "카홀롬"
				},
				{
					"id": 150240310,
					"content": "이분은 명룡의 현 대장로이신 위대한 트라포포티즈틀리십니다. 연기 주인의 살아 있는 토템이시죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240311
					],
					"speakerTitle": "카홀롬"
				},
				{
					"id": 150240311,
					"content": "이름이 엄청 기네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240312,
					"content": "부족 사람들은 평소에 트라포 장로라고 부르고 있으니 두 분도 그렇게 부르시면 됩니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240313
					],
					"speakerTitle": "카홀롬"
				},
				{
					"id": 150240313,
					"content": "손님을 초대하는 방식이 특별하네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240314
					]
				},
				{
					"id": 150240314,
					"content": "아, 장로님의 능력을 말씀하시는 거군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240315
					],
					"speakerTitle": "카홀롬"
				},
				{
					"id": 150240315,
					"content": "트라포 장로님은 벌써 수백 년을 살아오셨습니다. 그분의 비밀은 제사장인 저도 제대로 설명하기 어려우니, 두 분이 혼란스러워하시는 것도 당연하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240316
					],
					"speakerTitle": "카홀롬"
				},
				{
					"id": 150240316,
					"content": "다만 한 가지 확실한 건, 트라포 장로님이 두 분께 중요한 계시를 내리셨다는 겁니다. 그래서 두 분을 시련에 초대하고 싶습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240317
					],
					"speakerTitle": "카홀롬"
				},
				{
					"id": 150240317,
					"content": "계시? 시련?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240318,
					"content": "두 분만 괜찮으시다면 부족의 족장님께 안내해 드리죠. 저보다는 족장님이 더 잘 설명해 주실 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240319
					],
					"speakerTitle": "카홀롬"
				},
				{
					"id": 150240319,
					"content": "음… 알겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240320
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240320,
					"content": "준비되셨다면 따라오시죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240401
					],
					"speakerTitle": "카홀롬"
				},
				{
					"id": 150240401,
					"content": "이 두루마리를 사용하면 바로 족장님이 계신 「흑요석 제단」으로 이동할 수 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240402
					],
					"speakerTitle": "카홀롬"
				},
				{
					"id": 150240402,
					"content": "저희 부족이 사용하는 여러 비술 중 하나에 불과하니, 너무 놀라실 것 없습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카홀롬"
				}
			]
		},
