				]
			},
			"dialogs": [
				{
					"id": 150240501,
					"content": "우와, 방금 그건 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240502,
					"content": "저희 제사장들의 일상 업무 중 하나입니다. 선조들의 영혼과 소통하고 계시를 구하는 것이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240503
					],
					"speakerTitle": "카홀롬"
				},
				{
					"id": 150240503,
					"content": "족장님은 저쪽에 계십니다. 먼저 가서 보고를 드릴 테니, 두 분은 여기서 잠시만 기다려 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240504
					],
					"speakerTitle": "카홀롬"
				},
				{
					"id": 150240504,
					"content": "뭐랄까, 연기 주인 부족은 아주 신비로운 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240505,
					"content": "족장님께 보고를 드렸으니 절 따라 족장님을 뵈러 가시죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240506
					],
					"speakerTitle": "카홀롬"
				},
				{
					"id": 150240506,
					"content": "너희가 계시가 지목한 사람들이지? 난 연기 주인의 현 족장 비람이야. 우리 부족에 온 걸 환영해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240507
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240507,
					"content": "엄청 크다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240508,
					"content": "난 태어날 때부터 남다른 체구를 가졌어, 너무 놀라진 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240509
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240509,
					"content": "미안! 방금은 그냥 조금 놀랐을 뿐이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240510
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240510,
					"content": "「계시」가 뭐죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240511
					]
				},
				{
					"id": 150240511,
					"content": "자세한 상황은 카홀롬이 설명해 줬겠지. 두 사람이 의아해하는 것도 충분히 이해해. 너희는 외부에서 온 손님이니까 「계시」를 잘 모르는 것도 당연하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240512
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240512,
					"content": "과거의 기나긴 역사 속에서 이 「계시」의 선택을 받은 사람은 모두 연기 주인 내부 부족 사람들이었어. 외부인이 선택된 건 이번이 처음이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240513
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240513,
					"content": "어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240514
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240514,
					"content": "설명해 줄게. 연기 주인에는 두루마리를 제작해 나타의 역사를 기록하는 오랜 전통이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240515
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240515,
					"content": "우리 부족의 역사뿐만 아니라, 다른 부족의 전설과 영웅 이야기들도 함께 기록하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240516
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240516,
					"content": "지금까지 수천 년 동안 그래왔고, 우리는 그걸 우리의 사명이라 여기고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240517
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240517,
					"content": "그런데 나타 전 지역에 영향을 미치는 큰 사건이 발생했을 땐 아주 특별한 두루마리가 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240518
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240518,
					"content": "그리고 그 직물은 오직 명룡 대장로님이 지목한 사람만이 완성할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240519
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240519,
					"content": "명룡 대장로님이 지맥의 큰 변화를 감지하면, 계시를 내리고 두루마리를 제작할 사람을 선택하는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240520
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240520,
					"content": "그렇다는 건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240521
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240521,
					"content": "현 장로님은 오래전부터 지맥의 변화를 감지하셨지만, 너희가 도착한 후에야 두루마리를 제작할 사람을 지목하셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240522
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240522,
					"content": "그렇구나… 근데 우린 두루마리를 어떻게 만드는지 전혀 모르는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240523
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240523,
					"content": "그건 별로 놀랄 일이 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240524
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240524,
					"content": "응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240525
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240525,
					"content": "장로님은 약 200년 전에 장로 자리와 더불어 계시를 받을 사람을 선택하는 역할을 맡게 되셨지만, 장로님이 선택한 사람들 모두 두루마리를 만드는 방법을 이해하지 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240526
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240526,
					"content": "그럼 그 200년 동안 역사적인 사건들을 기록하지 못한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240527
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240527,
					"content": "그건 아냐, 다들 정해진 시간에 결과물을 제출했지만, 대부분이 자기가 두루마리를 만든 게 아니라 「신의 선물」을 받은 거라고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240528
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240528,
					"content": "음… 연기 주인 부족은 정말 신비로운 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240529
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240529,
					"content": "하지만 그게 바로 내가 곤란한 부분이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240530
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240530,
					"content": "역사를 기록하는 건 무척 중요한 일이야. 「신의 선물」이라는 수수께끼 같은 말에만 희망을 거는 건 굉장히 불안하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240531
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240531,
					"content": "연기 주인의 족장이 이런 말을 할 줄은 몰랐어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240532
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240532,
					"content": "충분히 이해해. 연기 주인 부족 사람들은 다들 신비로움이 가득하고, 말로 설명하기 어려운 사물을 숭상한다고 생각하겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240533
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240533,
					"content": "하지만 난 좀 달라. 연기 주인의 족장이긴 하지만, 이 전통에도 개혁이 필요하다고 생각하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240534
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240534,
					"content": "난 여러 가지 신비한 것들을 해석하려고 최선을 다하고 있어. 그래야만 명확한 규칙을 세울 수 있고, 결과적으로 부족의 전통을 더 오래 유지할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240535
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240535,
					"content": "와, 엄청 대단해 보여…. 그럼 「신의 선물」도 해석한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240536
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240536,
					"content": "아니… 오랫동안 조사했지만, 「신의 선물」이 뭔지 정확하게 밝혀내지 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240537
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240537,
					"content": "그 두루마리로 기록해야 하는 큰 사건은 손에 꼽을 정도로 드문 데다 사건 사이의 간격이 수십 년도 넘거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240538
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240538,
					"content": "다음 계시가 내려올 때쯤이면 족장이 바뀌고 난 뒤라서 자세하게 조사할 기회가 전혀 없었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240539
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240539,
					"content": "그럼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240540
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240540,
					"content": "사건의 전모를 파악하진 못했지만, 어느 정도 진전은 있었어. 다만, 내 가설을 검증하기 위해선 선택된 사람의 협력이 필요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240541
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240541,
					"content": "그래서 저희가 시련을 받아야 한다는 거군요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240542
					]
				},
				{
					"id": 150240542,
					"content": "맞아, 그래도 걱정할 거 없어. 이 시련은 내 가설을 검증하기 위한 거니까 두 사람의 정신력을 크게 소모하지도 않고 위험하지도 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240543
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240543,
					"content": "구체적으로 어떤 시련인가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240544
					]
				},
				{
					"id": 150240544,
					"content": "시련 장소로 가면서 얘기해 줄게. 그전에 「영혼을 감싸는 깃털」을 벗어야 하니까 잠깐 기다려 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240545
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240545,
					"content": "이건 역대 족장들에게 전해져 내려오는 성물로, 제사를 주관할 때만 착용할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240546
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240546,
					"content": "우와…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240547
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240547,
					"content": "비람은 겉옷을 벗어 조심스럽게 제사장에게 건넸다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150240548
					]
				},
				{
					"id": 150240548,
					"content": "자, 따라와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240549
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240549,
					"content": "이 두루마리 보이지? 두루마리에 손을 대면 비밀 공간으로 이동할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240550
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240550,
					"content": "두 사람이 받아야 할 시련은 바로 그 공간에서 탈출하는 방법을 찾는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240551
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240551,
					"content": "그것만 하면 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240552
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150240552,
					"content": "이 시련을 얕보진 마. 만약 탈출 방법을 찾지 못하면 너희가 돌아올 수 있도록 내가 도와줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240553
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240553,
					"content": "물론 그렇게 되면 이번 계시는 여전히 풀리지 않은 수수께끼로 남게 되겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240554
					],
					"speakerTitle": "비람"
				},
				{
					"id": 150240554,
					"content": "일단 해볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240555
					]
				},
				{
					"id": 150240555,
					"content": "좋아, 저 두루마리를 만지면 시련이 시작될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "비람"
				}
			]
		},
