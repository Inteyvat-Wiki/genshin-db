			"dialogs": [
				{
					"id": 10031801,
					"content": "드디어 왔네. 절운간에 다녀온 성과는 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031802
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031802,
					"content": "…그랬구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031806,
					"content": "모든 선인을 다 만나지 못한 건… 그들의 말로하면 「인연이 없어서」인 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031807
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031807,
					"content": "상관없어! 시간 나면 다시 가보면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031808
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031808,
					"content": "게다가 항마대성의 정보만 해도 아주 귀한 거야. 답례로 나도 정보를 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031809
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031809,
					"content": "신의 죽음에 대한 리월 칠성의 반응은 아주 의미심장해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031810
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031810,
					"content": "그들은 외부에 아직 진범을 찾지 못했기 때문에 「선조의 허물」 참배를 금한다고 공표했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031811
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031811,
					"content": "입을 막으려는 시도까지 했지…. 하지만 청신의례엔 사람이 많으니까, 아무리 칠성이라도 소문이 퍼지는 걸 막을 순 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031812
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031812,
					"content": "선조의 허물?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031813
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10031813,
					"content": "리월의 상식에 의하면 암왕제군도 선인이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031814
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031814,
					"content": "바위의 신은 계약의 신이자 선인들의 조상이라고 불리고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031815
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031815,
					"content": "지금의 「삼안오현 선인」은 그때 모두 리월을 지키겠다는 계약을 맺었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031816
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031816,
					"content": "그래서 리월의 일에 그렇게 신경 썼구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031817
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10031817,
					"content": "맞아. 그들은 그럴만한 책임과 자격이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031818
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031818,
					"content": "——만약 리월을 관리하는 칠성에 문제가 생기면, 그들은 책임을 추궁할 자격이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031819
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031820,
					"content": "그건 내게도 큰 문제야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031821,
					"content": "나도 이런 행태를 받아들일 수 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031819,
					"content": "칠성은 왜 바위 신의 영혼이 하늘로 올라가고 남은 껍데기를 숨긴 거지…. 수상해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031820,
						10031821
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031822,
					"content": "그래! 맞아, 우린 바위의 신을 만나러 온 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031823
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10031823,
					"content": "리월 칠성이 「선조의 허물」을 숨기고 사람들의 접근을 막아버린다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031824
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10031824,
					"content": "#{NICKNAME}가 일곱 신 모두를 만나겠다는 목표가 물거품이 되잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031825
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10031826,
					"content": "너와 상관없잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031827,
					"content": "말해줄 수 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031825,
					"content": "오? 일곱 신을 찾아다니고 있었구나? 어째서지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031826,
						10031827
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031828,
					"content": "하하… 좋은 대답이군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031829
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031829,
					"content": "「우인단」에게 쉽게 비밀을 털어놓는 기사는 좋은 기사가 아니잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031830
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031830,
					"content": "하지만… 이번엔 너에게 도움을 줄 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031831
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031831,
					"content": "에? 정말?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031832
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 10031832,
					"content": "내게 시간을 좀 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031833
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031833,
					"content": "사람을 좀… 찾아야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031834
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031834,
					"content": "내가 이 교착 상태를 깰 수 있는 사람을 찾아줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031835
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031835,
					"content": "훗… 재미있군. 상황을 억지로 통제할수록 결국 더욱 큰 혼란을 야기하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031836
					],
					"speakerTitle": "「타르탈리아」"
				},
				{
					"id": 10031836,
					"content": "썩은 물이 터져 나오는 장관을 직접 보려면 나와 재회할 때까지 잘 버티고 있으라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「타르탈리아」"
				}
			]
		},
