			"dialogs": [
				{
					"id": 210360301,
					"content": "야외 훈련이요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360302
					]
				},
				{
					"id": 210360302,
					"content": "잘됐다, 어떤 모험가한테 야외 훈련 루트를 짜는 걸 도와달라고 했거든…. 아 내가 여기서 훈련할 수 있는 것도 다 그녀 덕분이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360303
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210360303,
					"content": "최대한 빨리 결승점에 도달하면 된다고 했는데… 난 항상 시간을 너무 많이 써서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360304
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210360304,
					"content": "어떻게 해야 빠르게 「야외 훈련」을 진행할 수 있는지 시범을 보여주면, 내가 열심히 따라 해볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360305,
						210360306
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210360305,
					"content": "좋아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360308
					]
				},
				{
					"id": 210360308,
					"content": "아무튼 잘 부탁해. 그럼 먼저 훈련 장소로 이동하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "손우"
				},
				{
					"id": 210360306,
					"content": "뒤처지면 안 돼요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360307
					]
				},
				{
					"id": 210360307,
					"content": "크흠… 내 발힘에 한계가 있긴 하지만… 열심히 할게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360308
					],
					"speakerTitle": "손우"
				}
			]
		},
