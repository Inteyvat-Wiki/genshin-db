			},
			"dialogs": [
				{
					"id": 210360501,
					"content": "후… 후우… 후우우… 넌 어떻게… 그렇게 빠른 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360502,
						210360504
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210360502,
					"content": "당신이 느린 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360503
					]
				},
				{
					"id": 210360503,
					"content": "내가 졌다… 내가 졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210360506,
					"content": "시범을 보여줘서 고마워, 여행자. 이건 답례니까 받아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360507,
						210360510
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210360507,
					"content": "소작아에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360508
					]
				},
				{
					"id": 210360508,
					"content": "사매는… 하, 여전히 만나주지 않아. 나, 난 어떻게 설득해야 할까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360509
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210360509,
					"content": "휴… 두 마리 토끼를 다 잡기가 이렇게 힘들 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "손우"
				},
				{
					"id": 210360510,
					"content": "그 모험가에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360511
					]
				},
				{
					"id": 210360511,
					"content": "그 사람? 아… 모험가 길드에서 만났지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360512
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210360512,
					"content": "길드의 의뢰를 받고 층암거연에서 업무를 보고 있었대. 내가 동행하고 싶다는 말을 듣고 끼워 줬지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360513
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210360513,
					"content": "하지만 그 대가로… 의뢰를 도와줘야 했어. 대부분 물건을 찾는 의뢰라 딱히 어려울 건 없었지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360514
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210360514,
					"content": "다만… 너무 말이 많아서 조금 상대하기 버겁더군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "손우"
				},
				{
					"id": 210360504,
					"content": "수련을 더 하셔야겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360505
					]
				},
				{
					"id": 210360505,
					"content": "네 말이… 네 말이 맞아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "손우"
				}
			]
