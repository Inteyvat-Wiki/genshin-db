				]
			},
			"dialogs": [
				{
					"id": 60110201,
					"content": "이분은 등대 같은 분이셨습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110202
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110202,
					"content": "언제나 그 자리에서 주위에 빛과 은혜를 베풀었죠. 하지만 사람들은 빛에 익숙해진 나머지 등대의 존재를 잊고 말았습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110203
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110203,
					"content": "서서히, 조금씩, 그 자신도 이렇게 여겼습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110204
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110204,
					"content": "「내가 하는 일은 별게 아니다. 나는 아직 부족하다. 더 참고 기다려야 한다…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110205
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110205,
					"content": "다소 슬픈 결말일지도 모르지만, 저는 타인의 앞길을 밝혀준 이분이 자랑스럽습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110206
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110206,
					"content": "빛에서 태어난 그림자들은, 이 사실을 결코 잊지 않을 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110207
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110207,
					"content": "정말 안타까워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60110208,
					"content": "한 등불 요정에 관한 이야기를 들은 적이 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110209
					]
				},
				{
					"id": 60110209,
					"content": "네. 저도 들어봤습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110210,
						60110211
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110210,
					"content": "그에게 저도 똑같은 말을 해주고 싶어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				},
				{
					"id": 60110212,
					"content": "…그런가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110213
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110213,
					"content": "맞는 말씀입니다. 비록 이번에 우리 노력은 허사가 되었고, 달 사냥꾼은 목적을 이뤘으나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110214
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110214,
					"content": "원하는 결과가 따르지 않는다 하더라도, 우리는 끝까지 그자를 추격할 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110215
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110215,
					"content": "이렇게 보니 묘지기의 일과도 닮았네요——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110216
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110216,
					"content": "망자를 되살리는 게 아니라, 안식을 준다는 점에서요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110217
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110217,
					"content": "그렇게 생각하니 다행이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110218
					]
				},
				{
					"id": 60110218,
					"content": "네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110219
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110219,
					"content": "무, 무슨 대화인지 모르겠어. 설명 좀 해줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60110220,
					"content": "진지한 분위기잖아, 돌아가서 말해줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110221
					]
				},
				{
					"id": 60110221,
					"content": "알겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110222
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60110222,
					"content": "어쨌든, 이번 장례의 주인공은 그 등불 요정이 아니죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110223
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110223,
					"content": "「빛을 든 자여, 그대는 피로 영광과 정의를 실천했노라」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110224
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110224,
					"content": "「갈 길이 바쁘고 온몸이 상처투성일지라도, 잠시 멈추어 애증의 과거를 되돌아보라」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110225
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110225,
					"content": "「깊은 밤 세상이 잠들면, 아무도 볼 수 없는 등이 그대만을 위해 서서히 빛나리라」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110226
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110226,
					"content": "그동안 감사했습니다. 수시 원사님",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110211,
					"content": "결과에 그렇게 집착할 필요 없다고요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				}
			]
		},
