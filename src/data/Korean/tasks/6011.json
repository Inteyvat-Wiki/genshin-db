			"dialogs": [
				{
					"id": 60110101,
					"content": "모두 한데 모여 양쪽에서 일어난 일과 얻은 정보를 공유한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						60110102
					]
				},
				{
					"id": 60110102,
					"content": "다행히 피해는 최소한으로 막았고, 부상당한 주민도 소수에 불과해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110103
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60110103,
					"content": "하지만 달 사냥꾼은 완전한 몸을 얻은 반면, 우리는 아직 그의 목적조차 알지 못하고 있네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110104
					],
					"speakerTitle": "라우마"
				},
				{
					"id": 60110104,
					"content": "꼭 흉악한 깃룡을 방생한 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110105
					],
					"speakerTitle": "이네파"
				},
				{
					"id": 60110105,
					"content": "…다들 깃룡이 뭔지 모르시나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110106
					],
					"speakerTitle": "이네파"
				},
				{
					"id": 60110106,
					"content": "알긴 아는데, 되게 귀여운 비유네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60110107,
					"content": "그자는 이 세계에 관심이 없다고 했으니까, 당장은 우리와 충돌할 이유가 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110108
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 60110108,
					"content": "단순히 복수를 하러 찾아온다 해도, 우리에겐 방법이 없고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110109
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 60110109,
					"content": "나 지금이라도 빠져도 될까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110110
					],
					"speakerTitle": "야호다"
				},
				{
					"id": 60110110,
					"content": "노, 농담이야, 보스! 이렇게 된 마당에 튈 데가 어딨다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110111
					],
					"speakerTitle": "야호다"
				},
				{
					"id": 60110111,
					"content": "으… 내 자랑이던 대포가 악당을 돕다니… 우씨! 당장 분해해 버려야겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110112,
						60110113
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 60110112,
					"content": "이건 아이노 잘못이 아니야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				},
				{
					"id": 60110114,
					"content": "맞아. 평범한 광란의 사냥을 상대할 때는 여전히 유용하니까 너무 낙담하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60110115,
					"content": "플린스 씨, 당신은 등지기에 돌아가서 뒤처리를 맡아줘. 당신에 관한 건 해명해 뒀으니, 그쪽에서 귀찮게 굴지는 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110116
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 60110116,
					"content": "여러모로 정말 감사했습니다. 당신의 도움이 없었다면, 쉽게 진실에 다다르진 못했을 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110117
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110117,
					"content": "조금 더 자주 모습을 드러내도록 해. 그럼 이번처럼 고립되는 일은 없을 테니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110118
					],
					"speakerTitle": "네페르"
				},
				{
					"id": 60110118,
					"content": "하하, 조언 새겨듣겠습니다. 한번 고려해 보죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110119
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110119,
					"content": "제가 수시 원사님의 자리를 이어받는다면, 확실히 그런 일은 없겠군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110120
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110120,
					"content": "뭐야, 너 승진해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60110121,
					"content": "농담하는 거야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110122
					]
				},
				{
					"id": 60110122,
					"content": "앗, 그렇구나. 내가 눈치가 없었네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 60110123,
					"content": "#{NICKNAME}, 시간 괜찮으시면 저랑 같이 가주실 수 있을까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110124
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110124,
					"content": "그분께 마지막 인사를 드리고 싶습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "플린스"
				},
				{
					"id": 60110113,
					"content": "대포 잘못도 아니고…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				}
			]
		},
