			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"리사"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010701,
					"content": "<color=#00E1FFFF>유적</color>에서 사는 건가? 몬드 사람들도 가끔 이상한 취미가 있네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010702
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101010702,
					"content": "몬드 사람들의 거주 습관을 이렇게 함부로 추측하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010703
					],
					"speakerTitle": "리사"
				},
				{
					"id": 101010703,
					"content": "난 오히려 사람들에게 미움받는 「훼방꾼」의 수법과 비슷하다고 생각해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010704,
						101010707,
						101010709
					],
					"speakerTitle": "리사"
				},
				{
					"id": 101010704,
					"content": "츄츄족인가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010705
					]
				},
				{
					"id": 101010705,
					"content": "츄츄족이 책을 훔칠 것 같아 보이진 않는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010706
					],
					"speakerTitle": "리사"
				},
				{
					"id": 101010706,
					"content": "책을 훔친다고 해도 불붙여서 땔감으로 사용하겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "리사"
				},
				{
					"id": 101010712,
					"content": "아마도 <color=#00E1FFFF>심연 교단</color>의 짓일 거야. 워낙 신출귀몰한 놈들이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010713
					],
					"speakerTitle": "리사"
				},
				{
					"id": 101010713,
					"content": "게다가… 유적 입구의 원소 봉인도 심연 메이지의 마력 흔적과 비슷해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010714
					],
					"speakerTitle": "리사"
				},
				{
					"id": 101010714,
					"content": "봉인인가, 그럼 어떻게 풀지…? 또 뭐가 많이 필요한 건 아니겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010715
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101010715,
					"content": "이 정도의 원소력으로 날 막을 순 없지. 우습게 보다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010716
					],
					"speakerTitle": "리사"
				},
				{
					"id": 101010716,
					"content": "응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010717
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101010717,
					"content": "들어가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010718
					],
					"speakerTitle": "리사"
				},
				{
					"id": 101010718,
					"content": "우…와…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010719
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101010719,
					"content": "이게 바로 근무 중인 리사 씨인가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101010707,
					"content": "심연 교단인가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010708
					]
				},
				{
					"id": 101010708,
					"content": "역시, 넌 나와 텔레파시가 통하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "리사"
				},
				{
					"id": 101010709,
					"content": "모험가 길드인가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010710
					]
				},
				{
					"id": 101010710,
					"content": "음… 확실히 항상 지하 유적을 들락날락하긴 하지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010711
					],
					"speakerTitle": "리사"
				},
				{
					"id": 101010711,
					"content": "하지만 그들은 남의 물건을 함부로 가져가진 않아…. 음, 방금 한 말 취소, 적어도 살아 있는 사람의 물건은 함부로 가져가지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "리사"
				}
			]
		},
		{
			"id": 1010108,
			"completionStepIds": [
				1010108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1010108",
							"2"
						],
						"stepId": 1010108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"리사"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010801,
					"content": "<color=#00E1FFFF>《하얀 공주와 여섯 난쟁이》</color>! 책 이름을 기억해, 이거 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010802
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101010802,
					"content": "맞아, 다행히 책엔 아무런 손상도 없어, 안 그랬으면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010803
					],
					"speakerTitle": "리사"
				},
				{
					"id": 101010803,
					"content": "안 그랬으면? 설마 리사에게 더 잔인한 벌칙이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010804
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101010804,
					"content": "후후, 그럼 아마 약제학에서의 성과를 사용하게 되겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010805
					],
					"speakerTitle": "리사"
				},
				{
					"id": 101010805,
					"content": "우!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010806
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101010806,
					"content": "그러고 보니 「금서 구역」의 책이 아니라서, 마음 놓고 일반 시민에게 빌려줬는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010807
					],
					"speakerTitle": "리사"
				},
				{
					"id": 101010807,
					"content": "내가 한 표기 외에, 아무런 이상한 원소 파동도 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010808
					],
					"speakerTitle": "리사"
				},
				{
					"id": 101010808,
					"content": "그러게, 그냥 평범한 동화책 같잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010809,
						101010810
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101010809,
					"content": "그런데 왜 심연 교단이…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010810
					]
				},
				{
					"id": 101010810,
					"content": "(신비롭군, 호기심을 자극해…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010811
					]
				},
				{
					"id": 101010811,
					"content": "도서관 사서로서의 번거로운 일은 이미 다 끝났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010812
					],
					"speakerTitle": "리사"
				},
				{
					"id": 101010812,
					"content": "이 책에 관심 있어 보이는데, 빌려줄까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010813,
						101010814
					],
					"speakerTitle": "리사"
				},
				{
					"id": 101010813,
					"content": "그… 그럼 반납 기한은…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010814
					]
				},
				{
					"id": 101010814,
					"content": "「벌」 받기 싫어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010815
					]
				},
				{
					"id": 101010815,
					"content": "기한은 무기한이야. 널 「대여인」이 아닌 「보관인」으로 등록할게",
					"roleType": "TALK_ROLE_NPC",
