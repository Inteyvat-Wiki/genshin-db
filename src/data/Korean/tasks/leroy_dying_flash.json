			"dialogs": [
				{
					"id": 741490501,
					"content": "다 끝났어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490502
					],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741490502,
					"content": "응. 르로아, 그…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741490503,
					"content": "사탕을 갖고 싶은 거니, 아니면 용돈으로 쓸 수 있는 보수를 받고 싶은 거니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490504
					],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741490504,
					"content": "다, 다 갖고 싶은데, 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741490505,
					"content": "페이몬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490506
					]
				},
				{
					"id": 741490506,
					"content": "욕심꾸러기구나. 하하하, 괜찮아. 어린아이는 원래 이래야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490507
					],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741490507,
					"content": "특히 페이몬처럼 귀여운 꼬마 아가씨는 예쁜 치마를 입고 마카롱을 먹으며 예쁜 집에서 살아야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490508
					],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741490508,
					"content": "#나도 그렇게 생각해! {NICKNAME}, {NICKNAME}, 나 그거 사도 될까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490509
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741490509,
					"content": "안 돼",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490510
					]
				},
				{
					"id": 741490510,
					"content": "흑흑, 미워. 이 구두쇠야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490511,
						741490512
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741490511,
					"content": "페이몬, 우리는 모험가잖아…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				},
				{
					"id": 741490513,
					"content": "근데 그게 마카롱과 치마, 그리고 예쁜 집이랑 무슨 상관인데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490514
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741490514,
					"content": "왜 갑자기 말다툼을 하는 거야? 정말 유치하구나. 하지만 말다툼하는 것도 나쁘진 않지. 너희들이 아직 어린아이라는 증거거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490515,
						741490516
					],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741490515,
					"content": "사실 제 나이는…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490517,
					"content": "어린 시절은 길지 않아, 소중히 여겨야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490518
					],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741490518,
					"content": "자, 보수랑 간식을 모두 줄 테니 이제 싸우지 말렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490519
					],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741490519,
					"content": "야호, 간식이다! 고마워, 르로아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490520
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741490520,
					"content": "브누아라고 부르면 돼. 르로아는 내 성이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490521
					],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741490521,
					"content": "폰타인성에 르로아는 나 하나뿐이야. 성으로 부르는 건 이 늙은이를 외롭게 할 뿐이니까, 이름으로 불러줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490522
					],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741490522,
					"content": "르… 브누아, 네 딸의 성은 르로아가 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490523
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741490523,
					"content": "모티시아는 내 친딸이 아니야. 반년 전에 입양한 딸이지. 하지만 나에게는 친딸과 다를 바 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490524
					],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741490524,
					"content": "원한다면 내일 또 와도 돼. 그때는 모티시아와 아토스가 돌아왔을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490525
					],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741490525,
					"content": "귀여운 두 아이에게 일을 맡기고 간식을 좀 준다고, 모티시아가 불만은 없을 테지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490526
					],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741490526,
					"content": "가끔 다른 꼬마 아이도 찾아오는데 같이 놀아도 좋아. 난 어린아이들을 좋아하거든. 어린아이들이 많으면 집에 사람 사는 소리가 나니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490527
					],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741490527,
					"content": "너희가 왔을 때 만약 내가 없다면 문을 두드리도록 해. 그러면 아토스가 문을 열어줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490528
					],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741490528,
					"content": "그럼 약속한 거다. 우리 내일 다시 올게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490529
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741490529,
					"content": "그래, 그래. 나도 이제 집에 들어가야 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490530
					],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741490530,
					"content": "내일 봬요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490531
					]
				},
				{
					"id": 741490531,
					"content": "그래, 잘 가렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741490516,
					"content": "이건 사이가 좋다는 증명이죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490512,
					"content": "페이몬, 여행의 목적을 잊지 마…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				}
			]
		},
