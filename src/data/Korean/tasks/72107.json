					],
					"speakerTitle": "수수께끼의 남자"
				},
				{
					"id": 721070612,
					"content": "어쨌든 당신은 직접 날 본 적이 없잖아요, 하나치루사토 아가씨?",
					"roleType": "TALK_ROLE_NPC",
