				"points": []
			},
			"dialogs": [
				{
					"id": 721070201,
					"content": "이만하면 됐어! 피곤해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721070202,
					"content": "힘든 건 나인데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070203
					]
				},
				{
					"id": 721070203,
					"content": "그런 세세한 부분까지 따지지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721070204,
					"content": "응, 안에 책이 있는 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721070205,
					"content": "와, 읽기 어렵네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721070206,
					"content": "한번 훑어봤는데 무슨 내용인지 전혀 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721070207,
					"content": "휴, 전문가한테 가서 물어보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721070208,
					"content": "수상한 물건이니까… 나루카미 다이샤로 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7210703,
			"completionStepIds": [
				7210707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210705",
							"3"
						],
						"stepId": 7210705,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210707",
							"2"
						],
						"stepId": 7210707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"이나기 호토미"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721070301,
					"content": "안녕하세요, 머나먼 곳에서 온 여행자. 「나루카미 다이샤」에 온 걸 환영합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070302
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070302,
					"content": "고민이나 소원이 있으면 겐도우 아가씨를 찾아가 점괘를 보세요. 번개 신이 지켜줄 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070303
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070303,
					"content": "그렇군요, 전 이미 얼추 알고 있었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070304
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070304,
					"content": "「신성한 벚나무 대액막이」는 매우 중요한 의식이죠. 관련 기록은 있는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070305
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070305,
					"content": "그런데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070306
					]
				},
				{
					"id": 721070306,
					"content": "그런데 구체적인 방법은 소실됐어요. 당신이 가지고 있는 《개요》는 매우 귀중한 사료입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070307
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070307,
					"content": "소실이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070308
					]
				},
				{
					"id": 721070308,
					"content": "설마 우인단의 짓인가? 이나기가 중요한 일이라고 한 이상, 우인단이 배후에서 뭔가를 꾸몄다는 생각이 들어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721070309,
					"content": "아, 아닙니다. 습기나 벌레 등으로부터 보존을 잘못했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070310
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070310,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070311
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721070311,
					"content": "이런, 정말 유감이에요. 많은 사료가 분실되었네요. 전에 야에 님과 카미사토 님도 이 일로 고민했었지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070312
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070312,
					"content": "「언령」에 관해서 아무것도 모르는 건 아닙니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070313
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070313,
					"content": "응응, 그럼 푸는 방법을 알려줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721070314,
					"content": "죄송하지만 주술 도구를 봉인한 「언령 주문」은 특정 주문이 아닙니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070315
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070315,
					"content": "…주술사가 직접 정한 말이, 언령입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070316
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070316,
					"content": "그 뜻은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070317
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721070317,
					"content": "주문… 그 주술사가 마음대로 지은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721070318,
					"content": "꼭 그렇지는 않습니다. 언령은 대개 규칙이 있지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070319
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070319,
					"content": "자세히 설명해주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070320
					]
				},
				{
					"id": 721070320,
					"content": "음… 제 기억엔 책에 이렇게 기록되어 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070321
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070321,
					"content": "첫 번째 문구는 자신이 이나즈마에서 유명하다는 걸 표현했는데 무슨 「칙사」라는 두 글자도 포함했던 것 같아요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070322
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070322,
					"content": "두 번째 문구는 자신의 힘의 근원을 설명하고 있어요. 예를 들면, 「경단」, 「라멘」, 「라이트 노벨」 같은 것입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070323
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070323,
					"content": "응응, 알아. 확실히 대단한 힘의 원천이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070324
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721070324,
					"content": "단지 예를 들었을 뿐입니다. 기록에는 「음양박효」 같은 거라고 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070325
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070325,
					"content": "세 번째 문구에 관해서는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070326,
						721070327
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070326,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070328
					]
				},
				{
					"id": 721070328,
					"content": "음… 예상하신 바와 같습니다. 세 번째 문구의 내용은 자유자재로 표현할 수 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070329
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070329,
					"content": "오랜 시간이 지났으니, 세상에 세 번째 문구를 아는 사람은 없을 것 같네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070330
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070330,
					"content": "그럼 어떡하지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070331
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721070331,
					"content": "가면 무녀 언니의 부탁인데… 그리고 이 땅은… 망했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070332,
						721070333
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721070332,
					"content": "긴장하지 말고…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070334
					]
				},
				{
					"id": 721070334,
					"content": "네, 이 조그마한 물건이 두 분께 도움이 될지도 모릅니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070335
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070335,
					"content": "이건 <color=#00E1FFFF>「기억의 렌즈」</color>입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070336
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070336,
					"content": "「기억」? 기억하겠다는 뜻이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070337
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721070337,
					"content": "두 분은 견문이 넓으니 분명 「사진기」에 대해 아실 겁니다. 그것은 이국 폰타인에서 생산된, 영상을 기록할 수 있는 기물입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070338
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070338,
					"content": "먼 옛날, 이도(離島)가 막 세워졌을 때, 히이라기 가문의 가주인 히로시 님은 이국땅에서 기발한 물건을 많이 들여왔어요. 그것은 무역항 건설 추진에 큰 도움이 되었지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070339
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070339,
					"content": "예를 들면, 스네즈나야에서 구입한 「용광로」를 이용해서, 천수각과 인접한 히이라기 가문의 옛 저택을 「온천」으로 개조하여, 쇼군의 은혜에 대한 감사로 쇼군에게 선물했죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070340
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070340,
					"content": "또한, 「호재궁 어르신」이 히이라기 가문에 증여한 「렌즈」라고 불리는 퇴마 거울을 폰타인국에서 특수한 사진기로 제작하여, 그리움과 기억을 기록할 수 있도록 했지요. 그 사진기는 우호와 우정의 상징으로 다이샤에게 답례로 주었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070341
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070341,
					"content": "사진기 자체의 기능은 세월의 풍파를 겪으면서 상실됐지만, 호재궁 어르신의 축복을 받은 렌즈는 특별한 곳에서 지금은 존재하지 않는 것을 볼 수 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070342
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070342,
					"content": "우리는 그 렌즈를 꺼내서 「기억의 렌즈」라는 이름을 지어줬죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070343
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070343,
					"content": "두 분께서 「벚나무」 일을 위해 뛰어다니신 이야기를 들으니, 믿음이 갑니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070344
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070344,
					"content": "두 분께 맡기면, 이 렌즈도 제 몫을 다하는 셈이겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070345
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070345,
					"content": "이렇게 중요한 물건이…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721070346
					]
				},
				{
					"id": 721070346,
					"content": "두 분은 타향에서 오셨죠. 여러분도 알다시피 이나즈마 사람은 만물에 영이 깃들기에, 돌과 나무에도 기억이 있다고 믿습니다. 기물을 백 년 동안 방치하면 달갑지 않은 감정도 생깁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721070347
					],
					"speakerTitle": "이나기 호토미"
				},
				{
					"id": 721070347,
					"content": "이걸 신사에서 묵히기보다는, 인연 있는 사람에게 드려 수백 년 동안 변화되는 세상을 보여주고자 합니다",
					"roleType": "TALK_ROLE_NPC",
