			"dialogs": [
				{
					"id": 701020102,
					"content": "「이빨」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020103
					]
				},
				{
					"id": 701020103,
					"content": "이빨? 어디 보여줘 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020104
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 701020104,
					"content": "음… 이 모양과 크기는 확실히 평범하진 않네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020105
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 701020105,
					"content": "난 이런 재료에 대해 잘 몰라…. 근데 오르방 씨는 무기 만들 때 수많은 재료를 봐왔으니까 알지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020106
					],
					"speakerTitle": "옥희"
				},
				{
					"id": 701020106,
					"content": "그는 이 근처에 있으니까 가서 물어봐. 쉽게 찾을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "옥희"
				}
			]
		},
		{
			"id": 7010202,
			"completionStepIds": [
				7010207
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
