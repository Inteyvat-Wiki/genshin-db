					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_GREATER",
						"rawParams": [
							"73263",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬",
					"아란마"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730692001,
					"content": "세 번째 바소마 열매도 획득! 아란자 말대로 세 개면 충분하겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692002
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730692002,
					"content": "#응! 충분할 것 같아. 나라{NICKNAME}, 페이몬. 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692003,
						730692005
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730692003,
					"content": "천만에",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730692004
					]
				},
				{
					"id": 730692004,
					"content": "…그러고 보니, 분명히 네가 도움을 줬는데 왜 우리에게 고마워하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692006
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730692006,
					"content": "음, 생각해 보니 이렇게 말해야 할 것 같네. 너희도 아란나를 돕는 중이고, 또 아란나는 내 친구니까, 그래서 너희한테 고마운 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692007
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730692007,
					"content": "#그리고 나라{NICKNAME}(은)는 아란야사, 아란다사, 아란슈드라카를 도와 오래된 노래를 찾아냈고, 그들도 나의 친구니까, 그래서 너희한테 고마운 거고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692008
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730692008,
					"content": "#마지막으로 나라{NICKNAME}(이)랑 페이몬과 함께 모험을 하게 되어 너무 즐거웠거든, 그래서 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692009
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730692009,
					"content": "나도 즐거웠어! 고마워, 아란마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692010
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730692010,
					"content": "그러고 보니, 아슈바타 전당 근처에도 사람이 활동했던 흔적이 있는 것 같던데… 여기 무슨 사연이 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692011
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730692011,
					"content": "아주 오래전의 이야기인데, 내가 씨앗도 아니었을 때 얘기야. 아주 먼 옛날엔 나라도 아란나라를 볼 수 있었고, 아란나라도 나라를 두려워하지 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692012
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730692012,
					"content": "#그때는 나라와 아란나라가 서로를 도우며 함께 놀았어. 지금의 나랑 나라{NICKNAME}처럼 자주 함께 노래도 불렀지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692013
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730692013,
					"content": "아란야사와 같은 채곡가들도 다 나라에게서 배운 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692014
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730692014,
					"content": "아슈바타 전당은 원래 아란나라와 나라가 함께 놀던 곳이었어. 비록 아주 오래전 일이지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692015
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730692015,
					"content": "그 끔찍한 재앙이 일어난 후로 바나라나는 멸망했고, 아슈바타 전당도 황폐해졌지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692016
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730692016,
					"content": "그렇구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692017
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730692017,
					"content": "응, 끔찍한 이야기야. 하지만 다행이야. 내 기억이 아닌 이야기일 뿐이라서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692018
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730692018,
					"content": "#걱정 마! 다 잘될 거야. 그렇지, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692019,
						730692020
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730692019,
					"content": "응, 맞아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730692022
					]
				},
				{
					"id": 730692022,
					"content": "아슈바타 전당도 찾았고 바소마 열매 세 개도 구했으니까, 이제 돌아가서 우트사바 축제 준비를 돕고, 숲속의 동료들도 불러야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692023
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730692023,
					"content": "응! 아란마, 힘내! 우트사바 축제가 기대된다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692024
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730692024,
					"content": "나도 너무 기대돼! 그럼, 또 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692025
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730692025,
					"content": "아란마, 또 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730692020,
					"content": "글쎄…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730692021
					]
				},
				{
					"id": 730692021,
					"content": "#…{NICKNAME}, 너 많이 피곤해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730692022
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730692005,
					"content": "분명히 도움을 줘놓고…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730692006
					]
				}
			]
