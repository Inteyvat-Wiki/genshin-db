						240090802
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240090802,
					"content": "찍었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090803
					]
				},
				{
					"id": 240090803,
					"content": "어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090804
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240090804,
					"content": "정말 완벽해! 사진 촬영에 이렇게 조예가 깊은 줄 몰랐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090805
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240090805,
					"content": "이 사진에서 참고할 만한 좋은 소재를 고를 수 있을 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090806
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240090806,
					"content": "정말 고마워. 아, 내가 모라를 어디에 뒀더라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090807
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240090807,
					"content": "자, 여기 있어, 꼭 받아줘! 다음에 또 기회가 되면 사진 찍는 거 도와주라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090808
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240090808,
					"content": "이제 작품을 구상할 차례인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "드피에리스"
				}
