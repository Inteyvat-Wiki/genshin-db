			"dialogs": [
				{
					"id": 240091001,
					"content": "고마워, 이 정도면 충분히 배를 채울 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091002
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240091002,
					"content": "자, 여기 보수야. 난 우선 허기를 좀 달래야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091003
					],
					"speakerTitle": "드피에리스"
				},
				{
					"id": 240091003,
					"content": "다음엔… 주머니에 들어가는 과자를 좀 챙겨야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "드피에리스"
				}
			]
		},
