				},
				{
					"id": 760790102,
					"content": "심연의 악취가 진하게 풍기고 있군요. 균열 뒤에 뭔가 숨어 있는 게 분명합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760790103
					],
					"speakerTitle": "플린스"
				},
				{
					"id": 760790103,
