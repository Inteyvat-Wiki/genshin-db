						741511007
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741511007,
					"content": "네 분석을 들어보니까 내가 느꼈던 의혹이 뭐였는지 조금 알 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741511005,
					"content": "브누아 씨는 딸에게 협박당하고 있는 거야",
					"roleType": "TALK_ROLE_PLAYER",
