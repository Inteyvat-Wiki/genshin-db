			},
			"dialogs": [
				{
					"id": 741500501,
					"content": "아빠, 요즘 잠은 잘 자고 있어? 아직도 불면증에 시달리고 있는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500502
					],
					"speakerTitle": "아토스"
				},
				{
					"id": 741500502,
					"content": "훨씬 좋아졌어. 요즘에는 거의 악몽을 안 꾸거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500503
					],
					"speakerTitle": "브누아·르로아"
				},
				{
					"id": 741500503,
					"content": "(르로아 일가의 잡담 소리가 점점 희미해진다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "두드리기"
				}
			]
		},
		{
			"id": 7415101,
			"completionStepIds": [
				7415101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
