			"dialogs": [
				{
					"id": 742530201,
					"content": "평온한 시간이야. 참 좋다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530202,
						742530203
					],
					"speakerTitle": "마리안"
				},
				{
					"id": 742530202,
					"content": "(조금 더 앉아있자)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "「산드로네」"
				},
				{
					"id": 742530204,
					"content": "벌써 시간이 이렇게 됐구나? 하하, 그럼 앞으로 자주 만나자, 산드로네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마리안"
				},
				{
					"id": 742530203,
					"content": "티타임을 슬슬 끝내야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "「산드로네」"
				}
			]
		}
	]
}