			"dialogs": [
				{
					"id": 745260401,
					"content": "#아, {NICKNAME}, 왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260402,
						745260403
					],
					"speakerTitle": "닐루"
				},
				{
					"id": 745260402,
					"content": "닐루, 연습하고 있었어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				},
				{
					"id": 745260404,
					"content": "아니, 괜찮아. 새로운 춤을 구상하고 있었어. 비가 그친 파디사라와 꽃잎에 이슬이 맺혀있는 모습에서 영감을 받았거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260405
					],
					"speakerTitle": "닐루"
				},
				{
					"id": 745260405,
					"content": "하지만 아직 초기 단계라서 동작이 아름답지 않고, 뭔가 부족한 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260406,
						745260407
					],
					"speakerTitle": "닐루"
				},
				{
					"id": 745260406,
					"content": "설명만 들어도 이미 아름다운걸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260408,
					"content": "사진? 하지만 아까 말했듯이, 아직 스텝이 서툴러서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260409,
						745260410
					],
					"speakerTitle": "닐루"
				},
				{
					"id": 745260409,
					"content": "춤을 완성하는 과정도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260411,
					"content": "응, 알겠어! 그럼 마음을 스텝에 담아볼게… 사진기로 꽃이 피어나는 순간을 담아 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "닐루"
				},
				{
					"id": 745260410,
					"content": "예술의 일부니까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260407,
					"content": "사진 한 장 찍어도 될까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260403,
					"content": "방해가 된 건 아니지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				}
			]
		}
