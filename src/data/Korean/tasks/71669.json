			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"진진"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716690101,
					"content": "#{NICKNAME}, 직원들 말로는 발신 장치를 가진 동물들을 모두 다 찾았다던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690102
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716690102,
					"content": "의외인걸, 어떤 동물들은 선천적으로 민감해서 낯선 생물이 다가오면 바로 도망가거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690103
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716690103,
					"content": "그런데 네 접근을 거부하지 않았다니, 정말 신기하네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690104,
						716690105
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716690104,
					"content": "전 동물들의 친구니까요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				},
				{
					"id": 716690106,
					"content": "하하, 정말 부러운 능력인걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690107
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716690107,
					"content": "전에 직원들이 나와 함께 동물들에게 먹이를 주러 몇 번 갔었는데 다들 날 향해 짖거나 물었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690112
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716690112,
					"content": "팔에 흉터도 몇 개 남았지. 꽤 아프더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690113
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716690113,
					"content": "나한테 살갑게 굴지는 않지만, 귀여운 친구들이 잘 지내는 모습만 볼 수 있다면 난 아주 만족해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690114
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716690114,
					"content": "다른 입양인들도 똑같을 거야. 모두 동물들을 놀라게 하지 않는 범위 내에서 그들의 생존 환경을 지키고 싶어 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690115
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716690115,
					"content": "야생 동물이 많은 모험가들의 중요한 식량이란 건 알고 있어. 우리도 「동물 친구와 동행」 멤버에게 살생하지 말라는 요구는 하지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690116
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716690116,
					"content": "우리가 주장하는 원칙은 무분별한 남획을 금지하는 거야. 만약 모든 사람이 이 원칙을 지킬 수만 있다면 우리의 주변 환경은 더 다양하고 아름다워지겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690117
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716690117,
					"content": "#우리의 멤버로서 {NICKNAME} 너도 이 원칙에 동의하고 받아들일 수 있다면 정말 좋을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690118,
						716690120
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716690118,
					"content": "저도 동의해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690119
					]
				},
				{
					"id": 716690119,
					"content": "역시 너처럼 합리적인 사람이라면 동의할 줄 알았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716690122,
					"content": "생각해 보는 계기가 될 수 있다면 그것만으로도 성공이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690123
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716690123,
					"content": "기회가 된다면 다음 「동물 친구와 동행」 행사에서도 널 만날 수 있으면 좋겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690124
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716690124,
					"content": "그때 내 팔에 상처가 더 이상 늘어나 있지 않길 바라야지, 하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "진진"
				},
				{
					"id": 716690120,
					"content": "제 의견은 일단 보류할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690121
					]
				},
				{
					"id": 716690121,
					"content": "괜찮아, 모두에게 다 받아들이라고 강요하는 건 아니니까. 하지만 난 개인적으로 모두가 살생 전에 이 문제를 생각해 보면 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "진진"
				},
				{
					"id": 716690105,
					"content": "모험가의 천부적인 재능이라고 할 수 있죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				}
			]
		},
