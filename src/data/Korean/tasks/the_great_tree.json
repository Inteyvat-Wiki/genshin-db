			"dialogs": [
				{
					"id": 230270201,
					"content": "여행자, 이런 우연이 다 있나. 또 만났네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270202
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230270202,
					"content": "아직도 연구를 하고 있는 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270203
					]
				},
				{
					"id": 230270203,
					"content": "응, 라데프와 페레즈 말로는 더 많은 데이터를 수집해야 한대. 그전까진 내 일을 계속할 수밖에 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270204
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230270204,
					"content": "하지만 뿌리 상태가 어떤지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270205
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230270205,
					"content": "여행자, 혹시 시간 있으면 신성한 나무의 뿌리 상태를 다시 기록해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야스민"
				}
			]
		},
