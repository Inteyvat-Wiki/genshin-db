			"dialogs": [
				{
					"id": 200360301,
					"content": "다 끝났나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360302
					],
					"speakerTitle": "글로리"
				},
				{
					"id": 200360302,
					"content": "위엔 바람이 거세네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360303
					]
				},
				{
					"id": 200360303,
					"content": "그래야 민들레가 더 멀리 날아가죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360304
					],
					"speakerTitle": "글로리"
				},
				{
					"id": 200360304,
					"content": "그럼 갓윈이 제가 한 말을 전해 들을 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360305
					],
					"speakerTitle": "글로리"
				},
				{
					"id": 200360305,
					"content": "제가 닿을 수 있게 손을 뻗어주세요….여기, 이건 답례예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360306
					],
					"speakerTitle": "글로리"
				},
				{
					"id": 200360306,
					"content": "갓윈에게 하고픈 말이 아직 많네요. 나중에 또 당신에게 부탁할지도 몰라요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "글로리"
				}
			]
		}
	]
