						],
						"pointId": 330201413
					}
				]
			},
			"dialogs": [
				{
					"id": 735220101,
					"content": "짜잔! 산게마 바이 어르신의 정보 판매 시간이 돌아왔습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220102
					],
					"speakerTitle": "도리"
				},
				{
					"id": 735220102,
					"content": "거기 두 사람, 최신 정보가 필요하지 않아? 이번 정보는 엄청나게 중요한 건 아니니까 단돈 50만 모라만 받도록 하지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220103
					],
					"speakerTitle": "도리"
				},
				{
					"id": 735220103,
					"content": "저번보다 고작 절반의 가격으로 구매할 수 있는 파격적인 기회라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220104
					],
					"speakerTitle": "도리"
				},
				{
					"id": 735220104,
					"content": "공짜로 주면 안 돼?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735220105
					]
				},
				{
					"id": 735220105,
					"content": "쿨럭, 단숨에 0모라로 깎아버리다니… 이건 또 예상 밖이구만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220106
					],
					"speakerTitle": "도리"
				},
				{
					"id": 735220106,
					"content": "하지만 나는 관대한 산게마 바이 어르신이라 불리는 몸! 그렇게 알고 싶다면 특별히 공짜로 말해줄게. 대신 소문은 내지 말라고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220107
					],
					"speakerTitle": "도리"
				},
				{
					"id": 735220107,
					"content": "소문에 의하면, 20년 전 대항전의 한 참가자가 대회가 끝난 후 갑자기 성격이 확 돌변했다지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220108
					],
					"speakerTitle": "도리"
				},
				{
					"id": 735220108,
					"content": "그런데 말이야, 과거 아루 마을에서 그 사람을 목격한 사람이 있다고 해. 과연 그 사람은 어디로 갔던 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220109
					],
					"speakerTitle": "도리"
				},
				{
					"id": 735220109,
					"content": "자, 공짜 정보는 여기까지! 이 뒤는 200만 모라에 모십니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220110
					],
					"speakerTitle": "도리"
				},
				{
					"id": 735220110,
					"content": "말도 안 되게 비싸잖아! 그냥 아루 마을에 가서 직접 물어보는 게 낫겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7352202,
			"completionStepIds": [
				7352202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352202",
							"2"
						],
						"stepId": 7352202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"리쉬티"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735220201,
					"content": "20년 전이라… 확실히 어떤 젊은이가 오긴 왔었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220202
					],
					"speakerTitle": "리쉬티"
				},
				{
					"id": 735220202,
					"content": "당시 이곳의 상황은 지금보다 훨씬 안 좋았단다. 가난과 질병, 그리고 무지가… 항상 우리를 괴롭혔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220203
					],
					"speakerTitle": "리쉬티"
				},
				{
					"id": 735220203,
					"content": "그 젊은이는 아카데미아 출신에 앞날이 창창했는데도, 기꺼이 이곳에서 우리와 고통을 함께 나눴어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220204
					],
					"speakerTitle": "리쉬티"
				},
				{
					"id": 735220204,
					"content": "그는 우리에게 지식을 나눠주고, 모래폭풍과 마물에 대처하는 법을 가르쳐 줬단다. 또 사비를 털어 약초를 잔뜩 사 와서는 병자를 돌봐주기도 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220205
					],
					"speakerTitle": "리쉬티"
				},
				{
					"id": 735220205,
					"content": "되게 좋은 사람이었나 보네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735220206,
					"content": "그랬지…. 왜 좋은 사람들은 그렇게 명이 짧은지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220207
					],
					"speakerTitle": "리쉬티"
				},
				{
					"id": 735220207,
					"content": "그는 항상 찌푸린 얼굴이었지만, 그가 무엇을 걱정하는지 아는 사람은 없었단다. 그저 다들 「곧 떠나려나」하고 짐작할 뿐이었지. 이곳 상황이 너무 안 좋아서 제대로 된 대접을 할 수가 없었으니까 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220208
					],
					"speakerTitle": "리쉬티"
				},
				{
					"id": 735220208,
					"content": "하지만 그가 미쳤다고 생각하는 사람도 적지 않았어. 그는 때때로 아이들에게 자기가 어렸을 때 어떤 신기한 생물에게 글자를 가르쳤다든가 하는 이야기를 늘어놓았거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220209
					],
					"speakerTitle": "리쉬티"
				},
				{
					"id": 735220209,
					"content": "또 그 젊은이는 종종 마을을 떠나 사막으로 탐사를 떠나기도 했단다. 언젠가 그에게 무엇을 찾고 있냐고 물었더니, 나가르뭐시기단인가 하는 사람들을 찾아서 이야기를 나누고 싶다고 하더구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220210
					],
					"speakerTitle": "리쉬티"
				},
				{
					"id": 735220210,
					"content": "그러던 어느 날, 그가 유사에 빠져 죽었다는 소식을 들었어. 탐사를 하다가 유사에 빠진 캐러밴을 발견해 많은 사람을 구했지만, 정작 자신은 빠져나오지 못했다는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220211
					],
					"speakerTitle": "리쉬티"
				},
				{
					"id": 735220211,
					"content": "당시 그가 머물던 집에는 자기 아이에게 쓰다 만 편지가 남아있었어. 그가 죽은 후, 내 아들은 언젠가 주인에게 전달할 기회가 있을지도 모른다면서 그 편지를 가져갔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220212
					],
					"speakerTitle": "리쉬티"
				},
				{
					"id": 735220212,
					"content": "그 편지는… 아직도 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735220213,
					"content": "아니, 이젠 없단다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220214
					],
					"speakerTitle": "리쉬티"
				},
				{
					"id": 735220214,
					"content": "내 아들은 더 잘 살아보려고 용병 일을 시작했다가, 몇 년 전의 한 전투에서 목숨을 잃었어. 가지고 있던 물건도 누군가 전부 가져갔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220215
					],
					"speakerTitle": "리쉬티"
				},
				{
					"id": 735220215,
					"content": "그 후로 벌써 세월이 이렇게나 흘렀구나. 그 젊은이의 자식이 건강하게 자랐을지, 행여나 그를 원망하지는 않을지 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220216
					],
					"speakerTitle": "리쉬티"
				},
				{
					"id": 735220216,
					"content": "이젠 그 일을 기억하는 사람도 별로 남아있지 않단다. 나도 이제는 늙어서 곧 잊어버릴 것 같고 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "리쉬티"
				}
			]
		},
