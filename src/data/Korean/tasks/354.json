			"dialogs": [
				{
					"id": 3540401,
					"content": "바람의 신이 당신을 지켜주길!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540402
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3540402,
					"content": "난 페보니우스 기사단의 정찰 기사 엠버야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540403
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3540403,
					"content": "넌 몬드의 시민이 아닌 것 같은데? 너의 정체를 말해줘야겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540404
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3540404,
					"content": "진정해. 우리는 이상한 사람이 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3540405,
					"content": "수상한 사람들은 하나같이 이렇게 말하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540406
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3540406,
					"content": "#난 {NICKNAME}(이)라고 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540407
					]
				},
				{
					"id": 3540407,
					"content": "…현지인의 이름은 아닌 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540408
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3540408,
					"content": "그리고 이… 마스코트처럼 생긴 건 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540409,
						3540412
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3540409,
					"content": "친구야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540410
					]
				},
				{
					"id": 3540410,
					"content": "응, 비록 알고 지낸 지 2개월밖에 안 됐지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3540411,
					"content": "우린 이미 둘도 없는 친구야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3540414,
					"content": "어쨌든, 너희들은 여행자라는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540415
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3540415,
					"content": "최근 몬드성 주변에 거대한 드래곤이 출몰하고 있어. 너희들도 얼른 성안으로 피하는 게 좋을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540416
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3540416,
					"content": "몬드는 여기서 멀지 않아, 기사인 내가 너희들을 호송해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540417
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3540417,
					"content": "성 밖으로 나왔는데 다른 임무는 없는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540418
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3540418,
					"content": "물론 있어. 하지만 안심해. 임무 도중에도 너희들의 안전은 지켜줄 수 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540419
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3540419,
					"content": "그리고… 수상한 사람들을 그냥 내버려 둘 순 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540420,
						3540421
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3540420,
					"content": "우릴 믿지 못하는 거구나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540422,
					"content": "…실례했군, 훌륭한 기사의 신분에 맞지 않는 말을 해버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540423
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3540423,
					"content": "미안해, 음… 낯설고 존경하는 나그네여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540424
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3540424,
					"content": "이 어색한 발언은 뭐야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540425
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 3540425,
					"content": "너 우리 《기사단 매뉴얼》의 규범 용어에 대해 불만이라도 있는 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				},
				{
					"id": 3540421,
					"content": "손님을 그렇게 부르면 예의가 없는 건데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540412,
					"content": "비상식량이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540413
					]
				},
				{
					"id": 3540413,
					"content": "뭐야! 마스코트보다 못하잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
}