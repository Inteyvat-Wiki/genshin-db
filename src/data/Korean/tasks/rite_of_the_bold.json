			"dialogs": [
				{
					"id": 750190601,
					"content": "솔직히… 네 실력은 알고 있지만, 그래도 조심해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190602
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750190602,
					"content": "파칼은 「고대 이름」을 얻지 못했지만 그래도 실력자야. 그가 요 몇 년 동안 수련을 게을리하지 않았다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190603
					],
					"speakerTitle": "망코"
				},
				{
					"id": 750190603,
					"content": "준비됐으면 전투를 시작하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "망코"
				}
			]
