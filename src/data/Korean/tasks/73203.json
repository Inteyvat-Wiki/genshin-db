				"points": []
			},
			"dialogs": [
				{
					"id": 731930501,
					"content": "너희를 만나지 못했다면 장미가 싹 틔우는 걸 볼 수 없었을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930502
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930502,
					"content": "이런 방법이 있는 줄 알았다면 애초에 씨앗이 아니라 책을 좀 챙겨 오는 건데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930503,
						731930519
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930503,
					"content": "현지인 아니었어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930504
					]
				},
				{
					"id": 731930504,
					"content": "그렇게 보여? 내가 여기 잘 적응하긴 했나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930505
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930505,
					"content": "이곳에 처음 왔을 때는 의식주가 다 힘들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930506
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930506,
					"content": "그래도 시간이 흐르니까 천천히 적응되더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930507
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930507,
					"content": "하지만 겉으로만 그렇게 보이는 거지, 내 처지를 받아들인 건 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930508
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930508,
					"content": "수메르성에서는 활짝 피는 장미가 여기서는 꽃을 피우지 못했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930509
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930509,
					"content": "학자세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930510
					]
				},
				{
					"id": 731930510,
					"content": "난… 예전에는 학자라 불렸지만 지금은 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930511
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930511,
					"content": "내 신분으로 해선 안 되는 말을 했고, 내 신분으로 알아선 안 되는 지식을 알아버렸거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930512
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930512,
					"content": "아카데미아의 금기를 어겼으니 난 더 이상 학자가 아니야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930513
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930513,
					"content": "무슨 말을 했는데요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930514
					]
				},
				{
					"id": 731930514,
					"content": "호기심은 지식 추구의 원동력이자 죄악의 원흉이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930515
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930515,
					"content": "이곳으로 쫓겨나서야 깨달았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930516
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930516,
					"content": "혹시 모르니 자세한 건 말하지 않는 게 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930517
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930517,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930518
					]
				},
				{
					"id": 731930518,
					"content": "흠흠, 하지만… 그…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930535
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930535,
					"content": "모험가는 바쁘게 오가는 사람이라 한 번 도움을 줬으니 다시 돌아오지 않을 거라 생각했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930536
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930536,
					"content": "너랑 이렇게 많은 이야기를 나눌 줄 몰랐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930537
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930537,
					"content": "음… 이곳에는 다 터놓고 말할 수 있는 친구가 많지 않거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930538
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930538,
					"content": "혹시… 나중에… 바쁘지 않으면 꽃들에게 비료 주는 거 도와주지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930539
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930539,
					"content": "그럴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930540
					]
				},
				{
					"id": 731930540,
					"content": "그렇다면… 알겠어. 네가 오기를 기다릴게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사바"
				},
				{
					"id": 731930519,
					"content": "왜 수메르 장미를 심고 싶었어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930520
					]
				},
				{
					"id": 731930520,
					"content": "수메르 장미에 대해 잘 모르는구나. 다양한 용도로 쓸 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930521
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930521,
					"content": "먹을 수도 있고 약으로도 쓸 수 있지. 다른 사람에게 선물할 수도 있고 경제적 가치도 높아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930522
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930522,
					"content": "일상생활에서 자주 쓰이는 용도만 말해도 이 정도야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930523
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930523,
					"content": "원래 수메르 장미의 꽃, 잎, 줄기는 우리가 지금 아는 모습과는 전혀 다른 형태였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930524
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930524,
					"content": "지리 조건이 바뀌면서 수메르 장미의 형태적 특징도 바뀐 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930525
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930525,
					"content": "수메르 장미의 형태가 진화하는 과정을 보면 다양한 역사지리학 정보를 얻을 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930526
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930526,
					"content": "짧게 설명할 수 있는 내용은 아니라서 지나가는 모험가에게 할 이야기는 아닌 것 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930527
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930527,
					"content": "만약 식물의 진화에 관심이 있다면 아카데미아에 가 봐. 식물학 교육 과정이 잘 마련되어 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930528
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930528,
					"content": "수메르 장미를 연구하려고 했나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930529
					]
				},
				{
					"id": 731930529,
					"content": "난 더 이상 학자가 아닌걸. 연구할 조건도 자격도 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930530
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930530,
					"content": "굳이 이유를 묻는다면… 휴, 넌 호기심이 많구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930531
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930531,
					"content": "예전에 살던 곳에 수메르 장미를 가득 심었는데 꽃이 피면 너무 아름다웠어. 매일 예쁜 꽃을 볼 수 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930532
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930532,
					"content": "할 수만 있다면 예전처럼 매일 꽃들과 함께하고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930533
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930533,
					"content": "…단지 그뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930534
					],
					"speakerTitle": "사바"
				},
				{
					"id": 731930534,
					"content": "이해해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930535
					]
				}
			]
		},
		{
			"id": 7320301,
			"completionStepIds": [
				7320301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320301",
							"2"
						],
						"stepId": 7320301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"사바"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030101,
					"content": "너희 왔구나, 약속을 지켰네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030102
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030102,
					"content": "버터 치킨을 좀 만들었어. 배고프면 같이 앉아서 먹을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030103
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030103,
					"content": "버터 치킨! 앗싸, 엄청 많이 먹어야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030104,
						732030105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732030104,
					"content": "페이몬, 그러면 안 돼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				},
				{
					"id": 732030106,
					"content": "아… 미안",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732030107,
					"content": "괜찮아. 나한테 미안해할 필요 없어. 먹는 걸 좋아할 수도 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030108
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030108,
					"content": "있다가 데워서 따로 싸줄게. 전에 부탁을 들어준 것에 대한 답례야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030109
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030109,
					"content": "우와, 사바, 너 정말 좋은 사람이구나! 네가 심은 꽃도 반드시 원하는 대로 잘 자랄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732030110,
					"content": "하하, 그동안 흙을 최대한 촉촉하게 유지해서 새싹들 상태가 괜찮아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030111
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030111,
					"content": "다만 자라는 속도가 조금 느려서 걱정이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030112
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030112,
					"content": "보통 씨눈 상태가 좋으면 금방 싹을 틔우거든. 그런데 이것들은 아직 아무런 변화가 없네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030113
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030113,
					"content": "흙의 양분이 부족해서 그런 걸까? 계속 이 상태라면 비료를 더 주는 게 좋을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030114,
						732030115
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030114,
					"content": "비료를 한 번 더 줘볼까요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030116,
					"content": "그럼 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030117
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030117,
					"content": "별거 아니니 우리한테 맡겨!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732030115,
					"content": "풀 원소의 힘으로 해 보죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030105,
					"content": "죄송해요, 페이몬이 원래 좀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				}
			]
		},
		{
			"id": 7320303,
			"completionStepIds": [
				7320303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320303",
							"2"
						],
						"stepId": 7320303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"사바"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030301,
					"content": "이번에도 정말 고마워. 이곳에서 수메르 장미가 자라는 걸 보게 되다니 무척 기뻐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030302
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030302,
					"content": "사바와 얘기하고 있는데 한 무더기의 새잎이 전에 있던 잎에서 돋아난다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030303
					]
				},
				{
					"id": 732030303,
					"content": "새잎이 점차 펴지면서 커다란 꽃봉오리가 맺힌다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030304
					]
				},
				{
					"id": 732030304,
					"content": "꽃봉오리가 천천히 열리더니 사바가 심은 수메르 장미가 끝내 꽃을 피운다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030305
					]
				},
				{
					"id": 732030305,
					"content": "사바는 수메르 장미 한 송이를 꺾어 여행자와 페이몬에게 준다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030306
					]
				},
				{
					"id": 732030306,
					"content": "아냐, 수메르 장미를 얼마 심지도 못했는데, 우리한테까지 주지 않아도 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732030307,
					"content": "괜찮아, 너희의 도움이 없었다면 수메르 장미는 이곳에서 꽃을 피우지 못했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030308,
						732030309
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030308,
					"content": "별거 아니었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				},
				{
					"id": 732030310,
					"content": "장미가 만개한 정원이라면 정말 보기 좋겠지. 하지만 한 송이 장미도 아름다워. 난 학자 시절에도 장미를 정말 좋아했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030311
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030311,
					"content": "응? 사바는 원래 학자였어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732030312,
					"content": "맞아, 페이몬에게 아직 말하지 않았구나. 난 아루 마을 사람이 아니야. 난 아카데미아에서… 「보내진」 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030313
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030313,
					"content": "그럴 줄 알았어. 사바 말투가 학자처럼 엄청 우아하더라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732030314,
					"content": "알겠다. 사바는 장미를 계속 연구하고 싶어서 심은 거구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030315
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732030315,
					"content": "꼭 그런 것만은 아니야. 학자들의 연구 대상에 대한 관심은 연구 때문에 억지로 기를 수 있는 게 아니니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030316
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030316,
					"content": "이 세계를 사랑하니까 이해하고 싶은 거야. 초목이 그리는 생명의 궤적을 알고 싶거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030317
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030317,
					"content": "예를 하나 들자면 예전에 수메르 지리 환경 변화가 장미 품종의 형태에 미치는 영향이라는 과제가 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030318
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030318,
					"content": "생각해 봐, 만약 수메르 지리 환경의 변화 방향이 지금과 완전히 달랐다면, 장미는 자연에 적응하기 위해 어떤 형태로 진화했을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030319
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030319,
					"content": "덩굴 식물로 진화했을까? 그렇다면 지금쯤 아카데미아 벽은 장미로 뒤덮여 있었겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030320
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030320,
					"content": "뭉쳐나기 식물로 진화했다면? 일단 피면 한 움큼인데 정말 기품 있지 않았을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030321
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030321,
					"content": "어쩌면 색의 스펙트럼이 다양해졌을 수도 있어. 흰색, 빨간색, 금색… 그럼 새로운 품종이 되는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030322
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030322,
					"content": "물론 지금은 새로운 품종을 찾아내는 사람이 극히 드물어. 과거의 몇몇 일류 학자들처럼 새로운 품종을 재배하는 사람은 더더욱 없고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030323
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030323,
					"content": "내가 말하고 싶은 건 장미 한 송이 한 송이마다 엄청난 가능성이 잠재되어 있다는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030324
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030324,
					"content": "이런 가능성을 찾아내는 건 정말 즐거운 일이야. 당시에 난 흥미를 가득 품고 신나게 표본을 모으러 다녔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030325
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030325,
					"content": "돌이켜 보면 정말 순수하고 즐거운 시간이었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030326
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030326,
					"content": "아무튼 너희가 이 꽃을 받아줬으면 좋겠어. 내게도 이건 손해가 아니라 즐거운 나눔일 뿐이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030327
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030327,
					"content": "마음이 불편한 거라면 나중에 수메르 장미를 가득 들고 날 찾아와 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030328
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030328,
					"content": "너희들과 대화하면 마음이 편해져",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030329
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030329,
					"content": "내가 무슨 말을 하든 너희는 내 말을 「잡담」이라 생각하며 끊지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030330
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030330,
					"content": "나도 너희에게 작은 선물을 줄게. 비록 지금의 내겐 쓸모없는 거지만 너희는 좋아할지도 모르니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030331
					],
					"speakerTitle": "사바"
				},
				{
					"id": 732030331,
					"content": "자주 올게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030332
					]
				},
				{
					"id": 732030332,
					"content": "꼭 자주 와야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사바"
				},
				{
					"id": 732030309,
					"content": "마음에 담아 두지 마세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				}
			]
		},
