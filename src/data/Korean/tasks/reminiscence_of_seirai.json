				"objectNames": [
					"후루야 노보루"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630201,
					"content": "정말 머리 아프군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630202
					],
					"speakerTitle": "후루야 노보루"
				},
				{
					"id": 721630202,
					"content": "지도에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630203
					]
				},
				{
					"id": 721630203,
					"content": "지도에 나와 있는 지형을 보니 세이라이섬의 어디인 거 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630204
					],
					"speakerTitle": "후루야 노보루"
				},
				{
					"id": 721630204,
					"content": "어떻게 안거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630205
					]
				},
				{
					"id": 721630205,
					"content": "길드에서도 세이라이섬과 관련 있는 탐사 의뢰를 한 적이 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630206
					],
					"speakerTitle": "후루야 노보루"
				},
				{
					"id": 721630206,
					"content": "의뢰를 받은 모험가들이 길드에 보고를 하러 올 때 세이라이섬에 관한 정보를 가지고 오니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630207
					],
					"speakerTitle": "후루야 노보루"
				},
				{
					"id": 721630207,
					"content": "하지만 인원이 부족해 대규모 탐사를 진행하지 못하는 탓에, 일정 시간마다 모험가 몇 명만 파견해 탐사하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630208
					],
					"speakerTitle": "후루야 노보루"
				},
				{
					"id": 721630208,
					"content": "그래서 세이라이섬에 대한 정보가 한정적이라 이 지도를 더 이상 분석하는 건 무리일 거 같네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630209
					],
					"speakerTitle": "후루야 노보루"
				},
				{
					"id": 721630209,
					"content": "하지만, 성 안에 세이라이섬과 관련 있는 분을 알고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630210
					],
					"speakerTitle": "후루야 노보루"
				},
				{
					"id": 721630210,
					"content": "오다 타로 님이라고… 선조들이 세이라이섬에 거주했었고, 개인적인 사정으로 이곳에 이주해 왔다고 들었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630211
					],
					"speakerTitle": "후루야 노보루"
				},
				{
					"id": 721630211,
					"content": "얼마 전에 길드에 찾아와 세이라이섬까지 동행해 줄 모험가를 고용하고 싶다고 했으니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630212
					],
					"speakerTitle": "후루야 노보루"
				},
				{
					"id": 721630212,
					"content": "이 지도를 가지고 오다 타로 님에게 가서 물어보면 알고 있는 게 있을 수도 있겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "후루야 노보루"
				}
			]
		},
