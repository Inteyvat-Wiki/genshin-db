					"오다 타로"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721630301,
					"content": "아이고, 같이 갈 사람을 어느 세월에 찾지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630302
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630302,
					"content": "지도에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630303
					]
				},
				{
					"id": 721630303,
					"content": "너는… 모험가 길드의 모험가야? 드디어 의뢰가 수락된 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630304
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630304,
					"content": "전 그냥 지나가던 여행자예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630305
					]
				},
				{
					"id": 721630305,
					"content": "그래… 내게 무슨 지도를 보여주고 싶은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630306
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630306,
					"content": "어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630307
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630307,
					"content": "이, 이건! 설마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630308,
						721630309
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630308,
					"content": "뭐라도 알아내셨나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				},
				{
					"id": 721630310,
					"content": "여긴 세이라이섬 이잖아!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630311,
						721630312
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630311,
					"content": "네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630313,
					"content": "하하하, 진짜 세이라이섬이야? 그냥 찍은 건데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630314
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630314,
					"content": "내 선조분들이 세이라이섬에 살긴 했지만 오래전 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630315
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630315,
					"content": "우리 세대는 세이라이섬에 대한 기억이 거의 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630316
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630316,
					"content": "집에 세이라이섬과 관련 있는 물건은… 세이라이섬 풍경화 세 장밖에 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630317
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630317,
					"content": "그럼 왜 돌아가려고 하는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630318
					]
				},
				{
					"id": 721630318,
					"content": "그건… 뭐라고 해야 할까, 그곳이 내「고향」이기 때문이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630319
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630319,
					"content": "어떻게든… 가보고 싶다는 생각이 들어서 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630320
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630320,
					"content": "지금은 장사가 너무 바빠서 갈 순 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630321
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630321,
					"content": "그리고… 아직 나를 세이라이섬으로 호송해 줄 모험가도 못 찾았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630322
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630322,
					"content": "그래서 어쩔 수 없이 모험가 길드에 의뢰를 부탁했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630323
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630323,
					"content": "나를 세이라이섬으로 데려다줄 모험가가 나타났으면 좋겠어. 세 장의 그림 위치를 찾아내서 「사진기」로 기록하고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630324
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630324,
					"content": "하지만 아직 아무도 이 의뢰를 받지 않고 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630325,
						721630326
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630325,
					"content": "제게 맡기세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630327,
					"content": "그, 그래?! 그럼 정말 다행이네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630328
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630328,
					"content": "보수는 걱정하지 마. 내가 꼭 챙겨줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630329
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630329,
					"content": "그럼 잘 부탁할게. 이미 가져온 지도 한 장까지 포함하면 총 네 장이군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630330
					],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630330,
					"content": "세이라이섬에 가서 이 네 지점에서 사진을 찍어서 가져다줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "오다 타로"
				},
				{
					"id": 721630326,
					"content": "제가 도와드릴 수 있을 거 같아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630327
					]
				},
				{
					"id": 721630312,
					"content": "맞아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630313
					]
				},
				{
					"id": 721630309,
					"content": "이곳이 고향이신가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630310
					]
				}
			]
		},
