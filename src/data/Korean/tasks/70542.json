					}
				]
			},
			"dialogs": [
				{
					"id": 705420101,
					"content": "냐… 냐옹?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420102
					],
					"speakerTitle": "모나"
				},
				{
					"id": 705420102,
					"content": "고양이한테 이렇게 인사하면 되나? 발음이 틀리진 않았겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420103
					],
					"speakerTitle": "모나"
				},
				{
					"id": 705420103,
					"content": "야옹?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420104
					],
					"speakerTitle": "「샤베트」"
				},
				{
					"id": 705420104,
					"content": "「샤베트」는 하나도 못 알아들은 것 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705420105,
					"content": "모나, 지금 고양이 언어를 시도해 보고 있는 거야…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420106,
						705420107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705420106,
					"content": "모나 선생님, 그게 아니야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420108
					]
				},
				{
					"id": 705420108,
					"content": "이봐! 「으르렁, 어흥」은 호랑이나 사자 같잖아. 그런 소리를 내면 고양이가 놀랄 거라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705420109,
					"content": "#{NICKNAME}, 페이몬! 너희가 「복슬복슬 고양이 성」에서 일하고 있다는 게 사실이었구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420110
					],
					"speakerTitle": "모나"
				},
				{
					"id": 705420110,
					"content": "일이라기보다는 바레리나와 로자리아를 도와주고 있는 거지. 음, 뭐랄까… 고문 역할에 더 가까워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705420111,
					"content": "그래, 고문이라고 하니까 엄청 대단해 보이네. 후후!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705420112,
					"content": "그나저나 「위대한 점성술사 모나」, 넌 별자리 관측을 도와줄 고양이 한 마리를 입양하려는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705420113,
					"content": "내 천문학적 이해에 따르면 고양이들이 별자리를 알아보도록 가르치는 건 그렇게 어렵지 않을 거야. 어쩌면… 고양이한테 원고를 써 달라고 할 수 있을지도?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420114
					],
					"speakerTitle": "모나"
				},
				{
					"id": 705420114,
					"content": "(샤베트를 힐끔 쳐다본다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420115
					],
					"speakerTitle": "모나"
				},
				{
					"id": 705420115,
					"content": "(샤베트를 똑바로 응시한다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705420116,
					"content": "야옹!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420117
					],
					"speakerTitle": "「샤베트」"
				},
				{
					"id": 705420117,
					"content": "흠흠, 됐다. 별자리를 이해한다고 해도 심오한 내용을 쉽게 표현하는 방법을 모르는 채로 쓴 원고로는 내 진실한 견해를 전달할 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420118
					],
					"speakerTitle": "모나"
				},
				{
					"id": 705420118,
					"content": "원고 작성을 도와줄 조수가 필요하다면, 다시 폰타인으로 가서 스팀버드의 사무원을 고용하거나 타자기를 다룰 줄 아는 멜뤼진을 찾아서 몬드로 데려오는 편이 낫지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420119
					],
					"speakerTitle": "모나"
				},
				{
					"id": 705420119,
					"content": "만약 내가 정말 고양이를 입양한다면, 고양이들과 함께 놀며 학술 연구에서 쌓인 피로와 스트레스를 풀기 위해서일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420120
					],
					"speakerTitle": "모나"
				},
				{
					"id": 705420120,
					"content": "자기가 힘들다고 고양이까지 힘들게 하는 나쁜 주인이 될 수는 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420121
					],
					"speakerTitle": "모나"
				},
				{
					"id": 705420121,
					"content": "이곳에 들어오기 전까지는 고양이랑 노는 게 이렇게 즐거운 일인지 몰랐거든…. 다들 계속 이렇게 즐겁게 지내면 좋겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420122
					],
					"speakerTitle": "모나"
				},
				{
					"id": 705420122,
					"content": "헤헤, 모나도 좋은 주인이 될 것 같은데? 너에게 고양이를 맡긴다면 모두가 안심할 수 있을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705420123,
					"content": "그런데 과하게 활동적인 고양이도 있다고 들었어. 항상 방 안을 어지럽게 뛰어다닌다거나, 가구를 물고 뜯는 걸 좋아한다던데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420124
					],
					"speakerTitle": "모나"
				},
				{
					"id": 705420124,
					"content": "만약 내 원고나 점성술 자료가 물어 뜯겨서 엉망이 되면 큰일이라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420125
					],
					"speakerTitle": "모나"
				},
				{
					"id": 705420125,
					"content": "고가의 책이 물어 뜯겨서 엉망이 된다니… 생각조차 하기 싫을 정도로 무서운 일이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705420126,
					"content": "「샤베트」는 아주 착해 보이지만, 내 말이 무슨 뜻인지는 잘 모르는 것 같아…. 어쩌면 우리 둘이 잘 맞는 건 아닐지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420127
					],
					"speakerTitle": "모나"
				},
				{
					"id": 705420127,
					"content": "그러니까 내 말을 이해할 수 있는 고양이가 있는지 좀 더 둘러봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420128
					],
					"speakerTitle": "모나"
				},
				{
					"id": 705420128,
					"content": "그리고 고양이 집이랑 사료처럼 부가적으로 들어가는 비용도 계산해 봐야 해. 아주 화려하진 않더라도 너무 초라한 걸 사줄 순 없으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420129,
						705420130
					],
					"speakerTitle": "모나"
				},
				{
					"id": 705420129,
					"content": "괜찮아, 천천히 둘러봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420131
					]
				},
				{
					"id": 705420131,
					"content": "맞아. 바레리나가 앞으로 더 많은 길고양이를 입양할 거라고 했어. 지금 당장 마음에 드는 고양이가 없더라도 자주 와서 둘러보면 될 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420132
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705420132,
					"content": "야옹~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「샤베트」"
				},
				{
					"id": 705420130,
					"content": "성에는 다른 고양이도 엄청 많거든",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420131
					]
				},
				{
					"id": 705420107,
					"content": "으르렁, 어흥이라고 해 봐",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420108
					]
				}
			]
		}
	]
}