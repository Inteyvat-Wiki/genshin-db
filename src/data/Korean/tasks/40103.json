			"dialogs": [
				{
					"id": 401035101,
					"content": "알하이탐, 닐루, 혹시 다른 참가자들 못 봤어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401035102,
					"content": "못 봤는데, 아직 완료한 사람이 없거든…. 무슨 일 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035103
					],
					"speakerTitle": "닐루"
				},
				{
					"id": 401035103,
					"content": "그 왕관, 뭔가 잘못된 것 같아…. 아! 알하이탐, 너라면 뭔가 알고 있지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401035104,
					"content": "뭘 말하는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035105
					],
					"speakerTitle": "알하이탐"
				},
				{
					"id": 401035105,
					"content": "너어——됐어! 일단 왕관부터 찾고 물어보러 올게!",
					"roleType": "TALK_ROLE_NPC",
