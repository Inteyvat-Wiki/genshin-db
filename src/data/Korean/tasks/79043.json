					],
					"speakerTitle": "읽기"
				},
				{
					"id": 790430102,
					"content": "음, 이 화가에게 심경의 변화가 생겼던 모양이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
