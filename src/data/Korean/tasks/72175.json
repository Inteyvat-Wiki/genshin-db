					"nextDialogs": [
						721750408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 721750408,
					"content": "하하, 사소한 일에 너무 신경 쓰지 말게. 나도 계속 먹고 있다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750409
