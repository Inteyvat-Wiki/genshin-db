			"dialogs": [
				{
					"id": 722030501,
					"content": "하하, 또 들켰네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030502
					],
					"speakerTitle": "논노"
				},
				{
					"id": 722030502,
					"content": "그게, 아쉽지만… 이번에는 작별 인사하러 온 거야. 황금색 아저씨가 이제 떠나야 한대…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030503
					],
					"speakerTitle": "논노"
				},
				{
					"id": 722030503,
					"content": "하지만 걱정하지 마. 내가 가는 곳에는 함께 놀아줄 사람이 엄청 많거든! 너도 같이 갔으면 좋겠지만… 황금색 아저씨가 아직은 때가 아니래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030504
					],
					"speakerTitle": "논노"
				},
				{
					"id": 722030504,
					"content": "하지만 괜찮아! 기다리고 있을게, 만약 못 기다리겠으면 빛으로 변해서 네 꿈속으로 찾아가면 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030505
					],
					"speakerTitle": "논노"
				},
				{
					"id": 722030505,
					"content": "조심히 가",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722030506
					]
				},
				{
					"id": 722030506,
					"content": "응, 고마워. 그동안 즐거웠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030507
					],
					"speakerTitle": "논노"
				},
				{
					"id": 722030507,
					"content": "이제 혼자가 아니라서… 정말 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "논노"
