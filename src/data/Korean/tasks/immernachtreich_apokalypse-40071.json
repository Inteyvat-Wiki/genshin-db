			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"내레이터",
					"모나",
					"신염"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710301,
					"content": "「오늘날 백성들은 기억할 방법이 없지만 학자들은 성도 시대보다 600년 앞선 혼돈의 시기에 황녀가 이미 세계에 군림한 것을 알고 있다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710302
					],
					"speakerTitle": "내레이터"
				},
				{
					"id": 400710302,
					"content": "뭐야? 갑자기 웬 내레이션?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710303
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400710303,
					"content": "책의 세계라서 그런지 이야기를 내레이션으로 설명해 주네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710304
					],
					"speakerTitle": "신염"
				},
				{
					"id": 400710304,
					"content": "길이 끊겨서 더 이상 갈 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400710305,
					"content": "저기 있는 장치, 우리가 다가오길 기다리고 있는 거 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710306
					],
					"speakerTitle": "모나"
				},
				{
					"id": 400710306,
					"content": "이곳의 모든 것이… 너무 인위적이지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400710307,
					"content": "신성 왕국이니 네가 이해 좀 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710308
					],
