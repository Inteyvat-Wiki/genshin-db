						],
						"pointId": 330201343
					}
				]
			},
			"dialogs": [
				{
					"id": 735210401,
					"content": "…20년 전의 일 말인가요? 혹시 무슨 이야기라도 들으셨나요? 갑자기 그런 걸 물어보시고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210402
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210402,
					"content": "20년 전에 왕관이 사라졌었다는 이야기를 들었어. 성격이 변해버린 참가자도 있는 것 같고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735210403,
					"content": "꽤 많이 알고 계시는군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210404
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210404,
					"content": "위카스, 혹시 우리한테 숨기는 거 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735210405,
					"content": "딱히 숨겼다고 할 만한 건 아니에요. 애초에 20년 전에 저는 5살이었는데 아는 게 뭐가 있겠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210406
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210406,
					"content": "다만 아무에게도 말하지 않은 이야기가 있기는 해요. 사실 제가 축제 준비 위원회에 들어온 건 어떤 선배 때문이었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210407
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210407,
					"content": "그 선배와는 여행 중에 알게 된 사이였는데, 조금… 겁이 많은 사람이었어요. 돌발 상황이 발생하면 늘 가장 먼저 숨어버렸죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210408
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210408,
					"content": "4년 전 어느 날, 저는 선배에게 아카데미아 축제가 곧 열리니 아카데미아로 돌아가고 싶다고 말했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210409
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210409,
					"content": "그런데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735210410,
					"content": "아카데미아 축제라는 말에 선배는 화들짝 놀라는 것 같았어요. 「나랑은 상관없는 일이야」 같은 말도 했었고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210411
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210411,
					"content": "그날 밤 작별 인사를 하려는데, 선배가 갑자기 술을 마시자고 하더라고요. 그리곤 술에 취하자 이상한 말을 해댔어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210412
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210412,
					"content": "당시에는 저도 적지 않게 취한 상태라 뭐라고 하는지 제대로 듣진 못했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210413
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210413,
					"content": "기억나는 거라고는 통찰의 왕관이 한동안 사라졌었다는 것뿐이에요. 당시 선배는 통찰의 왕관의 배부와 회수를 맡고 있던 터라 걱정돼 죽을 뻔했지만, 다행히 어떤 나무 구멍에서 찾았다고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210414
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210414,
					"content": "전에 들었던 거랑 똑같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210415
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735210415,
					"content": "선배는 통찰의 왕관이 수많은 문헌에 기록되어 있는 귀중한 보물이라고 했어요. 전설에 따르면 고대의 유명한 장인이 만든 것인 데다, 누구에게도 알려지지 않은 비밀이 숨겨진 물건이라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210416
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210416,
					"content": "사카인은 왕관을 아카데미아에 맡긴 것뿐이었기 때문에, 만약 왕관을 못 찾았으면 그 선배는 전 재산으로도 돈을 변상하지 못했을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210417
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210417,
					"content": "그래서 왕관이 사라진 게 아주 잠시뿐이라고 해도, 그 사실을 남들에게 들켜서는 안 됐어요. 들켰다간 아카데미아는 중대한 과실이라며 처벌을 내렸을 테니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210418
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210418,
					"content": "그래서 그 사건을 은폐한 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210419
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735210419,
					"content": "맞아요. 당시 많은 사람들이 찾아와서 그 일에 대해 물어봤대요. 심지어 어린아이들까지도요…. 하지만 선배는 왕관을 잃어버린 적이 없다는 대답으로 일관했다고 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210420
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210420,
					"content": "하지만 그럼에도 겁이 났던 선배는 사건이 잠잠해진 후에 직장을 그만두고 아카데미아를 떠난 거죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210421
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210421,
					"content": "술을 진탕 마시고 이튿날 일어나보니 선배는 사라지고 없었어요. 나중에 생각해보니, 그런 사람들에게 아카데미아 축제를 맡기면 언젠가는 큰 문제가 생기겠다 싶더라고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210422
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210422,
					"content": "마침 그때는 다른 일자리도 없었기에 축제 위원회에 들어갔어요. 내부에서 당시 사건에 대해 조사를 해봤지만 별 소득은 없었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210423
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210423,
					"content": "왕관도 이미 제자리로 돌아온 데다, 성격이 변했다던 사람은 이미 죽어서 뭘 더 알아볼 수가 없었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210424
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210424,
					"content": "무엇보다 20년이나 지난 일이라 아무도 당시의 일을 기억하거나 신경 쓰지 않았고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210425
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210425,
					"content": "이게 제가 아는 전부예요. 궁금하다면 계속 조사를 해보는 것도 괜찮겠죠. 언젠가 진실을 알게 될 수도 있으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210426
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210426,
					"content": "솔직히 말하면 우리도 더 이상 단서가 없어. 혹시 다른 실마리는 없어? 예를 들면 그 선배가 평소에 어디서 지냈다든가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210427
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735210427,
					"content": "그 선배에 관한 소식은 저도 몰라요. 그 후에 선배를 찾아서 사막에 가보기도 했지만, 그 광활한 모래바다에서 우연히 마주치기란 불가능에 가까우니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210428
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210428,
					"content": "그 대신이라고 하기는 뭐하지만 사카인에 관한 정보는 있는데, 들어보시겠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210429
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210429,
					"content": "으음… 그것도 좋지. 뭔데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210430
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735210430,
					"content": "예전에 여행을 다닐 때 어떤 용병단장과 함께 다녔던 적이 있어요. 그 사람과 대화를 나누던 중, 자기가 어떤 아카데미아 학자가 쓴 논문을 가지고 있다는 이야기를 하더군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210431
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210431,
					"content": "그 사람은 그걸 무슨 보물처럼 여겨서 남에게 쉽게 보여주지 않았어요. 저도 한참을 부탁한 후에야 겨우 살짝 볼 수 있었죠. 그때 내용은 제대로 못 봤지만, 사카인의 서명만큼은 똑똑히 봤어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210432
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210432,
					"content": "당시에는 사카인이 누군지도 몰랐고, 관심도 없었어요. 축제 준비 위원회에 합류한 뒤에야 그가 학부 축제를 후원하는 유명 인론파 학자라는 걸 알게 되었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210433
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210433,
					"content": "혹시 관심 있으면 사막으로 가보세요. 평소에는 다{RUBY#[D]켄리아}흐리 계곡에 머무르고 있으니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210434
					],
					"speakerTitle": "위카스"
				},
				{
					"id": 735210434,
					"content": "사카인과 관련된 정보라 그거지? 알았어, 한번 가볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 7352105,
