						],
						"pointId": 331000111
					}
				]
			},
			"dialogs": [
				{
					"id": 735210501,
					"content": "무슨 일이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210502
					],
					"speakerTitle": "수하입"
				},
				{
					"id": 735210502,
					"content": "으아… 무서운 사람 같아 보여!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735210503,
					"content": "할 말 있으면 하고 없으면 가. 상대해줄 시간 없으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210504
					],
					"speakerTitle": "수하입"
				},
				{
					"id": 735210504,
					"content": "사실 네가 사카인이 쓴 글을 갖고 있단 얘길 들었거든, 그래서 보러 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735210505,
					"content": "…장난치는 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210506
					],
					"speakerTitle": "수하입"
				},
				{
					"id": 735210506,
					"content": "그럴 리가! 왜 그렇게 생각해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735210507,
					"content": "진짜 모르는 모양이군. 얼마 전 감정을 받았는데, 이 글은 평범하게 감상을 적은 여행기에 불과해서 아무런 가치가 없다더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210508
					],
					"speakerTitle": "수하입"
				},
				{
					"id": 735210508,
					"content": "사카인은 한때 내 아버지를 자신의 경호원으로 고용했었어. 걸으면서도 질문을 하고, 뭔가를 끄적이는 정신 사나운 녀석이었다지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210509
					],
					"speakerTitle": "수하입"
				},
				{
					"id": 735210509,
					"content": "한 번은 녀석의 원고가 바람에 날아가 버린 적이 있어. 그는 필요 없다고 했는데, 내 아버지는 똑똑한 사람의 글이니 분명 돈이 될 거라 여겨 한밤중에 횃불을 들고 찾아 헤매기까지 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210510
					],
					"speakerTitle": "수하입"
				},
				{
					"id": 735210510,
					"content": "우리 가족은 글을 모르거든. 그래서 아버지는 그걸 보물로 여기고 내게 물려주기까지 했지. 그런데 아무 가치도 없는 물건이었다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210511
					],
					"speakerTitle": "수하입"
				},
				{
					"id": 735210511,
					"content": "운이 나빴네…. 그 글은 아직 갖고 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735210512
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735210512,
					"content": "어. 보고 싶어? 그럼 그러든가. 돈도 안 되는 물건을 아낄 필요는 없지",
					"roleType": "TALK_ROLE_NPC",
