				"objectNames": [
					"아한가르"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160201,
					"content": "조금만 기다리라니까… 응? 왜 네가 왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160202,
						230160203
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230160202,
					"content": "가르시아 씨 대신 왔어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				},
				{
					"id": 230160204,
					"content": "진짜 혼자 만들고 있었어? 참 이상한 사람이라니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160205
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230160205,
					"content": "오랫동안 대장장이로 일했지만 그렇게 깐깐하게 요구하는 사람은 처음 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160206
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230160206,
					"content": "철관 연결부 사이즈와 나사 홈까지 직접 재다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160207
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230160207,
					"content": "너무 짜증 나서, 그렇게 잘났으면 직접 만들라고 했더니 다음 날 정말 주조 방법을 가르쳐달라고 말하더라니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160208
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230160208,
					"content": "그 열정에 나도 감동해서 하고 싶은 대로 두기로 했어. 재료와 돈만 지불한다면 도구도 마음껏 쓸 수 있도록 해줬고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160209
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230160209,
					"content": "휴, 도대체 뭘 만들려는지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160210,
						230160211
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230160210,
					"content": "아주 위대한 기계를 만들고 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160212,
					"content": "아무래도 상관없어… 어쨌든 이상한 물건이겠지. 주조 방법을 물으러 온 거지? 톱니바퀴 주조 방법에 대해서는 나도 딱히 가르칠 게 없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160213
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230160213,
					"content": "가르시아가 원하는 톱니바퀴는 변두리가 아주 예리한데 중간은 움푹 들어간 모양이더군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160214
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230160214,
					"content": "이런 모양의 톱니바퀴는 거푸집으로 바로 만들 수 없어. 톱니바퀴를 제작한 다음 2차 가공을 해야 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160215
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230160215,
					"content": "어떻게 하는지 이미 알려줬었는데. 이번에 네가 제대로 알려줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160216
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230160216,
					"content": "일단, 두 번째로 용광로에 넣을 때는 <color=#00E1FFFF>연료를 더 많이 넣어야 해</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160217
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230160217,
					"content": "그리고 가공할 땐 <color=#00E1FFFF>안쪽에서부터 바깥쪽으로 내리쳐야 하지</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160218
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230160218,
					"content": "어때? 제대로 배웠어? 그럼 얼른 가서 알려줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160219
					],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230160219,
					"content": "참 이상한 사람이라니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아한가르"
				},
				{
					"id": 230160211,
					"content": "이상한 기계를 만들고 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160203,
					"content": "가르시아 씨는 손에 힘이 풀려서 잠시 쉬고 있어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				}
			]
		},
