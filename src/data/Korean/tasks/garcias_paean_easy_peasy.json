					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230165006,
					"content": "그럼 카이아 씨와 함께 저녁 식사를 할 장소에 대해서 얘기해 보죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165007
					],
					"speakerTitle": "루통"
				},
				{
					"id": 230165007,
					"content": "고마워, 루통",
					"roleType": "TALK_ROLE_NPC",
