			"dialogs": [
				{
					"id": 230160301,
					"content": "루통! 이제 거푸집에서 톱니바퀴를 꺼내면 돼. 얼른 도와줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160302
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230160302,
					"content": "여행자, 마침 자네도 돌아왔군. 아한가르 씨한테서 제대로 알아 왔겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160303
					],
					"speakerTitle": "가르시아"
				},
				{
					"id": 230160303,
					"content": "얼, 얼른 알려줘. 이 톱니바퀴를 어떻게 해야 하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "가르시아"
				}
			]
