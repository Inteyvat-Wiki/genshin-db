				"points": []
			},
			"dialogs": [
				{
					"id": 210350201,
					"content": "후우… 후… 어렵군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350202
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210350202,
					"content": "미안, 형편없는 모습을 보이고 말았네. 진짜 적을 상대할 때 내가 이렇게 긴장할 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350203
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210350203,
					"content": "그러니까 난… 수련을 더 해야겠어. 고마워, 여행자. 답례를 받아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350204
					],
					"speakerTitle": "손우"
				},
				{
					"id": 210350204,
					"content": "진짜 리월을 떠날 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350205
					]
				},
				{
					"id": 210350205,
					"content": "아직 결정하지 못했어. 조금 더 고민해봐야지. 그리고… 사매도 다시 설득해볼 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "손우"
				}
			]
		}
	]
