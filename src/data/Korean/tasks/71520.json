{
	"id": 71520,
	"type": "WQ",
	"name": "제어할 수 없는 규모의 실험",
	"description": "리월 야외에서 어떤 수메르 학자가 한숨을 푹푹 쉬고 있다. 한숨을 쉬는 학자는 이미 여러 번 봐왔지만, 대체 왜 홀로 거기 있는 걸까…",
	"unlockDescription": "",
	"chapter": "",
	"showType": "QUEST_SHOW",
	"activityId": 5138,
	"mainQuestTag": "MAINQUEST_TAG_GUIDE",
	"suggestTrackMainQuestList": [],
	"prevMainQuestList": [],
	"steps": [
		{
			"id": 7152001,
			"order": 1,
			"listShowType": "QUEST_SHOW",
			"description": "한숨 쉬는 학자와 대화하기",
			"finishConditions": [
				{
					"type": "QUEST_CONTENT_COMPLETE_TALK",
					"rawParams": [
						7152001,
						0
					],
					"talkId": 7152001
				}
			]
