			"dialogs": [
				{
					"id": 80070101,
					"content": "한순간에 사라질 줄 알았는데… 할프단의 영혼이 이렇게 강인할 줄이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
