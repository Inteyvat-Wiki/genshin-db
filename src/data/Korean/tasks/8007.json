				},
				{
					"id": 80070907,
					"content": "한 번 더 확인해 보지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070908
					],
					"speakerTitle": "데인슬레이프"
				},
				{
					"id": 80070908,
					"content": "데인도… 엄청 슬프겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070909
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80070909,
					"content": "과거의 전우와 이런 식으로 재회하다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070910
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 80070910,
					"content": "……",
