					"content": "…데인슬레이프!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070105
					],
					"speakerTitle": "심연 사제"
				},
				{
					"id": 80070105,
					"content": "녀석을 해치우고 장치를 꺼!",
					"roleType": "TALK_ROLE_NPC",
