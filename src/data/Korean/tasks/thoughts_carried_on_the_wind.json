					"글로리"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350401,
					"content": "갓윈이 무사하길…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350402
					],
					"speakerTitle": "글로리"
				},
				{
					"id": 411350402,
					"content": "잘 있나 확인 좀 해달라고 갓윈에게 부탁 받았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350403
					]
				},
				{
					"id": 411350403,
					"content": "갓윈? 혹시 그가 어디 있는지 아시나요? 오랫동안 소식이 없어서 걱정하고 있거든요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350404
					],
					"speakerTitle": "글로리"
				},
				{
					"id": 411350404,
					"content": "멀리서 임무 수행 중이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350405
					]
				},
				{
					"id": 411350405,
					"content": "…그래요? 다행이네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350406
					],
					"speakerTitle": "글로리"
				},
				{
					"id": 411350406,
					"content": "운석만 안 떨어졌어도 기사단에 가서 행방을 물어보려 했었어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350407
					],
					"speakerTitle": "글로리"
				},
				{
					"id": 411350407,
					"content": "전 계속 성안에 있어서 괜찮아요. 하지만 갓윈은 야외로 나가 임무 수행 중이잖아요. 세계 곳곳에 운석이 떨어졌다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350408
					],
					"speakerTitle": "글로리"
				},
				{
					"id": 411350408,
					"content": "휴, 갓윈이 무사했으면 좋겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350409
					],
					"speakerTitle": "글로리"
				},
				{
					"id": 411350409,
					"content": "무사할 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350410
					]
				},
				{
					"id": 411350410,
					"content": "감사합니다, 다행이네요. 참, 저 좀 도와주실 수 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350411
					],
					"speakerTitle": "글로리"
				},
				{
					"id": 411350411,
					"content": "제가 플로라 씨한테 민들레 씨앗을 샀거든요. 원래 이 씨앗이 바람을 타고 갓윈에게 닿을 수 있게 높은 곳에서 뿌려주실 분을 찾고 싶었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350412
					],
					"speakerTitle": "글로리"
				},
				{
					"id": 411350412,
					"content": "아시다시피 지금은 상황이 안 좋아서 도와줄 분이 없어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350413
					],
					"speakerTitle": "글로리"
				},
				{
					"id": 411350413,
					"content": "오신 김에 저 대신 이 민들레 씨앗 좀 갓윈에게 전해주실 수 있나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350414
					],
					"speakerTitle": "글로리"
				},
				{
					"id": 411350414,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350415
					]
				},
				{
					"id": 411350415,
