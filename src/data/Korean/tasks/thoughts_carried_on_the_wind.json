				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350101,
					"content": "글로리는 어떤지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350102
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350102,
					"content": "무슨 일이죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350103
					]
				},
				{
					"id": 411350103,
					"content": "넌… 여행자구나, 지금 밖은 위험해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350104
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350104,
					"content": "다치고 싶지 않으면 빨리 몬드성으로 돌아가렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350105
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350105,
					"content": "갓윈 씨는요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350106
					]
				},
				{
					"id": 411350106,
					"content": "난… 난 당분간 안 돌아갈 거야. 나도 페보니우스 기사단인데… 이 시국에 물러설 순 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350107
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350107,
					"content": "사정이 있어서 몬드성에 갈 순 없지만, 그래도 야외에서 도울 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350108
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350108,
					"content": "운석이 떨어진 후 그 영향으로 마물들이 난폭하게 변해버린 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350109
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350109,
					"content": "이대로 뒀다간 큰일 날 거야. 그래서 해치우러 가려던 참이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350110
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350110,
					"content": "혼자서 괜찮겠어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350111
					]
				},
				{
					"id": 411350111,
					"content": "음, 좀 많기는 한데… 조심하면 괜찮을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350112
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350112,
					"content": "그래도 나 혼자라서 처치하는 데 얼마나 걸릴지 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350113
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350113,
					"content": "여행자, 괜찮으면 날 도와 몬스터 영지 좀 소탕해주지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350114,
						411350116
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350114,
					"content": "내게 맡겨요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350115
					]
				},
				{
					"id": 411350115,
					"content": "그럼 부탁할게. 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350116,
					"content": "왜 기사단에 도움을 청하지 않는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350117
					]
				},
				{
					"id": 411350117,
					"content": "기사단이라… 윽, 그건 절대 안 돼…. 말 못 할 사정이 있으니 더는 묻지 말아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350118
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350118,
					"content": "나 좀 도와줘, 마물의 영지를 소탕하는 것도 기사단을 돕는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "갓윈"
				}
			]
		},
		{
