					"갓윈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411350301,
					"content": "마물들 다 처치했니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350302
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350302,
					"content": "이미 처리했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350303
					]
				},
				{
					"id": 411350303,
					"content": "고마워, 여행자. 급한 불은 끈 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350304
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350304,
					"content": "빨리 성으로 돌아가 봐. 이런 상황에 밖을 돌아다니게 해서 정말 미안해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350305
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350305,
					"content": "음, 그리고… 성으로 돌아가면 뭐 좀 확인해줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350306
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350306,
					"content": "간단해! 그냥 보기만 하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350307
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350307,
					"content": "뭔데 그래요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350308
					]
				},
				{
					"id": 411350308,
					"content": "그게, 성으로 돌아가면 글로리가 어떤지 좀 봐줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350309
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350309,
					"content": "아마 계속 성에 있어서 위험하진 않았겠지만, 그래도 안심이 안 돼서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350310
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350310,
					"content": "부탁해, 글로리의 상황 좀 살펴줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350311
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350311,
					"content": "알겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411350312
					]
				},
				{
					"id": 411350312,
					"content": "고마워, 여행자. 참, 있잖아… 글로리한텐 내가 여기 있다고 말하지 말아줘. 그… 그냥 아직 멀리서 임무 수행 중이라고만 해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411350313
					],
					"speakerTitle": "갓윈"
				},
				{
					"id": 411350313,
					"content": "미안해, 꼭 좀 그렇게 전해줘. 부탁 좀 할게. 사정이 있어서 그래. 부탁해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "갓윈"
				}
			]
		},
		{
			"id": 4113504,
			"completionStepIds": [
				4113506
			],
