			"dialogs": [
				{
					"id": 730650201,
					"content": "그래, 뭐 하고 놀 건데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730650202
					]
				},
				{
					"id": 730650202,
					"content": "아란푸라탑이 「열매」를 여러 개 준비했어. 내가 「열매」를 전부 보여주면 나라는 열매의 개수를 세야 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730650203
					],
					"speakerTitle": "아란푸라탑"
				},
				{
					"id": 730650203,
					"content": "정해진 시간이 지나면 아란푸라탑이 「열매」를 다 치우고 금빛의 나라에게 아란푸라탑이 생각하는 「열매」가 몇 개 있었는지 물어볼 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730650204
					],
					"speakerTitle": "아란푸라탑"
				},
				{
					"id": 730650204,
					"content": "착한 나라야, 준비됐어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730650205
					],
					"speakerTitle": "아란푸라탑"
				},
				{
					"id": 730650205,
					"content": "시작하자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
