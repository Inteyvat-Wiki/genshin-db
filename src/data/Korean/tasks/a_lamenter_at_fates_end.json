			"dialogs": [
				{
					"id": 80110101,
					"content": "저건… 카리베르트가 아닌데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110102,
						80110103
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80110102,
					"content": "아닌 것 같네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				},
				{
					"id": 80110104,
					"content": "그래, 팔에 달린 스카프는 내가 카리베르트의 엄마에게 줬던 선물이야. 지금은 표식용으로 쓰고 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110105
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80110105,
					"content": "내 눈도 다 닳은 모양이군. 아들도 못 알아보다니… 후우",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110106,
						80110107
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80110106,
					"content": "근데 저 츄츄족은…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110108,
					"content": "그래, 우리에게 관심도 주지 않고 저쪽으로 가다니… 저쪽에 뭔가 있나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110109,
						80110110
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80110109,
					"content": "글쎄요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110111,
					"content": "좋아, 츄츄족에 관해서… 많이 알수록 좋지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아이드"
				},
				{
					"id": 80110110,
					"content": "따라가 보죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110107,
					"content": "조금 이상하네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110103,
					"content": "팔에 스카프가 없네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				}
			]
		},
		{
			"id": 801102,
			"completionStepIds": [
				801104
			],
