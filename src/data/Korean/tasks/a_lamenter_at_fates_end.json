			"dialogs": [
				{
					"id": 80110301,
					"content": "멈춰라, 인간. 그대들은 「운명」의 탐구를 허락받지 못하였노라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110302
					],
					"speakerTitle": "운명의 사도"
				},
				{
					"id": 80110302,
					"content": "(심연 사도? 아니, 심연 교단에서 이런 녀석은 본 적이 없는데…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110303
					]
				},
				{
					"id": 80110303,
					"content": "굳이… 「알현」하겠다는 것이냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110304
					],
					"speakerTitle": "운명의 사도"
				},
				{
					"id": 80110304,
					"content": "…그래도 상관없다면, 그대들에게 「운명의 시련」을 하사하겠노라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "운명의 사도"
				}
			]
		},
		{
