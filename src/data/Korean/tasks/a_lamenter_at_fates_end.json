					"nextDialogs": [
						80110636
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80110636,
					"content": "가면을 벗으면 안 된단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110637
					],
					"speakerTitle": "아이드"
				},
				{
