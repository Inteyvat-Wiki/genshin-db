			"trigger": {
				"objectNames": [
					"아이드"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110201,
					"content": "음산한 곳이군…. 옛날에도 있었나? 한 번도 본 적 없는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110202,
						80110203
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80110202,
					"content": "저길 봐요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				},
				{
					"id": 80110204,
					"content": "음… 저건? 뭔가를 숭배하는 건가? 걷다가 또 무릎 꿇고 경배하다가…. 아주 경건해 보이는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110205
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80110205,
					"content": "이런 장면은 처음이야. 이곳에 대체 뭐가 숨겨져 있는 걸까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110206
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80110206,
					"content": "확인해 보는 수밖에 없겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110207
					],
					"speakerTitle": "아이드"
				},
				{
					"id": 80110207,
					"content": "(이 분위기랑 기괴한 광경은 설마…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110203,
					"content": "저 츄츄족들이 뭘 하는 걸까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				}
			]
		},
