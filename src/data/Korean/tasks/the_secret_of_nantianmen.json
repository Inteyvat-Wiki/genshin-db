			"dialogs": [
				{
					"id": 718080301,
					"content": "돌아왔군요, 상황은 좀 어떤가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080302
					],
					"speakerTitle": "가의"
				},
				{
					"id": 718080302,
					"content": "남천문의 상황에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080303
					]
				},
				{
					"id": 718080303,
					"content": "지진과 마물, 그리고 소녀라… 집을 잃어버린 아이인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080304
					],
					"speakerTitle": "가의"
				},
				{
					"id": 718080304,
					"content": "그 소녀가 했던 말에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080305
					]
				},
				{
					"id": 718080305,
					"content": "그 소녀가 뭐라고 했나요? 「그분」의 부활? 확인? 왠 뚱딴지 같은 소린지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080306
					],
					"speakerTitle": "가의"
				},
				{
					"id": 718080306,
					"content": "무슨 이상한 책을 봤나 봐요…. 바로 사람을 보내서 그 아이를 성으로 데려와야겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080307
					],
					"speakerTitle": "가의"
				},
				{
					"id": 718080307,
					"content": "지진에 마물까지… 그 아이가 무사해야 되는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080308
					],
					"speakerTitle": "가의"
				},
				{
					"id": 718080308,
					"content": "고마워요, 이거 받아둬요. 다녀오느라 고생 많았어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080309
					],
					"speakerTitle": "가의"
				},
				{
					"id": 718080309,
					"content": "휴, 일이 줄지가 않네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "가의"
				}
