			"dialogs": [
				{
					"id": 718080201,
					"content": "다시 깨어날 때가 되면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080202
					],
					"speakerTitle": "옥구"
				},
				{
					"id": 718080202,
					"content": "너 괜찮아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080203
					]
				},
				{
					"id": 718080203,
					"content": "「그분」의 부활을 확인하려고 왔구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080204
					],
					"speakerTitle": "옥구"
				},
				{
					"id": 718080204,
					"content": "근데 좀 이르긴 하네…. 근데 또 넘 늦지도 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080205
					],
					"speakerTitle": "옥구"
				},
				{
					"id": 718080205,
					"content": "뭐라는 거야, 하나도 못 알아듣겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 718080206,
					"content": "윽, 뭐라고 했어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080207
					]
				},
				{
					"id": 718080207,
					"content": "허허, 아직도 깨닫지 못하다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080208
					],
					"speakerTitle": "옥구"
				},
				{
					"id": 718080208,
					"content": "하지만 그게 좋을 수도 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080209
					],
					"speakerTitle": "옥구"
				},
				{
					"id": 718080209,
					"content": "돌아가, 「그분」이 깨어나면 모든 걸 알게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "옥구"
				}
			]
		},
