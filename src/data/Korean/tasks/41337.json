						413370604
					]
				},
				{
					"id": 413370604,
					"content": "아직 여길 기억하고 있는 고화파 사람이 있다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370605
					],
					"speakerTitle": "지약"
				},
				{
					"id": 413370605,
					"content": "왔을 때 주변에 아무도 없어서 좀 속상했는데…",
