				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"손우"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413370401,
					"content": "고마워. 이제 소등을 만들 수 있겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370402
					],
					"speakerTitle": "손우"
				},
				{
					"id": 413370402,
					"content": "소등이 완성됐어. 사매가 글씨를 잘 쓰니까 이따 소등에 소원을 적어줘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370403
					],
					"speakerTitle": "손우"
				},
				{
					"id": 413370403,
					"content": "알았어요, 쓰면 되잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370404
					],
					"speakerTitle": "소작아"
				},
				{
					"id": 413370404,
					"content": "사매… 혹시 기분이 안 좋아? 왜 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370405
					],
					"speakerTitle": "손우"
				},
				{
					"id": 413370405,
					"content": "기분이 안 좋긴요. 사형을 도와 소등을 날릴 수 있어서 얼~ 마나 기쁜데요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370406,
						413370407
					],
					"speakerTitle": "소작아"
				},
				{
					"id": 413370406,
					"content": "에… 에헴! 소등은 어디서 날릴 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370408
					]
				},
				{
					"id": 413370408,
					"content": "이 친구 말이 맞아. 소등 날릴 준비해야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370409
					],
					"speakerTitle": "손우"
				},
				{
					"id": 413370409,
					"content": "사형 혼자 가세요. 전 안 갈래요. 등산은 피곤해서 싫어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370410
					],
					"speakerTitle": "소작아"
				},
				{
					"id": 413370410,
					"content": "어… 방금 여기서 한참 쉬었잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370411
					],
					"speakerTitle": "손우"
				},
				{
					"id": 413370411,
					"content": "산바람을 맞아서 그런지 머리가 좀 아프네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370412
					],
					"speakerTitle": "소작아"
				},
				{
					"id": 413370412,
					"content": "뭐…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370413,
						413370414
					],
					"speakerTitle": "손우"
				},
				{
					"id": 413370413,
					"content": "제, 제가 대신 날릴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
					"id": 413370415,
					"content": "어… 휴, 그럼 부탁하네. 원래는 특별한 곳에 가서 날리려고 했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370416
					],
					"speakerTitle": "손우"
				},
				{
					"id": 413370416,
					"content": "예전에 고화파가 아직 있었을 때… 해등절만 되면 사부님께서 우릴 데리고 거기서 등을 날렸거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370417
					],
					"speakerTitle": "손우"
				},
				{
					"id": 413370417,
					"content": "하지만 지금은 문파가 쇠락해서 고화파 사람들이 그곳에서 소등을 날린지도 아주 오래됐지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370418
					],
					"speakerTitle": "손우"
				},
				{
					"id": 413370418,
					"content": "자네가 도와주겠다고 하면, 나 대신 그곳에 가서 소등을 날려줬으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370419
					],
					"speakerTitle": "손우"
				},
				{
					"id": 413370419,
					"content": "위치를 표시해뒀어. 그럼 난 먼저 우리 사매를 보살필게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "손우"
				},
				{
					"id": 413370414,
					"content": "제가 도와줄게요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413370415
					]
				},
				{
