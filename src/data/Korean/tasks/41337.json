					"nextDialogs": [
						413370606
					],
					"speakerTitle": "지약"
				},
				{
					"id": 413370606,
					"content": "아직 이곳을 기억하고 있는 고화파 사람이 있다니까 기분이 훨씬 나아졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413370607
					],
					"speakerTitle": "지약"
				},
				{
