		{
			"id": 4133704,
			"completionStepIds": [
				4133704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133704",
							"2"
						],
						"stepId": 4133704,
						"stateName": "QUEST_STATE_UNFINISHED"
