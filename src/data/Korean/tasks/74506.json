					}
				]
			},
			"dialogs": [
				{
					"id": 745060201,
					"content": "사진사진사진… 소재소재소재… 모라모라모라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060202
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060202,
					"content": "앗! 대단한 분이 떴다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060203
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060203,
					"content": "안녕하세요, 두 분! 괜찮으시다면 사진 한 장 찍어도 될까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060204
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060204,
					"content": "엥… 설마 우릴 부르는 건가? 우리 사진을 찍겠다는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060205,
						745060206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060205,
					"content": "안 될 건 없지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060207
					]
				},
				{
					"id": 745060207,
					"content": "헤헤… 나서서 사진을 찍어주겠다는 사람이 있다니, 우리 유명인 다 됐나 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060208,
					"content": "하지만 우리 사진을 다른 곳에 쓸 거면, 폰타인의 방식대로 우리한테… 음… 모델료? 출연료를 지불해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060209,
					"content": "좋아요! 두 분의 사진을 찍는 건 제 영광이니까요. 사진 한 장에 150만 모라는 어때요, 존귀하신 모험가 콤비님들?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060210
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060210,
					"content": "좋아, 좋아! 진작 그랬어야지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060211,
					"content": "엥, 잠깐. 얼마라고? 150만 모라? 내가 잘못 들은 거 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060212,
					"content": "사진 한 장에 150만 모라라니… 너무 과하지 않아? 우리 둘의 이미지가 그 정도로 비싸다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060213,
						745060214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060213,
					"content": "몇 장이든 더 찍으세요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060215
					]
				},
				{
					"id": 745060215,
					"content": "하하! 150만 모라 정도는 별것도 아니에요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060216
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060216,
					"content": "저와 손을 잡으시면 사진기로 사진만 대충 찍어도… 모라를 아홉 자리 숫자쯤은 쉽게 벌 수 있답니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060217
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060217,
					"content": "아홉 자리… 일, 십, 백, 천, 만… 십만, 백만, 천만… 그, 그, 그렇게나 많이?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060218,
						745060219
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060218,
					"content": "너무 말도 안 되는 숫자잖아요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060220
					]
				},
				{
					"id": 745060220,
					"content": "맞아! 너무 과하잖아! 그런 말은 아무리 나라도 안 믿는다고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060221,
					"content": "설마 사기꾼은 아니겠지? 우리 둘의 이름을 내세워서 사기라도 치려는 거야!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060222
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060222,
					"content": "사기요? 하하, 주제를 제대로 맞히셨네요——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060223
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060223,
					"content": "다만 정반대로 제가 하려는 일은 사기꾼 녀석들을 티바트 대륙에서 몰아내는 거예요. 그리고 저를 도와주시면 여러분께도 두둑히 챙겨드릴게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060224
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060224,
					"content": "잠깐, 천천히 얘기해 봐! 대화를 못 따라가겠다고…. 넌 길에서 사진만 찍고 있잖아, 그런데 왜… 범죄를 해결한다는 것처럼 말해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060225
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060225,
					"content": "그걸 설명하려면 사람들이 쉽게 간과하는 경비 장치의 「목표 식별」 능력부터 얘기해야겠네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060226
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060226,
					"content": "경비 장치가 불법 행위를 단속하려면 우선 상대방이 범죄자인지를 확인해야 한다는 건 아시죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060227
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060227,
					"content": "좋은 사람을 나쁜 사람으로 오해하든, 무기를 소지한 잠재적 범죄자를 놓치든, 다 심각한 문제로 이어질 수 있으니까요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060228
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060228,
					"content": "낚시꾼의 낚싯대를 창으로 착각하거나 파이프로 위장한 무기를 그냥 지나친다고 생각해 보세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060229
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060229,
					"content": "듣고 보니 일리 있네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060230
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060230,
					"content": "만약 제가 놀이공원에서 뛰쳐나온 연극 배우처럼 고양이나 강아지, 참새나 비둘기, 또는 탱탱 물범의 탈을 쓴다면 경비 장치는 어떻게 대처해야 할까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060231,
						745060232
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060231,
					"content": "놀이공원이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060233
					]
				},
				{
					"id": 745060233,
					"content": "그, 그건 반칙이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060234
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060234,
					"content": "네가 말한 동물들은 다 귀여우니까 경비 장치가 공격하진 않겠지! 그리고 탱탱 물범이 성안에 나타날 리 없잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060235
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060235,
					"content": "딩동댕! 포인트를 잘 짚으셨네요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060236
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060236,
					"content": "사실상 성안의 경비 장치는 그런 동물을 목표물로 삼지 않아요. 탱탱 물범은 특히 더 그렇구요. 이미지를 식별하는 과정에서 바로 건너뛰어 버리죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060237
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060237,
					"content": "장치의 운행 효율을 고려해 만날 가능성이 극히 낮은 목표물을 리스트에서 제외하면 업무 효율을 높일 수 있으니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060238
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060238,
					"content": "「경비 장치의 약점을 알아낸 관찰력이 뛰어난 범죄자들이 탱탱 물범으로 위장해 도둑질을 했다…」라는 기사가 전에 《스팀버드》에도 났었구요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060239
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060239,
					"content": "「경비 장치는 그들을 공기 취급했고, 그들의 범죄 행위를 저지하지 않았다」고 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060240,
						745060241
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060240,
					"content": "교활해요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060242
					]
				},
				{
					"id": 745060242,
					"content": "범죄자들이 탱탱 물범인 척하며 범죄를 저질렀는데, 경비 장치는 그걸 놔뒀다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060243
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060243,
					"content": "곰곰이 생각해 보니 화가 나면서도 좀 무섭네…. 그 녀석들이 도둑질을 넘어서 더 나쁜 짓을 저지르기라도 하면… 정말 최악이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060244
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060244,
					"content": "즉, 이건 이미지 식별에 관한 싸움이에요. 범죄자의 위장 기술이 발전할수록 점점 치열해질 테고 결국엔 기술 전쟁으로 번지겠죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060245
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060245,
					"content": "폰타인의 치안을 위해——「이미지 식별학」 엔지니어인 저 르핀 폴린이 나서겠어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060246
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060246,
					"content": "그래서 전 다양한 이미지 샘플을 수집하고 있어요. 대량의 샘플을 기반으로 간결하고 효율적이며 정확한 이미지 식별 알고리즘을 짜고 그걸로 소형 보조 장치를 제작할 거예요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060247
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060247,
					"content": "그걸 태엽 장치에 설치하기만 하면, 위장을 간파하고 정확하게 범죄자를 식별하는 능력을 갖추게 되는 거죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060248
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060248,
					"content": "그렇게만 되면 멜모니아궁은 치안을 유지하기 위해 모든 경비 장치를 업그레이드할 테니까… 이건 부자가 될 기회예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060249,
						745060250
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060249,
					"content": "그래서 길거리를 찍고 있었군요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060251
					]
				},
				{
					"id": 745060251,
					"content": "뭔가 익숙한 예감이 드는데… 너처럼 연구만 하는 사람은 대부분 야외활동에 약하지. 그래서 너도 시내에서만 샘플을 수집하는 거고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060252
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060252,
					"content": "우리에게 부탁하려는 게 너 대신 사진도 찍고 더 많은 샘플을 수집해 달라는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060253
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060253,
					"content": "흠흠… 정답이에요! 역시 최고의 모험가 파트너답게 제가 바라는 걸 바로 알아채시네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060254
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060254,
					"content": "자, 제 프로젝트에 합류해서 함께 「이미지 식별」 전문가가 되어 범죄자들의 속임수를 간파하자구요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060255
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060255,
					"content": "게다가 저와 함께 「이미지 식별」에 참여하시면 폰타인의 기술 발전과 치안에 큰 기여를 할 수 있답니다. 부와 명예를 한꺼번에 챙기는 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060256
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060256,
					"content": "음… 상당히 가치 있는 연구네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060257
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060257,
					"content": "모라는 둘째 치고 이런 상황에서 우리가 가만히 있을 순 없지…. 범죄자들이 탱탱 물범의 이름을 더럽히게 두진 않겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060258,
						745060259
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745060258,
					"content": "가만히 있을 순 없어!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060260
					]
				},
				{
					"id": 745060260,
					"content": "시원시원해서 좋네요! 그럼 우린 이제 한 팀이에요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060261
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060261,
					"content": "자, 이 예비용 「이미지 식별 샘플 수집 장치」를 챙겨 가세요. 제가 정성껏 제작한 기록과 분석 장치… 그리고 특별 매뉴얼이 탑재되어 있어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060262
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060262,
					"content": "사전에 각 지역의 자료들을 비교하면서 중요한 샘플의 특징을 요약해 뒀으니, 매뉴얼을 따라 촬영하신 다음 사진을 저에게 주시면 돼요. 참 쉽죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060263
					],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060263,
					"content": "「이미지 식별」 전쟁의 승리를 위해, 그리고 앞으로 쏟아질 주문들을 위해… 같이 힘내요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "르핀 폴린"
				},
				{
					"id": 745060259,
					"content": "모라를 나눠 받을 수 있다면 더 좋고!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060260
					]
				},
				{
					"id": 745060250,
					"content": "샘플 수량이 부족할 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060251
					]
				},
				{
					"id": 745060241,
					"content": "너무 비겁해요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060242
					]
				},
				{
					"id": 745060232,
					"content": "동물로 위장한다고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060233
					]
				},
				{
					"id": 745060219,
					"content": "그런 거짓말은 안 믿어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060220
					]
				},
				{
					"id": 745060214,
					"content": "수상한데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060215
					]
				},
				{
					"id": 745060206,
					"content": "다른 용도로 쓸 거면 돈 내세요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060207
					]
				}
			]
		}
	]
