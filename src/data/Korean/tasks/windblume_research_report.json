				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000601,
					"content": "사진을 다 찍었니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000602
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 700000602,
					"content": "다 찍었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000603
					]
				},
				{
					"id": 700000603,
					"content": "음, 잘 찍었구나. 연구에 유용하게 쓰이겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000604
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 700000604,
					"content": "이런 아름다운 장면을 보니… 내 고향 수메르의 축제가 떠오르네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000605
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 700000605,
					"content": "수메르에는 어떤 축제가 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000606
					]
				},
				{
					"id": 700000606,
					"content": "아, 넌 모르겠지. 우린 매년 「화신(花神) 탄신일」을 거행한단다. 「작은 쿠사나리 화신(化神)」의 탄신일을 기념하는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000607
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 700000607,
					"content": "근데 분위기는 몬드성의 윈드블룸 축제와 좀 달라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000608
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 700000608,
					"content": "그러고 보니… 올해는 화신(花神) 탄신일에 참가하지 못했구나. 휴, 너무 오래 나와 있었어. 아카데미아는 요새 어떤 상황일까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000609
					],
					"speakerTitle": "사이드"
				},
				{
					"id": 700000609,
					"content": "얘기가 엉뚱한 방향으로 흘렀네. 어쨌든 도와줘서 고마워. 이건 보수야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "사이드"
				}
			]
		}
	]
