			"dialogs": [
				{
					"id": 111010201,
					"content": "이 《호법선중야차록》만 필요하신 건가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010202
					],
					"speakerTitle": "기향"
				},
				{
					"id": 111010202,
					"content": "네, 잔돈은 됐어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010203
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111010203,
					"content": "통이 아주 크시네요… 감사합니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010204
					],
					"speakerTitle": "기향"
				},
				{
					"id": 111010204,
					"content": "저 사람 「칠뜨기천군」 아니야? 여기서 또 만났네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010205,
						111010206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111010205,
					"content": "「철성확진천군」이야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				},
				{
					"id": 111010207,
					"content": "저 사람이 방금 샀던 책이… 《호법선중야차록》이었던 거 같은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111010208,
					"content": "선인과 관련된 책이었던 것 같아. 선인이 어째서 자신에 관한 책을 사는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010209,
						111010211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111010209,
					"content": "어쩐지 수상했어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010210
					]
				},
				{
					"id": 111010210,
					"content": "엥, 그랬어? 어디가 수상했는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111010214,
					"content": "선인한테 그 많은 돈이 왜 필요한 걸까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010215
					]
				},
				{
					"id": 111010215,
					"content": "아… 듣고 보니 그렇네. 보통 선인들은 욕심이 없어 보이잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111010220,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111010221,
					"content": "책 내용을 확인해볼 필요가 있겠어. 뭔가 약점을 잡을 수 있을지도 몰라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111010216,
					"content": "사기꾼의 수법 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010217
					]
				},
				{
					"id": 111010217,
					"content": "그러니까… 저 사람에겐 소원을 들어줄 힘이 없다는 뜻이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111010218,
					"content": "가면이 너무 흉해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010219
					]
				},
				{
					"id": 111010219,
					"content": "아! 진짜 흉하지! 정말 수상한데!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111010211,
					"content": "자뻑 아닐까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010212
					]
				},
				{
					"id": 111010212,
					"content": "그 말도 일리 있네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010213
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111010213,
					"content": "근데 생각해보면, 저 선인은 항상 좀 이상했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111010206,
					"content": "이게 바로 「선인과의 인연」인 걸까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				}
			]
		},
