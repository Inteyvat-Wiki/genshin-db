				},
				{
					"id": 730171209,
					"content": "반드시 좋아질 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171210
					]
				},
				{
					"id": 730171210,
					"content": "#맞아, 나랑 {NICKNAME}도 도울게!",
