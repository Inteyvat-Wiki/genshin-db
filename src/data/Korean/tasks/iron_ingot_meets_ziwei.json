				"points": []
			},
			"dialogs": [
				{
					"id": 413330701,
					"content": "이 각도… 이 별자리… 강아지 같이 생겼는데… 이름을 뭐로 짓는 게 좋을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330702
					],
					"speakerTitle": "자미"
				},
				{
					"id": 413330702,
					"content": "오, 철괘아구나? 무슨 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330703
					],
					"speakerTitle": "자미"
				},
				{
					"id": 413330703,
					"content": "음… 그게… 그냥… 리월항 밖을 걷다가 우연히 좋은 곳을 발견했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330704
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330704,
					"content": "좋은 곳? 별 보기 좋은 곳이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330705
					],
					"speakerTitle": "자미"
				},
				{
					"id": 413330705,
					"content": "응, 별 보기도 좋고 소등 띄우기도 좋은 곳이야. 소등도 내가 준비해놨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330706
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330706,
					"content": "봐, 위에 내가 시를… 시를 한 수 써봤어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330707
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330707,
					"content": "「철삽과 운석이 만나 무수한 불꽃을 튀긴다」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330708
					],
					"speakerTitle": "자미"
				},
				{
					"id": 413330708,
					"content": "음… 네가 무슨 소원을 빌고 싶은지 모르겠지만 꽤 재밌는 시네~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330709
					],
					"speakerTitle": "자미"
				},
				{
					"id": 413330709,
					"content": "하지만 소등에 적힌 소원을 먼저 보여줘버리면 효과가 없을걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330710
					],
					"speakerTitle": "자미"
				},
				{
					"id": 413330710,
					"content": "그리고 나는 무슨 일로 찾아온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330711
					],
					"speakerTitle": "자미"
				},
				{
					"id": 413330711,
					"content": "난…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330712,
						413330713
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330712,
					"content": "그가 소등 띄우기 딱 좋은 장소를 찾았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				},
				{
					"id": 413330714,
					"content": "소등? 앗… 미안, 사실 난 지금 소등이 적은 곳을 찾고 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330715
					],
					"speakerTitle": "자미"
				},
				{
					"id": 413330715,
					"content": "소등 불빛 때문에 별이 잘 안 보여서 좀 멀리 가볼까 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330716
					],
					"speakerTitle": "자미"
				},
				{
					"id": 413330716,
					"content": "신경 써 줘서 고마워. 그럼 난 가던 길 가 볼게. 해등절 즐겁게 보내렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330717
					],
					"speakerTitle": "자미"
				},
				{
					"id": 413330717,
					"content": "아… 앗?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330718,
						413330719
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330718,
					"content": "가버렸어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330720,
					"content": "나… 난 괜찮아. 너무 모호하게 써서 자미가 못 알아봤나 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330721
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330721,
					"content": "걱정 마, 기 안 죽어. 언젠가… 그녀가 내 마음을 알아줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330722
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330722,
					"content": "여행자, 도와줘서 고마워. 이 물건들 받아주겠니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330723
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330723,
					"content": "휴, 난 이 소등이라도 날려야지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330719,
					"content": "기죽지 마요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330720
					]
				},
				{
					"id": 413330713,
					"content": "소등 띄우려면 같이 가는 게 좋을 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330714
					]
				}
			]
