				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413330201,
					"content": "「철괘아와 자미가 만나」… 안 돼, 안 돼! 너무 직접적이잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330202
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330202,
					"content": "응? 언제 왔어? 장소는 둘러봤어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330203
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330203,
					"content": "다 둘러봤어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330204
					]
				},
				{
					"id": 413330204,
					"content": "이렇게 빨리? 어디 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330205
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330205,
					"content": "흠… 보자, 하나는 겹겹이 쌓인 독특한 풍경이고, 또 하나는 들쭉날쭉한 운치 있는 풍경이라…. 「가로로 보면 완만한 산줄기지만, 옆에서 보면 험준한 산봉우리니」… 다음 문장은 뭐지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330206
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330206,
					"content": "…뭐 괜찮아, 직접 가 보는 게 당당하고 패기 넘쳐 보이겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330207
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330207,
					"content": "좋아! 어디 가야할 지 알겠어…. 여행자, 또 하나 도와줬으면 하는 게 있는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330208
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330208,
					"content": "형제들이 다른 사람과 이야길 할 땐 먹을 걸 준비하는 게 좋다고 했거든, 자미랑 대화하면서 먹을 거로 뭘 준비해 가는 게 좋을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330209,
						413330211
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330209,
					"content": "흘호어 구이요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330210
					]
				},
				{
					"id": 413330210,
					"content": "흘호어 구이라…. 휴우, 너무 기름지지 않을까? 좀 없어 보이기도 하고… 아니면 행인두부가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330212
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330212,
					"content": "좋아, 행인두부! 적당할 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330213
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330213,
					"content": "여행자, 행인두부 하나 장만해 줘. 난 계속 시상을 생각해봐야 해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413330214
					],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330214,
					"content": "「무수한 불꽃을 튀긴다」…. 이거 괜찮은 걸?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "철괘아"
				},
				{
					"id": 413330211,
					"content": "행인두부요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413330212
					]
				}
			]
		},
