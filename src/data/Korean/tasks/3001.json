					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010610
					]
				},
				{
					"id": 30010610,
					"content": "잠깐, 방금 그건 뭐야? 내가 잘못 본 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010611,
						30010613
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30010611,
					"content": "너도 봤어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010612
					]
				},
				{
					"id": 30010612,
					"content": "응! 작고 동글동글한 게, 야채 같은 모습을 하고 있었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010615
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30010615,
					"content": "방금 진짜 깜짝 놀랐어. 그게 뭐였는지 알아볼 필요가 있을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010616
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30010616,
					"content": "우선 청소부터 시작하자. 내가 날아서 위를 청소할 테니까 넌 아래를 맡아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010617
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30010617,
					"content": "페이몬과 함께 신상을 꼼꼼히 닦기 시작한다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 30010613,
					"content": "양배추였나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010614
					]
				},
				{
					"id": 30010614,
					"content": "맞아! 작고 둥근 게 양배추 같았어. 근데 분명 살아 움직이는 것 같던데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010615
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30010605,
					"content": "「작은 쿠사나리 화신」?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010606
					]
				},
				{
					"id": 30010606,
					"content": "신상의 모습을 보니 이름과 정말 잘 어울리는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010607
					],
					"speakerTitle": "페이몬"
				}
