				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"밸푸어",
					"하니야"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735080101,
					"content": "#덕분에 도움이 많이 됐어, 「은빛 반성」이랑 「금빛 유성」 {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080102
					],
					"speakerTitle": "밸푸어"
				},
				{
					"id": 735080102,
					"content": "너희가 참여한 모든 「버섯몬 기관 대전」 과정을 기록했어, 이 기록을 토대로 많은 데이터를 얻을 수 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080103
					],
					"speakerTitle": "밸푸어"
				},
				{
					"id": 735080103,
					"content": "너희들은 「최고 수준」의 테스터니까, 너희의 기록과 일반 테스터들의 기록을 결합하면 안정적인 개선 방안을 도출할 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080104
					],
					"speakerTitle": "밸푸어"
				},
				{
					"id": 735080104,
					"content": "그리고 전반적인 스타일에 대한 너희들의 최종 의견도 궁금해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080105
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080105,
					"content": "너희 의견은 「버섯몬 기관 대전」 게임 자체뿐만 아니라, 다음 대회의 진행 방식에도 어느 정도 영향을 끼칠 거니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080106
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080106,
					"content": "너희 둘의 선호 플레이 스타일을 알려주면 좋을 것 같아. 예를 들면… 재미 위주라거나, 아니면 경쟁 위주라거나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080107,
						735080112,
						735080117
					],
					"speakerTitle": "밸푸어"
				},
				{
					"id": 735080107,
					"content": "저는 파트너들과의 협력을 중시해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080108
					]
				},
				{
					"id": 735080108,
					"content": "맞아! 경기도 대전도 중요하긴 하지만 우리와 버섯몬 파트너들 사이의 유대감을 더 느낄 수 있으면 좋겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735080109,
					"content": "버섯몬들과의 유대감이라… 알겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080110
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080110,
					"content": "밸푸어 씨, 제가 전에 말했던 가장 중요한 이념이 뭔지 기억하시죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080111
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080111,
					"content": "그럼요! 여행자, 다음 대회에선 소통을 통해 버섯몬 파트너의 전력을 이끌고 협동심을 테스트할 수 있는 도전을 준비할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080121
					],
					"speakerTitle": "밸푸어"
				},
				{
					"id": 735080121,
					"content": "너희 둘은 정말 여전하구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080122
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080122,
					"content": "아무튼 「버섯몬 기관 대전」 테스트가 성공적으로 끝났어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080123,
						735080125
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080123,
					"content": "고생하셨습니다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080124
					]
				},
				{
					"id": 735080124,
					"content": "오예! 일을 끝냈으니 이제 수고비는 우리 거다! 수고한 나에게 맛있는 것을 잔뜩 사줘야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735080127,
					"content": "잠깐, 잠깐… 아니다! 우리는 다음 대회 주최자고 하니야랑 밸푸어는 다음 대회를 준비 중이잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735080128,
					"content": "하니야는 우리의 도우미고, 밸푸어는 일단 우리 직원인 셈이니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735080129,
					"content": "오히려 우리가… 음… 하니야에게는 수고비를, 직원인 밸푸어에게는 급여를 줘야 하는 거 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735080130,
					"content": "아냐, 그렇게까지 해줄 필요는 없어. 내가 자원해서 한 일이고, 얻은 것도 많으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080131
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080131,
					"content": "난 사업가이기도 하니까, 이번 「버섯몬 기관 대전」을 통해 얻은 경험과 이력은 나 같은 사람에게 정말 소중해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080132
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080132,
					"content": "이걸 외부에 공개하면 판권을 사겠다는 사람들이 몰려들걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080133
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080133,
					"content": "게다가 「버섯몬 기관 대전」이 수익을 내기 시작하면 밸푸어 씨도 투자금을 회수할 테고, 그 수입은 대부분 나에게 돌아올 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080134
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080134,
					"content": "난 그 수입의 일부를 다음 대회 자금으로 남겨두고, 나머지는 버섯몬 파트너들을 돌보는 데 쓰려고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080135
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080135,
					"content": "「둥둥 모자」 일행뿐만 아니라 「바람의 무희」 같은 다른 선수들이 맡긴 파트너도 돌봐야 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080136
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080136,
					"content": "한마디로 너희 덕분에 개선된 「버섯몬 기관 대전」은 우리 모두에게 큰 이익을 가져다줄 거고, 그로 인해 버섯몬 파트너들의 복지도 좋아질 거란 말이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080137
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080137,
					"content": "그렇구나… 수입이나 이익 같은 건 잘 모르겠지만, 아무튼 모두에게 득이 됐다는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080138
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735080138,
					"content": "더욱 뿌듯한걸!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735080139,
					"content": "#{NICKNAME}, 나중에 시간 되면 수메르 친구들에게도 「버섯몬 기관 대전」 이야기를 해주자. 더 많은 사람에게 이 게임을 알리는 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080140
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735080140,
					"content": "물론이지!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080141
					]
				},
				{
					"id": 735080141,
					"content": "그럼, 나는 버섯몬 파트너들과 먼저 가볼게. 성 밖에서 조수랑 만나 야영지로 돌아갈 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080142
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080142,
					"content": "야영지를 너무 오래 비워두면, 남아있는 버섯몬들이 걱정할 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080143
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080143,
					"content": "밸푸어 씨는 계속 이곳에서 테스트 버전 「버섯몬 기관 대전」을 홍보할 거야. 원한다면 계속 즐겨도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080144
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080144,
					"content": "맞아, 얼마든지 즐겨 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080145
					],
					"speakerTitle": "밸푸어"
				},
				{
					"id": 735080145,
					"content": "으, 하니야 가는 거야? 「둥둥 모자」랑 다른 버섯몬들도 데려가는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080146
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735080146,
					"content": "「둥둥 모자」랑 좀 더 놀고 싶었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080147
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735080147,
					"content": "하지만… 이번에 하니야를 만나고 조금 안심했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080148
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735080148,
					"content": "버섯몬 파트너들도 모두 건강했고, 우리와의 유대감도 여전한 걸 확인했으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080149
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735080149,
					"content": "걱정 마, 곧 다시 만나게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080150
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080150,
					"content": "너희가 여행을 다녀도 연락 수단이 있잖아. 예를 들어 모험가 길드를 통해 편지를 전한다든가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080151
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080151,
					"content": "다음에 다시 만날 때, 나도 버섯몬 파트너들도 건강한 모습을 보여주겠다고 약속할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080152
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080152,
					"content": "좋은 소식 기다려줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080153
					],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080153,
					"content": "응! 우린 널 믿어, 하니야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080154,
						735080155,
						735080156
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735080154,
					"content": "힘내세요, 하니야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080157
					]
				},
				{
					"id": 735080157,
					"content": "#다음에 만나, 「은빛 반성」 페이몬과 「금빛 유성」 {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "하니야"
				},
				{
					"id": 735080155,
					"content": "버섯몬 파트너들을 잘 부탁해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080157
					]
				},
				{
					"id": 735080156,
					"content": "몸조심하세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080157
					]
				},
				{
					"id": 735080125,
					"content": "수고비 잊으시면 안 돼요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080126
					]
				},
				{
					"id": 735080126,
					"content": "맞아, 맞아. 일하고 번 모라로 사먹는 밥이 더 맛있다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 735080112,
					"content": "전 화려하고 시원시원한 전투가 좋아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735080113
					]
				},
				{
					"id": 735080113,
					"content": "음! 이번에 버섯몬 파트너들이랑 만나고 더욱 확신했어. 버섯몬들과의 유대감은 시간이 지날수록 약해지는 게 아니라 오히려 강해진다는 것을!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735080114
					],
					"speakerTitle": "페이몬"
				},
				{
