			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790330301,
					"content": "어, 보니까 두 사람이 바닥에 누워 있어… 별을 보는 것 같은데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790330302,
					"content": "뭔가 이상한 영상이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790330303,
					"content": "야코프, 대장님이 뭐라고 하셨길래 이렇게 풀이 죽었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790330304,
					"content": "파도가 심하게 치는 바람에 장치를 나르다가 넘어졌는데 다행히 손이 빨라서 장치에는 아무 문제 없었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790330305,
					"content": "그런데 대장님이 우리 소대를 혼내시고는 섬에 가서 장치 신호 수신 테스트나 하래. 그게 제일 힘든 임무인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790330306,
					"content": "괜찮아, 속상해하지 마. 우리가 힘든 일을 안 해본 것도 아니고. 먼저 뭐 좀 먹어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790330307,
					"content": "그렇게 높은 곳을 가리키는 건, 대체 뭘 먹으려는 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790330308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 790330308,
					"content": "설마 이 소라… 잘못 놓은 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
}