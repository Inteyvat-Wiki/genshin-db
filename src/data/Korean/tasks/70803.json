					"사이러스"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708030101,
					"content": "엥? 이 사람은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030102,
						708030103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 708030102,
					"content": "설마 요엘의 아버지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				},
				{
					"id": 708030104,
					"content": "앗! 왔구나, 여행자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030105
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708030105,
					"content": "소개할게. 이분은 요엘의 아버지, 요세프 씨야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030106
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708030106,
					"content": "아빠! 이분이 내가 얘기한 여행자예요. 전에 날 엄청 많이 도와줬고, 이번에 같이 눈사람도 만들었어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030107
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 708030107,
					"content": "요엘한테 얘기 많이 들었어요. 아이고, 정말 고마워요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030108,
						708030109
					],
					"speakerTitle": "요세프"
				},
				{
					"id": 708030108,
					"content": "다시 만나서 다행이에요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030110,
					"content": "맞아, 정말 잘됐다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 708030111,
					"content": "팔라드, 이번에 또 큰 공을 세웠네. 잘했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030112
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 708030112,
					"content": "또? 팔라드가 전에 무슨 공을 세웠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 708030113,
					"content": "전에 내가 설산에서 사람을 봤다고 한 걸 기억해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030114
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708030114,
					"content": "그날 너희가 날 도와 설산에 가서 마물을 처치한 후에, 난 남아서 주변을 수색했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030115
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708030115,
					"content": "수색하다가 산에서 굴러떨어졌는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030116
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708030116,
					"content": "굴, 굴러떨어졌다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 708030117,
					"content": "다행히 아래 눈이 많이 쌓여있어서 다치진 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030118
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708030118,
					"content": "내가 돌아가는 길을 찾고 있을 때, 옆에서 기척이 들리더니 한 사람이 튀어나왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030119
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708030119,
					"content": "처음엔 요세프 씨인 줄 모르고 나처럼 인명구조하러 온 모험가인 줄 알았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030120
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708030120,
					"content": "근데 몇 마디 나눠보니 많은 걸 기억 못 하시더라고. 자신의 이름조차 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030121
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708030121,
					"content": "그때는 어떻게 된 영문인지 생각할 겨를도 없었어. 너무 추웠거든. 그래서 다른 건 제쳐두고 일단 같이 산 너머에 있는 야영지로 돌아가기로 했지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030122
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708030122,
					"content": "캠프에 돌아온 우린 요엘을 만났는데, 요엘은 요세프 씨를 보자마자 잠깐 벙찌더니 「아빠!」하고 외쳤어. 그때 기억이 일부 돌아온 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030123
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708030123,
					"content": "아빠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030124
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 708030124,
					"content": "그래, 요엘, 아빠 여기 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030125
					],
					"speakerTitle": "요세프"
				},
				{
					"id": 708030125,
					"content": "요세프, 정말 다른 건 아무것도 기억 안 나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 708030126,
					"content": "《멧돼지 공주》랑 설산에서 네가 먹이 줬던 여우들도…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 708030127,
					"content": "죄송하지만 기억이 안 나요. 머리에 외상을 입어서 그런가? 잘 모르겠군요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030128
					],
					"speakerTitle": "요세프"
				},
				{
					"id": 708030128,
					"content": "깨어났을 땐 온몸이 피범벅이었어요. 짐도 잃어버렸고, 신분을 증명할 수 있는 것도 없었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030129
					],
					"speakerTitle": "요세프"
				},
				{
					"id": 708030129,
					"content": "그래서 한 동굴로 기어들어 가 천천히 상처를 회복했어요. 다리를 어느 정도 회복한 뒤엔 사냥을 하며 살아남았고요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030130
					],
					"speakerTitle": "요세프"
				},
				{
					"id": 708030130,
					"content": "아빠… 진짜 걱정했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030131
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 708030131,
					"content": "괜찮아, 요엘, 울지 마. 아빠 이제 아무 데도 안 가고 네 옆에만 있을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030132
					],
					"speakerTitle": "요세프"
				},
				{
					"id": 708030132,
					"content": "요세프, 앞으로의 계획은 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 708030133,
					"content": "지금은… 가족이랑 함께 있고 싶군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030134
					],
					"speakerTitle": "요세프"
				},
				{
					"id": 708030134,
					"content": "돌아왔으니 됐네. 만족할만한 결말이로군, 하하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030135
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 708030135,
					"content": "하지만 팔라드, 수색 과정에서 발을 헛디뎌 산에서 굴러떨어지다니. 모험 능력을 좀 더 갈고닦아야겠어……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030136
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 708030136,
					"content": "길드에 돌아가면, 보충 수업을 해주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030137
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 708030137,
					"content": "네? 사, 사이러스 회장님… 저도 공을 세웠는데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030138
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708030138,
					"content": "에잉! 가자고! 길드로!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030139
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 708030139,
					"content": "회장님! 제발 보충 수업만은!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708030109,
					"content": "무사하면 된 거죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030103,
					"content": "어른 버전의 요엘이야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				}
			]
		}
	]
}