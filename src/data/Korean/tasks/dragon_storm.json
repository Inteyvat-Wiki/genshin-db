				"points": []
			},
			"dialogs": [
				{
					"id": 3572301,
					"content": "풍마룡이 결국 도시 내부를 공격하기 시작했어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572302
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3572302,
					"content": "#케이아, {NICKNAME}, 마침 잘 왔어. 어서 빨리…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572303
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3572303,
					"content": "잠시만, 엠버. 일단 소개는 해줘야지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572304
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3572304,
					"content": "아… 맞네. 여긴 케이아 선배, 우리 기병대 대장이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572305
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3572305,
					"content": "이 두 사람은 멀리서 온 여행자야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572306
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3572306,
					"content": "(「멀리서」 온 것만 아는 건가…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572307
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3572307,
					"content": "사건의 전말은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572308
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 3572308,
					"content": "그렇군. 몬드성에 온 걸 환영해. 시기를 잘못 맞추긴 했지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572309
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3572309,
					"content": "가족끼리 헤어진 고통을 나도 잘 알고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572310
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3572310,
					"content": "그리고 너희가 왜 바람의 신을 찾는지는 모르겠지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572311
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3572311,
					"content": "사람들은 모두 자신만의 비밀이 있으니까. 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572312
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3572312,
					"content": "더 캐묻진 않을게, 하하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572313
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3572313,
					"content": "어쨌든 기사단을 대표해서 감사 인사부터 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572314,
						3572315
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3572314,
					"content": "보고만 있을 순 없잖아요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				},
				{
					"id": 3572318,
					"content": "시민들 모두가 방금 전 풍마룡과의 전투를 목격했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572319
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3572319,
					"content": "단장 대행이 너희들한테 관심이 있는 것 같아. 같이 <color=#00E1FFFF>기사단 본부</color>로 한번 가줬으면 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "케이아"
				},
				{
					"id": 3572315,
					"content": "괜찮아요, 그럼 답례는?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572316
					]
				},
				{
					"id": 3572316,
					"content": "음… 몬드의 전통 요리인 허니캐럿그릴?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572317
					],
					"speakerTitle": "케이아"
				},
				{
					"id": 3572317,
					"content": "그 말은 방금 이미 들었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				}
			]
		}
	]
}