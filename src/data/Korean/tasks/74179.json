			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 741790201,
					"content": "(수선화 십자검을 우시아 성질로 전환한다)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741790202
					]
				},
				{
					"id": 741790202,
					"content": "(시간의 척도의 끝에 이르러 우주가 백지와 같아진다면, 과거의 「성검」은 그림자를 드리워 나아갈 방향을 가리킬 것이다)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「작은 분수」"
				}
			]
		},
		{
