			"dialogs": [
				{
					"id": 741790301,
					"content": "(수선화 십자검을 프뉴마 성질로 전환한다)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741790302
					]
				},
				{
					"id": 741790302,
					"content": "(태양이 꺼지고 세계가 어둠에 휩싸여도, 과거의 「성검」은 미약한 빛을 내뿜어 나아갈 길을 밝힐 것이다)",
					"roleType": "TALK_ROLE_NPC",
