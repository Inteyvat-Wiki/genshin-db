			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"캐서린"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050101,
					"content": "미안해, 이렇게 다시 불러서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050102,
						205050104
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050102,
					"content": "괜찮아요, 평소엔 내가 신세를 많이 졌잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050103
					]
				},
				{
					"id": 205050103,
					"content": "그렇게 말해줘서 고마워. 그럼 최대한 간략히 말할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050106,
					"content": "전에 길드의 의뢰를 도와줘서 정말 고마워. 덕분에 모험가 길드의 평판도 점점 좋아지고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050107
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050107,
					"content": "하지만 의뢰를 맡기는 사람도 점점 많아지고 있어서 인력이 많이 부족한 상황이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050108
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050108,
					"content": "우리가 모험가 길드를 홍보해줄까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 205050109,
					"content": "아, 아니. 더 많은 신인들이 길드에 가입하면 좋긴 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050110
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050110,
					"content": "지금에 와서 신인을 찾기엔 너무 늦은 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050111
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050111,
					"content": "네 친구가 우리를 도와줄 시간이 있는지 대신 물어봐 줄 수 없을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050112,
						205050114
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050112,
					"content": "한 번 상의해 볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050113
					]
				},
				{
					"id": 205050113,
					"content": "정말? 너무 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050117,
					"content": "일단 말하자면, 요즘 급한 건 이런 <color=#00E1FFFF>「탐사 파견」</color>이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050118
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050118,
					"content": "「탐사 파견」?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050119
					]
				},
				{
					"id": 205050119,
					"content": "우리는 수시로 도시 주변과 야외를 주시하고 있어. 혹시라도 잠재적인 위험이나 지하 유적에 이상이 생길 수도 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050120
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050120,
					"content": "타인한테서 온 의뢰가 아니라 시간제한은 없지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050121
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050121,
					"content": "바쁜 탓에 장기적으로 방치해 두면 잠복돼 있는 위험 요소들이 거대한 재난으로 번지게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050122
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050122,
					"content": "그렇다면 꽤 중요한 일이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050123,
						205050125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 205050123,
					"content": "친구들이라면 이해해줄 거예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050124
					]
				},
				{
					"id": 205050124,
					"content": "그들이 도와주겠다고 약속만 하면 나머지 일은 나한테 맡기면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050127,
					"content": "그럼 먼저 어떤 「탐사 파견」이 있는지 소개해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050128
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050128,
					"content": "「탐사 파견」을 확인하기",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205050125,
					"content": "보수는요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050126
					]
				},
				{
					"id": 205050126,
					"content": "안심해. 탐색에서 얻는 수확들은 길드에서 한 푼도 받지 않고 다 너희들한테 줄 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050127
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050114,
					"content": "내 친구들이 길드에 가입하길 바라는 거예요?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050115
					]
				},
				{
					"id": 205050115,
					"content": "아니, 오해야. 네 친구들이 각자 신분이 있는 사람들이라는 건 나도 알아. 그들을 전부 길드에 가입시키는 건 현실적이지도 않고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050116
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050116,
					"content": "이게 또 길드의 무리한 부탁인 것 같기도 하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050117
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050104,
					"content": "수령할 수 있는 보수가 생겼나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205050105
					]
				},
				{
					"id": 205050105,
					"content": "하하… 그래 맞아. 보아하니 꽤 관심이 있는 모양이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050106
					],
					"speakerTitle": "캐서린"
				}
			]
		},
		{
			"id": 2050502,
			"completionStepIds": [
				2050502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050502",
							"2"
						],
						"stepId": 2050502,
						"stateName": "QUEST_STATE_UNFINISHED"
