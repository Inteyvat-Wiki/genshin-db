			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"캐서린"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050201,
					"content": "「탐사 파견」은 언제든지 진행할 수 있고, 의뢰에 파견된 동료는 이 기간 동안에도 너와 함께 모험할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050202
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050202,
					"content": "탐사의 정도에 따라 소비하는 시간도 달라져. 탐사를 완료하면 나한테 와서 성과를 확인하기만 하면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050203
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050203,
					"content": "「모험 등급」이 오를수록 더 위험한 곳에 가서 탐사를 진행할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050204
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050204,
					"content": "그러니까 능력이 높을수록 책임도 크다는 거네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 205050205,
					"content": "맞아. 이건 너희들의 안전을 위해서이기도 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050206
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 205050206,
					"content": "아무튼 도와줘서 정말 고마워. 앞으로 동료들과 함께 「탐사 파견」 임무를 많이 진행해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐서린"
				}
			]
		}
	]
}