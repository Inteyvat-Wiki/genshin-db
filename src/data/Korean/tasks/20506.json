			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"데마로우스"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205060201,
					"content": "와! 신기하다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 205060202,
					"content": "지금의 연금술은 그저 고대인들이 남긴 방법들을 모방하고 있는 것뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060203
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 205060203,
					"content": "바람의 날개를 사용할 줄 안다고 해서 그게 어떻게 만들어졌는지는 알 필요 없잖아. 연금술도 마찬가지지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060204
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 205060204,
					"content": "하지만 원리를 깨달았다 싶으면 내 예상을 뛰어넘는 결과가 나와버리니, 휴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060205,
						205060207
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 205060205,
					"content": "연금술은 또 뭘 할 수 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060206
					]
				},
				{
					"id": 205060206,
					"content": "사실 나도 잘 몰라, 하지만 모르니까 궁금한 거 아니겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 205060210,
					"content": "아직은 신기한 제조법들이 많아서 나도 연구 중이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060211
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 205060211,
					"content": "모험을 하면서 아마 연금술에 관한 고대 문명의 기록들을 볼 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060212
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 205060212,
					"content": "「모험 등급」이 오를수록 네가 얻는 제조법도 늘어나겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060213,
						205060215
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 205060213,
					"content": "자세하게 설명해줘서 고마워요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060214
					]
				},
				{
					"id": 205060214,
					"content": "천만에, 나한테도 네 견문과 성과를 알려주는 거 잊지 말렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 205060218,
					"content": "그럼, 다음에 또 보자고. 바람이 너와 함께하길",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 205060215,
					"content": "그때면 페이몬도 만들 수 있겠죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060216
					]
				},
				{
					"id": 205060216,
					"content": "아직도 그 얘기야? 내가 뭐 잘못한 거 있어?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060217
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 205060217,
					"content": "하하, 둘 다 참 재밌군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060218
					],
					"speakerTitle": "데마로우스"
				},
				{
					"id": 205060207,
					"content": "페이몬을 만들 수 있어요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060208
					]
				},
				{
					"id": 205060208,
					"content": "나 하나로 부족한 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 205060209,
					"content": "하하하, 아쉽게도 지금은 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060210
					],
					"speakerTitle": "데마로우스"
				}
			]
		}
	]
