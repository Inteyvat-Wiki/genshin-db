			"dialogs": [
				{
					"id": 728060201,
					"content": "음? 무슨 일로 왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060202
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 728060202,
					"content": "「야에 출판사」 편지와 선물에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060203
					]
				},
				{
					"id": 728060203,
					"content": "「야에 출판사」의 편지? 또 필명을 바꾸라는 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060204
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 728060204,
					"content": "내가 말했잖아, 본명으로 서명하면 된다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060205
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 728060205,
					"content": "됐다, 됐어. 내가 봐야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060206
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 728060206,
					"content": "소설 대회… 심사위원이라, 이건… 내가 시간이 안될지도 모르지만, 우선 호의는 고마워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060207
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 728060207,
					"content": "음? 뒤에 더 있네, 이건… 창작 제안…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060208
					],
					"speakerTitle": "상구야"
				},
				{
					"id": 728060208,
					"content": "음, 내가 자세히 한번 읽어 볼게, 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "상구야"
				}
			]
		},
		{
