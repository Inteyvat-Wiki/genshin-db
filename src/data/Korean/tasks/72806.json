					"행추"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060401,
					"content": "음… 여긴 잘 썼고, 문체가 참신하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060402
					],
					"speakerTitle": "행추"
				},
				{
					"id": 728060402,
					"content": "행추",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060403
					]
				},
				{
					"id": 728060403,
					"content": "그렇군, 그랬어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060404
					],
					"speakerTitle": "행추"
				},
				{
					"id": 728060404,
					"content": "행추!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060405
					]
				},
				{
					"id": 728060405,
					"content": "#어? 너구나, {NICKNAME}. 오랜만이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060406
					],
					"speakerTitle": "행추"
				},
				{
					"id": 728060406,
					"content": "인사하는 말투 들어보니 좋아 보이네, 무슨 일로 날 찾은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060407
					],
					"speakerTitle": "행추"
				},
				{
					"id": 728060407,
					"content": "사실, 사람을 한 명 찾고 있는데, 너는 책을 많이 읽어서 알 수도 있을 거 같아서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 728060408,
					"content": "사람? 작가님이라도 찾고 있는 거야? 음… 누군지 한번 말해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060409
					],
					"speakerTitle": "행추"
				},
				{
					"id": 728060409,
					"content": "「침옥」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060410
					]
				},
				{
					"id": 728060410,
					"content": "「침옥」? 그, 그 이름은 어디서 들은 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060411
					],
					"speakerTitle": "행추"
				},
				{
					"id": 728060411,
					"content": "이 《침추습검록》에 쓰여 있어서…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060412
					]
				},
				{
					"id": 728060412,
					"content": "이 「침옥」이라는 작가를 찾고 있어, 이나즈마의 「야에 출판사」에서 이 작가한테 편지를 보내고 싶어 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 728060413,
					"content": "「침옥」이 누군지 알아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060414
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 728060414,
					"content": "음… 「침옥」은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060415
					],
					"speakerTitle": "행추"
				},
				{
					"id": 728060415,
					"content": "부끄럽지만 사실 내… 필명이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060416
					],
					"speakerTitle": "행추"
				},
				{
					"id": 728060416,
					"content": "엥?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060417
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 728060417,
					"content": "전에 들어 본 적이 없는 것 같은데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060418
					]
				},
				{
					"id": 728060418,
					"content": "뭐… 자랑할 일도 아니어서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060419
					],
					"speakerTitle": "행추"
				},
				{
					"id": 728060419,
					"content": "리월에 있을 때, 내 담당 편집자가 내가 쓴 책이 「설정이 너무 터무니없고 스토리는 너무 진부하여 사람들로부터 외면받을 것」이라는 이유로 내 원고를 거절했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060420
					],
					"speakerTitle": "행추"
				},
				{
					"id": 728060420,
					"content": "그 말을 듣고 믿기지가 않아 몇 권 인쇄해서 좋아하는 사람이 있는지 보려고 몰래 「만문집사」에 뒀는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060421
					],
					"speakerTitle": "행추"
				},
				{
					"id": 728060421,
					"content": "그래도 읽는 사람이 얼마 없어 아무 생각도 안 하고 있었는데, 이 책이 이나즈마에서 이렇게 호평을 받을지 몰랐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060422
					],
					"speakerTitle": "행추"
				},
				{
					"id": 728060422,
					"content": "어쨌든 내가 쓴 책을 읽어주는 사람이 있다는 건 좋은 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060423
					],
					"speakerTitle": "행추"
				},
				{
					"id": 728060423,
					"content": "편지는 잘 읽어 볼게. 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "행추"
				}
			]
		},
