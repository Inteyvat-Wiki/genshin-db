			"dialogs": [
				{
					"id": 200330201,
					"content": "끝이다! 고마워, 이번 호송도 안전하게 잘 끝난 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330202
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200330202,
					"content": "근데 모험가들은 평소에 이런 의뢰밖에 안 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330203,
						200330205
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200330203,
					"content": "다른 의뢰도 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330204
					]
				},
				{
					"id": 200330204,
					"content": "목소리 톤이 왜 그래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 200330207,
					"content": "그렇구나… 알겠어! 그럼 더 열심히 할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330208
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200330208,
					"content": "돈을 많이 모으면, 오빠랑 부모님을 데리고 여행 가야겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330209
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200330209,
					"content": "오빠는 계속 여행 가고 싶어 했는데… 내가 병에 걸려서 어쩔 수 없이 나를 보살폈어야 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330210
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200330210,
					"content": "지금은 몸도 건강해졌고, 모험가가 되었으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330211
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200330211,
					"content": "헤헤, 이제는 오빠의 꿈을 이루어줄 차례야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "안나"
				},
				{
					"id": 200330205,
					"content": "너도 곧 이해할 수 있을 거야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330206
					]
				},
				{
					"id": 200330206,
					"content": "왜 그렇게 피곤한 표정을 짓는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330207
					],
					"speakerTitle": "안나"
				}
			]
		},
