				"points": []
			},
			"dialogs": [
				{
					"id": 200330101,
					"content": "여행자! 이 옷 좀 봐, 어때? 예쁘지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330102
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200330102,
					"content": "이 옷은… 설마?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330103
					]
				},
				{
					"id": 200330103,
					"content": "맞아! 모험가 길드의 시험에 합격했어. 난 이제부터 정식 모험가야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330104,
						200330105
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200330104,
					"content": "정말 멋지다!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				},
				{
					"id": 200330106,
					"content": "헤헤, 고마워. 오빠한테도 한번 도전해보라고 했는데 절대 안 하려고 하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330107
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200330107,
					"content": "난 모험에 큰 흥미가 없어… 게다가 우리 둘 다 모험가가 되면 부모님은 누가 보살필 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330108
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200330108,
					"content": "그럼 엄마 아빠랑 같이 전 세계를 돌아다니면서 함께 여행하는 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330109
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200330109,
					"content": "넌… 됐어, 모험가가 됐으니 네 일에 최선을 다해, 집안일은 내게 맡기고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330110
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200330110,
					"content": "단! 항상 조심해야 해. 절대 다치면 안 되고, 무리하지 마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330111
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200330111,
					"content": "알았어, 알았어! 그럼 난 의뢰 수행하러 갈게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330112
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200330112,
					"content": "나랑 같이 가줄 수 있어? 모험가에 대해서 물어보고 싶은 게 많은데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330113,
						200330114
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200330113,
					"content": "물론이지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330115,
					"content": "좋아, 그럼 어디 보자… 이번 의뢰가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330116
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200330116,
					"content": "화물 열기구 호송하기!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "안나"
				},
				{
					"id": 200330114,
					"content": "그럼 출발하자!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330105,
					"content": "축하해!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				}
			]
		},
