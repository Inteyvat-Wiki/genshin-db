			"dialogs": [
				{
					"id": 200330301,
					"content": "그럼 안나 좀 잘 부탁해, 요즘 기분이 너무 좋아 보이는 거 같아서 걱정이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330302
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200330302,
					"content": "동생이 모험가가 되는 게 싫어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330303
					]
				},
				{
					"id": 200330303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330304
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200330304,
					"content": "난 동생의 꿈을 응원해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330305
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200330305,
					"content": "몸도 건강해졌고, 자신의 꿈을 좇아갈 기회도 얻었으니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330306
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200330306,
					"content": "오빠로서… 최선을 다해서 응원해 줘야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330307
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200330307,
					"content": "그게 다야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "앤서니"
				}
			]
		}
