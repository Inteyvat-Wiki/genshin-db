			"trigger": {
				"objectNames": [
					"페이몬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000101,
					"content": "#내 환각인가, {NICKNAME}… 저 츄츄족들 뭔가 좀 이상해 보이지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000102,
						111000104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111000102,
					"content": "몸에서… 사악한 기운이 나오는 거?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000103
					]
				},
				{
					"id": 111000103,
					"content": "맞아, 그동안 봤던 츄츄족들이 마물이긴 해도 이러진 않았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111000106,
					"content": "앗! 바로 옆이 「망서객잔」이잖아. 그쪽 손님들이 위험하겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111000107,
					"content": "#보고도 모른 척한다면 마음이 편치 않을 거야…. 우리가 해결하자， {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111000104,
					"content": "뭔가 좀 불안해 보여",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000105
					]
				},
				{
					"id": 111000105,
					"content": "맞아, 그들 몸에서 나오던 그 이상한 검은 연기 때문인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000106
					],
					"speakerTitle": "페이몬"
				}
			]
		},
		{
			"id": 1110003,
			"completionStepIds": [
				1110003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
