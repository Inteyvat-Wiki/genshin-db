				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000801,
					"content": "어때? 신도들이 좀 과장을 했겠지만 전부 사실이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000802
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111000802,
					"content": "전부 심리 작용 같은데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000803
					]
				},
				{
					"id": 111000803,
					"content": "하하하… 농담을 참 잘하는군. 사람들이 「량자」라고 부르는 선가의 고수 설무량은 이런 말을 했지——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000804
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111000804,
					"content": "「만물은 본디 하나로 얽혀 있어서, 『심리 작용』 역시 『혼백』과 『사물의 결말』이 이어진 인연의 하나이다…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000805
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111000805,
					"content": "그러니까 그들의 소원은 이미 실현되는 과정에 와있어. 이제 알아듣겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000806
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111000806,
					"content": "무슨 말인지 전혀 모르겠어…. 어쨌든 사람들의 소원이 다 이루어진다는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000807
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111000807,
					"content": "맞아, 요 꼬맹이는 통찰력이 있구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000808
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111000808,
					"content": "근데… 궁금한 게 하나 더 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000809
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111000809,
					"content": "그래? 뭔지 말해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000810,
						111000811
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111000810,
					"content": "왜 가면을 쓰는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000814
					]
				},
				{
					"id": 111000814,
					"content": "난… 세상을 떠돌며 선행을 펼치고 있어. 괜한 사고를 방지하려고 얼굴을 감추는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000815
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111000815,
					"content": "그런 거구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000816
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111000816,
					"content": "그럼 둘의 소원은 뭐지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000817,
						111000819,
						111000821
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111000817,
					"content": "가족의 행방을 알고 싶어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000818
					]
				},
				{
					"id": 111000818,
					"content": "음… 뭔가 가슴 아픈 이야기가 있겠군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111000824,
					"content": "…그래, 그 소원을 들어주는 것도 불가능하진 않아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000825
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111000825,
					"content": "다만… 성의가 좀 부족해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000826
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111000826,
					"content": "성의가… 부족하다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000827
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111000827,
					"content": "선인의 도는 「깨달음」에 있어. 내 말의 뜻을 깨닫지 못한다면 도와주긴 힘들지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000828
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111000828,
					"content": "어쩌지? 저 사람이 말한 성의가 뭔지 아직도 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000829,
						111000830
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111000829,
					"content": "뭔가를 달라는 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000831,
					"content": "앗! 방금 그 신도들이 말했던 것 같아. 선인에게 도움을 청하려면 대가를 지불해야 한다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000832
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111000832,
					"content": "하지만 우리에겐 돈 될 만한 게 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000833
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111000833,
					"content": "게다가 넌 「신의 눈」도 없고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000834,
						111000835
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111000834,
					"content": "신의 눈을 파는 사람은 없겠지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000836,
					"content": "아! 맛있는 걸 만들어서 주면 어떨까? 맛있는 음식의 유혹을 이겨낼 사람은 없잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000837,
						111000838
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111000837,
					"content": "페이몬 머릿속은 온통 그런 거지…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000839,
					"content": "응, 맛있는 거! 분명 성공할 거야, 헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000840
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111000840,
					"content": "빨리 「만문집사」에 가서 요새 유행하는 맛있는 요리 레시피를 찾아보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111000838,
					"content": "맛있는 거!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000835,
					"content": "그러게, 진짜 아쉽다…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000830,
					"content": "모라를 원하는 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000819,
					"content": "신에 필적할 만한 힘을 얻고 싶어요",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						111000820
					]
				},
				{
					"id": 111000820,
					"content": "힘이 있으면 많은 문제가 저절로 해결되지. 근데 신에게 원한이라도 있는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111000821,
					"content": "지금 당장 재벌이 되고 싶어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000822
					]
				},
				{
					"id": 111000822,
					"content": "#뭐? {M#동생}{F#오빠} 안 찾을 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000823
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111000823,
					"content": "응, 모두가 바라는 거지. 넌 리월 사람은 아닌 것 같은데, 리월의 물질만능주의에 젖은 것 같군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "철성확진천군"
				},
				{
					"id": 111000811,
					"content": "가면을 벗어주실 수 있나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000812
					]
				},
				{
					"id": 111000812,
					"content": "야! 너무 무례하잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000813
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 111000813,
					"content": "허허, 좀 그렇긴 하군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000814
					],
					"speakerTitle": "철성확진천군"
				}
			]
