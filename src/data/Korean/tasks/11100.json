					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001005
					]
				},
				{
					"id": 111001005,
					"content": "#난 페이몬이야! 이쪽은 내 길동무 {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
