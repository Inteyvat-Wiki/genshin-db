						413341205
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413341204,
					"content": "여기는 지나가는 사람이 별로 없어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413341206
					]
				},
				{
					"id": 413341206,
					"content": "말도 안 돼, 그럴 리가…. 아냐, 손님을 끄는 방법이 잘못된 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413341207
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413341207,
					"content": "직접 가서 손님을 모으면 좀 더 효과가 있으려나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413341208
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413341208,
					"content": "여행자, 주변에서 손님을 좀 모아줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413341209
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413341209,
					"content": "그러니까… 여긴 음식도 맛있고 환경도 근사해서 해등절을 감상하기엔 딱이라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413341210
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413341210,
					"content": "나도 손님을 잡아 끌 다른 방법이 있는지 더 생각해볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "주 사장"
				},
