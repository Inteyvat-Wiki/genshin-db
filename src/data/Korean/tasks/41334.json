			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"주 사장"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413340101,
					"content": "방법을 생각해야 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340102
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413340102,
					"content": "무슨 방법이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340103
					]
				},
				{
					"id": 413340103,
					"content": "아… 여행자구나. 해등절이잖아.이번 해등절에 돈을 바짝 벌 수 있는 방법을 생각해야 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340104
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413340104,
					"content": "봐봐, 여긴 위치도 좋고 환경도 준수해. 음식도… 많지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340105
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413340105,
					"content": "성에서 「명소등」을 날릴 때, 여기 앉아서 맛난 음식과 좋은 술을 즐기면 기분 끝내줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340106
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413340106,
					"content": "난 여길 거점으로 손님을 끌어들이려 하는데, 네 생각은 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340107,
						413340108
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413340107,
					"content": "여기서 「명소등」이 보여요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340109
					]
				},
				{
					"id": 413340109,
					"content": "윽… 보일 거야. 「명소등」은 엄청 크니까 쪼끔이라도 보이겠지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340110
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413340110,
					"content": "그건… 일단 그때 가서 다시 생각해보자. 난 일단 가게를 돌봐야 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340111
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413340111,
					"content": "여행자, 소등 재료 좀 모아줄 수 있어? 가게에 소등을 걸어두고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340112,
						413340113
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413340112,
					"content": "제가 직접 만들어드릴게요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340114
					]
				},
				{
					"id": 413340114,
					"content": "괜찮아, 재료만 있으면 돼. 직접 만들면 번거롭잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340115
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413340115,
					"content": "재료를 다 모으면 모질이에게 가져다줘. 모질이가 만들 거야. 난 다른 일을 처리해야 해서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340116
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413340116,
					"content": "물론 널 공짜로 부려먹진 않아. 손님을 끌어모아서 장사가 잘 되면 보수를 두둑이 챙겨줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340117
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413340117,
					"content": "만약 손님이 안 오면요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340118
					]
				},
				{
					"id": 413340118,
					"content": "윽… 손님이… 안 와도 보수는 줘야지. 걱정하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340119
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413340119,
					"content": "아무튼 가게를 정돈하면 손님들도 올 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413340120
					],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413340120,
					"content": "흠… 그럼 재료를 모질이에게 가져다줘. 내일 상황을 봐서 보수를 계산해줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "주 사장"
				},
				{
					"id": 413340113,
					"content": "재료만 필요하세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340114
					]
				},
				{
					"id": 413340108,
					"content": "여기에선 「명소등」이 안 보일 텐데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413340109
					]
				}
			]
		},
