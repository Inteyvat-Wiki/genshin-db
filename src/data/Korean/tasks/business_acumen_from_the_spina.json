						401891603
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401891603,
					"content": "나도 모르게 이것저것 많이 배웠나 보네?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891604,
						401891605
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401891604,
					"content": "나비아가 잘 가르쳤다는 거죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891606
					]
				},
				{
					"id": 401891606,
					"content": "아냐 아냐, 사실 딱히 뭘 가르치지도 않았어. 너희 스스로 깨달은 게 가장 중요한 거지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891607
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401891607,
					"content": "처음 「장기 경영」이라는 말을 들었을 땐, 정말 무시무시하지 않았어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891608
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401891608,
					"content": "하지만 무서워할 거 없어. 복잡한 걸 작은 일로 나누고 하나씩 하다 보면 아무리 재능이 없고 머리가 나쁘더라도 해낼 수 있다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891609
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401891609,
					"content": "오오오! 나 내 발전이 느껴지는 것 같아! 의욕도 막 넘쳐! 나비아가 해준 응원의 말들을 노트에 적어둘래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891610
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401891610,
					"content": "그럼 이제 나비아랑 같이 「슈벨마 시네마 파크」을 잘 운영해 보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
