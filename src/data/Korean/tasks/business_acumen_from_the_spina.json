						],
						"pointId": 340200187
					}
				]
			},
			"dialogs": [
				{
					"id": 401890601,
					"content": "어쩐지 저번보다 더 몰입하는 것처럼 보이는데… 첫 체험이 마음에 들었나 보구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890602,
						401890603
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890602,
					"content": "도전 형식이 정말 친절했어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890604
					]
				},
				{
					"id": 401890604,
					"content": "영화를 많이 본 건 아니지만, 이번 체험 덕에 어쩐지… 흥미가 더 생긴 것 같은데? 관련 작품이 궁금해졌어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890605
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401890605,
					"content": "대단해 페이몬, 애호가들의 가장 순수한 목표를 깨달았구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890606
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890606,
					"content": "손님들이 놀이 프로그램의 모델이 된 영화에 관심을 가지면 소박한 애호가들도 더할 나위 없이 기뻐할 테지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890607
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890607,
					"content": "지출 가능 범위 내에서 사비를 더 털어낼 수도 있다고 하더라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890608
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890608,
					"content": "사… 사비를 털어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890609
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401890609,
					"content": "맞아. 기본적인 노점 건축 자재와 임대료는 가시 장미회에서 책임지고 있지만, 많은 애호가들이 사비로 보물과 관련 상품을 제작하고 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890610
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890610,
					"content": "그 사람들한테 부스 비용은 큰 문제가 아닌 거야. 벌써 영화 캐릭터 파생 상품을 디자인하기 시작한 사람도 있는걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890611
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890611,
					"content": "예를 들어 이번 홍보 대사인 슈벨마 부인은 지난번 만화 영화 인기투표에서 2위를 차지했고, 「동글동글 완전 귀여워」라는 평가를 받았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890612
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890612,
					"content": "많은 사람이 최고급 원단을 최고의 장인에게 맡겨서 슈벨마 부인의 캐릭터 쿠션을 대량 생산하고 싶어 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890613
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890613,
					"content": "다음 전시회부터 이런 쿠션들은 정식으로 출시될 예정이고, 비슷한 상품들도 많이 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890614,
						401890616
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890614,
					"content": "그렇게 말하니까 저도 좀 혹하는데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890615
					]
				},
				{
					"id": 401890615,
					"content": "완전 멋지지? 게다가 슈벨마 부인의 초상권 대리인이자 보호자인 푸리나 씨는 판매 수익의 60%를 배당받게 된다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890618
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890618,
					"content": "아무래도 애호가들은 돈이 목적이 아니라 슈벨마 부인의 귀여운 이미지를 홍보하기 위해서 자원한 거니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890619
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890619,
					"content": "푸리나 씨에게 모라가 많아질수록 슈벨마 부인의 식사가 풍성해질 테니, 다들 기뻐할 거야~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890620
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890620,
					"content": "헤헤, 난 이런 게 좋아! 모두가 이익을 따지지 않고 공통의 취미를 위해 노력하는 거!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890621
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401890621,
					"content": "사실 돈이랑 완전히 상관없다는 건 극단적이야. 애호가의 작품이든 정식 상업 프로그램이든 기본적인 수입 지출의 균형을 고려해야 하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890622
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890622,
					"content": "이번 「슈벨마 시네마 파크」도 마찬가지야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890623
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890623,
					"content": "「콘텐츠 표준 공략법」을 정한 후엔 놀이 프로그램을 정식으로 오픈할 수 있어. 하지만 우리가 직접 판매원이 될 수는 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890624
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890624,
					"content": "부스에 아직 처리해야 할 잡일도 많고, 테마파크 건설도 계속해야 하거든. 그래서 놀이 프로그램마다 관리할 전문 직원을 배치해야 해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890625
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890625,
					"content": "테마파크의 전시판에 모집처가 있는데, 각각의 장점이 있는 이력서가 많이 들어왔어. 우리는 프로그램에 필요한 요소를 고려해 종합적으로 제일 우수한 직원을 뽑아야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890626
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890626,
					"content": "이제 직원들이 계속해서 놀이 프로그램을 운영해 나갈 거야. 그렇게 「슈벨마 시네마 파크」에 수익이 계속 쌓이겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890627
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890627,
					"content": "어? 우리 갑자기 테스터에서 직원을 모집하는… 사장이 된 거야? 이런 일은 경험이 없는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890628,
						401890629
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401890628,
					"content": "난 이력서를 아주 엄격하게 선별한다고!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890630
					]
				},
				{
					"id": 401890630,
					"content": "그래도 널 절대 평가 기준으로 삼진 마. 일반인들이 너랑 같을 순 없으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890631
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401890631,
					"content": "좋아, 이제부턴 이력서 시간이야! 엄청 뛰어난 직원이 지원해 주면 좋겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401890629,
					"content": "난 분명 유능한 사장일 거야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890630
					]
				},
				{
					"id": 401890616,
					"content": "아니면 푸리나에게 배당금을 더 챙겨줄까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890617
					]
				},
				{
					"id": 401890617,
					"content": "걱정 마. 푸리나 씨는 슈벨마 부인의 보호자로서 초상권을 관리하고 있기 때문에 판매 수익의 60%를 배당으로 받을 수 있거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890618
					],
					"speakerTitle": "나비아"
				},
				{
					"id": 401890603,
					"content": "거기에 영화 테마까지 결합하다니!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890604
					]
				}
			]
		},
