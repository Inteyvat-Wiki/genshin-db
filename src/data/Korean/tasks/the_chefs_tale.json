				"points": []
			},
			"dialogs": [
				{
					"id": 760330201,
					"content": "음, 핫도그 안에 들어간 소시지를 아주 잘 구웠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330202
					],
					"speakerTitle": "음식에 집착하는 유령"
				},
				{
					"id": 760330202,
					"content": "밖에 있는 식당에서 일한다면, 이 정도 실력으로 보조 요리사 정도 가능하겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330203
					],
					"speakerTitle": "음식에 집착하는 유령"
				},
				{
					"id": 760330203,
					"content": "하지만! 우리는 섬에 있는 모든 등지기를 위한 식사를 준비해야 해. 중요한 건 요리가 얼마나 맛있는지가 아니라 배불리 먹을 수 있느냐지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330204
					],
					"speakerTitle": "음식에 집착하는 유령"
				},
				{
					"id": 760330204,
					"content": "빵은 좀 두껍게 만들고, 지금은 채소류가 너무 적은 것 같아. 소시지 말고 다른 고기도 넣을 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330205
					],
					"speakerTitle": "음식에 집착하는 유령"
				},
				{
					"id": 760330205,
					"content": "넌 아직 더 연습해야 해. 다음엔 베리 바비큐를 한번 만들어 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "음식에 집착하는 유령"
				}
			]
		},
		{
