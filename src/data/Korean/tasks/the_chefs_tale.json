			},
			"dialogs": [
				{
					"id": 760330301,
					"content": "고기도 충분히 두껍고, 두꺼운데도 잘 익혔네. 좋았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330302
					],
					"speakerTitle": "음식에 집착하는 유령"
				},
				{
					"id": 760330302,
					"content": "하지만 하나 더 알려주자면, 바비큐를 만들 땐 곁들여서 먹는 요리에도 신경 써야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330303
					],
					"speakerTitle": "음식에 집착하는 유령"
				},
				{
					"id": 760330303,
					"content": "고기는 많이 먹으면 느끼해지기 쉬우니까, 베리를 같이 넣는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330304
					],
					"speakerTitle": "음식에 집착하는 유령"
				},
				{
					"id": 760330304,
					"content": "우리가 모든 섬 사람들의 식단과 건강을 책임지고 있으니까, 야채와 고기의 균형을 잘 잡아야 하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330305
					],
					"speakerTitle": "음식에 집착하는 유령"
				},
				{
					"id": 760330305,
					"content": "이 바비큐는 곁들여서 먹을 요리가 너무 적어. 이건 큰 문제야. 조화롭지 못하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330306
					],
					"speakerTitle": "음식에 집착하는 유령"
				},
				{
					"id": 760330306,
					"content": "넌 아직 더 연습해야 해. 다음엔 백령과 닭구이를 한번 만들어 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "음식에 집착하는 유령"
				}
