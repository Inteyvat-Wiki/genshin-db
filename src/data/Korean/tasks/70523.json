			},
			"dialogs": [
				{
					"id": 705230201,
					"content": "오! 또 왔구만?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230202
					],
					"speakerTitle": "게오르크"
				},
				{
					"id": 705230202,
					"content": "이번에도 외국 고객 대신 주문을 하려는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230203
					],
					"speakerTitle": "게오르크"
				},
				{
					"id": 705230203,
					"content": "응! 이번에는 「바캉스 과일주」 100박스가 필요해. 의뢰인은 경책 산장의 요리사 관수야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705230204,
					"content": "우리는 가격을 제시할 준비가 되었어, 게오르크 씨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230205,
						705230206
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705230205,
					"content": "왜 비즈니스 대결의 느낌이 드는 거지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				},
				{
					"id": 705230207,
					"content": "오! 기세가 대단하시군! 그럼 어디 두 사람의 각오가 얼마나 대단한지 한번 볼까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "게오르크"
				},
				{
					"id": 705230206,
					"content": "제 공격을 받아보시죠, 게오르크 씨!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				}
			]
		},
		{
			"id": 7052303,
			"completionStepIds": [
				7052303
