			"dialogs": [
				{
					"id": 751870101,
					"content": "#뿔에 불꽃 무늬가 없는 걸로 봐선… {REALNAME[ID(2)|SHOWHOST(true)]}은(는) 아니고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751870102,
					"content": "흠, 이 녀석은 대체 어디서 온 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751870103,
					"content": "오치카나타의 용의 알…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751870104
					]
				},
				{
					"id": 751870104,
					"content": "앗! 그때 그 용의 알이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751870105,
					"content": "우꺄?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870106
					],
					"speakerTitle": "아구아라"
				},
				{
					"id": 751870106,
					"content": "그 알 속에 있던 게 산룡이었을 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751870107,
					"content": "전에 그 용의 알을 보호하던 사람이 이름을 지어줬었는데… 이름이 「아구아라」였나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751870108,
					"content": "꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870109
					],
					"speakerTitle": "아구아라"
				},
				{
					"id": 751870109,
					"content": "오호! 네 이름에 반응한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751870110,
					"content": "우웅?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870111
					],
					"speakerTitle": "아구아라"
				},
				{
					"id": 751870111,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}처럼 이 녀석도 집이 없어져 버렸네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751870112,
					"content": "#그럼 우리랑 같이 가자! 헤헤, 나랑 {NICKNAME}은(는) 산룡의 좋은 친구거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751870113,
					"content": "꺄! 꺄!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870114
					],
					"speakerTitle": "아구아라"
				},
				{
					"id": 751870114,
					"content": "헤헤… 그렇게 말할 줄 알았어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751870115,
					"content": "한때 동료에게 했던 것처럼 녀석에게 스카프를 묶어준다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751870116
					]
				},
				{
					"id": 751870116,
					"content": "저번에 스카프를 매준 어린 친구는 지금 엄청, 엄청 대단한 녀석이 됐어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 751870117,
					"content": "아구아라! 너도 그 친구처럼 부디 건강하게 자라야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
}