					{
						"sceneId": 3,
						"position": [
							2455.786,
							343.059,
							2402.397
						],
						"pointId": 7559
					},
					{
						"sceneId": 3,
						"position": [
							2454.721,
							343.059,
							2402.242
						],
						"pointId": 7560
					}
				]
			},
			"dialogs": [
				{
					"id": 715320101,
					"content": "저기… 전 이야기꾼의 제자 권서라고 합니다. 잠깐 멈춰주실 수 있을까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320102
					],
					"speakerTitle": "권서"
				},
				{
					"id": 715320102,
					"content": "이런 소문 들어보신 적 있으세요? 「해등절의 밤하늘에 춤추는 불빛이 아름다운 그림을 수놓았다…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320103
					],
					"speakerTitle": "권서"
				},
				{
					"id": 715320103,
					"content": "무, 무슨 소린지 모르겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715320104,
					"content": "불빛으로 하늘에 그림을 그린다고? 평범한 사람은 꿈도 못 꿀 일이잖아…. 비행선을 탄다 해도 하늘을 색칠할 염료를 구할 수 있을 리가 없으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715320105,
					"content": "엄청 과장된 비유 같네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320106,
						715320107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715320106,
					"content": "평범한 그림은 아닌 것 같네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320108
					]
				},
				{
					"id": 715320108,
					"content": "#크흠! 아무튼 이 소문의 주인공은 바로 명성이 자자한 여행자 {NICKNAME} 님과 여행자의 친구 페이몬이랍니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320109
					],
					"speakerTitle": "권서"
				},
				{
					"id": 715320109,
					"content": "엥? 왜 갑자기 주제가 우리로 바뀐 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715320110,
					"content": "잊으셨나 보네요. 작년에 두 분께서 모험가 첨아 씨의 의뢰를 받아 특수한 스피드 도전을 진행하셨잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320111
					],
					"speakerTitle": "권서"
				},
				{
					"id": 715320111,
					"content": "그 도전에 아름다운 불꽃이 더해져 정말 보기 드문 장관이 펼쳐졌었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320112
					],
					"speakerTitle": "권서"
				},
				{
					"id": 715320112,
					"content": "어렴풋이 기억나네. 그땐 그냥 가볍게 모험가 길드 홍보원을 도와줬던 것뿐인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715320113,
					"content": "그러고 보니 그 이벤트를 통해 새로운 멤버를 영입하려 한다고 했는데, 성공했으려나 모르겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320114,
						715320115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715320114,
					"content": "그런 일이 있었던 거 같기도 하네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320116
					]
				},
				{
					"id": 715320116,
					"content": "당시 전 심란한 마음에 망서 객잔에서 술을 마시다가 폭죽에 비친 두 분의 모습을 봤어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320117
					],
					"speakerTitle": "권서"
				},
				{
					"id": 715320117,
					"content": "그 순간, 낙방의 슬픔과 캄캄한 미래에 대한 불안이 두 분의 반짝이는 모습에 싹 가셔버렸죠!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320118
					],
					"speakerTitle": "권서"
				},
				{
					"id": 715320118,
					"content": "덕분에 정신을 차리고 침옥 협곡에 와서 제가 사랑하는 민속 연구에 매진할 수 있었어요…. 절 북돋아 주셔서 감사해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320119
					],
					"speakerTitle": "권서"
				},
				{
					"id": 715320119,
					"content": "두 분의 모습에 감명받은 건 저뿐만이 아니에요. 수많은 사람이 두 분을 보고 모험가 길드에 가입했죠. 그 사람들도 인생의 새로운 방향을 찾은 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320120
					],
					"speakerTitle": "권서"
				},
				{
					"id": 715320120,
					"content": "저, 전혀 몰랐어! 멀리서 누가 지켜보고 있다고는 상상도 못했다구. 그냥 스피드 도전에 참여했을 뿐인데 그게 누군가에겐 격려가 됐을 줄이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715320121,
					"content": "그렇게 띄워주니 부끄럽네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320122,
						715320123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715320122,
					"content": "힘이 났다니 다행이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320124
					]
				},
				{
					"id": 715320124,
					"content": "오늘 두 분을 만나서 정말 영광이에요. 그래서 한 가지 부탁을 드리면서 감사를 전하고 싶어요——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320125
					],
					"speakerTitle": "권서"
				},
				{
					"id": 715320125,
					"content": "부디 앞으로도 두 분의 빛을 널리 퍼뜨려서, 더 많은 사람들에게 격려가 되어 주셨으면 해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320126
					],
					"speakerTitle": "권서"
				},
				{
					"id": 715320126,
					"content": "우리는 네 말처럼 위대한 사람이 아냐. 하지만 네 생각엔 동감해. 더 많은 사람들이 기뻐할 수 있다면 당연히 그래야지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715320127,
					"content": "그나저나 우리가 뭘 하면 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715320128,
					"content": "관례대로 전 첨아 씨의 스피드 도전을 참고해, 두 분께 격려 받은 모험가들과 함께 새로운 도전 「구름을 누비는 빛」을 고안했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320129
					],
					"speakerTitle": "권서"
				},
				{
					"id": 715320129,
					"content": "이 침옥 협곡에는 기묘한 것들이 많아요. 그중에서도 한 기묘한 잉어는 더 빨리 나아갈 수 있는 힘을 주죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320130
					],
					"speakerTitle": "권서"
				},
				{
					"id": 715320130,
					"content": "두 분은 그냥 언제나처럼 산과 하늘 사이를 누비며 날렵하고 멋진 모습을 선보여 주시면 돼요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320131,
						715320132
					],
					"speakerTitle": "권서"
				},
				{
					"id": 715320131,
					"content": "맡겨 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320133
					]
				},
				{
					"id": 715320133,
					"content": "물론 이 모라 답례 말고도 저희의 감사를 표하기 위한 다양한 보상을 준비해 뒀어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320134
					],
					"speakerTitle": "권서"
				},
				{
					"id": 715320134,
					"content": "두 분이 전해주신 희망과 격려에 비하면 이 답례는 보잘것없을지도 모르지만, 이게 전부는 아니니까요. 앞으로 기회가 되는 대로 더 보답할게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320135
					],
					"speakerTitle": "권서"
				},
				{
					"id": 715320135,
					"content": "#헤헤, 괜찮아! 답례 같은 게 많지 않아도, 나랑 {NICKNAME}은(는) 앞으로도 계속 여행하면서 헤매는 사람을 도와줄 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715320136
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715320136,
					"content": "권서의 말을 들으니까 모험할 기운이 솟아나는걸! 우리 권서가 말한 「구름을 누비는 빛」을 해보자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 715320132,
					"content": "기꺼이요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320133
					]
				},
				{
					"id": 715320123,
					"content": "기운 차리신 거 축하드려요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320124
					]
				},
				{
					"id": 715320115,
					"content": "그래서 하시려는 말씀이 뭔가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320116
					]
				},
				{
					"id": 715320107,
					"content": "설마 폭죽을 말하는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715320108
					]
				}
			]
		}
	]
}