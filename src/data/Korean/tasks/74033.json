						],
						"pointId": 5768
					}
				]
			},
			"dialogs": [
				{
					"id": 740330401,
					"content": "미툴, 너 괜찮아? 너무 오래 갇혀 있던 건 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330402
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740330402,
					"content": "구세주다! 드디어 왔구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330403
					],
					"speakerTitle": "미툴"
				},
				{
					"id": 740330403,
					"content": "코블렌츠는? 같이 안 왔어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330404
					],
					"speakerTitle": "미툴"
				},
				{
					"id": 740330404,
					"content": "네가 갇혔다며 내게 도움을 요청한 게 코블렌츠야. 여기 오는 도중에 교도관에게 들켜서 먼저 자리를 떴어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330405
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740330405,
					"content": "못 미더운 녀석일 줄 알았어! 괜히 찔리고 무서워서 도망간 거겠지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330406
					],
					"speakerTitle": "미툴"
				},
				{
					"id": 740330406,
					"content": "생각해 봐, 사업을 하려면 대담하게 나가야 돈을 벌 수 있잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330407
					],
					"speakerTitle": "미툴"
				},
				{
					"id": 740330407,
					"content": "사람이 굼뜬 건 그렇다 쳐도, 왜 그렇게까지 신중한 건데?! 결국 「순수의 물」뿐만 아니라 폰타까지 들어오기 시작했잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330408
					],
					"speakerTitle": "미툴"
				},
				{
					"id": 740330408,
					"content": "폰타까지 들어온 마당에 우리에게 아직 희망이 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330409
					],
					"speakerTitle": "미툴"
				},
				{
					"id": 740330409,
					"content": "그렇구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740330410,
					"content": "뭐야, 설마 너도 폰타를 좋아해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330411,
						740330413
					],
					"speakerTitle": "미툴"
				},
				{
					"id": 740330411,
					"content": "당신은 싫어하나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330412
					]
				},
				{
					"id": 740330412,
					"content": "당연히 좋아하지! 폰타가 강력한 경쟁 상대라는 건 인정할 수밖에 없잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "미툴"
				},
				{
					"id": 740330415,
					"content": "그보다 난 코블렌츠에게 따지러 가야겠어. 참, 녀석이 보상도 안 줬지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330416
					],
					"speakerTitle": "미툴"
				},
				{
					"id": 740330416,
					"content": "응, 안 줬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330417
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740330417,
					"content": "…통 안에 녀석을 쑤셔 넣고 반성하게 하고 싶다니까. 아무튼 이 특별 허가 쿠폰 받아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330418
					],
					"speakerTitle": "미툴"
				},
				{
					"id": 740330418,
					"content": "#페이몬과 {NICKNAME}, 너희가 받는 게 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330419
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740330419,
					"content": "어라? 다 우리 주는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330420
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740330420,
					"content": "물론이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330421
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740330421,
					"content": "헤헷, 그럼 잘 받을게. 나중에 허름한 뼈다귀 상점에 괜찮은 물건이 있는지 구경하러 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330422
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740330422,
					"content": "참, 너희를 번거롭게 했으니까 사과의 의미로 내가 가진 신선한 건강 음료를 나눠줄게. 마셔볼래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330423
					],
					"speakerTitle": "미툴"
				},
				{
					"id": 740330423,
					"content": "신선한… 건강 음료?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330424
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740330424,
					"content": "「순수의 물」보다 더 건강한 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330425,
						740330428
					],
					"speakerTitle": "미툴"
				},
				{
					"id": 740330425,
					"content": "한 잔 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330426
					]
				},
				{
					"id": 740330426,
					"content": "(이봐! 캐터필러가 아까 마시지 말라고 그랬잖아…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330427
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740330427,
					"content": "#{NICKNAME} 말은 무시해! 우린 방금 오기 전에… 음, 음료수를 잔뜩 마셨거든!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740330431,
					"content": "건강 음료라니 정말 아쉽네. 나중에 기회 닿으면 꼭 마셔볼게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330432
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740330432,
					"content": "아쉽게 됐네, 알겠어. 제대로 대접할 테니까 나중에 시간 있으면 꼭 들러줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330433
					],
					"speakerTitle": "미툴"
				},
				{
					"id": 740330433,
					"content": "그럼 난 이만 코블렌츠를 찾으러 가볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330434
					],
					"speakerTitle": "미툴"
				},
				{
					"id": 740330434,
					"content": "난 다른 볼일이 있어서 이만 가볼게. 특별 허가 쿠폰은 걱정할 필요 없어. <color=#00E1FFFF>단서를 찾으면 칠판에 붙여 놓을게</color>. 나중에 다시 만나자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330435
					],
					"speakerTitle": "캐터필러"
				},
				{
					"id": 740330435,
					"content": "응, 이따가 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740330428,
					"content": "폰타 한 잔 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330429
					]
				},
				{
					"id": 740330429,
					"content": "있긴 한데… 뭐야, 설마 내 건강 음료를 무시하는 거야? 이봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330430
					],
					"speakerTitle": "미툴"
				},
				{
					"id": 740330430,
					"content": "그런 뜻이 아니야! 그러니까… 우리가 방금 오기 전에 음료수를 잔뜩 마셨거든. 그래서 지금 너무 배가 불러…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740330413,
					"content": "그럭저럭요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330414
					]
				},
				{
					"id": 740330414,
					"content": "오? 맛을 아는 손님이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "미툴"
				}
			]
		}
	]
}