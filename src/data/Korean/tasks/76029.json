			"dialogs": [
				{
					"id": 760290201,
					"content": "아이노! 집에 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760290202,
					"content": "오! 페이몬 목소리다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290203
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 760290203,
					"content": "안녕! 간식 들고 나 보러 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290204
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 760290204,
					"content": "그렇게 말할 줄 알았다니까. 자, 여기 있어. 오는 길에 준비한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760290205,
					"content": "빨리 줘 빨리! 이네파가 곧 돌아올 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290206
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 760290206,
					"content": "그럼 오늘은 나랑 뭐 하고 놀게?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290207
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 760290207,
					"content": "헤헤… 사실~ 아이노한테 부탁할 게 좀 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760290208,
					"content": "으악! 치… 치워! 그 이상한 물건 좀 치우라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290209
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 760290209,
					"content": "이상한 물건? 이 악기 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760290210,
					"content": "과학이나 기계학 원리로 설명되지 않는 건 질색이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290211
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 760290211,
					"content": "저 악기는 잊을만하면 집 앞에 나타나는데, 매번 고치는 족족 감쪽같이 사라진다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290212
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 760290212,
					"content": "난… 저런 이상한 물건 따윈 보기 싫어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290213
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 760290213,
					"content": "아… 오해가 좀 있었나 보네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290214
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760290214,
					"content": "오해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290215,
						760290216
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 760290215,
					"content": "이건 우리 친구의 악기야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				},
				{
					"id": 760290217,
					"content": "응, 나쁜 뜻은 없어. 사정이 있어서 몰래 회수해 간 것뿐이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760290218,
					"content": "정말? 나 속이는 거 아니지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290219
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 760290219,
					"content": "그… 그럼 너희를 믿고… 이번엔 좀 더 완벽하게 고쳐볼게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290220
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 760290220,
					"content": "여기서 잠시만 기다려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290221
					],
					"speakerTitle": "아이노"
				},
				{
					"id": 760290221,
					"content": "역시 아이노는 든든하네. 저거 때문에 깜짝 놀랐을 걸 생각하면 좀 불쌍하기도 하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290222
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760290222,
					"content": "응, 보답해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290223
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760290223,
					"content": "응응… 으악! 갑자기 어디서 튀어나온 거야! 이번엔 우리가 놀랐다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290224
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760290224,
					"content": "너희한테 전달할 물건이 있어서 잠깐 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290225
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760290225,
					"content": "응? 이건 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290226
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760290226,
					"content": "월령이 감사의 마음을 전하려고 수집한 「보물」이야. 저 장인 마음에 들 거래",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
