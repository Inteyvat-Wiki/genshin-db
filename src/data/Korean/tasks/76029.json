			"dialogs": [
				{
					"id": 760290101,
					"content": "안녕",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290102
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760290102,
					"content": "어? 콜롬비나, 외출하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760290103,
					"content": "응, 악기를 고치러 가는 길이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290104
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760290104,
					"content": "…에?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760290105,
					"content": "월령이 아끼는 악기가 망가져서, 고쳐주려고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290106
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760290106,
					"content": "월령은 정말 다재다능하구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760290107,
					"content": "응, 늘 여기서 악기를 연주해 줘. 나도 종종 그 소리에 맞춰 노래를 부르지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290108
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760290108,
					"content": "전부터 느낀 건데, 넌 정말 월령을 아끼는구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760290109,
					"content": "응, 항상 곁에 있어 주고, 재밌는 물건도 가져다주니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290110
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760290110,
					"content": "(라우마는 이걸 달의 신을 기쁘게 하려는 월령의 천성이라고 했었지)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290111
					]
				},
				{
					"id": 760290111,
					"content": "그런데 악기를 어떻게 고칠 생각이야? 너 다른 사람한테 보여지면 안 된다며",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760290112,
					"content": "음… 예전에는 동물이나 월령에게 부탁해서, 수리가 필요한 물건을 장인의 집 앞에 놓고 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290113
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760290113,
					"content": "발견하면 보통은 수리해 주거든. 가끔 늦게 발견해서 며칠 기다려야 하는 경우도 있지만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290114
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760290114,
					"content": "꽤 번거로워 보이네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760290115,
					"content": "우리한테 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290116
					]
				},
				{
					"id": 760290116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290117
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760290117,
					"content": "걱정 마, 우리한테 맡기면 오늘 안에 고칠 수 있을지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760290118,
					"content": "…응. 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290119
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760290119,
					"content": "천만에. 그나저나 평소에는 어느 장인 집 앞에 둬?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760290120,
					"content": "이름은 몰라. 그 장인은 입구에 커다란 기계팔이 달리고, 소라처럼 동글동글한 집에서 살고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290121
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760290121,
					"content": "(설마…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290122
					]
				},
				{
					"id": 760290122,
					"content": "그리고 거기서 종종 크룸카케 향기가 풍겨와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290123
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760290123,
					"content": "누군지 알 것 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
