	"talks": [
		{
			"id": 7410404,
			"completionStepIds": [
				7410404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410404",
							"2"
						],
						"stepId": 7410404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"쿠트로"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741040401,
					"content": "두, 두 분은 연구 조수 자리에 지원하러 오신 건가요? 죄, 죄송합니다. 지금은 움직이기 좀 힘들어서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040402,
						741040403
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040402,
					"content": "그런 것 같네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040405
					]
				},
				{
					"id": 741040405,
					"content": "그건 나중에 얘기하고… 너, 어쩌다 철창에 갇히게 된 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040406,
					"content": "제 연구 파트너인 쿠트로와 의견이 엇갈리는 바람에… 잠깐 머리를 식히고 있으라고 하더라고요. 아… 참, 자기소개가 늦었네요. 전… 퀴셀이라고 해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040407
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040407,
					"content": "아, 그러니까… 퀴셀의 태엽 공방의 그 퀴셀 말이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040408
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040408,
					"content": "#이쪽은 {NICKNAME}, 난 페이몬이야. 아까 다투는 소리가 들렸는데… 그 무시무시한 녀석이 네 연구 파트너였구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040409,
						741040411
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040409,
					"content": "파트너를 바꾸는 건 어때요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040410
					]
				},
				{
					"id": 741040410,
					"content": "#맞아! 파트너로는 나 같은 좋은 녀석을 만나야지…. {NICKNAME}, 나 같은 파트너를 둔 걸 행운으로 알라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040413,
					"content": "호, 혹시 괜찮다면 절 꺼내 주실 수 없을까요? 옆의 에너지 저장 장치를 활성화하면 문, 문을 열 수 있을 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040414
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040414,
					"content": "제, 제발 부탁드릴게요! 연구 조수 자리에 지원하러 온 사람들도 다들 쿠트로의 성질을 견디지 못하고 금세 떠나버렸거든요. 그래서 부탁할 사람도 없어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040415
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040415,
					"content": "#음, 뭐 그렇다면야… {NICKNAME}, 우리가 도와주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040411,
					"content": "그럼 계속 머리 식히세요. 이만 가볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040412
					]
				},
				{
					"id": 741040412,
					"content": "이봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040403,
					"content": "그냥 둘러보던 중이었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040404
					]
				},
				{
					"id": 741040404,
					"content": "겨, 견학하러 오신 건가요? 물론 그쪽도 환영입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040405
					],
					"speakerTitle": "쿠트로"
				}
			]
		},
		{
			"id": 7410405,
			"completionStepIds": [
				7410406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410406",
