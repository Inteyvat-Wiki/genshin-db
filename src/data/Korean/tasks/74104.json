				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741042501,
					"content": "퀴셀! 찾았다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741042502,
					"content": "그럼 옆에 있는 건… 아마 퀴셀이 말했던 이상한 연구 파트너, 쿠트로겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042503
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741042503,
					"content": "…뭐? 난 브리콜이고 저 녀석이 쿠트로야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042504
					],
					"speakerTitle": "브리콜"
				},
				{
					"id": 741042504,
					"content": "어? 퀴셀 아니었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741042505,
					"content": "퀴셀은… 그저 편리한 캐릭터일 뿐이에요. 어려운 시험을 통과한 두 분께는 더 감출 필요 없겠네요. 제가 이 공방의 진짜 주인인 쿠트로입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042506
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741042506,
					"content": "하하, 두 분은 정말… 소재로서 완벽해요. 만약 여러분이 제 연구를 도와주신다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042507
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741042507,
					"content": "어떤 연구죠? 일단 들어볼게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741042508
					]
				},
				{
					"id": 741042508,
					"content": "뭐라고!? 이 수상한 녀석한테 협력할 생각이야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042510
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741042510,
					"content": "누가 봐도 정상적인 공방은 아니잖아! 심지어 거짓말도 하고 태엽 장치로 우릴 공격하기까지 했어…. 위험한 녀석이라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042511
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741042511,
					"content": "맞아! 절대 속으면 안 돼! 저 녀석은… 아주 악독한 녀석이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042512
					],
					"speakerTitle": "브리콜"
				},
				{
					"id": 741042512,
					"content": "난 단서를 따라 조사하던 중에 이곳을 발견했어. 저 녀석… 제명당한 뒤에도 위험한 연구를 계속해 온 것도 모자라 폰타인 과학원의 자산까지 훔칠 줄이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042513
					],
					"speakerTitle": "브리콜"
				},
				{
					"id": 741042513,
					"content": "이건 범죄야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042514
					],
					"speakerTitle": "브리콜"
				},
				{
					"id": 741042514,
					"content": "말이 많군, 브리콜. 쓸모없는 평범한 인간 주제에… 두 귀빈의 진정한 가치를 감정하고 나서 널 손봐 주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042515
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741042515,
					"content": "귀빈들이라니… 우리를 말하는 건 아니겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042516
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741042516,
					"content": "아니긴요. 두 분께서 자신의 진정한 가치를 증명하기까지 이제 한 걸음 남았습니다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741042517
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741042517,
					"content": "당신들의 진짜 실력을 보여주세요!",
