							4455.18
						],
						"pointId": 6729
					}
				]
			},
			"dialogs": [
				{
					"id": 741040501,
					"content": "문 열렸는데 안 나올 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040502
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040502,
					"content": "사, 사실 이런 말씀 드리기는 좀 그렇지만… 제가 지금 여기서 나가면, 아… 아마 폭발이 일어날 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040503
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040503,
					"content": "폭발?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040504,
					"content": "네, 네… 아까도 말씀드렸지만 제 연구 파트너는… 성격이 안 좋거든요. 철창에 특수한 트리거를 설치해놨어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040505
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040505,
					"content": "에엑?! 그럼 어떡해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040506,
						741040508
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040506,
					"content": "무거운 물건을 대신 올려놓는 건 어떨까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040507
					]
				},
				{
					"id": 741040507,
					"content": "펴, 평범한 물건으로는 안 될 거예요…. 원리가 복잡해서요. 으음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040510
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040510,
					"content": "#{NICKNAME} 씨, 혹시 잠시… 자리를 바꿔주실 수 있을까요? 그럼 제가 얼른 특수 트리거를 해제할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040511
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040511,
					"content": "며, 몇 년 동안 함께 연구해 온 파트너니까, 쿠트로의 생각은 제가 잘 알아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040512,
						741040515
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040512,
					"content": "저 혼자선 무게가 부족할 테니 페이몬도 같이…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040513
					]
				},
				{
					"id": 741040513,
					"content": "나… 난 공중에 떠 있으니까 무게가 있을 리가 없잖아! 응, 없다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040514
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040514,
					"content": "음… 이 트리거는 특별한 물건이라 단순히 무게만으로 판단하지는 않아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040516
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040516,
					"content": "제발 믿어주세요. 잠시만 기다려 주시면 바로 트리거를 해제하고 올게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040517
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040517,
					"content": "…혹시 폰타인 과학원이라고 들어보셨나요? 아니면 레이먼드 씨라거나, 보쉬에 씨라거나… 저, 전 그 두 분의 가르침을 받은 사람이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040518
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040518,
					"content": "이, 이 정도 기술 문제는 어렵지 않으니 얼마 걸리지 않을 거예요. 잠깐이면 돼요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040519
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040519,
					"content": "음… 알겠어. 그래도 최대한 빨리 해제해야 한다?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040520
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040520,
					"content": "조심스럽게 퀴셀과 위치를 바꾼다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741040521
					]
				},
				{
					"id": 741040521,
					"content": "엥? 문이 또 닫혔잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040522
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040522,
					"content": "윽… 뭐, 뭔가 문제가 생겼나 보네요. 자, 잠시 살펴보고 올게요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040523
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040523,
					"content": "뭔가 불길한 예감이…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040524
					]
				},
				{
					"id": 741040524,
					"content": "최, 최대한 빨리 처리할 테니 걱정하지 마세요. 트리거를 해제하는 단말기는 다른 곳에 있으니 잠시만 기다려 주세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040525
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040525,
					"content": "기다리는 수밖에 없겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040526
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040526,
					"content": "잠시 기다린다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741040527
					]
				},
				{
					"id": 741040527,
					"content": "왜 아직도 안 오는 거지? …혹시 무슨 문제라도 생긴 건가? 여기에는 자기랑 연구 파트너밖에 없다고 했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040528,
						741040530
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040528,
					"content": "혹시 또 다른 철창에 갇힌 걸지도…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040529
					]
				},
				{
					"id": 741040529,
					"content": "에엑——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040532
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040532,
					"content": "전 줄곧 고민해 왔습니다. 「선량함」은 정말로 바람직한 품성일까? 선량하기만 한 사람의 인생에… 그것은 과연 도움이 될까 말입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040533
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040533,
					"content": "…응? 누구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040534
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040534,
					"content": "거기에 폭발을 일으키는 트리거 같은 건 없어요. 하지만 철창의 문이 잠겨 있는 건 사실이죠. 자, 이제 어떻게 할 생각이죠? 계속 기다릴 것인가, 아니면 움직일 것인가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040535
					],
					"speakerTitle": "쿠트로"
				},
				{
					"id": 741040535,
					"content": "대체 무슨 말을 하는 거야? 게다가 이 목소리… 어쩐지 퀴셀 같기도 하고, 퀴셀이랑 다투던 사람 같기도 한데… 대체 뭐가 어떻게 된 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040536
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040536,
					"content": "일단 여기서 나갈 방법부터 생각해 보자…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040537
					]
				},
				{
					"id": 741040537,
					"content": "그렇네! 근데… 지금 철창 안에 갇힌 상태잖아. 이걸 어떻게 열지…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040538
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040538,
					"content": "페이몬, 너만 믿을게. 제발 구해줘!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741040539
					]
				},
				{
					"id": 741040539,
					"content": "으으, 어쩌다 일이 이렇게 된 거람!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741040540
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741040540,
					"content": "나까지 갇히지 않아서 다행이라고 해야 하나…? 음, 아까처럼 하면 문을 열 수 있는 거겠지? 한번 해볼게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
