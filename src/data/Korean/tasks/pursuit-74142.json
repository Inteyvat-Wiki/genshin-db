						],
						"pointId": 6836
					}
				]
			},
			"dialogs": [
				{
					"id": 741420401,
					"content": "#어라? {NICKNAME} {M#오빠}{F#언니}… 우리 조금 전에 만나지 않았나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420402
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741420402,
					"content": "언제?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420403
					]
				},
				{
					"id": 741420403,
					"content": "음, 정확히 언제라고는 말 못 하겠네요…. 아무래도 이런 곳에선 시간을 알기 힘드니까요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420404
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741420404,
					"content": "카노틸라, 나랑 같이 가자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420405
					]
				},
				{
					"id": 741420405,
					"content": "이곳은 정상이 아니야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420406
					]
				},
				{
					"id": 741420406,
					"content": "하지만 정상과 비정상은 우리가 정한 거잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420407
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741420407,
					"content": "아… 다른 뜻은 없었어요. 하지만 생명력과 색깔로 가득 차 있는 이곳이 전 너무 좋은걸요? 저쪽 세계에선 이런 풍경을 본 적 없죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420408
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741420408,
					"content": "해바라기 한 송이밖에 못 봤는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420409
					]
				},
				{
					"id": 741420409,
					"content": "네? 와! 어디요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420410
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741420410,
					"content": "전에 강아지를 만났던 곳에 있어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420411
					]
				},
				{
					"id": 741420411,
					"content": "오! 그럼 저 먼저 출발할게요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420412
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741420412,
					"content": "잠깐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
