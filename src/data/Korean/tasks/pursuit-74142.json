				]
			},
			"dialogs": [
				{
					"id": 741420701,
					"content": "#앗! {NICKNAME} {M#오빠}{F#언니}. 어라, 페이몬은 같이 안 왔나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420702
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741420702,
					"content": "저 균열은… 뭘 보고 있었어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420703
					]
				},
				{
					"id": 741420703,
					"content": "네? 균열이라뇨? 거울이잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420704
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741420704,
					"content": "앗, 그러고 보니 저 뭔가를 찾고 있었죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420705
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741420705,
					"content": "「수수께끼 거울」의 단서 말이에요…. 아마 그림 같은 물건일 텐데 「게시의 책」처럼 명상을 할 수 있게 해주겠죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420706
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741420706,
					"content": "사상한과 게슈탈트의 탑의 「그림」에 대해…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420707
					]
				},
				{
					"id": 741420707,
					"content": "#…그랬군요, 그런 곳에 있었군요. 고마워요, {NICKNAME} {M#오빠}{F#언니}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카노틸라"
				}
			]
		},
