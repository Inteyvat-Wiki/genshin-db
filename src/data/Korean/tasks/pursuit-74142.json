			"dialogs": [
				{
					"id": 741421401,
					"content": "으앗!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741421402,
					"content": "페이몬, 나…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421403
					]
				},
				{
					"id": 741421403,
					"content": "이번에도 엄청 빠르네! 아직 눈도 못 깜빡였는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741421404,
					"content": "…다행이네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421405
					]
				},
				{
					"id": 741421405,
					"content": "#사건의 원흉도 돌아왔으니 이제 됐어! 카노틸라, {NICKNAME}이(가) 널 얼마나 걱정했는 줄 알아!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741421406,
					"content": "아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421407
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741421407,
					"content": "흑흑, 죄송해요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421408
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741421408,
					"content": "엥? 아… 탓하는 건 아니었어! 카노틸라, 뚝! 맛있는 거 줄 테니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421409
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741421409,
					"content": "(무슨 일이 있었던 거야?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421410
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741421410,
					"content": "(안에서 위험한 일을 겪었어)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421411
					]
				},
				{
					"id": 741421411,
					"content": "(그렇구나…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421412
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741421412,
					"content": "옳지, 옳지. 카노틸라 진짜 용감하네? 자, 카노틸라! 이건 내가 가장 좋아하는 버섯 닭꼬치인데 상으로 너 줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741421413,
					"content": "흑흑… 고마워요, 페이몬… 흑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421414
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741421414,
					"content": "(우물우물)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421415
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741421415,
					"content": "흑흑, 맛이 이상해요. 이게 바로 인간들의 음식인가요…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421416
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741421416,
					"content": "뭐어!? 안 먹을 거면 돌려줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421417
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741421417,
					"content": "#그래도… 고마워요, 페이몬. {NICKNAME} {M#오빠}{F#언니}도요. 구해줘서 고마워요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421418
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741421418,
					"content": "이제 어떻게 할 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421419
					]
				},
				{
					"id": 741421419,
					"content": "잘 모르겠지만 책은 안 볼 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421420
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741421420,
					"content": "…카노틸라, 너무 극단적인 거 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421421
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741421421,
					"content": "으, 그치만 「게시의 책」은 너무 무서운걸요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421422
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741421422,
					"content": "(대체 무슨 일이 있었던 건데!?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421423
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741421423,
					"content": "(설명하자면 복잡해…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421424,
						741421425
					]
				},
				{
					"id": 741421424,
					"content": "(직접 봐야 알 수 있어)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421426
					]
				},
				{
					"id": 741421426,
					"content": "(대체 뭔데! 진짜 열받네…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421427
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741421427,
					"content": "…더는 이곳에 있지 않을 거예요. 모두와 함께 바다 거품 마을에서 살래요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421428
					],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741421428,
					"content": "잘됐다! 다른 멜뤼진들이 널 잘 돌봐줄 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421429
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 741421429,
					"content": "#네, 고마워요… {NICKNAME} {M#오빠}{F#언니}, 페이몬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카노틸라"
				},
				{
					"id": 741421425,
					"content": "(넌 안 가서 다행이다)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421426
					]
				}
			]
		},
