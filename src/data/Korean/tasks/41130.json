			"dialogs": [
				{
					"id": 411300601,
					"content": "어때? 그 마물을 쓰러뜨렸니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300602
					],
					"speakerTitle": "경륜"
				},
				{
					"id": 411300602,
					"content": "네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300603
					]
				},
				{
					"id": 411300603,
					"content": "정말 다행이야…. 드디어 한숨 돌릴 수 있겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300604
					],
					"speakerTitle": "경륜"
				},
				{
					"id": 411300604,
					"content": "도와줘서 고마워, 여행자. 이건 답례니까 받아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300605
					],
					"speakerTitle": "경륜"
				},
				{
					"id": 411300605,
					"content": "근데 대체 왜 경책 산장 근처에 갑자기 이런 마물이 나타난 거지? 이상하군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300606
					],
					"speakerTitle": "경륜"
				},
				{
					"id": 411300606,
					"content": "뭐 어때. 어찌 됐든 이 일은 총무부에 보고해야겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300607
					],
					"speakerTitle": "경륜"
				},
