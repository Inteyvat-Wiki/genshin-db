				"points": []
			},
			"dialogs": [
				{
					"id": 411300201,
					"content": "안 돼…. 지원이 필요해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300202
					],
					"speakerTitle": "경륜"
				},
				{
					"id": 411300202,
					"content": "마물 영지를 소탕했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300203
					]
				},
				{
					"id": 411300203,
					"content": "응, 고마워. 근데 방금 또 문제가 생겼어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300204
					],
					"speakerTitle": "경륜"
				},
				{
					"id": 411300204,
					"content": "경책 산장 주변엔 평범한 마물들만 있는 줄 알았는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300205
					],
					"speakerTitle": "경륜"
				},
				{
					"id": 411300205,
					"content": "동료들과 마물 영지 한 곳을 소탕하고 좀 쉬었다 다음 영지로 이동하려고 했더니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300206
					],
					"speakerTitle": "경륜"
				},
				{
					"id": 411300206,
					"content": "수풀 속에서 갑자기 츄츄 바위왕 한 마리가 나타났지 뭐야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300207
					],
					"speakerTitle": "경륜"
				},
				{
					"id": 411300207,
					"content": "우리가 반응하기도 전에 공격해와서 부상자가 많이 나왔어…. 그래서 일단 후퇴할 수밖에 없었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300208
					],
					"speakerTitle": "경륜"
				},
				{
					"id": 411300208,
					"content": "그 마물은 너무 위험해. 이대로 방치해둘 수 없어. 근데 다른 마물 영지를 치우러 간 사람들이 아직 안 돌아왔는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300209
					],
					"speakerTitle": "경륜"
				},
				{
					"id": 411300209,
					"content": "여행자, 혹시 네가 가서 그 마물을 처치해줄 수 있니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300210,
						411300212
					],
					"speakerTitle": "경륜"
				},
				{
					"id": 411300210,
					"content": "제게 맡겨요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300211
					]
				},
				{
					"id": 411300211,
					"content": "그럼 부탁할게. 우리가 할 일인데 떠맡겨서 미안해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "경륜"
				},
				{
					"id": 411300212,
					"content": "다친 사람들은 괜찮아요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300213
					]
				},
				{
					"id": 411300213,
					"content": "다행히 제때 치료해서 큰 이상은 없는데… 당분간은 움직이기 좀 불편할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300214
					],
					"speakerTitle": "경륜"
				},
				{
					"id": 411300214,
					"content": "그러니까 그 마물을 처치하는 건 너한테 부탁해도 될까, 여행자?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300215
					],
					"speakerTitle": "경륜"
				},
				{
					"id": 411300215,
					"content": "정말 미안해…. 원래는 우리가 할 일인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "경륜"
				}
			]
		},
