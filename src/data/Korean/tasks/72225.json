			"dialogs": [
				{
					"id": 722250101,
					"content": "아파라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250102
					],
					"speakerTitle": "쿠"
				},
				{
					"id": 722250102,
					"content": "#{NICKNAME} {F#누나}{M#형아}, 페이몬! 마침 잘 왔어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250103
					],
					"speakerTitle": "류"
				},
				{
					"id": 722250103,
					"content": "무슨 일이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250104
					]
				},
				{
					"id": 722250104,
					"content": "발을 삐었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250105
					],
					"speakerTitle": "쿠"
				},
				{
					"id": 722250105,
					"content": "쿠 형이 또 다쳤어. 혹시 대신 서목(栖木)에 공양해 줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250106,
						722250108
					],
					"speakerTitle": "류"
				},
				{
					"id": 722250106,
					"content": "이런 전개를 예상하지 못한 건 아니지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250107
					]
				},
				{
					"id": 722250107,
					"content": "물론이지, 맡겨 줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722250109,
					"content": "정말 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250110
					],
					"speakerTitle": "류"
				},
				{
					"id": 722250110,
					"content": "맞다, 류도 「원소」를 잘 느끼지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722250111,
					"content": "왜 서목에 직접 공양하지 않는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722250112,
					"content": "음… 전에 제전에서 여러 가지 일을 해보긴 했는데, 결과가 별로 좋지 않았거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250113,
						722250115,
						722250116
					],
					"speakerTitle": "류"
				},
				{
					"id": 722250113,
					"content": "왜?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250114
					]
				},
				{
					"id": 722250114,
					"content": "나도 몰라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250117
					],
					"speakerTitle": "류"
				},
				{
					"id": 722250117,
					"content": "어쩔 수 없지, 그럼 서목은 우리한테 맡겨 두라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722250115,
					"content": "그럼 나한테 맡겨줘",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250116,
					"content": "다친 사람은 네게 맡길게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250117
					]
				},
				{
					"id": 722250108,
					"content": "나한테 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250109
					]
				}
			]
		},
