				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722250301,
					"content": "서목(栖木)에 활기가 돌고 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250302
					],
					"speakerTitle": "류"
				},
				{
					"id": 722250302,
					"content": "서목(栖木) 공양이 드디어 끝났네. 고생했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250303
					],
					"speakerTitle": "쿠"
				},
				{
					"id": 722250303,
					"content": "후후, 이런 문제 해결은 우리가 전문가지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722250304,
					"content": "「빛 인도 의식」이랑 비슷해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250305
					]
				},
				{
					"id": 722250305,
					"content": "항상 세 곳에 흩어져있는 세 가지 기믹을 해결해야 하는 상황을 겪는다니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722250306,
					"content": "뭔가, 너랑 같이 있으면 항상 이런 일이 생기는 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722250307,
					"content": "다른 건 모르겠지만, 어른들이 이렇게 말하곤 했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250308
					],
					"speakerTitle": "류"
				},
				{
					"id": 722250308,
					"content": "바로 「3의 법칙」이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250309
					],
					"speakerTitle": "류"
				},
				{
					"id": 722250309,
					"content": "3의 법칙…이라니, 무슨 뜻이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722250310,
					"content": "음… 그러니까, 무슨 일이든 세 번 이상 겪어 봐야 결과가 나온다는 뜻 아닐까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250311
					],
					"speakerTitle": "류"
				},
				{
					"id": 722250311,
					"content": "예를 들어, 길조가 세 번 일어나야 진정한 행운이 오고, 흉조가 세 번 일어나면, 반드시 안 좋은 일이 생긴대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250312
					],
					"speakerTitle": "류"
				},
				{
					"id": 722250312,
					"content": "무슨 일을 할 때도, 세 번의 어려움을 겪고, 네 번째에야 성공할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250313
					],
					"speakerTitle": "류"
				},
				{
					"id": 722250313,
					"content": "그럼「4의 법칙」 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722250314,
					"content": "그렇네! 페이몬 수학 진짜 잘한다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250315
					],
					"speakerTitle": "류"
				},
				{
					"id": 722250315,
					"content": "흐흥, 당연하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250316,
						722250318
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722250316,
					"content": "수학이 포인트였던 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250317
					]
				},
				{
					"id": 722250317,
					"content": "그나저나, 쿠는 괜찮아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250319
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 722250319,
					"content": "걱정하지 마, 쿠 형은 항상 그러니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250320
					],
					"speakerTitle": "류"
				},
				{
					"id": 722250320,
					"content": "못 볼 꼴을 보였네… 제전에 영향이 없어야 할 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250321
					],
					"speakerTitle": "쿠"
				},
				{
					"id": 722250321,
					"content": "안 그럼, 류한테 너무 미안하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250322
					],
					"speakerTitle": "쿠"
				},
				{
					"id": 722250322,
					"content": "무슨 소리야. 쿠 형은 항상 나한테 잘해 줬잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250323
					],
					"speakerTitle": "류"
				},
				{
					"id": 722250323,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250324
					],
					"speakerTitle": "쿠"
				},
				{
					"id": 722250324,
					"content": "#{NICKNAME} {F#누나}{M#형아}, 페이몬, 먼저 가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250325
					],
					"speakerTitle": "류"
				},
				{
					"id": 722250325,
					"content": "난 쿠 형이랑 잠깐 앉아 있다가 마무리하고 갈게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "류"
				},
				{
					"id": 722250318,
					"content": "쿠의 발목 부상…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250319
					]
				}
			]
