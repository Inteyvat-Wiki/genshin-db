			"dialogs": [
				{
					"id": 30130401,
					"content": "너 나히다지! 어쩐지 화신 탄신 축제에서 만난 캐서린이 조금 이상하다고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130402
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30130402,
					"content": "두냐르자드는… 네가 구해준 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130403
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30130403,
					"content": "그건 말하자면 길어. 아무튼 환자의 휴식을 방해하지 말자. 아직 정신이 많이 쇠약하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30130404
					],
					"speakerTitle": "캐서린"
				},
				{
					"id": 30130404,
					"content": "자리를 옮겨서 이야기할까? 여행자의 「애착」 벤치로 가는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "캐서린"
				}
			]
