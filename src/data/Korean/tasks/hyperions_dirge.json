					"nextDialogs": [
						722410238
					]
				},
				{
					"id": 722410238,
					"content": "이젠 나한테 아무 의미 없는 물건이야. 영혼이 한곳에 모인 지금, 자네에게 맡기는 게 고삐에는 가장 좋은 일일지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410239
					],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722410239,
					"content": "이런 재능이… 이런 재능이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아베라쿠"
				},
				{
					"id": 722410224,
					"content": "누군가의 생일에…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410225
					]
				}
			]
