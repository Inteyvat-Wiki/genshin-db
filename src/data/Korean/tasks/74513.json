							4988.518
						],
						"pointId": 340500104
					}
				]
			},
			"dialogs": [
				{
					"id": 745130101,
					"content": "안녕하세요, 생론파 학자이자 바자르와 바다 이슬 항구의 새롭게 떠오르는 상인인 바히마 5세라고 합니다. 부탁이니 잠시만 시간을 내주시겠어요…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130102
					],
					"speakerTitle": "바히마 5세"
				},
				{
					"id": 745130102,
					"content": "아주 중요한 얘기를 해드릴 테니 몸과 마음을 가볍게 하고 귀를 기울여 주세요——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130103
					],
					"speakerTitle": "바히마 5세"
				},
				{
					"id": 745130103,
					"content": "세상에서 제일 귀여운 건, 바로 참새랍니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130104
					],
					"speakerTitle": "바히마 5세"
				},
				{
					"id": 745130104,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745130105,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130106
					]
				},
				{
					"id": 745130106,
					"content": "참새가 귀여운 건 알겠는데… 방금 자기 입으로 학자 겸 상인이라고 하지 않았어? 그렇게 단정 지어 말하는 건 논쟁을 불러일으키지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745130107,
					"content": "내가 알기론 학자들은 말을 신중하게 하고, 상인들도 과장된 말은 함부로 하지 않았던 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745130108,
					"content": "누군가에게 「내 이론이 가장 정확하다」라거나 「내 상품이 최고다」라고 말하고 다니면, 네 말에 동의하지 않는 사람들의 표적이 되어서 트집 잡힐 일이 많아지지 않을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745130109,
					"content": "어라? 어쩐지 이 대화, 어디서 들어본 것 같은 느낌이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130110,
						745130111,
						745130112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745130110,
					"content": "그럼 저도 할 말이 있어요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130113
					]
				},
				{
					"id": 745130113,
					"content": "#윽! {NICKNAME}, 너 갑자기 왜 그래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745130114,
					"content": "농담이 아니더라도 그렇게 크게 말하진 말라구…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130115
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745130115,
					"content": "하하하! 바로 그 기세예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130116
					],
					"speakerTitle": "바히마 5세"
				},
				{
					"id": 745130116,
					"content": "세상에 절대적인 1등이 없다는 건 물론 저도 알아요. 그 어떤 학술 이론도 뒤집힐 가능성이 존재하고, 어떤 상품이든 신제품에 밀려날 수 있죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130117
					],
					"speakerTitle": "바히마 5세"
				},
				{
					"id": 745130117,
					"content": "하지만 객관적인 세상이 어떻게 바뀌든, 사람의 마음속에는… 저마다 자기가 최고라 여기는 사람이나 사물이 있어요. 다른 사람이 뭐라고 하든, 그러한 것들은… 가장 높은 가치를 지니죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130118
					],
					"speakerTitle": "바히마 5세"
				},
				{
					"id": 745130118,
					"content": "자신감을 잃고 타인에게 부정당할까 두려워하면 절대로 본인이 생각하는 최고의 모습이 될 수 없어요. 나를 인정해 줄 친구도 찾을 수 없고요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130119
					],
					"speakerTitle": "바히마 5세"
				},
				{
					"id": 745130119,
					"content": "여러분들도 제가 만든 「우당탕탕 짹짹볼」 게임을 해봤다면, 저처럼 참새가 제일 귀여워라고 외치고 있을걸요?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130120
					],
					"speakerTitle": "바히마 5세"
				},
				{
					"id": 745130120,
					"content": "우당… 탕탕… 짹짹볼? 네 옆 테이블 위에 있는 저걸 말하는 거야? 왠지 어디서 본 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745130121,
					"content": "네, 이 게임을 해보시면 제가 왜 참새가 세상에서 가장 귀엽다고 했는지 알게 될 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130122
					],
					"speakerTitle": "바히마 5세"
				},
				{
					"id": 745130122,
					"content": "실은 지금 이 보드게임을 홍보하는 중이거든요. 게임에서 높은 점수를 얻으면 상품도 받을 수 있어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130123
					],
					"speakerTitle": "바히마 5세"
				},
				{
					"id": 745130123,
					"content": "나도 참새가 귀엽다고 생각해. 재밌게 놀 수만 있으면 상품이 많지 않아도 난 좋아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745130124,
					"content": "#{NICKNAME}, 넌 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130125,
						745130126
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 745130125,
					"content": "나도 해보고 싶어!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130127
					]
				},
				{
					"id": 745130127,
					"content": "헤헤, 곧 우리가 같은 생각을 하게 될 것 같네요! 그럼 마음껏 즐겨주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바히마 5세"
				},
				{
					"id": 745130126,
					"content": "참새가 얼마나 귀여운지 어디 한번 보자고!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130127
					]
				},
				{
					"id": 745130111,
					"content": "세상에서 제일 귀여운 건, 페이몬이에요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130113
					]
				},
				{
					"id": 745130112,
					"content": "반박은 받지 않을게요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130113
					]
				}
			]
		}
	]
}