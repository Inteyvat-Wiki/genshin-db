					"청주"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090401,
					"content": "수확이 좀 있었나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090402
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718090402,
					"content": "제법 있었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090403
					]
				},
				{
					"id": 718090403,
					"content": "엇? 빨리 말해줘요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090404
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718090404,
					"content": "남쪽 부두에 개가 참 많더라구요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090405
					]
				},
				{
					"id": 718090405,
					"content": "오, 좋네요. 삶의 정취가 가득해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090406
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718090406,
					"content": "「불복려」 주변에 참새가 많았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090407
					]
				},
				{
					"id": 718090407,
					"content": "참새라, 음… 평화로운 모습이니 시의 소재로 딱이네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090408
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718090408,
					"content": "어떤 사람들은 먹는 것에만 신경을 쓰죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090409
					]
				},
				{
					"id": 718090409,
					"content": "그것도 틀린 건 아니죠. 먹는 건 가장 중요한 일이잖아요. 특히… 이 리월에서는요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090410
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718090410,
					"content": "그것도 흥미롭네요. 일단 적죠. 시의 소재가 될 수도 있으니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090411
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718090411,
					"content": "변화가 너무 빠르다고 느끼는 사람이 있더라구요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090412
					]
				},
				{
					"id": 718090412,
					"content": "음… 그렇게 느끼는 것도 정상이죠. 지금의 리월은 날마다 새로워지고 있어요. 저도 적응이 안 되는 것들이 있으니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090413
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718090413,
					"content": "다만 이건 좀 광범위한 주제라서 시 한 편으론 부족할 것 같네요…. 그래도 일단 적어야겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090414
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718090414,
					"content": "이 정도면 충분해요. 역시 당신에게 부탁하길 잘했네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090415
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718090415,
					"content": "다음 시집에 신작을 몇 편 더할 수도 있겠어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090416
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718090416,
					"content": "맞다, 이런 세속적인 거 말고… 이거도 받아주세요, 제 성의예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090417
					],
					"speakerTitle": "청주"
				},
				{
					"id": 718090417,
					"content": "다음 시집이 출판되면, 이걸로 사인된 책을 교환할 수 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "청주"
				}
			]
		},
