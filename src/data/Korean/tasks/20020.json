				"points": []
			},
			"dialogs": [
				{
					"id": 200200101,
					"content": "그렇구나, 그렇구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200102
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200102,
					"content": "오빠, 이 식물은 요리하는 것 외에 다른 용도로도 쓰이기도 해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200103
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200103,
					"content": "내가 그걸 어떻게 알아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200104
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200200104,
					"content": "난 어디서 채집할 수 있는지, 먹을 수 있는지 없는지 정도만 알아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200105
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200200105,
					"content": "음… 그럼 직접 가서 확인해 봐야겠다. 걱정하지 마 오빠, 식물들을 채집하러 가는 거니까, 마물들 근처에는 절대 안 갈게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200106
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200106,
					"content": "휴, 어떻게 해야 할지 네가 알고 있으면 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200107
					],
					"speakerTitle": "앤서니"
				},
				{
					"id": 200200107,
					"content": "알겠어, 오늘은 조금 늦게 올 수도 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200108,
						200200109
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200108,
					"content": "아직 훈련 중이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				},
				{
					"id": 200200110,
					"content": "여행자! 마침 잘 왔어, 지금 막 식물을 관찰하러 가려고 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200111
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200111,
					"content": "사이러스 삼촌이 그러는데, 모험가는 야외에서 노숙을 할 때가 많아서 식량을 찾는 게 가장 중요하다고 했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200112
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200112,
					"content": "그래서 일단 야외에 어떤 식물들이 있는지 관찰부터 하고 식물들의 분포도와 특성을 기록해서 천천히 기억할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200113
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200113,
					"content": "그러면 다음에 야외에서 식량을 찾을 때 어떤 식물은 먹어도 되고 어떤 식물은 먹으면 안 되는지 구분할 수 있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200114
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200114,
					"content": "하지만… 문자로만 기록해서 외우는 건 직관적이지 못한 거 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200115
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200115,
					"content": "「사진기」라는 물건이 있다고 들었는데, 맞아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200116
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200116,
					"content": "혹시 괜찮으면 「사진기」로 식물들의 성장 환경을 기록해 줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200117
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200117,
					"content": "물론이지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200118
					]
				},
				{
					"id": 200200118,
					"content": "그럼 우선 통통 연꽃이랑, 등불꽃 그리고 세실리아꽃의 성장 환경을 기록해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200119
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200119,
					"content": "그리고 그 3가지 식물도 가져다줘. 표본으로 만들어서 보관하고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200120
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200120,
					"content": "식물의 성장 환경 기록 사진, 실제 식물 표본, 자세한 문자 설명…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200121
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200121,
					"content": "내 「모험가의 식물 노트」 정말 괜찮을 거 같지 않아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200122
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200122,
					"content": "그럼 부탁 좀 할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200123
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200123,
					"content": "샘물 마을에 있는 샘물 옆에 통통 연꽃이 많아, 등불꽃은 울프 영지에서 찾을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200124
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200124,
					"content": "세실리아꽃은… 별을 따는 절벽에 가야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200125
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200125,
					"content": "나는 다른 곳에 가서 식물들을 계속 관찰할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200126
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200200126,
					"content": "사진을 찍고 다시 여기서 만나자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "안나"
				},
				{
					"id": 200200109,
					"content": "훈련은 잘돼가고 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				}
			]
		},
