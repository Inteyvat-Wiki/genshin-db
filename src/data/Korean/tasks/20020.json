			"trigger": {
				"objectNames": [
					"안나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200201001,
					"content": "왔어? 어때, 사진은 찍었어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201002
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200201002,
					"content": "전부 찍었고, 다 채집해왔어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200201003
					]
				},
				{
					"id": 200201003,
					"content": "와! 사진을 이렇게 빨리 찍다니… 이게 바로 경험이 많은 모험가의 실력인 건가? 정말 대단해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201004
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200201004,
					"content": "정말 고마워! 음… 이렇게 하자, 감사의 의미로 맛있는 요리를 대접할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201005
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200201005,
					"content": "어때, 괜찮아 보이지, 맛있게 먹어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201006
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200201006,
					"content": "난 가서 필기 좀 할게. 음… 이 식물 같은 경우는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201007
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200201007,
					"content": "나는 잭을 찾아가서 식물 표본을 만드는 방법을 아는지 물어볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201008
					],
					"speakerTitle": "안나"
				},
				{
					"id": 200201008,
					"content": "세실리아꽃은 표본 말고 꽃병에 꽂아둬야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "안나"
				}
			]
		},
