				"points": []
			},
			"dialogs": [
				{
					"id": 730380201,
					"content": "이건 아란나의 아란라칼라리잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380202
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730380202,
					"content": "저 나라가 바로 아란나의 나라 친구야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380203
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730380203,
					"content": "#응, 그럼 {NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730380204,
					"content": "(비야의 열매를 사용한다)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7303803,
			"completionStepIds": [
				7303803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
