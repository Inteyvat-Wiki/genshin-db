				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"라나",
					"페이몬",
					"아란나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730380301,
					"content": "윽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380302
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380302,
					"content": "깼어…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380303,
						730380304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730380303,
					"content": "내 말 들려요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380305
					]
				},
				{
					"id": 730380305,
					"content": "#응? 나 또 잠든 건가… 여긴 어디지? 페이몬이랑 {NICKNAME}, 무사해서 정말 다행이야! 얼마나 걱정했는지 몰라. 죽음의 땅에 당한 건 아니지? 그리고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380306
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380306,
					"content": "아란나? 너 맞지? 아란나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380307
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380307,
					"content": "안녕, 나라 친구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380308
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730380308,
					"content": "아주 오랫동안 널 기다렸어…. 나 무척 긴 꿈을 꿨는데 널 처음 만난 날이었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380309
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380309,
					"content": "꿈에서 난 숲에서 길을 잃은 채로 집도 못 찾고, 엄마랑 아빠도 못 찾아서 계속 울고 있었어. 그때 네가 내 울음소리를 듣고 다가와서 나한테 노래를 불러줬지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380310
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380310,
					"content": "그 뒤로 우린 가장 좋은 친구가 되었어. 난 항상 널 만나기 위해 숲으로 갔고 넌 나에게 꽃을 선물로 줬지. 그리고 나한테 숲의 비밀을 많이 알려줬어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380311
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380311,
					"content": "예를 들면 별 버섯은 하늘의 별이 땅에 떨어진 그림자고, 달 연꽃이 피는 걸 보면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380312
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380312,
					"content": "달 연꽃이 피는 걸 보면, 다음 달이 떠오를 때까지 행운이 깃든다는 것 말이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380313
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730380313,
					"content": "맞아! 바로 그거야! 그리고 또…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380314
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380314,
					"content": "꿈에서 난 비마라 마을 사람들을 위해 믿음직한 어른으로 자라 숲의 순찰관이 됐어. 하지만 믿음직한 어른은 숲에 요정이 산다는 동화는 믿지 않았지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380315
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380315,
					"content": "꿈에서 난 널 잊어버렸어. 난 아란나라의 이야기가 이오탐 같은 아이들을 위한 동화라고 생각했거든. 꿈속의 숲은 나무가 가득한 땅일 뿐 마법은 존재하지 않았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380316
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380316,
					"content": "그래서 깨어났을 때 정말 널 잊어버린 거면 어떡해야 하나 너무 무서웠어…. 그냥 꿈이라서 정말 다행이야. 다시 만나서 너무 기뻐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380317
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380317,
					"content": "아란나, 대체 어디 갔었던 거야! 네가 날 다시 숲으로 데려가 주길 얼마나 기다렸는데…. 너와 함께 있을 때만 나타났던 그 비밀스럽고 신비로운 숲 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380318
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380318,
					"content": "미안해, 아란나는 더 이상 널 기억하지 못해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380319
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730380319,
					"content": "뭐…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380320
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380320,
					"content": "음… 라나, 아란나를 원망하지 마. 그게 어떻게 된 거냐면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380321
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730380321,
					"content": "「…널 찾다가 아란나를 만났어. 아란나는…」",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730380322
					]
				},
				{
					"id": 730380322,
					"content": "마우티이마 숲에 있던 버섯, 비의 끝자락에서 벌인 전투, 유적 거상의 내부, 장미 속의 작은 노래, 남매 연기를 하는 아란나라, 즐거웠던 우트사바 축제까지….\\n그동안 아란나라와 함께 겪었던 일들을 라나와 아란나에게 천천히 들려준다",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730380323
					]
				},
				{
					"id": 730380323,
					"content": "모든 걸 잊은 건 사실 나였구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380324
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380324,
					"content": "비야의 열매는 기억으로 피어나는 거야…. 너와 함께했던 기억이 아란나에게 정말 소중했나 봐. 그래서 널 치료할 때 과거의 기억까지 되찾을 수 있었던 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380325
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730380325,
					"content": "#페이몬이랑 {NICKNAME}, 고마워. 날 돕기 위해 그렇게 많은 시련을 겪었다니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380326,
						730380328
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380326,
					"content": "괜찮아요. 그 과정에서 우리도 많은 걸 얻었으니까요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380327
					]
				},
				{
					"id": 730380327,
					"content": "맞아! 라나가 고마워해야 할 사람은 아란나와 아란마라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380329
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730380329,
					"content": "고마워… 그리고 미안해. 아란나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380330
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380330,
					"content": "흑흑… 내가 널 잊어버렸다니…. 내가 미웠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380331
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380331,
					"content": "모르겠어. 아란나는 이미 모든 걸 잊어버렸으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380332
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730380332,
					"content": "하지만 괜찮아. 아란나가 기억을 포기하면서까지 널 도와줬다는 건 네가 아란나에게 추억보다 더 소중한 나라였다는 뜻이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380333
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730380333,
					"content": "맞아… 이렇게 말하면 아란나한테 불공평할 수도 있겠지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380334
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730380334,
					"content": "#아란자가 말했어. 아란나라의 수명은 아주 길다고! 앞으로 두 사람은 더 소중한 추억을 쌓을 수 있을 거야. 나랑 {NICKNAME}처럼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380335
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730380335,
					"content": "그래, 맞아…. 우리한테는 아직 시간이 많아. 다시 한번 숲과 세상의 거대함 그리고 무한한 미래를 알아가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380336
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380336,
					"content": "좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380337
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730380337,
					"content": "#마라나… 그리고 죽음의 땅에 관한 건 내가 잠들었을 때 거의 다 해결된 것 같네. {NICKNAME}, 페이몬 그리고 수많은 아란나라들, 정말 고마워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380338
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380338,
					"content": "이기적으로 들릴지도 모르지만 난 아란나와 여행을 가고 싶어. 그런데 비마라 마을의 아이들이 다시 위험해질까 봐 걱정돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380339
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380339,
					"content": "하마터면 잊어버릴 뻔했네. 그 나쁜 녀석을 아직 혼내주지 못했잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380340
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730380340,
					"content": "그 녀석이 누군지 대충 알 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380341
					]
				},
				{
					"id": 730380341,
					"content": "뭐? 누군데? 오잉, 난 왜 아무것도 모르는 건데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380342
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730380342,
					"content": "그러니까! 누가 그런 짓을 저지른 거야? 떠나기 전에 제대로 때려줘야겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380343,
						730380344
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380343,
					"content": "나한테 맡겨요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380345
					]
				},
				{
					"id": 730380345,
					"content": "그렇구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380346
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380346,
					"content": "#난 널 믿어, {NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380347
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380347,
					"content": "이렇게 말하면 이상하게 들리겠지만… 그 사람이 꼭 나쁜 짓만 저지른 건 아닌 것 같아. 아이들이 실종되지 않았다면 나도 숲의 순찰 횟수를 늘리지 않았을 거고——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380348
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380348,
					"content": "숲의 순찰 횟수를 늘리지 않았다면 그 시간에 그곳에서 버섯몬과 마주치지도 않았겠지. 그럼 너랑 페이몬처럼 정직하고 착한 데다, 다른 사람을 기꺼이 도와주는 사람들을 만나지도 못했을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380349
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380349,
					"content": "#덕분에 {NICKNAME}와(과) 페이몬을 알게 됐잖아. 너희한테 정말 많은 도움을 받았어. 날 구해주고 소중한 친구와 다시 만날 수 있게 해줬으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380350
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380350,
					"content": "#고마워, {NICKNAME}. 고마워, 페이몬",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380351
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380351,
					"content": "괜찮아! 하지만 라나가 떠나면 이오탐, 카부스, 수다베가 슬퍼할 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380352
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730380352,
					"content": "#그 아이들은 생각보다 훨씬 더 강해. 그리고 이젠 {NICKNAME} {M#형아}{F#언니}가 있잖아. 게다가 내가 영원히 돌아오지 않는 것도 아니고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380353
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380353,
					"content": "#난 꼭 다시 돌아와서 아이들에게 다양한 이야기를 들려줄 거야. 그리고 {NICKNAME}(을)를 소개해 줬던 것처럼 아이들에게 아란나도 소개해 줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380354
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380354,
					"content": "그래… 그럼 다행이다. 다시 안 오면 어쩌나 했거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380355
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730380355,
					"content": "아란나, 나랑 같이 여행하지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380356
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380356,
					"content": "좋아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380357
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730380357,
					"content": "넌 날 위해 많은 걸 잃어버렸어. 하지만 페이몬이 말한 것처럼 앞으로 더 많은 추억을 만든다면 네 마음속의 텅 빈 부분을 다시 채울 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380358
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380358,
					"content": "난 라나라고 해. 내 친구가 되어 줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380359
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380359,
					"content": "응, 나라나. 예전에도, 앞으로도 우린 좋은 친구일 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380360
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730380360,
					"content": "어, 이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380361
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730380361,
					"content": "라나의 가슴에서 심장처럼 따뜻하고 부드러운 밝은 빛이 뿜어져 나온다.\\n라나는 손으로 가려도 보고, 무엇인지 알아내려 했지만 빛은 의식을 가진 것처럼 라나의 손으로 빨려 들어간다.\\n빛이 천천히 사라지자, 라나의 손엔 정교한 장식품만이 남아 있다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730380362
					]
				},
				{
					"id": 730380362,
					"content": "신의 눈이에요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380363
					]
				},
				{
					"id": 730380363,
					"content": "이런 상황은 처음인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380364
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730380364,
					"content": "신이 내 소원을 들어주셨나 봐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380365
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380365,
					"content": "#이것만 있으면 여행을 걱정하지 않아도 되겠어! 아직 남아있는 죽음의 땅을 다시 만난다고 해도 내가 해결할 수 있을 거야. 나도 {NICKNAME}처럼 싸울 수 있었으면 좋겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380366
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380366,
					"content": "해야 할 일이 많아. 모두와 인사도 나눠야 하고 타이나리 선배한테도 여행을 가겠다고 말씀드려야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380367
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380367,
					"content": "#페이몬, 아란나, {NICKNAME}. 모두들 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380368
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380368,
					"content": "#페이몬이랑 금빛의 나라{NICKNAME}, 정말 고마워. 비록 아란나는 너희를 기억하지 못하지만 너희는 분명 좋은 나라일 거야. 덕분에 나라나와 다시 만날 수 있었어. 정말 기뻐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380369,
						730380372
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730380369,
					"content": "만나서 정말 반가웠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380370,
						730380371
					]
				},
				{
					"id": 730380370,
					"content": "조심해야 해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380373
					]
				},
				{
					"id": 730380373,
					"content": "라나와 아란나… 순조로운 여행하길 바랄게. 그리고 절대 우릴 잊지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380374
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730380374,
					"content": "「바람에 지지 말고, 비에도 지지 말라. 겨울의 눈에 지지 말고, 여름의 더위에도 지지 말라…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380375
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380375,
					"content": "#전에 이런 시를 들은 적 있어. 우리가 다시 만날 땐 난 분명 더 강해진 모습일 거야. {NICKNAME}, 페이몬. 우린 반드시 다시 만날 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380376
					],
					"speakerTitle": "라나"
				},
				{
					"id": 730380376,
					"content": "우린 반드시 다시 만날 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란나"
				},
				{
					"id": 730380371,
					"content": "여행을 통해 많은 걸 얻길 바랄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380373
					]
				},
				{
					"id": 730380372,
					"content": "잘 가",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380373
					]
				},
				{
					"id": 730380344,
					"content": "아직 실질적인 증거는 없어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380345
					]
				},
				{
					"id": 730380328,
					"content": "라나 씨가 고마워해야 할 사람은 아란나와 아란마예요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380329
					]
				},
				{
					"id": 730380304,
					"content": "큰 문제는 없어 보이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380305
					]
				}
			]
		}
	]
}