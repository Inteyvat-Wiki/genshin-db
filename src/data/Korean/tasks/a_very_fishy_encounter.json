	"talks": [
		{
			"id": 7004601,
			"completionStepIds": [
				7004601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7004601",
							"2"
						],
						"stepId": 7004601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"잘리아"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700460101,
					"content": "완벽해. 준비 작업은 다 끝났고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460102
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 700460102,
					"content": "힘내자, 잘리아! 며칠 안에 모조리 잡아버리자고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460103,
						700460104
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 700460103,
					"content": "뭐, 뭘 잡아요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				},
				{
					"id": 700460105,
					"content": "히익! 폰타인에도 밀렵꾼이 나타나다니…. 요즘 동물 밀매가 돈이 좀 되나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700460106,
					"content": "안 돼, 그럴 순 없지. 우리가 널 먼저 잡아서 법률 집행청으로 데려가겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700460107,
					"content": "…너희구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460108
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 700460108,
					"content": "아주 좋아. 방금 막 법률 집행청에서 돌아왔는데, 내가 길을 안내해 줄까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460109
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 700460109,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460110,
						700460112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700460110,
					"content": "좋아요. 시원시원해서 마음에 드네요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460111
					]
				},
				{
					"id": 700460111,
					"content": "잠깐, 뭔가 이상한데… 자기를 잡아가겠다고 해도 전혀 무서워하지 않는다면 보통 상습범이거나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700460114,
					"content": "정의의 편에 선 착한 사람이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460115
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 700460115,
					"content": "정확히 말하자면, 난 환경을 위해 싸우는 법률 집행청의 특별 고문——「방생 사냥꾼」이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460116
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 700460116,
					"content": "내가 잡는 건 폰타인 수역에 침입한 외래종 물고기거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460117
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 700460117,
					"content": "외… 외래종?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460118,
						700460120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700460118,
					"content": "어디서 들어본 것 같아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460119
					]
				},
				{
					"id": 700460119,
					"content": "아, 그래. 전에 몬드에서 비슷한 일을 들어본 적이 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700460122,
					"content": "지나간 일은 나중에 얘기하자. 지금 상황이 더 중요해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460123
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 700460123,
					"content": "이 외래종 물고기들은 이상한 믿음을 가진 상인들이 일부러 방생한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460124
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 700460124,
					"content": "그중에는 흉포하거나 번식 능력이 뛰어난 애들도 있고, 특별한 사료를 먹고 자란 애들도 있는데, 토착 물고기들에게 아주 큰 골칫거리지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460125
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 700460125,
					"content": "녀석들이 토착 물고기들을 몰아내고 수중 생물의 생태 구조를 바꿔버리면, 폰타인의 수질에 영향을 끼칠 수도 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460126
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 700460126,
					"content": "폰타인 사람들의 건강에 영향을 줄 수 있다는 장기적인 문제는 놔두더라도, 우선 폰타 같은 음료의 맛은 아주 금방 바뀔 거야. 그럼 폰타인의 경제도 영향을 받을 테니 일이 커지겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460127,
						700460128
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 700460127,
					"content": "폰타가 망하게 둘 순 없죠!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460129,
					"content": "말은 가볍게 했지만 이건 과소평가할 문제가 아닌 것 같네. 이대로 가만히 있을 순 없지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460130
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700460130,
					"content": "물고기 잡는 건 우리도 전문인데, 조금 도와줄까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700460131,
					"content": "좋아! 그 말을 해주길 기다리고 있었어. 이래야 너희답지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460132
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 700460132,
					"content": "포획 구역은 이미 만들어 놨어. 침입한 외래종 물고기들이 안에 넣은 미끼에 이끌려 몰려들 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460133
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 700460133,
					"content": "정의의 힘을 보여주자고, 명예 기사랑 하얀 조수! 최선을 다해 응원할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460134
					],
					"speakerTitle": "잘리아"
				},
				{
					"id": 700460134,
					"content": "왠지 모르겠지만 이 사람, 우리에 대해 잘 아는 것 같은데… 내 착각인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700460128,
					"content": "전 잘 안 마시지만, 폰타는 소중해요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460120,
					"content": "그게 뭔가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460121
					]
				},
				{
					"id": 700460121,
					"content": "아주 오래전에 몬드에서 비슷한 일을 들어본 적이 있는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700460112,
					"content": "잠깐… 우리가 뭔가 오해한 것 같은데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460113
					]
				},
				{
					"id": 700460113,
					"content": "그런 것 같아. 자기를 잡아가겠다고 해도 전혀 무서워하지 않는다면 보통 상습범이거나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 700460104,
					"content": "밀, 밀렵꾼?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				}
			]
		}
	]
}