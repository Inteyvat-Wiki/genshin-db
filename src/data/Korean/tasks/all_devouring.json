				]
			},
			"dialogs": [
				{
					"id": 150360201,
					"content": "앞에 길이 끊긴 것 같아! 그 나쁜 놈이 여기에 숨어 있는 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360202
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150360202,
					"content": "안개가 엄청나서 아무것도 안 보여!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150360203,
					"content": "전에 넌 여기서 습격당하고 영혼 조각을 빼앗겼을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360204
					],
					"speakerTitle": "스커크"
				},
				{
					"id": 150360204,
					"content": "너의 영혼 조각이 어디에 있는지 느껴져?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360205
					],
					"speakerTitle": "스커크"
				},
				{
					"id": 150360205,
					"content": "(눈을 감고 몸에서 흩어지던 빛을 떠올려 본다… 근처에 있는 것 같지만, 구체적인 방향은 알 수 없다)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360206,
						150360207
					]
				},
				{
					"id": 150360206,
					"content": "모르겠어…!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				},
				{
					"id": 150360208,
					"content": "미리 조각의 기운을 숨겨뒀나 보네. 그게 아니면 영혼 간에 더 강한 공명이 일어났을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360209
					],
					"speakerTitle": "스커크"
				},
				{
					"id": 150360209,
					"content": "잠깐만, 저기 봐! 가시가 또 나타났어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150360210,
					"content": "마음 놓고 공격할 수도 없는 상황이네. 일단 반격할 때 힘을 아끼고 상대의 움직임부터 살펴봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360211
					],
					"speakerTitle": "스커크"
				},
				{
					"id": 150360211,
					"content": "네 영혼 조각을 빼앗아 갔으니 분명 그걸로 뭐든 하려 할 거야. 어떤 공격 속에 숨겼을 수도 있으니, 어떻게든 찾아내",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "스커크"
				},
				{
					"id": 150360207,
					"content": "근처에 있다는 것만 느껴져",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				}
			]
		},
