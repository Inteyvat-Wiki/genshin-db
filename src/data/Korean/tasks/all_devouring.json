			"dialogs": [
				{
					"id": 150360101,
					"content": "여긴… 층암거연 근처 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150360102,
					"content": "여기로 들어가면 네가 꿈에서 본 공간에 갈 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360103
					],
					"speakerTitle": "스커크"
				},
				{
					"id": 150360103,
					"content": "심연 비경과 비슷하긴 해도 다른 녀석의 영역이니 조심하도록 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360104
					],
					"speakerTitle": "스커크"
				},
				{
					"id": 150360104,
					"content": "걱정 마, 난 네 뒤에 숨을게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150360105,
					"content": "헤헤, 너도 너무 무리하지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360106,
						150360107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 150360106,
					"content": "안심해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				},
				{
					"id": 150360108,
					"content": "가자. 특훈에서 배운 걸 잘 떠올려 봐. 도움이 될지도 모르니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "스커크"
				},
				{
					"id": 150360107,
					"content": "그 「도둑」 녀석을 혼쭐내주자고",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				}
			]
		},
