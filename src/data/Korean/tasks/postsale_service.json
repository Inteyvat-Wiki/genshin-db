				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370101,
					"content": "큰일이야… 어떻게 이럴 수가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370102
					],
					"speakerTitle": "바히드"
				},
				{
					"id": 220370102,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370103
					]
				},
				{
					"id": 220370103,
					"content": "여행자, 그렇지 않아도 찾고 있었어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370104
					],
					"speakerTitle": "바히드"
				},
				{
					"id": 220370104,
					"content": "콘다 덴스케 씨 기억해? 얼마 전 가게로 와서 비료에 대해 물어보셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370105
					],
					"speakerTitle": "바히드"
				},
				{
					"id": 220370105,
					"content": "비료가 마음에 드신대요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370106
					]
				},
				{
					"id": 220370106,
					"content": "마음에 들고 말고 할 것도 없어… 아니, 정확하게 말하자면… 콘다 덴스케 씨가 「혼란」에 빠진 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370107
					],
					"speakerTitle": "바히드"
				},
				{
					"id": 220370107,
					"content": "혼란이요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370108
					]
				},
				{
					"id": 220370108,
					"content": "음, 지난번 네가 가게를 홍보한 후, 덴스케 씨는 네가 말한 방법대로 우리 가게의 비료를 사용했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370109
					],
					"speakerTitle": "바히드"
				},
				{
					"id": 220370109,
					"content": "그런데 그 후 농작물이 자라긴 했는데… 밭에 원인 불명의 버섯도 잔뜩 자랐대…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370110
					],
					"speakerTitle": "바히드"
				},
				{
					"id": 220370110,
					"content": "덴스케 씨의 얘기에 솔직히 나도 좀 혼란스럽더라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370111
					],
					"speakerTitle": "바히드"
				},
				{
					"id": 220370111,
					"content": "어쨌든 밭에 사용한 비료와 연관이 있는 건 틀림없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370112
					],
					"speakerTitle": "바히드"
				},
				{
					"id": 220370112,
					"content": "여행자, 콘다 마을로 가서 덴스케 씨 밭의 버섯들을 제거해주지 않을래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370113,
						220370116
					],
					"speakerTitle": "바히드"
				},
				{
					"id": 220370113,
					"content": "맡겨주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370114
					]
				},
				{
					"id": 220370114,
					"content": "그럼 부탁할게, 난 가게에서 자료를 좀 더 찾아봐야겠어. 대체 왜 이런 상황이 발생하게 된 건지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370115
					],
					"speakerTitle": "바히드"
				},
				{
					"id": 220370115,
					"content": "휴, 엘라니가 있었으면 좋았을 텐데. 그럼 원인을 바로 찾아냈겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바히드"
				},
				{
					"id": 220370116,
					"content": "엘라니에게 이 문제에 대한 연구를 부탁하는 건 어때요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370117
					]
				},
				{
					"id": 220370117,
					"content": "그녀가 있다면 분명 원인을 금방 찾아낼 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370118
					],
					"speakerTitle": "바히드"
				},
				{
					"id": 220370118,
					"content": "하지만 엘라니는 아직도 돌아오지 않고 있어. 어디 갔는지도 모르겠고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370119
					],
					"speakerTitle": "바히드"
				},
				{
					"id": 220370119,
					"content": "그래서 너한테 부탁하는 수밖에 없어. 난 가게에서 자료를 좀 더 찾아볼게. 왜 이런 상황이 발생했는지 알아봐야지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "바히드"
				}
			]
		},
