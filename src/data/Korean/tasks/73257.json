					"content": "나무에서 꽃이 자라는 것 같은데… 이제 어떻게 해야 하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571703
					],
					"speakerTitle": "페이몬"
				},
