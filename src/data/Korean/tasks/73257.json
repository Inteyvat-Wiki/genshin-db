			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"소루쉬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732570101,
					"content": "유적 공장에서 나온 뒤로 소루쉬가 갑자기 조용해졌네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732570102,
					"content": "지금까지 쉬지도 않고 얘기하다가 이렇게 조용해지니까 너무 어색해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570103,
						732570104,
						732570105
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732570103,
					"content": "겁먹은 건 아니겠지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570106,
					"content": "소루쉬, 정신 차려야 해. 아직 할 일이 많이 남았다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732570107,
					"content": "뭐였더라…. 그 이름도 희한한 의식도 끝내야 하고, 그 큰 구멍도 해결해야 하잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732570108,
					"content": "모든 일을 다 끝내고 나면 다 같이 맛있는 거 먹으러 가자. 다들 엄청 고생했으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732570109,
					"content": "뭐가 좋을까… 음, 페리는 무슨 음식을 좋아할지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732570110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570111
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732570111,
					"content": "…페리는 음식을 먹을 필요가 없어, 바보 두둥실이",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570112
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732570112,
					"content": "어휴, 이 내가 흰두둥실이에게 위로받을 날이 올 줄이야. 수치스러운 것도 정도가 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570113
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732570113,
					"content": "지금 당장 「잿빛 수정」 안에 봉인되어 버리든가, 아니면 나를 아는 녀석들이 전부 사라져 버릴 때까지 잠들어 있을 수 있는 동굴로 숨어버리고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570114
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732570114,
					"content": "흰두둥실이라고 부르지 말라고 했지! 근데 진짜 그런 동굴이 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570115,
						732570117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732570115,
					"content": "도망치는 건 해결 방법이 될 수 없어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570116
					]
				},
				{
					"id": 732570116,
					"content": "난 이제 아무것도 신경 쓰고 싶지 않아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732570119,
					"content": "나세주나 녀석에게 속아서 고생하던 꼴이 너무 우습잖아. 창피해서 견딜 수가 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570120
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732570120,
					"content": "어쨌든 「크{RUBY#[D]신성한 빛}바레나의 노래」는 손에 넣었으니까, 그 기상 현상을 해결하고 싶으면 꽃바다로 가서 미히르나 라슈누를 찾으면 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570121
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732570121,
					"content": "아무튼 날 좀 내버려 둬. 그전에 내가 했던 말들도 다 잊어주고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570122
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732570122,
					"content": "음, 네가 이상한 말을 많이 하긴 했지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570123,
						732570124,
						732570125
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732570123,
					"content": "「나의 찬송의 주인」?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570126,
					"content": "으윽, 제발 그만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570127
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732570127,
					"content": "#{NICKNAME}, 소루쉬 그만 놀려! 이렇게 오랫동안 같이 모험했는데, 인제 와서 소루쉬가 포기하면 안 되잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732570128,
					"content": "게다가 소루쉬에겐 아주 대단한 점도 있잖아. 예를 들어… 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570129
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732570129,
					"content": "방금 고민한 거지! 흑흑… 날 설득하려고 하지 마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570130,
						732570131
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732570130,
					"content": "행동력이 강하다거나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570132,
					"content": "응응, 맞아. 게다가 우리는 계속 함께 이상 현상 문제를 해결하려고 노력했잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570133
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732570133,
					"content": "여기까지 오게 된 것도 다 소루쉬 네 덕분이고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570134
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732570134,
					"content": "그 말이 뭐였더라? 맞아, 「계속 노력하면 훌륭한 모험가가 되는 것도 시간문제일 거야」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570135
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732570135,
					"content": "정말이야? 정말 진심으로 칭찬해 주는 거 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570136
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732570136,
					"content": "이건 친구의 칭찬인걸",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570137
					]
				},
				{
					"id": 732570137,
					"content": "후후, 역시 나답다고 할 수 있겠군!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570138
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732570138,
					"content": "갑자기 힘이 나기 시작했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570139
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732570139,
					"content": "소루쉬가 움직일 힘이 생겼으니까, 어서 주르반을 찾으러 가자. 빨리 그 큰 구멍 문제를 해결하고 보상을 받는 거야! 맛있는 밥이 우리를 기다리고 있다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 732570131,
					"content": "책임감이 강하다거나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570124,
					"content": "「용맹한 자태」?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570125,
					"content": "「운명적인 희생」?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570117,
					"content": "너한테는 꼭 해야 할 일이 있잖아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570118
					]
				},
				{
					"id": 732570118,
					"content": "그렇기는 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 732570104,
					"content": "그런 일을 겪었으니까…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570105,
					"content": "소루쉬도 피곤할 거야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				}
			]
		},
		{
			"id": 7325702,
