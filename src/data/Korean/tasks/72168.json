			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"동욱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680301,
					"content": "이렇게… 그리고 이렇게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680302
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680302,
					"content": "다 만들었어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680303
					]
				},
				{
					"id": 721680303,
					"content": "마지막 단계야… 튀김 옷을 입히고 튀겨주기만 하면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680304
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680304,
					"content": "「벚꽃 모둠튀김」 완성! 어서 먹어 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680305
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680305,
					"content": "맛, 맛있어, 근데… 좀 뜨겁네… 호오오…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680306
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 721680306,
					"content": "동욱, 「모둠튀김」이라는 음식은 소스를 곁들여 먹어야 한대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680307
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721680307,
					"content": "소스? 그건 내가 준비를 못 했는데, 다음에 기회가 생기면 그것도 연구해볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680308
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680308,
					"content": "이 「벚꽃 모둠튀김」은 네 거야, 받아 줘. 도와줘서 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680309
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680309,
					"content": "그리고 이건 「벚꽃 모둠튀김」 레시피야, 이것도 가져가",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680310
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680310,
					"content": "기회가 되면 직접 만들어 봐, 요리하는 건 꽤 재밌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680311,
						721680313
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680311,
					"content": "고마워",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680312
					]
				},
				{
					"id": 721680312,
					"content": "사양 말고 받아줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680314
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680314,
					"content": "이나즈마에서 한동안 머물 거야, 좀 지나면 아마 <color=#00E1FFFF>칸나즈카</color> 주변을 돌지 않을까 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680316
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680316,
					"content": "그리고 줄리가 「나루카미 다이샤」에 있는 신성한 벚나무를 보고 싶다고 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680317
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680317,
					"content": "이 섬에 있는 「벚꽃 수구」가 모두 그 나무에서 떨어진 거라는 소문이 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680318
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680318,
					"content": "얼마나 큰 나무이길래 그렇게 많은 꽃잎이 떨어지는지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680319
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680319,
					"content": "관심 있으면 너도 한번 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680320
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680320,
					"content": "도와줘서 정말 고마워, 여행자. 난 배가 고파서 뭐 좀 먹으러 갈게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680313,
					"content": "이제 어디로 갈 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680314
					]
				}
			]
		},
