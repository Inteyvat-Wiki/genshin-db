			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"동욱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680201,
					"content": "파르바나, 이 근처에 진짜 다른 방법은 없어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680202
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680202,
					"content": "이 책에는 한 가지밖에 안 적혀 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680203
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721680203,
					"content": "으… 만약 마물이 길을 막으면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680204
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 721680204,
					"content": "이게 너희가 찾던 「벚꽃 수구」야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680205
					]
				},
				{
					"id": 721680205,
					"content": "어! 맞아, 이 빛깔은 우리가 찾던 「벚꽃 수구」가 틀림없어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680206
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680206,
					"content": "잘됐다! 드디어 맛있는 거 먹을 수 있겠다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680207
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 721680207,
					"content": "잠깐, 우리가 알려준 방법으로 배리어 안에 들어간 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680208
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721680208,
					"content": "맞아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680209
					]
				},
				{
					"id": 721680209,
					"content": "네가 찾은 「번개의 벚나무 가지」가 어디 있는지 알려줄 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680210
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721680210,
					"content": "「번개의 벚나무 가지」를 접촉하고, 「번개 씨앗」은 어떻게 몸에 부착한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680211
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721680211,
					"content": "잠시만, 공책 좀 꺼내고… 「번개 씨앗」에 부착된 후에 어떤 느낌이었어? 그리고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680212
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721680212,
					"content": "파르바나, 잠시만 기다려봐, 여행자는 방금 우리를 도와줬잖아. 질문은 조금 있다가 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680213
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680213,
					"content": "여행자, 도와줘서 고마워. 전에 말했던 보수는 톡톡히 챙겨줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680214
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680214,
					"content": "그전에 잠시만 기다려줘. 네가 가져다준 「벚꽃 수구」로 맛있는 요리를 만들 수 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680215
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680215,
					"content": "옛날부터 이나즈마에 엄청 특이한 「벚꽃 모둠튀김」이라는 음식이 있었는데, 드디어 만들어 볼 기회가 생겼네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680216
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721680216,
					"content": "준비만 끝나면 만드는 건 금방이야, 조금만 기다려줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동욱"
				}
			]
		},
		{
			"id": 7216803,
			"completionStepIds": [
				7216804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
