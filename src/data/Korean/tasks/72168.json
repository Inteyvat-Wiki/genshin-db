				},
				{
					"id": 721680403,
					"content": "으… 만약 마물이 길을 막으면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680404
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 721680404,
					"content": "다시 설명해 줄 수 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680405
					]
				},
				{
					"id": 721680405,
					"content": "내가 알려줄게. 구체적인 방법은 「번개의 벚나무 가지」를 찾아 그걸 만지는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680406
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721680406,
					"content": "그럼 「번개 씨앗」이 몸에 부착될 거고, 그 뒤에 배리어 안에 들어가면 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "파르바나"
				}
			]
		},
