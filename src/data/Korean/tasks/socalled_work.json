				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"임령"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140601,
					"content": "으… 이제 시는 그만 쓰고 일이나 열심히 해야지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140602,
						221140607,
						221140612
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140602,
					"content": "일이 더 중요하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140603
					]
				},
				{
					"id": 221140603,
					"content": "나도 알아. 하지만 매일 똑같은 일만 반복하다 보면… 지루해지기 마련이라구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140604
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140604,
					"content": "게다가 이런 자질구레한 일은 별로 의미도 없고 아무도 신경 쓰지 않아서 나도 모르게 딴생각을 하게 된단 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140605
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140605,
					"content": "휴, 소안 씨가 항상 「모든 일엔 엄청난 가치가 있다」, 「중요하지 않은 일은 없다」라고 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140606
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140606,
					"content": "정말 그렇다면, 어째서 다들 직업을 고를 때 이것저것 따지는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "임령"
				},
				{
					"id": 221140607,
					"content": "일할 땐 책임감이 있어야죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140608
					]
				},
				{
					"id": 221140608,
					"content": "나도 가끔씩 너한테만 도와달라고 하는 거지, 대부분 일은 나 혼자서 한다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140609
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140609,
					"content": "일할 때 책임감이 있어야 한다는 건… 당연히 알지. 하지만 바쁠수록 더 게으름 피우고 싶단 말이야. 그래서 너한테 그렇게 부탁했던 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140610
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140610,
					"content": "정말 한가할 땐 오히려 일할 거리를 찾게 된다니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140611
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140611,
					"content": "에휴, 넌 아직 일해본 적 없지? 그럼 말해도 모를 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "임령"
				},
				{
					"id": 221140612,
					"content": "왜 그렇게 시를 쓰고 싶어 하는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140613
					]
				},
				{
					"id": 221140613,
					"content": "갑자기 그건 왜? 흠, 글쎄… 넌 왜 일을 해야 한다고 생각해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140614
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140614,
					"content": "「계속 일하기 위해 일을 하는 거」면 너무 재미없지 않겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140615
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140615,
					"content": "그러니까 난 사람은 살면서 꿈이 있어야 된다고 생각해. 매일 하는 번잡한 업무랑은 완전히 다른 「꿈」 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140616
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140616,
					"content": "그럼 더 이상 버틸 수 없을 만큼 지치고 힘들어도, 적어도 그 「꿈」속에서 쉬어갈 수 있거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140617
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140617,
					"content": "하지만 이건 내 개인적인 의견일 뿐이야. 모험가들이 어떻게 생각할지는 나도 잘 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140618
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140618,
					"content": "온전히 꿈을 위해 살아가는 그들의 모습을 보면, 오히려 우리가 하는 일상적인 업무로 자신을 억제할 필요도 있는 것 같다니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140619
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140619,
					"content": "그래도, 하하하… 나를 본보기로 삼으렴. 「꿈」은 「꿈」일 뿐, 일할 땐 성실히 임해야 된다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "임령"
				}
			]
		},
