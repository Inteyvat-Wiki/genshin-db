			},
			"dialogs": [
				{
					"id": 221140501,
					"content": "확인은 끝났어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140502,
						221140504
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140502,
					"content": "끝났어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140503
					]
				},
				{
					"id": 221140503,
					"content": "잘됐다. 나도 준비가 거의 다 끝났거든. 이따가 내가 그 화물들을 전부 다시 점검해볼게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140506,
					"content": "맞다! 이건 답례니까 받아줘. 난 바로 화물을 점검하러 갈 거야. 이번엔 절대 실수하면 안 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "임령"
				},
				{
					"id": 221140504,
					"content": "또 시를 쓴 건 아니죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140505
					]
				},
				{
					"id": 221140505,
					"content": "당연히 아니지! 나도 그 정도 눈치는 있거든, 지금은 시 쓸 때가 아니라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "임령"
				}
			]
		},
		{
			"id": 2211406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211402",
							"2"
						],
						"stepId": 2211402,
						"stateName": "QUEST_STATE_UNFINISHED"
