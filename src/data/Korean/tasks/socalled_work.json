			"dialogs": [
				{
					"id": 221140101,
					"content": "끝났어. 이젠 전부 끝이라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140102
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140102,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140103
					]
				},
				{
					"id": 221140103,
					"content": "흑… 소안 씨가 난 이 일이랑 잘 안 맞는 것 같대…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140104
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140104,
					"content": "그럼 해고하겠다는 거 아닐까? 이제 어떡하지, 흑… 내가 매일 얼마나 열심히 일했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140105,
						221140111
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140105,
					"content": "엥? 갑자기 왜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140106
					]
				},
				{
					"id": 221140106,
					"content": "그게… 전에 내가 너한테… 선박 수 좀 세어달라고 부탁했었잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140107
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140107,
					"content": "난 네 능력을 믿었거든 그래서 따로 점검도 안 하고 바로 위에다 보고해 버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140108
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140108,
					"content": "근데 틀린 부분이 너무 많아서… 소안 씨한테 엄청 혼났지 뭐야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140109
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140109,
					"content": "네가 소안 씨한테 말 좀 해주면 안 될까? 너한테도 되도록이면 안 도와달라고 하고! 이, 이제부터 열심히 일할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140110
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140110,
					"content": "내가 직접 가서 말하긴 무섭단 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "임령"
				},
				{
					"id": 221140111,
					"content": "저번에 선박 수를 집계하던 게 잘못됐나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140112
					]
				},
				{
					"id": 221140112,
					"content": "그래. 전에 내가 너한테 선박 수를 좀 세어달라고 했었잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140113
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140113,
					"content": "너만 믿고 따로 점검도 안 하고 바로 보고했더니, 잘못 센 부분이 많았더라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140114
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140114,
					"content": "너한테 부탁하는 건 아주 가끔이고, 내가 직접 집계한 수치도 꽤 많았거든…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140115
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140115,
					"content": "그 두 개가 섞여서 어디가 틀렸는지도 모르니까 소안 씨가 엄청 화가 나셨지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140116
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140116,
					"content": "제발 네가 소안 씨한테 말 좀 해주면 안 될까? 너한테도 되도록이면 안 도와달라고 하고! 이, 이제부터 열심히 일할게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140117
					],
					"speakerTitle": "임령"
				},
				{
					"id": 221140117,
					"content": "내가 직접 가서 말하긴 무섭단 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "임령"
				}
			]
		},
