				{
					"id": 760540303,
					"content": "어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760540304,
					"content": "달… 달…",
