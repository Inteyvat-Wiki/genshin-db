					"nextDialogs": [
						400220615
					],
					"speakerTitle": "「시키 대장」"
				},
				{
					"id": 400220615,
					"content": "계속되는 기다림에 난 깊은 잠에 빠졌다오…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220616
					],
					"speakerTitle": "「시키 대장」"
				},
