				"points": []
			},
			"dialogs": [
				{
					"id": 220420101,
					"content": "정말이지 말을 듣지 않는 아이로군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420102
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220420102,
					"content": "왜 그래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420103
					]
				},
				{
					"id": 220420103,
					"content": "자네들이군, 그 녀석이 또 도망을 갔어, 정말 점점 더 말을 안 듣는 것 같군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420104,
						220420105
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220420104,
					"content": "어떻게 도와주면 돼?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				},
				{
					"id": 220420106,
					"content": "신사 밖에 걸려있는 쇠구슬이 있으니, 그 꼬마 녀석들도 어떻게 돌아오는지 알고 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420107
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220420107,
					"content": "그러니 녀석들이 가끔은 밖에서 나뒹굴다 와도 괜찮겠지. 여기 있어봤자 신사에 인간이 찾아왔을 때 난동 부려서 신사의 평판을 깎아 먹을 수도 있으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420108
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220420108,
					"content": "다만 너무 신나게 노느라… 달이 뜰 때까지 배를 곯으면 안 되겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420109
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220420109,
					"content": "자네들, 나 대신 이 생선들을 가져가서 그 아이들에게 나누어주게나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420110,
						220420113
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220420110,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420111
					]
				},
				{
					"id": 220420111,
					"content": "이제 지도를 네코에게 주자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 220420112,
					"content": "호오, 자네는 조금 똑똑한 듯하군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220420115,
					"content": "됐어, 자네들은 이제 가보도록 해, 나는 신사를 정리해야 하니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220420113,
					"content": "여기 지도가 있어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420114
					]
				},
				{
					"id": 220420114,
					"content": "호오, 자네는 조금 똑똑한 듯하군…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220420105,
					"content": "가서 찾아올까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				}
			]
		},
