				"points": []
			},
			"dialogs": [
				{
					"id": 220420401,
					"content": "자네들 왔군. 이상하게도, 그 꼬마 녀석들 전부 겁이 질린 채로 돌아왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420402
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220420402,
					"content": "설마, 밖에서 몽둥이를 가지고 있는 털북숭이 인간을 만난 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420403
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220420403,
					"content": "어쨌거나, 아이들이 돌아왔으니 됐어… 자네 왜 그래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420404
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220420404,
					"content": "사, 사실은 내가…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420405
					]
				},
				{
					"id": 220420405,
					"content": "…알 수 없는 인간이군! 어째서 이런 짓을 할 생각을 한 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420406
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220420406,
					"content": "이 아이들과 놀고 싶다면, 평범한 방법으로 다가갔어야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420407
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220420407,
					"content": "야옹! 녀석들이 놀랄만 했군… 자네는 가서 아이들을 달래주게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420408
					],
					"speakerTitle": "「네코」"
				},
				{
					"id": 220420408,
					"content": "정말이지, 역시 모든 인간이 히비키 같을 거라는 기대는 하면 안 된다니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「네코」"
				}
			]
