			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬",
					"진",
					"바바라",
					"클레"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110101,
					"content": "아… 날씨 완전 좋다. 정신없이 잤네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400110102,
					"content": "좋은 아침! 와, 너희들 옷이?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400110103,
					"content": "헤헤, 예쁜가요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110104
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110104,
					"content": "여름옷으로 갈아입어 봤어요! 놀러 온 건 아니지만… 이 아름다운 여름 바다를 그냥 지나치고 싶지 않아서요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110105
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110105,
					"content": "이, 이상하진 않지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110106
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110106,
					"content": "이렇게 하늘하늘한 옷은 나한텐 안 어울릴 텐데… 크흠! 실례했군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110107,
						400110108
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110107,
					"content": "그렇지 않아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				},
				{
					"id": 400110109,
					"content": "정말…? 고마워 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110110
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110110,
					"content": "그치만 진 단장이 여름옷을 따로 챙겨오다니, 의외네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400110111,
					"content": "아니에요, 언니 성격에 이런 걸 챙겨왔을 리 없죠. 이건 저랑 리사 씨가 고른 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110112
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110112,
					"content": "대놓고 「언니」라고 불렀어…. 게다가 바바라 본인은 전혀 의식도 못 하고 있네. 완전 여름에 취해있잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400110113,
					"content": "여름옷… 말하자면 길지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110114
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110114,
					"content": "리사가 준 주머니엔 급할 때 쓸 수 있는 묘책이 들어 있는 줄 알았는데, 여름옷이 들어 있었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110115
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110115,
					"content": "액세서리까지 챙기다니, 역시 리사답다고 해야 하나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400110116,
					"content": "기사단 모두가 호시탐탐 날 쉬게 할 생각만 하고 있네…. 역시 내가 평소에 스스로를 너무 몰아붙였나…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110117
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110117,
					"content": "다들 클레 쪽으로 와봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110118
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400110118,
					"content": "클레 목소리야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110119
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110119,
					"content": "여기 이상한 물건이 있어——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110120
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400110120,
					"content": "무슨 일이야? 이상한 물건?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400110121,
					"content": "바다를 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110122
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400110122,
					"content": "이상한 물건이 물 위를 떠다녀",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110123
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400110123,
					"content": "모양을 보니까 아마 부표 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110124
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110124,
					"content": "하지만 어제는 바다 위에서 이런 장치를 못 본 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110125
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110125,
					"content": "분명 도도 대마왕이 놔둔 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110126
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400110126,
					"content": "하룻밤 사이에 이상한 장치가 튀어나오다니, 수상한데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400110127,
					"content": "지금까지 나타나지 않는 건, 클레를 인정할 수 없단 건가…? 아니면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110128
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400110128,
					"content": "클레가 찾으러 가길 기다리고 있는 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110129
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400110129,
					"content": "갑자기 바다 위에 나타난 부표에 어떤 의미가 있는 걸까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110130
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110130,
					"content": "가까이 가보면 알겠지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110131
					]
				},
				{
					"id": 400110131,
					"content": "맞아, 여기서 추측만 한다고 문제는 해결되지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110132
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400110132,
					"content": "괜찮을까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110133
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110133,
					"content": "역시 직접 확인해 보는 게 좋겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110134
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110134,
					"content": "바다에서 뭐가 우릴 기다리고 있을지 모르니… 만일의 사태에 대비해서 다들 전투 준비를 해줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110135
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110135,
					"content": "각자 준비가 끝나면 내가 있는 곳으로 모여. 같이 배 타고 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110136,
						400110137
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110136,
					"content": "역시 모두의 진 단장!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110138,
					"content": "과, 과찬이야. 이게 내 일인걸",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110139
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110139,
					"content": "그럼, 준비는 너희들에게 맡길게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "진"
				},
				{
					"id": 400110137,
					"content": "여름옷을 입었어도 든든하네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110108,
					"content": "완전 잘 어울려요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				}
			]
		},
		{
