			"dialogs": [
				{
					"id": 400110701,
					"content": "명예 기사님, 여기 좀 보세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110702
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110702,
					"content": "어…? 이건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110703
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400110703,
					"content": "쌓여 있는 돌과 작은 꽃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110704
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110704,
					"content": "누군가를 기리기 위한 것 같아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110705,
						400110706
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110705,
					"content": "예리한데?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110707
					]
				},
				{
					"id": 400110707,
					"content": "그렇게 말하면 부끄러워요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110708
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110708,
					"content": "하지만 여기엔 아무 반응도 없는 이나즈마 기계뿐인데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110709
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400110709,
					"content": "설마 그 기계를 기념하는 걸까요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110710
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110710,
					"content": "사람들이 기념할만한 일을 했을지도 모르지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110711
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110711,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110712
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110712,
					"content": "우리가 지금까지 본 것들은 전부 이 해역에 사람이 존재했었단 걸 의미해. 하지만 이것만으론 어떤 인류 문명이었는지 짐작하기 어려워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110713
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110713,
					"content": "지금까지 사람이나 사람의 무덤은 보지 못했으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110714
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110714,
					"content": "진 단장님, 클레 저기 가봐도 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110715
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400110715,
					"content": "좋아, 하지만 꼭 조심해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110716
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110716,
					"content": "응!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110717
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400110717,
					"content": "이 섬엔 대체 얼마나 많은 비밀이 있는 걸까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110718
					]
				},
				{
					"id": 400110718,
					"content": "클레는 아직 어려서 위험을 인지하지 못 하지만, 현재 상황을 냉정하게 생각해봐, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110719
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110719,
					"content": "솔직히 처음엔 그 편지가 그냥 질 나쁜 장난인 줄만 알았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110720
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110720,
					"content": "맞아, 우리도!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110721
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 400110721,
					"content": "저도요. 근데 대체 누가 클레처럼 어린아이에게 그런 장난을 치겠어요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110722
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110722,
					"content": "이 섬의 존재를 아는 사람은 소수인 데다가, 장치를 푸는 방법도 아주 정교한 걸 보면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110723
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110723,
					"content": "이건 장난이 아닌 오래전부터 계획된 함정일지도 몰라. 절대 방심하면 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110724
					],
					"speakerTitle": "진"
				},
				{
					"id": 400110724,
					"content": "바바라 언니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110725
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400110725,
					"content": "왜 그래, 클레?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110726
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110726,
					"content": "언니… 대마왕은 클레를 만나고 싶지 않은 걸까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110727
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400110727,
					"content": "왜 그렇게 생각해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110728
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110728,
					"content": "왜냐면 도도코는 클레를 좋아하고, 클레도 도도코를 좋아하니까. 대마왕은 우릴 갈라놓을 수 없단 걸 알고 우릴 안 만나려고 하는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110729
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400110729,
					"content": "힝… 클레는 대마왕이 우리를 갈라놓을까 봐 무서워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110730
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400110730,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110731
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110731,
					"content": "클레, 이게 뭘까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110732
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110732,
					"content": "하르파스툼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110733
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400110733,
					"content": "언니… 큼! 진 단장님한테 들었어. 클레는 하르파스툼을 갖고 놀고 싶다고 했었지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110734
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110734,
					"content": "응, 클레는 하르파스툼 축제에서 놀고 싶어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110735
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400110735,
					"content": "이건 언니가 클레를 위해 특별히 만든 하르파스툼이야. 클레가 원하면 매일매일 하르파스툼 축제가 될 거야, 좋지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110736
					],
					"speakerTitle": "바바라"
				},
				{
					"id": 400110736,
					"content": "좋아——!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110737
					],
					"speakerTitle": "클레"
				},
				{
					"id": 400110737,
					"content": "부제의 상냥함이 느껴지네…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110738
					]
				},
				{
