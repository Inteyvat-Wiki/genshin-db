			"dialogs": [
				{
					"id": 710120101,
					"content": "「바람은 새로운 이야기를 가져다주고, 시간이 지나면 그 이야기는 신화가 된다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120102
					],
					"speakerTitle": "불완전한 각인 문자"
				},
				{
					"id": 710120102,
					"content": "이게 무슨 뜻일까…? 전혀 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710120103,
					"content": "흠, 이곳에 무슨 비밀이 숨겨져 있는 거 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 710120104,
					"content": "단서가 있을지도 모르니 주위를 한번 둘러보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				}
			]
		},
