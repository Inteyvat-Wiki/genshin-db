			"dialogs": [
				{
					"id": 721700101,
					"content": "여긴 못 내려가는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700102
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700102,
					"content": "왜 그래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700103
					]
				},
				{
					"id": 721700103,
					"content": "여행자, 또 만났네. 우리는 어떻게 하면… 저 물속으로 들어갈 수 있을까 고민 중이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700104
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700104,
					"content": "물속에 있는 신선한 해초를 구해서 「주먹밥」이라는 걸 만들어보고 싶거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700105,
						721700107
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700105,
					"content": "바닷가에서 구하면 되지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700106
					]
				},
				{
					"id": 721700106,
					"content": "해변에서 자라는 해초는 신선하지가 않아서 식재료로 쓰기에는 뭔가 좀 부족해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700109,
					"content": "사람들한테 물어보니 이 아래에 질 좋은 해초가 자라고 있다고 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700110
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700110,
					"content": "근데 오늘 와서 보니… 여기는 바닷물에 다 잠겼더라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700111
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700111,
					"content": "우리 3명 모두… 잠수를 못 해서 여기서 지켜보고만 있었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700112
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700112,
					"content": "주위에 장치 같은 건 없어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700113
					]
				},
				{
					"id": 721700113,
					"content": "저기에 장치가 하나 있어! 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700114
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 721700114,
					"content": "저 장치는 또 배리어에 둘러싸여 있어서 들어갈 수가 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700115
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700115,
					"content": "휴, 여기서 방법을 계속 생각해볼 수밖에",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700116
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700116,
					"content": "여행자, 혹시 해결 방법이 생각나면 알려줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700117
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700117,
					"content": "물론 직접 해초를 가져와 주면 더 좋고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700118
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700118,
					"content": "동욱?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700119
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721700119,
					"content": "크흠! 해초를 갖다주면 사례할게. 주먹밥 진수성찬도 대접해 줄 거고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700120
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700120,
					"content": "주먹밥을 「진수성찬」이라고 부를 수 있나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700121
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721700121,
					"content": "음, 양만 많으면 성찬이라고 할 수 있지…. 크흠, 우리 내려갈 방법이나 계속 생각하자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700107,
					"content": "꼭 물속으로 들어가야 하는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700108
					]
				},
				{
					"id": 721700108,
					"content": "해변에서 자라는 해초는 신선하지가 않아서 식재료로 쓰기에는 뭔가 좀 부족해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "동욱"
				}
			]
