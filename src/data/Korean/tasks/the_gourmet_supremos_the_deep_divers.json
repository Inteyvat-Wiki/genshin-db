				"points": []
			},
			"dialogs": [
				{
					"id": 721700701,
					"content": "이 아래, 물에 잠겼던 흔적이 있는 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700702
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700702,
					"content": "응, 흔적이 선명하네. 확실히 얼마 전까지 물에 잠겨 있었을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700703
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 721700703,
					"content": "근데, 왜 갑자기 물이 빠진 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700704
					],
					"speakerTitle": "줄리"
				},
				{
					"id": 721700704,
					"content": "윽… 주위가 축축해서 신발도 다 젖었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700705
					],
					"speakerTitle": "파르바나"
				},
				{
					"id": 721700705,
					"content": "됐어, 신경 쓰지 말고 빨리 해초나 채집하고 나가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700706
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700706,
					"content": "여기서 뭐 해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700707
					]
				},
				{
					"id": 721700707,
					"content": "음? 여기서 여행자를 만나다니, 우리 정말 인연인가 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700708
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700708,
					"content": "우리는 방금 신선한 해초를 구해서 「주먹밥」이라는 요리를 만들려고 아래로 내려갔어. 근데 거기는 물에 젖어 있어서 신발이 다 젖어버렸지 뭐야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700709
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700709,
					"content": "이 얘긴 그만하고, 여행자 너도 우리를 도와서 해초를 같이 채집해줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700710
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700710,
					"content": "아래쪽은 물에 잠겼었던 것 같아. 지금은 물이 빠지긴 했지만, 어쩌면… 언젠가 아래쪽은 다시 물에 잠길지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700711
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700711,
					"content": "그러니까 빨리 해초를 채집하고 위로 올라가는 게 좋을 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700712,
						721700715
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700712,
					"content": "맡겨줘",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700713
					]
				},
				{
					"id": 721700713,
					"content": "그럼 부탁할게, 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700714
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700714,
					"content": "해초를 다 채집하면 나한테 가져다줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700715,
					"content": "바닷가 근처에서 구하면 되잖아?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700716
					]
				},
				{
					"id": 721700716,
					"content": "해변에서 자라는 해초는 신선하지가 않아서 식재료로 쓰기에는 뭔가 좀 부족해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700717
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700717,
					"content": "이쪽 해초의 질이 더 좋을 거야. 어쨌든 해초 채집은 너에게 맡길게 여행자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700718
					],
					"speakerTitle": "동욱"
				},
				{
					"id": 721700718,
					"content": "해초를 다 채집하면 나한테 가져다줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "동욱"
				}
			]
