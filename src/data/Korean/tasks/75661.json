			"completionStepIds": [
				7566101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7566101",
							"2"
						],
						"stepId": 7566101,
						"stateName": "QUEST_STATE_UNFINISHED"
