				"points": []
			},
			"dialogs": [
				{
					"id": 220330101,
					"content": "음…리월 요리를 먹을 수 있다면 좋을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330102
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330102,
					"content": "왜 그러세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330103
					]
				},
				{
					"id": 220330103,
					"content": "이 차림은… 너 여행자니? 미안, 그냥 집 생각이 좀 나서",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330104,
						220330105
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330104,
					"content": "방금 리월 요리가 먹고 싶다고 했죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330118
					]
				},
				{
					"id": 220330118,
					"content": "어? 설마… 리월 요리할 줄 알아? 잘됐다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330119
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330119,
					"content": "그럼, 어, 빨리 도와줘. 제대로 된 리월 요리 좀 만들어 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330120
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330120,
					"content": "지금 내가 가장 먹고 싶은 건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330121
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330121,
					"content": "음… 난 디저트가 먹고 싶어! 고풍스럽고 달콤한 리월 디저트",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330122
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330122,
					"content": "요즘 눈을 감으면 꿈꾸는 것처럼 아름다운 자태의 디저트 도령이 보여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330123
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330123,
					"content": "발에는 누룽지 부츠를 신고, 머리에는 두부관을 쓰고, 쌀외투를 입고, 손에는 꽃빵 부채를 흔들며…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330124,
						220330125
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330124,
					"content": "듣기만 해도 쥐가 모일 것 같은 분이네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330126
					]
				},
				{
					"id": 220330126,
					"content": "그가 길가의 디저트 가게에서 나와 향긋한 냄새를 풍기며 내 곁을 지나가면, 정말 그 냄새를 잊지 못할 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330127
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330127,
					"content": "제발, 디저트 도령을 데려와줘, 부탁이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330125,
					"content": "듣기만 해도 엄청나게 음식을 낭비할 것 같은 분이네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330126
					]
				},
				{
					"id": 220330105,
					"content": "무슨 문제가 생겼나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330106
					]
				},
				{
					"id": 220330106,
					"content": "먼저 내 소개를 할게, 내 이름은 탕운이야. 리월에서 온 역사학자로 이나즈마의 특색있는 풍습과 민화를 연구하고 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330107
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330107,
					"content": "원래 자료를 거의 다 수집해서 리월로 돌아가려던 참이었는데, 이나즈마의 쇄국령으로 발이 묶인 지 꽤 됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330108
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330108,
					"content": "사실 난 이게 좋은 일이라고 생각하고 있어. 왜냐하면 지금 이나즈마는 역사적인 순간을 맞았거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330109
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330109,
					"content": "난 이 특별한 시기가 티바트의 역사에 한 획을 그을 것이라고 확신해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330110
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330110,
					"content": "이 역사를 눈으로 직접 보고 가감 없이 온전하고 분명하게 기록해서 후세에 남기는 것이 역사학자들이 해야 할 일이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330111
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330111,
					"content": "그런데… 사명감이 불타긴 하지만, 배가 고프긴 하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330112
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330112,
					"content": "배고프세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330113
					]
				},
				{
					"id": 220330113,
					"content": "말하기 민망한데… 배고파… 하하하, 이나즈마 음식이 정말 맛있잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330114
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330114,
					"content": "난 이곳의 「모둠튀김」이 정말 좋아. 뭐랄까… 튀김옷을 입혀서 모든 것을 튀길 것 같은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330115
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330115,
					"content": "하지만 이나즈마 요리를 많이 먹다 보니, 리월 요리가 더 생각나네. 근데 제대로 된 리월 요리를 하는 식당을 찾지 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330116
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330116,
					"content": "며칠 전 마음을 단단히 먹고 모험가 길드에 가서 「요리 의뢰」를 신청했는데 아직까지 연락이 없네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330117
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330117,
					"content": "제가 한번 해볼까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330118
					]
				}
			]
		},
