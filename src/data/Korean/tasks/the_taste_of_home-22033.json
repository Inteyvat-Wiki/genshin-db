				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220330301,
					"content": "그래, 이거야! 이게 바로 내가 꿈꾸던 고향의 맛이야… 정말… 우으… 정말 감동적이잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330302
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330302,
					"content": "고마워. 이런 맛있는 음식들이 있어서 힘이 나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330303
					],
					"speakerTitle": "탕운"
				},
				{
					"id": 220330303,
					"content": "이것들을 받아줘. 앞으로의 여행이 순조롭길!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "탕운"
				}
			]
		},
		{
			"id": 2203304,
			"completionStepIds": [
				2203304
			],
			"beginWay": "TALK_BEGIN_AUTO",
