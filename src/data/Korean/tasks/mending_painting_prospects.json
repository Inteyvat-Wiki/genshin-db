	"talks": [
		{
			"id": 7152101,
			"completionStepIds": [
				7152101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7152101",
							"2"
						],
						"stepId": 7152101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"바트로"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715210101,
					"content": "다음은… 음, 이 그림을…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210102
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210102,
					"content": "뭐 하세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210103
					]
				},
				{
					"id": 715210103,
					"content": "#당신은… {NICKNAME}?! 얘기 많이 들었습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210104
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210104,
					"content": "제 동료들이 당신 얘길 하는 걸 여러 번 들었는데, 혹시 이번 성대한 축제에 참석하시지는 않을지 꽤 궁금했습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210105
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210105,
					"content": "정말 여기서 만나게 됐군요. 영광입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210106
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210106,
					"content": "당신에게 소개해 드리고 싶은 게 많지만 그 전에 먼저 제 소개부터 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210107
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210107,
					"content": "전 바트로라고 합니다. 직업은 화가인데… 화가라는 직업이 낯설지는 않으시죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210108
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210108,
					"content": "하지만 전 화가일 뿐만 아니라… 「그림 복원가」이기도 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210109
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210109,
					"content": "불에 그을렸거나, 쥐가 파먹었거나, 곰팡이가 슬어서 썩는 등… 그림이 얼마나 손상됐든지 간에…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210110
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210110,
					"content": "제 손만 거친다면! 그 그림은 다시 완벽한 모습을 되찾을 수 있습니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210111
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210111,
					"content": "그림 복원은 원작을 따라 그리는 건가요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210112
					]
				},
				{
					"id": 715210112,
					"content": "하하하, 그건 아닙니다. 단순히 원작을 따라 그린다면 그건 「모사」죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210113
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210113,
					"content": "저희가 하는 건 그림을 가장 원래의 모습으로 복원하는 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210114
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210114,
					"content": "색깔이든, 붓끝에서 오는 느낌이든, 심지어 캔버스의 재료까지… 어떤 디테일이든 그림의 원래 모습과 완전히 똑같아야 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210115,
						715210116
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210115,
					"content": "정말 복잡하네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210117
					]
				},
				{
					"id": 715210117,
					"content": "맞습니다. 그림 복원을 하려면 높은 수준의 회화 기술과 매우 섬세한 화면 인지 능력이 필요한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210118
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210118,
					"content": "그게 바로… 제가 어시스트를 구하지 못하는 이유이기도 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210119
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210119,
					"content": "만약 높은 수준의 회화 기술과 섬세한 화면 인지 능력이 있는 화가라면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210120
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210120,
					"content": "왜 직접 그림을 그리지 않고 다른 사람을 도와 그림을 복원하겠습니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210121
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210121,
					"content": "게다가 그림 복원은 모라도 안 되고, 사람들의 인식 속에 저희는 그저 따라 그릴 줄만 아는 실력 없는 화가일 뿐인지라…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210122
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210122,
					"content": "하지만 어떤 일이든 책임져야 할 사람이 필요한 법이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210123
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210123,
					"content": "그림은 매우 귀중한 사물입니다. 훌륭한 그림 한 점에는 역사, 이야기, 감정… 그리고 시장의 상업적 가치까지 담을 수 있지요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210124
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210124,
					"content": "다른 사람이 어떻게 생각하든, 전 화가로서 그림이 훼손되는 걸 보고만 있을 순 없습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210125
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210125,
					"content": "…하지만 방금 말한 것처럼 이 일은 모라도 못 벌고 다른 사람에게 오해를 받기도 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210126
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210126,
					"content": "계속 어시스트를 구하고 있지만, 아직까지도 저 혼자 이 일을 하고 있어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210127
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210127,
					"content": "이번에 여기 온 것도 제가 하는 일을 홍보해서 더 많은 사람이 관심을 갖고 참여하도록 하기 위함입니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210128
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210128,
					"content": "하지만… 어시스트는 아직도 구하지 못했고, 오래된 그림을 복원해 달라는 요청은 많이 받았습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210129
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210129,
					"content": "그 그림들은 몬드와 리월에서 온 건데 풍경, 인물, 짐승… 심지어는… 어린이 크레용 그림까지 종류가 다양하죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210130
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210130,
					"content": "크레용 그림도 복원하세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210131
					]
				},
				{
					"id": 715210131,
					"content": "아… 원칙적으로 그림이기만 하면 저한테 복원을 의뢰할 수 있습니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210132
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210132,
					"content": "게다가 크레용 그림엔 아이들의 노력이 담겨 있어요. 어쩌면 그게 아이들이 예술의 길에 내디딘 첫걸음일지도 모르죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210133
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210133,
					"content": "그렇기 때문에 아이들의 부모님이 저에게 복원을 의뢰하는 것도… 이해는 됩니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210134,
						715210136
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210134,
					"content": "어쩔 수 없다는 얼굴이네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210135
					]
				},
				{
					"id": 715210135,
					"content": "네? 아닙니다! 그렇지 않아요. 저는… 다만… 크레용 그림에 대한 지식이 좀 필요할 것 같군요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210138
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210138,
					"content": "#{NICKNAME}, 괜찮다면 저를 도와주시겠습니까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210139
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210139,
					"content": "보셔서 아시겠지만 여긴 저 혼자인데… 그림 복원을 하려면 근처에 가서 배경을 취재해야 하거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210140,
						715210141
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210140,
					"content": "배경을 취재한다고요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210142
					]
				},
				{
					"id": 715210142,
					"content": "휴, 맞습니다. 배경 취재는 물론이고 그림과 관련된 다양한 자료들도 찾아봐야 하죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210143
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210143,
					"content": "예를 들어 이 그림 속 풍경의 그 당시 모습과 그림 속 동물의 형태가 어떤지 등등…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210144
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210144,
					"content": "다행히 지금 급히 복원해야 할 그림들이 오래된 게 아니어서 풍경엔 변화가 없을 겁니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210145
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210145,
					"content": "지금 배경을 취재하려고 준비 중이긴 한데, 당신도 아시다시피… 야외는 아주 위험해서 저 같은 붓쟁이가 모험을 떠나기에는 적합하지 않은 곳이죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210146
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210146,
					"content": "그래서 말인데… 당신이 야외에 가서 배경을 취재해 줬으면 좋겠군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210147
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210147,
					"content": "저는 그림을 잘 못 그리는데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210148
					]
				},
				{
					"id": 715210148,
					"content": "걱정 마세요! 제가 다 준비했습니다…. 전에 다른 사람에게 이 일을 부탁했을 때도 이렇게 했거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210149
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210149,
					"content": "자, 이건 복원해야 할 그림의 사진입니다. 안에 중요한 풍경이 몇 개 있는데… 제가 이미 표시해 드렸어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210150
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210150,
					"content": "이 풍경이 있는 곳으로 가서 사진기로 풍경을 찍기만 하면 됩니다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210151
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210151,
					"content": "그러니까 전 사진만 찍으면 된다는 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715210152
					]
				},
				{
					"id": 715210152,
					"content": "그렇습니다. 하지만 사진을 찍기 전에 제가 드린 사진 속 그림을 잘 살펴봐야 합니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210153
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210153,
					"content": "그림에 담긴 미학과 예술적 감각을 느끼면서… 그 그림이 당신의 머릿속에 머물게 하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210154
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210154,
					"content": "그림을 완전히 이해한다면, 사진을 찍을 때 그 그림이 완성되기까지의 모든 과정을 느낄 수 있을지도 모릅니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210155
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210155,
					"content": "밑그림부터 윤곽선, 채색, 디테일까지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715210156,
						715210157
					],
					"speakerTitle": "바트로"
				},
				{
					"id": 715210156,
					"content": "그건 환각 아닌가요?",
					"roleType": "TALK_ROLE_PLAYER",
