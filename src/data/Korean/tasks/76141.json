			"dialogs": [
				{
					"id": 761410101,
					"content": "두 사람, 돌아온 걸 환영해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410102
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 761410102,
					"content": "하지만 아직은 작별 인사를 나눌 때가 아니야. 너희는 아직 이 오두막을 다 둘러보지 않았거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410103
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 761410103,
					"content": "방이라면 전부 들어가 봤잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 761410104,
					"content": "숨겨진 비밀의 방이 없다고 말한 적은 없는데? 마녀란 원래 종잡을 수 없는 존재야. 너희도 슬슬 익숙해지렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410105
					],
					"speakerTitle": "니콜"
				},
				{
					"id": 761410105,
					"content": "이쪽이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "니콜"
				}
			]
		},
		{
			"id": 7614102,
