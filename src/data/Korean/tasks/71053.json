			"dialogs": [
				{
					"id": 710501401,
					"content": "다른 건 일단 나중에 얘기하고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501402
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710501402,
					"content": "층암거연에 머무르는 동안 네게 너무 많은 도움을 받아서 어떻게 감사를 해야 할지 모르겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501403
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710501403,
					"content": "고작 모라 따위로 감사를 표할 순 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501404
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710501404,
					"content": "사실 굳이 주신다면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710501405
					]
				},
				{
					"id": 710501405,
					"content": "장난은 그만해, 내가 그깟 모라를 주고 일을 대충 끝내버리는 각박한 짓을 할 리가 없잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501406
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710501406,
					"content": "그건 네 선의를 모욕하는 일이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501407
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710501407,
					"content": "자, 이 편지를 잘 보관해 둬. 나중에 수메르에서 곤경에 처하거나 도움이 필요한 일이 생기면 이 편지를 갖고 푸르비루니 일파의 사람을 찾아가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501408
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710501408,
					"content": "우리가 최선을 다해 널 도울 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501409
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710501409,
					"content": "「오가는 정은 황금보다도 귀하다」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501410
					],
					"speakerTitle": "헤디브"
				},
				{
					"id": 710501410,
					"content": "이 수메르의 속담은 바로 이런 상황에서 사용하는 것이겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "헤디브"
				}
			]
		}
	]
