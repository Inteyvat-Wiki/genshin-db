					"nextDialogs": [
						708020403
					]
				},
				{
					"id": 708020403,
					"content": "음, 그 녀석도 가끔은 제대로 된 일을 하는군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
