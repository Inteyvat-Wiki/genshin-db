			"dialogs": [
				{
					"id": 708020101,
					"content": "이번엔 진짜 아빠를 찾을 수 있을까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020102
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 708020102,
					"content": "아빠의 소식은 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020103
					]
				},
				{
					"id": 708020103,
					"content": "#여행자 {F#누나}{M#형아}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020104
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 708020104,
					"content": "팔라드 형이 그랬는데, 사이러스 아저씨가 아빠에 대한 단서를 찾은 것 같대요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020105
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 708020105,
					"content": "팔라드 형도 확신은 못 하지만… 단서가 유력해서 진짜로 아빠를 찾을 수 있을지도 모른다고 했어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020106
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 708020106,
					"content": "저도 같이 설산에 가고 싶었는데, 사이러스 아저씨가 야영지에 남으라고 했어요. 소식이 있으면 알려 준다고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020107
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 708020107,
					"content": "#{F#누나}{M#형아}, 괜찮다면 사이러스 아저씨한테 가서 소식을 알아봐 줄래요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020108,
						708020109
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 708020108,
					"content": "알겠어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				},
				{
					"id": 708020110,
					"content": "안, 안 좋은 소식을… 들을까봐 무서워서요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020111
					],
					"speakerTitle": "요엘"
				},
				{
					"id": 708020111,
					"content": "#아무튼 부탁할게요, {F#누나}{M#형아}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "요엘"
				},
				{
					"id": 708020109,
					"content": "왜 직접 가서 물어보지 않고?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				}
			]
		},
