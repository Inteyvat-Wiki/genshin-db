			"dialogs": [
				{
					"id": 708020201,
					"content": "이런 곳에 있다니… 팔라드, 확실해?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020202
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 708020202,
					"content": "네. 사이러스 씨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020203
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708020203,
					"content": "요엘의 아버지에 대해서 얘기하고 있었나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020204
					]
				},
				{
					"id": 708020204,
					"content": "이거 여행자가 아닌가? 요엘을 만나고 오는 길인가 보군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020205
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 708020205,
					"content": "그 아이는 매일 사람들한테 부탁해서 아버지의 소식을 물어보지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020206
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 708020206,
					"content": "하지만 이번엔 좋은 소식을 전해줄 수 있을 것 같군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020207
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 708020207,
					"content": "얼마 전에 우리 모험가 길드에서 「설산 특훈」을 했었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020208
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 708020208,
					"content": "그 부분은 제가 얘기할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020209
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708020209,
					"content": "특훈에 참가하러 가는 도중에 눈보라가 너무 거세서 길을 잃었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020210
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708020210,
					"content": "왔던 길을 따라 돌아가는데 절벽에서 흐릿한 그림자를 봤지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020211
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708020211,
					"content": "그래서 나처럼 길을 잃은 모험가인 줄 알고, 큰소리로 그 사람을 불렀어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020212
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708020212,
					"content": "하지만 그 사람의 주의를 끌기도 전에… 마물들이 먼저 나타났지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020213
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708020213,
					"content": "설산에서 마물을 처치할 자신은 없어서 먼저 되돌아올 수밖에 없었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020214
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708020214,
					"content": "그리고 돌아오고 나서 이 일을 사이러스 씨한테 보고했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020215,
						708020217
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708020215,
					"content": "그 그림자가 요엘의 아빠일까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020216
					]
				},
				{
					"id": 708020216,
					"content": "그건 확신할 순 없네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020218
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 708020218,
					"content": "어쨌든 설산에 조난당한 사람이 있다는 걸 안 이상, 구조작업은 진행해야겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020219
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 708020219,
					"content": "그 사람이 요엘의 아버지인 요세프 씨인지는… 운에 달렸지만 말이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020220
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 708020220,
					"content": "아무튼 길드의 능력 있는 모험가들한테 설산 구조 작업을 맡겼네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020221
					],
					"speakerTitle": "사이러스"
				},
				{
					"id": 708020221,
					"content": "난 준비 좀 하고 설산 구조에 합류할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020222,
						708020223
					],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708020222,
					"content": "저도 같이 갈게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020224,
					"content": "너도 도우려고? 정말 고마워. 그럼 같이 출발하자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "경솔한 팔라드"
				},
				{
					"id": 708020223,
					"content": "마물은 저한테 맡기세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020217,
					"content": "다른 모험가일 수도 있겠죠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020218
					]
				}
			]
		},
