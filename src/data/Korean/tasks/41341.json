					"몽몽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410101,
					"content": "소등 만드는 거 너무 어려워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410102
					],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410102,
					"content": "왜 그러니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410103
					]
				},
				{
					"id": 413410103,
					"content": "#{F#언니}{M#오빠} 소등 어떻게 만드는지 알아? 몽몽이는 잘 모르겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410104
					],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410104,
					"content": "여기로 넣은 다음 다시 뺐는데 재료가 땅에 떨어졌어…. 아니면 줄이 자꾸 끊어지고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410105
					],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410105,
					"content": "현우한테 소등 만들어주려고 했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410106
					],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410106,
					"content": "현우는 찻집을 봐야 돼서 나랑 놀 시간도 없고, 소등 만들 시간도 없대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410107
					],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410107,
					"content": "현우도 빌고 싶은 소원이 있을 테니까 몽몽이가 소등 만들어 주려고 한 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410108,
						413410109
					],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410108,
					"content": "내가 도와줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				},
				{
					"id": 413410110,
					"content": "근데 몽몽이가 직접 만들어 주고 싶은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410111
					],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410111,
					"content": "몽몽이는 소등 만드는 법을 알고 싶어. 그래야 현우한테 알려줄 수 있으니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410112
					],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410112,
					"content": "#{F#언니}{M#오빠}가 소등 만드는 법 좀 가르쳐 주면 안 돼?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410113
					],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410113,
					"content": "좋아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410114
					]
				},
				{
					"id": 413410114,
					"content": "#고마워, {M#오빠}{F#언니}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410115
					],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410115,
					"content": "이제 소등이… 완성된 거겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410116
					],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410116,
					"content": "#고마워, {M#오빠}{F#언니}! 빨리 현우한테 소등을 갖다주자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410109,
					"content": "내가 하나 만들어 줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410110
					]
				}
			]
		},
		{
			"id": 4134102,
			"completionStepIds": [
				4134102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134102",
							"2"
						],
						"stepId": 4134102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"현우"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410201,
					"content": "소, 손님, 안녕하세요. 저… 이쪽으로 앉으세요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410203
					],
					"speakerTitle": "현우"
				},
				{
					"id": 413410203,
					"content": "소등을 주러 왔어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410204
					]
				},
				{
					"id": 413410204,
					"content": "소등이요…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410205
					],
					"speakerTitle": "현우"
				},
				{
					"id": 413410205,
					"content": "자, 이 소등 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410206
					],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410206,
					"content": "몽몽아! 어, 이 소등 네가 만든 거야? 고, 고마워…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410207
					],
					"speakerTitle": "현우"
				},
				{
					"id": 413410207,
					"content": "#이 {F#언니}{M#오빠}가 알려줬어. 나 잘 못 만들었는데, 맘에 들어…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410208
					],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410208,
					"content": "잘 만들었는데? 완전 맘에 들어! 마침 소등을 언제 만들지 고민이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410209
					],
					"speakerTitle": "현우"
				},
				{
					"id": 413410209,
					"content": "몽몽아, 고마워. 이따 다른 분한테 소등을 문에 걸어달라고 할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410210,
						413410211
					],
					"speakerTitle": "현우"
				},
				{
					"id": 413410210,
					"content": "다른 분한테?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				},
				{
					"id": 413410212,
					"content": "그게, 음… 저희 아빠는 몸이 안 좋으셔서 소등을 걸 수 없어요. 전 키가 너무 작아서 불가능하구요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410213
					],
					"speakerTitle": "현우"
				},
				{
					"id": 413410213,
					"content": "소등을 걸려면 다른 어른한테 부탁해야 돼요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410214,
						413410215
					],
					"speakerTitle": "현우"
				},
				{
					"id": 413410214,
					"content": "제가 도와드릴게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410216,
					"content": "정말요? 감사합니다. 사람 찾으러 갈 동안 가게 볼 사람이 없어서 걱정이었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "현우"
				},
				{
					"id": 413410215,
					"content": "나한테 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410216
					]
				},
				{
					"id": 413410211,
					"content": "집에 도와줄 어른이 없니?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410212
					]
				}
			]
		},
		{
			"id": 4134104,
			"completionStepIds": [
				4134104
			],
