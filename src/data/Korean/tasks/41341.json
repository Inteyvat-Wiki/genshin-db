			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"현우"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413410401,
					"content": "#이 소등 정말 예뻐요. 고마워요, {M#형아}{F#누나}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410402
					],
					"speakerTitle": "현우"
				},
				{
					"id": 413410402,
					"content": "그럼… 우리 나가서 놀자. 꽃이 엄청 예쁜 곳을 찾았거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410403
					],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410403,
					"content": "#아까 {F#언니}{M#오빠}가 소등 만드는 법을 알려줬어. 거기 가면 내가 너 가르쳐 줄게!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410404
					],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410404,
					"content": "아… 지금은 안 돼. 가게 정리해야 되거든. 손님이 없어도 가게는 항상 깨끗해야 한다고 아빠가 그러셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410405
					],
					"speakerTitle": "현우"
				},
				{
					"id": 413410405,
					"content": "그… 그럼 소등 만들지 말고 가서 수다만 잠깐 떨고 오자, 응? 금방 갔다 올 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410406
					],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410406,
					"content": "하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410407,
						413410408
					],
					"speakerTitle": "현우"
				},
				{
					"id": 413410407,
					"content": "내가 가게 정리해 줄게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				},
				{
					"id": 413410409,
					"content": "#네? 그래도 돼요? 그, 그럼 {F#누나}{M#형아}한테 너무 미안한데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410410
					],
					"speakerTitle": "현우"
				},
				{
					"id": 413410410,
					"content": "갔다가 금방 올 거니까 그렇게 오래 안 걸릴 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413410411
					],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410411,
					"content": "#그럼 부탁해, {M#오빠}{F#언니}. 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "몽몽"
				},
				{
					"id": 413410408,
					"content": "정리는 나한테 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413410409
					]
				}
			]
		},
		{
			"id": 4134107,
