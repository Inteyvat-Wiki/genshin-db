			"dialogs": [
				{
					"id": 411420101,
					"content": "제가 배달할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411420102
					]
				},
				{
					"id": 411420102,
					"content": "그럼 부탁할게. 정말 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411420103
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 411420103,
					"content": "받아, 이게 바로 진주비취백옥탕이야. 가다가 <color=#00E1FFFF>엎거나, 바람의 날개를 사용하면 안 돼</color>. 그럼 탕이 쏟아져도 모르니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411420104
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 411420104,
					"content": "그리고 <color=#00E1FFFF>이상한 게 묻으면 안 돼</color>. 그럼 맛이…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411420105
					],
					"speakerTitle": "묘 사부"
				},
				{
					"id": 411420105,
					"content": "자, 이 요리를 빨리 배달해줘. 식으면 안 된다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "묘 사부"
