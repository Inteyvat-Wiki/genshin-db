					}
				]
			},
			"dialogs": [
				{
					"id": 401930201,
					"content": "이토의 연이은 재촉으로 인해, 일행은 다시금 아이사 대중탕으로 향했다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930202
					]
				},
				{
					"id": 401930202,
					"content": "으하하! 여기가 제일 뜨거운 곳인가 본데! 오늘 누가 온천에서 제일 오래 버티는지, 한번 겨뤄보자고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930203
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 401930203,
					"content": "후후, 이토 씨가 그렇게 말하시는데 거절할 수야 없죠?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930204
					],
					"speakerTitle": "토마"
				},
				{
					"id": 401930204,
					"content": "정말이지… 이게 무슨 사우나도 아니고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930205
					],
					"speakerTitle": "쿠키 시노부"
				},
				{
					"id": 401930205,
					"content": "온천… 좋아… 쿨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930206
					],
					"speakerTitle": "사유"
				},
				{
					"id": 401930206,
					"content": "오, 온천에서 잠들면 안 돼!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 401930207,
					"content": "으… 털이 무거워졌어. 머리도 좀 어지럽고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930208
					],
					"speakerTitle": "고로"
				},
				{
					"id": 401930208,
					"content": "하하하! 고로 형씨! 벌써부터 그러면 안 되지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930209
					],
					"speakerTitle": "아라타키 이토"
				},
				{
					"id": 401930209,
					"content": "거기——욕장에서 소란피우지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930210
					],
					"speakerTitle": "쿠죠 사라"
				},
				{
					"id": 401930210,
					"content": "같은 시각, 다른 곳에서는…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930211
					]
				},
				{
					"id": 401930211,
					"content": "후후, 이토 씨는 언제나 기운이 넘치시네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930212
					],
					"speakerTitle": "카미사토 아야토"
				},
				{
					"id": 401930212,
					"content": "오빠, 대국 중에 한눈 팔면 안 되지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930213
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 401930213,
					"content": "#후오——경기가 가장 치열한 단계에 접어들었습니다! {NICKNAME}은(는) 어떻게 대처할 것인가! 두 선생님께선 어떻게 보시나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930214
					],
					"speakerTitle": "요이미야"
				},
				{
					"id": 401930214,
					"content": "음… 저라면 차근차근 접근해서 우세를 다질 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930215
					],
					"speakerTitle": "산고노미야 코코미"
				},
				{
					"id": 401930215,
					"content": "음, 적극적인 공세로 승부수를 거는 것도… 좋은 방법이죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930216,
						401930217
					],
					"speakerTitle": "시카노인 헤이조"
				},
				{
					"id": 401930216,
					"content": "(차근차근…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				},
				{
					"id": 401930218,
					"content": "오? 이런 묘수라니? 이번 판은 제가 졌네요. 그럼 아까 뽑은 순서대로, 다음 차례는…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930219
					],
					"speakerTitle": "카미사토 아야토"
				},
				{
					"id": 401930219,
					"content": "아야카, 재미있게 놀렴",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930220
					],
					"speakerTitle": "카미사토 아야토"
				},
				{
					"id": 401930220,
					"content": "#어… 앗, 응! {NICKNAME}, 잘 부탁드려요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930221
					],
					"speakerTitle": "카미사토 아야카"
				},
				{
					"id": 401930221,
					"content": "(아야토 씨, 아야카가 더 놀 수 있게 일부러 져주신 건가…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 401930217,
					"content": "(올인이다!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				}
			]
		},
