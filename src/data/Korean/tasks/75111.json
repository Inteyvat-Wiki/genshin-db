			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"미치카"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110301,
					"content": "이건… 창카의 글씨체로 보이네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110302
					],
					"speakerTitle": "미치카"
				},
				{
					"id": 751110302,
					"content": "…주문서를 보낸 것 같은데, 겉 포장이 다 찢어져서 이대로 보낼 수는 없어. 창카에게 반송해야해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110303
					],
					"speakerTitle": "미치카"
				},
				{
					"id": 751110303,
					"content": "나는 가게에서 우편물을 정리해야 하니, 대신 이 우편물을 창카에게 전달해 줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110304
					],
					"speakerTitle": "미치카"
				},
				{
					"id": 751110304,
					"content": "창카는 성화 경기장에 있는 「피로의 집」의 주인이야. 가게를 찾기는 아주 쉬울 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "미치카"
				}
			]
		},
		{
			"id": 7511104,
			"completionStepIds": [
				7511104
			],
			"beginWay": "TALK_BEGIN_NONE",
