			"dialogs": [
				{
					"id": 751110101,
					"content": "전에 이런 걸 주웠었는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751110102
					]
				},
				{
					"id": 751110102,
					"content": "어? 이건 또 어떤 바보가 잃어버린 거야? 잠깐 보여줘 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "미치카"
				}
			]
		},
		{
			"id": 7511102,
			"completionStepIds": [
				7511102
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7511102",
							"2"
						],
						"stepId": 7511102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"미치카"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110201,
					"content": "이건… 아캇에게 갈 물건인가 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110202
					],
					"speakerTitle": "미치카"
				},
				{
					"id": 751110202,
					"content": "…겉 포장이 다 찢어졌어. 이대로 다시 부치면 내용물이 망가질지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110203
					],
					"speakerTitle": "미치카"
				},
				{
					"id": 751110203,
					"content": "나는 가게에서 우편물을 정리해야 하니, 대신 이 우편물을 아캇에게 전달해 줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110204
					],
					"speakerTitle": "미치카"
				},
				{
					"id": 751110204,
					"content": "아캇은 성화 경기장에 있는 「프리다의 팔레트」의 주인이야. 거기는 간판이 눈에 잘 띄니까 금방 찾을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "미치카"
				}
			]
		},
		{
			"id": 7511103,
			"completionStepIds": [
				7511103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
