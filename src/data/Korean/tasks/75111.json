				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110401,
					"content": "「무후루 보석점」… 이믹스? 이런, 상품 명세서인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110402
					],
					"speakerTitle": "미치카"
				},
				{
					"id": 751110402,
					"content": "이 우편물을 잃어버렸다간 그 애가 쉐븐 씨에게 엄청 야단맞겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110403
					],
					"speakerTitle": "미치카"
				},
				{
					"id": 751110403,
					"content": "나는 가게에서 우편물을 정리해야 하니, 대신 이 우편물을 이믹스에게 전달해 줄 수 있을까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110404
					],
					"speakerTitle": "미치카"
				},
				{
					"id": 751110404,
					"content": "「무후루 보석점」은 「메아리 아이」 쪽에 있으니까 쉽게 찾을 수 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "미치카"
				}
			]
		},
