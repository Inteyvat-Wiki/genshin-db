	"talks": [
		{
			"id": 7150301,
			"completionStepIds": [
				7150301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7150301",
							"2"
						],
						"stepId": 7150301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"호세이니",
					"지호",
					"도 씨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715030101,
					"content": "#잘 왔어, {NICKNAME}. 우린 지금 「푸르시나 볼트」를 어떻게 안으로 운반할지 논의 중이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030102
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030102,
					"content": "그나저나, 여기 상황이 생각보다 많이 심각한 것 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030103
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030103,
					"content": "콜록콜록… 안 되겠어. 검은 진흙이 너무 많고 검은 진흙에 이끌려온 몬스터들 때문에 안으로 옮길 수가 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030104
					],
					"speakerTitle": "지호"
				},
				{
					"id": 715030104,
					"content": "더 이상 나아갈 수 있는 길이 보이지 않아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030105
					],
					"speakerTitle": "지호"
				},
				{
					"id": 715030105,
					"content": "갱도 안까지 가려면 아직 멀었어. 자, 함께 힘을 내보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030106
					],
					"speakerTitle": "도 씨"
				},
				{
					"id": 715030106,
					"content": "그래도 안 되면 밖에 나가서 형제들에게 도움을 요청할 수밖에 없어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030107
					],
					"speakerTitle": "도 씨"
				},
				{
					"id": 715030107,
					"content": "고작 장치를 옮기는 거잖아. 채굴계의 대스타인 이 몸이 곡괭이를 휘두르면 산도 파버릴 수 있어. 층암의 몬스터 따위는 우습지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030108
					],
					"speakerTitle": "도 씨"
				},
				{
					"id": 715030108,
					"content": "그만하지? 기침을 참느라 얼굴이 빨개진 게 다 보이는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030109
					],
					"speakerTitle": "지호"
				},
				{
					"id": 715030109,
					"content": "내가 무슨 기침을 참았다고… 케켁! 콜록콜록…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030110
					],
					"speakerTitle": "도 씨"
				},
				{
					"id": 715030110,
					"content": "더 이상 앞으로 가는 건 무리야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030111
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030111,
					"content": "검은 진흙과 지나치게 접촉하면 심각한 결과를 초래할 수 있어. 그리고 안에는 몬스터가 가득 깔려 있어 너무 위험해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030112
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030112,
					"content": "하, 하지만 지난번에 우리 모두 봤었잖아. 기계를 광산 지역에 갖다 놓으니 그곳이 싹 깨끗해지는 걸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030113
					],
					"speakerTitle": "도 씨"
				},
				{
					"id": 715030113,
					"content": "만약, 콜록콜록, 만약 갱도 안의 검은 진흙을 빨리 해결해버릴 수 있다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030114
					],
					"speakerTitle": "도 씨"
				},
				{
					"id": 715030114,
					"content": "지금은 속도를 추구할 때가 아니야. 문제를 처리하든 실험을 하든, 조사나 준비 없이 무턱대고 진행하면 한 번의 오조작으로도 목숨이 위태로워질 수 있단 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030115
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030115,
					"content": "「목숨보다 중요한 건 없다」 이건 「아카데미아」 실험실 매뉴얼의 기본 수칙 중 하나야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030116
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030116,
					"content": "「아카데미아」의 학자로서 나는 이러한 상황을 그냥 지켜만 볼 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030117
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030117,
					"content": "휴… 그런데 이 많은 검은 진흙을 처리하자면 뭐라도 해야 하지 않겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030118
					],
					"speakerTitle": "지호"
				},
				{
					"id": 715030118,
					"content": "검은 진흙이 몬스터를 더 많이 끌어모은다면… 사람을 스무 명 더 불러와도 장치를 안으로 운반할 수 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030119
					],
					"speakerTitle": "지호"
				},
				{
					"id": 715030119,
					"content": "흐음… 가만 보자…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030120
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030120,
					"content": "정 안 되면 먼저 여기서 볼트를 한 번 작동시키는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030121
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030121,
					"content": "여기서 작동시킨다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030122
					],
					"speakerTitle": "지호"
				},
				{
					"id": 715030122,
					"content": "그래. 내가 검은 진흙이 분출되는 속도를 눈대중으로 가늠해 봤는데, 어제 광구보단 빨랐지만 그래도 검은 진흙의 핵심 구역이 아닌 만큼 제거하는 속도가 분출되는 것보다 빠를 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030123
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030123,
					"content": "층암거연의 몬스터들이 검은 진흙에 이끌리는 걸 보면, 검은 진흙의 에너지에 영향을 받는 게 분명해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030124
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030124,
					"content": "#여기서 장치를 가동하여 주변 검은 진흙의 영향을 약화시키면 {NICKNAME}의 행동에도 도움이 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030125
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030125,
					"content": "검은 진흙을 다 치워버린 후 몬스터들이 여기에 모여들지 않을 때 다시 안으로 운반을 시도해 보는 게 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030126
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030126,
					"content": "그게 좋겠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030127
					]
				},
				{
					"id": 715030127,
					"content": "너희 둘은 당분간 야영지에 가서 좀 쉬어. 나중에 도움이 필요할 때 부를게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030128
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030128,
					"content": "난 괜찮아. 고작 이 정도를 가지고 뭘… 쿨럭쿨럭, 아직은 채굴계의 대스타인 이 몸이 쉴 때가 아니야. 그깟 몬스터 몇 마리를 치우는 게 뭐라고, 내가 도와줄 수 있어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030129
					],
					"speakerTitle": "도 씨"
				},
				{
					"id": 715030129,
					"content": "괜히 오기 부리지 말고 응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030130
					],
					"speakerTitle": "지호"
				},
				{
					"id": 715030130,
					"content": "#천하의 {NICKNAME}이(가) 있는데, {NICKNAME}에게 맡기면 전혀 걱정하지 않아도 된단 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030131
					],
					"speakerTitle": "지호"
				},
				{
					"id": 715030131,
					"content": "#{NICKNAME}, 주변의 검은 진흙과 몬스터 처리를 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030132,
						715030133
					],
					"speakerTitle": "지호"
				},
				{
					"id": 715030132,
					"content": "알았어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030134
					]
				},
				{
					"id": 715030134,
					"content": "#그건 그렇고, {NICKNAME} 주변은 온통 검은 진흙으로 가득 차 있어 상황이 생각보다 많이 심각한데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030135
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030135,
					"content": "검은 진흙 주변에 몬스터까지 가득 깔렸으니 부디 조심해…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030136
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030136,
					"content": "조심할게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030137
					]
				},
				{
					"id": 715030137,
					"content": "아니, 내 말은 「푸르시나 볼트」 안전을 조심하라는 뜻이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030138
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030138,
					"content": "네가 강하다는 것은 충분히 알고 있어. 그런데 「푸르시나 볼트」는 지극히 정밀하면서도 취약한 위대한 장치이니…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715030139
					],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030139,
					"content": "볼트는 절대 손상되면 안 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "호세이니"
				},
				{
					"id": 715030133,
					"content": "맡겨주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715030134
					]
				}
			]
		}
	]
}