			},
			"dialogs": [
				{
					"id": 101220401,
					"content": "잠깐, 이 사람들은 누구지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220402
					],
					"speakerTitle": "달레르"
				},
				{
					"id": 101220402,
					"content": "알려줄 의무는 없을 텐데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220403
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220403,
					"content": "내가 데려왔으니 당연히 손님이지. 내 손님한테 무례한 짓을 했다간 로렌스 가문의 비난을 면할 수 없을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220404
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220404,
					"content": "하지만 이 일은 기밀 중의 기밀이니 신중해서 나쁠 건 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220405
					],
					"speakerTitle": "달레르"
				},
				{
					"id": 101220405,
					"content": "지금 감히 내 앞에서 귀족의 행동을 지적하는 건가? 잔말 말고 길을 비켜라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220406
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220406,
					"content": "거만하기만 하고 아무 능력도 없으면서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220407
					],
					"speakerTitle": "달레르"
				},
				{
					"id": 101220407,
					"content": "알았어, 알았어. 빨리 들어와",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "달레르"
				}
			]
