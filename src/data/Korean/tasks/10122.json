					"nextDialogs": [
						101220305
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220305,
					"content": "확실히 그들에게 쉽게 얼굴을 보여선 안 되지, 하하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220306
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220306,
					"content": "네 반응이 빨라서 다행이야. 들키는 줄 알았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101220307,
					"content": "그럼 계속 가지. 그들에겐 널 내 손님이라고 소개하마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220303,
					"content": "이게 귀족의 예의에 걸맞지 않나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220304
					]
				}
			]
