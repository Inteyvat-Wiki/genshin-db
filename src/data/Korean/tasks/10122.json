						],
						"stepId": 1012201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬",
					"슈베르트"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101220101,
					"content": "(천막은 낡아서 다 떨어져 가지만, 아주 근사해 보이는 의자가 하나 놓여있잖아…)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220102
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101220102,
					"content": "(이것도 귀족의 예의 중 하나일까?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101220103,
					"content": "또 너희들이냐? 휴, 날 좀 귀찮게 하지 말고 내버려 둘 수 없나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220104,
						101220106
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220104,
					"content": "귀족은 도량이 넓고 관대하다고 들었습니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220105
					]
				},
				{
					"id": 101220105,
					"content": "「도량이 넓고 관대」하다라…. 재밌군, 나쁘지 않아. 그래 귀족은 그렇지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220108
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220108,
					"content": "좋아, 나도 마음이 편협한 사람은 아니니 과거의 사소한 잘못들은 더는 묻지 않겠어. 네 말을 일단 들어는 주지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220109
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220109,
					"content": "(와, 저 고고한 자태라니!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220110,
						101220112
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101220110,
					"content": "그 전에 제가 항쟁의 의지를 내비친 것을 넓은 아량으로 이해해 주세요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220111
					]
				},
				{
					"id": 101220111,
					"content": "넌 나와 뜻이 맞는 사람이었군, 「항쟁」——이란 무능한 기사단에게 반항하는 것이지. 큰 뜻을 깨달았구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220114
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220114,
					"content": "표현이 아주 좋군, 내 의도는 너의 겸손한 품성을 떠보려던 것이었다. 역시 넌 내 뜻을 깨우친 것 같구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220115
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220115,
					"content": "(떠보는 거였다구?! 뭐야 그게!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101220116,
					"content": "음, 예의 부분은 합격이야, 이렇게 짧은 시간 동안 이만큼이나 발전하다니 놀랍구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220117
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220117,
					"content": "이렇게 예의 바르고 고상한 단어를 골라 문장을 만드는 것을 어디서 배운 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220118,
						101220119
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220118,
					"content": "다 벗의 가르침 덕분입니다",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220120
					]
				},
				{
					"id": 101220120,
					"content": "좋군, 총명함은 더할 나위 없고, 몬드의 천민들에 비하면 아주 걸출한 인재야, 귀족 출신이었다면 앞길이 창창했을 텐데!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220121
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220121,
					"content": "참, 그리고 선물을… 어, 흠흠, 약소한 선물을 준비했습니다. 송구스럽지만 받아주십시오",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101220122,
					"content": "아, 이건…「야채절임 바비큐」?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220123
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220123,
					"content": "허세가 아니라 이건 정말 공을 들였군, 요즘 젊은이들은 마음만 먹으면 다 해낸단 말이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220124
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220124,
					"content": "이거 간만인데 잘됐구나…. 아니, 내 말은 이왕 식사 시간이니 사양하지 않겠다는 뜻이다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220125
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220125,
					"content": "아, 맛있군, 예전의 맛 그대로야. 특히 이 산미는, 음——이게 바로 귀족만이 이해할 수 있는 즐거움이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220126
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220126,
					"content": "저렇게 말하니까 나까지 맛이 궁금해지잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220127
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101220127,
					"content": "좋아, 너희들의 진정성은 충분히 알았다. 이렇게 간절하다면, 분명히 부탁이 있어서 왔겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220128
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220128,
					"content": "로렌스 가문에 큰 계획이 있다고 들었어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220129
					]
				},
				{
					"id": 101220129,
					"content": "그것까지 알아? 이건 원래 우리 가문의 기밀인데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220130,
						101220131
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220130,
					"content": "보잘것없는 힘이지만 저도 돕고 싶어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220132
					]
				},
				{
					"id": 101220132,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220133
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220133,
					"content": "좋아, 이렇게 예의 차릴 줄 아는 걸 보니 넌 미래가 기대되는 인재 같군. 널 믿고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220134
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220134,
					"content": "그럼 날 따라와, 우린 마침 지금 더 많은 조력자가 필요하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220135
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220135,
					"content": "어디로 가나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220136
					]
				},
				{
					"id": 101220136,
					"content": "먼 곳에서 온 우리의 친구를 만나러 가는 거지. 그들은 로렌스 가문의 영광을 되찾는 걸 도와줄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220137
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220137,
					"content": "예의 바르다는 이유로 우리를 완전히 믿는다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220138,
						101220139
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101220138,
					"content": "나도 뭔가 이상한 것 같아, 조심하자…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220140
					]
				},
				{
					"id": 101220140,
					"content": "됐어, 어서 따라와, 곧 모든 걸 다 알게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220139,
					"content": "아니면 이것도 옛 귀족의 「겉치레」일지도 몰라",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220140
					]
				},
				{
					"id": 101220131,
					"content": "변변찮은 힘이지만, 귀족을 위해 제 한 몸 바치고 싶어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220132
					]
				},
				{
					"id": 101220119,
					"content": "벗의 가르침을 받아 경전을 근거로 하여 깊이 깨닫게 되었지요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220120
					]
				},
				{
					"id": 101220112,
					"content": "이번에 만나 뵙고 보니, 꼭 찬란한 빛이 쏟아져 내리는 듯해요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220113
					]
				},
				{
					"id": 101220113,
					"content": "넌 나와 뜻이 맞는 사람이었군, 「찬란한 빛」이란—— 오늘날까지 이어져 온 귀족의 영광이지. 일편단심으로 충성을 다하여라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220114
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220106,
					"content": "외람된 말씀이지만, 한마디 해도 괜찮을까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220107
					]
				},
				{
					"id": 101220107,
					"content": "「외람된 말씀」이라… 재밌군, 아주 적절한 단어였어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220108
					],
					"speakerTitle": "슈베르트"
				}
			]
		},
