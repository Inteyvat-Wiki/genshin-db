				{
					"id": 101220708,
					"content": "어쨌든 그 문제는 단장 대행한테도 말씀드려야겠어. 그럼 처리해주시겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220709
					],
					"speakerTitle": "유라"
				},
				{
					"id": 101220709,
					"content": "참, 근데 왜 따라오신 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220710
					]
				},
				{
					"id": 101220710,
					"content": "그러게, 아까 나타난 타이밍도 너무 딱 떨어졌어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220711
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101220711,
					"content": "그건…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220712
					],
					"speakerTitle": "유라"
				},
				{
					"id": 101220712,
					"content": "내가 추적하던 우인단을 네가 처치해서 내 공로가 날아갔으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220713
					],
					"speakerTitle": "유라"
				},
				{
					"id": 101220713,
					"content": "그래서 복수하러 왔어. 내 공로를 되찾아야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220714,
						101220715
					],
					"speakerTitle": "유라"
				},
				{
					"id": 101220714,
					"content": "그 「복수」란 게 도면이었나 보네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220716
					]
				},
				{
					"id": 101220716,
					"content": "헤헤, 이제야 네 말을 알아듣겠네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220717
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101220717,
					"content": "사실은 우리한테 무슨 일 생길까 봐 불안했던 거잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220718
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101220718,
					"content": "우리랑 숙부가 걱정돼서 소대를 이끌고 온 거였구나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220719
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101220719,
					"content": "복수라니까, 내 의도를 왜곡하지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220720
					],
					"speakerTitle": "유라"
				},
				{
					"id": 101220720,
					"content": "흥, 덜떨어진 녀석인 줄 알았는데 꽤 계산적인걸?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220721
					],
					"speakerTitle": "유라"
				},
				{
					"id": 101220721,
					"content": "이 원한, 기억해두겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220722
					],
					"speakerTitle": "유라"
				},
				{
					"id": 101220722,
					"content": "덜떨어졌다니, 그게 무슨 말이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220723
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101220723,
					"content": "너희 둘, 언젠간 이 원수를 꼭 갚아줄 테니 두고 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220724
					],
					"speakerTitle": "유라"
				},
				{
					"id": 101220724,
					"content": "너희가 잿더미가 되더라도 절대 잊지 않겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220725
					],
					"speakerTitle": "유라"
				},
				{
					"id": 101220725,
					"content": "그럼 저흰 이제 「원수지간」이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220726
					]
				},
				{
					"id": 101220726,
					"content": "얼마든지 덤비라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220727
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101220727,
					"content": "하하하, 이렇게 나와야지. 그럼 난 이만 도면을 챙겨서 기사단으로 돌아가 볼게. 뒷일은 내게 맡겨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220728
					],
					"speakerTitle": "유라"
				},
				{
					"id": 101220728,
					"content": "응응, 기회 되면 또 만나자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220729
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 101220729,
					"content": "꼭 다시 만날 거야, 다음에 만나면 날 실망시키지 말라고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "유라"
				},
				{
					"id": 101220715,
					"content": "그럼 이제 쌤쌤인 거죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220716
					]
				},
				{
					"id": 101220707,
					"content": "그럼 배보다 배꼽이 커지게 되겠죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101220708
					]
				}
			]
		},
