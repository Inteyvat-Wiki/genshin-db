					"nextDialogs": [
						101220544
					],
					"speakerTitle": "슈베르트"
				},
				{
					"id": 101220544,
					"content": "휴, 이럴 줄 알았어. 애초에 멍청한 귀족 따위 믿는 게 아니었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101220545
					],
					"speakerTitle": "세르게이"
