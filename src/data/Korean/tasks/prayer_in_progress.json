				"points": []
			},
			"dialogs": [
				{
					"id": 220110201,
					"content": "벌써 다 치웠나요?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110202
					],
					"speakerTitle": "마키"
				},
				{
					"id": 220110202,
					"content": "다 치웠어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110203
					]
				},
				{
					"id": 220110203,
					"content": "고마워요, 점괘들은 이리 줘요. 적절한 곳에 걸어둘 거예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110204
					],
					"speakerTitle": "마키"
				},
				{
					"id": 220110204,
					"content": "도와줘서 고마워요. 이건 수고해준 답례예요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110205
					],
					"speakerTitle": "마키"
				},
				{
					"id": 220110205,
					"content": "액운을 없애거나 행운을 바라는 마음을 이해 못 하는 건 아니에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110206
					],
					"speakerTitle": "마키"
				},
				{
					"id": 220110206,
					"content": "하지만… 정말 눈앞에 닥친 문제를 해결하려면, 점괘에 기대기보다는 뭐라도 하는 게 더 낫죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110207
					],
					"speakerTitle": "마키"
				},
				{
					"id": 220110207,
					"content": "아무것도 하지 않으면 신이 도움을 주려 해도 방법이 전혀 없거든요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "마키"
				}
			]
		},
