			"dialogs": [
				{
					"id": 110020201,
					"content": "이 근처에 있을 텐데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020202
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110020202,
					"content": "벌써 뭘 찾아야 할지 생각해둔 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110020203,
					"content": "그럴 리가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020204
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110020204,
					"content": "근데 뭐가 그렇게 당당해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110020205,
					"content": "이게 내 스타일인걸, 요리하기 전에 뭘 만들지 다 생각해두면 놀라운 요리를 만들 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020206
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110020206,
					"content": "같은 이유로 찾아내기 전에 뭘 찾아야 할지 생각해두면 그것도 놀라움이 없겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020207
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110020207,
					"content": "너무 생각이 없는 거 아닐까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020208
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110020208,
					"content": "걱정 마, 「만민당」의 간판 메뉴는 다 이렇게 탄생한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020209
					],
					"speakerTitle": "향릉"
				},
				{
					"id": 110020209,
					"content": "우선 대충 둘러보자. 마음에 드는 재료를 발견하게 되면 알려줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "향릉"
				}
			]
		},
