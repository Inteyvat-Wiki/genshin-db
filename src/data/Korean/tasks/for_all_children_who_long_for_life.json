						],
						"stepId": 7303712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"페이몬",
					"아란나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730370301,
					"content": "아란마…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370302,
					"content": "아란마는 이제 새로운 아슈바타 나무가 되었어. 비록 아직 작지만 뿌리는 아주 깊고 튼튼해. 수많은 달이 지나면 분명히 아름답고 큰 나무로 자랄 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370303
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730370303,
					"content": "아란나가 말했잖아. 추억과 꿈은 아란나라의 힘이자 가장 소중한 것이라고… 기억을 포기하면 라나와 비마라 마을의 아이들을 잊게 되는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370304
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370304,
					"content": "맞아, 하지만 친구가 추억보다 더 소중해. 기억은 다시 쌓을 수 있지만 잃어버린 친구는 다시 돌아오지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370305
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730370305,
					"content": "난 나라나를 도와주고 싶어. 이름이 아란나와 비슷하기도 하고, 나라나는 내 친구니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370306
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730370306,
					"content": "아란나가 잊어버린다고 해도 네가 기억할 거잖아. 너만 기억해 준다면, 언젠가 네 기억이 탐스러운 열매를 맺을 수 있을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370307
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730370307,
					"content": "…알겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370308,
					"content": "이제 어떻게 해야 해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370309
					]
				},
				{
					"id": 730370309,
					"content": "#나라{NICKNAME}, 아란나가 가르쳐 준 「위대한 꿈의 멜로디」 아직 기억하지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370310
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730370310,
					"content": "아란나와 아란마에게 그 노래를 불러 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란나"
				}
			]
		},
		{
			"id": 7303704,
