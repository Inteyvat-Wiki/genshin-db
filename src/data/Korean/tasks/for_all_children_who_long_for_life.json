			},
			"dialogs": [
				{
					"id": 730370401,
					"content": "「비야의 열매」를 획득했다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730370402
					]
				},
				{
					"id": 730370402,
					"content": "드디어 소중한 비야의 열매를 얻었어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370403,
						730370405
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370403,
					"content": "정말 힘들었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370404
					]
				},
				{
					"id": 730370404,
					"content": "응, 이제 라나한테 전해주면 되겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370406,
					"content": "…너희는 누구지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란나"
				},
				{
					"id": 730370405,
					"content": "이제 라나 씨한테 전해주면 되겠지…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370406
					]
				}
			]
		},
		{
			"id": 7303705,
			"completionStepIds": [
				7303708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
