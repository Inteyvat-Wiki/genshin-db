						"rawParams": [
							"302821",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"아란마",
					"아란나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730370201,
					"content": "#우리가 마라나의 화신을 처치했으니까 숲도 다시 평화로워질 거야. 「우리」라는 단어를 사용하긴 했지만 모두 네 용기와 노력 덕분이야. 고마워, 나라{NICKNAME}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370202,
						730370205
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370202,
					"content": "화관과 모두의 도움이 있었기 때문이야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370203,
						730370204
					]
				},
				{
					"id": 730370205,
					"content": "천만에",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370206
					]
				},
				{
					"id": 730370203,
					"content": "그 덕에 포기하지 않고 용기를 낼 수 있었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370207
					]
				},
				{
					"id": 730370204,
					"content": "그 덕에 다시 일어날 수 있었어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370207
					]
				},
				{
					"id": 730370206,
					"content": "#{NICKNAME}(이)가 화관을 쓰고 있어서 다행이야! 아까는 정말 아슬아슬했어…. 정말 신기한 화관이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370207,
					"content": "꽃에는 아란나라의 작은 마음이 연결되어 있어. 그리고 모든 꽃으로 만든 화관은 「마하바나{RUBY#[D]아란나라의 우주}라나프나」의 문이라고 해도 과언이 아니지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370208
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370208,
					"content": "우리의 마음은 연결되어 있어. 네가 힘들 땐 응원해 주고 너에게 힘을 빌려줄 거야. 또 악몽을 막아주고 네가 어둠을 이기고 마음속 공허함을 채울 수 있도록 도와줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370209
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370209,
					"content": "더 이상 꿈을 꾸지 않아 우리를 볼 수 없는 사람들과 운명을 받아들이고 더 이상 전진하지 않는 사람들, 그리고 공포와 고통 속에 빠진 사람들의 마음은 이미 단단해져서 꽃의 도움을 받을 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370210
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370210,
					"content": "#나라{NICKNAME}(은)는 정직하고 착해서, 또 나라{NICKNAME}이(가) 나라{NICKNAME}(이)라서 화관이 제 역할을 할 수 있는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370211
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370211,
					"content": "#나라{NICKNAME}(은)는 아란나라의 친구야. 그러니까 세상을 더 밝고 깨끗하게 만드는 사명을 위해 너 혼자서 마라나를 마주하고 사악함을 소멸하게 두지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370212
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370512,
					"content": "#{NICKNAME}은(는) 내 최고의 파트너니까 당연히 가장 좋은 사람이지! 그러고 보니, 전에 타이나리도 죽음의 땅이 더 이상 나타나지 않을 거라고 했잖아! 드디어 죽음의 땅 문제가 해결됐네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370513
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370513,
					"content": "응, 더 이상 보지 말자, 마라나. 숲에 아직도 작은 마라나들이 많이 남아 있긴 하지만, 우린 이미 가장 큰 적을 물리쳤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370514
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370514,
					"content": "사르바에 있던 마라나에 관한 기억이 완전히 사라진 게 느껴져. 그러니까 만물이 「죽음」을 기억하고 공포를 느끼더라도 두 번 다시 그를 깨우지 못할 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370515
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370515,
					"content": "#세상에는 아직도 생명을 노리는 것들이 많이 있어. 하지만 언제라도 나라{NICKNAME}와(과) 나라바루나같이 태양처럼 반짝이는 사람이 있을 테니까, 난 전혀 걱정되지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370516
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370516,
					"content": "지금의 숲에는 밝은 미래가 있어. 남은 마라나만 제거하면 이제 숲의 아이들은 충분한 햇빛과 이슬을 얻게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370517
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370217,
					"content": "음… 아무튼 마라나의 화신을 제거했으니까 이제 아슈바타 나무를 심고 비야의 열매를 얻는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370218,
					"content": "맞아, 조금만 기다려 줘. 가서 아란나를 불러올게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370219
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370219,
					"content": "아란나… 맞다, 아란나의 기억을 사용해야 비야의 열매를 맺을 수 있었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370220
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370220,
					"content": "하지만 아란나는 비마라 마을 근처에 있잖아? 어떻게 하려는 거지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370221
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370221,
					"content": "사라졌어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370222
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370222,
					"content": "으악!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370223
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370223,
					"content": "#나라{NICKNAME}, 페이몬. 아란나는 너희가 마라나의 화신과 대적한 걸 느꼈어. 너희랑 아란마는 정말 용감해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370224,
						730370227
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730370224,
					"content": "그렇게 먼 곳에서 어떻게 온 거야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370225
					]
				},
				{
					"id": 730370227,
					"content": "그럼 이제…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370228
					]
				},
				{
					"id": 730370225,
					"content": "아란무후쿤다의 기억을 획득했어. 덕분에 사르바를 이용해 숲에서 빠르게 이동할 방법을 배웠지. 이건 「워프」라고 하는 아란라칼라리야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370226
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370226,
					"content": "아란마는 정말 대단해. 아란무후쿤다도 네게 기억을 줄 수 있어서 정말 기뻤을 거야. 아란나는 「워프」를 한 지 아주 오래됐어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370228
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730370228,
					"content": "이제 새로운 아슈바타 나무를 심어야겠지? 아란마가 「씨앗」에 대해 얘기했는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370229
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370229,
					"content": "씨앗은 무럭무럭 큰 나무로 자라서 열매를 가득 맺어야 한다는 걸 알고 있을 거야…. 고마워, 아란마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370230
					],
					"speakerTitle": "아란나"
				},
				{
					"id": 730370230,
					"content": "응, 난 새로운 아슈바타 나무로 자랄 거야. 그리고 너의 추억과 꿈으로 비야의 열매를 맺을게. 내 뿌리를 사용해서 마라나에 의해 침식된 꿈과 꿈 사이의 다리를 다시 연결해 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370231
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370231,
					"content": "너희 지금 무슨 말을 하는 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370232,
						730370234
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370232,
					"content": "아란마가 바로 씨앗이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370233
					]
				},
				{
					"id": 730370234,
					"content": "너희 지금 무슨 말을 하는 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370235
					]
				},
				{
					"id": 730370233,
					"content": "난 바소마 열매 그리고 아슈바타 나무와 아란무후쿤다의 기억과 힘을 흡수했어. 지금의 숲에 나보다 더 강한 「씨앗」은 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370236
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370235,
					"content": "내가 바로 아슈바타 나무의 씨앗이야. 난 바소마 열매 그리고 아슈바타 나무와 아란무후쿤다의 기억과 힘을 흡수했어. 지금의 숲에 나보다 더 강한 「씨앗」은 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370236
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370236,
					"content": "응? 그게 무슨 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370237
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370237,
					"content": "원래 난 내 눈과 몸을 통해 나만의 기억을 쌓을 계획이었어. 그러다 수십 또는 수백 년이 지나면 다시 땅으로 돌아가 아름다운 바사라 나무로 자라려고 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370238
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370238,
					"content": "너희가 아니었다면 이런 영광이 나한테 돌아오지 않았을 거야. 함께 마라나의 화신을 제거하고 숲을 치유하지도 못했을 거고, 이렇게나 많은 기억을 쌓아서 바사라 나무의 왕이 되지도 못했을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370239
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370239,
					"content": "아, 설마… 아슈바타 전당에 있는 바사라 나무도 아란나라가 변한 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370240
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370240,
					"content": "그건 아란지, 아란야마, 아란마하야. 바소마 열매는 바로 그들의 기억이지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370241
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370241,
					"content": "아란마가 나무로 변하면… 앞으로 함께 뛰어놀지도 못하고 말이나 노래도 할 수 없잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370242
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370242,
					"content": "비록 씨앗으로서 지상에서 걸었던 시간은 조금 짧았지만 너희와 함께했던 시간은 과거보다 수십 배, 아니 수백 배는 더 보람찼어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370243
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370243,
					"content": "안 돼… 난 아란마랑 더 놀고 싶단 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370244
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370244,
					"content": "#그랬구나, 페이몬이랑 나라{NICKNAME}(은)는 내 친구야. 이 사실은 영원히 변하지 않을 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370245
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370245,
					"content": "기억과 힘을 획득한 뒤로 사르바에서 다양한 풍경을 보고 수많은 이야기를 들을 수 있었어. 너한테 이야기를 하나 들려줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370246
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370246,
					"content": "응…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370247
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370247,
					"content": "금빛 모래 폭풍 속에 감춰진 영원의 오아시스에는 그 어떤 생명체도 없어. 지금까지 그 어떤 아란나라도 만나지 못했던 모든 초목의 가장 오래된 주인이 모래 속에 숨어있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370248
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370248,
					"content": "모든 아름다운 건 결국 죽게 될 거란 마라나의 말처럼, 과거 그곳을 뒤덮었던 푸른 식물들은 모두 시들어서 통제할 수 없는 모래가 되어버렸어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370249
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370249,
					"content": "하지만 이것만 알아둬. 아무리 밤이 어두워도 하늘에는 별이 빛나고 태양도 다시 떠오를 거야. 죽음이 주인의 모든 것을 갈망하고 있더라도 생명은 절대 사라지지 않으니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370250
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370250,
					"content": "대지에 떨어진 노란 잎은 췌화나무의 비료가 되고 그 열매는 동물 짐꾼, 여우, 숲멧돼지의 사료가 될 거야. 그리고 또 그들은 머리깃 호랑이의 먹이가 되겠지. 그렇게 숲은 생명으로 가득 차게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370251
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370551,
					"content": "독혈이 대지를 까맣게 물들였을 때, 나라처럼 아란나라도 모든 게 끝날 거로 생각했어. 하지만 이제 그에 관한 기억은 사라졌고, 오늘의 숲은 어제보다 더 무성하지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370552
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370252,
					"content": "마지막에 남은 건 아름다운 것뿐이야. 지금 헤어져도 결국 사르바에서 다시 만나게 될 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370253
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370253,
					"content": "언젠가 우리의 꿈과 우리의 기억이 하나가 되어 무수하게 많은 사르바의 나뭇가지 위에 꽃을 피울 거야. 얼마나 기쁜 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370254
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370254,
					"content": "응… 하지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370255
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370255,
					"content": "페이몬",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370256
					]
				},
				{
					"id": 730370256,
					"content": "응, 그래… 알겠어! 아란마, 넌 최고의 「씨앗」이니까 반드시 크고 아름다운 나무로 자랄 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370257
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370257,
					"content": "#그러니까… 그러니까 나무로 변해도 절대 나랑 {NICKNAME}(을)를 잊으면 안 돼. 우리가 함께했던 모험도 잊지 말고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370258,
						730370259,
						730370260
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 730370258,
					"content": "고마웠어, 아란마",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370261
					]
				},
				{
					"id": 730370259,
					"content": "안녕, 아란마",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370261
					]
				},
				{
					"id": 730370260,
					"content": "이렇게 끝나는구나",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730370261
					]
				},
				{
					"id": 730370261,
					"content": "#응, 나라{NICKNAME}, 페이몬. 정말 고마웠어. 너희를 만날 수 있어서 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370262
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370262,
					"content": "아란나, 네 기억으로 가장 아름답고 탐스러운 비야의 열매를 맺을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730370263
					],
					"speakerTitle": "아란마"
				},
				{
					"id": 730370263,
					"content": "널 믿어, 아란마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아란나"
				}
			]
		},
