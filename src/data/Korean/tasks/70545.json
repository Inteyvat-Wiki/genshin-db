			},
			"dialogs": [
				{
					"id": 705450101,
					"content": "야, 야옹——야옹——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450102
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 705450102,
					"content": "야옹! 야아옹!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450103
					],
					"speakerTitle": "「토깽이」"
				},
				{
					"id": 705450103,
					"content": "음… 「토깽이」와 엠버의 말 모두 일리 있어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705450104,
					"content": "음, 그렇구나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450105,
						705450106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705450105,
					"content": "확실히 맞는 말이야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				},
				{
					"id": 705450107,
					"content": "사실 나도 잘 몰라. 하지만 엠버와 「토깽이」가 서로를 이해하고 있다는 게 확실히 느껴진다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450108
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705450108,
					"content": "#{NICKNAME}, 페이몬 왔구나! 마침 너희를 찾아가려던 참인데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450109
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 705450109,
					"content": "너희가 「복슬복슬 고양이 성」의 운영을 돕고 있다는 건 바레리나 씨한테 들었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450110
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 705450110,
					"content": "#역시 {NICKNAME}(이)야. 몬드로 돌아오자마자 이렇게 큰 도움을 주다니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450111,
						705450112
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 705450111,
					"content": "난 어떤 임무든지 해결하는 명예 기사니까",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450113,
					"content": "그러고 보니 엠버랑 「토깽이」는 무슨 얘기하고 있었어? 아주 즐거워 보이던데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705450114,
					"content": "야옹, 야옹야옹?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450115
					],
					"speakerTitle": "「토깽이」"
				},
				{
					"id": 705450115,
					"content": "음… 「토깽이」한테 오늘 비가 오는지 물어보는 중이었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450116
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 705450116,
					"content": "엥? 고양이가 그런 것도 알 수 있어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705450117,
					"content": "헤헤, 나도 리사한테 들은 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450118
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 705450118,
					"content": "리사가 본 책에 따르면 고양이는 습기에 민감하고 눅눅한 기운을 싫어한대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450119
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 705450119,
					"content": "그래서 만약 공기의 습도가 높아지는 걸 느끼면 불안감에 끊임없이 얼굴을 문지르거나 털을 핥기 시작한대",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450120
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 705450120,
					"content": "그러니까 고양이들이 이런 행동을 보이면 곧 큰 비가 올 것을 예상할 수 있지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450121
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 705450121,
					"content": "우와, 그런 신기한 원리가 있었다니… 우연히 놀라운 사실을 알게 됐네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450122
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705450122,
					"content": "#{NICKNAME}, 앞으로 여행할 때는 고양이를 주의 깊게 관찰해. 그러면 적어도… 쏟아지는 폭우에 쫄딱 젖을 일은 없을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450123,
						705450124
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 705450123,
					"content": "앞으로는 관심을 가지고 지켜볼게",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450125,
					"content": "난 오늘 바레리나 씨에게 물어볼 게 있어서 왔어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450126
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 705450126,
					"content": "그런데 그녀와 얘기하는 도중에 고양이 한 마리가 내 옆으로 와서는 엎드려서 하품하는 거야. 너무 귀여운 거 있지!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450127
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 705450127,
					"content": "나한테 친근하게 대해줬으니, 그… 그러면 나도 친근하게 대하는 게 도리잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450128
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 705450128,
					"content": "그러다가 리사가 얘기해줬던 게 생각나서 겸사겸사 「토깽이」한테 날씨를 물어봤던 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450129
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 705450129,
					"content": "그런데 「토깽이」는 잠깐 얼굴을 비비다가, 또 꼬리를 흔들기도 하고, 잠깐 바닥에 눕다가, 또 내 손에 비벼댔지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450130
					],
					"speakerTitle": "엠버"
				},
				{
					"id": 705450130,
					"content": "음, 그러니까 도대체 비가 온다는 걸까, 안 온다는 걸까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "엠버"
				},
				{
					"id": 705450124,
					"content": "난 원래부터 길가의 고양이들을 살펴봤거든!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450112,
					"content": "몬드성의 고양이를 보호하는 것도 내 의무야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450106,
					"content": "잠깐, 지금 무슨 말을 하는 거야!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				}
			]
		}
	]
}