			"dialogs": [
				{
					"id": 752710101,
					"content": "풍선은 망가뜨리지 말아 줘. 풍선을 갖고 놀고 싶은 거라면 다른 걸 줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710102
					],
					"speakerTitle": "스키"
				},
				{
					"id": 752710102,
					"content": "뭔가 특별해 보이는 풍선이네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710103
					]
				},
				{
					"id": 752710103,
					"content": "말하기 부끄럽지만… 이건 아주 중요한 소품이거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710104
					],
					"speakerTitle": "스키"
				},
				{
					"id": 752710104,
					"content": "풍선을 보니까 무슨 용도인지 알겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710105,
						752710107
					],
					"speakerTitle": "스키"
				},
				{
					"id": 752710105,
					"content": "청혼?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710106
					]
				},
				{
					"id": 752710106,
					"content": "고백이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "스키"
				},
				{
					"id": 752710109,
					"content": "낭만적인 풍선 가운데에서 사랑하는 요포이에게 고백할 생각이야. 어때?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710110
					],
					"speakerTitle": "스키"
				},
				{
					"id": 752710110,
					"content": "그럼 빨간색 풍선을 써야죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710111
					]
				},
				{
					"id": 752710111,
					"content": "응? 일리 있는 말이야…. 역시 난 낭만이 부족한 건가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710112
					],
					"speakerTitle": "스키"
				},
				{
					"id": 752710112,
					"content": "요포이가 곧 올 텐데, 빨간색 풍선은 어디 가서 찾지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "스키"
				},
				{
					"id": 752710107,
					"content": "고백?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710108
					]
				},
				{
					"id": 752710108,
					"content": "마… 맞아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "스키"
				}
			]
		},
