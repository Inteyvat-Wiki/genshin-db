			"dialogs": [
				{
					"id": 752710601,
					"content": "요포이! 왔구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710602
					],
					"speakerTitle": "스키"
				},
				{
					"id": 752710602,
					"content": "스키…? 너야? 모습이 왜 그래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710603
					],
					"speakerTitle": "요포이"
				},
				{
					"id": 752710603,
					"content": "네가 제일 좋아하는 나나스 사람이잖아…. 내가 빌려왔어. 멋지지? 그리고 이 풍선들도 내가 일부러 준비한 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710604
					],
					"speakerTitle": "스키"
				},
				{
					"id": 752710604,
					"content": "사실 예전부터 너한테 하고 싶었던 말이 있어… 나랑 사귀자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710605
					],
					"speakerTitle": "스키"
				},
				{
					"id": 752710605,
					"content": "너… 너 어디 아파?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710606
					],
					"speakerTitle": "요포이"
				},
				{
					"id": 752710606,
					"content": "아니! 사랑하는 요포이, 나랑 사귀어줘!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710607
					],
					"speakerTitle": "스키"
				},
				{
					"id": 752710607,
					"content": "너 진짜 어디 다친 거 아니야? 오늘은 우리 결혼 3주년 되는 날이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710608
					],
					"speakerTitle": "요포이"
				},
				{
					"id": 752710608,
					"content": "그건 당연히 기억하지! 하지만… 넌 내가 낭만을 모른다고 했잖아. 결혼하기 전에 정식으로 고백한 적도 없어서… 그래서… 이게 바로 내 늦은 고백이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710609
					],
					"speakerTitle": "스키"
				},
				{
					"id": 752710609,
					"content": "하… 알겠어. 받아줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710610
					],
					"speakerTitle": "요포이"
				},
				{
					"id": 752710610,
					"content": "뭐? 정말?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710611
					],
					"speakerTitle": "스키"
				},
				{
					"id": 752710611,
					"content": "받아준다고, 낭만적인 바보야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710612
					],
					"speakerTitle": "요포이"
				},
				{
					"id": 752710612,
					"content": "산들바람이 불어오고 두 사람은 포옹한다…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
