			"dialogs": [
				{
					"id": 250340501,
					"content": "#{M#형아}{F#누나}, 구해줘서 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340502
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250340502,
					"content": "우아우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340503
					],
					"speakerTitle": "치카"
				},
				{
					"id": 250340503,
					"content": "#부족에서 너무 멀리 떨어져 있어서 일라파 누나한테 알릴 방법도 없었어. 만약 {M#형아}{F#누나}가 아니었으면 치카는 분명히 잡혔을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340504
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250340504,
					"content": "여기서 뭐 하고 있었던 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340505
					]
				},
				{
					"id": 250340505,
					"content": "등반 훈련을 하러 왔는데, 훈련하다 보니까 배가 고프더라고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340506
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250340506,
					"content": "그래서 치카랑 열매를 따러 갔지. 열매를 따면서 걷다 보니까 멀어져서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340507
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250340507,
					"content": "배가 불렀을 땐, 이미 너무 멀리 와버린 후였어. 돌아가면 엄마는 분명 잔소리하실 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340508
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250340508,
					"content": "#도와줘서 정말 고마워, {M#형아}{F#누나}. 이 「카카오」를 받아줘. 우리가 방금 따온 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340509
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250340509,
					"content": "우리는 빨리 돌아가야겠어, 치카! 가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340510
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250340510,
					"content": "우! 우우! 우우!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "치카"
				}
			]
		}
	]
