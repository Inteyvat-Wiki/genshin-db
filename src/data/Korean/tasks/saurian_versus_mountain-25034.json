			"dialogs": [
				{
					"id": 250340101,
					"content": "너희를 싫어하잖아, 저리 가!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340102
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250340102,
					"content": "이 꼬맹이가… 너 이 용 알아? 용이랑 너랑 무슨 관계인데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340103
					],
					"speakerTitle": "성가신 도적"
				},
				{
					"id": 250340103,
					"content": "우… 우우!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340104
					],
					"speakerTitle": "치카"
				},
				{
					"id": 250340104,
					"content": "이거 봐, 용이 인내심을 잃기 일보 직전이야. 꼬마야, 저리 가라. 우린 애들은 안 때려",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340105
					],
					"speakerTitle": "성가신 도적"
				},
				{
					"id": 250340105,
					"content": "형씨들, 자루 좀 가져다줘. 후후, 저 어린 용은 분명 좋은 가격에 팔릴 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340106
					],
					"speakerTitle": "성가신 도적"
				},
				{
					"id": 250340106,
					"content": "가까이 오지 마! 더 다가오면 나도 가만히 있지 않을 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340107
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250340107,
					"content": "가만히 안 있으면, 네가 뭐? 하하하하, 형씨들, 이 꼬마가 우리를 공격하려나 봐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340108
					],
					"speakerTitle": "성가신 도적"
				},
				{
					"id": 250340108,
					"content": "어휴, 무서워라. 꼬마야 말을 꺼낸 건 너니까 내 탓 하지 마라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340109
					],
					"speakerTitle": "성가신 도적"
				},
				{
					"id": 250340109,
					"content": "우! 우우! 우!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340110
					],
					"speakerTitle": "치카"
				},
				{
					"id": 250340110,
					"content": "쯧, 이 어린 용은 꽤나 사납군… 꼬마, 넌 잠이나 자고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340111,
						250340112
					],
					"speakerTitle": "성가신 도적"
				},
				{
					"id": 250340111,
					"content": "한숨 푹 자는 건 너희야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				},
				{
					"id": 250340113,
					"content": "#{M#형아}{F#누나}! 저 사람들은 나쁜 놈이에요! 치카를 뺏어가려고 해요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340114
					],
					"speakerTitle": "틀라터"
				},
				{
					"id": 250340114,
					"content": "우우! 우우!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340115
					],
					"speakerTitle": "치카"
				},
				{
					"id": 250340115,
					"content": "…지나가던 사람은 이 일에서 빠져줘. 그럼 우리가 일이 끝난 후에 네 몫도 챙겨 줄 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340116,
						250340117
					],
					"speakerTitle": "성가신 도적"
				},
				{
					"id": 250340116,
					"content": "치카를 건드리지 마",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340118,
					"content": "더 말할 필요가 없겠군. 됐다, 그럼 규칙대로 주먹으로 얘기하자고!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340119
					],
					"speakerTitle": "성가신 도적"
				},
				{
					"id": 250340119,
					"content": "흐흐… 형제들이여, 돌격하라!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "성가신 도적"
				},
				{
					"id": 250340117,
					"content": "누가 봐 달라고 했나?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340112,
					"content": "너희도 내 탓 하면 안 되는 거 알지?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				}
			]
		},
