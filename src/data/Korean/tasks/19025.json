			"dialogs": [
				{
					"id": 190250501,
					"content": "이렇게 쉽게 찾을 줄 몰랐는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250502,
						190250503
					],
					"speakerTitle": "중운"
				},
				{
					"id": 190250502,
					"content": "경험이 부족해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				},
				{
					"id": 190250504,
					"content": "여기에 숨으면 찾지 못할 거라고 생각했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250505
					],
					"speakerTitle": "중운"
				},
				{
					"id": 190250505,
					"content": "내가 평소에 쫓는 요마들은 모두 숨기의 달인이야, 요마들이 숨었던 곳을 생각해봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250506
					],
					"speakerTitle": "중운"
				},
				{
					"id": 190250506,
					"content": "여기처럼, 요마들은 주변에 반듯한 물건이 놓여 있고 먼지도 쌓여있는 데다가, 햇빛도 잘 들어오지 않는 곳에 머무르는 걸 좋아하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250507,
						190250509
					],
					"speakerTitle": "중운"
				},
				{
					"id": 190250507,
					"content": "숨바꼭질과 도술을 연결하다니…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250508
					]
				},
				{
					"id": 190250508,
					"content": "음, 역시 이런 경험을 참고하면 안 되겠어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "중운"
				},
				{
					"id": 190250511,
					"content": "아무튼 걸렸으니까, 패배를 인정할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250512
					],
					"speakerTitle": "중운"
				},
				{
					"id": 190250512,
					"content": "근데 숨바꼭질을 해보니까 단순하지만 참 재밌네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250513,
						190250515
					],
					"speakerTitle": "중운"
				},
				{
					"id": 190250513,
					"content": "그럼 다음에 또 같이 놀까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250514
					]
				},
				{
					"id": 190250514,
					"content": "좋아, 친구들도 더 많이 부르자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "중운"
				},
				{
					"id": 190250517,
					"content": "그럼 갈까?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "중운"
				},
				{
					"id": 190250515,
					"content": "술래 안 시키길 잘한 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250516
					]
				},
				{
					"id": 190250516,
					"content": "하하, 맞는 말이야, 만약 내가 술래였다면 한 시간이 걸려도 다 못 찾았을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250517
					],
					"speakerTitle": "중운"
				},
				{
					"id": 190250509,
					"content": "하지만 너무 한눈에 보였는걸",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250510
					]
				},
				{
					"id": 190250510,
					"content": "아, 확실히 너무 긴장해서 가장 중요한 부분을 생각하지 못했어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190250511
					],
					"speakerTitle": "중운"
				},
				{
					"id": 190250503,
					"content": "…왜 여기에 숨은 거야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190250504
					]
				}
			]
		},
