			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"우나"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040101,
					"content": "키토, 키나, 왔니…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040102
					],
					"speakerTitle": "우나"
				},
				{
					"id": 722040102,
					"content": "정말… 그렇게 뛰어다니면 이 할미는 못 따라가… 저러다가 무슨 일이라도 일어나면 어떡하려고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040103,
						722040104
					],
					"speakerTitle": "우나"
				},
				{
					"id": 722040103,
					"content": "안녕하세요…?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				},
				{
					"id": 722040105,
					"content": "아이고! 너희들… 어린놈들이 못 하는 말이 없어. 그런 말은 할미에게 상처가 된단다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040106
					],
					"speakerTitle": "우나"
				},
				{
					"id": 722040106,
					"content": "이리 왔으면… 딴 데 가지 말고 할미랑 같이 있어 줘, 괜찮겠니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040107,
						722040108
					],
					"speakerTitle": "우나"
				},
				{
					"id": 722040107,
					"content": "죄송해요, 전…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040109,
					"content": "저번에 어디까지 이야기했더라…? 아, 맞다… 너희들의 할아버지가 어렸을 적에 말이다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040110
					],
					"speakerTitle": "우나"
				},
				{
					"id": 722040110,
					"content": "안개바다 밖에, 스마리 씨족이 살고 있던 섬이 있었는데… 그 일족의 주인은 여우 모습을 한 여인이었지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040111
					],
					"speakerTitle": "우나"
				},
				{
					"id": 722040111,
					"content": "그들 말에 의하면 그들 섬에는 번개색 꽃이 엄청 많다고 해… 스마리 씨족은 그렇게 높은 산, 논밭과 들에 집을 짓고 행복하게 살았단다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040112
					],
					"speakerTitle": "우나"
				},
				{
					"id": 722040112,
					"content": "그러고는… 하… 그들의 꽃은… 하… 쿨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040113
					],
					"speakerTitle": "우나"
				},
				{
					"id": 722040113,
					"content": "쿨… 쿨… 안개 바다의 밖은… 음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040114,
						722040115
					],
					"speakerTitle": "우나"
				},
				{
					"id": 722040114,
					"content": "할머니…? 괜찮으세요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040116,
					"content": "음… 키토? 키나? 벌써… 가려고? 음… 정말 미안하구나, 할미가 또 깜빡 졸았네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040117
					],
					"speakerTitle": "우나"
				},
				{
					"id": 722040117,
					"content": "가기 전에 이거 가져가… 할미가 너희한테 주려고 계속 보관하고 있었어… 이건 안개바다 반대편에서 구한 꽃이야… 절대 잃어버리면 안 된단다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "우나"
				},
				{
					"id": 722040115,
					"content": "(깨우지 않는 게 좋겠어…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040108,
					"content": "알겠어요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040104,
					"content": "사람을 잘못 보신 것 같은데요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				}
			]
		},
