			"dialogs": [
				{
					"id": 760520201,
					"content": "음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520202
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520202,
					"content": "어떤 것 같아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520203
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520203,
					"content": "아주 먼 옛날이 떠올라. 나랑 「서리달 아이」가 함께 지내던 때…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520204
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520204,
					"content": "거기 사람들은 신선한 민트랑 향료, 말린 과일을 같이 우린 음료를 즐겨 마셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520205
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520205,
					"content": "창가를 지날 때마다 집 안에서 은은한 풀 내음이 풍겨왔지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520206
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520206,
					"content": "그래서? 마셔봤어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520207
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520207,
					"content": "그러려고 했는데, 못 마셨어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520208
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520208,
					"content": "응? 왜…?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520209
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520209,
					"content": "난데없이 「신」이 「너희 집 차를 마실 수 있냐」고 물어도… 진짜 집에서 「대충 우린 차」를 바칠 사람은 없으니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520210
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520210,
					"content": "아, 그렇네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520211
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520211,
					"content": "내 손에 들어왔을 땐, 화려한 포장지에 싸여 「신」께 바치는 「공물」이 되어 있었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520212
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520212,
					"content": "맛이 없는 건 아니었지만… 창가를 지날 때 맡은 따스한 향은 느껴지지 않았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520213
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520213,
					"content": "이제 마음껏 마셔",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520214
					]
				},
				{
					"id": 760520214,
					"content": "응…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520215
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520215,
					"content": "맛있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520216
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520216,
					"content": "…그런데 우유를 넣는 경우도 있구나",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520217
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520217,
					"content": "몬드의 레시피야. 거기선 차에 우유나 크림, 설탕 같은 걸 많이 넣어 마시거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520218
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520218,
					"content": "신기하다. 맛있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520219
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520219,
					"content": "휴, 마음에 든다니 다행이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520220
					],
