			"dialogs": [
				{
					"id": 760520101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520102
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520102,
					"content": "콜롬비나, 괜찮아? 기운이 없어 보여",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520103
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520103,
					"content": "너희구나. 난 괜찮아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520104
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520104,
					"content": "(또 「달」에 관한 문제를 생각하는 건가…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520105
					]
				},
				{
					"id": 760520105,
					"content": "내가 뭐 도와줄 거 있을까?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520106
					]
				},
				{
					"id": 760520106,
					"content": "나…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520107
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520107,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520108
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520108,
					"content": "편하게 말해. 사소한 고민이어도 털어놓으면 훨씬 후련하다구",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520109,
					"content": "나… 주점에 있는 음료를 마시고 싶어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520110
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520110,
					"content": "어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520111,
					"content": "…음…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520112
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520112,
					"content": "미안! 그냥 좀 놀라서. 네가 원하는 걸 말하는 경우는 별로 없다 보니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520113
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520113,
					"content": "게다가, 그게 그냥… 음료라니",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520114
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520114,
					"content": "너무 쉬운 소원이라서 그래?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520115
					]
				},
				{
					"id": 760520115,
					"content": "난 최소한 「달을 따다 줘」 같은 소원이 나올 줄 알았어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520116
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520116,
					"content": "음, 그치만 이해는 되네. 지금 콜롬비나는 마음대로 돌아다니기 어려우니까, 주점에 가는 게 달을 따는 것만큼 힘들 수도 있지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520117
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520117,
					"content": "「우인단」에 있을 때도 그랬어. 날 잡으려는 사람은 없었지만, 내가 밖에 나서면 다들 나를 멀찌감치 피해 다녔지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520118
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520118,
					"content": "(집행관 서열 3위라는 이름은… 콜롬비나를 잘 모르는 사람들은 무서워하기 충분하지…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520119
					]
				},
				{
					"id": 760520119,
					"content": "음… 근데 생각해 보니까, 별로 어렵진 않을 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520120,
					"content": "#주점에서 파는 정도의 음료라면, {NICKNAME} 너도 만들 수 있잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520121
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520121,
					"content": "…정말?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520122
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520122,
					"content": "그렇게 기대하니까 괜히 나까지 더 긴장되네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520123
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520123,
					"content": "특별히 원하는 맛 있어?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520124
					]
				},
				{
					"id": 760520124,
					"content": "맛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520125
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520125,
					"content": "바깥 음료를 많이 안 마셔봐서 구체적으로 말하긴 어렵지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520126
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520126,
					"content": "너무 무겁지 않게?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520127
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520127,
					"content": "무겁다는 게 무슨 말이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520128
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520128,
					"content": "「우인단」의 코트 같은 거",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520129
					],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520129,
					"content": "들으면 들을수록 모르겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520130,
						760520131
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 760520130,
					"content": "맑고 깔끔한 음료를 원하는 것 같은데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				},
				{
					"id": 760520132,
					"content": "응. 부탁해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「콜롬비나」"
				},
				{
					"id": 760520131,
					"content": "나한테 맡겨",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				}
			]
		},
