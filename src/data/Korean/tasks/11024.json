	"talks": [
		{
			"id": 1102401,
			"completionStepIds": [
				1102401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102401",
							"2"
						],
						"stepId": 1102401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"종려"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110240101,
					"content": "전에 내가 말했지. 고운각 밑에는 진압된 수많은 과거의 마신들이 있다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240102
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110240102,
					"content": "선인들은 이제 리월을 인간에게 맡겼고, 훌리야의 시대는 더욱 먼 과거일세. 그러니 그녀가 남긴 「소금 단지」와 「소금 자」를 리월로 가져가선 안 되네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240103
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110240103,
					"content": "차라리 이곳에 남겨두어 깊이 잠들게 하는 것이, 고향에 돌려보내는 셈이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240104
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110240104,
					"content": "제가 뭘 하면 될까요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240105
					]
				},
				{
					"id": 110240105,
					"content": "내 손으로 한 시대를 끝냈네. 그리고 난 줄곧… 내가 끝낸 역사를 어떻게 기록할지 고민 중이었지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240106
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110240106,
					"content": "역사는 기록할 수 있지만, 이번 일이 증명했듯 늘 신뢰할 수 있는 건 아니야. 시간이라는 강대한 힘 앞에 역사는 왜곡되곤 하니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240107
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110240107,
					"content": "그래서 진실된 역사를 새길 더 나은 「기록」을 찾고 있었어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240108
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110240108,
					"content": "석판에 새긴 「기록」은 오래 남지만, 변하지 않을 것 같은 반석이나 세상, 그리고 나 자신도… 어느 날 사라져 버릴지도 몰라",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240109
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110240109,
					"content": "종려…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240110
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110240110,
					"content": "그래서 여행자, 난 자네가 떠올랐네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240111
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110240111,
					"content": "자네는 여러 세계와 별바다를 넘나든 사람이야. 자네 기억 속에 새긴 역사는 언젠가 자네와 함께 다른 세계로 가겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240112
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110240112,
					"content": "여행자인 자네가 충분히 「기록」한다면, 티바트의 시대와 역사에 「살아있는 예비본」이 생기게 되는 거야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240113,
						110240115
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110240113,
					"content": "그래서 저와 함께 다니시는 거군요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240114
					]
				},
				{
					"id": 110240114,
					"content": "책임이 무겁네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240118
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110240118,
					"content": "그럼 이제 「소금 단지」와 「소금 자」를 바다에 던지자고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240119
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110240119,
					"content": "엥? 왜 바다에 던져야 하는데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240120
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 110240120,
					"content": "방금 말했잖나. 여기에 진압된 과거의 마신들이 있다고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240121
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110240121,
					"content": "「군옥각」에 의해 심해에 다시 갇힌 「소용돌이의 마신」 오셀도 포함되지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "종려"
				},
				{
					"id": 110240115,
					"content": "보물찾기를 시키려는 게 아니었군요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240116
					]
				},
				{
					"id": 110240116,
					"content": "하하하… 부디 티바트 대륙을 떠난 후에도 별바다 사이에서 보물을 찾게 되길 바라네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240117
					],
					"speakerTitle": "종려"
				},
				{
					"id": 110240117,
					"content": "내겐 「재물의 신」이란 이름도 있으니, 이 말이 제법 효력이 있을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240118
					],
					"speakerTitle": "종려"
				}
			]
		}
	]
}