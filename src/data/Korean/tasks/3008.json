				"points": []
			},
			"dialogs": [
				{
					"id": 30080201,
					"content": "「하프트 미와」 요리를 파는 곳이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080202
					],
					"speakerTitle": "두냐르자드"
				},
				{
					"id": 30080202,
					"content": "아가씨는 식견이 대단하시군요. 요즘 사람들은 잘 모를 줄 알았는데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080203
					],
					"speakerTitle": "아말"
				},
				{
					"id": 30080203,
					"content": "에이, 풀떼기밖에 없잖아. 윽, 나 실망했어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080204
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30080204,
					"content": "그나저나 「하프트 미와」는 뭐야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080205
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30080205,
					"content": "화신 탄신 축제의 풍습 같은 거야. 사람들은 수메르 신의 7가지 품성을 상징하는 음식들을 준비하거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080206,
						30080207
					],
					"speakerTitle": "두냐르자드"
				},
				{
					"id": 30080206,
					"content": "잠깐만… 아까부터…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080208
					]
				},
				{
					"id": 30080208,
					"content": "…재의 모양을 봤을 때는 「달」인 것 같군요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080209
					],
					"speakerTitle": "키미야"
				},
				{
					"id": 30080209,
					"content": "정말? 난 왜 먹는 것처럼 생긴 것 같지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080210
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30080210,
					"content": "음… 「달」은… 음… 뭘 상징하는지 까먹었네요, 잠시만 기다려주세요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080211
					],
					"speakerTitle": "키미야"
				},
				{
					"id": 30080211,
					"content": "지금 책을 몰래 보고 있는 거지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080212
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30080212,
					"content": "아, 맞다, 달은 「허망」과 「거짓」을 의미해요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080213
					],
					"speakerTitle": "키미야"
				},
				{
					"id": 30080213,
					"content": "자신의 감을 믿고 마음속의 두려움을 극복하면 해는 반드시 떠오른답니다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080214,
						30080215
					],
					"speakerTitle": "키미야"
				},
				{
					"id": 30080214,
					"content": "어디서 들어본 듯한 말이야…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080216
					]
				},
				{
					"id": 30080216,
					"content": "알겠어요. 참고할게요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080217
					],
					"speakerTitle": "두냐르자드"
				},
				{
					"id": 30080217,
					"content": "아… 저도 즉석에서 배우면서 알려드리는 거라서… 하하… 하하…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080218
					],
					"speakerTitle": "키미야"
				},
				{
					"id": 30080218,
					"content": "그래도 재미있었어. 다음 노점도 가보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 30080215,
					"content": "「기시감」인가?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080216
					]
				},
				{
					"id": 30080207,
					"content": "익숙한 느낌이 들어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080208
					]
				}
			]
		},
