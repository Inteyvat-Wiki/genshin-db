				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210042001,
					"content": "마신일지라도 벗어날 수 없었던 운명…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042002
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 210042002,
					"content": "유적 4곳에서 4개의 단서를 발견했어요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042003
					]
				},
				{
					"id": 210042003,
					"content": "유적 4곳에 단서 4개라… 「귀종 4훈」의 훈계 구절 수와 같아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042004
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 210042004,
					"content": "하지만 이 4구절 모두 「귀종 4훈」의 어느 한 조항에 대한 해석이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042005
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 210042005,
					"content": "정확히 해독하려면 역시 「귀종 4훈」의 원문이 필요해, 이 4구절은 보조적인 역할을 할 뿐이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042006
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 210042006,
					"content": "이 다섯 마디를 연결해야 돼. 근데 대체 무슨 뜻이지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042007
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 210042007,
					"content": "「4구절을 모아 완성된」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042008
					]
				},
				{
					"id": 210042008,
					"content": "4구절을 모아 완성됐다라…. 이 4구절을 다른 방식으로 결합해보라는 것 같은데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042009
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 210042009,
					"content": "그러고 보니 이 「훈어」 4구절은 각각 4개의 유적 속에 있었던 것 같아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042010
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 210042010,
					"content": "음… 좀 서투른 추측을 해보자면, 이 「훈어」 4구절을 해독하기 위해선 각 「훈어」가 있던 <color=#00E1FFFF>「유적」</color>을 잘 활용해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042011
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 210042011,
					"content": "그러나 구체적인 해독 방법은 더 고민해봐야겠어…. 너도 생각해보고 혹시 좋은 방법이 떠오르면 바로 실천해봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042012
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 210042012,
					"content": "넌 몇 발자국만 가도 힘이 빠져버리는 나 같은 「약해빠진」 학자와는 다르니까…. 에휴, 넌 강철 체력이라서 좋겠다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042013
					],
					"speakerTitle": "소라야"
				},
				{
					"id": 210042013,
					"content": "그럼 난 여기서 더 생각해보고 있을게. 좋은 방법이 떠오르거나 뭔가 발견하면 나한테 와줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "소라야"
				}
			]
		},
