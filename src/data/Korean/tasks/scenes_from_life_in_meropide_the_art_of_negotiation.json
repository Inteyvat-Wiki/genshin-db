			},
			"dialogs": [
				{
					"id": 740660901,
					"content": "(나 준비 끝났어! 어서 도전해 보자!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660902
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660902,
					"content": "첫 번째 질문, 특별 허가 식당의 음식 가격을 지금처럼 낮게 유지하는 게 합리적이라고 생각하는가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660903
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660903,
					"content": "(음——어떻게 대답할까? 어디 보자… 찾았다! 이 만능 공식을 대입해 보자)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660904
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660904,
					"content": "(책에 따르면 「저도 그 관점에 동의합니다. 하지만…」이라는 말은 어떤 상황에서도 쓸 수 있대. 이걸 사용하면 심연 메이지와도 교류할 수 있다는데? 이건 좀 대단한걸)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660905,
						740660909,
						740660914
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660905,
					"content": "합리적이죠. 페이몬도 좋아하는걸요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660906
					]
				},
				{
					"id": 740660906,
					"content": "뭐…? 난 그렇게 맛없는 음식은 공짜로 줘도 안 먹어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660907
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660907,
					"content": "하지만 음식을 살 돈이 없다면…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660908
					]
				},
				{
					"id": 740660908,
					"content": "음… 그러고 보니 일리가… 아, 아니야! 난 차라리 굶을래!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660918,
					"content": "크흠, 잠깐만",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660919
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660919,
					"content": "응?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660920
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660920,
					"content": "규칙에 따르면 이 설문 조사는 빠르게 대답해야 해. 일단 다음 문제로 넘어가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660921
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660921,
					"content": "아, 알았어… 규칙이 그렇다면야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660922
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660922,
					"content": "두 번째 질문, 식사 시간에 특별 허가 식당이 공급하는 음식의 양은 충분한가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660923
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660923,
					"content": "충분하기는 하지만… 정말 맛이 없다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660924,
						740660929,
						740660932
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660924,
					"content": "양만 보면 티바트 대륙의 민트보다 많아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660925
					]
				},
				{
					"id": 740660925,
					"content": "난 차라리 민트를 먹을래…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660926
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660926,
					"content": "진짜? 그럼 오늘은 민트 샐러드를 먹자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660927
					]
				},
				{
					"id": 740660927,
					"content": "싫어! 난 둘 다 싫다구! 흑흑, 난 달콤달콤 닭고기 스튜를 먹고 싶단 말이야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660928
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660928,
					"content": "아무튼… 다시 본론으로 돌아와서, 그럼 설문지에는 「네」라고 적을게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660935,
					"content": "후… 힘들다. 다음 질문으로 넘어가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660936
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660936,
					"content": "세 번째 질문을 하기 전에 다시 한번 말하지만, 답변은 빠르게 해야 해. 그러니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660937
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660937,
					"content": "아무튼 세 번째 질문, 무작위 메뉴가 재미있는가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660938
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660938,
					"content": "맛이나 좀 신경 쓰라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660939
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660939,
					"content": "나도 그 관점에 동의해. 하지만… 무작위 메뉴에는 깜짝 놀랄 만한 의외성이라는 게 있잖아?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660940
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660940,
					"content": "오… 그렇게 생각해 보니까 확실히 재밌는 것 같아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660941
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660941,
					"content": "페이몬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660942
					]
				},
				{
					"id": 740660942,
					"content": "왜? 몽그리니 말이 일리가 있잖아. 인정할 건 인정해야지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660943
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660943,
					"content": "크흠, 어서 대답해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660944,
						740660949,
						740660951
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660944,
					"content": "재밌어요. 행운의 쪽지도 재밌고요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660945
					]
				},
				{
					"id": 740660945,
					"content": "맞아! 매번 나오는 그 쪽지가 제비뽑기 같아서 꽤 재밌어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660946
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660946,
					"content": "「열심히 일하면 성공할 것이다!」 이거 뽑으면 기분이 좋다니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660947
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660947,
					"content": "가이드 일이 힘들기는 하지",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660948
					]
				},
				{
					"id": 740660948,
					"content": "헤헤",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660957,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660958
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660958,
					"content": "네 번째 질문, 식당에서 기호품을 판매하는 것이 합리적이라고 생각하는가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660959
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660959,
					"content": "(어? 어? 갑자기 목소리가 빨라졌네?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660960
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660960,
					"content": "(「기선제압」? 「화제 유도」? 아니, 둘 다 아닌 것 같아. 그럼… 그냥 만능 공식을 써볼까…?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660961,
						740660962
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660961,
					"content": "(이 질문들… 뭔가 이상해…)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660963,
					"content": "크흠, 너무 깊이 생각하지 말고 잡담도 하지 마. 앞서 말한 것처럼 직감을 따라서 빠르게 대답해 봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660964,
						740660965,
						740660966
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660964,
					"content": "합리적이에요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660967,
					"content": "좋아, 답변 고마워. 이제 마지막 질문이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660968
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660968,
					"content": "무시했어! 우리 대답은 중요하지 않은 거 아냐?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660969
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660969,
					"content": "지금까지의 답변을 토대로 특별 허가 식당 현황에 대한 만족도는?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660970
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660970,
					"content": "아까 질문이 뭐였더라? 기억이 안 나는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660971
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660971,
					"content": "괜찮아. 다 만족이라고 하면 되잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660972
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660972,
					"content": "그런가… 근데 뭔가 좀 이상한 것 같단 말이지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660973
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660973,
					"content": "참고로 「아니요」라고 대답하면 특별 허가 쿠폰을 얻을 수 없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660974
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660974,
					"content": "너무하잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660975
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660975,
					"content": "#그럼 {NICKNAME}, 네 선택은?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660976
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660976,
					"content": "내 말 무시하지 말라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660977,
						740660978,
						740660981
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660977,
					"content": "네, 아주 만족스러워요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660982,
					"content": "협조해 줘서 고마워. 네가 보내준 성원은 우리의 발전을 위한 밑거름이 될 거야. 이쪽에 서명하고 특별 허가 쿠폰을 가져가. 옆에 있는 스마트 비행 태엽 장치도 서명하면 가져갈 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660983
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660983,
					"content": "어? 내 몫도 있다고?! 난 참여하지 않았는데 정말 가져가도 되는 거야? 잠깐, 난 페이몬이야. 무슨 비행 태엽 장치가 아니라구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660984
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660984,
					"content": "그래그래, 아무튼 모든 의견을 존중해 주는 것이 우리 원칙이니까. 모든 사람을… 아니, 모든 사람과 기계를 위한 몫이 준비되어 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660985
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660985,
					"content": "말했잖아. 난 비행 태엽 장치가 아니라 페이몬이라구! 무시하지 말라니까!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660986
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660986,
					"content": "알았어… 아무튼 네 귀중한 시간을 아끼기 위해, 네가 답변한 내용은 내가 응답지에 적어줄게. 걱정 마, 특별 허가 쿠폰은 똑같이 지급할 테니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660987
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660987,
					"content": "네 답변은 모두 「만족」 맞지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660988
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660988,
					"content": "응! 특별 허가 쿠폰!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660989
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660989,
					"content": "그럼 여기에 서명만 하면 돼. 나머진 나한테 맡겨",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660990
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660990,
					"content": "오예! 귀찮은 절차를 생략하고 바로 특별 허가 쿠폰을 얻을 수 있다니! 그럼 잘 부탁해, 몽그리니!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660991
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660991,
					"content": "자, 여기 특별 허가 쿠폰. 협조해 줘서 고마워. 다음 설문 조사 때 또 만나자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660992
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660992,
					"content": "특별 허가 쿠폰을 받은 당신과 페이몬은 몽그리니와 작별했다",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740660993
					]
				},
				{
					"id": 740660993,
					"content": "#{NICKNAME}, 지금 생각해 보니까… 몽그리니는 우리가 뭐라고 대답하는지 전혀 신경 쓰지 않는 것 같던데?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660994
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660994,
					"content": "설문 내용이 이상해서 그런 것 같아",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660995
					]
				},
				{
					"id": 740660995,
					"content": "——음, 확실히 좀 이상하긴 했지. 게다가… 몽그리니도 아주 피곤해 보였고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660996
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660996,
					"content": "「협상의 예술」은 실패했네",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660997
					]
				},
				{
					"id": 740660997,
					"content": "이게 무슨 「협상의 예술」이야? 하나도 쓸모없잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660998,
						740661000,
						740661002
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660998,
					"content": "맞아, 전부 그 책 탓이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660999
					]
				},
				{
					"id": 740660999,
					"content": "그치? 네 생각에도 책에 문제가 있지? 그래도 특별 허가 쿠폰을 봐서 이번에는 그냥 넘어가자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740661000,
					"content": "아니, 페이몬 탓이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661001
					]
				},
				{
					"id": 740661001,
					"content": "뭐——? 그치만 난 책 내용 그대로 따라 했는걸. 봐, 「그래서 나는 큰 소리로 말했다…」 역시 다 이 책 탓이잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740661002,
					"content": "나도 그 관점에 동의해. 하지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661003
					]
				},
				{
					"id": 740661003,
					"content": "너어——그런 식으로 놀리지 말라구! 이게 무슨 「협상의 예술」이야? 이 책, 하나도 쓸모없잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660978,
					"content": "아뇨, 아주 불만족스러워요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660979
					]
				},
				{
					"id": 740660979,
					"content": "아냐, 그러지 말고 만족한다고 해. 특별 허가 쿠폰은 받아야지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660980
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660980,
					"content": "만족한다고? 알았어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660982
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660981,
					"content": "아주 만족스럽지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660965,
					"content": "비합리적이에요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660966,
					"content": "저도 그 관점에 동의합니다. 하지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660962,
					"content": "(지금… 화제를 유도하고 있는 건가?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660949,
					"content": "별로예요. 먹고 싶은 걸 먹을 수 없잖아요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660950
					]
				},
				{
					"id": 740660950,
					"content": "…매번 이상한 요리 밖에 안 나오는데 대체 의외성이 어디 있다는 거야?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660951,
					"content": "저도 그 관점에 동의합니다. 하지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660952
					]
				},
				{
					"id": 740660952,
					"content": "18번 식사하면 맛있는 요리를 공짜로 하나 줬으면 더 좋겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660953
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660953,
					"content": "왜 하필 18번이야?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660954
					]
				},
				{
					"id": 740660954,
					"content": "이건 다른 사람한테 들은 건데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660955
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660955,
					"content": "뭐랬더라…? 음——하루에 3끼를 먹으면 일요일 전까지는 6일이니까 총 18끼잖아…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660956
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660956,
					"content": "일곱째 날 맛있는 공짜 요리를 먹을 수 있으면 한 주 동안 기분이 좋을 거 아냐!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660929,
					"content": "부족해요. 울지 씨도 못 먹는걸요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660930
					]
				},
				{
					"id": 740660930,
					"content": "그건 먹기 싫어서 그런 거잖아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660931
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660931,
					"content": "알았어. 아무튼 부족하다는 거네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660932,
					"content": "저도 그 관점에 동의합니다. 하지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660933
					]
				},
				{
					"id": 740660933,
					"content": "어차피 우리는 안 먹잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660934
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660934,
					"content": "후… 너희가 그 책 본 거 다 알거든…? 아무튼 「네」라고 적으면 되겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660909,
					"content": "합리적이지 않아요. 가격을 올려야 해요!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660910
					]
				},
				{
					"id": 740660910,
					"content": "엥?! 어째서?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660911
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660911,
					"content": "난 제일 좋은 게 아니라 제일 비싼 걸 원해!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660912
					]
				},
				{
					"id": 740660912,
					"content": "대체 뭔 소리야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660913
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660913,
					"content": "너… 지금 괜찮은 거 맞아? 뭔가 이상한 것 같은데…. 뭐 잘못 먹은 거 아냐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660914,
					"content": "저도 그 관점에 동의합니다. 하지만…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660915
					]
				},
				{
					"id": 740660915,
					"content": "하지만?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660916
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660916,
					"content": "#아직도 개선할 여지가 있어! 더 맛있어졌으면 좋겠다구. 그치, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660917
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660917,
					"content": "아니면… 달콤달콤 닭고기 스튜를 팔았으면 좋겠다. 그러면 매일 사 먹을 텐데",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "페이몬"
				}
			]
		}
	]
}