					}
				]
			},
			"dialogs": [
				{
					"id": 740660301,
					"content": "등록처라면… 이쪽이야! 그럼 어디 한번 운을 시험해 볼까나?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660302
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660302,
					"content": "몽그리니, 안녕~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660304
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660304,
					"content": "(우와… 진짜 대화하기 힘든 사람이네)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660305
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660305,
					"content": "(우리 「협상의 예술」을 써볼까?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660306
					]
				},
				{
					"id": 740660306,
					"content": "(맞다, 그런 게 있었지! 설마 이런 곳에서 도움이 될 줄이야)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660307,
					"content": "어디 보자… 찾았다! 「먼저 기선제압으로 상대방의 기세를 꺾는다면…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660308
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660308,
					"content": "바로 이거야! 기세에서 상대를 압도하면 된다는 건가? 좋았어! 요컨대 큰 소리로 말하면 된다는 거겠지?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660309
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660309,
					"content": "어이! 어이! 몽그리니, 안녕——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660310
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660310,
					"content": "…듣고 있어. 내 도움이 필요하니?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660311
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660311,
					"content": "엥? 정말 도움이 되네!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660312
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660312,
					"content": "헤헤, 몽그리니! 우리 설문 조사 하러 왔어! 아… 아니다. 나는 그냥 얘 따라온 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660313
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660313,
					"content": "#({NICKNAME}, 우리한텐 이 책이 있으니까 걱정하지 마. 내가 몰래 책을 보고 힌트를 줄게! 음… 아무튼 내 말대로 하면 될 거야)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660314
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660314,
					"content": "또 책에 있는 팸플릿을 보고 온 사람인가…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660315
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660315,
					"content": "응! 맞아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660316
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 740660316,
					"content": "대체 얼마나 뿌린 거야…. 그게 실은… 하아, 아니다. 아무것도 아니야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660317
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660317,
					"content": "크흠, 잠시만 기다려…. 일단 규칙을 설명해 줄게. 이번 설문 조사는 총 5개의 질문으로 구성되어 있어. 직감에 따라 빠르게 대답하면 돼. 명심해, 꼭 빠르게 대답해야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660318
					],
					"speakerTitle": "몽그리니"
				},
				{
					"id": 740660318,
					"content": "알겠지? 준비가 됐으면 시작할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "몽그리니"
				}
			]
		},
