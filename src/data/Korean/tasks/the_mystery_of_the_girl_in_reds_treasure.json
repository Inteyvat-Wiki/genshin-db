			},
			"dialogs": [
				{
					"id": 102010101,
					"content": "도착했어! 바로 이 근처야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010102
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102010102,
					"content": "봐봐. 내가 엄~청 커다란 보물 하나를 여기에 묻어놨었는데…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010103
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102010103,
					"content": "구멍 하나만 남았네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010104
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102010104,
					"content": "잠깐, 저기 누군가 있어…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010105
					]
				},
				{
					"id": 102010105,
					"content": "심연 메이지야?! 저게 바로 진 단장이 전에 경고했던 몬드성에 몰래 접근한다던…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010106
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102010106,
					"content": "응? 손에 들고 있는 게 뭐지…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010107
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102010107,
					"content": "내 보물이야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010108
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102010108,
					"content": "엥?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010109
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102010109,
					"content": "칫, 지원을 불러오다니, 계획을 바꿔야겠다…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010110
					],
					"speakerTitle": "심연 메이지"
				},
				{
					"id": 102010110,
					"content": "야! 도망가지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010111
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102010111,
					"content": "쫓아가자!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 1020103,
			"completionStepIds": [
				1020113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
