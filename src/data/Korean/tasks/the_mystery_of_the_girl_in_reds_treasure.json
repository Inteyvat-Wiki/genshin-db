			"trigger": {
				"objectNames": [
					"클레"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102010301,
					"content": "아, 비경 입구야! 심연 메이지는 분명 이리로 들어간 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010302,
						102010303
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102010302,
					"content": "더는 도망갈 곳이 없겠군",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				},
				{
					"id": 102010304,
					"content": "후우… 후우…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010305
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102010305,
					"content": "클레야, 더 뛸 수 있겠어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010306
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102010306,
					"content": "여기서 기다릴래? 보물 찾으면 돌려줄게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010307
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102010307,
					"content": "…안, 안 돼. 나도 같이 갈 거야!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010308
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102010308,
					"content": "보송보송한 녀석이 훔쳐 간 건 내 거야. 내겐 그걸 되찾을 책임이 있다구!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010309,
						102010310
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102010309,
					"content": "용기가 가상한데",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010311,
					"content": "헤헤, 클레는 엄청 강해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010312
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102010312,
					"content": "#명예기사 {F#언니}{M#오빠}, 어서 가자. 빨리",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "클레"
				},
				{
					"id": 102010310,
					"content": "하지만 비경은 엄청 위험해",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010303,
					"content": "어서 쫓아가자",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				}
			]
		},
