			},
			"dialogs": [
				{
					"id": 102010401,
					"content": "흥, 쫓아오다니. 너희들도 한가락 하는가 보군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010402
					],
					"speakerTitle": "심연 메이지"
				},
				{
					"id": 102010402,
					"content": "하지만, 너흰 여기까지다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010403
					],
					"speakerTitle": "심연 메이지"
				},
				{
					"id": 102010403,
					"content": "뭘 하려구?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010404
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102010404,
					"content": "하하하하하",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010405
					],
					"speakerTitle": "심연 메이지"
				},
				{
					"id": 102010405,
					"content": "우린 인간들의 소문을 통해 전력에 대한 자세한 정보를 수집했다",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010406
					],
					"speakerTitle": "심연 메이지"
				},
				{
					"id": 102010406,
					"content": "그 빨간 옷의 여자아이가 몬드성의 가장 강력한 보물을 갖고 있다더군",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010407
					],
					"speakerTitle": "심연 메이지"
				},
				{
					"id": 102010407,
					"content": "이제 보물은 내 손에 있으니, 용 써도 소용없어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010408
					],
					"speakerTitle": "심연 메이지"
				},
				{
					"id": 102010408,
					"content": "자… 이 보물로 너흴 상대해주마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010409
					],
					"speakerTitle": "심연 메이지"
				},
				{
					"id": 102010409,
					"content": "안 돼! 절… 절대로 건드리지 마!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010410
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102010410,
					"content": "당황하긴, 이제야 겁을 먹은 거냐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010411
					],
					"speakerTitle": "심연 메이지"
				},
				{
					"id": 102010411,
					"content": "어디 보자, 오호… 화염의 표식인가. 후후후후",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010412
					],
					"speakerTitle": "심연 메이지"
				},
				{
					"id": 102010412,
					"content": "펑——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010501
					],
					"speakerTitle": "심연 메이지"
				},
				{
					"id": 102010501,
					"content": "아!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010502
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102010502,
					"content": "생존 수칙 하나 「폭탄에 사람 부상, 진이 방문」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010503
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102010503,
					"content": "다 끝났어. 다 끝나버렸다구…. 으허엉",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010504
					],
					"speakerTitle": "클레"
				},
				{
					"id": 102010504,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010505
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102010505,
					"content": "클레의 「보물」이 폭탄이었구나!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010506,
						102010507
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 102010506,
					"content": "엄청난데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				},
				{
					"id": 102010508,
					"content": "응, 그래서 클레가 몬드에서 가장 강하다는 소문이 돌았던 거구나",
