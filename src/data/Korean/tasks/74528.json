			"dialogs": [
				{
					"id": 745280401,
					"content": "너구나. 우리 여정이 또 교차했네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280402,
						745280403
					],
					"speakerTitle": "스커크"
				},
				{
					"id": 745280402,
					"content": "스커크, 오랜만이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				},
				{
					"id": 745280404,
					"content": "이 세계에 남겨진 「상처」를 관찰하고 있어. 과거의 폭발로 이곳은 폐허가 되었지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280405
					],
					"speakerTitle": "스커크"
				},
				{
					"id": 745280405,
					"content": "오늘날 사람들은 폐허 위에 다시 새로운 건물을 세웠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280406
					],
					"speakerTitle": "스커크"
				},
				{
					"id": 745280406,
					"content": "모든 것은 시들기 마련이지만, 시든 후에도 새로운 가능성이 잉태되는 법이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280407
					],
					"speakerTitle": "스커크"
				},
				{
					"id": 745280407,
					"content": "지난번에 만났을 때보다 더 강해졌구나. 단련을 게을리하지 않아서 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280408,
						745280409
					],
					"speakerTitle": "스커크"
				},
				{
					"id": 745280408,
					"content": "실은 부탁이 있는데…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280410,
					"content": "사진? 난 이 세계를 떠도는 나그네일 뿐이야. 굳이 무언가를 남길 필요가 없지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280411,
						745280412
					],
					"speakerTitle": "스커크"
				},
				{
					"id": 745280411,
					"content": "하지만 나한테는 그저 지나가는 나그네가 아닌걸",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280413,
					"content": "…네가 하고 싶은 대로 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280414
					],
					"speakerTitle": "스커크"
				},
				{
					"id": 745280414,
					"content": "난 여기 있으니까. 언제든 시작할 수 있어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "스커크"
				},
				{
					"id": 745280412,
					"content": "재회는 언제나 기념할 만한 일이야",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280409,
					"content": "사진을 한 장 찍고 싶어",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280403,
					"content": "여기서 뭐 해?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				}
			]
		}
	]
