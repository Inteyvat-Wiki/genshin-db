					"주르반"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020101,
					"content": "지난번에 비해 표정이 많이 좋아졌군. 훈련이 순조롭나 봐?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020102
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 737020102,
					"content": "네, 몇 번의 반성을 통해 전 성장했어요. 지금은…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020103
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 737020103,
					"content": "페리 용자다운 페리가 되었다고?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020104
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 737020104,
					"content": "아, 아직은 아니에요. 마지막 훈련이 남았잖아요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020105
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 737020105,
					"content": "모든 임무를 완수하고 선배에게 인정받아야 「쌍각 화관」의 진정한 주인이 될 수 있겠죠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020106
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 737020106,
					"content": "오? 사춘기가 끝났다더니 거짓말은 아니었나 보네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020107
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 737020107,
					"content": "그, 그걸 아직도 기억하시는 거예요? 빨리 잊어주세요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020108
					],
					"speakerTitle": "소루쉬"
				},
				{
					"id": 737020108,
					"content": "후후, 아무튼 기운을 차려서 다행이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020109
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 737020109,
					"content": "#{NICKNAME}(와)과 페이몬, 소루쉬가 「쌍각 화관」에 어울리는지 부디 끝까지 지켜봐 줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020110
					],
					"speakerTitle": "주르반"
				},
				{
					"id": 737020110,
					"content": "난 종점에서 기다리고 있을 테니 나중에 보자",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "주르반"
				}
			]
		},
		{
			"id": 7370206,
			"completionStepIds": [
				7370206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370206",
							"2"
						],
						"stepId": 7370206,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7323201",
							"0"
						]
					}
