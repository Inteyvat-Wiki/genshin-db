				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"스미다",
					"카마"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460101,
					"content": "아름다운 팔찌! 아름다운 꽃병! 리월의 물건들은 전부 예쁘다!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460102
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460102,
					"content": "…아, 안 돼. 이런 어휘량으로는 어디 가서 소설가라고 하기도 부끄러워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460103
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460103,
					"content": "정교하고 아름다운 꽃병을 사서, 소설의 참고 자료로 써야겠어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460104
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460104,
					"content": "음… 이런 줄거리를 써봐야겠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460105
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460105,
					"content": "「상황 역전의 키포인트가, 이 꽃병 안에 있는 신의 눈이었을 줄이야…!」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460106
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460106,
					"content": "엄청 재미있을 거 같은데! 어때요, 카마 씨?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460107
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460107,
					"content": "저는 아무거나 다 괜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460108
					],
					"speakerTitle": "카마"
				},
				{
					"id": 722460108,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460109
					],
					"speakerTitle": "카마"
				},
				{
					"id": 722460109,
					"content": "…전 「꽃병」에 대한 내용이 너무 많으면 그 의도가 너무 분명해서 조절이 필요할 거 같아요. 하지만 또 내용이 너무 적으면 스미다 님이 나중에 떡밥을 회수할 때 이상할 수도 있을 것 같네요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460110
					],
					"speakerTitle": "카마"
				},
				{
					"id": 722460110,
					"content": "우와, 일리 있네요! 메모 좀 해야겠어요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460111
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460111,
					"content": "아아, 죄송해요! 자리를 좀 옮기죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460112
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460112,
					"content": "그리고 스미다 님으로 부르지 말라고 몇 번이나 얘기했잖아요——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460113
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460113,
					"content": "음? 생각해 보니, 둘이 여행하면서 한 명이 「님」을 붙이는 것도 드문 일은 아닌 것 같네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "스미다"
				}
			]
		},
		{
			"id": 7224602,
			"completionStepIds": [
				7224603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224603",
							"2"
						],
						"stepId": 7224603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"스미다",
					"카마"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460201,
					"content": "후아——정말 멋져——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460202
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460202,
					"content": "역시 북대륙에서 제일 큰 도서관이네요! 《소녀 베라의 우울》을 정주행할 수 있을 줄이야! 정말 즐거웠어!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460203
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460203,
					"content": "스미다 님, 소리 낮추세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460204
					],
					"speakerTitle": "카마"
				},
				{
					"id": 722460204,
					"content": "아, 미안해요. 너무 흥분돼서, 저도 모르게…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460205
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460205,
					"content": "아니에요, 스미다 님이 다치실까 봐 그런 거예요. 저 뒤에 있는 사서 아가씨의 기운이 범상치 않아서…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460206
					],
					"speakerTitle": "카마"
				},
				{
					"id": 722460206,
					"content": "음? 그래요? 전 그냥 전형적인 귀차니즘 마녀 같은데요…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460207
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460207,
					"content": "…지금 생각해 보니, 보통 이런 캐릭터가 제일 강했어요. 안 되지, 안 되지. 절대 그녀를 화나게 해서는 안 돼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460208
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460208,
					"content": "아, 그래요. 다음에는 이런 캐릭터를 주인공으로 작품을 써봐야겠어요. 《대도서관의 마법사》…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460209
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460209,
					"content": "여행은 어떠셨나요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460210
					]
				},
				{
					"id": 722460210,
					"content": "오랜만이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460211
					],
					"speakerTitle": "카마"
				},
				{
					"id": 722460211,
					"content": "#어, 전설의 {NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460212
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460212,
					"content": "여행은… 전에도 취재하러 여행을 많이 다녔어요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460213
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460213,
					"content": "「번개의 재앙을 묘사하기 위해 무상도의 협곡에 가기」,「뱀 요괴를 묘사하기 위해 뱀 신의 머리에 가기」, 「번개를 쫓는 자의 생활을 묘사하기 위해 카마 씨한테 입대시키기」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460214
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460214,
					"content": "오늘도 악마 1패 추가. 카마 씨가 고생이 많네요…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460215
					]
				},
				{
					"id": 722460215,
					"content": "별거 아니에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460216
					],
					"speakerTitle": "카마"
				},
				{
					"id": 722460216,
					"content": "하지만, 이번은 정말 목적 없이 멀리 떠나는 여행이에요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460217
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460217,
					"content": "그랬더니 쓸만한 주제들, 재미있는 이야기들이 너무 많다는 걸 알게 됐어요. 마치 《키노의 여행》처럼요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460218
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460218,
					"content": "카마 씨와 같이 현지인이 추천해 준 여행지와 가게를 탐방하고, 그리고 야외에서 야영할 때, 낯선 사람들과 같이 불도 쬐고 이야기도 하고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460219
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460219,
					"content": "눈을 떴을 땐 모든 여비가 도난당했지만…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460220
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460220,
					"content": "…괜찮은 거 맞죠?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460221
					]
				},
				{
					"id": 722460221,
					"content": "괜찮아요. 그자들을 결국에는 찾았거든요. 처음에 열 명이 보일 때 돌려받긴 틀렸구나 싶었죠",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460222
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460222,
					"content": "근데 카마 씨가 그들을 설득해서, 돈을 다 돌려받았어요. 게다가 까마귀 무늬가 있는 기념화폐까지 얻어왔어요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460223
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460223,
					"content": "분명 재미있는 소재일 텐데, 카마 씨가 자세한 이야기를 안 해줘요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460224,
						722460225
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460224,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				},
				{
					"id": 722460226,
					"content": "당연히 해야 할 일이죠. 스미다 님은 신경 쓰지 않으셔도 돼요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460227
					],
					"speakerTitle": "카마"
				},
				{
					"id": 722460227,
					"content": "아뇨, 카마 씨는 정말 믿음직스러워요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460228
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460228,
					"content": "카마 씨랑 같이 있으면, 세계 끝까지 가도 문제없을 거예요!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460229
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460229,
					"content": "게다가, 츠루미 일이 있은 뒤로 카마 씨가 많이 변한 거 같아요. 하고 싶어 하는 일도 생기고, 질문도 하고, 제 생각을 이야기할 줄도 알고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460230
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460230,
					"content": "스미다 님이 그게 안 좋다고 생각하신다면…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460231
					],
					"speakerTitle": "카마"
				},
				{
					"id": 722460231,
					"content": "좋아서 그래요! 카마 씨가 말해 준 의견 중에 좋은 의견이 많았으니까요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460232,
						722460233
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460232,
					"content": "그럼 두 분을 방해하지 않을게요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460234,
					"content": "#그래요, 다음에 또 봐요, {NICKNAME}. 《피슬 황녀 야화》에 나오는 것처럼, 모든 것의 끝에서 다시 만나요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460235
					],
					"speakerTitle": "스미다"
				},
				{
					"id": 722460235,
					"content": "#{NICKNAME}, 고마워요, 몸조심하세요",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "카마"
				},
				{
					"id": 722460233,
					"content": "기회가 된다면 또 만나요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460225,
					"content": "카마 씨는 정말 대단하네요",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				}
			]
		},
		{
