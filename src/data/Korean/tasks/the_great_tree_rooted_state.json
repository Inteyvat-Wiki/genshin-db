					"야스민"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280101,
					"content": "여행자, 마침 잘 왔어. 지금 막 도움이 필요했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280102
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280102,
					"content": "신성한 나무의 뿌리에 무슨 문제라도 생긴 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280103
					]
				},
				{
					"id": 230280103,
					"content": "신성한 나무 상태는 모두 정상이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280104
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280104,
					"content": "내가 해야 하는 일은 신성한 나무가 계속 정상적인 상태를 유지하게 하는 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280105
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280105,
					"content": "구체적으로 말하면 이 약물을 신성한 나무의 뿌리 주변에 뿌리는 거지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280106
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280106,
					"content": "그런데 약물의 양이 너무 많아서 혼자서는 도저히 못 옮기겠어. 마침 라데프와 페레즈도 일에 발이 묶여서 난감했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280107
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280107,
					"content": "나 대신 이 약물을 옮겨줘",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280108,
						230280112
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280108,
					"content": "라데프와 페레즈는…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280109
					]
				},
				{
					"id": 230280109,
					"content": "두 사람도 나처럼 학생인데 라데프는 스판타마드 학부 소속이고 페레즈는 크샤흐레와르 학부 소속이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280110
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280110,
					"content": "우리는 공동 과제를 맡고 있어. 이념은 다르지만, 지금은 협력하고 있는 상황이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280111
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280111,
					"content": "이 약물이 바로 우리가 함께 만든 작품이고",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280113
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280113,
					"content": "그래. 이건 내가 옮길 테니 남은 걸 부탁할게",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280114
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280114,
					"content": "조심해서 옮겨야 해. 라데프가 사람들이 약물을 못 마시게 하려고 굉장히 역한 냄새를 추가했다고 했거든",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280115
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280115,
					"content": "약물이 옷에 묻으면 오랫동안 고약한 냄새가 사라지지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280112,
					"content": "그럼 출발하죠",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280113
					]
				}
			]
		},
		{
			"id": 2302804,
			"completionStepIds": [
				2302804
