			"trigger": {
				"objectNames": [
					"아완",
					"야스민"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280401,
					"content": "야스민? 네가 어떻게 여기, 윽… 설마 또 약물을 뿌리러 온 거야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280402
					],
					"speakerTitle": "아완"
				},
				{
					"id": 230280402,
					"content": "여기 있는 나무뿌리는 모두 정상이야. 더는 약물을 뿌리지 않아도 된다니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280403
					],
					"speakerTitle": "아완"
				},
				{
					"id": 230280403,
					"content": "그렇다고 해도 계속 세심히 돌봐 줘야 해",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280404
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280404,
					"content": "문제가 생기고 나서야 대책을 생각하는 건, 생선이 다 익기도 전에 생선 롤을 만드는 거나 마찬가지야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280405
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280405,
					"content": "다시 만들거나 완성된 롤을 푸는 건 꽤 번거로운 일이니까",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280406
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280406,
					"content": "정말 말로는 못 이기겠다니까… 지난번에도 네게 그 약 냄새에 대해 말했잖아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280407
					],
					"speakerTitle": "아완"
				},
				{
					"id": 230280407,
					"content": "난 이 근처에서 산다고. 그런 이상한 냄새를 맡으면서 잠들고 싶지 않아",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280408
					],
					"speakerTitle": "아완"
				},
				{
					"id": 230280408,
					"content": "걱정하지 마, 라데프한테 약물의 제조법을 수정하라고 했으니까. 그렇게 자극적이지 않을 거야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280409
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280409,
					"content": "에휴, 됐다. 난 갈래, 우리 정원에는 뿌리지 말아 줘. 그 냄새 정말 견디기 힘드니까…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280410
					],
					"speakerTitle": "아완"
				},
				{
					"id": 230280410,
					"content": "그래, 그래. 알겠어. 여행자, 상자 안에 있는 약물을 나한테 줄래?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280411
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280411,
					"content": "야스민과 함께 약물을 뿌린다…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230280412
					]
				},
				{
					"id": 230280412,
					"content": "냄새가 정말 고약하네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280413
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230280413,
					"content": "야스민 씨는 괜찮아요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280414
					]
				},
				{
					"id": 230280414,
					"content": "냄새라면… 이 약물보다 훨씬 더 고약한 것도 많이 맡아봤어",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280415
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280415,
					"content": "이제 됐어. 여러 데이터를 기록했으니 페레즈도 분명 좋아하겠지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280416
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280416,
					"content": "여행자, 네게 주는 보수야. 지금까지 도와줘서 고마워",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280417
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280417,
					"content": "라데프와 페레즈가 일을 잘하고 있는지 모르겠네…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야스민"
				}
			]
		},
