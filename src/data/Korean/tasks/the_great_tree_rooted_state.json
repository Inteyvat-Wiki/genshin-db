			},
			"dialogs": [
				{
					"id": 230280501,
					"content": "야스민 누나! 으악!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280502
					]
				},
				{
					"id": 230280502,
					"content": "숨, 숨을 못 쉬겠어. 어서 여길 벗어나야 해!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280503
					]
				},
				{
					"id": 230280503,
					"content": "이게 뭐야… 켁, 콜록콜록! 이게 무슨 냄새야…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280504
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 230280504,
					"content": "라데프가 일을 제대로 해줬네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280505
					],
					"speakerTitle": "야스민"
				},
				{
					"id": 230280505,
					"content": "여긴 다 뿌렸으니 다음 장소로 가자. 바로 이 근처니까 멀리 안 가도 돼",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "야스민"
				}
			]
		}
	]
