			"trigger": {
				"objectNames": [
					"자카"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752640401,
					"content": "사람 잘못 잡았어…. 들어 봐, 우리 스승님은 카네이고 난 자카야… 잡아야 할 사람은 스승님이라고…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640402
					],
					"speakerTitle": "자카"
				},
				{
					"id": 752640402,
					"content": "난 스승님 수준의 인형은 못 만들어…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640403
					],
					"speakerTitle": "자카"
				},
				{
					"id": 752640403,
					"content": "잡혀 오신 거예요?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752640404
					]
				},
				{
					"id": 752640404,
					"content": "엥? 너희도 한 패 아니야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640405
					],
					"speakerTitle": "자카"
				},
				{
					"id": 752640405,
					"content": "당연히 아니지. 우리가 다 쫓아낸 거 못 봤어?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640406
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 752640406,
					"content": "그래? 다행이다! 난 드디어 자유인가?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640407
					],
					"speakerTitle": "자카"
				},
				{
					"id": 752640407,
					"content": "당연하지. 이제 집에 가도 돼. 근데… 대체 어떻게 된 일이야?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640408
					],
					"speakerTitle": "페이몬"
				},
				{
					"id": 752640408,
					"content": "이 녀석들이 어디서 왔는지 모르겠지만, 여기서 가짜 인형을 만들고 있었어. 하지만 품질이 너무 형편없어서, 내 스승님 카네이를 납치해 고문으로 삼으려 했지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640409
					],
					"speakerTitle": "자카"
				},
				{
					"id": 752640409,
					"content": "근데 어디서 문제가 생겼는지, 날 잡아온 거야…. 맙소사, 난 스승님한테 색칠 기술을 겨우 사흘밖에 안 배웠다고… 조건 미달인걸….",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640410
					],
					"speakerTitle": "자카"
				},
				{
					"id": 752640410,
					"content": "어쨌든 정말 고마워!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640411
					],
					"speakerTitle": "자카"
				},
				{
					"id": 752640411,
					"content": "아자카, 집으로 돌아가자!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640412
					],
					"speakerTitle": "자카"
				},
				{
					"id": 752640412,
					"content": "~~~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "아자카"
				}
			]
		}
	]
