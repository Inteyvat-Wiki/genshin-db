				"points": []
			},
			"dialogs": [
				{
					"id": 718170301,
					"content": "이런, 바빠서 아래층 손님 주문받는 것도 까먹었네",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170302
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718170302,
					"content": "이렇게 하자, 넌 아래층에 있는 외국인 손님들께 주문을 받아줘. 횔덜린씨와 카스파 씨가 있는 테이블이야",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170303
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718170303,
					"content": "아마 오래 기다리셨을 거야. 화나셨을 수도 있으니까, 먼저 반찬으로 <color=#00E1FFFF>맛있는 버섯 닭꼬치</color> <color=#00E1FFFF>2인분</color> 올려드리는 거 잊지 마",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170304
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718170304,
					"content": "반찬 드린 다음에 메인 요리는 뭘 드실 건지 여쭤봐. 그래야 두 번 수고하지 않지",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718170305
					],
					"speakerTitle": "언소"
				},
				{
					"id": 718170305,
					"content": "손님들 기다리지 않게 어서 가봐",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "언소"
				}
			]
		},
