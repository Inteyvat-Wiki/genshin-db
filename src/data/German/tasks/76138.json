			},
			"dialogs": [
				{
					"id": 761380201,
					"content": "Chefin Nefer? Und ... Herr Zompaynco, was gibt’s, wenn ich fragen darf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380202
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380202,
					"content": "Unser Gast aus Natlan scheint die „Nachkommen des Frostmonds“ besuchen zu wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380203,
					"content": "Aber aus gewissen Gründen der Höflichkeit will er lieber jemanden dabei haben, der ihn vorstellt. Bitte, Herr Zompaynco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380204
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380204,
					"content": "Fräulein Lyylikki! Schön, dich zu sehen. Ähm ... das ist ein Fossil, das ich aus Natlan mitgebracht habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380205
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380205,
					"content": "Danke, Herr Zompaynco, aber ich kenne dich doch schon lange. Du musst wirklich nicht so formell sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380206
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380206,
					"content": "Hm? Wie hast du mich diesmal erkannt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380207
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380207,
					"content": "Du warst doch da, als ich das Essen ausgegeben habe. Du bist die ganze Zeit hin und her gelaufen, aber hast dich nie angestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380208
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380208,
					"content": "Ich dachte, du wolltest auch eine Portion nehmen, hast dich aber nicht getraut. Also habe ich dir heimlich eine zurückgelegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380209
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380209,
					"content": "Aber ... du hast sie nie abgeholt. Wärst du heute nicht gekommen, hätte ich jemanden geschickt, um zu fragen, ob du Hilfe brauchst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380210
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380210,
					"content": "Äh ... I... Ich ... Tut mir leid, ich war unsicher, wie ich dich ansprechen soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380211
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380211,
					"content": "Also, Fräulein Lyylikki, darf ich mal bei den „Nachkommen des Frostmonds“ vorbeischauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380212
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380212,
					"content": "Klar, bei den „Nachkommen des Frostmonds“ gibt es ohnehin ein paar Gäste von außerhalb. Aber was willst du denn dort machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380213
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380213,
					"content": "Ich will ein paar Fotos machen, in Dokumenten stöbern und, wenn möglich, Leute nach Legenden fragen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380214
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380214,
					"content": "Ich bin Mitglied im „Verein für Saurierrelikte“ in Natlan. Es wäre super, wenn ich ein paar Materialien zu meinem Forschungsthema sammeln könnte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380215
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380215,
					"content": "Oh ... du willst also in die Bücher schauen? Lass mich mal überlegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380216
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380216,
					"content": "Da ihr euch nun kennengelernt habt, ist dieser Auftrag damit erledigt. Also werde ich mich verabschieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380217
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380217,
					"content": "Danke, Chefin Nefer! Ähm ... die Kosten bezahle ich natürlich trotzdem, wie könnte ich dich denn auch einfach so umsonst losschicken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380218
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380218,
					"content": "Das ist ganz dir überlassen, Herr Zompaynco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380219
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380219,
					"content": "Also, dann verabschiede ich mich jetzt. Euch beiden noch eine gute Unterhaltung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				}
			]
		}
	]
}