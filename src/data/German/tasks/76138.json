			"dialogs": [
				{
					"id": 761380101,
					"content": "Ah ... Chefin Nefer! Meine Güte, du kommst genau zur richtigen Zeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380102
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380102,
					"content": "Hast du dich entschieden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380103,
					"content": "Huh? Entschieden ... W... Was meinst du damit ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380104
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380104,
					"content": "Ich weiß, du wolltest schon immer die „Nachkommen des Frostmonds“ besuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380105,
					"content": "Also hoffst du, zuerst Lyylikki kennenzulernen und diese Freundschaft als Eintrittskarte zu den „Nachkommen des Frostmonds“ zu nutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380106,
					"content": "Du ... Du weißt alles! Oje, ich hab das doch immer für mich behalten und kaum jemandem erzählt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380107
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380107,
					"content": "Herr Zompaynco, wer ein Geheimnis bewahren will, muss auch verbergen können, dass er eines hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380108,
					"content": "Sonst bekommt die Mauer in deinem Herzen früher oder später Risse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380109,
					"content": "*seufz* In meiner Heimat konnte ich meine Gedanken nie gut verbergen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380110
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380110,
					"content": "Na gut ... da du es eh weißt, kannst du mich vielleicht vorstellen? Ich bin ein Fremder und würde Fräulein Lyylikki nicht einfach so stören wollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380111
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380111,
					"content": "Die „Nachkommen des Frostmonds“ sind sehr freundlich. Selbst wenn die Besucher Fremde sind, ja sogar wenn es keine Menschen sind, werden sie freundlich empfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380112,
					"content": "Was? Wirklich ... Echt jetzt ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380113
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380113,
					"content": "Aber egal wie, einfach so aufzutauchen wäre unhöflich. Also bitte, Chefin Nefer, stell mich doch vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380114
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380114,
					"content": "Gut, sie müssten gerade mit dem Austeilen des Essens fertig sein. Das ist eine gute Gelegenheit zum Reden, los geht’s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380115,
					"content": "Ah ... diesmal verlange ich nichts, ich kam nur zufällig vorbei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380116,
					"content": "Danke, Chefin Nefer! Ich pack gleich meine Sachen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zompaynco"
				}
			]
		},
