				]
			},
			"dialogs": [
				{
					"id": 761490101,
					"content": "Was?! Wer ist da?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490102
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490102,
					"content": "#{NICKNAME}. Ich bin jemand aus der heutigen Zeit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490103
					]
				},
				{
					"id": 761490103,
					"content": "Ich kenne eure Zeit zwar nicht, aber ich heiße Alara und war eigentlich ein Asket im Zeitalter der Stille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490104
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490104,
					"content": "Ich weiß nicht mehr, wie lange ich schon hier bin. Dieser Ort hat sogar meine Selbstkultivierung in der Stille unterbrochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490105
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490105,
					"content": "Es ist also wahr ... wer seinen Geist ohne Gedanken und Begierden kultiviert, wird im Gedankenlosen Himmel des Bösen wiedergeboren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490106
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490106,
					"content": "Nicht der Rede wert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490107
					]
				},
				{
					"id": 761490107,
					"content": "Du musst mir nicht danken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490108
					]
				},
				{
					"id": 761490108,
					"content": "Trotzdem danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490109
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490109,
					"content": "Dich zu retten, war eher eine spontane Entscheidung. Aber davon abgesehen, wollen wir versuchen, einen Ausweg zu finden, der nichts mit Meditation zu tun hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490110
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490110,
					"content": "Hast du etwa keine Übung im Meditieren? Oder wird das in deinem Zeitalter einfach nicht gelehrt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490111
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490111,
					"content": "Das erste Mal, als ich diesen Ort verließ, dauerte es Hunderte von Jahren. Ich gab meine Suche nach der Wahrheit auf ... und meine Sehnsucht, meine Liebsten wiederzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490112
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490112,
					"content": "Diesmal bin ich nicht bereit, diese Dinge aufzugeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490113
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490113,
					"content": "Ich bin dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490114
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490114,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490115
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490115,
					"content": "Dex hat noch ein Fragment der Vergänglichkeit gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490116
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490116,
					"content": "Vergänglichkeit? Ach so, du meinst die Maranasati-Meditationstechnik. Ich habe davon gehört, und auch davon, wie sie zur Kultivierung des eigenen Geisteszustands im Angesicht des Todes verwendet werden kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490117
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490117,
					"content": "Jetzt, wo wir Zeitlind gefunden haben, sollten wir versuchen, einen Ausgang zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490118
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490118,
					"content": "Bist du sicher, dass wir hier aus eigener Kraft herauskommen können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490119
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490119,
					"content": "Melanta und Nihilita können sich hier frei bewegen, und normalerweise haben sie auch immer Leute bei sich. Daher sollte Dex in der Lage sein, das auch zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490120
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490120,
					"content": "♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490121
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490121,
					"content": "Jetzt haben wir schon drei Fragmente der Vergänglichkeit eingesammelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490122
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490122,
					"content": "Hm, wobei das nur ein temporärer Name ist. Denn ich weiß auch nicht, wofür Dex sie verwenden will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490123
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490123,
					"content": "Was jetzt, Dex?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490124
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490124,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490125
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490125,
					"content": "Folgen wir ihm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
