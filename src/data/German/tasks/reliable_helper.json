					"nextDialogs": [
						207003202
					]
				},
				{
					"id": 207003202,
					"content": "Nicht schlecht, nicht schlecht. Es wurde auch keine Box beschädigt - du weißt, was du tust.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003203
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003203,
					"content": "Hier, nimm diese fünftausend Mora. Wir sollten wieder Geschäfte machen, sollte sich die Möglichkeit dazu auftun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003204
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003204,
					"content": "All diese Arbeit, für nur fünftausend Mora ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207003205,
					"content": "Werd jetzt nicht wählerisch. Ich habe diese Vergütung sehr sorgfältig berechnet und sie ist der Arbeit angemessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003206
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003206,
					"content": "Man muss Großes leisten, um große Belohnungen zu kriegen. Falls wir uns wieder treffen, kannst du dann dein Glück versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
