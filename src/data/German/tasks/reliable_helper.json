					"nextDialogs": [
						207004307
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004307,
					"content": "Was? 1000 Mora? Für was kann man das überhaupt hernehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207004308,
					"content": "Hmpf. Zu wenig sagst du? Du hast die Arbeit nicht einmal richtig erledigt. Diese 1000 Mora sind mehr als genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
