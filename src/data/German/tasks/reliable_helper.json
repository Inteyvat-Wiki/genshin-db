			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsarevich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000201,
					"content": "Ist bereits erledigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000202
					]
				},
				{
					"id": 207000202,
					"content": "So bald? In weniger als einer Minute sogar. Du bist ziemlich gut. Wirklich ziemlich gut, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000203
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000203,
					"content": "Gut, gut. Fünftausend Mora, und nicht ein Mora weniger. Nimm es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000204
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000204,
					"content": "„Ziemlich gut“, und alles, was wir kriegen, sind fünftausend Mora ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207000205,
					"content": "Werd jetzt nicht wählerisch. Ich habe diese Vergütung sehr sorgfältig berechnet und sie ist der Arbeit angemessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000206
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000206,
					"content": "Man muss Großes leisten, um große Belohnungen zu kriegen. Falls wir uns wieder treffen, kannst du dann dein Glück versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
		{
