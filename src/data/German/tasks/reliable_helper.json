			"dialogs": [
				{
					"id": 207003101,
					"content": "Ich werde in Richtung Berge gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207003102
					]
				},
				{
					"id": 207003102,
					"content": "Ah, es gibt einige Waren von mir, die ich zurück transportieren und in den Bergen verkaufen wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003103
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003103,
					"content": "Aber jetzt sind nicht nur die Straßen blockiert. Es ist auch der Bereich, in dem ich meine Waren gelagert habe, von Hilichurlen besetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003104
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003104,
					"content": "Glücklicherweise haben sie kein gutes Auge für Wertvolles und haben meine Waren nicht angefasst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003105
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003105,
					"content": "Geh jetzt und beseitige sie. Und denk daran, meine Waren nicht anzufassen. Diese Boxen gehen leicht kaputt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003106
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003106,
					"content": "*seufz* Mit den Straßensperren können diese Waren wahrscheinlich nicht mehr verkauft werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
