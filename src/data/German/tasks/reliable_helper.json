					"nextDialogs": [
						207004102
					]
				},
				{
					"id": 207004102,
					"content": "Die Gruppe Hilichurle auf dem Gipfel sind am schwierigsten zu beseitigen. Früher bin ich dort hingegangen um zu entspannen, nun traue ich mich nicht einmal in die Nähe. Sehr unglücklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004103
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004103,
					"content": "Na ja, du siehst recht tüchtig aus. Ich denke also, diese Aufgabe passt zu dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004104
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004104,
					"content": "Denk daran, dass der große Holzkopf mit der Axt zuerst beseitigt werden muss. Ihn so eingebildet herumlaufen zu sehen, lässt mein Blut kochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004105
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004105,
					"content": "Und dann gibt es den, der sein großes Schild in deinem Gesicht herumwedelt. Was für ein unschöner Anblick ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004106
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004106,
					"content": "Und schließlich solltest du die mit den langen Stäben loswerden ... Wie werden sie nochmal genannt? Samachurle? Egal, sie sehen nicht so zäh aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004107
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207004107,
					"content": "Werde sie auf jeden Fall alle los. Schaff sie aus meinem Sichtfeld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
