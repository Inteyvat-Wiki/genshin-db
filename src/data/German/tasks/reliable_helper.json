				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsarevich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000101,
					"content": "Was für ein Pech. Diese Ritter vom Ordo Favonius sind wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000102
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000103
					]
				},
				{
					"id": 207000103,
					"content": "Hmpf! Diese Ritter vom Ordo Favonius haben überhaupt keinen Sinn für Effizienz. Sie sagten, es seien Monster voraus und ließen mich nicht passieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000104
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000104,
					"content": "Aber sogar jetzt habe ich nichts Konkreteres von ihnen erfahren. Was für ein unzuverlässiger Haufen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000105
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000105,
					"content": "Ich habe noch so viele Angelegenheiten, um die ich mich kümmern muss. Haben die überhaupt eine Ahnung, wie viel Geld sie mich kosten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000106
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000106,
					"content": "Nun ja, du siehst wie ein Abenteurer aus, oder? Wie wäre es ... Wärst du bereit, etwas für mich zu tun? Ich bezahle dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000107,
						207000109
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000107,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000108
					]
				},
				{
					"id": 207000108,
					"content": "Wundervoll. Ich liebe Menschen, die sich klar ausdrücken. Ihr werdet eure Belohnung erhalten, sobald die Tat vollbracht ist. Ich verspreche es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000111,
					"content": "Vielleicht täuschen mich meine Augen, aber die Anzahl der Hilichurle um Mondstadt hat sich anscheinend vergrößert. Wer weiß, was diese sogenannten Ritter den ganzen Tag machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000112
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000112,
					"content": "Da du zugestimmt hast, mir zu helfen, kannst du mir helfen abzufahren. Aber du bist nur eine Person. Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000113
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000113,
					"content": "Vergiss es. Wähle selbst eines dieser Gebiete zum Säubern aus: den Gipfel, die Seite oder den Fuß des Berges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000114
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000114,
					"content": "Es sind alles Hilichurle, egal wo. Es gibt also keinen Unterschied. Geh jetzt und verschwende nicht meine Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000109,
					"content": "Wie viel bietest du an?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000110
					]
				},
				{
					"id": 207000110,
					"content": "Hah, das hängt von der Art der Taten ab. Wenn du es gut machst, werde ich mich darum kümmern, dass du belohnt wirst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Tsarevich"
				}
			]
		},
		{
			"id": 2070002,
