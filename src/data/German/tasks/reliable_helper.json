				{
					"id": 207003301,
					"content": "Ist bereits erledigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207003302
					]
				},
				{
					"id": 207003302,
					"content": "Hast du mich falsch verstanden? Oder hoffst du, dass ich es dir durchgehen lasse? Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003303
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003303,
					"content": "Ich habe dir gesagt, du sollst diese Boxen nicht kaputtmachen, und du hast so viele kaputtgemacht? Können sie jetzt überhaupt noch verkauft werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003304
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003304,
					"content": "Ich habe keine Waren gesehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207003305
					]
				},
				{
					"id": 207003305,
					"content": "Das waren diese Boxen! Das waren meine Waren! Warum sollte ich sie sonst draußen aufstapeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003306
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003306,
					"content": "Vergiss es! Ich habe nichts zu sagen zu Flegeln, die ihre Aufgabe überhaupt nicht ernst nehmen können wie du. Hier sind deine tausend Mora – nimm sie und geh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003307
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207003307,
					"content": "1000 Mora? Das ist viel zu wenig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207003308,
					"content": "Zu wenig? Du kannst nicht mal eine einfache Arbeit richtig erledigen und du willst mehr Geld? Das ist der Betrag, den du verdienst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
