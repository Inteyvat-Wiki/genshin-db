			},
			"dialogs": [
				{
					"id": 207000304,
					"content": "Ist bereits erledigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000305
					]
				},
				{
					"id": 207000305,
					"content": "Faul, genau wie der Ordo Favonius. Du hattest eine Minute! Hast du es vergessen oder von Anfang an nicht zugehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000306
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000306,
					"content": "Keine Aufmerksamkeit, nicht mal für so einfache Details ... es sind 1000 Mora. Mach damit, was du willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000307
					],
					"speakerTitle": "Tsarevich"
				},
				{
					"id": 207000307,
					"content": "1000 Mora? So wenig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207000308,
					"content": "Was erwartest du für eine Arbeit, die so erledigt wurde? Das ist die Bezahlung, die du verdienst - jetzt nimm es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsarevich"
				}
			]
		},
		{
			"id": 2070007,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
