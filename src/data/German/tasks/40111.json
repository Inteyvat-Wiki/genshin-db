				"objectNames": [
					"Sangonomiya Kokomi",
					"Kujou Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401115201,
					"content": "Frau Kujou, hast du Zeit für ein Gespräch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115202
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115202,
					"content": "Herzlichen Glückwunsch zu diesem Sieg, Sangonomiya Kokomi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115203
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115203,
					"content": "Ich bin dir sehr dankbar, dass du mich daran erinnert hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115204
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115204,
					"content": "Keine Ursache. Jeder, der sich mit Kartenspiel auskennt, weiß, dass Geschick und Strategie über den Sieger entscheiden. Auf jeden Fall war es ein guter Wettbewerb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115205
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115205,
					"content": "Echt schade, dass du dieses Mal nicht teilgenommen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115206
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115206,
					"content": "Ich fürchte, ich kann dich nicht besiegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115207
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115207,
					"content": "Nein. Ich nehme an, du freust dich auch darauf, so wie ich es tue, deine Fähigkeiten zu verfeinern, über deine Strategie nachzudenken und dich mit Freunden und anderen Spielern beim Kartenspielen zu messen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115208
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115208,
					"content": "... Vielleicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115209
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115209,
					"content": "Nun, wenn das so ist, dann lass uns, bevor du Narukami verlässt, eine Runde „Geniale Beschwörung“ spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115210,
					"content": "Nur zu gern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
