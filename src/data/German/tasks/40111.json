			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charlotte",
					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401113301,
					"content": "Hallo, ich bin Charlotte von der Zeitung „Dampfvogel“ in Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113302
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113302,
					"content": "Hättest du ein paar Minuten Zeit? Ich würde gerne ein kurzes Interview mit dir machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113303
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113303,
					"content": "*seufz* Frag nur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113304
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113304,
					"content": "Du hast es bis zur letzten Runde geschafft und zuletzt den Titel an die Direktorin Hu Tao aus dem Bestattungsunternehmen Wangsheng verloren, was ziemlich bedauerlich ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113305
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113305,
					"content": "Wie würdest du diesen Wettkampf beurteilen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113306
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113306,
					"content": "Hmmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113307
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113307,
					"content": "Fräulein Journalistin, willst du eine Antwort, die in die Zeitung geschrieben werden darf, oder meine ehrliche Meinung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113308
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113308,
					"content": "Natürlich deine ehrliche Meinung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113309
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113309,
					"content": "*seufz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113310
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 401113310,
					"content": "Nun, mir ist schon immer klar, dass Sieg oder Niederlage beim Kartenspielen zu siebzig Prozent aus Geschick und zu dreißig aus Glück besteht ... aber diesmal hat sie sechs gleichfarbige Würfel geworfen! Ich bin nur ein gewöhnlicher Abenteurer, selbst wenn ich ein Adept wäre, hätte ich keine Chance gegen so etwas!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
		{
			"id": 4011151,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
