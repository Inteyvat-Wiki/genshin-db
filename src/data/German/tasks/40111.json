				"points": []
			},
			"dialogs": [
				{
					"id": 401111401,
					"content": "Was für ein toller Wettkampf. Dieser Junge Timmie ... sein Potenzial ist grenzenlos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111402
					],
					"speakerTitle": "Eichendorff"
				},
				{
					"id": 401111402,
					"content": "Ich habe nicht erwartet, dass Timmie am Ende gewinnen würde ... Ich bin in gewisser Weise stolz trotz meiner Niederlage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lennard"
				}
			]
		},
		{
			"id": 4011115,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4011101",
							"2"
						],
						"stepId": 4011101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Charlotte"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111501,
					"content": "„Der Rittmeister des Ordo Favonius gegen den talentierten ungeschlagenen Jungen. Die Stadt auf dem See bringt immer neue Talente hervor“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111502
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111502,
					"content": "Hmm, das ist eine Ehrfurcht zollende Schlagzeile, aber sie lässt etwas „Explosivität“ vermissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111503
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111503,
					"content": "„Der beste Kopf des Ordo Favonius verliert in fünf Runden gegen einen Jungen“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111504
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111504,
					"content": "„Eine glanzvolle Wendung wie eine goldene Kornähre“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111505
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111505,
					"content": "Hmmm ... vielleicht wäre es besser, wenn wir zur ersten Version zurückkehren? ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charlotte"
				}
			]
		},
		{
			"id": 4011131,
