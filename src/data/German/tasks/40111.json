						],
						"pointId": 4383
					}
				]
			},
			"dialogs": [
				{
					"id": 401113101,
					"content": "Ach so. Kann Beidou also auch „Geniale Beschwörung“ spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113102
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401113102,
					"content": "Ja, ihre Kartenkünste gehören zu den besten in der Crux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113103
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 401113103,
					"content": "Warum stellst du mich ihr nicht vor? Ich bewundere Beidou schon lange und wollte mich mit ihr anfreunden, aber ich hatte bisher noch nie die Gelegenheit dazu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113104
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401113104,
					"content": "Gut. Solltest du sie in einem Duell von „Geniale Beschwörung“ unweigerlich besiegen, sei bitte etwas gnädig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4011132,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4011102",
							"2"
						],
						"stepId": 4011102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401113201,
					"content": "Ich habe gehört, dass der inoffizielle Wettkampf von „Geniale Beschwörung“ sehr lebhaft ist. Viele Spieler, die Kartenspiele lieben, haben sich sogar gleichzeitig für sowohl den offiziellen als auch den inoffiziellen Wettkampf angemeldet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401113202,
					"content": "Mich ... stört es nicht, gelegentlich einem Trend zu folgen. Dennoch bin ich mehr an der Schachspielerei interessiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113203
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401113203,
					"content": "Eigentlich sind alle Spiele nur verschiedene Ausprägungen. Bedeutender ist die Tatsache, dass sich Freunde durch diese Spiele treffen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
		{
			"id": 4011133,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
