			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arataki Itto",
					"Kuki Shinobu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401115101,
					"content": "Der Kampf zwischen der Kitsune-Dame und dieser Ko oder Mi war so spannend, dass mir vor Aufregung der Schweiß auf der Stirn stand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115102
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115102,
					"content": "Ja, ja. Boss, ganz Ritou weiß, wie aufgeregt du warst. Aber die von der Arataki-Bande warten noch. Also ist es bald an der Zeit, zurückzugehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115103
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401115103,
					"content": "#Warte noch ein bisschen, so dringend ist es nicht. Lass mich wenigstens ein letztes Spiel mit {F#meiner besten Freundin}{M#meinem besten Freund} spielen ... Das ist doch nicht zu viel verlangt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115104,
						401115107
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115104,
					"content": "Aber klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115105
					]
				},
				{
					"id": 401115105,
					"content": "#{F#Meine liebe Freundin}{M#Mein lieber Freund}! Du bist wirklich {F#meine allerbeste Freundin}{M#mein allerbester Freund}! Du bist {F#die}{M#der} Einzige, {F#die}{M#der} meine flammende Kartenspielerseele verstehen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115106,
					"content": "... Ich bin euch gegenüber wirklich ratlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401115107,
					"content": "Vielleicht nächstes Mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115108
					]
				},
				{
					"id": 401115108,
					"content": "... Na gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115109,
					"content": "#Ein Mann kann nicht einfach Tränen vergießen. Ich mache dir keinen Vorwurf, {F#liebe Freundin}{M#lieber Freund}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
		{
			"id": 4011152,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
