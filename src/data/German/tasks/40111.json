			},
			"dialogs": [
				{
					"id": 401115301,
					"content": "Ich habe gehört, dass du sie „die große Kitsune“ nennst. Gibt es dafür einen Grund?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115302
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115302,
					"content": "Erzähl mir bitte mehr darüber, es könnte beim Schreiben nützlich sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115303
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115303,
					"content": "Ähm ... Wenn ich es dir sagen würde, hätte ich Angst, etwas Falsches zu sagen, da ich als Youkai nicht sehr erfahren bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115304
					],
					"speakerTitle": "Kirara"
				},
				{
					"id": 401115304,
					"content": "Na gut. Dann eine andere Frage: Was haben frittierter Tofu und Kitsune miteinander zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115305
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115305,
					"content": "Ich bin hungrig, weil du mir Löcher in den Bauch fragst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115306
					],
					"speakerTitle": "Kirara"
				},
				{
					"id": 401115306,
					"content": "Lass uns doch in Inazuma Ramen mit frittiertem Tofu essen. Ich kann es dir beim Essen erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kirara"
				}
			]
		}
	]
}