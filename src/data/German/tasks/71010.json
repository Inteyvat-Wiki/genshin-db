					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100101,
					"content": "Mein Schulkamerad und ich haben von Kindheit an die Kampfkünste geübt. Wir wollten die Mächte des Bösen bekämpfen und alles schützen, was in dieser Welt heilig ist. Aber dies war keine leichte Aufgabe ohne ein Göttliches Auge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100102
					],
					"speakerTitle": "Ruinenschatz"
				},
				{
					"id": 710100102,
					"content": "Wir zwei haben hier Unterschlupf gesucht, um uns weiterzubilden und die Göttlichen Augen zu suchen, die wir begehrten. Wir errichteten diese Stele als Zeichen unserer Bemühungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100103
					],
					"speakerTitle": "Ruinenschatz"
				}
			]
		},
		{
			"id": 7101002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101006",
							"3"
						],
						"stepId": 7101006,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100201,
					"content": "Aber jetzt, da mein Schulkamerad sein Göttliches Auge erhalten hat, fragte er mich, anstatt gegen Monster zu kämpfen: „Sind Monster wirklich von Natur aus böse?“ Also erwiderte ich ihm: „Sie richten auf der ganzen Welt Verwüstungen an, und unschuldige Menschen müssen die Konsequenzen tragen. Ist das nicht genug böse, als dass du nicht deine Klinge gegen sie erheben solltest?“ Ich glaube, ein Übermaß an Meditation hat sein Gehirn gebraten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100202
					],
					"speakerTitle": "Ruinenschatz"
				},
				{
					"id": 710100202,
					"content": "Nun, ich will es immer noch mit diesen Monstern aufnehmen, auch wenn ich es ohne ihn tun muss, und auch wenn es bedeutet, dass ich auf ein Göttliches Auge verzichten muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100203
					],
					"speakerTitle": "Ruinenschatz"
				}
			]
		},
		{
			"id": 7101003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101007",
							"3"
						],
						"stepId": 7101007,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100301,
					"content": "Monster sind das Verhängnis von allem, für das es sich lohnt, in dieser Welt zu leben. Wer von uns mit der Klinge umgehen kann, ist verpflichtet, sie zu töten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100302
					],
					"speakerTitle": "Ruinenschatz"
				},
				{
					"id": 710100302,
					"content": "Monster sind böse! Sie verdienen es, gnadenlos abgeschlachtet zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100303
					],
					"speakerTitle": "Ruinenschatz"
				}
			]
		},
