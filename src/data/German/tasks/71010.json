	"talks": [
		{
			"id": 7101001,
			"completionStepIds": [
				7101004,
				7101005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101001",
							"2"
						],
						"stepId": 7101001,
