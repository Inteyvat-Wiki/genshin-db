				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745230401,
					"content": "#In dem Wind liegt der salzige Duft des Meeres, der Holzduft der fernen Handelsschiffe und ... der Atem {F#einer alten Freundin}{M#eines alten Freundes}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230402
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230402,
					"content": "#{NICKNAME}, schön, dich wiederzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230403,
						745230404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230403,
					"content": "Kazuha, lange nicht gesehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				},
				{
					"id": 745230405,
					"content": "Die „Crux“-Flotte legt in Inazuma an, um Vorräte aufzufüllen. Da ich nur selten meine alte Heimat wiedersehe, will ich ein wenig spazieren gehen, die Landschaft noch einmal anschauen und dem Wind zuhören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230406
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230406,
					"content": "Der Wind in Ritou ist immer lauter als anderswo, vermischt mit Abschied und Wiedersehen, mit Hoffnung und Verwirrung ... Dies ist ein Ort, an dem man viele Geschichten hören kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230407,
						745230408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230407,
					"content": "Darf ich ein Foto von dir machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230409,
					"content": "Hehe, alles hat seine Form, auch der Wind. Doch seine Gestalt zeigt sich nur für einen flüchtigen Moment – wenn Blätter fallen, Wellen sich kräuseln oder die Gewänder eines Reisenden im Wind flattern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230410
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230410,
					"content": "Ich hoffe, dass du durch meine Gestalt einen flüchtigen Blick auf die „Form des Windes“ erhaschen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230411,
						745230412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230411,
					"content": "Also, dann fange ich an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230413,
					"content": "Dann sammle bitte die Verse, die diesem Moment gehören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230412,
					"content": "Spüre einfach den Wind, genau wie gerade eben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230408,
					"content": "Ich möchte auch den Wind in diesem Moment festhalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230404,
					"content": "Was bringt dich hierher?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				}
			]
		}
	]
}