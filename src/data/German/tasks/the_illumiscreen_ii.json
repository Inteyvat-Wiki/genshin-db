				"points": []
			},
			"dialogs": [
				{
					"id": 413580101,
					"content": "Probiere den Leuchtschirm aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580102
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580102,
					"content": "Wie? Diese Laternen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580103
					]
				},
				{
					"id": 413580103,
					"content": "Ah, du bist es. Du kommst gerade recht. Seit deinem letzten Besuch habe ich die Laternen ausgetauscht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580104
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580104,
					"content": "Probier es ruhig aus. Kannst es diesmal lösen? Es wird schwerer als beim letzten Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580105,
						413580108
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580105,
					"content": "Warum? Ist das Bild komplexer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580106
					]
				},
				{
					"id": 413580106,
					"content": "Nein, nein. Das Bild ist leicht zu erkennen, es besteht immer noch nur aus drei Teilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580107
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580107,
					"content": "Die Schwierigkeit liegt darin, wie du sie richtig rotierst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580112,
					"content": "Ah! Das heutige Bild stellt <color=#00E1FFFF>Mora</color> dar. Um zu sehen, wo der Schatz ist, muss das Bild stimmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580108,
					"content": "Ist es schwieriger, die Laternen zu drehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580109
					]
				},
				{
					"id": 413580109,
					"content": "Hehehe, diesmal sind die drei Laternen <color=#00E1FFFF>miteinander verbunden</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580110
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580110,
					"content": "Einfach ausgedrückt, drehst du eine Laterne, drehst du womöglich auch die andere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580111
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580111,
					"content": "Versuch es mal, dann wirst du schon sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580112
					],
					"speakerTitle": "Qian"
				}
			]
		},
