				{
					"id": 413580201,
					"content": "Wie lief die Schatzsuche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580202
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580202,
					"content": "Hab alle gefunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413580203
					]
				},
				{
					"id": 413580203,
					"content": "Alle? Du bist eine echte Schatzsucher-Koryphäe ... Viele haben schon beim ersten Versuch aufgegeben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413580204
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413580204,
					"content": "Da du alle Schätze gefunden hast ... nimm bitte deinen Preis entgegen. Frohes Laternenritual!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
