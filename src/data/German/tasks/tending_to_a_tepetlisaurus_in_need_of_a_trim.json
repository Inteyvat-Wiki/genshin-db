					"Cazcal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250212709,
					"content": "(Anstatt sich zu entspannen, schaut dich Hora verwirrt an.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212710
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212710,
					"content": "(Cazcal übernimmt rechtzeitig. Nach einem weiteren Versuch der sorgfältigen Pflege gelingt es ihm schließlich, Horas Klauen zu schneiden ...)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212701
					]
				},
				{
					"id": 250212701,
					"content": "#Schon gut, manchmal täusche ich mich auch bei Hora. Aber er weiß ganz sicher, dass du {M#ein guter Freund} {F#eine gute Freundin} bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212702
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212702,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212703
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212703,
					"content": "Hahaha, siehst du, was hab ich dir gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212704
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212704,
					"content": "Nochmals danke. Das hier ist für dich, als Zeichen meiner Wertschätzung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212705
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212705,
					"content": "Kleine Saurier sind echt schwer zu durchschauen, und erst nachdem ich viel Zeit mit Hora verbracht hatte, konnte ich das meiste erraten, was in seinem kleinen Oberstübchen da vor sich geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212706
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212706,
					"content": "Aber das ist schon in Ordnung. Schließlich werden wir beide eine lange Zeit zusammen sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212707
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212707,
					"content": "Hä? Wo ist Hora denn hin? Er hat doch nicht schon wieder Reißaus genommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212708
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212708,
					"content": "Hora! Horaaaaaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
