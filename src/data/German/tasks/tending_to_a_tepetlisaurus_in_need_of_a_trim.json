				"points": []
			},
			"dialogs": [
				{
					"id": 250213701,
					"content": "(Hora schüttelt den Kopf, kratzt sich am Bauch und sieht dich verwirrt an.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213702
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250213702,
					"content": "Du kannst nicht die ganze Zeit nur mit Hora spielen. Wir haben hier noch eine Menge zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213703
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213703,
					"content": "Ähem! Komm, ich zeige dir, wie man ihn richtig badet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213704
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213704,
					"content": "(Cazcal übernimmt rechtzeitig. Nach einem weiteren Versuch der sorgfältigen Pflege gelingt es ihm schließlich, Horas Klauen zu schneiden ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213705
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250213705,
					"content": "Du kannst nicht nur mit ihm spielen, wir müssen erst die Arbeit erledigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213706
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213706,
					"content": "*brüll*! *brüüüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213707
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250213707,
					"content": "Hahah, es sieht so aus, als ob Hora dich doch mag. Kein Wunder, dass er dieses Mal so gehorsam war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213708
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213708,
					"content": "Jedenfalls vielen Dank für die Hilfe. Das hier ist für dich, als Zeichen meiner Wertschätzung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213709
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213709,
					"content": "Hmm ... Vielleicht sollte ich das nächste Mal auch versuchen, erstmal mit Hora zu spielen, bevor ich ihn wasche ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213710
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213710,
					"content": "Hora, was denkst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213711
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213711,
					"content": "Hä? Wo ist Hora denn hin? Er hat doch nicht schon wieder Reißaus genommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213712
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213712,
					"content": "Hora! Horaaaaaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
