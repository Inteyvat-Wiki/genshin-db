			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cazcal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250212609,
					"content": "(Nach und nach entspannt sich Hora. Er streckt seinen ganzen Körper und fährt seine Klauen aus. Es scheint so, als wäre es an der Zeit, seine Klauen zu schneiden.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212610
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212610,
					"content": "Unter Cazcals Anleitung schneidest du akribisch Horas Klauen.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212601
					]
				},
				{
					"id": 250212601,
					"content": "Hahaha, wer hätte das gedacht, du bist ja ein Naturtalent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212602
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212602,
					"content": "*brüüüllll*! *brüll*! *brüüüllll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212603
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212603,
					"content": "Hora bedankt sich auch bei dir. Du hast ihn so sorgfältig zurechtgemacht, dass er jetzt sicher noch schneller graben kann, wenn er sich in die Erde wühlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212604
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212604,
					"content": "Das ist für dich, als Zeichen meiner Dankbarkeit. Ähm ... übrigens möchte ich dich warnen: Wenn du dich danach um andere kleine Saurier kümmern solltest, darfst du die heutige Methode nicht einfach so kopieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212605
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212605,
					"content": "Jeder kleine Saurier hat seinen ganz eigenen Charakter und so verhält es sich auch mit der Methode, wie man sie pflegt. Bis jetzt habe ich nur herausgefunden, wie ich mich um Hora kümmern kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212606
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212606,
					"content": "Aber ich bin zufrieden damit, wenigstens das geschafft zu haben. Schließlich werden wir beide für eine lange Zeit zusammen sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212607
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212607,
					"content": "Hä? Wo ist Hora denn hin? Er hat doch nicht schon wieder Reißaus genommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212608
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212608,
					"content": "Hora! Horaaaaaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
