			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cazcal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250210101,
					"content": "Dass du mir dieses Mal nicht wieder abhaust, Hora, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210102,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210103
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210103,
					"content": "Oh, Hora ist heute richtig brav!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210104
					]
				},
				{
					"id": 250210104,
					"content": "Und wie! Und alles dank deiner Hilfe mit dem „Schwimmball“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210105
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210105,
					"content": "Mit ihm kann ich ihn dazu bringen, alle möglichen Dinge zu tun. Ob Baden, Fressen, Schlafen oder Training; das wird alles so viel einfacher machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210106
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210106,
					"content": "Ganz zu schweigen, vom Klauen schneiden! Früher war ich schon immer völlig fertig, wenn ich ihn mir nur für all das schnappen wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210107
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210107,
					"content": "Jetzt muss ich ihm nur den Ball vor die Nase halten und er setzt sich brav hin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210108,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210109
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210109,
					"content": "#Hora, weißt du noch, wer das ist? {M#Er}{F#Sie} hat mir dabei geholfen, dein Spielzeug zu bauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210110,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210111,
						250210112
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210111,
					"content": "Ja, wer ist ein guter Junge? Ja, du!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				},
				{
					"id": 250210113,
					"content": "Oh! Hora erinnert sich an dich! Und wie er sich freut, dich zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210114,
					"content": "Willst du mal versuchen, ihm die Klauen zu schneiden? Poliere ihm am besten währenddessen auch sein Horn blank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210115
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210115,
					"content": "Das ist wichtig für kleine Tepetlisaurier, schließlich müssen sie sich in den Felsen und in die Erde graben, daher müssen ihre Klauen von Zeit zu Zeit geschärft werden. Und falls sie verwachsen sind, oder abgebrochen, sollte man sie nachschneiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210116,
					"content": "Nur so kann sichergestellt werden, dass kleine Tepetlisaurier ein perfektes Paar Klauen entwickeln, wenn sie erwachsen sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210117,
					"content": "Hier, nimm das! Lass uns gleich mal die Gelegenheit nutzen, um seine Klauen zu schneiden und Hora einmal wieder richtig hübsch zu machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210118,
						250210119
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210118,
					"content": "Du bist ja ziemlich präzise!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210120,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210121
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210121,
					"content": "*hust* ... Es kommt nicht oft vor, dass Hora so brav ist. Ich bin einfach froh, dass ich ihn heute mal nicht durch den ganzen Klan jagen muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210122
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210122,
					"content": "Klingt ziemlich anstrengend ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210123
					]
				},
				{
					"id": 250210123,
					"content": "Ach was! Also gut, dann lass uns mal anfangen, ich bin dabei, und sage dir, was zu tun ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210124,
					"content": "Damit Hora sich entspannt, solltest du ihm zunächst mit einer großen Bürste sanft den Rücken schrubben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210130
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210130,
					"content": "Anschließend säuberst du sein Horn mit der Bürste mit den feinen Borsten. Diesmal mit etwas mehr Kraft, sonst entgeht dir der Schmutz in den Ritzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210125,
					"content": "Dann schnappst du dir ein Handtuch und rubbelst ihm den ganzen Körper ab ... so entspannt er sich. So wird er auch ganz von selbst seine Klauen ausfahren. Dann können wir sie schneiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210126,
						250210127
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210126,
					"content": "Wieder mal sehr detailliert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210128,
					"content": "Ja, na klar. Ich habe ihn schließlich auch großgezogen. Im ganzen Stamm ... nein, in ganz Natlan gibt es niemanden, der ihn besser kennt als ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210129
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210129,
					"content": "Also gut, schneide jetzt einfach Horas Klauen, so wie ich es dir gesagt habe. Ich bin direkt neben dir. Ansonsten frag mich einfach, wenn du dir bei etwas unsicher bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210127,
					"content": "Du kennst Hora echt gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210119,
					"content": "Warum bist du denn plötzlich so aufgeregt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210112,
					"content": "(Hora streicheln)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				}
			]
		},
