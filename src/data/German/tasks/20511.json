			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205110101,
					"content": "Wird dieses Rezept wirklich funktionieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110103
					]
				},
				{
					"id": 205110103,
					"content": "Reisender! Du kommst gerade recht. Mir geht es im Moment nicht so gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110104,
					"content": "Es ist so: Erinnerst du dich an meine jüngere Schwester Anna? Sie war immer kränklich und nichts konnte sie heilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110105,
					"content": "Aber ich habe gehört, dass es im Hafen von Liyue einen unglaublichen Arzt geben soll, der besonders gut darin ist, das Unheilbare zu heilen. Daher habe ich jemanden gefragt, mir zu helfen, ein Rezept von ihm zu beschaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110106,
					"content": "Die Zutaten sind alle sehr ungewöhnlich ... aber ich vermute, ich kann nichts tun, als es zu probieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110107,
					"content": "Hmm, lass mich mal sehen ... Könntest du mir helfen, eine von einem Dendro-Schleim geschluckte Beere zu finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110108,
						205110112,
						205110116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110108,
					"content": "So etwas gibt es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110109
					]
				},
				{
					"id": 205110109,
					"content": "Ich habe auch keine Ahnung! Essen Dendro-Schleime wirklich Beeren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110110,
					"content": "Ich zähle jedenfalls auf dich! Ich kennen einen Ort, an dem sowohl Schleime als auch Beeren gefunden werden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110111,
					"content": "Bitte hilf mir zu suchen. Ich hoffe, du wirst sie finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110112,
					"content": "Dieser Arzt ist ein Quacksalber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110113
					]
				},
				{
					"id": 205110113,
					"content": "Du denkst also auch so, oder? Aber mir bleibt keine andere Wahl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110114,
					"content": "Ich kenne einen Ort, an dem du sowohl Schleime als auch Beeren finden kannst. Könntest du bitte dort hingehen und für mich suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110115,
					"content": "Ich probiere die Medizin, wie wir herstellen, als Erster. Egal, was passiert, ich kann Annas Zustand nicht noch schlechter werden lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110116,
					"content": "Ich könnte einfach einen Dendro-Schleim für dich einfangen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110117
					]
				},
				{
					"id": 205110117,
					"content": "Ähm ... Was? Erzählst du mir, ich soll die Beere selbst direkt in den Mund des Dendro-Schleims stecken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110118,
					"content": "Verschone mich, bitte! Das letzte Mal als ich Kräuter für Annas Medizin gepflückt habe, hat mich eine Gruppe Dendro-Schleime den ganzen Weg nach Quellingen gejagt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110119,
					"content": "Ich kenne einen Ort, an dem du sowohl Schleime als auch Beeren finden kannst. Geh bitte dort hin und suche für mich? Ich hoffe, du findest etwas ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110120,
					"content": "Aber ... falls du wirklich nichts finden kannst, dann für Anna ... F... fang einfach einen Dendro-Schleim und bringe ihn hierher zurück. Ich kann es tun. Ich ... Ich werde es tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
