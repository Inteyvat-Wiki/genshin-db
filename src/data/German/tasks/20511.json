				{
					"id": 205110401,
					"content": "Habt ihr die Sachen gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110402
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110402,
					"content": "Ja, habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110403
					]
				},
				{
					"id": 205110403,
					"content": "Ist es das? Es sieht wirklich nicht anders aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110404
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110404,
					"content": "Egal, wie man darauf schaut, es ist nur eine einfache Beere ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110405
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110405,
					"content": "Vergiss es. Da es sich um Anweisungen des Arztes handelt, sollten wir dem Rezept bis auf den letzten Buchstaben folgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110406
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110406,
					"content": "Danke. Dies ist für deine Mühen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110407
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110407,
					"content": "Ich muss dich in Zukunft vielleicht noch einmal stören. Wenn das geschieht, lehne bitte nicht ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
