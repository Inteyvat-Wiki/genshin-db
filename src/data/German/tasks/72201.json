			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rero"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010201,
					"content": "Haha! Du schweifst ab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010202
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010202,
					"content": "Hahah, ich muss Tränen lachen! Oh, Chikapu, wenn du nur hier sein könntest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010203,
						722010204
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010203,
					"content": "Ich bin ein bisschen böse!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				},
				{
					"id": 722010205,
					"content": "Hahaha, tut mir leid. Es ist so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010206
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010206,
					"content": "Meine Frau und ich haben den Leuten ständig Streiche gespielt und es gab nie eine Wiederholung, es hat uns allen Spaß gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010207
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010207,
					"content": "Später wurde sie sehr krank und starb früh ... Damals sagte sie mir, dass an ihrem Grab ein ehrlicher Mann stehen solle, sonst würde ihr Geist nicht gehen können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010208
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010208,
					"content": "Um ihren Wunsch zu erfüllen ... Was sagt ihr? Ich habe mich doch ganz gut geschlagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010209,
						722010210,
						722010211
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010209,
					"content": "Dieser Witz ist sehr langweilig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010212,
					"content": "Ah, Außenstehende sind so langweilig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010213
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010213,
					"content": "Sogar der Trick mit dem spritzenden Maulwurf, den du nicht sehen willst ... wie langweilig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010214
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010214,
					"content": "Auf Wiedersehen, ich gehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010210,
					"content": "Menschen können getötet werden!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010211,
					"content": "Ich werde deinem Unsinn nicht mehr vertrauen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010204,
					"content": "Kannst du mir sagen was los ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				}
			]
		},
