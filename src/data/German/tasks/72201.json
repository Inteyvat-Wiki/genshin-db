				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rero"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010101,
					"content": "Ach ... Passanten ... bitte habt Mitleid mit mir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010102,
						722010103
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010102,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				},
				{
					"id": 722010104,
					"content": "Danke, dass du bereit bist, einen alten Mann anzuhören ... *seufz* ... Komm her, komm her, hör mir zu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010105
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010105,
					"content": "Ich hatte noch nie einen Tag Glück in meinem Leben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010106
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010106,
					"content": "Als ich geboren wurde, warf die Priesterin, die die Geburtszeremonie durchführte, versehentlich die Öllampe um und verbrannte das lange Haar meiner Tante ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010107
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010107,
					"content": "Oh, nein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010108
					]
				},
				{
					"id": 722010108,
					"content": "Dann litt ich an einer seltsamen Krankheit, durch die meine Glieder aus dem Gleichgewicht gerieten; dann wurde ich eines Tages aus der Wiege geschleudert und brach mir sechs Rippen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010109
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010109,
					"content": "Als ich etwas älter war, verschluckte sich mein Cousin eines Tages an einem Pilz und mein Vater schlug mir mit einer Schaufel auf den Kopf, während er ihn wiederbelebte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010110
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010110,
					"content": "Einmal wurde der geliebte kleine Fink von dem Wen Kamuy der Familie gefressen, welcher danach von einem blinden Wildschwein von einer Klippe gestürzt wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010111
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010111,
					"content": "Dann opferte das Mädchen, das ich liebte, versehentlich die Opfer der Priesterin dem Donnervogel und wurde von der Insel vertrieben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010112
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010112,
					"content": "Als ich aufwuchs, starb meine Großmutter, weil ich zu hässlich war, und dann starb mein Großvater mit ihr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010113
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010113,
					"content": "Dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010114
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010114,
					"content": "Die Familie ist ein gewisser Trost für dich, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010115
					]
				},
				{
					"id": 722010115,
					"content": "Ah ... apropos meine Familie ... Als ich volljährig wurde, sagte der Arzt, dass ich wahrscheinlich keine Kinder bekommen würde, weil mir ein ... Moment, ich zeige es euch...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010116,
						722010117
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010116,
					"content": "Nein! Das wird nicht nötig sein!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010118,
					"content": "Ah ... lasst mich noch einen Satz sagen ... das ist die letzte Hilfe, um die ich euch bitten will ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010119,
						722010120
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010119,
					"content": "Bitte sprich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010121,
					"content": "Vor einiger Zeit, als ich meine Frau beerdigte, ließ ich aus Versehen meinen Goldring ins Grab fallen und begrub ihn zusammen mit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010122
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010122,
					"content": "Es war mein letzter Besitz ... aber ich wage es nicht, ihn wieder auszugraben ... denn das würde ihren Geist beleidigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010123
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010123,
					"content": "Du willst also, dass ich ein Grab bestehle und es aushebe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010124
					]
				},
				{
					"id": 722010124,
					"content": "Du bist ein Außenstehender ... Da ist nichts Merkwürdiges dabei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010125
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010125,
					"content": "Nein, nein ... Ich meine, wenn es ein Außenstehender ist, wird er die örtlichen Geister nicht beleidigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010126
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010126,
					"content": "Geh zum Chirai-Schrein ... Ihr Grab ist direkt neben dem Schrein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010120,
					"content": "Nur bitte kein peinliches Thema ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010117,
					"content": "Schon verstanden!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010103,
					"content": "Brauchst du Hilfe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				}
			]
		},
		{
			"id": 7220102,
			"completionStepIds": [
