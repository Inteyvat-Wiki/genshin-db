			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Onkel Tian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718050501,
					"content": "Was kann ich für dich tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050502
					],
					"speakerTitle": "Onkel Tian"
				},
				{
					"id": 718050502,
					"content": "Hier ist deine Bestellung bei Jifang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050503
					]
				},
				{
					"id": 718050503,
					"content": "Wie jetzt? Oh, richtig. Ich habe in der Buchhandlung Wanwen ein Exemplar von „Schrift vom Gleichgewicht“ bestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050504
					],
					"speakerTitle": "Onkel Tian"
				},
				{
					"id": 718050504,
					"content": "Ganz recht, ganz recht, dieses Buch habe ich bestellt. Haha, und ich dachte, dass bei all den anderen Kunden Jifang meine Bestellung vergessen hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050505
					],
					"speakerTitle": "Onkel Tian"
				},
				{
					"id": 718050505,
					"content": "Aber jetzt ist es ja da. Es ist auch gut gebunden. Jifang ist immer so gewissenhaft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050506
					],
					"speakerTitle": "Onkel Tian"
				},
				{
					"id": 718050506,
					"content": "Danke dir. Ich nehme es dann mal an mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Onkel Tian"
				}
			]
		},
