					"Fürst De’an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718050401,
					"content": "Was gibt es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050402
					],
					"speakerTitle": "Fürst De’an"
				},
				{
					"id": 718050402,
					"content": "Hier ist deine Bestellung bei Jifang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050403
					]
				},
				{
					"id": 718050403,
					"content": "Der vierte Band der Rex Incognitus. Das ist eine Ewigkeit her. Warum hat das so lange gedauert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050404
					],
					"speakerTitle": "Fürst De’an"
				},
				{
					"id": 718050404,
					"content": "Mal sehen. Oh? Eine Erstausgabe? Kein Wunder, dass es so lange dauert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050405
					],
					"speakerTitle": "Fürst De’an"
				},
				{
					"id": 718050405,
					"content": "Und ich dachte, dass bei all den anderen Kunden Jifang meine Bestellung vergessen hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050406
					],
					"speakerTitle": "Fürst De’an"
				},
				{
					"id": 718050406,
					"content": "Danke, dass du mir dieses Buch gebracht hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fürst De’an"
				}
			]
		},
		{
			"id": 7180505,
