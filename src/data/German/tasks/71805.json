				{
					"id": 718050701,
					"content": "Was die beiden Bücher betrifft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050702
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050702,
					"content": "Die beiden gehören zu unseren ältesten Kunden. Für gewöhnlich kümmere ich mich rasch um ihre Bestellungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050703
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050703,
					"content": "Doch wegen der hohen Nachfrage habe ich dieses Mal ein wenig getrödelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050704
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718050704,
					"content": "Sie sind wohl ungeduldig geworden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jifang"
				}
			]
		},
