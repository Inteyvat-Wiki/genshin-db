			"dialogs": [
				{
					"id": 740840801,
					"content": "... Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840802
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840802,
					"content": "Pahsiv, was treibst du hier? Bring dich vor der Drachenechse in Sicherheit! Die ist gefährlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840803,
					"content": "Paimon gut, Pahsiv! Gefährlich, Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840804
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840804,
					"content": "Pahsiv streckt die Hand aus, um den Kopf der Drachenechse zu streicheln. Die aufgebrachte Drachenechse senkt gehorsam ihren Körper.\\nSie öffnet ihr Maul, um einen kristallklaren Wassertropfen auszuspucken. Dann dreht sie sich um und springt ins Wasser.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740840805
					]
				},
				{
					"id": 740840805,
					"content": "Der Schlüssel! Der Schlüssel war also im Maul der Drachenechse versteckt! Und sie hat von sich aus den Schlüssel herausgerückt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840806,
					"content": "Blau, gut Ding, Schlüssel, schützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840807
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840807,
					"content": "„Blau“? Meinst du damit die Drachenechse von gerade eben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740840808
					]
				},
				{
					"id": 740840808,
					"content": "Pahsiv, bist du mit der Drachenechse befreundet? Hilft sie dir, den Schlüssel zu bewachen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840809,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840810
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840810,
					"content": "Lila, Schlüssel rauben ... Blau, Bewusstsein weg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840811
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840811,
					"content": "Li... Lila? Wer ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840812,
					"content": "#Lila, böse Ding ... Blau, Paimon, {NICKNAME}, gut Ding!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840813
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840813,
					"content": "Ähm ... In Ordnung. Obwohl wir heraushören können, dass du uns lobst, klingt es doch ein bisschen komisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840814,
					"content": "Lila, sehr böse. Erinnyes, sehr Melusine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840815
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840815,
					"content": "Willst du damit sagen ... Dieses lila Ding bedroht die Insel? Nur gut, dass der Schlüssel jetzt in unseren Händen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840816,
					"content": "#Paimon, {NICKNAME}, Pahsiv! Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840817
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840817,
					"content": "Schlüssel, Schlüssel, Schlüssel, Platz, West ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840818
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740840818,
					"content": "Verstanden, Pahsiv, immer mit der Ruhe. Wir gehen jetzt zu dem Platz im Westen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
