					}
				]
			},
			"dialogs": [
				{
					"id": 740841201,
					"content": "... Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841202
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841202,
					"content": "Pahsiv? Wo kommst du denn her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841203,
					"content": "Keine Spur, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841204
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841204,
					"content": "Ach, das ist jetzt nicht wichtig! Bring dich schnell vor der Drachenechse in Sicherheit! Die ist gefährlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841205,
					"content": "Paimon gut, Pahsiv! Gefährlich, Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841206
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841206,
					"content": "Pahsiv streckt die Hand aus, um den Kopf der Drachenechse zu streicheln. Die aufgebrachte Drachenechse senkt gehorsam ihren Körper.\\nSie öffnet ihr Maul, um einen kristallklaren Wassertropfen auszuspucken. Dann dreht sie sich um und springt ins Wasser.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740841207
					]
				},
				{
					"id": 740841207,
					"content": "Schlüssel, Schlüssel, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841208
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841208,
					"content": "Unglaublich! Die Drachenechse hat von sich aus den Schlüssel herausgerückt? Paimon hat wirklich nicht erwartet, dass sie auf dich hört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841209,
					"content": "Blau, gut Ding, Schlüssel, schützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841210
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841210,
					"content": "„Blau“? Meinst du damit die Drachenechse von gerade eben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841211
					]
				},
				{
					"id": 740841211,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841212
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841212,
					"content": "Hat sie dir geholfen, auf den Schlüssel aufzupassen? Bist du mit der Drachenechse befreundet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841213,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841214
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841214,
					"content": "Lila, Schlüssel rauben ... Blau, Bewusstsein weg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841215
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841215,
					"content": "Li... Lila? Wer ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841216,
					"content": "#Lila, böse Ding ... Blau, Paimon, {NICKNAME}, gut Ding!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841217
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841217,
					"content": "Ähm ... In Ordnung. Obwohl wir heraushören können, dass du uns lobst, klingt es doch ein bisschen komisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841218,
					"content": "Lila, sehr böse. Erinnyes, sehr Melusine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841219
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841219,
					"content": "Nun gut ... Paimon hat wirklich noch nie eine so besondere Melusine wie dich gesehen ... Und Paimon dachte, dass alle Melusinen am Hof von Fontaine oder in Mérusea leben. Wie kommt es, dass du allein hier bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841220,
					"content": "Hof von Fontaine? Mérusea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841221
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841221,
					"content": "Du scheinst ziemlich verwirrt zu sein. Hast du diese beiden Namen noch nie gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841222,
					"content": "Hof von Fontaine, Melusine ... Mérusea, Melusine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841223
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841223,
					"content": "Äh ... Erinnyes, Pahsiv, Zuhause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841224
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841224,
					"content": "Erinnyes, Pahsiv, schützen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841225
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841225,
					"content": "Warte mal. Hast du gerade gesagt, dass dies dein Zuhause ist und du es beschützt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841226,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841227
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841227,
					"content": "Aber kommen nicht alle Melusinen aus Mérusea?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841228
					]
				},
				{
					"id": 740841228,
					"content": "Genau! Seltsam ... Es gibt noch Melusinen, die an einem anderen Ort geboren wurden? Aber es gibt hier anscheinend keine anderen Melusinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841229,
					"content": "Pahsiv, lebst du hier ganz alleine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841230,
					"content": "Alleine? Melusine. Nur wie nett! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841231
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841231,
					"content": "Nur ... wie nett? Wen meinst du damit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841232,
					"content": "#Nur wie nett! Paimon, Paimon. {NICKNAME}, {NICKNAME}. Nur wie nett, nur wie nett!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841233
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841233,
					"content": "Und wer ist das genau?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841234
					]
				},
				{
					"id": 740841234,
					"content": "Pahsiv, meinst du, dass der Name dieser Person einfach „nur wie nett“ ist, so wie Paimon Paimon heißt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841235,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841236
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841236,
					"content": "Aha! So ist das. Hehe, Paimon hat doch gesagt, dass Paimon auch sehr schlau ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841237,
						740841238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841237,
					"content": "Ein sehr seltsamer Name.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841239
					]
				},
				{
					"id": 740841238,
					"content": "Ein sehr netter Name.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841239
					]
				},
				{
					"id": 740841239,
					"content": "Nur wie nett, Pahsiv, Wissen, hellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841240
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841240,
					"content": "Hmm ... Willst du sagen, dass diese nette Person dir hilft, Dinge zu lernen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841241,
					"content": "Pahsiv! Sehr viel. Sprache, Wissen ... Sehr, sehr viel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841242
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841242,
					"content": "Ähm ... Irgendwie hat Paimon das Gefühl, dass es doch nicht so viel ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841243,
					"content": "Pahsiv, nur wie nett, schützen, hellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841244
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841244,
					"content": "Diese Person hilft dir auch, diesen Ort zu schützen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841245,
					"content": "Melusine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841246
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841246,
					"content": "Du hilfst ihr, diesen Ort zu beschützen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841247
					]
				},
				{
					"id": 740841247,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841248
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841248,
					"content": "So ist das also ... Wer ist diese Person eigentlich? Weshalb braucht sie deine Hilfe, um diesen Ort zu beschützen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841249,
					"content": "Zudem haben sich hier wirklich einige üble Dinge ereignet. Die Texte von der Steinplatte, die wir gesehen haben, wurden von jemandem weggekratzt. Und es gibt auch eine Menge Unreinheiten ... Ist das lila Ding für all das verantwortlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740841250,
					"content": "Paimon neugierig, Pahsiv! Aber Zeit, sehr, sehr wenig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841251
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841251,
					"content": "Schlüssel, Schlüssel, Schlüssel, Platz, West. Hellen, hellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841252
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740841252,
					"content": "Wir werden uns beeilen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740841253
					]
				},
				{
					"id": 740841253,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740841254
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831040,
					"content": "Pahsiv macht zwei Sprünge vor Freude in die Luft und geht etwas in Eile davon.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740831041
					]
				},
				{
					"id": 740841255,
					"content": "Anscheinend drängt wirklich die Zeit. Glücklicherweise haben wir bereits zwei Schlüssel. Lass uns mit Volldampf den dritten Schlüssel besorgen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}