			"dialogs": [
				{
					"id": 740840605,
					"content": "Schau! Neben dem Altar befindet sich eine Drachenechse! Ist sie eingeschlafen? Wir sollten auf der Hut sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840601,
					"content": "Huh? Wieso ... Wieso gibt es hier keinen Schlüssel? Könnte dieser Altar bereits aktiviert worden sein? Könnte jemand anderes den Schlüssel genommen haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840602,
					"content": "*brüll*!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840603
					],
					"speakerTitle": "Schlummernde Drachenechse"
				},
				{
					"id": 740840603,
					"content": "Oh nein! Die Drachenechse ist aufgewacht! Wir sollten uns schnell aus dem Staub machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840604,
					"content": "Die Drachenechse neben dem Altar ist mit einem Rütteln erwacht. Beide Augen sind voller Zorn und Heimtücke ...\\nIhr schwimmt eilig zum Ufer ... aber die Drachenechse ist euch unerbittlich auf den Fersen ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
