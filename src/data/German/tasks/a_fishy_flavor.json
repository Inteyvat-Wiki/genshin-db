					"„Neko“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220420101,
					"content": "Was für ein ungehorsamer Haufen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420102
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220420102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420103
					]
				},
				{
					"id": 220420103,
					"content": "Ihr seid es, die Kleinen sind wieder zum Spielen rausgegangen, sie laufen wirklich wild herum ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420104,
						220420105
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220420104,
					"content": "Kann ich irgendwo helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				},
				{
					"id": 220420106,
					"content": "Mit diesen Eisenkugeln, die vor dem Schrein hängen, sollten die kleinen Kerle wissen, wie sie zurückkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420107
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220420107,
					"content": "Es ist gut, draußen zu sein und zu spielen, damit sie, wenn die Menschen zum Schrein kommen, nicht vor ihnen verrückt spielen und die Regeln des Schreins missachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420108
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220420108,
					"content": "Aber es ist nicht gut, wenn sie es übertreiben ... von der Zeit, in der die Sonne noch am Himmel steht, bis der Mond sie erreicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420109
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220420109,
					"content": "Helft mir bitte, ihnen die Fische zu geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420110,
						220420113
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220420110,
					"content": "Alles klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420111
					]
				},
				{
					"id": 220420111,
					"content": "Gib Neko die Karte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220420112,
					"content": "Ihr kennt euch doch ein wenig aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220420115,
					"content": "Gut, geht, ich muss mich noch um den Schrein kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220420113,
					"content": "Das ist die Karte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420114
					]
				},
				{
					"id": 220420114,
					"content": "Ihr kennt euch doch ein wenig aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220420105,
					"content": "Soll ich sie holen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				}
			]
		},
