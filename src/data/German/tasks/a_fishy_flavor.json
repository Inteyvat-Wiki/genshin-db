			},
			"dialogs": [
				{
					"id": 220420301,
					"content": "Habt ihr sie gefüttert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420302
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220420302,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420303
					]
				},
				{
					"id": 220420303,
					"content": "Das ist gut, danke, sonst hätten die Kleinen wieder wie verrückt gespielt und wären dann in der Wildnis verhungert, danke für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420304
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220420304,
					"content": "Was für ein Haufen ungehorsamer kleiner Kerle. Wie können sie die Menschen, die zum Schrein kommen, dann empfangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		},
