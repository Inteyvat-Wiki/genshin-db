				"points": []
			},
			"dialogs": [
				{
					"id": 220420401,
					"content": "Ihr seid zurück. Gut. Die Kleinen sind auch alle zurück. Irgendwie sehen sie beängstigt aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420402
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220420402,
					"content": "Haben sie etwa böse Menschen draußen getroffen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420403
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220420403,
					"content": "Na ja, immerhin sind sie wieder da. Was ist mit dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420404
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220420404,
					"content": "Na ja, ich, ähm ... Eigentlich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420405
					]
				},
				{
					"id": 220420405,
					"content": "Was für ein schwer fassbares menschliches Wesen! Warum wolltest du das tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420406
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220420406,
					"content": "Wenn du mit ihnen spielen willst, tu es einfach auf die normale Weise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420407
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220420407,
					"content": "Miau! Kein Wunder, dass die Kleinen so verängstigt waren ... Ich muss sie trösten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420408
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220420408,
					"content": "Wirklich, man kann nicht erwarten, dass alle Menschen gleich sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		}
