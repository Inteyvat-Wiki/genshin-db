			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jifang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130201,
					"content": "Hallo. Möchtest du etwas kaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130202
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130202,
					"content": "Wir hätten gerne eine Ausgabe von „Die Juwelenmine“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130203
					]
				},
				{
					"id": 718130203,
					"content": "„Die Juwelenmine“? Das haben wir nicht auf Lager. Braucht ihr es schnell?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130204
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130204,
					"content": "Ja, wir bauen das Jadegemach wieder auf ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130205
					]
				},
				{
					"id": 718130205,
					"content": "Wirklich? Nun, das erfordert eine gute Vorbereitung, ja. Lass mich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130206
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130206,
					"content": "Vielleicht suchst du stattdessen nach Qingzhou. Er ist sehr belesen. Vielleicht weiß er, wo ein Exemplar von „Die Juwelenmine“ zu finden ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130207
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130207,
					"content": "Alles klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130208
					]
				},
				{
					"id": 718130208,
					"content": "Wenn ich mich recht erinnere, logiert Qingzhou oft im Gasthaus Wangshu. Du kannst versuchen, ihn dort zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jifang"
				}
			]
		},
		{
			"id": 7181303,
			"completionStepIds": [
				7181303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181303",
							"2"
						],
						"stepId": 7181303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130301,
					"content": "Rätselhaft. Sehr ärgerlich, wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130302
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130302,
					"content": "Also, äh, weißt du etwas über die „Die Juwelenmine“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130303
					]
				},
				{
					"id": 718130303,
					"content": "„Die Juwelenmine“ sagst du? Ja, ich erinnere mich an dieses Buch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130304
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130304,
					"content": "Ich habe mal überall nach Material gesucht, um ein Gedicht über Händler zu schreiben, und bin dabei auf dieses Buch gestoßen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130305,
					"content": "Ich verstand zwar den Inhalt des Buches nicht ganz, aber einige Anekdoten waren trotzdem sehr inspirierend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130306
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130306,
					"content": "Ich versuche, mich an den Namen dieses Gedichtes zu erinnern. Gib mir einen Moment Zeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130307
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130307,
					"content": "Weißt du vielleicht, wo ich das Buch finden kann?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130308
					]
				},
				{
					"id": 718130308,
					"content": "Ah, du willst also dieses Buch wiederfinden? Ich muss zugeben, dass ich mich nicht daran erinnere ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130309
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130309,
					"content": "Wenn du es aber unbedingt benötigst, könnte ich dir einfach selbst eine Kopie davon schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130310,
						718130311
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130310,
					"content": "Eine Kopie schreiben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				},
				{
					"id": 718130312,
					"content": "Ah, es war nicht wirklich ein langer Text. Ihn auswendig zu lernen, war nicht schwer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130313,
					"content": "Außerdem wollte der Büchersammler nicht, dass ich das Buch ausleihe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130314
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130314,
					"content": "Und da man Poesie nicht überstürzen darf, beschloss ich, einfach eine Kopie für meinen späteren Gebrauch zu schreiben ... Auch der Inhalt des Buches war nicht sehr lang, also habe ich es jetzt mehr oder minder auswendig gelernt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130315
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130315,
					"content": "Das ist eine äußerst beeindruckende Arbeit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130316
					]
				},
				{
					"id": 718130316,
					"content": "Ah, es ist nur eine Bagatelle. Trotzdem kannst du mir vielleicht einen Gefallen tun, im Tausch gegen den handgeschriebenen Text.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130317
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130317,
					"content": "So beschämend das auch ist ... Ich war so darauf konzentriert, hier Inspiration zu finden, dass ich es jetzt erst merke: Ich vergaß heute völlig, etwas zu essen. Plötzlich fühle ich mich so hungrig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130318
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130318,
					"content": "Kannst du mir helfen, eine Portion Gestreiftes Dreierlei zu bekommen? Im Tausch schreibe ich dir ein Exemplar von „Die Juwelenmine“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130319
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130319,
					"content": "Ich glaube, dass ich bis zu deiner Rückkehr so gut wie fertig sein werde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130311,
					"content": "Aus dem Gedächtnis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				}
			]
		},
		{
			"id": 7181304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
