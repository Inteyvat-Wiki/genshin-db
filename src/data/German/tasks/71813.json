					"Baiwen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130801,
					"content": "Hallo, kann ich dir helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130802
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130802,
					"content": "Also, wegen der Vorbereitungen, die du getroffen hast ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130803
					]
				},
				{
					"id": 718130803,
					"content": "Ist dies ...„Die Juwelenmine“? Wo hast du dieses Buch her? Ich habe in ganz Liyue gesucht, aber ich konnte es trotzdem nicht finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130804
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130804,
					"content": "Qingzhou hat eine Abschrift für mich geschrieben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130805
					]
				},
				{
					"id": 718130805,
					"content": "Dieser Dichter? Hmm, sein Ruf scheint ihm gerecht zu werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130806
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130806,
					"content": "Danke für deine Hilfe bei der Vorbereitung dieser Objekte. Sobald Meister Lu diese Ornamente schickt, sorge ich auch dafür, dass er eine entsprechende Bezahlung erhält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130807
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130807,
					"content": "Ihr baut also das Jadegemach wirklich wieder auf, ja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130808
					]
				},
				{
					"id": 718130808,
					"content": "In der Tat haben wir Pläne, das zu tun. Aber bei der Vielzahl der Dinge, die wir vorbereiten müssen, bleibt noch einiges zu tun. Ich zweifle, dass wir den Wiederaufbau schnell abschließen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130809
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130809,
					"content": "Nicht zuletzt unsere größten materiellen Sorgen, für die wir noch keine Lösung gefunden haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130810
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130810,
					"content": "Egal, ich werde nicht erst davon anfangen. Danke noch einmal für deine Hilfe und bitte, nimm diese für deine Hilfe entgegen. Wenn du mich jetzt entschuldigen würdest, ich muss zu meiner Arbeit zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baiwen"
				}
			]
		},
