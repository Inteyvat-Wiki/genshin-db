				"objectNames": [
					"Meister Lu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130701,
					"content": "Hast du die Waldschweine vertrieben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130702
					],
					"speakerTitle": "Meister Lu"
				},
				{
					"id": 718130702,
					"content": "Ja, alle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130703
					]
				},
				{
					"id": 718130703,
					"content": "Das wird reichen. Ich werde nachher hinübergehen, um Bambus zu sammeln. Sobald die Ornamente bereit sind, werde ich sie direkt zum Yuehai-Pavillon bringen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130704
					],
					"speakerTitle": "Meister Lu"
				},
				{
					"id": 718130704,
					"content": "Diese Bestellung ist ziemlich umfangreich. Hier lässt sich eine ziemliche Summe verdienen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Meister Lu"
				}
			]
		},
		{
			"id": 7181308,
			"completionStepIds": [
