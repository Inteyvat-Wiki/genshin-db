					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130401,
					"content": "„Die Juwelenmine“, wie fing es an ... Ah ja, „Handel und Gewerbe, wie Quellen und die Bäche, beginnen mit den Bergen und enden mit dem Meer ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 7181305,
			"completionStepIds": [
				7181305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181305",
							"2"
						],
						"stepId": 7181305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130501,
					"content": "„Dieser große Plan gibt vor den Kurs, der langsam, aber sicher, zu Liyues langem Leben und dem Wohlstand der Menschen führen wird.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130502
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130502,
					"content": "Ah, du bist wieder da. Einen Moment, ich schreibe noch die letzten Zeilen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130503
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130503,
					"content": "Hmm ... Ja. Das ist es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130504
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130504,
					"content": "Hier ist dein Gestreiftes Dreierlei ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130505
					]
				},
				{
					"id": 718130505,
					"content": "Ah! Aber das kann warten, erst musst du sehen, ob das Buch zu deiner Zufriedenheit ist. Ich vertraue darauf, dass du meine Schriftkunst recht zufriedenstellend finden wirst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130506
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130506,
					"content": "Das ist eine schwer beeindruckende Arbeit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130507
					]
				},
				{
					"id": 718130507,
					"content": "Hahaha, du lobst mich übermäßig! Dieses Buch gehört dir. Verliere es jetzt nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 7181306,
			"completionStepIds": [
				7181306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181306",
							"2"
						],
						"stepId": 7181306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Meister Lu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130601,
					"content": "Hmm? Brauchst du irgendwas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130602
					],
					"speakerTitle": "Meister Lu"
				},
				{
					"id": 718130602,
					"content": "Ich würde gern ein paar kleine Ornamente aus Bambus bestellen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130603
					]
				},
				{
					"id": 718130603,
					"content": "Kleine Bambusornamente, sagst du? Ich könnte mich schon darum kümmern, aber darf ich wissen, woher dieser Auftrag kommt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130604
					],
					"speakerTitle": "Meister Lu"
				},
				{
					"id": 718130604,
					"content": "Das ist von Baiwens Prüfliste ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130605
					]
				},
				{
					"id": 718130605,
					"content": "Oho ... ein Auftrag vom Yuehai-Pavillon, nicht wahr? Nun denn, ich nehme an, ich sollte ihn dann so schnell wie möglich ausführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130606
					],
					"speakerTitle": "Meister Lu"
				},
				{
					"id": 718130606,
					"content": "Es gibt allerdings ein Problem: Der Bambuswald, aus dem ich oft Material sammle, wurde plötzlich von zahlreichen Waldschweinen überrannt. Niemand weiß, warum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130607
					],
					"speakerTitle": "Meister Lu"
				},
				{
					"id": 718130607,
					"content": "Es ist zwar kein großes Problem, aber ich muss oft um sie herumgehen, um Bambus zu sammeln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130608
					],
					"speakerTitle": "Meister Lu"
				},
				{
					"id": 718130608,
					"content": "Wenn du diese Waldschweine vertreiben könntest, kann ich sofort etwas Bambus sammeln gehen und wir können gleich mit der Arbeit beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130609
					],
					"speakerTitle": "Meister Lu"
				},
				{
					"id": 718130609,
					"content": "Das werde ich machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130610
					]
				},
				{
					"id": 718130610,
					"content": "Ich werde dann hier auf dich warten. Wenn du die Waldschweine verjagt hast, komm zurück und sag mir Bescheid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Meister Lu"
				}
			]
		},
		{
			"id": 7181307,
			"completionStepIds": [
				7181310
			],
