			"dialogs": [
				{
					"id": 742080301,
					"content": "Über den mysteriösen xenochromatischen Kristall ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742080302
					]
				},
				{
					"id": 742080302,
					"content": "Die Regeln lauten wie immer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080303
					],
					"speakerTitle": "Pitot"
				},
				{
					"id": 742080303,
					"content": "Sehr gut. Nichtsdestoweniger glaube ich nicht, dass wir danach noch einmal die Gelegenheit zu solch angenehmen Transaktionen haben werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080304
					],
					"speakerTitle": "Pitot"
				},
				{
					"id": 742080304,
					"content": "Mysteriöses ist vor allem deshalb mysteriös, weil es selten ist. Ich hatte auch schon vorher bereits mysteriöse xenochromatische Kristalle von einem Abenteurer erworben, allerdings nur dreimal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080305
					],
					"speakerTitle": "Pitot"
				},
				{
					"id": 742080305,
					"content": "Ihm zufolge hat er danach nie wieder welche gefunden. Vielleicht enthalten sie ja etwas, was wir über die Wunder der Natur nicht wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742080306
					],
					"speakerTitle": "Pitot"
				},
				{
					"id": 742080306,
					"content": "Wenn du mich fragst, sollten einige Geheimnisse dieser Welt im Verborgenen bleiben, denkst du nicht auch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pitot"
				}
			]
		}
