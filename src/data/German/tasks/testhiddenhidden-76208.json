			"dialogs": [
				{
					"id": 762080101,
					"content": "Hm? Es sieht aus, als würde sich ringsherum ein durchsichtiger Vorhang heben ... Kommt der von dem Baumstamm dort?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080102,
					"content": "Es ist, als würde er Harz ausspeien und diesen Ort in einen Bernstein verwandeln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080103,
					"content": "Dann wären wir die kleinen Insekten im Bernstein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762080104
					]
				},
				{
					"id": 762080104,
					"content": "Ein Bernstein mit dir und Paimon drin – der wäre bestimmt das Highlight jeder Auktion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080105,
					"content": "Und was wäre dann das krönende Stück?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762080106
					]
				},
				{
					"id": 762080106,
					"content": "Na, dieser Baum natürlich! Schließlich ist der Bernstein aus ihm entstanden. Schade, dass man ihn anscheinend nicht mitnehmen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080107,
					"content": "Ob es hier in der Nähe wohl Hinweise darauf gibt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
