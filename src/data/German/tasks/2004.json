					"Paimon",
					"Tejima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040101,
					"content": "Also, wo ist die Person, von der Ayaka sprach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040102,
					"content": "Was soll das? Warum nach all diesen Jahren der plötzliche Aufbruch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040103
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040103,
					"content": "Ganz genau, das kommt viel zu plötzlich. Wir konnten uns nicht vorbereiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040104
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040104,
					"content": "Die Kinder wollen unbedingt mit dir spielen ... Bitte, überleg es dir noch einmal anders!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040105
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040105,
					"content": "Das muss der Typ sein, den Ayaka meinte. Gehen wir mal hin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200402,
			"completionStepIds": [
				200402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200402",
							"2"
						],
						"stepId": 200402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040201,
					"content": "Das scheint Tejimas Tagebuch zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040202,
					"content": "Mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040203,
					"content": "„Heute haben die Dorfbewohner und ich zusammen gerösteten Trockenfisch gemacht. Meiner war leicht angebrannt, also tat ich so, als sei es schwarzer Schlangenkopf.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040204,
					"content": "„Heute rettete ich ein Kind, das ins Wasser gefallen war. Als ich es aus dem Wasser zog, meinte es, sein bester Freund Banbu sei immer noch im Wasser. Ich suchte den ganzen Nachmittag im Wasser, bis ich erfuhr, dass Banbu sein Haustier ist, ein Krebs.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040205,
					"content": "„Heute ließ ich einen Drachen steigen. Die Leine riss, also rannte ich hinterher. Bald schwante mir, dass ich ihn nicht zurückbekomme, also setze ich mich hin und sah zu, wie er in der Ferne entschwand.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040206,
					"content": "Hmm ... Liest sich wie das Tagebuch eines Dorfbewohners ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040207,
					"content": "Wie? Warte ... Das ist noch nicht alles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040208,
					"content": "„Heute war ich am Schrein für eine Weile beten. Das Omamori, das du mir gabst, ist ein wenig verblichen, doch es ist immer noch mein kostbarster Besitz ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040209,
					"content": "Danach haben wir gesucht! Statten wir dem Schrein einen Besuch ab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200403,
			"completionStepIds": [
				200403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200403",
							"2"
						],
						"stepId": 200403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040301,
					"content": "Von diesem Omamori hat Tejima also geschrieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040302,
					"content": "Interessant ... sieh dir die Farbe und die Machart an. Paimon findet, es sieht aus wie von einem Mädchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040303,
					"content": "Wie auch immer, wenn er es die ganze Zeit dabei hatte, steckt vielleicht noch etwas Elementarenergie von ihm darin. Ob das nützlich sein könnte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200404,
			"completionStepIds": [
				200404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200404",
							"2"
						],
						"stepId": 200404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040401,
					"content": "Da wären wir! Diesen Ort scheint Tejima häufig besucht zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040402,
					"content": "Der Boden wurde aufgewühlt ... Vielleicht hat Tejima hier etwas Kostbares vergraben ... etwas, das ihn all die Jahre im Dorf hielt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040403,
					"content": "Der Schatz, den Tejima hier vor 30 Jahren versteckt hat, muss bestimmt toll sein. Lass uns ihn schnell ausgraben und nachschauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040404,
					"content": "Sieht aus wie ... ein Brief? Er ist vergilbt, wurde also vor langer Zeit geschrieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040405,
					"content": "„Dorf Konda“ ... Klingt vertraut. Wo liegt das noch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040406,
					"content": "Hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040407
					]
				},
				{
					"id": 20040407,
					"content": "Tejima kam also hierher, weil er auf jemanden wartete?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040408,
					"content": "Doch er lebt seit 30 Jahren hier ... er hat wohl vergeblich gewartet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040409,
					"content": "Nun ja, geben wir Tejima erst einmal seine Sachen zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200405,
			"completionStepIds": [
				200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200405",
							"2"
						],
						"stepId": 200405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tejima",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040501,
					"content": "Wenn das nicht ... Das ist definitiv meine Handschrift ... und das Omamori und der Brief sind auch von mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040502
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040502,
					"content": "Doch ich kann mich an nichts aus diesem Tagebuch erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040503
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040503,
					"content": "Gleichwohl ... Offensichtlich habe ich hier 30 Jahre lang auf jemanden gewartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040504
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040504,
					"content": "Mit der Zeit begann ich wohl, alles von Interesse festzuhalten ... um es mit ihr zu teilen, sobald wir endlich wiedervereint wären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040505
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040505,
					"content": "Und seht euch an, was in all den Jahren passiert ist ... Wie rasch die Zeit verging! 30 Jahre sind wie in einem Augenblick verflogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040506
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040506,
					"content": "Wie konnte ich etwas so Wichtiges nur vergessen? Hmm ... Da fällt mir wieder ein, wie leer ich mich plötzlich fühlte, als mein ... Göttliches Auge mir genommen wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040507
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040507,
					"content": "Liebe, Reue ... alles, was ich für sie empfand ... es ist alles verschwunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040508
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040508,
					"content": "Macht dich das traurig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040509
					]
				},
				{
					"id": 20040509,
					"content": "Nein ... nicht besonders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040510
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040510,
					"content": "Schließlich habe ich vergessen, wer sie war. Ihr Gesicht, ihre Stimme, unsere gemeinsamen Erlebnisse ... Ich erinnere mich kaum daran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040511
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040511,
					"content": "Es ist so, als wäre sie nie Teil meines Lebens gewesen ... als ob all diese Jahre nicht mehr waren als ein flüchtiger Traum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040513
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040513,
					"content": "Willst du also immer noch aufbrechen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040514
					]
				},
				{
					"id": 20040514,
					"content": "Ich denke ... lieber nicht. Wenn ich die meiste Zeit meines Lebens darauf gewartet habe, sollte ich wohl weiter warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040516
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040516,
					"content": "Allerdings, was wäre, wenn sie schließlich auftaucht und ich mich nicht einmal an ihren Namen erinnere ... Wäre sie dann nicht aufgebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040517
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040517,
					"content": "So gesehen ... versetzt es meinem Herzen doch einen leichten Stich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040518
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040518,
					"content": "Seltsam ... Warum ist das überhaupt so, wenn ich mich doch nicht an sie erinnere? Es ist nur dieses Gefühl der Leere, dieses Gefühl, dass ... etwas fehlt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040519
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040519,
					"content": "Danke euch beiden, ihr habt mir geholfen, den Grund für mein Hiersein wiederzufinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040520
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040520,
					"content": "Ich werde hierbleiben und weiter auf sie warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040522
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040522,
					"content": "Tejima wirkt nicht allzu niedergeschlagen, trotzdem ... stimmt es Paimon überaus betrübt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040523,
						20040524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040523,
					"content": "Ja, mich auch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				},
				{
					"id": 20040525,
					"content": "Es ist so wie Ayaka und Thoma sagten. Wer sein Göttliches Auge verliert, der verliert auch alle Hoffnungen und Träume ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040526,
					"content": "Das erklärt auf jeden Fall Tejimas früheren Zustand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040527,
					"content": "Zumindest konnten wir ihm helfen ... oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040528,
					"content": "*seufz* Begeben wir uns zur nächsten Person!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040524,
					"content": "Es gibt wohl nichts Traurigeres, als den Grund der Trauer zu verlieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				}
			]
		},
		{
			"id": 200406,
			"completionStepIds": [
				200406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200406",
							"2"
						],
						"stepId": 200406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mahiru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040601,
					"content": "Ah ... Ihr seid also hier, um Tejima zum Bleiben zu bewegen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040602
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040602,
					"content": "Was ist passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040603
					]
				},
				{
					"id": 20040603,
					"content": "Seit seiner Ankunft vor 30 Jahren beschützt Tejima diesen Ort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040604
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040604,
					"content": "Er hielt die Schatzräuber fern, vertrieb alle Monster, schlichtete Zwistigkeiten zwischen den Dorfbewohnern ... er hat unendlich viel Mühe für uns alle aufgewandt. Er bedeutet uns allen sehr viel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040605
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040605,
					"content": "Doch jetzt will er plötzlich aufbrechen ... und wir wundern uns darüber? Haben wir vielleicht etwas falsch gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040606
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040606,
					"content": "Wenn es so ist, entschuldigen wir uns mit Freuden bei ihm ... Wir möchten bloß, dass er bleibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahiru"
				}
			]
		},
		{
			"id": 200407,
			"completionStepIds": [
				200407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200407",
							"2"
						],
						"stepId": 200407,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kenjirou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040701,
					"content": "*seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040702
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040702,
					"content": "Warum der Wandel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040703
					]
				},
				{
					"id": 20040703,
					"content": "Wenn ihr mich fragt, hat das mit dem Augenhatz-Dekret zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040704
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040704,
					"content": "Tejima hat nichts falsch gemacht, so viel ist klar. Und doch nahmen sie ihm sein Göttliches Auge. Danach ... war er wie ausgewechselt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040705
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040705,
					"content": "Ich verstehe es zwar nicht ganz, doch offensichtlich hat er etwas sehr Wichtiges verloren. Er streifte auf Spaziergängen herum, umkreiste einige Male das Dorf, und dann verkündete er plötzlich, dass er aufbrechen will, um ein Wanderer zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040706
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040706,
					"content": "Ehrlich gesagt, sind wir uns nicht sicher, ob es richtig wäre, ihn hierzubehalten. Doch ... in diesem Zustand wollen wir ihn auch nicht ziehen lassen. Er ist eine verlorene Seele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040707
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040707,
					"content": "Er scheint hier äußerst respektiert zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200408,
			"completionStepIds": [
				200408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200408",
							"2"
						],
						"stepId": 200408,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Tejima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040801,
					"content": "Bist du Tejima? Warum möchtest du so plötzlich aufbrechen und hier verschwinden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040802,
					"content": "Ich ...? Mir ... geht es nicht darum, warum ich gehen sollte ... sondern darum, warum ich bleiben sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040803
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040803,
					"content": "Du hast lange Zeit hier gelebt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040804
					]
				},
				{
					"id": 20040804,
					"content": "Alle zählen auf dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040805
					]
				},
				{
					"id": 20040805,
					"content": "Das stimmt ... Doch aus diesem Grund bin ich nicht hiergeblieben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040806
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040806,
					"content": "Warum bin ich vor 30 Jahren hierhergekommen? Und warum wollte ich in all dieser Zeit nie weg?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040807
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040807,
					"content": "Weil ich mich an nichts mehr erinnere, habe ich keine Antworten mehr auf diese Fragen. Seit man mir mein Göttliches Auge nahm ... ist ein Teil meiner Erinnerung fort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040808
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040808,
					"content": "Früher wusste ich, warum ich hierbleiben wollte ... doch dieses Wissen ist jetzt fort. Warum soll ich also nicht aufbrechen? Die Leere in mir bleibt so oder so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040809
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040809,
					"content": "Wenn das so ist, helfen wir dir dabei, den Grund für dein Hiersein wiederzufinden, damit du nicht mehr weggehst, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040810,
					"content": "Hmm ... aber wenn du dich an nichts erinnerst, wird das nicht leicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040811,
					"content": "Vielleicht kommt alles zurück, wenn du dich ein wenig anstrengst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040812,
					"content": "Oh, da fällt mir ein ... Als ich Tejima beim letzten Mal Früchte brachte, schrieb er in ein Tagebuch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040813
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040813,
					"content": "Ich führe Tagebuch? Wenn du das sagst ... Ich kann mich ehrlich nicht daran erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040814
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040814,
					"content": "Ja, das tust du! Du meintest, du wolltest interessante Begebenheiten festhalten ... Dinge, die später noch wichtig sein werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040815
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040815,
					"content": "Perfekt! Wollen wir Tejima vom Aufbruch abhalten, müssen wir also bloß sein Tagebuch finden. Es muss hier irgendwo sein, sehen wir uns um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040816,
					"content": "Wenn es in Ordnung ist, überlassen wir euch die Suche nach dem Tagebuch ... wir sollten den anderen im Dorf von Tejimas Lage berichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahiru"
				}
			]
		},
