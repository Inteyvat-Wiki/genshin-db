					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732750501,
					"content": "Über das Lied ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750502
					]
				},
				{
					"id": 732750502,
					"content": "Erinnerst du dich noch an dieses Lied? Hehe, es ist eine gute Sache, dass es eine weitere junge Person gibt, die sich daran erinnert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750503
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750503,
					"content": "„Rose, oh, Rose, mach meinen Wunsch wahr. Die Blume erblüht aus den Steinen und die Goldrose bietet mir ein Lied dar.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750504
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750504,
					"content": "„Kein Boden, der mich trägt, einzig das Lied will mich tragen. Das Lied besiegt mein grausames Schicksal, genauso wie mein Ende.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750505,
					"content": "„Es besiegt mich, es besiegt die Zeit, es besiegt das niemals vergehende Vergehen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
