			"dialogs": [
				{
					"id": 732750102,
					"content": "Die Goldrosen sind zu Setzlingen herangewachsen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750103
					]
				},
				{
					"id": 732750103,
					"content": "Die, Ooh ... Ich frage mich, wo du diese Samen überhaupt gefunden hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750104,
					"content": "Von einem weit entfernten Ort.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750105
					]
				},
				{
					"id": 732750105,
					"content": "Die Samen, die Onkel Shafaqat gesät hat, haben am Ende den Weg hierher gefunden, nachdem sie in jeden Winkel der Wüste gestreut worden waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750107
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750107,
					"content": "Wir müssen uns gut um diese Setzlinge kümmern. Ich habe vor, sie Sabbah zu überlassen. Wenn ich einmal nicht mehr bin, sollen diese Blumen ihr gehören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750108
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750108,
					"content": "Danke, mein gutes Kind. Es gibt wenig, was ich dir geben kann ... Aber bitte nimm diese Früchte und Blumen an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
