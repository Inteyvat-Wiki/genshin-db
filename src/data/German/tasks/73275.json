				},
				{
					"id": 732750305,
					"content": "Die Samen, die Onkel Shafaqat gesät hat, haben am Ende den Weg hierher gefunden, nachdem sie in jeden Winkel der Wüste gestreut worden waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750307
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750307,
					"content": "Wir müssen uns gut um diese Setzlinge kümmern. Ich habe vor, sie Sabbah zu überlassen. Wenn ich einmal nicht mehr bin, sollen diese Blumen ihr gehören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750308
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750308,
					"content": "Du hast mir wirklich einen großen Gefallen getan und hast keine Belohnung verlangt. Aber ich würde heute Nacht nicht schlafen können, wenn ich dir nicht wenigstens eine Kleinigkeit geben würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750309
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750309,
					"content": "Dieser Setzling ist kürzlich durch die Erde gebrochen, und Sabbah schlug vor, ihn dir zu schenken. Sie hat ihn sogar hübsch eingepackt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750310
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750310,
					"content": "Nimm es als Erinnerung von uns mit. Ich wünsche, dass du so widerstandsfähig bist wie ihn und niemals den Glauben verlierst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
