						],
						"pointId": 16847
					}
				]
			},
			"dialogs": [
				{
					"id": 700960601,
					"content": "Wunderbar ... Laut Barbeloths Prophezeiung sollte der Mensch, der Führung braucht, gleich hier auftauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960602
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960602,
					"content": "Eröffnungszeilen ... auswendig gelernt. Eröffnungseffekte ... bestätigt. Hahaha, dieses Mal kann nichts schiefgehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960603
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960603,
					"content": "He ... Warum glaubt ihr, dass die „letzte Prophezeiung“ verlangt, dass Lohen hierherkommt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960604,
					"content": "Oh nein, sind sie schon da? Hat Durin seine Zeilen nicht beendet? Urgh ... ich muss still sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960605
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960605,
					"content": "Könnte mit der „Macht des Drachen“ am Ende etwa Dvalin gemeint sein? Obwohl er heute nicht hier zu sein scheint ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960606,
					"content": "Genau genommen habe ich ihn schon gesehen, als ich das erste Mal aus Nod-Krai nach Hause zurückgekehrt bin. Er war direkt neben euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960607
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960607,
					"content": "Ach ja! In Wolfenlauf, als du Briefe für Varka ausgetragen hast! Warte mal ... Heißt das, die Prophezeiung hat sich schon erfüllt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960608,
					"content": "Wenn wir es großzügig auslegen, habe ich mich „dreimal der Macht des Drachen gestellt“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960609
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960609,
					"content": "Aber hast du schon „die wahre Bedeutung der Stärke verstanden“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960610
					]
				},
				{
					"id": 700960610,
					"content": "Ich schätze, deshalb hat mich die Prophezeiung hierhergeführt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960611
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960611,
					"content": "Bevor dieser Ort als Dvalins Ruinen bekannt wurde, war er das Reich von Decarabian, dem Gott der Stürme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960612
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960612,
					"content": "Doch der mächtige Gott, der Stürme beschwören konnte, um die Welt auszusperren, konnte die Sehnsucht nach Freiheit in seinen eigenen Mauern aus Wind nicht aufhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960613
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960613,
					"content": "Doch der Gott des Nordwinds, mit dem er einst um den göttlichen Thron kämpfte, fand die Antwort, die er immer gesucht hatte, erst, nachdem er seine Macht aufgegeben hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960614
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960614,
					"content": "Hm? Dieses Kind scheint mehr draufzuhaben, als Varka mir glauben gemacht hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960615
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960615,
					"content": "Der Spiegel des Morgengrauens, Durin ... Auch sie waren eine Zeit lang von Verwirrung und Zweifel erfüllt. Was sie zu Stärke führte, war mehr als nur Macht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960616
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960616,
					"content": "Tja ... Du scheinst es wirklich zu verstehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960617
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960617,
					"content": "Und ebenso Ursa, das Monster, das einst ein Engel gewesen war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960618
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960618,
					"content": "... Hä?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960619
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960619,
					"content": "Paimon denkt, du könntest hier was herausgefunden haben, Lohen ... Aber, ähm, du redest irgendwie komisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960620,
						700960621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960620,
					"content": "Erst Durin ... jetzt Lohen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				},
				{
					"id": 700960622,
					"content": "„Der Engel, der sich für die Macht entschied, sehnte sich dennoch danach, den Menschen nah zu bleiben, und verfiel schließlich zu einem bedauernswerten Monster ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960623
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960623,
					"content": "„O Menschen, die ihr dies alles bezeugt habt, strebt ihr immer noch nach Macht?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960624
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960624,
					"content": "He! Das sind meine Zeilen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960625
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960625,
					"content": "Wah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960626,
					"content": "Oje ... Jetzt ist wohl die Katze aus dem Sack, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960627
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960627,
					"content": "Es ist mir eine Freude, dich kennenzulernen, Fräulein Nicole. Ich habe dein Drehbuch gelesen, und ich muss sagen, ich war sehr beeindruckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960628
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960628,
					"content": "*seufz* ... Warum habe ich nur das Gefühl, dass Durin sein eigenes Exemplar fallen gelassen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960629
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960629,
					"content": "Oh? Das war also auch Teil der Prophezeiung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960630
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960630,
					"content": "Überhaupt nicht. Wenn ich es im Voraus gewusst hätte, hätte ich nicht einfach ... *hust*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960631
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960631,
					"content": "Wie auch immer, das Drehbuch war gut geschrieben. Sehr unterhaltsam – als herzerwärmendes kleines Märchen natürlich. Allerdings muss ich sagen, dass ich es nicht besonders mag, belehrt zu werden ... nicht mal von einem Engel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960632
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960632,
					"content": "... Ich glaube einfach mal, dass das an meinen ehemaligen Kollegen gerichtet war – den, der sich für die Macht entschieden hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960633
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960633,
					"content": "Da du mein Drehbuch gelesen hast, weißt du bestimmt schon alles, was ich zu sagen habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960634
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960634,
					"content": "Ja, und ich werde es auf jeden Fall als wertvollen Rat behandeln. Gab es sonst noch was, oder kann ich jetzt wieder an meinem „Handbuch starker Gegner“ weiterschreiben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960635,
						700960636
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960635,
					"content": "(Er hat nicht gesagt, dass er das auch wirklich umsetzen will ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960637,
					"content": "Aber ich muss zugeben, dass es ein ziemlich produktiver Tag war. Ich bin sicher, dass ich zumindest ein kleines bisschen stärker geworden bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960638
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960638,
					"content": "Danke an euch alle ... und richtet dem Produktionsteam schöne Grüße von mir aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960639
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960639,
					"content": "*seufz* ... Warum sind Menschen nur immer so schwierig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960640
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960640,
					"content": "Ähm, kann jemand Paimon erklären, was hier los ist? Paimon ist ... sehr, sehr verwirrt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960641,
					"content": "Erinnerst du dich noch an den Kampf gegen Il Dottore und das Gift, das Ursa in Mondstadt hinterlassen hat? Mir wurde gesagt, dass Lohen damals auch ziemlich gelitten hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960642
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960642,
					"content": "Da es sich um eine Katastrophe handelte, die von einem ehemaligen Engel verursacht worden war, fiel es natürlich einem gegenwärtigen Engel zu, die Dinge in Ordnung zu bringen ... Obwohl die „Dinge“ nicht genau so liefen, wie ich es geplant hatte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960643
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960643,
					"content": "Es scheint, dass das Schicksal der Menschheit immer unvorhersehbarer wird ... Die Führung der Engel ist nicht mehr das Einzige, was sie in die Zukunft leitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960644
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960644,
					"content": "Aber all diese unendlichen Möglichkeiten ... Vielleicht liegt genau darin die wahre Stärke der Menschheit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960636,
					"content": "(Er wird ziemlich sicher einfach weiter an seinem Handbuch arbeiten, egal was sie sagt ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960621,
					"content": "Warum klingen alle, als würden sie von einem Drehbuch ablesen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				}
			]
		},
