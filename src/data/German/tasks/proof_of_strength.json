							1136.21,
							506.39,
							-831.26
						],
						"pointId": 16843
					}
				]
			},
			"dialogs": [
				{
					"id": 700960501,
					"content": "... Machtsuchender, Anhänger des Schicksals, du bist endlich hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960502
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960502,
					"content": "Es ist Durin ... Paimon ist wirklich überhaupt nicht überrascht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960503,
					"content": "Er spricht irgendwie seltsam ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960504
					]
				},
				{
					"id": 700960504,
					"content": "Oberster Herrscher, Schöpfung einer Hexe und ein Nachfahre der Engel ... Alle verfügen über unterschiedliche Kräfte, doch alle wurden zu Drachen gekrönt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960505
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960505,
					"content": "... Das liegt daran, dass Drachen das Symbol der Macht sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960506
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960506,
					"content": "Also wurde „gegen große Drachen zu kämpfen“ zu einer Möglichkeit, die eigene Stärke zu beweisen? ... Ich glaube, ich fange an, den anfänglichen Großmeister langsam besser zu verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960507
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960507,
					"content": "... Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960508
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960508,
					"content": "Ich sehe, du hast noch viel zu sagen, aber ich schlage vor, wir lassen unsere Klingen sprechen. Schließlich sagt ein einzelner Schwerthieb mehr als tausend Worte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960509
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960509,
					"content": "W... Warte! J... Junger Mensch, die Prüfung, die du suchst, ist weit von hier entfernt. Du musst dich zu Dvalins Ruinen begeben und d... dich der finalen Prophezeiung stellen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960510,
						700960511
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960510,
					"content": "Warum redet er so schnell?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				},
				{
					"id": 700960512,
					"content": "Alles in Ordnung, Durin? Du klingst heute irgendwie komisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960513,
					"content": "(Puh ... Ich glaube, ich hab die wichtigsten Teile geschafft ... auch wenn ich vieles überspringen musste!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960514
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960514,
					"content": "Ähm, ich glaube, Albedo meinte, dass er Hilfe bei einem Experiment braucht, also sollte ich jetzt besser zurückgehen. Tut mir leid, Leute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960515
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960515,
					"content": "Wah, der war aber schnell weg ... Echt schade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960516
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960516,
					"content": "He, was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960517
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960517,
					"content": "Ähm ... Warum genau war Durin hier? Abgesehen vom letzten Satz über „... zu Dvalins Ruinen begeben ...“ hat er nur Unsinn geredet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960518,
						700960519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960518,
					"content": "Irgendetwas sagt mir ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960520,
					"content": "Interessant. Ich bin gespannt darauf, wie genau sich diese „Prophezeiung“ erfüllen wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960519,
					"content": "... Dass er nur hier war, damit der nächste Drache als Nummer drei zählt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960511,
					"content": "Er klingt wie ein Schauspieler, der von der Bühne verschwinden will!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				}
			]
		},
		{
			"id": 7009606,
