			},
			"dialogs": [
				{
					"id": 700960401,
					"content": "Solch fließende Bewegungen ... Ich hätte nie gedacht, dass du eine Maschine bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960402
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960402,
					"content": "Deine Angriffe sind ebenfalls sehr präzise, Herr Lohen. Fast schon mechanisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960403
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960403,
					"content": "Juhu, neue Teile! Damit werde ich ein paar hervorragende neue Module bauen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960404
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960404,
					"content": "Und ... Ähm ... Heißt das, du hast jetzt Zeit, um ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960405
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960405,
					"content": "Ineffa, such noch mehr! Ich will so viele, wie wir kriegen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960406
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960406,
					"content": "Verstanden ... Entschuldigung, Herr Lohen. Darüber können wir später reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960407
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960407,
					"content": "Nach vielen Erkundungen ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700960408
					]
				},
				{
					"id": 700960408,
					"content": "*schnarch* ... *schnarch* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960409
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960409,
					"content": "Aino schläft ... Hat sie sich in Dornmannshaven beim Spielen ausgetobt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960410,
					"content": "So geht es ihr oft – ihre Batterien sind schnell leer. Es tut mir leid, Herr Lohen, aber ich fürchte, ich kann im Moment nicht aufstehen. Ich muss hier bleiben, bis Aino in einen tieferen Schlaf gefallen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960411
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960411,
					"content": "... Das ist völlig in Ordnung. Ich habe bereits genug gesehen, um zu wissen, wozu du fähig bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960412
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960412,
					"content": "... Ich hoffe, meine Kampfdaten liefern dir ein paar nützliche Erkenntnisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960413
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960413,
					"content": "Übrigens hat die Person, die uns von diesen besonderen Mechanismen erzählt hat, auch Drachengrat erwähnt. Du solltest vielleicht dorthin gehen und dir die Sache ansehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				}
			]
		},
		{
			"id": 7009605,
