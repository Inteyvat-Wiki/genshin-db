				]
			},
			"dialogs": [
				{
					"id": 700960301,
					"content": "Ineffa! Ineffa! Hast du die Windmühle gesehen!? Du musst aufzeichnen, wie sie funktioniert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960302
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960302,
					"content": "Verstanden – Fotografie der Windmühle wird vorbereitet. Möchtest du dieses Mal auch auf dem Bild erscheinen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960303
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960303,
					"content": "#Äh? {NICKNAME}? Paimon ... und Lohen! Hallo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960304
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960304,
					"content": "Oooh ... Informationen aus Nod-Krai über einen mächtigen uralten Drachen ... Paimon versteht, was hier los ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960305,
					"content": "Situationseinschätzung läuft ... Es scheint, dass Herr Lohen gegen mich kämpfen möchte. Ist das richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960306
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960306,
					"content": "Kurz gesagt: Ja! Das ist es, was ich vorhabe. Als die Expedition noch in Nod-Krai war, hatte ich keinen Grund anzunehmen, dass du eine so außergewöhnliche Geschichte hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960307
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960307,
					"content": "Aber das ist jetzt nicht so wichtig. Ich wollte schon lange mal meine Fähigkeiten gegen dich testen, also ... Wie wär’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960308
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960308,
					"content": "Hehe! Ineffa, zeig ihm, wo’s langgeht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960309
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960309,
					"content": "Es tut mir leid – laut heutigem Zeitplan müssen wir noch nach Mondstadt, um einige spezielle Komponenten abzuholen. Meine Einschätzungen zeigen, dass ein Kampf mit dir jetzt unsere nachfolgenden Aktivitäten beeinträchtigen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960310
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960310,
					"content": "Oh ja ... Ich hätte es fast vergessen! Wir haben gehört, dass es in Mondstadt so eine Art riesigen Roboter gibt ... Deshalb sind wir hier! Aber dann bin ich etwas abgelenkt worden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960311
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960311,
					"content": "Schon in Ordnung ... Ich verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960312
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960312,
					"content": "Lohen ... Du gibst doch jetzt nicht einfach so auf!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960313,
					"content": "Wenn ich dir helfe, die Ruinenwächter zu erledigen, sollte das doch deinen Zeitplan freimachen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				}
			]
		},
		{
