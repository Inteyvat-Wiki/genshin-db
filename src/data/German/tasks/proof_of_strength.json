			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Slazhnev",
					"Leifhelm"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700960201,
					"content": "Unser Truppenführer ist nicht nur stark – er hat sogar eine Substanz entwickelt, die dem Abgrund entgegenwirkt! Das hast du bestimmt nicht gewusst, oder, du Besserwisser? Und trotzdem hältst du mich für einen „Pseudo-Experten“, der keine Ahnung hat!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960202
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960202,
					"content": "Weißt du eigentlich, wie schnell unser Großmeister ist? Er hat den Fluss der Elementen benutzt, um von Nod-Krai nach Mondstadt zu reisen – und war schneller da, als du deine Schuhe binden kannst. Falls du das überhaupt kannst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leifhelm"
				}
			]
		},
