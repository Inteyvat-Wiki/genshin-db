			"dialogs": [
				{
					"id": 700960101,
					"content": "... Wenn du wissen willst, wer der stärkste Krieger ist, dann schau dir unseren Truppenführer an! Er kann den Abgrund allein mit reiner körperlicher Kraft zurückhalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960102
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960102,
					"content": "Genau so ein Geschwätz würde ich von jemandem erwarten, der noch nie echte Kämpfe gesehen hat! Glaubst du, starke Krieger stehen einfach nur rum und schlagen auf Holzpuppen ein? Außerdem bezweifle ich, dass er, was reine Stärke angeht, mit unserem Großmeister mithalten kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960103
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 700960103,
					"content": "Jetzt reicht’s! Ich habe euch beide nicht eingeladen, um eurem Gezänk zuzuhören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960104
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960104,
					"content": "... Lohen? Und sind das nicht ... Leifhelm und Slazhnev? Was macht ihr zusammen, und was führt euch beide aus Nod-Krai hierher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960105,
					"content": "Ha ... Ich habe gehört, dass es in Nod-Krai ein paar „Kampfexperten“ gibt, also habe ich sie eingeladen, mir bei der Zusammenstellung eines „Handbuchs starker Gegner“ zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960106
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960106,
					"content": "Hätte ich nur gewusst, dass Kampfexperten so streitsüchtig sind ... *seufz* Ich muss sie wohl mit ihren Köpfen zusammenstoßen und schauen, ob sie sich dann etwas professioneller verhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960107
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960107,
					"content": "Ahaha ... Ich ... Ich mache mich sofort an die Liste! He ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960108
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960108,
					"content": "Truppenführer Lohen! Ich will wirklich nicht unkooperativ sein, aber das Konzept „starke Gegner“ ist einfach viel zu vage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960109
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 700960109,
					"content": "Ganz zu schweigen von normalen Monstern – selbst die Machtunterschiede zwischen den Archonten sind riesig. Wenn wir keinen geeigneten Maßstab finden, fürchte ich, dass jede weitere Diskussion sinnlos sein wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960110
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 700960110,
					"content": "W... Wenn wir von einem Stärke-Maßstab sprechen, den jeder akzeptieren kann ... sollten wir wohl Drachen nehmen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960111
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960111,
					"content": "... Drachen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960112
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960112,
					"content": "Im Ernst? Paimon hat das Gefühl, dass die Stärkeunterschiede zwischen den Drachen nicht viel kleiner sind als die zwischen den Archonten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960113,
						700960114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960113,
					"content": "Warum willst du eigentlich ein „Handbuch starker Gegner“ zusammenstellen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960115
					]
				},
				{
					"id": 700960115,
					"content": "Nun ... um es kurz zu machen: Nach einer Phase der Selbstreflexion kam ich zu dem Schluss, dass der beste Weg, um noch stärker zu werden, darin besteht, die stärksten Gegner der ganzen Welt herauszufordern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960116
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960116,
					"content": "(... Hast du das nicht schon vorher gemacht?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960117
					]
				},
				{
					"id": 700960117,
					"content": "Aber dann heute Morgen, kurz bevor ich losziehen wollte ... da ist dieses komisch aussehende Ding vor mir aufgetaucht und hat angefangen, irgendwelchen Unsinn zu reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960118
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960118,
					"content": "„Verlorener Mensch, dreimal wirst du der Macht des Drachen gegenüberstehen. Dann, und nur dann, wirst du die wahre Bedeutung von Stärke begreifen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960119
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 700960119,
					"content": "(Das hört sich nach etwas an, was Barbeloth sagen würde ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960120
					]
				},
				{
					"id": 700960120,
					"content": "Ich glaube normalerweise nicht an Prophezeiungen, aber ... Hmpf, sagen wir einfach, ich habe das Gefühl, dass ich hier manipuliert werde, und das gefällt mir überhaupt nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960121
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960121,
					"content": "Drachen, hm ... Hier in Mondstadt könnte man nur von Dvalin oder Ursa sprechen, oder von den Legenden über Drachengrat ... Hmm, was gibt es sonst noch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960122
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 700960122,
					"content": "Ha, da fehlt dir eindeutig noch etwas Wissen! Laut streng geheimen Informationen, die ich in Nod-Krai erhalten habe, hat sich kürzlich ein mächtiger alter Drache nach Dornmannshaven geschlichen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960123
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960123,
					"content": "Wirklich!? Das kann nicht sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960124,
					"content": "Wenn wir die Wahrheit wissen wollen, gibt es nur einen Weg, das rauszufinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960114,
					"content": "„Drachen“ scheinen deine Aufmerksamkeit erregt zu haben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960115
					]
				}
			]
		},
		{
			"id": 7009602,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
