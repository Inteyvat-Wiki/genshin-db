				{
					"id": 700960701,
					"content": "*seufz* Trotzdem ... Auch wenn es mein erster Versuch war, kann ich nicht glauben, dass es so ausgegangen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960702,
						700960704
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960702,
					"content": "Aller Dinge Anfang ist schwer ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960703
					]
				},
				{
					"id": 700960703,
					"content": "Außerdem ist es nicht wirklich schlecht ausgegangen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960704,
					"content": "Aber dein erster Versuch in was genau?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960705
					]
				},
				{
					"id": 700960705,
					"content": "Ha ... Meine erste „Aufgabe der Hexe“. Ich erkläre es später.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
