			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190201,
					"content": "Hab ihn gefunden. Er vergräbt die Beute ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190202,
						220190204
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190202,
					"content": "Schnappen wir ihn uns!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190203
					]
				},
				{
					"id": 220190203,
					"content": "#Warte, {F#Reisende}{M#Reisender}. Jetzt ist nicht der richtige Zeitpunkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190206,
					"content": "Nur noch ein bisschen länger ... Hmmm ... Bald ist es so weit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190207,
					"content": "He, du! Was machst du denn da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190208
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190208,
					"content": "Lass fallen was du in den Händen hältst und nicht bewegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190209
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190209,
					"content": "Wie habt ihr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190210
					],
					"speakerTitle": "Ishikawa Hachirou"
				},
				{
					"id": 220190210,
					"content": "Aah ... Kommt schon, steht da nicht so rum! Schaltet sie aus! Werdet die beiden los und wir haben es geschafft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190211
					],
					"speakerTitle": "Ishikawa Hachirou"
				},
				{
					"id": 220190211,
					"content": "Ha! Ein paar mickrige Schatzräuber seid ihr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190212
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190212,
					"content": "Andou, Amano, wir werden euch helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190213
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190213,
					"content": "Gut! Sie gehören alle euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190214
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190214,
					"content": "#{F#Reisende}{M#Reisender}, jetzt ist es an der Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190215
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190215,
					"content": "Bah, so kompliziert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190216
					]
				},
				{
					"id": 220190216,
					"content": "Das ist der Plan von Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190217
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190217,
					"content": "Na gut, los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190204,
					"content": "Sollten wir ihn uns schnappen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190205
					]
				},
				{
					"id": 220190205,
					"content": "In einem Moment. Es ist noch nicht die Zeit dafür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 2201903,
			"completionStepIds": [
				2201905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201905",
							"2"
						],
						"stepId": 2201905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190301,
					"content": "#Jetzt haben wir ihn auf frischer Tat ertappt. Danke für die Hilfe, Ryuuji, danke, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190302
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190302,
					"content": "Amano und ich werden diese Schatzräuber zurück zur Polizeiwache bringen. Wir werden uns um den Rest des Falles kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190303
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190303,
					"content": "Es ist erstaunlich, wie Sango die Details des Falles so genau herausfinden konnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190304
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190304,
					"content": "Nun, es ist Sango. Ein Fall wie dieser ist für sie keine große Sache, kein Zweifel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190305
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190305,
					"content": "Ryuuji, wir gehen zuerst zurück zur Polizeiwache. Wir werden dich besuchen, wenn wir mit dem Kerl fertig sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190306
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190306,
					"content": "Es war mir ein Vergnügen. Pass auf dich auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190307
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190307,
					"content": "#{F#Reisende}{M#Reisender}, lass uns zurückgehen und Sango Bericht erstatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 2201904,
			"completionStepIds": [
				2201906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201906",
							"2"
						],
						"stepId": 2201906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190401,
					"content": "Und Andou und Amano bringen den Übeltäter in diesem Moment zur Polizeiwache, Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190402
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190402,
					"content": "Aha. Dann ist das geklärt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190403
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190403,
					"content": "#{F#Reisende}{M#Reisender}, ich danke dir für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190404,
						220190405
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190404,
					"content": "Also ... das war’s?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				},
				{
					"id": 220190406,
					"content": "Es ist normal, sich so zu fühlen. Immerhin waren es Amano und Andou, die den Verbrecher mitgenommen haben. Warum nimmst du nicht deinen Lohn? Das wird helfen, dass sich das alles realer anfühlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190407,
						220190409
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190407,
					"content": "Was ist mit deiner Bezahlung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190408
					]
				},
				{
					"id": 220190408,
					"content": "Ich? Die größte Belohnung für mich ist es, der Polizei zu helfen, einen Fall zu lösen und Frieden und Sicherheit in die Stadt zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190412,
					"content": "Aber um ehrlich zu sein, habe ich dieses Mal nicht viel zugelegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190413
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190413,
					"content": "Ich habe keine neuen kriminellen Techniken oder Ideen zu sehen bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190414
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190414,
					"content": "Es war ein uninteressantes Verbrechen. Zum Glück hat es nicht viel Mühe gekostet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190415,
						220190417
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190415,
					"content": "Sango ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190416
					]
				},
				{
					"id": 220190416,
					"content": "Hmm? Ist das das erste Mal, dass du jemanden triffst, der sich für Verbrechen interessiert, so wie ich es tue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190419,
					"content": "Es ist diese Faszination, die mich dazu gebracht hat, Detektiv zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190420
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190420,
					"content": "Willst du dann auch Verbrechen begehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190421
					]
				},
				{
					"id": 220190421,
					"content": "Ja, in gewisser Weise will ich das. Ich wünsche mir, ein makelloses, perfektes Verbrechen zu begehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190422
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190422,
					"content": "Wie auch immer ... es ist unvermeidlich, dass bei einem Verbrechen einige Beweise zurückbleiben und solange es Beweise gibt, ist es nur eine Frage der Zeit, bis das Verbrechen aufgeklärt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190423,
						220190424,
						220190425
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190423,
					"content": "Was ist, wenn das Verbrechen nicht von einer Person begangen wird?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190426,
					"content": "Siehst du! Du kannst nicht anders, als auch darüber nachzudenken, Verbrechen zu begehen, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190427
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190427,
					"content": "Sei nicht nervös. Du denkst nur darüber nach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190428
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190428,
					"content": "Ich denke die ganze Zeit über Verbrechen nach, wie und warum sie begangen werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190429
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190429,
					"content": "Warum denkst du so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190430
					]
				},
				{
					"id": 220190430,
					"content": "Um Fälle besser zu lösen, natürlich. Die Fälle, an denen ich in letzter Zeit gearbeitet habe, wurden immer komplizierter, so dass ich mir viele Gedanken gemacht habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190431
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190431,
					"content": "Allerdings kann keiner dieser Fälle als perfekt bezeichnet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190432
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190432,
					"content": "Hast du jemals ein perfektes Verbrechen gesehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190433
					]
				},
				{
					"id": 220190433,
					"content": "Ja, das habe ich. Es gab ein perfektes Verbrechen, das ich bis zum heutigen Tag nicht lösen konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190434
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190434,
					"content": "Aber ich glaube, dass es, solange es von einem Menschen begangen wurde, irgendeinen Beweis geben muss. Es ist nur so, dass ich noch keine gefunden habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190435
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190435,
					"content": "#Wie auch immer, hier ist deine Bezahlung. Danke, dass du mir geholfen hast, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190436
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190436,
					"content": "Fühl dich frei, hierherzukommen, wann immer du Zeit hast. Aber wenn du zu beschäftigt bist ... nun ... das ist auch in Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190437
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190437,
					"content": "Trotzdem sagt mir mein Bauchgefühl, dass wir die Chance haben werden, unsere Kräfte wieder zu vereinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190424,
					"content": "Was ist, wenn der Schuldige nicht existiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190425,
					"content": "Gibt es eine Möglichkeit, deine Spuren zu verwischen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190417,
					"content": "Sind alle Detektive so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190418
					]
				},
				{
					"id": 220190418,
					"content": "Ich würde es nicht verallgemeinern, aber ich interessiere mich sehr für „Kriminalität“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190409,
					"content": "Willst du nichts?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190410
					]
				},
				{
					"id": 220190410,
					"content": "Ich habe bereits den Geschmack der Gerechtigkeit gekostet. Ich brauche nichts anderes ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190411
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190411,
					"content": "Hehe ... Ich nehme an, das klingt besser, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190405,
					"content": "Einfach so? ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				}
			]
		},
		{
