			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190101,
					"content": "Also gut, ich zähle auf euch beide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190102
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190102,
					"content": "Sei unbesorgt, Sango.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190103
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190103,
					"content": "Ich kann nicht glauben, dass er sich so lange vor unserer Nase versteckt hat. Er hat echt Nerven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190104
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190104,
					"content": "Und noch mit dieser Identität ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190105
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190105,
					"content": "Auf jeden Fall soll heute das Ende seiner Karriere sein. Ryuuji, weißt du noch, was ich gesagt habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190106
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190106,
					"content": "Mhmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190107,
					"content": "#Gut ... Du bist auch hier, {F#Reisende}{M#Reisender}. Das ist großartig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190108,
						220190109
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190108,
					"content": "Wirst du den Dieb fangen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190111
					]
				},
				{
					"id": 220190111,
					"content": "Ich habe genug Beweise gesammelt und ich habe die Gewohnheiten des Täters herausgefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190112
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190112,
					"content": "#{F#Reisende}{M#Reisender}, wirst du mit Ryuuji, Andou und Amano gehen, um den Schuldigen vor Gericht zu bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190113
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190113,
					"content": "Er muss mehrere Komplizen haben. Wenn du dabei bist, wird der Erfolg der Operation noch sicherer sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190114,
						220190117
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190114,
					"content": "Was muss ich tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190115
					]
				},
				{
					"id": 220190115,
					"content": "Benutze einfach deine unübertroffene Aura, um den Täter einzuschüchtern, damit er nichts besonders Dummes tut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190116
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190116,
					"content": "Aber auch hier denke ich, dass ein Dieb, der nur herumschleichen kann, nicht den Nerv haben wird, irgendwelche drastischen Schritte zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190121,
					"content": "Wenn ich richtig liege, muss unser Mann in die Wildnis, um die neu gestohlene Ware zu vergraben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190122
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190122,
					"content": "Wenn du jetzt dorthin gehst, solltest du ihn auf frischer Tat ertappen können. Ich werde hier auf deine guten Nachrichten warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190117,
					"content": "Kommst du nicht mit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190118
					]
				},
				{
					"id": 220190118,
					"content": "Mein Teil ist erledigt, also halte ich mich da raus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190119
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190119,
					"content": "#{F#Reisende}{M#Reisender}, benutze deine unübertroffene Aura, um den Übeltäter einzuschüchtern, damit er nichts ... besonders Dummes tut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190120
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190120,
					"content": "Aber auch hier denke ich, dass ein Dieb, der nur herumschleichen kann, nicht den Nerv haben wird, irgendwelche drastischen Schritte zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190109,
					"content": "Wirst du den Fall schließen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190110
					]
				},
				{
					"id": 220190110,
					"content": "Ja. Wenn alles gut geht, wird er heute geschlossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190111
					],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 2201902,
			"completionStepIds": [
				2201903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
