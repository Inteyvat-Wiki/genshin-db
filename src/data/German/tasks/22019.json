			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190601,
					"content": "Wenn du jetzt dorthingehst, solltest du ihn auf frischer Tat ertappen können. Ich werde hier auf deine guten Nachrichten warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190602
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190602,
					"content": "#Gibt es noch etwas, das du sagen möchtest, {F#Reisende}{M#Reisender}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190603,
						220190607
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190603,
					"content": "Du siehst nicht sehr begeistert aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190604
					]
				},
				{
					"id": 220190604,
					"content": "Dieser Fall ist ziemlich uninteressant: Er hat einen langweiligen Täter, und den Methoden fehlt es an Raffinesse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190605
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190605,
					"content": "Wenn ich diesen Fall bewerten müsste ... er ist ein totaler Schnarcher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190606
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190606,
					"content": "Aber wie gesagt, es ist ein Verbrechen, also ist es gut, dass es geahndet wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190607,
					"content": "Kommst du nicht mit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190608
					]
				},
				{
					"id": 220190608,
					"content": "Mein Teil ist erledigt, also halte ich mich da raus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190609
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190609,
					"content": "Außerdem könnte ich mit meinen kämpferischen Fähigkeiten und meinem Körperbau von dem Täter als Geisel genommen werden, was er dann nutzen könnte, um zu bekommen, was er will. Das wäre das Schlimmste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190610
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190610,
					"content": "Ich kenne meine Grenzen, also überlasse ich es dir, mit ihm umzugehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		}
	]
}