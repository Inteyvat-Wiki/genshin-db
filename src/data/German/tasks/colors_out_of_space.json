			"dialogs": [
				{
					"id": 760280301,
					"content": "#Waaah, endlich hat Paimon dich gefunden, {NICKNAME}! Als die zwei leuchtenden Dinge zusammengestoßen sind, wurde Paimon von der Druckwelle der Explosion weggeschleudert, aber zum Glück ist Paimon unverletzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280302,
					"content": "Paimon musste so lange fliegen, um hierher zurückzukommen ... Wie gut, dass dir nichts passiert ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280303,
						760280308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280303,
					"content": "Ich bin auch lange geflogen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280304
					]
				},
				{
					"id": 760280304,
					"content": "Ach so ... Äh? Moment mal, warum fliegen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280305,
					"content": "Du erzählst Paimon von den Dingen, die du gerade gesehen hast ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760280306
					]
				},
				{
					"id": 760280306,
					"content": "#Hmm, Paimon hat noch nie von so einem Ort in Teyvat gehört ... {NICKNAME}, hast du vielleicht irgendwelche seltsamen Halluzinationen gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280307,
					"content": "Aber Hauptsache, du bist wohlauf! An diesem Ort gibt es einfach zu viele Dinge, die wir nicht verstehen. Lass uns lieber schnell von hier verschwinden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280312,
					"content": "Uff, Paimon hätte nie gedacht, dass es so gefährlich sein würde, und am Ende haben wir nicht mal einen Schatz gefunden ... Warum ist das überhaupt jetzt hier aufgetaucht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280313,
					"content": "Und wenn die beiden leuchtenden Gestalten keine Seelien waren, was waren sie dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280308,
					"content": "Ich wurde wohl an einen seltsamen Ort geweht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280309
					]
				},
