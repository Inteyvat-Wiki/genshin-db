			},
			"dialogs": [
				{
					"id": 230390101,
					"content": "Hallo! Warte mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390102
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390102,
					"content": "#Entschuldigung ... Bist du {F#eine Abenteurerin}{M#ein Abenteurer}? Die Art {F#Abenteurerin, die}{M#Abenteurer, der} überall die Gefahr sucht und es versteht, zu kämpfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390103,
						230390104
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390103,
					"content": "Na ja ... irgendwie schon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				},
				{
					"id": 230390105,
					"content": "#Siehst du, Hilmi! Ich hab dir doch gesagt, dass {M#er ein Abenteurer}{F#sie eine Abenteurerin} ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390106
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390106,
					"content": "Aber tragen denn nicht alle Abenteurer diese grünen Sachen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390107,
						230390108
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390107,
					"content": "Ich bin krasser, ich brauch so etwas nicht zu tragen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390109,
					"content": "Oha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390110
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390110,
					"content": "Oha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390111
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390111,
					"content": "Dann kannst du uns sicher helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390112
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390112,
					"content": "Siehst du das große Lager im Dorf? Habachi sagt, darin befinden sich sehr wichtige Sachen und wir müssen es gut bewachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390113
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390113,
					"content": "Er hat uns auch gesagt, dass er zuerst den Aufzug anhält und dann die Hängebrücke kappt, wenn Bösewichter das Dorf angreifen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390114
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390114,
					"content": "Aber das Lager ist ein gutes Stück vom Aufzug entfernt. Wenn Habachi den Aufzug stoppen will, dann muss er rennen wie der Wind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390115
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390115,
					"content": "Wir haben Habachi vorgeschlagen, mit ihm zusammen zu trainieren, aber er hat uns einfach ignoriert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390116
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390116,
					"content": "Aber jedes Mal, wenn wir nur Steine ditschen gehen wollen, da rastet er aus ... Tss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390117
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390117,
					"content": "*hust* Kurzum: Wenn Bösewichter das Dorf angreifen und Habachi nicht mehr rennen kann, dann bleiben nur noch wir, um den Aufzug zu stoppen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390118
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390118,
					"content": "#Du bist {F#eine Abenteurerin}{M#ein Abenteurer}, du kannst doch sicher ganz schnell laufen. Bitte trainiere doch mit uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390119,
						230390121
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390119,
					"content": "Na gut, dann renne ich mit euch eine Runde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390120
					]
				},
				{
					"id": 230390120,
					"content": "Super! Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390126,
					"content": "Wir haben schon den Startpunkt ausgewählt, lass uns hingehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390127
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390127,
					"content": "Haha, dieses Mal hast du keine Chance gegen mich. Nur zur Info, ich flitze wie ein Hase!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390121,
					"content": "Ihr könnt euch auf Habachi verlassen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390122
					]
				},
				{
					"id": 230390122,
					"content": "Ähm ... Spiel doch mit uns ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390123
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390123,
					"content": "Komm schon, trainiere mit uns, bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390124
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390124,
					"content": "Na gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390125
					]
				},
				{
					"id": 230390125,
					"content": "Super! Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390108,
					"content": "Ich bin besonders, ich brauch so etwas nicht zu tragen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390104,
					"content": "So könnte man es sagen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				}
			]
