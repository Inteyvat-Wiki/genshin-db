					"nextDialogs": [
						230390404
					]
				},
				{
					"id": 230390404,
					"content": "Hehe, ich habe doch gesagt, dass ich schnell rennen kann. Hast du mich etwa unterschätzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390405
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390405,
					"content": "Aber egal wie schnell wir auch rennen, Habachi kriegt uns trotzdem. Wie macht er das bloß?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390406,
						230390407
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390406,
					"content": "Vielleicht nimmt er eine Abkürzung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390408
					]
				},
				{
					"id": 230390408,
					"content": "Meinst du? Hm ... Aber ich glaube, hier gibt es keine Abkürzung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390409
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390409,
					"content": "Dann bitten wir dich eben, beim nächsten Mal mit uns zu spielen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390410
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390410,
					"content": "Mit uns zu trainieren! Ähm ... „Verstecken in der Wildnis“ trainieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390411
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390411,
					"content": "Genau, wenn wir Habachi nicht davonlaufen können, umgehen wir ihn eben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390412
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390412,
					"content": "Haben wir nicht schon die ganze Zeit versucht, ihn zu umgehen? Aber egal wie, er hat uns doch immer entdeckt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390407,
					"content": "Vielleicht gibt es einen Trick ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390408
					]
				},
				{
					"id": 230390403,
					"content": "Du bist ... wirklich schnell ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390404
					]
