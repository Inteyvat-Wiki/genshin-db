			"dialogs": [
				{
					"id": 761690101,
					"content": "#{NICKNAME}, Paimon, schön, euch auch hier zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690102
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690102,
					"content": "Wir wollten ihn auch besuchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761690103
					]
				},
				{
					"id": 761690103,
					"content": "Wenn er das wüsste, würde er es zwar nicht sagen, aber tief im Inneren wäre er darüber bestimmt glücklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690104
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690104,
					"content": "Ihr steht eine Weile mit Illuga vor dem Grab ...\\nIlluga erzählt seinem Kameraden, der ihm vorausgegangen war, von den großen und kleinen Dingen, die sich in letzter Zeit in Piramida ereignet haben ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761690105
					]
				},
				{
					"id": 761690105,
					"content": "Jetzt, wo er weiß, dass es allen in Piramida gut geht, kann er bestimmt in Frieden ruhen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761690106,
					"content": "Ja. Er hat seinen Auftrag abgeschlossen, und wir werden unseren abschließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761690107
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761690107,
					"content": "Und nach uns wird es andere geben, die dieses Land beschützen, so wie das Winterweidenkraut, das Stürmen und bitterer Kälte trotzt und dennoch unaufhörlich weiterlebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
