			"dialogs": [
				{
					"id": 705340101,
					"content": "*seufz* Keine Ahnung, warum es wieder ein Brettspiel ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340102
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340102,
					"content": "#Ah! ... {F#Reisende}{M#Reisender}, du hast mich zu Tode erschreckt ... Bist du auch wegen der „Ass-Beschwörer-Meisterschaft“ hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340103,
						705340104
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340103,
					"content": "Was tust du hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				},
				{
					"id": 705340105,
					"content": "Schau her, das ist ein Spiel, das von einem Abenteurer aus der Gilde entworfen wurde. Er meinte, es sei eine Art ... neues Brettspiel, das Geniale Beschwörung mit Kämpfen verbindet. Es nennt sich „Strategem der Würfel“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340106
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340106,
					"content": "Wir sind doch Mitorganisatoren der „Ass-Beschwörer-Meisterschaft“ und die Gilde hat Gefallen an seinem Entwurf fürs „Strategem der Würfel“ gefunden. Damit soll eine kleine Sonderveranstaltung auf die Beine gestellt werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340107,
						705340108
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340107,
					"content": "Können denn Kartenspiel und Kampf miteinander kombiniert werden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340109,
					"content": "Hahaha, um ehrlich zu sein, verstehe ich es auch nicht wirklich. Aber ich habe hier ein Regelbuch ... und schau nur mal, wie dick es ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340110
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340110,
					"content": "Soweit ich weiß, dreht sich aber alles um „Würfel“ beim „Strategem der Würfel“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340111
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340111,
					"content": "Also, wenn du spielen willst, nur zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340108,
					"content": "Ich kann mir nicht vorstellen, wie das zusammenpassen soll ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340104,
					"content": "Was für ein Brettspiel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				}
			]
		}
	]
}