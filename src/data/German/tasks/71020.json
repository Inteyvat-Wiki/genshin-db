			"dialogs": [
				{
					"id": 710201001,
					"content": "Oh Mann, jetzt habe ich Probleme am Hals ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201002
					],
					"speakerTitle": "Nervöser An"
				},
				{
					"id": 710201002,
					"content": "Der Beamte Zhao hat mir gesagt, ich soll dir das hier geben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710201003
					]
				},
				{
					"id": 710201003,
					"content": "Hm? Er braucht einen Bericht über alle Schiffe im Hafen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201004
					],
					"speakerTitle": "Nervöser An"
				},
				{
					"id": 710201004,
					"content": "Also ... Eigentlich hatte ich schon von Anfang an begonnen, darüber Buch zu führen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201005
					],
					"speakerTitle": "Nervöser An"
				},
				{
					"id": 710201005,
					"content": "Aber dann ist da noch der Bericht über importierte Waren, die Mannschaftsberichte und der Bericht über Auswanderer und Zuwanderer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710201006
					],
					"speakerTitle": "Nervöser An"
				},
				{
					"id": 710201006,
					"content": "Es gibt einfach sooo viel, was man aufzeichnen muss. Berichte dies, melde das, ich kann einfach nicht mit all dem mithalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nervöser An"
				}
			]
		},
