			"dialogs": [
				{
					"id": 731000601,
					"content": "#Araminali ist noch nicht bereit! Die „Truhen“ sind immer noch nicht voll. Nara {NICKNAME} und Paimon können „faulenzen“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000602
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000602,
					"content": "Oh, nein, es ist „herumlaufen“. Vielleicht trefft ihr auf Aranara, die Hilfe brauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310007,
			"completionStepIds": [],
