			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000101,
					"content": "#Nara {NICKNAME} möchte die „Truhen“ öffnen? Aber ... so viele Aranara brauchen noch Hilfe in Vana. Wenn der goldene Nara ihnen zur Hand gehen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000102
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000102,
					"content": "Dann füllt Araminali alle „Truhen“! Die „Truhen“ werden sogar mit den „Schätzen“ von Aranimba gefüttert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310002,
			"completionStepIds": [
				7310014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310014",
							"2"
						],
						"stepId": 7310014,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000201,
					"content": "#Araminali weiß, dass der goldene Nara anderen Aranara geholfen hat. Also sind Araminalis „Truhen“ für Nara {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
