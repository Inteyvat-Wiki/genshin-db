				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000701,
					"content": "#Araminali ist satt, die „Truhen“ sind leer. Ein leerer Bauch ist nicht gut. Nara {NICKNAME} und Paimon sind viel gelaufen und haben bestimmt leere Bäuche. Ihr müsst Pilze essen, um Kraft zu gewinnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		}
	]
