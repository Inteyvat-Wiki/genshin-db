			"dialogs": [
				{
					"id": 721570101,
					"content": "Wie? Wo ist denn der Schutzstein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570102
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721570102,
					"content": "Hmm. Das wird wohl doch nicht so leicht, wie wir dachten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570103
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570103,
					"content": "Sehen wir uns mal ein bisschen um.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721570104
					]
				},
				{
					"id": 721570104,
					"content": "Stimmt, mehr können wir wohl nicht tun. Sehen wir mal, ob wir etwas finden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570105
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570105,
					"content": "Aber wir müssten ein riesiges Gebiet absuchen! Wie lange wird das wohl dauern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570106
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721570106,
					"content": "Nun, dann müssen wir wohl einfach Glück haben. So oder so wird es Zeit, dass wir anfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570107
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570107,
					"content": "„Wie man Schutzsteine findet“, scheint ebenfalls zu unseren „Versiegelungsproblemen“ zu gehören, hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570108
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570108,
					"content": "Nun, hoffen wir eben einfach, dass wir hier irgendwo Hinweise finden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570109
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570109,
					"content": "Na komm schon, Taisuke. Die Zeit läuft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721570110
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 721570110,
					"content": "Oh ... Gut, Etsuko. Wir haben wohl keine andere Möglichkeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				}
			]
