			},
			"dialogs": [
				{
					"id": 760570101,
					"content": "Wie wär’s, wenn ich nächstes Mal ein Teamtraining organisiere? Ein Duell wäre auch eine gute Idee! Oh, ihr seid es! Willkommen auf dem Trainingsplatz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570102,
						760570105,
						760570109
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570102,
					"content": "Über den Trainingsplatz ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570103
					]
				},
				{
					"id": 760570103,
					"content": "Es kommen immer mehr Gäste und das habe ich euch zu verdanken. Natürlich auch den Kindern und den „Erdverborgenen“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570104
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570104,
					"content": "Ich habe bemerkt, dass der Trainingsplatz ein perfekter Ort für Treffen ist. Wenn man sich nach vielen Jahren plötzlich mit alten Freunden wiedersieht, weiß man manchmal nicht, was man sagen soll, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570105,
					"content": "Über die „Erdverborgenen“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570106
					]
				},
				{
					"id": 760570106,
					"content": "Ah ... Bisher haben wir noch kein besseres Material für die Maulwurfsbaue gefunden als die Zielscheiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570107
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570107,
					"content": "Ich und die Kinder haben schon viele Materialien ausprobiert, aber die Maulwürfe mögen die Zielscheiben besonders gern. Bis jetzt müssen wir immer noch mit ihnen handeln, um sie zurückzubekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570108
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570108,
					"content": "Aber wir haben mit der Zeit gelernt, wie viel ihre Schätze wert sind, und machen damit einen guten Gewinn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570109,
					"content": "Ich komme dich bald wieder besuchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570110
					]
				},
				{
					"id": 760570110,
					"content": "Ja, komm jederzeit vorbei! Und denk dran, für euch ist es immer kostenlos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				}
			]
		},
		{
			"id": 7605719,
