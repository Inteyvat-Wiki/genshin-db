				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kleiner Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760202,
					"content": "He, ist es zu schwer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760203
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760203,
					"content": "Paimon war einfach in einem schlechten Zustand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760204,
					"content": "Willst du es nochmal versuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760205
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760205,
					"content": "#Aber natürlich! {NICKNAME}, wir müssen dem kleinen Kujirai zeigen, was wir drauf haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760206,
					"content": "Noch einmal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760207
					]
				},
				{
					"id": 721760207,
					"content": "Ja! Das Ziel ist es, den Temari innerhalb der vorgegebenen Zeit zu finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleiner Kujirai"
				}
			]
		},
		{
			"id": 7217607,
			"completionStepIds": [
				7217605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217605",
							"2"
						],
						"stepId": 7217605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kleiner Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760702,
					"content": "Gut, du hast ihn gleich gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760703
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760703,
					"content": "#Tja, {NICKNAME} ist sehr erfahren und ist schon in vielen Gebieten gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760704,
					"content": "Ooh! Könnte es sein, dass „Mondstadt“ dazugehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760705
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760705,
					"content": "Natürlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760706
					]
				},
				{
					"id": 721760706,
					"content": "Das ist fantastisch! Ich habe von der Chefin gehört, dass Mondstadt viele schöne Orte hat, wie die „Sturmschreckenruinen“ mit hohen, hohen Türmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760707,
						721760708
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760707,
					"content": "Ja, die gehören Dvalin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				},
				{
					"id": 721760709,
					"content": "Hmm, ich frage mich, ob der Turm höher ist oder der Tenshukaku des allmächtigen Shougun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760710
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760710,
					"content": "Kleiner Kujirai, warum bist du allein hier draußen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760711,
					"content": "Als meine Schwester fischen war, dachte sie, ich würde die Fische verscheuchen und ließ mich allein rausgehen und spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760712
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760712,
					"content": "Einmal traf ich auf die große Abenteurerin. Sie sah, dass ich mich langweilte, also gab sie mir viele Temari und sagte mir, ich solle „gierige Reisende finden, mit denen ich Temari spielen kann“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760713
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760713,
					"content": "Gierige Reisende ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760714
					]
				},
				{
					"id": 721760714,
					"content": "Es ist keine Gier! Es ist Sorge! Ich mache mir Sorgen, dass der kleine Kujirai sich alleine langweilt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760715,
					"content": "Ja, ich denke auch, dass ihr nett seid, ich bin echt glücklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760716
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760716,
					"content": "Allein in der Wildnis ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760717
					]
				},
				{
					"id": 721760717,
					"content": "Du bist ein kleines Kind, das sich in der Wildnis aufhält. Hast du keine Angst, in Gefahr zu geraten? Außerdem hast die diese tollen Sachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760718,
					"content": "Wirklich nett, aber keine Sorge, die große Abenteurerin hat mir beigebracht, dass der Temari mit einer speziellen Manipulation in eine Bombe verwandelt werden kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760719
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760719,
					"content": "Das ist gefährlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760720,
					"content": "Es ist nicht gefährlich! Ich habe damit so viele Hilichurle, Schleime und Bösewichte weggepustet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760721
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760721,
					"content": "Du bist es, der in Gefahr ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760722,
					"content": "Übrigens, wenn du mit anderen Freunden Temari spielen willst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760723
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760723,
					"content": "Ich lasse einen Temari hier! Hier sind die Regeln dafür ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760724
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760724,
					"content": "Wenn du einen Temari versteckst, musst du ihn innerhalb der Zeit eines Temariliedes verstecken. Und die Person, die ihn sucht, muss ihn innerhalb der Zeit eines Liedes finden. So läuft alles gerecht ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760725
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760725,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760726
					]
				},
				{
					"id": 721760726,
					"content": "Es ist so beängstigend zu denken, dass das, womit wir spielen, tatsächlich eine Bombe ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760727,
					"content": "Ihr habt nichts zu befürchten, das sagte sie mir auch: „Nur die Bösen werden in die Luft gehen. Wahrscheinlich.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760728
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760728,
					"content": "„Wahrscheinlich“?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760729,
					"content": "Nun, ich gehe jetzt woanders spielen! Tschüs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760708,
					"content": "Wirklich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				}
			]
		}
	]
}