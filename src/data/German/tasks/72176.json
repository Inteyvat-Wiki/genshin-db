				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Kleiner Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760101,
					"content": "Hi, ich habe hier etwas Gutes ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760102
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760102,
					"content": "Danke, kein Interesse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760103
					]
				},
				{
					"id": 721760103,
					"content": "Meine Güte, in einem so jungen Alter in eine zweifelhafte Branche gezwungen zu werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760104,
					"content": "Nein! Ich möchte mit dir Temari spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760105
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760105,
					"content": "„Temari“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760106,
					"content": "Einfach gesagt, ich verstecke den Temari irgendwo in der Nähe. Wenn du ihn innerhalb der Zeit eines Temariliedes finden kannst, dann gewinnst du.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760107
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760107,
					"content": "So spielt man also Temari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760108
					]
				},
				{
					"id": 721760108,
					"content": "Hm? Es wurde mir von einer großartigen Abenteurerin beigebracht. Und sie sagte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760109
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760109,
					"content": "„Kujirai, erinnere dich gut. Du musst sagen: ‚Wenn du gewinnst, bekommst du ein paar tolle Sachen.‘“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760110
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760110,
					"content": "Also, wenn du gewinnst, bekommst du diese tollen Sachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760111
					],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760111,
					"content": "#Das ist tolles Zeug! {NICKNAME}, ich denke es ist nur richtig, mit den Kindern zu spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760112,
						721760115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760112,
					"content": "Aber ich glaube trotzdem nicht, dass man so mit Temari spielt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760113
					]
				},
				{
					"id": 721760113,
					"content": "Es ist wahrscheinlich eine Spielart, die nur die Einheimischen kennen, da muss man sich nicht um die Details kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760114,
					"content": "Du bist der kleine Kujirai, nicht wahr? Wir werden mit dir spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760116,
					"content": "Super!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleiner Kujirai"
				},
				{
					"id": 721760115,
					"content": "Gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760116
					]
				}
			]
		},
		{
			"id": 7217602,
			"completionStepIds": [
				7217602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
