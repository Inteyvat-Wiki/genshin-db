			"dialogs": [
				{
					"id": 701430101,
					"content": "Über Abenteuer am Drachengrat ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430102
					]
				},
				{
					"id": 701430102,
					"content": "Falls du dir tatsächlich vornimmst, auf dem Drachengrat ein Abenteuer zu wagen, ist es lebenswichtig, dass du schon vorbereitet bist, bevor du ihn betrittst. Nimm den Berg nie auf die leichte Schulter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430103
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701430103,
					"content": "Der Drachengrat zeigt keine Gnade gegenüber leichtsinnigen Abenteurern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7014302,
			"completionStepIds": [
				7014302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7014302",
							"2"
						],
						"stepId": 7014302,
						"stateName": "QUEST_STATE_UNFINISHED"
