			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701430201,
					"content": "#Hallo, {F#Reisende}{M#Reisender}. Ich hoffe, deine Abenteuer verlaufen reibungslos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430202,
					"content": "Ziemlich reibungslos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430203
					]
				},
				{
					"id": 701430203,
					"content": "#Gut. Ich habe deine jüngsten Unternehmungen sogar verfolgt. Ich habe keinen Zweifel daran, dass du, wenn du so weitermachst, eines Tages {F#eine hervorragende Abenteurerin}{M#ein hervorragender Abenteurer} sein wirst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430204
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430204,
					"content": "Was andere Gildenaktivitäten angeht, so habe ich einige Abenteuerberichte, die ich gerne mit dir teilen würde, falls du daran interessiert bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430205,
					"content": "Noch eine Mission für mich? Erzähl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430206
					]
				},
				{
					"id": 701430206,
					"content": "Haha, dein Tonfall lässt vermuten, dass du mit der Art und Weise, wie die Gilde ihre Angelegenheiten regelt, inzwischen außerordentlich vertraut bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430207,
					"content": "Diesmal habe ich allerdings keine Mission für dich, sondern einfach nur ein paar Abenteuerberichte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430208
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430208,
					"content": "In diesem „Abenteuerbericht“ geht es um den „Drachengrat“ in der Nähe von Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430209
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430209,
					"content": "Die Gilde hat dort ein Lager errichtet und eine Reihe von Abenteurern stationiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430210,
					"content": "Ich habe den Ort auf deiner Karte markiert. Sobald du angekommen bist, suchst du bitte eine Abenteurerin namens Iris. Sie wird dich über die Situation in diesem Gebiet informieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430211
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430211,
					"content": "Das war’s von mir. Viel Spaß beim Abenteuer und ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
}