			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Inaba Kyuuzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610701,
					"content": "Der Feind in der Nähe ist wieder auf dem Vormarsch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610702
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610702,
					"content": "#He, Fremde{M#r}! Wenn du herumwanderst, sei bitte vorsichtig wegen der Piraten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610703
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610703,
					"content": "Danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610704
					]
				},
				{
					"id": 721610704,
					"content": "Natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610705
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610705,
					"content": "Sie sind keine Gegner für mich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610706
					]
				},
				{
					"id": 721610706,
					"content": "Haha, gib nicht an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610707
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610707,
					"content": "Warte, bis du sie alle losgeworden bist, bevor du solche Dinge zu mir sagst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610708
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610708,
					"content": "Abgemacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610709
					]
				},
				{
					"id": 721610709,
					"content": "Gut. Abgemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				}
			]
		},
		{
