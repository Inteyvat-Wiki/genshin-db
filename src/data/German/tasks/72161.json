				"points": []
			},
			"dialogs": [
				{
					"id": 721610401,
					"content": "Du bist zurück. Pass auf der Insel auf dich auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610402
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610402,
					"content": "Ist das genug?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7216105,
			"completionStepIds": [
				7216105
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216105",
							"2"
						],
						"stepId": 7216105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Inaba Kyuuzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610505,
					"content": "Es wird lange dauern, bis die Kräuter zu einer Paste zerstampft sind. Du kannst jetzt gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610506
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610506,
					"content": "Nein, ich schmeiße dich nicht raus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610507
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610507,
					"content": "Komm in einer Weile wieder, es wird auch schön sein, jemanden zu haben, mit dem man reden kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610508,
						721610509
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610508,
					"content": "Verstanden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610510
					]
				},
				{
					"id": 721610510,
					"content": "Pass auf dich auf, Fremde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610509,
					"content": "Gute Besserung!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610510
					]
				}
			]
		},
		{
			"id": 7216106,
			"completionStepIds": [
				7216107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216107",
							"2"
						],
						"stepId": 7216107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Inaba Kyuuzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610601,
					"content": "#Fremde{M#r}, wie geht’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610602
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610602,
					"content": "Tut mir leid, dies ist kein guter Ort für Gastfreundschaft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610603
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610603,
					"content": "Aber ... Ich bin froh, dass du hier bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610604
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610604,
					"content": "Du siehst jetzt viel besser aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610605
					]
				},
				{
					"id": 721610605,
					"content": "Nun, ein weiterer Gefallen, den ich dir schulde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610606
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610606,
					"content": "Haha, wie schade, dass ich wieder durchgehalten habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610607
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610607,
					"content": "Ist das nicht eine gute Sache? Was ist schade daran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610608,
						721610609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610608,
					"content": "Was kommt als Nächstes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				},
				{
					"id": 721610610,
					"content": "Ich habe noch nicht herausgefunden, was ich als Nächstes machen sollte, aber ich glaube nicht, dass ich zurückgehen werde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610611
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610611,
					"content": "Obwohl Kujou Masahito kein schlechter Kerl ist, schreit sein Vater danach, dass Deserteure verhaftet werden, um seine Autorität zu etablieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610612
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610612,
					"content": "Ich kann nicht in sein Messer laufen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610613
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610613,
					"content": "Vielleicht lege ich diese Rüstung ab. Es ist schön, einfach mein Leben allein zu leben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610614
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610614,
					"content": "Bis der Frieden mir nicht mehr erlaubte, mir etwas vorzumachen, und die Erinnerung mir sagte, dass ich immer noch der blutbefleckte, verwundete Soldat war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610615
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610615,
					"content": "Ach ... Wie auch immer, was danach kommt, wer weiß?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610616,
						721610617
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610616,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610618,
					"content": "Andererseits habe ich nie alle Entscheidungen Ihrer Exzellenz infrage gestellt, also gibt es wohl keine Gewissensbisse, auch wenn ich gehe, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610619
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610619,
					"content": "Nun ... Das Thema ist plötzlich sehr schwer geworden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610620,
					"content": "Ah, da wir gerade dabei sind ... Es ist Zeit für mich, alte Kameraden zu besuchen, die noch mit mir auf dieser Insel waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610621
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610621,
					"content": "Inazumas Tradition ist es, ein „Dendrobium“ anzubieten, eine zarte und betörende Blume ... Ein Symbol für das Schicksal des Kampfkünstlers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610622
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610622,
					"content": "Übrigens, wenn du bei deinen nächsten Reisen auf einen meiner alten Kameraden triffst, mach dir die Mühe, vorbeizuschauen und auch sie kennenzulernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610617,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610609,
					"content": "Hast du jemals daran gedacht zurückzugehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				}
			]
		},
		{
			"id": 7216107,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
