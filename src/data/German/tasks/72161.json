			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Inaba Kyuuzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721610101,
					"content": "Hm, was für eine Schande ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610102
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610102,
					"content": "Wir haben ganz offensichtlich dein Leben gerettet und du nennst uns eine Schande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610103,
						721610104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610103,
					"content": "Er redet von sich selbst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				},
				{
					"id": 721610105,
					"content": "Ich hätte nie gedacht, dass ich einmal in einer Situation landen würde, in der ich von Fremden gerettet und von ihnen beurteilt werde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610106
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610106,
					"content": "Nun ... Übrigens, Herr Samurai, geht es dir gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610108,
						721610109
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610108,
					"content": "Scheint fit zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610110,
					"content": "#Ich schulde dir was, Fremde{M#r}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610111
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610111,
					"content": "Außerdem, guter Kampf gerade eben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610112
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610112,
					"content": "#Ich bin {NICKNAME}. Es ist schön, dich kennenzulernen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610113
					]
				},
				{
					"id": 721610113,
					"content": "#Schau nicht auf andere herab, Fremde{M#r} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610114
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610114,
					"content": "Inaba Tousaburou Kyuuzou, nenn mich einfach Kyuuzou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610115,
						721610116
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610115,
					"content": "Was sind das für Leute?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610117,
					"content": "Es sind Piraten und es gibt ziemlich viele ihrer Festungen entlang dem Nazuchi-Strand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610118
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610118,
					"content": "Umherziehende Diebe, Minenarbeiter und Fischer, die ihre Hauptbeschäftigung verloren haben, Flüchtlinge aus dem „Augenhatz-Dekret“ oder Deserteure von beiden Seiten des Krieges stapeln sich manchmal und degenerieren zu Dieben und Banditen ... bei dem Versuch, der Kontrolle der großen Ogosho zu entkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610119
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610119,
					"content": "Die „Vagabundierenden“ und die „Kairagi“ sind ein gesetzloser Haufen ... Und wir haben sie schon eine Weile verfolgt, bis die Rebellen die Omamori der Insel zerstört haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610120
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610120,
					"content": "Die Flüchtlinge aus Tatarasuna und der Mine flohen in schneller Folge, und einige dieser Ratten huschten zu diesem Ort, was die Reihen dieser Piratenbanden anschwellen ließ und sie noch rücksichtsloser machte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610121
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610121,
					"content": "Die Gruppe von Piraten war gerade aus dem südlichen Lager gekommen und hatte ein Auge auf die Ladung des Schiffes geworfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610122
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610122,
					"content": "Nur schade, dass ich ihnen in die Quere kam, hm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610123
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610123,
					"content": "Das ist nicht dein Boot?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610124
					]
				},
				{
					"id": 721610124,
					"content": "Dieses Schiff? Es war ursprünglich ein Rebellenschiff der Sangonomiya. Ich bin mir nicht ganz sicher ... Jedenfalls war das Schiff verlassen, als ich hier ankam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610125
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610125,
					"content": "Also blieb ich und lebte bis jetzt wie ein Einsiedlerkrebs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610126
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610126,
					"content": "Das ist das erste Mal seit langer Zeit, dass ich so viel gesagt habe. Es ist anstrengend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610127
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610127,
					"content": "Übrigens, wenn es dir nichts ausmacht, tu mir nebenbei einen Gefallen ... Ich werde dir die Gefallen, die ich dir schulde, alle zurückzahlen, wenn es mir besser geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610128
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610128,
					"content": "Du musst mir helfen, das nahe gelegene Piratenlager zu räumen, das ich vorhin erwähnt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610129
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610129,
					"content": "Nur dann werden mich die wilden hundeartigen Piraten nicht weiter belästigen. Vielleicht schreckt es auch andere Piratenlager davon ab, dieses kaputte Schiff einfach zu überfallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610130
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610130,
					"content": "Dann könnte ich auch sehen, was du draufhast. Wie wäre das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610131,
						721610132
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610131,
					"content": "Ein Klacks!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610133,
					"content": "Hm, das ist alles eine große Lüge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610134
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610134,
					"content": "#Übrigens, Fremde{M#r} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610135
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610135,
					"content": "Werde jetzt nicht übermütig. Ein falscher Schritt und du könntest dir das Bein brechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610132,
					"content": "Bin bald zurück.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610116,
					"content": "Warum bist du unter Belagerung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610109,
					"content": "Es ist offensichtlich, dass sein Stolz verletzt ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610104,
					"content": "Es ist die charakteristische Anmaßung der Samurai ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				}
			]
		},
		{
			"id": 7216102,
