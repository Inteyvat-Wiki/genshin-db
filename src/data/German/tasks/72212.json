			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120301,
					"content": "*seufz* Wann finde ich endlich Arbeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120302
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120302,
					"content": "Suchst du nach mir? Worum geht es denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120303,
						722120304
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120303,
					"content": "Kennst du dich mit Bildhauerei aus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				},
				{
					"id": 722120305,
					"content": "Hm? Nun, das ist großartig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120306
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120306,
					"content": "Warte, entschuldige, ich habe vergessen, mich vorzustellen. Ich bin Ooshima Junpei und habe vorher in Tatarasuna gearbeitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120307
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120307,
					"content": "Nach dem Unfall wurden wir alle evakuiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120308
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120308,
					"content": "Aber bisher habe ich noch keine Nachricht erhalten, dass wir wieder zur Arbeit zurückkehren könnten, also war ich die ganze Zeit hier untätig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120309
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120309,
					"content": "Du suchst also jemanden, der ein paar Bildhauerarbeiten machen kann, richtig? Nun, das ist nicht meine Spezialität, aber ich bin ein bisschen geübt darin und habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120310
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120310,
					"content": "Welche Art von Bildhauerei möchtest du anfertigen lassen? Könntest du mir das sagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120311
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120311,
					"content": "Nun, die Sache ist die ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120312
					]
				},
				{
					"id": 722120312,
					"content": "Äh ... Also, lass mich das mal zusammenfassen. Eine sprechende Katze will, dass du einen Handwerker findest, der eine Statue von ihr meißelt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120313
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120313,
					"content": "Es ist ja nicht so, dass ich dir nicht glaube oder so. Es ist nur ein bisschen ... abenteuerlich ... Du weißt schon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120314
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120314,
					"content": "Und selbst wenn ich einverstanden wäre, wie soll diese ... diese vorläufige Oberpriesterin mich bezahlen? Ich arbeite nicht umsonst, egal was jemand sagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120315
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120315,
					"content": "Ganz ruhig, es wird alles gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120316
					]
				},
				{
					"id": 722120316,
					"content": "(Wird es das wirklich?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120317,
					"content": "Wird es? Ich ... Hmm, es fühlt sich einfach so an, als ob du mich beschwindelst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120318
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120318,
					"content": "Dennoch ... Weißt du was? Egal. Ich habe sowieso nichts zu tun. Da kann ich genauso gut mitkommen und mir das ansehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120319
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120319,
					"content": "Ich hoffe echt, dass ich bezahlt werde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 722120304,
					"content": "Wir suchen einen Handwerker, der mit Stein arbeiten kann.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				}
			]
		},
		{
			"id": 7221204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221205",
							"2"
						],
						"stepId": 7221205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Neko“",
					"Ooshima Junpei",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120401,
					"content": "Ah, du bist wieder da. Dies muss der Steinmensch sein, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120402,
						722120403
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120402,
					"content": "Das ist der Handwerker, den wir angeworben haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				},
				{
					"id": 722120404,
					"content": "Was?! Die Katze ... kann wirklich sprechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120405,
					"content": "Miau, miau, miau, so viel Lärm um nichts! Ist es so seltsam, dass meine Wenigkeit spricht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120406,
						722120407
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120406,
					"content": "Kein Grund zur Sorge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120408,
					"content": "Warte! Soll das heißen, dass das etwas ganz Normales für dich ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120409
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120409,
					"content": "So ist es bisher auf jeden Fall gewesen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120410
					]
				},
				{
					"id": 722120410,
					"content": "Was um alles in der Welt hast du erlebt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120411
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120411,
					"content": "Komm jetzt, wir sind nicht hier, um nur zu quatschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120412
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120412,
					"content": "Zurück zu unserem Hauptthema. Steinmensch, kannst du Stein schlagen und ihn so aussehen lassen wie meine Wenigkeit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120413
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120413,
					"content": "Hä? Steinmensch? Du meinst mich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120414
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120414,
					"content": "„Stein schlagen“, sagst du... Nun, ich kann es mit Meißeln probieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120415
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120415,
					"content": "Ist das so? Wunderbar, miau, miau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120416
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120416,
					"content": "S... So ist das also, hm ... Na ja, eine Arbeit zu haben ist besser als keine. Ich meine, ich habe noch nie für eine Katze gearbeitet, also ... Ich denke, wir werden meine Vergütung später besprechen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120417
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120417,
					"content": "Hmm. Wie auch immer, ich muss einige Vorbereitungen treffen. Es gibt ziemlich viele Steine hier auf der Insel. Ich muss mir einen geeigneten aussuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120418
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120418,
					"content": "Ah, ja. Wie soll ich dich ansprechen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120419
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120419,
					"content": "Mein Name ist Neko, meine Wenigkeit ist die vorläufige Oberpriesterin des Asase-Schreins.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120420
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120420,
					"content": "Was die Anrede betrifft, so kannst du mich nennen, wie du willst, großer, steineknackender Mensch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120421
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120421,
					"content": "Wirklich? Na gut, dann werde ich dich wohl Frau Priesterin nennen. Du bist schließlich meine Chefin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120422
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120422,
					"content": "Eine „Schäfin“? Ich bin eine Katze, kein Schaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120423
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120423,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120424
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120424,
					"content": "Ich schaue mich um und suche mir einen Stein aus, den ich verwenden kann. Du bleibst erst einmal hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120425
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120425,
					"content": "Für eine Katze zu arbeiten ... Nun, es gibt für alles ein erstes Mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120426
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722120426,
					"content": "Herr Ooshima scheint diese Vergütung völlig vergessen zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120407,
					"content": "Das ist doch nur eine sprechende Katze.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120408
					]
				},
				{
					"id": 722120403,
					"content": "Ja, der Steinmensch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120404
					]
				}
			]
		},
