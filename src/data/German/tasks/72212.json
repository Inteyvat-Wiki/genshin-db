					"„Neko“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120601,
					"content": "Trotzdem bin ich neugierig. Wie wird ein Ding, das so hart wie Stein ist, mein Aussehen annehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120602
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120602,
					"content": "Ist dieser Steinmensch besonders mächtig? Kann er auch Magie anwenden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120603,
						722120605
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120603,
					"content": "Oh, er ist sehr mächtig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120604
					]
				},
				{
					"id": 722120604,
					"content": "Ah, ich verstehe. Sehr schön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120605,
					"content": "Es ist wie damals bei dem Essen, das wir zubereitet haben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120606
					]
				},
				{
					"id": 722120606,
					"content": "Ah, ich begreife. Die Gerichte, die du und Hibiki zubereitet haben, waren alle gut. Der Stein, den der Steinmensch herstellen wird, muss dann auch eine gute Sache sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120607
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120607,
					"content": "Menschen sind manchmal ziemlich geschickt, wie es scheint. Der Dank dafür gebührt dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		}
	]
