			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"„Neko“",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120101,
					"content": "Du bist gerade zur rechten Zeit gekommen. Ich brauche noch einmal deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120102
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120102,
					"content": "Mach schon, los!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120103
					]
				},
				{
					"id": 722120103,
					"content": "Ich möchte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120104
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120104,
					"content": "Dass du einen hoch aufragenden Stein, der nach ihrem Abbild geformt ist, neben diesen Schrein stellst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120105
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120105,
					"content": "Wo sollen wir denn so etwas finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120106,
					"content": "Sie meint eine Statue, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120107
					]
				},
				{
					"id": 722120107,
					"content": "Meine Wenigkeit wünscht sich jedenfalls etwas Ähnliches wie die Fuchssteine auf der weit, weit entfernten Insel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120108
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120108,
					"content": "Hibiki sagte immer, dass es viele davon auf der Insel gäbe, und sie fragte sogar, ob ich eine nach meinem Bild machen lassen wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120109
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120109,
					"content": "Ich glaube, dass, wenn Hibiki das wollte, es gut sein muss. Deshalb bitte ich dich, einen solchen Stein anfertigen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120110,
						722120113
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722120110,
					"content": "Ich bin kein guter Bildhauer ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120111
					]
				},
				{
					"id": 722120111,
					"content": "Hmmm, was tun wir nur ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120112,
					"content": "Gut, warum fragen wir nicht Taisuke? Er ist ein großer Katzenfan. Vielleicht ist er sogar bereit, mit der Bildhauerei anzufangen, nur um Neko zu helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120113,
					"content": "Nun, ich denke, wir könnten Taisuke suchen gehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120114
					]
				},
				{
					"id": 722120114,
					"content": "Das stimmt! Er liebt Katzen so sehr. Vielleicht kann er uns helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7221202,
			"completionStepIds": [
				7221202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221202",
							"2"
						],
						"stepId": 7221202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taisuke",
					"Etsuko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120201,
					"content": "Ah, hallo. Was hast du heute vor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120202
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120202,
					"content": "Ich helfe Neko dabei, eine Statue zu bauen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120203
					]
				},
				{
					"id": 722120203,
					"content": "Äh ... Was? Eine Statue, hier? Echt jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120204
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120204,
					"content": "I... Ich fange gleich mit der Bildhauerei an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120205
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120205,
					"content": "Ich bezweifle, dass du rechtzeitig fertig wirst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120206
					]
				},
				{
					"id": 722120206,
					"content": "Hmm? Ist das noch einer von Nekos Aufträgen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120207
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120207,
					"content": "Weißt du was, ich glaube nicht, dass es so schwierig sein wird, arbeitssuchende Handwerker zu finden, bei all den Problemen, die wir in Tatarasuna haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120208
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120208,
					"content": "Die Gilde hat in diesem Zusammenhang schon einige Missionen erhalten und ich hörte, dass einige Leute noch in Tatarasuna sind und nach Arbeit suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120209
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120209,
					"content": "Bei einer Mission bin ich genau auf ein solches Lager gestoßen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120210
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120210,
					"content": "Wenn du also möchtest, kannst du dort dein Glück versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120211,
						722120212
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120211,
					"content": "Danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120214
					]
				},
				{
					"id": 722120214,
					"content": "Hehe, beachte es gar nicht. So schwer war es nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120215
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120215,
					"content": "Und weißt du was? Ich würde gern sehen, was passiert, wenn dieser Schrein tatsächlich wieder aufblüht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120216
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120216,
					"content": "Besonders diese „Hibiki“, von der Neko ständig redet. Was für ein Mensch könnte von dieser Katze so geliebt werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120217
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120217,
					"content": "Keine Sorge, ich führe nur Selbstgespräche. Geh und such diesen Handwerker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120218
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120218,
					"content": "Und was die Frage angeht, ob er wissen wird, wie man einen Stein behaut oder nicht ... Nun, ich denke, das hängt vom Glück ab, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120219
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120219,
					"content": "Los, Fräulein Etsuko, du willst doch auch Frau Neko helfen, nicht wahr? Haha, du bist so ein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120220
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120220,
					"content": "Taisuke, ist unser Untersuchungsplan schon fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120221
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722120221,
					"content": "Äh, ich bin fast fertig. Tut mir leid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120212,
					"content": "Du wirkst anders als sonst, Etsuko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120213
					]
				},
				{
					"id": 722120213,
					"content": "Was, du bist es nicht gewohnt, dass ich dir zuerst Informationen gebe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120214
					],
					"speakerTitle": "Etsuko"
				}
			]
		},
		{
