				"points": []
			},
			"dialogs": [
				{
					"id": 191451601,
					"content": "Ich hoffe, die Göttin behütet diese Oma und ihre Enkelin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451602
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451602,
					"content": "Was Omas Augen angeht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191451603
					]
				},
				{
					"id": 191451603,
					"content": "Habt ihr das auch mitbekommen? Ja, Oma kann nicht gut sehen. Wir sind jedes Mal etwas besorgt, wenn sie auf den Berg kommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451604
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451604,
					"content": "Aber sie wollte uns immer nur ungern stören und sagte, dass sie nach so vielen Jahren des Wanderns den Berg allein hinauf- und hinabgehen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451605
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451605,
					"content": "Glücklicherweise gibt es auch Schreinjungfern an der Bergstraße, die einigermaßen auf sie aufpassen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451606
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451606,
					"content": "Möge die Göttin der Blitze sie segnen, ich wünsche der Oma und ihrer Enkelin eine gute Reise ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				}
			]
		},
