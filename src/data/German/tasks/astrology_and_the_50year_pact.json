					"speakerTitle": "Mona"
				},
				{
					"id": 105000315,
					"content": "Das ging aber schnell!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000317
					]
				},
				{
					"id": 105000317,
					"content": "Dabei haben wir doch alle die Arbeit geleistet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000318,
					"content": "Als Schüler sollte man sich auch wie ein Schüler verhalten. Du solltest den Verdienst deiner Meisterin nicht für dich beanspruchen.",
