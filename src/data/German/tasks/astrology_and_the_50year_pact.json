				{
					"id": 105000305,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000308
					]
				},
				{
					"id": 105000308,
					"content": "Oh, das sollte ich vielleicht klarstellen. Meine Familie besitzt drei Jademinen. Um sicherzustellen, dass ich eine gute Frau finde, hat meine Mutter mir sehr viel Schmuck aus Jade vererbt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000309
					],
					"speakerTitle": "Herr Zhu"
				},
				{
					"id": 105000309,
					"content": "Das müssen insgesamt an die fünfhundert Stück sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000310
					],
					"speakerTitle": "Herr Zhu"
				},
				{
					"id": 105000310,
					"content": "Und warum machst du dann hier ein Gasthaus auf?",
