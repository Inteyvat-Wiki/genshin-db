			"dialogs": [
				{
					"id": 105000201,
					"content": "(An so einer Stelle läuft das Geschäft für ein Gasthaus natürlich nicht allzu gut ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000202,
					"content": "Mona, du kommst gerade richtig! Hast du auf deinem Weg hierher einen Ring aus Jade gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000203
					],
					"speakerTitle": "Herr Zhu"
				},
				{
					"id": 105000203,
					"content": "Einen Ring aus Jade? Nicht dass ich wüsste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000204,
					"content": "Das ist schlecht ... Diesen Ring hat mir nämlich ein Schleim abgeknöpft. Meine Mutter hat ihn mir hinterlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000205
					],
					"speakerTitle": "Herr Zhu"
				},
				{
					"id": 105000205,
					"content": "Oh? Aber das müsste für Mona mit ihren hellseherischen Fähigkeiten doch kein Problem sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000206,
					"content": "Das geht nicht so einfach. Astrologie wird dazu verwendet, die Wahrheit der Welt und Wissen über das Schicksal zu erfahren. Sie darf nicht für so triviale Angelegenheiten angewendet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000207,
					"content": "Aber hast du nicht vorher gesagt, dass der Inhaber sich gut um dich kümmert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000208,
					"content": "Es geht hier um Würde und eine geistige Einstellung. Wenn ein Astrologe glaubt, er könne alle Probleme der Welt lösen, wird ihn die Gunst der Sterne verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000209,
					"content": "Seine Weissagungen werden niemanden mehr leiten und er wird kein Rätsel mehr lüften können. Es geht hier ums Prinzip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000210,
					"content": "Da hat man schon so tolle Fähigkeiten und kann damit auch keine Brötchen verdienen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000211,
					"content": "Schade, dabei hätte ich zwanzigtausend Mora springen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000212
					],
					"speakerTitle": "Herr Zhu"
				},
				{
					"id": 105000213,
					"content": "Was denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000214,
					"content": "Du siehst so bleich aus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000212,
					"content": "Zwanzigtausend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000213,
						105000214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000216,
					"content": "Du warst gerade dabei, von der Würde eines Astrologen zu sprechen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000217,
					"content": "Du warst gerade dabei, von deinen Prinzipien zu sprechen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000215,
					"content": "Ich? ... Mir geht’s gut. Ich denke nur, derjenige, der den Ring findet, wird richtig Glück haben, so viel Geld zu bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000216,
						105000217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000218,
					"content": "Hust, das ist zwar wahr, aber ... der Inhaber arbeitet wirklich sehr hart, es muss ein wahrlich besonderer Ring sein, wenn er bereit ist soviel dafür auszugeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000219,
					"content": "Einfach so abzulehnen, wäre sicher nicht nett. Wir sollten uns trotzdem anstrengen und helfen, selbst ohne Astrologie anzuwenden. Es gibt sicher einen anderen Weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000220,
					"content": "Paimon weiß, wohin das führt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000222,
					"content": "Ja, sicher ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000223,
					"content": "Jetzt bin ich wieder dran ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000221,
					"content": "#{NICKNAME}, kümmer du dich doch darum! Das ist der erste Auftrag, den ich dir als deine Meisterin übergebe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000222,
						105000223
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000224,
					"content": "Hmm, der Ring wurde doch von einem Schleim verschluckt. Dann könnten wir die Schleime in der Nähe mit einem Elementarköder anlocken, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000825,
					"content": "Weißt du, dass das Weingut Morgenröte bei der Weinherstellung ein Abfallprodukt mit einer besonderen Wirkung entdeckt hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000826,
					"content": "Die Formel ist zwar geheim, aber das Produkt zieht Schleime auf magische Weise an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000227,
					"content": "Du bist echt unfassbar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000228
					]
				},
				{
					"id": 105000229,
					"content": "Ich hoffe, das war nicht als Zwischenmahlzeit gedacht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000230
					]
				},
				{
					"id": 105000226,
					"content": "Also, Paimon will ganz offen mit dir sein ... Paimon hat welchen dabei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000227,
						105000229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000228,
					"content": "Als Partner ist Paimon unverzichtbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000230,
					"content": "Jetzt halte dich nicht an solchen Kleinigkeiten auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000231,
					"content": "Ihr scheint ja schon einen Plan zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000232
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000232,
					"content": "Ja, das wird ein Klacks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1050009,
			"completionStepIds": [
				1050002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050002",
							"2"
						],
						"stepId": 1050002,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"50001",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000902,
					"content": "Lange nicht gesehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000904
					]
				},
				{
					"id": 105000903,
					"content": "Mona, hallo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000904
					]
				},
				{
					"id": 105000901,
					"content": "Deine Geheimnisse so leicht zu erraten, ruft das keine Erinnerungen wach?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000902,
						105000903
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000904,
					"content": "Ah, Paimon erinnert sich! Du bist diese Astrologin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000905,
					"content": "Ganz recht, das bin ich, die Astrologin Mona Megistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000906
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000906,
					"content": "Dieses Mal möchte ich euch bitte, mir nach Mondstadt zu folgen, wo ich eine Kiste an mich nehmen will, die meiner Meisterin gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000907
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000109,
					"content": "Es geht dabei um eine Vereinbarung, die sie mit einer Freundin vor fünfzig Jahren getroffen hatte. Da sie jetzt aber so alt ist und nicht mehr so gut zu Fuß unterwegs ist, hat sie mich geschickt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000110,
					"content": "Und was hat die ganze Kistengeschichte mit uns tu tun? Warum müssen wir da mitkommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000111,
					"content": "Der Grund dafür ist einfach: Ich will mich mit dem Hüter der Kiste anlegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000911,
					"content": "Du willst also deine Stärke beweisen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000912
					]
				},
				{
					"id": 105000913,
					"content": "Es geht dir also ums Ansehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000914
					]
				},
				{
					"id": 105000112,
					"content": "Meine Meisterin und ihre Freundin sind seit jeher Rivalen in den mystischen Künsten und haben noch keinen Gewinner ausmachen können. Wenn ich gewinnen könnte, wäre ich doch besser als alle beiden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000113,
						105000115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000114,
					"content": "Ähem, um es genauer zu sagen, ich will die Stärke der Astrologie unter Beweis stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000116,
					"content": "Was redest du da? Es geht hier um eine einmalige Gelegenheit, die Stärke der Astrologie zu beweisen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000117,
					"content": "Aber so weit ich von meinen Beobachtungen der Sterne weiß, hat der Freund meiner Meisterin Mondstadt verlassen und die Kiste in die Obhut ihres Nachfolgers gegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000118,
					"content": "Wie ich muss dieser Nachfolger jemand sein, der seine Meisterin übertroffen hat. Ich darf nicht nachlässig werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000918,
					"content": "Aber ... ich weiß doch gar nicht, wie Astrologie geht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000919
					]
				},
				{
					"id": 105000920,
					"content": "Wie bist du da auf mich gekommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000921
					]
				},
				{
					"id": 105000119,
					"content": "Ich muss gewinnen, wenn ich mich mit diesem Nachfolger messe. Und da habe ich an dich gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000120,
						105000122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000121,
					"content": "#Wie kommt das Thema auf einmal auf {F#sie}{M#ihn} zu sprechen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000123,
					"content": "Das Wissen, das ich von meiner Meisterin erhalten habe, muss wiederum von mir weitergegeben werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000124,
					"content": "#Wenn ich mit {F#einer eigenen Schülerin}{M#einem eigenen Schüler} bei ihr aufkreuzen würde, hätte ich sie doch schon übertroffen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000125
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000924,
					"content": "Abgelehnt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000926
					]
				},
				{
					"id": 105000925,
					"content": "#Wieso bin ich jetzt plötzlich {F#deine Schülerin}{M#dein Schüler}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000926
					]
				},
				{
					"id": 105000125,
					"content": "#Und du bist {F#die große Heldin}{M#der große Held} von Mondstadt, ungefähr so wie ich. Das heißt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000126,
						105000127
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000128,
					"content": "#Ach, jetzt versteh doch! Du musst ja nicht wirklich {F#meine Schülerin}{M#mein Schüler} sein, sondern nur so tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000129,
					"content": "Außerdem wird sich das Ganze auch für dich lohnen, wenn du mir hilfst, die Kiste zu bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000130,
					"content": "Sobald ich diesen Nachfolger getroffen habe, um mein Wissen mit ihm auszutauschen, werde ich dein Schicksal genauer bestimmen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000131
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000131,
					"content": "Dann werde ich dir selbst auf schwierige Fragen antworten können, zum Beispiel was Götter und Geschwister angeht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000132
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000133,
					"content": "Diese Bedingungen klingen ganz gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000134,
					"content": "Vielleicht sollten wir wirklich mitmachen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000132,
					"content": "Unfassbar! Das wäre viel einfacher, als in jeder Stadt einzeln zu suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000133,
						105000134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000135,
					"content": "Hehe, eine weise Wahl. Dann gehen wir mal los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000136
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000136,
					"content": "Bevor wir aufbrechen, möchte ich noch an einen bestimmten Ort gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		}
	]
}