						],
						"stepId": 1050003,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46622",
							"3"
						],
						"stepId": 46622,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Herr Zhu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000201,
					"content": "(An so einer Stelle läuft das Geschäft für ein Gasthaus natürlich nicht allzu gut ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000202,
					"content": "Mona, du kommst gerade richtig! Hast du auf deinem Weg hierher einen Ring aus Jade gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000203
					],
					"speakerTitle": "Herr Zhu"
				},
				{
					"id": 105000203,
					"content": "Einen Ring aus Jade? Nicht dass ich wüsste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000204,
					"content": "Das ist schlecht ... Diesen Ring hat mir nämlich ein Schleim abgeknöpft. Meine Mutter hat ihn mir hinterlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000205
					],
					"speakerTitle": "Herr Zhu"
				},
				{
					"id": 105000205,
					"content": "Oh? Aber das müsste für Mona mit ihren hellseherischen Fähigkeiten doch kein Problem sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000206,
					"content": "Das geht nicht so einfach. Astrologie wird dazu verwendet, die Wahrheit der Welt und Wissen über das Schicksal zu erfahren. Sie darf nicht für so triviale Angelegenheiten angewendet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000207,
					"content": "Aber hast du nicht vorher gesagt, dass der Inhaber sich gut um dich kümmert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000208,
					"content": "Es geht hier um Würde und eine geistige Einstellung. Wenn ein Astrologe glaubt, er könne alle Probleme der Welt lösen, wird ihn die Gunst der Sterne verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000209,
					"content": "Seine Weissagungen werden niemanden mehr leiten und er wird kein Rätsel mehr lüften können. Es geht hier ums Prinzip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000210,
					"content": "Da hat man schon so tolle Fähigkeiten und kann damit auch keine Brötchen verdienen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000211,
					"content": "Schade, dabei hätte ich zwanzigtausend Mora springen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000212
					],
					"speakerTitle": "Herr Zhu"
				},
				{
					"id": 105000212,
					"content": "Zwanzigtausend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000213,
						105000214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000213,
					"content": "Was denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000215,
					"content": "Ich? ... Mir geht’s gut. Ich denke nur, derjenige, der den Ring findet, wird richtig Glück haben, so viel Geld zu bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000216,
						105000217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000216,
					"content": "Du warst gerade dabei, von der Würde eines Astrologen zu sprechen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000218,
					"content": "Hust, das ist zwar wahr, aber ... der Inhaber arbeitet wirklich sehr hart, es muss ein wahrlich besonderer Ring sein, wenn er bereit ist soviel dafür auszugeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000219,
					"content": "Einfach so abzulehnen, wäre sicher nicht nett. Wir sollten uns trotzdem anstrengen und helfen, selbst ohne Astrologie anzuwenden. Es gibt sicher einen anderen Weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000220,
					"content": "Paimon weiß, wohin das führt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000221,
					"content": "#{NICKNAME}, kümmer du dich doch darum! Das ist der erste Auftrag, den ich dir als deine Meisterin übergebe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000222,
						105000223
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000222,
