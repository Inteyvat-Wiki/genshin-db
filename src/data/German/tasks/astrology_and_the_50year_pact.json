					"nextDialogs": [
						105000303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000303,
					"content": "Herr Zhu, mit solchen wertvollen Besitztümern sollte man vorsichtiger umgehen. Man hat nicht jedes Mal so viel Glück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000304,
					"content": "Du hast vollkommen recht. Wie könnte ich meiner Familie gegenübertreten, würde ich den zweihundertdreiundfünfzigsten Ring, den mir meine Mutter gegeben hat, endültig verlieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
