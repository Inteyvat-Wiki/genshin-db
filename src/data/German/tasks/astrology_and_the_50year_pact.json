				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000101,
					"content": "Aber woher weißt du denn davon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000102,
					"content": "Ich bin eine hervorragende Astrologin, musst du wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000103,
					"content": "Wenn es sonst nichts weiter gibt, sollten wir aufbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000104,
						105000105
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000104,
					"content": "Aber ich habe noch Fragen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000106
					]
				},
				{
					"id": 105000106,
					"content": "Hach, na gut, wenn’s denn sein muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000107,
					"content": "Ich bin Astrologin Mona Megistus, aber ihr dürft mich ruhig Mona nennen. Wenn ihr euch meinen Namen nicht merkt und mich falsch nennt, wäre das nämlich ziemlich unhöflich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000108,
					"content": "Ich bin von meinem Meister nach Mondstadt geschickt worden, um hier eine Kiste zu holen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000109,
					"content": "Es geht dabei um eine Vereinbarung, die sie mit einer Freundin vor fünfzig Jahren getroffen hatte. Da sie jetzt aber so alt ist und nicht mehr so gut zu Fuß unterwegs ist, hat sie mich geschickt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000110,
					"content": "Und was hat die ganze Kistengeschichte mit uns tu tun? Warum müssen wir da mitkommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000111,
					"content": "Der Grund dafür ist einfach: Ich will mich mit dem Hüter der Kiste anlegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000112,
					"content": "Meine Meisterin und ihre Freundin sind seit jeher Rivalen in den mystischen Künsten und haben noch keinen Gewinner ausmachen können. Wenn ich gewinnen könnte, wäre ich doch besser als alle beiden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000113,
						105000115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000113,
					"content": "Du willst also deine Stärke beweisen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000114
					]
				},
				{
					"id": 105000114,
					"content": "Ähem, um es genauer zu sagen, ich will die Stärke der Astrologie unter Beweis stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000117,
					"content": "Aber so weit ich von meinen Beobachtungen der Sterne weiß, hat der Freund meiner Meisterin Mondstadt verlassen und die Kiste in die Obhut ihres Nachfolgers gegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000118,
					"content": "Wie ich muss dieser Nachfolger jemand sein, der seine Meisterin übertroffen hat. Ich darf nicht nachlässig werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000119,
					"content": "Ich muss gewinnen, wenn ich mich mit diesem Nachfolger messe. Und da habe ich an dich gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000120,
						105000122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000120,
					"content": "Aber ... ich weiß doch gar nicht, wie Astrologie geht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000121
					]
				},
				{
					"id": 105000121,
					"content": "#Wie kommt das Thema auf einmal auf {F#sie}{M#ihn} zu sprechen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000123,
					"content": "Das Wissen, das ich von meiner Meisterin erhalten habe, muss wiederum von mir weitergegeben werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000124,
					"content": "#Wenn ich mit {F#einer eigenen Schülerin}{M#einem eigenen Schüler} bei ihr aufkreuzen würde, hätte ich sie doch schon übertroffen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000125
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000125,
					"content": "#Und du bist {F#die große Heldin}{M#der große Held} von Mondstadt, ungefähr so wie ich. Das heißt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000126,
						105000127
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000126,
					"content": "Abgelehnt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000128
					]
				},
				{
					"id": 105000128,
					"content": "#Ach, jetzt versteh doch! Du musst ja nicht wirklich {F#meine Schülerin}{M#mein Schüler} sein, sondern nur so tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000129,
					"content": "Außerdem wird sich das Ganze auch für dich lohnen, wenn du mir hilfst, die Kiste zu bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000130,
					"content": "Sobald ich diesen Nachfolger getroffen habe, um mein Wissen mit ihm auszutauschen, werde ich dein Schicksal genauer bestimmen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000131
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000131,
					"content": "Dann werde ich dir selbst auf schwierige Fragen antworten können, zum Beispiel was Götter und Geschwister angeht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000132
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000132,
					"content": "Unfassbar! Das wäre viel einfacher, als in jeder Stadt einzeln zu suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000133,
						105000134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000133,
					"content": "Diese Bedingungen klingen ganz gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000135,
					"content": "Hehe, eine weise Wahl. Dann gehen wir mal los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000136
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000136,
					"content": "Bevor wir aufbrechen, möchte ich noch an einen bestimmten Ort gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000134,
					"content": "Vielleicht sollten wir wirklich mitmachen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000127,
					"content": "#Wieso bin ich jetzt plötzlich {F#deine Schülerin}{M#dein Schüler}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000128
					]
				},
				{
					"id": 105000122,
					"content": "Wie bist du da auf mich gekommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000123
					]
				},
				{
					"id": 105000115,
					"content": "Es geht dir also ums Ansehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000116
					]
				},
				{
					"id": 105000116,
					"content": "Was redest du da? Es geht hier um eine einmalige Gelegenheit, die Stärke der Astrologie zu beweisen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000105,
					"content": "Wer bist du überhaupt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000106
					]
				}
			]
		},
		{
			"id": 1050002,
			"completionStepIds": [
				1050003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
