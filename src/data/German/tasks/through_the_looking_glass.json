						"pointId": 6282
					},
					{
						"sceneId": 3,
						"position": [
							2560.522,
							232.133,
							4711.404
						],
						"pointId": 6283
					}
				]
			},
			"dialogs": [
				{
					"id": 741401301,
					"content": "Oh. Da sind wir wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401302,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401303,
					"content": "Ich fühle mich wirklich schlecht, das zu sagen, gerade weil alle so nett zu mir sind und ihr ja auch. Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401304,
					"content": "Findet ihr nicht, dass die reale Welt furchtbar langweilig ist? Findet ihr die Welt in Büchern nicht schöner?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401305,
						741401307,
						741401309
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401305,
					"content": "Mir geht es genau so.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401306
					]
				},
				{
					"id": 741401306,
					"content": "Wie? Denkst du das wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401311,
					"content": "Ich finde die Welt im „Buch der Aufdeckung“ immer noch am schönsten. Überall gibt es Blütenblätter mit Tautropfen, und ich habe mich endlich mit dem Hündchen angefreundet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401312
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401312,
					"content": "Hündchen ... Was das angeht, Canotila, verstehst du, was Hunde sagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401313,
					"content": "Was? Natürlich nicht. Es ist nur so, dass das Hündchen im „Buch der Aufdeckung“ besonders ist. Oder vielleicht bin ich besonders?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401314
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401314,
					"content": "Aber immer, wenn ich meditiere, reise ich zum Spielen in die Welt des Buches. Und eines Tages hat sich das übliche Bellen plötzlich in Sprache verwandelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401315
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401315,
					"content": "Wir haben gerade darüber gesprochen, dass er möchte, dass ich gehe und nicht wiederkomme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401316
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401316,
					"content": "Ach, ich möchte den Anblick der blühenden Sonnenblumen immer noch sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401317
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401317,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401318
					]
				},
				{
					"id": 741401318,
					"content": "J... Ja, genau ... Pass gut auf dich auf, Canotila! Also, wir gehen dann mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401307,
					"content": "Ich sehe das etwas anders.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401308
					]
				},
				{
					"id": 741401308,
					"content": "Wirklich ...? Vielleicht ist das ja richtig. Ich bin nicht normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401309,
					"content": "Für mich gibt es da keinen Unterschied.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401310
					]
				},
				{
					"id": 741401310,
					"content": "#Anscheinend ist {F#Schwester}{M#Bruder} {NICKNAME} der stärkste Mensch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Canotila"
				}
			]
		}
	]
}