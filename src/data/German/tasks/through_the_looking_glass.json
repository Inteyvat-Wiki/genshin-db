			},
			"dialogs": [
				{
					"id": 741401101,
					"content": "Oh, so sieht man sich wieder. Äh, dieses Mal hast du Paimon mitgebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401102
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401102,
					"content": "Hm? Als wir das letzte Mal zum Meditieren hergekommen sind, war Paimon auch hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401103,
					"content": "Bist du dir sicher? Dann habe ich das wohl vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401104
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401104,
					"content": "Aber egal. Dank deiner Hilfe, habe ich den Standort des „Mysterienspiegels“ und den Ort, an dem die Blumen blühen werden, gefunden. Außerdem habe ich mein Verständnis von diesem Ort vertieft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401105
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401105,
					"content": "Hm ... Canotilas Art zu sprechen ist so verwirrend wie immer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401106,
					"content": "Wuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401107
					]
				},
				{
					"id": 741401107,
					"content": "Hm? Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401108
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401108,
					"content": "Wuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401109
					]
				},
				{
					"id": 741401109,
					"content": "Schon gut, schon gut! Ich habe es verstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401110
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401110,
					"content": "(Hm ... Spricht sie mit dem Hund? Heißt das etwa, dass Melusinen generell mit Hunden kommunizieren können?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401111,
					"content": "(Echt unglaublich.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401112
					]
				},
				{
					"id": 741401112,
					"content": "Ich kann wirklich nichts machen, also, bis zum nächsten Mal. Hmph, auch wenn du so etwas sagst, werde ich trotzdem wiederkommen und mit dir spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401113
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401113,
					"content": "#{F#Schwester}{M#Bruder} {NICKNAME}, Paimon, lasst uns gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
		{
			"id": 7414013,
			"completionStepIds": [
				7414013
			],
			"beginWay": "TALK_BEGIN_MANUAL",
