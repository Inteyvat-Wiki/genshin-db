			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Bona",
					"„Cocouik“"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-136.96,
							453.037,
							10016.94
						],
						"pointId": 8608
					},
					{
						"sceneId": 3,
						"position": [
							-137.177,
							452.96,
							10019.38
						],
						"pointId": 8646
					}
				]
			},
			"dialogs": [
				{
					"id": 751330101,
					"content": "Paimon hat nicht damit gerechnet, dass Coco uns hierherführen würde. Diese seltsame Festung sieht genauso aus wie der Ort, an dem wir dich getroffen haben, Bona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330102,
					"content": "Schaut, sie hat sogar das gleiche Wandgemälde! Und es sind keine Schmierereien zu sehen. Liegt es daran, dass es hier höher ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330103,
					"content": "#{NICKNAME}, könnte die Person auf dem Wandgemälde der Schlangenkönig sein, den Bona gerade erwähnt hat? Er sieht wirklich böse aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330104,
					"content": "Ja, das ist der Schlangenkönig Och-Kan, der der Legende nach sein Volk missbrauchte und unterdrückte, um die Tonatiuh zu bauen, und schließlich den Abgrund anlockte, was zu seinem und seines Reiches Untergang führte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330105
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330105,
					"content": "Aber das ist nur eine Legende. Die Geschichtenerzähler in meinem Stamm haben viele unterschiedliche Geschichten darüber erzählt, was am Ende mit ihm passiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330106
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330106,
					"content": "Vielleicht treibt er sich immer noch auf der Tonatiuh herum und labt sich an seinen Schätzen. Oder vielleicht ist der böse Drache, der uns aufhalten will, tatsächlich sein Geist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330107
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330107,
					"content": "*gurr* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330108
					],
					"speakerTitle": "„Cocouik“"
				},
				{
					"id": 751330108,
					"content": "Waah, das ist so gruselig! Hör auf mit den Geschichten, du machst Coco Angst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330109,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330110,
					"content": "#Seit wir den Drachen besiegt haben, will {REALNAME[ID(2)|SHOWHOST(true)]} unbedingt etwas tun, um sich zu beweisen. Hat er eine Art geheimen Wettbewerb mit Coco?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330111,
					"content": "Hm, zurück zum Thema. Wo ist der Altar, den wir suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330112,
					"content": "Wenn Coco recht hatte, müsste er ... direkt unter uns sein? Moment, ich dachte, es wäre irgendwo weiter oben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330113
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330113,
					"content": "Ist da etwas falsch? Oder könnte der Altar des Urfeuers tatsächlich im Kern dieses Berges liegen? Ich meine, wie sollen wir später in den Himmel transportiert werden? Wird der Wind den Berg zum Einsturz bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330114
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330114,
					"content": "Oder gibt es eine besondere Transportmethode?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330115
					]
				},
				{
					"id": 751330115,
					"content": "Hui, aber sie klang vorhin so zuversichtlich! Und wir verstehen nicht, was Coco sagen will ... Was sollen wir jetzt tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330116,
					"content": "*gurr* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330117
					],
					"speakerTitle": "„Cocouik“"
				},
				{
					"id": 751330117,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330118,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, hast du eine Idee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330119,
					"content": "Paimon, ich glaube, ich habe das verstanden. Es soll wohl heißen, dass es uns nicht weiterbringt, nur hier zu stehen und zu raten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330120
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330120,
					"content": "Das denkst du dir doch nur aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330121,
					"content": "Wie auch immer, ich denke, wir sollten da runtergehen und nachsehen, was auch immer da unten ist. Das ist es, was ein echter Abenteurer tun würde, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330122
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330122,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330123,
					"content": "#Oh, du siehst ziemlich begeistert aus, {REALNAME[ID(2)|SHOWHOST(true)]}. Dann lass uns erst mal einen Weg finden, runterzugehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
