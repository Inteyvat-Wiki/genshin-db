			},
			"dialogs": [
				{
					"id": 751330301,
					"content": "#Es ist geöffnet! Du bist großartig, {REALNAME[ID(2)|SHOWHOST(true)]}! Ohne dich hätten wir es nicht gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330302,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330303
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330303,
					"content": "#Ich wusste, dass du es schaffst, {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330304
					]
				},
				{
					"id": 751330304,
					"content": "Aber wir sollten trotzdem nicht zu früh feiern. Es warten noch viele Herausforderungen auf uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330305,
					"content": "Da der Eingang nun geöffnet ist, müssen wir unbedingt herausfinden, was sich dort unten befindet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330306,
					"content": "Ich stimme dir zu, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330307
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330307,
					"content": "*zwitsch* ... *zwitsch*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330308
					],
					"speakerTitle": "„Cocouik“"
				},
				{
					"id": 751330308,
					"content": "Was ist los, Coco? Willst du nicht reingehen? Hast du etwa Angst? Wir haben die Hälfte unserer Reise hinter uns, es gibt jetzt kein Zurück mehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330309
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330309,
					"content": "*gurr* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330310
					],
					"speakerTitle": "„Cocouik“"
				},
				{
					"id": 751330310,
					"content": "Bona, zwing Coco nicht, er sieht sehr verängstigt aus. Könnte da unten etwas extrem Gefährliches sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330311,
					"content": "Ich habe auch Angst!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330312
					]
				},
				{
					"id": 751330312,
					"content": "#Was? Jetzt auch du?! Reiß dich zusammen wie {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330313,
					"content": "Jetzt wird es doch erst aufregend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330314
					]
				},
				{
					"id": 751330314,
					"content": "Oha, Paimon hätte nicht gedacht, dass du so begeistert davon sein würdest. Aber du kannst es wahrscheinlich sowieso mit allem aufnehmen, was uns da unten begegnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330315,
					"content": "Keine Sorge, wir haben unseren tapferen Saurier an unserer Seite.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330316
					]
				},
				{
					"id": 751330316,
					"content": "*brüll* ... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330317,
					"content": "Coco, du kannst hier bleiben, wenn du Angst hast. Oh, aber wir können ihn nicht einfach hier allein lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330318,
					"content": "Tja, ich denke, es gibt keine andere Möglichkeit. Ich bleibe mit Coco hier oben. Hier, ich vertraue euch, also könnt ihr den Pyrophosphorit erst mal haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330319
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330319,
					"content": "Aber versprecht mir, dass ihr, egal was ihr dort findet, zurückkommen und mich finden werdet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330320
					],
					"speakerTitle": "Bona"
				},
				{
