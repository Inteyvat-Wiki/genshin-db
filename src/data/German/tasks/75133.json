			"dialogs": [
				{
					"id": 751330201,
					"content": "Habt ihr etwas gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330202
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330202,
					"content": "Vielleicht gibt es in der Nähe ein spezielles Gerät oder einen Geheimgang, lasst uns noch ein bisschen suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bona"
				}
			]
		},
