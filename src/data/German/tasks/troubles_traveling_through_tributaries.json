					"Yue Chuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210261001,
					"content": "Und, hast du die Flaschenpost weggebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261002
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261002,
					"content": "Kann der kleine Meng sie wirklich empfangen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261003
					]
				},
				{
					"id": 210261003,
					"content": "Nun ... Das dürfte schwierig werden. Normalerweise ist es unmöglich, sie zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261004
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261004,
					"content": "Ist das dann nicht völlig sinnlos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210261005,
					"content": "Du solltest nichts überstürzen. Ich habe dir doch gesagt, dass ein zuverlässiger Erwachsener ihm helfen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261006
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261006,
					"content": "Kennt ihr diesen Ort „Sumeru“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261007
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261007,
					"content": "Ich kenne zufällig ein paar Leute im Geschäftsbereich. Sie haben vor, ein Pilzgeschäft zu betreiben, und werden in Kürze dorthin reisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261008
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261008,
					"content": "Hahahaha, das wisst ihr alle. Man sagt, dass man auf eine „Expedition“ nach Sumeru gehen würde, aber in Wirklichkeit ist es nur eine Reise zum Spaß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261009
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261009,
					"content": "Da dieser kleine Junge namens Meng die Idee hatte, eine Reise zu machen, war es nur gut, dass ich mich mit ihm in Verbindung setzte, um zu fragen, ob sie eine zusätzliche Person mitbringen könnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261010
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261010,
					"content": "Macht euch keine Sorgen, ich werde das arrangieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261011
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261011,
					"content": "Den Brief habe ich abgeschrieben, dafür habe ich anderweitig Verwendung. Und was die Flasche angeht ... Lass sie sein. Ich rechne auch nicht damit, dass sie jemand findet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261012,
						210261013
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261012,
					"content": "Danke für deine Hilfe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				},
				{
					"id": 210261014,
					"content": "Ist es nicht normal, dass Erwachsene Kindern bei der Erfüllung ihrer Träume helfen? Ich werde diese Angelegenheit klären, mach dir keine Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261015
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261015,
					"content": "Übrigens muss ich meine Freunde bitten, sich formell zu kleiden, um die Leute nicht zu erschrecken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261013,
					"content": "Warum willst du Meng helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				}
			]
		},
