				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yue Chuan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210260101,
					"content": "Der Schrift nach zu urteilen ist die Flasche von einem kleinen Kind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260102
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260102,
					"content": "Der kleine Meng ... Wer ist dieses Kind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260103
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260103,
					"content": "Was? Diese Flaschenpost ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260104
					]
				},
				{
					"id": 210260104,
					"content": "#{F#Reisende}{M#Reisender}? Du hörst dich an, als ob du die Person kennst, die diesen Brief geschrieben hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260105,
						210260106
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260105,
					"content": "Mehr oder weniger ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				},
				{
					"id": 210260107,
					"content": "Das ist es also. Der Junge denkt in großen Dimensionen und versucht, erwachsen zu werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260108
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260108,
					"content": "Ich denke, wenn er nur einen Ausflug nach draußen machen und etwas die Welt erkunden könnte, wären diese Sorgen vielleicht gelöst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260109
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260109,
					"content": "Ehrlich gesagt hat Meng selbst erzählt, dass er die Welt außerhalb Liyues besuchen möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260110,
					"content": "Aber wir haben ihn natürlich auch eingeladen. Also warum hat er nicht einfach zugesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260111,
					"content": "Hahaha, vielleicht liegt es an der Sturheit des jungen Mannes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260112
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260112,
					"content": "Da es sich um sein eigenes Problem handelt, sollte er es natürlich selbst lösen und sich nicht nur auf die Hilfe anderer verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260113
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260113,
					"content": "Aber Flaschenpost allein wird das Problem nicht lösen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210260114,
					"content": "Es ist also an der Zeit, dass ihm ein zuverlässiger Erwachsener zur Seite steht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260115
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260115,
					"content": "#Komm, Reisende{M#r}, lass uns gemeinsam einen Brief an dieses Kind schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260116
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260116,
					"content": "Erzähl ihm in diesem Brief, welche neuen und aufregenden Dinge ihn in der Außenwelt erwarten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260117
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260117,
					"content": "#Aber ... Hehe, ich war noch nicht an vielen Orten, also überlasse ich es dir, zu entscheiden, über welche neuen und aufregenden Orte du schreiben willst, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260118,
						210260119,
						210260120
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260118,
					"content": "Über die Ruinen des Turms, die vom Sturm umgeben sind ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260121,
					"content": "Bitte langsam, ja? Ich habe noch nicht alles aufgeschrieben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260122
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260122,
					"content": "Nun, hier ...sollte man es so schreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260123
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260123,
					"content": "Ja! Erledigt ... Jetzt merk ich erst, wie viel wir schon geschrieben haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260124
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260124,
					"content": "Hahaha, wenn ich dich darüber reden höre, bekomme ich Lust, ein bisschen nach draußen zu reisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260125
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260125,
					"content": "Reisen ist bestimmt nicht schlecht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260126
					]
				},
				{
					"id": 210260126,
					"content": "In meinem Alter habe ich zu viel um die Ohren, um so viel zu reisen, wie ich möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210260127
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260127,
					"content": "Ich habe diesen Brief in eine Flasche gesteckt, also wirf die Flaschenpost in den Fluss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210260119,
					"content": "Über die von Gewittern umgebenen fremden Inseln ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260120,
					"content": "Über die Insel, die durch das Schwert des Elektro-Archons geteilt wurde ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260121
					]
				},
				{
					"id": 210260106,
					"content": "Es ist ein Kind aus Liyue ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210260107
					]
				}
			]
		},
