			"dialogs": [
				{
					"id": 150120601,
					"content": "Wie auch immer ... Sicher habt ihr gesehen, wie es hier um die Umgebung steht. Das liegt daran, dass die „Schattennadel“, die einst darüber hing, in die Tiefe gestürzt ist und einen riesigen Krater hinterlassen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120602
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120602,
					"content": "Die Naht, die ich gefunden habe, lag näher an der Außenseite, sodass sie von der Katastrophe verschont blieb. Aber die Monster in der Gegend wurden aufgeschreckt und haben angefangen, zu wüten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120603
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120603,
					"content": "Ich hab Panik gehabt und einen schmalen Pfad genommen, um ihnen auszuweichen ... nur um dann diesen Banditen in die Arme zu laufen ... Dass ihr dann aufgetaucht seid, ist ein Glück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120604
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120604,
					"content": "Bei einer solchen Gefahr ... Warum hast du sie denn nicht einfach fallen lassen, während du gerannt bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120605,
