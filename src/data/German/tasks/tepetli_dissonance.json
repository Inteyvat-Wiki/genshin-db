				]
			},
			"dialogs": [
				{
					"id": 150120101,
					"content": "S... Sie ist noch nicht zurück ... Ich hoffe, nichts Schlimmes ist der Meisterin Cheven zugestoßen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120102
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120102,
					"content": "He, das Kind dort drüben weint. Ist etwas passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120103,
					"content": "Sehen wir mal nach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120104,
					"content": "Hallo, was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120105
					]
				},
				{
					"id": 150120105,
					"content": "*schluchz* Mei... Meisterin Ch... Cheven, sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120106
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120106,
					"content": "Sie meinte, sie wolle ein paar Vulkankristalle sammeln ... Aber sie ist noch nicht zurückgekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120107
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120107,
					"content": "Ich habe es den Wachen gesagt, aber sie sagten, dass sie im Moment keine Leute übrig haben, und dass das Gelände in dieser Richtung sehr gefährlich sei, mit vielen Monstern und bösen Schurken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120108
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120108,
					"content": "Sie müssen erst die Vorbereitungen abschließen, bevor sie sie retten können ... Aber dann wird es zu spät sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120109,
						150120110
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120109,
					"content": "Keine Sorge, wir machen das schon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				},
				{
					"id": 150120111,
					"content": "Heißt das, ihr helft mir? Toll! Ich male euch die Stelle an, wo die Wachen vorhin waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120112
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120112,
					"content": "Sie sagten, dass Meisterin Cheven vielleicht dort Halt gemacht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120113
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120113,
					"content": "Sie musste vielleicht sogar in die Nähe der Schattennadel gehen. Wenn das passiert ist ... dann ... *schnief*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120114
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120114,
					"content": "Bitte! Hilf mir, Meisterin Cheven zu retten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120110,
					"content": "Sieht so aus, als müssten wir wieder einmal die Helden sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				}
			]
		},
