			},
			"dialogs": [
				{
					"id": 150120501,
					"content": "Ich hab Panik gehabt und einen schmalen Pfad genommen, um ihnen auszuweichen ... nur um dann diesen Banditen in die Arme zu laufen ... Dass ihr dann aufgetaucht seid, ist ein Glück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120502
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120502,
					"content": "Bei einer solchen Gefahr ... Warum hast du sie denn nicht einfach fallen lassen, während du gerannt bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120503,
					"content": "Ich habe viele von ihnen weggeworfen, glaub mir. Ich habe nur den reinsten von ihnen behalten. Und ich muss ihn zurückzubringen, egal was passiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120504
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120504,
					"content": "... Für Tlazolli und die arme kleine Nechca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120505
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120505,
					"content": "Entschuldige, wer sind die Zwei ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120506
					]
				},
				{
					"id": 150120506,
					"content": "Ah, richtig, du kennst sie nicht. Tlazolli ... sie war eine Schmiedin, die die „alten Namen“ schmiedete, und Nechca ist ihre Tochter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120507
					],
					"speakerTitle": "Cheven"
				}
			]
		},
