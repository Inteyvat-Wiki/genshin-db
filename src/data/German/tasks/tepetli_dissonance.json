				},
				{
					"id": 150120827,
					"content": "Aber, worum es sich handelt ... das soll euch Tlazolli selbst sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120823,
					"content": "Ob es wohl ein antiker Name ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120824
					]
				},
				{
					"id": 150120824,
					"content": "He! Der Pyro-Archon meinte, dass sie sich dabei an Xilonen gewandt hat. Kein Grund, die Dinge noch komplizierter zu machen, als sie sein müssen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120825,
					"content": "Wir brauchen nichts derartig Ausgefallenes. Ein normales Geschenk ist mehr als genug, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120813,
					"content": "Kein Wunder, dass du den Kristall nicht zurücklassen wolltest.",
					"roleType": "TALK_ROLE_PLAYER",
