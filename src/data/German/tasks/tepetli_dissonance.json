			"dialogs": [
				{
					"id": 150120401,
					"content": "Nun, sie haben anscheinend überhaupt nicht vor, zu kämpfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120402,
						150120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120402,
					"content": "Ich denke, sie wussten, mit wem sie es zu tun hatten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				},
				{
					"id": 150120404,
					"content": "Puh ... Ich danke euch beiden. Ohne eure Hilfe wäre ich wahrscheinlich den Berg hinuntergestürzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120405
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120405,
					"content": "#Von {NICKNAME} gerettet ... Ich schätze, mein Glück hat sich gebessert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120406
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120406,
					"content": "Ah, tut mir leid, ich habe mich noch gar nicht vorgestellt. Ich bin Cheven, eine Edelsteinhandwerkerin und im Allgemeinen vom Pech verfolgt ... aber vielleicht geht es jetzt aufwärts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120407
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120407,
					"content": "Imix hat uns zur Hilfe geschickt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120408
					]
				},
				{
					"id": 150120408,
					"content": "Sie hat das gemacht ... *seufz* Ich wollte nicht, dass sie sich Sorgen macht. Ich hatte nicht vor, dass ich länger als zwei Tage weg sein würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120409
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120409,
					"content": "Aber ich habe in der Nähe der Schattennadel ein neues Vorkommen von Vulkankristall entdeckt ... In beträchtlicher Menge und auch von besonderer Reinheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120410
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120410,
					"content": "Ich habe einen ganzen Haufen davon ausgegraben und wollte gerade zurückkehren, aber das Phlogiston in den Kristallen hat wohl Monster angelockt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120403,
					"content": "Ruhm hat auch seine Vorteile ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				}
			]
		},
