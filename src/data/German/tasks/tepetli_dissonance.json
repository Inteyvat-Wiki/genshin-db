			},
			"dialogs": [
				{
					"id": 150121301,
					"content": "Ich erinnere mich, dass Xilonen auch in diesem Bereich tätig ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121302
					]
				},
				{
					"id": 150121302,
					"content": "Oh, ihr kennt Xilonen? Haha, erwähnt diesen Namen mal vor Tlazolli. Bevor sie ihr Loblied auf Xilonen beendet hat, wird die Sonne untergehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121303
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121303,
					"content": "„Der beste Experte der antiken Namen“, „die Zukunft unseres Stammes“, „der beste Handwerker in Natlan“ ... Das und noch viel mehr wirst du zu hören kriegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121304
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121304,
					"content": "Ich weiß, dass Tlazolli die Zeiten vermisst, in denen sie alte Namen schmiedete. Sie würde das nur nie laut aussprechen ... aber ich weiß es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				}
			]
		},
