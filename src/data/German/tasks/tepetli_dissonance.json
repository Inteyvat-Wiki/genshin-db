					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150121415,
					"content": "Ich bin sicher, sie und ihre Mutter würden sich sehr über deine Glückwünsche freuen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121416
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121416,
					"content": "Gut, lasst uns erst einmal zurückgehen. Sonst wird Imix noch ganz krank vor Sorge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121417
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121417,
					"content": "Ach ja, würdest du morgen mit mir zu Tlazolli gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121418
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121418,
					"content": "Immerhin ist es dir zu verdanken, dass ich den Kristall zurückbringen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121419
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121419,
					"content": "Du hast ein Geschenk verdient, denn du hast uns geholfen, etwas so Bedeutendes zu schützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121420,
						150121423
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121420,
					"content": "Ich hoffe, dass das Geschenk Nechca glücklich machen wird.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121421
					]
				},
				{
					"id": 150121421,
					"content": "Genau! Gute Laune sorgt für eine schnelle Erholung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150121422,
					"content": "Und natürlich, äh ... würden wir auch zu einem kleinen Geschenk niemals nein sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150121426,
					"content": "Haha, keine Sorge. Ich bin sicher, dass es euch gefallen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121427
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121427,
					"content": "Aber, worum es sich handelt ... das soll euch Tlazolli selbst sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150121423,
					"content": "Ob es wohl ein antiker Name ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121424
					]
				},
				{
					"id": 150121424,
					"content": "Du hast schon einen alten Namen. Mehr als einen davon zu haben, ist doch sinnlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150121425,
					"content": "Wir brauchen nichts derartig Ausgefallenes. Ein normales Geschenk ist mehr als genug, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150121413,
					"content": "Kein Wunder, dass du den Kristall nicht zurücklassen wolltest.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121414
					]
				}
			]
		}
	]
}