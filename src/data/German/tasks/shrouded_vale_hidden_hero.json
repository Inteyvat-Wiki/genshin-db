					}
				]
			},
			"dialogs": [
				{
					"id": 711090201,
					"content": "Waah! Wer hätte gedacht, dass diese schäbige Wangshan-Halle tatsächlich so ein riesiges Geheimnis verbirgt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090202,
						711090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090202,
					"content": "Ich hätte das auch nicht erwartet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				},
				{
					"id": 711090204,
					"content": "Meister Huang der Dritte schien wohl auch nichts von diesem Ort gewusst zu haben ... Warte, könnte das die legendäre „Schatzkammer von Guhua“ sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090205,
					"content": "#Außerdem ... {NICKNAME}, schau mal! Da scheint etwas auf dieser Plattform zu leuchten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090206,
						711090207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090206,
					"content": "Ein Schatz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090208,
					"content": "Egal, lass uns schnell hingehen und nachsehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090207,
					"content": "Eine Vorrichtung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090203,
					"content": "Vielleicht heißt es ja deshalb: „Beurteile ein Buch nicht nach seinem Einband“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				}
			]
		},
		{
			"id": 7110905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110903",
							"2"
						],
						"stepId": 7110903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711090501,
					"content": "„... Es ist schwer, dem Weg des Himmels zu vertrauen und nur wenige können ihm gerecht werden. Das Schicksal folgt nicht dem geraden Weg und nur wenige prosperieren, ohne zu scheitern. Wem der Himmel Augen zum Sehen gab, der sieht oft den Weg nicht. Was ist erst mit dem, der nicht von der Warte des Himmels aus sieht ...?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090502
					],
					"speakerTitle": "Inschrift auf der Stele"
				},
				{
					"id": 711090502,
					"content": "„... Diese Andachtsstele wurde hinterlassen, um die Künftigen zu fragen: Wohin soll man sich wenden, wenn man auf verlorenem Posten steht?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090503,
						711090504
					],
					"speakerTitle": "Inschrift auf der Stele"
				},
				{
					"id": 711090503,
					"content": "(Die Steinstele berühren.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711090504,
					"content": "(Weggehen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7110906,
			"completionStepIds": [
				7110906
			],
