						"pointId": 311400041
					},
					{
						"sceneId": 3,
						"position": [
							2250.204,
							346.642,
							2187.956
						],
						"pointId": 7885
					}
				]
			},
			"dialogs": [
				{
					"id": 711090601,
					"content": "Hä? Auf diesem Schwert steht etwas geschrieben? Lass Paimon mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090602,
					"content": "„... Die Klinge liebkosend, gehe ich singend, um Drachen zu spalten und ihr Blut zu trinken. Das göttliche Licht, wie ein fließender Blitz, wie eine eisige Welle, droht die Berge zu zerschmettern ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090603
					],
					"speakerTitle": "Inschrift des antiken Schwertkämpfers"
				},
				{
					"id": 711090603,
					"content": "„... Unter dem Tianheng-Berg töte ich Tiger, die geschuppte Bestie spieße ich inmitten des Wolkenmeeres auf ... Wenn ich mit Erfolg gekrönt zurückkehre, werden wir in Ruhe leben ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090604
					],
					"speakerTitle": "Inschrift des antiken Schwertkämpfers"
				},
				{
					"id": 711090604,
					"content": "Daneben gibt es noch eine Steinstele ... Huch, die Schrift unterhalb sieht etwas anders aus, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090605,
					"content": "„Es war mein ursprüngliches Ansinnen, den Fisch und das Lamm hier zu belassen. Doch wie soll man verhindern, dass sie im Laufe der Zeit verderben? Daher hinterlege ich das Rezept, damit künftige Besucher sich selbst an der Zubereitung erproben können. Welch wunderbare Idee.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090606
					],
					"speakerTitle": "Uralte Gravur"
				},
				{
					"id": 711090606,
					"content": "„... Es gibt hier nichts anderes als das. Nur dieses Schwert und diese Landschaft.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090607
					],
					"speakerTitle": "Uralte Gravur"
				},
				{
					"id": 711090607,
					"content": "„... Wenn du in eine ausweglose Lage gerätst, was sollst du tun? Gehe weiter und du wirst es wissen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090608
					],
					"speakerTitle": "Uralte Gravur"
				},
				{
					"id": 711090608,
					"content": "„... Nimm ihn nicht an dich ... den Schatz, von nun an verleibt ... nur ein ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090609
					],
					"speakerTitle": "Kritzelige Gravur"
				},
				{
					"id": 711090609,
					"content": "„Möge mein letzter Stand ein Denkmal der ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090610
					],
					"speakerTitle": "Kritzelige Gravur"
				},
				{
					"id": 711090610,
					"content": "Waah ... Die nächsten Zeilen sind so krakelig geschrieben. Paimon versteht überhaupt nicht, was da geschrieben steht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090611,
						711090612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090611,
					"content": "Es bedeutet wohl einfach, dass man nichts wegnehmen soll.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				},
				{
					"id": 711090613,
					"content": "*heul* Am Ende haben wir überhaupt keine wertvollen Schätze gefunden. All die Vorfreude war umsonst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090614,
						711090615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090614,
					"content": "Also wirklich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090617
					]
				},
				{
					"id": 711090617,
					"content": "Andererseits hätte Paimon nicht gedacht, in so einer traurigen Situation noch so eine Landschaft bestaunen zu dürfen ... Zumindest das hat sich gelohnt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090615,
					"content": "Mach dir nichts draus, ich koche dir etwas Feines zum Essen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090616
					]
				},
				{
					"id": 711090616,
					"content": "#Ah! Echt!? {NICKNAME}, das ist ein Wort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090612,
					"content": "Ich kann es auch nicht entziffern ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				}
			]
		},
		{
