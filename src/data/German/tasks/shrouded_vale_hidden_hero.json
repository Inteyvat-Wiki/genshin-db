			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wen der Vierte",
					"Huang der Dritte"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711092501,
					"content": "*seufz* ... Nach tausend Jahren muss der oberste Hüter des Tors der Guhua-Schule jetzt andere um Essen betrügen ... Was kann man da noch tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092502
					],
					"speakerTitle": "Wen der Vierte"
				},
				{
					"id": 711092502,
					"content": "Argh, genug gejammert. Ich tue das, damit du nicht vor diesem Tor verhungerst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092503
					],
					"speakerTitle": "Huang der Dritte"
				},
				{
					"id": 711092503,
					"content": "#Und hör auf, diesen deprimierten Gesichtsausdruck zu machen. Du hast dich auch sehr über die Leistung {M#dieses jungen Mannes}{F#dieser jungen Dame} gefreut, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092504
					],
					"speakerTitle": "Huang der Dritte"
				},
				{
					"id": 711092504,
					"content": "#Diese Dumpfbacke von vorhin!? {M#Er}{F#Sie} ist einfach reingegangen, hat sich umgesehen und dir Pökelfleisch mit Reis gekocht! Warum sollte ich mich darüber freuen? Wäre ich ein paar Jahre jünger, würde ich dir eine schallende Ohrfeige geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092505
					],
					"speakerTitle": "Wen der Vierte"
				},
				{
					"id": 711092505,
					"content": "He! Vor ein paar Jahren war deine Kampftechnik noch schlechter als meine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092506
					],
					"speakerTitle": "Huang der Dritte"
				},
				{
					"id": 711092506,
					"content": "Wie auch immer, hör zu ... Es sind nur noch ein paar von uns alten Knackern übrig. Wir müssen weiter die prüfen, die sich uns vielleicht anschließen können. Wir können die Bücher doch nicht wirklich mit ins Grab nehmen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092507
					],
					"speakerTitle": "Huang der Dritte"
				},
				{
					"id": 711092507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092508
					],
					"speakerTitle": "Wen der Vierte"
				},
				{
					"id": 711092508,
					"content": "Haha, wechseln wir das Thema, es hat keinen Sinn, über solche deprimierenden Dinge zu reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711092509
					],
					"speakerTitle": "Huang der Dritte"
				},
				{
					"id": 711092509,
					"content": "Ach ja, warum probierst du nicht mal das Essen, das die Kinder mir gemacht haben? Hehe, ich glaube, es ist noch besser als das vom Restaurant Wanmin! Hier, nimm einen Bissen ... Oh komm schon, nur einen Bissen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huang der Dritte"
				}
			]
		}
	]
}