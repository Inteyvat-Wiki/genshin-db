			"dialogs": [
				{
					"id": 220290201,
					"content": "Hast du dich gerade zurückgehalten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290202
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290202,
					"content": "Mach dir keine Sorgen um meinen Stolz. Bitte hol alles raus, was du hast. Ich ... muss stärker werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
