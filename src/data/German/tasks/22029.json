				"points": []
			},
			"dialogs": [
				{
					"id": 220290301,
					"content": "*schnauf* Du ... bist in der Tat furchteinflößend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290302
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290302,
					"content": "Ich ... Ich habe viel gelernt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290303,
						220290304
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290303,
					"content": "Geht es dir gut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				},
				{
					"id": 220290305,
					"content": "Das ist ... in Ordnung. Ich muss nur mal kurz Luft holen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290306
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290306,
					"content": "Aber du bist in der Tat so mächtig, dass ich es dir sogar geglaubt hätte, wenn du behauptet hättest, einen riesigen Drachen besiegt zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290307
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290307,
					"content": "Tatsächlich habe ich einen riesigen Drachen besiegt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290308
					]
				},
				{
					"id": 220290308,
					"content": "Hahaha ... Ich glaube dir, natürlich. Danke, dass du mit mir trainiert hast. Ich werde mich an das erinnern, was ich aus diesem Kampf gelernt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290309
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290309,
					"content": "Wenn es dir nichts ausmacht, komm bitte und trainiere von nun an öfter mit mir. Einen starken Krieger wie dich als Trainingspartner zu haben ... Ich bin sicher, dass ich die Sache bald vollenden werde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290310
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290310,
					"content": "Welche Sache?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290311
					]
				},
				{
					"id": 220290311,
					"content": "Ähem ... Es ist nur ein kleiner Wunsch, den ich im Kopf habe. Vielen Dank für deine Hilfe. Bitte nimm dies als Bezahlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290312
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290312,
					"content": "Jetzt muss ich zurückgehen und eine Pause machen. Deine Schläge waren in der Tat sehr mächtig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290304,
					"content": "Tut mir leid, ich hatte damals meine Kraft nicht unter Kontrolle ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				}
			]
		},
