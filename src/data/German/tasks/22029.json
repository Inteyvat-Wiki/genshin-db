			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290101,
					"content": "Ich muss! Ich muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290102
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290102,
					"content": "Hm? Wer bist du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290103
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290103,
					"content": "Ich habe deinen Auftrag angenommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290104
					]
				},
				{
					"id": 220290104,
					"content": "Oh, du meinst meine Anfrage nach einem Trainingspartner. Das stimmt, das habe ich veröffentlicht. Ich möchte jemanden als meinen Kampfsport-Trainingspartner finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290105
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290105,
					"content": "Du bist also derjenige, der ihn akzeptiert hat? Ich glaube nicht, dass ich dich schon einmal in der Stadt getroffen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290106
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290106,
					"content": "Tut mir leid, ich will deine Stärke nicht infrage stellen. Aber ich bin mir wirklich nicht sicher, wie es um deine Kampfkünste bestellt ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290107,
						220290109
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290107,
					"content": "Ich habe schon riesige Drachen besiegt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290108
					]
				},
				{
					"id": 220290108,
					"content": "Hahaha ... ist das so? Eigentlich bin ich eher neugierig, wo du einen gefunden hast. Ich habe bisher nur von Drachen gehört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290112,
					"content": "Oh, keine Sorge, ich bin ziemlich fähig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290113
					]
				},
				{
					"id": 220290113,
					"content": "Haha, wie auch immer, Worte werden nichts beweisen. Dann lass uns die Worte mit unseren Händen testen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290114,
						220290115
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290114,
					"content": "Sehr gerne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220290115,
					"content": "Warum hast du eigentlich diesen Auftrag anonym aufgegeben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290116
					]
				},
				{
					"id": 220290116,
					"content": "Nun, es ist eigentlich wegen etwas, auf das ich ... nicht stolz bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290117
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290117,
					"content": "Ähem, da du es bereits akzeptiert hast, werde ich dir die Wahrheit sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290118
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290118,
					"content": "Vorhin bin ich mit einigen Doushins auf eine Mission gegangen. Auf dem Rückweg trafen wir auf eine Gruppe von Kairagi, die dabei waren, eine Handelskarawane zu überfallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290119
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290119,
					"content": "Wir eilten dorthin, um die Karawane zu retten. Am Anfang hatten wir die Oberhand, und sie zogen sich schnell zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290120
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290120,
					"content": "Aber als wir gerade eine Pause machen wollten, kam plötzlich eine weitere Gruppe Kairagi aus dem Nichts und es schien ein Anführer da zu sein, der sie befehligte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290121
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290121,
					"content": "Bevor meine Kollegen und ich reagieren konnten, haben sie uns schon überwältigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290122
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290122,
					"content": "Da wir die Oberhand verloren hatten, konnten wir nur versuchen, die Kairagi abzuwehren, während wir die Händler zurück in die Stadt eskortierten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290123
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290123,
					"content": "Und als ich gegen den Kairagi-Anführer kämpfte ... nahm er meine Waffe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290124
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290124,
					"content": "Und dieser Kerl hielt tatsächlich meine Waffe hoch, nachdem er sie genommen hatte und lachte mich die ganze Zeit aus. Was für eine Demütigung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290125
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290125,
					"content": "Was ist mit dieser Gruppe von Händlern passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290126
					]
				},
				{
					"id": 220290126,
					"content": "Wir sind beim Rückzug auf andere patrouillierende Doushin gestoßen, also zogen sich auch diese Kairagi zurück, nachdem sie sie gesehen hatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290127
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290127,
					"content": "Auch diese Händler wurden von uns in die Stadt eskortiert. Aber ihre Waren waren alle ... *seufz* Das liegt alles an meinen mangelnden Fähigkeiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290128
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290128,
					"content": "Nach der Rückkehr wurde mir auch eine andere Waffe ausgehändigt. Aber ich kann immer noch nicht darüber hinwegkommen, was passiert ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290129
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290129,
					"content": "Daher habe ich diesen Auftrag in der Hoffnung veröffentlicht, meine Fähigkeiten zu verfeinern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290130
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290130,
					"content": "Sobald ich stark genug bin, werde ich diese Kairagi selbst besiegen und meine Waffe zurücknehmen, um diesen Schandfleck von meinem Namen zu tilgen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290109,
					"content": "Ich war Zeuge des Sturzes eines Gottes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290110
					]
				},
				{
					"id": 220290110,
					"content": "Was, wovon sprichst du? Du meinst, dass du schon einmal an der Adeptenzeremonie in Liyue teilgenommen hast, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290111
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290111,
					"content": "Hahaha, nach deiner Logik haben auch viele Menschen in Liyue „den Fall eines Gottes miterlebt“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Asakura"
				}
			]
		},
		{
			"id": 2202902,
