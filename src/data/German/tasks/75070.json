			"dialogs": [
				{
					"id": 750700701,
					"content": "Haha! Hab’ ich doch gewusst, dass wir uns wiedersehen! Ihr kommt genau richtig, um Zeugen meines zweiten Meisterwerks zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700702
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700702,
					"content": "Na ja ... es ist nicht wirklich mein zweites, ich habe schließlich schon viele gute Sachen gemacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700703
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700703,
					"content": "Na jedenfalls, ihr habt großes Glück! Haha, ich bin kurz davor, hier eine dynamische Szene aufzunehmen! Haha, es ist das erste Mal, dass ich mich der Herausforderung der dynamischen Fotografie stelle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700704
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700704,
					"content": "Früher habe ich vorwiegend an Tatorten Fotos der Opfer gemacht ... Ähm, aber das muss ich jetzt nicht genauer erklären ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700705
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700705,
					"content": "Na, brauchst du diesmal wieder unsere Hilfe, Herr Magnifico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700706,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750700707,
					"content": "Nein ... ähm, doch, es wäre gut, wenn ihr mir helfen könntet! Kommt, ich werde euch erklären, worum es geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700708
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700708,
					"content": "Also, ich muss einen Qucusaurier fotografieren, der sich an diesem Wasserfall ins Wasser stürzt ... genau den Moment, wo er mit voller Wucht in die Wasseroberfläche eintaucht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700709
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700709,
					"content": "Ich habe im Teich unter dem Wasserfall Futter versteckt, um die Qucusaurier anzulocken. Aber ... *seufz* bisher ist einfach keiner im passenden Winkel heruntergefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700710
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700710,
					"content": "Hä? ... Was ist denn das für ein großer Kreis da auf der Wasseroberfläche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700711,
					"content": "Mach dir darum keinen Kopf, ich weiß auch nicht genau, was das ist ... Das ist nur irgendein Geraffel, das ich von einem Stamm in der Nähe aufgelesen habe, um es als Ziel zu verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700712
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700712,
					"content": "Bisher sind alle Bilder, die ich geschossen habe, furchtbar langweilig geworden, das ist echt zum Verzweifeln. Ich könnte noch länger warten, aber jetzt, da ihr da seid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700713
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700713,
					"content": "Vielleicht könntet ihr ... ähm, ihnen ein bisschen auf die Sprünge helfen? Zeigt diesen kleinen Sturköpfen, wie man einen richtig schönen Kopfsprung hinlegt! Ihr seid schließlich die berühmten Saurierexperten Natlans, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700714
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700714,
					"content": "Super! Ich werde hier für euch rückwärts zählen. Ihr müsst nur genau in dem Moment, wenn ich bei „eins“ ankomme, ins Wasser eintauchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700715,
						750700717
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700715,
					"content": "Wir können es ja mal probieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750700716
					]
				},
				{
					"id": 750700716,
					"content": "Haha, hervorragend! Dann lasst uns gleich loslegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700717,
					"content": "Wir können nichts versprechen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750700718
					]
				},
				{
					"id": 750700718,
					"content": "Ist schon gut, im schlimmsten Fall verlieren wir nur ein bisschen Zeit. Und he, wir sind schließlich Reisende ... niemandes Zeit ist weniger wert als unsere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700719,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
