			"dialogs": [
				{
					"id": 750701601,
					"content": "*seufz* Wie du siehst, sind die Ergebnisse ... alles andere als zufriedenstellend. Genau wie ich selbst ... unfähig in jeder Hinsicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701602
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701602,
					"content": "Bei mir zuhause pflegte man zu sagen, dass selbst ein kleiner Baum große Schatten wirft! Alles Unsinn, nur leeres Gerede! Die wollten mich nur bloßstellen!",
