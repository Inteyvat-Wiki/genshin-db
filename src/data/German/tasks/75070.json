			"dialogs": [
				{
					"id": 750700901,
					"content": "Haha, perfekt! Hier, ein Abzug für dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700902
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700902,
					"content": "Waah, das ist bombastisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700903,
					"content": "So, hier ist eure Belohnung. Das ist schon das zweite ... nein, das dritte Mal, dass ihr mir helft. Ohne euch ... hätte ich diese Fotoreise vielleicht nie in trockene Tücher bringen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700904
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700904,
					"content": "Mein nächstes Reiseziel liegt hier ... Ich habe es auf eurer Karte markiert. Wenn ihr wollt, können wir gern wieder zusammenarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700905
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700905,
					"content": "Ah ... Die Zeit drängt. Ich muss los! Viel Glück euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700906
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700906,
					"content": "Magnifico verstaut flink sein Gepäck und springt leichtfüßig in den Heißluftballon.\\nLangsam schwebt der Ballon davon, während Magnificos Lachen als leises Echo verhallt.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
