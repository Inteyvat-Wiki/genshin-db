			"dialogs": [
				{
					"id": 750701401,
					"content": "Verflixt, wir müssen noch mal von vorn anfangen! Ähm ... Also, nur wenn es euch nichts ausmacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701402
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701402,
					"content": "*seufz* Schon gut, wir sind ja schon hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701403,
						750701405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750701403,
					"content": "Machen wir weiter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701404
					]
				},
				{
					"id": 750701404,
					"content": "Ja, vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701405,
					"content": "Lass uns doch erstmal eine Pause machen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701406
					]
				},
				{
					"id": 750701406,
					"content": "Von der Klippe zu springen ist ziemlich anstrengend. Wir sollten wirklich eine Pause einlegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750701407,
					"content": "Oh ... Tut mir leid, daran hatte ich nicht gedacht. Macht einfach weiter, wenn ihr bereit seid. Ich werde hier auf euch warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				}
			]
		},
