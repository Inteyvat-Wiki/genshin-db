			"dialogs": [
				{
					"id": 760000201,
					"content": "Hmm ... Diese Tür lässt sich wohl nicht öffnen. Aber Paimon ist wirklich neugierig, was sich dahinter verbirgt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000202,
						760000204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000202,
					"content": "Das ist bestimmt nichts Wichtiges.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000203
					]
				},
				{
					"id": 760000203,
					"content": "Wenn man sich die Position anschaut, ist es wirklich unwahrscheinlich, dass hier etwas Wichtiges versteckt ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000206,
					"content": "Jedenfalls sollten wir einen Weg finden, um da hineinzukommen! Sonst wird Paimon dieses Rätsel nicht mehr aus dem Kopf gehen, und das fühlt sich genauso unangenehm an, wie wenn man zu viele Nod-Krai-Hotdogs isst, die einem dann schwer im Magen liegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000207,
					"content": "Die Tür lässt sich zwar nicht öffnen, aber vielleicht gibt es noch einen anderen Weg hinein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000204,
					"content": "Vielleicht werden da drin irgendwelche finsteren Experimente durchgeführt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760000205
					]
				},
				{
					"id": 760000205,
					"content": "F... Finstere Experimente ... Sollte das wirklich der Fall sein, dann sind die Sicherheitsvorkehrungen hier viel zu lasch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760000206
					],
					"speakerTitle": "Paimon"
				}
			]
		},
