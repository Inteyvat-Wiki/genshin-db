						"stepId": 4001309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean",
					"Barbara",
					"Albedo",
					"Klee",
					"Alice",
					"Paimon",
					"Kaeya",
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400130201,
					"content": "Hm, das ist ... Moment, ich bin völlig verwirrt. Was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130202
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130202,
					"content": "Diese ganze Insel ist so etwas wie eine riesige Geschenketruhe, die unter dem Energieschild versteckt ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130203
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130203,
					"content": "Da drüben ist etwas zu sehen. Wollen wir mal nachsehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130204
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130204,
					"content": "Ja, ich will nachsehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130205
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130205,
					"content": "Schlitzohriges Mädchen der Flammen, du bist endlich da. Ich habe viel zu lange gewartet. Es war so langweilig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130206
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130206,
					"content": "Du wagst es, dich mir zu stellen, dem Oberhaupt des Dodo-Klans, dem Dodo-König?! Welch unglaublicher Mut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130207
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130207,
					"content": "Solcher Mut ist zwar lobenswert, aber er ist jetzt sinnlos, weil ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130208
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130208,
					"content": "Weil der Dodo-König niemand anderes als deine Mutter Alice ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130209
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130209,
					"content": "Hä? Mama?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130210
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130210,
					"content": "Moment! Alice? Die Alice, die den Teyvat-Reiseführer geschrieben hat?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130211,
					"content": "Klee und ihre Inselgefährten, hallo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130212
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130212,
					"content": "Also, wie gefällt es euch hier? Hat es Spaß gemacht? Der Sommerhimmel und die Meeresbrise, hmmm? Ein toller Urlaub, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130213
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130213,
					"content": "Es hat keinen Sinn, nach mir zu suchen, ich bin nicht wirklich in deiner Nähe. Das Sprechgerät auf der Plattform vor dir ist nichts anderes als meine Eigenentwicklung, der Alice-Phonograph! Ich setze ihn ein, um die Liebe einer Mutter zu vermitteln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130214
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130214,
					"content": "Oh? Das kann nicht dein Ernst sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130215
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400130215,
					"content": "He, ich habe euch doch nicht etwa alle abgeschreckt, oder? Entschuldigung, meine Klee liebt es, mit allen erdenklichen kleinen Spielzeugen zu spielen. Als ihre Mutter will ich sie natürlich fördern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130216
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130216,
					"content": "Diese Spielzeuge sind keineswegs klein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130217,
					"content": "Klees ... Ma... Mama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130218
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 400130218,
					"content": "Es ist schade, dass wir uns nicht treffen können, aber ich werde wie immer aus der Ferne alles beobachten, was du machst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130219
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130219,
					"content": "Es war tatsächlich Alice! Wie unvorsichtig von mir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130220
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130220,
					"content": "Moment, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130221
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130221,
					"content": "Vielleicht erscheint euch das alles ein bisschen seltsam. Warum sollte eine Mutter, die so weit von zu Hause weg ist, so viel Aufwand betreiben, um ein solches Meereswunderland zu erschaffen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130222
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130222,
					"content": "Ding ding! Das ist korrekt, ich war selbst schon auf diesen Inseln. Ich bin von den alten Ruinen und der einmaligen Landschaft absolut begeistert. Ich habe alles so vorbereitet, dass ihr alle mitmachen und die Inseln ebenfalls genießen könnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130223
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130223,
					"content": "Klees Mutter hat offenbar ebenfalls einen ziemlich freien Geist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130224,
					"content": "Hehe, ich hoffe, keiner von euch sagt jetzt schlimme Dinge über mich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130225
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130225,
					"content": "Hä? N... Nein! Hört sie uns noch zu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130226,
					"content": "Kein Grund zur Sorge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130227
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130227,
					"content": "Was meinst du damit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130228,
					"content": "Klees Mutter, Alice, ist eine überaus geheimnisvolle und fast allmächtige Zauberin. Keine Sorge. Das ist einfach ihre Persönlichkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130229
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130229,
					"content": "Ihr müsst doch neugierig gewesen sein, was hinter diesen Briefen, den Booten, den Bojen und dem Energieschild steckt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130230
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130230,
					"content": "Mhmm. Ehrlich gesagt, fand ich auch, dass es ein ziemlicher Aufwand war, aber das war die einzige Möglichkeit, alle hierher einzuladen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130231
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130231,
					"content": "Die Inseln sind voller Sagen und Legenden. Die Ureinwohner, Schiffswracks, mystische Maschinen ... Zahllose Zufälligkeiten begegnen sich hier. Es wäre eine solche Verschwendung, wenn ich diese Vorkehrungen nicht getroffen hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130232
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130232,
					"content": "Jetzt lasst mich raten ... Alle, die einen Brief erhalten haben, sollten hier sein. Kaeya, Diluc, Razor, Jean, Barbara ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130233
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130233,
					"content": "#Dann ist da noch der verlässliche und kluge Albedo, und ... {F#die geheimnisvolle Reisende}{M#der geheimnisvolle Reisende} und {F#ihre}{M#seine} treue Begleiterin, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130234
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130234,
					"content": "Ihr alle wurdet von mir eingeladen, Klee zu begleiten. Ich danke euch dafür, dass ihr meiner Tochter einen unvergesslichen Sommer beschert habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130235
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130235,
					"content": "Alles auf diesen Inseln ist ein Geschenk für euch alle, als Dank dafür, dass ihr meiner kleinen Klee so viel Zeit widmet. Aber wenn ihr diese Aufnahme hört, werde ich bereits in anderen fernen Ländern unterwegs sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130236
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130236,
					"content": "#Das Leben eines Reisenden besteht aus Hektik und Vergnügen. Haha, frag {F#die Reisende}{M#den Reisenden} neben dir und du wirst es wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130237
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130237,
					"content": "Alice hat also all diese Mühen auf sich genommen, weil sie zu viel zu tun hatte, um mit Klee zusammen zu sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130238
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130238,
					"content": "Nö, so ist Mama eben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130239
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130239,
					"content": "Wenn ihr jetzt versucht, eine verborgene Bedeutung in all dem zu finden, dann muss ich euch leider sagen, dass die Situation nicht so kompliziert ist, wie ihr es vielleicht vermutet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130240
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130240,
					"content": "Der Grund, warum ich Mondstadt mag, ist, dass seine Freiheit exakt das ist, was wir uns als Mutter für unser Kind wünschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130241
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130241,
					"content": "Mein Wunsch ist einfach, dass Klee mit einem neugierigen und gütigen Herzen aufwächst. Solange sie es sich wünscht, kann sie alles tun und überall hingehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130242
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130242,
					"content": "So ist das also. Na ja, ich muss zugeben, dass es auf jeden Fall zu dem Stil von Alice passt. Ich bitte um Entschuldigung, ich habe es missverstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130243
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130243,
					"content": "Es muss toll sein, eine Mutter mit so einer Persönlichkeit zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130244,
					"content": "Jepp! Mama ist die beste Mama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130245
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130245,
					"content": "Mama, wir haben Fische gefangen, sind mit dem Boot gesegelt, waren schwimmen und haben ganz viele Sachen gespielt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130246
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130246,
					"content": "Alle waren super-duper-toll und wirklich nett zu mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130247
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130247,
					"content": "Nächstes Mal kannst du mitkommen und wir können alle wieder hier spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130248
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130248,
					"content": "Mutter und Tochter sind offenbar verwandte Seelen, beide wild und frei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130249
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400130249,
					"content": "Sommer ... Apropos Sommer! Als ich zu diesen Inseln fuhr, war es zufällig auch Sommer. Ich saß am Strand, lauschte den Wellen, die gegen meine Füße rollten, und dachte an dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130250
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130250,
					"content": "Klee, du bist ein Sommerkind, ein Geschenk des Meeres und des Windes an mich. Mama ist für deine Geburt dankbar und wollte dir etwas schenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130251
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130251,
					"content": "Also hat Mama diese Inseln aufgepeppt, die antiken Ruinen in einen Sommerpark verwandelt und den Namen Dodo-König benutzt, um dich einzuladen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130252
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130252,
					"content": "In einer anderen Welt gibt es Erzählungen über eine wundersame Insel, die nach goldenen Äpfeln benannt wurde. Sie ist unter vielen Namen bekannt und repräsentiert die grandiosen Aussichten, welche die menschliche Fantasie heraufbeschwört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130253
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130253,
					"content": "Mama liebt diese Erzählungen und wollte, dass du die wundervollen Dinge darin genießt, also gab Mama dir saphirblaues Wasser, perlmuttfarbenen Sand, ein traumhaftes Paradies ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130254
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130254,
					"content": "Für dich und deine Liebsten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130255
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130255,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130256
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130256,
					"content": "Es gab also nur drei Kristalle ... Hellrot wie Blütenblätter, hellblau wie Meereswellen, hellgelb wie Herbstlaub ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130257
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130257,
					"content": "Vielleicht ist diese Inselgruppe aus der Sicht von Alice der natürliche vierte Kristall. Inmitten des Meeres gelegen und von Pflanzen bedeckt, ist er wahrlich ein schimmernder, smaragdgrüner „Sommerkristall“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130258
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130258,
					"content": "Klee, wie Mama gehörst du zu einer Spezies, die mit einer langen Lebenserwartung gesegnet ist. Für uns ist die Zeit wie ein Windstoß, Momente kommen und enden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130259
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130259,
					"content": "Während eines so langen Lebens sind die Eltern nur die erste Bindung für ein Kind. Auch wenn wir uns nicht trennen wollen, kommt irgendwann der Tag, an dem man seinen eigenen Weg gehen muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130260
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130260,
					"content": "Klee, Mama wird dich immer lieb haben, aber auch andere sind an deiner Seite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130261
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130261,
					"content": "Freunde, die dich begleiten, Lehrer, die dich unterrichten, Menschen, die für dich auf einer Insel bleiben wollen, obwohl sie wissen, wie merkwürdig sie ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130262
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130262,
					"content": "Der Sommer ist für jedermann. Ganz egal, wie sich das Leben verändert, ganz egal, wie viele Dinge in diesem Jahr passieren, der Sommer wird niemals vergehen, genau wie die Liebe zwischen Menschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130263
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130263,
					"content": "Ich hoffe, dass du von nun an, egal wo du hingehst, nie vergisst, wie viele Menschen auf dieser Welt dich lieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130264
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130264,
					"content": "Ach ja, hör auf jeden Fall auf Herrn Albedo zu Hause. Mama wird immer wieder zu euch zurückkehren, um nach euch beiden zu sehen. Genau genommen, immer wenn ich einen Moment Zeit habe, werde ich zurückschleichen, um nach dir und allen anderen zu sehen. Haha, hat das noch niemand bemerkt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130265
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130265,
					"content": "Genau wie immer, Tante Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130266
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130266,
					"content": "Du denkst doch nicht, dass Albedo es von der ersten Minute an wusste, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130267
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130267,
					"content": "Hm? Die Zeit ist fast um, also höre ich hier auf. Stimmt, stimmt, ich habe viel Mühe auf diesen Platz verwendet, also müsst ihr euch alle richtig austoben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130268
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130268,
					"content": "Ihr alle, meine geliebte Klee, bis zum nächsten Mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130269
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 400130269,
					"content": "Tschüs, Mama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130270
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130270,
					"content": "Klee scheint besonders glücklich zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130271
					]
				},
				{
					"id": 400130271,
					"content": "Hehe ... Der Dodo-König war in Wirklichkeit Mama. Ich weiß nicht, warum, aber ich bin sehr glücklich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130272
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130272,
					"content": "Egal, ob es nun die Mama ist, die das Eingangstor von Mondstadt in die Luft sprengt, oder die Mama, die Hausarrest bekommt, oder die Mama, die komische Briefe schreibt. Klee hat sie wirklich sehr lieb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130273
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130273,
					"content": "Fühlst du dich einsam ohne deine Mutter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130274
					]
				},
				{
					"id": 400130274,
					"content": "Nö. Mama ist die mächtigste Magierin, also kann sie mich begleiten, egal wo sie ist. Sie lässt mich nie alleine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130275
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130275,
					"content": "Ich hab Mama soooooo lieb!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130276
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130276,
					"content": "#{F#Frau}{M#Herr} Ehrenritter, hast du Klee auch lieb?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130277
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130277,
					"content": "Jupp!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130278
					]
				},
				{
					"id": 400130278,
					"content": "Ich habe dich auch sehr lieb! Du musst ganz viel mit mir hier spielen, sonst wird Mama enttäuscht sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130279
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130279,
					"content": "Ich habe noch ganz viele Bimm-Bamm-Bomben und ich habe auch Dodoco hier. Ich nehme dich mit zum Schwimmen und Fischeplatzen mit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130280
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130280,
					"content": "Es ist immer spaßig, wenn wir bei dir sind, Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130281
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130281,
					"content": "He, los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130282
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130282,
					"content": "Lassen wir Klee nicht warten. Komm schon, auf geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4001303,
			"completionStepIds": [
				4001310
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001310",
							"2"
						],
						"stepId": 4001310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara",
					"Jean",
					"Klee",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400130301,
					"content": "Ehrenritter, hier drüben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130302
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130302,
					"content": "Wie sind die Fische?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130303
					]
				},
				{
					"id": 400130303,
					"content": "Wie erwartet, wurden sie vom Kristall angezogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130304
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130304,
					"content": "Fangi fangi Fischi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130305
					],
