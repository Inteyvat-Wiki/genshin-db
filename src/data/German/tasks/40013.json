			},
			"dialogs": [
				{
					"id": 400130101,
					"content": "Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130102,
					"content": "Wir haben endlich alle Schuppen eingefügt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130103
					]
				},
				{
					"id": 400130103,
					"content": "Juhu, toll! Hehehe, jetzt bin ich dran, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130104,
					"content": "Ja, die Vorrichtung da drüben überlassen wir dir, Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130105,
					"content": "Klaro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130106
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130106,
					"content": "Klee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130107
					]
				},
				{
					"id": 400130107,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130108,
						400130109
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130108,
					"content": "Bitte pass gut auf dich auf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130110
					]
				},
				{
					"id": 400130110,
					"content": "Jepp, alles klar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130111
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130112,
					"content": "Klee, was ist los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130113
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130113,
					"content": "Ich ... Ich mache mir Sorgen ... Was ist, wenn der Dodo-König wirklich hier drin ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130114
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130114,
					"content": "Und was ist, wenn er mir nicht erlaubt, Dodocos Familie zu werden, oder ich gegen ihn verliere ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130115,
					"content": "Dann darf Dodoco nicht bei mir sein und Mama wäre auch sehr traurig ... Dodoco ist mein bester Freund, den Mama mir je geschenkt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130116
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130116,
					"content": "Ich ... Ich habe zu viel Angst, um ihn zu drücken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130117,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130118
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130118,
					"content": "#{F#Frau}{M#Herr} Ehrenritter, kannst du den Knopf für mich drücken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130119
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130119,
					"content": "Klee, ich kann dir nicht helfen, ihn zu drücken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130120
					]
				},
				{
					"id": 400130120,
					"content": "Warum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130121,
					"content": "Weil ich meine Waffe halten muss.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130122
					]
				},
				{
					"id": 400130122,
					"content": "Nur so kann ich dich beschützen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130123
					]
				},
				{
					"id": 400130123,
					"content": "Ja, Klee, wir sind alle für dich da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400130124,
					"content": "Keine Sorge, Klee, wir stehen alle hinter dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400130125,
					"content": "Ganz gleich, wer der Feind ist: Solange wir hier sind, musst du keine Angst haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130126
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400130126,
					"content": "Prima, ich will auch sehen, wie stark die Gegner auf dieser Insel tatsächlich sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130127
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 400130127,
					"content": "Geh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130128
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 400130128,
					"content": "Ich bin da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130129
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 400130129,
					"content": "Leute, sagt doch sowas nicht ... Was ist, wenn der Dodo-König Klee nur zum Plaudern in sein Haus einladen will? Oder ... ja! Vielleicht hat er ja Klee schon längst anerkannt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130130
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400130130,
					"content": "Wird er mich wirklich anerkennen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130131
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130131,
					"content": "Warum sollte er das nicht tun? Du hast immer dein Bestes gegeben und gute Arbeit geleistet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130132
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 400130132,
					"content": "Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130133,
						400130134
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130133,
					"content": "Klee, du bist meine allerbeste Freundin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130135,
					"content": "Gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130136
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130136,
					"content": "Dann werde ich mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400130137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130137,
					"content": "Drück, drück ... drück den Knopf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 400130134,
					"content": "Er wird dich akzeptieren, das weiß ich genau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130135
					]
				},
				{
					"id": 400130109,
					"content": "Wir gehen mit dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400130110
					]
				}
			]
		},
		{
			"id": 4001302,
			"completionStepIds": [
				4001309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
