			"dialogs": [
				{
					"id": 751950201,
					"content": "Himmel! Da ist ... plötzlich jemand nett?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950202
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950202,
					"content": "Ich wollte gerade einen Tatankasaurier bitten, die Steine in diesem Brachland zu zertrümmern und zur Seite zu treten. Falls dabei ein Monster aufgetaucht wäre, hätte er es gleich mit erledigen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950203
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950203,
					"content": "Und jetzt habe ich noch nicht einmal angefangen, da hat sich schon jemand um all meine Sorgen gekümmert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950204
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950204,
					"content": "Ich dünge jeden Morgen die Obstbäume vor meinem Haus. Ich habe mein ganzes Leben nur solche guten Dinge getan. Das muss jetzt die Belohnung der Götter für mich sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950205
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950205,
					"content": "Du bist ein guter Mensch, Bote des Archons! Ich, Dutta, danke dir für deine Großzügigkeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950206
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950206,
					"content": "Ein alter Mann wie ich könnte dir kaum etwas außer Mora geben. Aber es gibt doch noch ein paar Dinge, die ich nicht mehr brauche, bitte nimm sie auch mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dutta"
				}
			]
		}
	]
