			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Prinz“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706660201,
					"content": "#Miau! „Du bist wirklich {F#eine tolle Kartenbeschwörerin}{M#ein toller Kartenbeschwörer}! Herzlichen Glückwunsch zum Bestehen der Aufstiegsprüfung, jetzt bist du {F#eine Fortgeschrittene}{M#ein Fortgeschrittener}!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660202
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706660202,
					"content": "Miau? „Du hast nach nur einer Aufstiegsprüfung den Rang eines Fortgeschrittenen erreicht? Weißt du, die meisten spielen dieses Spiel zum Spaß und nehmen es nicht ganz so ernst ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660203
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706660203,
					"content": "„Mit anderen Worten, es gibt nur wenige, die es zum Spaß ernst spielen, aber auch wenn man nur ein wenig Spaß will, sollte man es ernst nehmen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660204
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706660204,
					"content": "Miau! „Ah, genau. Jetzt hast du dir meine Anerkennung verdient und du kannst auch die anderen in der Taverne zu einem Kartenspiel herausfordern. Hmm ... Sie werden dich bestimmt mögen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660205
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706660205,
					"content": "Die anderen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660206
					]
				},
				{
					"id": 706660206,
					"content": "Miau. „Ja, andere Katzen hier in der Taverne ... Unterschätze sie nicht.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660207
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706660207,
					"content": "Miau! „Wenn es so weit ist, kann Shuyun für sie die Karten legen. Also gut, der Tradition wegen muss ich jetzt noch eine Sache sagen!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660208
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706660208,
					"content": "#„{NICKNAME}, ich hoffe, dass du die Freude, ‚Geniale Beschwörung‘ zu spielen, spüren kannst!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Prinz“"
				}
			]
		},
