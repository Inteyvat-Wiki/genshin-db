					"„Neko“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500201,
					"content": "Der Große Narukami-Schrein ... ist hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500202
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500202,
					"content": "Es gibt so viele rote Tore. Mögen Menschen rote Tore sehr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500203
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500203,
					"content": "Das heißt Torii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500204
					]
				},
				{
					"id": 220500204,
					"content": "Der Asase-Schrein hat das auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500205,
					"content": "Oh, ich verstehe, das ist also das „Torii“. Dort leben doch die Vögel, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500206
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500206,
					"content": "Je mehr Torii es also gibt, desto mehr Vögel gibt es, denke ich. Vogel, das ist eine gute Sache. Der Mensch ist ziemlich ausgefuchst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500207
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500207,
					"content": "Habt ihr Hibiki gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500208
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500208,
					"content": "Keine Spur von Menschen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500209
					]
				},
				{
					"id": 220500209,
					"content": "Hier scheint niemand in der Nähe zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500210,
					"content": "Warum gehen wir nicht zum Großen Narukami-Schrein und fragen die Schreinjungfern dort?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500211,
					"content": "Ich glaube, dass Hibiki auch eine Schreinjungfer ist ... Vielleicht wissen die ja etwas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2205003,
			"completionStepIds": [
				2205003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205003",
							"2"
						],
						"stepId": 2205003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Neko“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500301,
					"content": "Miau, das ist ein großer Schrein und es gibt auch viele Menschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500302
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500302,
					"content": "Juhu! Die Spendenkästchen und Regale sind auch sehr groß. Kein Wunder, dass so viele Menschen hierherkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500303
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500303,
					"content": "Lernt gut! In Zukunft wird der Asase-Schrein so werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500304,
						220500305
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500304,
					"content": "Es geht nicht wirklich darum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				},
				{
					"id": 220500306,
					"content": "Sie ist immer noch nicht zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500307
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500307,
					"content": "Wie auch immer, lasst uns jemanden finden, den wir nach Hibiki fragen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500305,
					"content": "Warum soll ich gut lernen?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500306
					]
				}
			]
		},
		{
			"id": 2205004,
			"completionStepIds": [
				2205004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2205004",
							"2"
						],
						"stepId": 2205004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Inagi Hotomi",
					"„Neko“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500401,
					"content": "#Hallo, Reisende{M#r} aus der Ferne. Willkommen im Großen Narukami-Schrein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500402
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500402,
					"content": "Wenn du auf Schwierigkeiten stößt oder dir einfach etwas wünschen möchtest, kannst du dir hier ein Stäbchen holen. Möge die Göttin der Blitze dich segnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500403
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500403,
					"content": "Wir kommen wegen etwas anderem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500404,
					"content": "Bitte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500405
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500405,
					"content": "Also, es ist so ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500406
					]
				},
				{
					"id": 220500406,
					"content": "Hibiki vom Asase-Schrein? Asase Hibiki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500407
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500407,
					"content": "Ja! Hibiki ist „Asase Hibiki“, ein Mensch! Kennst du Hibiki? Weißt du, wo sie ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500408
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500408,
					"content": "Hmmm ... Hä?! Warum redet diese Katze? Habe ich das mir eingebildet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500409
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500409,
					"content": "Die Menschen sind leicht zu erstaunen ... Ist es seltsam, dass ich sprechen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500410
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500410,
					"content": "Kennst du Hibiki? Weißt du, wo sie ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500411
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500411,
					"content": "Es ist ein seltsames Gefühl, von einer solchen Katze befragt zu werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500412
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500412,
					"content": "Wenn ihr wirklich nach der „Asase Hibiki“ fragt, dann sucht ihr an der falschen Stelle ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500413
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500413,
					"content": "Wie? Wie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500414,
					"content": "Falsche Stelle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500415
					]
				},
				{
					"id": 220500415,
					"content": "Ich hatte ihren Namen schon einmal in einem der wenigen gut erhaltenen kanonischen Bücher des Heiligtums gelesen. Sie war die letzte Generation im Asase-Schrein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500416
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500416,
					"content": "Vor etwa vierhundert oder fünfhundert Jahren gab es ein Yougou-Trio. Asase Hibiki, Kamuna Harunosuke und Mikoshi Nagamasa waren einst auf dem Yougou-Berg und lernten bei dem Yougu-Berg-Tengu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500417
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500417,
					"content": "Während dieser Zeit ging Asase an unserem Schrein in die Lehre und freundete sich auch mit der Kitsune Saiguu an. Doch am Ende ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500418
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500418,
					"content": "Es scheint, dass die drei nach einer „Katastrophe“, die aus den Aufzeichnungen nicht eindeutig hervorgeht, schließlich getrennte Wege gingen. Es heißt, dass Kamuna Harunosuke das Meer nach Liyue überquerte, um den mächtigeren „Weg der Adepten“ zu lernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500419
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500419,
					"content": "Mikoshi Nagamasa kehrte nach Inazuma zurück, um dem Bakufu zu dienen. Asase, auf der anderen Seite ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500420,
						220500421
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500420,
					"content": "Ging zurück nach Seirai ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500422
					]
				},
				{
					"id": 220500422,
					"content": "Nun, das ist richtig. Da es aber nur wenige historische Informationen gibt, sind die Einzelheiten nicht so klar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500423
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500423,
					"content": "Warte einen Moment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500424
					]
				},
				{
					"id": 220500424,
					"content": "Nun ... sie sagte, es sei vierhundert oder fünfhundert Jahre her, was bedeutet, dass Hibiki jemand von vor langer Zeit ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500425,
					"content": "Ist Neko auch eine Katze, die vierhundert oder fünfhundert Jahre alt ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500426,
					"content": "Das weiß ich nicht. Was heißt das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500427
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500427,
					"content": "Ich bin kein Mensch. Es gibt nicht so viel, worauf ich mich versteife, nur den Sonnenaufgang und den Mondaufgang. Wenn ich schlecht gelaunt bin, dann schlaf ich einfach aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500428
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500428,
					"content": "Bewundernswert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500429,
						220500431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500429,
					"content": "Paimon ist da ähnlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500430
					]
				},
				{
					"id": 220500430,
					"content": "#He! Das ist unhöflich, Paimon macht sich jeden Tag große Sorgen um {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500433,
					"content": "Ihr sprecht viel über Sachen, die ich nicht kenne. Wo ist Hibiki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500434
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500434,
					"content": "Wenn ich ehrlich sein darf, ist sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500435
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500435,
					"content": "Sie ist nicht hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500436
					]
				},
				{
					"id": 220500436,
					"content": "Genau. Sie ist woanders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500437,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500438
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500438,
					"content": "Das stimmt auch wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500439
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500439,
					"content": "Ich kann es nicht fassen. Warum benimmt sich Hibiki immer noch wie ein kleines Kind und läuft herum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500440
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500440,
					"content": "Wie auch immer, danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500441,
					"content": "Na, dann los.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500442
					]
				},
				{
					"id": 220500442,
					"content": "Lass mich wissen, wenn du Hilfe brauchst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500431,
					"content": "Kann eine Katze so lange leben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500432
					]
				},
				{
					"id": 220500432,
					"content": "Normalerweise nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500421,
					"content": "Ging zurück zum Asase-Schrein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500422
					]
				}
			]
		},
		{
			"id": 2205005,
			"completionStepIds": [
				2205006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
