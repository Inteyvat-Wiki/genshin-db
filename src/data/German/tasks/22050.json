			"dialogs": [
				{
					"id": 220500701,
					"content": "Gibt es noch etwas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500702,
						220500705,
						220500710
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500702,
					"content": "Über Mikoshi ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500703
					]
				},
				{
					"id": 220500703,
					"content": "Der Legende nach stand Mikoshi in den Diensten des Bakufu und gilt als äußerst aufrichtig, sogar bis hin zu ... fast schon unflexibel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500704
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500704,
					"content": "Seine Nachfahren leben bis heute. Die meisten der Menschen in der Stadt, die heute noch den Nachnamen Mikoshi tragen, sind seine Nachkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500705,
					"content": "Über Kamuna ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500706
					]
				},
				{
					"id": 220500706,
					"content": "Es wird nicht viel über ihn geschrieben. Nachdem er das Meer nach Liyue überquert hatte, um die Adeptenkräfte zu lernen, kehrte er nach Inazuma zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500707
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500707,
					"content": "Danach gründete er sein eigenes Onmyoudou und Shiki-Taishou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500708
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500708,
					"content": "Den Aufzeichnungen zufolge setzte er diese Technik ein, um den Bakedanuki Ioroi, der viel Unfug trieb, zu versiegeln, um den Frieden in Inazuma zu sichern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500709
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500709,
					"content": "Doch dann geriet auch er in Vergessenheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500710,
					"content": "Tschüs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500711
					]
				},
				{
					"id": 220500711,
					"content": "Lass mich wissen, wenn du Hilfe brauchst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				}
			]
		}
