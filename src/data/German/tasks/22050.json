				"objectNames": [
					"„Neko“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220500601,
					"content": "Puh ... endlich wieder da ... Nachdem ich so viel Zeit neben dem Schrein verbracht hatte, ist mein Fell ganz zerzaust.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500602
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500602,
					"content": "Danke euch, ihr seid zuversichtliche Menschen *miau*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500603
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500603,
					"content": "Ich kümmere mich weiter um den Schrein. Wenn Hibiki zurückkommt, stelle ich euch einander vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500604
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500604,
					"content": "Miau, miau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500605
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500605,
					"content": "Hibiki, wann kommt sie zurück?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		},
