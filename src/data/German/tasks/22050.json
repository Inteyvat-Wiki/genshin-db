			},
			"dialogs": [
				{
					"id": 220500501,
					"content": "Machen wir hier Pause. Ich bin müde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500502
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500502,
					"content": "Es ist, wie Hibiki es gesagt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500503
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500503,
					"content": "Die verschiedenen Inseln sind wirklich völlig unterschiedlich. Und es stellt sich heraus, dass der Schrein auf einem so hohen Hügel stehen kann. Haben Menschen keine Höhenangst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500504
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500504,
					"content": "Mein Asase-Schrein ist besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500505
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500505,
					"content": "Wo ist Hibiki nur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500506
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500506,
					"content": "Sollen wir weitersuchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500507
					]
				},
				{
					"id": 220500507,
					"content": "Ich bin müde, später vielleicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500508
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500508,
					"content": "Später!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500509,
					"content": "Das steht fest. Sie hat mir so viele Geschichten erzählt. Geschichten über den Strand, Geschichten über einen Ort mit vielen Bäumen, Geschichten über die Kitsune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500510
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500510,
					"content": "Ich erinnere mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500511
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500511,
					"content": "Aber das Wichtigste ist jetzt, nach Hause zu kommen. Schließlich muss der Asase-Schrein seinen Guuji haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500512
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 220500512,
					"content": "Kommt mit mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		},
		{
			"id": 2205006,
