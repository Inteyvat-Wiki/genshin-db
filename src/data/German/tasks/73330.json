			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush",
					"Markozov",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733300701,
					"content": "Ihr Unholde, seht bloß zu, dass ihr von hier verschwindet! Weder das Erbe der Pari, noch ihre Geheimnisse werdet ihr je erlangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300702
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300702,
					"content": "Pari? Pari! Na, das ist mal was Neues!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300703
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300703,
					"content": "#Oh! Und was haben wir hier? {M#Ein kräftiger Junge und sein}{F#Eine kleine Dame und ihr} ... Haustier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300704
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300704,
					"content": "#He! Wie unhöflich! Paimon ist {M#seine}{F#ihre} allerbeste Reisegefährtin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300705,
					"content": "Reisegefährtin ... Aber klar doch! Und allerbeste Reisegefährtin, das klingt echt schick! Als Kind wollte ich auch immer so etwas wie eine „allerbeste Reisegefährtin“ haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300706
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300706,
					"content": "#Also, {M#mein Junge}{F#kleine Dame}, du brauchst doch sicher keine zwei „allerbesten Reisegefährtinnen“, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300707,
						733300708
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300707,
					"content": "Was willst du damit andeuten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300710
					]
				},
				{
					"id": 733300710,
					"content": "Ich meine damit, dass das ja ein echter Luxus ist! Selbst für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300711
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300711,
					"content": "Eine solche Ungerechtigkeit kann ich aber nicht dulden ... Deshalb bitte ich dich ganz nett darum, mir deine Pari zu überlassen. Und keine Sorge, bei mir ist sie in guten Händen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300712
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300712,
					"content": "Ungehobelter Klotz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300713
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300713,
					"content": "Mit so einem lässt sich nicht reden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300714,
					"content": "In dieser Welt gibt es andere Mittel, die wirksamer sind als Worte ... Mein Yasnapati, du bist schlau, du verstehst sicher, was ich meine, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300715
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300715,
					"content": "Lass Paimon mal raten. Sorush meint sicher damit, ihn grün und blau zu schlagen, dann sehen wir, was passiert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300716,
					"content": "Sei mal ruhig, weißes Schweberchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300708,
					"content": "Ich habe nichts dagegen, mehr Gefährten zu haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300709
					]
				},
				{
					"id": 733300709,
					"content": "Was? Niemals! Es kann nur eine „allerbeste“ Gefährtin geben, und das ist Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300710
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}