				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vind"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200401,
					"content": "#Hmm? Was führt dich her, {F#Reisende}{M#Reisender}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200402
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200402,
					"content": "Wo warst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200403
					]
				},
				{
					"id": 411200403,
					"content": "Oh, tut mir leid. Ich war am Meer spazieren, war also wohl nicht so leicht zu finden ... Was gibt es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200404
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200404,
					"content": "Bitte begib dich nach Mondstadt, dort ist es sicher.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200405
					]
				},
				{
					"id": 411200405,
					"content": "Sicher? Ah, du meinst diese Meteoriten. Ich verstehe, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200406
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200406,
					"content": "Pa... Pass auf! Da kommen Monster!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4112006,
			"completionStepIds": [
				4112006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112006",
							"2"
						],
						"stepId": 4112006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vind"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200601,
					"content": "Puh ... Danke, das war echt knapp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200602
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200602,
					"content": "Und darum solltest du Schutz suchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200603
					]
				},
				{
					"id": 411200603,
					"content": "Es tut mir leid, aber ich kann gerade nicht zurück. Diese gefallenen Sterne sind schon seltsam genug ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200604
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200604,
					"content": "In Zeiten wie diesen wäre es wenig überraschend, wenn ein Sturm wieder die Meere aufrüttelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200605
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200605,
					"content": "Ich muss hier weiter Wache halten. Falls ein Sturm aufzieht, muss ich die Stadt sofort warnen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200606
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 411200606,
					"content": "Danke aber für die Nachricht. Ich werde besser aufpassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				}
			]
		},
		{
			"id": 4112007,
			"completionStepIds": [
				4112007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112007",
							"2"
						],
						"stepId": 4112007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200701,
					"content": "Du bist zurück. Konntest du alle benachrichtigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200702
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200702,
					"content": "Ja. Aber keiner von ihnen will zurückkehren ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200703
					]
				},
				{
					"id": 411200703,
					"content": "Alle weigern sich? Wenn sie in solchen Zeiten unbedingt draußen bleiben wollen, müssen sie wichtige Pflichten versehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200704
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200704,
					"content": "So sind nun mal die freien Bewohner von Mondstadt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200705
					]
				},
				{
					"id": 411200705,
					"content": "Haha, das ist wahr. Die Bewohner von Mondstadt sind wirklich frei wie der Wind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200706
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200706,
					"content": "Doch gerade jetzt wünschte ich, sie würden sich ein wenig zügeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200707
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200707,
					"content": "#*seufz* Die Ritter sind wahrscheinlich ebenfalls beschäftigt. Ich werde mir etwas anderes einfallen lassen, um sie zu überzeugen. Danke, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200708
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200708,
					"content": "Ich bete dafür, dass alle gesund bleiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
		{
			"id": 4112008,
			"completionStepIds": [
				4112008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
