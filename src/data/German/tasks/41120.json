			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Doolan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200301,
					"content": "Jetzt ist nicht die Zeit, um zu forschen. Wir müssen Schutz suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200302
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200302,
					"content": "Wie ich zuvor schon sagte, ich lasse mir diese Gelegenheit nicht entgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200303
					],
					"speakerTitle": "Neugierige Patchi"
				},
				{
					"id": 411200303,
					"content": "Pardon, aber es wird Zeit, Schutz in Mondstadt zu suchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200304
					]
				},
				{
					"id": 411200304,
					"content": "Schon wieder? Jetzt ist nicht die Zeit dafür. Diese Meteoriten bieten uns womöglich die Gelegenheit, tiefer in den Tempel der Tausend Winde vorzudringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200305
					],
					"speakerTitle": "Neugierige Patchi"
				},
				{
					"id": 411200305,
					"content": "Tiefer in den Tempel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200306
					]
				},
				{
					"id": 411200306,
					"content": "Patchi meint, wenn ein Meteorit den Tempel der Tausend Winde trifft, bahnt er uns einen Weg in die inneren Kammern des Tempels ... oder was auch immer da unten liegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200307
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200307,
					"content": "Aber das ist bloß Wunschdenken. Sollte ein Meteorit den Tempel treffen, kommen wir nicht rechtzeitig weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200308
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200308,
					"content": "Wir sollten uns wirklich in Sicherheit bringen. Und falls tatsächlich ein Meteorit den Tempel der Tausend Winde trifft und so einen Weg öffnet, können wir später nicht einfach zurückkommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200309
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200309,
					"content": "Aber was, wenn uns jemand zuvorkommt? Wenn du zurück willst, dann geh. Ich werde hier warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200310
					],
					"speakerTitle": "Neugierige Patchi"
				},
				{
					"id": 411200310,
					"content": "#Aber ... Na gut. Tut mir leid, {F#Reisende}{M#Reisender}, aber wir beide bleiben noch eine Weile hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200311
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200311,
					"content": "Keine Sorge. Bei Gefahr kümmere ich ... ich mich selbst darum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200312
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200312,
					"content": "Oh, richtig. Hier kam zuvor jemand namens Schuster vorbei. Der wirkte ziemlich erschüttert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200313
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200313,
					"content": "Er bat mich um einen Schluck Wasser. Dann meinte er, dass er nach Mondstadt müsse, und eilte weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200314
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200314,
					"content": "Allerdings rannte er nicht in Richtung der Stadt, sondern in Richtung des Windblickkaps.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200315
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200315,
					"content": "Vielleicht ... hat die Furcht seinen Orientierungssinn durcheinandergebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200316
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200316,
					"content": "Du solltest am Windblickkap nach ihm sehen. Vielleicht läuft er Monstern über den Weg, das wäre nicht auszudenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200317
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 411200317,
					"content": "Ich werde Patchi Gesellschaft leisten, und falls wirklich etwas passiert ... Ähm, kümmere ich mich selbst darum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		},
		{
			"id": 4112004,
