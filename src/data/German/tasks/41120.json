				"objectNames": [
					"Ängstlicher Schuster"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200801,
					"content": "Argh! Du ... Oh, du bist kein Monster ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200802
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 411200802,
					"content": "Pardon, aber es wird Zeit, Schutz in Mondstadt zu suchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200803
					]
				},
				{
					"id": 411200803,
					"content": "Ich - Ich weiß, dass ich das sollte! Ich bin auch hier draußen, um die Leute zu warnen. Ich habe zwar ein paar Umwege genommen, aber trotzdem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200804
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 411200804,
					"content": "Warum hast du dich dann da drüben versteckt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200805
					]
				},
				{
					"id": 411200805,
					"content": "Ich ... Ich ruhe mich aus! Ist das ein Problem? Mach dir um mich keine Sorgen! Geh einfach nach Mondstadt zurück ... oder so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200806
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 411200806,
					"content": "Gefallene Sterne und Monster ... man muss schon verrückt sein, um sich draußen herumzutreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200807
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 411200807,
					"content": "Nun, treibt sich denn momentan noch jemand draußen herum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200808
					]
				},
				{
					"id": 411200808,
					"content": "Eigentlich habe ich nach Vind gesucht ... das ist die Ordensschwester, die sich stets am Windblickkap aufhält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200809
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 411200809,
					"content": "Ich habe das gesamte Gebiet abgesucht, aber konnte sie nicht finden, also habe ich mein Glück woanders versucht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200810
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 411200810,
					"content": "Doch dann sah mich eine Gruppe rasender Monster. Ich konnte nur knapp entkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200811
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 411200811,
					"content": "Über Umwege schlug ich mich zurück zum Windblickkap – doch immer noch kein Zeichen von Vind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200812
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 411200812,
					"content": "Ich kann nur hoffen, dass die Ordensschwester wieder zurück in Mondstadt ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200813
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 411200813,
					"content": "Ich gehe zurück zur Stadt. Das solltest du auch tun. Jetzt ist nicht die Zeit für Spaziergänge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ängstlicher Schuster"
				}
			]
		},
