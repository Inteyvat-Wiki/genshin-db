			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200101,
					"content": "Ich bete dafür, dass alle gesund bleiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200102
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200102,
					"content": "Was beschäftigt dich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200103
					]
				},
				{
					"id": 411200103,
					"content": "#Oh, du bist es, {F#Reisende}{M#Reisender}. Du hast die Meteoriten auch gesehen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200104
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200104,
					"content": "Zum Glück ist keiner in der Stadt eingeschlagen, aber ich sorge mich um die, die noch draußen sind. Es muss ein riesiges Chaos sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200105
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200105,
					"content": "#{F#Reisende}{M#Reisender}, würdest du dabei helfen, sie zu warnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200106
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200106,
					"content": "Falls Sie eine Zuflucht suchen, können Sie in die Stadt kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200107,
						411200109
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200107,
					"content": "Alles klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200108
					]
				},
				{
					"id": 411200108,
					"content": "#Vielen Dank, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200112,
					"content": "Suche zuerst nach Lynn. Vielleicht weiß sie, wer sich alles noch draußen herumtreibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200113,
					"content": "Überzeuge sie davon, Zuflucht in Mondstadt zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200114
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200114,
					"content": "Dies ... ist nicht die Zeit für ein „Überlebensabenteuer in der Wildnis“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200109,
					"content": "Warum schlug keiner der Meteoriten in der Stadt ein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200110
					]
				},
				{
					"id": 411200110,
					"content": "Vielleicht war es nur Glück. Wie auch immer, in Mondstadt ist es momentan sicherer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200111
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 411200111,
					"content": "Zumindest sicherer als da draußen ... oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200112
					],
					"speakerTitle": "Grace"
				}
			]
		},
		{
			"id": 4112002,
			"completionStepIds": [
				4112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112002",
							"2"
						],
						"stepId": 4112002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lynn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411200201,
					"content": "Unter solchen Bedingungen fällt es schwer in der Wildnis zu überleben, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200202
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200202,
					"content": "Bitte suche Zuflucht in Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200203
					]
				},
				{
					"id": 411200203,
					"content": "Zuflucht suchen? Oh, keine Sorge. Ich achte auf meine Umgebung. Mir passiert nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200204
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200204,
					"content": "Aber warum bist du noch hier draußen? Du solltest zurück nach Mondstadt – einer dieser Meteoriten könnte dich treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200205
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200205,
					"content": "Wegen der Leute, die noch da draußen sind ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200206
					]
				},
				{
					"id": 411200206,
					"content": "Die Leute, die sich draußen herumtreiben? Es sind ziemlich viele – warum fragst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200207,
						411200211
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200207,
					"content": "Sie sollen sich in Sicherheit bringen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200208
					]
				},
				{
					"id": 411200208,
					"content": "Oh, darum geht es also ... Tatsächlich verteilt die Gilde Aufträge deswegen. Ich habe bereits vielen Leuten Bescheid gegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200209
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200209,
					"content": "Wer nahe bei der Stadt lebt, hat sich bereits dorthin begeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200210
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200210,
					"content": "Allerdings haben wir zu wenig Abenteurer für diese Aufgabe, viele Leute wissen also noch nichts davon. Wenn du uns aushelfen könntest, wäre das großartig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200215,
					"content": "Lasst mich kurz nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200216
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200216,
					"content": "Ah, richtig! Ich glaube, Patchi und Doolan sind immer noch im Tempel der Tausend Winde. Ich versuchte sie zu warnen, doch sie wollte ihre Forschung dort nicht abbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200217
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200217,
					"content": "Und dann gibt es noch Vind, die immer noch am Windblickkap verweilt. Die Gilde bat mich, nach ihr zu sehen, doch ich konnte sie nicht finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200218
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200218,
					"content": "Das sind alle Leute, die mir einfallen. Fang doch mit denen an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200219
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200219,
					"content": "Ich werde das Gebiet noch einmal durchstreifen und allen Bescheid geben, die ich finde, sobald etwas Nahrung vorbereitet habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200220
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200220,
					"content": "Hoffentlich sind sie nicht zu weit weg, ansonsten dürfte die Rückkehr in die Stadt anstrengend für sie werden, selbst wenn wir sie finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200211,
					"content": "Schwester Grace ist äußerst besorgt um sie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411200212
					]
				},
				{
					"id": 411200212,
					"content": "Du bist also hier auf Geheiß von Grace? Tatsächlich verteilt die Gilde Aufträge deswegen. Ich habe bereits vielen Leuten Bescheid gegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200213
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200213,
					"content": "Wer nahe bei der Stadt lebt, hat sich bereits dorthin begeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200214
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 411200214,
					"content": "Allerdings haben wir zu wenig Abenteurer für diese Aufgabe, viele Leute wissen also noch nichts davon. Wenn du uns aushelfen könntest, wäre das großartig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411200215
					],
					"speakerTitle": "Lynn"
				}
			]
		},
		{
			"id": 4112003,
			"completionStepIds": [
				4112003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112003",
