			"dialogs": [
				{
					"id": 750210101,
					"content": "Na, was machst du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210102,
					"content": "... Waaah! Du hast mich echt erschreckt! Wenn ich deswegen gefallen wäre, wie willst du mir das ersetzen? Ohne verborgene Kraft bin ich doch nur ein hilfloses Kind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210103
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210103,
					"content": "Oh, Entschuldigung, Paimon wollte dich echt nicht erschrecken. Aber ... Verborgene Kraft? So eine Art Wahnsinns-Spezialfähigkeit oder was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210104,
					"content": "Tja, da es eine verborgene Kraft ist, wie soll ich dann wissen, was sie wirklich ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210105,
						750210106
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210105,
					"content": "Das klingt logisch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				},
				{
					"id": 750210107,
					"content": "Lass uns das jetzt beiseitelegen. Könnt ihr mir bitte helfen, die Sternensplitter zurückzubekommen? Ich habe mir durch meine Hilfe bei Mama Coco etwas Taschengeld verdient und die ganzen Mora gebe ich euch dafür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210108
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210108,
					"content": "#Wenn du uns um Hilfe bittest, solltest du dich wenigstens mal vorstellen. Paimon ist Paimon und {M#er}{F#sie} ist {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210109,
					"content": "Der aktuelle Name ist nur ein Deckname ... Die meisten nennen mich Orqo, also könnt ihr mich auch so nennen. Also, wollt ihr mir bei den Sternensplittern helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210110
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210110,
					"content": "Hm, was genau sind diese Sternensplitter überhaupt? Klingt nicht gerade nach etwas, das man einfach finden kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210111,
					"content": "Es sind Splitter von Sternen, die vom Himmel gefallen sind. Wenn man sie findet und an ihren Ursprung zurückbringt, kann man die verlorene Kraft wiedergewinnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210112
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210112,
					"content": "Schaut mal, die Sterne, die vom Himmel gefallen sind, liegen da unten. Dort findet ihr sicher Hinweise auf die Sternensplitter. Bitte helft mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210113
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210113,
					"content": "Na gut, dann helfen wir dir eben einmal. Aber mal ehrlich, diese Sternensplitter und die verlorene Kraft klingen echt nach etwas aus einem Roman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210114,
					"content": "Kennt ihr die Geschichte von Qoyllor und Ukuku nicht? Hier, das ist für euch. Mein Vater hat sie mir immer erzählt, ich kenne sie auswendig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210115
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210115,
					"content": "Aber jetzt ist es wichtiger, wenn wir erstmal gemeinsam runtergehen und nachsehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210106,
					"content": "Du siehst jung aus, aber du sprichst wie ein Philosoph.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				}
			]
		},
