			"dialogs": [
				{
					"id": 750210501,
					"content": "Das ist alles, oder? Diese Mission ist viel einfacher, als Paimon gedacht hat! Aber gibt es wirklich so etwas Fantastisches? Vorher war Paimon da noch ein bisschen skeptisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210502,
					"content": "Paimon, willst du auch, dass die verborgene Kraft erwacht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210503
					]
				},
				{
					"id": 750210503,
					"content": "#Klar, wer würde sich nicht über eine Super-Schatzsucher-Fähigkeit oder über eine Superkraft zum Ein-Schlag-K.O. von Monstern freuen? {NICKNAME}, willst du das nicht auch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210504,
						750210506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210504,
					"content": "Ich brauche mehr Kraft!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210505
					]
				},
				{
					"id": 750210505,
					"content": "Mehr Kraft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210508,
					"content": "Bringt die verlorenen Splitter schnell zurück zum Stern! Hmm ... Was für eine Kraft werde ich wohl erwecken? Vielleicht kann ich dann in den Himmel fliegen ... Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210506,
					"content": "Ich bin schon stark genug, das brauche ich nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210507
					]
				},
				{
					"id": 750210507,
					"content": "Hä? Heißt es nicht immer, dass der Weg zur Kraft kein Ende hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
