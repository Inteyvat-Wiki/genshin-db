			},
			"dialogs": [
				{
					"id": 750210301,
					"content": "Puh ... Allein wäre ich da nie runtergekommen, danke euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210302
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210302,
					"content": "Ist das wirklich ein Stern, der vom Himmel gefallen ist? Aus der Nähe sieht das ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210303,
						750210306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210303,
					"content": "Aaaah, eine geheimnisvolle Kraft entfaltet sich in mir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210304
					]
				},
				{
					"id": 750210304,
					"content": "Was?! Echt jetzt? Wir haben die verstreuten Sternensplitter doch noch gar nicht gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210305,
					"content": "Mal ehrlich, gibt es hier echt Hinweise der Sternensplitter? Paimon hat keinen blassen Schimmer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210308,
					"content": "Was machen wir jetzt als Nächstes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210309,
					"content": "Wir müssen es wohl mit roher Gewalt versuchen. <color=#00E1FFFF>Vielleicht hilft es, wenn wir es mit der Kraft von einem Tepetlisaurier so richtig durchschütteln,</color> um den verlorenen Sternensplitter zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210310,
					"content": "Die meisten Probleme kann man mit roher Gewalt lösen, sagt mein Vater immer. Aber ich habe noch keine erwachte Kraft und keinen Saurier ... Also, ich zähle auf euch beide!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210306,
					"content": "Was für ein merkwürdiger Stein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210307
					]
				},
				{
					"id": 750210307,
					"content": "Das ist wirklich einzigartig ... Aber ist Paimon vielleicht zu unempfindlich? Paimon spürt keine geheimnisvolle Kraft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				}
			]
		},
