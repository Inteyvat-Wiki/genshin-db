			},
			"dialogs": [
				{
					"id": 750211301,
					"content": "#{NICKNAME}, spürst du irgendeine erstaunliche Kraft?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211302,
					"content": "Nein, nichts Besonderes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211303
					]
				},
				{
					"id": 750211303,
					"content": "Der große Stein zeigt keine Veränderung, kein geheimnisvolles Leuchten, kein plötzliches Zittern oder Aufbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211304,
					"content": "Hm, vielleicht haben wir den falschen Zauberspruch gesagt? Klang aber ziemlich überzeugend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211305,
					"content": "So was passiert bei Ruinen-Expeditionen manchmal! Man vergisst einen Code oder ein Passwort und dann bewegt sich die Vorrichtung gar nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211306,
					"content": "Wie merkwürdig ... Man hat mir doch gesagt, so könnte man die verborgene Kraft freisetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211307
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211307,
					"content": "Derjenige, der mir das erzählt hat, hat nach dem Zauberspruch die Augen zugehalten und vor Schmerzen gejammert. Aber danach hat er das „Magische Auge“ bekommen, mit dem er den Wert von Edelsteinen erkennen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211308,
						750211310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211308,
					"content": "Waaah, das ist ja richtig fantastisch!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211309
					]
				},
				{
					"id": 750211309,
					"content": "Hä? Paimon finde das irgendwie ganz schön verdächtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211311,
					"content": "Oh, endlich habe ich dich gefunden, du kleiner Dussel! Was machst du hier? Dein Vater ist schon total besorgt, weil er dich nicht finden kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211312
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211312,
					"content": "Ich habe ihm doch gesagt, dass ich zur Essenszeit pünktlich zurückkomme. Mama Coco, musste er dir das wirklich erzählen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211313
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211313,
					"content": "Hör auf, so frech zu sein! Ihr zwei kleinen Freunde, ihr solltet euch besser nicht länger da unten aufhalten. Wer weiß, welche Gefahren euch dort noch erwarten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211314
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211314,
					"content": "Ihr bringt Orqo an die Oberfläche und erzählt Mama Coco, was passiert ist ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750211315
					]
				},
				{
					"id": 750211315,
					"content": "*seufz* Das Zeug, was er erzählt hat, war nur kindlicher Quatsch. Es ist echt lieb von euch, dass ihr auf seine kindlichen Fantasien eingegangen seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211316
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211316,
					"content": "Der Kleine ist echt ein freches Kerlchen, weil seine Mutter nie da ist und sein Vater auch noch Sehprobleme hat. Ich als Nachbarin wollte zwar helfen, aber meine Kräfte sind eben auch nicht unendlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211317
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211317,
					"content": "Ach, so ist das also! Paimon hat es schon vorher ein bisschen verdächtig gefunden! Wie kann es so einfach sein, dass man nur durch das Sammeln von ein paar Steinsplittern mystische Kraft oder so etwas erlangen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211318,
					"content": "Ich tue das nicht, weil ich frech bin, ich tue es für Papa ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211319
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211319,
					"content": "Kleiner Dussel, du hörst nie auf die Ratschläge von erfahrenen Erwachsenen? Diesmal ist alles gut gegangen, aber was ist, wenn du irgendwann mal wirklich in Schwierigkeiten gerätst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211320
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211320,
					"content": "Ach, komm, sei jetzt nicht so stur und komm brav mit mir zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211321
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211321,
					"content": "Na gut, aber bevor wir gehen ... Hier, wie versprochen habe ich die ganzen Mora für euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211322
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211322,
					"content": "Nehmt das lieber an, damit er nicht als jemand dasteht, der sein Wort nicht hält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211323
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211323,
					"content": "Wenn ihr das so sagt, dann nehmen wir die Mora an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211324,
					"content": "Hm, vielleicht werde ich euch in Zukunft noch mal um Hilfe bitten. Scheitern heißt ja nicht, dass es beim nächsten Mal nicht klappen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211325
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211325,
					"content": "Äh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211326,
					"content": "Du kleiner Sturkopf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211327
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211327,
					"content": "Mama Coco, lass uns gehen, damit sich Papa nicht so Sorgen macht. Ihr Lieben, wir sehen uns dann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211310,
					"content": "Diese Symptome kommen mir irgendwie bekannt vor ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211311
					]
				}
			]
		},
