			"dialogs": [
				{
					"id": 750210701,
					"content": "Wahnsinn! Erstaunlich, ihr habt alle Sternensplitter gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210702
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210702,
					"content": "Ich habe Mama Coco bei ihren Aufgaben geholfen und dabei einiges an Taschengeld gespart. Hier, nehmt diese Mora und verkauft mir die Sternensplitter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210703
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210703,
					"content": "Sternensplitter? Weißt du überhaupt, was man damit anstellt? Und wie kommt es, dass du als Kind hier ganz allein unterwegs bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210704,
					"content": "... Alle nennen mich Orqo, ihr könnt mich auch so nennen. Auch wenn der gerade nur ein Deckname ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210705
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210705,
					"content": "Ich bin hier, um die Sternensplitter zu sammeln. Ihr seht doch den großen Stein da unten, oder? Das ist ein Stern, der vom Himmel gefallen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210706
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210706,
					"content": "Wenn man die verlorenen Splitter zurückbringt, kann man die verlorene Kraft wiedererlangen ... Bitte, ich brauche diese Sternensplitter wirklich sehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210707,
						750210709
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210707,
					"content": "Das klingt ja ziemlich verdächtig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210708
					]
				},
				{
					"id": 750210708,
					"content": "Hm ... Aber es ist wenigstens ein Hinweis. Lass es uns doch mal versuchen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210711,
					"content": "Aber mal ehrlich, diese Sternensplitter und die verlorene Kraft klingen echt nach etwas aus einem Roman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210712,
					"content": "Kennt ihr die Geschichte von Qoyllor und Ukuku nicht? Hier, das ist für euch. Mein Vater hat sie mir immer erzählt, ich kenne sie auswendig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210713
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210713,
					"content": "Aber das Wichtigste jetzt ist, dass wir zusammen runtergehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210714
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210714,
					"content": "Ihr seid zusammen mit Orqo an dem „gefallenen Stern“ angekommen ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750210715
					]
				},
				{
					"id": 750210715,
					"content": "Bringt die verlorenen Splitter schnell zurück zum Stern! Hmm ... Was für eine Kraft werde ich wohl erwecken? Vielleicht kann ich dann in den Himmel fliegen ... Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210709,
					"content": "Ach, so läuft das? Na, dann kriegst du sie erst recht nicht!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210710
					]
				},
				{
					"id": 750210710,
					"content": "Er ist doch nur ein Kind, da musst du nicht so ernst sein. Und wer weiß, ob er die Wahrheit sagt? Lass es uns einfach zusammen ausprobieren, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "Paimon"
				}
			]
		},
