			"dialogs": [
				{
					"id": 722760801,
					"content": "Das ist seltsam. Wo ist er?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760802
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760802,
					"content": "Es gibt hier einen Schatten von Tokoyo, hm? Ist er ... Bunkoku?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760803,
					"content": "Verwechsle mich nicht mit diesem verachtenswerten Verräter! Mein Name ist Koyanagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760804
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760804,
					"content": "Aber da du den Namen Bunkoku kennst, bist du mir mit böser Absicht hierher gefolgt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760805
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760805,
					"content": "Mein Freund muss viel lesen und sorgfältig analysieren, um den geheimen Schatz von Bunkoku zu finden. Ich werde auf keinen Fall zulassen, dass du ihn mir wegnimmst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760806
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760806,
					"content": "Du irrst dich. Wir sind nur ... äh ... zufällig hier unten gelandet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760807,
					"content": "Hmpf, dann geht bald.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760808
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760808,
					"content": "(Jemand war schon mal hier.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760809,
					"content": "(Sind sie uns bei der Schatzsuche zuvorgekommen?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760810,
						722760812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760810,
					"content": "Das ist unwahrscheinlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760811
					]
				},
				{
					"id": 722760811,
					"content": "Paimon dachte das auch. Hätten sie den Schatz erfolgreich gefunden, wäre der Bunkoku-Fall bis heute kein Geheimnis geblieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760814,
					"content": "Was murmelst du da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760815
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722760815,
					"content": "N... Nichts, gar nichts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760816,
					"content": "(Wie auch immer, lass uns diesen Ort weiter erforschen.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760812,
					"content": "Es ist möglich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760813
					]
				},
				{
					"id": 722760813,
					"content": "Nein, nein, nein. Hätten sie den Schatz gefunden, wäre der Bunkoku-Fall schon längst gelöst worden. Dann bliebe er nicht bis heute ein Rätsel.",
					"roleType": "TALK_ROLE_NPC",
