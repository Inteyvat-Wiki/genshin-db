			"dialogs": [
				{
					"id": 722760201,
					"content": "Darf ich dich bitten, einen Blick darauf zu werfen? Bitte fang nicht an, dich zu überfordern. „Mysteriös“ ist schließlich ein Synonym für „gefährlich“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yabe"
				}
			]
		},
		{
