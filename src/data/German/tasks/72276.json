				"points": []
			},
			"dialogs": [
				{
					"id": 722760301,
					"content": "He, hast du das gehört? Es scheint, als käme von dort oben ein seltsames Geräusch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760302
					],
					"speakerTitle": "Paimon"
				},
				{
