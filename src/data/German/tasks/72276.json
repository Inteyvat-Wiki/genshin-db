					"nextDialogs": [
						722760706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722760706,
					"content": "Wenn Paimon darüber nachdenkt, hat Yabe gesagt, dass die Kammer von den Sonnenflammenillusionen verborgen wird.",
