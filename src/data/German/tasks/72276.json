			},
			"dialogs": [
				{
					"id": 722761001,
					"content": "Wie ... Wie kann das sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761002
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761002,
					"content": "Was ist denn passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761003,
					"content": "Wie konnte ich meinen Freund angreifen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761004
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761004,
					"content": "Ich muss von einem der rachsüchtigen Geister besessen gewesen sein, die von Bunkoku beschworen wurden. Er war es, der mich kontrollierte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761005
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761005,
					"content": "Der Schatz ist nichts im Vergleich zu unserer Freundschaft. Ich würde nie in Versuchung kommen, ihn wegen eines unbedeutenden Schatzes anzugreifen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761006
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761006,
					"content": "Er vertraut mir so sehr, dass er mich sogar eingeladen hat, bei der Entdeckung von Bunkokus geheimem Schatz dabei zu sein ... I...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761007
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761007,
					"content": "Ich würde das nie tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761008
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761008,
					"content": "Hm, ist die Wahrheit also durch das letzte Stück verdeckt worden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761009,
					"content": "Er braucht etwas Zeit für sich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761010
					]
				},
				{
					"id": 722761010,
					"content": "Das tut er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761011,
					"content": "Lass uns zurückkehren und Yabe erzählen, was passiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7227611,
