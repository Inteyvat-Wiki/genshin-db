				},
				{
					"id": 722760413,
					"content": "Wir könnten es dem Schicksal überlassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760414
					]
				},
				{
					"id": 722760414,
					"content": "Du gibst schon auf? Paimon meint, wir könnten Yabe fragen.",
