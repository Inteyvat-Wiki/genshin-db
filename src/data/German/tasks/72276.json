			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yabe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722760101,
					"content": "#He, bist du {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760102
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760102,
					"content": "Ich frage mich, ob du dich an meinen Namen erinnerst. Ich bin Yabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760103
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760103,
					"content": "Hallo, Yabe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760104
					]
				},
				{
					"id": 722760104,
					"content": "Hallo, hallo, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760105
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760105,
					"content": "Du musst also ziemlich gut sein, was? Erst gegen Shougun Raiden antreten und dann der Dunkelheit von Enkanomiya trotzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760106
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760106,
					"content": "Das ist wahr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760107
					]
				},
				{
					"id": 722760107,
					"content": "Toll! Ich habe eine Spur zu einem bestimmten Schatz, aber das könnte eine gefährliche Reise bedeuten. Bist du interessiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760108
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760108,
					"content": "Obwohl mich geheimnisvolle Dingen schon immer angezogen haben, möchte ich mich lieber nicht in große Gefahr begeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760109
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760109,
					"content": "Ich bin interessiert. Erzähl mir mehr darüber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760110
					]
				},
				{
					"id": 722760110,
					"content": "Das habe ich gefunden, als ich den Dainichi Mikoshi patrouillierte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760111
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760111,
					"content": "Auch wenn es nur eine Steintafel zu sein scheint, glaube ich, dass sie der Schlüssel zum Finden des geheimen Schatzes von Bunkoku ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760112
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760112,
					"content": "Geheimer Schatz von Bunkoku?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760113
					]
				},
				{
					"id": 722760113,
					"content": "Der Name ist alles, was ich weiß, denn es gibt nicht viele detaillierte Berichte über Byakuyakoku, die die Geschichte von Watatsumi überlebt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760114
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760114,
					"content": "Eine Version besagt, dass Bunkoku der zweite Premierminister in der Geschichte von Byakuyakoku war. Er und das Sonnenkind ließen das Volk durch hohe Steuern ausbluten und verdienten ein großes Vermögen. Danach versteckte er seinen Schatz in einer geheimen Kammer im Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760115
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760115,
					"content": "Schließlich versteckte er die Schatzkammer mithilfe der Sonnenflammenillusionen und beschwor rachsüchtige Geister und verdorbene Wesen aus dem Fluss der Elemente als ihre Wächter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760116
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760116,
					"content": "Bunkoku hatte wahrscheinlich einen altertümlich klingenden Namen, so etwas wie „Tyeseus“ oder so ähnlich. Aber niemand würde die Geschichte eines verabscheuungswürdigen Verräters im Detail aufzeichnen wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760117
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760117,
					"content": "Lass uns zurück zur Steinplatte gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760118
					]
				},
				{
					"id": 722760118,
					"content": "Er ist wahrscheinlich der Schlüssel zur Schatzkammer von Bunkoku. Nach meiner jahrelangen Erfahrung mit Kaidan und bei der Untersuchung von Geheimnissen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760119
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760119,
					"content": "Es lautet ... ähm ... Es liegt mir auf der Zunge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760120
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760120,
					"content": "Du kannst ruhig ehrlich sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760121
					]
				},
				{
					"id": 722760121,
					"content": "Tatsächlich habe ich die Steintafel im Lagerraum des Dainichi Mikoshi gefunden und daneben lag ein Zettel, auf dem sowohl die alte Schrift als auch ihre Übersetzung verzeichnet sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760122
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760122,
					"content": "Es scheint, dass alle Dokumente, die während der Übergangszeit geschrieben wurden, mit einer Übersetzung versehen waren. Laut dieser Notiz steht die Steintafel in direktem Zusammenhang mit dem Bunkoku-Fall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760123
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760123,
					"content": "Hier steht auch, dass es insgesamt acht Schiefertafeln gibt. Bis jetzt haben wir nur eine gefunden. Laut der Notiz befindet sich die geheime Kammer in der Nähe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760124
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760124,
					"content": "Darf ich dich bitten, einen Blick darauf zu werfen? Um ehrlich zu sein, ist mir der Schatz egal. Ich wäre schon überglücklich, wenn ich den Bunkoku-Fall bis zur Lösung miterleben könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yabe"
				}
			]
		},
		{
			"id": 7227602,
