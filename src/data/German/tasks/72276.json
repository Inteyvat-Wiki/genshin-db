			"dialogs": [
				{
					"id": 722761201,
					"content": "Du bist zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761202
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761202,
					"content": "Hallo, Ya... Ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761203
					]
				},
				{
					"id": 722761203,
					"content": "Yabe! Mein Name ist Yabe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761204
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761204,
					"content": "*seufz* Kannst du dich nicht mal an meinen Namen richtig erinnern? Sag mir nicht, du hast vergessen, warum ich dich geschickt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761205
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761205,
					"content": "#{NICKNAME} macht nur Witze. Wir haben die Wahrheit über Bunkokus geheimen Schatz herausgefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761206,
					"content": "Du erzählst Yabe, was passiert ist ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722761207
					]
				},
				{
					"id": 722761207,
					"content": "Es gibt also wirklich eine geheime Kammer, die von den Sonnenflammenillusionen verborgen wird? Doch dann geschah etwas anderes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761208
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761208,
					"content": "Außerdem wird die Kammer von rachsüchtigen Geistern und verdorbenen Wesen bewacht, die die Gedanken der Menschen kontrollieren können. Oje, ich hatte solche Angst. Zum Glück bin ich nicht mit dir mitgegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761209
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761209,
					"content": "Hattest du Angst, dass wir verletzt werden könnten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761210
					]
				},
				{
					"id": 722761210,
					"content": "Ich hatte Angst, dass du mir eine Tracht Prügel verpassen könntest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761211
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761211,
					"content": "Wie auch immer, ich bin sowohl zufrieden als auch ein bisschen frustriert. Ich danke dir. So unergründlich das Rätsel auch erscheinen mag, mit Blick auf die Elementarkraft scheint alles zu stimmen. Das macht die Sache nicht gerade spannender.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761212
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722761212,
					"content": "Das Bunkoku-Rätsel wurde endlich geknackt und ich werde es der ganzen Welt erzählen, sobald ich zurück bin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yabe"
				}
			]
		},
