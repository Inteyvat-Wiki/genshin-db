				{
					"id": 722761301,
					"content": "Ah, das ist das letzte Stück! Warum gibt es ein neuntes Stück?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722761302,
					"content": "Außerdem: Wo ist Bunkokus geheimer Schatz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761303
					],
					"speakerTitle": "Paimon"
				},
				{
