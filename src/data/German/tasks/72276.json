			"dialogs": [
				{
					"id": 722761101,
					"content": "Hehe, hahaha! Das ist die Verbindung der drei Welten, die nur einmal in jedem Jahrhundert stattfindet. Solange ich meinen Schatz jetzt verstecke, wird er ein Geheimnis bleiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761102
					],
					"speakerTitle": "Koyanagi"
				},
				{
					"id": 722761102,
					"content": "I... Ich bin nicht ...",
