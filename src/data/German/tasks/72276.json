					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760503
					]
				},
				{
					"id": 722760503,
					"content": "Es ist also alles wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760504
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760504,
					"content": "Laut der Notiz werden alle anderen Steintafeln in drei Gruppen eingeteilt und in drei Bereichen aufbewahrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760505
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760505,
					"content": "Ich nehme an, du hast die einfache Karte von Tsumi? Ich zeige sie dir mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760506
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760506,
					"content": "Warum hast du uns das nicht früher gesagt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760507
					]
				},
				{
					"id": 722760507,
					"content": "Nun, diese Gebiete sind voller Gefahren. Wenn sich die geheime Kammer als reines Hirngespinst herausstellt, hat es keinen Sinn, sie weiter zu erforschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760508
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760508,
					"content": "Ich würde mich so schlecht fühlen, wenn ich dich jemals wegen eines Streiches unserer Vorfahren in die Tiefe der Dunkelheit gehen lassen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760509
					],
					"speakerTitle": "Yabe"
				},
				{
					"id": 722760509,
					"content": "Gut, hier werden die Steintafeln aufbewahrt.",
