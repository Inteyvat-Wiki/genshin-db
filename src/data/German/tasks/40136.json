			"dialogs": [
				{
					"id": 401360301,
					"content": "Und der Gewinner des Furina-Preises der ersten Filmfestspiele auf der Fontainale ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360302
					],
					"speakerTitle": "Festspiel-Moderator"
				},
				{
					"id": 401360302,
					"content": "„Die zwei Musketiere“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360303
					],
					"speakerTitle": "Festspiel-Moderator"
				},
				{
					"id": 401360303,
					"content": "Wir haben gewonnen! Wir haben wirklich gewonnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360304,
					"content": "Herzlichen Glückwunsch, Herr Xavier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360305
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360305,
					"content": "Wir haben gewonnen ... Ich glaub’s nicht. Ich ... Ich kann euch nicht genug danken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360306,
					"content": "Seht ihr? Meine Einschätzung der Unterhaltungsindustrie von Fontaine war nie verkehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360307
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360307,
					"content": "Nun heißen wir den Produzenten von „Die zwei Musketiere“, Herrn Xavier willkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360308
					],
					"speakerTitle": "Festspiel-Moderator"
				},
				{
					"id": 401360308,
					"content": "Ich danke euch ... Ich danke euch allen so sehr für eure Anerkennung und Unterstützung. An dieser Stelle möchte ich einen besonderen Dank an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360309
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360309,
					"content": "Die Zeit vergeht wirklich schnell, nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360310
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360310,
					"content": "So fühlt es sich wirklich an. Es kommt mir vor, als wäre es erst gestern gewesen, dass du mir beibrachtest, wie man eine Muskete hält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360311
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360311,
					"content": "Wirst du wieder nach Fontaine zurückkehren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360312
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360312,
					"content": "Natürlich, ich liebe diese Stadt. Es passieren hier so viele neuartige und spannende Dinge, dass man kaum den Überblick behalten kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360313
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360313,
					"content": "Und du? Würdest du gern einmal Inazuma besuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360314
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360314,
					"content": "Ich kann nicht sagen, dass mir der Gedanke schon einmal gekommen wäre ... Aber ich werde ihn jetzt gern in Betracht ziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360315
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360315,
					"content": "Ich werde dich mit Freude erwarten. Ich würde dich gern bei mir zu Hause willkommen heißen und dir unseren Tee und unsere Süßigkeiten anbieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360316
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360316,
					"content": "Ja, wir hören voneinander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360317
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360317,
					"content": "Hast du alles erreicht, was du dir vorgenommen hattest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360318
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360318,
					"content": "Ja, und du solltest Inazuma eines Tages wieder besuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360319
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360319,
					"content": "Wie ist es Ogura und ihrem Textilien-Geschäft ergangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360320
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360320,
					"content": "Meines Wissens geht es ihr blendend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360321
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360321,
					"content": "Sag ihr schöne Grüße von mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360322
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360322,
					"content": "Das werde ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360323
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360323,
					"content": "Wie ich hörte, ist der Sturm abgeflaut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360324
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360324,
					"content": "Ja, auch die Kriegshandlungen wurden eingestellt. Frieden und Wohlstand haben wieder auf den Inseln Einzug gehalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360325
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401360325,
					"content": "Das klingt sehr gut. Es ist das richtige Wetter, um Kleidung zum Trocknen rauszuhängen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360326
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360326,
					"content": "... Ich möchte nochmals der ganzen Truppe und dem Filmteam meinen Dank ausdrücken. Ohne euch hätte ich weder diesen Film vollenden können, noch würde ich heute hier vor euch stehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360327
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360327,
					"content": "Dank der Unterstützung des gesamten Teams kann ich bei dieser Gelegenheit die Gründung unserer Filmgesellschaft bekannt geben. Sie heißt „Musketier-Filmstudio“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360328
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360328,
					"content": "Aah, so ein wohlklingender Name!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360329,
					"content": "Nun, wenn das so ist, bitten wir alle Mitglieder des Musketier-Filmstudios, auf die Bühne zu kommen ... für ein Erinnerungsfoto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360330
					],
					"speakerTitle": "Festspiel-Moderator"
				},
				{
					"id": 401360330,
					"content": "Oh! Jetzt gibt es auch noch ein Gruppenfoto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360331,
					"content": "Regisseurin Furina, ich denke, du bist die würdigste Person überhaupt, die diese Trophäe entgegennehmen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360332
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360332,
					"content": "Äh? Nein, nein! Nicht nötig ... Das ist so peinlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360333
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360333,
					"content": "Diese Ehre gebührt der Regisseurin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360334
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360334,
					"content": "Ja, ich stimme zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360335
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401360335,
					"content": "Niemand sonst kommt noch mehr für diese Ehrung infrage.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360336
					]
				},
				{
					"id": 401360336,
					"content": "Finde dich einfach damit ab, dass du die richtige Person bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360337
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 401360337,
					"content": "Seid ihr bereit? Drei, zwei, eins ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360338
					],
					"speakerTitle": "Festspiel-Moderator"
				},
				{
					"id": 401360338,
					"content": "Musketier-Filmstudiooo!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
