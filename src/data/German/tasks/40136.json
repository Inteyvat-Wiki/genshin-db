			"dialogs": [
				{
					"id": 401360101,
					"content": "Danach vergeht wieder etwas Zeit ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401360102
					]
				},
				{
					"id": 401360103,
					"content": "Xavier! Lange nicht gesehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360104,
					"content": "Hallo, ihr beiden. Tut mir leid, dass ich mich so rar gemacht habe. Die Vermarktung und die Vorbereitungen für das Erscheinen des Films haben mich krass gestresst, seit wir mit der Nachbearbeitung fertig waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360105,
					"content": "Heute findet die Preisverleihung statt, oder? Ob wir wohl den Furina-Preis gewinnen werden!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360106,
					"content": "Ich bin mir zu neunzig Prozent sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360107
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360107,
					"content": "Furina! Paimon wusste nicht, dass du schon hier bist. Du bist früher dran als alle anderen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360108,
					"content": "Ich bin sicher, die anderen werden auch jeden Moment hier sein. Hmm, Xavier, für den Fall, dass wir auf die Bühne gerufen werden ... haben wir einen Namen für unser Team?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360109
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360109,
					"content": "Ähm, aber wir wissen nicht einmal, ob wir gewinnen werden. Ich möchte uns lieber kein Pech bringen, indem wir zu früh feiern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360110,
					"content": "Du musst nur mal deine Augen aufmachen! Du hast doch gesehen, wie das Publikum auf den Film reagierte! Wir wurden von den Kritikern mit Beifall überhäuft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360111,
					"content": "Du warst auch in Gesprächen mit dem Personal des Opernhauses, oder? Sagten sie nicht, sie wollten die Anzahl der Aufführungen erhöhen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360112,
					"content": "Mit den Mora, die du aus dem Kartenverkauf eingenommen hast, gründest du deine eigene Filmgesellschaft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360113,
					"content": "A... Aber das gebührt alles unserem fantastischen Team! Jeder von euch hat dazu beigetragen, dass dies hier Realität wurde. Da ist es nicht fair, wenn ich allein einen Namen auswählen darf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360114
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360114,
					"content": "Also, denk darüber nach. Bestimmt wird das Team deine Entscheidung respektieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360115
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360115,
					"content": "#In Ordnung ... Aber bevor ich das tue, {NICKNAME} und Paimon, könnte ich euch bitten, dem Fort Méropide schnell einen Besuch abzustatten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360116,
					"content": "Hä? Aber wir müssen doch zur Preisverleihung hierbleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360117,
					"content": "Ich möchte euch bitten, Chevreuse zur Preisverleihung einzuladen. Immerhin ist sie eine unserer Hauptrollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360118,
					"content": "Ich konnte sie in letzter Zeit nicht auffinden, deshalb hatte ich keine Möglichkeit, sie persönlich einzuladen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360119
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360119,
					"content": "Die Nachrichten berichten, dass die Verurteilten im Musketenmordfall heute von der Truppenführerin der Sonderpatrouille für Sicherheit und Überwachung persönlich nach Fort Méropide eskortiert werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360120,
					"content": "Aha, jetzt versteht Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360121,
					"content": "Pillepalle! Für uns ist das keine große Sache.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360122
					]
				},
				{
					"id": 401360122,
					"content": "Jupp! Warte einfach hier, Xavier. Und denk dir inzwischen einige originelle Namen aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360123,
					"content": "In Ordnung, dann überlasse ich das euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
