				]
			},
			"dialogs": [
				{
					"id": 401360201,
					"content": "Ich eskortiere sie bis hierher. Nun überlasse ich die drei dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360202
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360202,
					"content": "Hast du noch einen Auftrag zu erledigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360203
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360203,
					"content": "Etwas in der Art. Ich werde auf einer Feier erwartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360204
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360204,
					"content": "Also das hört man nicht jeden Tag. Hast du eine neue Freizeitbeschäftigung gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360205
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360205,
					"content": "Nein, es ist eher ein besonderer Anlass.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360206
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360206,
					"content": "Chevreuse, Wriothesley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360207,
					"content": "Feste bringen wirklich Menschen in Kontakt. Ich hatte schon lange nicht mehr so viele Besucher im Fort Méropide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360208
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360208,
					"content": "Schließlich ist es die Fontainale. Da ist es normal, dass es viel Trubel gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360209
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360209,
					"content": "Da hast du recht. Sogar unsere Oberschwester hat sich die Mühe gemacht, tolle nährstoffreiche Milchmixgetränke zuzubereiten ... Ein Schluck genügt, und du hast deinen Nährstoffbedarf gedeckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360210
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360210,
					"content": "Habt ihr gerade über die Arbeit gesprochen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360211,
					"content": "Wir haben schon alles durchgesprochen. Also, Wriothesley, was hältst du von meiner Forderung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360212
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360212,
					"content": "Hmm. Ich glaube, ich habe noch nichts versprochen oder garantiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360213
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360213,
					"content": "Aber du hast auch nicht abgelehnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360214
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360214,
					"content": "Wie wäre es damit: Wir können jedem eine Kopie der Zeitung geben. Mit etwas Glück wird darin eine Titelgeschichte erscheinen, die die Missetaten eines Mannes von vor zwanzig Jahren aufdeckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360215
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360215,
					"content": "Ich glaube, dann wird jemand bald die unglücklichste Person im Fort Méropide sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360216
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360216,
					"content": "Während zwei andere als Helden gefeiert werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360217
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360217,
					"content": "Wo wir von Helden sprechen. Wolltet ihr beide etwas von mir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360218
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360218,
					"content": "Oh, also, eigentlich sind wir hier, weil ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360219,
					"content": "Ihr seid hier, um mich zur Feier einzuladen, stimmt’s? Keine Sorge, ich habe es nicht vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360220
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360220,
					"content": "Hehe, dann lasst uns gleich zurückgehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360221,
					"content": "Bis zum nächsten Mal, Wriothesley! Frohe Fontainale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360222,
					"content": "Gleichfalls, frohe Feiertage!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				}
			]
		},
