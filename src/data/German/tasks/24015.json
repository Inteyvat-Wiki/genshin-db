	"talks": [
		{
			"id": 2401504,
			"completionStepIds": [
				2401504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401504",
							"2"
						],
						"stepId": 2401504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150401,
					"content": "Nein, nein ... Wenn man das Licht und die Schatten herausnimmt, wie kommt dann die Schichtung des Bildes rüber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150402
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150402,
					"content": "Die Kraft des Ausdrucks in diesen Farben ist nicht ausreichend ... und der Kontrast ist auch nicht gut genug ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150403
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150403,
					"content": "Ach! Ich habe nur ein paar Elemente herausgenommen ... Das ganze Bild ist versaut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150404,
						240150405
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150404,
					"content": "Was machst du hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				},
				{
					"id": 240150406,
					"content": "Du bist hier, schön, dich zu sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150407
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150407,
					"content": "Entschuldigung, ich habe gerade über das Gemälde nachgedacht und konnte nicht anders, als herumzulaufen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150408
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150408,
					"content": "Vielleicht verstehst du das nicht, aber ich darf nicht stillsitzen, wenn ich über ein Problem nachdenke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150409
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150409,
					"content": "Wenn ich stillsitze und über etwas nachdenke, werde ich immer reizbarer ... also gehe ich immer spazieren und denke gleichzeitig über etwas nach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150410
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150410,
					"content": "Während ich denke, lasse ich meine Beine sich frei bewegen. Egal, wohin auch immer sie mich führen, ich möchte einfach niemals einen Stillstand erleben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150411
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150411,
					"content": "Das mache ich oft. Tut mir leid, dass ich dir damit Sorgen gemacht habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150412,
						240150413
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150412,
					"content": "Bist du also zu einem Schluss gekommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150414,
					"content": "Kein Fortschritt. Einfach ... keine Idee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150415
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150415,
					"content": "Durch die Beseitigung von Licht und Schatten wird das Bild schichtlos, und durch die Verringerung der Formgebung kann das Objekt die Struktur des Bildes nicht tragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150416
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150416,
					"content": "Wenn man nur ein paar Elemente weglässt, fällt das ganze Bild in sich zusammen und am Ende ist es nur ein großer Haufen Müll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150417
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150417,
					"content": "Das sind alles nur meine Selbstgespräche, störe dich also nicht an mir. Ich werde weiter darüber nachdenken, wie ich dieses Problem lösen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150418
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150418,
					"content": "Ich muss erst meine Staffelei suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150413,
					"content": "Wie läuft es mit deinen Überlegungen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150405,
					"content": "Wir dachten, du wärst in Gefahr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				}
			]
		},
		{
			"id": 2401506,
			"completionStepIds": [
				2401506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401506",
							"2"
						],
						"stepId": 2401506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150601,
					"content": "*keuch* ... *keuch* ... Vielen Dank, vielen Dank ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150602
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150602,
					"content": "Argh, ich saß hier und malte nur, aber plötzlich wurde ich von diesen Kerlen umgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150603
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150603,
					"content": "Immer wieder stürzten sie sich auf die Staffelei, als wollten sie mein Gemälde fressen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150604
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150604,
					"content": "Natürlich konnte ich nicht zulassen, dass sie mein Gemälde ruinieren, also rannte ich sofort mit ihm in den Armen davon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150605
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150605,
					"content": "Aber ich ... ich war nicht weit genug weg, bevor sie mich einholten. Zum Glück hast du mich gerettet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150606,
						240150607
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150606,
					"content": "Stimmt etwas mit diesem Gemälde nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				},
				{
					"id": 240150608,
					"content": "Ich ... Ich weiß es nicht! Ich habe Vaniloqua-Nektar für meine Farben benutzt. Erinnerst du dich? Du hattest mir letztes Mal welchen besorgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150609
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150609,
					"content": "Moment, könnte es sein ... dass diese Kerle von den Farben aus Vaniloqua-Nektar angezogen wurden? Aber der Nektar hat überhaupt keinen Geruch, nachdem ich ihn in die Farben gerührt habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150610
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150610,
					"content": "Und ich traute mich nicht, das Farbrezept zu ändern, also musste ich mir etwas anderes einfallen lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150611
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150611,
					"content": "*hust* Ich dachte, dass sogar die Vaniloqua die Schönheit des Gemäldes spürte und kommen wollten, um es zu bewundern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150607,
					"content": "Hast du etwas getan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				}
			]
		}
	]
}