			},
			"dialogs": [
				{
					"id": 20170702,
					"content": "So viele, viele Menschen ... wenn wir beobachtet werden, wird es schwierig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170703
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170703,
					"content": "Sie müssen weggelockt werden, damit wir uns hineinschleichen können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170704
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170704,
					"content": "Wir können Yoimiya nur vertrauen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170705
					]
				},
				{
					"id": 20170705,
					"content": "Wir treffen uns wieder in der <color=#00E1FFFF>Teestube Komore</color>, wenn ich das offizielle Dokument bekomme, ist das in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170706
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170706,
					"content": "Außerdem, wenn ich erwischt werde ... komm bitte und rette mich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170707
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170707,
					"content": "Wird es wirklich keine Probleme geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170708,
					"content": "Wie auch immer, lass uns zur <color=#00E1FFFF>Statue des Allgegenwärtigen</color> gehen. Achte darauf, nicht von der Patrouille entdeckt zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
