			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170901,
					"content": "#Wie ist es, {NICKNAME}, läuft alles nach Plan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170902,
						20170903
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170902,
					"content": "Ich weiß es leider auch nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				},
				{
					"id": 20170904,
					"content": "Das war harte Arbeit, nun warten wir auf Sayu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170905
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170905,
					"content": "Nach einer Weile ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170906,
					"content": "*keuch*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170907
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170907,
					"content": "Obwohl Bewegung helfen kann, größer zu werden, scheint es ein bisschen zu viel gewesen zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170908
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170908,
					"content": "Mir ist schwindelig ... alles ... dreht sich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170909
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170909,
					"content": "Nein, es scheint noch etwas Wichtiges zu geben, bevor ich ins Bett gehe ... Oh richtig, ich habe es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170910
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170910,
					"content": "Ich wusste nicht genau, wie das „offizielle Dokument“, von dem ihr gesprochen habt, aussah, also habe ich alles Verdächtige mitgenommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170911
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170911,
					"content": "Hier, bitte sehr. Ich gehe jetzt schlafen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170912
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170912,
					"content": "Das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170913
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170913,
					"content": "Dieser versiegelte Band sollte das „offizielle Dokument“ der Tenryou-Verwaltung an den Shougun sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170914
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170914,
					"content": "Außerdem ist das ... der Brief, den sie mit den Fatui ausgetauscht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170915
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170915,
					"content": "Es scheint, dass Guuji Yae recht hatte. Der derzeitige Streit in Inazuma ist in der Tat das Ergebnis davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170916
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170916,
					"content": "#{NICKNAME}, diese sollten als Beweis ausreichen. Als Nächstes bringe sie bitte zu <color=#00E1FFFF>Guuji Yae</color>. Ich glaube, sie wird einen Plan haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170917
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170917,
					"content": "Ich werde auch meine Männer versammeln, um zu versuchen, mehr von den Fatui ausfindig zu machen, die in Inazuma lauern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170918
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170918,
					"content": "Pass trotzdem auf den Shougun auf, ich bekomme eine Gänsehaut, wenn ich nur daran denke, wie sie vorhin ihr Schwert gezückt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170919
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170919,
					"content": "Wir können auch nur Guuji Yae vertrauen. Sie stand dem Shougun nahe und hat vielleicht einen Weg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170920
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170920,
					"content": "Wenn ich mich recht erinnere, ist es fast Zeit für den Termin mit Yae Miko, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170921,
					"content": "Packen wir schnell zusammen und machen uns bereit für den Weg zum <color=#00E1FFFF>Großen Narukami-Schrein</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170903,
					"content": "Das Feuerwerk ist gezündet und danach bin ich direkt weggelaufen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				}
			]
		},
