			"dialogs": [
				{
					"id": 20171000,
					"content": "Yoimiya, wir wollen ein superextragroßes Feuerwerk! Die super-, supergroße Variante!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171001
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20171001,
					"content": "Supergroßes Feuerwerk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171002
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171002,
					"content": "Hehe, da seid ihr hier richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171003
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171003,
					"content": "In der Tat habe ich vor zwei Tagen zufällig ein besonders gutes gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171004
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171004,
					"content": "Aber weil es so mächtig ist, konnte ich nie einen geeigneten Platz zum Experimentieren finden ... Da kommt ihr gerade recht, um es euch zu geben, damit ihr mir helfen könnt, es auszuprobieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171005
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171005,
					"content": "Denke daran, dass ihr beim Anzünden schnell laufen müsst, damit ihr eure Kleidung nicht verbrennt. Und haltet euch auch die Ohren zu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171006
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171006,
					"content": "Warum fühlt Paimon sich so beängstigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20171007,
					"content": "Hahaha, ist schon gut, es ist nur ein Feuerwerk. Daran ist nichts auszusetzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171008
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171008,
					"content": "Dann werden wir es mal versuchen ... Danke, Yoimiya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
