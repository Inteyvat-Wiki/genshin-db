			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170201,
					"content": "Die Tanuki sind Menschen geworden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170202,
					"content": "Was ist das? Das sehe ich zum ersten Mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170203,
					"content": "Kein Tanuki ... es ist ein Mujina ... *schnarch* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170204
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170204,
					"content": "So schläfrig ... wenn ich nicht genug Schlaf bekomme ... werde ich nicht größer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170205
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170205,
					"content": "Ist das der „Profi“, von dem Yae gesprochen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170206,
					"content": "Sie sieht überhaupt nicht danach aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170207,
					"content": "Dies ist ein Mitglied des „Shuumatsuban“ und ist ein echter „Ninja“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170208
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170208,
					"content": "Ein Ninja! Was ist da gerade passiert, war das die legendäre Doppelgängertechnik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170209,
					"content": "Aber was ist der „Shuumatsuban“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170210,
					"content": "Der Shuumatsuban ist ein Teil der Yashiro-Verwaltung, also eine geheime Einheit von Kamisato Ayato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170211
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170211,
					"content": "Im Moment sind Kamisato Ayato und die Yashiro-Verwaltung neutral und ich kann den Shuumatsuban nicht befehlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170212
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170212,
					"content": "Es ist jedoch immer noch möglich, einen der ewigen Faulpelze unter dem Shuumatsuban zum Aushelfen zu bewegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170213
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170213,
					"content": "*gluck* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170214
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170214,
					"content": "Das war’s, geh bitte in die Stadt und such nach Beweisen für den Betrug der Tenryou-Verwaltung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170215,
					"content": "Schließlich gehört es sich nicht, dass ich mich bei so einem Anlass blicken lasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170216
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170216,
					"content": "Selbst wenn wir wüssten, was zu tun ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170217,
						20170218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170217,
					"content": "Es fühlt sich nicht so an, als gäbe es viele Anhaltspunkte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				},
				{
					"id": 20170219,
					"content": "Hä? Ich dachte, darauf wärst du schon gekommen. Dann gebe ich dir noch einen kleinen Hinweis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170220
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170220,
					"content": "Für Außenstehende ist es in der Tat schwierig, dem Geschehen in der Tenryou-Verwaltung auf den Grund zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170221
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170221,
					"content": "Aber da die drei Verwaltungen zusammenarbeiteten, um den Shougun zu unterstützen, arbeiten sie eng miteinander, sodass es für die anderen Verwaltungen einfacher gewesen sein muss, zu sehen, was vor sich ging ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170222
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170222,
					"content": "Die Yashiro-Verwaltung!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170223
					]
				},
				{
					"id": 20170223,
					"content": "Hehe ... es scheint, als hättest du es verstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170224
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170224,
					"content": "Die Suche nach dir durch die Bakufu-Armee sollte noch nicht beendet sein. Aber mit der Hilfe dieses Ninjas vom Shuumatsuban glaube ich, dass du deinen Freund erfolgreich wieder treffen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170225
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170225,
					"content": "Vergiss nicht, die Beweise vor der vereinbarten Zeit zurückzubringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170218,
					"content": "Was genau ist der Beweis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				}
			]
		},
		{
			"id": 201704,
			"completionStepIds": [
				201704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
