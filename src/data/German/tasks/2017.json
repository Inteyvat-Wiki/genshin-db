			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170403,
					"content": "#{NICKNAME}, was führt euch hierher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170404
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170404,
					"content": "Hast du die Widerstandskämpfer gesehen? Wie ist die Situation auf dem Schlachtfeld? Kann ich hier rauskommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170405
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170405,
					"content": "Wahrscheinlich noch nicht ... und wir sahen Leute, die in der Gegend patrouillierten, als wir ankamen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170406,
					"content": "Sieht so aus, als ob es noch nicht vorbei ist ... Ich schätze, ihr seid hier aufgetaucht, weil ihr etwas mit uns zu besprechen habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170407
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170407,
					"content": "Ich hole jemanden, der das Fräulein herholt, einen Moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170408
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170408,
					"content": "Du erzählst Ayaka und Thoma über die aktuelle Situation ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170409,
					"content": "Ich sehe, ihr habt auch schon viel durchgemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170410
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170410,
					"content": "Ich habe die Situation verstanden, auf jeden Fall geht es darum, Beweise für die Meuterei der Tenryou-Verwaltung zu finden. Lass mich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170411
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170411,
					"content": "In diesem Fall gibt es eine Sache, die mir Sorgen bereitet. Die Bakufu-Armee befindet sich schon seit langem im Krieg mit den Widerstandskämpfern, aber der Shougun hat nie danach gefragt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170412
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170412,
					"content": "Ich hatte gedacht, dass der Shougun sich nicht um diese Angelegenheit kümmert, aber jetzt sehe ich, dass vielleicht das <color=#00E1FFFF>„offizielle Schreiben“</color>, das der Shougun von der Tenryou-Verwaltung erhalten hat, von Anfang an fehlerhaft war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170413
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170413,
					"content": "Was Ayaka meint, ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170414,
					"content": "Die Tenryou-Verwaltung ist für die militärischen Angelegenheiten des Landes zuständig und wenn sie auf die Idee kommen, Informationen zurückzuhalten, haben wir keine Möglichkeit, das herauszufinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170415
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170415,
					"content": "Das Ergebnis war, dass der Shougun die Gefahr des Augenhatz-Dekrets falsch einschätzte und sich weiter darauf versteift hat. Wenn wir die offiziellen Berichte der Tenryou-Verwaltung in die Hände bekommen könnten, wüssten wir es auf einen Blick.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170416,
					"content": "Aber soweit ich mich erinnern kann, war die einzige Person, die die Befugnis hatte, die vorgelegten offiziellen Dokumente anzufassen, Kujou Takayuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170417
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170417,
					"content": "Der Ort ist schwer bewacht und selbst mit Hilfe von Sayu wäre es schwierig, die Dokumente unbemerkt wegzubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170418
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170418,
					"content": "Wenn es nur etwas gäbe, das die Wachen vorübergehend ablenken könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170419
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170419,
					"content": "Ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170420,
						20170421
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170420,
					"content": "Apropos Ablenkung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				},
				{
					"id": 20170422,
					"content": "Das Feuerwerk von Yoimiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170423
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170423,
					"content": "Natürlich ist dies eine Anregung von Thoma ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170424
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170424,
					"content": "Das ist nicht unvernünftig. Die Statue des Allgegenwärtigen steht direkt neben der Tenryou-Verwaltung und wenn du ein Feuerwerk um die Statue herum anzünden kannst, wird die Verwaltung es nicht ignorieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170425
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170425,
					"content": "Zu diesem Zeitpunkt könnte Sayu ohne Probleme in die Tenryou-Verwaltung eindringen und die offiziellen Dokumente und andere Beweise besorgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170426,
					"content": "Ja! Ich habe das Gefühl, dass ich der Freiheit näher komme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170427
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170427,
					"content": "Puh ... es fühlt sich immer wie eine Ewigkeit an, wenn wir so zusammensitzen und uns unterhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170428
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170428,
					"content": "Es scheint nicht lange her zu sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170429
					]
				},
				{
					"id": 20170429,
					"content": "Es hat lange auf sich warten lassen und ich freue mich jeden Tag auf dich hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170430
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170430,
					"content": "Früher war das wirklich mein liebstes Geheimversteck, aber nachdem ich dieses Mal hereingekommen bin, weiß ich nicht, wie lange es her ist, dass ich einen Schritt aus der Teestube gemacht habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170431
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170431,
					"content": "Verdammt, ich will zu den heißen Quellen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170432
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170432,
					"content": "Thoma, du meine Güte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170433,
					"content": "Klären wir das Problem, um das es geht. Nach der Aufhebung des Augenhatz-Dekrets ist Thoma frei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170434
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170434,
					"content": "Es ist ein Wiedersehen, aber es bleibt nicht viel Zeit, um sich auszutauschen. Wenn alles vorbei ist, werden wir eine schöne Feier haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170435
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170435,
					"content": "Dann spielen wir gemeinsam das Feuertopfspiel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170436
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170436,
					"content": "Du denkst immer noch darüber nach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170437,
					"content": "In der Nähe der Tenryou-Verwaltung gibt es viele Wachen, sei also vorsichtig, wenn du dich näherst. Treffen wir uns danach wieder hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170438
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170438,
					"content": "#Also dann, {NICKNAME}, lass uns zuerst nach <color=#00E1FFFF>Hanamizaka</color> gehen, um <color=#00E1FFFF>Yoimiya</color> zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170421,
					"content": "Ich habe das auch schon mal erlebt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				}
			]
		},
		{
			"id": 201707,
