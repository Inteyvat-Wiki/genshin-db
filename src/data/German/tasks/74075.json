			"dialogs": [
				{
					"id": 740750101,
					"content": "„Dieser Ort ist der Orthant der Seele, die Weihestätte der Seele, die Kammer der Seele“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750102
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750102,
					"content": "„Ewige Ruhe bei dir“ ... „In einem Augenblick geboren, oft widersprüchlich, immer vereint“ ... „Der wertvollste Schatz der Welt“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750103
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750103,
					"content": "Puh ... Dieses Mal ist es nichts Schreckliches. Und die Antwort ... könnte es eine Taschenuhr sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750104,
					"content": "Da wir gerade davon reden, hat Ann nicht auch eine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750105,
					"content": "Taschenuhren sind in der Tat sehr teuer ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750106
					]
				},
				{
					"id": 740750106,
					"content": "Die Antwort muss also Geld sein, das heißt, Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750107,
					"content": "Für immer mit Geld zu schlafen ist die zweitgrößte Tragödie im Leben eines Menschen. Und fragt mich nicht, was die größte ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750108
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750108,
					"content": "Und was ist die größte Tragödie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750109
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750109,
					"content": "Das kann ich beantworten. Die Antwort lautet „Bettelarm im Sarg liegen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750110
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750110,
					"content": "Diesen Wertvorstellungen kann ich nicht zustimmen. Auf der Welt gibt es viele wichtigere Dinge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750111
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750111,
					"content": "Daher habe ich auch gesagt, dass ihr besser nicht nachfragen solltet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750112
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750112,
					"content": "Tut mir leid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750113
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750113,
					"content": "Zurück zum Thema. Basierend auf den vorher genannten Gründen, gehe ich nicht davon aus, dass die Antwort eine teure Uhr oder Mora ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750114
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750114,
					"content": "Was könnte es dann sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750115,
					"content": "Die Antwort ist sehr einfach. Ich kann ein ähnliches Rätsel abrufen, das eine Übereinstimmungsrate von siebzig Prozent aufweist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750116
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750116,
					"content": "Es stammt aus einem klassischen Roman, der vor mehreren hundert Jahren geschrieben wurde. Der Originaltext lautet: „Ich wurde in dem flüchtigen Moment geboren, in dem sich die Blicke trafen. Ich renne mit dem Rücken zu der Person, die ich verfolge.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750117
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750117,
					"content": "„... Und auch wenn man mir das Fleisch, die Knochen und die Eingeweide herausreißt, liege ich immer noch eingebettet bei dir im Mark, das übrig bleibt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750118
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750118,
					"content": "Die Antwort lautet „Liebe“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750119
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750119,
					"content": "Klingt logisch. Genau wie in meiner Taschenuhr sind auch in dieser Taschenuhr sicher viele Erinnerungen voller Liebe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750120
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750120,
					"content": "Wenn wir nur diese Taschenuhr öffnen könnten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750121
					]
				},
				{
					"id": 740750121,
					"content": "Ja, eines Tages werden wir sie sicher öffnen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750122
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750122,
					"content": "Dummer Hund, gut gemacht! Du bist der süßeste mechanische Hund!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750123
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750123,
					"content": "Ich fühle mich geehrt. Wobei süß eine subjektive Charakterisierung ist. Die von mir bevorzugte Anrede lautet „verlässlicher, strapazierfähiger Prototyp 4ACV07“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750124
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750124,
					"content": "Und genau das ist der Grund, warum du so süß bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750125
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750125,
					"content": "... Zitiert ihr beide aus einem klassischen Theaterstück? Mir kommt es vor, als hätte ich dieses Stück schon einmal gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750126
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740750126,
					"content": "Aber das spielt jetzt keine Rolle. Das Rätsel hier wurde bereits von jemand anderem gelöst. Wir sollten uns beeilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
		{
			"id": 7407502,
