			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2431.168,
							441.192,
							3924.431
						],
						"pointId": 7247
					},
					{
						"sceneId": 3,
						"position": [
							2431.882,
							441.219,
							3923.576
						],
						"pointId": 7248
					}
				]
			},
			"dialogs": [
				{
					"id": 740750201,
					"content": "Jemand muss vor nicht allzu langer Zeit hier gewesen sein. Unglaublich, es gibt wirklich jemanden, der sich besser mit archäologischen Expeditionen auskennt als wir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750202,
					"content": "Da liegt etwas auf dem Boden ... Eine Taschenuhr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750203,
					"content": "Gemäß der üblichen Vorgehensweise bei unseren Abenteuern sollte sich Paimon einmal die Hinweise auf dieser Steinplatte ansehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750204,
					"content": "„Dieser Ort ist der Orthant der Seele, die Weihestätte der Seele, die Kammer der Seele“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750205,
					"content": "„Ewige Ruhe bei dir“ ... „In einem Augenblick geboren, oft widersprüchlich, immer vereint“ ... „Der wertvollste Schatz der Welt“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750206,
						740750207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750206,
					"content": "Ah, sehr offensichtlich, meine Freunde ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750208
					]
				},
				{
					"id": 740750208,
					"content": "Hmm ... Eine sehr kostbare Taschenuhr, doch der wertvollste Schatz der Welt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750209,
					"content": "Paimon hat es! Die Antwort lautet Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750210,
					"content": "Nein, das klingt nicht richtig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750211
					]
				},
				{
					"id": 740750211,
					"content": "Hmm ... Ja, du hast recht. Normalerweise sind die Antworten nicht so profan. Dann muss es ... Ähm ... Wie lautet das Wort ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750212,
					"content": "Ah, richtig! Es ist „Reichtum“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750213,
					"content": "Sehr gut. Gehen wir für den Moment einfach davon aus, dass das nicht die Antwort ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750214
					]
				},
				{
					"id": 740750214,
					"content": "Du bringst Paimon zur Weißglut! Wieso hast du denn gar kein Vertrauen zu Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750215,
					"content": "Also schön, was ist dann deiner Meinung nach die Antwort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750216,
						740750218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750216,
					"content": "Heute ist das Wetter wirklich gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750217
					]
				},
				{
					"id": 740750217,
					"content": "He! Wechsel nicht das Thema!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750218,
					"content": "Es spielt keine Rolle, sehen wir uns erst einmal weiter drinnen um.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750219
					]
				},
				{
					"id": 740750219,
					"content": "He! Gib einfach zu, dass du es auch nicht weißt. Kein Grund, so schnell zu laufen, nur weil es dir peinlich ist! Warte auf Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750207,
					"content": "Ein Rätsel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750208
					]
				}
			]
