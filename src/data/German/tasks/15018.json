					{
						"sceneId": 3,
						"position": [
							-2654.367,
							280.413,
							10093.35
						],
						"pointId": 10947
					}
				]
			},
			"dialogs": [
				{
					"id": 150180801,
					"content": "Ah, endlich sind wir da! Dies hier ist das Stammeslager des Kollektivs der Fülle ... mein Zuhause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180814
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180814,
					"content": "Waah, wie prächtig! Diese Plattform in Form eines Stierkopfs sieht echt mega aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180802,
					"content": "Hehe, das dort ist die Arena des Widerhalls. Dort halten wir unsere Wettkämpfe ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180803
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180803,
					"content": "Vielen Dank, dass du uns hierhergebracht hast.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180804
					]
				},
				{
					"id": 150180804,
					"content": "Kein Problem! Es war mir ein Vergnügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180815
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180815,
					"content": "Ich hätte euch wirklich gern herumgeführt, aber jetzt muss ich erst mal kurz nach Hause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180816
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180816,
					"content": "Ist dir etwas Wichtiges eingefallen? Es schien, als hättest du es sehr eilig, als die Hilichurle aufgetaucht sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180817,
					"content": "Hoffentlich haben wir dich nicht aufgehalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180818
					]
				},
				{
					"id": 150180818,
					"content": "Das macht nichts, wirklich! Wir liegen gut in der Zeit! Aber ehrlich gesagt gibt es nach dem Training eine Sache, die Vorrang hat: das Essen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180805
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180805,
					"content": "Mit leerem Magen ist man schlapp, schwindelig und völlig neben der Spur ... Das ist echt nicht ohne, da sollte man vorsichtig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180806
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180806,
					"content": "Entschuldigt bitte, aber ich muss dringend etwas essen ... gefühlt wie gestern! Ihr solltet euch auch mal stärken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180807
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180807,
					"content": "Wir treffen uns später in der Arena des Widerhalls. Bis dann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180808
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180808,
					"content": "Und weg ist sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180809,
					"content": "Wah, sie ist echt wechselhaft ... Mal total zurückhaltend, mal gehen die Pferde mit ihr durch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180810,
					"content": "So ist der Geist der Jugend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180811
					]
				},
				{
					"id": 150180811,
					"content": "Der „Geist der Jugend“? Warum redest du plötzlich wie ein alter Knacker? Wir sind doch noch jung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180812,
					"content": "Aber wenn sie schon nach Hause gegangen ist, können wir doch einfach allein hier rumstöbern und später bei der Arena des Widerhalls auf sie warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180813,
					"content": "Von hier oben müsste die Aussicht wunderbar sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}