			"dialogs": [
				{
					"id": 150180101,
					"content": "Huch ... Was macht denn dieses Holzbrett hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180107,
					"content": "Ja, das ist ein Trainingsgerät unseres Stammes, ich nutze es auch ständig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180108
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180108,
					"content": "Ein Trainingsgerät?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180109,
					"content": "Hm, wie soll ich das erklären ... Lass es mich dir stattdessen einfach zeigen. Dann mal los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180103
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180103,
					"content": "Geschmeidige Landung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180104
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180104,
					"content": "Oh, waah! Du bist da einfach so rübergesprungen. Megastark!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180105,
					"content": "Ach, das ist nichts Besonderes. Mit etwas Training kann das jeder lernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180110
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180110,
					"content": "Du bist ja ganz ohne Training rübergekommen. Viel beeindruckender als alles, was ich kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180112
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180112,
					"content": "Na ja, Paimon kann fliegen, aber ... Du hast nicht ganz unrecht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
