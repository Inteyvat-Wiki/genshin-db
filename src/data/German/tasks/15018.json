					"Varesa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150180501,
					"content": "#Nun, das hier ist {NICKNAME} und Paimon ist Paimon, {M#seine}{F#ihre} fantastische Reisegefährtin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180502,
					"content": "#{NICKNAME} und Paimon ... das sind schöne Namen. Die werde ich nicht vergessen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180503
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180503,
					"content": "Na dann ... auf geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
