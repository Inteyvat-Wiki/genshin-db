			"dialogs": [
				{
					"id": 150180401,
					"content": "Hallo, sag mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180403,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180404
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180404,
					"content": "#Seid ihr nicht ... {NICKNAME} und Paimon!? Endlich seid ihr da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180405
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180405,
					"content": "Wah! Du kennst uns? Wir sind also doch ganz schön berühmt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180406,
					"content": "Aber ... haben wir irgendwem erzählt, dass wir ins Kollektiv der Fülle kommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180407,
					"content": "Äh, wusstet ihr das nicht? Iansan hat mir erzählt, dass sie euch eingeladen hat, das Kollektiv zu besuchen, deshalb warte ich schon ewig hier und trainiere nebenbei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180408
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180408,
					"content": "Und jetzt seid ihr wirklich gekommen ... Hihi, wie toll ist das denn!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180409
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180409,
					"content": "D... Du musst ja nicht gleich so aus dem Häuschen sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180410,
					"content": "Ihr seid die berühmten Helden, die den Abgrund besiegt haben! Eure Taten sind in ganz Natlan bekannt. Ich habe die Geschichte von Tum{RUBY#[S]Hoffnung}aini schon zigmal gehört, ich kenn sie regelrecht auswendig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180411
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180411,
					"content": "Seit Iansan erzählte, dass ihr vielleicht das Kollektiv der Fülle besucht, freue ich mich darauf! Ach ja, mein Name ist Varesa. Hat sie meinen Namen erwähnt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180412
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180412,
					"content": "Ah, ja, jetzt, da du es sagst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180413,
					"content": "Als der Abgrund damals angegriffen hat, fragten wir Iansan, ob wir dem Kollektiv helfen sollen. Aber sie sagte uns, dass Varesa die Gefahr bereits unter Kontrolle hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180414,
						150180415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180414,
					"content": "Also musst du auch beeindruckende Fähigkeiten haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				},
				{
					"id": 150180416,
					"content": "Ach was, das war nur dank Onkel Acatls gutem Kommando. Ich habe nur ein paar Monster beseitigt, mehr nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180417
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180417,
					"content": "Wenn ich an damals zurückdenke, wird mir immer noch mulmig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180418
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180418,
					"content": "Aber das ist jetzt alles vorbei. Das Kollektiv der Fülle hat nur wenig abbekommen und der Wiederaufbau ist abgeschlossen. Momentan leistet unser Stamm Unterstützung bei den anderen Stämmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180419
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180419,
					"content": "Hehe, kommt schon! Ich führe euch gern zu unserem Stamm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180420
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180420,
					"content": "Alles klar, gehen wir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180415,
					"content": "Du bist eine Heldin durch und durch!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				}
			]
		},
