			},
			"dialogs": [
				{
					"id": 150180201,
					"content": "Oh, den Namen kennen wir! Du bist das also!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180202,
					"content": "#Nun, das hier ist {NICKNAME} und Paimon ist Paimon, {M#seine}{F#ihre} fantastische Reisegefährtin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180203,
					"content": "#{NICKNAME} und Paimon ... das sind schöne Namen. Die werde ich nicht vergessen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180204
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180204,
					"content": "Na dann ... auf geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
