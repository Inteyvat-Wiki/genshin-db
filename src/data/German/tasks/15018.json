			"dialogs": [
				{
					"id": 150180301,
					"content": "Hallo, sag mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180303,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180304
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180304,
					"content": "Seid ihr vom Weg abgekommen? Braucht ihr Hilfe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180305
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180305,
					"content": "Nein ... nicht ganz. Wir wollten eigentlich das Kollektiv der Fülle besuchen. Laufen wir in die richtige Richtung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180306,
					"content": "Japp! Ist tatsächlich auch mein Zuhause. Wenn ihr wollt, kann ich euch den Rest des Weges begleiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180307
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180307,
					"content": "#Spitze! Noch ein einheimischer Reiseführer! {NICKNAME}, wir haben echt Glück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180308,
					"content": "Ich dachte eigentlich, das wäre deine Aufgabe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180309
					]
				},
				{
					"id": 150180309,
					"content": "Ein Reiseführer, hm ... Ja, na klar! Warum denn nicht? Hehe, von jetzt an bin ich also euer Reiseführer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180310
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180310,
					"content": "Hier in der Gegend gibt es jede Menge beeindruckende Landschaften. Ich werde euch unterwegs darauf hinweisen. Den Leuten fällt da immer regelrecht die Kinnlade runter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180311
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180311,
					"content": "Wie nett von dir, danke! Aber warte mal ... Wir halten dich nicht von irgendetwas ab, oder? Unseretwegen musst du dir nicht die Mühe machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180312,
					"content": "Kein Ding, wirklich! Ich habe nur ein bisschen trainiert und wollte sowieso gerade einpacken. Wir haben also eh denselben Weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180313
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180313,
					"content": "Außerdem kann ich euch dann alles über den Stamm erzählen. Neues zu lernen macht doch immer Spaß, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180314
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180314,
					"content": "Solange ihr glücklich seid, bin ich es auch. Und genau so sollen wir unsere Gäste behandeln, hat uns Onkel Acatl beigebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180315
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180315,
					"content": "N... Na gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180316,
					"content": "Sie scheint ein total herzlicher Mensch zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180317,
					"content": "Jepp, mit ihr haben wir echt Glück.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180318
					]
				},
				{
					"id": 150180318,
					"content": "Schon, oder? Paimon mag sie auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180319,
					"content": "Alles gut? Wenn ihr bereit seid, dann lasst uns gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180320
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180320,
					"content": "Ach ja, wir haben dich noch gar nicht nach deinem Namen gefragt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180321,
					"content": "Stimmt! Ich heiße Varesa. Freut mich, euch kennenzulernen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				}
			]
		},
