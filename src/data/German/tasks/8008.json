	"talks": [
		{
			"id": 800801,
			"completionStepIds": [
				800801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800801",
							"2"
						],
						"stepId": 800801,
						"stateName": "QUEST_STATE_UNFINISHED"
