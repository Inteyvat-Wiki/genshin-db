			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuehui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80080101,
					"content": "Bergmann, wir sind hier, um über die Ergebnisse deines Auftrags zu berichten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080102,
					"content": "Oh! Endlich sehe ich euch wieder! Ich war vorher etwas besorgt, obwohl ich dafür bezahlt habe, aber wenn ich darüber nachdenke, wäre es besser, wenn man jemanden mit der Erkundung eines so seltsamen Ortes beauftragt, sodass nichts passiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080103
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080103,
					"content": "Wenn es etwas gibt, werde ich für den Rest meines Lebens ein schlechtes Gewissen haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080104
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080104,
					"content": "Schon gut, schon gut. Sieh mal, wir sind wieder in guter Verfassung, nicht wahr? Und unsere Ermittlung war erfolgreich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080105,
					"content": "Großartig, großartig! Also, was ist da unten los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080106
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080106,
					"content": "Oh ... Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080107,
						80080109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080107,
					"content": "Dort gibt es viele Hilichurle, die sich zur Ruhe setzen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080108
					]
				},
				{
					"id": 80080108,
					"content": "Zur Ruhe setzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080111,
					"content": "Wie auch immer, kurz gesagt, die Hilichurle, die dort hinuntergehen, sind nicht mehr aggressiv und es ist zu hoffen, dass die Bergleute sie nicht absichtlich stören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080112,
						80080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080112,
					"content": "Genau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080114,
					"content": "Wir Bergleuten haben nur Heidenangst vor Gefahren, auf keinen Fall werden wir nach der Gefahr suchen. Wir haben nur glänzende und goldene Dinge in unseren Augen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080115
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080115,
					"content": "Glaube ich dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080116,
					"content": "Ich verstehe nicht ganz, wovon du sprichst, aber ich bin erleichtert, dass ich euer Wort habe, so dass ich jederzeit mit der Arbeit beginnen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080117
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080117,
					"content": "Vielen Dank an euch beide! Bitte nehmt diese Geschenke als Dank für eure harte Arbeit an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080113,
					"content": "So ist alles in Ordnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080109,
					"content": "Unten ist die Idylle der Hilichurle, die Hilidylle sozusagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080110
					]
				},
				{
					"id": 80080110,
					"content": "Die Hilidylle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Yuehui"
				}
			]
		}
	]
}