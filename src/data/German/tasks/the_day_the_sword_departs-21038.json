				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380201,
					"content": "#Ich danke dir, {F#Reisende}{M#Reisender}! Dieses „Bild“ genügt mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380203,
					"content": "Ah, jetzt muss ich aber wirklich los. Wenn ich die Leute sagen höre „Ein großer Mann ist bereit, überall sein Glück zu machen“ und „Zehntausend Meilen zu reisen, ist besser, als zehntausend Bücher zu lesen“, inspiriert mich das zwar sehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380204,
					"content": "Aber wenn es daran geht, selbst meine Heimat weit hinter mir zu lassen, fühle ich überhaupt keinen Mut in mir und will nur noch ein bisschen verweilen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380205,
					"content": "#{F#Reisende}{M#Reisender}, meinst du, ich kann auf meiner Reise in die Ferne wirklich finden, wonach ich suche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380206,
						210380208
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380206,
					"content": "Das weiß ich nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380207
					]
				},
				{
					"id": 210380207,
					"content": "Haha ... Ja, was suche ich überhaupt? Selbst ich weiß es nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380210,
					"content": "Na gut, jetzt ist es aber an der Zeit. Ich werde mich jetzt mit dem Geschäftsreisenden treffen. Bitte nimm diese Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380211
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380211,
					"content": "Que’er ... Schließlich ist sie nicht gekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380208,
					"content": "Das liegt alles in deinen Händen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380209
					]
				},
				{
					"id": 210380209,
					"content": "Also ... Du meinst, es ist alles Schicksal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
