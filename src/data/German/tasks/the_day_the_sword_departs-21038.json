	"talks": [
		{
			"id": 2103801,
			"completionStepIds": [
				2103801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2103801",
							"2"
						],
						"stepId": 2103801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210380101,
					"content": "#{F#Reisende}{M#Reisender}, du bist endlich gekommen. Ich hatte schon befürchtet, dass ich dich heute nicht mehr sehen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380102,
					"content": "Heute ist der Tag, an dem ich Liyue verlasse. Ich habe dich schon so oft beunruhigt ... Ich muss mich bei dir richtig bedanken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380103
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380104,
					"content": "Ähem ... Ich habe gerade überlegt, was ich sagen soll, wenn ich dich sehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380105,
					"content": "Und jetzt, da es an der Zeit ist, dass ich mit dir spreche, kann ich mich irgendwie an kein einziges Wort erinnern ... Haha, wie lächerlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380106,
						210380107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380106,
					"content": "Das macht nichts, wir werden uns bestimmt wiedersehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				},
				{
					"id": 210380108,
					"content": "Wirklich? Haha, na dann ist ja gut, dann werde ich dir alles zeigen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380109,
					"content": "Ah, richtig ... Ich möchte dich heute noch um eine letzte Sache bitten. Ich kann mich entsinnen, dass du einen „Fotoapparat“ besitzt. Bitte mach ein Bild von mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380110,
					"content": "Ich habe einen Matrosen sagen hören, dass man, wenn man fern der Heimat ist, am besten ein „Bild“ von ihr als Andenken bei sich hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380111,
					"content": "Aber da ich keinen „Fotoapparat“ besitze, kann ich nur dich um Hilfe bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380112,
						210380113
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380112,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 210380113,
					"content": "Mach eine schöne Pose.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380114
					]
				},
				{
					"id": 210380114,
					"content": "Was ... Was für eine schöne Pose soll ich machen? Also, wichtig ist mir vor allem die Ansicht hinter mir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380107,
					"content": "Ich komme dich bald in Fontaine besuchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				}
			]
		},
		{
			"id": 2103802,
			"completionStepIds": [
				2103803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2103803",
							"2"
						],
						"stepId": 2103803,
						"stateName": "QUEST_STATE_UNFINISHED"
