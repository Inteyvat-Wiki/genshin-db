			},
			"dialogs": [
				{
					"id": 150421701,
					"content": "Hervorragend, Mualani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421702,
					"content": "Puh ... Das, war, Wahnsinn! Wie war ich, Leute? Nicht schlecht, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421703
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421703,
					"content": "Es war unglaublich! Eine wahrhaft heldenhafte Leistung, ganz ehrlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421704
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421704,
					"content": "Während du da oben warst, hat Paimon mir alles über dich erzählt! Alles, was du erreicht hast, ist so erstaunlich! Im Ernst, ich bin ganz aus dem Häuschen, wenn ich nur davon höre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421705
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421705,
					"content": "Haha, danke, dein Lob bedeutet mir sehr viel! Ich bin so aufgeregt, dass ich das Gefühl habe, ich könnte hier eine Thermalquellensause schmeißen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421706
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421706,
					"content": "Schau, die Mitarbeiter der Wellen-Bucht sind auch da! Nach all der harten Arbeit freuen sie sich bestimmt darauf, endlich mal zu feiern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421707
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421707,
					"content": "Ich glaube, du hast das falsch verstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421708
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421708,
					"content": "Wieso falsch ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421709
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421709,
					"content": "Mualani, Mualani! Kann ich ein Autogramm von dir bekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421710
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421710,
					"content": "Ich auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421711
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150421711,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421712
					],
					"speakerTitle": "Junger Iktomisaurier"
				},
				{
					"id": 150421712,
					"content": "Die Katze ist wohl aus dem Sack.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421713
					]
				},
				{
					"id": 150421713,
					"content": "Schnell, wir machen das Gruppenfoto, bevor die Menge kommt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421714
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421714,
					"content": "Gut, ich will ein breites Lächeln und Selbstvertrauen sehen! Denkt an den Ozean und eure Glücksfarben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421715
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421715,
					"content": "Drei, zwei, eins ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421716
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421716,
					"content": "Koholasaurier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421717,
