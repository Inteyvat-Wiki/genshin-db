			"dialogs": [
				{
					"id": 150420101,
					"content": "Juhuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420102,
					"content": "Sonnenschein, Wellen und Koholasaurier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420103
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420103,
					"content": "Sie ist so aufgeregt, dass sie fast vergessen hat, dass ihr antiker Name „Um{RUBY#[S]Zusammenhalt}oja“ lautet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420104,
					"content": "Schnell, hier lang! Los Leute, schneller ... Lauft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420105
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420105,
					"content": "Wir kommen, wir kommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420106
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420106,
					"content": "Sieh mal! Was glaubst du, was das ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420107,
					"content": "Ein Holzbrett.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420108,
					"content": "Lies mal vor, was darauf steht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420109,
					"content": "Oooh, das ist eine Touristenkarte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420110,
					"content": "Eine Touristenkarte, genau! Sie ist wie ein Schlüssel zu einem Gewölbe mit unermesslichen Schätzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420111,
					"content": "Ich verstehe dich vollkommen. Sie ist wie ein Aufruf zum Abenteuer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420112,
					"content": "Ja! Oder so etwas wie brennende Asche aus Phlogiston!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420113,
					"content": "Phlogiston? Äh ... Das ist eine Art Energie, oder? Du meinst wie ... Nur ein einziger Blick füllt dich mit grenzenloser Motivation?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420114
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420114,
					"content": "Ganz genau! Und auch, weil es wirklich wichtig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420115
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420115,
					"content": "Mit einer Karte in der Hand, die du dir jederzeit anschauen kannst, bist du frei, deinen ganz eigenen Abenteuerweg zu gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420116
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420116,
					"content": "Hehe, Freiheit und Abenteuer! Das hört sich toll an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420117
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420117,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420118
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150420118,
					"content": "Moment mal, du solltest ihr nicht so schnell zustimmen ... Warum hat Paimon das Gefühl, dass Mualani etwas verheimlicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420119,
					"content": "Also gut, Leute, Zeit für Solo-Erkundungen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420120
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420120,
					"content": "Welche Reiseführerin macht einfach Feierabend, sobald sie einen schönen Ort erreicht hat? Was soll das mit der Reise?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420121,
						150420122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420121,
					"content": "Vielleicht will Mualani einfach nur alleine Spaß haben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				},
				{
					"id": 150420123,
					"content": "#Hehe, du bist so {M#ein toller Gefährte}{F#eine tolle Gefährtin}. Ich werde nicht vergessen, dass du mir den Rücken gestärkt hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420124
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420124,
					"content": "Schaut euch das einmal an. Diese beiden Attraktionen wurden als „Prüfung ausstehend“ gekennzeichnet. Es scheint, als ob einige Probleme aufgetreten sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420125
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420125,
					"content": "Warum teilen wir uns nicht auf und sehen uns die Attraktionen an, auf die jeder von uns am meisten gespannt ist? Wir werden Spaß haben und gleichzeitig bei den Prüfungen mithelfen. Vielleicht schaffen wir es sogar, dass die Wellen-Bucht früher als erwartet in Betrieb geht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420126
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420126,
					"content": "Und Paimon dachte, du würdest uns im Stich lassen, sobald du dein Wassersport-Programm bekommen hast. Anscheinend hast du doch an die gesamte Gruppe gedacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420127,
					"content": "Hehe, wie wäre es, wenn wir uns wieder in der Nähe des riesigen Koholasaurier-Gebäudes treffen, wenn wir fertig sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420128
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420128,
					"content": "Basierend auf meiner Intuition, die ich in jahrelanger Erfahrung als Reiseführerin erworben habe, würde ich wetten, dass der Eingang zur Haupt-Herausforderung irgendwo dort liegt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420129
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420129,
					"content": "Sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420130
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150420130,
					"content": "Also gut, teilen wir uns auf. Vergesst nicht, immer wieder auf die Karte zu schauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420122,
					"content": "Nun, auch eine Reiseführerin verdient Urlaub.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				}
			]
		},
		{
			"id": 1504213,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
