			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chasca"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150421301,
					"content": "Gutes Auge. Hätte nicht erwartet, dass du mich hier oben entdeckst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421302
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421302,
					"content": "Es sieht so aus, als hättest du dich auch für die Einrichtungen hier interessiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421303,
						150421305
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421303,
					"content": "Nun, sind sie unterhaltsam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421304
					]
				},
				{
					"id": 150421304,
					"content": "Ich finde sie toll, aber „unterhaltsam“ ist subjektiv. Was ich sage, soll dich nicht beeinflussen. Du musst es selbst ausprobieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421307,
					"content": "Siehst du die Fahrbahn dort drüben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421308
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421308,
					"content": "Benutze die Farbkugeln, um die Bälle, die auf der Fahrbahn liegen, einzufärben. Sobald sie alle die gleiche Farbe haben, verschwinden die Bälle mit einem „Knall“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421309
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421309,
					"content": "Damit meine ich, dass jemand anderes mit seiner eigenen Waffe in der Nähe stehen wird. Er wird darauf warten, die bunten Bälle in die Luft zu jagen, sobald der richtige Zeitpunkt gekommen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421310,
						150421311
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421310,
					"content": "Absolut abgefahren ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421312,
					"content": "Mein Wort ist nichts wert, wenn du es nicht ausprobierst. Nimm einfach die Waffe dort drüben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421313
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421313,
					"content": "Dieses Mal schaue ich dir beim Spielen zu. Viel Glück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421311,
					"content": "Ich hätte dein Wort fast für bare Mora genommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421305,
					"content": "Sind die Spielregeln kompliziert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421306
					]
				},
				{
					"id": 150421306,
					"content": "Entspann dich, es ist ganz einfach. Passend, wenn man den Namen dieses Ortes bedenkt. Selbst wenn du dich bemühen würdest, könntest du hier nichts „Kompliziertes“ oder „Schweres“ finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "Chasca"
				}
			]
		},
