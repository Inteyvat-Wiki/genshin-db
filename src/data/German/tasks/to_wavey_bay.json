			},
			"dialogs": [
				{
					"id": 150421501,
					"content": "Gut, lasst uns durchzählen. Eins, zwei, drei, vier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421502
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421502,
					"content": "Hm, das ist einer mehr als vorher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421503
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421503,
					"content": "Seid gegrüßt! Ich nehme an, ihr seid alle hier, um euch der größten Herausforderung in der Wellen-Bucht zu stellen? Leider sind wir auf ein kleines Problem gestoßen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421504
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421504,
					"content": "Wenn ihr ein Gruppenfoto von der Attraktion für euer Album braucht, kann ich euch dabei helfen, es sofort zu machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421505
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421505,
					"content": "Nein ... Das ist nicht richtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421506
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421506,
					"content": "Fotos sind nur ein Mittel, um Erinnerungen zu bewahren, etwas, auf das man zurückblicken und mit dem man sich an all die glücklichen Momente erinnern kann. Was für uns zählt, ist das eigentliche Erlebnis selbst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421507
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421507,
					"content": "Nun, man kann immer noch diese Fotos gegen Preise eintauschen ... Aber, na ja, abgesehen davon ist Paimon ganz deiner Meinung. Einfach ein Foto zu machen und wegzugehen, wäre nicht richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421508,
					"content": "Ich verstehe, es tut mir sehr leid ... Bitte habt noch ein wenig Geduld mit uns. Wir werden unser Bestes tun, um das Problem so schnell wie möglich zu lösen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421509
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421509,
					"content": "Wie lange müssen wir noch warten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421510,
					"content": "Das ist etwas schwer zu sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421511
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421511,
					"content": "Hm? Und warum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421512,
					"content": "Können wir etwas tun, um zu helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421513
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421513,
					"content": "Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421514
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421514,
					"content": "Mir ist aufgefallen, dass nicht viele Leute an den anderen Herausforderungen in der Wellen-Bucht arbeiten, und auch die Saurier-Mitarbeiter wirken ziemlich erschöpft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421515
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421515,
					"content": "Ich vermute, es liegt daran, dass die Haupt-Herausforderung ein Problem hatte, sodass alle vorübergehend umdisponiert wurden, um bei den Reparaturarbeiten zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421516
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421516,
					"content": "Entspann dich. Ich verstehe, dass es wahrscheinlich Dinge gibt, die du nicht preisgeben kannst. Ich versuche nicht, die Dinge für dich schwieriger zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421517
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421517,
					"content": "Meine Gefährten sind alle sehr geschickt und helfen gerne mit, also eher das Gegenteil. Tatsächlich haben sie gerade die Prüfungen für „Dämmer-Bootsfahrt“ und „Asha rennt“ abgeschlossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421518
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421518,
					"content": "Wenn du uns sagen würdest, was das Problem ist, könnten wir dir sicher viel schneller helfen, es zu lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421519
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421519,
					"content": "Oh, sie ist wirklich eine taktvolle Verhandlerin. Das ist wohl die verborgene Kraft einer Friedensstifterin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421520,
					"content": "Warte, Chasca ... Woher wusstest du das alles? Du hast uns doch nicht etwa von einem Baum aus beobachtet, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421521
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421521,
					"content": "Spielt das jetzt wirklich eine Rolle ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421522
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421522,
					"content": "Die Rolle, die das spielt, ist ... dass wir wirklich gut darin sind, zu helfen! Wenn es also ein Problem gibt, wären wir alle mehr als glücklich, unseren Teil beizutragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421523
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421523,
					"content": "Ich bin ziemlich erstaunt, dass du genau weißt, wie es unseren Sauriern geht. Es tut mir leid, ich hätte nicht versuchen sollen, es vor euch zu verbergen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421524
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421524,
					"content": "Also im Grunde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421525
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421525,
					"content": "Während des Tests haben wir festgestellt, dass die aktuelle Bemalung der spektakulären Megarutsche noch viel zu wünschen übrig lässt. Da sie vom Seelenpfad aus besprüht werden muss, ist das gelinde gesagt eine gewaltige Herausforderung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421526
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421526,
					"content": "Um die offizielle Eröffnung der Urlaubsanlage nicht zu verzögern, mussten wir sie vorübergehend stilllegen. Im Moment arbeiten wir gegen die Zeit, um sie fertigzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421527
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421527,
					"content": "Haha, das nennst du eine Herausforderung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421528
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421528,
					"content": "Sag mir, wo die Farbe ist, und ich erledige das alles in einem Rutsch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421529
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421529,
					"content": "Hm? Aber ... wie soll das nur ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421530
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421530,
					"content": "Ich nehme an, du hast sie noch nie getroffen. Das hier ist „Um{RUBY#[S]Solidarität}oja“ Mualani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421531
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421531,
					"content": "Mualani ... Moment mal, Mualani!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421532
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421532,
					"content": "Meinst du Mualani, eine der sechs Helden?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tuksina"
				}
			]
		},
