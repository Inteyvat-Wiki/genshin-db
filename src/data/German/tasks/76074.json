			"dialogs": [
				{
					"id": 760740101,
					"content": "Was für eine seltsame Leier. Egal wie Paimon sie auch spielt, sie gibt überhaupt keinen Ton von sich ... Ist sie kaputt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740102,
						760740104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740102,
					"content": "Lass uns erstmal den Seelien folgen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760740103
					]
				},
				{
					"id": 760740104,
					"content": "Hä? Aber ich habe doch ganz klar Musik und Gesang gehört ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760740105
					]
				},
				{
					"id": 760740103,
					"content": "Ja, vergessen wir die Leier erstmal! Wenn wir den Seelien nach oben folgen, finden wir bestimmt den Schatz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740105,
					"content": "W... Wirklich? Hmm, außer dem Wind hat Paimon gar nichts gehört. Ist das vielleicht so eine Situation, wo „nur derjenige, der das Instrument spielt, die Musik hören kann“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740106,
					"content": "Gut, dann wird Paimon noch mal versuchen zu spielen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740107,
					"content": "Paimon zupfte kräftig an den Saiten ...\\n",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760740108
					]
				},
				{
					"id": 760740110,
					"content": "#Argh! Paimon hört immer noch gar nichts! {NICKNAME}, bist du dir sicher, dass du dich nicht verhört hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740111,
					"content": "Egal, vergessen wir die Leier erst mal! Wenn wir den Seelien nach oben folgen, finden wir bestimmt den Schatz!",
