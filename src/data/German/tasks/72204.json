			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040101,
					"content": "Kito, Kina, ihr seid da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040102
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040102,
					"content": "Ich kann nicht mit euch mithalten ... was, wenn ich in Gefahr bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040103,
						722040104
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040103,
					"content": "Guten Tag ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				},
				{
					"id": 722040105,
					"content": "He da! Ihr seid wirklich ... Ihr seid noch jung, sagt so etwas nicht, es verletzt das Herz des alten Menschen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040106
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040106,
					"content": "Wenn du schon mal hier bist, lauf nicht herum und spiele ... komm und leiste auch Oma Gesellschaft, okay?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040107,
						722040108
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040107,
					"content": "Entschuldigung, ich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040109,
					"content": "Wo war diese Geschichte beim letzten Mal ...? Ach ja ... das war, als der Großvater deines Großvaters noch jung war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040110
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040110,
					"content": "Jenseits des Nebelmeeres, auf der Insel der Außenstehenden, lebt ein Klan namens Sumari. Seine Matriarchin, ist eine fuchsähnliche Frau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040111
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040111,
					"content": "Man sagt, das Land dort drüben sei voller gewitterfarbener Blumen ... Das Volk der Sumari lebte in Liebe und Freude in seinen Häusern inmitten der Berge und Felder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040112
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040112,
					"content": "Und dann ja ... ha ... ihre Blumen ja ... ha ... hoo ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040113
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040113,
					"content": "Puh ... puh ... außerhalb des Nebelmeeres ... mmmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040114,
						722040115
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040114,
					"content": "Oma, geht es dir gut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040116,
					"content": "He ... Kito? Kina? Oh ... ihr geht schon? Seufz ... Es tut mir so leid, Oma ist wieder von alleine eingeschlafen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040117
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040117,
					"content": "Bevor ihr geht, vergesst das hier nicht ... Oma hat es für euch aufbewahrt ... es ist eine wunderschöne Blume von der anderen Seite des Nebelmeeres ... verliert sie nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040115,
					"content": "(Es ist besser, sie nicht zu belästigen ... )",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040108,
					"content": "Na gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040104,
					"content": "Sie haben mich wohl verwechselt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				}
			]
		},
