					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040301,
					"content": "Ich bin mir nicht sicher, was los ist. Ich erinnere mich nicht an alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040302,
						722040303
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040302,
					"content": "Guten Tag?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				},
				{
					"id": 722040304,
					"content": "Seufz ... mein Gedächtnis wird immer schlechter. Je älter ich werde, desto mehr Dinge kann ich mir nicht mehr merken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040305
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040305,
					"content": "Ich weiß nicht, ob Kito und Kina hungrig sind oder ob es sicher ist, draußen zu spielen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040306,
						722040307
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040306,
					"content": "Es wird schon nichts passieren ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040308,
					"content": "Kito, Kina! Warum habt ihr so lange gebraucht ... seid ihr unterwegs gestürzt? Ihr seid doch nicht wieder auf einen Baum geklettert, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040309
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040309,
					"content": "Es ist wirklich besorgniserregend. Ich weiß leider nicht, was in letzter Zeit passiert ist, aber es gibt immer weniger Menschen auf der Insel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040310
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040310,
					"content": "Wo sind die Leute, an deren Namen ich mich noch erinnere? Sie sind noch weniger geworden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040311
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040311,
					"content": "Was ist, wenn Oma euch auch vergisst ... was wird dann passieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040312
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040312,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040313
					]
				},
				{
					"id": 722040313,
					"content": "Ich gebe euch diese Blütenblätter ... Wenn Oma euch vergisst, zeigt mir diese ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040314
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040314,
					"content": "Oma hat noch viele Geschichten zu erzählen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040307,
					"content": "Kann ich helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040303,
					"content": "Ist etwas passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				}
			]
		},
