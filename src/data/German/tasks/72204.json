					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040701,
					"content": "Hallo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040702
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040702,
					"content": "Es tut mir leid, ich werde alt und bin nicht mehr ganz klar im Kopf ... wer bist du ...? Kenne ich dich überhaupt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040703,
						722040704
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040703,
					"content": "#Ich bin {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				},
				{
					"id": 722040705,
					"content": "Den Namen kenne ich nicht. Bist du von außerhalb?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040706
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040706,
					"content": "Seltsam, seltsam ... niemand sollte ohne Erlaubnis vom Donnervogel auf die Insel kommen können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040707,
						722040708
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040707,
					"content": "Der Donnervogel ist nicht mehr hier ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040709,
					"content": "Leider ... erinnert mich dein Anblick an meinen armen Mann ... aber jetzt kann ich mich nicht einmal mehr daran erinnern, wie er aussah ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040710
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040710,
					"content": "Damals waren wir alle jung und unsere Köpfe waren voller unrealistischer Fantasien ... aber manche Menschen werden auch nach einer gemeinsamen Zeit nicht halb so erwachsen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040711
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040711,
					"content": "Er verließ mich und baute ein Floß, um das Meer auf die andere Seite zu überqueren, auf die Insel der Außenstehenden ... Er sagte, er wolle frei sein, um dort zu jagen und Blumen zu pflücken, die er noch nie gesehen hatte ... schöne Blumen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040712
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040712,
					"content": "Das hat er schon als Kind gesagt ... aber er ist nie erwachsen geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040713
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040713,
					"content": "Da sah ihn das Kind des Priesters am Strand liegen, still wie eine Muschel, weißer als der Sand des Meeres, und diese Blütenblätter in seiner Hand ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040714
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040714,
					"content": "Der Priester weinte und sagte zu mir, dass das Schiff der Vorfahren ihn abgewiesen habe. Sein „Geist“ würde von nun an im Land der Außenstehenden umherwandern müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040715
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040715,
					"content": "Ich hatte gerade unser Kind zur Welt gebracht ... was sollte ich ihm dazu sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040716
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040716,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040717
					]
				},
				{
					"id": 722040717,
					"content": "Und dann ... bekamen meine Kinder Kinder und dann schickte ich meine Kinder an das silberne Schiff ... aber ich bin immer noch auf dieser Erde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040718
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040718,
					"content": "Ich habe nur noch Kito und Kina ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040708,
					"content": "Ich erkläre es dir später.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040704,
					"content": "#Nenn mich einfach {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				}
			]
		},
