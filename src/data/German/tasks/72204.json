			"dialogs": [
				{
					"id": 722041201,
					"content": "Dieser ... dieser Geruch ist ... Kitos Duftbeutel ... er hat den Geruch dieser beiden Kinder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722041202
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722041202,
					"content": "Sie haben also endlich genug vom Spielen und gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722041203
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722041203,
					"content": "Ich verstehe es nicht wirklich, aber ich denke schon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722041204
					]
				},
				{
					"id": 722041204,
					"content": "Vielen Dank, Außenstehender ... auf Wiedersehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722041205
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722041205,
					"content": "Die silbernen Zypressenwälder, der Fluss des Schlafes ... führt mich hin, ihr, die das Boot haltet ...",
