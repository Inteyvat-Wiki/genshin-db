			"dialogs": [
				{
					"id": 722040401,
					"content": "Geht und spielt, geht und spielt ... Oma wird nicht weggehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040402
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040402,
					"content": "O Blütenblätter ... O Blütenblätter ... wie ist es in eurem Heimatland ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				}
			]
		},
		{
			"id": 7220405,
			"completionStepIds": [
				7220403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220403",
