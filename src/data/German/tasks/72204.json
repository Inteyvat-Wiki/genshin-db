				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040501,
					"content": "Das ist Abe. Wie sieht es mit der Pilzernte zu Hause aus? Belästige den Priester nicht noch einmal, er wird mich nicht überzeugen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040502
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040502,
					"content": "Oh, Entschuldigung! Ich ziehe nur eine Familie alleine auf, warum kann ich da nicht mithalten? Oh, Entschuldigung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040503
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040503,
					"content": "E... Entschuldige bitte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040504,
						722040505
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040504,
					"content": "Hallo, Oma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040506
					]
				},
				{
					"id": 722040506,
					"content": "Ah! Du bist es! Was für eine Schande ... was für eine Schande! Komm doch rein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040507,
						722040508
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040507,
					"content": "Ähm ... was?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
					"id": 722040509,
					"content": "Wie war der Fang draußen ...? Keinen Fisch gefangen? ... Macht nichts, macht nichts, es reicht, sich auf den Garten zu Hause zu verlassen. Es ist nur so, dass es keine Möglichkeit gibt, dem Donnervogel den vollen Betrag darzubieten ... Nun, was ist los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040510
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040510,
					"content": "Was für ein Narr du bist! Das Fest ist dieses Jahr gut verlaufen, und auch der Rest des Jahres muss gut werden ... die Priesterin sagte, wir würden ein starkes Kind bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040511
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040511,
					"content": "Aber warum erzählst du mir plötzlich solche Sachen! Hast du vergessen, was mit Kama passiert ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040512,
						722040513
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040512,
					"content": "Bitte beruhige dich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040514
					]
				},
				{
					"id": 722040514,
					"content": "Wenn auch du dich vom Donnervogel entfernen und von den tosenden Wellen verschluckt werden willst, dann nur zu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040515
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040515,
					"content": "Mein Kind ... armes Kind ... hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040513,
					"content": "„Kama“ ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040514
					]
				},
				{
					"id": 722040508,
					"content": "Ufff ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
					"id": 722040505,
					"content": "Wie geht es dir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040506
					]
				}
			]
		},
