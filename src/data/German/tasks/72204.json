			"dialogs": [
				{
					"id": 722040901,
					"content": "Da bist du ja ... ach wirklich, Kito, Kina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040902
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040902,
					"content": "Ich glaube, sie sind weggegangen, um wieder irgendwo zu spielen ... wirklich ... das tut mir leid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040903
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040903,
					"content": "Und ... Wie heißt du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040904,
						722040905
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040904,
					"content": "#Hallo, {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040906
					]
				},
				{
					"id": 722040906,
					"content": "Seufz ... ich bin ... dabei zu gehen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040907
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040907,
					"content": "Zu gehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040908
					]
				},
				{
					"id": 722040908,
					"content": "Der Kerl, der das Boot hält, kommt in letzter Zeit öfters, um mich zu drängen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040909
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040909,
					"content": "Jedes Mal kam er leise, trug seinen goldenen Pelz, lange Hosen aus Gold und eine Krone aus Goldseide auf dem Kopf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040910
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040910,
					"content": "Genau wie meine Mutter es mir gesagt hat, genau wie ich es Kito und Kina gesagt habe ... nimmt er uns mit an Bord des silbernen glitzernden Bootes ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040911
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040911,
					"content": "Schaukeln und schaukeln und schaukeln auf dem leuchtenden Fluss ... und du bist in einem Traum. Es gibt keinen Nebel im Land der Träume, es gibt ein großes goldenes Haus ... mit siebzig und nochmals siebzig Wiegen ... schaukelnd, schaukelnd, schaukelnd ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040912
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040912,
					"content": "Wir schlafen dort, und wir werden zu einem kleinen Licht ... und dann, ach, werden wir zu den Träumen der Kinder der Erde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040913,
						722040914
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040913,
					"content": "Wah ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040915,
					"content": "Der Bootsmann sagte, dass er mir diese für Kito und Kina übergab. Oh ... diese beiden Kinder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040916
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040916,
					"content": "Noch nicht ... noch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040914,
					"content": "Du meinst also ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040905,
					"content": "#Ich bin’s, {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040906
					]
				}
			]
		},
