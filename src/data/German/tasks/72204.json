			"dialogs": [
				{
					"id": 722040201,
					"content": "Nun ... gut ... Lass Oma auch etwas schlafen ... hmmmm ... puh ... puh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040202
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040202,
					"content": "Seid vorsichtig, Leute ... geht nicht zu weit weg ... puh ... puh ...",
					"roleType": "TALK_ROLE_NPC",
