					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560601,
					"content": "Dass ich tatsächlich gegen einen Passanten verloren habe ... dreimal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560602
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560602,
					"content": "Nein, nein, du und ich haben beide zweimal verloren, der Boss nur einmal, also so schlimm ist es gar nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560603
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560603,
					"content": "#Ha! Verloren ist verloren, da hilft auch kein Grübeln! {NICKNAME} ist echt stark!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560604
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560604,
					"content": "Ihr beide könnt normalerweise ja nicht mal mich besiegen und jetzt habt ihr jemand richtig Starkes erlebt! Ihr müsst noch viel trainieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560605
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560605,
					"content": "Was mich betrifft ... ich sollte wohl langsam über den vorzeitigen Ruhestand nachdenken. Ich frage mich, ob sie bei Vainos Trainingsplatz noch Leute suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605607,
