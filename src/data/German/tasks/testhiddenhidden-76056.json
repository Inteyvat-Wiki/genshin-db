			},
			"dialogs": [
				{
					"id": 760560701,
					"content": "#Du bist also tatsächlich zurückgekommen! Bielov, du bist als Erster dran! Wie sieht’s aus? {F#Meine Freundin}{M#Mein Freund}, bist du bereit, dich mit uns zu messen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
