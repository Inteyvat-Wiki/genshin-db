					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560101,
					"content": "He, du da! Zum Trainingsplatz zu kommen und immer nur auf Ziele zu schießen, findest du das nicht ein bisschen unbefriedigend? Du siehst aus als hättest du Können, wie wäre es mit ein paar Übungskämpfen gegen uns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605602,
			"completionStepIds": [
				7605601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605601",
							"2"
						],
						"stepId": 7605601,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7605601",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560201,
					"content": "Nur ein paar? Ein paar mehr wären auch in Ordnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560202
					]
				},
				{
					"id": 760560202,
					"content": "Haha, so gehört sich das! Sich mit jemand Anderem zu messen macht doch Spaß, oder? Bielov, wie wäre es, wenn du zuerst eine Runde gegen unseren neuen Freund kämpfst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560205
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560205,
					"content": "Alles klar, Boss! In drei Zügen beende ich das!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bielov"
				}
			]
		},
		{
			"id": 7605603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605601",
							"2"
						],
						"stepId": 7605601,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7605601",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560301,
					"content": "Tut mir leid, ich habe noch etwas zu tun ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560302
					]
				},
				{
					"id": 760560302,
					"content": "Kein Problem, wir schlagen hier sowieso nur die Zeit tot. Komm einfach wieder zu uns, wenn du Zeit hast und es dich kitzelt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605604,
			"completionStepIds": [
				7605602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605602",
							"2"
						],
						"stepId": 7605602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560401,
					"content": "Tut mir leid, Boss ... ich habe euch alle blamiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560402
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560402,
					"content": "He, es war doch nur, um Zeit totzuschlagen, also ist es nicht schlimm, dass du verloren hast. Bielov, ruh dich erstmal ein bisschen aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560403
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560403,
					"content": "#{F#Meine Freundin}{M#Mein Freund}, du beweist gutes Können! Ich heiße Terho, freut mich sehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560404
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560404,
					"content": "#Ich bin {NICKNAME}. Freut mich, dich kennenzulernen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560405
					]
				},
				{
					"id": 760560405,
					"content": "#Du scheinst {F#eine erfahrene Kämpferin}{M#ein erfahrener Kämpfer} zu sein, da müssen wir die Sache wohl ernster nehmen. Das eben zählt nicht, lass uns noch einmal kämpfen! Incali, du bist dran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560406
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560406,
					"content": "Der Boss erinnert sich nur an mich, wenn es Probleme gibt ... Tja, da kann man nichts machen. Also dann, du Könner, lass uns anfangen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Incali"
				}
			]
		},
		{
			"id": 7605605,
			"completionStepIds": [
				7605603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7605603",
							"2"
						],
						"stepId": 7605603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560501,
					"content": "I... Ich habe tatsächlich verloren ... von einem einfachen Passanten besiegt ... Wie kann das sein?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560502
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560502,
					"content": "Hmm, du hast also gegen Incali gewonnen ... Ich habe dich wohl unterschätzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560503
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560503,
					"content": "Das ist nicht deine Schuld, Boss. Wer hätte schon ahnen können, dass so starke Gegner ausgerechnet hier vorbeikommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560504
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560504,
					"content": "Boss! Wir dürfen sie nicht gehen lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560505
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560505,
					"content": "Hm? Geht es nicht nur um ein einfaches Kräftemessen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560506
					]
				},
				{
					"id": 760560506,
					"content": "Versteh uns nicht falsch, Incali meint nur, dass wir und nicht einfach so geschlagen geben können. Wir sind immerhin Schatzjäger mit ein bisschen Ansehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560507
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560507,
					"content": "#{NICKNAME}, ich fordere dich hiermit offiziell heraus. Diesmal geht es nicht nur ums Vergnügen – wie wäre es, wenn wir mit voller Kraft gegeneinander antreten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560508
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560508,
					"content": "Bitte, kommt doch alle drei auf einmal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560509
					]
				},
				{
					"id": 760560509,
					"content": "Also gut, dann zeigen wir dir keine Gnade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
