			"dialogs": [
				{
					"id": 200390401,
					"content": "Versuch dich zunächst an „Donneröl“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390402
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390402,
					"content": "Das ist ein grundlegendes Produkt der Alchimie und eignet sich besonders für Anfänger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390403
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390403,
					"content": "Wenn du Donneröl herstellen willst, brauchst du erst einmal elektrisierte Kristalle und Frösche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390404
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390404,
					"content": "Beide Zutaten findet man draußen in der ... Was? Du findest, dass ein Kristall nichts mit Öl zu tun hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390405
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390405,
					"content": "Hahaha! Natürlich hat er das! Aber der elektrisierte Kristalle ist für den Donner zuständig, die Kröte für das Öl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390406
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390406,
					"content": "Sobald du alle Zutaten beisammen hast, kannst du das Donneröl herstellen. Versuch es einfach! Ich werde dir über die Schulter gucken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390407
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390407,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
