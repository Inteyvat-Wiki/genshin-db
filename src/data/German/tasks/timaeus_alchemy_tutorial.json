					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390604,
					"content": "Draußen vor der Stadt solltest du eigentlich fündig ... Was Frösche mit Feuer zu tun haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390605
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390605,
					"content": "Der Extrakt der Flammenblumen muss doch erst mit dem Schleim auf der Krötenhaut verdünnt werden, um genießbar zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390606
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390606,
					"content": "Oh, ach so! Ich habe nichts gesagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390607
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390607,
					"content": "Sobald du alle Zutaten beisammen hast, kannst du das Flammenöl herstellen. Versuch es einfach! Ich werde dir über die Schulter gucken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390608
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390608,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
