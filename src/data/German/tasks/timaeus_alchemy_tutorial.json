			"dialogs": [
				{
					"id": 200390101,
					"content": "Ich will mehr über Alchimie erfahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390102,
					"content": "Die alte Kunst der ist einfach atemberaubend ... Wenn doch nur mehr Menschen daran Begeisterung fänden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390103
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390103,
					"content": "Was? Interessierst du dich etwa auch für Alchimie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390104,
					"content": "Ja, sehr sogar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200390105
					]
				},
				{
					"id": 200390105,
					"content": "Dann komm doch her und versuche dich selbst an dieser Kunst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390106,
					"content": "Alle großen Erfolge bauen auf einer soliden Basis und entwickeln sich von dort aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		},
