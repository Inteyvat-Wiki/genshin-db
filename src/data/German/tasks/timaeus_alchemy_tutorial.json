				},
				{
					"id": 200390503,
					"content": "Wenn du Frostöl herstellen willst, brauchst du erst einmal Echsenschwänze und Eisnebelblumenblüten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390504
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390504,
					"content": "Diese beiden Zutaten sollten draußen ziemlich gut zu finden ... Was? Wozu Echsenschwänze gut sein sollen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390505
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390505,
					"content": "Ein knusprig gefrorener Echsenschwanz gibt dem Trank doch erst die richtige Würze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390506
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390506,
					"content": "Hahaha, ich mache doch nur Spaß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390507
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390507,
					"content": "Sobald du alle Zutaten beisammen hast, kannst du das Frostöl herstellen. Versuch es einfach! Ich werde dir über die Schulter gucken.",
