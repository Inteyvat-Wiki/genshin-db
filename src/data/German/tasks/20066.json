			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ellin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200660101,
					"content": "So ein Mist! Was soll ich denn jetzt tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660102,
					"content": "Was tust du denn hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660103
					]
				},
				{
					"id": 200660103,
					"content": "Ich trainiere für die nächste Ritterauswahl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660104,
					"content": "Aber na ja, ich bin natürlich nicht so stark wie Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660105,
					"content": "Ich glaube, ich sollte mich eher an die Technik als an die Stärke halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660106,
					"content": "Beispielsweise denke ich darüber nach, wie ich all die Holzpfähle mit einem Schlag abschlagen könnte. Mein Vater hat sie mir gesucht. Da möchte ich ihn nicht enttäuschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660107,
					"content": "Wenn du Zeit und Lust hast, kannst du gern mit mir zusammen darüber nachdenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660108,
						200660109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660108,
					"content": "Ich überlege mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660110
					]
				},
				{
					"id": 200660110,
					"content": "Klar, lass dir Zeit. Die Holzpflöcke laufen ja nicht weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660111,
					"content": "Das einzige, was uns davonlaufen könnte, ist unsere Zeit ... und unser Leben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660114,
					"content": "Bei dieser Entfernung sollte ich womöglich die eine Seite übernehmen und die andere mit einer Bombe bearbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660115
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660115,
					"content": "Hahaha, ich mache doch nur Spaß! Woher sollte man schon Bomben kriegen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660109,
					"content": "Wir könnten es zusammen versuchen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660112
					]
				},
				{
					"id": 200660112,
					"content": "Kämpfst du sonst auch immer in der Gruppe? Beneidenswert ... jemanden zu haben, auf den man zählen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660113,
					"content": "Jemand wie ich muss lernen, allein zurechtzukommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
		{
			"id": 2006602,
			"completionStepIds": [],
