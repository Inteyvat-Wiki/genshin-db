			},
			"dialogs": [
				{
					"id": 200660301,
					"content": "Geschafft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660302
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660302,
					"content": "Darauf wäre ich nie im Leben gekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660303
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660303,
					"content": "Danke dir! Ich werde es gleich selbst versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		}
	]
