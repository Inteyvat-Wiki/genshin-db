					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680404
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680404,
					"content": "Kannst du diese Methode noch einmal wiederholen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680405
					]
				},
				{
					"id": 721680405,
					"content": "Ich werde es dir sagen. Die genaue Methode ist, etwas in der Umgebung zu finden, das sich „Donner-Sakura-Zweig“ nennt, und es zu berühren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680406
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680406,
					"content": "Danach sollte etwas namens „Elektrogranum“ an hängen bleiben, das dir erlaubt, diese Barriere zu betreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				}
			]
		},
