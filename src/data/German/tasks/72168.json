			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680201,
					"content": "Parvaneh, gibt es wirklich keinen anderen Weg?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680202,
					"content": "Das ist die einzige Art und Weise, wie es in dem Buch, das ich habe, dokumentiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680203
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680203,
					"content": "Oooh ... wenn da nur Monster im Weg wären ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680204
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680204,
					"content": "Sind das die „Sakura-Blüten“, die du wolltest?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680205
					]
				},
				{
					"id": 721680205,
					"content": "Oh! Ja, das ist die Art von „Sakura-Blüte“, die wir wollen. Diese Farbe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680206
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680206,
					"content": "Das ist toll! Endlich kann ich etwas Leckeres kochen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680207
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680207,
					"content": "Moment mal, du bist in die Barriere hineingegangen? Mit der gleichen Methode, von der wir dir erzählt haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680208
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680208,
					"content": "Ja. Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680209
					]
				},
				{
					"id": 721680209,
					"content": "Kannst du mir sagen, wo der „Donner-Sakura-Zweig“ ist, den du gefunden hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680210
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680210,
					"content": "Wie hat sich dieses „Elektrogranum“ an dir festgesetzt, nachdem du den „Donner-Sakura-Zweig“ berührt hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680211
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680211,
					"content": "Tut mir leid, ich hole erst mal mein Notizheft raus ... Na ja, hast du etwas gefühlt, nachdem du mit dem „Elektrogranum“ verbunden warst? Und ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680212
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680212,
					"content": "#Parvaneh, warte einen Moment. Dieser {F#Reisende}{M#Reisender} hat uns gerade einen Gefallen getan. Du musst mit den Nachforschungen noch eine Weile warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680213
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680213,
					"content": "#{F#Reisende}{M#Reisender}, danke für deine Hilfe, du wirst wie vorher vereinbart bezahlt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680214
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680214,
					"content": "Aber bis dahin, warte bitte noch ein wenig. Mit der „Sakura-Blüte“, die du mitgebracht hast, kann ich auch anfangen zu kochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680215
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680215,
					"content": "Ich habe gehört, dass es in Inazuma ein spezielles Gericht namens „Sakura-Tempura“ gibt, aber jetzt habe ich endlich die Chance, es zu probieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680216
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680216,
					"content": "Ich kümmere mich darum, es sollte bald fertig sein, also melde sich später.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7216803,
			"completionStepIds": [
				7216804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216804",
							"2"
						],
						"stepId": 7216804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680301,
					"content": "So ... und so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680302,
					"content": "Bist du fertig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680303
					]
				},
				{
					"id": 721680303,
					"content": "Eine letzte Sache ... ich muss das noch einwickeln, einlegen und frittieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680304,
					"content": "Es ist vollbracht! „Sakura-Tempura“! Probiere es doch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680305,
					"content": "Gut, lecker, nur ein bisschen ... ein bisschen zu heiß ... puh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680306
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680306,
					"content": "Xudong, im Buch steht, dass dieses Ding namens „Tempura“ mit einer Soße serviert werden soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680307
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680307,
					"content": "Soße? Das ist etwas, das ich nicht wirklich vorbereitet habe, also werde ich es mir bei nächster Gelegenheit ansehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680308,
					"content": "#Dieses „Sakura-Tempura“ ist für dich, nimm es, {F#Reisende}{M#Reisender}, und danke, dass du uns diesen Gefallen getan hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680309,
					"content": "Und diese „Sakura-Tempura“-Zubereitung habe ich für dich kopiert, also nimm sie einfach mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680310
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680310,
					"content": "Du solltest in Zukunft mal versuchen, sie selbst zu machen. Es macht immer viel Spaß, selbst zu kochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680311,
						721680313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680311,
					"content": "Danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680312
					]
				},
				{
					"id": 721680312,
					"content": "Ach, kein Problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680314
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680314,
					"content": "Wir werden noch eine lange Weile in Inazuma bleiben, also denke ich, dass wir später nach <color=#00E1FFFF>Kannazuka</color> gehen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680316,
					"content": "Und Julie sagte, dass sie den heiligen Sakura-Baum sehen wollte, der im „Großen Narukami-Schrein“ stand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680317
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680317,
					"content": "Es wird gesagt, dass alle „Sakura-Blüten“ auf dieser Insel von diesem großen Baum herunterschweben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680318
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680318,
					"content": "Wie groß ist der Baum, dass er so viele Blütenblätter hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680319
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680319,
					"content": "Wenn du Interesse hast, geh mal rüber und schau es dir auch an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680320,
					"content": "#Nochmals vielen Dank für deine Hilfe, {F#Reisende}{M#Reisender}. Ich muss mir auch etwas zu essen holen, ich bin am Verhungern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680313,
					"content": "Wohin gehst du als Nächstes?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680314
					]
				}
			]
		},
