			"dialogs": [
				{
					"id": 3710101,
					"content": "Du hast ihr eben nicht alles gesagt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710102,
					"content": "Außer dem Drachen und dem Kristall haben wir noch etwas anderes gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710103,
						3710104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710103,
					"content": "Ich will der Sache erst allein nachgehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710105
					]
				},
				{
					"id": 3710105,
					"content": "Du erinnerst dich also noch an ihn, diesen Kerl in Grün!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710106,
					"content": "Er sah genauso aus wie der da unten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710107,
						3710111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710107,
					"content": "Hmm, das scheint der gleiche Farbton gewesen zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710108
					]
				},
				{
					"id": 3710108,
					"content": "Ich glaub schon, ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710109,
					"content": "Komisch, je länger ich hinsehe, desto ähnlicher scheint er auszusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710110,
					"content": "Das ist derselbe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710111,
					"content": "Das ist der Kerl in Grün!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710112
					]
				},
				{
					"id": 3710112,
					"content": "Aaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3710104,
					"content": "Der Kerl sah nicht gerade bösartig aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710105
					]
				}
			]
		},
