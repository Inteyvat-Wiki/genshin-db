				},
				{
					"id": 741890426,
					"content": "Noch einmal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890409
					]
				},
				{
					"id": 741890427,
					"content": "Lass mich überlegen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890428
