			"dialogs": [
				{
					"id": 741890501,
					"content": "Einen Moment. Willst du ein „Geheimnis“ über den Schatz erfahren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890502
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890502,
					"content": "Welches Geheimnis?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890503
					]
				},
				{
					"id": 741890503,
					"content": "Ein Schatz und der Schlüssel zum Öffnen der Schatztür ... Wie wäre das? Interessierst du dich dafür?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890504,
						741890505
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890504,
					"content": "Verlange nicht wieder von mir, dass ich gegen Monster kämpfe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				},
				{
					"id": 741890506,
					"content": "Wie kommst du darauf? Unsere Taverne schickt Gäste niemals los, um Aufträge zu erledigen. Zumindest ... schicken wir keine Gäste los, um Aufträge zu erledigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890507
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890507,
					"content": "Siehst du diese „Kanone“ hier neben mir, und den Trümmerhaufen, auf den sie gerichtet ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890508
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890508,
					"content": "Du musst nur die Kanone aktivieren und mit der Kanonenkugel die Steine wegsprengen. Wenn die Steine zerstört sind, gehört der Schatz dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890509
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890509,
					"content": "Wer hat sich den Namen für die Kanone ausgedacht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890510
					]
				},
				{
					"id": 741890510,
					"content": "Der Steuermann hat ihn sich ausgedacht. Die Kanone hat er auch von irgendwo hergeholt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890511,
						741890512
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890511,
					"content": "Direkt gefragt: Welches Teil fehlt bei dieser Kanone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890513,
					"content": "Du irrst dich. Bei dieser Kanone sind alle Teile intakt und vollständig. Energie ist auch ausreichend vorhanden. Sie wird von mir täglich gewartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890514
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890514,
					"content": "Aber vor dem Abfeuern der Kanone will ich dich bitten, einige „Fragen“ zu beantworten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890515
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890515,
					"content": "... Um ehrlich zu sein, ist das die Forderung des Steuermanns. Er sagt, dass so die Gäste, die der Taverne einen Besuch abstatten, eine Beschäftigung haben und auf diese Weise ihren Alkohol langsamer trinken und länger in der Taverne verweilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890516
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890516,
					"content": "Ich weiß nicht. Aber bitte stelle deine Fragen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890517
					]
				},
				{
					"id": 741890517,
					"content": "Die erste Frage ist: Wie viele Tische gibt es in unserer „Rostruder“-Taverne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890518
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890518,
					"content": "Die zweite Frage ist: Wie viele Mitarbeiter gibt es in unserer „Rostruder“-Taverne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890519
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890519,
					"content": "Die dritte Frage lautet: Welche Sache wird von unserer „Rostruder“-Taverne nicht angeboten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890520
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890520,
					"content": "Kurz gesagt, du musst nur drei Fragen richtig beantworten, um die Kanone abzufeuern, welche die Steine zertrümmern und dir den Schatz sichern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890521
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890521,
					"content": "Und was ist, nachdem ich den Schatz an mich genommen habe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890522
					]
				},
				{
					"id": 741890522,
					"content": "... Danach werde ich zu einem passenden Zeitpunkt wieder einen geeigneten Schatz in die Höhle bringen und den Eingang zur Höhle mit Trümmern zumauern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890523
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890523,
					"content": "Dann kann der nächste Gast ihn mittels der „Kanone“ bergen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890524,
						741890525
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890524,
					"content": "Du hast eine schwere Arbeit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890528
					]
				},
				{
					"id": 741890528,
					"content": "In Ordnung, dann such nach den Antworten auf die Fragen. Ich werde hier auf dich warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890525,
					"content": "Dein Boss ist wirklich ein Schuft!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890526
					]
				},
				{
					"id": 741890526,
					"content": "Ich kann dir nicht widersprechen. Aber ich habe noch keine Methode gefunden, wie ich die Mündung der Kanone auf den Steuermann richten kann, ohne dass es von ihm bemerkt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890527
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890527,
					"content": "Wenn außerdem die Kanone auf so rücksichtslose Weise abgefeuert würde, können andere Gäste in der Taverne verletzt werden. Das entspricht nicht meiner Vorstellung von tugendhaftem Verhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890528
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890512,
					"content": "Direkt gefragt: Welche Energie fehlt dieser Kanone?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890505,
					"content": "Du willst doch nicht schon wieder, dass ich etwas suche ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				}
			]
		}
	]
}