			"dialogs": [
				{
					"id": 6051101,
					"content": "#Herr Albedo! {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051102
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 6051102,
					"content": "Ist hier alles in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6051103,
					"content": "Alles gut! Ein paar Monster sind in die Stadt eingedrungen, aber Meister Diluc und Herr Kaeya haben mir geholfen, sie zu erledigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051104
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 6059901,
					"content": "Vor nicht allzu langer Zeit ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
