			"dialogs": [
				{
					"id": 6050201,
					"content": "Fantastische Arbeit bei der Verteidigung dieses Ortes, ihr zwei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050202
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050202,
					"content": "Von hier an übernehmen wir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 6050203,
					"content": "Rittmeister Kaeya, Swan ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050204
					],
					"speakerTitle": "Lawrence"
				},
				{
					"id": 6050204,
					"content": "He! Mir geht’s gut. Sorgen wir uns lieber um dein Bein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050205
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050205,
					"content": "Swan, Lawrence, ihr solltet euch beide in der Kathedrale behandeln lassen. Überanstrengt euch nicht. Wir kümmern uns hier um alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050206
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050206,
					"content": "Aber, Meister Diluc ... Hast du den Ritterorden nicht verlassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050207
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050207,
					"content": "Was, ist etwa nur der Ritterorden in der Lage, dieses Tor zu verteidigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 6050208,
					"content": "Schon gut. Meister Diluc ist einfach nur ... selbstlos wie immer. Wenn ein Zivilist helfen möchte, wer sind wir denn, ihn abzuweisen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050209
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 6050209,
					"content": "... Verstanden. Wir sind dankbar für die Unterstützung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050210
					],
					"speakerTitle": "Swan"
				},
				{
					"id": 6050210,
					"content": "Ja, tausend Dank! Wir sind gleich wieder da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6050211
					],
					"speakerTitle": "Lawrence"
				},
				{
					"id": 6051104,
					"content": "Ich habe gerade etwas Zeit übrig, also wollte ich ein paar Tränke für die kämpfenden Leute herstellen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051105
					],
					"speakerTitle": "Saccharose"
				},
				{
					"id": 6051105,
					"content": "Ein guter Plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6051106,
					"content": "Sei bitte vorsichtig. Auch wenn es unwahrscheinlich ist, zieh dich an einen sicheren Ort zurück, falls du in eine Situation gerätst, die du nicht bewältigen kannst. Mach dir keine Sorgen um die Frontlinie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6051107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6051107,
					"content": "Verstanden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Saccharose"
				}
			]
		},
