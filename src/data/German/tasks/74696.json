					}
				]
			},
			"dialogs": [
				{
					"id": 746960101,
					"content": "Erinnerst du dich jetzt, Qiqi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960102
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960102,
					"content": "Oh ... Ähm ... Tut mir leid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960103
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960103,
					"content": "Keine Sorge. Bis zum Palais Mermonia ist es noch ein weiter Weg. Lass uns einfach weiterlaufen – ich bin sicher, du erinnerst dich bald daran, wo dein Zuhause ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960104
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960104,
					"content": "Sieh mal, da ist Qiqi! Und sie ist mit einer Melusine unterwegs. Das ist eine Kombi, die Paimon echt nicht erwartet hätte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960105,
					"content": "#Ah! {NICKNAME} und ... Pai... Paimon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960106
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960106,
					"content": "Hallo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960107
					]
				},
				{
					"id": 746960107,
					"content": "Ihr kennt Qiqi? Fantastische Neuigkeiten! Ich bin ihr bei meinen Ermittlungen in der Nähe des Lumidouce-Hafens begegnet ... Wegen ihrer Größe dachte ich, sie wäre ein Menschenkind ... Sie ist doch ein Kind, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960108
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960108,
					"content": "Ich bin ... ich bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960109
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960109,
					"content": "... Unsere gute Freundin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960110
					]
				},
				{
					"id": 746960110,
					"content": "Genau, genau! Wir kennen uns schon ewig. Wir sind die besten Freunde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960111,
					"content": "Hehe! Schnell gedacht! Wenn Qiqi gesagt hätte, dass sie ein Zombie ist, hätte sie die Melusine vielleicht zu Tode erschreckt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960112,
					"content": "Ja ... beste ... Freunde ... genau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960113
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960113,
					"content": "Nun, das ist wirklich eine glückliche Fügung. Ehrlich gesagt bin ich zum ersten Mal in meinem Leben völlig ratlos ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960114
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960114,
					"content": "Du weißt also von ihren Gedächtnisproblemen? Sie kann sich kaum an etwas anderes als ihren eigenen Namen erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960115
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960115,
					"content": "So ist Qiqi manchmal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960116,
					"content": "Armes Kind. Ich wollte sie eigentlich zum Maréchaussée-Phantom mitnehmen und sie dort eine Weile bleiben lassen, aber ich hoffte, dass ihr auf dem Weg vielleicht ein paar Erinnerungen zurückkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960117
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960117,
					"content": "Da ihr so gute Freunde seid, nehme ich an, ihr wisst, wo sie wohnt? Es würde eine Menge Ärger ersparen, wenn ich sie direkt nach Hause bringen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960118
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960118,
					"content": "Wir wissen es ... Aber es ist, ähm, sehr weit weg von hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960119,
					"content": "Sehr ... weit weg ...? Ich bin einer Seelie bis zum Lumidouce-Hafen gefolgt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960120
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960120,
					"content": "Hm? Du hast dich an etwas erinnert? Was ist davor passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960121
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960121,
					"content": "Vorher ... hat Herr Bai mich bei seinen Visiten in Yi... Ähm, Yi-irgendwas mitgenommen ... Ich bin Kräuter sammeln gegangen, und dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960122
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960122,
					"content": "Oh! Herr Baizhu hat dich zum Yilong-Pier mitgenommen, oder? Detektivin Paimon weiß, was passiert ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960123,
					"content": "Baizhu hat Qiqi mitgenommen, um Patienten am Yilong-Pier zu besuchen. Beim Kräutersammeln hat sie sich verirrt, eine Seelie entdeckt und ist ihr bis zum Lumidouce-Hafen gefolgt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960124,
					"content": "#Hehe, zum Glück haben Paimon und {NICKNAME} „Robben gegen Chesterton“ gelesen! Solche einfachen Schlussfolgerungen sind für Paimon jetzt ein Kinderspiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960125,
					"content": "Du weißt schon, dass das Buch ein fiktives Werk ist, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960126
					]
				},
				{
					"id": 746960126,
					"content": "Aha! Nun, das macht Sinn! Ich bringe Qiqi sofort zurück zum Yilong-Pier. Herr Baizhu ist Qiqis Vormund, oder? Er muss sich große Sorgen machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960127,
						746960128
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960127,
					"content": "Warte ... Die Leute in Barbeloths Prophezeiung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				},
				{
					"id": 746960129,
					"content": "Oh, du hast recht! Das hätte Paimon fast vergessen. Barbeloth – bist du da? Kannst du uns hören?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960130,
					"content": "Du musst nicht schreien. Ich war die ganze Zeit hier, aber ich wollte euer Gespräch nicht einfach unterbrechen. Zuhören ist der Grundzustand jedes guten Wahrsagers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960131
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960131,
					"content": "Die sogenannte Führung dieser Seelie könnte man auch als Führung des Schicksals betrachten. Hehehe ... Da du nun hier bist, Qiqi, warum lässt du mich nicht mal dein Schicksal lesen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960132
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960132,
					"content": "Wahr... sagerei ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960133
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960133,
					"content": "Oje, Barbie, lass mich doch kurz einwerfen: Du bist wirklich nicht dafür geeignet, mit Kindern zu reden, weißt du – du machst dem armen Mädchen Angst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960134
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960134,
					"content": "Lass mich das übernehmen. Jetzt hör gut zu: So überreicht man ein kleines Überraschungsgeschenk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960135
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960135,
					"content": "Ähm, kleine Qiqi, Mitglied des Minihexenzirkels, ich bin die Mutter deiner Verbündeten Klee, Tante Alice, die größte Hexe der Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960136,
					"content": "Freut mich, dich kennenzulernen, Tante Alice ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960137
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960137,
					"content": "Was für ein süßes, höfliches Kind. Komm her, lass die Freundin von Tante Alice, eine andere große Hexe, eine wundervolle Überraschungs-Wahrsage-Feier für dich veranstalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960138
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960138,
					"content": "Wahrsage... -Feier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960139
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960139,
					"content": "Genau! Schau dir die Karten vor dir an. Sind sie nicht hübsch? Magst du sie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960140
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960140,
					"content": "Ich ... mag sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960141
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960141,
					"content": "Das ist wunderbar! Kannst du mir jetzt eine aussuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960142
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960142,
					"content": "Ähm ... Ist die hier in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960143
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960143,
					"content": "Natürlich. Und weil du so wunderbar brav warst, darfst du diese Karte behalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960144,
					"content": "... D... Danke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960145
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960145,
					"content": "Also gut, Barbie, die Pause ist vorbei. Komm und hilf der kleinen Qiqi beim Lesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960146
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960146,
					"content": "Du musst mich nicht wachrütteln – ich habe die ganze Zeit zugehört ... Ah, der aufrechte Gehängte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960147
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960147,
					"content": "Nur sehr wenige Leute ziehen diese Karte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960148
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960148,
					"content": "Das bedeutet, dass du etwas ganz Besonderes bist, Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960149
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960149,
					"content": "Sie symbolisiert Transzendenz und Warten, aber auch die Loslösung von der alltäglichen Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960150
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960150,
					"content": "Es gibt Fesseln, die dich binden, aber du selbst hast kein Verlangen, dich von ihnen zu befreien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960151
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960151,
					"content": "Fesseln ... Meinst du ... meine Befehle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960152
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960152,
					"content": "Zumindest oberflächlich betrachtet wäre es nicht falsch, die Dinge so zu verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960153
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960153,
					"content": "Was deine Zukunft betrifft, musst du nur warten. Natürlich mangelt es dir nicht an Zeit ... Aber ... Oje, wie seltsam, wie seltsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960154,
					"content": "Moment mal! Du redest zu viel auf einmal – lass dem Kind doch erst mal Luft zum Atmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960155
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960155,
					"content": "Lass Qiqi erst mal ihr kleines Geschenk auskosten. Man braucht bei Kindern ein bisschen mehr Geduld – gib ihnen etwas mehr Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960156
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960156,
					"content": "Was denkst du, Qiqi? Gefällt dir deine Überraschung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960157
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960157,
					"content": "Diese Karte ist wirklich hübsch ... Danke, Tante Alice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960158
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960158,
					"content": "Oje, braves Mädchen – du hast dir Tante Alices Namen so gut gemerkt. Ich würde gerne noch mehr mit dir plaudern, aber es ist Zeit für dich, nach Hause zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960159
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960159,
					"content": "Wenn ich noch mehr zu sagen habe, kann ich beim nächsten Treffen des Hexenzirkels für jede kleine Hexe, die kommt, eine Prophezeiung machen! Wäre das nicht schön?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960160
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960160,
					"content": "... Könntest du aufhören, mir zusätzliche Arbeit aufzuhalsen, ohne mich vorher zu fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960161
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960161,
					"content": "Dann ist das abgemacht! Bis zum nächsten Mal, Qiqi, und euch allen, die ihr dabei wart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960162
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960162,
					"content": "Tschüss ... Tante Alice ... und Tante Alices ... allerbeste Freunde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960163
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960163,
					"content": "Puh ... Ist das jetzt alles vorbei? Kamen diese beiden Stimmen gerade aus dieser Puppe? Was ist das für ein Spielzeug? Das ist so süß, wo kann ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960164
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960164,
					"content": "Ugh! Nein, das ist jetzt nicht wichtig. Qiqi, lass uns deinen Dr. Baizhu suchen gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960165
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960165,
					"content": "#... Mmhmm, es ist Zeit ... Qiqi sollte nach Hause gehen. Bis ... zum nächsten Mal, {NICKNAME} ... und Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960166,
						746960167
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960166,
					"content": "Pass auf dich auf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960168,
					"content": "Karte ... Geschenk ... Hmm ... Hübsch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960167,
					"content": "Pass auf dich auf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
