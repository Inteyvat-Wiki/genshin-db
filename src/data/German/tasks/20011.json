			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200110301,
					"content": "#Jetzt kann man den Weg wieder benutzen. Danke, {F#Reisende}{M#Reisender}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110302,
					"content": "Wir haben nicht viel Geld und Anna geht es einfach nicht besser. Deswegen komme ich oft her, um Heilkräuter zu pflücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110303
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110303,
					"content": "Ich habe die Kräuter gesammelt. Dann haben mich diese Kerle angegriffen. Gut, dass du in der Nähe warst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110304,
					"content": "Hier, das ist für dich. Daraus mache ich Anna oft Tee. Das hilft gegen ihren Husten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110305,
					"content": "Du bist auch oft draußen, nicht wahr? Pass bitte gut auf dich auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
	]
