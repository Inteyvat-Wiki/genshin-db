				"points": []
			},
			"dialogs": [
				{
					"id": 200110201,
					"content": "#Danke, {F#Reisende}{M#Reisender} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110202
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110202,
					"content": "Aber hier ist noch eine Sperre, daran komme ich nicht vorbei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110203
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110203,
					"content": "Hahaha, ich habe es auch allein geschafft ... Dafür habe ich es mit den Hilichurlen zu tun bekommen. Mir tut immer noch alles weh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110204
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110204,
					"content": "Aber wenigstens sind die Heilkräuter, die ich für Anna gesammelt habe, noch in Ordnung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110205
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110205,
					"content": "Es tut mir wirklich leid nach allem, was du schon getan hast. Aber könntest du diese Straßensperre noch aus dem Weg räumen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110206,
						200110207
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110206,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110208
					]
				},
				{
					"id": 200110208,
					"content": "Danke! Ich werde mich solange ausruhen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110207,
					"content": "Ich habe noch etwas Dringendes vor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110209
					]
				},
				{
					"id": 200110209,
					"content": "Anna wartet aber noch zu Hause auf mich. Würdest du mir bitte helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
			"id": 2001103,
			"completionStepIds": [
				2001104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
