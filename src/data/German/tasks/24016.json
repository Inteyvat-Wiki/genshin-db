			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chalmet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240160301,
					"content": "Puh ... Ich danke dir für deine Hilfe. Ich weiß nicht, wie lange ich ohne deine Hilfe gebraucht hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160302
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160302,
					"content": "#Du hast es wirklich verdient, {M#ehrenamtlicher Spitzenforscher}{F#ehrenamtliche Spitzenforscherin} zu sein. Egal, was du tust, du machst es so rasch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160303,
						240160304
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160303,
					"content": "Ich war schon immer etwas außergewöhnlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160306
					]
				},
				{
					"id": 240160306,
					"content": "#Vielen Dank noch einmal für deine Hilfe, {M#ehrenamtlicher Spitzenforscher}{F#ehrenamtliche Spitzenforscherin}. Bitte nimm diese!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160304,
					"content": "Ich habe ein gewisses Geschick beim Aufräumen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160305
					]
				},
				{
					"id": 240160305,
					"content": "#Echt? Du bist wirklich vielseitig talentiert. Wie es sich für {M#den ehrenamtlichen Spitzenforscher}{F#die ehrenamtliche Spitzenforscherin} gehört!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160306
					],
					"speakerTitle": "Chalmet"
				}
			]
		},
