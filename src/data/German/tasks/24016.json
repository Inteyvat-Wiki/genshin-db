			"dialogs": [
				{
					"id": 240160401,
					"content": "Puh ... Ich danke dir für deine Hilfe. Ich weiß nicht, wie lange ich ohne deine Hilfe gebraucht hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160402
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160402,
					"content": "Es wäre allerdings besser, wenn du beim Helfen etwas weniger Kraft anwenden könntest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160403,
						240160404
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160403,
					"content": "Es tut mir leid ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				},
				{
					"id": 240160405,
					"content": "Versteh mich nicht falsch! Ich mache dir keine Vorwürfe, du hast mir schon sehr geholfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160406
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160406,
					"content": "#Das ist für dich. Danke für deine Hilfe, {M#ehrenamtlicher Spitzenforscher}{F#ehrenamtliche Spitzenforscherin}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160404,
					"content": "Nächstes Mal werde ich etwas sanfter sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				}
			]
		}
	]
