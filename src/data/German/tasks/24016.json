							3944.917
						],
						"pointId": 6694
					}
				]
			},
			"dialogs": [
				{
					"id": 240160101,
					"content": "Das wäre fast alles ... Ich hoffe, diese Akten sind wirklich nützlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160102,
					"content": "Du bist immer noch hier und sortierst die Akten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160103
					]
				},
				{
					"id": 240160103,
					"content": "#Oha! Ich freue mich, dich zu sehen, {M#ehrenamtlicher Spitzenforscher}{F#ehrenamtliche Spitzenforscherin}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160104,
					"content": "Ja, wie von Herrn Raimondo angeordnet, bin ich immer noch dabei, die Daten und Akten zu ordnen ... Halt, habe ich das nicht vorhin schon gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160105,
					"content": "Dieser Ort ist ganz schön groß! Es ist zu anstrengend für dich, allein zu arbeiten. Warum hat Raimondo niemanden geschickt, der dir helfen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160106,
					"content": "Das Forschungsinstitut hat im Moment viel zu tun. Da ist es verständlich, dass niemand zur Hilfe geschickt werden könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160107
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160107,
					"content": "Dein Titel als „Leiterin“ hilft wohl auch kaum weiter ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160108
					]
				},
				{
					"id": 240160108,
					"content": "Du meinst „Leiterin der Materialrückgewinnung des Forschungsinstituts Fontaine“? *seufz* Bitte, mach dich nicht über mich lustig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160109
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160109,
					"content": "Ich war überhaupt keine „Leiterin“. Von Anfang an war ich nur eine normale Angestellte und für die Sortierung der Akten zuständig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160110,
					"content": "Nachdem ich von Herrn Raimondo hierhergeschickt worden war, um die Akten zu sortieren, gab man mir plötzlich diesen Titel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160111
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160111,
					"content": "Mir wurde gesagt, dass Herr Choiseul darum gebeten hat, weil er glaubt, dass unsere Arbeit sehr hart ist und dass das hauptsächlich geschieht, um es uns zu erleichtern, mehr Zuschüsse zu bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160112,
					"content": "Ach! Erzählt bitte es niemandem. Wie ... Wie konnte ich euch das bloß erzählen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160113,
					"content": "Mach dir keine Sorgen, ich werde es niemandem sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160114
					]
				},
				{
					"id": 240160114,
					"content": "Das klingt doch nach einer guten Sache. Es spricht nichts dagegen, dass Leute, die hart arbeiten, mehr verdienen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160115,
					"content": "Aber warum muss es so auf Umwegen geschehen? Wäre es nicht besser, die Vergütung direkt an alle zu zahlen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160116,
						240160117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160116,
					"content": "Im Forschungsinstitut ist das doch normal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				},
				{
					"id": 240160118,
					"content": "Ach, ich kann leider nicht verstehen, was Herr Choiseul und Herr Raimondo denken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160119,
					"content": "Wie auch immer, ich muss weiterarbeiten. Es gibt noch viel zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160120
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160120,
					"content": "#{M#Ehrenamtlicher Spitzenforscher}{F#Ehrenamtliche Spitzenforscherin}, wenn du willst, könntest du mir helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160121,
						240160122
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160121,
					"content": "Natürlich habe ich keinen Grund, mich zu weigern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160124
					]
				},
				{
					"id": 240160124,
					"content": "Dann hilf mir bitte, die Flecken ringsumher zu reinigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160125
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160125,
					"content": "Bitte versuche beim Saubermachen auch, <color=#00E1FFFF>die Akten daneben nicht zu berühren</color>. Es wäre eine Bescherung, wenn sie schmutzig werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160126
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160126,
					"content": "Dann überlasse ich das dir. Ich muss die Akten hier weiter sortieren. Ich wusste nicht, dass es so viele Akten im Institut gibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160122,
					"content": "Das fügt meinen Verdiensten eine weitere Leistung hinzu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160123
					]
				},
				{
					"id": 240160123,
					"content": "Haha, klar, ich werde deine Gutmütigkeit bezeugen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160124
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160117,
					"content": "Solange du tatsächlich das Geld erhalten kannst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				}
			]
		},
