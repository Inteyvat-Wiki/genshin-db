					}
				]
			},
			"dialogs": [
				{
					"id": 762010201,
					"content": "... Metta, du bist gemein. Ich wollte doch nur, dass du beim Abenteuer Spaß hast. Warum musst du so was sagen und mir die Laune verderben? Uuuh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010202
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010202,
					"content": "Wenn du deine Angewohnheit, ständig deiner Laune nach zu handeln, nicht ablegst, werden die anderen dich auch nicht mehr aushalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010203
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010203,
					"content": "Das ist doch keine Laune, ich ... ich habe auch meine eigenen Pläne ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010204
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010204,
					"content": "Pläne also ... Hm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010205
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010205,
					"content": "Du nimmst mich schon wieder nicht ernst ... Ich rede nie wieder mit dir! Bereuen hilft dir später auch nichts mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010206
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010206,
					"content": "... Ah, Linnea! Hör mir zu, Metta, sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010207
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010207,
					"content": "Du hörst Vesa zu, wie er stockend erzählt, was passiert ist. Es schien nur ein gewöhnlicher kleiner Streit unter Kindern zu sein ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762010208
					]
				},
				{
					"id": 762010208,
					"content": "Egal wie man es dreht und wendet, ich bin nicht schuld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010209
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010209,
					"content": "Dann ... Dann habe ich auch nichts falsch gemacht! Linnea ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010210
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010210,
					"content": "Hm ... Manchmal passieren solche Dinge tatsächlich. Obwohl niemand einen Fehler gemacht hat, ist das Ergebnis leider enttäuschend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010211
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010211,
					"content": "Richtig, so wie die Geschichte der Schwestern der Nachkommen des Frostmonds, für die die Nachtschattenblume steht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010212
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010212,
					"content": "Die Geschichte der Schwestern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010213
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010213,
					"content": "Nun, es heißt, unter den Nachkommen des Frostmonds gab es einst zwei Schwestern. Sie waren grundverschieden, wie eine rote und eine blaue Nachtschattenblume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010214
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010214,
					"content": "Die beiden Schwestern taten, was sie jeweils für richtig hielten, doch genau deswegen trennten sich ihre Wege.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010215
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010215,
					"content": "Es heißt, die kleine Schwester habe ihrer großen Schwester nie verziehen, dass sie sie verlassen hat. Obwohl die große Schwester danach viele Leben gerettet hat ... haben sich die beiden bis zu ihrem Tod nie wiedergesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010216
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010216,
					"content": "Über die Nachkommen des Frostmonds existieren also auch noch solche Geschichten ... Davon habe ich noch nie gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010217
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010217,
					"content": "Ich auch nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010218
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010218,
					"content": "Ich habe sie auch nur von einem Barden gehört, vielleicht ist einiges davon etwas ausgeschmückt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010219
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010219,
					"content": "Oh, die Geschichte ist also erfunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010220
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010220,
					"content": "Ach komm schon. Selbst wenn die Geschichte erfunden ist, so stimmt die Moral doch trotzdem, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010221
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010221,
					"content": "Keine von beiden sah sich im Unrecht. Beide waren fest davon überzeugt, dass ihre Entscheidung richtig war. Doch ihre Entscheidungen führten auch dazu, dass sie einander für immer verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010222
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010222,
					"content": "Wenn ihr, um zu beweisen, dass ihr recht habt, einen Freund verlieren müsstet ... wie würdet ihr euch entscheiden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010223
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010224
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010224,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010225
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010225,
					"content": "Hach, eigentlich sind so kleine, spontane Zwischenfälle auf einem Abenteuer auch nicht schlecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010226
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010226,
					"content": "... Ja! Wenn ich es mir recht überlege, ist die Zeit, die du für unsere Abenteuer hast, sehr kostbar. Wenn ich meine Ideen ständig ändere, erleben wir am Ende vielleicht gar nichts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010227
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010227,
					"content": "Nächstes Mal ... Nächstes Mal werde ich es besser planen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010228
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010228,
					"content": "Hehe, es ist wirklich das Beste, wenn ihr euch wieder vertragt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010229
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010229,
					"content": "Wenn ich später mit Vesa auf Abenteuer gehe und wir ungewöhnliche Steine finden, bringen wir sie zum „Speranza“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010230
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010230,
					"content": "Super! Dann danke ich euch schon mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
