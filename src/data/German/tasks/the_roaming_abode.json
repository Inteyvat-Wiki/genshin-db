			"dialogs": [
				{
					"id": 711050101,
					"content": "Opa ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050102
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050102,
					"content": "Hä? Kleine Freundin, was machst du so spät hier allein? Wie heißt du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050103,
					"content": "Ich bin Xiangjun ... Ich suche meinen Opa ... Mein Opa wurde von einem Monster entführt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050104
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050104,
					"content": "Mo... Monster? Hier gibt es Monster? Was für Monster?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050105,
					"content": "Ich ... Ich weiß es auch nicht ... Opa hat das gesagt. Er sagte, dass es in den Bergen Monster gäbe ... Deshalb sollte ich mich nicht herumtreiben ... Aber er ist schon seit drei Tagen in den Bergen verschwunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050106
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050106,
					"content": "Um dir Angst zu machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050107
					]
				},
				{
					"id": 711050107,
					"content": "Das glaubt Paimon auch ... Was wollte er denn in den Bergen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050108,
					"content": "Opa ist der Kräutersammler des Dorfes. Jetzt wollte er Adeptenkräuter sammeln. Es heißt, sie müssen mit gesegnetem Wasser vom Berg Xuanlian gegossen werden, um zu wachsen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050109
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050109,
					"content": "Also ... ist er an ein Monster geraten, das das gesegnete Wasser bewacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050110
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050110,
					"content": "Kleine Xiangjun, mach dir keine Sorgen. Es ist schon spät, vielleicht ist deinem Opa nur etwas dazwischengekommen. Wir bringen dich erst einmal nach Hause, einverstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050111,
					"content": "Aber ich muss Opa retten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050112
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050112,
					"content": "Wir können dir helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050113
					]
				},
				{
					"id": 711050113,
					"content": "Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050114
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050114,
					"content": "Genau! Wenn du nicht nach Hause gehst, wird sich dein Opa nur noch mehr sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050115,
					"content": "Oh ... Ich möchte Opa keine Sorgen bereiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050116
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050116,
					"content": "Also werden wir ihn suchen. Wo ist denn dein Zuhause? Wir bringen dich nach Hause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050117,
					"content": "Es ist sehr lieb von euch, aber ich wohne in Qiaoying, ich kann alleine zurückgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050118
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050118,
					"content": "Könntet ihr meinen Opa schnell finden? Ich habe Angst, dass er in Gefahr sein könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050119
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050119,
					"content": "Wir haben jetzt nichts zu tun. Also ... Weißt du, wo genau dein Opa hingegangen ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050120,
					"content": "Ich weiß nur, dass er in diese Richtung gegangen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050121
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050121,
					"content": "Dann gehen wir zuerst dort nachsehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050122
					]
				},
				{
					"id": 711050122,
					"content": "Danke! Dann gehe ich jetzt nach Hause, ich möchte nicht, dass sich alle Sorgen machen ... Ich werde brav im Dorf auf gute Nachrichten warten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 7110502,
			"completionStepIds": [
				7110502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110502",
