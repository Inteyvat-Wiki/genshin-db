					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050501,
					"content": "„... Ich hatte zwar schon immer Angst vor Monstern ... Aber ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050502
					],
					"speakerTitle": "Jemandes Notizen"
				},
				{
					"id": 711050502,
					"content": "„... So viel ... geflossen ... Meine Beine ... Es hört einfach nicht auf ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050503
					],
					"speakerTitle": "Jemandes Notizen"
				},
				{
					"id": 711050503,
					"content": "„... Ich bin so müde ... Aber dort vorn ist der Berg Xuanlian ... Xiangjun ... Ich werde das gesegnete Wasser auf jeden Fall holen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050504
					],
					"speakerTitle": "Jemandes Notizen"
				},
				{
					"id": 711050504,
					"content": "„... Xiangjun ... Ich werde das gesegnete Wasser auf jeden Fall holen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050505
					],
					"speakerTitle": "Jemandes Notizen"
				},
				{
					"id": 711050505,
					"content": "Oh nein ... Er wurde von einem Monster angegriffen und schwer verletzt ... Und er konnte in diesem Zustand immer noch zum Berg Xuanlian gehen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050506,
					"content": "Wir sollten uns beeilen, hoffentlich können wir ihm helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
