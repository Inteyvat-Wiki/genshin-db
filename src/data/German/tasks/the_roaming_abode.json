			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050201,
					"content": "„Ich habe verschlafen! Ich muss nach Hause kommen, bevor es morgen wird, sonst passt niemand auf Xiangjun auf ... Ich bin so dumm ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050202
					],
					"speakerTitle": "Jemandes Notizen"
				},
				{
					"id": 711050202,
					"content": "„Ich erinnere mich, dass ein Pfad vom Yaodie-Tal zum Berg Xuanlian führt ... Nach dem Pfad noch durch eine Höhle, dann bin ich da ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050203
					],
					"speakerTitle": "Jemandes Notizen"
				},
				{
					"id": 711050203,
					"content": "„Ich habe gehört, dass es in der Gegend Monster gäbe, aber ich muss jetzt eine Abkürzung versuchen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050204
					],
					"speakerTitle": "Jemandes Notizen"
				},
				{
					"id": 711050204,
					"content": "Das scheint der Opa zurückgelassen zu haben? Er hat den Pfad genommen! Wir sollten auch dort nachsehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110505,
			"completionStepIds": [
				7110505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110505",
							"2"
						],
