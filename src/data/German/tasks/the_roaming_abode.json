			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Onkel Luo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711051101,
					"content": "Wenn es euch nichts ausmacht, gehe ich jetzt. Wenn ihr wollt, könnt ihr euch ja selbst umsehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051102
					],
					"speakerTitle": "Onkel Luo"
				},
				{
					"id": 711051102,
					"content": "Also gibt es wirklich keine Xiangjun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711051103,
					"content": "Ich werde mich für euch umhören, vielleicht war es ja ein kleines Wirrköpfchen, das sein Heimatdorf verwechselt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051104
					],
					"speakerTitle": "Onkel Luo"
				},
				{
					"id": 711051104,
					"content": "Danke, dass ihr den Weg auf euch genommen habt und die Kräuter für den „Adepten“ gegossen habt. Wenn er das erfährt, wird er euch dankbar sein und euch vor Unglück bewahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Onkel Luo"
				}
			]
		}
	]
}