				]
			},
			"dialogs": [
				{
					"id": 711050601,
					"content": "Hä? Sollte es hier sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050602,
					"content": "Warum ist hier niemand? Und es gibt auch keine Spuren in der Nähe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050603,
					"content": "Ist er vielleicht schon zurückgegangen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050604
					]
				},
				{
					"id": 711050604,
					"content": "Das kann sich Paimon nicht vorstellen, Xiangjuns Opa ist verletzt, dann soll er noch so weit laufen können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050605,
					"content": "Aber er ist auch nicht in der Nähe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050606
					]
				},
				{
					"id": 711050606,
					"content": "Könnte er unterwegs jemandem begegnet sein, der ihn nach Hause gebracht hat? Das hält Paimon für wahrscheinlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050607,
					"content": "Wollen wir nach Qiaoying zurückgehen und fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050608,
					"content": "Holen wir zuerst etwas „gesegnetes Wasser“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050609
					]
				},
				{
					"id": 711050609,
					"content": "Gesegnetes Wasser? Ach ja ... Du hast recht, wenn der Opa wirklich gerettet wurde, dann wird er es bestimmt brauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050610,
					"content": "#So können wir nebenbei noch helfen. Hehe, {NICKNAME}, du denkst wirklich mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110508,
			"completionStepIds": [
				7110508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110508",
							"2"
						],
						"stepId": 7110508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Onkel Luo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050801,
					"content": "Oh ... Die Reisenden, ihr seht aus, als hättet ihr Schwierigkeiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050802
					],
					"speakerTitle": "Onkel Luo"
				},
				{
					"id": 711050802,
					"content": "Wir ... Onkel Luo, weißt du, wo Xiangjun und ihr Opa wohnen? Wir suchen nach ihnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050803,
					"content": "Xiangjun? Von der habe ich noch nie gehört, ist sie von hier? Ich als alter Mann sollte alle Leute aus dem Dorf kennen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050804
					],
					"speakerTitle": "Onkel Luo"
				},
				{
					"id": 711050804,
					"content": "Nie von ihr gehört? Unmöglich ... Wir sind draußen einem Mädchen begegnet, es sagte, es heiße Xiangjun und sie wohne in Qiaoying. Sie hat uns gebeten, ihren Opa zu suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050805,
					"content": "Sie hatte auch ein großes Bambusfloß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050806,
					"content": "Hm ... Ein Bambusfloß sieht man häufiger, aber der Name Xiangjun ... Ich versichere euch, dass im Dorf niemand so heißt. Wisst ihr denn, wie ihr Opa heißt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050807
					],
					"speakerTitle": "Onkel Luo"
				},
				{
					"id": 711050807,
					"content": "Ihr Opa ist Kräutersammler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050808
					]
				},
				{
					"id": 711050808,
					"content": "Kräutersammler? Lasst mich überlegen. Es gab im Dorf tatsächlich einen Kräutersammler ... Aber er ist schon vor drei Jahren von uns gegangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050809
					],
					"speakerTitle": "Onkel Luo"
				},
				{
					"id": 711050809,
					"content": "Von uns gegangen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050810,
					"content": "Er ist draußen einem Monster begegnet ... *seufz* ... Aber er ist sicher nicht derjenige, den ihr sucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050811
					],
					"speakerTitle": "Onkel Luo"
				},
				{
					"id": 711050811,
					"content": "Dieser Kräutersammler war nämlich ein bisschen verrückt und hat niemals eine Familie gegründet, also hat er auch keine Nachkommen gehabt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050812
					],
					"speakerTitle": "Onkel Luo"
				},
				{
					"id": 711050812,
					"content": "Was ... Was geht hier eigentlich vor? Diese Xiangjun, der wir begegnet sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050813,
					"content": "Sie wird doch nicht das Monster sein!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050814,
					"content": "Welche Kräuter hatte der Kräutersammler des Dorfes denn gesammelt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050815
					]
				},
				{
					"id": 711050815,
					"content": "Das waren alles Pflanzen, die ich nicht kenne. Ich verstehe nur ein bisschen von Tee, von diesem Zeug hab ich keine Ahnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050816
					],
					"speakerTitle": "Onkel Luo"
				},
				{
					"id": 711050816,
					"content": "Aber ich kann mich daran erinnern, dass wir ihn nach seinem Unglück in der Nähe des Berges Xuanlian gefunden haben. Er hielt damals noch eine Flasche mit Wasser in seinen Händen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050817
					],
					"speakerTitle": "Onkel Luo"
				},
				{
					"id": 711050817,
					"content": "Er sagte, in seinem Hof wüchse ein Büschel Adeptenkräuter, welche dieses gesegnete Wasser zum Überleben bräuchten. Ich konnte sehen, dass er richtig verwirrt war, es war doch nur Wasser aus dem Fluss, was sollte daran denn besonders gewesen sein? Und dafür hatte er sein Leben riskiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050818
					],
					"speakerTitle": "Onkel Luo"
				},
				{
					"id": 711050818,
					"content": "Hm ... Man soll die Toten respektieren, also haben wir sein Wasser nach seiner Beerdigung in seinem Hof vergossen, damit er beruhigt gehen konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050819
					],
					"speakerTitle": "Onkel Luo"
				},
				{
					"id": 711050819,
					"content": "Gesegnetes Wasser vom Berg Xuanlian? Wir waren auch dort und haben gesegnetes Wasser mitgenommen ... Dieser Kräutersammler ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050820,
					"content": "Ich glaube, er war diese Person.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050821
					]
				},
				{
					"id": 711050821,
					"content": "Das ist wirklich seltsam. Warum ... kommt ihr nicht mit mir mit, ich zeige euch seinen Hof.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050822
					],
					"speakerTitle": "Onkel Luo"
				},
				{
					"id": 711050822,
					"content": "Wenn ihr auch etwas von dem Wasser habt, könnt ihr es ja in seinem Hof ausgießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Onkel Luo"
				}
			]
		},
		{
			"id": 7110511,
			"completionStepIds": [
				7110511
			],
			"beginWay": "TALK_BEGIN_MANUAL",
