					"nextDialogs": [
						700090807
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090807,
					"content": "Lily hat ihn selbst zubereitet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090808
					]
				},
				{
					"id": 700090808,
					"content": "Der sieht aus wie ... Eigentlich sieht er ziemlich lecker aus! Wer hätte gedacht, dass du das kannst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090809
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090809,
					"content": "Hehe, das hat Mama mir beigebracht! Wenn du aufgegessen hast, kannst du mir noch mehr Geschichten erzählen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090810
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090810,
					"content": "Du willst immer noch meine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090811
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090811,
					"content": "Na schön. Da du mir etwas geschenkt hast, erzähle ich dir noch ein paar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090812
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090812,
					"content": "Juhu! Dann erzähl mir von ... den Fettui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090813
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090813,
					"content": "Mist! Das ... Das wird nicht reichen ... Das ist zu langweilig, ich muss mir etwas Spannenderes ausdenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
