			"dialogs": [
				{
					"id": 700091001,
					"content": "Dir scheint die Plauderei mit der Kleinen viel Freude bereitet zu haben. Ich habe übrigens alles gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700091002
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700091002,
					"content": "Und, was meinst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700091003
					]
				},
				{
					"id": 700091003,
					"content": "Es sind Kinderträume. So oder so fällt mir dazu nichts ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700091004
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700091004,
					"content": "Ließe die Welt sich so leicht in Gut und Böse trennen, dann wäre vieles ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700091005
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700091005,
					"content": "Egal. Ich sag nichts mehr. Geh mit ihr spielen.",
