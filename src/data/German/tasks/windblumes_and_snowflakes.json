				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lily"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090201,
					"content": "Warum kann dieser Herr Fettui nicht zum Schwindkrumenfest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090202,
						700090204
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090202,
					"content": "Er hat wichtige Aufgaben zu erledigen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090203
					]
				},
				{
					"id": 700090203,
					"content": "Nichtige Aufgaben? Noch nichtiger als das Schwindkrumenfest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090207,
					"content": "Aber auch wenn dieser Fettui viel Böses getan hat, kann er gut werden, wenn er sich bessert, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090208
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090208,
					"content": "Ich werde ihm sagen, dass er beim Schwindkrumenfest mitmachen kann, wenn er in Zukunft gut ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090209
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090209,
					"content": "Er ist gerade sehr beschäftigt. Lass uns zuerst draußen spielen, in Ordnung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090210
					]
				},
				{
					"id": 700090210,
					"content": "Oh ... na gut. Gehst du dann mit mir spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090211
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090211,
					"content": "Klar ... aber wir gehen nicht zu weit weg, ja?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090212
					]
				},
				{
					"id": 700090212,
					"content": "Juhu! Los geht’s, los geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090204,
					"content": "Die Fatui können beim Windblumenfest nicht mitmachen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090205
					]
				},
				{
					"id": 700090205,
					"content": "Warum nicht? Weil die Fettui ganz doll böse sind? Papa meint, sie putzen sich vorm Schlafengehen nicht die Zähne und essen mit den Händen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090206
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090206,
					"content": "Hmm ... dann sind sie wohl böse. Der Papa dieses Fettui ist sicher auch böse ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090207
					],
					"speakerTitle": "Lily"
				}
			]
		},
		{
			"id": 7000903,
			"completionStepIds": [
				7000906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000906",
							"2"
						],
						"stepId": 7000906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Blanche"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090302,
					"content": "#{F#Reisende}{M#Reisender}? Was kann ich für dich tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090303
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090303,
					"content": "Und ... bist du das, Lily? Was machst du hier? Wo sind deine Eltern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090304
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090304,
					"content": "#Papa und Mama sind mit etwas wirklich Nichtigem beschäftigt! Darum spielt {F#sie}{M#er} mit mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090305
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090305,
					"content": "Etwas wirklich Wichtigem? Ah, Rudolf und Jilliana ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090306
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090306,
					"content": "Große Schwester, was ist mit den Welpen passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090307
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090307,
					"content": "Oh, die Welpen? Da bin ich mir selbst nicht sicher. Für gewöhnlich bleiben sie in ihrer Hütte und kommen nur raus, wenn ich Futter in ihre Schüssel schütte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090308
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090308,
					"content": "Vielleicht hat all der Lärm sie aufgeschreckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090309
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090309,
					"content": "Willst du mit ihnen spielen, Lily?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090310
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090310,
					"content": "Ja! Will ich! Ich will mit ihnen spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090311
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090311,
					"content": "Mal überlegen. Ich glaube nicht, dass wir sie einfach so finden ... Vielleicht solltest du etwas Futter in diese Schüssel schütten. Das könnte sie anlocken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090312
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090312,
					"content": "Rohes Geflügel sollte sich dafür am besten eigenen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090313
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090313,
					"content": "Wie? Aber wo sollen wir das herkriegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090314
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090314,
					"content": "Ich kann mich darum kümmern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090315
