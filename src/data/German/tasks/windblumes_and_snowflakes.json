					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090703
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090703,
					"content": "Fertig! Hier sind drei Eierkuchen. Einer für dich, einer für mich und einer für Herrn Fettui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090704
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090704,
					"content": "Gut, gehen wir zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lily"
