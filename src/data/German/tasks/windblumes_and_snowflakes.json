				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090401,
					"content": "Kommt, Welpen, wir haben leckeres Fressen für euch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090402
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090402,
					"content": "Oooh! Da sind sie, da sind sie! Ich will sie streicheln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090403
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090403,
					"content": "Oh, wie flauschig weich sie sind. Der Herr Fettui meinte, dass er zu Hause auch viele Welpen hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090404
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090404,
					"content": "Doch er sagte, seine Welpen sind riesig groß und haben ganz viel Fell. Bestimmt kann man die gut streicheln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lily"
				}
			]
		},
		{
			"id": 7000905,
			"completionStepIds": [
				7000910
