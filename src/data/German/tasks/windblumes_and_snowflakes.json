			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090101,
					"content": "Feiert ihr Fettui das Schwindkrumenfest nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090102
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090102,
					"content": "Ich, äh, glaube nicht ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090103
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090103,
					"content": "Was führst du im Schilde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090104
					]
				},
				{
					"id": 700090104,
					"content": "Ich? Oh, du bist es? Komm schon, warum guckst du mich schon wieder so schief an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090105,
					"content": "Ich habe mich bloß mit der Kleinen unterhalten. Ich hatte nichts Böses vor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090106,
					"content": "Ihr Fatui feiert das Windblumenfest wirklich nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090107
					]
				},
				{
					"id": 700090107,
					"content": "Und was ist mit dir? Willst du dich nicht beim Schwindkrumenfest amüsieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090108
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090108,
					"content": "#Nun, wir reden hier {F#von der Ehrenritterin}{M#vom Ehrenritter} Mondstadts. Sicher gibt es genug zu tun, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090109,
					"content": "Wie eingebildet ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090110
					]
				},
				{
					"id": 700090110,
					"content": "*hust* Es ist nichts. Apropos nichts ... Wenn du nichts zu tun hast, könntest du mir rasch einen Gefallen erweisen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090111,
					"content": "Die Eltern dieser Kleinen hier sind während des Fests einkaufen gegangen, also passen die Ordensschwestern auf sie auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090112,
					"content": "Doch wie du weißt, sind während des Fests alle mit irgendetwas beschäftigt, sogar die Schwestern. Ihnen fehlt die Zeit, mit der Kleinen zu spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090113,
					"content": "Und darum ist sie nun bei mir. Doch wie du weißt, kann ich die Kathedrale nicht verlassen. Bei mir langweilt sie sich bloß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090114
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090114,
					"content": "Selbst während so eines Festes bin ich in den Blicken dieser Schwester da drüben ausgesetzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090115
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090115,
					"content": "Bestimmt fragt sie sich, was dieser „üble Fatui-Intrigant schon wieder ausheckt“, oder so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090116,
					"content": "Hmpf. Um mich dieser Schwester zu entledigen und für das Wohlergehen des Kindes zu sorgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090117
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090117,
					"content": "#Würde {F#unsere ruhmreiche Ehrenritterin}{M#unser ruhmreicher Ehrenritter} sich dazu herablassen, mit diesem Kind spielen zu gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090118,
						700090122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090118,
					"content": "Schon gut, schon gut, ich hab es kapiert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090119
					]
				},
				{
					"id": 700090119,
					"content": "#Oho, wie direkt. Aber schließlich bist du {F#die Ehrenritterin}{M#der Ehrenritter}! Wie töricht von mir, zu denken, du würdest um einen Lohn dafür schachern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090120
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090120,
					"content": "Komm schon, nimm das Kind einfach mit. Ich bleibe solange hier und lasse mich von den Blicken dieser Schwestern aufspießen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090121,
					"content": "*seufz* Wann nimmt das endlich ein Ende?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090122,
					"content": "Oh, du willst bloß, dass sie draußen spielen kann, wie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090123
					]
				},
				{
					"id": 700090123,
					"content": "Du ... argh, egal. Ich bin ein Fatuus. Wir sind die Bösen, verstanden? Werd nicht rührselig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090124,
					"content": "Husch ... sieh zu und geh mit Kind spielen. Hier geht sie mir bloß auf die Nerven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090125
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090125,
					"content": "Ich bleibe ... solange hier und lasse mich von den Blicken dieser Schwestern aufspießen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090126
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 700090126,
					"content": "*seufz* Wann nimmt das endlich ein Ende?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 7000902,
			"completionStepIds": [
				7000904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
