			},
			"dialogs": [
				{
					"id": 700090602,
					"content": "Hehe. Wie geht’s? Wollt ihr Blumen kaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090603
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090603,
					"content": "Oh, es gibt so viele ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090604
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090604,
					"content": "#Hmm, Lily? Warum bist du mit {F#der Reisenden}{M#dem Reisenden} unterwegs?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090605
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090605,
					"content": "#Papa und Mama sind mit etwas wirklich Nichtigem beschäftigt! Darum spielt {F#sie}{M#er} mit mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090606
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090606,
					"content": "Wichtige Dinge, was? Nun, ich kann mir schon vorstellen, was das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090607
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090607,
					"content": "Wie dem auch sei, kann ich euch beiden helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090608
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090608,
					"content": "Wir wollen uns nur die Blumen angucken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090609
					]
				},
				{
					"id": 700090609,
					"content": "Nur angucken? Hmm, wie wäre es dann mit diesem Löwenzahn? Hier, Lily, der ist für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090610
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090610,
					"content": "Wirklich? Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090611
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090611,
					"content": "Das war unerwartet ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090612
					]
				},
				{
					"id": 700090612,
					"content": "Nun, tatsächlich hat Rudolf einen großen Blumenstrauß für Jilliana bestellt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090613
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090613,
					"content": "Da fällt ein Löwenzahn aufs Haus nicht so ins Gewicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090614
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700090614,
					"content": "Dieser Löfenzahn ist so schön ... Aber ich muss nach Hause, sonst machen Papa und Mama sich Sorgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090615
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090615,
					"content": "Warte. Bevor wir zurückgehen ... Weißt du, wo es eine große Pfanne gibt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090616
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090616,
					"content": "Einmal hat Mama Eierkuchen für mich gemacht und ich will dir auch welche machen, weil du mit mir gespielt hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lily"
				}
			]
		},
