				"objectNames": [
					"Blanche"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700090502,
					"content": "#Ah, Lily, {F#Reisende}{M#Reisender}, ihr seid zurück. Habt ihr die Welpen gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090503
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090503,
					"content": "Jap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090504
					]
				},
				{
					"id": 700090504,
					"content": "Haben wir! Danke, liebe Tante! Es hat so viel Spaß gemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090505
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090505,
					"content": "Schön. Oh, richtig, falls ihr beiden Zeit habt, könntet ihr Flora einen Besuch abstatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090506
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090506,
					"content": "Und wenn ihr schon dabei seid, könnt ihr gleich einen Blumenstrauß mitbringen. Schließlich haben wir gerade das Windblumenfest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090507
					],
					"speakerTitle": "Blanche"
				},
				{
					"id": 700090507,
					"content": "Ooh ... stimmt! Ich will hingehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700090508
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 700090508,
					"content": "Sag nichts mehr, lass uns aufbrechen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700090509
					]
				},
				{
					"id": 700090509,
					"content": "Juhu! Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lily"
				}
			]
		},
