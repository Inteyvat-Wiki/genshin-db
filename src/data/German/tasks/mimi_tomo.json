			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700240101,
					"content": "#{F#Reisende}{M#Reisender}, bitte hier drüben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240102,
					"content": "Entschuldige, wenn ich einen Moment deiner Zeit in Anspruch nehmen darf. Wärest du daran interessiert, einen neue Mission anzunehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240103,
						700240104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240103,
					"content": "Es kann nicht schaden, mehr darüber zu erfahren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				},
				{
					"id": 700240105,
					"content": "Die Situation ist folgende. Jüngste Berichte der Gilde deuten darauf hin, dass die Hilichurle in freier Wildbahn wieder anfangen, sich zu versammeln und die Handelsroute zu stören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240106,
					"content": "Wir haben eine beträchtliche Anzahl von Abenteurern ausgesandt, um mehr in Erfahrung zu bringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240107,
					"content": "Sie alle haben von einem seltsamen Phänomen berichtet — dass, wann immer sie eine Gruppe von Hilichurlen entdecken, die sich versammeln, immer ein bestimmter ungewöhnlicher Hilichurl in ihrer Mitte ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240108,
					"content": "Wir glauben, dass dieser „merkwürdige Hilichurl“ eine Schlüsselrolle bei den jüngsten Störungen spielen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240114,
					"content": "Wir brauchen also jemanden, der den merkwürdigen Hilichurl einfängt oder zumindest verjagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240109,
					"content": "#{F#Reisende}{M#Reisender}, bist du daran interessiert, diese Mission anzunehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240110,
						700240111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240110,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240112,
					"content": "Dankeschön! Ich habe einige Standorte für dich auf deiner Karte markiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240113,
					"content": "In jedem dieser Gebiete wurde über Aktivitäten der Hilichurle berichtet. Bitte beginne deine Nachforschungen, indem du sie besuchst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240115,
					"content": "Solltest du dem merkwürdigen Hilichurl begegnen ... Sei bitte vorsichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700240111,
					"content": "Ich werde die Augen offenhalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240112
					]
				},
				{
					"id": 700240104,
					"content": "Um was für eine Mission handelt es sich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240105
					]
				}
			]
		},
		{
			"id": 7002402,
			"completionStepIds": [
				7002404
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002404",
							"2"
						],
						"stepId": 7002404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700240202,
					"content": "Das kann man wohl sagen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240203,
					"content": "Ist alles in Ordnung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240204
					]
				},
				{
					"id": 700240201,
					"content": "Puh ... Das war knapp. Gut, dass ihr gekommen seid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240202,
						700240203
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240204,
					"content": "*seufz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240205,
					"content": "Ich verstehe das nicht, es lief doch alles so gut ... Was habe ich denn gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240206
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240206,
					"content": "Na ja, jedenfalls ... Danke, dass du mich gerettet hast ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240207
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240207,
					"content": "Sie sieht wirklich verärgert aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700240208,
					"content": "Nun ... du hast gesehen, was passiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240223
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240223,
					"content": "Meine bisherige Strategie, auf eigene Faust zu versuchen, mit einem Hilichurl zu interagieren, ist offensichtlich zu riskant ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240209
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240210,
					"content": "Ich verstehe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240211,
					"content": "Kann ich etwas tun, um zu helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240212
					]
				},
				{
					"id": 700240209,
					"content": "Aber trotzdem ... Es ist eine Schande, dass eine goldene Gelegenheit, sich mit einem Hilichurl zu unterhalten, einfach vergeudet wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240210,
						700240211
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240212,
					"content": "Es sieht so aus, als ob meine Arbeit an der Vokabelsammlung für das Wörterbuch wieder einmal verschoben werden muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240224
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240213,
					"content": "Ich werde dir helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240214
					]
				},
				{
					"id": 700240224,
					"content": "Also werde ich stattdessen jemanden beauftragen, die Richtigkeit des Buchinhalts in meinem Namen zu überprüfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240213
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240214,
					"content": "I... Im Ernst? Das ist großartig! ... Genau, dann nimm dieses Buch unbedingt mit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240215
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240215,
					"content": "Boah ... Das war ein schneller Übergang vom Schmollen zum Herumkommandieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700240217,
					"content": "... Im Prinzip?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700240218
					]
				},
				{
					"id": 700240216,
					"content": "Solltest du auf Kommunikationsschwierigkeiten stoßen, könntest du diese ganz einfach mithilfe dieses Buches beheben ... Na ja, im Prinzip jedenfalls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240217
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240218,
					"content": "Du meinst, du weißt nicht einmal, was du in deinem eigenen Buch geschrieben hast!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700240219,
					"content": "Nur durch die Anwendung in der Praxis findest du heraus, wo die Probleme in deiner Forschung liegen! Wie soll ich, ohne sie auf Herz und Nieren zu prüfen, sicher sein, ob meine Theorien Bestand haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240225
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240225,
					"content": "Hmm ... Nee, egal, du würdest wahrscheinlich sowieso nicht verstehen, was ich sagen wollte. Aber davon abgesehen ... danke noch mal, dass du mich gerettet hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700240221,
					"content": "Willkommen in der Mannschaft!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240222,
					"content": "Da wir schon mal so weit gekommen sind ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 700240220,
					"content": "Wenn du nichts dagegen hast, schließe ich mich dir an, und wir machen uns jetzt auf die Suche nach einem Hilichurl, mit dem wir interagieren können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700240220,
						700240221
					],
					"speakerTitle": "Ella Musk"
				}
			]
		}
	]
}