			"dialogs": [
				{
					"id": 190361901,
					"content": "Hä? Bist du nicht auf der Suche nach dem nervenden Jungen Shikanoin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361902
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361902,
					"content": "Untersuchung? Wieso sollte ich seinen Schlamassel untersuchen? Hmpf! Mir ist es in der Stadt einfach zu langweilig, deswegen mache ich einen Spaziergang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361903
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361903,
					"content": "Gut, kümmere dich nicht um mich. Erledige weiter deine Aufgabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
