					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji",
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361401,
					"content": "#Was ist, wenn {F#die Reisende}{M#der Reisende} auch nicht verfügbar ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361402
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361402,
					"content": "Das ist dein Problem. Du bist doch selbst schuld, wenn du solch eine problematische Aufgabe eigenmächtig übernommen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361403
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361403,
					"content": "#Ach, du hast ja Glück. {F#Deine Retterin}{M#Dein Retter} ist da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361404
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361404,
					"content": "#Hm? Oh, perfekt! {F#Die Reisende}{M#Der Reisende} ist da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361405
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361405,
					"content": "Keine Sorge. Ich habe genug Zeit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361406
					]
				},
				{
					"id": 190361406,
					"content": "Wenn man vom Müßiggänger spricht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361407
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361407,
					"content": "Sango!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361408
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361408,
					"content": "#Verglichen mit {F#der Reisenden}{M#dem Reisenden} bist du eher eine Müßiggängerin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361409
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361409,
					"content": "Das stimmt aber nicht. Ich bin sehr beschäftigt. Es ist ziemlich anstrengend, hier zu stehen ... und zwar den ganzen Tag.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361410
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361410,
					"content": "Auch wenn es sich um eine Mission handelt, die du nicht annehmen willst, ist dieses Argument zu oberflächlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361411
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361411,
					"content": "Eine Mission, die du nicht annehmen willst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361412
					]
				},
				{
					"id": 190361412,
					"content": "Richtig ... Deshalb habe ich dich hierher eingeladen. Lass mich das im Detail erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361413
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361413,
					"content": "Neulich ist eine wichtige Person der Tenryou-Verwaltung verschwunden. Man kann ihn weder finden noch erreichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361414
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361414,
					"content": "Aus verschiedenen Gründen ist es für die Tenryou-Verwaltung unrealistisch, eine große Suchaktion zu starten. Deswegen haben sie uns heimlich gebeten, diese Person zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361415
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361415,
					"content": "Wie heißt die Person?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361416
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361416,
					"content": "Es ist Generalin Kujou Sara, die verschwunden ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361417
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361417,
					"content": "... Wenn die Generalin wirklich vermisst wäre, hätten sie die Stadt Inazuma schon längst auf den Kopf gestellt. Wäre es in diesem Fall überhaupt möglich, dass sie das nur uns anvertrauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361418
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361418,
					"content": "#{F#Reisende}{M#Reisender}, hör nicht auf den Unsinn von Sango. Tatsächlich heißt die vermisste Person Shikanoin Heizou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361419
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361419,
					"content": "Er ist ein Sonderermittler der Polizei. Obwohl sein Rang nur Doushin ist, hat er hervorragende Fähigkeiten. Deswegen wird er bei der Polizei sehr geschätzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361420
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361420,
					"content": "Ähm ... Noch fähiger als ich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361421
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361421,
					"content": "Sango, wenn du nicht helfen willst, solltest du zumindest keinen Ärger machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361422
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361422,
					"content": "#Tut mir leid, {F#Reisende}{M#Reisender}. Obwohl ich diesen Auftrag übernommen habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361423
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361423,
					"content": "Aber wie du siehst, hat Sango keine Lust, sich hier einzumischen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361424,
						190361425
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361424,
					"content": "Weil die Belohnung zu niedrig ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				},
				{
					"id": 190361426,
					"content": "Daneben! Null Punkte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361427
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361427,
					"content": "Wenn dich der Grund wirklich interessieren sollte ... Ich habe einfach keine Lust, mich um die Angelegenheiten dieses nervenden Jungen zu kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361428
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361428,
					"content": "Das einzige, was einen noch glücklicher machen könnte, als „Shikanoin ist verschwunden“, ist, „dass Shikanoin seit hundert Jahren verschwunden ist“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361429
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361429,
					"content": "Na ja ... Kurz gesagt, Fräulein Sango und Herr Heizou verstehen sich nicht wirklich gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361430
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361430,
					"content": "Ich verstehe ... Konflikte im Fachkreis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361431
					]
				},
				{
					"id": 190361431,
					"content": "Ähm ... nicht so ganz. Es ist wahrscheinlich noch viel schlimmer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361432
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361432,
					"content": "Sango sagte, dass Herr Heizou ihr Stolperstein zum Tempel der Wahrheit sei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361433
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361433,
					"content": "Wie ein bissiger Hund, der ständig im Weg war!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361434
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361434,
					"content": "Seufz ... Obwohl Herr Heizous Persönlichkeit tatsächlich ziemlich ... ähm ... eigenartig ist? Aber er ist definitiv ein guter Kerl. Er hat mir viel beigebracht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361435
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361435,
					"content": "#Selbst wenn Sango es nicht zulässt, kann ich nicht einfach wegschauen. Zumindest können wir diese Mission an einen Vertrauten weitergeben, wie zum Beispiel {F#die großartige Reisende}{M#den großartigen Reisenden}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361436,
						190361437
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361436,
					"content": "#Verstanden. Ich bin {F#die externe Auftragnehmerin}{M#der externe Auftragnehmer}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361438,
					"content": "Ach ... Nein, nein! Die Belohnung, die die Tenryou-Verwaltung versprochen hat, wird natürlich komplett bereitgestellt. Zusätzlich werde ich persönlich noch etwas draufschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361439
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361439,
					"content": "#Deswegen hoffe ich, dass du diese Mission übernimmst, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361440
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361440,
					"content": "Wenn Herr Heizou wirklich in Not geraten sollte, wäre es für ihn sicherer, dich an seiner Seite zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361441,
						190361445
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361441,
					"content": "Kennst du ihn sehr gut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361442
					]
				},
				{
					"id": 190361442,
					"content": "Tatsächlich haben wir eine sehr gute Beziehung. Aber Sango hat mich immer aufgefordert, Abstand zu ihm zu halten, und mir verboten, in der Öffentlichkeit zu zeigen, dass ich gut mit ihm befreundet bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361443
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361443,
					"content": "Wenn die Leute danach fragen, sage ich deswegen normalerweise nur, dass ich Herrn Shikanoin nur ein paar Mal getroffen habe. Wenn nicht so etwas wie heute passiert wäre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361444
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361444,
					"content": "*Hust* ... Ach, genug davon. Darf ich dich bitten, mir bei der Suche nach ihm zu helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361449,
					"content": "Verstanden. Ich werde gleich aufbrechen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361450
					]
				},
				{
					"id": 190361450,
					"content": "Gut, das ist alles. Bitte die Vollmacht der Polizei gut aufbewahren. Wenn du Herrn Heizou findest, meldest du dich direkt bei der Polizeistation der Tenryou-Verwaltung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361445,
					"content": "Kein Problem. Ich brauche aber mehr Informationen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361446
					]
				},
				{
					"id": 190361446,
					"content": "Sehr schön! Wir haben erfahren, dass Herr Heizou vor seinem Verschwinden sehr an Watatsumi interessiert war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361447
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361447,
					"content": "Während des Krieges scheint er Missionen in Watatsumi erledigt zu haben. Nach dem Krieg unternahm er auch häufig Reisen nach Watatsumi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361448
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361448,
					"content": "Ich habe gehört, dass du eine sehr gute Beziehung zu Sangonomiya hast. Ich glaube, wir könnten vielleicht von dort aus mit unseren Untersuchungen anfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361437,
					"content": "Verstanden. Ich bin euer Plan B.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361425,
					"content": "Weil die Hinweise zu wenig sind?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				}
			]
		},
		{
			"id": 1903615,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1903606",
							"2"
						],
						"stepId": 1903606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361501,
					"content": "#{F#Reisende}{M#Reisender}, ich bitte dich so schnell wie möglich loszulegen. Ich hoffe, dass Herr Heizou nicht in Gefahr ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361502
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361502,
					"content": "Erzähl mir bitte mehr über diesen Shikanoin Heizou.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361503
					]
				},
				{
					"id": 190361503,
					"content": "Herr Heizou? Er ist ein Mann voller Energie! Er redet viel, ist lebhaft und energisch. Ich habe ihn noch nie faul gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361504
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361504,
					"content": "Sango hat immer gesagt, er sei so lästig wie eine summende Fliege, vielleicht weil er jedes kaputte Ei aufspüren könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361505
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361505,
					"content": "Demnach ist Herr Heizou keine gewöhnliche Fliege, sondern eine fortgeschrittene Fliege!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361506
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361506,
					"content": "Selbst mit verstopfter Nase, verdeckten Augen und verdeckten Ohren kann er immer noch Risse in Eierschalen lokalisieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361507
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361507,
					"content": "Klingt erstaunlich, oder? Angeblich verlässt er sich auf etwas anderes als die fünf Sinne. Ist es der sechste Sinn? Intuition? Gottes Hilfe? Oder etwas anderes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361508,
						190361510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361508,
					"content": "Diese Beschreibung ist sehr ausgefallen. Beim nächsten Mal kannst du dich einfacher fassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361509
					]
				},
				{
					"id": 190361509,
					"content": "Oh ... Sango sagt immer, dass ich viel Unsinn erzähle. Ist das wirklich so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361510,
					"content": "Die Metaphern sind ziemlich schlecht. Aber irgendwie würde ich trotzdem gern mehr hören.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361511
					]
				},
				{
					"id": 190361511,
					"content": "Ähem ... Reden wir nächstes Mal weiter darüber ... Sango starrt uns an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 1903616,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1903606",
							"2"
						],
						"stepId": 1903606,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361601,
					"content": "Du bist noch hier! Könnte es sein, dass du deine Meinung geändert hast? Das wäre toll. Es ist nicht klug, sich mit diesem Typen einzulassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361602
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361602,
					"content": "Ich möchte wissen, was für einen Groll du gegen ihn hegst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361603
					]
				},
				{
					"id": 190361603,
					"content": "Meine Welt wird ihren endgültigen Frieden finden, wenn er für immer von uns geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361604
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361604,
					"content": "(Lächeln, um Höflichkeit zu zeigen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361605
					]
				},
				{
					"id": 190361605,
					"content": "Sieh mich nicht so an. Haha, man muss doch einige Erzrivalen haben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361606
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361606,
					"content": "Mach dich schnell auf den Weg, bevor Shikanoin großen Ärger verursacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361607
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361607,
					"content": "Warte. Wenn du wirklich versehentlich seinen Nachlass oder so findest, vergiss nicht, es mir zu sagen und mich glücklich zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 1903617,
			"completionStepIds": [
				1903606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
