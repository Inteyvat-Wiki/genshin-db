			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shibata"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361701,
					"content": "#Ah, du bist ... du bist {F#die Truppenführerin}{M#der Truppenführer} von Schwertfisch II! Ich bin Shibata und für die Bewachung dieses Ortes zuständig. Wie kann ich dir helfen, {F#Truppenführerin}{M#Truppenführer}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361702,
					"content": "Ich möchte mich nach jemandem erkundigen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361703
					]
				},
				{
					"id": 190361703,
					"content": "Du hast Shibata über die Mission informiert.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						190361704
					]
				},
				{
					"id": 190361704,
					"content": "Du meinst diesen jungen Detektiv? Den kenne ich. Shikanoin Heizou heißt er also? Er hing früher in der Nachbarschaft herum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361705,
					"content": "Ihre Exzellenz beauftragte mich damals sogar, ihn zu beobachten, weil sie sich Sorgen machte, dass er etwas Schlimmes tun würde. Aber später fand ich heraus, dass er hier eher Ausflüge machte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361706,
					"content": "Hmm ... Einige Leute haben ihn wohl kürzlich in der Gegend östlich des Sangonomiya-Schreins gesehen. Du kannst dort vorbeischauen, wenn du Lust hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shibata"
				}
			]
		},
