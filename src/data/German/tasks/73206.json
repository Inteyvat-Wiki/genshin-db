					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050501,
					"content": "♪ Rose, oh, Rose, mach meinen Wunsch wahr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050502
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050502,
					"content": "Oh? Ihr seid immer noch hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050503,
						732050513
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050503,
					"content": "Warum wohnst du hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050504
					]
				},
				{
					"id": 732050504,
					"content": "Hehe, jedenfalls bin ich ein komischer Kauz. „Komische Kauze haben keinen Grund für ihre Handlungen.“ Nur wenige Menschen fragen mich wie du.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050505,
					"content": "Ich wollte schon immer meine Heimat verlassen und nach einer Gelegenheit suchen, um etwas aus mir zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050506
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050506,
					"content": "Als ich noch nicht lange verheiratet war, wäre ich fast mit der Goldbrigade fortgegangen. Aber ich konnte meine Frau einfach nicht alleine zurücklassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050507
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050507,
					"content": "Später bin ich dann auf einen fahrenden Händler getroffen und ich habe mir überlegt, ihn zu begleiten, um Geschäfte zu machen, aber letztendlich ist dieses Vorhaben gescheitert, weil ich nicht genügend Finanzmittel hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050508
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050508,
					"content": "Als meine Frau starb, gab es nichts mehr, was mich hier gehalten hätte, aber da war ich schon zu alt, um wegzugehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050509
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050509,
					"content": "Ich habe meine Zeit bis zum heutigen Tag verbummelt und zu viele Dinge verpasst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050510
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050510,
					"content": "Und wenn ich zurückblicke, wird mir klar, dass ich weder zu diesem Dorf noch zu einem anderen Ort gehöre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050511
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050511,
					"content": "Erst als ich dann am Ende alleine das Dorf verlassen habe und in die nähere Umgebung gezogen bin, habe ich mich wohlgefühlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050512
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050512,
					"content": "Und so sind die Jahrzehnte ins Land gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050525,
					"content": "Wenn die Blumen erblühen, solltet ihr vorbeikommen, um euch das anzusehen. Morgen oder übermorgen wird es wohl so weit sein, habt ihr Zeit, dann vorbeizuschauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050526
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050526,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050527
					]
				},
				{
					"id": 732050527,
					"content": "Gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050528
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050528,
					"content": "♪ Rose, oh, Rose, mach meinen Wunsch wahr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050513,
					"content": "Über den Scheusalsgreis ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050514
					]
				},
				{
					"id": 732050514,
					"content": "Nur Leute von außerhalb würden sich nach der Sache mit dem Scheusalsgreis erkunden. In unserem Dorf kennen alle Kinder diesen Namen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050515
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050515,
					"content": "Wenn ein Kind unartig ist, dann jagen die Eltern ihm einen Schrecken ein, indem sie sagen: „Wenn du nicht artig bist, kommt dich der Scheusalsgreis holen!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050516
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050516,
					"content": "Keiner von diesen jungen Leuten hat den Scheusalsgreis gekannt, aber sie zögern dennoch nicht, seinen Namen zu verwenden, um anderen Angst einzujagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050517
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050517,
					"content": "Als ich noch klein war, habe ich den Scheusalsgreis gesehen. Er mochte keine kleinen Kinder, so viel steht fest, aber er sah nicht scheußlich aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050518
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050518,
					"content": "Ich weiß nicht, wie er zu dem Beinamen Scheusalsgreis gekommen ist. Aber ich glaube, dass das auf ein paar Tunichtgute zurückgeht, die hinter seinem Rücken gelästert haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050519
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050519,
					"content": "Wart ihr zwei nicht befreundet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050520
					]
				},
				{
					"id": 732050520,
					"content": "Als ich noch klein war, bin ich öfter in die Nähe seines kleinen Gartens gekommen, um dort zu spielen. Sobald er mich entdeckt hat, hat er mich seine Hacke schwingend verscheucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050521
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050521,
					"content": "Er hat in mir wohl einfach nur einen frechen Bengel gesehen, der Ärger machen will. Wie könnte er sich da an mich erinnern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050522
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050522,
					"content": "Auch wenn er mich wahrscheinlich nicht gekannt hat, habe ich mich immer an ihn und seinen Garten erinnert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050523
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050523,
					"content": "Wenn ich sage, dass er mein Freund ist, ist das also nicht falsch, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050524
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050524,
					"content": "Lasst uns einfach sagen, dass ich diese Blumen anpflanzen will, um den kleinen Garten aus meiner Erinnerung wieder zum Leben zu erwecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320601,
			"completionStepIds": [
				7320601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
