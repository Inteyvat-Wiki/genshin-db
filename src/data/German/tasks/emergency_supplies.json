				{
					"id": 200730301,
					"content": "Das ist ein Notversorgungspunkt. Wenn du etwas benötigst, kannst du dich hier an den Materialien bedienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730302
					],
					"speakerTitle": "Notversorgungspunkt"
				},
				{
					"id": 200730302,
					"content": "Der Drachengrat ist ein gefährlicher Ort. Bitte geh nicht zu weit rein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730303
					],
					"speakerTitle": "Notversorgungspunkt"
				},
				{
					"id": 200730303,
					"content": "Vorräte platzieren",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730303
					]
				}
			]
		},
