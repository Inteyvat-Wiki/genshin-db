	"talks": [
		{
			"id": 2007301,
			"completionStepIds": [
				2007301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2007301",
							"2"
						],
						"stepId": 2007301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Riese"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200730101,
					"content": "#{F#Reisende}{M#Reisender}! Du kommst genau richtig! Kannst du mir einen Gefallen tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730102
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730102,
					"content": "Was brauchst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730103
					]
				},
				{
					"id": 200730103,
					"content": "Wie du sicher schon gesehen hast, sind die Bedingungen hier oben schrecklich. Selbst erfahrene Abenteurer können nicht behaupten, dass sie mit allem fertig werden, was der Drachengrat ihnen entgegenwirft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730104
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730104,
					"content": "Ich erhielt den Befehl des Stellvertretenden Großmeisters, hier Wache zu halten und alle Bürger zu warnen, nicht auf den Berg zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730105
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730105,
					"content": "Aber während ich viele Bürger überzeugen konnte, dies nicht zu tun, haben diese Abenteurer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730106
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730106,
					"content": "Ich glaube, du weißt, was ich meine, wenn ich behaupte, dass es sinnlos ist, sie zu überzeugen. Sie wollen einfach nur diesen Berg erklimmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730107
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730107,
					"content": "Ich weiß nicht mehr, wie viele Probleme ich mit den Abenteurern lösen musste ... Aber sie kommen trotzdem immer wieder und nie werden sie weniger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730108
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730108,
					"content": "Sich um alle zu kümmern, ist eine unmögliche Aufgabe ... Deshalb habe ich beschlossen, an bestimmten Stellen des Drachengrats einige Vorräte für sie bereitzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730109
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730109,
					"content": "Dadurch erhalten die Abenteurer, die einen Rückzug antreten müssen und sich auf den Rückweg vorbereiten, mehr Möglichkeiten, sich aus dem Berg zu befreien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730110
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730110,
					"content": "Sollte jedoch irgendein leichtsinniger Narr, der von seinem Glück berauscht ist, zu weit nach oben kommen, dann kann er sich nur auf sich selbst verlassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730111
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730111,
					"content": "Also, könntest du mithelfen, diese Vorräte auf den Berg zu bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730112,
						200730114
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730112,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730113
					]
				},
				{
					"id": 200730113,
					"content": "Ich rechne also mit dir. *seufz* Wenn nur diese Abenteurer einen so guten Schwertarm und einen so klugen Kopf auf ihren Schultern tragen würden wie du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730117,
					"content": "Ich habe drei Orte auf deiner Karte markiert. Du musst einfach nur <color=#00E1FFFF>eine Portion Schinken</color> an jedem Ort platzieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730118
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730118,
					"content": "*seufz* Ich wünschte, dass diese Abenteurer ein bisschen mehr Selbsterkenntnis besitzen würden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730114,
					"content": "Werden sie von Nutzen sein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730115
					]
				},
				{
					"id": 200730115,
					"content": "Ob sie es wollen oder nicht ... Es ist besser, sie zu haben als nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730116
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730116,
					"content": "Unter so fürchterlichen Bedingungen wie auf diesem Berg ist es besser, mehr Vorräte zu haben. Jedenfalls zähle ich auf deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "Riese"
				}
			]
		},
		{
			"id": 2007302,
			"completionStepIds": [
				2007306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
