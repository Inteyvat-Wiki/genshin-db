			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Riese"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200730201,
					"content": "Hast du alle Vorräte platziert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730202
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730202,
					"content": "Alle sind da, wo sie sein müssen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730203
					]
				},
				{
					"id": 200730203,
					"content": "Das ist wundervoll. Jetzt kann ich ruhig schlafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730204
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730204,
					"content": "Ich hoffe dennoch, dass jene, die den Berg erklimmen, ausreichend vorbereitet sind und dass wir diese Notvorräte nicht verwenden müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730205
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730205,
					"content": "Wenn ich es mir recht überlege, deine Kleidung scheint auch etwas dürftig zu sein. Ist das die neueste Mode in Mondstadt oder so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730206
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730206,
					"content": "Egal wie, bitte nimm dies als Zeichen meines Dankes und zieh ein paar zusätzliche Schichten an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Riese"
				}
			]
		},
		{
