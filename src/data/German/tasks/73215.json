			"dialogs": [
				{
					"id": 732150601,
					"content": "Goldener Nara, weißes Fliegerchen, ihr seid gekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150602
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150602,
					"content": "Ja, wir sind da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150603,
					"content": "Hehe ... Ich habe vielleicht eine Menge Dinge vergessen, also müsst ihr mich daran erinnern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150604
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150604,
					"content": "Ist es wegen „Kusava“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150605
					]
				},
				{
					"id": 732150605,
					"content": "Ja ... Aranaga hat es euch gegenüber erwähnt. Macht liegt in der Erinnerung, und keine Erinnerung bedeutet keine Macht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150606
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150606,
					"content": "Darum haben wir zuvor sicher etwas erlebt, aber wir erinnern uns nicht mehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150607
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150607,
					"content": "Haha, das bedeutet nichts für mich. Wir können immer noch mit neuen Erinnerungen anfangen! Nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150608
					],
					"speakerTitle": "Aragaru"
