				"points": []
			},
			"dialogs": [
				{
					"id": 732150301,
					"content": "Hallo, danke! Goldener Nara und weißes Fliegerchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150302
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150302,
					"content": "Was macht ihr da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150303
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150303,
					"content": "Du hast gesagt, wir sollen nicht vergessen, zurückzukehren und wieder mit euch zu spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150304,
					"content": "Hmm ... Habe ich das tatsächlich gesagt ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150305,
						732150307
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150305,
					"content": "Das hast du gesagt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150306
					]
				},
				{
					"id": 732150306,
					"content": "Also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150309
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150309,
					"content": "Auf jeden Fall danke ich euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150307,
					"content": "Was ist los, bist du nicht glücklich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150308
					]
				},
				{
					"id": 732150308,
					"content": "Hmm ... Nicht wirklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150309
					],
					"speakerTitle": "Aragaru"
				}
			]
		},
