			},
			"dialogs": [
				{
					"id": 732150501,
					"content": "Hallo! Goldener Nara! Und du, kleines, weißes Fliegerchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150502
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150502,
					"content": "Hm, ich bin nicht klein! Sieh dich selber an",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150503,
					"content": "Ich bin auch nicht klein! Ach ja, richtig, was macht ihr eigentlich hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150504
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150504,
					"content": "Wir sind zurückgekommen, um euch zu besuchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150505
					]
				},
				{
					"id": 732150505,
					"content": "Ja, wir haben zuvor gemeinsam doch viele Bösewichte besiegt und zusammen gesungen und „Maa-tima“ gerettet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150506,
					"content": "„Mawtiyima“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150507
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150507,
					"content": "Ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150508,
					"content": "Hm ... Entschuldige ... Was ihr sagt, sollte wahr sein, aber ich erinnere mich nicht mehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150509
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150509,
					"content": "Hm ... ! Kein Problem! Bitte sei nicht traurig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150510,
					"content": "(Er erinnert sich wirklich nicht mehr ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
