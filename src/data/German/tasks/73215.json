			"dialogs": [
				{
					"id": 732150401,
					"content": "Hallo, Goldener Nara und weißes Fliegerchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150402
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150402,
					"content": "Hallo! Wie geht’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150403,
					"content": "Sehr gut, was macht hier, ihr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150404
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150404,
					"content": "Hä ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150405,
					"content": "Oh ... Sehr beunruhigt wir sind. Einen guten Grund es sicher geben wird. Doch warum ihr gekommen seid, wir nicht wissen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150406
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150406,
					"content": "Wir kennen diesen Ort gut, nach all den Abenteuern, die wir mit euch erlebt haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150407,
					"content": "... ? Hmm ... Ist das so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150408
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150408,
					"content": "Er erinnert sich nicht mehr daran, was er mit uns zusammen erlebt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
