					"speakerTitle": "Yicheng"
				}
			]
		},
		{
			"id": 2220006,
			"completionStepIds": [
				2220006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
