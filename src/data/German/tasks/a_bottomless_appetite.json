					"nextDialogs": [
						222000705
					]
				},
				{
					"id": 222000705,
					"content": "Das Rezept für Eichhörnchenfisch und Kalte Geflügelhäppchen kennt Koch Mao vom Restaurant Wanmin am besten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000706
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000706,
					"content": "Ein Händler aus Mondstadt berichtete mir mal, dass beim Hirschjäger den berühmten Sahneeintopf geben soll, ich weiß aber nicht ob dieser gut schmeckt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000707
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000707,
					"content": "Und dann noch ein Teyvat-Spiegelei, das müsste man eigentlich in Mondstadt überall leicht bekommen ... knurr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000708
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000708,
					"content": "*knurr* ... Ah, mein Magen knurrt immer lauter vor Hunger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
