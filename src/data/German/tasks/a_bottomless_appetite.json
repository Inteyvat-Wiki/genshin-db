			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000201,
					"content": "Oh, ich habe gehört in Mondstadt gibt es einige Gerichte, die großartig schmecken – süß mariniertes Hähnchen, gegrillter Mondstadt-Fisch, Fischerschnitte, Meeresfrüchtesuppe mit Wasserlilie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000202
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000202,
					"content": "Bitte, bringt mir das Essen, welches den Magen am leichtesten füllt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000203
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000203,
					"content": "Nachdem ich es gegessen habe, wird wenigstens heute für den Rest des Tages mein Magen nicht mehr knurren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
