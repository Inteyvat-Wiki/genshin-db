			"dialogs": [
				{
					"id": 222000301,
					"content": "Hast du jenes Magen füllendes Essen für mich gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000302,
						222000304
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000302,
					"content": "Hier ist es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000303
					]
				},
				{
					"id": 222000303,
					"content": "Wundervoll, ich probiere es gleich mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000304,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000305
					]
				},
				{
					"id": 222000305,
					"content": "Na gut, also die Fischerschnitte gibt es zum Beispiel im Restaurant Wanmin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000307
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000307,
					"content": "Ein Händler aus Mondstadt berichtete mir mal, dass beim Hirschjäger die berühmte Meeresfrüchtesuppe mit Wasserlilie geben soll, die schmeckt bestimmt nicht schlecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000308
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000308,
					"content": "Da wir von Mondstadt-Gerichten sprechen: Gegrillter Fisch und süß mariniertes Hähnchen sollten recht einfach zu machen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000309
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000309,
					"content": "*knurr* ... Ah, mein Magen knurrt immer lauter vor Hunger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
		{
			"id": 2220004,
			"completionStepIds": [
				2220004
			],
