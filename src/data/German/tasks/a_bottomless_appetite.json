			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000101,
					"content": "Hallo, kann ich dir wa... *knurr*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000102
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000102,
					"content": "Oh, mein Bauch macht wieder so furchtbaren Lärm. Ich sagte, brauchst du etwa Hil... *knurr*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000103
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000103,
					"content": "Ähm, was hast du gesagt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000104
					]
				},
				{
					"id": 222000104,
					"content": "*seufz* Mein Bauch macht jedes Mal solche Probleme, wenn ich Hunger habe. Knurrt hier und knurrt da. Und er ist auch wirklich laut. Ich kann nicht mal den Klang meiner eigenen Stimme hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000105
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000105,
					"content": "Obwohl *knurr* zur Bubu-Hütte gegangen bin, um mich untersuchen zu lassen, sagte der Arzt nur, dass ich hungrig sei, aber nicht krank. Es gibt also keine Heilung für mein ... *knurr*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000106
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000106,
					"content": "Der Arzt hat gemeint, dass ich einfach vollständige Mahlzeiten zu mir nehmen soll, aber ich ... ich hatte immer einen größeren *KNURREN* als die meisten. Wenn ich jedes Mal essen würde, bis ich voll bin, hätte ich ein großes Loch in meinem Geldbeutel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000107
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000107,
					"content": "Jiayi sagt mir, dass ich mir etwas kaufen soll, um die Lücken zu füllen, wenn mich meine Hauptmahlzeiten nicht satt machen, damit es meine Arbeit nicht beeinträchtigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000108
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000108,
					"content": "„Die Lücken füllen“ sagt er, aber ich habe eine lange Liste an Gerichten, die ich gerne essen würde. Und ich bin mir nicht sicher, was das Beste ist, um meinen Bauch zu füllen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000109
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000109,
					"content": "Reisender, du bist erfahren im Leben draußen. Du weißt sicherlich, welches Essen den Bauch am besten füllt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000110
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000110,
					"content": "Könntest du mir helfen, das sättigendste und köstlichste Gericht von meiner Liste auszuwählen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000111
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000111,
					"content": "Was würdest du dieses Mal gerne essen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000112
					]
				},
				{
					"id": 222000112,
					"content": "Oh, es gibt viel ... Lass mich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
		{
			"id": 2220002,
			"completionStepIds": [
				2220002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
