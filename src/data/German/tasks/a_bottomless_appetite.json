			},
			"dialogs": [
				{
					"id": 222000401,
					"content": "Ich sehne mich nach einem gedämpften Ei mit Lotossamen, aber auch nach etwas gekochtem Schwarzrückenbarsch ... Aber es gibt auch einige Gerichte aus Mondstadt, die ich gerne hätte. Einen Spieß mit Pilzen und Hühnchen würde ich nicht ablehnen, das Gleiche gilt für einen Landeierkuchen oder zwei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000402
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000402,
					"content": "Bitte, bringt mir das Essen, welches den Magen am leichtesten füllt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000403
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000403,
					"content": "Nachdem ich es gegessen habe, wird wenigstens heute für den Rest des Tages mein Magen nicht mehr knurren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
