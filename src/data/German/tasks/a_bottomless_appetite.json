			"dialogs": [
				{
					"id": 222000701,
					"content": "Hast du jenes Magen füllendes Essen für mich gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000702,
						222000704
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000702,
					"content": "Hier ist es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000703
					]
				},
				{
					"id": 222000703,
					"content": "Wundervoll, ich probiere es gleich mal.",
					"roleType": "TALK_ROLE_NPC",
