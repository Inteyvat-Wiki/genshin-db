				"objectNames": [
					"Yicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000601,
					"content": "Wie gern würde ich jetzt Eichhörnchenfisch und Kalte Geflügelhäppchen essen. Ich habe gehört, in Mondstadt gibt es auch einige tolle Gerichte, wie Sahneeintopf oder das berühmte Teyvat-Spiegelei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000602
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000602,
					"content": "Je mehr ich dran denke, desto hungriger werde ich ... knurr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000603
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000603,
					"content": "Ich bitte dich, bring mir eine Portion zu essen. Nachdem ich es gegessen habe, wird wenigstens heute für den Rest des Tages mein Magen nicht mehr knurren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
