					"content": "Hier ist es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000503
					]
				},
				{
					"id": 222000503,
					"content": "Wundervoll, ich probiere es gleich mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000504,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000505
					]
				},
				{
					"id": 222000505,
					"content": "Ich habe gehört, dass Chefkoch Mao vom Wanmin Restaurant weiß, wie man einen Schwarzrücken-Barsch-Eintopf zubereitet - du kannst ihn fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000506
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000506,
					"content": "Zum gedämpften Ei mit Lotossamen: Ich denke, der Kräuterkundler Gui kennt das Rezept. Er arbeitet in der Bubu-Hütte auf der Yujing-Terrasse, wenn du nach ihm fragen musst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000507
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000507,
					"content": "Ich habe von einem Händler gehört, dass die Landeierkuchen vom Hirschjäger in Mondstadt wirklich gut schmecken und sättigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000508
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000508,
					"content": "Und dann noch Spieß mit Pilzen und Hühnchen, den müsste man eigentlich in Mondstadt überall leicht bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000509
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000509,
					"content": "*knurr* ... Ah, mein Magen knurrt immer lauter vor Hunger ...",
					"roleType": "TALK_ROLE_NPC",
