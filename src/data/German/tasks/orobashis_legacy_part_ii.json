			},
			"dialogs": [
				{
					"id": 721300101,
					"content": "Die seltsam geformte Steinlaterne scheint eine unheilvolle Energie auszustrahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300102
					],
					"speakerTitle": "Betrachten"
				},
				{
					"id": 721300102,
					"content": "Diese Steinlaterne ist so unheimlich ... Sie kommt mir bekannt vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721300103,
					"content": "Oh, da hat jemand etwas auf der Lampensäule geschrieben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721300104,
					"content": "„Soldaten, die hier stationiert sind, wenn ihr Fragen zu dieser Station habt, geht bitte in die Musoujin-Schlucht und sprecht mit Herrn Kaji.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300105
					],
					"speakerTitle": "Betrachten"
				},
				{
					"id": 721300105,
					"content": "Die Handschrift sieht neu aus, aber wurde vom Regen verwaschen. Ein paar klare Zeilen kleinerer Schrift sind darunter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300106
					],
					"speakerTitle": "Betrachten"
				},
				{
					"id": 721300106,
					"content": "„Bitte glaub diesen seltsamen Notizen nicht. Das Geheimnis des Erfolgs auf dem Schlachtfeld ist Schnelligkeit. Das muss ein feindlicher Trick sein, um uns zu verlangsamen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300107
					],
					"speakerTitle": "Betrachten"
				},
				{
					"id": 721300107,
					"content": "„Wer die Armee ohne Erlaubnis verlässt, wird hart bestraft!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300108
					],
					"speakerTitle": "Betrachten"
				},
				{
					"id": 721300108,
					"content": "Herr Kaji scheint ziemlich besorgt über die Steinlaternen zu sein. Warum gehen wir nicht zur Musoujin-Schlucht und fragen ihn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
