			},
			"dialogs": [
				{
					"id": 721170301,
					"content": "Wie ist es gelaufen? Hast du alle unsere Baken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170302,
					"content": "Ich habe sie alle hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170303
					]
				},
				{
					"id": 721170303,
					"content": "Bravo! Jetzt gib mir einen Moment, um dieses Gerät zu modifizieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170304,
					"content": "Dennoch sind die letzten Aktionen der Fatui immer seltsamer geworden. Sie versammeln sich alle um den Kern des Ofens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170305
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170305,
					"content": "Hoffentlich brüten sie nicht eine weitere heimtückische Verschwörung aus. Oder sollte ich sagen: etwas versuchen, wogegen wir nicht ankommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
