					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721170101,
					"content": "#Ah, so ein perfektes Timing, Reisende{M#r}! Die Daten sind fast alle gesammelt und es ist nun an der Zeit, unsere Baken zu holen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170102,
						721170104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170102,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170103
					]
				},
				{
					"id": 721170103,
					"content": "Das werde ich, das werde ich. Sei am besten schnell. Lass dich nicht von den Fatui entdecken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170104,
					"content": "Woher weißt du das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170105
					]
				},
				{
					"id": 721170105,
					"content": "Diese Baken werden in der Regel mit sehr detaillierten Anleitungen geliefert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170106,
					"content": "Diese beschreiben verschiedene Umstände und die Zeit, die für das Sammeln von Daten unter den jeweiligen Umständen benötigt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170107,
					"content": "Was unbekannte Energien wie die der Tatarigami angeht, werde ich einfach davon ausgehen, dass sie die längste Dauer benötigen. So oder so, die Aufgabe, diese Leuchtfeuer zu finden, fällt dir zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
