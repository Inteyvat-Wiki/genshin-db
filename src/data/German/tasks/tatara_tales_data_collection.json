						721170402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170402,
					"content": "Sobald wir diese Daten zur Hand haben, werde ich einige entsprechende Anpassungen an diesem Gerät vornehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170403
					],
					"speakerTitle": "Xavier"
				},
				{
