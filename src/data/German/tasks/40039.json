			"dialogs": [
				{
					"id": 400390801,
					"content": "Halt, alle, sofort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390802
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390802,
					"content": "Ihr erkennt die große Beidou nicht einmal, ihr undankbares Pack!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390803
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390803,
					"content": "He ... Beidou, du bist nach so langer Zeit immer noch so gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390804
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390804,
					"content": "Carmen, ich habe dich lange nicht gesehen. Warum hast du wieder so viel zugenommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390805
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390805,
					"content": "Wenn du weiter zunimmst, wirst du dich nicht mehr verstecken können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390806
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390806,
					"content": "Du machst Witze ... Du machst Witze ... Hahaha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390807
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390807,
					"content": "Kommen wir zur Sache. Ich nehme die hier. Leg die Sachen hin und ich werde keine Schwierigkeiten machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390808
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390808,
					"content": "Ja, ja, ja, hört auf Beidou ... Legt alles hin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390809
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390809,
					"content": "Alles ist für dich da, also ... dann werden wir uns verabschieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390810
					],
					"speakerTitle": "Carmen"
				},
				{
					"id": 400390810,
					"content": "Carmen ist schnell mit der Gruppe der Schatzräuber verschwunden ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400390811
					]
				},
				{
					"id": 400390811,
					"content": "Ich kann nicht glauben, dass sie so schnell aufgaben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400390812,
					"content": "Die Kapitulation ging echt schnell.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390813
					]
				},
				{
					"id": 400390813,
					"content": "Das Wegrennen auch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390814
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400390814,
					"content": "Vergeuden wir keine Zeit mit ihnen, sondern fahren wir schnell aufs Meer und setzen die Bergung fort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390815
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390815,
					"content": "#Ach ja, da ist ja noch all das Zeug, das an Bord gebracht werden muss ... {F#Reisende}{M#Reisender}, komm und hilf mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
				}
			]
		},
