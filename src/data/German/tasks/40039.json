					"nextDialogs": [
						400391110
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391110,
					"content": "Ein bisschen kann man schon für uns da lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391111
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391111,
					"content": "Diese Sachen darfst du nicht anfassen. Ich wiederhole: Legt alles weg und entfernt euch so weit wie möglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391112
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391112,
					"content": "Das ist nicht gut so, oder? Vielleicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391113
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391113,
					"content": "Du schindest Zeit ...",
					"roleType": "TALK_ROLE_NPC",
