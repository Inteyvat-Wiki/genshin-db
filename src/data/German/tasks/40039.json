						400391105
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391105,
					"content": "Liuliu, was machst du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400391106,
					"content": "Nun, wir hatten Glück und wollten etwas aus dem Meer fischen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391107
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391107,
					"content": "Nimm, was du willst! Sieh es als Dankesgeschenk von uns, hahah ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391108
					],
					"speakerTitle": "Liuliu"
				},
				{
					"id": 400391108,
					"content": "Ach? Dann sollten wir all diese Dinge behalten.",
					"roleType": "TALK_ROLE_NPC",
