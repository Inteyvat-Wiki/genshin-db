			},
			"dialogs": [
				{
					"id": 400390101,
					"content": "Beidou ist drüben bei den Guyun-Türmen und hilft mir, die verstreuten Sammlungen des Jadegemachs zu bergen. Wenn du Interesse hast, kannst du es dir anschauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
		{
			"id": 4003902,
			"completionStepIds": [
				4003902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003902",
							"2"
						],
						"stepId": 4003902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400390201,
					"content": "Es fehlt wirklich eine Menge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390202,
					"content": "Was fehlt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390203
					]
				},
				{
					"id": 400390203,
					"content": "Im Vergleich zu früher gibt es heute viel weniger Dinge in diesem Jadegemach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390204
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390204,
					"content": "Viele der Bücher, Möbel und Schmuckstücke, die ich gesammelt hatte, fielen mit diesem Jadegemach ins Meer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390205
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390205,
					"content": "Die meisten dieser Gegenstände wurden bei der Katastrophe zerstört und die wenigen, die überlebt haben, sind über das Meer verstreut und äußerst schwer zu bergen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390206
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390206,
					"content": "Nur jemand, der gut auf dem Wasser arbeiten kann, kann das für mich tun. Ich weiß nur nicht, ob Beidou sie alle zurückholen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390207,
					"content": "Zurückholen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390208
					]
				},
				{
					"id": 400390208,
					"content": "Was? Hast du Beidou gebeten, die Sachen zurückzuholen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400390209,
					"content": "„Gebeten“ ist nicht präzise. Wir schulden einander nie was.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390210
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390210,
					"content": "Beidou wird dafür bezahlt, Dinge zu tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390211
					]
				},
				{
					"id": 400390211,
					"content": "Es gibt noch andere „Belohnungen“ als „Mora“ ... Oh, diese Dinge sind kompliziert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390212
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390212,
					"content": "Kurz gesagt, Beidou befindet sich jetzt in der Gegend der Guyun-Türme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390213
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400390213,
					"content": "Wenn ihr Interesse habt, könnt ihr es euch ansehen. Vielleicht könnt ihr ihr auch helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
		{
			"id": 4003904,
			"completionStepIds": [
				4003904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003904",
							"2"
						],
						"stepId": 4003904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400390401,
					"content": "Diese lästige Frau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390402
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390402,
					"content": "Das Jadegemach wurde auf dem Meer zerschmettert und sein Inhalt muss zerstört worden sein. Wie hätte man ihn also bergen können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390403
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390403,
					"content": "Läuft die Bergung noch gut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390404
					]
				},
				{
					"id": 400390404,
					"content": "#{F#Reisende}{M#Reisender}? Was machst du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390405
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390405,
					"content": "Ich bin hier, um zu helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390406
					]
				},
				{
					"id": 400390406,
					"content": "Oh! Du kommst gerade noch rechtzeitig, das ganze Schiff ist jetzt draußen und es gibt einfach nicht genug Männer für alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390407
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390407,
					"content": "Ich habe Xinyan sogar zur Hilfe geholt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390408
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390408,
					"content": "Xinyan ist auch da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390409
					]
				},
				{
					"id": 400390409,
					"content": "Ach ja, warum ist Xinyan mit an Bord? Gibt es eine Darbietung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400390410,
					"content": "Ja! Es handelt sich eigentlich nicht um einen offiziellen Auftritt, aber ich wurde gebeten, ein paar Lieder für eine Feier zu singen, die Beidou veranstalten wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390411
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400390411,
					"content": "Doch bevor es losgehen konnte, kam plötzlich einer, der behauptete, der Sekretär von Ningguang zu sein, und rief Beidou weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390412
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400390412,
					"content": "Hieß sie Baiwen oder Baixiao? Nun ... es ist ein bisschen schwer, sich daran zu erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390413
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390413,
					"content": "Wie auch immer, es war nur eine weitere Bitte von Ningguang, ihr bei der Bergung der Sammlung auf See zu helfen, wobei sie eine große Summe Geld für die Arbeit zahlen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390414
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390414,
					"content": "Hm ... da die Mittel zur Verfügung stehen, werden wir diesen Auftrag annehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390415
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390415,
					"content": "Für die Bergung muss man ein kleines Boot benutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390416
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390416,
					"content": "Alle kleinen Boote der Flotte, die eingesetzt werden konnten, sind unterwegs, aber im Moment fehlt noch eins ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390417
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390417,
					"content": "Ich habe eins.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400390418
					]
				},
				{
					"id": 400390418,
					"content": "Du hast ein Boot? Das ist perfekt, wir segeln auf deinem Boot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400390419
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 400390419,
