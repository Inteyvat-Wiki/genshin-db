					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391206
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400391206,
					"content": "Aber überlassen wir das Beidou, sie ist gut im Umgang mit diesen Leuten. Ihre Bezahlung, auch darauf werde ich vorbereitet sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400391207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 400391207,
					"content": "Danke, dass ihr mir noch einmal davon berichtet habt. Ich habe auch einige Belohnungen für euch vorbereitet, also nehmt sie bitte an.",
