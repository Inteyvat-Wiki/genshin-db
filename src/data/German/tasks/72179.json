			"dialogs": [
				{
					"id": 721790101,
					"content": "(Ein einfaches, aber feierliches Steindenkmal, von der Hand eines Soldaten gehauen und aufrecht stehend.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721790102
					],
					"speakerTitle": "Einfacher Grabstein"
				},
				{
					"id": 721790102,
					"content": "„Nagano Shigehide und Ohatsu“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721790103
					],
					"speakerTitle": "Einfacher Grabstein"
				},
				{
					"id": 721790103,
					"content": "„Hier verabschiedeten sich Liebende und vereinten sich wieder.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721790104
					],
					"speakerTitle": "Einfacher Grabstein"
				},
				{
					"id": 721790104,
					"content": "Nun ... Das scheinen die Grabsteine der Kriegsopfer zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721790105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721790105,
					"content": "Es ist so traurig, allein zu sein ... Sollen wir ein paar Blumen ans Grab legen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721790106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721790106,
					"content": "(Dendrobium platzieren)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
