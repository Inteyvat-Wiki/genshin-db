			"dialogs": [
				{
					"id": 200150401,
					"content": "Gut, dass du da warst. Allein hätte ich das nicht überlebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150402
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150402,
					"content": "Was hab ich denn Falsches gesagt? Bestimmt war meine Aussprache nicht korrekt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150403
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150403,
					"content": "Ich sollte mich für das nächste Mal besser vorbereiten ...",
