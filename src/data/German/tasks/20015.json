					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200150201,
					"content": "Hier, dieser Hilichurl ist wach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150202
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150202,
					"content": "Den nehmen wir. Also schnell rüber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150203
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150203,
					"content": "Aber sei vorsichtig. Wir sollten die anderen Hilichurle nicht aufwecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150204,
					"content": "Wir wollen ja nicht, dass sie glauben, wir wollten sie angreifen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150205,
					"content": "Dann würden sie bestimmt nicht mehr mit uns reden wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
		{
			"id": 2001503,
			"completionStepIds": [
				2001504
