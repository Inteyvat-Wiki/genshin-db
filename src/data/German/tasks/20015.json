				"points": []
			},
			"dialogs": [
				{
					"id": 200150701,
					"content": "Was meinst du? Mein Hilichurlisch ist doch ziemlich gut, oder? Die Kommunikation stimmt so weit. Jetzt brauchen wir nur noch Zeit, um uns wirklich gegenseitig zu verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150702
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150702,
					"content": "Das ist jedenfalls mein Traum ... Ich will, dass wir eines Tages Freunde sein können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150703
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150703,
					"content": "Ach, ich hab ja noch das hier. Nimm dieses Geschenk, das uns der Hilichurl vorhin gegeben hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150704
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150704,
					"content": "Das Geschenk eines Hilichurls! Das hast du sicher nicht erwartet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150705
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150705,
					"content": "Dann verabschiede ich mich jetzt. Ich muss meine Entdeckungen alle aufschreiben. Wir sehen uns beim nächsten Mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
		{
			"id": 2001508,
			"completionStepIds": [
				2001506
			],
