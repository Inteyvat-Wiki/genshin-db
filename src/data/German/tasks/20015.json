			"trigger": {
				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200150101,
					"content": "#{F#Reisende}{M#Reisender}, hier drüben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150102,
					"content": "Jetzt scheuch die Hilichurle nicht auf! Warum läufst du auch immer direkt in ihre Lager?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150103,
					"content": "Ach, egal. Ich studiere Hilichurlisch schon seit Langem und wollte gern einen richtig sprechen hören, anstatt nur Bücher darüber zu lesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150104,
					"content": "Jetzt bin ich endlich auf ein richtiges Hilichurl-Lager gestoßen. Diese Gelegenheit kann ich doch nicht einfach vorbeiziehen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150105,
					"content": "#Also, {F#Reisende}{M#Reisender}, würdest du mir einen Hilichurl aus dem Lager suchen, der mit mir sprechen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
		{
			"id": 2001502,
			"completionStepIds": [
				2001503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
