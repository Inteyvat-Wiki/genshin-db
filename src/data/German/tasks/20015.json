			},
			"dialogs": [
				{
					"id": 200150601,
					"content": "Olah! Muhe mimi, nye, eh ... mosi aba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150602
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150602,
					"content": "Yo mimi beru si?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150603
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 200150603,
					"content": "Buka ... mita nye, guru-guru ... yo mosi ka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150604
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150604,
					"content": "Ya odomu, Todo yo, buka guru-guru nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150605
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 200150605,
					"content": "Mi? Dada! Valo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150606
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150606,
					"content": "Valo, ya odomu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150607
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 200150607,
					"content": "Hihi, sieh dir an, wie er sich bewegt. Er scheint richtig gut drauf zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150608
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150608,
					"content": "Dieser Kontakt war wirklich erfolgreich. Mein Hilichurlisch wird immer besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
		{
