			"dialogs": [
				{
					"id": 200150301,
					"content": "Biat ye, ye pupu dada mosi! Plama ye upa dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150302
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150302,
					"content": "Dala beru yo?! Kundala muhe, kucha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150303
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 200150303,
					"content": "Kundala gusha! Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150304
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150304,
					"content": "Biat ye, plata ye pupu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150305
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 200150305,
					"content": "Movo unta nye kucha, mi dada tiga mitono!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150306
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 200150306,
					"content": "Er scheint mich verstanden zu haben. Jetzt will er uns wohl ein Geschenk geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200150307
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150307,
					"content": "#Das ... ist eine Waffe! Aaaaaah, {F#Reisende}{M#Reisender}, bitte rette mich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
