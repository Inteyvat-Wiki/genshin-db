			},
			"dialogs": [
				{
					"id": 205030601,
					"content": "Wenn du demnächst wieder Erz findest, kannst du es immer zu mir bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030602
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030602,
					"content": "Am besten, wenn ich nicht gerade so viel zu tun habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030603
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030603,
					"content": "Du scheinst nicht bei sonderlich guter Laune zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030604
					]
				},
				{
					"id": 205030604,
					"content": "Fürs Schmieden braucht man vollen Körpereinsatz. Ich finde keinen Gefallen daran, mit Kunden Schwätzchen zu halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030605
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030605,
					"content": "Solange ich meine Arbeit gut mache, läuft das Geschäft. Alles andere ist nur überflüssiger Unsinn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030606
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030606,
					"content": "Wenn nichts weiter ist, werde ich weiterarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				}
			]
		}
	]
