				"points": []
			},
			"dialogs": [
				{
					"id": 205030201,
					"content": "Was gibt’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030202,
						205030204
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030202,
					"content": "Was hast du so für Waffen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030203
					]
				},
				{
					"id": 205030203,
					"content": "Da drüben. Such dir einfach eine aus. Wenn du was Spezielles brauchst, kann ich dir auch etwas anfertigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030207,
					"content": "Du machst sogar Maßanfertigungen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205030208,
					"content": "Natürlich! Ich verkaufe, ich mache Maßanfertigungen, Verfeinerungen, einfach alles, was ein Schmied eben so macht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030209
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030209,
					"content": "Du musst mir nur passendes Erz geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030210,
						205030212
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030210,
					"content": "Wo findet man dieses Erz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030211
					]
				},
				{
					"id": 205030211,
					"content": "Ja, überall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030214,
					"content": "Ach, jetzt guck doch nicht so verwirrt. Ich werde dir sagen, wo es hier in der Nähe besonders viel Eisen gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030215
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030215,
					"content": "Wenn du mir ein paar Brocken Eisen bringst, kann ich sie für dich schmieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030216
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030216,
					"content": "Gut, danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030217
					]
				},
				{
					"id": 205030217,
					"content": "Nichts zu danken. Dann mache ich mich mal wieder an die Arbeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030212,
					"content": "Verkaufst du auch welches?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030213
					]
				},
				{
					"id": 205030213,
					"content": "Such dir da jemand anderen. Ich habe ja selbst nicht genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030204,
					"content": "Gibt es etwas in der Größe von Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030205
					]
				},
				{
					"id": 205030205,
					"content": "Was? Das glaub ich jetzt nicht! Soll ich jetzt etwa auch noch für dich kämpfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205030206,
					"content": "Also, da hilft nur eine Maßanfertigung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "Wagner"
				}
			]
		},
