			},
			"dialogs": [
				{
					"id": 205030501,
					"content": "Was denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030502,
						205030503
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030502,
					"content": "Ich habe das Eisen gesammelt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030504
					]
				},
				{
					"id": 205030504,
					"content": "Ach, stimmt ja ... Hab ich wohl verdrängt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030505
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030505,
					"content": "Na, dann her damit. Scheint wohl ganz in Ordnung zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030506
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030506,
					"content": "Ich möchte mir etwas schmieden lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030503,
					"content": "Du hast mich doch Eisen sammeln lassen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030504
					]
				}
			]
		},
		{
			"id": 2050306,
			"completionStepIds": [
				2050306
