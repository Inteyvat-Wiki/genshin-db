			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiayi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411260101,
					"content": "*seufz* Was soll ich tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260102
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260102,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260103
					]
				},
				{
					"id": 411260103,
					"content": "Du hast diese gefallenen Sterne sicher auch gesehen, oder? Glücklicherweise blieb die Stadt verschont, doch da draußen herrscht das reinste Chaos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260104
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260104,
					"content": "Die gefallenen Sterne blockieren nicht nur die Straßen, sondern stacheln auch die Monster in der Nähe an, sodass sie gefährlicher als sonst sind. Überall werden Vorbeiziehende und Händler von ihnen attackiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260105
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260105,
					"content": "Der Rat für Allgemeine Angelegenheiten hat beinahe jeden verfügbaren Millelith gesandt, doch Liyue ist einfach zu groß. Wir können nur für die Sicherheit einiger Hauptstraßen und zentraler Dörfer sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260106
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260106,
					"content": "Ich wollte ins Qingce-Dorf versetzt werden, um dort Wache zu halten, doch aus irgendeinem Grund soll ich hier immer noch auf neue Befehle warten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260107
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260107,
					"content": "#{F#Reisende}{M#Reisender}, würdest du diesen Brief für mich zu einem Mädchen namens kleine Liu ins Qingce-Dorf bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260108
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260108,
					"content": "Sie ist meine Tochter, ich habe versprochen, einige Tage bei ihr zu verbringen. Doch bei all diesen Notsituationen steht das nun außer Frage ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260109,
						411260111
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260109,
					"content": "Ich kümmere mich darum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260110
					]
				},
				{
					"id": 411260110,
					"content": "#Das weiß ich zu schätzen, {F#Reisende}{M#Reisender}. Ah, was für ein Pech ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260115,
					"content": "Außerdem habe ich von Soldaten außer Dienst ebenfalls gehört, dass sich nahe dem Qingce-Dorf viele Monster zusammenscharren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260116
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260116,
					"content": "Und ... ich will dir nichts auferlegen, aber du wirkst so, als wärst du fürs Abenteuer gewappnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260117
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260117,
					"content": "Würdest du dich beim Qingce-Dorf umsehen, wenn du den Brief überbringst, und die Monster beseitigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260118
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260118,
					"content": "Die Millelith überwachen die Hauptstraßen und die wichtigsten Pässe ... Wenn sich ein paar verstreute Monster in das Qingce-Dorf einfielen, könnte das böse enden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260119,
						411260121
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260119,
					"content": "Also gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260120
					]
				},
				{
					"id": 411260120,
					"content": "Ich danke dir! Das weiß ich wirklich zu schätzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260121,
					"content": "Das kostet dich extra ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260122
					]
				},
				{
					"id": 411260122,
					"content": "Ähm ... Keine Sorge, ich werde dich angemessen entschädigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260123
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260123,
					"content": "Ich bin dir dankbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260111,
					"content": "Es ist nicht deine Schuld ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260112
					]
				},
				{
					"id": 411260112,
					"content": "Ich weiß aber ... ich verstehe es einfach nicht. Warum passiert so etwas immer nur, wenn ich mir Urlaub nehme?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260113
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260113,
					"content": "Das kann doch kein Zufall sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260114
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 411260114,
					"content": "Dann überlasse ich es dir. Bitte bring diesen Brief zu Kleine Liu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "Jiayi"
				}
			]
		},
