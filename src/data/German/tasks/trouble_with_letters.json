						411260803
					]
				},
				{
					"id": 411260803,
					"content": "Ein Brief von Papa ... Oje, ich weiß schon, was drin steht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260804
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 411260804,
					"content": "Er hat Dienst und kann darum nicht zu mir kommen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260805
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 411260805,
					"content": "Als die Millelithen kamen, dachte ich, Papa wäre bei ihnen, aber nichts da ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260806
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 411260806,
					"content": "Aber eigentlich ist das nicht so schlimm. Bei all den Felsen, die vom Himmel fallen, könnte Papa da draußen in Gefahr sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260807,
						411260809
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 411260807,
					"content": "Fürchtest du dich nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260808
					]
				},
				{
					"id": 411260808,
					"content": "Ein bisschen, aber das wird schon. Schließlich sind die Millelith hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260811
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 411260811,
					"content": "Würdest du diesen Brief für mich zu Papa bringen? Er ist bestimmt besorgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260812
					],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 411260812,
					"content": "Es ist so seltsam. Immer, wenn Papa Zeit mit mir verbringen will, passiert irgendetwas ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleine Liu"
				},
				{
					"id": 411260809,
					"content": "Geh jetzt nicht nach draußen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260810
					]
				},
				{
					"id": 411260810,
					"content": "Ich weiß, ich weiß. Die Millelithen wiederholen es auch ständig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260811
					],
					"speakerTitle": "Kleine Liu"
				}
			]
		},
