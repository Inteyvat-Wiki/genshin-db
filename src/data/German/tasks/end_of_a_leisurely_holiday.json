			"dialogs": [
				{
					"id": 765100101,
					"content": "... Das beweist doch endlich, dass es sich hier nicht um eine vertrauliche militärische Waffe handelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100102
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100102,
					"content": "Hmm, stimmt schon, wenn es noch schwieriger gestaltet wäre, wäre es kein Kinderspiel mehr. Gib alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100103
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100103,
					"content": "Oha! Schon wieder diese bedrohliche Atmosphäre, es ist so angespannt, als würde es ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100104,
					"content": "Gleich zu einem Kampf kommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100105
					]
				},
				{
					"id": 765100105,
					"content": "#Ja ... da {NICKNAME} auch hier ist, wäre jetzt doch der perfekte Moment für ein faires Kräftemessen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100106
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100106,
					"content": "Ach, woher kommt nur deine Besessenheit? Ist es etwa, weil ich dich beim letzten Mal so einfach besiegt habe? Wenn das der Grund ist, dann lass uns ein Kräftemessen veranstalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100107
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100107,
					"content": "#{NICKNAME}, pass auf, wir werden ja sehen, wer zuerst aufgibt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100108
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100108,
					"content": "Pah, große Worte helfen dir nicht weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100109,
						765100110
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100109,
					"content": "Edler sieht stärker aus ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				},
				{
					"id": 765100111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100112
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100112,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100113
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100113,
					"content": "...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100114
					]
				},
				{
					"id": 765100114,
					"content": "Waaah! Sollte das nicht nur ein kleines Kräftemessen zwischen den beiden sein?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100115,
					"content": "Du kannst jetzt noch aufgeben, ich gebe dir drei Sekunden Zeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100116
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100116,
					"content": "Drei, zwei, eins ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100117
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100117,
					"content": "Waaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100118,
					"content": "Nach einem metallischen „Klick“ wird alles ... wieder ruhig.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						765100119
					]
				},
				{
					"id": 765100119,
					"content": "So, kleine Paimon, du kannst jetzt die Augen öffnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100120
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100120,
					"content": "Na, hier ist wohl der nervöseste Mensch von allen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100121
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100121,
					"content": "W... Was? Wislawa ist tatsächlich wohlauf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100122,
						765100123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100122,
					"content": "Edler wollte Wislawa nur erschrecken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100124,
					"content": "Ja, ich möchte nicht auf einer Reise in einem fremden Gefängnis landen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100125
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100125,
					"content": "Ich musste mich mutig geben und stark auftreten, damit sie sieht, dass ich keine schwache Händlerin bin, die man einfach so herumschubsen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100126
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100126,
					"content": "Dann wird sie es sich beim nächsten Mal zweimal überlegen, bevor sie mir Ärger macht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100127
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100127,
					"content": "#Aber wie hast du das nur herausgefunden, {NICKNAME}! Du wirkst überhaupt nicht nervös.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100128,
						765100129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765100128,
					"content": "Edler sieht ganz entspannt aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100130,
					"content": "Du bist wirklich scharfsinnig. Einschüchterung ist in der Tat der schnellste Weg, jemanden zum Aufgeben zu bringen. Leider ist es nie so einfach, Abkürzungen zu nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100131
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100131,
					"content": "#Außerdem ist {NICKNAME} ja auch noch hier ... Jedenfalls stehe ich immer noch aufrecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100132
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100132,
					"content": "Ich hoffe nur, dass wir beim nächsten Treffen die Gelegenheit haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100133
					],
					"speakerTitle": "Wislawa"
				},
				{
					"id": 765100133,
					"content": "Ach nein, jemand wie ich kommt doch nicht oft dazu, einer so wichtigen Person wie dir zu begegnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100134
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100134,
					"content": "Wenn wir uns das nächste Mal während deiner Dienstzeit treffen und du etwas gegen mich unternehmen willst, dann muss ich mich eben in Notwehr verteidigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765100135
					],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100135,
					"content": "Wenn wir uns wieder in deinem Urlaub über den Weg laufen, spielen wir einfach eine Runde Kriegsspielsimulation, das wäre doch eine nette Unterstützung für mein kleines Geschäft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edler"
				},
				{
					"id": 765100129,
					"content": "Edler sagte, es kommt darauf an, „wer zuerst aufgibt“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100130
					]
				},
				{
					"id": 765100123,
					"content": "In der Muskete sind keine Kugeln.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100124
					]
				},
				{
					"id": 765100110,
					"content": "Wislawa sieht größer aus ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765100111
					]
				}
			]
		}
	]
}