					"Conulaf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750730101,
					"content": "#Oh, {F#meine Retterin}{M#mein Retter}! Vielen Dank, dass du diese Hilichurle beseitigt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730102
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730102,
					"content": "Ehrlich gesagt, ich habe nur die Aussicht vom Felsen genossen, als mich plötzlich ein Hilichurl bewusstlos geschlagen hat. Und als ich aufwachte, war ich hier eingesperrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730103
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730103,
					"content": "Eingesperrt ... der Schlüssel, oh, da drüben auf der Truhe! Könntest du mir einen kleinen Gefallen tun und ihn holen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730104
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730104,
					"content": "Ich wäre dir unendlich dankbar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
