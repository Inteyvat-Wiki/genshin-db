			},
			"dialogs": [
				{
					"id": 750730201,
					"content": "#Oh, {F#Retterin}{M#Retter}, an so einem hohen Ort, und überall fliegen diese Qucusaurier herum. Ihr könnt mich doch hier nicht einfach im Käfig lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
