			},
			"dialogs": [
				{
					"id": 750730301,
					"content": "*schluchz* Endlich bin ich diesem Käfig entkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730302
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730302,
					"content": "Dieser schaukelnde Heißluftballon ... Ein einziger Windstoß und wir stürzen in die Tiefe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730303
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730303,
					"content": "Dann könnte mir nicht mal Oma Itztli helfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730304
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730304,
					"content": "Wer bist du und was tust du hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730305
					]
				},
				{
					"id": 750730305,
					"content": "Verzeihung, ich habe vergessen, mich vorzustellen. Mein Name ist Conulaf, eine auszubildende Priesterin der „Meister des Nachtwinds“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730306
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730306,
					"content": "Ich bin gerade auf einer Pilgerreise als Teil meiner Ausbildung zur Priesterin ... Hm, davor habe ich mein ganzes Leben im Stamm verbracht, bis die Alten beschlossen: „Kind, die Welt ist groß, du musst hinaus!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730307
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730307,
					"content": "Und so haben sie mich hinausgeworfen, angeblich wegen einer Ausbildung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730308
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730308,
					"content": "#Aber von diesen Hilichurlen gefangen zu werden, das war wirklich nicht das, was ich mir erträumt hatte, nicht wahr, {F#meine Retterin}{M#mein Retter}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730309,
						750730311
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730309,
					"content": "Ganz allein herumzuziehen ... Das kann böse enden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730310
					]
				},
				{
					"id": 750730310,
					"content": "Ja, ohne dich, wer weiß, wie lange ich hier noch festgesessen hätte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730313,
					"content": "Wie auch immer, danke fürs Retten. Der Wind ist hier unerträglich. Lasst uns hinabsteigen und darüber nachdenken, wie ich meine Ausbildung fortsetzen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730314
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730314,
					"content": "Ich habe nicht viel Geld, aber meine Familie lehrte mich, jede Gnade zurückzugeben, also, nimm dies als Zeichen meiner Dankbarkeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730311,
					"content": "Man muss nur stark genug sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730312
					]
				},
				{
					"id": 750730312,
					"content": "#Hehe ... Aber so jemanden wie dich, {F#eine so starke Abenteurerin}{M#einen so starken Abenteurer}, gibt es nicht oft auf der Welt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "Conulaf"
				}
			]
		},
