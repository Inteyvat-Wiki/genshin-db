				"points": []
			},
			"dialogs": [
				{
					"id": 745300401,
					"content": "#Ah, {F#Meisterin}{M#Meister}! Du bist zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300402,
						745300403
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300402,
					"content": "Du scheinst echt gut drauf zu sein, Kachina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				},
				{
					"id": 745300404,
					"content": "Hihi, bei meiner Ausgrabung habe ich richtig tolle Erze gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300405
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300405,
					"content": "Wenn ich sie gut poliere, werden sie vielleicht zu wunderschönen, glitzernden Edelsteinen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300406
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300406,
					"content": "Super!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300407
					]
				},
				{
					"id": 745300407,
					"content": "Ja! Vorher hatte ich kaum etwas gefunden und dachte schon, ich müsste mit leeren Händen zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300408
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300408,
					"content": "Aber ich sagte mir, ich muss weitermachen ... noch ein bisschen tiefer graben, nur ein kleines Stück ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300409
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300409,
					"content": "Ich weiß nicht mehr, wie oft ich es versucht hatte, aber dann hatte ich endlich Erfolg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300410
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300410,
					"content": "Als ich fertig war, merkte ich, dass die Sonne schon fast untergegangen war ... Ich habe wohl versehentlich den ganzen Tag lang gegraben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300411,
						745300412
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300411,
					"content": "Echt typisch für dich, Kachina! Du hast wirklich Biss.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300413,
					"content": "Oh, wirklich? I... Ich werde vor der Kamera bestimmt verlegen ... Vielleicht wird das Foto ja gar nicht gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300414
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300414,
					"content": "Aber ... wenn es du gerne möchtest, werde ich mein Bestes geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300415,
						745300416
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300415,
					"content": "Du gibst dir schon größte Mühe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300417,
					"content": "Ah! Danke ... Dann lass ich dich einfach mal machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kachina"
				},
				{
					"id": 745300416,
					"content": "Kachina, so, wie du jetzt aussiehst, bist du perfekt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300412,
					"content": "Darf ich ein Foto von dir machen, da du gerade so strahlst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300403,
					"content": "Ist etwas Gutes passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				}
			]
		}
	]
