				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370501,
					"content": "#{NICKNAME}, ihr seid zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370502,
						710370510
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370502,
					"content": "Jinwu hat eine Bitte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370503
					]
				},
				{
					"id": 710370503,
					"content": "Schon wieder dieser Sicherheitshinweis, oder? Ich bin es so leid, das zu hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370504
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370504,
					"content": "Ich bin auch in den Minen aufgewachsen, wie könnte ich also die Gefahren der Minen nicht kennen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370505
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370505,
					"content": "Wenn es um Unbekanntes geht, stützen sich die Älteren immer so gern auf ihre Erfahrungen, um festzustellen, ob es gefährlich ist oder nicht ... und verwenden dann wiederum ihre Urteile, um ihre Erfahrungen zu rechtfertigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370506
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370506,
					"content": "Ich habe die Nase voll von ihrer Arroganz ... Ich bin sicher, dass es dir als Abenteurer genauso geht, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370507
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370507,
					"content": "Stell dir einfach vor, wie viele wundervolle Abenteuer du verpassen würdest, wenn du nicht zum Drachengrat gehen würdest, nur weil du Iris’ Sicherheitsvorträgen zugehört hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370508
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370508,
					"content": "Na gut, hör auf, mich zu überreden. Ich will mich nicht mit dir über eine so triviale Angelegenheit streiten ... Nun, lass uns das Thema wechseln, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370509
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370509,
					"content": "Schau mal, ich erkunde jetzt das Gelände hier, um es zu kartieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370512,
					"content": "Nur ... als ich vorhin die Minen erkundete, war der Weg durch mehrere seltsame Dinge versperrt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370513
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370513,
					"content": "Sowohl der Rat für Allgemeine Angelegenheiten als auch die Abenteurergilde würden sich freuen, wenn jemand ihnen eine Probe oder ein paar Fotos bringen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370514
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370514,
					"content": "Ich hätte es getan, aber ... ich habe meinen Fotoapparat beim Abstieg in die Minen verloren, also kann ich mich jetzt nur noch auf dich verlassen, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370515
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370515,
					"content": "Es gibt noch andere Orte ... na ja, hier und hier, wo es Spuren von Schatzräubern gibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370516
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370516,
					"content": "Was soll’s ... Paimon kann nicht einmal sehen, was es überhaupt ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370517,
					"content": "Nur ein paar Kreuzen und ein paar Strichen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370518
					]
				},
				{
					"id": 710370518,
					"content": "Haha, tut mir leid ... Ich gewöhne mich daran und vergesse, dass nicht jeder die Intuition eines Kartografen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370519
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370519,
					"content": "Aber das macht nichts, ich gehe mit dir mit und zeige euch den Weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370520
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370520,
					"content": "Sie sind im Grunde egal, wir können zu jedem dieser möglichen Orte gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370521,
						710370522
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370521,
					"content": "Gut, dann lass uns losgehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710370522,
					"content": "Aber du musst vorsichtig sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370523
					]
				},
				{
					"id": 710370523,
					"content": "Danke! Ich werde vorsichtig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370510,
					"content": "Was machst du hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370511
					]
				},
				{
					"id": 710370511,
					"content": "Ähm ... wie gesagt, ich habe das Gelände erkundet und kartiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
