			},
			"dialogs": [
				{
					"id": 710370601,
					"content": "Vielen Dank für deine Hilfe, nimm bitte dies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370602
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370602,
					"content": "Danke dir ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370603
					]
				},
				{
					"id": 710370603,
					"content": "Haha, du musst nicht so höflich sein, es ist sowieso Khedives Geld ... Pssst, nicht so laut, damit der Geizhals aus Sumeru dich nicht hört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370604
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370604,
					"content": "Entschuldigung, lass uns Jinwu suchen, ja? Viele der Fragen aus der vorangegangenen Reise könnten mit Hilfe ihrer Erfahrung beantwortet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370607
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370607,
					"content": "Gut, ich werde dich nicht aufhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
		{
