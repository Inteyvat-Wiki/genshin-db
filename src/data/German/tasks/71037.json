				7103702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103702",
							"2"
						],
						"stepId": 7103702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong",
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370101,
					"content": "Puh, es ist schon lange her, dass ich hier unten war ... Es ist die vertraute Luft in der Mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370102
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370102,
					"content": "Aber sei nicht unvorsichtig, Zhiqiong. Warum rieche ich jetzt etwas Unbekanntes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370103
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370103,
					"content": "Schließlich können wir nicht einfach abspringen ... Ein klappriger Kran ist zu ablenkend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370104
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370104,
					"content": "Du bist doch zu lange auf dem Boden gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370105,
					"content": "Paimon kann nichts riechen ... Seid ihr Bergleute alle so gut mit euren Nasen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370106,
					"content": "Haha, eine schlechte Nase in den Minen kann tödlich sein. Aber jetzt ist alles in Ordnung, der Fink ist immer noch gut gelaunt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370107,
					"content": "Sieh mal da drüben, die Lumenkristalle wachsen hier oben ... Als wir das letzte Mal in der Mine waren, reichten sie noch nicht hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370108
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370108,
					"content": "Wirklich? Gehen wir hin und sehen wir nach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370109
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370109,
					"content": "Nun ... Es fühlt sich so an, als ob jemand Paimons Worte geklaut hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7103702,
			"completionStepIds": [
				7103704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103704",
							"2"
						],
						"stepId": 7103704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370201,
					"content": "Ich hatte nicht erwartet, dass die Lumenkristalle so nahe am Boden auftauchen würden ... Ich glaubte, dass sie sich nicht an einem strukturell anfälligeren Ort ausbreiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370202
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370202,
					"content": "Sie sind Fragmente dieses „Ding“ im Untergrund, das entlang der Gesteinsadern gewandert ist und schließlich hier angekommen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370203
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370203,
					"content": "Rede keinen Blödsinn. Es handelt sich lediglich um lokale Gesteine, die so geworden sind, weil sie eine Art Umwandlungsprozess durchlaufen und Kristalle gebildet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370204
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370204,
					"content": "Die Qixing beauftragten uns mit einer Analyse ... Die Zusammensetzung ist immer noch größtenteils lokal aus der Großen Kluft, aber es ist nur ... dass äußere Kräfte sie in eine eigentümliche kristalline Form umgestaltet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370205
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370205,
					"content": "#Sieh mal, dieser Kristall sieht dem „Katalysator“ von {NICKNAME} ähnlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370231,
					"content": "#{NICKNAME}, kannst du uns den Lumenstein-Katalysator zeigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370232,
					"content": "Ja, der Lumenstein-Katalysator und dieser Kristall sind in der Tat ein und dasselbe. Sie haben die gleiche Struktur und stehen in natürlicher Resonanz zueinander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370206,
						710370207
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370206,
					"content": "Merkwürdig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				},
				{
					"id": 710370208,
					"content": "He, ist das alles, was du sagen kannst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370209,
					"content": "He, streitet euch bitte nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370210
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370210,
					"content": "Wir streiten nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370211
					]
				},
				{
					"id": 710370211,
					"content": "#{NICKNAME} und Paimon haben sich nicht gestritten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370212,
					"content": "Ich meine, es ist mir egal, ob ihr streitet oder nicht, Zhiqiong und ich werden hier ein provisorisches Lager für uns errichten, also geht in der Zwischenzeit bitte nirgendwo hin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370213
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370213,
					"content": "Die Kristalle, die wir gerade entdeckt haben, werden für die kommende Expedition sehr nützlich sein, also lasst mich bitte wissen, wenn ihr weitere Entdeckungen macht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370214
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370214,
					"content": "Mein Handwerk ist noch nicht eingerostet und ich kann diese Rohkristalle für euch verfeinern ... Nützlich für spätere Abenteuer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370215
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370215,
					"content": "Nun, das und ... streiten nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370216
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370216,
					"content": "Alles klar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370217,
					"content": "Verstanden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370218
					]
				},
				{
					"id": 710370218,
					"content": "Gut, ich gebe euch später Süßigkeiten. Übrigens, wenn euch hier etwas Seltsames auffällt, kommt bitte rechtzeitig zurück und meldet euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370219
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370219,
					"content": "Übrigens, was Jinwu letztes Mal über Onkel He sagte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370220
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370220,
					"content": "#Ich habe es nicht vergessen. Da {NICKNAME} auch hier ist, tu mir bitte noch einen Gefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370221
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370221,
					"content": "Onkel He ist ein ehemaliges Mitglied unseres Bergwerks und gehörte zu den Unglücklichen, die verschwanden, als die Bergleute vor einigen Jahren aus der Großen Kluft abgezogen wurden ... Er war ein bisschen taub und hat den Alarm wahrscheinlich nicht bemerkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370222
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370222,
					"content": "Die Versorgung der Huishan-Kammer und der Shenglu-Kammer sind ziemlich großzügig und seine Familie hat schon lange für seine Beerdigung gesorgt ... Aber ich kann es nicht glauben, ich habe das Gefühl, dass er immer noch irgendwo in der Mine lebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370223
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370223,
					"content": "Er ist ein erfahrener Bergmann ... Wie man eine Minenkatastrophe vermeidet, wie man entkommt, wie man auf Rettung wartet und so weiter ... Er weiß viel und hat mir viel beigebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370224
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370224,
					"content": "Ich bin mir also sicher, dass er nach all der Zeit noch irgendwo am Leben ist ... und wir können die Suche und Rettung nicht aufgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370225
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370225,
					"content": "Ich zeige dir später ein paar Durchgänge zu dem Ort, an dem Onkel He gearbeitet hat, bevor die Bergleute abgezogen wurden ... Vielleicht finden wir dort ein paar Hinweise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370226
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370226,
					"content": "Und ich mache mich auf, die Tiefen des Bergwerks zu erforschen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370233
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370233,
					"content": "Ah, vergesst eure Süßigkeiten nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370227,
						710370229
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370227,
					"content": "Kommst du nicht mit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370228
					]
				},
				{
					"id": 710370228,
					"content": "Sie müsste auch Karten für uns zeichnen und die Kompliziertheit der Struktur der Großen Kluft wären ohne sie nicht zu verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370229,
					"content": "Pass auf dich auf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370230
					]
				},
				{
					"id": 710370230,
					"content": "Schon in Ordnung, ich bin kein Anfänger mehr. Mach dir keine Sorgen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370207,
					"content": "Fantastisch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				}
			]
		},
		{
			"id": 7103703,
			"completionStepIds": [
				7103709
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103709",
							"2"
						],
						"stepId": 7103709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370301,
					"content": "Oh, ihr seid zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370302
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370302,
					"content": "Onkel He hat diese Nachrichten hinterlassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370303
					]
				},
				{
					"id": 710370303,
					"content": "Was? Er hat wirklich etwas hinterlassen! Komm schon, erzähl mir davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370306
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370306,
					"content": "Ihr erzählt Jinwu, was ihr gefunden habt.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710370304
					]
				},
				{
					"id": 710370304,
					"content": "Hmmm ... schwarzes „Magma“ ... Lumenstein ... Pilze ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370305
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370305,
					"content": "Hm ... Was für ein merkwürdiges Déjà-vu. Wir sollten uns hier nicht länger aufhalten. Lasst uns gemeinsam zum Lager gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7103704,
			"completionStepIds": [
				7103711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103711",
							"2"
						],
						"stepId": 7103711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370401,
					"content": "Das ist der Ort ... seltsam, wo ist Zhiqiong ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370402
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370402,
					"content": "Zhiqiong, Zhiqiong!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370403
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370403,
					"content": "Ja, das Kind ist wieder losgezogen, um in den Tiefen des Bergwerks eine Karte zu zeichnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370404,
						710370405
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370404,
					"content": "Was?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370407
					]
				},
				{
					"id": 710370407,
					"content": "Sie hat diese Karte gezeichnet, als ihr weggegangen seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370408
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370408,
					"content": "Sie sollte wieder in die Tiefe gehen. Bitte sagt ihr für mich, dass es gefährlich ist, und dass sie nicht das Risiko eingehen soll, alle zu verlassen und abzustürzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370409
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370409,
					"content": "... Wenn sie noch mehr Ärger macht und alle in den Abgrund zieht, wird Jinwus Faust keine Gnade walten lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370410
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370410,
					"content": "Ah, wie grausam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370411,
					"content": "So grausam ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370412
					]
				},
				{
					"id": 710370412,
					"content": "Na gut, seid auch nicht untätig. Entweder helft mir, das Lager einzurichten, oder geht vor und erkundet die Wege.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370413
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370413,
					"content": "Tut mir leid, ich bin nicht sehr gut darin, höflich zu sein ... Wie auch immer, seid wenigstens für alle nützlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370414
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370414,
					"content": "Ach, übrigens, wenn ihr auf eurem Weg rohe Lumenkristalle seht, bringt sie bitte mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370415
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370415,
					"content": "Ich werde sie zu einem wirksameren „Katalysator“ zu verarbeiten. Meiner Erfahrung nach wären diese in der Mine nützlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370405,
					"content": "Ist Zhiqiong in Gefahr?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370406
					]
				},
				{
					"id": 710370406,
					"content": "Noch nicht ... Hm, aber ihr Po ist in Gefahr, wenn sie wieder abhaut, ohne mich zu informieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370407
					],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7103705,
			"completionStepIds": [
				7103713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
