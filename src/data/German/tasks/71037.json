			"dialogs": [
				{
					"id": 710371101,
					"content": "Vielen Dank für deine Hilfe, nimm bitte dies.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371102
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371102,
					"content": "Danke dir ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710371103
					]
				},
				{
					"id": 710371103,
					"content": "Haha, du musst nicht so höflich sein, es ist sowieso Khedives Geld ... Pssst, nicht so laut, damit der Geizhals aus Sumeru dich nicht hört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371104
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371104,
					"content": "Entschuldigung, lass uns Jinwu suchen, ja? Viele der Fragen aus der vorangegangenen Reise könnten mit Hilfe ihrer Erfahrung beantwortet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371105
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371105,
					"content": "Genau wie du am Drachengrat ... Jinwu spricht nicht gern darüber, aber sie war eine Legende in den Minen, als sie jung war ... ähem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371106
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371106,
					"content": "Ich habe gehört, dass sie die Such- und Rettungstruppen der Millelithen geleitet und viele Bergleute aus gefährlichen Situationen gerettet hat ... Haha, aber ich werde diese alten Geschichten nicht erwähnen, damit sie nicht wütend wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371107,
					"content": "Gut, ich werde dich nicht aufhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				}
			]
		}
	]
}