			"dialogs": [
				{
					"id": 710370901,
					"content": "Wenn du zurückkommst, sollte Zhiqiongs Karte fast fertig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370902
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370902,
					"content": "Aber bis dahin muss ich darauf warten, dass die Transporttruppe von oben alle meine Werkzeuge herunterbringt, also könnt ihr in der Zwischenzeit gern auf Erkundungstour gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
