				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160501,
					"content": "Ich hatte Kontakt mit Francis. Er hat seine Warenlieferung erhalten – vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160502
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160502,
					"content": "Wann hast du das getan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160503
					]
				},
				{
					"id": 718160503,
					"content": "Haha, oh, keine Sorge. Wir Auftragswächter sind schneller auf den Beinen als so manch anderer. Und wenn es um Übergaben geht ... sind wir auch immer recht schnell zur Stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160504
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160504,
					"content": "Diese Fahrt ist dank deiner Hilfe sehr reibungslos verlaufen. Und nur, damit du Bescheid weißt ... ich bin ein Anhänger von gerechten Löhnen für alle. Also warte bitte einen Augenblick ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160505
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160505,
					"content": "Nimmst du dir nicht frei, um das Laternenritual zu feiern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160506
					]
				},
				{
					"id": 718160506,
					"content": "In unserer Branche weiß man nie genau, wann es Arbeit gibt. Nicht einmal während dem Laternenritual kann ich zu Hause sein ... Aber andererseits kann man da einfach nichts machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160507
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160507,
					"content": "Wenn du die Welt bereisen möchtest, solltest du auch in Liyue vorbeischauen, um das Ritual zu erleben. Zu dieser Zeit wird wohl wirklich jeder eine Laterne aufsteigen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160508,
						718160510
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160508,
					"content": "Was ist mit dir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160509
					]
				},
				{
					"id": 718160509,
					"content": "Oh, ich arbeite das ganze Jahr über außerhalb der Stadt. Ich hatte noch nie wirklich Zeit, um eine Laterne in den Himmel steigen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160512,
					"content": "Wenn ich eine Laterne hätte, die einsatzbereit ist, wäre es sicher schön, sie aufsteigen zu lassen, weil es Glück bringen soll. Aber ich hatte noch nie Zeit, um mir eine eigene Laterne zu basteln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160513
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160513,
					"content": "Natürlich vermisse ich diese festliche Stimmung, aber ich schätze, eigentlich macht das nichts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160514,
						718160515
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160514,
					"content": "Und wenn ich dir eine machen würde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
					]
				},
				{
					"id": 718160516,
					"content": "Wie? Du würdest mir eine Laterne besorgen? Du bist ... wirklich ein netter Mensch, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160515,
					"content": "Ich werde es natürlich tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
					]
				},
				{
					"id": 718160510,
					"content": "Hast du denn schon einmal eine Laterne in den Himmel steigen lassen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160511
					]
				},
				{
					"id": 718160511,
					"content": "Bis jetzt noch nicht. Reisende Wächter wie wir haben keine Zeit für solche Dinge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "Huangshan"
				}
			]
		},
		{
			"id": 7181607,
			"completionStepIds": [
				7181608
