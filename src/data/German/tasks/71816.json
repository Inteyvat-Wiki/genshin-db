	"talks": [
		{
			"id": 7181601,
			"completionStepIds": [
				7181601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181601",
							"2"
						],
						"stepId": 7181601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160101,
					"content": "Wie soll ich das nur ausliefern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160102
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160102,
					"content": "Stimmt etwas nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160103
					]
				},
				{
					"id": 718160103,
					"content": "#Du bist {F#eine Reisende}{M#ein Reisender}, wette ich. Und du hast großes Glück, dass du genau zu Beginn des Laternenrituals in Liyue angekommen bist. Ich aber habe nicht viel Zeit für Feierlichkeiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160104
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160104,
					"content": "Wir Einwohner von Liyue haben eine Tradition namens „Laternenritual“, bei dem wir Laternen in den Himmel steigen lassen. Deswegen gelangt hier jedes Jahr eine massive Menge an Laternen-Material über die Handelsrouten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160105
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160105,
					"content": "Und vielleicht bilde ich mir das nur ein, aber es fühlt sich so an, als wären dieses Jahr sogar noch mehr Waren unterwegs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160106
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160106,
					"content": "Für mich ist das alles gerade ein bisschen viel, und darüber hinaus hetzt mich die ganze Zeit dieser Händler, ohne Rücksicht auf den Zustand der Straßen in Liyue zu nehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160107
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160107,
					"content": "Ich spiele mit dem Gedanken, jemanden um Hilfe zu bitten, konnte aber bis jetzt niemanden finden, der geeignet wäre. Wärst du vielleicht an einer Arbeit als Begleiter interessiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160108,
						718160111
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160108,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160109
					]
				},
				{
					"id": 718160109,
					"content": "Toll! Ich mag Menschen, die unkompliziert sind. Wenn doch nur auch die Person, die wir begleiten, so wäre wie du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160110
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160110,
					"content": "Sein Name ist Fran... äh ... Francis. Oje, mit ausländischen Namen bin ich nicht wirklich gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160115,
					"content": "Wenn du aushelfen möchtest, kannst du mich an dem Ort treffen, wo die Waren eingelagert werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160116
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160116,
					"content": "Ich habe dir den Ort auf deiner Karte markiert. Ich gehe zuerst dorthin. Treffen wir uns einfach ein bisschen später.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160111,
					"content": "Ein Händler aus Fontaine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160112
					]
				},
				{
					"id": 718160112,
					"content": "Genau. Wie hieß er jetzt noch gleich ... Fran... Francis? Ach, ausländische Namen sind immer so schwierig zum Aussprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160113
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160113,
					"content": "Ich weiß auch ehrlich gesagt nicht, was er mit dermaßen vielen Waren vorhat, aber ... Na ja, solange er bezahlt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160114
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160114,
					"content": "Keine Sorge, ich werde dafür sorgen, dass du deinen fairen Anteil bekommst, sobald die Arbeit erledigt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "Huangshan"
				}
			]
		},
		{
			"id": 7181602,
			"completionStepIds": [
				7181603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181603",
							"2"
						],
						"stepId": 7181603,
						"stateName": "QUEST_STATE_UNFINISHED"
