				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huangshan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160201,
					"content": "Also, hier lagern wir unsere Waren ein. Es ist mir klar, dass du mir mit deiner Hilfe einen großen Gefallen tust, also musst du nur diesen einen Transportballon eskortieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160202
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160202,
					"content": "Aber vergiss nicht, dass dieser Ballon ein sehr zerbrechliches Material transportiert, das zum Herstellen von Laternen verwendet wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160203
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160203,
					"content": "Wenn es beschädigt oder verbrannt wird, ist es zu nichts mehr nutze. Gib also bitte gut acht auf deiner Reise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160204
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160204,
					"content": "Sei immer wachsam, denn auch Monster und Schatzräuber nehmen manchmal diesen Weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160205
					],
					"speakerTitle": "Huangshan"
				},
				{
					"id": 718160205,
					"content": "Nun, damit überlasse ich diese Sache jetzt dir. Sorge einfach dafür, dass diese Waren wohlbehalten bei Francis eintreffen, und triff dich danach mit mir bei der Brücke südwestlich des Chihu-Felsen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huangshan"
				}
			]
		},
		{
			"id": 7181603,
