			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Francis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160301,
					"content": "Wo sind nur meine Waren ... Mir knurrt schon richtig der Magen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Francis"
				}
			]
		},
		{
			"id": 7181604,
			"completionStepIds": [
				7181605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181605",
							"2"
						],
						"stepId": 7181605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Francis"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160401,
					"content": "Das sind ... die Waren, die ich bestellt habe. Meine Güte, endlich sind sie da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160402
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160402,
					"content": "Deiner Kleidung nach zu urteilen stammst du nicht aus Liyue, Freundchen. Habe ich recht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160403
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160403,
					"content": "Ah, mein Freundchen, ich weiß ja nicht, ob du schon das Privileg genossen hast, die Köstlichkeiten von Liyue probieren zu dürfen. Aber die sind wundervoll und wirklich einen Versuch wert, glaub es mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160404
					],
					"speakerTitle": "Francis"
				},
				{
					"id": 718160404,
					"content": "In Ordnung. Jetzt, wo meine Waren eingetroffen sind, kann ich wieder in Ruhe essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Francis"
				}
			]
		},
		{
			"id": 7181605,
			"completionStepIds": [
				7181610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
