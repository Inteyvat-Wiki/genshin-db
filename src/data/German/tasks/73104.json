			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan",
					"Helbet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040101,
					"content": "Bitte tu mir diesen Gefallen, ich brauche wirklich deine Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040102
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040102,
					"content": "Es gibt da nichts zu diskutieren, ich werde nicht nachgeben, bitte lass mich in Ruhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040103,
					"content": "Boah, weswegen streiten sich die beiden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040104,
					"content": "#He, {M#Fremder}{F#Fremde}, kannst du mal bitte für mich mit dieser Frau hier sprechen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040105
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040105,
					"content": "Sie ist heute ganz plötzlich aufgetaucht und nervt mich schon die ganze Zeit damit, dass ich irgendwelche Antiquitäten für sie aus dem Fluss angeln soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040106
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040106,
					"content": "Sie vertreibt mir nicht nur die Fische, sondern will mir auch noch den Rest meiner Zeit stehlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040107
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040107,
					"content": "Junge Frau, ist die Sache etwa so dringend, weil du mit den Antiquitäten einen großen Reibach machen willst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040108
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040108,
					"content": "Nein, Herr Kayvan, das ist nicht der Fall. Ich bin Helbet, eine Angestellte einer Partnerorganisation der Akademie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040109
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040109,
					"content": "Die Antiquitäten wurden von der Akademie für Forschungszwecke gesammelt, und ich bin für die Verwaltung von ihnen verantwortlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040110
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040110,
					"content": "Doch gestern hat sich ein Unfall auf dem Boot ereignet, das die Antiquitäten transportiert hat, und einige davon sind in den Fluss gefallen, woraufhin sie von der Strömung davongetragen wurden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040111
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040111,
					"content": "Dann heuer doch ein professionelles Bergungsunternehmen an! Was erwartest du von einem Angler wie mir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040112
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040112,
					"content": "Es würde zu lange dauern, ein Bergungsunternehmen zu finden, und ich habe einmal gehört, dass Herr Kayvan, den die Leute die „Perfektion am Angelhaken“ nennen, beinahe jeden Tag verlorene Dinge aus dem Fluss fischt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040113
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040113,
					"content": "Außerdem angelst du häufig in diesem Flussgebiet, daher will ich dich darum bitten, deine Angelrute auszuwerfen, vielleicht kriegst du ja einige der Antiquitäten an den Haken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040114,
						731040115
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040114,
					"content": "Da greifst du aber wirklich nach dem allerletzten Strohhalm ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040117
					]
				},
				{
					"id": 731040117,
					"content": "*hust* Frau Helbet, es ist ja nicht so, dass ich kein Verständnis für deine Lage hätte, aber ich bin nur ein einfacher Angler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040118
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040118,
					"content": "Ich werfe meine Angel nur aus, um Fische zu fangen, und Fische sind daher auch das Einzige, was ich an den Haken bekommen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040119
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040119,
					"content": "Du hast aber offensichtlich noch keinen einzigen gefangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040120,
					"content": "Ähm! Also mein ganzes Training ist auf das Fangen von Fischen ausgerichtet. Mir ist noch nie der Gedanke gekommen, dass ich meine Fähigkeiten dazu einsetzen könnte, etwas anderes zu fangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040121
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040121,
					"content": "Daher solltest du besser jemand anderen finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040122
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040122,
					"content": "Hmm, so ist das also?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040123
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040123,
					"content": "In diesem Fall ... Was würdest du dann davon halten, wenn ich dich einfach nur darum bitten würde, an einem anderen Ort zu angeln, anstatt nach Antiquitäten zu fischen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040124
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040124,
					"content": "Das wäre dann so, als ... als ob ich dir für das Angeln von Fischen Geld zahlen würde! Bitte, ich zähle auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040125
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040125,
					"content": "Ihr ... Ich bin ein Fischer! Ein Fischer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040126,
						731040127
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040126,
					"content": "An einem anderen Ort zu angeln, wäre sicher nicht schlecht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040128,
					"content": "Hier, ich habe die Bezahlung bereits vorbereitet. Bitte hilf mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040129
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040129,
					"content": "Ihr raubt mir wirklich den letzten Nerv ... Na schön, wenn es denn unbedingt sein muss. Wo soll ich also für dich angeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040130
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040130,
					"content": "Vielen Dank! Folge mir einfach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040131
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040131,
					"content": "#Genau wie zuvor, {M#Reisender}{F#Reisende}, will ich euch darum bitten, mir das Material für den Fischköder zu beschaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040132
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040132,
					"content": "Lasst mich nachdenken ... Dieses Mal werde ich Minze verwenden. Aber sie muss an einem ganz bestimmten Ort eingesammelt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040133
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040133,
					"content": "Ich markiere für dich die ungefähre Stelle auf der Karte, dann zähle ich auf dich! Deine Bezahlung halte ich bereit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040134
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040134,
					"content": "Ich werde jetzt erst einmal mit Frau Helbet zu dem Ort gehen, an dem ich für sie angeln soll. Wir treffen uns dort später.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040127,
					"content": "Es kommt doch andauernd vor, dass Fischern die verschiedensten Dinge an den Haken gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040115,
					"content": "Nun, wenn es Kayvan ist, der die Rute wirft ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040116
					]
				},
				{
					"id": 731040116,
					"content": "Ich werfe meine Angel nur aus, um große Fische zu fangen, ist das so schwer zu verstehen!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040117
					],
					"speakerTitle": "Kayvan"
				}
			]
		},
