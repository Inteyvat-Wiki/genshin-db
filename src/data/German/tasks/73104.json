					"Helbet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731041201,
					"content": "Es scheint alles in Ordnung zu sein. Zeit für den letzten Haken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041202
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041202,
					"content": "Das ist nun der dritte Versuch. Wenn doch nur wenigstens ein Fisch anbeißen würde, selbst wenn es nur ein daumengroßer wäre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041203
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041203,
					"content": "Kayvan stellt den Köder her und beginnt zu angeln ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731041204
					]
				},
				{
					"id": 731041204,
					"content": "Nach einiger Zeit zieht Kayvan das dritte nasse Paket aus dem Wasser.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731041205
					]
				},
				{
					"id": 731041205,
					"content": "Am besten schau es dir selbst an, ich will es gar mehr nicht sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041206
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041206,
					"content": "Gut! Lass mich mal sehen ... Es scheint in einem guten Zustand zu sein und ist völlig unbeschädigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041207
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041207,
					"content": "Einfach perfekt! Herr Kayvan, du bist es wirklich würdig, die „Perfektion am Angelhaken“ genannt zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041208
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041208,
					"content": "Ah, haha, solange du nur bekommen hast, was du willst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041209
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041209,
					"content": "Er hat tatsächlich in drei Versuchen alle drei Pakete aus dem Wasser gezogen und dabei keinen einzigen Fisch an den Haken bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041210,
						731041211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731041210,
					"content": "Das ist das, was Herr Kayvan so besonders macht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731041212
					]
				},
				{
					"id": 731041212,
					"content": "He! Ich wollte eigentlich die ganze Zeit einen großen Fisch fangen und habe mich kein bisschen für die Antiquitäten interessiert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041213
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041213,
					"content": "Meine Angeltechnik muss wohl miserabel sein oder ich werfe die Rute nicht mit genügend Kraft aus oder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041214
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041214,
					"content": "Aber ich habe die Angel so oft ausgeworfen, da hätte ich doch auch mit dem größten Pech einige Fische an den Haken bekommen müssen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041215
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041215,
					"content": "Aber bis jetzt habe ich noch keinen einzigen Fisch geangelt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041216
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041216,
					"content": "Hmm ... Da du es so sagst, das ist in der Tat etwas seltsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731041217,
					"content": "Hmm ... Herr Kayvan, wenn du daran interessiert bist, könnte ich dich mit einem Gelehrten bekannt machen, der sich auf die Erforschung des Angelns spezialisiert hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041218
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041218,
					"content": "Er war an dem Design von verschiedenen beliebten Ködern und Angelruten beteiligt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041219
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041219,
					"content": "Ich weiß zwar nicht, weswegen keine Fische bei dir anbeißen wollen, aber es kann sicher nicht schaden, einen Experten um seine Meinung zu bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041220
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041220,
					"content": "Möglicherweise hat dieser Gelehrte ja auch ein Interesse an dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041221
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041221,
					"content": "Ein Interesse an mir? Willst du damit sagen, dass er an meiner speziellen Fähigkeit, „alles außer Fisch an meinen Haken zu kriegen“, interessiert sein könnte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041222
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041222,
					"content": "Aber du hast ganz recht. Ich sollte diese Gelegenheit ausnutzen, um herauszufinden, was mit meiner Angeltechnik nicht stimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041223
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041223,
					"content": "Kein Problem. Ich werde das in die Wege leiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041224
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041224,
					"content": "Aber können Gelehrte, die ja bekanntlich Stubenhocker und Bücherwürmer sind, wirklich eine Sache wie das Angeln verstehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041225
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731041225,
