			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Helbet",
					"Kayvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040901,
					"content": "Ihr seid großartig! Vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040902
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040902,
					"content": "Sobald alle Antiquitäten gefunden wurden, werde ich einen Antrag auf ein Honorar stellen, um euch zu entlohnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040903
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040903,
					"content": "Du glaubst wohl tatsächlich, dass ich keinen echten großen Fisch angeln könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040904
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040904,
					"content": "Moment, ein großer Fisch hat angebissen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040905
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040905,
					"content": "Kayvan reißt mit Wucht die Angel hoch ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040906
					]
				},
				{
					"id": 731040906,
					"content": "Schon wieder ... irgend so ein Ding ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040907
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040907,
					"content": "Ah! Das ist das Paket mit der anderen Antiquität! Hervorragend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040908
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040908,
					"content": "Ich hätte nicht gedacht, dass das so einfach werden würde. Nun haben wir schon zwei Antiquitäten geborgen. Du hast dir deinen Ruf wirklich verdient, Herr Kayvan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040909
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040909,
					"content": "... Das mit dem „echten großen Fisch“ hätte ich nicht sagen sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040910
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040910,
					"content": "Im Fluss gibt es viele Fische, doch selten Antiquitäten. Hut ab!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040911
					]
				},
				{
					"id": 731040911,
					"content": "Aber ich habe keinen einzigen Fisch gefangen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040912
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040912,
					"content": "Kein Grund, den Kopf hängen zu lassen. Wir haben die Antiquitäten geborgen. Das ist eine gute Sache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040913,
					"content": "Der letzte ... Angelplatz ist in der Nähe von Vimara. Wir sollten uns so schnell wie möglich auf den Weg machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040914
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040914,
					"content": "Ja, ja, ich komme ja schon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040915
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040915,
					"content": "Wirklich merkwürdig. Stimmt etwas mit meiner Angeltechnik nicht oder liegt es am Köder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040916
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040916,
					"content": "#Wie auch immer, {M#Reisender}{F#Reisende}, dieses Mal will ich dich darum bitten, einige frische Zaytun-Pfirsiche zu sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040917
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040917,
					"content": "Da es sich um den letzten Ort handelt, will ich meinen Spezialköder verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040918
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040918,
					"content": "#{M#Reisender}{F#Reisende}, ich zähle auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				}
			]
		},
