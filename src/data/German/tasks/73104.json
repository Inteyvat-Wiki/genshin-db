			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan",
					"Helbet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040701,
					"content": "Also gut. Dann können wir mit dem zweiten Angeln beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040702
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040702,
					"content": "Ich muss mich konzentrieren. Bitte seid still ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040703
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040703,
					"content": "Mit konzentrierter Miene beginnt Kayvan zu angeln ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040704
					]
				},
				{
					"id": 731040704,
					"content": "Argh! Seht mal dort drüben! Die ganzen Schleime!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040705
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040705,
					"content": "Oh?! So etwas habe ich ja noch nie erlebt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040706,
						731040707
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040706,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040708
					]
				},
				{
					"id": 731040708,
					"content": "Warum gibt es nur immer so viel Ärger, wenn Herr Kayvan angeln geht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040707,
					"content": "Angle einfach weiter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040708
					]
				}
			]
		},
		{
			"id": 7310409,
			"completionStepIds": [
				7310409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
