						],
						"stepId": 7310404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kayvan",
					"Helbet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040401,
					"content": "Gute Arbeit, vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040402
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040402,
					"content": "Bitte beginn jetzt gleich mit dem Angeln, andernfalls könnten die Antiquitäten ... äh ... ich meine die Fische ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040403
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040403,
					"content": "Immer mit der Ruhe. Man muss den Rhythmus des Flusses fühlen und einen Zustand der inneren Ruhe erreichen, bevor man die Rute auswirft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040404
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040404,
					"content": "Dann wollen wir mal sehen, welche großen Fische man hier angeln kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040405
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040405,
					"content": "Kayvan stellt den Köder her und beginnt zu angeln ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040406
					]
				},
				{
					"id": 731040406,
					"content": "Nach langer Zeit des Wartens zieht Kayvan ein nasses Paket aus dem Wasser.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731040407
					]
				},
				{
					"id": 731040407,
					"content": "Was ist das ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040408
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040408,
					"content": "Das ist ... Lass mich mal sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040409
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040409,
					"content": "Hervorragend! Das ist eine der Antiquitäten, die ins Wasser gefallen sind! Sie ist unbeschädigt und da scheint auch kein Wasserlebewesen eingedrungen zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040410
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040410,
					"content": "Du hast tatsächlich eine Antiquität geangelt. Kein Wunder, dass man dich die „Perfektion am Angelhaken“ nennt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040411
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040411,
					"content": "Soll das ein Kompliment sein? Es macht mich kein bisschen glücklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040412
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040412,
					"content": "Also gut, wir haben die Antiquität am ersten Ort an Land gezogen. Der nächste ... Angelplatz ist nicht weit von hier in westlicher Richtung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040413
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040413,
					"content": "*seufz* Dann lass uns schnell aufbrechen. Ich will so schnell wie möglich zurück, um ungestört angeln zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040414
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040414,
					"content": "Kein Problem, folge mir bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040415
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040415,
					"content": "#{M#Reisender}{F#Reisende}, dieses Mal brauche ich Harra-Frucht als besonderes Material. Mein Instinkt sagt mir, dass das die beste Wahl ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040416
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040416,
					"content": "Ich kenne einen Ort, an dem die Harra-Frucht besonders gut ist. Ich markiere ihn für dich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040417
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040417,
					"content": "Wir sollten schon mal losgehen, wir sehen uns dann am nächsten Angelplatz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				}
			]
		},
