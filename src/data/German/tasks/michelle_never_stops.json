			"dialogs": [
				{
					"id": 200430401,
					"content": "Hast du <color=#00E1FFFF>Dämmerfrüchte</color> gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430402
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430402,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430403
					]
				},
				{
					"id": 200430403,
					"content": "Außerhalb der Stadt sollte es viele <color=#00E1FFFF>Dämmerfrüchte</color> geben. Ich werde solange auf den Laden aufpassen. Komm bitte schnell wieder zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
