					"Quinn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200430301,
					"content": "Wie lange soll ich denn noch warten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430302
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430302,
					"content": "Was ist passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430303
					]
				},
				{
					"id": 200430303,
					"content": "Ach, wir haben keine Dämmerfrüchte mehr. Deswegen habe ich einige Ladungen bestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430304
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430304,
					"content": "Doch bis jetzt ist noch keine einzige eingetroffen ... Ich habe viele Kunden, die allein wegen der Dämmerfrüchte kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430305
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430305,
					"content": "Allein Eury ist schon dreimal hier gewesen. Sie wollte einfach nur <color=#00E1FFFF>drei Dämmerfrüchte</color>. Natürlich will ich eine Stammkundin wie sie nicht verlieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430306
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430306,
					"content": "Ich muss ja auf den Laden aufpassen. Wenn ich nur jemanden hätte, der ein paar Dämmerfrüchte sammeln könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430307,
						200430309
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430307,
					"content": "Wenn es wirklich so dringend ist, könnte ich helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430308
					]
				},
				{
					"id": 200430308,
					"content": "Das würdest du tun? Das wäre großartig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430309,
					"content": "Michelle kommt gleich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430310
					]
				},
				{
					"id": 200430310,
					"content": "Warte! Wie soll Michelle denn in der Verfassung Obst ernten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430311,
					"content": "Wir sollten mit anpacken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
