			},
			"dialogs": [
				{
					"id": 200430601,
					"content": "Habt ihr Quinn gefragt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430602
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430602,
					"content": "Ja, er meint, dass du wieder nach Hause kannst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430603
					]
				},
				{
					"id": 200430603,
					"content": "Im Laden gibt es heute nichts weiter zu tun. Deswegen kannst du dich ausruhen gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430604,
					"content": "Oh, na dann werde ich mir eine andere Beschäftigung suchen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430605
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430605,
					"content": "Ach, gehst du dich denn nicht ausruhen? Jetzt musst du doch nicht mehr arbeiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430606,
					"content": "Seht euch doch einfach mal um. Die Winde von Barbatos wehen immer noch fleißig und machen auch keine Pause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430607
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430607,
					"content": "Wir, gesegnet von Barbatos, können auch nicht faul auf der Haut liegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430608
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430608,
					"content": "Was hast du eigentlich gemacht? Warum schwitzt du denn so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430609
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430609,
					"content": "Sieht aus, als wärst auch du sehr beschäftigt. Es ist gut, wenn man sich anstrengt. Nur mit dem Schweiß von all der Arbeit spürt man den Wind, den Barbatos schickt, erst richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430610
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430610,
					"content": "Hier hast du eine Flasche Milch. Danach hast du wieder Kraft, deiner Arbeit nachzugehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michelle"
				}
			]
		},
