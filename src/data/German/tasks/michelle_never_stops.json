				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200430101,
					"content": "Aua, mein Rücken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430102
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430102,
					"content": "Was ist denn passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430103
					]
				},
				{
					"id": 200430103,
					"content": "Ich bereite mich gerade auf meine Arbeit vor und da schmerzt plötzlich mein Rücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430104
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430104,
					"content": "Ich habe Quinn versprochen, heute bei seinem Obststand auszuhelfen. Jetzt muss ich mich aber erst etwas ausruhen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430105
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430105,
					"content": "Ach, wenn ich hierbleibe, verschwende ich aber auch nur Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430106
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430106,
					"content": "Kannst du Quinn womöglich fragen, was ich für ihn tun könnte? Dann kann ich mich schon darauf vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430107,
						200430109
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430107,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430108
					]
				},
				{
					"id": 200430108,
					"content": "Dankeschön! Ich ruhe mich nur etwas aus solange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430109,
					"content": "Es ist ja auch nicht weit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430110
					]
				},
				{
					"id": 200430110,
					"content": "Komm schon, der kleine Gefallen. Das hast du doch im Nu erledigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
