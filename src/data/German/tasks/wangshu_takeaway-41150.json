			"dialogs": [
				{
					"id": 411500301,
					"content": "Ich habe gehört, es gibt eine Sonderbestellung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411500302
					]
				},
				{
					"id": 411500302,
					"content": "Also, es ist so: Die hohlköpfige Lingguan hat eine Schüssel Buntes bestellt, die sie später essen wollte. Doch ich könnte wetten, dass sie sich wieder mal irgendwo verirrt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500303
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 411500303,
					"content": "Bring ihr das hier. <color=#00E1FFFF>Und schön ruhig bleiben, renn nicht ziellos in der Gegend herum</color>, sonst verschüttest du es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500304
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 411500304,
					"content": "<color=#00E1FFFF>Und fass keinen Elementarkram an, das bringt den Geschmack durcheinander</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500305
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 411500305,
					"content": "Wenn es verdirbt, komm zu mir zurück. Dann gebe ich dir eine weitere Portion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lächelnder Yanxiao"
				}
			]
