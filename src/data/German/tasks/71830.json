			},
			"dialogs": [
				{
					"id": 718300301,
					"content": "Langsam abbauen, langsam abbauen! Nicht die Statue beschädigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300302
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300302,
					"content": "Leider sieht es so aus, als würde es eine Weile dauern, bis es gebaut ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping’an"
				}
			]
		},
		{
			"id": 7183004,
			"completionStepIds": [
				7183004
