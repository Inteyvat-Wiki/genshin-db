			},
			"dialogs": [
				{
					"id": 718300601,
					"content": "Dann nehme ich das <color=#00E1FFFF>Dürrsandholz</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300602
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300602,
					"content": "Es wird noch einige Zeit dauern, bis dieser Tempel fertig ist, und ich werde in der Zwischenzeit hier bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300603
					],
