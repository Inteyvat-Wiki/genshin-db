			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang Ping’an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300201,
					"content": "Das ist eine Menge Arbeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300202
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300202,
					"content": "Du renovierst wirklich den Tempel ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300203
					]
				},
				{
					"id": 718300203,
					"content": "Du bist es. Aber klar, ich habe gesagt, dass ich ein anständiger Mensch bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300204
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300204,
					"content": "Trotzdem hatte ich nicht erwartet, dass der Aufwand so groß sein würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300205
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300205,
					"content": "Der Meister, der das Haus entworfen hat, war begeistert, als er hörte, dass es sich um einen dem „Yaksha“ geweihten Tempel handelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300206
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300206,
					"content": "Er hat nicht nur einen riesigen Stapel von Entwürfen gezeichnet, sondern war auch mit dem Einkauf von Materialien beschäftigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300207
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300207,
					"content": "Ich glaube, wenn er ein paar Jahrzehnte jünger wäre, wäre er vorbeigekommen und hätte ihn selbst repariert...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300208,
						718300210
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300208,
					"content": "Du bist doch nicht in Gefahr geraten, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300209
					]
				},
				{
					"id": 718300209,
					"content": "Gefahr? Oh, du meinst Monster und Schatzräuber, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300212,
					"content": "Als sie hörten, dass ich den Tempel für den Yaksha renovieren wollte, schickte der Rat für Allgemeine Angelegenheiten einige Mitglieder der Millelithen zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300213
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300213,
					"content": "Alle Monster in der Umgebung wurden im Grunde genommen von diesen wenigen Millelithen vertrieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300214
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300214,
					"content": "Was die Gruppe der Schatzräuber betrifft, so würden sie sich wahrscheinlich nicht trauen, ihren Kopf zu zeigen, wenn sie die Millelithen hier sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300215
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300215,
					"content": "Der Arbeitsaufwand für die Reparatur des Tempels überstieg jedoch meine Vorstellungskraft und die ursprünglich vorbereiteten Materialien reichten nicht aus, sodass wir weitere Materialien aus der Stadt heranschaffen mussten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300216
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300216,
					"content": "Ich denke ... obwohl diese Gruppe von Schatzräubern es nicht wagen würde, das Gelände anzugreifen, könnten sie auf der Straße auf der Lauer liegen, um die herbeigeschafften Materialien zu rauben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300217
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300217,
					"content": "Zwar können die Millelithen den Ort halten, doch wenn die Materialträger von den Schatzräubern auf der Straße angegriffen würden, wären die Millelithen sicher nicht in der Lage, rechtzeitig zur Hilfe zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300218
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300218,
					"content": "#{F#Reisende}{M#Reisender}, darf ich dich um einen Gefallen bitten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300219
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300219,
					"content": "Ich weiß, dass du sehr gut in deinem Beruf bist, und du wirst mit diesen Schatzräubern fertig werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300220
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300220,
					"content": "Könntest du bitte herumgehen und dieser Gruppe von Schatzräubern eine Lektion erteilen, bevor diese Typen uns in die Quere kommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300221,
						718300223
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300221,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300222
					]
				},
				{
					"id": 718300222,
					"content": "Oh, danke dir, dank dir vielmals!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300223,
					"content": "Wieso können die Millelithen nicht hingehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300224
					]
				},
				{
					"id": 718300224,
					"content": "Sie haben schon so viel zu tun, indem sie den Ort hier bewachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300225
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300225,
					"content": "Also, vielen Dank im Voraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300210,
					"content": "Ich erinnere mich, dass die Gegend nicht sehr sicher war ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300211
					]
				},
				{
					"id": 718300211,
					"content": "Du meinst, dass es hier Monster und Schatzräuber gibt, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping’an"
				}
			]
		},
		{
