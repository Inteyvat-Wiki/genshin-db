			},
			"dialogs": [
				{
					"id": 718300701,
					"content": "Ihr seid zurück, gibt es hier irgendwelche Schatzräuber in der Nähe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300702
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300702,
					"content": "Gut, wenn sie weg sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300703
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300703,
					"content": "Können wir sonst noch etwas tun, um zu helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300704
					]
				},
				{
					"id": 718300704,
					"content": "Hahaha, ich danke euch für die Freundlichkeit, aber ihr habt mir so sehr geholfen, dass ich euch nicht weiter belasten kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300705
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300705,
					"content": "Aber wenn du möchtest, kannst du mir etwas <color=#00E1FFFF>Dürrsandholz</color> besorgen, damit du tatsächlich am Bau des Tempels teilnehmen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300706
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300706,
					"content": "Es ist eine gute Tat, einen Tempel zu bauen, und du kannst gesegnet werden, wenn du selbst daran teilnimmst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300707,
						718300709
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300707,
					"content": "Ich werde ein wenig suchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300708
					]
				},
				{
					"id": 718300708,
					"content": "Hahaha, gut. Wenn du <color=#00E1FFFF>Dürrsandholz</color> findest, bring es einfach zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300709,
					"content": "Hat noch jemand Material für die Reparatur des Tempels gespendet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300710
					]
				},
				{
					"id": 718300710,
					"content": "Nun, um ehrlich zu sein, waren es nicht wirklich viele Leute. Schließlich liegt er mitten im Nirgendwo und die meisten Leute wissen nicht einmal, dass es hier einen Tempel gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300711
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300711,
					"content": "Außerdem erinnern sich nicht mehr viele Menschen an Pervases ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300712
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 718300712,
					"content": "Nun, genug davon. Wenn du <color=#00E1FFFF>Dürrsandholz</color> gefunden hast, bring es mir einfach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping’an"
				}
			]
		},
