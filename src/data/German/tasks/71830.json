							"7183004",
							"2"
						],
						"stepId": 7183004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anführer der Schatzräuber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300401,
					"content": "#Halt ein, Held{F#in}! Wir geben uns geschlagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300402,
						718300403
					],
					"speakerTitle": "Anführer der Schatzräuber"
				},
				{
					"id": 718300402,
					"content": "Packt zusammen und verschwindet von hier!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				},
				{
					"id": 718300404,
					"content": "Ja. Ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300405
					],
					"speakerTitle": "Anführer der Schatzräuber"
				},
				{
					"id": 718300405,
					"content": "#Aber ich frage mich ... Inwiefern haben wir dich gestört, Held{F#in}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300406
					],
					"speakerTitle": "Anführer der Schatzräuber"
				},
				{
					"id": 718300406,
					"content": "Hast du zufällig einen Schatz in dieser Gegend gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300407
					],
					"speakerTitle": "Anführer der Schatzräuber"
				},
				{
					"id": 718300407,
					"content": "Wir sind dabei, den Tempel in der Nähe zu reparieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300408
					]
				},
				{
					"id": 718300408,
					"content": "Reparieren, einen Tempel reparieren? Wie könnte ein Held hier, mitten im Nirgendwo, einen Tempel reparieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300409
					],
					"speakerTitle": "Anführer der Schatzräuber"
				},
				{
					"id": 718300409,
					"content": "Das hier ... Gibt es hier tatsächlich den Tempel eines Adepten? Moment mal, könnte das kaputte Haus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300410
					],
					"speakerTitle": "Anführer der Schatzräuber"
				},
				{
					"id": 718300410,
					"content": "Boss, als wir das letzte Mal dort waren, um eine Pause zu machen, habe ich eine Vogelstatue gesehen, das wird doch wohl nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300411
					],
					"speakerTitle": "Handlanger der Schatzräuber"
				},
				{
					"id": 718300411,
					"content": "Das ist Pervases, der Yaksha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300412
					]
				},
				{
					"id": 718300412,
					"content": "Was!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300413
					],
					"speakerTitle": "Anführer der Schatzräuber"
				},
				{
					"id": 718300413,
					"content": "Boss! Haben wir den Adepten beleidigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300414
					],
					"speakerTitle": "Handlanger der Schatzräuber"
				},
				{
					"id": 718300414,
					"content": "Nein, redet keinen Blödsinn! Wir wussten es vorher nicht, es war ... es war ein versehentlicher Fehler! Der Adept sollte ... sollte uns nicht die Schuld geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300415
					],
					"speakerTitle": "Anführer der Schatzräuber"
				},
				{
					"id": 718300415,
					"content": "#Held{F#in}! Die Sache mit der Reparatur des Tempels für den Adepten ist uns nun bekannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300416
					],
					"speakerTitle": "Anführer der Schatzräuber"
				},
				{
					"id": 718300416,
					"content": "Das vorhin war unsere Schuld. Wir bitten den Adepten um Verzeihung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300417
					],
					"speakerTitle": "Anführer der Schatzräuber"
				},
				{
					"id": 718300417,
					"content": "Wir werden zurückkehren und unseren Kumpanen in der Gegend sagen, dass sie sich von diesem Tempel fernhalten sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300418
					],
					"speakerTitle": "Anführer der Schatzräuber"
				},
				{
					"id": 718300418,
					"content": "Boss, sollten wir uns die Zeit nehmen, dorthin zu gehen und ein paar Räucherstäbchen anzuzünden, um den Adepten zu besänftigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300419
					],
					"speakerTitle": "Handlanger der Schatzräuber"
				},
				{
					"id": 718300419,
					"content": "Halt die Klappe! Gehen wir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anführer der Schatzräuber"
				},
				{
					"id": 718300403,
					"content": "Bleib in Zukunft weg von hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				}
			]
		},
