			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750240701,
					"content": "(Ein Tagebuch liegt dort ... )",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240702,
						750240706,
						750240710,
						750240714
					]
				},
				{
					"id": 750240702,
					"content": "(Ersten Teil lesen)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240703
					]
				},
				{
					"id": 750240703,
					"content": "„... Heute regnet es. Ich habe für Platsch sein Lieblingsessen, <color=#00E1FFFF>Pökelfisch in saurer Sauce</color>, zubereitet. Wenn ich seinen zufriedenen Gesichtsausdruck sehe, ist es all die Mühe wert ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240704
					],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240704,
					"content": "„... Selbst wenn er eigentlich nur gemütlich umherschwimmt, sobald ich <color=#00E1FFFF>Pökelfisch in saurer Sauce</color> serviere, springt er aus dem Wasser heraus. Die Flugbahn kann als absolut perfekt bezeichnet werden!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240705
					],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240705,
					"content": "„... Ich zweifle nicht an seiner Liebe für mich. Ich habe nur etwas die Sorge, dass er <color=#00E1FFFF>Pökelfisch in saurer Sauce</color> noch mehr mag als mich ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240706,
					"content": "(Zweiten Teil lesen)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240707
					]
				},
				{
					"id": 750240707,
					"content": "„... Runde Augen, ein Ringelschwanz, ein kräftiges, freudiges Brüllen ... Jade, o Jade. Kann es auf der Welt einen noch niedlicheren kleinen Saurier als dich geben ...?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240708
					],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240708,
					"content": "„... Er wurde noch nie übers Ohr gehauen und glaubt alle Dinge völlig vertrauensselig. Es scheint, dass er sich mit allen Wesen auf der Erde anfreunden und mit ihnen gemeinsam Spaß haben kann ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240709
					],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240709,
					"content": "„... Wenn ich nicht so viel zu tun hätte, würde ich mich gern den ganzen Tag mit dir gemeinsam amüsieren. Dich anschauen, wie du im Wald, in dem die Sonne scheint, wie der Wind umherflitzt, völlig sorgenfrei!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240710,
					"content": "(Dritten Teil lesen)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240711
					]
				},
				{
					"id": 750240711,
					"content": "„... Ich bin über Hügel und durch Täler gereist, nur um dir auf die Spur zu kommen. Aber wenn du mich wirklich nicht magst, kannst du auch einfach gehen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240712
					],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240712,
					"content": "„... Aber du folgst genau meinem Laufrhythmus und sammelst sogar eine Menge Kornfrüchte und diese leuchtenden Steine für mich ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240713
					],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240713,
					"content": "„... Meine liebe Marigold. Nur ich weiß, dass sich unter deiner harten Schale ein weiches Herz befindet. Es liegt nicht in deiner Natur, kämpferisch und wild zu sein ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240714,
					"content": "(Besser nicht weiterlesen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
