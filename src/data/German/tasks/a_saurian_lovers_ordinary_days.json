			"dialogs": [
				{
					"id": 750240601,
					"content": "*brüll* ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240602
					],
					"speakerTitle": "„Marigold“"
				},
				{
					"id": 750240602,
					"content": "Bleib ruhig, wir machen uns nur Sorgen, ob die Person verletzt wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240603,
						750240605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240603,
					"content": "Scheint, als wäre ein Duell unvermeidlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240604
					]
				},
				{
					"id": 750240604,
					"content": "Gib nicht so schnell auf! Kleine Marigold, wir haben keine bösen Absichten, wir wissen auch, dass es absolut nicht deine Absicht ist ... so aggressiv zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240606,
					"content": "*krächz*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240607
					],
					"speakerTitle": "„Marigold“"
				},
				{
					"id": 750240607,
					"content": "Waaah ... Warum wird sie noch wütender?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240605,
					"content": "„Meine liebe Marigold ...“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240606
					]
				}
			]
		},
		{
