			"dialogs": [
				{
					"id": 750240101,
					"content": "Meine Freunde, eure Begeisterung ... macht mich einfach sprachlos, puh ... Esst erstmal ein Eis und beruhigt euch etwas. Danach plaudern wir in aller Ruhe, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240102
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240102,
					"content": "*brüll* ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240103
					],
					"speakerTitle": "„Marigold“"
				},
				{
					"id": 750240103,
					"content": "Zunächst hast du ein Schreien mit dem Laut „Autsch“ gehört, gefolgt von dem dumpfen Laut von etwas Schwerem, was auf den Boden gefallen ist. Danach war nur noch das Sauriergeheul zu hören ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240104
					]
				},
				{
					"id": 750240104,
					"content": "Huch?! Es ist doch wohl nichts Schlimmes passiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240105,
					"content": "Hmm ... Sie sind da ganz eng zusammengequetscht. Paimon weiß nicht, wie der Person da geht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240106,
					"content": "Soll Paimon von oben einen Blick darauf werfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240107
					]
				},
				{
					"id": 750240107,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240108,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} sagt anscheinend, dass man es ihn versuchen lassen soll. Dann überlassen wir es ihm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240109,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240110,
					"content": "Ähm, die Situation sieht nicht so gut aus, oder? Diese Person wird doch wohl nicht umkommen ... Gut möglich, dass er nur das Bewusstsein verloren hat. Aber ganz gleich was passiert ist, können wir nicht einfach tatenlos herumstehen und nicht helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240111,
					"content": "Ähm ... Könnt ihr drei Paimon mal durchlassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240112,
					"content": "*krächz*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240113
					],
					"speakerTitle": "„Marigold“"
				},
				{
					"id": 750240113,
					"content": "*brüll* ... *brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240114
					],
					"speakerTitle": "„Platsch“"
				},
				{
					"id": 750240114,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240115
					],
					"speakerTitle": "„Jade“"
				},
				{
					"id": 750240115,
					"content": "Mensch, sie wollen einfach keinen Platz machen ... Was ist da eigentlich los? Nach dem, was wir von der Person gehört haben, könnte er die Saurier kennen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240116,
					"content": "Es wäre besser, wenn es noch mehr Hinweise gäbe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240117,
					"content": "... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240118,
					"content": "#Huch? {REALNAME[ID(2)|SHOWHOST(true)]}! Hast du etwas entdeckt? Lasst uns dem Ganzen schnell folgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7502402,
			"completionStepIds": [
				7502402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7502402",
							"2"
						],
						"stepId": 7502402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2030.073,
							74.78,
							8497.404
						],
						"pointId": 8382
					},
					{
						"sceneId": 3,
						"position": [
							-2032.248,
							74.7,
							8496.88
						],
						"pointId": 9621
					}
				]
			},
			"dialogs": [
				{
					"id": 750240201,
					"content": "„... Heute regnet es. Ich habe für Platsch sein Lieblingsessen, <color=#00E1FFFF>Pökelfisch in saurer Sauce</color>, zubereitet. Wenn ich seinen zufriedenen Gesichtsausdruck sehe, ist es all die Mühe wert ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240202
					],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240202,
					"content": "„... Selbst wenn er eigentlich nur gemütlich umherschwimmt, sobald ich <color=#00E1FFFF>Pökelfisch in saurer Sauce</color> serviere, springt er aus dem Wasser heraus. Die Flugbahn kann als absolut perfekt bezeichnet werden!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240203
					],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240203,
					"content": "„... Ich zweifle nicht an seiner Liebe für mich. Ich habe nur etwas die Sorge, dass er <color=#00E1FFFF>Pökelfisch in saurer Sauce</color> noch mehr mag als mich ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240204
					],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240204,
					"content": "Platsch ... Er meint wohl den Koholasaurier. Der Pökelfisch in saurer Sauce, der im Topf des Lagers gekocht wird, wird bestimmt für ihn zubereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240205,
					"content": "„... Runde Augen, ein Ringelschwanz, ein kräftiges, freudiges Brüllen ... Jade, o Jade. Kann es auf der Welt einen noch niedlicheren kleinen Saurier als dich geben ...?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240206
					],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240206,
					"content": "„... Er wurde noch nie übers Ohr gehauen und glaubt alle Dinge völlig vertrauensselig. Es scheint, dass er sich mit allen Wesen auf der Erde anfreunden und mit ihnen gemeinsam Spaß haben kann ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240207
					],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240207,
					"content": "„... Wenn ich nicht so viel zu tun hätte, würde ich mich gern den ganzen Tag mit dir gemeinsam amüsieren. Dich anschauen, wie du im Wald, in dem die Sonne scheint, wie der Wind umherflitzt, völlig sorgenfrei!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240208
					],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240208,
					"content": "#Hmm, es scheint, dass der kleine Yumkasaurier, der den Namen Jade trägt, ein verspielter kleiner Saurier ist. Es ist gut möglich, dass du, {REALNAME[ID(2)|SHOWHOST(true)]}, dich auch mit ihm anfreunden wirst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240209,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240210,
					"content": "„... Ich bin über Hügel und durch Täler gereist, nur um dir auf die Spur zu kommen. Aber wenn du mich wirklich nicht magst, kannst du auch einfach gehen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240211
					],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240211,
					"content": "„... Aber du folgst genau meinem Laufrhythmus und sammelst sogar eine Menge Kornfrüchte und diese leuchtenden Steine für mich ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240212
					],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240212,
					"content": "„... Meine liebe Marigold. Nur ich weiß, dass sich unter deiner harten Schale ein weiches Herz befindet. Es liegt nicht in deiner Natur, kämpferisch und wild zu sein ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240213
					],
					"speakerTitle": "Tagebuch eines Unbekannten"
				},
				{
					"id": 750240213,
					"content": "Hmm ... Ist Marigold also dieser ungestüme Tepetlisaurier, der wild und aggressiv die Leute umstößt? Da ist nicht die Spur von Sanftheit zu erkennen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240214,
					"content": "Aber diese drei Saurier sind alle seine ... Freunde? Warum haben sie ihn bewusstlosgehauen und stehen um ihn herum ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240215,
					"content": "Wir sollten ihn erst retten und dann die Fragen stellen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240216
					]
				},
				{
					"id": 750240216,
					"content": "Das stimmt. Es wäre besser, wenn die Saurier Platz machen würden ... Ach so, steht im Tagebuch nicht, dass Platsch gern Pökelfisch in saurer Sauce isst? Es trifft sich gut, dass es davon was im Lager gibt. Es ist gut möglich, dass wir ihn fortlocken können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240217,
						750240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240217,
					"content": "#Und {REALNAME[ID(2)|SHOWHOST(true)]} kann sich mit Jade anfreunden, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240218
					]
				},
				{
					"id": 750240218,
					"content": "#Hmm, Jade ist sehr verspielt. {REALNAME[ID(2)|SHOWHOST(true)]} muss ihn nur mit sich nehmen und in der Nähe spielen und alles ist in Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240221,
					"content": "*brüll*! *brüll* *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240222
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240222,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} strotzt auch vor Energie! Aber lass uns erst einmal die einfachste Methode versuchen. Wäre es nicht eine Verschwendung, den Pökelfisch in saurer Sauce nicht zu essen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240219,
					"content": "Wir könnten Marigold zum Duell herausfordern!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240220
					]
				},
				{
					"id": 750240220,
					"content": "#Wir sollten erst eine friedliche Aktion versuchen. Zum Beispiel {REALNAME[ID(2)|SHOWHOST(true)]} die verspielte Jade weglocken zu lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240221
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
