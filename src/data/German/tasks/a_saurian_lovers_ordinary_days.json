			"dialogs": [
				{
					"id": 750240822,
					"content": "Der als „Marigold“ bezeichnete Tepetlisaurier hat sich nach seiner Niederlage im Duell in den Boden verkrochen, niemand weiß, wo er sich versteckt hat. In der Zwischenzeit schaut ihr schnell nach der verletzten Person ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240801
					]
				},
				{
					"id": 750240801,
					"content": "Es scheint keine offensichtlichen Verletzungen zu geben ... He ... Geht es dir gut?? Kannst du Paimon hören?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240802,
					"content": "... Hm, Marigold? Sorgst du dich um mich? Du bist wirklich weichherzig. Mach dir keine Sorgen. Um sorgenfrei mit dir spielen zu können, habe ich in letzter Zeit hart trainiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240803
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240803,
					"content": "#Paimon ist Paimon, nicht irgendeine Marigold! {NICKNAME}, denkst du, dieser Typ hat sich den Kopf gestoßen, als er gefallen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240804,
						750240805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240804,
					"content": "Vielleicht kommt er später wieder zur Besinnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240806
					]
				},
				{
					"id": 750240806,
					"content": "Hä, was? Du bist ... nicht Marigold ... Was ist mit mir passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240807
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240807,
					"content": "Du erzählst ihm, wie er von drei Sauriern umzingelt und von „Marigold“ niedergeschlagen wurde ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240808
					]
				},
				{
					"id": 750240808,
					"content": "Also so war das, es tut mir leid, dass ich euch beide belästigt habe ... Nennt mich bitte Icayo, wie ihr seht, bin ich ein Abenteurer, der gern Sauriern hinterherjagt ... und manchmal von ihnen gejagt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240809
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240809,
					"content": "Ich hatte in letzter Zeit ein kleines gesundheitliches Problem und musste eine Weile im Bett bleiben, wodurch meine Ausdauer stark abgenommen hat, und ich konnte sie nicht rechtzeitig treffen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240810
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240810,
					"content": "Diesmal wurde ich umzingelt, bevor ich das Lager erreichen konnte, was zeigt, dass sie sich große Sorgen um mich gemacht haben, ach, ich bin wirklich so glücklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240811,
						750240812
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240811,
					"content": "Es scheint, dass du besonders gut im positiven Denken bist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240813
					]
				},
				{
					"id": 750240813,
					"content": "Übrigens, gerade eben hatten wir ein kleines Problem mit Marigold, weil wir uns ein bisschen zu sehr beeilt haben, dich zu retten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240814,
					"content": "Ah, das ist kein Problem, für sie war es wahrscheinlich nichts anderes als ein normales Spiel. Sie versteckt sich jetzt vermutlich irgendwo und schmollt, schließlich hat sie gegen euch verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240815
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240815,
					"content": "Trotz ihres Aussehens ist sie innerlich ein sensibles und liebenswertes Wesen. Ich werde sie später finden und beruhigen, keine Sorge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240816
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240816,
					"content": "Nun gut, es sieht so aus, als ob es dir auch gut geht. Wir haben uns zwar umsonst Sorgen gemacht, aber Hauptsache, dir ist nichts passiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240817,
					"content": "Ich bin wirklich dankbar für eure Fürsorge. Übrigens, auch wenn es nichts Seltenes ist ... Nehmt dieses Rezept für Pökelfisch in saurer Sauce an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240818
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240818,
					"content": "#Besonders liebt Platsch dieses Gericht, vielleicht mag es euer Gefährte {REALNAME[ID(2)|SHOWHOST(true)]} auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240819
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240819,
					"content": "*brüll* ... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240820
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240820,
					"content": "#Was ist los? Möchtest du es ausprobieren? Gut, dann lass {NICKNAME} es später für dich zubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240821,
					"content": "*brüll*!",
