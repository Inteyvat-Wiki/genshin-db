					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750130204
					],
					"speakerTitle": "Junger Tepetlisaurier"
				},
				{
					"id": 750130204,
					"content": "#Hmm ... Paimon ist sich nicht sicher, ob wir ihn für irgendwas benutzen können, aber lass uns diesen Greifhaken mitnehmen, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750130205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750130205,
					"content": "Danke, Kleiner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
