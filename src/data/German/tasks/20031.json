				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310501,
					"content": "Hehe, da können wir nicht Nein sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310502,
					"content": "Nehmt dies als Zeichen des Dankes der Abenteurergilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310503
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310503,
					"content": "Die Gilde bekommt jeden Tag so viele Missionen. Ohne euch Abenteurer hätten wir nicht die geringste Chance, das alles zu bewältigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310504
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310504,
					"content": "Wenn du genügend Missionen an einem Tag erledigt hast, kannst du dir bei mir ein zusätzliches Geschenk abholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310505
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310505,
					"content": "In deiner Abenteurerlizenz werden all deine täglich ausgeführten Missionen aufgezeichnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310506
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310506,
					"content": "Denke unbedingt daran, noch am selben Tag vorbeizuschauen und deine Belohnung abzuholen. Der Vorrat ist begrenzt. Wenn du die Zeit zum Abholen verpasst, war’s das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310507,
						200310509
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310507,
					"content": "Verstanden, danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310508
					]
				},
				{
					"id": 200310508,
					"content": "Ach, ich habe dir zu danken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310512,
					"content": "Eins noch: Wenn du anderen Abenteurern bei ihren Missionen hilfst, erhältst auch du bessere Belohnungen am Ende des Tages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310513
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310513,
					"content": "Arbeite also gut mit deinen Kameraden zusammen! Ad astra abyssosque!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310509,
					"content": "Pro Tag gibt es bloß eine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310510
					]
				},
				{
					"id": 200310510,
					"content": "Im Moment sieht das ganz so aus ... Tut mir leid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310511
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310511,
					"content": "Aber mach dir da keine Sorgen. Wir versuchen immer, beim Hauptquartier das Beste für unsere Abenteurer rauszuholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310512
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
