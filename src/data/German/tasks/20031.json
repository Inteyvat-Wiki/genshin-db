					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200310201,
					"content": "#Das ist ja großartig, {NICKNAME}! Für dein erstes mal ist das eine hervorragende Leistung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310202,
					"content": "Ich soll anstelle des Auftraggebers dessen Dank an euch aussprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310203,
					"content": "Und nun werde ich mein Versprechen einlösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
