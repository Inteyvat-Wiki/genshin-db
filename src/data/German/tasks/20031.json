			},
			"dialogs": [
				{
					"id": 200310401,
					"content": "#He, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310402
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310402,
					"content": "Mir ist zu Ohren gekommen, dass du schon eine <color=#00E1FFFF>Mission</color> von der Abenteurergilde abgeschlossen hast. Ich soll dir vom Auftraggeber viele Grüße ausrichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310403,
						200310406
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310403,
					"content": "Welche Mission denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310404
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310404,
					"content": "Du hast doch jemandem in Not geholfen. Schon vergessen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310405
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310405,
					"content": "Die meisten Leute, die auf Probleme stoßen, informieren die Abenteurergilde darüber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310408,
					"content": "Ich werde dir am besten kurz erklären, wie das alles abläuft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310409
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310409,
					"content": "Die Abenteurergilde vergibt jeden Tag Missionen an ihre Mitglieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310410
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310410,
					"content": "Diese Missionen sind die Haupteinnahmequelle vieler Abenteurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310411
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310411,
					"content": "Da kann ich dir auch gleich verraten, dass die Gilde eine Überraschung für dich vorbereitet hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310406,
					"content": "Ich bin jemandem auf dem Weg begegnet, der meine Hilfe brauchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310407
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310407,
					"content": "Dieser Enthusiasmus, wenn man neu in der Abenteurergilde ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
