				"points": []
			},
			"dialogs": [
				{
					"id": 200310101,
					"content": "#So sehen wir uns wieder, Abenteurer{F#in}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310102,
					"content": "Wie sieht es denn in der letzten Zeit mit den Abenteuern aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310103,
						200310105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310103,
					"content": "Kann mich nicht beklagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310104
					]
				},
				{
					"id": 200310104,
					"content": "Gute Einstellung! Bleib so!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310107,
					"content": "Du scheinst schon viel Erfahrung gesammelt zu haben. Ich sollte dich mit einer wichtigen Aufgabe der Abenteurergilde vertraut machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310108,
					"content": "Die Abenteurergilde vergibt jeden Tag <color=#00E1FFFF>Missionen</color> an ihre Mitglieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310109,
					"content": "Diese Missionen sind die Haupteinnahmequelle vieler Abenteurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310110,
					"content": "Was sind das so alles für Missionen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310111,
					"content": "Ganz verschiedene. Manchmal muss man Bürgern dabei helfen, Monster loszuwerden, manchmal sind auch ziemlich gefährliche dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310112,
					"content": "Am besten ist es, ihr nehmt euch ein paar Missionen. Dann versteht ihr auch, wie der Ablauf funktioniert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310113,
					"content": "Dies hier sind die heute verfügbaren Missionen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310114,
					"content": "Wenn ihr sie erfüllt habt, erstattet ihr bei mir Bericht. Dann könnt ihr euch auch eine tolle Belohnung abholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310115,
						200310117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310115,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310116
					]
				},
				{
					"id": 200310116,
					"content": "#Das ist mein{F#e} {NICKNAME}. Man kann immer auf dich zählen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310119,
					"content": "#Dann warte ich hier darauf, dass du mit guten Neuigkeiten wiederkommst, {NICKNAME}. Ad astra abyssosque! Zu den Sternen und Abgründen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310117,
					"content": "Wie toll sind die Belohnungen denn genau?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310118
					]
				},
				{
					"id": 200310118,
					"content": "Wir wollen die Überraschung doch nicht verderben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310105,
					"content": "Ziemlich anstrengend, muss ich sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310106
					]
				},
				{
					"id": 200310106,
					"content": "Am Anfang geht das jedem so. Vor deinen Abenteuern solltest du dich gut vorbereiten. Das erleichtert vieles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
