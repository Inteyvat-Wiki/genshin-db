			"trigger": {
				"objectNames": [
					"Ootomo",
					"Lenne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930101,
					"content": "Ah, du bist da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930102
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930102,
					"content": "Lenne schrieb gestern von unserem Bedauern, dass wir uns nicht früher getroffen haben, und deshalb möchte ich ihm heute auch ein paar Verse schenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930103
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930103,
					"content": "Haha, es ist mir eine Ehre, ein solches Geschenk anzunehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930104
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930104,
					"content": "Ich bin zwar schon ein alter Mann, aber nachdem ich in den letzten Tagen Freunde aus Mondstadt kennengelernt habe, bin ich sehr interessiert an der Stadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930105
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930105,
					"content": "Dieses Gedicht habe ich in Anlehnung an die Barden von Mondstadt geschrieben und der Vers wird auch einige der Landschaften dieses Landes erwähnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930106
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930106,
					"content": "Leider war ich noch nie in Mondstadt ... Aber könntest du mir helfen, ein paar Fotos von <color=#00E1FFFF>Mondstadts regionalen Besonderheiten</color> zu machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930107
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930107,
					"content": "Mach ich doch gern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930108
					]
				},
				{
					"id": 726930108,
					"content": "Haha, wenn das so ist, zähle ich auf dich. Genau wie in den letzten Tagen reichen vier Bilder aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
		{
			"id": 7269302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
