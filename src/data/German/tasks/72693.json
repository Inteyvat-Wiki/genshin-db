					"Lenne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930501,
					"content": "Die wilde Frucht hier spielt wohl auf schmerzhafte Erfahrungen an. Es ist keine freudige Erinnerung, wie der erste Geschmack vom Wein oder das erste Lesen eines Gedichts, aber sie hinterlässt dennoch einen tiefen Eindruck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
		{
			"id": 7269306,
			"completionStepIds": [
				7269305
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
