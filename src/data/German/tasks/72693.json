				"points": []
			},
			"dialogs": [
				{
					"id": 726930401,
					"content": "Eine Blume mit einem Geliebten zu verbinden, ist allen Völkern gemeinsam. Dieser Satz vergleicht die Erinnerung an die Sehenswürdigkeiten von Inazuma mit der Erinnerung an die erste Liebe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
		{
			"id": 7269305,
