			"dialogs": [
				{
					"id": 726930301,
					"content": "Die „Spuren des Windes“ als Metapher für den Aufbruch auf eine Reise zu verwenden, ist in der Tat eine Ausdrucksform sehr im Stile von Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
		{
