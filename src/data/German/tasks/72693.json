				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lenne",
					"Ootomo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930601,
					"content": "Ootomos Gedicht hat die übliche Form des Inazuma-Gedichts wirklich durchbrochen, aber es enthält auch seinen ursprünglichen Stil, um alle möglichen unvergesslichen menschlichen Erfahrungen zu schildern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930602
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930602,
					"content": "Vielleicht will er damit sagen, dass Mondstadt und Inazuma zwar sehr unterschiedlich erscheinen, aber doch eine gemeinsame Ästhetik haben ... So wie wir beide, obwohl wir aus verschiedenen Ländern stammen, uns als Dichter verbunden haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930603
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930603,
					"content": "Wie schön, dass du die Gefühle hinter diese Verse so schnell erfassen konntest, obwohl du noch so jung bist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930604
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930604,
					"content": "Früher habe ich nicht an die Idee geglaubt, dass man Freunde unterschiedlichen Alters finden kann, aber jetzt weiß ich, dass sie wahr ist. Was für eine freudige Wahrheit das ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930605
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930605,
					"content": "Und du hast uns geholfen, all das zu verwirklichen ... Da muss das Schicksal im Spiel sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930606
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930606,
					"content": "In der Tat. Die Reise nach Inazuma war ziemlich wellig, aber das ist jetzt schon egal. Selbst wenn ich nach Mondstadt zurückkehre, werde ich mich an alles erinnern, was ich hier in Inazuma gesehen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930607
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930607,
					"content": "Das ist auch den Bildern zu verdanken, die du mitgebracht hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930608
					],
					"speakerTitle": "Lenne"
				},
				{
					"id": 726930608,
					"content": "Ich hoffe, dass wir drei uns eines Tages wiedersehen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930609
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930609,
					"content": "Das werden wir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lenne"
				}
			]
		},
