			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ootomo",
					"Lenne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930201,
					"content": "Wie sieht es denn mit den Bildern aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930202
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930202,
					"content": "Hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930203
					]
				},
				{
					"id": 726930203,
					"content": "Danke, danke, danke. Ah, damit kann ich endlich ein zufriedenstellendes Gedicht aufschreiben. Nun denn, lass mich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930204
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930204,
					"content": "Hier ist mein Entwurf, geschrieben nach den Bildern, die du mitgebracht hast. Warum wählst du nicht die Verse aus, die wir verwenden sollen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
			]
		},
		{
			"id": 7269303,
