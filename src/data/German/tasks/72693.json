			"dialogs": [
				{
					"id": 726930901,
					"content": "Wie sieht es denn mit den Bildern aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930902
					],
					"speakerTitle": "Ootomo"
				},
				{
					"id": 726930902,
					"content": "Ich habe sie noch nicht aufgenommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930903
					]
				},
				{
					"id": 726930903,
					"content": "Es tut mir leid, dass ich dich belästige. Heute brauche ich <color=#00E1FFFF>Besonderheiten aus Mondstadt</color>, wie vorher auch <color=#00E1FFFF>vier</color> Fotos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ootomo"
				}
