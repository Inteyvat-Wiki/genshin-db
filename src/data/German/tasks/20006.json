			"dialogs": [
				{
					"id": 200060101,
					"content": "Bestellung außer Haus",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060102,
					"content": "#Willkommen beim Hirschjäger ... {F#Reisende}{M#Reisender}? Du kommst genau richtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060103,
					"content": "Entschuldige, ich weiß, du wirst hungrig sein. Aber könntest du mir einen Gefallen tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060104,
					"content": "Orlean aus Quellingen hat eine Portion <color=#00E1FFFF>Honigmöhren-Fleischpfanne</color> bestellt. Mir ist aber leider zu Ohren gekommen, dass Quellingen wohl von Schleimen heimgesucht wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060105,
					"content": "Ich traue mich nicht ... Würdest du diese Bestellung für mich zu <color=#00E1FFFF>Orlean in Quellingen</color> bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060106,
						200060107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060106,
					"content": "Gern, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060108
					]
				},
				{
					"id": 200060108,
					"content": "Wenn du zurück bist, wird hier eine tolle Mahlzeit auf dich warten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060109,
					"content": "Ich zähle auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060107,
					"content": "Ich bin so hungrig! Ich wollte eigentlich nur etwas essen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060110
					]
				},
				{
					"id": 200060110,
					"content": "Wenn du damit fertig bist, werde ich dich, ja, auf ein Spezialgericht beim Hirschjäger einladen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
