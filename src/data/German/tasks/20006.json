						200060402
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060402,
					"content": "Du bist zurück! Hast du die Bestellung ausgeliefert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060403
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060403,
					"content": "Hier hast du das Geld.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060404
					]
				},
				{
					"id": 200060404,
					"content": "Mal sehen ... Oh ja, vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060405
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060405,
					"content": "Dieser <color=#00E1FFFF>leckere geschmorte Schinken mit Krebsgemüse</color> ist für dich. Er ist gerade fertig geworden und ist noch heiß.",
					"roleType": "TALK_ROLE_NPC",
