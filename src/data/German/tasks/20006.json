			"dialogs": [
				{
					"id": 200060201,
					"content": "Danke, diese Schleime sind wirklich nervig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060202
					],
					"speakerTitle": "Quirlige Orlean"
				},
				{
					"id": 200060202,
					"content": "Wenn mein Magen nicht so leer wäre, würde ich es diesen Dingern selbst zeigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060203
					],
					"speakerTitle": "Quirlige Orlean"
				},
				{
					"id": 200060203,
					"content": "Hier ist deine Bestellung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060204
					]
				},
				{
					"id": 200060204,
					"content": "Mmh ... Möhren und Fleisch, das duftet herrlich. Wenn ich mich nur eher hätte satt essen können, hätte ich es diesen Schleimen gezeigt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060205
					],
					"speakerTitle": "Quirlige Orlean"
				},
				{
					"id": 200060205,
					"content": "Aber was soll ich machen? Hier hast du das Geld für Sara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quirlige Orlean"
				}
			]
		},
