				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410401,
					"content": "Ist das Albedo? Warum würde er sich an einem Ort wie diesem aufhalten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410402,
					"content": "Gerüchten zufolge liebt er es zu zeichnen. Wenn es eine hübsche Landschaft gibt, bleibt er da eine Weile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410403
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410403,
					"content": "Die Aussicht ist wirklich hervorragend. Motive, wo auch immer man hinsieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410404
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410404,
					"content": "Aber ... sieht er denn diese Hilichurle nicht? Ist er nicht in Gefahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410405,
					"content": "Iiih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1104106,
			"completionStepIds": [
				1104106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104106",
							"2"
						],
						"stepId": 1104106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110410601,
					"content": "Wer seid ihr? Warum habt ihr sie aufgescheucht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410602
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410602,
					"content": "Zum Glück habe ich meine Skizze bereits fertiggestellt, es wäre eine Schande, diese Hilichurle in unvollständigem Zustand zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410603,
						110410604
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410603,
					"content": "Du hast die Hilichurle gezeichnet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				},
				{
					"id": 110410605,
					"content": "Warum zeichnest du Hilichurle? Sehen die nicht alle gleich aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410606,
					"content": "Hmm, ich fürchte, das ist nicht so einfach zu erklären. Schaut euch meine Zeichnung an, dann seht ihr es vielleicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410607,
						110410608
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410607,
					"content": "Äh ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410609,
					"content": "Oh! Wie detailliert! Aber teilweise auch ein wenig hastig hingeschmiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410610,
					"content": "Diese Hilichurle sind überall zu finden. Eigentlich sind sie ziemlich langweilig und keinen zweiten Blick wert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410611
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410611,
					"content": "Aber seht euch dieses Exemplar an. Der Körperbau, das Fell ... Hier ist eine bestimmte Macht am Werk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410612
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410612,
					"content": "Im Lebenskreislauf solcher primitiven Gesellschaften deuten einzigartige Attribute wie diese an, dass die Evolution am Werk ist. Evolution, der Übergang vom Nichts in die Existenz, vom Bekannten zum Un...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410613
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410613,
					"content": "Immer langsam mit den jungen Pferden, etwas sagt mir, dass uns jetzt eine These blüht. Dafür habe ich nicht die Geduld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410614
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410614,
					"content": "Wir haben euren Mann gefunden, ich mache mich auf den Rückweg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410615
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410615,
					"content": "Was? Du willst ihn gar nichts fragen? He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410616,
					"content": "Hmpf. Was für eine seltsame Person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410617,
					"content": "Schwester Rosaria hat euch also hergebracht? Das überrascht mich. Und ich hatte nicht einmal Zeit, mich bei ihr zu bedanken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410618
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410618,
					"content": "Aber wenn ich sie richtig verstanden habe, habt ihr mich gesucht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410619
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410619,
					"content": "Hm! Wir haben in Mondstadt ein Mädchen kennengelernt, Saccharose. Sie meinte, du würdest irgendwie bei deiner Forschung feststecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410620,
					"content": "Ah, ich verstehe. Saccharose hat euch hergeschickt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410621
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410621,
					"content": "Dann bist du wohl der Ehrenritter. Ganz Mondstadt spricht über dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410622
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410622,
					"content": "Ich habe ein bisschen was von allem gehört: über deinen Beitrag während des Angriffs von Sturmschrecken, deine Kontrolle über die Elemente und manch andere geheimnisvolle Sachen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410623
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410623,
					"content": "Daraus ziehe ich den Schluss, dass es dafür letzten Endes nur einen Grund geben kann. Du kommst von weit her ... aus einer anderen Welt. Stimmt’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410624,
						110410625
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410624,
					"content": "Stimmt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410626,
					"content": "Ausgezeichnet. Darf ich dich um deine Hilfe bitten? Ich glaube, meine Forschung würde unheimlich davon profitieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410627,
						110410628
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410627,
					"content": "Deine Forschung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410629,
					"content": "Ah ... tut mir leid, das ist bestimmt verwirrend. Wo soll ich anfangen? Hmm ... Die Essenz des Lebens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410630
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410630,
					"content": "Herrje, DAMIT willst du anfangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410631,
					"content": "Hmm ... du hast recht. Es wäre besser, das Ganze zu demonstrieren, anstatt mich mit Worten herumzuplagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410632
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410632,
					"content": "Zum Beispiel Leben erwecken. Gefallenen Blättern neues Leben einhauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410634
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410634,
					"content": "Das kannst du tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410635,
						110410636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410635,
					"content": "Alchimie ist ein Wunder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410637,
					"content": "Jedoch hat die soeben erwähnte Methode bei einem gewissen Samen in meinem Besitz noch nicht gefruchtet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410639
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410639,
					"content": "Er kommt wie du auch aus einer anderen Welt. Ihm zu helfen zu wachsen ... zu blühen ... Das ist das Problem, um das sich meine Forschung dreht. Hierbei brauche ich deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410640
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410640,
					"content": "Wenn du Schwierigkeiten hast, das zu lösen, zweifelt Paimon daran, dass wir groß weiterhelfen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410641,
					"content": "Und ich glaube, dass ihr das doch könnt. Mir sind die Feinheiten des Lebens außerhalb der bekannten Welt ein Rätsel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410642
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410642,
					"content": "Aber du kommst nicht aus der bekannten Welt. Indem ich dich beobachte und erforsche, finde ich vielleicht heraus, wie ich den Samen zum Sprießen bringen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410643
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410643,
					"content": "Das heißt also, ich wäre ein ... Forschungsobjekt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410644
					]
				},
				{
					"id": 110410644,
					"content": "#Äh ... {NICKNAME}, sollen wir von hier verschwinden? Das klingt ein wenig irre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410645,
						110410647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110410645,
					"content": "Könnte das gefährlich sein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410646
					]
				},
				{
					"id": 110410646,
					"content": "Vielleicht. Aber ich werde alles in meiner Macht Stehende tun, um eure Sicherheit zu garantieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410649,
					"content": "Zeit für einen Tapetenwechsel. Wir sollten aufbrechen, die Forschung wartet nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410650
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410650,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410651
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410651,
					"content": "Die beiden scheinen sich gut zu verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410652
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410652,
					"content": "Gleich und gleich gesellt sich gern. Ich frage mich ... Könnte das ein Risiko für Mondstadt sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110410647,
					"content": "Und was springt für mich dabei raus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410648
					]
				},
				{
					"id": 110410648,
					"content": "Mora, Wissen. Und du bist auf der Suche nach der Antwort auf eine bestimmte Frage. Ich kenne sie zufällig. Wie klingt das für dich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110410649
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110410636,
					"content": "Alchimie ist wirklich nützlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410637
					]
				},
				{
					"id": 110410628,
					"content": "Ich bin mir nicht sicher, ob ich das richtig verstanden habe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410629
					]
				},
				{
					"id": 110410625,
					"content": "Du wirst deinem Ruf als Gelehrter gerecht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410626
					]
				},
				{
					"id": 110410608,
					"content": "Äußerst ... künstlerisch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410609
					]
				},
				{
					"id": 110410604,
					"content": "Ich dachte, du hättest eine Landschaft festgehalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110410605
					]
				}
			]
		}
	]
}