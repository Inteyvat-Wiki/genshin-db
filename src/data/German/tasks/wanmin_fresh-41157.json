					"nextDialogs": [
						411570303
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 411570303,
					"content": "So viele junge Leute begeben sich an diesen merkwürdigen Ort – was geht heutzutage nur in Liyue vor sich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411570304
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 411570304,
					"content": "Wie dem auch sei, dürfte ich dich damit behelligen, diese Mahlzeit an ihn zu liefern? <color=#00E1FFFF>Aber haste nicht zu sehr,</color> sonst verschüttest du die Suppe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Koch Mao"
				}
			]
		},
