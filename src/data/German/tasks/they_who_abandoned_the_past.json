			"dialogs": [
				{
					"id": 761170201,
					"content": "Tss, was für ein Loser. Der Typ ist so pleite, dass er nichts hat, was es sich zu stehlen lohnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170202
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170202,
					"content": "He, Kaleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170203,
					"content": "Wer kommt denn da ... na, na, na, wenn das nicht Jahoda ist! Was führt dich hierher, Kleine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170204
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170204,
					"content": "Entspann dich, keine große Sache. Es heißt, du hättest vor ein paar Tagen etwas von einem Mann namens Ihanti geklaut. Stimmt das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170205
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170205,
					"content": "Hier, nimm das Geld und gib mir die Ware. Ich bin heute großzügig, also betrachten wir das als Abkaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170206
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170206,
					"content": "Ha, sieh dich nur an, wie zivilisiert du dich gibst. Das passiert wohl, wenn Nefer dir den Rücken freihält, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170207
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170207,
					"content": "Angenommen, ich möchte die Sachen lieber behalten. Was willst du dann tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170208
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170208,
					"content": "Tu mir einen Gefallen, Kaleva. Könntest du und deine Bande von Trotteln nicht zur Abwechslung mal versuchen, euch normal zu benehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170209,
					"content": "Ach komm, sag mir nicht, dass du den ganzen Weg hierhergekommen bist, um mit einem Dieb ehrliche Geschäfte zu machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170210
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170210,
					"content": "Oder hast du wirklich geglaubt, ich würde dir den Kram einfach auf einem Silbertablett servieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170211
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170211,
					"content": "Na dann ist die Verhandlung wohl schon gescheitert, bevor sie überhaupt begonnen hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170212,
					"content": "*seufz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170213,
					"content": "Mein Fehler, Kaleva. Ich hätte nicht versuchen sollen, mit dir so umzugehen, wie Chefin Nef es tut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170214,
					"content": "Ein Schlag ins Gesicht ist die einzige Möglichkeit, mit Idioten wie dir zu verhandeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170215
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170215,
					"content": "#Komm schon, {NICKNAME}, machen wir diese Typen fertig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170216
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170216,
					"content": "Du schaust auf uns herab, was? Kommt schon, Jungs, es ist Zeit, dieser kleinen Göre ihren Platz zu zeigen. Macht sie fertig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaleva"
				}
			]
		},
