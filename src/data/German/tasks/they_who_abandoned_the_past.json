					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170604,
					"content": "... Ruhe in Frieden, Ihanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170605
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170605,
					"content": "Ich werde mich nicht von diesem sogenannten „Schicksal“ einholen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170606
					],
					"speakerTitle": "Jahoda"
				},
				{
