						"sceneId": 3,
						"position": [
							2097.637,
							200.208,
							9562.796
						],
						"pointId": 14264
					},
					{
						"sceneId": 3,
						"position": [
							2098.119,
							200.186,
							9563.697
						],
						"pointId": 14265
					}
				]
			},
			"dialogs": [
				{
					"id": 761170301,
					"content": "Schon gut, schon gut, ihr habt gewonnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170303
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170303,
					"content": "Siehst du? Wenn du einfach mitgespielt hättest, wäre uns das alles erspart geblieben. Und jetzt nimm die Mora und such dir einen vernünftigen Arzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170304,
					"content": "Hmpf, ist das deine Art, Mitgefühl zu zeigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170305
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170305,
					"content": "Halt den Mund und nimm die Mora. Ob du sie ins Wasser wirfst oder damit Schläger anheuern willst, die mich verprügeln sollen, ist mir egal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170306
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170306,
					"content": "Eins ist doch klar: Hunger leiden und verprügelt werden ist beides nicht das Wahre. Mach es dir nicht noch schwerer, Kaleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170308
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170308,
					"content": "Der Krempel, den ich diesem Invaliden geklaut habe, liegt dort drüben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170309
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170309,
					"content": "Abgesehen von etwas Kleingeld waren es nur ein Gemälde und eine kaputte Puppe. Die Mora sind längst weg, aber ich hatte noch keine Zeit, den Rest wegzuwerfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170310
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170310,
					"content": "Gut. Eine letzte Frage: Du hast Ihanti gerade als „Invaliden“ bezeichnet. Was meinst du damit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170311
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170311,
					"content": "Genau das, was es heißt. Bei seinem erbärmlichen Zustand glaubt man kaum noch, dass er lebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170312
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170312,
					"content": "Als ich ihn fand, lag er da, steif wie ein Brett. Ich dachte ehrlich gesagt, er wäre schon ... Na du weißt schon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170313
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170313,
					"content": "... Jedenfalls dachte ich mir, dass er seine Tasche wohl nicht mehr braucht. Da habe ich sie mitgenommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170314
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170314,
					"content": "Markiere mir die Stelle, an der du ihn das letzte Mal gesehen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170315
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170315,
					"content": "Wo ich ihn zum letzten Mal gesehen habe? Das war wohl ungefähr ... hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170316
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170316,
					"content": "#Gut. {NICKNAME}, Paimon, lasst uns gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170317
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170317,
					"content": "Ich würde diese Sachen gerne persönlich dem Auftraggeber zurückgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
		{
			"id": 7611704,
			"completionStepIds": [
				7611705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7611705",
							"2"
						],
						"stepId": 7611705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ihanti"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2018.583,
							206.964,
							9782.118
						],
						"pointId": 14266
					},
					{
						"sceneId": 3,
						"position": [
							2020.458,
							206.988,
							9783.119
						],
						"pointId": 14267
					},
					{
						"sceneId": 3,
						"position": [
							2019.785,
							206.972,
							9781.799
						],
						"pointId": 14268
					},
					{
						"sceneId": 3,
						"position": [
							2018.43,
							206.961,
							9782.82
						],
						"pointId": 14269
					}
				]
			},
			"dialogs": [
				{
					"id": 761170401,
					"content": "... *schnarch* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170402
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170402,
					"content": "Wer ist da? Ich habe keine Mora ... nichts habe ich! Und wenn ihr mein Leben wollt, dann nehmt es ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170403
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170403,
					"content": "Ich bringe dir deine Sachen zurück, Ihanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170404
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170404,
					"content": "... Jahoda? Bist du das? Ich höre deine Stimme, kann dich aber nicht mehr klar sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170405
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170405,
					"content": "Ja, ich bin es, Ihanti. Und ich stehe direkt vor dir. Warum bist du nicht zu mir gekommen? Du siehst schrecklich aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170406
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170406,
					"content": "Selbst ein hungernder Straßenhund wagt sich nicht in die Stadt eines reichen Mannes ... Nicht nach all den Schlägen, die er einstecken musste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170407
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170407,
					"content": "So jemand bin ich nicht. Und Nef... ich meine Chefin Nef auch nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170408
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170408,
					"content": "Ein Grund mehr, warum ich mich nicht an dich wenden konnte. Wenn die Leute mitbekommen hätten, wie hilfsbereit du bist, hätten sie jeden Tag an deine Tür geklopft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170409
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170409,
					"content": "Niemand wäre so verrückt, sich vor der Chefin so respektlos zu verhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170410
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170410,
					"content": "Aber du bist immer da draußen und tust heimlich Gutes, nur um dann von genau den Leuten hinterrücks erstochen zu werden, denen du geholfen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170411
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170411,
					"content": "He, ich habe viel von der Chefin gelernt, weißt du. Und niemand wird mich jemals wieder so erwischen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170412
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170412,
					"content": "... Du kannst einfach nicht anders, als dich um andere Leute zu kümmern, oder, Jahoda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170413
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170413,
					"content": "... Das ist meine Sache, meine ganz allein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170414
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170414,
					"content": "Hehe ... Vielleicht ist das der Grund, warum die Chefin dich so schätzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170415
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170415,
					"content": "Vielleicht ist das der Grund, warum ich noch am Leben bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170416
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170416,
					"content": "Hahaha ... *hust* *hust* ... Du hast recht, Jahoda, du hast recht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170417
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170417,
					"content": "... Wie auch immer. Wenn ich etwas für dich tun kann, Ihanti, ist jetzt der Zeitpunkt, es mir zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170418
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170418,
					"content": "Immer noch dieselbe ... Was, wenn all das nur ein großer Schwindel wäre oder ich dich in eine Falle locken würde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170419
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170419,
					"content": "Das würdest du nicht tun. Nicht nach all der Zeit, die wir uns kennen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170420
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170420,
					"content": "Und das reicht, um dein Vertrauen zu gewinnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170421
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170421,
					"content": "Komm schon, sieh dich doch mal an. Wie könntest du mich denn bedrohen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170422
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170422,
					"content": "Ha! Endlich machen wir Fortschritte. Ich denke, eine giftige Schlange zu retten, die kaum ihr Maul öffnen kann, ist alles in allem ziemlich sicher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170423
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170423,
					"content": "Kannst du mir einen Gefallen tun? Rolle bitte die Zeichnung aus der Tasche zusammen und steck sie in meine Hosentasche. Ich habe keine Kraft mehr, sie selbst hochzuheben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170424
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170424,
					"content": "Dieses Bild habe ich zusammen mit meiner Frau und meiner Tochter gemalt, und es ist das Einzige auf dieser Welt, was mir noch etwas bedeutet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170425
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170425,
					"content": "Alles andere hat für mich keine Bedeutung mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170426
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170426,
					"content": "He, dein altes Ich würde sich vor Lachen biegen, wenn es dich das sagen hören würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170427
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170427,
					"content": "Ha ... Und was ist mit den Dingen geschehen, die ich einst über alles geschätzt habe? Sie konnten weder meine Frau noch mein Leben retten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170428
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170428,
					"content": "Aber vielleicht ist das einfach das Schicksal eines Diebes. Alles, was wir stehlen, wird uns immer wieder gestohlen, und am Ende stehen wir wieder mit leeren Händen da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170429
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170429,
					"content": "Der Anhänger, den ich für die Mission benutzt habe, war auch mein letzter Besitz ... Haha ... Na ja, man kann nicht wirklich sagen, dass es „mein“ letzter Besitz war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170430
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170430,
					"content": "Das war das erste Schmuckstück, das du jemals gestohlen hast. Du musst mir die Geschichte schon dutzende Male erzählt haben – wie du es geschafft hast und wie der reiche Kerl geguckt hat, als er es gemerkt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170431
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170431,
					"content": "Ja. Aber wie dem auch sei, jetzt gehört er dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170432
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170432,
					"content": "Wem hat er denn gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170433
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170433,
					"content": "Es war jemand aus Snezhnaya namens Holomov, der früher in Nod-Krai gelebt hat, aber wahrscheinlich ist er schon wieder zurück in Snezhnaya. Sag mir bloß nicht, dass du daran denkst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170434
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170434,
					"content": "Ich bin keine Diebin mehr und behalte gestohlene Sachen auch nicht für mich. Dieser Anhänger sollte zu seinem rechtmäßigen Besitzer zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170435
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170435,
					"content": "Haha ... hahaha ... ! Du bist ... Du bist wirklich besonders, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170436
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170436,
					"content": "Die Chefin hatte recht ... Jemand wie du könnte niemals ... *hust* als Dieb bestehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170437
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170437,
					"content": "*hust* ... *hust* ... *hust*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170438
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170438,
					"content": "Genug geredet. Ich gehe zurück und suche einen Arzt für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170439
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170439,
					"content": "Lass es gut sein, ich gehe einfach dorthin, wo ich hingehöre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170440
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170440,
					"content": "Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170441
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170441,
					"content": "Jahoda, du kennst die „Regeln“ der Chefin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170442
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170442,
					"content": "... „Wer nach Ruhe strebt, soll Ruhe finden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170443
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170443,
					"content": "Du weißt, wovon ich spreche. Also lass mich in Frieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170444
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170444,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170445
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170445,
					"content": "Ich verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170446
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170446,
					"content": "Ich bin froh, dass du es warst, Jahoda, die kam, um mir zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170447
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170447,
					"content": "Leider habe ich keine Schätze, die ich dir geben könnte. Aber wenn du magst, kannst du diese Puppe haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170448
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170448,
					"content": "Warte, aber ... Ich dachte, ich hätte dir gesagt, dass du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170449
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170449,
					"content": "Keine Sorge, ich habe sie selbst gemacht. Die, die du zusammengestellt hast, sind längst weg – ich habe sie alle verbrannt, genau wie du es mir gesagt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170450
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170450,
					"content": "Nicht schlecht, oder? Vor allem für jemanden, der schon kurz vor der Erblindung stand ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170451
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170451,
					"content": "Nimm sie, Jahoda. Betrachte sie als mein letztes Geschenk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170452
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170452,
					"content": "Ich werde zurückkommen, um nach dir zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170453
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170453,
					"content": "Geh jetzt. Auf Wiedersehen, Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170454
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170454,
					"content": "Und vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ihanti"
				}
			]
		},
		{
