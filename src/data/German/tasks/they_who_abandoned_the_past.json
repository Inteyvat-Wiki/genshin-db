						],
						"pointId": 14271
					}
				]
			},
			"dialogs": [
				{
					"id": 761170501,
					"content": "Ausgezeichnet, sieht so aus, als hättest du die Mission erfüllt. Bitte hab etwas Geduld, während ich deine Bezahlung hole.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170502
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170502,
					"content": "Alles in Ordnung mit dir, Fräulein Jahoda, du siehst nicht gut aus. Ist irgendwas passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170503
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170503,
					"content": "Ach, nichts. Es geht mir gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170504
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170504,
					"content": "Na gut. Warte bitte kurz, ich komme gleich mit deiner Bezahlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170505
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170505,
					"content": "Geht es dir wirklich gut, Jahoda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170506
					]
				},
				{
					"id": 761170506,
					"content": "Paimon weiß, dass wir versprochen haben, keinen Arzt zu rufen, aber ... Ihanti sah wirklich schrecklich aus. Vielleicht sollten wir doch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170507,
					"content": "Nein. Ich habe gesagt, dass ich mich an die Regeln halten werde. Also mache ich das auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170508
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170508,
					"content": "Also ... Ihr beiden kennt euch gut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170509
					]
				},
				{
					"id": 761170509,
					"content": "Wir waren früher einmal „Kollegen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170510
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170510,
					"content": "Er mag zwar ein Feigling sein, aber wenn es darum ging, Mora einzustreichen, war Ihanti einfach unübertroffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170511
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170511,
					"content": "Während alle anderen da draußen dumme Betrügereien und kleine Diebstähle verübten, spielte er das Spiel so gut, dass die Leute am Ende bereitwillig ihr Geld herausrückten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170512
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170512,
					"content": "Als wir noch zusammen „arbeiteten“, brachte er mir eine ganze Reihe verschiedener Methoden bei, wie man Leute umstimmen kann, und er lud mich immer wieder zu großartigen Essen ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170513
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170513,
					"content": "Würdest du ihn einen Freund nennen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170514
					]
				},
				{
					"id": 761170514,
					"content": "Einen Freund? Ha, natürlich nicht. Man müsste verrückt sein, um in dieser Hölle Freunde finden zu wollen. Bestenfalls ... kannten wir uns etwas, würde ich sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170515
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170515,
					"content": "Der einzige Grund, warum er sich so gut um mich gekümmert hat, war, um anzugeben. Eine kleine Helferin mitzuschleppen, gab ihm wohl das Gefühl, ein großer Fisch zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170516
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170516,
					"content": "Aber er hat sich in der Tat um mich gekümmert und ich helfe ihm nur, weil ich diese Schuld begleichen möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170517
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170517,
					"content": "Gut ... Hier ist deine Bezahlung, Fräulein Jahoda. Die Abenteuergilde dankt dir für deine Unterstützung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170518
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170518,
					"content": "#Hier ist dein Anteil, {NICKNAME}. Danke für deine Hilfe gerade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170519
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170519,
					"content": "Wie auch immer, ich sollte zurück zum Kuratorium gehen. Wenn die Chefin etwas erledigt haben will und ich nicht da bin, wird sie mir sicher wieder auf die Nerven gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170520
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170520,
					"content": "(Ich habe zwar gesagt, dass ich ihm keinen Arzt besorgen würde, aber was spricht dagegen, ein paar Schmerzmittel für ihn zu holen?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170521
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170521,
					"content": "(Ich werde die Chefin um Hilfe bitten, sie kann sicher ihre Beziehungen spielen lassen. Im schlimmsten Fall verzichte ich auf mein Monatsgehalt ... Eigentlich vielleicht nur auf die Hälfte davon ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170522
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170522,
					"content": "(Ja, genau das mache ich. Am besten bringe ich Ihanti die Medizin gleich morgen ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
