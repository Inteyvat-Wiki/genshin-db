			"dialogs": [
				{
					"id": 761170101,
					"content": "Aha, sieht so aus, als hättest du den Auftrag reibungslos erledigt. Danke, Fräulein Jahoda. Hier ist deine Bezahlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170102,
					"content": "Siehst du? Ich habe dir doch gesagt, dass alles glattlaufen wird. Und die Bezahlung ist auch nicht schlecht, hehe ... Hast du noch irgendwelche Aufträge, mit denen man sich eine schnelle Mora verdienen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170103,
					"content": "Ich kann bestimmt mal nachsehen, einen Moment ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170104,
					"content": "Hä? Ist das nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170105
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170105,
					"content": "He, Katheryne ... War dieser Schmuck dazu da, ein Kopfgeld auszusetzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170106,
					"content": "Das war er in der Tat. Du hast ein scharfes Auge, Fräulein Jahoda. Herr Ihanti hat ihn als Sicherheit für einen Kopfgeldauftrag hinterlegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170107,
					"content": "In diesem Fall nehme ich ihn an. Gib mir einfach die Infos dazu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170108,
					"content": "Die Sache ist nur ... dass die Belohnung dafür nicht besonders hoch ist und solche Stücke heutzutage auch nicht mehr so viel wert sind. Ich bin mir nicht sicher, ob das die Art Auftrag ist, hinter der du her bist, Fräulein Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170109,
					"content": "Keine Sorge, ich nehme ihn. Nennen wir es einfach ... etwas Wohltätigkeitsarbeit nebenher. Von Zeit zu Zeit muss man schließlich auch mal eine gute Tat vollbringen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170110,
					"content": "Haha, also gut. Bitte warte einen Moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170111,
						761170112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170111,
					"content": "Du nimmst wieder Missionen an?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170113
					]
				},
				{
					"id": 761170113,
					"content": "Na ja, im Moment habe ich auch nicht viel anderes zu tun. Ich kann schließlich nicht den lieben langen Tag herumsitzen und nur mit Ashru spielen, stimmt’s? Nef ... Ich meine Chefin Nef würde mich sonst doch rauswerfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170114
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170114,
					"content": "#Hmm, jetzt, da ihr schonmal hier seid ... {NICKNAME}, Paimon, ihr seid so geschickt, wollt ihr bei der Mission mitmachen? Wir können die Belohnung teilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170115,
					"content": "#Eine Mission? Da solltest du besser {M#ihn}{F#sie} fragen. {M#Er ist schließlich der Experte}{F#Sie ist schließlich die Expertin}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170116,
						761170117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170116,
					"content": "Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170118
					]
				},
				{
					"id": 761170118,
					"content": "Es ist bestimmt nichts Wichtiges. Glaub mir, Ihanti ist viel zu ängstlich, als dass es sich um etwas Wichtiges handeln könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170119
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170119,
					"content": "Fräulein Jahoda, hier sind die Details zu Herrn Ihantis Mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170120,
					"content": "Prima, dann sehen wir mal, was der Angsthase geschrieben hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170121
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170121,
					"content": "... Tss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170122
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170122,
					"content": "Was ist? Bitte sag Paimon nicht, dass es etwas super Schwieriges ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170123,
					"content": "Nein, nichts dergleichen. Ich hätte nur nicht erwartet, dass jemand, der nicht einmal einer Fliege etwas zuleide tun könnte, Missionen veröffentlicht, in denen es um Leben und Tod geht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170124,
						761170125
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170124,
					"content": "L... Leben und Tod?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170126
					]
				},
				{
					"id": 761170126,
					"content": "Du? Hahaha, klar ... Gesetz ist quasi dein zweiter Vorname, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170127
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170127,
					"content": "Bleib locker, ich mache doch nur Scherze. Es geht nur darum, etwas von einer Bande von Gaunern zurückzuholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170128
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170128,
					"content": "Für Gauner ist Geld das Leben, und das Leben ist Geld. Deswegen geht es wohl um Leben und Tod, stimmt’s? Haha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170129
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170129,
					"content": "Komm, folge mir. Ich bin mir ziemlich sicher, dass ich alleine mit diesen Typen fertig werde. Du wirst wahrscheinlich nicht mal einen Finger rühren müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170125,
					"content": "Ich halte mich an Recht und Gesetz, nur dass du Bescheid weißt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170126
					]
				},
				{
					"id": 761170117,
					"content": "Na gut, warum eigentlich nicht. Um welche Art von Mission geht es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170118
					]
				},
				{
					"id": 761170112,
					"content": "Viel zu tun, wie ich sehe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170113
					]
				}
			]
		},
