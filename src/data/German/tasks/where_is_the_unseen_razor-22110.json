			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100301,
					"content": "Wie sieht’s aus? Hast du ihn vernichtet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100302
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100302,
					"content": "Ja, ich habe ihn besiegt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100303
					]
				},
				{
					"id": 221100303,
					"content": "Selbst einen Ruinenjäger schaffst du ... Du scheinst mir wirklich eine ordentliche Portion zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100304
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100304,
					"content": "Du hast wohl immer noch keinen Hinweis auf den Säbel gefunden? Tja, was soll man da machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100305
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100305,
					"content": "Aber ja, vielen Dank! Du hast mir schon viel bei allen möglichen Missionen geholfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100306
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100306,
					"content": "Wo die „Versteckte Klinge“ nur ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100307,
						221100308
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100307,
					"content": "Wir werden sie bestimmt finden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100309
					]
				},
				{
					"id": 221100309,
					"content": "Versuchst du mich zu trösten? So frustriert bin ich nun auch wieder nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100310
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100310,
					"content": "Egal zu welcher Zeit oder an welchem Ort, ich werde diesen Säbel noch finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100311
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100311,
					"content": "Ich werde den Suchradius erweitern. Vielleicht werde ich dabei ja deine Hilfe brauchen. Natürlich bekommst du dafür auch eine Entlohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100316,
					"content": "Aber gut, hier ist deine Belohnung. Ich werde mir die nächsten Missionen ansehen und sie filtern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100317
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100317,
					"content": "„Versteckte Klinge“, ich werde dich noch finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100308,
					"content": "Diese Missionen klingen nicht so, als könnten sie etwas mit dem Säbel zu tun haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100312
					]
				},
				{
					"id": 221100312,
					"content": "Alle Missionen, die etwas mit dem Säbel zu tun haben könnten, habe ich nämlich schon ausgeführt. Bis zuletzt keine Spur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100313
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100313,
					"content": "Ich gehe stark davon aus, dass mein Bruder in eine höchst gefährliche Situation geraten sein muss, wenn er seine Waffe irgendwo zurücklässt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100314
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100314,
					"content": "Deswegen habe ich angefangen, weitere Missionen anzunehmen, in der Hoffnung, dass sie gefährlich genug sind, um etwas mit der „Versteckten Klinge“ zu tun zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100315
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100315,
					"content": "Es gibt aber doch ziemlich viele Missionen, die so gefährlich sind. Allein schaffe ich das nicht. Deswegen habe ich dich auch um Hilfe gebeten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Lan"
				}
			]
		}
	]
}