			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100101,
					"content": "Das hat einfach keinen Sinn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100102
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100103
					]
				},
				{
					"id": 221100103,
					"content": "Du scheinst wirklich nicht viel zu tun zu haben. Entweder ist dir langweilig, weil du so stark bist, oder du bist einfach nur zu schwach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100104
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100104,
					"content": "Aber ich denke, dass du nicht zu schwach sein dürftest. Schließlich hast du all meine Missionen ausgeführt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100105
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100105,
					"content": "Da du so viel Freizeit hast, könntest du doch noch eine Mission von mir annehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100106
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100106,
					"content": "Dieses Mal könnte es aber ein wenig gefährlicher werden. Du sollst nämlich einen Ruinenjäger besiegen. Hast du Lust?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100107,
						221100108
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100107,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100109
					]
				},
				{
					"id": 221100109,
					"content": "Du hast viel Selbstvertrauen als Abenteurer, ganz wie mein Bruder ... Vielleicht bist du ja zu Höherem auserkoren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100113,
					"content": "Wie dem auch sei, du musst zur Guili-Ebene. Sobald du vorbereitet bist, kümmerst du dich um den Ruinenjäger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100114
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100114,
					"content": "Bring mir alles, was mit dem Säbel zu tun haben könnte, sobald du ihn besiegt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100115
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100115,
					"content": "Wenn du nichts findest, macht das nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100116
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100116,
					"content": "Danke, dass du das übernimmst! Ich hoffe, dass es diesmal Spuren gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100108,
					"content": "Soll ich wieder nach dem Säbel Ausschau halten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100110
					]
				},
				{
					"id": 221100110,
					"content": "Ja, wenn du den Ruinenjäger besiegt hast, kannst du aufpassen, ob du etwas findest, was auf den Säbel deutet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100111
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100111,
					"content": "Vergiss nicht, dass es dieses Mal um einen Ruinenjäger geht. Mit denen ist nicht zu spaßen! Du musst wirklich gut aufpassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100112
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100112,
					"content": "Wenn du etwas findest, was mit dem Säbel zu tun hast, umso besser. Aber es reicht, wenn du den Ruinenjäger beseitigst, um deine Belohnung zu bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 2211002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
