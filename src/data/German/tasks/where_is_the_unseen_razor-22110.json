			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100201,
					"content": "Wie sieht’s aus? Hast du ihn vernichtet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100202
					],
					"speakerTitle": "Lan"
				},
				{
					"id": 221100202,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100203
					]
				},
				{
					"id": 221100203,
					"content": "Schon gut, bei einem Gegner wie dem Ruinenjäger muss man sich gründlich vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lan"
				}
			]
		},
		{
			"id": 2211003,
			"completionStepIds": [
				2211003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
