			"dialogs": [
				{
					"id": 732441504,
					"content": "Oh, so sehen sie also aus ... Aber wie sollen wir sie verwenden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441505
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441505,
					"content": "Biep ... Biepbiep ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441506
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441506,
					"content": "Benben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441507
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441507,
					"content": "Benben verbindet sich mit den Aufladungsumwandlungskondensatoren und entzieht schnell die Energie.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732441508
					]
				},
				{
					"id": 732441508,
					"content": "Biepbiep, biepbiep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441509
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441509,
					"content": "Juhu, Benben ist wieder am Leben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441510,
					"content": "Sag doch nicht so einen Unsinn! Benben hat vorher nur geschlafen und ist gerade aufgewacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441511
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441511,
					"content": "Biepbip ... Biepbip ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441512
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441512,
					"content": "Nein, ich habe mir keine Sorgen gemacht! Ich wusste, dass du dich eines Tages wieder erholen wirst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441513
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441513,
					"content": "Ha! „Ich werde Benben nie wieder in eine riskante Situation bringen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441514,
					"content": "Paimon, mach mir nicht nach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441515
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441515,
					"content": "Biepbiep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441516
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441516,
					"content": "#Ach ja, {NICKNAME}, Benben hat sich bedankt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441517
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441517,
					"content": "Auch wenn Benben still lag, wusste er alles, was ihr getan habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441518
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441518,
					"content": "Bitte schön, Benben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441519
					]
				},
				{
					"id": 732441519,
					"content": "Biepbiep!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441520
					],
					"speakerTitle": "Benben"
				},
				{
					"id": 732441520,
					"content": "Hm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441521
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441521,
					"content": "Was ist los, Jeht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441522,
					"content": "Obwohl er aufgewacht ist, muss sich Benben noch ein wenig erholen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441523
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441523,
					"content": "Genau! Erhol dich gut, Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441524,
					"content": "Biepbiep ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benben"
				}
			]
		},
		{
			"id": 7324417,
