			},
			"dialogs": [
				{
					"id": 732441901,
					"content": "„Aufladungsumwandlungskondensatoren“ ... Ich hoffe, Benben wird sich erholen, wenn wir sie erst einmal haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441902
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441902,
					"content": "Wenn du dich nicht sicher fühlst, gehe ich auch mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441903,
						732441904
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441903,
					"content": "Du bleibst hier mit Benben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				},
				{
					"id": 732441905,
					"content": "Gut, ich warte auf deine gute Nachricht ... Pass gut auf dich auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441904,
					"content": "Wir kommen gleich wieder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				}
			]
		},
