			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Unterhändler der Fatui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732441701,
					"content": "B... Bitte hört auf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441702
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441702,
					"content": "Vergebt uns! Wenn ihr weitermacht, könnten wir sterben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441703
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441703,
					"content": "Es ist ziemlich überzeugend von jemandem, der geschlagen wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441704,
					"content": "Sag einfach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441705,
					"content": "Komm schon, spuck es aus!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441706
					]
				},
				{
					"id": 732441706,
					"content": "Ja, ja! Ich werde euch alles erzählen! Alles, was ihr wissen wollt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441707
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441707,
					"content": "Sag zuerst, was du weißt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441708,
					"content": "Wir haben gerade ein paar Geschäfte mit Aderfi gemacht ... Ich habe gehört, dass die Matriarchin von Tanit eine Vorliebe für Azariq und ein neu angekommenes Mädchen hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441709
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441709,
					"content": "He, ich weiß nicht warum, aber es scheint, dass Azariq auch verschwunden ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441710
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441710,
					"content": "Diese Frau ist gnadenlos und wird niemanden dulden, der für den Stamm an Wert verloren hat ... Deswegen hat Aderfi sich an uns gewandt, um seine Position zu erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441711
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441711,
					"content": "Unsere Arbeit in der Wüste war vorher nicht sehr gut gelaufen ... Wir wollten schon immer mit jemandem wie Aderfi zusammenarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441712,
						732441716
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441712,
					"content": "An Wert verloren ... Was soll das bedeuten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441713
					]
				},
				{
					"id": 732441713,
					"content": "Ich weiß es nicht ... Wirklich nicht! Das hat mit den internen Angelegenheiten der Wüstenbewohner zu tun ... Aber wenn ich raten müsste, könnte es daran liegen, dass diese Frau uns nicht mehr für vertrauenswürdig hielt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441714
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441714,
					"content": "... Deshalb hat sie sich von uns distanziert. Und Aderfi, der häufig mit uns in Kontakt war, war auch sehr unruhig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441715
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441715,
					"content": "Schließlich können wir diesen verdammten Ort jederzeit verlassen. Aderfi hingegen wird nur von seinem Stamm ausgenutzt werden. Sein Leben wird dann von ihnen bestimmt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441724,
					"content": "Aber er war äußerst gerissen. Irgendwie brachte er uns dazu, alle seine Wünsche zu erfüllen und wir bekamen nie etwas von den Dingen, die wir wollten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441725
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441725,
					"content": "Wir haben gehört, dass ihm etwas zugestoßen war ... Wir waren uns nicht sicher, was genau passiert ist, aber wir sahen es als eine Gelegenheit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441726
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441726,
					"content": "Gelegenheit? Was für eine Gelegenheit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441727,
					"content": "Da wir davon ausgegangen sind, dass es in Zukunft nicht mehr viele Chancen geben würde, mit Aderfi Handel zu treiben, haben wir ihn gebeten, das sogenannte speziale Urkonstrukt mitzubringen, das er in seinen Briefen erwähnt hatte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441728
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441728,
					"content": "Wenn wir das stehlen könnten, bevor wir diesen Ort für immer verlassen, würden wir wenigstens nicht mit leeren Händen abreisen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441729
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441729,
					"content": "Was? Ihr wollt also auch etwas rauben? Kein Wunder, dass wir keine Waren oder Aufladungsumwandlungskondensatoren finden konnten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441730,
					"content": "Hm? Hast du gerade „auch“ gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441731,
						732441732
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441731,
					"content": "Genau, gib mir einfach den „Aufladungsumwandlungskondensator“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441733,
					"content": "Hmm ... Sag Paimon nicht, dass der sogenannte Aufladungsumwandlungskondensator nur von euch erfunden ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441734,
					"content": "Nein, die Aufladungsumwandlungskondensatoren gibt es tatsächlich. Es gibt viele davon, aber da es sich um uralte Relikte handelt, weiß ich nicht, ob sie noch funktionieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441735
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441735,
					"content": "Sag mal, wo können wir sie finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441736,
					"content": "Paimon sieht so mächtig aus!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441737
					]
				},
				{
					"id": 732441737,
					"content": "#Hehe, wirklich? ... Aber wechsle nicht das Thema, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441738
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441738,
					"content": "Sag! Wo habt ihr sie hingetan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441739,
					"content": "... In einem Stützpunkt nicht weit von hier entfernt. Hier ist der Schlüssel dazu. Ich habe euch alles gesagt, was ich weiß ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441740,
						732441741
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441740,
					"content": "Verschwinde!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441742,
					"content": "Ja, ja, ich verschwinde sofort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441741,
					"content": "Erscheine nie wieder vor uns!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441742
					]
				},
				{
					"id": 732441732,
					"content": "Du hast das Pech, uns zu begegnen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441733
					]
				},
				{
					"id": 732441716,
					"content": "Was ist eure Arbeit in der Wüste?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441717
					]
				},
				{
					"id": 732441717,
					"content": "... Das ist ein Geheimnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441718
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441718,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441719
					]
				},
				{
					"id": 732441719,
					"content": "#He, du hast {NICKNAME} verärgert! Mit {M#ihm}{F#ihr} sollte man sich nicht anlegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441720,
					"content": "Ah, natürlich, natürlich! Bitte sei nicht so ärgerlich, ich werde es einfach sagen! Obwohl ... Obwohl ich davon nicht viel weiß ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441721
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441721,
					"content": "Unsere Arbeit ist es, den aktuellen Zustand der Stämme der Wüstenbewohner zu untersuchen, sie durch Handel anzulocken und in die Stämme einzudringen, um damit die Aufmerksamkeit der Weisen zu erregen ... So können wir den Elf in der Stadt Sumeru helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441722
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441722,
					"content": "Außerdem suchte Professor Froderock in der Wüste nach lebenden Exemplaren. Er widersetzte sich immer den Anweisungen von „Il Dottore“ ... Das ist nur pure Eifersucht, wenn du mich fragst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441723
					],
					"speakerTitle": "Unterhändler der Fatui"
				},
				{
					"id": 732441723,
					"content": "Ähem, ich bin zu weit gegangen ... Jedenfalls war Aderfi unsere Kontaktperson, er war für alles zuständig, was mit Handel zu tun hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441724
					],
					"speakerTitle": "Unterhändler der Fatui"
				}
			]
		},
