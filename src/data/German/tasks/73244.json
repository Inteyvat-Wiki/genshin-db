			},
			"dialogs": [
				{
					"id": 732440801,
					"content": "Jeht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440803,
					"content": "Wie war’s? Ihr seid doch nicht in Schwierigkeiten geraten, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440802
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440802,
					"content": "Nein, nein, alles läuft ganz gut! Sieh hier! Wir haben die „Aufladungsumwandlungskondensatoren“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7324410,
			"completionStepIds": [
				7324419
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324419",
							"2"
						],
						"stepId": 7324419,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht",
					"Benben"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732441001,
					"content": "Ah, Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441002,
					"content": "Gut, dass Aderfi nicht rechtzeitig da war, um Benben wegzuholen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441003
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441003,
					"content": "Man könnte sogar sagen, dass hier alles wie früher ist. Es hat sich nichts geändert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441004
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441004,
					"content": "Glaubte er wirklich, er würde die Matriarchin umstoßen und sicher in sein Zelt zurückkehren? Was für ein egozentrischer Idiot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441005
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441005,
					"content": "Aber dank dieses Idioten ist Benben nichts Schlimmes passiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441006
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441006,
					"content": "Nichts Schlimmes? Benben ... Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441007,
						732441008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441007,
					"content": "Was ist mit ihm passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				},
				{
					"id": 732441009,
					"content": "Ja, warum liegt er auf dem Boden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441010,
					"content": "Was ist mit ihm passiert? Beim letzten Mal ging es Benben noch gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441011,
					"content": "Nachdem wir Khaj-Nisut verlassen hatten, wurde Benben immer schwächer ... Es sah so aus, als ob seine Teile nicht mehr richtig funktionierten und seine Pieptöne wurden immer leiser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441012
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441012,
					"content": "Bis er eines Tages keinen Laut mehr von sich gab und sich nicht mehr bewegte. Es war, als würde seine Lebenskraft allmählich verschwinden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441013
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441013,
					"content": "Zu diesem Zeitpunkt wusste niemand im Stamm außer Aderfi, was mit Benben los war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441014
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441014,
					"content": "Deshalb habe ich Benben bei Aderfi gelassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441015
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441015,
					"content": "Wie konnte das passieren ... Wird Benben für immer so bleiben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441016,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441017
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441017,
					"content": "Benben ist immer noch bei uns, das ist das Wichtigste. Eines Tages werde ich einen Weg finden, Benben zu reparieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441018
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441018,
					"content": "Aber jetzt haben wir gar keine Ahnung, was wir tun sollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441019,
					"content": "Hmm, ich erinnere mich, dass Aderfi mir sagte, dass Benbens Problem nicht sehr ernst ist und er die Ursache in ein paar Tagen herausfinden kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441020
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441020,
					"content": "Wie ich ihn kenne, hätte er bei seinen Ermittlungen bestimmt Aufzeichnungen hinterlassen. Schauen wir uns in der Gegend um!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441021
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441021,
					"content": "Wenn es wirklich „nicht sehr ernst“ ist, können wir vielleicht versuchen, Benben selbst zu reparieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441008,
					"content": "Was ist mit Benben los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				}
			]
		},
