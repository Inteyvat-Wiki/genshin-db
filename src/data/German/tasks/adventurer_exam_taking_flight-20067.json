			"dialogs": [
				{
					"id": 200670101,
					"content": "Wo ist das Problem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670103
					]
				},
				{
					"id": 200670103,
					"content": "#{F#Reisende}{M#Reisender} ... *schluchz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670104,
					"content": "Seit dem letzten Mal, als du mir Nachhilfe gegeben hast, habe ich wieder sehr fleißig gelernt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670105,
					"content": "Dann habe ich Jack gebeten, mir bei einem Übungstest zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670106,
					"content": "Das Ergebnis ... Das Ergebnis war, dass ich die Prüfung nicht bestanden habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670107,
					"content": "#Ich weiß wirklich nicht, was schief gelaufen ist ... {F#Reisende}{M#Reisender}, kannst du mir ein bisschen mehr Nachhilfe geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670108,
						200670109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670108,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670110
					]
				},
				{
					"id": 200670110,
					"content": "#Dann zähle ich auf dich, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200670111
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670111,
					"content": "Nun ... Die erste Frage ist, wie viele Personen können sich beim Fliegen einen Windgleiter gleichzeitig teilen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200670109,
					"content": "(War das letzte Mal etwas falsch ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200670110
					]
				}
			]
		},
