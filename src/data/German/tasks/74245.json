			"dialogs": [
				{
					"id": 742162101,
					"content": "Bruder ... Wenn du gleich mit mir zur Werkstatt zurückkehrst und dort Martha und Moce triffst, dann sag erstmal nichts. Ich werde euch einander vorstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742162102
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742162102,
					"content": "Also gut, wie du willst! Doch wer sind Martha und Moce eigentlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742162103
					],
					"speakerTitle": "Giustino"
				},
				{
					"id": 742162103,
					"content": "Martha ist meine Frau und Moce ist mein Sohn. Wenn ich mich recht erinnere, hast du damals auch die Tochter der Valier-Familie kennengelernt. Sie kam damals oft zur Werkstatt, um ... Spielt keine Rolle, lass uns das besprechen, nachdem du sie getroffen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
