				"points": []
			},
			"dialogs": [
				{
					"id": 735340901,
					"content": "Du bist also die fähige Person, die Dharmakirti zuvor erwähnt hatte. Ich bin Piyush, es ist mir ein Vergnügen, dich kennenzulernen. Ich arbeite in der Architekturbranche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340902
					],
					"speakerTitle": "Piyush"
				},
				{
					"id": 735340902,
					"content": "Kaveh hat mir von dir erzählt, aber ich hatte noch nicht die Gelegenheit, dich persönlich kennenzulernen. Was für ein glücklicher Zufall, dass wir heute hier sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340903
					],
					"speakerTitle": "Piyush"
				},
				{
					"id": 735340903,
					"content": "Ich schätze, ich werde von dem Projekt träumen, das ich gerade abgeschlossen habe. Es war ein absoluter Albtraum ... Es ist nur schade, dass wir uns zum ersten Mal bei einer so peinlichen Gelegenheit kennenlernen. Hach ... schon gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piyush"
				}
			]
		},
