				"objectNames": [
					"Collingwood"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735340101,
					"content": "#Guten Tag! Bist du {F#diejenige, die}{M#derjenige, der} mir bei der Traumtherapie hilft? Um ehrlich zu sein, weiß ich nicht, was in meinem Traum vorkommen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340102
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340102,
					"content": "Ich komme aus Mondstadt und habe eigentlich keine Hobbys ... Na ja, eines, wenn man das Trinken dazuzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340103
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340103,
					"content": "Und wenn ich betrunken bin, bringe ich oft alles durcheinander, also ... bitte, ich zähle auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collingwood"
				}
			]
		},
		{
			"id": 7353402,
