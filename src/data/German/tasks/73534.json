				{
					"id": 735340601,
					"content": "Ach! Ihr Youkai von Inazuma, wo versteckt ihr euch nur!? Kommt heraus und zeigt mir eure Gesichter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
