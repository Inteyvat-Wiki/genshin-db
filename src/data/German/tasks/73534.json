			"dialogs": [
				{
					"id": 735340401,
					"content": "Oh bitte, egal ob ihr göttlich oder teuflisch seid, habt Erbarmen mit mir und hört auf, mir aufzulauern, ich kann es wirklich nicht mehr ertragen!",
					"roleType": "TALK_ROLE_NPC",
