				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735340301,
					"content": "Schön, dich kennenzulernen. Wir werden bald gemeinsam in denselben Traum eintreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340302
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340302,
					"content": "Ich bin Youguang, eine Transportwache aus Liyue. Ich bin auf dem Transportweg auf ein paar ... „unsaubere“ Dinge gestoßen und habe seitdem nicht mehr gut geschlafen. Deshalb bin ich hier, um Hilfe zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340303
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340303,
					"content": "Ich wäre dir sehr dankbar, wenn du meine Albträume durch diese Traumtherapie vertreiben könntest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Youguang"
				}
			]
		},
		{
			"id": 7353404,
