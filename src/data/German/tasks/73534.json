			"dialogs": [
				{
					"id": 735340201,
					"content": "Je mehr ich mir diese Taverne ansehe, desto seltsamer erscheint sie mir ... *hicks* ... Hm ... Es ist, als ob die Dinge nicht wie üblich platziert sind ...",
					"roleType": "TALK_ROLE_NPC",
