					"Nitesh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735340701,
					"content": "#Oh, {F#die qualifizierte Freiwillige}{M#der qualifizierte Freiwillige} für die Experimente der Traumtherapie ist also ein so junger Mensch? Meine Güte, sind junge Leute heutzutage nicht beeindruckend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340702
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340702,
					"content": "Bitte nenn mich einfach Nitesh. Ich bin ein reisender Gelehrter der Stoffkunde. Zurzeit arbeite ich langfristig in Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340703
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340703,
					"content": "#Das Alter bringt alle möglichen Probleme mit sich. {F#Junge Frau}{M#Junger Mann}, ich verlasse mich darauf, dass du später im Traum herausfindest, was die Ursache für mein Problem ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nitesh"
				}
			]
		},
		{
