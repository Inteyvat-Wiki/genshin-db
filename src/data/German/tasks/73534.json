					"Higuchi Tetsuya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735340501,
					"content": "Ich freue mich, dich kennenzulernen. Ich bin Higuchi Tetsuya, ein Youkai-Roman-Autor aus Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340502
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340502,
					"content": "Ich stand in letzter Zeit sehr unter Druck und konnte mit meinem Roman nicht vorankommen. Ich bin bereit, alles zu versuchen, um wieder auf die Beine zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340503
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340503,
					"content": "Und ich möchte mich im Voraus für alle seltsamen Dinge entschuldigen, die du später sehen könntest. Schließlich handelt es sich um einen Traum, der auf den Problemen basiert, mit denen ich derzeit zu tun habe, daher könnte er viele Dinge enthalten, die ... einen starken persönlichen Stil aufweisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Higuchi Tetsuya"
				}
			]
		},
		{
