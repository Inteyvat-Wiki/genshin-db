			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Mehr Sein als nur Schein“"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-352.046,
							200.421,
							-699.884
						],
						"pointId": 7030
					}
				]
			},
			"dialogs": [
				{
					"id": 716665001,
					"content": "Das ergibt keinen Sinn ... Wie konntest du das tun!? Mei... Meine Reputation ist zerstört!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665002
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665002,
					"content": "Es war mir eine Ehre, gegen dich zu kämpfen, mein Herr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665003
					],
					"speakerTitle": "„Mehr Sein als nur Schein“"
				},
				{
					"id": 716665003,
					"content": "Was zum ... So höflich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665004,
					"content": "Haha! Wie es aussieht, hast du die ein oder andere Niederlage kassiert, als wir nicht da waren, Kuhh{RUBY#[S]„Großer Oni-König des Käferkampfes“}irte!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665005,
					"content": "Ich sehe das anders. Sofern der Große Oni-König des Käferkampfes jetzt nicht aufgibt, ist seine Niederlage gegen mich noch nicht besiegelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665006
					],
					"speakerTitle": "„Mehr Sein als nur Schein“"
				},
				{
					"id": 716665006,
					"content": "In der Schlacht wie im Leben sind gelegentliche Rückschläge normal. Aus einem Rückschlag wird nur dann ein Scheitern, wenn man aufhört, es zu versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665007
					],
					"speakerTitle": "„Mehr Sein als nur Schein“"
				},
				{
					"id": 716665007,
					"content": "Ganz genau! Gut gesprochen! Ich gebe mich nicht geschlagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665008,
					"content": "Es führt zu nichts, ständig Ausflüchte zu suchen. Verwende nicht so viel deiner Energie darauf, Müll zu reden ... widme dich dafür lieber mit mehr Kraft dem Kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665009
					],
					"speakerTitle": "„Mehr Sein als nur Schein“"
				},
				{
					"id": 716665009,
					"content": "Argh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665010
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665010,
					"content": "Oni-König, dieser Gegner fällt nicht in dein Spezialgebiet. Hör auf meinen Rat und schicke einen weiteren deiner Generäle ins Duell, während du den Verlauf beobachten kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665011
					],
					"speakerTitle": "„Marschall Hanakado“"
				},
				{
					"id": 716665011,
					"content": "Anderen beim Kämpfen zuzusehen, ist ein integraler Bestandteil des Trainings von Kriegern. Manche Fähigkeiten erlernt man in der Praxis, andere durch Beobachtung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665012
					],
					"speakerTitle": "„Marschall Hanakado“"
				},
				{
					"id": 716665012,
					"content": "#Sehr guter Vorschlag, Marschall! Welch eine glückliche Fügung, {M#mein bester Freund}{F#meine beste Freundin}! „Treue rechte Hand des Oni-Königs“, der Kampf soll dir gehören!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665013
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665013,
					"content": "#Hehe, endlich bist du dran! Mach was draus, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665014,
						716665015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665014,
					"content": "Hehe! Locker-flockig!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				},
				{
					"id": 716665016,
					"content": "#So, ich werde also gegen {M#den legendären}{F#die legendäre} {NICKNAME} antreten? Dann sollte ich wohl besser wachsam sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Mehr Sein als nur Schein“"
				},
				{
					"id": 716665015,
					"content": "Uh ... oh! Ich habe Angst!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				}
			]
		},
		{
