						],
						"pointId": 7030
					}
				]
			},
			"dialogs": [
				{
					"id": 716665101,
					"content": "Vortrefflich gemacht. Du hast mich geschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665102
					],
					"speakerTitle": "„Mehr Sein als nur Schein“"
				},
				{
					"id": 716665102,
					"content": "#Ich würde sagen, es gereicht mir zur Ehre, dir unterlegen zu sein, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665103
					],
					"speakerTitle": "„Mehr Sein als nur Schein“"
				},
				{
					"id": 716665103,
					"content": "Aaah, so machst du das! Das wäre mir nie eingefallen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665104,
					"content": "Jupp! Wer gegen einen trickreichen Gegner kämpft, muss einfallsreich sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665105,
					"content": "Schlägt deine Strategie fehl, dann verändere deinen Blickwinkel. Auf unseren Reisen müssen wir oft spontan reagieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665106,
					"content": "Du wirst mit alten Methoden keine neuen Probleme lösen, auch wenn du es noch so sehr versuchst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665107,
					"content": "Ich glaube, Shinobu hat einmal so etwas Ähnliches gesagt. Es muss wohl etwas dran sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665108,
					"content": "Darüber werde ich ein andermal nachdenken. Jetzt geht es um die drängendsten Aufgaben: Noch mehr Käferkämpfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
