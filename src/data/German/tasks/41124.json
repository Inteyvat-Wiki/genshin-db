			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240201,
					"content": "Oh, endlich bist du da. Ich habe auf dich gewartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240202
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240202,
					"content": "Wofür denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240203
					]
				},
				{
					"id": 411240203,
					"content": "Komm schon, sei nicht so kalt. Ich habe eine dringende Bitte an dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240204,
					"content": "Sicher sind dir die gefallenen Sterne aufgefallen. Es hat zwar keiner Mondstadt getroffen, doch es herrscht trotzdem überall Aufruhr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240205
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240205,
					"content": "Und wo Rauch ist, da ist auch Feuer. Es gibt immer jemanden, der die Lage ausnutzen will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240206,
						411240208
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240206,
					"content": "Du meinst die Schatzräuber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240207
					]
				},
				{
					"id": 411240207,
					"content": "Wie scharfsinnig. Du hast wirklich einige Erfahrung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240212,
					"content": "Die Ritter sind zwar alarmiert, doch bei all der Hilfe, die sie um die Stadt herum bieten müssen, gibt es zwangsläufig Lücken in der Verteidigung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240213
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240213,
					"content": "Diese geldgierigen Schatzräuber planen garantiert, diese Lücken auszunutzen, um „Mordskohle“ zu machen, wie sie sich ausdrücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240214,
						411240217
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240214,
					"content": "Wo komme ich ins Spiel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240215
					]
				},
				{
					"id": 411240215,
					"content": "Oh, das nenne ich eine direkte Antwort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240216
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240216,
					"content": "Der Notfallplan, den dieser Herr mir gab, war wohl doch nicht notwendig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240222,
					"content": "Kurz gesagt, hat der Herr die Schatzräuber erwischt, die zuvor uns ausgespäht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240223
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240223,
					"content": "Es handelt sich um drei verschiedene Banditengruppen, die das allgemeine Chaos für sich nutzen wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240224
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240224,
					"content": "Wir spielen also mit und bieten ihnen die perfekte Gelegenheit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240225,
						411240226
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240225,
					"content": "Und wo komme ich ins Spiel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240231
					]
				},
				{
					"id": 411240231,
					"content": "Deine Aufgabe ist einfach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240232
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240232,
					"content": "Um nicht gefangen zu werden, erstatten die Schatzräuber nicht direkt Bericht. Stattdessen hinterlassen sie ihre Informationen in Briefen an bestimmten Standorten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240233
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240233,
					"content": "Um weitere Probleme zu vermeiden, schickten sie ebenfalls drei Späher aus, die diese Infos dann an drei verschiedene Orte brachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240234
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240234,
					"content": "Sicher haben sie nicht erwartet, dass alle drei erwischt werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240235
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240235,
					"content": "Die nächsten Schritte der restlichen Schatzräuber hängen von diesen Infos ab. So entscheiden sie, wo sie einfallen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240236
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240236,
					"content": "Doch diesmal ersparen wir ihnen die Mühe. Der Herr hat die Pläne bereits für sie ausgearbeitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240237
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240237,
					"content": "Nimm diese drei Briefe mit und hinterlege sie an den Orten, die von den Schatzräubern vereinbart wurden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240238
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240238,
					"content": "Kehre anschließend zu mir zurück und erstatte Meldung. Was danach kommt ... besprechen wir später, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240226,
					"content": "Ist das auch glaubwürdig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240227
					]
				},
				{
					"id": 411240227,
					"content": "Haha, du bist wirklich vorsichtig, oder? Keine Sorge, die Schatzräuber haben kein Rückgrat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240228
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240228,
					"content": "Letzten Endes handelt es sich um einen Haufen Kleinkriminelle, die nur aufs Geld aus sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240229
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240229,
					"content": "„Es gibt Mora zu verdienen, aber versucht ja nichts Komisches ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240230
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240230,
					"content": "Nachdem wir diese Vereinbarung trafen, waren sie rasch bereit zu kooperieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240231
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240217,
					"content": "Die Ritter kommen damit zurecht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240218
					]
				},
				{
					"id": 411240218,
					"content": "Haha, ich dachte, dass du das sagen würdest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240219
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240219,
					"content": "Keine Sorge, der Herr hat diesmal großzügige Mittel bereitgestellt. Du wirst wohl entschädigt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240220
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240220,
					"content": "Und falls du während dieser Aufgabe etwas findest, darfst du es behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240221
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240221,
					"content": "Diese Aufgabe erfordert deine eigene Handschrift.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240208,
					"content": "Du meinst Hilichurle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240209
					]
				},
				{
					"id": 411240209,
					"content": "Haha, natürlich nicht. Die würden doch auffallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240210
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240210,
					"content": "Bestimmt sind die Ritter bereit, falls sie sich der Stadtmauer nähern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240211
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240211,
					"content": "Ich meine die Schatzräuber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 4112406,
			"completionStepIds": [
				4112406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
