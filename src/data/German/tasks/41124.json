	"talks": [
		{
			"id": 4112402,
			"completionStepIds": [
				4112402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
