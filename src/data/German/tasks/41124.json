				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240601,
					"content": "Hast du die Briefe platziert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240602
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240602,
					"content": "Ja, habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240603
					]
				},
				{
					"id": 411240603,
					"content": "Das sollte reichen. Die Schatzräuber werden ihre Pläne an den Informationen in diesen Briefen ausrichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240604
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240604,
					"content": "Ihr „perfekter Moment“ sollte irgendwann zwischen Anbruch der Nacht und Dämmerung liegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240605
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240605,
					"content": "Was ihren „perfekten Zugangspunkt“ betrifft ... Nun, es kann nur einen geben, oder? Ich markiere ihn auf deiner Karte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240606
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240606,
					"content": "Das sollte genügen. Jetzt müssen wir nur noch warten, dass die Schatzräuber in unsere Falle tappen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240607,
						411240610
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240607,
					"content": "Was passiert, wenn der Ordo Favonius dahinterkommt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240608
					]
				},
				{
					"id": 411240608,
					"content": "Eine berechtigte Fragen. Unsere ungewohnten Methoden könnten uns Ärger einhandeln, falls die Ritter Wind bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240609
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240609,
					"content": "Der Herr hat uns jedoch garantiert, dass dies nicht passieren wird. Also ... haben wir ein wenig Vertrauen, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240612,
					"content": "Warten wir also nur bis Anbruch der Nacht. Dann schnappen wir uns die Schatzräuber, wenn sie in die Falle tappen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240610,
					"content": "Und wenn die Schatzräuber nicht auftauchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240611
					]
				},
				{
					"id": 411240611,
					"content": "Oh, das werden sie. Sorge dich nicht darum. Der Herr persönlich hat die Pläne ausgearbeitet. Es wird nichts schiefgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 4112408,
			"completionStepIds": [
				4112408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112408",
							"2"
						],
						"stepId": 4112408,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240801,
					"content": "Hast du dich um die Schatzräuber gekümmert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240802
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240802,
					"content": "Ich habe mich gut um sie gekümmert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240803
					]
				},
				{
					"id": 411240803,
					"content": "Haha, von jemanden, der dem Herrn ins Auge fällt, habe ich nichts anderes erwartet. Äußerst effizient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240804
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240804,
					"content": "Hier ist deine Entschädigung. Es war ein Vergnügen ... mit dir zu arbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240805
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411240805,
					"content": "Mit etwas Glück arbeiten wir wieder mal zusammen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
