			},
			"dialogs": [
				{
					"id": 411245201,
					"content": "Du bist noch nicht aufgebrochen? Hast du also noch weitere Fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245202,
						411245205
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245202,
					"content": "Wer ist dieser Herr überhaupt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411245203
					]
				},
				{
					"id": 411245203,
					"content": "Hmm. Tatsächlich seid ihr beide alte Bekannt. Er meint, ihr habt schon einmal Seite an Seite gekämpft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245204
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245204,
					"content": "Ich darf dir seinen Namen aber nicht nennen. Das würde mich den Kopf kosten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245205,
					"content": "Warum nehmen wir die Schatzräuber nicht einfach direkt gefangen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411245206
					]
				},
				{
					"id": 411245206,
					"content": "Befürchtest du etwa, dass die restlichen Schatzräuber fliehen, nachdem wir die drei Banden geschnappt haben, die wir mit unseren Nachrichten angelockt haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245207
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245207,
					"content": "Nun, das stimmt, aber genau das ist seine Absicht. Der Herr wünscht sie nicht alle zu fangen. Er will sie bloß abschrecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245208
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245208,
					"content": "Bei der aktuellen Lage können die Ritter niemanden entbehren, um großflächig Jagd auf sie zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245209
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245209,
					"content": "So oder so haben die gefallenen Sterne aktuell oberste Priorität.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411245210
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 411245210,
					"content": "Die Schatzräuber müssen bloß davon überzeugt werden ... fürs Erste keinen Ärger zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
