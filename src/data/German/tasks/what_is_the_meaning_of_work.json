			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111301,
					"content": "Veilchengold-Anglermöwen, Veilchengold-Anglermöwen. Lasst uns in Ruhe, sobald ihr die Pommes aufgegessen habt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111302,
						240111303
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111302,
					"content": "Und, wie läuft es jetzt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				},
				{
					"id": 240111304,
					"content": "Nein, nicht im Geringsten. Als sich die Veilchengold-Anglermöwen über meine Pommes hergemacht haben, hat er sich sofort zitternd hinter meinem Rücken versteckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111305,
					"content": "*seufz* Ich mache ihm ja keinen Vorwurf. Solche Hunde haben seit ihrer Geburt ja nur eine Aufgabe, die Menschen zu lieben und von ihnen geliebt zu werden ... Er hat ja nie gelernt, zu kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111306
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111306,
					"content": "Nun, das ist sozusagen die Pflicht von uns Menschen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111307
					]
				},
				{
					"id": 240111307,
					"content": "Vielleicht. Aber in einigen Situationen stellt Liebe auch Macht dar. Und sobald das Wort Macht eine Rolle spielt, geht irgendetwas schief ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111308
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111308,
					"content": "Entschuldige, ich rede zu viel. Ich musste mich in den letzten Tagen um zu viele emotionsgeladene Streitigkeiten kümmern, meine Gedanken müssen erst zur Ruhe kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111309
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111309,
					"content": "*seufz* Jetzt stellt sich mir nur noch die Frage, wie ich in Ruhe meine Pommes essen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111303,
					"content": "Ist dir das Hündchen eine Hilfe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				}
			]
		},
