			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240111201,
					"content": "Hm ... Warum isst du nicht mal woanders?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111202
					]
				},
				{
					"id": 240111202,
					"content": "Ich finde jetzt auf die schnelle keinen geeigneten Platz zum Essen. Wenn ich zu nahe am Palais Mermonia bleibe, könnten die Kollegen mich sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111203
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111203,
					"content": "Dann würden sie mich nicht mehr in Ruhe lassen und beim Essen die ganze Zeit über die Arbeit reden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111204,
					"content": "Wenn ich mich aber zu weit vom Palais Mermonia entferne, komme ich vielleicht nicht rechtzeitig zurück und verpasse eine wichtige Angelegenheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111205
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111205,
					"content": "Unter diesen Umständen ist hier der einzige Ort, an dem ich ungestört essen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
		{
			"id": 2401113,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
