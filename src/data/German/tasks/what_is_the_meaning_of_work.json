			"dialogs": [
				{
					"id": 240111401,
					"content": "Ich werde sie entfernen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111402
					]
				},
				{
					"id": 240111402,
					"content": "Bitte, aber ... Könntest du die Veilchengold-Anglermöwen einfach nur vertreiben? Sie wollen ja nichts Böses, nur ein paar Pommes fressen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111403,
					"content": "Ähm ... Also, das ist für mich schon ärgerlich, aber auch keine große Sache, also ... verscheuche sie doch bitte einfach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
