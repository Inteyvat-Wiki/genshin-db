				{
					"id": 240111501,
					"content": "Ich werde sie mit etwas anderem füttern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111502
					]
				},
				{
					"id": 240111502,
					"content": "Oh? Das ist eine gute Idee. Aber es sind ja so viele Veilchengold-Anglermöwen, kannst du die denn alle füttern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111503
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111503,
					"content": "Nun ... sie müssen ja nicht satt werden, solange ich genug Zeit habe, um meine Pommes zu essen. Also gut, dann zähle ich auf dich.",
					"roleType": "TALK_ROLE_NPC",
