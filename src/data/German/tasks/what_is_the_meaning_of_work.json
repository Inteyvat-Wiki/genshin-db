			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240110101,
					"content": "Veilchengold-Anglermöwen, Veilchengold-Anglermöwen. Mir ist ja klar, dass ihr hungrig seid, aber ich hab selbst noch nicht richtig gegessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110102,
					"content": "Egal. Wenn es euch so glücklich macht, ist alles gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110103,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110104
					]
				},
				{
					"id": 240110104,
					"content": "#{M#Reisender}{F#Reisende}? Schön, dich zu sehen. Wenn du etwas Dienstliches von mir willst, musst du dich noch etwas gedulden, ich esse gerade Pommes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110105,
						240110107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110105,
					"content": "Ich will nichts Dienstliches.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110106
					]
				},
				{
					"id": 240110106,
					"content": "Na dann. Gut so, ich muss nämlich meine Pommes aufessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110108,
					"content": "Na, das ist meine Mahlzeit. Ich habe heute noch einen Termin mit Herrn Roialte, deshalb muss ich mich mit dem hier begnügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110109,
					"content": "Ich bin es nicht gewohnt, im Palais Mermonia zu essen. Deshalb suche ich mir oft draußen ein ruhiges Plätzchen für eine schnelle Mahlzeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110110,
					"content": "Aber heute ... Diese Veilchengold-Anglermöwen müssen verrückt geworden sein, ständig klauen sie mir meine Pommes und werden doch niemals satt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110111,
						240110112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110111,
					"content": "Weil es immer noch eine Menge hungriger Veilchengold-Anglermöwen gibt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110113,
					"content": "Ja, da hast du auch wieder recht. Aber ich kann doch nicht jede einzelne Veilchengold-Anglermöwe mit Pommes füttern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110114
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110114,
					"content": "Sind das etwa nicht deine Pommes? Die kannst du doch nicht einfach so den Veilchengold-Anglermöwen überlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110115,
					"content": "Sonst wirst du hungern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110116,
						240110117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110116,
					"content": "Belastet dich etwas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110118,
					"content": "Wie bitte? Nein, nichts ... Ja, gut, es gibt da was. Deinen scharfen Augen entgeht nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110119,
					"content": "Ich weiß einfach nicht, was meine Arbeit für einen Sinn hat. Wenn ich mich den ganzen Tag in der Maison Gestion abrackere, habe ich am Ende doch nichts Greifbares erreicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110120
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110120,
					"content": "Ich habe keiner bestimmten Person geholfen oder das Leben von irgendjemandem bequemer gemacht. Herr Roialte wiederholt zwar ständig, dass unsere Arbeit wichtig ist, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110121
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110121,
					"content": "Ich sitze nur den ganzen Tag an der Schreibmaschine, tippen, tippen, tippen, ohne Unterlass. Aber was hat das für einen Sinn? Genauso gut kann ich auch wieder eine Tastenkappe verlieren, dann bekommt Estelle wenigstens wieder etwas Geld ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110122
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110122,
					"content": "Entschuldige, ich sollte nicht so viel schwafeln. Ich bin nur etwas orientierungslos, ich weiß nicht, was das alles für einen Sinn hat. Vielleicht ... Vielleicht brauche ich nur etwas Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110123,
						240110124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110123,
					"content": "Iss dich doch erst einmal satt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110125,
					"content": "Da hast du recht. Aber im Augenblick ... habe ich nicht die Zeit, mir noch eine Portion Pommes zu kaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110126
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110126,
					"content": "Egal, die Pommes überlasse ich einfach den Veilchengold-Anglermöwen. Ich werde mir noch etwas zu essen kaufen, wenn ich die Sache mit Herrn Roialte erledigt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110127
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110127,
					"content": "Nun ... ähm ... ein halber Tag sollte reichen, das ist ja nicht zu lang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110128
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110128,
					"content": "Hältst du das denn durch, wenn du so lange nichts isst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110129,
						240110130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110129,
					"content": "Ich kümmer mich um die Veilchengold-Anglermöwen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110131,
					"content": "Wäre ... das nicht zu viel Arbeit? Es sind doch nur Pommes, du brauchst doch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110132
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110132,
					"content": "Du musst essen! Mit leerem Magen kannst du doch nicht arbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110130,
					"content": "Ich werde die Veilchengold-Anglermöwen vertreiben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110124,
					"content": "Du solltest zuerst diese Veilchengold-Anglermöwen loswerden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110117,
					"content": "Ist vielleicht irgendetwas nicht in Ordnung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110112,
					"content": "Nicht alle Veilchengold-Anglermöwen haben deine Pommes gefressen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110107,
					"content": "Wie kommt es, dass du hier Pommes isst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110108
					]
				}
			]
		},
