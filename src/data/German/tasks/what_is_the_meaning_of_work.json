			"dialogs": [
				{
					"id": 240111101,
					"content": "Möchtest du dir nicht einen Hund zulegen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111102
					]
				},
				{
					"id": 240111102,
					"content": "Du meinst ... Ich sollte den Hund die Veilchengold-Anglermöwen verjagen lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111103,
					"content": "Das ist keine schlechte Idee, vielleicht kann ich mir einen borgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
