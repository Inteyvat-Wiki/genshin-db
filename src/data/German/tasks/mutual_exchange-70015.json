						700150302
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700150302,
					"content": "Odomu tomo zido mi! <color=#00E1FFFF>Unta mosi dada</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700150303
					],
					"speakerTitle": "Hilichurl"
				},
				{
