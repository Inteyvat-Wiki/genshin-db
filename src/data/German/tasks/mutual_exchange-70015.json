					"nextDialogs": [
						700150103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700150103,
					"content": "Tomo tomo. Tomo dala si? domu nye, ika nye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700150104
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700150104,
					"content": "Ye muhe dala? Mimi mani ye.",
