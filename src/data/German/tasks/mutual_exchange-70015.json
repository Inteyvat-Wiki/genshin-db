					"nextDialogs": [
						700150105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700150105,
					"content": "Ya tomo mani, mani yaya tome nye ... Mi muhe du, du <color=#00E1FFFF>lata boya sada</color> si.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700150106
					],
					"speakerTitle": "Hilichurl"
				},
				{
					"id": 700150106,
					"content": "Er scheint etwas zu wollen ... Oh, da sollte ein Hinweis in meinem Handbuch stehen, lass mal schauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
