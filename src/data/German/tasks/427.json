			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270401,
					"content": "Sieht aus, als hättest du den Gleiter schon gut im Griff! Dann gehen wir über zur nächsten Phase.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270402,
					"content": "Du bist hier sowieso schon einmal geflogen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270403,
					"content": "Dies ist die letzte Prüfung. Wenn du sie bestehst, qualifizierst du dich für deine Fluglizenz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270404,
					"content": "Für den Flugschein! Auf die Plätze ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270405
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270405,
					"content": "Fertig, los!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 42708,
			"completionStepIds": [
				42708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"42708",
