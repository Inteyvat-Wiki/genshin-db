				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Otto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270801,
					"content": "Hallo, ich bin Ritter des Ordo Favonius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270802
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270802,
					"content": "Ah, was ist denn jetzt los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270803,
					"content": "#Guten Tag, {F#das Fräulein}{M#der Herr}. Die Papiere, bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270804,
						4270805
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270804,
					"content": "Papiere? Der Flugschein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				},
				{
					"id": 4270806,
					"content": "Unerlaubtes Fliegen ohne Flugschein verstößt gegen Artikel 7, Absatz 12 der Verordnung zur öffentlichen Sicherheit in Mondstadt. Komm bitte mit mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270807
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270807,
					"content": "Du hast das Recht zu schweigen. Alles, was du sagst, wird der Wind nie vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270808
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270808,
					"content": "Wartet doch! Wir sind gerade dabei, die Prüfung zum Flugschein zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270809
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270809,
					"content": "Ach wenn das so ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270810
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270810,
					"content": "Leider habt ihr euch eine unpassende Zeit für die Flugprüfung ausgesucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270811
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270811,
					"content": "Was ist denn passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270812
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270812,
					"content": "#Der Ritterorden hat vorhin eine Anzeige von einer Ordensschwester entgegengenommen, die den „komischen Vogel“ gesehen hat, der mit einem Windgleiter geflohen ist. Deswegen habe ich gedacht, dass {F#deine Freundin}{M#dein Freund} hier in die Sache verwickelt wäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270813
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270813,
					"content": "Ein komischer Vogel? Das klingt lustig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270814,
					"content": "Er ist ein berüchtigter Krimineller in Mondstadt. Er begeht seine Verbrechen immer mit einem Windgleiter. Deshalb nennen ihn die Leute auch den komischen Vogel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270815
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270815,
					"content": "Hmm, fliegt er sehr schnell?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270816
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270816,
					"content": "Wir waren bisher nicht in der Lage, ihn dingfest zu machen. Diesmal wollten wir ihn eigentlich mit einem Kulturschatz aus der Kathedrale ködern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270817
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270817,
					"content": "Dann ist er aber damit abgehauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270818
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270818,
					"content": "Die Ordensschwester war aber klug genug, eine Markierung mit elementarer Magie darauf setzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270819
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270819,
					"content": "Dieser Kerl fliegt einfach viel zu schnell. Wir konnten den elementaren Spuren deshalb nicht richtig folgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270820
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270820,
					"content": "Wenn der Übeltäter ein Meister im Fliegen ist, sollte kein geringerer als ich bei der Suche helfen! In welche Richtung ist er geflohen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270821
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270821,
					"content": "Soweit ich weiß, ist er zuletzt in der Nähe von Quellingen gesehen worden. Das ist jetzt aber schon eine Zeit her ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270822
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 4270822,
					"content": "#Überlass das ruhig mir! {NICKNAME} wird mir bei der Suche helfen. Gemeinsam werden wir diesen komischen Vogel schon fassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270823,
						4270824
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270823,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270825,
					"content": "Keine Sorge! Sobald wir den komischen Vogel gefunden haben,",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270826
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270826,
					"content": "werde ich Jean alles erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270824,
					"content": "Und was ist mit der Flugprüfung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270805,
					"content": "Graf von Hoppel hat sie gefressen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				}
			]
		},
