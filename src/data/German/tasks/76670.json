			"trigger": {
				"objectNames": [
					"Lyylikki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766700101,
					"content": "Lyylikki, wie lief es in letzter Zeit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700102
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700102,
					"content": "Oh! Hallo, Frau Lauma, in letzter Zeit läuft es hier wirklich gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700103
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700103,
					"content": "Die Zutaten kommen regelmäßig rein, niemand macht Ärger und meine Kochkünste haben sich wirklich verbessert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700104
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700104,
					"content": "Übrigens, was die „Freunde“ angeht, die du beim letzten Mal erwähnt hast ... Meintest du etwa diese Tiere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700105
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700105,
					"content": "Sie sind total brav und beobachten ganz ruhig die Leute in der Schlange. Ich habe versucht, ihnen etwas zu essen anzubieten, aber sie wollten es nicht annehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700106
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700106,
					"content": "Die Kleinen verstehen ihre Aufgaben. Wenn sie Dienst haben, bleiben sie konzentriert und auf ihrem Posten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700107
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700107,
					"content": "Aber sobald sie Feierabend haben, kannst du ihnen eine kleine Freude machen. Hehe, ich bin sicher, sie würden sich darüber freuen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700108,
					"content": "Prima! Dann werde ich heute etwas Leckeres kochen, um mich bei ihnen zu bedanken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700109,
					"content": "Vielen Dank, Lyylikki. Wenn du Hilfe brauchst, lass es mich einfach wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700110,
					"content": "Nicht nötig, wirklich! Ich habe alles unter Kontrolle. Außerdem greifen mir ja auch noch Herr Kantor und Fräulein Jahoda unter die Arme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700111,
					"content": "Na gut, dann störe ich dich mal nicht weiter. Auf Wiedersehen, Lyylikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700112,
					"content": "Auf Wiedersehen, Frau Lauma. Ich sollte die nächste Ladung Gerichte herausbringen ... Ach ja, Frau Lauma, möchtest du auch etwas davon probieren? Hier, frisch zubereitet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700113
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700113,
					"content": "So, und jetzt auf den Teller mit dem Essen ... Hm? Wo sind denn die Teller, die ich gerade gespült habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		}
	]
}