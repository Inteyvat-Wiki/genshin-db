			},
			"dialogs": [
				{
					"id": 766670401,
					"content": "Das wird reichen. Vielen, vielen Dank! Nur einen Moment, ich bereite den köstlichsten „Mondschmaus“ vor, den du je gesehen hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670402
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670402,
					"content": "Lyylikki eilt in die Küche und stürzt sich in die Vorbereitung des „Mondschmauses“ ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766670403
					]
				},
				{
					"id": 766670403,
					"content": "Fertig, bitte, probier mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670404
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670404,
					"content": "Nochmals vielen Dank für deine Hilfe. Komm gern wieder vorbei, wenn du das nächste Mal Hunger bekommst. Ich werde eine besondere Portion nur für dich zubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		},
