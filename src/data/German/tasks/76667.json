			"dialogs": [
				{
					"id": 766670301,
					"content": "Ich geh dir welche holen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670302
					]
				},
				{
					"id": 766670302,
					"content": "Du ... Du willst mir helfen? Vielen, vielen Dank! Dann ... Dann bring mir bitte <color=#00E1FFFF>fünf Lakkabeeren</color>, das sollte reichen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670303
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670303,
					"content": "Wenn du sie mir bringst, verspreche ich dir, den leckersten Mondschmaus zu machen, das du je gegessen hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		},
		{
			"id": 7666704,
			"completionStepIds": [
				7666702
			],
