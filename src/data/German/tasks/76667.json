			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lyylikki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766670101,
					"content": "... Ach ... hätte ich das gewusst, hätte ich ein paar Lakkabeeren mehr mitgenommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670102,
						766670103
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670102,
					"content": "(Als Lauma das letzte Mal hier war ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				},
				{
					"id": 766670104,
					"content": "#Hallo, {NICKNAME}, bist du wegen eines „Mondschmauses“ hier? Tut mir sehr leid, aber ... du musst dich vielleicht noch ein bisschen gedulden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670105
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670105,
					"content": "Was ist denn ein „Mondschmaus“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670106
					]
				},
				{
					"id": 766670106,
					"content": "Oh, hast du letztes Mal keinen bekommen? Ach, stimmt ja, Lauma hatte das organisiert ... Ich wette, sie hat den offiziellen Namen des Essens nicht erwähnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670107
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670107,
					"content": "Um es kurz zu machen: Ein „Mondschmaus“ ist eine kostenlose Mahlzeit, die wir „Nachkommen des Frostmonds“ an Bedürftige verteilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670108
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670108,
					"content": "Diesen Menschen zu helfen, ist seit jeher Tradition bei uns, auch wenn es früher nur auf das Gebiet um die Insel Hiisi beschränkt war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670109,
					"content": "Aber unter der Leitung von Lauma haben alle fleißig mit angepackt, und so konnten wir unsere Reichweite allmählich vergrößern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670110
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670110,
					"content": "Lauma sagt immer, dies sei ein Teil dessen, wie der Segen der Mondgöttin an alle weitergegeben werden könne. Es gibt ein Sprichwort, wie war das nochmal ... genau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670111,
					"content": "„Die erste Frucht der Ernte gehört auf den Altar des Mondlichts – nicht als Opfergabe an die Götter, sondern als Funke für ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670112
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670112,
					"content": "„Als Funke für ...“, ähm ... Wie ging der Rest noch mal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670113
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670113,
					"content": "*räusper* Na ja, jedenfalls ... Dieser Laden hier ist eine der Hauptausgabestellen für das Essen. Hehe, und ich schaffe das alles hier fast ganz allein! Ziemlich beeindruckend, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670114
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670114,
					"content": "Wir hatten recht große Schwierigkeiten, die Mahlzeiten in Nasha auszugeben, aber ich glaube an das, was Lauma sagt: Auf diese Weise können wir wirklich mehr Menschen helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670115
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670115,
					"content": "Wie auch immer ... als ich gestern die Zutaten vorbereitet habe, hatte ich vergessen, den Deckel der Schachtel fest zu verschließen. Als ich dann heute Morgen aufgewacht bin, hatten sich schon die Vögel fleißig an den Früchten bedient, wodurch die dann leider völlig unbrauchbar geworden sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670116
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670116,
					"content": "Mit den restlichen Lakkabeeren lässt sich leider kein „Mondschmaus“ mehr zubereiten. *seufz* ... Was soll ich jetzt nur machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670103,
					"content": "(Anscheinend haben sie hier Mahlzeiten ausgegeben ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				}
			]
		},
