			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110101,
					"content": "Albedo ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110102,
					"content": "Ihr seid zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110103,
					"content": "Haha! Wir haben uns gut um das Schwert gekümmert, weißt du? Schau mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110104,
					"content": "Sieh es dir an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110105
					]
				},
				{
					"id": 412110105,
					"content": "Hmm. Tatsächlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110106,
					"content": "Wie ich gedacht habe, das Schwert wird stärker, wenn du es im Kampf einsetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110107,
					"content": "Nicht, dass es ein Mensch wäre, natürlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110108,
					"content": "Und genau das ist das Besondere am Schwert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110109,
					"content": "Ah, ja. Ich sollte noch etwas Wichtigeres erwähnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110110
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110110,
					"content": "Ich habe mich in der Gegend umgesehen und einige ungewöhnliche Spuren entdeckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110111,
					"content": "Es treiben sich doch nicht noch mehr Diebe hier herum, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110112,
						412110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110112,
					"content": "Aber sind wir nicht die echten Diebe hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				},
				{
					"id": 412110114,
					"content": "Das stimmt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110115,
					"content": "Ich finde, dass wir uns diese seltsamen Spuren genauer ansehen sollten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110116,
					"content": "Ob es nun Diebe sind oder etwas anderes, wir werden es herausfinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110113,
					"content": "Das sehen die Schatzräuber wahrscheinlich anders ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110114
					]
				}
			]
		},
		{
			"id": 4121102,
			"completionStepIds": [
				4121109
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121109",
							"2"
						],
						"stepId": 4121109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110201,
					"content": "Die Fatui? Und sie haben beschlossen, uns im Lager der Schatzräuber anzugreifen ... Sind sie uns hierher gefolgt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110202
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110202,
					"content": "Aber warum würden sie das tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110203,
					"content": "Hast du sie irgendwie aufgestachelt, während wir nicht hingeschaut haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110204,
					"content": "Hast du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110205,
						412110206
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110205,
					"content": "Wie kommst du denn darauf?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				},
				{
					"id": 412110207,
					"content": "Ähm. Dann ist es wohl etwas, das wir zusammen gemacht haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110208,
					"content": "Ich glaube, die Fatui suchen nach diesem Schwert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110209
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110209,
					"content": "Hä? Hast du das Schwert nicht völlig geheim gehalten? Woher wussten die überhaupt von seiner Existenz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110210,
					"content": "Vielleicht haben sie gesehen, wie ihr auf dem Berg damit gekämpft habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110211
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110211,
					"content": "Wenn sie nicht völlig blind sind, haben sie zweifellos gesehen, wie sich dieses Schwert vom Rest abhebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110212
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110212,
					"content": "Die wollen wirklich alles haben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110213,
					"content": "Nicht wirklich, nein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110214
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110214,
					"content": "Ich habe aber auch so etwas in der Art gehört.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110215
					]
				},
				{
					"id": 412110215,
					"content": "Die Fatui sammeln Dinge, die mit den Archonten zu tun haben. So viel weißt du bestimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110216
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110216,
					"content": "Hm. Jetzt, da du es sagst, Meister Diluc hat das tatsächlich einmal erwähnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110217,
					"content": "Durin war der Erzfeind des Anemo-Archons und seine Kraft war ihm ebenbürtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110218
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110218,
					"content": "Ich will damit nicht sagen, dass er den Archons insgesamt ebenbürtig oder gar mit ihnen verwandt war ... Beides wäre eine Übertreibung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110219
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110219,
					"content": "Kein Wunder, dass sie es auf dieses Schwert abgesehen haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110220
					]
				},
				{
					"id": 412110220,
					"content": "So ist das also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110221,
					"content": "Ich habe beim Zeichnen in der Nähe eine neue Entdeckung gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110222
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110222,
					"content": "Weiter vorn ist ein Gebiet, das ziemlich bemerkenswert ist. Dort ist der Fluss der Elemente anders als überall sonst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110223
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110223,
					"content": "Die Monster in der Nähe werden davon angezogen und davon beeinflusst. Mit dem Ergebnis, dass ihre körperliche Verfassung bei Weitem besser ist als die von anderen Monstern derselben Art.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110224
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110224,
					"content": "Wie praktisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110225,
					"content": "Nun, wir sind doch hier, um diesem Schwert beim Wachsen zu helfen, oder? Dann können wir es genauso gut an diesen Monstern ausprobieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110226,
					"content": "Darauf wollte ich hinaus. Oh, und vergiss nicht zu beobachten, wie sich die verschiedenen Gegner auf dein Schwert auswirken, wenn du schon dabei bist. Bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110206,
					"content": "Das würde mir nicht im Traum einfallen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110207
					]
				}
			]
		},
		{
			"id": 4121103,
			"completionStepIds": [
				4121112
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4121112",
							"2"
						],
						"stepId": 4121112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412110301,
					"content": "Und, wie war es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110302,
						412110303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110302,
					"content": "Das Schwert ist stärker geworden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110304
					]
				},
				{
					"id": 412110304,
					"content": "Was das betrifft, habe ich eine Theorie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110305
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110305,
					"content": "Jedes Mal, wenn das Schwert Kraft vom Körper gefallener Feinde absorbiert, kommuniziert es mit Durins Gebeinen, die irgendwo auf diesem Berg verborgen liegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110306,
					"content": "Himmeldonnerwetter! Das klingt ja toll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 412110307,
					"content": "Sollte sich meine Vermutung bestätigen, könnte das bedeuten, dass alle Monster hier mit Durins Leichnam kommunizieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110308
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110308,
					"content": "Aber warum würden sie das tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412110309
					]
				},
				{
					"id": 412110309,
					"content": "Ich fürchte, das könnte damit zusammenhängen, wo diese Monster ihre Kraft herkriegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110310
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110310,
					"content": "Durin ist keine gewöhnliche Bestie. Obwohl er schon seit Langem tot ist, wird der gesamte Berg immer noch von seiner Leiche unterjocht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110311,
					"content": "Die mysteriöse Kraft des Drachen ... könnte an sich eine Art Fluch sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 412110312,
					"content": "Uns fehlen immer noch zu viele Informationen. Wenn wir die Sache besser verstehen wollen, benötigen wir mehr Daten. Und da kommt ihr wieder ins Spiel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412110313
					],
					"speakerTitle": "Albedo"
				},
				{
