				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220350204,
					"content": "Ja, wir haben auch dieses Mal einen großen Aufstand gemacht. Amano und Andou werden uns dabei helfen, dass der Dieb in der Stadt davon erfährt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350205,
					"content": "Wie lange wird das noch dauern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350206
					]
				},
				{
					"id": 220350206,
					"content": "Nicht mehr lange. Sobald Sango fertig ist, können wir diesen Fall abschließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350207,
					"content": "Hier ist deine Zahlung, Reisender. Vielen Dank für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350208,
					"content": "Das ist der Betrag, der von Sango selbst zugewiesen wurde, also denke ich, dass er angemessen sein sollte. Bitte nimm ihn. Vielleicht haben wir in Zukunft noch mehr Arbeit für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
