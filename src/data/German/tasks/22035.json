	"talks": [
		{
			"id": 2203501,
			"completionStepIds": [
				2203501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203501",
							"2"
						],
						"stepId": 2203501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220350101,
					"content": "#{F#Reisende}{M#Reisender}, wir treffen uns wieder. Dank deiner Hilfe beim letzten Mal ist sich Sango nun sicher, wer der Schuldige ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350102,
					"content": "Aber wenn wir wollen, dass dieser Übeltäter wirklich untergeht, brauchen wir noch etwas Vorbereitung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350103
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350103,
					"content": "Lass uns die Arbeit fortsetzen, die wir zuvor begonnen haben. Während sie mit anderen Dingen beschäftigt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350104,
						220350107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350104,
					"content": "Suchst du Ärger mit den Schatzräubern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350105
					]
				},
				{
					"id": 220350105,
					"content": "Ja, das ist richtig. Obwohl dieser Täter nichts mit den Schatzräubern zu tun hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350106,
					"content": "Diese Schatzräuber führen sowieso nichts Gutes im Schilde, also können wir sie genauso gut uns „helfen“ lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350112,
					"content": "Sango hat ihren genauen Standort markiert. Es ist nicht weit von der Stadt entfernt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350113,
					"content": "Was die Angelegenheiten innerhalb der Stadt angeht ... Sango hat Amano und Herrn Andou heimlich angewiesen, uns bei dieser Operation zu unterstützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350114,
					"content": "Sie hat auch versprochen, dass die Lorbeeren für die Lösung dieses Falles alle an sie gehen werden, also werden sie gerne mit uns zusammenarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350115,
					"content": "Überlasse ihr das Denken und Planen. Lass uns einfach unsere „Korrespondenz“ mit diesen Schatzräubern weiterführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350116
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350116,
					"content": "Ich habe den Ort auch auf deiner Karte markiert. Lass uns jetzt loslegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350107,
					"content": "Ihn weiter täuschen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350108
					]
				},
				{
					"id": 220350108,
					"content": "Das ist richtig. Wir müssen ihn weiterhin in dem Glauben lassen, dass die Schatzräuber unser Ziel sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350109
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350109,
					"content": "Auf diese Weise wird Sango mehr Zeit haben, ihren Plan zu vollenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350110,
					"content": "Hehehe ... Nicht, dass diese Schatzräuber irgendetwas Gutes im Schilde führen würden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350111,
					"content": "Also können wir genauso gut ihre „Hilfe“ in Anspruch nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 2203502,
			"completionStepIds": [
				2203508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
