			"dialogs": [
				{
					"id": 722430102,
					"content": "Ich habe Schätze, die ich gern verkaufen würde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430103
					]
				},
				{
					"id": 722430103,
					"content": "Schätze verkaufen? Was für eine Überraschung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430104,
					"content": "Es muss sehr selten sein, dass ein mächtiger Abenteurer wie du etwas verkaufen will, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430105
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430105,
					"content": "Lass mich sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430106,
					"content": "Die Geschichte der Perlen der Drachenknochenblume wurde Marjorie erzählt.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722430107
					]
				},
				{
					"id": 722430107,
					"content": "Ah, ist das nicht die Frucht des Vergessens, wie sie in der Erzählung des Barden beschrieben wird?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430108
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430108,
					"content": "Gibt es so etwas also wirklich ... Es stellt sich heraus, dass der echte Name Perle der Drachenknochenblume ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430109
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430109,
					"content": "Wenn es wirklich so funktioniert, wie du sagst, dann würde ich achtzigtausend Mora dafür bezahlen, plus eine kleine Spezialzubereitung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430110,
					"content": "Hmm ... Was hältst du von achtzigtausend Mora plus fünf Mondkuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430111,
						722430114,
						722430120
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430111,
					"content": "Was willst du damit machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430112
					]
				},
				{
					"id": 722430112,
					"content": "Hihi, was für ein einzigartiger Schatz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430113
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430113,
					"content": "Bei den märchenhaften magischen Effekten werden die Alchimisten sicher nicht ihrem Geldbeutel zu eng schnallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430114,
					"content": "Ein sehr guter Preis. Abgemacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430115
					]
				},
				{
					"id": 722430115,
					"content": "Dann werde ich diesen Schatz annehmen und mich für deine Unterstützung bedanken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430116
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430116,
					"content": "Normalerweise wirken solche geronnenen, perlenartigen Gegenstände übrigens langsam im Wind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430117
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430117,
					"content": "Daher ist es am besten, sie mit einem Septum zu bedecken oder in einem versiegelten Behälter aufzubewahren, um die Farbe zu erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430118
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430118,
					"content": "Hier ist ein kleiner Tipp für dich, der dir hoffentlich bei deinem Abenteuer helfen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430119
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430119,
					"content": "Wenn du in Zukunft ähnliche Schätze findest, vergiss nicht, dass es hier treue Käufer dafür gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430120,
					"content": "Ich überlege es mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430121
					]
				},
				{
					"id": 722430121,
					"content": "Haha, kein Problem, aber ich glaube, ich habe den besten Preis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430122
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430122,
					"content": "Wenn du darüber nachgedacht hast, kannst du auf mich zurückkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
		},
