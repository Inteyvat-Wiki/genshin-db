			"dialogs": [
				{
					"id": 140340101,
					"content": "Schließlich erreicht ihr die Kat{RUBY#[D]den Keller}hedrale, d{RUBY#[D]den}ie Florian erwähnt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340102
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Gespielt von Clorinde"
				},
				{
					"id": 140340102,
					"content": "Während ihr euch nähert, umgibt euch eine unheilvolle Aura. Ihr habt das Gefühl, dass euer Feind ganz in der Nähe ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340103
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Gespielt von Clorinde"
				},
				{
					"id": 140340103,
					"content": "(Wie seltsam ... Dieses ungute Gefühl scheint so real zu sein. Wie haben sie das geschafft?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340104,
					"content": "Jetzt ... ist es Zeit für die letzte Schlacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340105
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Gespielt von Clorinde"
				},
				{
					"id": 140340105,
					"content": "Kommt schon, Leute. Zeit zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340106
					],
					"speakerTitle": "Lyney",
					"speakerSubtitle": "Schattenjäger"
				},
				{
					"id": 140340106,
					"content": "Florian, warte mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340107
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340107,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340108
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340108,
					"content": "Ich finde, du solltest draußen warten. Du wurdest bereits einmal vom Devorator korrumpiert. Er könnte leicht wieder in deinen Geist eindringen und die Kontrolle über deinen Körper übernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340109
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340109,
					"content": "Es ist also keine gute Idee, wenn du so nah dran bist. Wenn es dich wieder korrumpiert, ist es möglich, dass du vollständig zum Monster wirst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340110
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340110,
					"content": "Das ist genau der Grund, warum ich gehen muss ... warum ich ganz vorne stehen sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340111
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340111,
					"content": "...! Das heißt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340112,
					"content": "Ja, ich habe vor, ihn in meinen Körper zu locken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340113
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340113,
					"content": "Das ist viel zu gefährlich. Wenn die Dinge aus dem Ruder laufen, muss ich dich vielleicht töten. Verstehst du, wie gefährlich das ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340114,
					"content": "Das verstehe ich. Aber nur auf diese Weise bekommt ihr ein konkretes und sichtbares Ziel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340115
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340115,
					"content": "Der Devorator wird sich die Chance nicht entgehen lassen, in einen Körper einzudringen, den er zu kontrollieren weiß. Außerdem musst du dir keine Sorgen mehr machen, dass einer deiner Freunde übernommen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340116
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340117
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340117,
					"content": "Du bist nicht wie ich, Fräulein Clorinde. Du bist ein gerechter und mächtiger Schattenjäger. Dieses Ungeheuer ist durch meinen Fehler ausgebrochen. Es ist nur richtig, dass ich die Verantwortung für seine Vernichtung trage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340118
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340118,
					"content": "Das ist etwas ... das ich tun muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340119
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340119,
					"content": "Betrachte es als ein Duell zur Wiederherstellung meiner Ehre. Meine einzige Bitte ist, dass du alles gibst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340120
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340120,
					"content": "... Ich habe verstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340121
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340121,
					"content": "Dann nehme ich als Duellrepräsentantin hiermit deine Duell-Anfrage an und zolle dir meinen aufrichtigsten Respekt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340122
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340122,
					"content": "... Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340123
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340123,
					"content": "Die Schlacht wartet noch auf uns. Lass den Devorator noch einmal unter der Klinge der Schattenjäger erbeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				}
			]
		},
