			},
			"dialogs": [
				{
					"id": 140340201,
					"content": "Und so wurden die Monster vernichtet und der böse Zauberer wurde besiegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340202
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Gespielt von Clorinde"
				},
				{
					"id": 140340202,
					"content": "Bald kehrte Frieden in der Hauptstadt ein. Auch die Minister am Hof, die von dem bösen Zauberer manipuliert worden waren, erkannten die Fehler ihres Handelns ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340203
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Gespielt von Clorinde"
				},
				{
					"id": 140340203,
					"content": "Einige erinnerten sich an die Namen der Helden, die ihr Königreich gerettet hatten ... andere setzten ihr Leben einfach fort, ohne etwas zu ahnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340204
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Gespielt von Clorinde"
				},
				{
					"id": 140340204,
					"content": "Das ist die Geschichte der Schattenjäger. Sie verfolgen die Phantome in der Dunkelheit und vernichten alle, die eine Bedrohung darstellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340205
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Gespielt von Clorinde"
				},
				{
					"id": 140340205,
					"content": "Sie werden diese Stadt und ihre Bürger immer schützen, selbst wenn die Menschen, denen sie dienen, ihre Leistungen vergessen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340206
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Gespielt von Clorinde"
				},
				{
					"id": 140340206,
					"content": "Uff ... Ich nehme an, wir haben endlich das Ende des Spiels erreicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340207
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340207,
					"content": "Ja. Ihr habt eines der guten Enden erreicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340208
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340208,
					"content": "Insgesamt ist es eine ziemlich spannende Geschichte. Am Anfang dachte ich, es sei nur ein gewöhnliches Abenteuer, aber je weiter wir kamen, desto beeindruckter war ich von der Präsentation und der Handlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340209
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340209,
					"content": "Vor allem der finale Kampf! Die ganzen Effekte waren super realistisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340210
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340210,
					"content": "Stimmt, ja, absolut, hahaha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340211
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340211,
					"content": "Ah ... Jetzt, wo du es sagst, hätte ich nie erwartet, dass die Waffen, die wir aus dem Tresorraum geholt haben, eine solche Wirkung haben würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340212
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340212,
					"content": "Ja, meine hat mich fast zu Tode erschreckt, als sie anfing zu leuchten! Ich habe mir die Waffe gerade noch einmal genau angesehen, aber sie leuchtet nicht mehr auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340213
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340213,
					"content": "Oh, wir sollten wahrscheinlich diese Requisiten zurückgeben, oder? Ich werde meine einfach hier lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340214
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340214,
					"content": "Hast du dich gut amüsiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340215
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340215,
					"content": "Ja, natürlich. Sag mir bitte Bescheid, wenn du wieder ein so gutes Skript bekommst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340216
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340216,
					"content": "Natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340217
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340217,
					"content": "Dann werde ich mich jetzt verabschieden. Ich glaube, ich brauche noch etwas Zeit auf dem Weg nach Hause, um die Geschichte zu verdauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340218
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340218,
					"content": "Bitte richte Herrn Florian meine Dankbarkeit aus, wenn er wach ist. Er ist sofort eingeschlafen, als der Kampf vorbei war. Er muss sehr erschöpft sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340219
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340219,
					"content": "Du hast recht. Er hat viel durchmachen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340220
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340220,
					"content": "Also, bis zum nächsten Mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340221
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340221,
					"content": "... Also, darf ich jetzt eine Frage stellen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340222
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340222,
					"content": "Jetzt sollte es in Ordnung sein, denke ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340223
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340223,
					"content": "Was in aller Welt war da los?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340224
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340224,
					"content": "... Ah, ihr habt das schon alles durchschaut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340225
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340225,
					"content": "Ahahaha ... Als du uns in der Höhle gebeten hast, unsere Augen zu schließen ... Es wäre noch seltsamer, wenn wir nichts bemerkt hätten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340226
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340226,
					"content": "Ich hatte die ganze Zeit Mühe, meine Neugier zu zügeln! Du hast ziemlich gut so getan, als ob nichts schiefgegangen wäre. Und Furina sah tatsächlich so aus, als ob sie dachte, das gehöre alles zur Geschichte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340227
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340227,
					"content": "Ich schätze, niemand von uns wollte die Fantasie ruinieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340228
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340228,
					"content": "Hm? Wovon redet ihr da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340229,
						140340231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340229,
					"content": "Genau, wovon redet ihr da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340230
					]
				},
				{
					"id": 140340230,
					"content": "#Warte, sag mir nicht, dass du es nie be... Ach, mein Fehler! Es ist noch nicht zu spät, sich die Ohren zuzuhalten! Komm, {F#Partnerin}{M#Partner}, ich mach’s für dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340233
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340233,
					"content": "Ähm, es ist schon ein bisschen zu spät, meinst du nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340234
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340234,
					"content": "Heißt das, dass ... dass alles, was früher passiert ist, nicht wirklich Teil des Skripts war?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340235,
					"content": "Vermutlich ist es zutreffender zu sagen, dass dies von Anfang an kein einfaches Rollenspiel war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340236
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340236,
					"content": "Waaas!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340237,
					"content": "... Zu laut ... Argh, mein Kopf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340238
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340238,
					"content": "He, du! Steh sofort auf und erkläre alles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340239,
					"content": "Aaaah! Nicht schütteln, bitte! Mein Kopf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340240
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340240,
					"content": "Florian erklärt allen die Wahrheit ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140340241
					]
				},
				{
					"id": 140340241,
					"content": "H... Hat Paimon das gerade richtig verstanden? Ihr habt euch den letzten Teil auf der Stelle ausgedacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340242,
					"content": "Es ist nicht nett, Leute anzulügen, aber ... Paimon muss zugeben, dass das eine wirklich gute Geschichte war, Florian. Oh, und schön improvisiert, Clorinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340243,
					"content": "Und wie! Es war, als würde man einem Zauberer zuschauen, wie er einen spektakulären Zaubertrick improvisiert, nachdem er bemerkt hat, dass er ein wichtiges Requisit vergessen hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340244
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340244,
					"content": "Wenn Paimon gewusst hätte, dass mit dem Tresor etwas nicht stimmt, wäre Paimon direkt in die entgegengesetzte Richtung geflogen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340245,
					"content": "Es war alles unter Kontrolle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340246
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340246,
					"content": "Als ob du jemals eine Situation als „außer Kontrolle“ beschrieben hättest. Ich bin mir ziemlich sicher, dass jede Situation, die du als leicht zu bewältigen ansiehst, eine vernünftige Person zu Tode erschrecken würde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340247
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340247,
					"content": "Vielleicht bin ich einfach daran gewöhnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340248
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340248,
					"content": "Ähm ... Dann hast du wohl eine Menge unerwarteter Situationen erlebt ... Das erklärt aber auch, warum du so gut darin bist, dir auf der Stelle etwas einfallen zu lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340249,
					"content": "Und was dich betrifft, Florian ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340250
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340250,
					"content": "... Ich weiß, dass es keine Rechtfertigung für meine Taten gibt. Ich werde mich sofort der Gendarmerie stellen, meine Verbrechen gestehen und jede Strafe akzeptieren, die auf mich zukommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340251
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340251,
					"content": "Meiner Meinung nach bist du schon mehr als genug gestraft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340252
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340252,
					"content": "... Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340253
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340253,
					"content": "Du magst anfangs von Ruhm und Reichtum geblendet gewesen sein, aber deine Taten während der letzten Schlacht haben bewiesen, dass du ein echter Schattenjäger bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340254
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340254,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340255
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340255,
					"content": "Du bist nützlicher für die Stadt, wenn du weiterhin am Festland auf freiem Fuß bist, als wenn du unter dem Meer gefangen bist. Deine Aufgabe als Schattenjäger ist viel wichtiger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340256
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340256,
					"content": "Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340257
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340257,
					"content": "Natürlich musst du dich bei den beiden Schattenjägern, denen du Unrecht getan hast, persönlich entschuldigen und ihnen die Schlüssel zurückgeben. Sei auch bereit, alle Bedingungen zu akzeptieren, die sie dir stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340258
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340258,
					"content": "... Ja, selbstverständlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340259
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340259,
					"content": "Abgesehen davon ... war deine Leistung im Duell Beweis genug für deine Ehre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340260
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340260,
					"content": "...! Dann werde ich genau das tun, was du gesagt hast. I... Ich werde die beiden Schlüssel sofort zurückgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340261
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340261,
					"content": "Vielen Dank an alle. Ich werde mein Bestes tun, um mich der zweiten Chance, die ihr mir gegeben habt, als würdig zu erweisen. Das schwöre ich bei meinem Namen und meiner Ehre als Schattenjäger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340262
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340262,
					"content": "Auf Wiedersehen, allerseits.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340231,
					"content": "Ich habe auch nur mitgespielt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340232
					]
				},
				{
					"id": 140340232,
					"content": "Warte, sag mir nicht, dass Paimon es noch nicht be... Ach, mein Fehler! Es ist noch nicht zu spät, sich die Ohren zuzuhalten! Komm, Paimon, ich mach’s für dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340233
					],
					"speakerTitle": "Navia"
				}
			]
		},
		{
			"id": 1403403,
			"completionStepIds": [
				1403403,
				1403404,
				1403405,
				1403406,
				1403407,
				1403408,
				1403409,
				1403410,
				1403411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1403403",
							"2"
						],
						"stepId": 1403403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clorinde"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2525.035,
							469.746,
							4803.685
						],
						"pointId": 340300464
					}
				]
			},
			"dialogs": [
				{
					"id": 140340301,
					"content": "Apropos Schattenjäger ... Was sollen wir mit dem „Schatz“ in der Höhle machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340302
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340302,
					"content": "Lass ihn da, so wie er ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340303
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340303,
					"content": "Bist du dir da sicher? Wir könnten ihn der Welt zeigen, damit sich die Menschen an die Schattenjäger erinnern ... Willst du das nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340304,
					"content": "Nein. Jeder Name auf dieser Stele hat dieselbe Wahl getroffen. Alle Schattenjäger wissen, was dieser Weg mit sich bringt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340305
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340305,
					"content": "Ich bin da keine Ausnahme ... Ich hoffe nicht, dass man sich an meine Identität als Schattenjäger erinnert. Ich möchte nur als Duellrepräsentantin anerkannt werden, mehr nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340306
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340306,
					"content": "Das ist sicherlich ganz anders als der Weg eines Zauberers. Trotzdem bewundere ich deine Entscheidung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340307
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340307,
					"content": "Moment, Paimon hat sich gerade an etwas erinnert. Wenn es keine Spezialeffekte waren, warum haben unsere Waffen während des Kampfes geleuchtet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340308,
					"content": "Das liegt daran, dass die Schattenjäger früherer Zeiten ihre Waffen oft mit besonderen Zaubern versahen, um die Monster zu überwältigen. Immer wenn ein Monster in der Nähe war, begannen ihre Waffen zu leuchten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340309
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340309,
					"content": "Ooh! Deshalb konnten wir den Typ also am Ende aufhalten. Ich hatte sogar gedacht, dass die „Beschwören“-Fähigkeit wirklich funktioniert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340310
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340310,
					"content": "Nun, ich bin sicher, dass das „Beschwören“ auch seinen Teil dazu beigetragen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340311
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340311,
					"content": "Oh? Was soll das bedeuten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340312
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340312,
					"content": "Dieser Devorator stammt wahrscheinlich aus der gleichen Zeit wie die Schattenjäger, die wir in dem Raum gesehen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340313
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340313,
					"content": "Die Namen, die ihr aufgezählt habt, gehören alle zu den tapfersten Schattenjägern, durch deren Klingen unzählige Monster gefallen sind. Das ist wahrscheinlich der Grund, warum der Devorator sichtlich zurückschreckte, als ihr sie laut ausspracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340314
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340314,
					"content": "Aha, die Namen haben also auch eine Macht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340316
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340316,
					"content": "... Navia, was du während der „Beschwörung“ gesagt hast ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340317
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340317,
					"content": "Hä? A... Ahahaha! Ich, ähm ... Ich meinte, was ich sagte. Ich meine, es entsprach meiner Figur! Also, ja, ich bin froh, dass du es gehört hast, aber zwing mich nicht, mich zu wiederholen. Das ist mir peinlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340318
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340318,
					"content": "Ich weiß diese Worte wirklich zu schätzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340319
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340319,
					"content": "Schon gut, schon gut. Werd’ nicht sentimental!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340320
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340320,
					"content": "Äh ... Wie auch immer, lass uns nicht mehr darüber quatschen! Ich gehe schon mal vor. Fallt nicht zu weit zurück, Leute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340321
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340321,
					"content": "Ah ... Schon ist sie weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340322,
					"content": "Ich sollte wahrscheinlich auch zurückgehen. Diese Geschichte ist wirklich unglaublich. Ich werde wohl die ganze Nacht damit verbringen müssen, meinen Geschwistern davon zu erzählen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340323
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340323,
					"content": "Bis zum nächsten Mal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340324
					]
				},
				{
					"id": 140340324,
					"content": "Bis bald!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340325
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340326
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340326,
					"content": "#{NICKNAME} ... Was wäre der Sinn deiner Reise, wenn sich andere nicht an deinen Namen erinnern ... wenn deine Taten nicht von denen gelobt werden, denen du geholfen hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340327
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340327,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340328
					]
				},
				{
					"id": 140340328,
					"content": "Ich denke, es geht um die Reise selbst und die Welt, die wir mitgestaltet haben. Die Zeit, die ich mit allen verbracht habe, und die Dinge, die wir zusammen erreicht haben, sind immer noch wertvoll, auch wenn sich niemand mehr daran erinnert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340329
					]
				},
				{
					"id": 140340329,
					"content": "... Eine schöne Antwort. Ich werde sie mir merken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340330
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340330,
					"content": "Wie würde deine Antwort lauten, Clorinde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340331
					]
				},
				{
					"id": 140340331,
					"content": "Meine? Hach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340332
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340332,
					"content": "(Die Jägerin sagt nichts zu dieser Frage.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340333
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340333,
					"content": "(Vielleicht liegt ihre Antwort in ihrem Schweigen. Der unausgesprochene Schwur hallt durch die Nacht ... Der Weg, den sie eingeschlagen hat, bedarf keiner Erklärung.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				}
			]
		}
	]
}