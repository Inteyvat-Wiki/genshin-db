			"dialogs": [
				{
					"id": 732961401,
					"content": "Das Gute daran, die Stadt zu verlassen, ist, dass man nicht extra Hundefutter vorbereiten muss. „Pfeffer“ ist so tüchtig, der kümmert sich selbst um seine Mahlzeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961402
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732961402,
					"content": "Der Nachteil ist allerdings ... ich habe weder Talent zum Kämpfen, noch zum Kochen; ich bin wohl einfach ein nutzloser Stadtmensch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961403
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732961403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961404
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732961404,
					"content": "Ich sollte mich wohl lieber ausruhen und erholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				}
			]
		},
