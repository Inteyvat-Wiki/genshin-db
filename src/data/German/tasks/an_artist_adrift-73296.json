	"talks": [
		{
			"id": 7329602,
			"completionStepIds": [
				7329602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
