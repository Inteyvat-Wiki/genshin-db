				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960201,
					"content": "#Paimon, und da ist ja auch {NICKNAME}. Ihr seid tatsächlich gekommen! Da draußen muss man sich wirklich auf seine Freunde verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960202
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960202,
					"content": "Wir haben schließlich versprochen, dir den Weg zu zeigen, oder? Und Leute herumzuführen ist jetzt auch nicht allzu schwer; tatsächlich ist es sogar kinderleicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960203,
					"content": "Aber willst du echt zurück nach Fontaine? Man hat nur selten die Gelegenheit, Sumeru zu besuchen. Hier gibt es noch so viel zu sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960204,
						732960206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960204,
					"content": "Der Regenwald hat was für sich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960205
					]
				},
				{
					"id": 732960205,
					"content": "Bäume und Flüsse im Überfluss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960208,
					"content": "Das klingt verlockend, aber ich denke ... für weite Reisen fehlt mir die Vorbereitung. Diesmal ist die Reise zwar gescheitert, aber ich habe etwas daraus gelernt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960209
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960209,
					"content": "Na ja ... nun ... in der Nähe gibt’s auch eine Menge zu sehen! Wäre doch schade, das zu verpassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960210,
					"content": "Paimons Ortsempfehlungen sind nicht verkehrt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960211
					]
				},
				{
					"id": 732960211,
					"content": "Da ihr beide darauf besteht, wäre es ja unhöflich von mir, meine guten Freunde abzuweisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960212
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960212,
					"content": "Hehe, Paimon, Reiseführerin Nummer eins in Teyvat. Überlasst die Wegführung nur Paimon, und haltet ja Schritt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960206,
					"content": "Die Wüste bietet viele schöne Szenerien.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960207
					]
				},
				{
					"id": 732960207,
					"content": "Sooo viele und dazu auch viele Ruinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7329603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329612",
							"2"
						],
						"stepId": 7329612,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960301,
					"content": "Paimon hat gehört, dass Maler die Dinge erst aus den verschiedensten Blickwinkeln betrachten, bevor ihr Pinsel die Leinwand überhaupt berührt ... oder ist das etwa nur ein „Klischee“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960302,
					"content": "Sehen wir uns gemeinsam um, ja? Und wenn das nichts bringt, kann ein Blick von oben auch nicht schaden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960303,
					"content": "Klingt nach einer guten Idee. Ich bin bereit, loszuziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960304
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960304,
					"content": "#Wie wär’s mit einem kleinen Wettrennen zum Zielort? {NICKNAME}, bereit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7329604,
			"completionStepIds": [
				7329604
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329604",
							"2"
						],
						"stepId": 7329604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960401,
					"content": "Der Duft der Natur ... ist doch perfekt, um zu skizzieren und sich inspirieren zu lassen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960402,
					"content": "Nun, das ist ein Klischee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960403
					]
				},
				{
					"id": 732960403,
					"content": "Na ja ... Wenn’s Paimon wäre, würde sie sich ihren Pinsel schnappen wollen. Die Landschaft, so lebendig, und die Farben, so prachtvoll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960404,
					"content": "*hust*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960405
					]
				},
				{
					"id": 732960405,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960406,
					"content": "Tschuldigung ... Paimon wollte nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960407,
					"content": "Haha, alles in Ordnung. Obwohl die Szenerie in meinen Augen etwas anders ist, ist Schönheit doch universell, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960408
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960408,
					"content": "Das stimmt! Paimon liebt die Szenerie hier. Es ist fast so, als würde die Seele gereinigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960409,
					"content": "Paimons Seele muss doch nicht gereinigt werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960410
					]
				},
				{
					"id": 732960410,
					"content": "Meine Freunde, ihr schenktet einem Fremden wie mir, der anfangs nicht einmal die Wahrheit sagte, so viel Freundlichkeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960411
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960411,
					"content": "Eure Herzen sind so rein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960412
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960412,
					"content": "Hehe ... Kein Grund, so zu übertreiben. Ach ja, es gibt da noch mehr einzigartige Szenerien zu bestaunen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960413,
					"content": "#{NICKNAME}, du weißt sicher, wovon Paimon spricht. Komm, lass es uns Julien zeigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
