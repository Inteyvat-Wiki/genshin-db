		},
		{
			"id": 7329608,
			"completionStepIds": [
				7329608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329608",
							"2"
						],
						"stepId": 7329608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960801,
					"content": "Es ist doch echt schön hier, oder? Und „Pfeffer“ scheint’s auch zu gefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960802,
					"content": "Worte scheinen bei diesem Anblick überflüssig. Caterpillar hatte absolut recht. Es wartet eine so weite Welt außerhalb meiner eisernen Box ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960803
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960803,
					"content": "Eiserne Box ... Du erwähntest, dass dein Zuhause in Fontaine sehr klein sei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960804,
					"content": "*räusper* Sumeru hat einiges an Naturlandschaften zu bieten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960805
					]
				},
				{
					"id": 732960805,
					"content": "... Ah, das stimmt! Julien hat beschlossen, ein echter Maler zu werden, und ein Tapetenwechsel könnte da nicht schaden. Denn wie heißt es so schön ... Ah, man sollte seinen Horizont erweitern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960806,
					"content": "Obwohl du selbst gesagt hast, du willst aufgeben ... denkt Paimon, dass wir keine voreiligen Schlüsse ziehen sollten! Es ist nie zu spät, darüber nachzudenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960807,
					"content": "Julien, denk nur an all die spektakulären Landschaften wie diese hier oder noch schöner, die du noch nie gesehen hast ... vielleicht geben sie dir neue Inspirationen, wenn du sie siehst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960808,
					"content": "Und was die Unterscheidung von Farben betrifft ... Julien, du hast es selbst gesagt, „obwohl die Szenerie in deinen Augen etwas anders ist“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960809,
					"content": "„Aber Schönheit ist doch universell.“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960810
					]
				},
				{
					"id": 732960810,
					"content": "Stimmt doch, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960811,
					"content": "Du hast ja recht ... Alles, was ihr sagt, ergibt Sinn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960812
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960812,
					"content": "Das waren deine Worte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960813,
					"content": "Meine ... Haha, ich wusste es also. Ich ... Ich habe halt nur den falschen Weg beschritten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960814
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960814,
					"content": "„Pfeffer“ hat dich auf diesen Weg gebracht, damit wir uns kennenlernen konnten, also war es nicht komplett der „falsche Weg“, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960815,
					"content": "Es ist zwar sehr schade, dass wir dir nicht helfen konnten, den Pilgerweg der Okeaniden zu finden ... Nun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960816,
					"content": "Gibt es ihn wirklich ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960817
					]
				},
				{
					"id": 732960817,
					"content": "Ich glaube bis heute fest daran, dass es den Pilgerweg gibt, aber ... für mich spielt es keine Rolle mehr, ob ich sein Ende erreichen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960818
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960818,
					"content": "Denn ich habe die Antwort gefunden, nach der ich gesucht habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960819
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960819,
					"content": "Ich danke euch, meine beiden Freunde. *seufz* Wie kann ich mich nur erkenntlich zeigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960820
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960820,
					"content": "Hätte ich doch nur vorher dieses mysteriöse Vogelei gekauft ... Ein magischer Gegenstand, der das Unglück eines Tages aufheben kann, genau das Richtige für Abenteurer wie euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960821,
						732960823
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960821,
					"content": "Stimmt, sehr schade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960822
					]
				},
				{
					"id": 732960822,
					"content": "#{NICKNAME}, glaubst du wirklich an sowas? An irgendwelche Wundergegenstände?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960825,
					"content": "Ich habe vor, noch ein wenig länger hier zu bleiben. Hier ist es ruhig, perfekt, um nachzudenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960826
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960826,
					"content": "Ich habe so das Gefühl, dass ich etwas malen könnte, was ein wenig anders sein könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960827
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960827,
					"content": "Danke für eure Hilfe. Ich wünsche euch noch eine gute Reise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960823,
					"content": "Danke, aber wäre eh nicht nötig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960824
					]
				},
				{
					"id": 732960824,
					"content": "Warum das? Selbst wenn es das Unglück nicht aufhebt ... wäre doch wenigstens ein lecker-schmecker Ei drin, womöglich hundertmal besser als ein stinknormales Vogelei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Paimon"
				}
			]
		},
