			"dialogs": [
				{
					"id": 732960601,
					"content": "Wir müssen noch ein paar Vorbereitungen treffen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960602
					]
				},
				{
					"id": 732960602,
					"content": "Na gut ... Dann brechen wir auf, sobald alles erledigt ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
