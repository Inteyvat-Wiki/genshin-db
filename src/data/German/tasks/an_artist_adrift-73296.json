			"dialogs": [
				{
					"id": 732961601,
					"content": "Puh ... Ich hätte nicht gedacht, dass Zeichnen so eine anstrengende Sache ist. Wenn ich das gewusst hätte, dann hätte ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961602
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732961602,
					"content": "Das schien etwas zu viel für Julien zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732961603,
					"content": "I... Immerhin habe ich mich gerade erst von meinen Verletzungen erholt ... *seufz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961604
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732961604,
					"content": "Aber hier gibt es eine einzigartige Aussicht. Seltsam, dass mir das vorher nicht aufgefallen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961605
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732961605,
					"content": "Die Aussicht dort vorne dürfte auch toll sein, gehen wir hin und sehen es uns an, aber vorsichtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
