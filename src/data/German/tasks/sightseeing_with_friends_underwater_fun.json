			"dialogs": [
				{
					"id": 737130101,
					"content": "Tadaaa! Hier sind wir! Wenn wir von dieser flachen Stelle ins Wasser gehen, fühlt es sich bestimmt so an, als würde sich vor uns langsam ein ganzes Gemälde entfalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130102,
					"content": "Oh! Ihr seid es ... Und ihr habt sogar neue Gefährten dabei? Sie sind ... Pilzbestien, oder? So etwas habe ich bisher nur in Büchern gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130103
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130103,
					"content": "Wie passend, hier spielt ja auch eine Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130104,
						737130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130104,
					"content": "Hallo, Marine! Schön, dich wiederzusehen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				},
				{
					"id": 737130106,
					"content": "Oh, ich spiele nicht. Ich sammle Gezeitenalgen. Wir bereiten gerade die eingelegten Gezeitenalgen für dieses Jahr vor, und viele meiner Schwestern sind dafür ins Dorf zurückgekehrt, um zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130107
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130107,
					"content": "Sogar Enghiene und die kleine Roxane haben sich freigenommen und sind zurückgekommen. Sie sind gerade sehr beschäftigt und ich gehe gleich auch noch ins Wasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130108
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130108,
					"content": "Übrigens, Enghiene hatte recht. Die blaue Pilzbestie sieht tatsächlich ein bisschen wie eine Gezeitenalge aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130109
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130109,
					"content": "Ich meine damit nur, dass sie sehr niedlich ist! Nicht, dass ich sie essen möchte ... Mhm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130110
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130110,
					"content": "♫♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130111
					],
					"speakerTitle": "Trommelkäppchen"
				},
				{
					"id": 737130111,
					"content": "Hehe, du hast wirklich ein gutes Auge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130112,
						737130113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130112,
					"content": "Unsere Pilzgefährten sind tatsächlich sehr niedlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130114,
					"content": "Wie auch immer, es war schön, euch zu treffen. Ich muss jetzt wieder an die Arbeit, aber ich wünsche euch viel Spaß hier in der Umgebung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130115
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130115,
					"content": "Dann brechen wir auch wieder auf! Lass uns mit den Pilzgefährten noch ein paar schöne Fotos von der Unterwasserlandschaft Fontaines machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130113,
					"content": "Die Melusinen stehen ihnen da in nichts nach!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130105,
					"content": "Hallo! Neue Melusinen-Freundin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				}
			]
		}
	]
