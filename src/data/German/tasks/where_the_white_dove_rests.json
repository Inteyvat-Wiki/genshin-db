			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Columbina“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761800801,
					"content": "Es macht viel Spaß, Spiele zu spielen. Ich freue mich darauf, das öfter zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800802,
						761800803
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761800802,
					"content": "(Lass uns noch ein Weilchen so sitzen bleiben.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800804,
					"content": "Gehst du schon? Alles klar, bis zum nächsten Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761800803,
					"content": "Ich glaube, es wird Zeit, dass ich mit dem Aufräumen anfange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
