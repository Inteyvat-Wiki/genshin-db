			"dialogs": [
				{
					"id": 761800401,
					"content": "Wir haben uns früher immer in deinem Garten getroffen, Sandrone. Jetzt bist du es, die mich auf einen Tee besucht. Das ist so ein seltsames Gefühl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800402
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761800402,
					"content": "Ich bin immer noch diejenige, die alles vorbereitet. Fühlt sich für mich nicht wirklich anders an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800403
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800403,
					"content": "Mmhmm, und deine Leckereien sind noch genauso gut, wie ich es in Erinnerung habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800404
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761800404,
					"content": "#Hmpf. Ich habe aber gehört, dass {NICKNAME} dich hier auch oft besuchen kommt. Was macht ihr dann so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800405
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800405,
					"content": "#Hmm ... Manchmal unterhalten wir uns, und manchmal spielen wir Spiele mit den Kuuhenki und sehen ihnen beim Zeichnen zu. Oh, ich spiele auch Mondschach mit {M#ihm}{F#ihr}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800406
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761800406,
					"content": "Mondschach? Ist das das Spiel, bei dem man versucht, drei Steine in eine Reihe zu bekommen? Wer gewinnt denn da meistens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800407
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800407,
					"content": "#Ich habe nicht mitgezählt, aber {NICKNAME} spielt ziemlich gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800408
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761800408,
					"content": "Heh, ich zeige dir, wie echte Könner das machen. Lust auf ein Spiel? Wenn wir unentschieden spielen, zählt das als Sieg für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800409
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800409,
					"content": "Klar doch. Los geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		},
		{
			"id": 7618006,
			"completionStepIds": [
				7618004
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7618004",
							"2"
						],
						"stepId": 7618004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Columbina“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761800601,
					"content": "W... Was? Das ist unmöglich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800602
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800602,
					"content": "Sieht so aus, als hättest du verloren, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800603
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761800603,
					"content": "Ich ... Ich habe dich gewinnen lassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800604
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800604,
					"content": "Wirklich? Warum regst du dich dann so auf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800605
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761800605,
					"content": "Verdammt ... Ich will eine Revanche!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800606
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800606,
					"content": "Hmpf, nichts leichter als das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800607
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800607,
					"content": "Du hast gewonnen. Du bist wirklich ziemlich geschickt, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800608
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761800608,
					"content": "Lass uns beim nächsten Mal etwas Schwierigeres spielen. Ich kenne viele lustige Mathespiele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800609
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800609,
					"content": "Klingt aufregend! Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800610
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761800610,
					"content": "Hä? Was ist daran so lustig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800611
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800611,
					"content": "Ich kann mich kaum daran erinnern, dich vorher schon mal so glücklich gesehen zu haben. Du hast mich fast nie zum Spielen eingeladen. Meistens hast du mich einfach verscheucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800612
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761800612,
					"content": "He ... Stell mich nicht als so einen Fiesling hin! Ich werde dich ab jetzt zu mehr Teegesellschaften einladen, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800613
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761800613,
					"content": "Das würde mir gefallen. Ich genieße diese kleinen Treffen, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		},
