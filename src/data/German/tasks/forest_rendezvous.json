			},
			"dialogs": [
				{
					"id": 3550701,
					"content": "Das war knapp! Er hätte Paimon fast weggeblasen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550702,
					"content": "Paimon konnte sich gerade so an deinen Haaren festhalten. Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550703,
						3550704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550703,
					"content": "Nur gut, dass meine Haare noch sitzen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550705
					]
				},
				{
					"id": 3550705,
					"content": "Was ist da überhaupt eben passiert? Paimon dachte schon, wir wären Drachenfutter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550706,
					"content": "Der Drache hat sicher etwas mit dem komischen Kerl zu tun, der mit ihm gesprochen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550707,
						3550709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550707,
					"content": "In dieser Welt gibt es also Drachen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550708
					]
				},
				{
					"id": 3550708,
					"content": "Ja, Paimon versteht, dass du besorgt bist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550711,
					"content": "Oh, was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550712,
					"content": "Auf dem großen Stein dort leuchtet etwas Rotes ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550713,
					"content": "Sehen wir uns das vom Nahen an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550709,
					"content": "Ist es normal, mit Drachen zu reden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550710
					]
				},
				{
					"id": 3550710,
					"content": "Natürlich nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550704,
					"content": "Wenigstens hat es der Drache nicht auf uns abgesehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550705
					]
				}
			]
		}
	]
