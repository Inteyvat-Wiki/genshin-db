			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140101,
					"content": "Nichts hält ewig, gar nichts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140102,
						10140105
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140102,
					"content": "Guten Tag.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140103
					]
				},
				{
					"id": 10140103,
					"content": "#Oh, {F#junge Dame}{M#junger Herr}, bist du hier, um die Blumen zu bewundern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140104
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140104,
					"content": "Welch ein Jammer, Ihr seid nicht zur richtigen Jahreszeit hier. Diese letzte Glaslilie steht kurz vor dem Verwelken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140107,
					"content": "Warum sind diese Blumen denn alle verwelkt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140108,
					"content": "Leute in meinem Alter pflegen zu sagen, „Glaslilien“ können menschliche Emotionen empfinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140109
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140109,
					"content": "Wenn sie etwas Schönes hören, wie z. B. Lachen oder Gesang, dann sind sie glücklich und wachsen sehr gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140110
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140110,
					"content": "Wenn man sie jedoch zu vielen schlechten Klängen aussetzt, wie z. B. Gezeter und Streit, dann welken sie ganz schnell dahin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140111
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140111,
					"content": "Also können die Blumen die derzeitige Situation in Liyue auch wahrnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140112,
					"content": "Genau, die Nachricht vom Tode Rex Lapis’ ist keine kleine Sache. Es gibt viel Gerede auf den Straßen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140113
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140113,
					"content": "Manche behaupten, die Fatui seien involviert, manch andere wiederum sagen, etwas aus den Untiefen des Meeres stecke dahinter, und dann gibt es noch die, die glauben, die Qixing selbst haben alles orchestriert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140114
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140114,
					"content": "Dieser Hafen ist wie trockenes Brennholz. Ein Funke reicht aus, um ein Flammenmeer zu entfesseln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140115
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140115,
					"content": "Aber erstmal genug davon. Ich bin schon sehr alt, daher mag ich es, mit jungen Leuten zu plaudern. Wie kann ich euch denn weiterhelfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140116,
						10140121
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140116,
					"content": "Wir wollen uns die „Glocke der Reinigung“ ausleihen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140117
					]
				},
				{
					"id": 10140117,
					"content": "Oh, das alte Teil! Ich erinnere mich. Sie sollte ganz hier in der Nähe sein. Nur wo genau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140118
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140118,
					"content": "Ein alter Freund von mir trug sie immer, als ich noch jung war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140119
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140119,
					"content": "Er gab sie mir, weil er gemerkt hat, wie oft ich sie so sehnlich ansah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140120
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140120,
					"content": "Aber er sagte mir damals, dass ich nicht widerwillig sein sollte, mich von der Glocke zu verabschieden, wenn jemand sie ausleihen wolle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140127,
					"content": "Wie oft wurde die Glocke der Reinigung in all den Jahren wohl schon ausgeliehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140128
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140128,
					"content": "Ich erinnere mich allerdings nicht mehr genau, seit wann, aber bereits seit, sehr langer Zeit ist keiner mehr gekommen, um sie auszuleihen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140129
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140129,
					"content": "*ächz*, meine Knochen sind schon so alt, die Suche kann etwas dauern. Falls ihr also nicht so lange warten könnt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140130,
						10140133
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140130,
					"content": "Wir können auch selbst suchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140131
					]
				},
				{
					"id": 10140131,
					"content": "Genau, Mütterchen, wir begleiten dich heim und dann suchen wir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140132,
					"content": "Und dann ... helfen wir dir noch ein wenig aufzuräumen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140135,
					"content": "In Ordnung, Kinder, es kann nicht weit sein. Macht euch keine zu großen Umstände.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140136
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140136,
					"content": "Mütterchen, dein Haus ist also ganz hier in der Nähe? Hier, an der Yujing-Terrasse, das kostet was ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140137,
					"content": "Hehe, ich kann mir ein Haus in der Stadt nicht leisten. Seht ihr diesen Teekessel? Meine gesamten Besitztümer befinden sich darin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140138
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140138,
					"content": "Alle Besitztümer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140139,
						10140140,
						10140143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140139,
					"content": "Heißt das, die Hausschlüssel sind auch darin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140146
					]
				},
				{
					"id": 10140146,
					"content": "Hehehe, Kinder, Kinder ... das Wichtigste ist doch, dass die Glocke in dem Teekessel ist, seht doch mal nach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140140,
					"content": "Die Glocke ist alles, was du hast?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140141
					]
				},
				{
					"id": 10140141,
					"content": "Das war jetzt aber nicht sehr höflich formuliert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140142,
					"content": "Selbst wenn das so sein sollte, die Glocke ist sehr wertvoll, nicht wahr, Mütterchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140143,
					"content": "Paimon kann sich ja mal im Teekessel umsehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140144
					]
				},
				{
					"id": 10140144,
					"content": "Da passt Paimon doch nicht rein! Egal wie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140145,
					"content": "Außerdem, wieso soll Paimon denn da rein? Nehmt den Deckel ab und seht rein, reicht das nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140133,
					"content": "Ich habe beim Großmeister des Ritterordens das Suchen von Dingen gelernt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140134
					]
				},
				{
					"id": 10140134,
					"content": "Ach, auf einmal sind wir stolz auf uns, ja?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140121,
					"content": "Wir möchten uns etwas ausleihen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140122
					]
				},
				{
					"id": 10140122,
					"content": "Was denn? Oh, ihr wollt euch die „Glocke der Reinigung“ ausleihen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140123
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140123,
					"content": "Außer diesem alten Teil habe ich auch nichts, wofür ihr jungen Leute euch interessieren würdet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140124
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140124,
					"content": "Allerdings gehörte sie nicht mir, sondern einem meiner alten Freunde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140125
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140125,
					"content": "Als ich noch jung war, liebte ich schöne Dinge, also liebte ich auch diese Glocke. Und so flehte ich ihn darum an, sie mir zu geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140126
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140126,
					"content": "Er konnte mir nicht widerstehen und somit schenkte er sie mir. Aber er sagte mir damals, dass ich nicht widerwillig sein sollte, mich von der Glocke zu verabschieden, wenn jemand sie ausleihen wolle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140105,
					"content": "Was ist denn, Mütterchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140106
					]
				},
				{
					"id": 10140106,
					"content": "Ach nichts, ich finde es nur so schade, wie viele von diesen Glaslilien bereits verwelkt sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "Madame Ping"
				}
			]
		},
		{
			"id": 101402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101406",
							"2"
						],
						"stepId": 101406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140201,
					"content": "Kinder, braucht ihr die Glocke nicht dringend? Warum habt ihr noch nicht mit der Suche begonnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140202
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140202,
					"content": "Den Teekessel habe ich aber lange nicht mehr saubergemacht, passt also ein bisschen auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140203
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140203,
					"content": "Ihr tragt so nette Kleidung, es wäre eine Schande, wenn sie dreckig werden würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madame Ping"
				}
			]
		},
		{
			"id": 101403,
			"completionStepIds": [
				101403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101403",
							"2"
						],
						"stepId": 101403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madame Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140301,
					"content": "Junge Leute sind einfach schnell. Im Handumdrehen ist die Glocke gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140302,
						10140305,
						10140308
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140302,
					"content": "Bist du ein Adept?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140303
					]
				},
				{
					"id": 10140303,
					"content": "Adept ... Diese Bezeichnung habe ich schon seit Ewigkeiten nicht mehr gehört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140304
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140304,
					"content": "Ob ich ein Adept bin oder nicht, mein Kind, hat dein Herz dir nicht schon geantwortet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140312,
					"content": "Paimon versteht, aber dann auch irgendwie nicht. Mütterchen, können wir einfach die Glocke haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140313,
					"content": "Bist du nicht überrascht? Die Sache mit Rex Lapis ist gerade erst passiert und dann kommen auch schon wir, um die Glocke zu holen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140314,
					"content": "Meine Lieben, Liyue hat über die vielen Jahre bereits so viele Adepten kommen und gehen sehen und viele Stürme zogen auf, die sich wieder gelegt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140315
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140315,
					"content": "Aber egal welches Mal, wir haben immer erst einen ordentlichen Adeptenabschied gehabt und danach die restlichen Dinge geklärt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140316
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140316,
					"content": "„Fasst den Mörder“ zu schreien und dadurch den Adeptenabschied zu verzögern, das bedeutet für mich, den Karren vor das Pferd zu spannen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140317
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140317,
					"content": "Jetzt, da ihr gekommen seid, um die Glocke auszuleihen, da frage ich mich, wer von meinen alten Freunden sich endlich entschlossen hat, etwas zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140318
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140318,
					"content": "Also, wieso sollte ich es ablehnen, euch die Glocke zu geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140319,
						10140322
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140319,
					"content": "Was wäre, wenn dein alter Freund sie nicht zurückgeben würde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140320
					]
				},
				{
					"id": 10140320,
					"content": "Nicht zurückgeben? Hahaha, sollte das wirklich einer wagen, dann müsste diese alte Dame demjenigen mal einen Besuch abstatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140321
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140321,
					"content": "Das wäre auch sehr passend, weil ich meine Freunde lange nicht gesehen habe. Wir könnten Tee trinken und über alte Zeiten reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140326,
					"content": "Also gut, jetzt, da ihr sie habt, könnt ihr euch schnell um alles kümmern. Verliert keine Zeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140327
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140327,
					"content": "Bitte richtet dem, der euch geschickt hat, nur eine Kleinigkeit aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140328
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140328,
					"content": "Er soll mich doch mal wieder auf einen Tee besuchen, wenn er Zeit hat. Ich habe nicht viel, aber ich habe einen Teekessel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140329
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140329,
					"content": "In Ordnung! Das werden wir so ausrichten. Hab vielen Dank, Mütterchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140322,
					"content": "Würdest du mir die Glocke schenken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140323
					]
				},
				{
					"id": 10140323,
					"content": "#Also! Du bist mir vielleicht eine{M#r}! Das gehört doch dem Mütterchen! Sobald wir fertig sind, müssen wir alles wieder zurückgeben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140324,
					"content": "Dir schenken? Du bist ja direkt, hahaha! Wenn du sie möchtest, nimm sie dir nur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140325
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140325,
					"content": "Manchmal hat die Glocke aber auch Heimweh nach ihrem alten Mütterchen. Wer weiß, vielleicht findet sie ihren Weg doch wieder zurück zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140305,
					"content": "Du gehörst doch bestimmt den Qixing von Liyue an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140306
					]
				},
				{
					"id": 10140306,
					"content": "Die „Qixing von Liyue“, diese Leute haben mich und meine Freunde schon vor langer Zeit abgelehnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140307
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140307,
					"content": "Aber die Dinge sind in den letzten Jahren besser geworden. Uns alten Leuten mangelt es an nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140308,
					"content": "Bist du vielleicht Mitglied der Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140309
					]
				},
				{
					"id": 10140309,
					"content": "Fatui? Ahahaha, du bist wirklich lustig! Was denkst du dir nur den ganzen Tag über für Geschichten aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140310
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140310,
					"content": "Ich bin zu alt, um mich noch mit diesen Gestalten abzugeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140311
					],
					"speakerTitle": "Madame Ping"
				},
				{
					"id": 10140311,
					"content": "Wenn sie ihre Reichweite noch etwas ausdehnen würden, wäre ich wohl auch nicht vor ihnen sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madame Ping"
				}
			]
		},
		{
			"id": 101404,
			"completionStepIds": [
				101407
			],
