				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140401,
					"content": "Nicht schlecht, das ist wahrlich die „Glocke der Reinigung“ und auch noch in sehr gutem Zustand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140402
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140402,
					"content": "Wir nehmen am besten auch gleich die Duftessenz mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140403,
						10140405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140403,
					"content": "Kennst du Madame Ping?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140404
					]
				},
				{
					"id": 10140404,
					"content": "Natürlich kenne ich sie. Wie hätte ich euch sonst zu ihr schicken können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140407,
					"content": "So viele Zweifel! Aber wenn du es nicht zugeben willst, werden wir auch nicht weiter fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140408,
					"content": "Wir sollen dir auch noch etwas von der alten Dame ausrichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140409,
					"content": "„Er soll mich doch mal wieder auf einen Tee besuchen, wenn er Zeit hat. Ich habe nicht viel, aber ich habe einen Teekessel.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140410,
					"content": "Hahaha, diese Worte passen so gar nicht zu dir. Aber ihr Tee ist wirklich sehr gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140411
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140411,
					"content": "Wenn die Zeit gekommen ist, werde ich sie natürlich besuchen gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140412
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140412,
					"content": "Nun, was ist als Nächstes dran für die Zeremonie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140413,
					"content": "Als Nächstes müssen wir <color=#00E1FFFF>Drachen</color> kaufen gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140414
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140414,
					"content": "Drachen! Herr Zhongli nimmt uns mit zum Drachensteigen? Ist das unsere wohlverdiente Pause?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140415,
					"content": "Haha, nein, so ist das nicht. Drachen gelten zwar meistens als Kinderspielzeug, aber bei Ritualen in Liyue haben sie noch eine andere Symbolik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140416
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140416,
					"content": "Ich erkläre euch alles später. Jetzt müssen wir erstmal die Drachen kaufen gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140417
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140417,
					"content": "Ähm, na gut, Paimon ist sowieso schon verwirrt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140405,
					"content": "Bist du auch ein Adept?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140406
					]
				},
				{
					"id": 10140406,
					"content": "Adept ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
					],
					"speakerTitle": "Zhongli"
				}
			]
		},
