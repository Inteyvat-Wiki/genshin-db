					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911604
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911604,
					"content": "Was, spielst du immer noch den Sturkopf? Ich möchte hören, was du für einen brillanten Einfall hast.",
