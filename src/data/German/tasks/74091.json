			"dialogs": [
				{
					"id": 740911601,
					"content": "Oha, ich hätte nicht erwartet, dass ihr zwei Kinder so stark seid. Und was Balent angeht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911602
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911602,
					"content": "Schau, was hatte ich dir gesagt? Es ist zu gefährlich, du wirst damit nicht fertig. Du wolltest mir ja nicht glauben. Hast du jetzt wenigstens deine Lektion gelernt?",
					"roleType": "TALK_ROLE_NPC",
