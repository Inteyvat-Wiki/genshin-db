			},
			"dialogs": [
				{
					"id": 740910501,
					"content": "Herr Aigouy, ich ... bin zurück ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910502
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910502,
					"content": "Ihr beiden ... Ihr habt Balent wohl das Leben gerettet, danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910503
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910503,
					"content": "Du Balg ... Ich habe dir doch gleich gesagt, dass du dich nicht in diese gefährliche Arbeit stürzen sollst. Es hätte gereicht, wenn du Estienne beim Rapport davon berichtet hättest. Er hätte dann jemanden beauftragt, sich darum zu kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910504
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910504,
					"content": "Ich war immer so nett und wollte dir etwas beibringen, aber was tust du Bengel stattdessen? Du behauptest, ich würde meine Arbeit nicht ernst nehmen und meine Pflichten vernachlässigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910505
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910505,
					"content": "Schau, was hatte ich dir gesagt? Es ist zu gefährlich, du wirst damit nicht fertig. Du wolltest mir ja nicht glauben. Hast du jetzt wenigstens deine Lektion gelernt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910506
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910506,
					"content": "Ich ... Ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910507
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910507,
					"content": "Was, spielst du immer noch den Sturkopf? Ich möchte hören, was du für einen brillanten Einfall hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910508
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910508,
					"content": "Lass mich etwas Wasser trinken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910509
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910509,
					"content": "Balent findet eine Flasche Wasser und stürzt ein paar Schlücke hinter. Dann bricht er sich einen Kanten trockenes Brot ab und kaut darauf herum.\\nEr ist ganz mit Essen und Trinken beschäftigt und achtet gar nicht auf die Worte des alten Mannes.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740910510
					]
				},
				{
					"id": 740910510,
					"content": "Puh ... Endlich ... Ich hab es überlebt. Ich danke euch beiden für eure Hilfe. Ich fürchte, ohne euch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910511
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910511,
					"content": "Ich fürchte, du hättest deinen Eltern höchstens ein Sterbegeld hinterlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910512
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910512,
					"content": "Nun, das wäre immer noch besser, als für einen schweren Unfall, verursacht durch die Vernachlässigung der Pflichten, gefeuert zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910513
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910513,
					"content": "Du dummer Junge ... *seufz* Du willst es einfach nicht verstehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910514
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910514,
					"content": "Ihr zwei, ich schäme mich, das zu sagen ... aber ich muss. Es geht um unser aller Sicherheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910515
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910515,
					"content": "Ihr beiden könnt doch bestimmt tauchen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910516
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910516,
					"content": "Gelernt ist gelernt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910517,
					"content": "Als mich die Hilichurle gefangen haben, habe ich auch meinen Taucheranzug verloren. Bei der letzten Routineinspektion wurde festgestellt, dass einige Ersatzteile beschädigt sind. Ich habe zwar schon neue angefordert, aber sie sind noch nicht eingetroffen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910518
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910518,
					"content": "Aber die Wartung der Rohre kann nicht aufgeschoben werden. Da ihr zwei tauchen könnt, möchte ich euch bitten, die Unterwasserrohre vom Fort Méropide für mich zu überprüfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910519
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910519,
					"content": "Ich werde euch zwei natürlich fair dafür entlohnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910520
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910520,
					"content": "Wenn es um die Sicherheit aller geht, müssen wir natürlich helfen. Aber die Überprüfung der Rohre ist doch sicher eine sehr anspruchsvolle Aufgabe. Können wir das überhaupt übernehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910521,
					"content": "Es ist nur eine Routineinspektion. Ich schätze, es gibt nur ein paar kleinere Mängel. Bei der letzten Inspektion hatte ich vier Sicherheitsrisiken festgestellt ... Aber es sollte nicht allzu schwer sein, das in Ordnung zu bringen. Ich werde euch alles erklären!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910522
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910522,
					"content": "Wenn unter Wasser <color=#00E1FFFF>Gaslecks</color> auftreten, dann wurden sie wahrscheinlich von Unterwasserlebewesen verursacht ... oder von Zusammenstößen mit abiotischen Zeugen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910523
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910523,
					"content": "Die Notlösung besteht darin, <color=#00E1FFFF>den Durchfluss über das Regelventil zu regulieren und so das Gasleck vorübergehend zu beseitigen</color>. Wenn ihr so weit kommt, reicht das schon aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910527
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910527,
					"content": "Die Bedienung des Regelventils ist eine Feinarbeit. <color=#00E1FFFF>Wenn man das Handrad dreht, muss man den Gasfluss im Auge behalten, eine Verringerung des Gasflusses zeigt euch, dass ihr auf dem richtigen Weg seid</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910524
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910524,
					"content": "Oh ... Paimon hat schon verstanden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910525,
					"content": "Wenn euch während der Routineinspektion noch etwas nicht klar ist, werde ich euch jederzeit eure Fragen beantworten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910526
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910526,
					"content": "Na gut, dann versuchen wir es erst einmal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7409110,
			"completionStepIds": [
				7409110
			],
