			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Aigouy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740910101,
					"content": "Die Hilichurle haben das Kind doch nicht etwa gefangen, um Suppe daraus zu kochen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910102,
						740910103
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910102,
					"content": "Wer wurde gefangen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910105
					]
				},
				{
					"id": 740910105,
					"content": "Schaut, dort drüben, seht ihr das Hilichurl-Lager am Wasser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910106
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910106,
					"content": "Es scheint plötzlich über Nacht aufgetaucht zu sein. Sie müssen durchgängig geschuftet haben, ohne sich auszuruhen. Hach, so wie Balent, dieser Herumtreiber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910107
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910107,
					"content": "Ich denke ja, dass er den Hilichurlen mächtig was erzählt hätte, wenn er nicht so ein Pech gehabt hätte und jetzt nicht dort im Kochtopf säße.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910108
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910108,
					"content": "Was? Du meinst, dein Bekannter wurde von diesen Hilichurlen geschnappt? Wie kannst du dann so ruhig sein. Wenn es wahr ist, dann muss er doch schnellstens gerettet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910109,
					"content": "Retten? Wen retten? Ich habe ihm gleich gesagt, dass er sich nicht in diese gefährliche Arbeit stürzen soll. Es hätte gereicht, wenn er Estienne beim Rapport davon berichtet hätte. Der hätte dann jemanden beauftragt, sich darum zu kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910110
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910110,
					"content": "Ich war so nett und wollte ihm etwas beibringen, aber was tut der Bengel stattdessen? Er behauptet, ich würde meine Arbeit nicht ernst nehmen und meine Pflichten vernachlässigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910111
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910111,
					"content": "Wenn er die Weisheit und die Erfahrung seines Vorgängers nicht zu schätzen weiß, dann muss ich sagen, dass er es sich selbst so ausgesucht hat. Junge Leute müssen auch mal ein bisschen leiden. Wie sollten sie denn erwachsen werden, wenn sie ihre Lektion nicht lernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910112,
						740910113
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910112,
					"content": "Schwer zu beurteilen, wenn man nur eine Seite gehört hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910114,
					"content": "Ja, jetzt geht es darum, Leben zu retten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910115,
					"content": "Es ist äußerst gefährlich! Was soll ich denn machen, wenn ihr verletzt werdet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910116
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910116,
					"content": "#Mach dir darüber mal keine Sorgen. {NICKNAME} ist wirklich stark! Warte hier, Opa, wir sind gleich wieder da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910113,
					"content": "Wie soll man denn erwachsen werden, wenn man in Gefahr schwebt und vielleicht sogar sein Leben verliert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910103,
					"content": "Was für eine Suppe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910104
					]
				},
				{
					"id": 740910104,
					"content": "Da liegt also der Hase im Pfeffer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910105
					],
					"speakerTitle": "Paimon"
				}
			]
		},
