			},
			"dialogs": [
				{
					"id": 740911001,
					"content": "Wir sind zurück! Es gab tatsächlich ein paar Probleme, aber wir haben uns darum gekümmert, so wie du es uns erklärt hast. Du kannst beruhigt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911002,
					"content": "Ich bin euch wirklich sehr dankbar. Wenn diese kleinen Sicherheitsrisiken nicht rechtzeitig behoben werden und erst einmal eine ernsthafte Katastrophe eintritt, bleibt danach keine Zeit mehr, etwas zu bereuen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911003
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911003,
					"content": "... Deshalb muss ich Herrn Aigouys Standpunkt widersprechen, auch wenn ich weiß, dass er nur auf mich aufpassen will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911004
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911009,
					"content": "Jedenfalls bin ich euch für meine Rettung und die Unterstützung meiner Arbeit sehr dankbar. Ich habe hier euren Lohn, bitte sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911010
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911010,
					"content": "Tut mir leid, dass ich euch mit dieser Sache aufgehalten habe. Ich wünsche euch eine gute Reise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Balent"
				}
			]
		},
