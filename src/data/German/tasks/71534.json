			"dialogs": [
				{
					"id": 715340101,
					"content": "Hmm, ich sollte mir wohl zuerst die anderen Glückwunschkarten ansehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340102
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340102,
					"content": "#{NICKNAME}, wir haben uns lange nicht gesehen ... Warum schaust du so überrascht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340103
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340103,
					"content": "Ach, ich hab nur nicht erwartet ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340104
					]
				},
				{
					"id": 715340104,
					"content": "Dass eine Kriegerin sich auch am Laternenritual erfreuen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340105
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340105,
					"content": "Man sieht dich sonst nie so entspannt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340106
					]
				},
				{
					"id": 715340106,
					"content": "Die Tenryou-Verwaltung trägt eine große Verantwortung gegenüber den Einwohnern dort. Als ihr Mitglied kann ich es mir im Normalfall nicht leisten, mich zu entspannen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340107
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340107,
					"content": "Vielleicht halten mich die Leute für eine Kriegerin, die nichts mit Festen am Hut hat ... und in einem so festlich dekorierten und kultivierten Viertel wie Hanamizaka völlig fehl am Platz ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340108
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340108,
					"content": "Aber meine Wachsamkeit zu vernachlässigen würde bedeuten, Verbrechen zuzulassen. Das ... würde nicht nur mir persönlich schaden, sondern vor allem der Atmosphäre in ganz Hanamizaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340109
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340109,
					"content": "Ich kann höchstens jede freie Minute nutzen, die sich mir bietet, um ein wenig spazieren zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340110
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340110,
					"content": "Aber entschuldige. Ich sollte während der Feiertage nicht über so ernste Dinge sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340111
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340111,
					"content": "Ich versuche gerade, eine Glückwunschkarte zu basteln, aber es klappt nicht ganz. Vielleicht kannst du mir ja einen Rat geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340112
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340112,
					"content": "Gern, lass mich mal nachdenken ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
