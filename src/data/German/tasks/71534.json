				},
				{
					"id": 715340302,
					"content": "Vielen Dank für deine Hilfe. Mit diesem Andenken hat sich die Reise wirklich gelohnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340303
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340303,
					"content": "#Ich bin dir zu Dank verpflichtet, {NICKNAME}. Wenn du das nächste Mal Inazuma besuchst, werde ich dich zum Tee einladen.",
