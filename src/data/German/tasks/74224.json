			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tailleferre"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240801,
					"content": "Die Landschaft hier ist einfach fantastisch. Wir bestellen jedes Jahr viele Instrumente aus dieser Stadt, aber als Touristin bin ich das erste Mal hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240802,
						742240803
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240802,
					"content": "Über die Partitur ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742240803,
					"content": "Ach, nichts.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240804
					]
				},
				{
					"id": 742240804,
					"content": "Dann verlass ich mich auf euch. Solange ihr weg seid, werde ich hier in der Stadt auf gute Nachrichten warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				}
			]
		},
		{
			"id": 7422409,
			"completionStepIds": [
				7422409
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422409",
							"2"
						],
						"stepId": 7422409,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tailleferre"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240901,
					"content": "Das ist ... Ah, das ist tatsächlich die Partitur der Oper „Der fliegende Fremde“. Ihr habt sie also wirklich gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240902
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240902,
					"content": "Das war sicherlich ganz schön schwierig! Ihr seid eben wirklich die großartigen Abenteurer. Ich wusste, dass ich mich auf euch verlassen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240903
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240903,
					"content": "Hehe, aber Tailleferre, was möchtest du eigentlich mit der Partitur machen? Du willst sie doch nicht an der Opéra Épiclèse aufführen und dir eine goldene Nase verdienen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240904,
					"content": "Na ja, es ist sicherlich wichtig, Einnahmen zu haben ... Jedenfalls habe ich nicht vor, diese Partitur unter mein Kopfkissen zu legen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240905
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240905,
					"content": "Dieses alte Kunststück gehört zum Erbe der Menschheit. Wenn meine Forschungen zu „Der fliegende Fremde“ abgeschlossen sind, sollen sie der Allgemeinheit zugutekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240906
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240906,
					"content": "Liegt nicht die größere Leistung darin, ein verloren geglaubtes Werk wiederzufinden und eine weiße Stelle in der Kunstgeschichte zu füllen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240907,
						742240908
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240907,
					"content": "Viel Erfolg dabei!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240910
					]
				},
				{
					"id": 742240910,
					"content": "So, ich sollte mich schnell zurückbegeben und diese Partitur unter die Lupe nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240911
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240911,
					"content": "Hier ist eure Bezahlung. Mögen sich unsere Wege eines Tages wieder kreuzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240908,
					"content": "Vergiss nicht meinen Beitrag zu der Sache.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240909
					]
				},
				{
					"id": 742240909,
					"content": "Natürlich! Eure Namen werden auf der Titelseite erscheinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240910
					],
					"speakerTitle": "Tailleferre"
				}
			]
		},
