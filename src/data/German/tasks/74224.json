	"talks": [
		{
			"id": 7422402,
			"completionStepIds": [
				7422402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422402",
							"2"
						],
						"stepId": 7422402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tailleferre"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240201,
					"content": "Oh? Bist du nicht Tailleferre? Wer hätte gedacht, dass wir uns wiedersehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240202,
					"content": "#Oh, ihr beide seid es. {M#Der Abenteurer}{F#Die Abenteurerin} und {M#sein}{F#ihr} kleines Helferlein. Ich habe vergessen, euch beim letzten Mal nach euren Namen zu fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240203
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240203,
					"content": "#Paimon, angenehm. Und {M#er}{F#sie} ist {NICKNAME}. Ohne dich hätten wir es letztes Mal nicht geschafft, die alte Partitur mit der Meeresschneckenharfe aufzuführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240204,
					"content": "Was hat dich denn nach Petrichor verschlagen, Tailleferre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240205,
					"content": "Das würde ich euch auch gerne fragen. Ich kam sofort hierher, nachdem ich Wind davon bekommen hatte. Aber für euch als Abenteurer ist es nur natürlich, dass ihr einen Schritt voraus seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240206
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240206,
					"content": "Wind davon bekommen? Wovon redest du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240207,
					"content": "Habt ihr etwa nicht die großen Neuigkeiten aus Petrichor gehört ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240208,
						742240209
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240208,
					"content": "Darüber, wie wir versehentlich die Welt gerettet haben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				},
				{
					"id": 742240210,
					"content": "Äh? Wovon redest du? Nein, ich meine natürlich die Wiederentdeckung des legendären verblassenden Schlosses!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240211
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240211,
					"content": "Die jüngsten Aufzeichnungen über das verblassende Schloss liegen auch schon mehrere Jahrhunderte zurück. Ich dachte, ihr seid genau deswegen hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240212
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240212,
					"content": "Ach, das ... Das könnte wirklich etwas mit uns zu tun haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240213,
					"content": "Ihr wisst sicherlich, dass das verblassende Schloss einst Boethius gehörte, einem der bedeutendsten Musiker in der Geschichte Fontaines.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240214
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240214,
					"content": "Seien es die Opern, die Boethius geschrieben hat oder die alten Musiknoten Remurias, die er sammelte, sie genießen in der Musikgeschichte eine einzigartige Stellung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240215
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240215,
					"content": "Da er einst in dem Schloss wohnte, sollte es dort eine große Menge Material geben. Für unseren Musikverband sind diese Dokumente von unschätzbarem Wert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240216
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240216,
					"content": "Deshalb bin ich gleich hierhergekommen, als ich die Neuigkeiten hörte. Ich versuchte, den Abenteurern zuvorzukommen, um die wichtigen Dokumente in Sicherheit zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240217
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240217,
					"content": "Aber wie sich herausstellt, wart ihr mir einen Schritt voraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240218
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240218,
					"content": "(Was nun? Sollen wir ihr sagen, dass dieser Boethius in Wirklichkeit ein richtig übler Kerl ist und er diese Musik für seine üblen Machenschaften genutzt hat ...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240219,
					"content": "(Ob sie traurig sein wird, wenn sie die Wahrheit erfährt ...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240220,
						742240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240220,
					"content": "Die Sinfonie kann jetzt keinen Schaden mehr anrichten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240222,
					"content": "Ah? Worüber tuschelt ihr denn da? Ihr habt doch nicht etwa schon eine uralte Partitur entdeckt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240223
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240223,
					"content": "Also, mal angenommen ... wirklich, es ist nur eine Annahme ... Wenn Boethius ein schlechter Mensch wäre, würdet ihr dann immer noch seine hinterlassenen Partituren haben wollen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240224,
					"content": "Hm ... Ich weiß zwar nicht, was du mit schlecht meinst, aber abgesehen von der Musik findet die Geschichtsschreibung keine guten Worte über Boethius.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240225
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240225,
					"content": "An seiner romantischen Oper „Der fliegende Fremde“ können wir sehen, dass er bis zu seinem Tode nicht aufgehört hat, Remuria wiederzubeleben. Deshalb sah er das neu entstandene Fontaine als einen Feind an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240226
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240226,
					"content": "Den Historikern zufolge hatte er auch bei den kriegerischen Unruhen im Zusammenhang der Gründung Fontaines seine Finger im Spiel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240227
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240227,
					"content": "Seine musikalischen Errungenschaften allerdings stehen auf einem anderen Blatt Papier. Auch wenn sie historisch unrichtig sind, so ist ihr künstlerischer Wert doch nicht von der Hand zu weisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240228
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240228,
					"content": "Meiner Meinung nach ist all das selbst Teil der Geschichte. Auch reine Kunst kann für das Böse benutzt werden. Alle Musiker würden gut daran tun, das nicht zu vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240229,
						742240231
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240229,
					"content": "Du würdest sie sicherlich nicht für böse Zwecke benutzen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240230
					]
				},
				{
					"id": 742240230,
					"content": "Haha, ich bin lediglich eine Forscherin. Diese alten Melodien hören zu dürfen, ist mein sehnlichster Wunsch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240233,
					"content": "Apropos, wo ich euch hier schon zufällig treffe, könnte ich euch bitten, mir bei einer Sache zu helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240234
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240234,
					"content": "Betrachtet es als Gegenleistung dafür, dass ich euch letztes Mal geholfen habe. Eine Hand wäscht die andere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240235,
						742240237,
						742240239
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240235,
					"content": "Letztes Mal sagtest du, du erwartest keine Entschädigung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240236
					]
				},
				{
					"id": 742240236,
					"content": "Hehe, dann nennen wir es einfach „Hilfe“, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240240,
					"content": "Nun, wie ich bereits sagte, bin ich hierhergekommen, um den Verbleib der Partitur der berühmten Oper „Der fliegende Fremde“ zu klären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240241
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240241,
					"content": "Laut den Aufzeichnungen, die ein gewisser Ruggiero vor mehreren hundert Jahren hinterlassen hat, muss sie irgendwo im verblassenden Schloss sein. Könnt ihr mir helfen, sie zu suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240242
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240242,
					"content": "Im Erkunden von Ruinen solltet ihr mir schließlich weit voraus sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240243
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240243,
					"content": "#{NICKNAME}, wenn sie es so sagt, dann sollten wir ihr doch helfen! Außerdem besitzen die Partituren wahrscheinlich auch nicht mehr „jene Kraft“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240244,
					"content": "Aha, ich sehe, ihr nehmt mein Angebot an. Das ist wirklich wunderbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240245
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240245,
					"content": "Dann verlass ich mich auf euch. Solange ihr weg seid, werde ich hier in der Stadt auf gute Nachrichten warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240237,
					"content": "Ich hätte aber gerne eine Bezahlung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240238
					]
				},
				{
					"id": 742240238,
					"content": "Natürlich bekommt ihr eine Belohnung. Der Musikverband ist schließlich keine Organisation, die am Hungertuch nagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240239,
					"content": "Das hatte ich mir schon gedacht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240240
					]
				},
				{
					"id": 742240231,
					"content": "Ein wirklich beeindruckendes Urteil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240232
					]
				},
				{
					"id": 742240232,
					"content": "Hehe, es ist nur meine persönliche Ansicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240221,
					"content": "Es wird ein bisschen kompliziert, das alles zu erklären ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240209,
					"content": "Oder die Sache mit der großen Hypnose in Petrichor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				}
			]
		},
