			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910501,
					"content": "Ja, es sind wirklich bessere Steine herausgewachsen. Auch wenn wir es jetzt schon zum zweiten Mal sehen, es ist immer noch unglaublich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910502,
					"content": "Hehe, ihr skeptischen Fremdlinge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910503
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910503,
					"content": "Jetzt versteht ihr endlich ... wie großartig der Schatzfelsen ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910504
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910504,
					"content": "Ah, der Schatzfelsen, dank der Steine, die ihr gebracht habt, ist seine Kraft noch größer geworden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910505
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910505,
					"content": "Ich frage mich wirklich, was aus ihm werden wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910506
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910506,
					"content": "Jetzt, da du es sagst, bin ich auch neugierig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910507,
					"content": "Warum um alles in der Welt spuckt er bessere Steine aus, wenn er welche frisst? Sollen wir ihn aufbrechen und nachschauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910508,
					"content": "Was redest du da? Das dürfen wir auf keinen Fall!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910509
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910509,
					"content": "Wenn ihr ... wenn ihr den Schatzfelsen aufbrechen wollt, dann nur über meine Leiche ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910510
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910510,
					"content": "Ach, Paimon sagt nur ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910511,
					"content": "Na gut, weil ihr dem Schatzfelsen zuvor Steine gebracht habt ... drücke ich nochmal ein Auge zu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910512
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910512,
					"content": "Oh ... na gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910513,
					"content": "Ich spüre es, hihi, ich spüre es schon! Wenn der Schatzfelsen noch hochwertigere Steine zu fressen bekommt, wird etwas Großartiges passieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910514
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910514,
					"content": "He, Reisende, ich habe einmal von Händlern gehört, dass es in der Wüste einen speziellen schimmernden Stein gibt, der unglaubliche Kräfte birgt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910515
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910515,
					"content": "Sein Name ist ... ja, richtig, sein Name ist „Trishirait“. Wenn ihr diesen Stein holen und an den Schatzfelsen verfüttern könntet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910516
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910516,
					"content": "Bestimmt, das können wir ganz bestimmt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910517
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910517,
					"content": "#Ähm, {NICKNAME}, was sagst du dazu ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910518,
					"content": "Probieren wir es aus!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910519
					]
				},
				{
					"id": 750910519,
					"content": "Ja, Paimon ist auch wirklich neugierig, was passieren wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910520,
					"content": "Wenn ... wenn ihr den „Trishirait“ habt ... bringt ihn mir, nur einen einzigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				}
			]
		},
