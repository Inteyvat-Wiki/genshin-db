				"objectNames": [
					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910401,
					"content": "Gut ... Seid geduldig und wartet, bis alles ruhig ist. Dann werde ich die Steine an den Schatzfelsen verfüttern ... Danke für die Steine, die ihr mitgebracht habt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910402
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910402,
					"content": "Schatzfelsen, bring bitte bessere Steine hervor, hehe. Einer ... noch ein Stein, zwei Steine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				}
			]
		},
		{
			"id": 7509105,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7509105",
							"2"
						],
						"stepId": 7509105,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7509103"
						]
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
