			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910301,
					"content": "Waah, da sind tatsächlich bessere Steine herausgekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910302,
					"content": "Der Schatzfelsen ist wirklich erstaunlich ... oder hast du die Steine da draufgelegt, Qispi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910303,
					"content": "... Hahaha, so blöd bin ich nun auch wieder nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910304
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910304,
					"content": "Dank der Steine, die ihr gebracht habt, ist der Schatzfelsen jetzt viel lebendiger. Hört ihr das nicht ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910305
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910305,
					"content": "Dieses einem unterirdischen Flammenstrom ähnelnde Pochen, es ist fast wie ... ja, wie ein Herzschlag ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910306
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910306,
					"content": "Ihn mit anderen Steinen zu füttern ... war wohl die richtige Idee ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910307
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910307,
					"content": "Hm, Paimon hört gar nichts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910308,
					"content": "#{NICKNAME}, hörst du was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910309,
						750910311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910309,
					"content": "Klingt für mich wie ein normaler Stein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910310
					]
				},
				{
					"id": 750910310,
					"content": "Jepp ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910313,
					"content": "Hehe, ihr Fremden ... großartige Gäste aus der Ferne ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910314
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910314,
					"content": "Wenn ihr könnt, bringt mir noch mehr Steine, bessere, schönere Steine ... Vertraut mir, die Kraft des Schatzfelsens wird euch nicht enttäuschen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910315
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910315,
					"content": "Ich kann es spüren, ich spüre, dass das gut für ihn sein wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910316
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910316,
					"content": "Es fühlt sich an, als würden wir immer tiefer in eine Falle tappen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910317,
					"content": "#{NICKNAME}, was meinst du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910318,
					"content": "Wenn wir bessere Steine kriegen könnten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910319
					]
				},
				{
					"id": 750910319,
					"content": "Dann lohnt es sich bestimmt, es weiter zu versuchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910320,
					"content": "Hehe, dann bringt mir noch bessere Steine als beim letzten Mal ... Ah, bessere Steine, so wird die Kraft des Schatzfelsens ganz sicher wachsen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910311,
					"content": "Der Schatzfelsen schreit! „Wuaaah!“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910312
					]
				},
				{
					"id": 750910312,
					"content": "Das kann doch nicht sein! Du willst Paimon nur erschrecken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7509104,
