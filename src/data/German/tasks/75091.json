			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910101,
					"content": "Ein, zwei, hm, drei Stück ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910102
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910102,
					"content": "Hm, hm, ein ... zwei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910103
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910103,
					"content": "Huch, hier drüben ist ein ziemlich komisches Stammesmitglied!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910104,
					"content": "Die wirklich komischen Leute seid ihr Fremden, hehe, das hier ist kein Platz für Leute von außerhalb ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910105
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910105,
					"content": "Ist das hier ein verbotener Ort ... oder eine heilige Stätte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910106,
					"content": "Überhaupt nicht, das ist nur ein Schatzort, den ich zufällig entdeckt habe. Hm ... Kommt mal näher, ihr zwei, hört ihr das? Dieser besondere Stein ... der Schatzfelsen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910107
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910107,
					"content": "Aus ihm erklingt leise ein gleichmäßig an- und abschwellendes Brummen, als ob da jemand atmen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910108,
						750910110
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910108,
					"content": "Sogar Steine haben’s nicht leicht!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910109
					]
				},
				{
					"id": 750910109,
					"content": "Einfach nur atmen, das ist doch nicht schwer ... oder doch ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910112,
					"content": "Atmen ... Steine wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910113,
					"content": "Nicht nur atmen, legt mal euer Ohr dran, dann hört ihr das rhythmische Pulsieren, das Aneinanderreiben von Fels unter der rauen Oberfläche ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910114
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910114,
					"content": "Hehe, wirklich ein wundervoller Klang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910115
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910115,
					"content": "Und, und ... Wenn man ihn mit kleinen Steinen füttert, spuckt er sogar noch bessere, hübschere Steine aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910116
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910116,
					"content": "Hach, unglaublich, oder? Sieh mal, diese Edelsteine, einer, zwei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910117
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910117,
					"content": "Ach so, du hast also Edelsteine gezählt, als wir gerade vorbeikamen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910118,
					"content": "Genau, und ich spüre, dass der Schatzfelsen umso kräftiger wird, je mehr unterschiedliche Steine er frisst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910119
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910119,
					"content": "Das ist wirklich ein Wunder. Hach, der Schatzfelsen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910120,
						750910121
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910120,
					"content": "Das klingt schon ziemlich verdächtig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910122,
					"content": "Hehe, ich habe nicht erwartet, dass ihr Fremden mir glaubt. Niemand wird mir glauben, wenn er es nicht selbst ausprobiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910123
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910123,
					"content": "Ich habe es auch nur zufällig entdeckt, als ich einige gesammelte Steine neben den Schatzfelsen gelegt habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910124
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910124,
					"content": "Genau ... Probiert es mal aus! Dann werdet ihr es glauben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910125
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910125,
					"content": "Übrigens, die Steine in der Nähe hat er schon alle verputzt. Er braucht neue, aber ich kann sie nicht holen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910126
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910126,
					"content": "Hä? Warum denn nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910127,
					"content": "Natürlich! Ich muss den Schatzfelsen permanent im Auge behalten! Was ... was, wenn er im Boden verschwindet, während ich weg bin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910128
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910128,
					"content": "Ich bewache ihn schon eine Ewigkeit, und alle meine Steine hat er schon gefressen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910129
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910129,
					"content": "Bringt ... Bringt mir ein paar neue Steine! Ich werde ihn füttern und es euch beweisen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910130
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910130,
					"content": "Hmm, das klingt wirklich nach einem Schwindler ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910131,
					"content": "#Was meinst du, {NICKNAME}, sollen wir es versuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910132,
					"content": "Es sind ja schließlich nur Steine ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910133
					]
				},
				{
					"id": 750910133,
					"content": "Hehe, dann sucht ein paar Steine und gebt sie mir ... Der Schatzfelsen wird bestimmt bessere ausspucken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910121,
					"content": "Wirklich? Das hört sich sehr nach Betrug an ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910110,
					"content": "Atmen gehört auch zu meinen Kernkompetenzen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910111
					]
				},
				{
					"id": 750910111,
					"content": "Genau, atmen kann doch jeder ... Halt, darum geht es nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7509102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
