					"Qispi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750910201,
					"content": "Gut ... Seid geduldig und wartet, bis es ruhig ist. Dann werde ich die Steine an den Schatzfelsen verfüttern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910202
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910202,
					"content": "Schon sehr bald werden neue Steine daraus hervorwachsen, hehe. Einer und noch einer, zwei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				}
			]
		},
		{
			"id": 7509103,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
