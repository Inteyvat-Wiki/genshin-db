			},
			"dialogs": [
				{
					"id": 413430601,
					"content": "Wann können wir nach Mondstadt zurückkehren, Schwester?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430602
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430602,
					"content": "Hmm ... warten wir noch eine Weile. Wir sind noch nicht so lange weg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
		{
			"id": 4134307,
			"completionStepIds": [
				4134307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134307",
							"2"
						],
						"stepId": 4134307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Freki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430701,
					"content": "#Hallo {F#Reisende}{M#Reisender}. Hast du die Löwenzahnsamen schon verstreut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430702
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430702,
					"content": "Habe ich gerade erledigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430703
					]
				},
				{
					"id": 413430703,
					"content": "Super! Hoffentlich trägt der Wind sie bis nach Mondstadt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430704
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430704,
					"content": "Du meintest, wir sollten uns an die neue Umgebung anpassen ... Aber letzten Endes konnten wir unsere alten Gewohnheiten aus Mondstadt nicht abschütteln. Wie wäre es, wenn wir uns heute ein paar Leckereien aus Mondstadt besorgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430709
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430709,
					"content": "Nein, das ist einfach nicht gut genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430710
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430710,
					"content": "Wie? Wie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430705
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430705,
					"content": "Aber es ist doch beides möglich. Wir können uns anpassen, ohne zugleich unsere alten Gewohnheiten aufzugeben. Lassen wir die Laterne steigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430706
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430706,
					"content": "Habt ihr euren Wunsch aufgeschrieben? Sobald sie sich in die Lüfte erhebt, widmen wir uns den festlichen Leckereien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430707
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430707,
					"content": "Ich habe meinen Wunsch aufgeschrieben, ja. Aber müssen wir danach unbedingt was essen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430708
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430708,
					"content": "Haha, na klar! Die Leckereien vom Laternenritual in Liyue sollte man auf keinen Fall verpassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		}
	]
}