			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Freki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430301,
					"content": "Vielen Dank. Jetzt müssen wir noch einen Wunsch darauf schreiben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430302
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430302,
					"content": "Hmm ... Mal überlegen. Was sollen wir schreiben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430303
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430303,
					"content": "Wie wäre es ... damit. Apropos, bei den Laternen, die unsere Wünsche in den Himmel tragen, fällt mir etwas ein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430304
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430304,
					"content": "In Mondstadt vertrauen wir unsere Wünsche dem Löwenzahn an, bevor wir seine Samen im Wind verstreuen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430305
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430305,
					"content": "Jetzt, da du es sagst, habe ich ein wenig Heimweh nach Mondstadt. Wir haben auch länger keinen Löwenzahn mehr gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430306
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430306,
					"content": "#{F#Reisende}{M#Reisender}, dürften wir dich damit behelligen, uns ein paar Löwenzahnsamen zu bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430307
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430307,
					"content": "Ich kümmere mich darum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430308
					]
				},
				{
					"id": 413430308,
					"content": "Danke für deine Hilfe! Bring sie gleich her, sobald du sie gefunden hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
