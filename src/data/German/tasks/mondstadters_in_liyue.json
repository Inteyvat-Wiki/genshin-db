		},
		{
			"id": 4134305,
			"completionStepIds": [
				4134305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134305",
							"2"
						],
						"stepId": 4134305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Freki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430501,
					"content": "Danke. Ha, noch sind wir nicht lange von Mondstadt fort, trotzdem vermissen wir bereits die Heimat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430502
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430502,
					"content": "Wie es unserer Familie wohl geht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430503
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430503,
					"content": "Nun, jetzt ist der passende Moment ... Hast du irgendwelche Wünsche, Freki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430504
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430504,
					"content": "Ich? Lass mich überlegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430505
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430505,
					"content": "#Das sollte genügen. {F#Reisende}{M#Reisender}, eine Bitte habe ich noch an dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430506
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430506,
					"content": "Löwenzahnsamen müssen von einem hohen Ort aus verstreut werden, damit sie weit fliegen. Doch Liyue ist ganz anders aufgebaut als Mondstadt und wir wissen nicht, wie wir an einen hohen Ort gelangen sollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430507
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430507,
					"content": "Würdest du einen hohen Platz für uns finden, um die Löwenzahnsamen zu verstreuen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430508
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430508,
					"content": "Ich helfe euch dabei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430509
					]
				},
				{
					"id": 413430509,
					"content": "Dann zählen wir auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
		{
			"id": 4134306,
