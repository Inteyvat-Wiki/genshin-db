					"Freki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430101,
					"content": "Aber wie sollen wir eine Laterne basteln? Hast du eine Idee, Schwester?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430102
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430102,
					"content": "Keine Ahnung ... Sollen wir jemanden darum bitten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430103
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430103,
					"content": "Ihr beiden wollt also auch eine Laterne steigen lassen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430104
					]
				},
				{
					"id": 413430104,
					"content": "#Oh, du bist es, {F#Reisende}{M#Reisender}. Ja, wir spielen mit dem Gedanken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430105
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430105,
					"content": "Eigentlich wollten wir nur die besonderen Gerichte während des Fests ausprobieren. Aber Geri meinte, er will auch eine Laterne steigen lassen, für die festliche Stimmung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430106
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430106,
					"content": "Nun, um die festliche Stimmung zu verspüren, solltet ihr von den festlichen Gerichten kosten, oder? Das große Ganze zählt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430107
					],
					"speakerTitle": "Geri"
				},
				{
					"id": 413430107,
					"content": "Es heißt auch, man kann sich mit jeder Laterne etwas wünschen, oder so ... Aber wir wissen nicht, wie man eine anfertigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430108
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430108,
					"content": "#{F#Reisende}{M#Reisender}, würdest du uns dabei helfen, eine dieser Laternen zu flechten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430109
					],
					"speakerTitle": "Freki"
				},
				{
					"id": 413430109,
					"content": "Ihr könnt auf mich zählen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430110
					]
				},
				{
					"id": 413430110,
					"content": "Wunderbar! Dann warten wir hier auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freki"
				}
			]
		},
		{
			"id": 4134302,
