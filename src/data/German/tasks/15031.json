			"dialogs": [
				{
					"id": 150310101,
					"content": "Häuptling Acatl versammelt alle Stammesmitglieder, um Varesas Bericht über die Pilze zu hören.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150310102
					]
				},
				{
					"id": 150310102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310103
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310104
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310104,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310105
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310105,
					"content": "Gut, damals kam es uns ganz normal vor. Aber wenn man es jetzt nochmal hört, klingt es eher ... lächerlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310106,
					"content": "Dieses Schweigen spricht Bände ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310107
					]
				},
				{
					"id": 150310107,
					"content": "Also haben die Pilze in der Obstplantage ein eigenes Bewusstsein ... Das ist eine unglaubliche Entdeckung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310108
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310108,
					"content": "Ja, wer weiß, was ohne eure Nachforschungen hätte passieren können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310109
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310109,
					"content": "Vielen Dank, dass ihr da aufgepasst habt, und auch für das Sammeln dieser Hinweise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310110
					],
					"speakerTitle": "Xoctli"
				},
				{
					"id": 150310110,
					"content": "Puh, ich fürchtete schon, das klänge, als hätte ich einen Sprung in der Schüssel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310111
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310111,
					"content": "Hahaha, es klingt schon etwas weit hergeholt. Schließlich hat noch nie jemand hier mit einem Pilz gesprochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310112
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310112,
					"content": "Aber du hast uns nie belogen, Varesa. Wir wissen das. Außerdem sind die grünen Pilze schon immer ein Rätsel für uns gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310113
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310113,
					"content": "Dank euch wissen wir jetzt, dass etwas Dunkles im Gange sein könnte. Also sollten wir auch mithelfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310114
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310114,
					"content": "Ja, lasst mich wissen, falls ich irgendwie helfen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310115
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310115,
					"content": "Wah! Viel Überzeugungsarbeit war ja mal nicht nötig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310116,
					"content": "Vielen Dank euch allen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310117
					]
				},
				{
					"id": 150310117,
					"content": "Oh, warte, du hast gesagt, dass diese Pilze mit hohen Temperaturen gekocht werden müssen, richtig? Warte kurz, ich kann das fix für dich veranlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310118
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310118,
					"content": "So, da bin ich wieder! Ich habe Gusseisen benutzt, die Temperatur sollte ausreichen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310119
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310119,
					"content": "Waah, das duftet wirklich lecker. Paimons Appetit ist wieder da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310120,
					"content": "A... Also, dann werde ich mal zugreifen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310121
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310121,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310122
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310122,
					"content": "Warte, das ist seine Stimme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310123,
					"content": "Hahaha, ihr habt anscheinend den Dreh raus. Aber diese Temperatur wird nicht im mindestens der Ernsthaftigkeit gerecht, die ich verlange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310124
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310124,
					"content": "Habt ihr geglaubt, ihr könnt mit so einem popeligen Ofen die Anerkennung des Weisen Herrn der Pilze erlangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310125
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310125,
					"content": "Menschen sind so enttäuschend. Sie können die Rätsel nur lösen, wenn man ihnen die Antworten auf einem Silbertablett serviert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310126
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310126,
					"content": "Aber wenn es einmal keine Hinweise mehr gibt ... ist kein Funke Verstand mehr zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310127
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310127,
					"content": "Versucht doch bitte diesmal euer Hirn zu benutzen, hehehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310128
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310128,
					"content": "Wie ist das gelaufen? Hast du die Stimme gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310129
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310129,
					"content": "Igitt! Was für ein widerlicher Pilz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310130,
					"content": "Der Weise Herr der Pilze sagte, die Temperatur sei nicht hoch genug. Er ist wirklich der Herr der Nörgelei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310131,
						150310132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310131,
					"content": "Dennoch, der einzige Weg herauszufinden, was er vorhat ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310133
					]
				},
				{
					"id": 150310133,
					"content": "Nicht hoch genug, hmm ... Dann brauchen wir wohl eine andere Wärmequelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310134
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310134,
					"content": "Achtung, an alle! Wir brauchen Gegenstände, die intensive Hitze erzeugen. Alles, was ihr finden könnt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310135
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310135,
					"content": "Mal sehen, was ich machen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310136
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310136,
					"content": "Überlass das mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310137
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310137,
					"content": "Sollten wir auch auf die Suche gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310138
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310138,
					"content": "Definitiv! Aber leider kennen wir uns hier nicht so gut aus. Hast du eine Idee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310139,
					"content": "Nun ... Es gibt noch keine Anhaltspunkte, aber wir können zum Vulkan gehen und uns dort umsehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310140
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310140,
					"content": "Er spuckt immer wieder Dinge aus. Vielleicht gibt es darunter ja brauchbare Materialien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310141
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310141,
					"content": "Auf geht’s! Paimon wird etwas glühend Heißes finden und es diesem bösen Stinkpilz ins Gesicht werfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310132,
					"content": "... ist, sich darauf einzulassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310133
					]
				}
			]
		},
