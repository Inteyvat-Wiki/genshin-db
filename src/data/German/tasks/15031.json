						"position": [
							-3047.629,
							233.936,
							9909.162
						],
						"pointId": 10931
					}
				]
			},
			"dialogs": [
				{
					"id": 150310401,
					"content": "Was für eine Ausbeute! Wir haben einen Haufen Gestaltaugen gefunden und auch dieses Ding, mit dem es anscheinend Feuer spuckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310402,
					"content": "Ich glaube, das ist sein Rückenpanzer! Er kann Phlogiston ausstoßen und ermöglicht es ihm, superflink zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310403
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310403,
					"content": "Mein Vater hat mir mal erzählt, dass diese Wesen normalerweise im Vulkan leben, also haben wir wirklich Glück gehabt, einem persönlich zu begegnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310404
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310404,
					"content": "Ich habe das Gefühl, dass dieses Panzerteil sogar noch höhere Temperaturen erzeugen kann als die Gestaltaugen. Auf jeden Fall werden wir den Pilzen diesmal ordentlich einheizen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310405
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310405,
					"content": "Du hast auch gut gekämpft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310406
					]
				},
				{
					"id": 150310406,
					"content": "Ja ... Ich kämpfe zwar nicht gern, aber manchmal hat man keine andere Wahl. Also habe ich einige Zeit damit verbracht, herauszufinden, wie ich am schnellsten in den „Kampfmodus“ komme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310407
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310407,
					"content": "Eine Sache, die ich gemacht habe, war, viele Heldengeschichten zu lesen. Meine Lieblingsheldin ist die, die ich schon erwähnt habe und die Fietena hieß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310408
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310408,
					"content": "Das bekannteste Merkmal von Fietena war ihre Maske, und so habe ich mir nach den Beschreibungen in der Geschichte auch eine Maske gebastelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310409
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310409,
					"content": "Wenn ich die Maske aufsetze, ist es, als würde ich mich selbst in Fietena verwandeln. Ich muss alle meine Ängste beiseiteschieben, um ihren Namen nicht zu entehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310410
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310410,
					"content": "Aber man könnte auch sagen, dass ich mich hinter ihrem Ruhm verstecke ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310411
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310411,
					"content": "Ah, so siehst du das also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310412,
						150310413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310412,
					"content": "Aber es funktioniert doch, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				},
				{
					"id": 150310414,
					"content": "Wirklich? Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310415
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310415,
					"content": "Müsste ich nicht eines Tages diese Maske ablegen und mir selbst ins Gesicht sehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310416
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310416,
					"content": "Aber je länger ich das nicht tue, desto abhängiger werde ich von meiner Maske. Also ... Ich mache mir wirklich Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310417,
						150310418
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310417,
					"content": "Aber du warst es doch, die beschlossen hat, diesen Fall zu untersuchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310419,
					"content": "Ja, du warst es, die beschlossen hat, in diesem Fall zu ermitteln. Die wahre Bedeutung des Abenteuers liegt darin, mutige Entscheidungen zu treffen. Kämpfen ist nur ein kleiner Teil davon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310420,
					"content": "Ich verstehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310421
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310421,
					"content": "Das hast du gut gemacht. Es gibt keinen Grund zur Eile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310422,
					"content": "Ich danke euch beiden. Ihr habt mich immer ermutigt und ich habe viel gelernt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310423
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310423,
					"content": "Hmm! Ich werde weiter wachsen, bis ich mir endlich ins Gesicht sehen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310424
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310424,
					"content": "Moment mal ... Jetzt, da es mir besser geht, habe ich plötzlich Hunger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310425
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310425,
					"content": "Hm? Du hast schon wieder Hunger? Paimon hat ihre letzte Mahlzeit noch nicht verdaut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310426,
					"content": "Gehen wir zurück zum Stamm. Diesmal werden wir den Weisen Herr der Pilze endlich dazu bringen, uns anzuerkennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310418,
					"content": "Nicht deine Maske.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310413,
					"content": "Solange es funktioniert, gibt es keinen Grund, sich zu schämen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				}
			]
		}
	]
}