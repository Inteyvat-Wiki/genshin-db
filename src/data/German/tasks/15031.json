						],
						"pointId": 10929
					}
				]
			},
			"dialogs": [
				{
					"id": 150310301,
					"content": "So, fertig! Oh, dieser Kern sieht gut aus. Seht ihr? Das Phlogiston darin ist noch aktiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310302
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310302,
					"content": "Lass Paimon mal schauen! Ooh, das ist ja kochend heiß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310303,
					"content": "Noch ein paar Brocken wie dieser sollten reichen. Komm, da oben müsste noch mehr sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				}
			]
		},
		{
			"id": 1503104,
