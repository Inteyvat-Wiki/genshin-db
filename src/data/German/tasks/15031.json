					}
				]
			},
			"dialogs": [
				{
					"id": 150310201,
					"content": "Ich kenne diesen Weg gut. Ich glaube, man kann hier oft Lavagestalten finden, die am Wegrand ruhen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310202
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310202,
					"content": "Ihre Kerne sollten für unsere Zwecke heiß genug sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310203
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310203,
					"content": "Paimon hat nicht damit gerechnet, dass uns alle so schnell zu Hilfe eilen ... Sieht so aus, als hätten sie den Pilz auch schon länger im Verdacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310204,
					"content": "Mhm, und das haben wir euch zu verdanken, dass ihr diese Untersuchung ins Rollen gebracht habt! Wirklich, viele Leute haben diesen Pilz schon gegessen, aber keiner von ihnen war in der Lage, ein Gespräch mit ihm zu beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310205
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310205,
					"content": "Stimmt ... Selbst wenn man nachforschen wollte, gab es keine Möglichkeit, damit anzufangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310206,
					"content": "Das ist wirklich eine seltene Gelegenheit! Außerdem hat dieser arrogante Weise Herr der Pilze vielleicht versehentlich den Konkurrenzgeist meines Stammes geweckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310207
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310207,
					"content": "Nun ... Hier scheinen Wettbewerbe so etwas wie ein gemeinsames Hobby zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310208
					]
				},
				{
					"id": 150310208,
					"content": "Das stimmt ... Wir haben es nur nicht bemerkt, weil Varesa so lieb ist. Zumindest wenn sie nicht gerade trainiert oder Monster bekämpft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310209,
					"content": "Ja, was das angeht ... Ich bin kein Fan von Kämpfen oder Wettkämpfen. Ich möchte einfach nur ein glückliches Leben führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310210
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310210,
					"content": "Aber Meister Iansan hat mir auch viel beigebracht, zum Beispiel, dass Kraft mehr Mittel als Zweck ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310211
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310211,
					"content": "Hätte ich in meinem Leben nicht hart trainiert und gewusst, wie ich mein Göttliches Auge einsetzen kann, wäre ich bei der Invasion des Abgrundes hilflos gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310212
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310212,
					"content": "Egal wie viel Angst ich habe, ich muss meinen Mut zusammennehmen. Ich muss in der Lage sein, meinen Teil zum Schutz aller beizutragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310213,
						150310214
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310213,
					"content": "Ich kann es sehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310215
					]
				},
				{
					"id": 150310215,
					"content": "Danke. Ich werde immer mutiger, bis ich so stark bin wie Fietena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310216
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310216,
					"content": "Gehen wir. Wir werden unterwegs nach Material suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310214,
					"content": "Tief in deinem Herzen ist eine Quelle der Kraft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310215
					]
				}
			]
		},
