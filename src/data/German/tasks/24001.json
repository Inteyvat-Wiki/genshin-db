			},
			"dialogs": [
				{
					"id": 240010301,
					"content": "Er ist also wirklich hier. Anscheinend geht es ihm ganz gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010302
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010302,
					"content": "Wann wird Fräulein Staelle bewusst, dass ein Hund keine Opern mag und auch nicht ihren Romanen zuhören will?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010303
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010303,
					"content": "Lass uns zurück. Fräulein Staelle wartet sicher ganz ungeduldig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Blathine"
				}
			]
