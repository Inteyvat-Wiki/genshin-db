			"dialogs": [
				{
					"id": 240010501,
					"content": "Mag Barea meinen neu geschriebenen Roman etwa nicht? *seufz* Andere Leute haben ihn doch über den grünen Klee gelobt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010502
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010502,
					"content": "Oh, das nächste Mal muss ich etwas Besseres auswählen, was ich Barea vorlese ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Staelle"
