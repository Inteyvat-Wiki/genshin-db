			"dialogs": [
				{
					"id": 240010401,
					"content": "Barea! Mein Schatz! Wo bist du nur gewesen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010402
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010402,
					"content": "Er hat nur einen ruhigen und friedlichen Ort gesucht, um dort ein Weilchen zu verbringen und sich eine kleine Auszeit zu geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010403
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010403,
					"content": "Ich war unheimlich besorgt. Vielen Dank, Frau Blathine. In meinem nächsten Roman werde ich dich erwähnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010404
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010404,
					"content": "Danke für die Nettigkeit. Aber es ist wohl nicht notwendig, mich in einem Roman zu erwähnen. Es gibt wohl niemanden, der sich für den Alltag einer Gendarmin interessiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010405
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010405,
					"content": "Dann schreibe ich deine Geschichte mit vielen Höhen und Tiefen, damit sie interessant zu lesen ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010406
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010406,
					"content": "Dieses Versprechen allein wird wohl schon bei meiner Stimmung für Höhen und Tiefen sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010407
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010407,
					"content": "Und das Ende muss die Leute auch zum Denken anregen! Lass mich überlegen, was ich dir am besten für einen Kollegen zuteile ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Staelle"
				}
			]
		},
