				]
			},
			"dialogs": [
				{
					"id": 240010101,
					"content": "Hilf mir bitte! Ich habe gerade an die Geschichte eines Romans gedacht. Ich war einmal etwas unaufmerksam und schon ist Barea einfach verschwunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010102
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010102,
					"content": "Bist du sicher, dass Barea nicht an deinem Platz im Opernhaus zurückgelassen oder am Eingang einer Toilette angebunden wurde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010103
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010103,
					"content": "Diese Orte habe ich schon durchsucht. Selbst unter dem Sitz habe ich schon gesucht, aber ich habe Barea nicht gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010104
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010104,
					"content": "Oh, mein Barea! Du wirst doch nicht von jemandem entführt worden sein, oder dich Hals über Kopf verliebt haben und völlig ahnungslos mit jemandem mitgegangen sein, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010105
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010105,
					"content": "Fräulein Staelle, ich bin sicher, dass Barea bei dieser Sache nicht ein zweites Mal einen Fehler machen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010106
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010106,
					"content": "Barea ist aber noch so jung ... In dem Alter macht man unentwegt dieselben Fehler. Gut möglich, dass Barea Spaß dabei hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010107
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010107,
					"content": "Barea ist sicher nicht so jung, wie du denkst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010108,
						240010109
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010108,
					"content": "Darf ich fragen, wer Barea ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				},
				{
					"id": 240010110,
					"content": "Barea ist der Hund von Fräulein Staelle ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010111
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010111,
					"content": "Nein, er ist meine Familie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010112
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010112,
					"content": "Äh ... Ein Mitglied ihrer Familie ist gerade verschwunden. Sie bittet mich um meine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010113
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010113,
					"content": "... Fräulein Staelle, diese Gegend haben wir bereits durchsucht, Barea ist wohl schon in die Wildnis verduftet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010114
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010114,
					"content": "Na dann gehen wir doch in die Wildnis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010115
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010115,
					"content": "Ich bitte dich, in der Stadt zu bleiben. Schau dir dein Kleid an. Selbst wenn du Barea findest, holst du ihn nicht ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010116
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010116,
					"content": "Blödsinn! Wenn Barea nur meine Stimme hört, wird er angerannt kommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010117
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010117,
					"content": "Das bedeutet, dass Barea uns sicher nicht gehört hat, als wir seinen Namen so lange in der Umgebung des Opernhauses riefen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010118
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010118,
					"content": "Deshalb, Fräulein Staelle, fürchte ich, dass ich nicht in der Lage bin, Barea allein an deine Seite zurückzubringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010119
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010119,
					"content": "Ich kann meinen Posten nicht zu lange verlassen, geschweige denn eine andere Kollegin bitten, ihren Posten mit mir zu verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010120
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010120,
					"content": "#{F#Reisende}{M#Reisender}, kannst du mir und Fräulein Staelle helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010121,
						240010122
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010121,
					"content": "Na ja, kein Problem ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010124
					]
				},
				{
					"id": 240010124,
					"content": "Es ist also abgemacht. Dann komm bitte mit mir in die Wildnis für die Suche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010125
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010125,
					"content": "Wenn man das Gewicht und die Ausdauer von Barea berücksichtigt, kann Barea nicht weit gekommen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010126
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010126,
					"content": "Aber Barea ist äußerst gesund!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010127
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010127,
					"content": "Wenn damit der geistige Zustand von Barea gemeint ist, bin ich völlig gleicher Meinung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010128
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010128,
					"content": "Brechen wir also auf. Wenn Barea die Vorteile der Wildnis erkennt, ist es gut möglich, dass er noch weiter wegläuft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010129
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010129,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010122,
					"content": "Die Gendarmerie kümmert sich also auch um solche Dinge?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010123
					]
				},
				{
					"id": 240010123,
					"content": "Wenn mich Bürger des Hofs von Fontaine um Hilfe bitten, habe ich keinen Grund, ihre Bitte abzulehnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010124
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010109,
					"content": "Gibt es irgendwelchen Ärger?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				}
			]
		},
