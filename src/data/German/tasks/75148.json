			"dialogs": [
				{
					"id": 751480601,
					"content": "Ah, endlich oben. Wer hätte gedacht, dass es so hoch ist. Aber es ist nicht so kalt wie Paimon es sich vorgestellt hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480602,
					"content": "*brüll* ... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480603,
					"content": "Wie sollte dir kalt sein, so speckig wie du bist!",
