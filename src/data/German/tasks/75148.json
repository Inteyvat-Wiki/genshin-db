						],
						"pointId": 351700005
					}
				]
			},
			"dialogs": [
				{
					"id": 751480201,
					"content": "Hä? War das gerade ... ein Qucusaurier?!? Der Qucusaurier schleppt also tatsächlich die geklaute Statue hierher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480202,
					"content": "Moment mal, hat er die Statue geschnappt und ist einfach gesprungen? Direkt in den Krater!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480203,
					"content": "Das ist also der Krater ... Schon ziemlich beeindruckend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480204,
					"content": "Hmm ... Als wir nach dem Weg gefragt haben, hieß es doch, dass sich hier große Mengen gasförmiges Phlogiston ansammeln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480205,
					"content": "Stimmt! <color=#00E1FFFF>So kommt man durch das gasförmige Phlogiston</color> ... Genau wie der Qucusaurier es gemacht hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480206,
					"content": "Aber, puh ... Das ist ganz schön hoch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480207,
						751480210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480207,
					"content": "Keine Sorge, ich halte dich einfach fest, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480208
					]
				},
				{
					"id": 751480208,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480209
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480209,
					"content": "Äh? Du willst das auch tun? Ehrlich? ... Na gut, dann fühlt es sich gar nicht mehr so beängstigend an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480214,
					"content": "Und es ist nicht nur hoch ... Da ist außerdem das ganze gasförmige Phlogiston!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480215,
					"content": "Hm, w... wir gehen los, sobald du bereit bist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480210,
					"content": "Solange Paimon mich im richtigen Moment auffängt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480211
					]
				},
				{
					"id": 751480211,
					"content": "Das klappt nicht! Selbst wenn Paimon stark genug wäre ... wie sollen wir bitte genau den richtigen Moment erwischen!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480212,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480213,
					"content": "Du auch, jetzt hör doch mal auf mit dem Gebrüll. *seufz* ... Wegen euch ist die ganze Anspannung weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "Paimon"
				}
			]
		},
