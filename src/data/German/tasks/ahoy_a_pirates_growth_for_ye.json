				2100007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100006",
							"3"
						],
						"stepId": 2100006,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100007",
							"2"
						],
						"stepId": 2100007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kleiner Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210000301,
					"content": "Ich kann es nicht glauben ... Ich kann nicht glauben, dass es so etwas gibt ... Es erschreckt mich zu Tode ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000302
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000302,
					"content": "Vielen herzlichen Dank. Machen wir weiter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000303
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000303,
					"content": "Was? Wo ist meine ... meine Flasche? Sie war gerade noch bei mir. Sie ist weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000304
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000304,
					"content": "Ist sie irgendwo heruntergefallen, als sie von dieser ... dieser Vaniloqua angegriffen wurde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000305
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000305,
					"content": "Bitte hilf mir sie zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleiner Meng"
				}
			]
		},
		{
			"id": 2100005,
			"completionStepIds": [
				2100011
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100017",
							"3"
						],
						"stepId": 2100017,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100011",
							"2"
						],
						"stepId": 2100011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kleiner Meng",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210000501,
					"content": "Toll ... Ich habe gestern die ganze Nacht geschrieben ... Ich müsste alles neu schreiben, wenn ich sie verlieren würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000502
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000502,
					"content": "Och ... Hast du so viele Probleme? Wie kommt es, dass du die ganze Nacht geschrieben hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000503,
					"content": "Es ist nicht so, dass ich mir viele Sorgen mache. Ich möchte immer noch wissen, wie ich reif werden kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000504
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000504,
					"content": "Ich habe viele Informationen nachgeschlagen und eine Menge Bücher gelesen, aber je mehr ich las, desto mehr Dinge konnte ich nicht verstehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000505
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000505,
					"content": "Hehe, ich werde also alle Fragen stellen, die ich nicht verstehe, und hoffentlich Antworten bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000506
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000506,
					"content": "Lasst uns schnell die Flaschenpost rausbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleiner Meng"
				}
			]
