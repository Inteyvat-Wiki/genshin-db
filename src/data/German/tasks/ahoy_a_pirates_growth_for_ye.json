			},
			"dialogs": [
				{
					"id": 210000101,
					"content": "Hmm, kann ich das wirklich tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000102
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000102,
					"content": "Kleiner Meng, was ist los mit dir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000103
					]
				},
				{
					"id": 210000103,
					"content": "Du bist es, hallo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000104
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000104,
					"content": "Kleiner Meng, warum siehst du unglücklich aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000105,
					"content": "Was ist hier los? Wollen deine Freunde das Piratenspiel nicht mehr mit dir spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000106,
					"content": "Was? Nein, die kleine Lulu und der kleine Fei sind nach Hause gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000107
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000107,
					"content": "Ich ... wollte alleine spazieren, deshalb bin ich eine Weile nicht nach Hause gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000108
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000108,
					"content": "Beunruhigt das deine Eltern nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000109,
					"content": "Zu dieser Tageszeit sind meine Eltern noch bei der Arbeit und nicht zu Hause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000110
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000110,
					"content": "#Nun, {NICKNAME}, kannst du mir eine Frage beantworten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000111,
						210000112
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000111,
					"content": "Was für eine Frage?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000114
					]
				},
				{
					"id": 210000114,
					"content": "#{NICKNAME}, ich habe von vielen über deine Geschichte gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000115
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000115,
					"content": "Ich denke, dass du an vielen Orten gewesen bist und viele Dinge erlebt hast ... Vielleicht kannst du mir die Antwort auf diese Frage sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000116
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000116,
					"content": "Oho... der kleine Meng ist plötzlich so ernst ... Wo liegt das Problem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000117,
					"content": "Ich will dich fragen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000118
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000118,
					"content": "Was genau braucht ein Mensch, um „reif“ zu werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000119,
						210000122
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000119,
					"content": "Zeit, um zu wachsen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000120
					]
				},
				{
					"id": 210000120,
					"content": "Willst du damit sagen, dass die Menschen einfach dadurch, dass sie erwachsen werden, auf natürliche Weise reifer werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000121
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000121,
					"content": "Aber ist es nicht ein bisschen zu spät, reif zu werden, wenn man schon erwachsen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000124,
					"content": "Nun ... wenn du die Stadt verlassen willst, können wir mit dir ausgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000125,
					"content": "Das wäre zu viel Aufwand für euch, und ... wenn ich nur aus der Stadt rausfahre, glaube ich nicht, dass ich etwas Besonderes erleben würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000126
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000126,
					"content": "#{NICKNAME}, ich will dich nur um eine kleine Hilfe bitten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000127
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000127,
					"content": "Ich habe gehört, dass man sagt, wenn man Probleme hat, die man nicht lösen kann, kann man sie aufschreiben und in eine Flasche stecken und sie mit dem Fluss hinausschwimmen lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000128
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000128,
					"content": "Auf diese Weise kann das Problem vielleicht gelöst werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000129
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000129,
					"content": "Aber ich habe gehört, dass es da draußen eine Menge Monster gibt, und es ist ein bisschen unsicher, allein zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000130
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000130,
					"content": "Ich möchte dich bitten, mich zu beschützen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000131,
						210000132
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000131,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000133,
					"content": "Danke, ich werde Geld verdienen und dich bezahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000134
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000134,
					"content": "Dann wollen wir mal loslegen und mit einem Besuch des Bishui-Flusses beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000132,
					"content": "Ich werde das machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000122,
					"content": "Man muss besondere Sachen erleben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000123
					]
				},
				{
					"id": 210000123,
					"content": "Etwas Besonderes erleben ... aber bis jetzt habe ich nicht einmal einen Fuß außerhalb von Liyue gesetzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210000112,
					"content": "Ich habe gerade keine Zeit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000113
					]
				},
				{
					"id": 210000113,
					"content": "Hahahaha, das Spiel spiele ich auch mit Lulu und Fei, aber ich spiele es nicht, wenn sie nicht da sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000114
					],
					"speakerTitle": "Kleiner Meng"
				}
			]
		},
