			},
			"dialogs": [
				{
					"id": 150170401,
					"content": "Huch, dort oben ist ja ein Tepetlisaurier. Nicht sicher, ob er der Sauriergefährte von Tlazolli ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170402,
						150170403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170402,
					"content": "Zumindest scheint er nicht in Gefahr zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170404
					]
				},
				{
					"id": 150170404,
					"content": "Hm ... Paimon sieht aber nirgends Tlazolli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170405,
					"content": "#Heeeee! {NICKNAME}! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170406
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170406,
					"content": "Es ist Chevens Stimme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170407,
					"content": "Da ist jemand bei ihr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170408
					]
				},
				{
					"id": 150170408,
					"content": "Kommt runter, schnell! Tlazolli ist hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170409
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170409,
					"content": "Hä? Wir sind doch gerade erst hier hochgekommen, und Tlazolli ist schon wieder da? Was für ein Zufall ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170410,
						150170411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170410,
					"content": "Wie auch immer, gehen wir runter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170413
					]
				},
				{
					"id": 150170413,
					"content": "Hm? Warum kommt dieser Tepetlisaurier mit ... Wah, he, he, nicht rennen, du erwischst uns noch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170414,
					"content": "Ihr seid mit dem Tepetlisaurier den Berg „hinuntergestiegen“ ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150170415
					]
				},
				{
					"id": 150170415,
					"content": "Iengu, komm her ... Warst du schon wieder unartig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170416
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170416,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170417
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170417,
					"content": "Das ist ein guter Saurier. Du musst hungrig sein. Tut mir leid ... aber ich werde später etwas Leckeres für dich zaubern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170418
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170418,
					"content": "Na gut, dann geh mal spielen. Ich kümmer mich gleich um dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170419
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170419,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170420
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170420,
					"content": "Entschuldigt, ihr zwei. Ich habe zu Hause auf euch gewartet, als Nechca ... Na ja, sie hat sich rausgeschlichen und ist allein weggelaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170421
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170421,
					"content": "Sie meinte, sie wolle ein paar schöne Blumen für unsere Gäste holen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170422
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170422,
					"content": "Aber sie hat sich da verlaufen ... Zum Glück habe ich sie noch rechtzeitig gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170423
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170423,
					"content": "Geht es ihr gut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170424
					]
				},
				{
					"id": 150170424,
					"content": "Ja, Cheven erzählte uns, dass es ihr erst kürzlich besser ging ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170425,
					"content": "Sie ist immer noch sehr geschwächt. Sie hat einen Schreck erlitten und war kalten Winden ausgesetzt, deshalb hat sie im Moment leichtes Fieber. Ich hab ihr etwas Medizin gegeben und sie ist ins Bett gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170426
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170426,
					"content": "Aber, es ist nichts Ernstes. Eine gute Nachtruhe sollte helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170427
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170427,
					"content": "Allerdings fürchte ich, dass sie euch heute nicht treffen kann. Tut mir leid, dass ihr den ganzen Weg umsonst gekommen seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170428
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170428,
					"content": "Oh, keine Sorge! Wir wissen, dass ihre Genesung ziemlich schleppend ist. Cheven hat uns erzählt, dass ihre Krankheit sehr ernst war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170429,
					"content": "Ihre Gesundheit steht auf jeden Fall an erster Stelle! Wir wollten nur vorbeikommen und sehen, wie es ihr geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170430,
						150170433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170430,
					"content": "Hat sie sich also von ihrer Krankheit erholt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170431
					]
				},
				{
					"id": 150170431,
					"content": "... Nun ja, sie kann jetzt wenigstens mit mir sprechen und ganz normal ihren Tag bewältigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170432
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170432,
					"content": "Das ist schon mehr, als ich mir wünschen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170437,
					"content": "He, Kopf hoch! Das soll doch ein fröhlicher Anlass sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170438
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170438,
					"content": "Wir wissen es zu schätzen, dass die kleine Nechca versucht hat, uns mit Blumen zu begrüßen. Aber, Tlazolli, wegen dieser Sache, die ich dir vorhin erzählt habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170439,
						150170440
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170439,
					"content": "Oh ja, das Geschenk!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170441,
					"content": "Ja! Was für ein Geschenk hast du für uns vorbereitet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170442,
					"content": "Nun, es ist eine „Glutkristall-Inschrift“. Ich habe sie aus reinstem Erz hergestellt und sie ist fast völlig erosionsbeständig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170443
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170443,
					"content": "Die Technik, mit der sie hergestellt wird, hat ihre Wurzeln im Schmieden der alten Namen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170444
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170444,
					"content": "Es handelt sich also im Grunde genommen um die vereinfachte Version eines alten Namens?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170445
					]
				},
				{
					"id": 150170445,
					"content": "He, so sagt man das nicht, sonst könnte das den Zorn des Wayob auf mich ziehen. Ich habe nur einige wenige der gleichen Techniken angewandt, um Erz zu diesem Kristall zu verarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170446
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170446,
					"content": "Als ich den ersten anfertigte, hätte ich nicht gedacht, dass er irgendeinen praktischen Zweck erfüllen könnte, außer erosionsbeständig zu sein und hübsch auszusehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170447
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170447,
					"content": "Aber dann hat Cheven vorgeschlagen, diese Kristalle zu verwenden, um einzigartige „Ornamente“ herzustellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170448
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170448,
					"content": "„‚Glutkristall-Inschriften‘ von einem Schmied, der alte Namen herstellt, mit Worten versehen, die nie verblassen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170449
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170449,
					"content": "Ein gutes Verkaufsargument, denkt ihr nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170450
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170450,
					"content": "Waah, die Beschreibung lässt sie tatsächlich besonders erscheinen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170451,
						150170452
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170451,
					"content": "Du hast einen guten Sinn fürs Geschäft ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170453,
					"content": "Haha, Tlazollis Glutkristall-Inschriften sind aber auch wirklich etwas Besonderes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170454
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170454,
					"content": "Mundpropaganda ist nicht immer zuverlässig. Wenn Informationen weitergegeben werden, geht gern mal was verloren oder es wird was vergessen. Und manchmal werden sogar Unwahrheiten verbreitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170455
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170455,
					"content": "Aber sobald Worte einmal in diese Kristalle eingraviert wurden, werden sie die Jahrhunderte überdauern, deutlich wie eh und je und sie können nicht verdreht werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170456
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170456,
					"content": "Es ist ein ideales Geschenk für einen lieben Freund oder deine Liebe. Du kannst es sogar an die jüngere Generation weitergeben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170457,
						150170460
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170457,
					"content": "Du willst mich wohl dazu bringen, noch mehr zu kaufen, was?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170458
					]
				},
				{
					"id": 150170458,
					"content": "#Ja, Paimon hat schon nach ihren Mora gegriffen! He, {NICKNAME}, warum kaufen wir nicht eine und lassen unsere Namen eingravieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170459
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170459,
					"content": "#Wenn wir {M#deine Schwester}{F#deinen Bruder} gefunden haben, kann {M#sie}{F#er} auch {M#ihren}{F#seinen} Namen eingravieren lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170462,
					"content": "So können unsere Namen für immer nebeneinander stehen. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170463,
						150170495
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170463,
					"content": "Anscheinend ist Paimon bereits von der Idee angefixt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170464,
					"content": "Kommt schon, seid nicht so bescheiden. Immerhin habt ihr sowohl mich als auch Nechcas Geburtstagsgeschenk gerettet. Das ist ein kleiner Preis, den ich dafür bezahlen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170465
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170465,
					"content": "Cheven, habe ich nicht vorhin gesagt, dass ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170466
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170466,
					"content": "Stell dein Licht jetzt ja nicht unter den Scheffel, Tlazolli! Das ist doch ein tolles Geschenk! Ich weiß, wie viel Arbeit du in die Glutkristall-Inschriften reingesteckt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170467
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170467,
					"content": "Na dann ... Ich danke euch beiden. Ich werde sie so schnell wie möglich fertig haben. Dann werde ich euch persönlich eure Namen eingravieren lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170468
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170468,
					"content": "Nechca sollte bis dahin wieder wohlauf sein. Sie wird sich sicher freuen, euch zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170469,
						150170496
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170469,
					"content": "Geteilte Freude ist doppelte Freude ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170470,
					"content": "Waaah! Sei nicht voreilig. Wir wissen nicht einmal, wie teuer das sein könnte. Bist du sicher, dass wir genug in der Reisekasse haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170471
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170471,
					"content": "Moment mal ... das ist doch jetzt nicht irgend so ein Plan von dir, damit wir hier all unsere Mora auf den Kopf hauen, Cheven?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170472
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170472,
					"content": "Man weiß ja nie ... Ihr seht jedenfalls auch nicht so aus, als würdet ihr am Hungertuch nagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170473
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170473,
					"content": "#Nein! Hör nicht auf sie, {NICKNAME}! Du verlierst sonst deine ganzen Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170474
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170474,
					"content": "Haha! Auf jeden Fall ist es eure Entscheidung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170475
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170475,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170476
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170476,
					"content": "Oh nein! Es ist wieder der Tepetlisaurier! Schnell, halt ihn jemand auf. Paimon will nicht schon wieder über den Haufen gerannt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170477
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170477,
					"content": "Oha, sei brav!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170478
					]
				},
				{
					"id": 150170478,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170479
					],
					"speakerTitle": "Iengu"
				},
				{
					"id": 150170479,
					"content": "Ach ja, wenn es dir nichts ausmacht, Tlazolli, würde ich dich gern bitten, mir bei der Reparatur meiner Glutkristall-Inschrift zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170480
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170480,
					"content": "Ich habe sie fallen lassen, als ich angegriffen wurde. Das Band und der Verschluss sind dabei gerissen, deshalb trage ich sie seitdem nicht mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170481
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170481,
					"content": "Ich habe schon versucht, es selbst zu reparieren, aber es wollte einfach nicht halten. Kannst du mir dabei helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170482
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170482,
					"content": "Keine Sorge, überlass das einfach mir. Ich mache ihn wieder so gut wie neu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170483
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170483,
					"content": "... Und vielen Dank, Cheven, dass du den ganzen Weg auf dich genommen hast und ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170484
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170484,
					"content": "Keine Ursache. Wir alle wollen nur, dass es Nechca besser geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170485
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170485,
					"content": "... Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170486
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170486,
					"content": "Iengu! Sei brav! Du bekommst gleich dein Futter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170487
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170487,
					"content": "#Cheven wird dir Bescheid geben, sobald alles fertig ist, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170488
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170488,
					"content": "Vielleicht schaffen wir es ja sogar, es mit Nechcas Geburtstag zusammenzulegen. Wir können dann eine richtige Party feiern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170489
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170489,
					"content": "Das klingt gut! Wir freuen uns bereits auf jede Menge Leckereien! Wir werden sicher aufkreuzen und bereit zum Essen sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170490
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170490,
					"content": "Man sieht sich auf jeden Fall, Tlazolli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170491,
						150170492
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170491,
					"content": "Bis dann.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170493,
					"content": "Passt auf euch auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170494
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170494,
					"content": "Nechca ... wird sich bestimmt freuen, euch kennenzulernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170492,
					"content": "Ich hoffe, Nechca erholt sich schnell.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170493
					]
				},
				{
					"id": 150170496,
					"content": "Ich könnte ein paar mehr als Geschenke kaufen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170470
					]
				},
				{
					"id": 150170495,
					"content": "Das hört sich ein bisschen zu kostbar an ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170464
					]
				},
				{
					"id": 150170460,
					"content": "Du bist sehr überzeugend ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170461
					]
				},
				{
					"id": 150170461,
					"content": "#Ja, Lass uns einen kaufen und unsere Namen darauf eingravieren lassen. Wenn wir {M#deine Schwester}{F#deinen Bruder} gefunden haben, kann {M#sie}{F#er} auch {M#ihren}{F#seinen} Namen eingravieren lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170462
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170452,
					"content": "Kein Wunder, dass du deinen eigenen Laden hast ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170453
					]
				},
				{
					"id": 150170440,
					"content": "Ja, ich bin gespannt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170441
					]
				},
				{
					"id": 150170433,
					"content": "Wenn man bedenkt, dass sie rauslaufen konnte, scheint es ihr ja ganz gutzugehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170434
					]
				},
				{
					"id": 150170434,
					"content": "Ja, und wenn ich sie dazu bringen wollte, ihr Gemüse zu essen, rannte sie dann besonders schnell. So viel ist sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170435
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170435,
					"content": "Über Stühlen und unter Tischen ... Und auch durchs ganze Haus. Ich kriege sie kaum zu fassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170436
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170436,
					"content": "So, wie es ihr jetzt geht ... Das ist schon gut genug. Mehr könnte ich mir wirklich nicht wünschen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170437
					],
					"speakerTitle": "Tlazolli"
				},
				{
					"id": 150170411,
					"content": "Ja, was für ein Zufall ...",
