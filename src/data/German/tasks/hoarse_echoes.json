						],
						"pointId": 350400107
					}
				]
			},
			"dialogs": [
				{
					"id": 150170201,
					"content": "Da wären wir. Ziemlich beeindruckendes Haus, nicht wahr? Einen Moment, ich werde anklopfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170202
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170202,
					"content": "Tlazolli, öffne die Tür! Sie sind da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170203
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170203,
					"content": "... Tlazolli? Bist du zu Hause? Mach auf, bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170204
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170204,
					"content": "Komisch ... Hm. Die Tür ist abgeschlossen und verriegelt, aber sie sollte um diese Zeit nicht unterwegs sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170205
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170205,
					"content": "He, Nechca? Nechca? Ich bin’s, Cheven. Mach auf, bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170206,
						150170207
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170206,
					"content": "(Keine Antwort ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170210
					]
				},
				{
					"id": 150170210,
					"content": "Aber, ich habe Tlazolli doch gesagt, dass wir kommen ... Vielleicht musste sie Nechca dringend rausbringen, um Medizin zu besorgen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170211
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170211,
					"content": "He? Was ist das da drüben? Sieht aus wie das Nest eines kleinen Tepetlisauriers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170212,
					"content": "Das stimmt. Tlazolli hat einen Tepetlisaurier als Gefährte. Wenn ich mich recht erinnere, war sein Name ... Iengu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170213
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170213,
					"content": "Als sie noch als Schmiedin tätig war, ließ sie sich oft von Iengu bei den Ausgrabungsarbeiten helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170214
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170214,
					"content": "Aber seit Nechca erkrankte, hat sie ihn in letzter Zeit nicht mehr viel graben lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170215
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170215,
					"content": "Warte mal. Was zum...? Hier herrscht ja das reinste Chaos! Iengu ist auch nirgends zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170216
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170216,
					"content": "Wah, sieh dir nur mal all diese zerbrochenen Kisten an! Da könnte etwas Schreckliches passiert sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170217,
						150170218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170217,
					"content": "Schauen wir uns das einmal näher an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150170218,
					"content": "Du bleibst hier, Cheven.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170219
					]
				},
				{
					"id": 150170219,
					"content": "Oh ... Na gut! Ich werde mich einfach ... erst einmal verstecken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170220
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170220,
					"content": "Wie kommt es ... jedes Mal, wenn Imix mir sagt, dass ich mich nicht an irgendeinen gefährlichen Ort begeben soll, gerate ich in Schwierigkeiten? Anscheinend haben ihre Worte eine Art Macht über mich ... Vielleicht ist es das Werk von Wayob ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170207,
					"content": "Soll ich die Tür aufbrechen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170208
					]
				},
				{
					"id": 150170208,
					"content": "Ob etwas mit den beiden passiert ist? Was, wenn Nechcas Zustand schlimmer würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170209,
					"content": "Denken wir nicht zu viel darüber nach. Ihnen ging es noch gut, als ich das letzte Mal hier war. Nechca schlief sogar tief und fest in ihrem Zimmer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170210
					],
					"speakerTitle": "Cheven"
				}
			]
		},
