				]
			},
			"dialogs": [
				{
					"id": 150170101,
					"content": "Oh, ihr seid früh dran! Ihr freut euch wohl schon auf euer Geschenk, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170102,
						150170105
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170102,
					"content": "Wir wollten doch Tlazolli und Nechca besuchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170103
					]
				},
				{
					"id": 150170103,
					"content": "Stimmt ja! Nechca war so krank, und Tlazolli musste ihre Arbeit aufgeben, die sie so liebt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170104,
					"content": "Dinge mögen zwar besser werden, aber sie könnten wahrscheinlich immer noch etwas Aufmunterung gebrauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170109,
					"content": "Haha, ich habe schon jemanden gebeten, bei Tlazolli vorbeizuschauen und ihr zu sagen, dass wir kommen. Sie hat wahrscheinlich schon alles Notwendige vorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170110
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170110,
					"content": "Dann los. Kannst du auf den Laden aufpassen, Imix? Ich bin sofort wieder da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170105,
					"content": "Ja, ich frage mich, was das Geschenk sein könnte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170106
					]
				},
				{
					"id": 150170106,
					"content": "Paimon auch ... Aber wir sind auch hier, um zu sehen, wie es um Nechca steht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170107,
					"content": "Es kann nicht einfach sein, sich von einer so schweren Krankheit zu erholen. Und dann ist da ja noch Tlazolli ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170108,
					"content": "Sie musste aufgeben, was sie liebt ... Wir müssen sie aufmuntern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1501702,
