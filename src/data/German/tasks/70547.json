			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Valerina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705470101,
					"content": "#Ah! {F#Die berühmte Katzenretterin}{M#Der berühmte Katzenretter} und die berühmte Katzenflüsterin! Ihr seid tatsächlich gekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470102
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470102,
					"content": "Hmm? Wie hast du uns gerade genannt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470103,
						705470104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470103,
					"content": "Das kommt mir irgendwie bekannt vor ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				},
				{
					"id": 705470105,
					"content": "Hm ... Paimon hat das Gefühl, dass wir uns schon einmal begegnet wären, kann das sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470106,
					"content": "Haha! Du erinnerst dich an mich, Katzenflüsterin! Das ist ein großer Erfolg für mich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470107
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470107,
					"content": "Wir können später über die Vergangenheit plaudern. Wie wäre es, wenn wir zuerst das neue Spiel ausprobieren, das ich gesponsert habe? Es hat mich eine ganze Woche lang zum Grinsen gebracht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470108
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470108,
					"content": "Dodocos bombastische Explo-Vaganza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470109
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470109,
					"content": "Boah ... So viele verschiedene Dodocos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470110,
						705470111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470110,
					"content": "Und jedes davon kommt mir irgendwie bekannt vor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470112,
					"content": "#Schau mal, Katzenretter{F#in} ... Ähm, ich meine, strahlende{M#r}, verehrte{M#r} Ehrenritter{F#in}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470113
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470113,
					"content": "Diese Dodoco-Puppe wurde nach deinem Vorbild angefertigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470114
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470114,
					"content": "#W... Wirklich! Die Farben und Muster sind ganz im Stil von {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470115,
					"content": "Im Spiel müssen Funken-Dodoco, Glitzer-Dodoco, Rittmeister-Dodoco und Magie-Dodoco zusammenarbeiten, um mit Bomben noch nie zuvor gesehene Gegner zu besiegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470116
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470116,
					"content": "Ich bin nur für das Sponsoring und den Betrieb des Spiels verantwortlich. Die Entwicklungsdetails kenne ich nicht und ich weiß auch nicht, wie die Vorbilder dieser Gegner in Wirklichkeit aussehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470117
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470117,
					"content": "Aber ich bin mir sicher, dass die unvergleichlich wundervollen Dodocos sie besiegen werden, sollten sie eines Tages tatsächlich aufeinander treffen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470118
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470118,
					"content": "Natürlich! Kein Monster kann Klee und zusammen mit ihrem Dodoco als tollen Gefährten aufhalten, wir sind auch dieser Ansicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470119,
						705470120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470119,
					"content": "Dann zeig es mir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470121,
					"content": "Hehe, ich bin sicher, ihr werdet auch viel Spaß daran haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470120,
					"content": "Ein neues Dodoco-Spiel!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470111,
					"content": "Man kann deutlich erkennen, wem sie nachempfunden wurden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470104,
					"content": "Den Spitznamen kenne ich doch nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				}
			]
		}
	]
}