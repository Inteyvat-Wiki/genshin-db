			"dialogs": [
				{
					"id": 711101101,
					"content": "Kleine, gehört der Pelikan zu dir? Könnten wir zusammen ein Foto mit ihm im Dorf Qiaoying machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101102,
					"content": "Rärä! ... Ga-ga-ga ... Korr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101103
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101103,
					"content": "Hä? Was sagst du da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101104,
					"content": "Das ist Pelikansprache und bedeutet „Ja, super!“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101105
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101105,
					"content": "Du sprichst die Sprache der Pelikane?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101106
					]
				},
				{
					"id": 711101106,
					"content": "Nur ein klein wenig ... Ich beobachtete nämlich, dass sie beim Essen immer „Rärä! ... Ga-ga-ga ... Korr!“ sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101107
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101107,
					"content": "Wenn sie sich freuen, sagen sie bestimmt etwas wie „Ja, super!“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101108
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101108,
					"content": "Deswegen habe ich diesen Ruf einfach gelernt. Wenn sie es hören, werden sie zutraulich, denn sie glauben, es gäbe etwas zu futtern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101109
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101109,
					"content": "Wenn ihr beim Fotografieren seid, könnt ihr auch einmal versuchen, es zu rufen! Ich muss jetzt auch nach Hause, leider ... Sonst könnte ich euch noch mehr beibringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101110
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101110,
					"content": "Kein Problem, Kleine. Wir werden es einfach selbst ausprobieren. Vielen Dank! Pass gut auf dich auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101111,
					"content": "#{NICKNAME}, los, wir gehen da rüber und versuchen es! Wenn wir wirklich Pelikane anlocken, können wir viel bessere Schnappschüsse knipsen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
