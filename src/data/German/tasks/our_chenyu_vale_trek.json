				{
					"id": 711100301,
					"content": "#{M#Junger Freund}{F#Junge Freundin}, du bist schon viel in der Welt herumgekommen und hast bestimmt nicht wenige Wunder erlebt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100302
					],
					"speakerTitle": "Zhuchun"
				},
				{
					"id": 711100302,
					"content": "Ich frage mich, ob die Orte vom Chenyu-Tal in dem Wettbewerb für Landschaftsfotografien noch einen Tick besser sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhuchun"
