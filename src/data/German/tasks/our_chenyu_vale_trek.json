				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fangju"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711100701,
					"content": "Deinem entspannten Gesichtsausdruck nach zu urteilen, bist du bestimmt hier, um Meisterwerke für unseren Wettbewerb einzureichen, oder? Du kannst sie einfach bei mir abgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100702
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100702,
					"content": "Ah, wirklich prima. Um solche besonderen Momente auf ein Foto zu bannen, hast du bestimmt lange ausharren müssen. Gut gemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fangju"
				}
			]
		},
