			"dialogs": [
				{
					"id": 711101501,
					"content": "Oh! Warum ist denn dieser Idiot aus Inazuma auch da? Ich muss so tun, als hätte ich ihn nicht gesehen ... Zum Glück steht jemand aus Liyue dazwischen. Er hat mich anscheinend nicht gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101502
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711101502,
					"content": "Verdammt, diese Landschaftsaufnahmen sind so atemberaubend schön. Ich möchte einfach hier stehen bleiben und sie betrachten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mali"
