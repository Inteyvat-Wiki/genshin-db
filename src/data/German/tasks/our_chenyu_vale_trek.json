			"dialogs": [
				{
					"id": 711101701,
					"content": "Da ist er! Dieser Halsabschneider aus Fontaine! Meine Glückssträhne scheint wirklich begonnen zu haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101702
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101702,
					"content": "Ich sollte eigentlich sofort hingehen und ihn schnappen, aber dann kann ich diese bezaubernden Bilder aus dem Chenyu-Tal nicht mehr genießen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101703
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101703,
					"content": "Nein, das wäre zu schade. Ich werde lieber erst die Bilder betrachten, insbesondere meine ausgewählten Werke ...",
