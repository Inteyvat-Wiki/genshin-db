				]
			},
			"dialogs": [
				{
					"id": 711100801,
					"content": "Oh ... Diese Bilder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100802
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100802,
					"content": "Was ist denn? Sind die Bilder nicht ausreichend gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100803,
					"content": "Hahaha, im Gegenteil ... Mir sind in letzter Zeit viele gute Bilder untergekommen, aber Bilder wie eure habe ich noch nie gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100805
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100805,
					"content": "Zum Beispiel dieses Bild aus Qiaoying. Die Pelikane geben dem friedlichen Dorf einen Hauch von Lebendigkeit und schaffen dadurch einen Kontrast zur Stille. Was für eine einzigartige Kompositionsidee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100806
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100806,
					"content": "Wenn ich das so sehe, wird auf jeden Fall ein Foto von euch beiden ausgewählt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100807
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100807,
					"content": "Waah! Das ist ja ein dickes Lob. Paimon wird gleich ein bisschen verlegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100808,
						711100810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100808,
					"content": "Das Foto wurde nicht von dir aufgenommen, warum wirst du denn verlegen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100809
					]
				},
				{
					"id": 711100809,
					"content": "Paimon fühlt sich in deinem Namen verlegen! ... Weil du so bescheiden bist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100811,
					"content": "Zurück zum Thema. Unsere Juryarbeit wird morgen früh abgeschlossen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100812
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100812,
					"content": "Von morgen früh um acht Uhr bis abends um sechs Uhr werden wir die ausgewählten Bilder öffentlich ausstellen, auf der Straße vor dem Hezhe-Posten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100813
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100813,
					"content": "Ich danke euch beiden für die Unterstützung beim diesmaligen Wettbewerb für Landschaftsfotografie „Reise durch Chenyu“. Vergesst nicht, morgen unbedingt vorbeizuschauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100814
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100814,
					"content": "Klar! Die Überraschung am Schluss lassen wir uns nicht entgehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100810,
					"content": "So gesehen, werde ich auch ein wenig verlegen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100811
					]
				}
			]
		},
