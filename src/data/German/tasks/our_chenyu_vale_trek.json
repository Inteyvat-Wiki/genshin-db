			"dialogs": [
				{
					"id": 711100101,
					"content": "Seid ihr beide auch hier, um an dem Wettbewerb für Landschaftsfotografie „Reise durch Chenyu“ teilzunehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100102
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100102,
					"content": "Wettbewerb für Landschaftsfotografie? Was ist das denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100103,
					"content": "Wie schon der Name sagt, ist es ein Fotografiewettbewerb, der die wunderschönen Landschaften des Chenyu-Tals würdigen möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100104
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100104,
					"content": "Wir haben einen Fragebogen verschickt, um von den Einwohnern zu erfahren, welche die zauberhaftesten Aussichtspunkte des Chenyu-Tals sind. Die Teilnehmer wurden gebeten, die ausgewählten Orte aufzusuchen und zu fotografieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100105
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100105,
					"content": "Am Ende werden wir eine Auswahl der besten Bilder küren und sie für die Werbung verwenden. Sie werden auf der Straße vor dem Hezhe-Posten öffentlich ausgestellt. Habt ihr Interesse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100106,
						711100108
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100106,
					"content": "Ich bin sehr pragmatisch, gibt es einen Preis zu gewinnen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100107
					]
				},
				{
					"id": 711100107,
					"content": "Falls dein eingereichtes Werk in die Auswahl kommt, erhältst du selbstverständlich eine Überraschung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100110,
					"content": "Waah! Eine Überraschung! Wir müssen uns unbedingt reinhängen und die Überraschung abstauben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100111,
					"content": "Hehe, auch wenn ihr es nicht in die Endauswahl schafft, werden wir für eure Zeit und die Mühe eine kleine Entschädigung vorbereiten. Wir hoffen, sie wird euch gefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100112
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100112,
					"content": "Und wo sollen wir beginnen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100113
					]
				},
				{
					"id": 711100113,
					"content": "Bitte seht euch diesen Ratgeber an. Darin findet ihr die von den Einwohnern des Chenyu-Tals empfohlenen Aussichtspunkte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100115
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100115,
					"content": "Hä? Warum gibt es da Orte, die gestrichen wurden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100116,
					"content": "Hehe, weil sich für diese Orte schon genügend Leute angemeldet haben. Wir würden das Chenyu-Tal gern umfassender präsentieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100117
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100117,
					"content": "Für die übrigen vier Orte kann man sich noch anmelden. Ihr könnt einen oder mehrere davon auswählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100118
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100118,
					"content": "#Aha! ... {NICKNAME}, melden wir uns am besten für alle vier Orte an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100119,
					"content": "Wenn wir ein Foto machen, ist die Wahrscheinlichkeit, zu gewinnen, ein Viertel. Also machen wir vier Fotos, dann sind es vier Viertel! Das bedeutet, wir gewinnen auf jeden Fall den Überraschungspreis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100120,
						711100123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100120,
					"content": "So kann man das nicht rechnen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100121
					]
				},
				{
					"id": 711100121,
					"content": "Nein? Aber vier mal ein Viertel macht vier Viertel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100122,
					"content": "Das mag ja sein, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100124,
					"content": "Hehe, was willst du da noch sagen!? Lass uns jetzt gleich aufbrechen! Für die Überraschung am Schluss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100123,
					"content": "Die Rechnung stimmt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100108,
					"content": "Sehr gut, niemand kann bessere Fotos machen als ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100109
					]
				},
				{
					"id": 711100109,
					"content": "Dir scheint es nicht an Arbeitseifer zu mangeln. Ach ja, und wenn dein eingereichtes Werk in die Auswahl kommt, haben wir auch eine Überraschung für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "Fangju"
				}
			]
		},
