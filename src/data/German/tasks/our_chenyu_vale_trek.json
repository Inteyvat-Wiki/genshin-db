			},
			"dialogs": [
				{
					"id": 711101301,
					"content": "Wartet! Nicht hierherkommen! Ihr ... Ihr seid gute Leute, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101302
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101302,
					"content": "He, Moment, gerade haben wir dich gerettet! Hast du dir irgendwo den Kopf gestoßen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101303,
					"content": "Ah! Du hast recht ... Tut mir echt leid. Ich hatte auf meiner Reise nach Chenyu diesmal wirklich Pech und davon ist mir immer noch ganz schwindelig. Ich danke euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101304
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101304,
					"content": "Nimmst du auch an dem Fotowettbewerb teil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101305
					]
				},
				{
					"id": 711101305,
					"content": "Ihr etwa auch!? So ein Zufall, aber eigentlich bin ich bloß ein einfacher Besucher ... Gegen diese Hilichurle habe ich einfach keine Chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101306
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101306,
					"content": "Echt widerlich, sie haben mich einfach angerempelt und mich ohne Erklärung den ganzen Weg hierhergeschleppt. Verlangen die Hilichurle jetzt etwa auch schon Mautgebühr? Das geht wirklich gar nicht! ... Ein Glück, dass ich euch getroffen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101307
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101307,
					"content": "Dann war heute echt nicht dein Tag, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101308,
					"content": "Nicht nur heute! Gestern hatte ich auch übelst Pech. Ich kaufte bei einem Händler aus Fontaine einen super teuren Fotoapparat. Dann schoss ich ein paar Bilder und schon war das Teil kaputt. Ich ging also zurück zum Verkäufer, aber weit und breit keine Spur von ihm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101309
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101309,
					"content": "Ein wahrhaft skrupelloser Händler ... Ihr solltet gut auf eure Mora achtgeben, wenn ihr draußen unterwegs seid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101310
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101310,
					"content": "Stimmt, wir sind abgeschweift. Wenn ihr auch an der „Reise durch Chenyu“ teilnehmt, seid ihr bestimmt hier, um Fotos vom Berg Xuanlian zu machen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101311
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101311,
					"content": "Um euch meinen Dank zu zeigen, werde ich euch den bestgelegenen Aussichtspunkt zum Fotografieren, den ich gefunden habe, auf eurer Karte einzeichnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101312
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101312,
					"content": "Schaut, von hier könnt ihr ihn sehen, genau da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101313
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101313,
					"content": "Ah? Aber was ist denn mit dir? Bist du nicht auch hier, um am Wettbewerb teilzunehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101314,
					"content": "Ich finde es hier zu gefährlich und möchte woanders hingehen. Im Ratgeber wurden noch andere Orte empfohlen ... Ich möchte mir gern den „Tee trinkenden Adepten“ ansehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101315
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101315,
					"content": "Gut! Ich mach mich auf den Weg. Schön, euch getroffen zu haben. Ich hoffe, dass ich von jetzt an mehr Glück haben werde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akai"
				}
			]
		},
