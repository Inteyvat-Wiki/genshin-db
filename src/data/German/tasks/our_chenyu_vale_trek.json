			"dialogs": [
				{
					"id": 711101001,
					"content": "Seid gegrüßt, ihr beiden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101002
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101002,
					"content": "Habt ihr die ausgestellten Fotos gesehen? Insgesamt wurden dieses Mal acht Fotos für den Wettbewerb „Reise durch Chenyu“ ausgewählt, und ihr habt die Hälfte davon gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101003
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101003,
					"content": "Glückwunsch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101004
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101004,
					"content": "Waah! Das ist ja großartig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101005,
					"content": "#{NICKNAME}! Paimon hat es doch gewusst! Am Ende werden es vier Viertel! Mit Zahlen ist Paimon richtig Spitze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101006,
						711101007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101006,
					"content": "Es sind doch eindeutig vier Achtel!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				},
				{
					"id": 711101008,
					"content": "Hehe, ganz wie ich es mir gestern schon dachte. Der Jury haben auch eure anderen beiden Werke ausgesprochen gut gefallen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101009
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101009,
					"content": "Hier überreiche ich euch dieses limitierte „Reise durch Chenyu“-Erinnerungsalbum. Darin sind alle Fotos enthalten, die dieses Mal ausgewählt wurden. Das habt ihr euch verdient.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101010
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101010,
					"content": "Das ist also die Überraschung? Das sieht wirklich hübsch aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101011,
					"content": "Erlaubt, dass ich euch noch ein paar Mora gebe, hier! Nochmals vielen Dank für eure Unterstützung, diesmal von mir persönlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101012
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101012,
					"content": "Es ist nämlich so, dass dies meine Heimat ist. Und ihr habt ihre Schönheit für alle Zeiten in Bildern festgehalten, die bestimmt sehr vielen Leuten diese Schönheit näherbringen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101013
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101013,
					"content": "Ich danke euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101007,
					"content": "Juhuu! Mathe ist Paimons Zauberfach! Abgeräumt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				}
			]
		},
