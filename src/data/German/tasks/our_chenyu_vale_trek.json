			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711100201,
					"content": "#Hallo, {M#lieber Freund}{F#liebe Freundin}. Bist du auch hier, um an dem Wettbewerb für Landschaftsfotografie teilzunehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100202
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100202,
					"content": "Als Fotograf, der aus dem Ursprungsland des Fotoapparats, Fontaine, stammt, möchte ich euch an etwas erinnern: Das Wichtigste an der Fotografie ist die Kamera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100203
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100203,
					"content": "Deshalb will ich euch jemanden vorstellen. In meiner Heimat sind seine Fotoapparate bei jedermann beliebt. Auch der Preis lohnt sich und ich habe eine gute Bezugsquelle, um an welche ranzukommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100204
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100204,
					"content": "He! Jetzt tut nicht so, als wärt ihr nicht interessiert. Ich kann für euch einen zusätzlichen Rabatt rausholen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100205
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100205,
					"content": "He! ... Lauft nicht weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mali"
				}
			]
		},
