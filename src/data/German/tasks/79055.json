			"dialogs": [
				{
					"id": 790550101,
					"content": "Diese verlassene Szene war ursprünglich für das Stück „Das Schiff am Fluss“ geplant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550102
					],
					"speakerTitle": "Notizen zur Szene"
				},
				{
					"id": 790550102,
					"content": "Ursprünglich drehte sich die Geschichte darum, wie zwei Wassergeister auf einem schwimmenden Schiffswrack in den Fluss der Liebe stürzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550103
					],
					"speakerTitle": "Notizen zur Szene"
				},
				{
					"id": 790550103,
					"content": "Nachdem sie sich gegenseitig ihre Gefühle gestanden haben, stehen sie am Bug des Schiffes und werden vom Abendrot beleuchtet. Diese Szene ist äußerst romantisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550104
					],
					"speakerTitle": "Notizen zur Szene"
				},
				{
					"id": 790550104,
					"content": "Die Szene wurde letzten Endes aber verworfen. Der Grund dafür war, dass die beiden Wassergeister, die die Rolle spielen sollten, einfach zu quirlig waren und nicht aufhören konnten, sich zu bewegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550105
					],
					"speakerTitle": "Notizen zur Szene"
				},
				{
					"id": 790550105,
					"content": "*seufz* Wenn ich doch nur <color=#00E1FFFF>zwei Wassergeister zur selben Zeit am Bug des Schiffes</color> haben könnte, dann wäre die Szene perfekt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550106
					],
					"speakerTitle": "Notizen zur Szene"
				},
				{
					"id": 790550106,
					"content": "... Der „Regisseur“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Notizen zur Szene"
				}
			]
		},
