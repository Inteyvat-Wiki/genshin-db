			"dialogs": [
				{
					"id": 250350801,
					"content": "Zwei ... drei ... und das sind alle! Gut gemacht, du hast alle fehlenden Pakete wiedergefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350802
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350802,
					"content": "... Moment mal, sollte dieses Paket nicht von Tundama geliefert werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350803
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350803,
					"content": "Hier ist deine Zahlung. Danke für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350804
					],
					"speakerTitle": "Michica"
				},
