				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250350101,
					"content": "Diese Dummköpfe ... Wie haben sie denn eine weitere Ladung Pakete verloren?! Ich habe ihnen doch gesagt, sie sollen nicht so viel Quatsch machen, wenn sie Pakete ausliefern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350102
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350102,
					"content": "Du hast ein Problem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350103
					]
				},
				{
					"id": 250350103,
					"content": "Ja, ein paar unserer Boten haben wieder einmal die Anweisungen ignoriert und eine ganze Ladung von Paketen verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350104
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350104,
					"content": "*seufz* Ist ihnen nicht klar, dass solche Nachlässigkeiten dem Ruf der gesamten Nachkommen der Baumkrone schaden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350105
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350105,
					"content": "Wenn du deine Arbeit machst, dann mach sie richtig! Wenn du einen Abhang hinuntergehst, gehst du einfach weiter wie sonst auch. Warum musst du plötzlich runterrutschen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350106
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350106,
					"content": "Ich habe es ihnen schon so oft gesagt, aber diese Jugendlichen wollen einfach nicht zuhören. Alles, was sie interessiert, ist die Jagd nach dem Nervenkitzel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350107
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350107,
					"content": "*seufz* Jetzt muss ich jemanden finden, der die Pakete abholt. Lass mich überlegen, wer gerade frei ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350108,
						250350111
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350108,
					"content": "Ich kann helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350109
					]
				},
				{
					"id": 250350109,
					"content": "Du ... bist bereit zu helfen? Das ist großartig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350110
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350110,
					"content": "Ich glaube nicht, dass ich im Moment jemanden finden kann, der die Pakete suchen würde ... und wenn ich mich selbst auf die Suche machen würde, gäbe es niemanden, der das Boten-Langhaus bewacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350117,
					"content": "Und keine Sorge, ich würde dich nicht eine Nadel im Heuhaufen suchen lassen. Ich kenne die Routen, die diese Kinder normalerweise nehmen, also kann ich ungefähr erraten, wo die Pakete verschwunden sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350118
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350118,
					"content": "Ich markiere die vermutlichen Standorte der fehlenden Pakete auf deiner Karte ... Bitte! Ich zähle auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350111,
					"content": "Sind diese Pakete sehr groß?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350112
					]
				},
				{
					"id": 250350112,
					"content": "Nein. Aber gerade weil sie nicht groß sind, sind sie immer sehr schwer zu finden. *seufz* Diese unvorsichtigen Kinder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350113
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350113,
					"content": "... Also, falls du gerade die Zeit hast, könntest du mir helfen, diese Pakete zu finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350114
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350114,
					"content": "Das Boten-Langhaus ist im Moment etwas unterbesetzt. Wenn ich sie selbst suchen würde, wäre niemand da, der sich um den Laden kümmert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350115
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350115,
					"content": "Kein Problem, das mache ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350116
					]
				},
				{
					"id": 250350116,
					"content": "Das wäre wunderbar! Vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Michica"
				}
			]
		},
