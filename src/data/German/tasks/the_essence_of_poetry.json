	"talks": [
		{
			"id": 2250101,
			"completionStepIds": [
				2250101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
