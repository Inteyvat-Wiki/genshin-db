			"dialogs": [
				{
					"id": 225010301,
					"content": "Es gibt einen besseren Weg, diese gefallenen Sterne zu betrachten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010302
					]
				},
				{
					"id": 225010302,
					"content": "Einen besseren Weg? Hmm, das könnte sein. Blickte ich bloß in die Flamme des gefallenen Sterns, doch achtete ich dabei nicht die Umgebung, würde ich da nicht zu viel verschmälern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
