			"dialogs": [
				{
					"id": 225010401,
					"content": "Hier kannst du dichten, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010402
					]
				},
				{
					"id": 225010402,
					"content": "Das reicht nicht. Bliebe ich mein ganzes Leben in sicherer Abgeschiedenheit, wovon zeugten dann meine Gedichte, wenn nicht von Ächzen der Gesunden oder närrischem Gesäusel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
