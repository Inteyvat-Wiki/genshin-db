						"stepId": 2250101,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2250102",
							"2"
						],
						"stepId": 2250102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010201,
					"content": "Was meinst du mit „unangebracht“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010202
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010202,
					"content": "Wer diese gefallenen Sterne berührt, sinkt in tiefen Schlaf ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010203
					]
				},
				{
					"id": 225010203,
					"content": "Ah, diese Kunde vernahm ich bereits. Doch wenn ich mich nur nähere, wird mir nichts Missliches geschehen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010204
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010204,
					"content": "Versprichst du, sie nicht zu berühren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010205
					]
				},
				{
					"id": 225010205,
					"content": "N... Nun gut, ich werde mich in Zurückhaltung üben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250103,
