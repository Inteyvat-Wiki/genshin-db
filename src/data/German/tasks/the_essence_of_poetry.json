			},
			"dialogs": [
				{
					"id": 225011201,
					"content": "Ich habe viel über deine Worte nachgesinnt und deine Sorgen sind berechtigt. Ich werde mich nicht dem ungebührlichen Risiko der gefallenen Sterne aussetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011202
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011202,
					"content": "Schön zu hören ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011203
					]
				},
				{
					"id": 225011203,
					"content": "Ein einzelner Federstreich erzeugt kein erlesenes Gedicht. Es sind die vielen Einzelheiten, die für ein feines Werk sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011204
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011204,
					"content": "Eine Blume oder ein anderes kleines Gut mag Gegenstand eines Verses sein. Doch die Zahl der Gedichte, die Blumen besingen, ist bereis Legion ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011205
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011205,
					"content": "#Hmm ... der Blick eines Fremden ist unverstellt, nicht wahr? Nun denn, {F#Reisende}{M#Reisender}, was für eine Blume sollte ich in meinem Gedicht besingen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
