			"dialogs": [
				{
					"id": 225011301,
					"content": "Ich habe viel über deine Worte nachgesinnt, doch die gefallenen Sterne sind zu selten, um übersehen zu werden. Ich werde gleichwohl aufbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011302
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011302,
					"content": "Du ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011303
					]
				},
				{
					"id": 225011303,
					"content": "Doch würde ich mich den gefallenen Sternen bloß nähern, so fürchte ich, dass ich in meiner Betrachtung ihre Umgebung vernachlässigen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011304
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011304,
					"content": "Der schlimmste Albtraum eines Dichters ist ein eingeschränkter Blick. Würde ich diese gefallenen Sterne aus nächster Nähe betrachten, würde meine Feder still bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011305,
					"content": "Darum werde ich sie zuerst aus der Ferne betrachten, bevor ich mich ihnen nähere ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011306
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011306,
					"content": "Und dann ... Hmm, warte. Es sind so viele Monster unterwegs und niemand begleitet mich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011307
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011307,
					"content": "#{F#Reisende}{M#Reisender}, wärest du womöglich so gütig, die Monster zu beseitigen, die uns den Weg verstellen könnten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011308,
						225011310
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011308,
					"content": "Werde ich machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011309
					]
				},
				{
					"id": 225011309,
					"content": "Wundervoll! Höchst vortrefflich! So verlasse ich mich also auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011310,
					"content": "Versprich mir bloß, diese gefallenen Sterne nicht zu berühren ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011311
					]
				},
				{
					"id": 225011311,
					"content": "A... Also gut, versprochen. Ach, komm! Warum sollte ich mich in Gefahr begeben, wenn ich doch weiß, dass eine Berührung mich in tiefen Schlummer sinken ließe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011312
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011312,
					"content": "Doch die Frage drängt sich auf, welch Träume solche in Schlummer Versetzte wohl ereilen mögen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011313,
					"content": "*hust* W... War nur ein Scherz! Bitte räume diese Monster für mich aus dem Weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
