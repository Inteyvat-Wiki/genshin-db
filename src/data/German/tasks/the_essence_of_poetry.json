				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010101,
					"content": "Hmm ... Nein, dieser Vers genügt nicht. Ganz und gar nicht. *seufz* Ich muss wohl wirklich selbst hingehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010102
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010103
					]
				},
				{
					"id": 225010103,
					"content": "Wie ergeht es dir heute? Ich bin Qingzhou und bin so kühn, mich als Poet zu bezeichnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010104
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010104,
					"content": "Durch ein seltsames Glück sucht mich jüngst die Muse der Poesie heim, doch dann hat sie mich wieder verlassen, und jetzt suche ich nach der Inspiration ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010105
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010105,
					"content": "Neuerdings bieten die Himmel ein merkwürdiges Schauspiel, Sterne fallen flammend herab auf die Erde. Ein wahrlich seltener Anblick für die Sterblichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010106
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010106,
					"content": "Da fiel mir ein, dass einer dieser gefallenen Stern mir Inspiration einflößen könnte, wenn ich ihn aus der Nähe betrachten könnte. So könnte sich mir der nächste Vers meines Gedichts offenbaren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010107
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010107,
					"content": "D... Das wäre unangebracht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010108
					]
				},
				{
					"id": 225010108,
					"content": "Unangebracht? Was möchtest du damit sagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 2250102,
			"completionStepIds": [
				2250102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
