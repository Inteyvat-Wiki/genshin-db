					}
				]
			},
			"dialogs": [
				{
					"id": 760540101,
					"content": "Huch, wo ist denn Columbina hin? Paimon kann sie nirgendwo sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540102,
					"content": "Hier drüben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540103
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540103,
					"content": "Wahh! Was machst du denn da oben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540104,
					"content": "Kommt rauf zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540105
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540105,
					"content": "Worin verwickeln wir uns denn jetzt schon wieder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540106,
					"content": "Erinnert ihr euch noch an die Steine, die wir beim letzten Mal gesammelt haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540107
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540107,
					"content": "Beim letzten Mal? Oh, du meinst das Erz, das zu leuchten anfängt, nachdem es Kuuvahki aufgesaugt hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540108,
					"content": "Korrekt. Nun, danach haben die Kuuhenki noch etwas mehr gesammelt, und ich habe sie in zwei Arten sortiert – dunklere und hellere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540109
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540109,
					"content": "Dunklere und hellere? Aber ... warum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540110,
					"content": "Um Mondschach zu spielen, natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540111
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540111,
					"content": "Ähm ... Was ist denn „Mondschach“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540112,
					"content": "Oh, habt ihr es noch nie gespielt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540113
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540113,
					"content": "... Nö.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540114
					]
				},
				{
					"id": 760540114,
					"content": "Aha ... Seit ich die Quadrate gesehen habe, die die Kinder der Nachkommen des Frostmonds auf den Boden zeichnen, wollte ich es immer einmal ausprobieren. Aber ich hatte nie jemanden, mit dem ich es spielen konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540115
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540115,
					"content": "Und wie lauten die Regeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540116,
					"content": "Hm ... Es ist einfacher, wenn ich es euch einfach zeige ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540117
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540117,
					"content": "Wahh! Da... Das ist ja beeindruckend! Wie hast du das gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540118,
					"content": "Hm? Mit ein klein wenig Kuuvahki, natürlich ... Könnt ihr das denn nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540119
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540119,
					"content": "Hm, vielleicht solltest du deine Erwartungen ein wenig runterschrauben. Wir sind nicht alle Mondgöttinnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540120,
					"content": "Wie ihr wünscht. Also, das ist das Brett – es repräsentiert den „Nachthimmel“. Und die Spielsteine, mit denen die zwei Spieler spielen, stehen für die „Monde“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540121
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540121,
					"content": "Die zwei Spieler platzieren abwechselnd ihre Monde am Nachthimmel, und der Spieler, der zuerst drei Monde in einer Reihe platziert, gewinnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540122
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540122,
					"content": "Ohhh! Also quasi eine Version von Drei gewinnt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540123,
					"content": "Also hier in Nod-Krai heißt es „Mondschach“, hm ... Das nennt Paimon mal einen lokalen Anstrich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540124,
					"content": "Ja. Aber in dieser Version rotieren die Monde, was bedeutet, dass es nie mehr als drei Monde gleichzeitig am Himmel geben kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540125
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540125,
					"content": "Wenn also der Nachthimmel voll ist, verschwindet der Mond, der zuerst aufgegangen war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540126
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540126,
					"content": "Das ... ergibt tatsächlich ziemlich viel Sinn ... und es macht das Spiel eine ganze Ecke schwieriger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540127,
					"content": "Also, möchtet ihr es mal versuchen? Es wird auch für mich das erste Mal sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540128
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540128,
					"content": "(Sie scheint sich wirklich darauf zu freuen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540129
					]
				},
				{
					"id": 760540129,
					"content": "#Hehe, klingt nach Spaß! Paimon ist die Schiedsrichterin! {NICKNAME} ist aber wirklich gerissen, also pass auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540130,
					"content": "Na gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		},
		{
