			"dialogs": [
				{
					"id": 747110101,
					"content": "Aha! Alles läuft reibungslos ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110102,
					"content": "Ich bin davon überzeugt, dass unsere Suche nach einem Heilmittel in die Endphase geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110103,
					"content": "Aber abgesehen davon, noch ein paar Wasserpatienten zu finden, um die Liste zu vervollständigen, habe ich noch eine andere, speziellere Bitte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110104,
					"content": "Ich möchte, dass ihr in den betroffenen Gewässern einige wichtige Unterwasser-Mechanismen findet und die Daten abruft, die von ihren Sensoren aufgezeichnet wurden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110105,
						747110106
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110105,
					"content": "Dann die Daten analysieren, um relevante Muster zu finden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				},
				{
					"id": 747110107,
					"content": "Genau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110108,
					"content": "Wir sollten auch mit den Bootsbesitzern und Tauchern sprechen, um sicherzugehen, dass sie ihre Lektion gelernt haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747110109,
					"content": "Das stimmt, ganz zu schweigen von den Fischern und Touristen ... Alle, die an der Wasseroberfläche mit einem Boot unterwegs sind, und diejenigen, die darunter tauchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110110,
					"content": "Alle, die in unseren Gewässern unterwegs sind, müssen rücksichtsvoll sein. Sie können nicht einfach Sachen ins Meer werfen und die Lebensräume unter Wasser zerstören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110111,
					"content": "Sonst könnten ein paar sehr aggressive Fische auftauchen und ihre Boote zum Kentern bringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110106,
					"content": "Damit wir in Zukunft ähnliche Vorfälle verhindern können?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				}
			]
		}
	]
}