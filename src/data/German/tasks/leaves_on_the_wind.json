					"Dr. Edith"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030501,
					"content": "Hast du etwas gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030502
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030502,
					"content": "Ich habe einige Blätter hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030503
					]
				},
				{
					"id": 207030503,
					"content": "... Blätter? Lass mich sehen, bitte. Hmm, du hast sie sogar in die Schachtel gelegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030504
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030504,
					"content": "Wenn du sie in deiner Hand hältst, erlauben dir diese Blätter tatsächlich, den „Wind“ zu spüren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030505
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030505,
					"content": "Und wenn man bedenkt, dass dieser Baum wirklich über solche Macht verfügt hat. Wenn ich nur ein Göttliches Auge hätte, dann müsste ich nicht so viel Zeit verschwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030506
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030506,
					"content": "Danke. Das ist eine sehr wertvolle Ressource. Und als solche werde ich sie verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030507
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030507,
					"content": "Ich habe trotzdem noch keine Methode, diese Blätter zu bewahren. Es ist gänzlich möglich, dass die Anemo-Kraft in ihnen nur all zu schnell schwindet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030508
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030508,
					"content": "Trotzdem, nimm das als Entschädigung für deinen Aufwand. Wer weiß, vielleicht frage ich dich in der Zukunft noch einmal nach Hilfe beim Sammeln von Forschungsmaterial.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Edith"
				}
			]
		}
	]
