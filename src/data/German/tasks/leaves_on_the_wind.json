			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dr. Edith"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030101,
					"content": "Leider ist das auch kein gutes Material, um darüber zu schreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030102
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030102,
					"content": "Was schreibst du denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030103
					]
				},
				{
					"id": 207030103,
					"content": "Ich suche nach Inspiration für mein neues Buch über Mondstadts Geschichte mit besonderem Fokus auf dem „Wind“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030104
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030104,
					"content": "Eigentlich ist dies der perfekte Ort, um Inspiration zu finden, direkt an der Statue der Sieben, die die Anemo-Kraft repräsentiert. Und dort ist auch noch der alte Baum, der mit der Legende der Heldin Vennessa verbunden ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030105
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030105,
					"content": "Dennoch ist es irgendwie lustig, denn ich besitze kein „Göttliches Auge“ und es ist schwer für mich den Wind zu sehen oder gar zu fangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030106
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030106,
					"content": "Und diese sogenannte Suche nach Inspiration? Ich lege gerade erst damit los. Der Großteil meines Materials wird aus Ressourcen aus zweiter Hand gewonnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030107
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030107,
					"content": "Das ist das Leben eines Menschen ohne ein Göttliches Auge auf diesem Kontinent - zu viel zu tun und trotzdem wenig zu erreichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030108
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030108,
					"content": "Man kann die Macht der Elemente ohne ein Göttliches Auge nicht nutzen. Ob in der Forschung oder im Leben, diejenigen ohne leben wie Außenseiter in ihrer eigenen Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030109
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030109,
					"content": "Hahaha, vielleicht sind in den Augen der Götter die Träger von Göttlichen Augen die wichtigsten Menschen dieser Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030110
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030110,
					"content": "Entschuldigung, ich habe zu viel gesagt. Und trotz des Gesagten werde ich meine Forschung nicht aufgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030111
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030111,
					"content": "Ich habe kein Göttliches Auge. Aber ich werde im Sinne der Wissenschaft nicht verlieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030112
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030112,
					"content": "Ich habe auch gehört, dass man die Elemente sogar ohne Göttliches Auge verwenden kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030113
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030113,
					"content": "Wenn du mir helfen könntest, einige Gegenstände zu finden, die von der Anemo-Kraft durchdrungen sind, würde das meiner Forschung wirklich helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030114
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030114,
					"content": "Kannst du mir helfen, den Baum hochzuklettern und nachzuschauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Edith"
				}
			]
		},
