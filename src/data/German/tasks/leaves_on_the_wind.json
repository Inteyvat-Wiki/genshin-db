			"dialogs": [
				{
					"id": 207030201,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030202
					]
				},
				{
					"id": 207030202,
					"content": "Toll, ich zähle auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030303
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030303,
					"content": "Du kannst die Elemente sehen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030304
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030304,
					"content": "Ich vermute, dass du nur der Spur des „Windes“ folgen musst, um so etwas zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030305
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030305,
					"content": "Ich werde auf dich unter dem Baum warten. Falls du irgendetwas findest, bring es einfach runter zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Edith"
				}
			]
		},
