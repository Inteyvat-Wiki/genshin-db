					"Dr. Edith"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030401,
					"content": "Ich muss sagen, dass jemand wie du definitiv besser dafür geeignet ist, Forschung zu betreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030402
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030402,
					"content": "Du hast viel Erfahrung bei Abenteuern und viel Ausdauer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030403
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030403,
					"content": "Und das Wichtigste: Du kannst die Elemente sogar kontrollieren, ohne ein Göttliches Auge zu nutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030404
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030404,
					"content": "Die Elemente ... Gibt es auf diesem Kontinent wirklich Forschung, die ihre Geheimnisse aufdecken könnte? Für einen Forscher ist die Fähigkeit, ein Göttliches Auge zu verwenden, oder dessen Fehlen wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030405
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030405,
					"content": "Ah, ich spreche schon wieder über etwas unwichtige Dinge ... Bitte nimm es dir nicht zu Herzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Edith"
				}
			]
		},
		{
			"id": 2070305,
			"completionStepIds": [
