					},
					{
						"sceneId": 3,
						"position": [
							2139.555,
							108.932,
							11209.02
						],
						"pointId": 13019
					},
					{
						"sceneId": 3,
						"position": [
							2138.688,
							108.819,
							11210.57
						],
						"pointId": 13020
					}
				]
			},
			"dialogs": [
				{
					"id": 60080201,
					"content": "Sie sieht nicht allzu gut aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080202,
					"content": "E... Entschuldige die Störung, aber bist du in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080203,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080204
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080204,
					"content": "Hat sich dein körperlicher Zustand verschlechtert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080205
					]
				},
				{
					"id": 60080205,
					"content": "... Mir ist schwindelig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080206
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080206,
					"content": "... Es ist, als würde ich ... auf den Mond zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080207
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080207,
					"content": "Warte, so schlimm ist es doch nicht, oder?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080208,
					"content": "Hm? Ich ... spüre die Kraft des Monds in dir ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080209
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080209,
					"content": "Wir haben das Mondmark von den Fatui zurückbekommen. Kann es dir irgendwie helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080210
					]
				},
				{
					"id": 60080210,
					"content": "Hm ... Und was verlangst du dieses Mal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080211
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080211,
					"content": "Ernsthaft? Denk nicht darüber nach! Was du jetzt tun musst, ist dich darauf zu konzentrieren, gesund zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080213
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080213,
					"content": "(Moment, ist das für sie einfach ... zur Gewohnheit geworden, nachdem sie so lange in Beziehungen von gegenseitigem Nutzen gelebt hat ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080214
					]
				},
				{
					"id": 60080214,
					"content": "Ich könnte in Zukunft deine Hilfe brauchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080215
					]
				},
				{
					"id": 60080215,
					"content": "... Oh, sehr gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080216
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080216,
					"content": "Gib mir deine Hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080217
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080217,
					"content": "Puh ... Zurück zur Erde. Vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080218
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080218,
					"content": "Ähm, du hast den Boden nie verlassen ... Aber egal, fühlst du dich jetzt besser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080219,
					"content": "Schon viel besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080220,
						60080221
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080220,
					"content": "Und was hast du gemacht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				},
				{
					"id": 60080222,
					"content": "Der Mond in deinem Körper ist ... so still wie eine Spiegelung im Wasser ... Faszinierend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080223
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080223,
					"content": "Ich habe lediglich einen Strahl seines Lichts aus dem Wasser aufgesaugt. Genug, um mich vorerst auf dem Boden zu halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080224
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080224,
					"content": "Ich habe auch einige andere Veränderungen wahrgenommen, glaube ich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080225
					]
				},
				{
					"id": 60080225,
					"content": "Das ist der „Segen der Mondgöttin“. Alle Dinge, mit denen ich in Kontakt komme, werden dieses Zeichen tragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080226
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080226,
					"content": "Es ist harmlos und wird nach einer Weile verschwinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080227
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080227,
					"content": "Apropos, willst du die Hüterin des Mondmarks sein, jetzt, da du deine Macht zurück hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080228,
					"content": "Es ist etwas, das auf jeden Fall zu einer „Göttin“ gehört, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080229,
					"content": "Es sind die Überreste von Arya, der Göttin des Ewigen Mondes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080230
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080230,
					"content": "Es gehörte also doch ... Warte, was!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080231,
					"content": "Wusstet ihr das nicht schon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080232
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080232,
					"content": "Lauma sagte nur, dass es sich von anderen Fragmenten unterscheide und sie göttliche Macht in ihm spüren könne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080233,
					"content": "Und sie hat recht. Als ich diesen Strahl des Mondlichts aus dem Mark gezogen habe, zog ich auch einige Erinnerungen aus seinem Inneren heraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080234
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080234,
					"content": "Daher weiß ich, dass es der Göttin des Ewigen Mondes gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080235
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080235,
					"content": "Aber Lauma hat mithilfe des Mondmarks auch in die Geschichte geschaut. Warum hat sie das nicht gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080236,
					"content": "(Lauma hat erwähnt, dass sie nur kurze, verschwommene Schnipsel wahrnehmen konnte ... Vielleicht ist das etwas, das nur eine Mondgöttin wahrnehmen kann ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080237
					]
				},
				{
					"id": 60080237,
					"content": "Einst gab es drei Monde am Himmel, jeder gehörte einer Göttin, die über ihn herrschte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080238
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080238,
					"content": "Doch nach dem Flammenkrieg lagen alle drei erschlagen da und zwei der drei Monde wurden während des Konflikts zerschmettert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080239
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080239,
					"content": "Nach Aryas Tod hat sich ihre Kraft in diesem Mondmark vereinigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080240
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080240,
					"content": "Die Überreste des schillernden Monds wurden nie gefunden. Und obwohl die Göttin des Frostmonds tot war, ist ihr Mond nie zerbrochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080241
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080241,
					"content": "Wie die Prophezeiung besagte, würde dieser Mond früher oder später eine neue Gottheit gebären – das Wesen, das die Nachkommen des Frostmonds „Kuu{RUBY#[S]Mondmädchen}tar“ nennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080242
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080242,
					"content": "Ich kann spüren, dass meine Kraft dem Frostmond gehört. Aber er befindet sich jenseits des trügerischen Himmels, zu weit von mir entfernt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080243
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080243,
					"content": "Ganz zu schweigen davon, ihn zu „steuern“ ... Allein ihn zu „spüren“ erfordert immense Anstrengungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080244
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080244,
					"content": "Warte, lass Paimon das mal zählen ... Wir haben das Mark des Ewigen Monds bei uns, das des Schillernden Monds kann niemand finden ... Hast du also das Mark des Frostmonds in dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080245,
					"content": "Nein. Es kann sich erst bilden, wenn die Mondgöttin tot ist. Betrachte es als eine Art Energiekern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080246
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080246,
					"content": "Genauso gut könntest du fragen, ob es auf dem Mond Felsen gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080247
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080247,
					"content": "Oh, du meinst also, dass du die Manifestation der Kraft des Frostmondes bist, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080248,
					"content": "#Ja. Nun, ein Archon mit Göttlichem Herz wird Gott genannt. Da du das Mondmark trägst, macht dich das zu {F#einer ... Mondgöttin}{M#einem ... Mondgott}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080249
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080249,
					"content": "Ich glaube nicht, dass das dasselbe ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080250
					]
				},
				{
					"id": 60080250,
					"content": "#Möchtest du nicht {F#eine}{M#einer} werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080251
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080251,
					"content": "Das ist nicht das Problem! Außerdem, warum willst du diesen Titel unbedingt an jemand anderen weitergeben!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080252
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080252,
					"content": "#Wie auch immer, vergessen wir diesen „{F#Mondgöttin}{M#Mondgott} werden“-Kram für den Moment. Sollen wir dir dieses Mondmark zurückgeben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080253,
					"content": "Ich sehne mich nicht danach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080254
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080254,
					"content": "Hä?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080255
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080255,
					"content": "Und es will auch nicht zu mir kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080256
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080256,
					"content": "Und was soll das heißen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080257,
					"content": "Als ich mit seiner Kraft in Berührung kam, habe ich eine Form von „Ablehnung“ gespürt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080258
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080258,
					"content": "Ich kann nur vermuten, dass dies daran liegt, dass auch ich eine Mondgöttin bin. Zwei Monde gehen nicht zur gleichen Zeit auf, geschweige denn verschlingen sie sich gegenseitig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080259
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080259,
					"content": "Dann muss es wohl vorerst bei mir bleiben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080260
					]
				},
				{
					"id": 60080260,
					"content": "Bist du sicher, dass das in Ordnung ist? Lauma hat gesagt, dass du diese Kraft gut verbergen kannst, aber die „Jungfrau“ hat sie gerade ganz leicht gespürt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080261
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080261,
					"content": "Und wir haben es hier mit der Wilden Jagd zu tun, nicht mit irgendeinem gewöhnlichen Feind. Wenn sie das Mondmark entdeckt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080262
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080262,
					"content": "Die Wilde Jagd? Ihr sprecht von diesem Phänomen, als würdet ihr eine Person beschreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080263
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080263,
					"content": "Nun, es sieht ganz danach aus, als würde eine Person dahinter stecken – und zwar jemand mit einem ganz klaren Ziel. Sie sind ununterbrochen hinter dem Mondmark her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080264
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080264,
					"content": "Kommt mir irgendwie bekannt vor ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080265
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080265,
					"content": "Was? Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080266
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080266,
					"content": "Meine Kollegen erwähnten jemanden, als ich noch bei den Fatui war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080267
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080267,
					"content": "Er stammt aus Khaenri’ah und erlangte während der Katastrophe die Macht des Abgrunds ... Und er hatte eine obsessive Besessenheit von den Monden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080268
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080268,
					"content": "Khaenri’ah? Nun, wir wissen nicht, ob das Phantom, das wir gesehen haben, etwas damit zu tun hat, aber die Details passen irgendwie ... Wie war sein Name?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080269
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080269,
					"content": "Ich weiß nur, wie die anderen ihn nennen – den „Rächer von Solnari“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080270
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080270,
					"content": "Einen der fünf Sünder von Khaenri’ah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080271
					]
				},
				{
					"id": 60080271,
					"content": "Ah. Er hat auch diesen Titel, ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080272
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080272,
					"content": "Eh!? Moment mal ... Dain hat ihn erwähnt, nicht wahr? Heißt das, unser Feind ist Rerir, einer der Fünf!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080273
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080273,
					"content": "Aber wenn das der Fall ist, sollte er stärker sein als das ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080274
					]
				},
				{
					"id": 60080274,
					"content": "Ich habe gehört, dass er nicht lange nach der Katastrophe verschwunden ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080275
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080275,
					"content": "Aber als ich meine Kollegen fragte, wohin er gegangen ist, antworteten sie: „Weißt du es wirklich nicht?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080276
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080276,
					"content": "Warum haben sie das gesagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080277
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080277,
					"content": "Die Erzählungen über sein endgültiges Schicksal besagen, dass er in den „Widerschein des Monds“ fiel, aus dem es keine Rückkehr gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080278
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080278,
					"content": "Warte, warte, warte ... Das sind einfach ... zu viele Informationen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080279
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080279,
					"content": "Mir ging es ganz ähnlich. Sie schienen zu denken, dass ich diejenige sein sollte, die alles über die Monde weiß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080280
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080280,
					"content": "Aber wie ich schon sagte ... Mein „Prolog“ liegt jenseits des trügerischen Himmels. Ich weiß nicht einmal mehr meinen Namen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080281
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080281,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080282
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080282,
					"content": "Wie auch immer, die Situation der Wilden Jagd hat sich nach seinem Weggang drastisch verschlechtert und ist seitdem zu einem Synonym für das Unheil des Abgrunds geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080283
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080283,
					"content": "Das gegenwärtige Phänomen mag zwar denselben Namen tragen, übertrifft seinen Vorgänger jedoch sowohl hinsichtlich seines Ausmaßes als auch seiner Tödlichkeit bei weitem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080284
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080284,
					"content": "Uff. Wenn man bedenkt, dass wir es mit einem der fünf legendären Sünder von Khaenri’ah zu tun haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080285
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080285,
					"content": "Das ist viel zu viel für uns! Der Vorfall am Sternsandstrand muss also Glück gewesen sein ... oder hat er vielleicht nicht alles gegeben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080286
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080286,
					"content": "Und selbst dann ... hat er trotzdem „Marionette“ besiegt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080221,
					"content": "... Oder besser gesagt, was habe ich gemacht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				}
			]
		},
		{
			"id": 600804,
			"completionStepIds": [
				600802,
				600803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Columbina“"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2143.145,
							109.201,
							11210.94
						],
						"pointId": 11739
					}
				]
			},
			"dialogs": [
				{
					"id": 60080401,
					"content": "Hm? Was? Kannst du das bitte wiederholen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080402
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080402,
					"content": "Äh ... Sie ist deine ... frühere Kollegin? Ja, also, wir waren zusammen am Sternsandstrand und sie wurde auch von der Wilden Jagd besiegt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080404
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080404,
					"content": "Hast du ... gerade gelacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080405,
					"content": "... Nein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080406
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080406,
					"content": "(Doch, das hast du!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080407,
					"content": "Habt ihr beiden ein Problem miteinander?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080408,
					"content": "Nein ... Ich habe mir nur ihren verlegenen Gesichtsausdruck nach der Niederlage vorgestellt und fand ihn interessant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080409
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080409,
					"content": "Sie schien ziemlich erschüttert zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080410,
					"content": "Oh, sie wird sich schon bald daran gewöhnen. Darin ist sie sehr gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080411
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080411,
					"content": "#Na gut, wie auch immer, wir sind vom Thema abgekommen. Da wir jetzt wissen, wie gefährlich der Typ ist, der es auf das Mondmark abgesehen hat ... Bist du sicher, dass du es mit dir herumtragen willst, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080412,
					"content": "Wenn die Informationen der Fatui vertrauenswürdig sind, würde Rerir selbst dann die Oberhand behalten, auch wenn ganz Nod-Krai gegen ihn antreten würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080413
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080413,
					"content": "Vielleicht hält ihn etwas zurück, wenn auch nur für den Moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080414
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080414,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080415
					]
				},
				{
					"id": 60080415,
					"content": "Bevor ich meine Entscheidung treffe, möchte ich dich um einen Gefallen bitten, Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080416
					]
				},
				{
					"id": 60080416,
					"content": "Was brauchst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080417
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080417,
					"content": "#Meinst du, du könntest mir zeigen, was passiert ist, als {M#meine Schwester}{F#mein Bruder} und ich mit unserem Raumschiff in Nod-Krai gelandet sind?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080418
					]
				},
				{
					"id": 60080418,
					"content": "Sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080419
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080419,
					"content": "Das war eine schnelle Antwort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080420,
					"content": "Wie ich schon sagte, für mich ist das nur ein weiterer Mondstrahl. Nichts Besonderes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080421
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080421,
					"content": "Gib mir deine Hand und halte dich bereit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080422
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080422,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080423
					]
				},
				{
					"id": 60080423,
					"content": "(Das ist das, was ich vorher gesehen habe, nur deutlicher ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080424
					]
				},
				{
					"id": 60080424,
					"content": "(Zumindest scheinen wir sicher gelandet zu sein ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080425
					]
				},
				{
					"id": 60080425,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080426
					]
				},
				{
					"id": 60080426,
					"content": "(Es scheint eine Menge Zeit vergangen zu sein ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080427
					]
				},
				{
					"id": 60080427,
					"content": "#(Wir sind immer noch innerhalb des Raumschiffs. Wenn man bedenkt, dass wir so lange da drin waren ... Wann ist {M#Lumine}{F#Aether} wohl rausgekommen?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080428
					]
				},
				{
					"id": 60080428,
					"content": "#(Moment. Ist das ... {M#Lumine}{F#Aether}?!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080429
					]
				},
				{
					"id": 60080429,
					"content": "(Wie kann das sein? Keiner hat das Schiff verlassen, seit wir gelandet sind! Die Tür ist noch nicht einmal geöffnet worden!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080430
					]
				},
				{
					"id": 60080430,
					"content": "Wo ... ist das hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080431
					]
				},
				{
					"id": 60080431,
					"content": "#{M#Aether}{F#Lumine}! Komm! Wir müssen weg von diesem Ort!",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						60080432
					]
				},
				{
					"id": 60080432,
					"content": "... Hä?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080433
					]
				},
				{
					"id": 60080433,
					"content": "He! Geht es dir gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080434,
					"content": "Unser Raumschiff ... Nachdem wir gelandet waren, verging eine lange, lange Zeit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080435
					]
				},
				{
					"id": 60080435,
					"content": "#Niemand hat das Schiff während dieser Zeit verlassen, aber {M#Lumine}{F#Aether} ... hat mich irgendwie von außerhalb des Schiffes gefunden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080436
					]
				},
				{
					"id": 60080436,
					"content": "Hä?! Wie ist das möglich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080437,
					"content": "Ich weiß nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080438
					]
				},
				{
					"id": 60080438,
					"content": "Die Geheimnisse in Erinnerungen sind wie Kekskrümel. Nimm einen Bissen, und sie verteilen sich überall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080439
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080439,
					"content": "(Das ... Das ist viel zu verdächtig. Ich muss der Sache auf den Grund gehen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080440
					]
				},
				{
					"id": 60080440,
					"content": "(Aber wie Nefer schon sagte, wird es nichts zu untersuchen geben, wenn Nod-Krai zerstört wird ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080441
					]
				},
				{
					"id": 60080441,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080442
					]
				},
				{
					"id": 60080442,
					"content": "Na gut. Ich werde das Mondmark bei mir behalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080443
					]
				},
				{
					"id": 60080443,
					"content": "Ähm ... Na ja, sicher ... Wenn du das sagst. Aber es ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080444
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080444,
					"content": "Brauchst du meine Hilfe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080445
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080445,
					"content": "Mit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080446
					]
				},
				{
					"id": 60080446,
					"content": "Ich könnte dir helfen, das „Mondmark“ zu verstecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080447
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080447,
					"content": "Wirklich? Das wäre toll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080448,
					"content": "Es aufzuspüren ist schon keine leichte Aufgabe, aber ich kann dir beibringen, seine Anwesenheit mit Kuuvahki weiter zu verbergen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080449
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080449,
					"content": "So etwa ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080450
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080450,
					"content": "Oh! Sieht aus wie ein Schild!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080451,
					"content": "(Das ... fühlt sich so weich und sanft an ... genau wie das Mondlicht ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080452
					]
				},
				{
					"id": 60080452,
					"content": "Kannst du es spüren? Versuche nun, es beizubehalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080453
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080453,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080454
					]
				},
				{
					"id": 60080454,
					"content": "Du lernst schnell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080455
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080455,
					"content": "Sieht ziemlich robust aus. Wenn nötig, könnte man es wahrscheinlich zur Selbstverteidigung verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080456
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080456,
					"content": "Danke, dass du mir das beigebracht hast ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080457
					]
				},
				{
					"id": 60080457,
					"content": "Bist du immer hier, Columbina? Es ist gefährlich da draußen, klar, aber bist du schon mal draußen spazieren gegangen oder so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080458
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080458,
					"content": "... Ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080459
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080459,
					"content": "... Ich mag keine Fremden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080460
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080460,
					"content": "Und sind wir immer noch Fremde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080461
					]
				},
				{
					"id": 60080461,
					"content": "Ein bisschen besser als das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080462,
						60080463
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080462,
					"content": "Wenn die ganze Sache mit der Wilden Jagd vorbei ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				},
				{
					"id": 60080464,
					"content": "Genau. Die Nachkommen des Frostmonds haben sich verändert, seit du sie das letzte Mal gesehen hast. Wer weiß, vielleicht würdest du sie jetzt sogar mögen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080465
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080465,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080466
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080466,
					"content": "Ich werde darüber nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080467
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080467,
					"content": "Sie sieht etwas müde aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080468
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080468,
					"content": "Wahrscheinlich hat sie schon lange nicht mehr so viel gesprochen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080469
					]
				},
				{
					"id": 60080469,
					"content": "Wie auch immer. Vielen Dank, dass du zugestimmt hast, uns zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080470
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080470,
					"content": "... Das war nicht viel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080471
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080471,
					"content": "Die Blumen hier ... Sie mögen Gäste wie dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 60080463,
					"content": "Gehen wir einen Spaziergang machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				}
			]
		}
	]
}