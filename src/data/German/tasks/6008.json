			"dialogs": [
				{
					"id": 60080101,
					"content": "Sehen wir mal ... Was hat sich verändert, seit wir weg waren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080102,
					"content": "Nicht so viel wie erwartet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080103
					]
				},
				{
					"id": 60080103,
					"content": "Ja. Wenn überhaupt, wenn überhaupt, scheint sich die Lage beruhigt zu haben. Lauma hat es drauf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080104,
					"content": "He, Lauma. Wir sind wieder da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080105,
					"content": "Wie ist es in den letzten Tagen gelaufen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080106
					]
				},
				{
					"id": 60080106,
					"content": "Die Aufräumarbeiten waren viel komplizierter, als ich erwartet hatte. Die Lösung von Problemen, die sich im Laufe der Zeit angesammelt haben, ist eine große Aufgabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080107
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080107,
					"content": "Ich glaube, ich werde mir noch ein paar Wochen mehr Zeit nehmen. Glücklicherweise scheinen diejenigen, die geblieben sind, die anfängliche Verwirrung abgeschüttelt zu haben und motivierter geworden zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080108,
					"content": "Es ist, als wären sie endlich gezwungen worden, sich mit dem auseinanderzusetzen, was ihr Glaube tatsächlich ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080109
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080109,
					"content": "Und das ist alles dein Verdienst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080110,
					"content": "Nein, ich ... ich hätte das früher tun sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080111,
					"content": "Ich habe in den letzten Tagen gut auf mich Acht gegeben. Ich sollte in der Lage sein, dir bei der Erforschung der Vergangenheit durch das Mondmark, auf das du im Moment aufpasst, zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080112,
					"content": "Danke, dass du dich daran erinnert hast.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080113
					]
				},
				{
					"id": 60080113,
					"content": "Apropos, hast du schon etwas Neues über das Phantom gehört, dem wir begegnet sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080114,
					"content": "Ich habe versucht, einige Leute zu fragen, aber ohne Erfolg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080115,
					"content": "Wie läuft es bei euch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080116,
					"content": "Wir haben auch keine großen Fortschritte gemacht, aber wir haben Folgendes ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080117,
					"content": "Das Wesentliche habe ich verstanden ... Ihr habt auch viel zu tun, wie es scheint, also achtet bitte auf eure Gesundheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080118
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080118,
					"content": "#Auf jeden Fall, {NICKNAME}, komm bitte näher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080119,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080120
					]
				},
				{
					"id": 60080120,
					"content": "Was siehst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080121,
					"content": "(Das ist ... Nod-Krai? Das kommt mir alles bekannt vor ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080122
					]
				},
				{
					"id": 60080122,
					"content": "(Ist das da oben ... eine Sternschnuppe?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080123
					]
				},
				{
					"id": 60080123,
					"content": "(...! Nein! Das ist unser Raumschiff!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080124
					]
				},
				{
					"id": 60080124,
					"content": "Ist es ... schon vorbei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080125,
					"content": "Das scheint schon sehr, sehr lange her zu sein. Die Erinnerungen, die ich wahrgenommen habe, sind sehr unruhig und ungeordnet. Das ist alles, was ich mit meiner Kraft erkennen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080126
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080126,
					"content": "(Zumindest weiß ich jetzt, wo unser Raumschiff in Nod-Krai gelandet ist ... In der Nähe vom Sternsandstrand, so scheint es jedenfalls.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080127
					]
				},
				{
					"id": 60080127,
					"content": "#(Das stimmt mit dem überein, was {M#Lumine}{F#Aether} mir erzählt hat ... Aber ich will trotzdem mehr wissen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080128
					]
				},
				{
					"id": 60080128,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080129
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 60080129,
					"content": "Äh? Was ist los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080130,
					"content": "Die Farbe der Blumen hat sich verändert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080131
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080131,
					"content": "(Diese Blumen sind ein Spiegelbild von Columbinas Kräften. Bedeutet das, dass sie ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080132
					]
				},
				{
					"id": 60080132,
					"content": "(Ich erinnere mich, dass sie erwähnt hat, das Mondmark benutzen zu wollen, um etwas von ihrer Kraft wiederherzustellen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080133
					]
				},
				{
					"id": 60080133,
					"content": "Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080134
					]
				},
				{
					"id": 60080134,
					"content": "Ja, wir sollten zu ihr gehen und sehen, ob wir ihr irgendwie helfen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080135,
					"content": "Ich überlasse das also euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080136
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080136,
					"content": "Ach ja, richtig. Hier ist das Medikament, das du früher beim Kuratorium der Geheimnisse bestellt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080137,
					"content": "Ah. Vielen Dank, dass ihr es mir gebracht habt. Das hilft mir wirklich sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080138
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080138,
					"content": "Außerdem ... habe ich das Gefühl, dass „Kuu{RUBY#[S]Mondmädchen}tar“ dir helfen könnte, einen genaueren Einblick in die Erinnerungen an dein Raumschiff zu bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080139
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60080139,
					"content": "Oh, das ist wahr. Sie ist ja schließlich die Kuutar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080140,
					"content": "Aber wir sollten erst nachsehen, ob es ihr gut geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080141,
					"content": "Also, bis später!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
