			"dialogs": [
				{
					"id": 750711101,
					"content": "Hast du das gesehen? Der Kleine hat anscheinend etwas bemerkt ... Ist es vielleicht seine Familie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711102
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711102,
					"content": "Er läuft schon von selbst dorthin! Schnell, hinterher ... wir dürfen ihn nicht verlieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				}
			]
		},
