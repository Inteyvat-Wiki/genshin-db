			"dialogs": [
				{
					"id": 750711321,
					"content": "Ihr habt die Gegner überwältigt und die Tür des Käfigs zertrümmert, in dem das kleine Packtier eingesperrt war. Es hüpft aus dem Käfig und quietscht euch vergnügt an.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750711301
					]
				},
				{
					"id": 750711301,
					"content": "Wah ... Puh, das wäre geschafft! Wie aufregend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711302,
					"content": "Psst ...! Schau mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711303
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711303,
					"content": "*klick*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711304
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711304,
					"content": "Perfekt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711305
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711305,
					"content": "Wah ... Die scheinen sich wirklich gut zu verstehen ... Paimon dachte schon, dass das Packtier gefressen wird ... oder so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711306,
					"content": "Hehe, die Tepetlisaurier mögen zwar furchteinflößend aussehen, aber eigentlich sind sie total sanftmütig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711307
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711307,
					"content": "So, das Foto ist fertig, hier ist dein Abzug. Und natürlich auch deine wohlverdiente Bezahlung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711308
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711308,
					"content": "*seufz* Hier dachte ich, wir könnten ein süßes Bild von einem jungen Tepetlisaurier und einem erwachsenen schießen ... Aber dann hat sich das Packtier vorgedrängelt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711309
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711309,
					"content": "Hehe, ach komm schon. Packtiere sind eigentlich gar nicht so schlimm. Meist du nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711310,
					"content": "Was ich denke, spielt keine Rolle! Wichtig ist, wie die Jury vom Fotowettbewerb das sieht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711311
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711311,
					"content": "Trotzdem ... wäre es zu gefährlich, das kleine Packtier allein in Natlan herumstreunen zu lassen. Außerdem könnte ich sowieso einen Helfer gebrauchen, der meine Sachen trägt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711312
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711312,
					"content": "Hehe, tja, dann muss ich es wohl oder übel adoptieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711313
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711313,
					"content": "Was ist denn mit seinem ursprünglichen Besitzer ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711314,
					"content": "Hmpf, der ist selbst schuld, wenn er es an so einem gefährlichen Ort hier draußen allein lässt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711317
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711317,
					"content": "Aber genug davon! Die Fotogalerien von Fontaine warten auf mich! Haha, und ihr müsst auch unbedingt kommen, wenn es so weit ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711318
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711318,
					"content": "#Tut mir leid, aber ich muss dieses Land nun wirklich verlassen! Auf Wiedersehen, {NICKNAME} und Paimon! Leb wohl, Kleiner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711319
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711319,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711320
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711320,
