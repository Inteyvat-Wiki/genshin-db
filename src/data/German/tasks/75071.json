			"dialogs": [
				{
					"id": 750711001,
					"content": "#Haha, {F#meine liebe}{M#mein lieber} {NICKNAME} und Paimon, meine Muse und ... äh, meine Mini-Muse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711002
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711002,
					"content": "#Ah ja, und {REALNAME[ID(2)|SHOWHOST(true)]} darf natürlich nicht fehlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711003
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711003,
					"content": "Hah! Wer ist eigentlich die Mini-Muse hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711004,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711005
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711005,
					"content": "Haha, ach, beachtet mich einfach nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711006
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711006,
					"content": "Hmpf, Paimon beachtet dich sehr wohl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711007,
						750711011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711007,
					"content": "Hattest du wieder eine neue Eingebung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711008
					]
				},
				{
					"id": 750711008,
					"content": "Selbstverständlich, aber ... hehe, neue Ideen bedeuten auch ... dass ich euch wieder um Hilfe bitten muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711009
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711009,
					"content": "Kein Problem! Solange du immer schön bezahlst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711010,
					"content": "Haha, wunderbar, meine tapferen kleinen Söldner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711017,
					"content": "Seht mal, heute mache ich Fotos von dem Tepetlisaurier ... Psst, seid leise. Wir dürfen sie nicht aufschrecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711018
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711018,
					"content": "Ich beschäftige mich zum ersten Mal mit diesen Sauriern, aber ich beobachte sie schon eine Weile ... Wirklich faszinierende Tiere ... Unter ihrer harten Schale verbergen sie interessante Persönlichkeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711019
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711019,
					"content": "Hehe, der hier hat sogar schon ein paar Grundkommandos gelernt, nachdem er ein paar Mal gefüttert wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711020
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711020,
					"content": "Ich brauche eure Hilfe, Saurierexperten. Ihr könntet mit dem abseitsstehenden Tepetlisaurier interagieren, damit ich ein Bild davon machen kann, wie er mit anderen Artgenossen spielt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711021
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711021,
					"content": "Hehe, eigentlich ganz leicht, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711022
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711022,
					"content": "Jepp, echt nicht schwer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711023,
						750711024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711023,
					"content": "(Du bist ja hier nicht der, der viel zu tun hat ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711025,
					"content": "Haha, genau so ist es richtig! Also, hilf mir, den Tepetlisaurier herzubringen, und wir können dann beginnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711024,
					"content": "(Nicht so leicht, wie du vielleicht denkst ...!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711011,
					"content": "Hoffst du wieder auf den Beistand deiner Musen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711012
					]
				},
				{
					"id": 750711012,
					"content": "Mousse ... Mhm, Paimon bekommt Appetit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711013,
					"content": "*grummel* ... *grummel* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711014
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711014,
					"content": "Äh ... Du meinst die „Muse“ ... nicht „Mousse“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711015
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711015,
					"content": "Hehe, solange du zahlst, können wir die Mora direkt in köstliche Mahlzeiten verwandeln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711016,
					"content": "Wie du meinst, Paimon ... Keine Sorge, ich habe reichlich Mora, ihr werdet nicht umsonst arbeiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "Magnifico"
				}
			]
		},
