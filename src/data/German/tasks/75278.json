				]
			},
			"dialogs": [
				{
					"id": 752780101,
					"content": "Ihr beiden! Bitte einen Moment!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780102
					],
					"speakerTitle": "„Chiton“"
				},
				{
					"id": 752780102,
					"content": "Was ist los, Süße? Was willst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780103,
					"content": "„Erlebe das Wunder der Blüte der Kaktusfeige, und lass das heilige Feuer dein Lächeln entzünden!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780104
					],
					"speakerTitle": "„Chiton“"
				},
				{
					"id": 752780104,
					"content": "Äh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780105,
					"content": "„Im Namen der Urlaubsanlage Leichtbrise präsentiere ich dir den Willkommenstanz! Funkle, Star von Pipilpan!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780106
					],
					"speakerTitle": "„Chiton“"
				},
				{
					"id": 752780106,
					"content": "Ah! Schon wieder dieser Satz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780107,
					"content": "#Ja, ich bin’s, „Chiton“. Hehe, lange nicht gesehen, {M#lieber}{F#liebe} {NICKNAME} und Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780108
					],
					"speakerTitle": "„Chiton“"
				},
				{
					"id": 752780108,
					"content": "Ach, du bist es, „Chiton“. Ich dachte schon, ich treffe wieder auf irgendwelche gruseligen Typen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780109,
						752780110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780109,
					"content": "Gab’s was Schönes zu berichten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				},
				{
					"id": 752780111,
					"content": "Hehe, ich erzähl’s euch: Mein Papa will mich jetzt persönlich trainieren und zur richtigen Darstellerin machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780112
					],
					"speakerTitle": "„Chiton“"
				},
				{
					"id": 752780112,
					"content": "Er klingt zwar streng, aber eigentlich kümmert er sich schon ganz schön um dich. Na ja, solange er dir keine komischen Sachen beibringt, wäre das natürlich noch besser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780113,
					"content": "Ach, hier, das ist für euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780114
					],
					"speakerTitle": "„Chiton“"
				},
				{
					"id": 752780114,
					"content": "Das ist dein Auftrittskostüm? Ohne das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780115,
					"content": "Hehe, keine Sorge, mein Papa hat mir ein neues Kostüm machen lassen, das viel besser zu mir passt! Diesmal falle ich bestimmt nicht mehr auf der Bühne hin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780116
					],
					"speakerTitle": "„Chiton“"
				},
				{
					"id": 752780116,
					"content": "Das alte Kostüm habe ich in eine Deko verwandelt. Nehmt’s bitte als Zeichen unserer Freundschaft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780117
					],
					"speakerTitle": "„Chiton“"
				},
				{
					"id": 752780117,
					"content": "Beim nächsten Mal, wenn wir uns sehen, trage ich mein neues Kostüm und tanze euch zur Begrüßung! Also kommt unbedingt vorbei, ich warte auf euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780118
					],
					"speakerTitle": "„Chiton“"
				},
				{
					"id": 752780118,
					"content": "Klar, das machen wir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780119,
					"content": "„Chiton“! Zeit fürs Training!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780120,
					"content": "#In Ordnung, ich gehe jetzt Muskeln trainieren! {M#Lieber}{F#Liebe} {NICKNAME} und Paimon, bis bald!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780121
					],
					"speakerTitle": "„Chiton“"
				},
				{
					"id": 752780121,
					"content": "Ja, bis bald!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780122,
					"content": "(Du wirst dein Wort wirklich halten?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780123
					]
				},
				{
					"id": 752780123,
					"content": "Klar doch! Aber es wäre natürlich noch besser, wenn Paimon dann auch mal eine normale Star-Show sehen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780110,
					"content": "Wie läuft’s bei dir so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				}
			]
		}
	]
}