					"nextDialogs": [
						760360342
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760360342,
					"content": "Dieses Bild ... zeigt vermutlich, wie die Nachkommen des Frostmonds Colombina als Göttin verehrten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360343,
					"content": "Hmm? Was macht Columbina dort am Altar? Die Details sind zu klein, um sie klar zu erkennen.",
