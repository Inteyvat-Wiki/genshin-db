			"dialogs": [
				{
					"id": 760360301,
					"content": "Reicht das hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360302,
					"content": "Ja. Sie scheint zufrieden zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360303
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760360303,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360304
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360304,
					"content": "Paimon wusste gar nicht, dass Kuuhenki malen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360305,
					"content": "Sie sind eigentlich genau wie wir, mit eigenen Persönlichkeiten und Hobbys.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360306
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760360306,
					"content": "Moment mal ... Sag bloß, du erkennst alle Kuuhenki in Nod-Krai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360307,
					"content": "Zumindest alle, die ich getroffen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360308
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760360308,
					"content": "Wahnsinn! Bis auf Luonnotar sehen alle anderen Kuuhenki ja fast gleich aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360309,
					"content": "Und wie heißt diese kleine Malerin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360310,
					"content": "Sie heißt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360311
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760360311,
					"content": "Moment mal ... Hast du ihnen etwa keine Namen gegeben ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360312,
					"content": "Ich erkenne sie und sie mich. Namen sind nicht nötig ... Ich selbst habe auch keinen Namen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360313
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760360313,
					"content": "Schlechte Traditionen sollte man nicht weiterführen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360314,
					"content": "Hmm ... Lass mich nachdenken ... „Luonnotar“ bedeutet „unter dem Segen der Mondgöttin geborenes Wesen“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360315,
					"content": "Was heißt „Gemälde“ auf der Sprache der Nachkommen des Frostmonds?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360316,
					"content": "Ich glaube ... Maa... naus? Maalaus? Ja, Maalaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360317
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760360317,
					"content": "Oh, klingt gut! Dann nennen wir sie ab jetzt so!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360318,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360319
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360319,
					"content": "Na, Maalaus? Bist du fertig mit dem Malen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360320,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360321
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360321,
					"content": "Oh! Lass Paimon mal sehen ... Ah! Das ist ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360322,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360323
					]
				},
				{
					"id": 760360323,
					"content": "Das Bild ist einfach wunderschön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360324,
					"content": "Paimon hat etwas Kindlicheres erwartet ... oder etwas ... Melusinenhaftes ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360325,
					"content": "Die Kuuhenki sind sehr gut darin, ihre Umgebung wahrzunehmen. Wenn sie etwas Gesehenes nachbilden, neigen sie dazu, das auch unverändert festzuhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360326
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760360326,
					"content": "Hmm ... hast du da etwa Columbina gemalt, Maalaus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360327
					]
				},
				{
					"id": 760360327,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360328
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360328,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360329
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760360329,
					"content": "... Sieht wie Columbina aus, als sie gerade geboren war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360330,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360331
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760360331,
					"content": "Paimon weiß noch, wie Lauma gesagt hat, dass deine Geburt von den Nachkommen des Frostmonds festgehalten wurde ... wobei dieses Bild etwas anders aussieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360332,
						760360333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360332,
					"content": "Und die Kuuhenki ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360334
					]
				},
				{
					"id": 760360334,
					"content": "Diese Kleine ... Maalaus, ist eine der ersten Kuuhenki. Vielleicht hat sie ihre Wahrnehmungen kombiniert, um sich ein Bild von damals zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360335
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760360335,
					"content": "Es scheint, als würdest du uns unbedingt deine Göttin vorstellen wollen, nicht wahr, Maalaus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360336,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360337
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360337,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360338
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760360338,
					"content": "Keine Sorge. Wir werden uns wunderbar mit Columbina verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360339,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360340
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360340,
					"content": "Oha! Wie hast du so schnell noch ein Bild gemalt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360341,
					"content": "...?",
