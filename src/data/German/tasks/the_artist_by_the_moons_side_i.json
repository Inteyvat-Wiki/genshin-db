					"nextDialogs": [
						760360345
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360345,
					"content": "Oha, sie isst also die Opfergaben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360346
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360346,
					"content": "... Hätte ich das nicht tun sollen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360347
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760360347,
					"content": "Nun, nein, nein, das ist ja nicht verboten. Es ist nur irgendwie ... ähm ... unerwartet ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360348,
					"content": "Du scheinst es genossen zu haben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360349
					]
				},
				{
					"id": 760360349,
					"content": "Nun ja ... es war lecker ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360350
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760360350,
					"content": "Paimon versteht das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360351,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360352
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360352,
					"content": "Ah, ich weiß schon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360353
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760360353,
					"content": "Gib mir deine Hand.",
