					"nextDialogs": [
						760360354,
						760360355
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760360354,
					"content": "Wir brauchen wirklich keine Belohnung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360356
