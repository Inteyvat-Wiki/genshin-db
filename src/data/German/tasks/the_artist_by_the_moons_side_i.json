				},
				{
					"id": 760360356,
					"content": "Nein. Dies ist der Beweis dafür, dass wir uns „gut verstehen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760360355,
					"content": "Das kann man ja gar nicht essen ...",
