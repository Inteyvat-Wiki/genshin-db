			"dialogs": [
				{
					"id": 190603101,
					"content": "Nimm nicht ernst, was Uesugi erzählt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603102
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603102,
					"content": "Wegen Takatsukasa Isamu und Ryuuji ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603103
					]
				},
				{
					"id": 190603103,
					"content": "Du fragst das? Ganz im Ernst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603104
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603104,
					"content": "Es besteht kein Zweifel, dass Ryuuji Takatsukasa Isamu als seinen Vater betrachtete. Warum Takatsukasa Isamu Ryuuji aus der tiefsten Armut half, hatte sowohl mit Mitleid als auch mit eigenen Interessen zu tun. Mehr dazu darf ich nicht sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603105
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603105,
					"content": "Schließlich war Takatsukasa Isamu kein normaler Bürger. Wenn er einen einfachen und naiven Typen wie Ryuuji begegnet, wird er die Chance nicht verpassen, den Typen als Vertrauten und treuen Begleithund aufzubauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603106
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603106,
					"content": "Takatsukasa Isamu hatte später selbst ein Kind. Aber tragischerweise wurde er ermordet, bevor das Kind zur Welt kam. Er hat es nicht einmal zu Gesicht bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603107
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 190603107,
					"content": "Lass dieses Thema beiseitelegen. Ihr wollt doch den Fall untersuchen, oder? Los geht’s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				}
			]
		},
