					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1906006",
							"2"
						],
						"stepId": 1906006,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1906007",
							"2"
						],
						"stepId": 1906007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uesugi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190603001,
					"content": "#He, {F#Reisende}{M#Reisender}, es bereitet Kopfschmerzen, einen Fall zu untersuchen, oder? Hört auf mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603002
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603002,
					"content": "Über Sango ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603003
					]
				},
				{
					"id": 190603003,
					"content": "Ach ja! Du meinst diese Frau Sango. Der Takatsukasa-Klan hat wirklich eine großartige Detektivin engagiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603004
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603004,
					"content": "Sie kam alle paar Tage, um einen Antrag auf eine erneute Untersuchung des „Ryuuji-Falls“ einzureichen. Aber jedes Mal wurde sie von Herrn Heizou blockiert. Ich habe nicht damit gerechnet, dass sie dieses Mal einen Beschwerdebrief geschrieben hat. Es ist ja erstaunlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603005
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603005,
					"content": "Warum Herr Heizou das nicht erlaubte, lag wahrscheinlich daran, dass er Angst hatte, dass Frau Sango in Gefahr geraten könnte. Schließlich handelt es sich um den Mord an einem hochrangigen Mann. Es ist nicht so einfach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603006
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603006,
					"content": "Sango ist zwar die Leiterin der Detektei, aber letztendlich auch ein gewöhnlicher Mensch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603007
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603007,
					"content": "Haben sie eine gute Beziehung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603008
					]
				},
				{
					"id": 190603008,
					"content": "Gut ist es nicht. Ich habe gesehen, dass es jedes Mal krachte, als sich die beiden trafen. Herr Heizou sollte bestimmt Rücksicht auf das alte Verhältnis genommen haben. Ich habe gehört, dass er früher mit Sango zusammengearbeitet hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603009
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603009,
					"content": "Er wies mich manchmal dazu an, ein paar triviale Fälle der Detektei zu übergeben. Ich schätze, er möchte ihnen eine weitere Einnahmequelle verschaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603010
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603010,
					"content": "Ja. Herr Heizou ist ein sehr guter Mensch. Daran besteht kein Zweifel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uesugi"
				}
			]
		},
