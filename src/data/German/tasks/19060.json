						],
						"stepId": 1906002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango",
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190602901,
					"content": "#{F#Reisende}{M#Reisender}, ich bin mir sicher, dass du die Wahrheit aufdecken wirst. Shikanoin ist bestimmt derjenige, der uns mit seinen Tricks belästigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190602902
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190602902,
					"content": "Ach ... Es ist eigentlich ganz klar, dass sowohl Sango als auch Herr Heizou sehr gute Menschen sind. Wieso kracht es immer, wenn sich die beiden treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190602903
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190602903,
					"content": "Ryuuji, sei bitte erwachsen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 1906030,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
