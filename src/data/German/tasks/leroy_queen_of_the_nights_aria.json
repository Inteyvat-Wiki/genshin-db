			"dialogs": [
				{
					"id": 741560401,
					"content": "Paimon ist so nervös! Auf dem Zettel stand doch, dass wir einfach hier auf ihn warten müssen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560402,
						741560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560402,
					"content": "Ja, lass uns geduldig sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				},
				{
					"id": 741560404,
					"content": "Gut, dann warten wir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560405,
					"content": "Nachdem ihr eine Weile ruhig und geduldig gewartet habt, öffnet sich das Fenster mit einem Knarren und ein vertrautes Gesicht erscheint. Benoit schaut sich die Umgebung genau an und klettert vorsichtig hinaus, nachdem er euch beide gesehen hat.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741560406
					]
				},
				{
					"id": 741560406,
					"content": "Benoit, was soll das Ganze ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560407,
					"content": "Schnell, schnell! Wenn ich entdeckt werde, bin ich erledigt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741560403,
					"content": "Es gibt ein paar Fragen, die ich ihm stellen möchte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				}
			]
		},
