			"dialogs": [
				{
					"id": 741560801,
					"content": "Hallo, Vater.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560802
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560802,
					"content": "... Und ich bin erledigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560803
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741560803,
					"content": "Als Autumn mir erzählte, dass du eine Flucht planst, war ich ziemlich überrascht. Wir haben dich schon so lange eingesperrt und trotzdem bist du weder zusammengebrochen noch hast du aufgegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560804
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560804,
					"content": "#Du hast sogar versucht, die Gelegenheit zu nutzen, diese beiden „{M#Freunde}{F#Freundinnen} der Gerechtigkeit“ zu ermutigen, dir bei deiner Flucht zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560805
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560805,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560806,
					"content": "Aber von all den Orten, an die du hättest fliehen können, hast du dich für den Ort entschieden, an dem du oft mit Autumn Ausflüge gemacht hast? Was für ein törichter Fehler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560807
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560807,
					"content": "Ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560808
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741560808,
					"content": "Du musst es nicht erklären. Wenn Menschen in Panik sind, wählen sie ganz natürlich und instinktiv den Weg, der ihnen am vertrautesten ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560809
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560809,
					"content": "Zum Glück ist Autumn nach euch aufgebrochen. Gut, dass sie es noch nicht hierher geschafft hat, ich möchte nicht, dass sie unser nächstes Gespräch hört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560810
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560810,
					"content": "Nun ... Warum hast du das getan? Ich verstehe es wirklich nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560811
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560811,
					"content": "Du hast sie zweimal im Namen der Ehe verkauft, wie eine Ware. Beim ersten Mal hast du sie gegen ein großes Haus am Hof von Fontaine eingetauscht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560812
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560812,
					"content": "Und beim zweiten Mal hast du sie einfach willkürlich mit jemandem verheiratet, nur um sie loszuwerden, sodass der Besitz und alles andere dir allein gehören würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560813
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560813,
					"content": "Sie hat dir sogar ihr Kind aus ihrer zweiten Ehe zur Erziehung anvertraut. Aber als sie geschlagen und gedemütigt wurde, hast du dich einfach entschieden, deinen Blick abzuwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560814
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560814,
					"content": "Und du bist auch ihr Kind losgeworden. Du hast es wahrscheinlich als Adoptivkind an eine reiche Familie verkauft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560815
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560815,
					"content": "Wie schaffst du es, den Kindern trotzdem mit gutem Gewissen Süßigkeiten zu geben und sie als Gäste zu dir nach Hause einzuladen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560816
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560816,
					"content": "Plagt dich dein Gewissen nicht im Geringsten? Ich kann dein Handeln wirklich nicht nachvollziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560817
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560817,
					"content": "Ich habe Autumn erst kennengelernt, als sie auf der Straße lebte. Sie ist eine sehr liebevolle Mutter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560818
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560818,
					"content": "Sie kümmert sich sehr um die Tochter von meinem Freund, Penny. Sie wird nicht aufhören zu fragen, wo Autumn ist, bis sie sie sieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560819
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560819,
					"content": "Oh, und falls du denkst, dass du noch eine Chance hast, den Spieß umzudrehen: Autumn hat jetzt eine ganze Menge Freunde, nicht nur mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560820
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560820,
					"content": "Es spielt keine Rolle, wohin du fliehst. Wir werden dich bis ans Ende von Teyvat jagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560821
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560821,
					"content": "Warum muss ein guter Mensch wie sie unter Verrat und Armut leiden, während ein Schurke wie du ein Leben in Luxus führt? Irgendetwas scheint mir daran nicht richtig zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560822
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560822,
					"content": "Hör auf zu fragen. Er verdient keine Chance zu gestehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560823
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741560823,
					"content": "Ach, du hast es schließlich gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560824
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560824,
					"content": "Oh, du bist also Autumn! Paimon hat endlich eine Ahnung, was hier los ist. Die Familie Leroy ist wirklich kompliziert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560825,
					"content": "#{NICKNAME}, wir haben Benoit bis hierher begleitet, aber es hat sich herausgestellt, dass viele Dinge ganz anders sind, als wir dachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560826,
					"content": "Sollten wir uns jetzt trotzdem weiter einmischen, wo die Dinge so liegen? Du triffst die Entscheidung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
