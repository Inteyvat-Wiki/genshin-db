					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561212,
					"content": "Nein, aber ich werde dich ohne Folter sterben lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561213
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561213,
					"content": "*seufz* ... Autumn, du lügst wirklich nie, oder? Jetzt werden wir nie herausfinden, wo sie hin ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561214
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561214,
					"content": "G... Glaubt nicht, dass ihr tun könnt, was ihr wollt! Wir sind hier nicht allein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561215
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561215,
					"content": "Na und? Glaubst du, das wird dich retten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561216
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561216,
					"content": "... Autumn, vergiss es. Gib einfach auf. Sie führt jetzt ein gutes Leben, ihre Eltern sind reich. Und was würdest du überhaupt tun, wenn du sie findest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561217
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561217,
					"content": "Würdest du sie dazu bringen, mit dir zu fliehen? Du bist ein Ausbrecher aus dem Fort Méropide! Willst du, dass sie ein ähnliches Leben wie du hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561218
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561218,
					"content": "Sie wurde also adoptiert ... Warum hast du mir das nicht gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561219
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561219,
					"content": "Sie führt jetzt ... ein gutes Leben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561220
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561220,
					"content": "Verschone mich, Autumn. Mich zu töten wird dir nichts bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561221
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561221,
					"content": "Hat sie eine Mutter, die sich um sie kümmert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561222
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561222,
					"content": "Ja! Und ihre Adoptivmutter ist sehr gut zu ihr. Sie kann sich besser um sie kümmern als du und ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561223
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561223,
					"content": "Was bringt es dann, sie zu finden ... Wohin soll das führen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561224
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561224,
					"content": "Ja, das bringt doch nichts! Alles, was ich am Hof von Fontaine habe, gehört jetzt dir. Ich will nichts mehr, lass mich einfach gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561225
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561226
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561226,
					"content": "Autumn, warum sagst du nichts? Willst du ihn wirklich gehen lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561227
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561227,
					"content": "Tss, Benoit, glaubst du wirklich, du kannst noch entkommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561228
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561228,
					"content": "Ich werde nicht tatenlos zusehen, wie ihr Benoit verletzt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561229
					]
				},
				{
					"id": 741561229,
					"content": "Warum müsst ihr euch in die Angelegenheiten anderer Menschen einmischen, die euch völlig unbekannt sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561230
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561230,
					"content": "Selbstgerechte Schleimer, das seid ihr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561231
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561231,
					"content": "Autumn, willst du ihn wirklich gehen lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561232
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561232,
					"content": "I... Ich weiß nicht ... Ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561233
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561233,
					"content": "*seufz* Du bist immer so weichherzig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561234
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561234,
					"content": "#Benoit, du scheinst heute Glück zu haben. Ein Kind ist die größte Schwäche einer Mutter wie Autumn. Und da {F#sie}{M#er} sich entschlossen hat, dich zu beschützen, lasse ich dich dieses Mal am Leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561235
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561235,
					"content": "Aber das spielt keine Rolle. Versuch nur, so weit wie möglich zu fliehen. Mal sehen, ob du es bis zu einem Ort schaffst, den wir nie finden werden, bevor wir dich schnappen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561236
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561236,
					"content": "Übrigens, ich hoffe, du verstehst das nicht falsch. Ich werde nicht der einzige sein, der dich bis ans Ende des Kontinents jagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561237
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561237,
					"content": "Wir haben viele Freunde im Fort Méropide. Vor unserer Reise an den Hof von Fontaine haben viele von ihnen großes Interesse an einem Treffen mit dir bekundet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561238
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561238,
					"content": "Ihr könnt mein ganzes Vermögen nehmen, alles!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561239
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561239,
					"content": "Es scheint, als wäre heute nicht dein letzter Tag. Ich hoffe aufrichtig, dass du noch ein paar Tage überleben kannst, damit meine Freunde nicht enttäuscht sein müssen, nur eine leblose Leiche zu sehen, wenn sie dich finden. Verschwinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561240
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561240,
					"content": "Benoit flieht in die entgegengesetzte Richtung des Hofes von Fontaine und verlässt euer Blickfeld über den Bergpfad, ohne sich noch einmal umzublicken.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741561241
					]
				},
				{
					"id": 741561241,
					"content": "Und was euch betrifft ... Wir werden den Hof von Fontaine bald verlassen und ich denke, wir werden uns nie wieder sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561242
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561242,
					"content": "Autumn, lass uns gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561243
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561243,
					"content": "... Tut mir leid, Athos ... Mein Kind, sie ist ... Es tut mir so leid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561245
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561244,
					"content": "Schon gut. Das ist etwas, das nur von dir entschieden werden sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561245
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561245,
					"content": "Lass uns gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561246
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561246,
					"content": "Das ist also die ganze Geschichte. Was für eine komplizierte Familie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561247,
					"content": "Paimon weiß wirklich nicht, was Paimon jetzt sagen soll ... Aber Paimon tut Autumn leid, sie hat ihr Kind am Ende nicht gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561248,
					"content": "Wie auch immer, zumindest haben wir verhindert, dass jemandes Blut vergossen wird. Das ist doch gut genug, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}