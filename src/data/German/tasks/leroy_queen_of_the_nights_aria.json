			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Morticia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741561101,
					"content": "Sie sollten sich selbst darum kümmern. Ich werde mich nicht einmischen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561102
					]
				},
				{
					"id": 741561102,
					"content": "Liebe Autumn, willst du das wirklich tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561103
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561103,
					"content": "Welches Mädchen am Fleuve Cendré hatte so viel Glück wie du? Deine Süßigkeiten, deine Seidenkleider und deine Bücher, für all das brauchte man Geld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561104
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561104,
					"content": "Während andere Kinder in den kalten Nächten hungerten, hast du deinen Hund mit Kleid und Halskette eingekleidet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561105
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561105,
					"content": "Ich habe dir dein Leben verdient. Meinst du nicht, dass du dich bei mir revanchieren solltest? Nichts auf dieser Welt ist umsonst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561106
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561106,
					"content": "War ich hart zu dir? Ich war großzügig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561107
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561107,
					"content": "Autumn, denke genau zurück. Welchen Abschnitt deines Lebens habe ich nicht sorgfältig für dich vorbereitet? Jeden falschen Schritt, den du gemacht hast, hast du selbst gewählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561108
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561108,
					"content": "Herr Benoit, du bist wirklich ein Meister der Sophistik. Deine Großzügigkeit ist nichts weiter als ein Mittel, um deine egoistischen Ziele zu erreichen. Letztendlich geht es doch nur um dich, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561109
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561109,
					"content": "Du hast mir das alles nur gegeben, um mich wie ein Schlachttier zu mästen. Schluss mit den Lügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561110
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561110,
					"content": "Die einzige Gnade, die ich dir gewähre, ist ein schneller Tod. Aber vorher musst du mir sagen, wo mein Kind ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561111
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561111,
					"content": "Es gibt keine einzige Spur von ihr, weder in der alten Wohnung noch in dem Haus, in dem du jetzt wohnst. Wo hast du sie hingeschickt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561112
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561112,
					"content": "Wirst du mein Leben verschonen, wenn ich es dir sage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561113
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561113,
					"content": "Nein, aber ich werde dich ohne Folter sterben lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561114
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561114,
					"content": "... Tod so oder so, alles das Gleiche. Hehe ... Warum sollte ich dir dann den Gefallen tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561115
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561115,
					"content": "*seufz* ... Autumn, du lügst wirklich nie, oder? Jetzt werden wir nie herausfinden, wo sie hin ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561116
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561116,
					"content": "Ich weiß, wo sie ist. Hehe ... Aber ich werde es dir niemals sagen, niemals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561117
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561117,
					"content": "Niemals ... Du wirst sie niemals finden ... Niemals ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561118
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561118,
					"content": "Ich werde ihn in sein Haus zurückbringen. Hat jemand von euch Einwände?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561119
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561119,
					"content": "Nein. Wir mischen uns nicht ein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561120
					]
				},
				{
					"id": 741561120,
					"content": "K... Kümmert ihr euch selbst darum! Das ist nicht unsere Sache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561121,
					"content": "Benoit wiederholt wieder und wieder „niemals“, als Autumn ihn schweigend wegbringt.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741561122
					]
				},
				{
					"id": 741561122,
					"content": "Ich hatte eigentlich nicht vor, Fremden etwas davon mitzuteilen. Immerhin liegt gegen sie ein Haftbefehl vor. Und falls es euch interessiert, gegen mich auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561123
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561123,
					"content": "Wenn ihr jetzt zur Maison Gardiennage geht und eine Anzeige erstattet, könnt ihr vielleicht eine hohe Belohnung erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561124
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561124,
					"content": "Aber ich würde euch davon abraten. Unsere Freunde werden euch nicht vergessen, wenn ihr das tut. Und ihr könnt selbst herausfinden, ob ich die Wahrheit sage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561125,
						741561126
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561125,
					"content": "Ich bin kein Klatschmaul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				},
				{
					"id": 741561127,
					"content": "Haha, das habe ich mir schon gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561128
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561128,
					"content": "Dann ist diese Regenbogenrose für dich. Wir schätzen diese Blume wegen ihrer reichen Symbolik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561129
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561129,
					"content": "Und gerade jetzt symbolisiert sie eine Warnung. Eine Warnung an dich, deine Meinung nicht zu ändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561130
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561130,
					"content": "Lebewohl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561131
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561131,
					"content": "Das ist also die ganze Geschichte. Was für eine komplizierte Familie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561132,
					"content": "Paimon weiß wirklich nicht, was Paimon jetzt sagen soll. Und Paimon findet es gut, dass wir diesen Fall nicht zu früh der Maison Gardiennage gemeldet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561133,
					"content": "Es ist nur schade, dass Autumn ihr Kind am Ende nicht gefunden hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561134,
					"content": "Und Paimon dachte, Benoit sei ein netter Kerl! Ähm ... Ist Paimon vielleicht ... sehr leicht zu täuschen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561135,
						741561136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561135,
					"content": "Boah, und das merkst du erst jetzt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561137,
					"content": "He! Hör auf, Paimon auszulachen! Hmpf! Paimon wird dir nicht verzeihen, wenn du Paimon nicht zu einem Festmahl im Hotel Debord einlädst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561136,
					"content": "Du Dummchen, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561126,
					"content": "Ich bin nicht knapp bei Kasse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				}
			]
		},
