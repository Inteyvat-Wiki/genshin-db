			"dialogs": [
				{
					"id": 220280501,
					"content": "Hier ist es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280502
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280502,
					"content": "Ich habe gehört, dass ein Doushin hier vor langer, langer Zeit viele Papierkraniche geopfert hat, mit dem Wunsch, dass alle in Hanamizaka friedlich leben können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280503
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280503,
					"content": "Kurz darauf brach in der Nähe ein Feuer aus und ein Haus fing Feuer. Das Haus war aber sowieso mit minderwertigen Materialien gebaut, sodass das Feuer es schnell zerstörte und es sich nicht ausbreiten konnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280504
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280504,
					"content": "Jeder glaubt, dass dies der Schutz des Archons war ... Hehe, deshalb habe ich auch einige Papierkraniche gefaltet und hierher gebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280505
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280505,
					"content": "Und das ist genug geplaudert! Was sollen wir denn dieses Mal anbieten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280506
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280506,
					"content": "Wir könnten eine Antwort bekommen, wenn wir Papierkraniche anbieten, genau wie dieser Doushin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280507
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280507,
					"content": "Aber da dieser Schrein in der Nähe der Teestube ist, wäre es besser, wenn wir eine Opfergabe von Konfekt mit Matcha-Geschmack machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280508
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280508,
					"content": "Ja, und Konfekt mit Matcha-Geschmack sind auch Dinge, die ich mag ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280509
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280509,
					"content": "Was denkst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
