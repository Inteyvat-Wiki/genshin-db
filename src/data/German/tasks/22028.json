			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shouta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220280101,
					"content": "Hör nur zu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280102
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280102,
					"content": "Nachdem ich dem Schrein vom letzten Mal eine Opfergabe gemacht habe, wurde mein Wunsch erfüllt ... ein kleiner Teil davon zumindest! Aber auch wenn es nur ein kleiner Teil ist ... das muss die Antwort des Archons sein, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280103
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280103,
					"content": "Was war dein Wunsch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280104
					]
				},
				{
					"id": 220280104,
					"content": "Äh ... der Wunsch, den ich beim letzten Mal geäußert habe, war, dass der Schöpfer des Mangas, den ich lese, produktiver sein möge. Ein neuer alle zwei Tage wäre das Beste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280105
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280105,
					"content": "Und dann hat der Macher tatsächlich die Menge der aktualisierten Inhalte in einer Ausgabe verdoppelt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280106
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280106,
					"content": "Allerdings ... Ich habe auch gehört, dass er für 3 Ausgaben eine Pause einlegen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280107,
						220280108
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280107,
					"content": "Perfekt ausbalanciert, wie alle Dinge sein sollten, denke ich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				},
				{
					"id": 220280109,
					"content": "Hmm ... wie auch immer, ich bin mir sicher, dass der Archon meine Wünsche gehört hat. Das bedeutet, dass der Grund, warum sie nicht in Erfüllung gegangen sind, ist, dass ich nicht genug Dinge dargebracht habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280110
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280110,
					"content": "Also werden wir heute eine Opfergabe an andere Schreine bringen! Auf diese Weise werden meine Wünsche sicher vollständig erfüllt werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280111
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280111,
					"content": "Ich habe meine Eltern gefragt und sie sagen, dass es hier in der Nähe noch zwei Schreine gibt. Einer ist in der Nähe der Teestube Komore und der andere liegt auf dem Weg aus der Stadt heraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280112
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280112,
					"content": "Zu welchem Schrein sollten wir deiner Meinung nach zuerst gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280108,
					"content": "Fühlt sich an, als wäre insgesamt eine Ausgabe weniger veröffentlicht worden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				}
			]
		},
