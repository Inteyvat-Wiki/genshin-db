			"dialogs": [
				{
					"id": 220280901,
					"content": "Hier ist es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280902
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280902,
					"content": "Vor langer Zeit brachte jemand diesem Schrein eine Opfergabe mit Eisenerz, das zum Schmieden von Klingen verwendet wird, in der Hoffnung, dass sich seine Kampfkunstfähigkeiten schnell verbessern würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280903
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280903,
					"content": "Später ging dieser Typ zu einem Kampfsportturnier und besiegte jeden Gegner superleicht! Jeder lobte seine herausragenden kämpferischen Fähigkeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280904
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280904,
					"content": "Ihm zufolge schienen seine Gegner jedoch alle nicht bei bester Gesundheit zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280905,
						220280906
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280905,
					"content": "Es fühlt sich so an, als ob der Archon nicht sehr klare Standards hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280907
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280907,
					"content": "Aber wie auch immer, jeder denkt, dass der Archon es getan hat. Deshalb denke ich, dass wir eine Antwort bekommen werden, wenn wir uns etwas an diesem Schrein wünschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280908
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280908,
					"content": "Und das ist genug geplaudert! Was sollen wir denn dieses Mal darbringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280909
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280909,
					"content": "Genau wie dieser Kerl können wir vielleicht eine Antwort bekommen, wenn wir Eisenerz anbieten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280910
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280910,
					"content": "Ich habe einige in der Nähe des Eingangs der Schmiede gefunden. Allerdings sehen sie nicht besonders gut aus, weshalb der Schmied sie mir wohl gern gegeben hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280911
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280911,
					"content": "Ich habe auch etwas frisches Seegras aus der Gegend gesammelt. Wenn ich sie koche und mit etwas Zucker bestreue ... schmecken sie bestimmt fantastisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280912
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280912,
					"content": "Ich bin mir nur nicht sicher, ob der Archon diese Art von kleinen Gerichten mag ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280913
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280913,
					"content": "Was denkst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280906,
					"content": "Machst du wirklich Fortschritte, wenn andere Leute einfach zurückfallen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280907
					],
					"speakerTitle": "Shouta"
				}
			]
		},
