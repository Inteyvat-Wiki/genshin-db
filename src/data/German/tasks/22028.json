					"nextDialogs": [
						220281201
					]
				},
				{
					"id": 220281201,
					"content": "Toll! Lass uns genau das tun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220281202
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220281202,
					"content": "Hoffentlich antwortet mir der Archon auch dieses Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220281203
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220281203,
					"content": "Ich werde morgen wieder hier sein, um zu sehen, ob etwas Besonderes passiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220281204
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220281204,
					"content": "Vielen Dank, dass du die ganze Zeit bei mir geblieben bist. Bitte nimm die hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220281205
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220281205,
					"content": "Ich hoffe, dass der Archon wirklich auf meine Wünsche eingehen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
