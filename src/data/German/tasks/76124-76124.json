			},
			"dialogs": [
				{
					"id": 761240301,
					"content": "Alles klar, das war’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240302
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240302,
					"content": "#Vielen Dank, ihr zwei. Das hat mir wirklich Spaß gemacht. Besonders {M#der blonde Junge}{F#das blonde Mädchen} hier hat einiges auf dem Kasten und ist wohl viel stärker als die Guhua-Jungs, die ich kenne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240303,
						761240304
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240303,
					"content": "Ich bin eben klasse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240306
					]
				},
				{
					"id": 761240306,
					"content": "Dank euch beiden habe ich nach langer Zeit eine neue Erkenntnis gewonnen. Die Fischpaste braucht unbedingt etwas gehacktes, frisches Fleisch für den Geschmack, sonst lässt sich der Fischgeruch nicht überdecken, wenn sie länger steht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240307
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240307,
					"content": "Oh, Paimon versteht, Paimon ver... Warte, das hat doch überhaupt nichts mit dem Thema zu tun, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240308,
					"content": "Haha, das ist doch nur eine Kleinigkeit! Wenn ich mir das nächste Mal mehr Fische von Castiglione malen lasse, lade ich euch auf etwas Fischpaste ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240304,
					"content": "Das war keine große Sache.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240305
					]
				},
				{
					"id": 761240305,
					"content": "Ha, kein Grund zur Bescheidenheit. Dein Umgang mit dem Schwert ist echt stark, das erkenne ich durchaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240306
					],
					"speakerTitle": "Jinggui"
				}
			]
		},
