				]
			},
			"dialogs": [
				{
					"id": 761240401,
					"content": "Nanu? Hier scheint noch ein Gemälde zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240402,
					"content": "Aha, gutes Auge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240403
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240403,
					"content": "Das ist das Ding, das diese Kinder, die sich Guhua-Erben nennen, bei Castiglione in Auftrag gegeben haben. Sie meinten, das sei ihr stolzer „Trainingsplatz“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240404
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240404,
					"content": "Aber die sind ja ziemlich eingebildet. Die halten sich für absolute Profis und meinen, so ein Grundlagentraining hätten sie längst nicht mehr nötig. Also haben sie mir das Bild geschenkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240405
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240405,
					"content": "Hä? Gehörst du etwa nicht zur Guhua-Schule?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240406,
					"content": "Hahaha. Ich wünschte, ich könnte das von mir behaupten. Ist zwar wirklich schade, aber der Guhua-Junge hat wohl nicht den Mumm, mich aufzunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240407
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240407,
					"content": "Als wir damals in der Guili-Ebene Banditen jagten, hat der Junge wegen seiner Unerfahrenheit fast sein Leben verloren. Ich musste ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240408
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240408,
					"content": "Ach, lassen wir das. Das sind alles alte Kamellen. Aber dieses Bild hier, das ist schon irgendwie interessant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240409
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240409,
					"content": "Wenn du Interesse hast, roll es aus und schau es dir an. Wenn du es dabei zerreißt, ist das auch nicht schlimm. Castiglione hat sowieso den ganzen Tag nichts zu tun, dann soll er einfach ein neues malen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				}
			]
		}
	]
}