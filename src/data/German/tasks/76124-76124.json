				},
				{
					"id": 761240203,
					"content": "Alles klar, ihr zwei! Da das Bild nun entrollt ist, erkläre ich euch im Namen der Kinder der Guhua-Schule mal die Regeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240204
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240204,
					"content": "Von diesen Bambusfiguren tragen einige <color=#00E1FFFF>blaue Kleidung</color>, während andere <color=#FF5E41FF>rote Kleidung</color> anhaben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240205,
						761240206
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240205,
					"content": "Oh, das ist wie damals in der Wangshan-Halle ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240207
					]
				},
				{
					"id": 761240207,
					"content": "Paimon erinnert sich auch wieder! Wir müssen präzise alle <color=#00E1FFFF>blau gekleideten</color> Bambusfiguren treffen. Aber wir dürfen die Bambusfiguren in <color=#FF5E41FF>roter Kleidung</color> nicht treffen, stimmt’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240208,
					"content": "Haha, ganz genau! Dann muss ich ja nicht mehr viel erklären. Zeig mir, wie gut du mit dem Schwert umgehen kannst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240206,
					"content": "Ich kenne die Regeln.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240207
					]
				}
			]
		},
