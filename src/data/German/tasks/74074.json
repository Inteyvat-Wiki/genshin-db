			"dialogs": [
				{
					"id": 740742001,
					"content": "Ihr habt die Oberseite der Vorrichtung untersucht, ohne etwas zu entdecken.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740742002
					]
				},
				{
					"id": 740742002,
					"content": "Hier ist auch nichts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740742003,
					"content": "Caterpillar, kannst du uns sagen, wonach wir eigentlich suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742004
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740742004,
					"content": "Wir suchen nach Materialien zum Schmieden des heiligen Schwerts des Narzissenkreuzes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742005
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742005,
					"content": "Basierend auf dem Mystizismus des Unterweltreiches und des antiken Fontaines hat der Narzissenkreuz-Verein die vier Arten von erforderlichen fiktiven Substanzen in der materiellen Welt neu erschaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742006
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742006,
					"content": "Das ist unbegreiflich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742007
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740742007,
					"content": "Mystische Dinge dieser Art erschließen sich einem nur durch die direkte Erfahrung. Man könnte sagen, dass sie die Vorstellungskraft eines Menschen noch weiter übersteigen als die Elementarkräfte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742008
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742008,
					"content": "Vor einigen Jahrzehnten habe ich einmal die Stoffkundelehrmaterialien der Sumeru-Akademie abgespeichert, von den Grundlagen bis hin zur mittleren Stufe. Die Elementarkräfte sind eigentlich nicht so mystisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742009
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740742009,
					"content": "Ach so? Jedenfalls kann man zusammenfassend sagen, dass es sich um eine Verbindung von antiken Praktiken aus Fontaine und den Techniken des Unterweltreichs handelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742010
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742010,
					"content": "Auf der Welt sind die folgenden vier Arten von Substanzen aufgetreten: „Erinnerung“, „Wunsch“, „Seele“ und „Persönlichkeit“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742011
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742011,
					"content": "Um Missverständnisse zu vermeiden, nennen wir sie Brocken der „Erinnerung“, Brocken des „Wunsches“, Brocken der „Seele“ und Brocken der „Persönlichkeit“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742012
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742012,
					"content": "Wie kommt es, dass man solche Dinge zum Schmieden des heiligen Schwerts braucht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740742013,
					"content": "Im Mystizismus des Narzissenkreuz-Vereins ist der Tempel ein Mikrokosmos des Universums, die Mitglieder sind die Stellvertreter der Götter und das heilige Salböl ist die geschmiedete Willenskraft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742014
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742014,
					"content": "Und das heilige Schwert hingegen ist die „Vernunft“, die alles spalten kann. Sie kann nur aus dem Willen eines vollkommenen Menschen geboren werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742015
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742015,
					"content": "Wie esoterisch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740742016
					]
				},
				{
					"id": 740742016,
					"content": "Tja, so ist der Mystizismus nun einmal. Wenn zwei Objekte sich ähnlich genug sind, würde man eine Verbindung zwischen ihnen herstellen. Und wenn man die Magie hat, solche Dinge zu realisieren, dann werden Illusionen zur Realität.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742017
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742017,
					"content": "Nun, wir sollten uns schnell auf dem Weg zum nächsten Ort machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
