			"dialogs": [
				{
					"id": 740740101,
					"content": "... Solltest du stattdessen nicht eher bemerken, dass in deinem Blickfeld ein Mann auf dem Boden liegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740102
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740740102,
					"content": "Ah? Boah! Was ist denn da passiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740103,
					"content": "Tut mir leid, Fräulein. Gerade habe ich der Suche nach der Steinplatte höchste Priorität eingeräumt. Erlaube mir nun, die Umgebung abzutasten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740104
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740104,
					"content": "... Tut mir sehr leid, Fräulein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740105
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740105,
					"content": "Was?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740106,
					"content": "Obwohl er noch lebt, ist der Hauch des Lebens bereits aus seinen Körperöffnungen entwichen. Ich kenne diese Methode ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740107
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740107,
					"content": "*wimmer* Paimon will gar nicht hinsehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740108,
					"content": "Lasst uns schnell Hilfe suchen! Wir können nicht einfach tatenlos danebenstehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740109,
					"content": "Ihr habt den ohnmächtigen Mann zum Lumidouce-Hafen zurückgebracht.\\nDie Leute am Hafen haben ihn dann sofort ins Krankenhaus gebracht.\\nErleichtert kehrt ihr dann an den ursprünglichen Ort zurück.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740740110
					]
				},
				{
					"id": 740740110,
					"content": "Nun, lass uns die Steinplatte einmal näher betrachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740111,
					"content": "„Dieser Ort ist der Orthant des Wunsches, der Tempel des Wunsches, die Kammer des Wunsches.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740112
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740112,
					"content": "„Oft widersprüchlich“ ... „In einem Augenblick geboren, ewige Ruhe bei dir, immer vereint“ ... „Befleckt mit den Folgen der Sünde“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740113
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740113,
					"content": "Wieder ein Rätsel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740114
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740114,
					"content": "Wieso fand in diesem Ort eine derart schreckliche Sache statt ... Steht sie mit dem Rätsel in einer Verbindung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740115,
					"content": "Weil die Menschen von Fontaine „Sünder“ sind ... Ein mit der „Erbsünde beflecktes“ Leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740116
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740116,
					"content": "Daher ist die Lösung „Leben“. Ich habe sie bereits erraten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740117
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740117,
					"content": "Bist du dir sicher, dass das die Lösung ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740118
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740740118,
					"content": "Ich bin nur allzu gut mit dem linguistischen Symbolsystem des Narzissenkreuz-Vereins vertraut. Es wäre sehr überraschend, wenn das nicht die richtige Lösung wäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740119
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740740119,
					"content": "Also gut, dann lasst uns loslegen, es gilt keine Zeit zu verlieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
