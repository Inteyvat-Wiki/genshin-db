					"nextDialogs": [
						740742102
					]
				},
				{
					"id": 740742102,
					"content": "Wurde das Ding, das hier war ... auch von jemandem weggenommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740742103,
					"content": "Es sieht wohl so aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742104
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742104,
					"content": "Wer kann das nur gewesen sein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740742105
					]
				},
				{
					"id": 740742105,
					"content": "Es war Jakob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742106
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742106,
					"content": "Wir sind in Elynas einmal aneinandergeraten. Korrektur: Vor Kurzem, nicht „einmal“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740742107,
					"content": "Als ich das tragische Opfer am Tor gesehen habe, wusste ich gleich, dass er es war. Es scheint, dass er doch noch aktiv ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742108
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742108,
					"content": "Aber warum hat er das Ding hier mitgenommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740742109,
					"content": "Das ist leicht zu beantworten. Auch er will das heilige Schwert des Narzissenkreuz-Vereins neu schmieden. Denn das Werk von Narzissenkreuz ist noch nicht vollendet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742110
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740742110,
					"content": "Nun, wir sollten uns besser schnell auf dem Weg zum letzten Ort machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
