			"dialogs": [
				{
					"id": 740741901,
					"content": "Ihr habt die Oberseite der Vorrichtung untersucht, ohne etwas zu entdecken.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740741902
					]
				},
				{
					"id": 740741902,
					"content": "Am Ende ist hier also gar nichts zu finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740741903,
					"content": "Nicht wirklich. Es sieht so aus, als wäre hier etwas gewesen, aber jemand anderes hat es schon genommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741904
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740741904,
					"content": "Ah! Heißt das, dass unser Plan gescheitert ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740741905,
					"content": "Die Geburt der „Vernunft“ erfordert die Vereinigung der vier Orthanten. Solange wir die restlichen bekommen, haben wir eine Chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741906
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740741906,
					"content": "Dann sollten wir besser schnell zum nächsten Ort gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		},
		{
