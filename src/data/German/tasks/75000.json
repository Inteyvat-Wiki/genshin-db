				{
					"id": 750000903,
					"content": "... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000904
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000904,
					"content": "#Ihm gefällt dieser Name! Hehe, Paimon hofft, dass wir bald in Natlan das Rätsel um dich lösen können ... und dass wir herausfinden können, wieso {NICKNAME} auf einmal in den Körper eines Drachen schlüpfen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000905,
					"content": "#Ach ja, {NICKNAME}, dir ist doch nichts passiert, als du dich in einen Drachen verwandelt hast, oder? Ist dir nicht schlecht gewesen oder so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000906,
						750000908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000906,
					"content": "Doch, ich fühlte mich drachenelend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000907
					]
				},
				{
					"id": 750000907,
					"content": "Was soll das überhaupt bedeuten!? Jetzt ist nicht die Zeit für Witze! Hmpf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000910,
					"content": "#Wie dem auch sei, {NICKNAME}, Paimon hat nie gehört, dass die Menschen in Natlan zu Drachen werden können ... Das ist, gelinde gesagt, seltsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000911,
					"content": "Wir sind gerade in Natlan angekommen und schon ist so viel passiert ... Wie kommen wir hier bloß wieder raus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000912,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000913
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000913,
					"content": "Hmm? Kennst du den Weg nach draußen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000908,
					"content": "Ab und zu mal ein Drache zu sein, ist wirklich toll.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000909
					]
				},
				{
					"id": 750000909,
					"content": "Nun, das sollte auch so bleiben! Was ist, wenn du dich in einen Drachen verwandelst und nicht mehr in deinen Körper zurückkehren kannst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "Paimon"
				}
			]
		},
