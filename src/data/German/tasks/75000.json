			"dialogs": [
				{
					"id": 750000901,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}. Du bist ab jetzt {REALNAME[ID(2)|SHOWHOST(true)]}, Kleiner!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000902
					],
					"speakerTitle": "Paimon"
				},
