			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200460101,
					"content": "Gut ... ich versuche auch, den Auftrag heute zu beenden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460102,
						200460106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460102,
					"content": "Was für eine Motivation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460103
					]
				},
				{
					"id": 200460103,
					"content": "Das ist sicher. Es macht Spaß, ein Abenteurer zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460104,
					"content": "Aber ... He, es gibt immer noch eine Menge Dinge, mit denen ich nicht vertraut bin, wenn ich einen Auftrag ausführe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460105,
					"content": "#{F#Reisende}{M#Reisender}, könntest du mich bitte zu einem weiteren Auftrag begleiten? Ich würde dich gern noch etwas anderes fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460108
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460108,
					"content": "Also los geht’s, der heutige Auftrag lautet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460109,
					"content": "Begleite den Transportballon ... Schon wieder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460106,
					"content": "Soll ich mitkommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460107
					]
				},
				{
					"id": 200460107,
					"content": "Ist das in Ordnung? He, ich habe eine Menge Fragen, die ich dir gern stellen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460108
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2004602,
			"completionStepIds": [
				2004604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2004604",
							"2"
						],
						"stepId": 2004604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200460201,
					"content": "#Erledigt! Danke, {F#Reisende}{M#Reisender}, die Eskorte ist gut gelaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460202,
					"content": "Aber ist das die Art von Dingen, die Abenteurer normalerweise als Auftrag haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460203,
						200460205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460203,
					"content": "Es gibt auch andere Aufträge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460204
					]
				},
				{
					"id": 200460204,
					"content": "Du klingst auch so hilflos ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460207,
					"content": "Ist das so ... gut! Dann werde ich es weiter versuchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460208
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460208,
					"content": "Wenn ich genug Geld gespart habe, werde ich mit meinem Bruder und meinen Eltern eine Reise machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460209
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460209,
					"content": "Mein Bruder wollte schon früher eine Reise machen, aber ... Er musste bleiben und sich um mich kümmern, weil ich krank war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460210
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460210,
					"content": "Jetzt habe ich mich von meiner Krankheit erholt und bin eine Abenteurerin geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460211
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460211,
					"content": "Es ist an der Zeit, meinem Bruder zu helfen, sich einen Traum zu erfüllen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460205,
					"content": "Du wirst es mit der Zeit wissen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460206
					]
				},
				{
					"id": 200460206,
					"content": "He, schau nicht so müde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460207
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2004603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2004601",
							"3"
						],
						"stepId": 2004601,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200460301,
					"content": "#{F#Reisende}{M#Reisender}, kümmere dich bitte um Anna, sie scheint in letzter Zeit überaktiv zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200460302,
					"content": "Willst du nicht, dass sie eine Abenteurerin wird?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460303
					]
				},
				{
					"id": 200460303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200460304,
					"content": "Ich respektiere den Traum meiner Schwester.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200460305,
					"content": "Sie konnte sich von ihrer Krankheit erholen und hat die Möglichkeit, ihren Traum zu verwirklichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200460306,
					"content": "Als ihr Bruder werde ich sie voll unterstützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200460307,
					"content": "So sieht’s aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
	]
}