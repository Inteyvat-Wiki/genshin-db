					"Chronie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740880601,
					"content": "Puh ... Ich kann immer noch nicht vergessen, wie Choiseul immer wieder um den heißen Brei herumgeredet hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880602
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740880602,
					"content": "Und dieser Raimondo ... Der Kerl ist aufgeblasen und arrogant. Ist dir aufgefallen, wie er mich angesehen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880603
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740880603,
					"content": "Ich denke, du bist viel besser als die beiden. Wenn du in ihrer Position wärst, würdest du garantiert nicht so werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chronie"
				}
			]
		}
	]
