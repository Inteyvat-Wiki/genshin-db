			"dialogs": [
				{
					"id": 740880401,
					"content": "#Hier müsste es auch einen „Überwachungsanker“ geben. Ich öffne euch die Tür. Die Bergung ist nun deine Aufgabe, danke, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
