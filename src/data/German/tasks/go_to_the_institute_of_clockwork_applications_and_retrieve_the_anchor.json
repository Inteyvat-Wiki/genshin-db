		},
		{
			"id": 7408805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nacker"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740880501,
					"content": "Das müsste Butors „Forschungszentrum für angewandte Uhrwerktechnik“ gewesen sein. Auf dem Gebiet der traditionellen Uhrwerktechnik ist Herr Butor eine absolute Autorität.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880502
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880502,
					"content": "Aber ... vom akademischen Standpunkt aus betrachtet, sind Entwicklung und Verbesserung der traditionellen Uhrwerktechnik an einem toten Punkt angelangt. Und aus der Anwendungsperspektive sind die Nachteile der traditionellen Uhrwerktechnik auch zu offensichtlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880503
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880503,
					"content": "Kurz gesagt, Herrn Butors Forschung ist im Institut allmählich in den Bereich der Belanglosigkeit abgerutscht. Das heißt, dass ihm nicht nur die Mittel reduziert wurden, sondern er auch keine Forscher mehr findet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880504
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880504,
					"content": "Nach einer Serie unglücklicher Ereignisse wurde Herrn Butors Forschungsgruppe komplett aufgelöst und dieser Ort ist buchstäblich verwaist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880505
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880505,
					"content": "Oh, lass mich dir erzählen, Herr Butor wurde wirklich vom Pech verfolgt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nacker"
				}
			]
		},
		{
			"id": 7408806,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
