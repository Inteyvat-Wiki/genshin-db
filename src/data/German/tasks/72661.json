				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujirai Momiji",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610601,
					"content": "Ihr seid endlich zurück, hm? Jiawei ist nicht mitgekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610602
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610602,
					"content": "Er ist im Dorf geblieben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610603
					]
				},
				{
					"id": 726610603,
					"content": "Oh? Ist er zum Familienmenschen geworden? Haha! Das klingt ganz nach ihm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610604
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610604,
					"content": "Immerhin war das ja sein Wunsch ... Gut, aus diesem Grund vergebe ich ihm, dass er nicht mitkommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610605
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610605,
					"content": "Was ist mit Nantuck? Habt ihr ihn gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610606
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610606,
					"content": "Er hat einen Bestseller geschrieben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610607
					]
				},
				{
					"id": 726610607,
					"content": "Hätte nie gedacht, dass er wirklich mal Autor wird. Er muss Talent haben. Also, worüber hat er geschrieben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610608
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610608,
					"content": "Paimon weiß es! Paimon weiß es! Das Buch heißt „Über die Tatsache, dass der Mond-Leviathan in Wirklichkeit eine gigantische Meeresschildkröte ist“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610609,
					"content": "Oh, das ist ein langer Name ... Ist es eine Kurzgeschichte? Nicht schlecht ... Ich werde es mir kaufen und lesen ... Hm? Moment mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610610
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610610,
					"content": "„Über die Tatsache, dass der Mond-Leviathan in Wirklichkeit ...“ Er ist in Wirklichkeit eine ...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610611
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610611,
					"content": "Mhmm, das ist tatsächlich eine gigantische Meeresschildkröte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610612
					]
				},
				{
					"id": 726610612,
					"content": "Wovon spricht der Kerl da? Wie soll es bitte eine gigantische Meeresschildkröte sein? Hat er etwa vergessen, dass wir den „Mond-Leviathan“ mit unseren eigenen Augen gesehen haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610613
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610613,
					"content": "Wir konnten es erst nicht glauben ... bis wir zum Drachengrat gegangen sind und das Fossil des „Mond-Leviathans“ gefunden haben ... Hier, bitte sehr, das Buch und das Fossil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610614,
					"content": "Nein, das glaube ich nicht. Das ist nicht wahr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610615
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610615,
					"content": "Du verstehst nicht. Unsere Familie entstammt einer langen Blutlinie von Fischern und auch mein Vater ist ein berühmter Fischer in Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610616
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610616,
					"content": "Er hat Jahrzehnte damit verbracht, den „Mond-Leviathan“ auf dem Meer zu jagen und einmal hätte er sogar fast Erfolg gehabt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610617
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610617,
					"content": "Obwohl am Ende nichts dabei herauskam, gab mein Vater nicht auf. Für einen Fischer wäre es eine große Ehre, den legendären „Mond-Leviathan“ zu fangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610618
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610618,
					"content": "Doch von seinem nächsten Ausflug aufs Meer ... kehrte er nie zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610619
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610619,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610620
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610620,
					"content": "Deshalb werde ich diesen Worten nicht so einfach Glauben schenken. Helft mir bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610621
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610621,
					"content": "Was hast du denn dann vor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610622
					]
				},
				{
					"id": 726610622,
					"content": "Ich gehe zurück und finde die Sachen, die mein Vater zurückgelassen hat. Er jagte den „Mond-Leviathan“ sein ganzes Leben lang und hat darüber einige Informationen hinterlassen. Ich bin sicher, dass ich einen Weg finden kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610623
					],
					"speakerTitle": "Kujirai Momiji"
				},
				{
					"id": 726610623,
					"content": "Ich habe ein Fischertraining für dich vorbereitet. Bitte warte auf Neuigkeiten von mir. Ich werde dich dann um Hilfe bitten müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujirai Momiji"
				}
			]
		},
		{
			"id": 7266107,
