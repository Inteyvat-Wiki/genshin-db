							"7266113",
							"2"
						],
						"stepId": 7266113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Altmodischer Qi",
					"Tollpatschiger Bazi",
					"Kouzen",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610701,
					"content": "He, ihr da! Denkt ihr, dass dieser lausige Stein irgendwas wert ist? Er ist so selten, dass er in Erz versteckt war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610702
					],
					"speakerTitle": "Altmodischer Qi"
				},
				{
					"id": 726610702,
					"content": "Oh, bitte ... lausiger Stein? Hast du in deinem Leben schon jemals ein Buch in die Hand genommen? Das ist ein Fossil. Ein Fossil, verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610703
					],
					"speakerTitle": "Fliehender Lin"
				},
				{
					"id": 726610703,
					"content": "Das ist nicht nur ein Vermögen wert, nur mit dem Ding alleine kann man halb Liyue aufkaufen! Setz dich mal hin und fang an zu lesen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610704
					],
					"speakerTitle": "Fliehender Lin"
				},
				{
					"id": 726610704,
					"content": "Echt? So viel ist das wert? Wir haben jetzt schon so viele im Lager. Wir können uns endlich eine goldene Schnauze verdienen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610705
					],
					"speakerTitle": "Tollpatschiger Bazi"
				},
				{
					"id": 726610705,
					"content": "Das heißt „goldene Nase“! Mannomann, du musst echt mehr Bücher lesen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610706
					],
					"speakerTitle": "Fliehender Lin"
				},
				{
					"id": 726610706,
					"content": "He! Du da drüben! Gib das Fossil her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610707,
					"content": "Ah! Wer ist das? Verdammt ... man hat uns entdeckt ... Brüder, schnappt sie euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fliehender Lin"
				}
			]
		}
	]
}