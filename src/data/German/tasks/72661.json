				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nantuck",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610101,
					"content": "#Hallo, {F#junge Anglerin}{M#junger Angler}, freut mich, euch zu sehen. Bist du etwa in Schwierigkeiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610102
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610102,
					"content": "Komm schon, ich bin dein erfahrener Fischereilehrer. Wenn dir etwas passieren sollte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610103
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610103,
					"content": "Es wundert mich nicht, dass Kujirai immer noch davon besessen ist, den „Mond-Leviathan“ zu finden, wenn man bedenkt, dass es ihr Wunsch ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610104
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610104,
					"content": "Doch wenn sie die Wahrheit über den „Mond-Leviathan“ wüsste, würde sie das am Boden zerstören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610105
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610105,
					"content": "Welche Wahrheit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610106
					]
				},
				{
					"id": 726610106,
					"content": "Um ehrlich zu sein, habe ich nach unserer Rückkehr nicht aufgehört, Nachforschungen über den „Mond-Leviathan“ anzustellen. In einem uralten Buch habe ich endlich eine Spur gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610107
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610107,
					"content": "Ausgehend von diesen Spuren bin ich zurück auf das Meer gefahren und habe einige schockierende Entdeckungen gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610108
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610108,
					"content": "Ich habe meine Forschungsergebnisse in einem Buch veröffentlicht, es verkauft sich sehr gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610109
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610109,
					"content": "Hier, ich habe noch eine Kopie hier. Die Wahrheit über den „Mond-Leviathan“ steckt hier drin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610110
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610110,
					"content": "Paimon will es auch sehen! Lass Paimon mal gucken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610111,
					"content": "„Über die Tatsache, dass der Mond-Leviathan in Wirklichkeit eine gigantische Meeresschildkröte ist“ ... Was für ein langatmiger Titel, hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610112,
					"content": "Eine gigantische Meeresschildkröte? Der „Mond-Leviathan“ ist eine gigantische Meeresschildkröte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726610113,
					"content": "Ganz genau, der „Mond-Leviathan“ ist eine gigantische Meeresschildkröte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610114
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610114,
					"content": "In der Nacht damals haben wir eine gigantische Meeresschildkröte gesehen, auf deren Rücken biolumineszierende Pflanzen wuchsen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610115
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610115,
					"content": "Es war eine schwangere Meeresschildkröte, die nach Land gesucht hat, um ihre Eier zu legen. So haben wir dann unseren Weg nach Hause gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610116
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610116,
					"content": "Geht nun zurück und erzählt es Kujirai, ihr müsst der Wahrheit früher oder später in die Augen sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610117
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610117,
					"content": "Es klingt logisch, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610118
					]
				},
				{
					"id": 726610118,
					"content": "Deinem Gesichtsausdruck nach zu urteilen glaubst du mir wohl nicht, hm? Meine Forschung ist mit Beweisen belegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610119
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610119,
					"content": "In den uralten Geschichten ist der „Mond-Leviathan“ eine alte Kreatur aus einer Zeit, als viele Lebewesen noch an Land lebten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610120
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610120,
					"content": "Ihre Vorfahren waren auf dem Drachengrat aktiv und man kann ihre Fossilien noch heute finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610121
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 726610121,
					"content": "Ich habe beim letzten Mal etwas in einem Minenhaufen auf der Westseite des <color=#00E1FFFF>Schlummerdrachentals</color> gefunden. Wenn ihr mir immer noch nicht glaubt, könnt ihr gehen, um sie euch selbst anzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
		},
