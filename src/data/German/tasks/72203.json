			"dialogs": [
				{
					"id": 722030501,
					"content": "Haha, du hast mich wieder gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030502
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030502,
					"content": "Das ist ein bisschen traurig, aber ... dieses Mal bin ich hier, um mich zu verabschieden. Der goldene Onkel sagte, dass wir gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030503
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030503,
					"content": "Aber keine Sorge, dort, wo ich hingehe, wird es viele Leute geben, mit denen ich spielen kann! Ich wünschte, du könntest auch kommen ... aber der goldene Onkel sagt, es ist noch nicht an der Zeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030504
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030504,
					"content": "Aber es ist in Ordnung, es ist in Ordnung! Ich werde auf dich warten. Wenn ich nicht warten kann, verwandle ich mich in ein gepunktetes Licht und komme in deine Träume, um dich zu finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030505
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030505,
					"content": "Viel Glück.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722030506
					]
				},
				{
					"id": 722030506,
					"content": "Vielen Dank. Es hat Spaß gemacht, mit dir zu spielen, vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030507
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030507,
					"content": "Es ist schön, nicht mehr allein zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nonno"
				}
