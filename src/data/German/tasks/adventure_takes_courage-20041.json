			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neugierige Patchi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200410101,
					"content": "Bei Abenteuern läuft nie alles glatt. Wenn du weiter so lange brauchst, wirst du keine Fortschritte machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410102
					],
					"speakerTitle": "Neugierige Patchi"
				},
				{
					"id": 200410102,
					"content": "Selbst wenn der Plan nicht perfekt ist, sollten wir uns immer noch auf alle Eventualitäten vorbereiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200410103,
					"content": "Worüber streitet ihr euch denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410104
					]
				},
				{
					"id": 200410104,
					"content": "Ich bin ein Forscher, der alte Ruinen untersucht, und möchte mich im Tempel der Tausend Winde umsehen. Leider bin ich nicht gut auf Situationen, in denen es zu Kämpfen kommen kann, vorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410105
					],
					"speakerTitle": "Neugierige Patchi"
				},
				{
					"id": 200410105,
					"content": "Doolan hier meint, er sei ein waschechter Abenteurer, und hat die Untersuchung des Tempels übernommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410106
					],
					"speakerTitle": "Neugierige Patchi"
				},
				{
					"id": 200410106,
					"content": "Ich will ja nicht sagen, dass Doolan nicht dafür geeignet wäre, und ich weiß auch, dass die Ruinenwächter wirklich lästig sind. Er will aber die ganze Zeit nur an seinem perfekten Plan arbeiten und sich mit mir besprechen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410107
					],
					"speakerTitle": "Neugierige Patchi"
				},
				{
					"id": 200410107,
					"content": "Forschen, untersuchen, anpassen und dann wieder untersuchen, forschen und anpassen ... Das halte ich nicht aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410108
					],
					"speakerTitle": "Neugierige Patchi"
				},
				{
					"id": 200410108,
					"content": "Eben hat er wieder eine Spur gefunden. Neben dem Tempel gibt es ein Lager voller Monster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410109
					],
					"speakerTitle": "Neugierige Patchi"
				},
				{
					"id": 200410109,
					"content": "Würdest du das Lager für uns säubern? Selbst wenn wir es nicht in den Tempel schaffen, hört er dann vielleicht wenigstens auf zu labern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410110,
						200410111
					],
					"speakerTitle": "Neugierige Patchi"
				},
				{
					"id": 200410110,
					"content": "Ähm, ja, natürlich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200410111,
					"content": "Ich werde solange mit Doolan eine Besprechungen abhalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410112
					]
				},
				{
					"id": 200410112,
					"content": "Danke für deine Hilfe! Denn glaub mir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410113
					],
					"speakerTitle": "Neugierige Patchi"
				},
				{
					"id": 200410113,
					"content": "Im Vergleich zu einer Besprechung mit ihm sind die Monster ein Klacks.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neugierige Patchi"
				}
			]
		},
