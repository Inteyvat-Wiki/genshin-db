			"dialogs": [
				{
					"id": 200410301,
					"content": "Hast du das Monsterlager gesäubert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410302
					],
					"speakerTitle": "Neugierige Patchi"
				},
				{
					"id": 200410302,
					"content": "Ja, keine Monster mehr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410303
					]
				},
				{
					"id": 200410303,
					"content": "Sehr gut! Dann werde ich jetzt mit ihm absprechen, wie wir in den Tempel kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410304
					],
					"speakerTitle": "Neugierige Patchi"
				},
				{
					"id": 200410304,
					"content": "Diesmal wird er keine Ausrede finden, um weitere Besprechungen zu führen!",
