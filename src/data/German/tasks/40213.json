			"dialogs": [
				{
					"id": 402130101,
					"content": "Es ist alles meine Schuld, Kapitan! Ich kann kaum glauben, dass jemand unsere Arbeit so vernachlässigt und Fremde einfach die Ressourcen vom Entwurfsbüro nutzen ... Ich werde der Sache gründlich nachgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130102
					],
					"speakerTitle": "Praporshchik"
				},
				{
					"id": 402130102,
					"content": "Lass die Nachforschung, hol deine Leute zurück und übernimm wieder das Ruder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130103
					],
					"speakerTitle": "Kapitan-Poruchik"
				},
				{
					"id": 402130103,
					"content": "Die Nachforschungen lassen ... Ist das die Entscheidung der Vorgesetzten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130104
					],
					"speakerTitle": "Praporshchik"
				},
				{
					"id": 402130104,
					"content": "Lass die Nachforschung, verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130105
					],
					"speakerTitle": "Kapitan-Poruchik"
				},
				{
					"id": 402130105,
					"content": "Verstanden, Kapitan-Poruchik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402130106
					],
					"speakerTitle": "Praporshchik"
				},
				{
					"id": 402130106,
					"content": "Hm? Seit wann bist du denn hier? Das hier ist eine Einrichtung des Versuchs- und Konstruktionsbüros zu Kuuvahki. Fremde müssen den Bereich sofort verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kapitan-Poruchik"
				}
			]
