			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beryna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760710101,
					"content": "Wenn ich leckeres Brot backen könnte, würde das bestimmt alle aufmuntern. Aber in dieser Situation ist das ziemlich schwierig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710102,
						760710103
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710102,
					"content": "Bist du in Schwierigkeiten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710105
					]
				},
				{
					"id": 760710105,
					"content": "Also, ich will gerade eine neue Sorte Brot backen – so ein pilzförmiges Brot, das meine Mama mir früher immer gemacht hat, als ich klein war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710106
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710106,
					"content": "In meiner Erinnerung macht man für dieses Brot zuerst eine Füllung aus Pilzen und Beeren, steckt sie dann in den frisch gekneteten Teig und backt das Ganze zusammen im Ofen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710107
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710107,
					"content": "Und das Wichtigste ist, dass man unbedingt Mehl aus frisch gemahlenem Weizen benutzt. Nur damit bekommt das Brot dieses warme, wohlige Aroma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710108
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710108,
					"content": "Eigentlich wollte ich nur ein bisschen Weizen ernten. Aber vielleicht hatten meine Kollegen die letzten Tage keine Zeit, sich um die Felder hier zu kümmern ... Jedenfalls wimmelt es plötzlich von lauter seltsamen kleinen Wesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710109
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710109,
					"content": "Wenn Herr Valdis hier wäre, könnte er das bestimmt regeln, aber ich bin in solchen Dingen einfach nicht gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710110
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710110,
					"content": "Könntest du mir also bitte etwas Weizen sammeln? Nur ein bisschen reicht schon. Als Gegenleistung kann ich dir beibringen, wie man warmes Pilzbrot macht. Ich bitte dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710103,
					"content": "Tschüss.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710104
					]
				},
				{
					"id": 760710104,
					"content": "Ach, geh doch nicht schon! Kannst du mir vielleicht kurz helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710105
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				}
			]
		},
