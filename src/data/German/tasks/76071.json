			},
			"dialogs": [
				{
					"id": 760710301,
					"content": "Wunderbar, danke dir! Mit diesem frischen Weizen kann ich endlich warmes Brot backen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710302
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710302,
					"content": "Als Gegenleistung bringe ich dir bei, wie man die „Fungus-Fantasie“ zubereitet — also präg es dir gut ein ...",
					"roleType": "TALK_ROLE_NPC",
