			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Onkel Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210101,
					"content": "Oho, diese Mine ist riesig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210102,
					"content": "Hier hat sich der Vorfall ereignet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210103
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210103,
					"content": "Vor sechs Tagen verließ eine Gruppe von uns das Gelände, um sich um externe Angelegenheiten zu kümmern. Als wir zurückkehrten, waren die vier Männer, die wir zurückgelassen hatten, verschwunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210104
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210104,
					"content": "Ich führte eine Truppe um die gesamte Mine, fand aber keine Spur. Da beschloss ich, Hilfe anzufordern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210105
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210105,
					"content": "Es sind also vier Bergleute verschwunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210106
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210106,
					"content": "Ja. Wir waren zu zehnt. Wir haben Long, den alten Cen, den jungen Cen und Mao verloren. Ich habe mit allen von ihnen gearbeitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210107
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210107,
					"content": "Arbeiter in diesem Gewerbe sind meist junge Männer in der Blüte ihres Lebens. Könnte es sein, dass die vier in eine andere Mine gegangen sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210108
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210108,
					"content": "Unwahrscheinlich. Es gibt meilenweit keine andere Unterkunft und wir sind auf dem Weg dorthin an keinen anderen Minen vorbeigekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210109
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210109,
					"content": "Hmm ... so eine riesige Mine. Hast du es wirklich geschafft, jede Ecke zu erkunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210110
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210110,
					"content": "Unterirdisch, oberirdisch ... wir haben nichts unversucht gelassen. Wir haben alles versucht, außer weiter in der Erde zu graben. Wie konnten vier junge, stramme Burschen einfach im Grundgestein verschwinden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210111
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210111,
					"content": "Wir müssen es selbst erforschen, bevor wir irgendwelche Schlussfolgerungen ziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210112,
					"content": "Sehr gut, ich warte hier. Bitte geh du weiter, wohin du willst. Wenn du auf irgendwelche Hinweise stößt, lass es mich sofort wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Onkel Dai"
				}
			]
		},
		{
			"id": 1112102,
			"completionStepIds": [
				1112102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
