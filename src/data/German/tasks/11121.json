			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kun Jun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210201,
					"content": "Kun Jun, was hast du da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210202,
					"content": "Aha, genau zur richtigen Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210203
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210203,
					"content": "Hast du etwas gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210204
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210204,
					"content": "Hier gibt es einen Erzbrocken, vielleicht sind darin Hinweise zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210205
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210205,
					"content": "Erz? Was hat es mit dem Verschwinden zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210206,
					"content": "Wir werden es herausfinden, wenn wir es ausprobieren. Einen Moment bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210207
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210207,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210208
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210208,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210209
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210209,
					"content": "Sieht aus, als würde er sich sehr konzentrieren. Was hat er vor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210210,
					"content": "Ich sehe ... vier Männer ... die jemandem aus der Mine folgen ... es sieht wie ein Kind aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210211
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210211,
					"content": "Ein Kind? Was macht ein Kind in einem Bergwerk!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210212,
					"content": "Ich bin mir nicht sicher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210213
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210213,
					"content": "Außerdem, wie hast du überhaupt etwas „gesehen“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210214,
					"content": "Oh! Ich meine nicht „sehen“ im herkömmlichen Sinne ... Ich würde es zu schätzen wissen, wenn das, was ich dir jetzt sage, ein Geheimnis bliebe. Es ist ein wenig seltsam ... Ich habe mich noch nie getraut, es jemandem zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210215
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210215,
					"content": "Ich kann ... die Erinnerungen des Erzes wahrnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210216
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210216,
					"content": "Hä ...!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210217,
					"content": "„Wahrnehmen?“ Es ist also keine ... Vermutung am Werk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210218
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210218,
					"content": "Du meinst, du kannst deine Hand auf einen Stein legen und — bumm! Es passiert einfach?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210219,
					"content": "Ich habe immer gespürt, dass Erz „Erinnerungen“ enthält. Manchmal zeichnet es Ereignisse auf, die in der Umgebung stattfinden. Ich muss es nur berühren und meine Aufmerksamkeit konzentrieren und die Erinnerungen kommen zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210220
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210220,
					"content": "Erstaunlich! Du kannst also alles herausfinden, was dort jemals passiert ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210221,
					"content": "Es kommt auf das Erz an. Einige Erze haben erstaunliche Erinnerungen. Andere, wie Eisenerz und weißes Eisenerz, sind nicht so gut. Ihre Erinnerungen sind verschwommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210222
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210222,
					"content": "Cor-Lapis- und Kristallerinnerungen sind viel stärker. Sie zeichnen mehr Ereignisse und in größerem Detail auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210223
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210223,
					"content": "Steinsehen ... faszinierend. In der Tat eine seltene Fähigkeit. Es war klug von Onkel Dai, dich zu rekrutieren, Kun Jun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210224
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210224,
					"content": "Haha, ich bin froh, dass ich behilflich sein kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210225
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210225,
					"content": "Basierend auf dem, was ich gesehen habe, glaube ich, dass sie diesem Weg gefolgt sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210226
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210226,
					"content": "Das wird uns nach Norden führen, weg von der Mine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210227
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210227,
					"content": "Norden ... ein weiterer Hinweis für Onkel Dai! Notieren wir uns das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112103,
			"completionStepIds": [
				1112103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112103",
							"2"
						],
						"stepId": 1112103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210301,
					"content": "Arbeitest du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210302,
					"content": "Ah! Ja, ja! Ihr müsst wegen des Verschwindens hier sein. Bitte findet sie, wenn ihr könnt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210303
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210303,
					"content": "I... Ich weiß nicht, was passiert ist. Das Wetter war an diesem Tag düster, der Vorarbeiter verschwand mit ein paar Männern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210304
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210304,
					"content": "Ich blieb mit den anderen vier zurück. Nach einer Weile beschloss ich, eine Pause zu machen ... nur um Luft zu holen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210305
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210305,
					"content": "Am Ende schlief ich im inneren Schutzraum ein. Als ich aufwachte, waren sie verschwunden. Ich hatte gerade noch mit ihnen gesprochen und plötzlich ... waren sie verschwunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210306
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210306,
					"content": "Vielleicht ... äh, möglicherweise bin ich der nächste ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210307
					],
					"speakerTitle": "Hu"
				},
				{
					"id": 111210307,
					"content": "Die Männer, die draußen arbeiteten, verschwanden und der einzige, der übrig blieb, schlief in einem Unterstand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210308,
					"content": "Vielleicht hat sich vor Ort ein Unfall ereignet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210309
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210309,
					"content": "Uuh! Was für ein gruseliger Gedanke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210310,
					"content": "Ein Unfall vor Ort ... Das sollten wir uns auch notieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112104,
			"completionStepIds": [
				1112104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112104",
							"2"
						],
						"stepId": 1112104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210401,
					"content": "Hier drüben! Was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210402,
					"content": "Ein Stapel Hemden, ein paar Hosen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210403,
					"content": "Ein paar Alltagsgegenstände, sie müssen Onkel Dai und seinen Männern gehören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210404
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210404,
					"content": "Eins, zwei, drei, vier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210405,
					"content": "Hah ... das scheint zu stimmen. Zehn Hemden, zehn Paar Hosen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210406,
					"content": "Diese müssen als Reserve dienen, oder? Schau, Onkel Dais Kleidung ist identisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210407,
					"content": "Die vier sind seit sechs Tagen unterwegs, ohne einmal die Kleidung gewechselt zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210408
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210408,
					"content": "Es liegen auch ein paar Taschentücher und etwas Seife herum ... Oh, und ein paar Werkzeuggürtel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210409,
					"content": "Utensilien, um sich vor der Frühschicht das Gesicht zu waschen ... Bergbauausrüstung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210410
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210410,
					"content": "Also ... haben sie keine Vorräte mitgenommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210411,
					"content": "Korrekt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210412,
						111210413
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210412,
					"content": "Vielleicht haben sie sie nicht gebraucht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				},
				{
					"id": 111210414,
					"content": "Unwahrscheinlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210415
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210415,
					"content": "Es fehlen vier Spitzhacken. Es scheint wahrscheinlich, dass sie mit den Werkzeugen ihres Handwerks abreisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210416
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210416,
					"content": "Sie hatten Zeit, ihre Werkzeuge mitzunehmen, aber nicht ihre Alltagsgegenstände? Seltsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210417
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210417,
					"content": "Hmm ... warum sollte jemand mit seinem Werkzeug losziehen, aber sein Gepäck zurücklassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210418,
					"content": "Erstens: Sie arbeiteten in der Nähe und brauchten ihre Vorräte nicht zu transportieren. Aber da sie noch nicht zurückgekehrt sind, scheint dies eine unwahrscheinliche Hypothese zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210419
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210419,
					"content": "Zweitens: Sie waren gezwungen zu gehen und hatten keine Zeit, an ihre Vorräte zu denken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210420
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210420,
					"content": "Oh ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210421,
					"content": "Glaubt Ihr ... jemand hat sie entführt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210422
					]
				},
				{
					"id": 111210422,
					"content": "Es ist sicherlich eine Möglichkeit. Wir brauchen mehr Hinweise, bevor weitere Schlüsse gezogen werden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210423
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210423,
					"content": "Wenn sie nicht gegangen sind, wurden sie vielleicht gezwungen zu gehen ... Wir machen eine Notiz und lassen es Onkel Dai wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210413,
					"content": "Vielleicht haben sie sie einfach vergessen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				}
			]
		},
		{
			"id": 1112107,
			"completionStepIds": [
				1112107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112107",
							"2"
						],
						"stepId": 1112107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Onkel Dai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210701,
					"content": "Du bist wieder da! Wie laufen die Ermittlungen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210702
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210702,
					"content": "Wir haben drei Hinweise in der Nähe gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210703
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210703,
					"content": "Erstens fehlen vier Spitzhacken, doch Alltagsgegenstände sind noch an ihrem Platz. Das deutet darauf hin, dass deine Männer nicht aus eigenem Antrieb gegangen sind, sondern dazu gezwungen wurden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210704
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210704,
					"content": "Gezwungen!? Aber ... wer würde Bergleute entführen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210705
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210705,
					"content": "Zweitens: Es waren fünf Arbeiter in der Mine. Einer von ihnen verließ die Baustelle, um sich auszuruhen. Als er erwachte, waren seine Kollegen spurlos verschwunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210706
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210706,
					"content": "Diejenigen, die weiterarbeiteten, verschwanden alle. Derjenige, der früher ging, tauchte wohlbehalten wieder auf. Es scheint, dass sich der Vorfall vor Ort ereignet hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210707
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210707,
					"content": "Jetzt, da du es erwähnst, erinnere ich mich, dass Hu sagte, dass er eine Pause gemacht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210708
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210708,
					"content": "Wie konnte jemand das Gelände betreten und einfach mit ihnen weggehen!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210709
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210709,
					"content": "Das führt mich zu meinem dritten Punkt. Kun Jun hier hat seine ... Expertenfähigkeit gut eingesetzt, um zu einer Schlussfolgerung zu kommen. Es war ein Kind, das deine Männer entführt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210710
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210710,
					"content": "Ein Kind!? Aber hier gibt es meilenweit keine Siedlungen! Es gibt keine Möglichkeit, dass ein Kind es bis zur Mine geschafft hätte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210711
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210711,
					"content": "So unwahrscheinlich es klingt, das ist unsere Schlussfolgerung. Deine Männer haben ein Kind verfolgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210712,
					"content": "Wo sind sie hin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210713
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210713,
					"content": "Wir glauben, dass sie der Straße nach Norden gefolgt sind, weg von der Mine und hin zu den Ruinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210714
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210714,
					"content": "Nach Norden! Gut, ich versammle ein paar Männer und nehme die Verfolgung auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210715
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210715,
					"content": "Können wir vielleicht irgendwie helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210716
					]
				},
				{
					"id": 111210716,
					"content": "Ihr wart von unschätzbarem Wert für die Untersuchung, aber überlasst uns die Laufarbeit. Wenn wir jetzt losgehen und uns beeilen, können wir sie vielleicht noch erwischen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210717
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210717,
					"content": "Nicht so schnell. Der Vorfall ereignete sich vor sechs Tagen. Selbst wenn sie sich zu Fuß aufgemacht haben, werden sie inzwischen eine Menge Weg zurückgelegt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210718
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210718,
					"content": "*seufz* Ihr habt recht ... Neuer Plan. Ich werde meinen Suchtrupp zu den Siedlungen weiter draußen führen und ein paar Erkundigungen einholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210719
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210719,
					"content": "Abseits der Mine gibt es eigentlich nur ein paar Siedlungen, in denen man übernachten kann. Lass uns diesen Teil der Untersuchung übernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210720
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210720,
					"content": "Darf ich euch bitten, weiter nach Hinweisen zu suchen? Wir sollten getrennte Wege gehen. Wenn wir euch in der Zwischenzeit nicht antreffen, sollten wir uns morgen Abend im Gasthaus Wangshu wieder treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210721
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210721,
					"content": "Einverstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210722
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210722,
					"content": "In Ordnung, ich und meine Männer werden loslegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210723
					],
					"speakerTitle": "Onkel Dai"
				},
				{
					"id": 111210723,
					"content": "Also ... sie werden mit den Leuten drüben in den Siedlungen reden, während wir hier weiter ermitteln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210724,
					"content": "Genau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210725
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210725,
					"content": "Aber ... in der Mine gibt es keine weiteren Hinweise ... Sollten wir nicht nach Norden gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210726,
					"content": "Warte ... Ich glaube, es fehlt jemand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210727
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210727,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210728,
					"content": "Ach ja, wo ist Kun Jun? Paimon wettet, dass er noch ermittelt. Rufen wir ihn herbei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112108,
			"completionStepIds": [
				1112108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112108",
							"2"
						],
						"stepId": 1112108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kun Jun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210801,
					"content": "Kun Jun! Was suchst du denn da? Wir haben keine Anhaltspunkte mehr! Los geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210802,
					"content": "Ah, Entschuldigung, ich führe eine schnelle Suche zu meinem eigenen Nutzen durch. Ich bin auf der Suche nach einem wertvollen Stein, der als Drachenfall bekannt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210803
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210803,
					"content": "Drachenfall?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210804,
						111210805
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210804,
					"content": "Noch nie davon gehört.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				},
				{
					"id": 111210806,
					"content": "Drachenfall wird oft beim Schmieden verwendet. Welche Verwendung hast du dafür?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210807
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210807,
					"content": "I... Ich weiß es nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210808
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210808,
					"content": "Äh, es tut mir leid, ich weiß nicht, warum ich es suche ... Ich habe mich in letzter Zeit sehr ... abwesend gefühlt. Abgesehen von Name und Adresse, habe ich Probleme, mich an Dinge zu erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210809
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210809,
					"content": "In der Tat fühle ich mich extrem ... ängstlich ... als ob ich vergessen hätte, etwas zu beenden. Es ist ... ein unangenehmes Gefühl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210810
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210810,
					"content": "Oh, Paimon kennt dieses Gefühl! Wenn man weiß, dass man etwas vergessen hat, sich aber nicht mehr genau erinnern kann, was es ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210811,
					"content": "Uff ... Ich weiß gar nicht, wo ich damit anfangen soll, ich bin ... ziellos umhergezogen. An diesem Tag auf dem Markt, hörte ich ein Gespräch mit, während ich etwas kaufte. Sie erwähnten Drachenfall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210812
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210812,
					"content": "Es kam mir so bekannt vor, als ob das, was ich zu tun hatte, mit diesem Stein verbunden war ... Also beschloss ich, danach zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210813
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210813,
					"content": "Vielleicht erinnere ich mich, wenn ich ihn berühre, daran, was ich zu tun habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210814
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210814,
					"content": "Ich verstehe ... Wenn ich während unseres Unterfangens dazu in der Lage bin, werde ich dir helfen, diesen Stein zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210815
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210815,
					"content": "Wirklich? Oh, vielen Dank, Herr Zhongli! Ihr seid zu hilfsbereit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210816
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210816,
					"content": "Denk dir nichts dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210817
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210817,
					"content": "Sollten wir nicht loslegen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210818,
					"content": "Wenn wir von der Schlucht nach Norden gehen, erreichen wir den Lingju-Pass. Wenn das tatsächlich der Weg ist, den sie gewählt haben, wird es Spuren geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210819
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210819,
					"content": "Toll! Schauen wir uns das mal an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210805,
					"content": "Nicht mein Fachgebiet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				}
			]
		},
		{
			"id": 1112109,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112104",
							"2"
