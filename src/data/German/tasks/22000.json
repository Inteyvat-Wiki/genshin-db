			},
			"dialogs": [
				{
					"id": 220000301,
					"content": "Alles sauber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000302
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000302,
					"content": "Alles sauber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000303
					]
				},
				{
					"id": 220000303,
					"content": "Klasse! Dankeschön! Hier, das hast du dafür, dass du mit uns gespielt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000304
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000304,
					"content": "Du wirst doch auch in Zukunft ein guter Mensch sein, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000305
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000305,
					"content": "Und wann kann ich der Kapitän sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000306
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220000306,
					"content": "Das nächste Mal. Dann kannst du auch Kapitän sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000307
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000307,
					"content": "Hmpf, das hast du letztes Mal auch gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleiner Fei"
				}
			]
		},
