				"objectNames": [
					"Kleiner Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220000201,
					"content": "Ich bin bereit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000202
					]
				},
				{
					"id": 220000202,
					"content": "Dann sollten wir gleich anfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000203
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000203,
					"content": "Wo fangen wir an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000204
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000204,
					"content": "Mit dem Klauen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000205
					]
				},
				{
					"id": 220000205,
					"content": "Aah, ein Pirat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000206
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 220000206,
					"content": "Lulu, komm schnell her! Ich werde dich beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000207
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220000207,
					"content": "Du bist doch ein Pirat. Warum willst du uns ausrauben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000208,
						220000209
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000208,
					"content": "Ich bin ein Pirat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				},
				{
					"id": 220000210,
					"content": "Es gibt gute und böse Piraten. Die müssen nicht unbedingt Sachen klauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000211
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000211,
					"content": "Beidou hat gesagt, dass sie auch ein Pirat ist. Aber sie ist ganz lieb und gibt mir immer Essen. Alle mögen sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000212
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000212,
					"content": "Warum willst du ein böser Pirat sein und kein guter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000213
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000213,
					"content": "Du hast doch selbst gesagt, dass sie böse sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000214,
						220000215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220000214,
					"content": "Stimmt auch wieder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000216,
					"content": "Beidou hat gesagt, dass es gut ist, sich vom Bösen abzuwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000217
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000217,
					"content": "Dann hilf uns doch, die Umgebung zu säubern. Man kann nur ein guter Mensch sein, wenn man Gutes tut ... oder ein guter Pirat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000215,
					"content": "Ich will ein Guter sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000209,
					"content": "Piraten rauben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				}
			]
		},
		{
