			},
			"dialogs": [
				{
					"id": 220000101,
					"content": "Wie regeln wir das heute?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000102
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000102,
					"content": "Also wenn sich keiner als Pirat verkleidet, können wir es auch sein lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000103
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220000103,
					"content": "Keiner will doch der Pirat sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000104
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000104,
					"content": "Was macht ihr denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000105
					]
				},
				{
					"id": 220000105,
					"content": "Wir wollen ein Spiel spielen. Aber keiner will der Pirat sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000106
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000106,
					"content": "Weil sich keiner als Pirat verkleidet, können wir nicht weiterspielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000107
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000107,
					"content": "Vielleicht könntest du ja der Pirat sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000108,
						220000110
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000108,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000109
					]
				},
				{
					"id": 220000109,
					"content": "Super! Dann werden wir mal alles vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000115,
					"content": "Komm einfach her, sobald du fertig bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000110,
					"content": "Ich kenne mich damit nicht aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000111
					]
				},
				{
					"id": 220000111,
					"content": "Das ist doch einfach! Piraten, die sind böse und klauen Sachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000112
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000112,
					"content": "Ich habe zwar noch keinen gesehen, aber Beidou hat mir davon erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000113
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000113,
					"content": "Aber ich finde, dass sollte leicht zu spielen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000114
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000114,
					"content": "Es wäre super, wenn du das übernehmen könntest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Kleiner Meng"
				}
			]
		},
		{
			"id": 2200002,
			"completionStepIds": [
				2200002
			],
			"beginWay": "TALK_BEGIN_NONE",
