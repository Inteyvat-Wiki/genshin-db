			"dialogs": [
				{
					"id": 220000501,
					"content": "Alles sauber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000502
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000502,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000503
					]
				},
				{
					"id": 220000503,
					"content": "Dann kümmere dich schnell darum! Das ist ein guter Weg, um dich vom Bösen abzuwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000504
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000504,
					"content": "Mit ein wenig Sauberkeit kann man schon ein guter Mensch werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000505
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220000505,
					"content": "Solange man Gutes tut, ist man auch ein guter Mensch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000506
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000506,
					"content": "Das wäre doch zu einfach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000507
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220000507,
					"content": "Wenn man Gutes tut, ist man gut. Wenn man Böses tut, ist man böse. Ganz einfach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000508
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000508,
					"content": "Hmpf, du sagst das so einfach. Aber wieso gibt es dann überhaupt noch böse Menschen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000509
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220000509,
					"content": "Weil sich alles einfach anhört, aber schwierig ist, wenn man es tut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000510
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000510,
					"content": "Böses zu tun ist immer leichter als Gutes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000511
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 220000511,
					"content": "Hat dir das auch Beidou erzählt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000512
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 220000512,
					"content": "Das habe ich in einem Buch gelesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleiner Meng"
				}
			]
		},
