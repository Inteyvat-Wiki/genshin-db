				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Giovanni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220701,
					"content": "#Hallo, {M#Bürger}{F#Bürgerin}, hast du was herausgefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220702,
						742220703
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220702,
					"content": "Ich fand einige ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 742220703,
					"content": "Ach, nichts.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220704
					]
				},
				{
					"id": 742220704,
					"content": "Pass auf dich auf und halt mich auf dem Laufenden, wenn etwas ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
				}
			]
		},
		{
			"id": 7422208,
			"completionStepIds": [
				7422208,
				7422209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422208",
							"2"
						],
						"stepId": 7422208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Giovanni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220801,
					"content": "Tatsächlich ... stimmt, das ist der Signalmast, mit dem die Barbaren ihre Botschaften übermitteln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220802,
						742220803
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220802,
					"content": "Wirklich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				},
				{
					"id": 742220804,
					"content": "Ach, wer hätte gedacht, dass sich die Spione der Barbaren wirklich eingeschlichen haben? Sieht so aus, als ob die Sorgen von Tribun Mettius doch berechtigt waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220805
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220805,
					"content": "Wenn ich ihm über diese Sache Bericht erstatte, habe ich wohl endlich meine Pflicht erfüllt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220806
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220806,
					"content": "#Auf jeden Fall danke, {M#Bürger}{F#Bürgerin}. Ohne deinen Einsatz wäre unsere Verteidigung schon von innen unterwandert worden, bevor die Armee der Barbaren überhaupt angekommen wäre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220807
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220807,
					"content": "Ich werde deinen Beitrag in meinem Bericht an den Tribun Mettius wohlwollend erwähnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220803,
					"content": "Gerade sagtest du noch, es sei ein Holzschwert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				}
			]
		}
	]
}