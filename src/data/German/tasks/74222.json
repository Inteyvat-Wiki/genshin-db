	"talks": [
		{
			"id": 7422201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422201",
							"2"
						],
						"stepId": 7422201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Moce"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220101,
					"content": "#Sei vorsichtig, Bürger{F#in}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220102,
						742220106,
						742220109,
						742220116
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220102,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220103
					]
				},
				{
					"id": 742220103,
					"content": "Ich? Wie du siehst, bin ich immer noch damit beschäftigt, die Bedrohung durch die Barbaren abzuwehren. Ihre Angriffe kommen in letzter Zeit immer näher, vielleicht schleichen sich sogar Spione ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220104
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220104,
					"content": "Die Sache ist keine Kleinigkeit und wir müssen doppelt vorsichtig sein, bis die Verstärkung eintrifft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220105
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220105,
					"content": "#Wenn es noch etwas gibt, melde dich bei meinem Adjutanten, Bürger{F#in}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220106,
					"content": "Was macht ein Kind allein hier ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220107
					]
				},
				{
					"id": 742220107,
					"content": "Hm? Wo gibt es hier ein Kind? Hat einer der Rekruten wieder gegen Militärbefehle verstoßen und seine Familie ohne Erlaubnis ins Lager gebracht ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220108
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220108,
					"content": "*seufz* Herr Cassiodor ist immer noch zu nett zu diesen Rekruten. Wenn so etwas vor dreißig Jahren passiert wäre, hätte der Tribun schon längst seine Peitsche rausgeholt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220109,
					"content": "Ist etwas Verdächtiges vorgefallen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220110
					]
				},
				{
					"id": 742220110,
					"content": "Bisher noch nicht. Aber die Barbaren sind wie gerissene Bestien, die immer angreifen, wenn man unvorbereitet ist. Ihre beste Taktik ist die Überrumpelung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220111
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220111,
					"content": "Sie werden die schmutzigsten Mittel einsetzen, um in unsere Städte einzudringen und unsere Geheimnisse zu erfahren. Die kleinste Spur von Nachlässigkeit kann zu einer tragischen Katastrophe führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220112
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220112,
					"content": "*seufz* ... Vor dreißig Jahren, als ich Herrn Boethius auf seiner Entdeckungsreise in den Norden folgte, waren sie nur eine Schar von Unzivilisierten, die nie diese verräterischen Taktiken angewandt haben. Woher in aller Welt haben sie das gelernt ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220113
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220113,
					"content": "Vor dreißig Jahren ... Da waren deine Eltern vielleicht noch nicht geboren ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220114
					]
				},
				{
					"id": 742220114,
					"content": "#Hm? Was hast du gesagt, Bürger{F#in}? Im Alter hört man eben nicht mehr so gut wie früher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220115
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220115,
					"content": "*seufz* Damals, als wir Bituria eroberten, konnte ich schon von Weitem die Glockensignale der Barbaren hören. Die Jahre haben uns nicht verschont ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220116,
					"content": "Tschüs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220117
					]
				},
				{
					"id": 742220117,
					"content": "#Auf Wiedersehen, Bürger{F#in}. Wenn du auf verdächtige Leute triffst, sag mir bitte Bescheid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				}
			]
		},
		{
			"id": 7422202,
			"completionStepIds": [
				7422202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7422202",
							"2"
						],
						"stepId": 7422202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Giovanni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220201,
					"content": "*seufz* Wann wird dieser Krieg zu Ende sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220202
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220202,
					"content": "Was machst du da auf dem Dach?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220203
					]
				},
				{
					"id": 742220203,
					"content": "#Hm? Ich halte natürlich Ausschau nach verdächtigen Bewegungen der Barbaren. In letzter Zeit ... Moment mal, {M#Bürger}{F#Bürgerin}, wie bist du denn hier auf den Aussichtsturm hochgekommen!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220204
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220204,
					"content": "Das wollte ich dich gerade fragen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220205
					]
				},
				{
					"id": 742220205,
					"content": "Egal, das ist jetzt nicht wichtig. Tribun Mettius sagt, die Angriffe der Barbaren kommen immer näher, vielleicht schleichen sich sogar Spione ein. Wir müssen die Wachsamkeit erhöhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220206
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220206,
					"content": "Aber denkst du, so eine abgelegene kleine Stadt wie unsere weckt überhaupt das Interesse der Barbaren? Geschweige denn, dass sie sich die Mühe machen, Spione zu schicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220207
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220207,
					"content": "Viele Bäche machen einen großen Fluss.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220208
					]
				},
				{
					"id": 742220208,
					"content": "#{M#Bürger}{F#Bürgerin}, was du sagst, ergibt echt Sinn! Ich muss wohl ein bisschen besser aufpassen. Aber nach deiner Art zu reden, hast du etwa eine Menge Erfahrung in dem Bereich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220209
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220209,
					"content": "Wenn das so ist, könntest du mir vielleicht helfen und in der Umgebung nachsehen? Wenn wirklich Barbaren aktiv waren, müssten sie irgendwelche Hinweise hinterlassen haben, wie Holzschwerter oder dergleichen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220210
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220210,
					"content": "Äh, wie Kinder, die Krieg spielen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220211
					]
				},
				{
					"id": 742220211,
					"content": "Na ja, sind eben Barbaren. Dass sie Holzstöcke als Waffen benutzen, ist nicht wirklich überraschend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220212
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220212,
					"content": "Dann zähle ich auf dich. Wenn du irgendwas in der Gegend findest, sag mir Bescheid. Das gehört auch zu den Pflichten eines Bürgers von Remuria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
				}
			]
		},
		{
			"id": 7422207,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
