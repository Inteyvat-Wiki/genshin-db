			"dialogs": [
				{
					"id": 721450101,
					"content": "„... Sie sagen, dass Omikamis Gesandter drei Augen hatte: eines für die ‚Seele‘, einen ‚Spiegel‘ und das letzte die ‚Wahrheit‘ ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450102
					],
					"speakerTitle": "Antike Stele"
				},
				{
					"id": 721450102,
					"content": "„... aus den Tiefen stieg es auf, vom <color=#00E1FFFF>Süden</color> über den <color=#00E1FFFF>Norden</color> und ganz über den <color=#00E1FFFF>westlichen</color> Hügel ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450103
					],
					"speakerTitle": "Antike Stele"
				},
				{
					"id": 721450103,
					"content": "„... Die drei Augen strahlten erbarmungslos, um den Drachenerben abzuwehren ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450104
					],
					"speakerTitle": "Antike Stele"
				},
				{
					"id": 721450104,
					"content": "Paimon ... hört all diese Wörter ... aber nichts davon ergibt Sinn, wenn man es zusammensetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721450105,
					"content": "Sieht so aus als wären hier auch keine Spuren, warum versuchen wir es nicht mit dem <color=#00E1FFFF>Elementarblick</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
