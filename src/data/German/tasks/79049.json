			},
			"dialogs": [
				{
					"id": 790490101,
					"content": "Warum ist ein Tagebuch so in der Ecke versteckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490102
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790490102,
					"content": "Die riesige Steintafel draußen war also das Zeichenbrett, das Idyia diesem Maler gegeben hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490103
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790490103,
					"content": "Hmm, allem Anschein nach, hat er in der „Veluriyam-Mirage“ einige schöne Landschaften gefunden, die ihm gefallen haben. Er hat auch mit „Tröpfchen“ Freundschaft geschlossen, was ihm neue Inspiration zur Erstellung von Werken gegeben hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490104,
						790490105
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790490104,
					"content": "Was für eine glückliche Fügung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790490106
					]
				},
				{
					"id": 790490106,
					"content": "Igitt! Daran hätte Paimon nicht gedacht, wenn du es nicht erwähnt hättest! Tatsächlich gibt es zielstrebige Menschen, die sich nach einem Rückschlag wie verrückt noch mehr abverlangen, bis sie am Ende nicht mehr ganz normal sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490107
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790490107,
					"content": "Puh ... Dank Idyias Werkzeugen und der Gesellschaft der „Tröpfchen“ hat der Maler wieder auf den rechten Weg zurückgefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790490105,
					"content": "Das ist wesentlich besser, als wie ein Besessener zu üben und dabei dem Wahnsinn zu verfallen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790490106
					]
				}
			]
		},
