			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701020102,
					"content": "Fällt dir was zu dem Zahn ein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020103
					]
				},
				{
					"id": 701020103,
					"content": "Ein Zahn? Lass mich mal sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020104
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020104,
					"content": "Hmm ... Ja, das ist ein bisschen ungewöhnlich, in Gestalt und Größe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020105,
					"content": "Ich bin kein Experte für obskures Material ... Orban kennt sich vielleicht damit aus, er stößt beim Schmieden von Waffen auf alle möglichen Materialien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020106
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020106,
					"content": "Warum fragst du ihn nicht? Er ist gleich da vorn. Du kannst ihn nicht verfehlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7010202,
			"completionStepIds": [
				7010207
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7010207",
							"2"
						],
						"stepId": 7010207,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7010206",
							"3"
						],
						"stepId": 7010206,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Orban"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701020201,
					"content": "Was denkst du über diesen Zahn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020202
					]
				},
				{
					"id": 701020202,
					"content": "Ein Zahn? Ach, sag mir nicht, du hast auf dem Berg nach Plunder gesucht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020203
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020203,
					"content": "Hmm, aber aber dieser Zahn hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020204
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020204,
					"content": "Was? Was ist damit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020205
					]
				},
				{
					"id": 701020205,
					"content": "Das ist ein feines Exemplar. Auch hart wie Stahl ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020206
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020206,
					"content": "Und diese Umrisse ... Sie sehen für mich verdammt nach einem Drachenzahn aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020207
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020207,
					"content": "Was meinst du mit „Drachenzahn“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020208
					]
				},
				{
					"id": 701020208,
					"content": "Ganz wörtlich, der Zahn eines Drachen. Waffen aus Drachenzahn sollen außergewöhnlich stark und scharf sein ... und sogar eine Art merkwürdige Kraft besitzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020209
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020209,
					"content": "So etwas trifft man nicht alle Tage an, aber ... In allen Erzählungen, die man hört, sind es immer nur die größten Helden, denen es gelingt, einen Drachenzahn zu erhalten und daraus Waffen herzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020210
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020210,
					"content": "Wie sagt man so schön: „Willst du einen Drachen töten, brauchst du einen Drachentöter!“ Wie solltest du ohne eine solche Waffe aber an einen Drachenzahn kommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020211
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020211,
					"content": "Dann ... ist das wirklich ein Drachenzahn, oder etwa nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020212
					]
				},
				{
					"id": 701020212,
					"content": "Ganz ehrlich, ich habe mich noch nie persönlich mit Drachenzähnen befasst. Daher kann ich keine definitive Antwort geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020213
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020213,
					"content": "Ich glaube schon, dass es der Zahn irgendeiner riesigen Bestie sein muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020214
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020214,
					"content": "Wie auch immer, da du dir all diese Mühe gemacht hast ... behandeln wir es doch einfach, als wäre es wirklich ein echtes, kostbares Stück Drachenzahn. Was denkst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020215
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020215,
					"content": "Hmm, aber das heißt, dass es nicht reicht, um daraus eine Waffe zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020216
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020216,
					"content": "Wie wäre es, wenn du, sagen wir mal, drei weitere Stücke Drachenzahn findest, und in der Zwischenzeit werde ich mich etwas einlesen und herausfinden, wie man mit diesem Zeug arbeitet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020217
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020217,
					"content": "Oh, und abgesehen von <color=#00E1FFFF>Drachenzahn</color>, wir wollen auch etwas gutes Erz verwenden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020218
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020218,
					"content": "Und deshalb solltest du, wenn du schon in die Berge gehst, auch gleich 50 Stücke <color=#00E1FFFF>Sternsilbererz</color> mitbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020220
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020220,
					"content": "Ach ja, und außerdem ... brauche ich auch eine <color=#00E1FFFF>unbearbeitete Stangenwaffe des Nordens</color> ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020219
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020219,
					"content": "Wenn du das alles zusammen hast, komm wieder zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orban"
				}
			]
		},
		{
			"id": 7010203,
