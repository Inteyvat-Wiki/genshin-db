				"objectNames": [
					"Orban"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701020301,
					"content": "Ich habe noch mehr Drachenzahn gefunden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020302
					]
				},
				{
					"id": 701020302,
					"content": "Ah, ich habe gehofft, dass du vorbeikommen würdest. Pass auf, bevor du den ganzen Drachenzahn sammelst ... Oh ... Wie ich sehe, bist du längst fertig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020303
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020303,
					"content": "Ich bitte um Verzeihung ... aber ich habe ein kleines Problem. Egal womit ich dieses Ding auch schlage, ich kann einfach keinen einzigen Splitter davon abkratzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020304
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020304,
					"content": "Es ist wohl doch echter Drachenzahn ... Wenn dem so ist, dann gibt es meines Wissens mehrere ziemlich komplizierte Methoden, um mit diesem Material zu arbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020305
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020305,
					"content": "Eine davon ist, den Drachenzahn eine Art ... „Lebenskraft“ absorbieren zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020306
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020306,
					"content": "Benutze dann den mit der Lebenskraft versehenen Drachenzahn, um die anderen Stücke Drachenzahn in Form zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020307
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020307,
					"content": "Aber wie kann man etwas mit Lebenskraft bereichern ... Ich habe nicht die leiseste Ahnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020308
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020308,
					"content": "#Hast du eine Idee, {F#Reisende}{M#Reisender}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020309
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020309,
					"content": "Ich, ähm ... werde mal sehen, was ich tun kann.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020310
					]
				},
				{
					"id": 701020310,
					"content": "Großartig! Hier, nimm diesen Drachenzahn und ich werde dir diese ganzen Dinge überlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020311
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020311,
					"content": "Hm, wenn allein die Zähne so viel Ärger verursachen, dann müssen ganze Drachen extrem komplizierte Kreaturen sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orban"
				}
			]
		},
