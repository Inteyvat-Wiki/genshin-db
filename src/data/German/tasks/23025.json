			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Farghani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250801,
					"content": "#Oh! {M#Reisender}{F#Reisende}, du bist endlich angekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250802
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250802,
					"content": "Wie geht es mit deiner Forschung voran?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250803
					]
				},
				{
					"id": 230250803,
					"content": "Die enormen Fortschritte der letzten Tage sind dir zu verdanken. Die Baken müssen wohl ordentlich Daten sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250804
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250804,
					"content": "Jetzt muss ich nur noch die Daten einsammeln, um die neuen Hypothesen zu überprüfen, die ich in den letzten Tagen aufgestellt habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250805,
						230250806
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250805,
					"content": "Alles, was du in den letzten Tagen gemacht hast, sind Mutmaßungen!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				},
				{
					"id": 230250807,
					"content": "Na ja, die Gleichungen konnten optimiert und Messgeräte kalibriert werden, siehst du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250808
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250808,
					"content": "Ich bin auch körperlich nicht in der Lage, zu den Stellen zu klettern, an denen du die Baken aufgestellt hast, um sie zu bergen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250809
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250809,
					"content": "Ich fürchte, diesmal muss ich dich wieder bitten, die Baken zu holen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250810,
						230250812
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250810,
					"content": "Na gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250811
					]
				},
				{
					"id": 230250811,
					"content": "#Ich zähle auf dich, {M#Reisender}{F#Reisende}. Ich werde deine Entlohnung bereithalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250812,
					"content": "Nächstes Mal solltest du vorher einplanen, wie man sie zurückholen kann ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250813
					]
				},
				{
					"id": 230250813,
					"content": "Es ist ja nicht so, dass ich daran nicht gedacht hätte. Ein zusätzlicher Apparat zur Bergung, die Erweiterung des Einsatzbereichs ... und dergleichen mehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250814
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250814,
					"content": "Aber das würde mehr Budget erfordern und ich weiß nicht, ob es die Genauigkeit der Daten beeinträchtigen würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250815
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250815,
					"content": "#Wie auch immer, diesmal zähle ich auf dich, {M#Reisender}{F#Reisende}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250806,
					"content": "Das bedeutet, es gibt überhaupt keinen Fortschritt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				}
			]
		},
