					"Farghani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230251001,
					"content": "Was!? Sogar hier tauchen jetzt Monster auf? Das ergibt keinen Sinn, die Umweltparameter in diesem Gebiet sind eindeutig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251002
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251002,
					"content": "Könnte es sein, dass die Bake selbst eine Einflussgröße ist? Ob es die leichten Vibrationen, die Geräusche und das Licht ihres Betriebes waren, die die Monster angezogen haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251003
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251003,
					"content": "Das kann sich nicht auf die gesammelten Daten ausgewirkt haben ... Ah, tut mir leid, ich führe schon wieder Selbstgespräche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251004
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251004,
					"content": "Ich hatte auch nicht erwartet, dir damit zusätzliche Schwierigkeiten zu bereiten. Bitte nimm dies als deine Bezahlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251005
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251005,
					"content": "Wenn ich das nächste Mal eine Messung vornehme, sollte ich noch genauer nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				}
			]
		}
	]
