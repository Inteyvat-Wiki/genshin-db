					"Farghani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250401,
					"content": "Hmm ja ... Ist das so? Wenn man diese Variable erneut eingibt, wird der vorige Fehler verständlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250402
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250402,
					"content": "Aber würde sich damit auch etwas an den anderen Schlussfolgerungen ändern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250403
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250403,
					"content": "Gibt es Fortschritte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250404
					]
				},
				{
					"id": 230250404,
					"content": "Ah, entschuldige, ich hatte vergessen, dass du noch hier bist ... Hier, hier ist die vereinbarte Bezahlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250405
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250405,
					"content": "Was den Fortschritt betrifft ... Ich habe einige Probleme gelöst, aber das führt wohl wieder zu einer Menge neuer Probleme ... Wahrscheinlich ist es genau das, was man unter Forschung versteht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250406
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250406,
					"content": "#Wahrscheinlich muss ich dich weiter belästigen, {M#Reisender}{F#Reisende}, bis ich zu einem endgültigen Ergebnis komme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				}
			]
		},
