				},
				{
					"id": 230250513,
					"content": "Tatsächlich habe ich ein perfektes Modell, um diese Fragen zu erklären. Ich brauche nur noch mehr Beobachtungsdaten, um es zu untermauern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250514,
						230250515
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250514,
					"content": "Kann ich helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250523
					]
				},
				{
					"id": 230250523,
					"content": "Du bist also bereit zu helfen, richtig? Vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250524
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250524,
					"content": "Tatsächlich hatte ich eine Reihe von Baken anfertigen lassen, die automatisch die für die Schlussfolgerungen notwendigen Rohdaten sammeln sollten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250525
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250525,
					"content": "Um Störungen durch das Gelände möglichst auszuschließen, sollten diese Baken vorzugsweise an hohen Punkten wie Klippen oder Berggipfeln aufgestellt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250526
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250526,
					"content": "Aber ich bin einfach kein besonders guter Bergsteiger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250527,
						230250529
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250527,
					"content": "Überlasse es mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250528
					]
				},
				{
					"id": 230250528,
					"content": "Vielen Dank! Der Ort zur Abnahme der Proben ist ganz in der Nähe, sag mir einfach Bescheid, wenn die Einstellungen fertig sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250529,
					"content": "Wurde das Gelände bei der Anfertigung der Baken nicht berücksichtigt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250530
					]
				},
				{
					"id": 230250530,
					"content": "Nun ja ... Die Priorität lag auf der Empfindlichkeit des Instruments, deshalb mussten wir Abstriche bei dem Anwendungsbereich machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250531
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250531,
					"content": "Schließlich könnte die Berechnung der Ergebnisse völlig daneben liegen, wenn es nur kleine Fehler in den Rohdaten gibt. Wie dem auch sei, ich zähle auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250515,
					"content": "Ich wünsche dir viel Glück. Auf Wiedersehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250516
					]
				},
				{
					"id": 230250516,
					"content": "Warte ... Warte mal! Du solltest nochmal darüber nachdenken, denn sobald meine Arbeit veröffentlicht wird, wird sie ein großer Erfolg sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250517
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250517,
					"content": "#Dann wirst du {M#ein Mitstreiter}{F#eine Mitstreiterin} für diese großartige Theorie sein und ich kann deinen Namen in die Danksagungsliste am Ende des Artikels aufnehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250518
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250518,
					"content": "#Ähm ... Andernfalls wäre auch eine Mitwirkung als {M#Zweitautor}{F#Zweitautorin} nicht ausgeschlossen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250519
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250519,
					"content": "Ist es so dringend?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250520
					]
				},
				{
					"id": 230250520,
					"content": "Wenn ich wieder keine Resultate vorweisen kann, befürchte ich, dass ich Probleme mit meiner Forschungsfinanzierung bekomme ... Das wäre noch weitaus tödlicher, als wenn der Himmel einstürzte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250521,
						230250522
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250521,
					"content": "#„{M#Zweitautor}{F#Zweitautorin}“ ... Das ist nicht notwendig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250523
					]
				},
				{
					"id": 230250522,
					"content": "Ich hätte lieber eine angemessene Bezahlung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250523
					]
				},
				{
					"id": 230250510,
					"content": "Der Himmel sollte nicht einfach so einstürzen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250512
					]
				},
				{
					"id": 230250503,
					"content": "Ich bin sehr beschäftigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250504
					]
				},
				{
					"id": 230250504,
					"content": "Ach! Bitte sag das nicht. Gibt es etwas Schlimmeres, als dass das eigene Haus zusammenzubrechen droht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250505
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250505,
					"content": "Dein Haus ... stürzt ein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250506
					]
				},
				{
					"id": 230250506,
					"content": "*räusper* ... Nein, natürlich nicht. Aber wenn du in einem Haus wohnen würdest, das du noch nie ganz gesehen hast und für dessen Statik niemand garantiert hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250507
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250507,
					"content": "Dann wäre es doch beunruhigend, jeden Tag in solch einem Haus zu leben, oder? Und so ist es auch mit dem Leben in dieser Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250508
					],
					"speakerTitle": "Farghani"
				}
			]
		},
