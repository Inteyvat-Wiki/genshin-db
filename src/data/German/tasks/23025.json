				"objectNames": [
					"Farghani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250201,
					"content": "He, Freund, hast du einen Moment Zeit für mich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250202,
						230250203
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250202,
					"content": "Worum geht es denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250208
					]
				},
				{
					"id": 230250208,
					"content": "Hast du jemals über diese Frage nachgedacht: Was passiert, wenn der Himmel einstürzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250209,
						230250210
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250209,
					"content": "Ich glaube, du machst dir zu viele Gedanken ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250212,
					"content": "Schon möglich. Aber warum stürzt der Himmel nicht ein? Warum bricht die Erde nicht zusammen? Ohne genaue Messungen werden wir nie eine Antwort auf diese Fragen bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250213
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250213,
					"content": "Tatsächlich habe ich ein perfektes Modell, um diese Fragen zu erklären. Ich brauche nur noch mehr Beobachtungsdaten, um es zu untermauern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250214,
						230250215
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250214,
					"content": "Kann ich helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250223,
					"content": "Du bist also bereit zu helfen, richtig? Vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250224
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250224,
					"content": "Eigentlich habe ich schon einen perfekten Ort für meine Beobachtungen gefunden, aber leider sind die Monster dort in der Nähe recht aktiv ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250225
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250225,
					"content": "Es wäre hilfreich, wenn du sie loswerden könntest, damit ich in Ruhe meine Beobachtungen machen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250226,
						230250228
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250226,
					"content": "Klar, mache ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250227
					]
				},
				{
					"id": 230250227,
					"content": "Danke, dann wollen wir uns auf den Weg machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250228,
					"content": "Wirst du auch mit dabei sein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250229
					]
				},
				{
					"id": 230250229,
					"content": "Schließlich gibt es einiges an Daten, die ich selbst erheben muss, ansonsten kann ich die Fehlerquellen nicht ermitteln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250230
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250230,
					"content": "Wenn man seinen Kopf in einem Stapel Papier vergräbt, wird man sich immer weiter von der richtigen Lösung entfernen – Lass uns loslegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250215,
					"content": "Ich wünsche dir viel Glück. Auf Wiedersehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250216
					]
				},
				{
					"id": 230250216,
					"content": "Warte ... Warte mal! Du solltest nochmal darüber nachdenken, denn sobald meine Arbeit veröffentlicht wird, wird sie ein großer Erfolg sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250217
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250217,
					"content": "#Dann wirst du {M#ein Mitstreiter}{F#eine Mitstreiterin} für diese großartige Theorie sein und ich kann deinen Namen in die Danksagungsliste am Ende des Artikels aufnehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250218
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250218,
					"content": "#Ähm ... Andernfalls wäre auch eine Mitwirkung als {M#Zweitautor}{F#Zweitautorin} nicht ausgeschlossen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250219
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250219,
					"content": "Ist es so dringend?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250220
					]
				},
				{
					"id": 230250220,
					"content": "Wenn ich wieder keine Resultate vorweisen kann, befürchte ich, dass ich Probleme mit meiner Forschungsfinanzierung bekomme ... Das wäre noch weitaus tödlicher, als wenn der Himmel einstürzte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250221,
						230250222
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250221,
					"content": "#„{M#Zweitautor}{F#Zweitautorin}“ ... Das ist nicht notwendig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250222,
					"content": "Ich hätte lieber eine angemessene Bezahlung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250210,
					"content": "Der Himmel sollte nicht einfach so einstürzen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250203,
					"content": "Ich bin sehr beschäftigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250204
					]
				},
				{
					"id": 230250204,
					"content": "Ach! Bitte sag das nicht. Gibt es etwas Schlimmeres, als dass das eigene Haus zusammenzubrechen droht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250205
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250205,
					"content": "Dein Haus ... stürzt ein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250206
					]
				},
				{
					"id": 230250206,
					"content": "*räusper* ... Nein, natürlich nicht. Aber wenn du in einem Haus wohnen würdest, das du noch nie ganz gesehen hast und für dessen Statik niemand garantiert hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250207
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250207,
					"content": "Dann wäre es doch beunruhigend, jeden Tag in solch einem Haus zu leben, oder? Und so ist es auch mit dem Leben in dieser Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250208
					],
					"speakerTitle": "Farghani"
				}
			]
		},
		{
			"id": 2302504,
			"completionStepIds": [
				2302504
			],
