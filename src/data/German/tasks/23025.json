				"objectNames": [
					"Farghani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250701,
					"content": "Nanu? Sind die Baken schon alle fertig eingestellt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250702
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250702,
					"content": "Alle sind eingestellt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250703
					]
				},
				{
					"id": 230250703,
					"content": "Ich danke dir vielmals. Hier, hier ist die versprochene Entlohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250704
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250704,
					"content": "Jetzt muss ich nur noch darauf warten, dass sie die Datenerfassung abschließen, um meine vorherige Schlussfolgerung zu bestätigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250705
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250705,
					"content": "Nur, wie komme ich jetzt da hinauf, um die Baken zu bergen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				}
			]
		},
		{
			"id": 2302508,
			"completionStepIds": [
				2302508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
