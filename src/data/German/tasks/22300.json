			]
		},
		{
			"id": 2230010,
			"completionStepIds": [
				2230010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230010",
							"2"
						],
						"stepId": 2230010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001001,
					"content": "Haha! Das ist Erz. Du scheinst den Begriff der Geo-Kraft sehr wörtlich zu nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001002
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001002,
					"content": "Für die ersten Siedler hier in Liyue hatte das Erz neben der Verhüttung noch eine ganz andere, sehr wichtige Funktion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001003
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001003,
					"content": "Als die ersten Siedler hier angekommen waren und anfingen, das Land zu erschließen, haben sie Steinöfen aufgeschichtet und mit Hilfe von Funken ein ordentliches Feuer gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001004
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001004,
					"content": "Mit diesem Feuer konnten sie Essen zubereiten, was sie stark genug machte, um schwerere Arbeiten zu unternehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001005
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001005,
					"content": "All das kommt von der Erde, also direkt vom Herrscher über die Felsen persönlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001006
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001006,
					"content": "In einigen alten Aufzeichnungen wird der Herrscher über die Felsen auch als „Gott des Herdes“ bezeichnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001007
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001007,
					"content": "Sobald ein neues Restaurant aufmacht, betet der Inhaber dafür, dass das Herdfeuer niemals erlischt und das Geschäft gut läuft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001008
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001008,
					"content": "Vergiss nicht, auch an den Herrscher über die Felsen zu denken, wenn du in einem Restaurant in Liyue speist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230011,
			"completionStepIds": [
				2230011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230011",
							"2"
						],
						"stepId": 2230011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001101,
					"content": "Oh, hast du das draußen in der Wildnis aufgelesen? Das muss sicher viel Mühe gekostet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001102
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001102,
					"content": "Also, du wirst ja gesehen haben, dass Liyue heutzutage eine enorme Größe hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001103
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001103,
					"content": "Aber selbst die größte Stadt hat mal klein angefangen und musste Stück für Stück aufgebaut werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001104
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001104,
					"content": "Als unsere Vorfahren gerade auf diesem Flecken Erde ankamen, gab es noch keinen Hafen hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001105
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001105,
					"content": "Wir haben es ihrer harten Arbeit und ihrem Mut zu verdanken, dass sie ihre Siedling Stück für Stück vergrößert haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001106
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001106,
					"content": "Auch du weißt bereits, dass das Gelände um Liyue ein ungleichförmiges Relief aufweist. Es ist äußerst schwierig, dieses Gebiet zu erschließen. Die Pflanzen aber haben damit kein Problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001107
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001107,
					"content": "Diese Pflanzen haben den Menschen dabei geholfen, ihre Arbeit zu verrichten. Sie sehen sie als Gabe des Herrschers über die Felsen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001108
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001108,
					"content": "Die Geschichten von den Anstrengungen unserer Vorfahren erzählt man sich heute von in Liyue. Einige Abenteurer, die von Liyue aus die Welt bereisen, haben sich von diesem Ehrgeiz anstecken lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001109
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001109,
					"content": "Sie haben aber nicht nur den Geist der Pioniere geerbt, sondern sehen den Herrscher über die Felsen auch als den Gott des Aufbruchs an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001110
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001110,
					"content": "Steinerne Standhaftigkeit ist ein Anspruch dieser Abenteurer an sich selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230012,
			"completionStepIds": [
				2230012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230012",
							"2"
						],
						"stepId": 2230012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001201,
					"content": "Oho, wo hast du dieses gute Stück denn gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001202
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001202,
					"content": "Ich hatte gedacht, dass man sowas nur noch von der Yujing-Terrasse aus sehen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001203
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001203,
					"content": "Du nimmst diese Aufgabe wirklich ernst. Für ein paar Geschichten über den Herrscher über die Felsen hast du selbst sowas gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001204
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001204,
					"content": "Wobei die Geschichte dieser Glaslilie tatsächlich eng mit der Gründung von Liyue verwoben ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001205
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001205,
					"content": "Verstehst du nicht? Na, überleg mal, was ist eine Besonderheit der Glaslilie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001206
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001206,
					"content": "Genau, sie ist sehr wertvoll. Mit dem Verkauf einer einzigen Glaslilie kann man schon viel Geld machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001207
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001207,
					"content": "Außerdem wurden die „Mora“ nach dem Herrscher über die Felsen benannt. Sein Name lautet nämlich „Morax“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001208
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001208,
					"content": "Deshalb gilt der Herrscher über die Felsen in den Herzen der Menschen auch als Gott des Reichtums. Jeder einzelne Händler hier bittet ihn darum, dass seine Geschäfte gut laufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001209
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001209,
					"content": "Denn der Herrscher über die Felsen ist das reichste Wesen auf dieser Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001210
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001210,
					"content": "Ich persönlich denke, dass er auch unter den Sieben der reichste ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230013,
			"completionStepIds": [
				2230013
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230013",
							"2"
						],
						"stepId": 2230013,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001301,
					"content": "Du scheinst auch einen Sinn für Köstlichkeiten zu haben. Das Essen hier in Liyue ist wirklich gut. Bei Gelegenheit solltest du mal die ganzen köstlichen Speisen ausprobieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001302
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001302,
					"content": "Du glaubst, das hat nichts mit dem Herrscher über die Felsen zu tun? Hahaha! Viele Restaurants hier im Hafen rühmen sich damit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001303
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001303,
					"content": "Wenn du Beweise dafür sehen willst, brauchst du nur die Inhaber der Restaurants zu fragen. Dort wird man behaupten, dass der Herrscher über die Felsen irgendwann einmal ein bestimmtes Gericht bestellt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001304
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001304,
					"content": "Wer weiß schon, was an diesen Bericht dran ist. Daraus kannst du aber sicher entnehmen, dass der Herrscher über die Felsen schon lange in Liyue sein muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001305
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001305,
					"content": "Einige der Geschichtsforscher in Liyue bezeichnen den Herrscher über die Felsen als den Ältesten unter uns und verehren ihn als den Gott der Geschichte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001306
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001306,
					"content": "Wie lange der Herrscher über die Felsen aber schon unter uns weilt, kann man nur raten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230080,
