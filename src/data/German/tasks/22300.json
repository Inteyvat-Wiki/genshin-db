					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223008001,
					"content": "Ha, wie die Zeit vergeht! Da habe ich dir schon so viele meiner Geschichten erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008002
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008002,
					"content": "Glaubst du, du verstehst nun mehr vom Herrscher über die Felsen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008003
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008003,
					"content": "Das hat mich zum Nachdenken angeregt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223008004
					]
				},
				{
					"id": 223008004,
					"content": "Na gut, aber das ist nur ein kleiner Teil der Geschichte um den Herrscher über die Felsen. Lass uns beim nächsten Mal über was anderes reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008005
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008005,
					"content": "Wie? Du hast dir sogar so viele Notizen gemacht ... Du scheinst dich ja wirklich dafür zu interessieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008006
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008006,
					"content": "Wie wäre es, wenn du diese Notizen bei mir lässt und ich schreibe dir noch mehr Geschichten auf, wenn ich die Zeit dazu finde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008007
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008007,
					"content": "Wenn man all diese Notizen zusammenlegt, ergibt das eine nette Sammlung. Es wäre mir eine Freude, sie dir zu schenken, wenn ich mit dem Sortieren fertig bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008008
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008008,
					"content": "Bei so vielen Geschichten über den Herrscher über die Felsen könnte das allerdings eine Weile dauern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008009
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008009,
					"content": "Bitteschön, die hier sind für dich, zum Dank dafür, dass du so ein guter Zuhörer bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		}
	]
}