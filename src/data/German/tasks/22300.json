			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223000101,
					"content": "Das müsste eigentlich reichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000102
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000102,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000103
					]
				},
				{
					"id": 223000103,
					"content": "Ich bete den Herrscher über die Felsen an. Hm, du scheinst nicht von hier zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000104
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000104,
					"content": "Wir sind hier im Yiyan-Tempel, wo man dem Herrscher über die Felsen Weihrauch anzündet. Viele in Liyue kommen regelmäßig her, um für Glück zu beten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000105
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000105,
					"content": "Ich wohne aber sehr weitab und kann nicht oft kommen. Deshalb bleibe ich jedes Mal ein wenig länger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000106
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000106,
					"content": "In der Vergangenheit habe ich so viel über den Herrscher über die Felsen gelesen, dass ich ihn wirklich zu schätzen gelernt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000107
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000107,
					"content": "Wenn man bedenkt, was der Herrscher über die Felsen alles für Liyue getan hat, ist es das Mindeste, was ich tun kann, wenn ich ein paar Schritte mehr laufe, um den Weihrauch anzuzünden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000108
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000108,
					"content": "Ich gehe mal davon aus, dass du nicht allzu viel über den Herrscher über die Felsen weißt. Ich könnte dir das eine oder andere über ihn sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000109
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000109,
					"content": "Bloße Worte hinterlassen aber sicher keinen großen Eindruck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000110
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000110,
					"content": "Machen wir es einfach folgendermaßen: Such in der <color=#00E1FFFF>Nähe des Hafens</color> nach ein paar Dingen, mit deren Hilfe ich dir von den Taten des Herrschers über die Felsen erzählen werde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000111,
						223000113
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000111,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000112
					]
				},
				{
					"id": 223000112,
					"content": "Ja, gut, dann werde ich hier auf dich warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000113,
					"content": "Wonach soll ich denn genau suchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000114
					]
				},
				{
					"id": 223000114,
					"content": "Nach allem, was irgendwie mit <color=#00E1FFFF>Liyue</color> oder deiner Meinung nach mit dem <color=#00E1FFFF>Herrscher über die Felsen</color> zu tun haben könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000115
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000115,
					"content": "Du weißt natürlich noch gar nichts weiter darüber. Ich werde dir aber alles Wissenswerte noch erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000116
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000116,
					"content": "Sobald du etwas gefunden hast, werden wir es uns gemeinsam ansehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
