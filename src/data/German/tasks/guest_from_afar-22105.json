			},
			"dialogs": [
				{
					"id": 221050101,
					"content": "Wirklich merkwürdig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050103
					]
				},
				{
					"id": 221050103,
					"content": "Ich habe so ein ungutes Gefühl, wenn ich mir die Umgebung des Gasthauses ansehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050104,
					"content": "Außerdem lassen sich in unserem Gasthaus einige sensible Leute nieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050105,
					"content": "Sobald mal ein Grashalm vom Wind in die falsche Richtung gedreht wird, könnte der ein oder andere schon verrücktspielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050106,
					"content": "Die Gäste bezahlen natürlich für die Schäden, die sie selbst verursachen. Diese zusammengezimmerten Teile sehen dann aber nicht mehr so schön aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050107
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050107,
					"content": "Könntest du dich in der Umgebung des Gasthauses etwas umsehen? Wenn du etwas, sagen wir, Verdächtiges siehst ... na ja, würdest du dich darum kümmern? Ich muss mich noch um die Gäste kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050108,
						221050109
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050108,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050110
					]
				},
				{
					"id": 221050110,
					"content": "Danke sehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050109,
					"content": "Diese Gäste ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050111
					]
				},
				{
					"id": 221050111,
					"content": "Die Gäste? Ach, mach dir nichts draus. Wenn man jahrelang durch die Wildnis reisen muss, wird man etwas empfindlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050112,
					"content": "Aber wie gesagt, es wäre schön, wenn du dich in der Gegend umsehen könntest. Es sollte nichts Großes passieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
