					"Nahuatlalli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752400101,
					"content": "#{F#Meine Liebe}{M#Mein Freund}, willkommen bei Ayars Heldenmeisterschaft! Ich bin hier die Moderatorin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400102
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400102,
					"content": "Heute ist schon der letzte Tag des Turniers. Wenn du dir den Titel holen willst, musst du nacheinander die drei stärksten Kämpfer hier plattmachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400107
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400107,
					"content": "Was ist denn Ayars Heldenmeisterschaft?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400108
					]
				},
				{
					"id": 752400108,
					"content": "Das ist der Wettkampf um den Ruhm Ayars. Schlag deinen Gegner mit deinen Fäusten, Waffen oder wie auch immer du willst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400109
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400109,
					"content": "Und wer ist Ayar überhaupt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400110
					]
				},
				{
					"id": 752400110,
					"content": "#{F#Meine Liebe}{M#Mein Freund}, hier darf nur der Champion Fragen stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400111
					],
					"speakerTitle": "Nahuatlalli"
				},
				{
					"id": 752400111,
					"content": "Geh schon auf die Bühne und zeig mir, ob du das Zeug hast, dir den Respekt zu verdienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahuatlalli"
				}
			]
		},
