			"dialogs": [
				{
					"id": 733560101,
					"content": "Das ist wirklich schwer zu glauben. Ich hätte nie gedacht, dass ich hier sitzen und mit dir Tee trinken würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560102
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560102,
					"content": "Ist das wirklich so seltsam? Ich wollte mich nur bei dir für den Kernprozessor bedanken, den du für das arithmetische Feld bereitgestellt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560103,
					"content": "Und warum redest du immer so, als würdest du uns in- und auswendig kennen? Du tust ja so, als hättest du uns total durchschaut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560104,
					"content": "Ich habe dir doch gesagt, dass ich Menschen gut einschätzen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560105
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560105,
					"content": "Trotzdem ... Hah, du hast recht. Ich sollte nicht immer glauben, dass ich dich verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560106
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560106,
					"content": "Hä?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560107,
					"content": "Selbst im Vergleich zu unserem letzten Treffen habe ich das Gefühl, dass du dich sehr verändert hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560108
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560108,
					"content": "Hmpf! Es ist egal, wie weit zurück du für deine „Vergleiche“ gehen willst, die einzigen Veränderungen, die ich durchgemacht habe, sind, die Fehler in meinem Kern zu akzeptieren und meine Augen zu öffnen, um ein paar Dinge klar zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560109,
					"content": "Und was ist mit dir? Hast du als eine Art „Marionette“ wie ich jemals Rechenfehler in deinem Herzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560110,
					"content": "Hah ... Ich erlebe viel mehr als nur Fehler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560111
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560111,
					"content": "Erzähl mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560112,
					"content": "Ich glaube, dafür kennen wir uns noch nicht gut genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560113
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560113,
					"content": "Heh, wie du willst. Ich habe eh nur aus Höflichkeit gefragt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560114,
					"content": "Wie auch immer, es braucht ziemlich viele Umwege, bis eine Marionette ihr Herz finden kann. Zumindest war es bei mir so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560115,
					"content": "Du scheinst ein gutes Verhältnis zu deinem Schöpfer gehabt zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560116
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560116,
					"content": "Ja, das hatte ich. Er hat mir sehr viel geholfen und mir den Weg gezeigt, sowohl im Leben ... Als auch danach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560117
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560117,
					"content": "In dieser Hinsicht gibt es einen grundlegenden Unterschied zwischen uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560118
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560118,
					"content": "... Oh. Ist das so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560119,
					"content": "Es tut mir leid. Auch wenn wir als Marionetten einiges gemeinsam haben, hätte ich nicht allein deshalb davon ausgehen sollen, etwas über dich zu wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560120,
					"content": "Das macht nichts. Um es mit deinen Worten zu sagen: Auch ich habe meine vergangenen Fehler akzeptiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560121
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560121,
					"content": "Es ist nur so, dass ich schon zu viele Umwege gegangen bin. Ich muss einen noch längeren Weg gehen, um das alles auszugleichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560122
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560122,
					"content": "In diesem Fall ... viel Glück? Und um es mit deinen Worten zu sagen, kenne ich dich noch nicht gut genug, um dir weitere Ratschläge zu geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560123
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560123,
					"content": "Hah ... Gut gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
