			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hut-Kerl"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733560201,
					"content": "Jeder von uns geht seinen eigenen Weg. Mehr müssen wir dazu nicht sagen. Der Tee ist übrigens ziemlich gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560202,
						733560203
					],
					"speakerTitle": "Hut-Kerl"
				},
				{
					"id": 733560202,
					"content": "(Lass uns noch ein Weilchen so sitzen bleiben.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 733560204,
					"content": "Alles klar, tschüss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hut-Kerl"
				},
				{
					"id": 733560203,
					"content": "Ich glaube, es wird Zeit, dass ich mit dem Aufräumen anfange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
}