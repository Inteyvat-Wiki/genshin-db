					}
				]
			},
			"dialogs": [
				{
					"id": 762050301,
					"content": "Ein Schatz! Juhu, das macht so viel Spaß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050302,
					"content": "Aber ... Paimons Kopf dröhnt wirklich. Im Ernst, musste Nicole wirklich so laut schreien, nur um diese Treppe erscheinen zu lassen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050303,
					"content": "Was soll das denn? Beschwerst du dich jetzt etwa? Hast du keine Angst, dass eine mächtige Hexe wie ich mit den Fingern schnippen und deine neuen Spielsachen in Möhren verwandeln könnte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050304,
						762050305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050304,
					"content": "P... Paimon hat es nicht böse gemeint ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				},
				{
					"id": 762050306,
					"content": "Hehe, ich mache doch nur Spaß. Ihr solltet doch wissen, dass ich nicht die Art von Engel bin, die leise in der Ecke schmollt und sich jede kleine Kränkung merkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050307,
					"content": "#Und so bestiegen {NICKNAME} und Paimon an jenem Tag die sieben Stufen, doch was sie dort erwartete, war eine vertraute Gestalt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050308,
					"content": "Strahlende Flammen vereinten sich und formten Flügel auf ihrem Rücken. Ihre Gestalt war noch immer so edel und schön wie an dem Tag, als sie sich zum ersten Mal begegneten, doch ihre Augen leuchteten nun in einem grausamen Licht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050309,
					"content": "#„Warum?“, fragen {NICKNAME} und Paimon gleichzeitig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050310,
					"content": "Alles begann an dem Tag, als sich Paimon beschwert hat, dass ich zu laut geschrien habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050311,
					"content": "He! Worte sind hier Magie, weißt du das nicht! Sag doch nicht so gruselige Sachen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050305,
					"content": "Komm schon, nimm dir das nicht so zu Herzen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				}
			]
		},
		{
			"id": 7620505,
			"completionStepIds": [
				7620505
