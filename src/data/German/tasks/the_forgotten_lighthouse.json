					}
				]
			},
			"dialogs": [
				{
					"id": 762050101,
					"content": "Was soll ich nur tun ... Was nur ... Der Zeit nach sind sie bald hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050102,
					"content": "Hallo, Nicole, wir sind daaaa! He, warum schiebst du uns denn raus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050103,
					"content": "Oje ... oje ... Das tut mir wirklich leid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050104,
					"content": "Bist du noch nicht fertig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050105
					]
				},
				{
					"id": 762050105,
					"content": "Wie soll ich es sagen ... Oh, verflixt, ich fürchte, ich kann es gar nicht genau erklären. Ich muss euch die ganze Geschichte erzählen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050106,
					"content": "Es fing an, als die Hexen zum ersten Mal den Anemo-Archon herausforderten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050107,
					"content": "Nicole, das ist ... schon viel zu lange her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050108,
					"content": "Ugh, das ist unfair! Es ist so peinlich, dass ihr das aus meinem eigenen Mund hören müsst ... Nein! Es lässt sich nicht ändern, die Fakten sind nun mal die Fakten ... Solange Alice nichts davon erfährt, gibt es keinen Grund zu lachen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050109
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050109,
					"content": "Oje, sie denkt schon wieder laut ... Und außerdem kommt es ja nicht wirklich aus ihrem „Mund“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050110,
					"content": "Pssst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050111
					]
				},
				{
					"id": 762050111,
					"content": "Ich hab die Federn ganz oben im Arbeitszimmer versteckt. Ich dachte mir, wenn ich es schwieriger mache, wäre das Erfolgserlebnis größer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050112
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050112,
					"content": "Aber ich bin wirklich nicht besonders gut darin, diese unbeschwerten Strömungen zu kontrollieren. Ich kann nur bis zu einer bestimmten Höhe fliegen, bevor ich anscheinend an eine unsichtbare Decke stoße.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050113
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050113,
					"content": "Kannst du nicht mit Magie die Federn wieder runterholen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050114,
					"content": "Wo bliebe denn da der Spaß!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050115,
					"content": "Oh, Paimon versteht, was du meinst ... Hmm, das ist wirklich knifflig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050116,
					"content": "Nicole, kannst du mal versuchen, etwas zu sagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050117
					]
				},
				{
					"id": 762050117,
					"content": "Was möchtest du, dass ich sage?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050118,
						762050119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050118,
					"content": "In Simulanka sind Worte Magie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				},
				{
					"id": 762050120,
					"content": "Oh! Ich verstehe, was du meinst! In Ordnung, ich versuch’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050121
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050121,
					"content": "Hmm, das ist gemein, das laut auszusprechen ist mir echt peinlich ...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050122
					]
				},
				{
					"id": 762050122,
					"content": "Egal, es ist nicht zu ändern. Die Wahrheit ist die Wahrheit ...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050123
					]
				},
				{
					"id": 762050123,
					"content": "Solange Alice nichts davon weiß, werde ich wohl nicht ausgelacht ...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				},
				{
					"id": 762050119,
					"content": "Vielleicht könntest du etwas sagen, das zu einer Treppe wird ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				}
			]
		},
