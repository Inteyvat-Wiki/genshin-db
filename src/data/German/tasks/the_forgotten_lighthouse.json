			"dialogs": [
				{
					"id": 762050201,
					"content": "Wah, diese Lücke ist ja riesig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050202,
					"content": "Alles kann als Wegweiser dienen ... Die Schriften sind gefüllt ... mit göttlichen Namen! Die Worte und Kapitel ... verflechten sich ... und Engel handeln im Einklang mit ihren Taten! An diesem heiligen Ort mögen Worte den Weg nach vorn weisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050203,
					"content": "*bumm*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050204
					],
					"speakerTitle": "Tür ansehen"
				},
				{
					"id": 762050204,
					"content": "Siehst du? Alles erledigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050205,
					"content": "Alles kann als Wegweiser dienen ... Die Schriften sind gefüllt ... mit göttlichen Namen!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050206
					]
				},
				{
					"id": 762050206,
					"content": "Die Worte und Kapitel ... verflechten sich ... und Engel handeln im Einklang mit ihren Taten!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050207
					]
				},
				{
					"id": 762050207,
					"content": "An diesem heiligen Ort mögen Worte den Weg nach vorn weisen.",
