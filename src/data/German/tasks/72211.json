			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kiminami Anna",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110702,
					"content": "Toll! Einen Moment noch. Ich glaube ... ich weiß jetzt, was zu tun ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110703
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110703,
					"content": "Geschafft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110704
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110704,
					"content": "Oh, das riecht fantastisch! Paimon will unbedingt mal probieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110705,
					"content": "Wie nennen wir das? Hmm ... Da es für eine sprechende Katze ist, sollten wir es „belebende Katzenmahlzeit“ nennen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110706
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110706,
					"content": "Na dann! Hier ist dein Gericht zum Mitnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110707
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110707,
					"content": "Ah, ja, und das Rezept schreibe ich dir auch noch auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110708
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110708,
					"content": "#Juhuu! Ich schätze, dass demnächst Katzenmahlzeiten von {NICKNAME} auf dem Speiseplan stehen werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110709,
						722110712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110709,
					"content": "Bist du etwa eine Katze, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110710
					]
				},
				{
					"id": 722110710,
					"content": "He, das ist gemein! Gutes Essen ist wie eine Weltsprache, weißt du das nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110711,
					"content": "Wie auch immer, herzlichen Dank, Fräulein Kiminami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110713,
					"content": "Schon gut, keine Sorge! Nimm einfach dieses Essen und das Rezept als Geschenk für Neko.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110714
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110714,
					"content": "Ich werde auf jeden Fall zum Asase-Schrein gehen, um ihr einen Besuch abzustatten, sobald ich die Zeit dazu finde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110715
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110715,
					"content": "Na gut, dann los jetzt. Lasst Neko nicht warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110712,
					"content": "Danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110713
					]
				}
			]
		},
		{
			"id": 7221108,
			"completionStepIds": [
				7221101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221101",
							"2"
						],
						"stepId": 7221101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"„Neko“",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110801,
					"content": "Ah, du bist da. Genau zur richtigen Zeit, ich brauche Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110802
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110802,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110803
					]
				},
				{
					"id": 722110803,
					"content": "Dank dir hat sich der Zustand des Schreins nun deutlich verbessert und wir können davon ausgehen, dass die Gläubigen sehr bald zurückkehren werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110804
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110804,
					"content": "Ich habe die Kleinen angewiesen, eine stolze Haltung zu bewahren und sich nicht vor den Menschen zu entwürdigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110805
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110805,
					"content": "Dummerweise sind sie zu sehr daran gewöhnt, wild herumzutoben und hören nicht auf Belehrungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110806
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110806,
					"content": "Dennoch habe ich einen raffinierten Plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110807
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110807,
					"content": "Ein raffinierter Plan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110808
					]
				},
				{
					"id": 722110808,
					"content": "Als ich noch sehr, sehr jung war, bin ich auch gern überall herumgetobt. Um mich auf den richtigen Weg mit den anderen Katzen zu bringen, bereitete Hibiki ein sehr leckeres Gericht zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110809
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110809,
					"content": "L... Lecker, sagst du ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110810,
					"content": "Immer, wenn dieses Gericht serviert wurde, strömten die Katzen von Bäumen und Dächern herbei. Ganz gleich, wie heiß es war oder wie verbrüht unsere Zungen waren, wir konnten nicht widerstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110811
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110811,
					"content": "Hibiki bereitete jedes Mal einen großen Topf davon zu, und Menschen und Katzen teilten ihn sich gemeinsam. Selbst diejenigen, die den Schrein besuchten, bekamen einen kleinen Anteil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110812
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110812,
					"content": "Ach, aber Domeki ... Dieser Vielfraß. Er fraß immer so viel. Einen würdeloseren Anblick habe ich noch nie gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110813,
						722110814
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110813,
					"content": "Also ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				},
				{
					"id": 722110815,
					"content": "Sehr schön, deine Auffassungsgabe ist ausgezeichnet. Ja, ich bitte dich, ein Gericht zuzubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110816
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110816,
					"content": "Ich möchte deine Weisheit nicht anzweifeln ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110817
					]
				},
				{
					"id": 722110817,
					"content": "Aber weißt du wirklich, wie dieses Gericht zubereitet werden sollte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110818,
					"content": "Miau, miau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110819
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110819,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110820
					]
				},
				{
					"id": 722110820,
					"content": "Ist es nicht gerade der Zweck der Übung, solche Dinge dir zu überlassen? Muss ich alles selbst machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110821
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110821,
					"content": "Ah, dieses Gericht war wirklich ein wahres Meisterwerk! Sogar nachdem ich weit weg wanderte oder nachdem ich jahrelang ohne verbracht habe, erinnere ich mich an seinen Geschmack ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110822
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110822,
					"content": "#Nun, {NICKNAME}, sieht ganz nach einer Aufgabe für uns aus, was? Es geht schließlich um den Schrein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110823,
						722110824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110823,
					"content": "Was ist in dem Gericht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110826
					]
				},
				{
					"id": 722110826,
					"content": "Natürlich erinnere ich mich: Fischfleisch, Tierfleisch, Seegras und weißer Reis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110827
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110827,
					"content": "Ooh, das sind also Fisch, rohes Fleisch, Seegras und Reis, hmm ... Wie wurde es dann zubereitet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110828
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110828,
					"content": "Ich erinnere mich nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110829,
						722110831
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110829,
					"content": "Wir müssen wohl einen Koch fragen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110830
					]
				},
				{
					"id": 722110830,
					"content": "Sicher, aber ... Wo finden wir einen Koch, der sich mit Katzenfutter auskennt? Hmm ... Fragen wir doch Taisuke und Etsuko. Sie wissen vielleicht, was zu tun ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110831,
					"content": "Fragen wir doch mal die beiden Abenteurer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110832
					]
				},
				{
					"id": 722110832,
					"content": "Oh ja, das stimmt! Etsuko und Taisuke sind Abenteurer. Sie könnten etwas wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110824,
					"content": "Du bist so leicht zu durchschauen, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110825
					]
				},
				{
					"id": 722110825,
					"content": "Komm schon, Paimon hat Katzen doch lieb! Neko, erinnerst du dich noch an die Zutaten für dieses Gericht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110814,
					"content": "Soll ich dir etwas Essen zubereiten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				}
			]
		},
