			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Neko“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110501,
					"content": "Hast du das Essen zu den Kleinen gebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110502
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110502,
					"content": "Sie sind absolut begeistert davon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110503
					]
				},
				{
					"id": 722110503,
					"content": "Ist das so? Wunderbar, wunderbar. Miau, miau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110504
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110504,
					"content": "Es ist zu lange her, dass ich etwas so Wunderbares gegessen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110505
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110505,
					"content": "Miau, miau, miau ... Obwohl ich jetzt weder Futter noch Wasser brauche, ist der Genuss einer Reismahlzeit immer eine viel zu große Verlockung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110506
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110506,
					"content": "Die Kleine wurde Meshi genannt, weil „Essen“ es das Beste ist, was es auf der ganzen Welt gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110507
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110507,
					"content": "Wie war der Name des Gerichts, das Hibiki zubereitet hatte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110508
					]
				},
				{
					"id": 722110508,
					"content": "Ein Name? Gerichte brauchen Namen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110509
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110509,
					"content": "Das hier heißt „belebende Katzenmahlzeit“, weißt du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110510
					]
				},
				{
					"id": 722110510,
					"content": "Was für ein komplizierter Name. Allerdings mag ich ihn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110511
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110511,
					"content": "Und du hast recht. Mahlzeiten sind gute Sachen und alle guten Sachen sollten Namen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110512
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110512,
					"content": "Miau, miau, ich werde Hibiki fragen, wenn sie zurückkommt. Du kannst ihr dann auch dein Gericht zubereiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110513
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110513,
					"content": "Und sie kocht euch ihres. Dann wirst du zwei verschiedene, aber köstliche Gerichte essen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110514
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110514,
					"content": "Das ist tatsächlich ein Grund mehr für mich, den Schrein zu restaurieren. Wenn Hibiki zurückkehrt, werden wir alle zusammen essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110515
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110515,
					"content": "Ich danke dir. Das ist sehr lecker. Miau, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		},
		{
