				"objectNames": [
					"Kiminami Anna",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722111101,
					"content": "Hallo, willkommen im Restaurant Kiminami. Möchtest du irgendetwas bestellen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111102
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111102,
					"content": "#Hall! Oh, du bist es! {F#Eine Freundin}{M#Ein Freund} von Fräulein Kamisato! Hereinspaziert, hereinspaziert! Womit kann ich dir helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111103
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111103,
					"content": "Also, ich muss Neko ein Gericht zubereiten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111104
					]
				},
				{
					"id": 722111104,
					"content": "„Neko?“ ... Ist das zufällig der Name einer Katze?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111105
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111105,
					"content": "Weißt du, wer Neko ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722111106,
					"content": "Nein. Ich hatte nur plötzlich das Gefühl, dass das ein guter Name für eine Katze ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111107
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111107,
					"content": "Du hast eine starke Intuition ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111108
					]
				},
				{
					"id": 722111108,
					"content": "Lassen wir das erst einmal beiseite. Es ist folgendermaßen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722111109,
					"content": "Es gibt ... einen Asase-Schrein auf Seirai und in diesem Schrein wohnt eine sprechende Katze?! Und diese Katze hat dich gebeten, ihr eine Mahlzeit zu machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111110
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111110,
					"content": "St... Stimmt das wirklich? Ich habe noch nie von so etwas gehört!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111111,
						722111112
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111111,
					"content": "So wahr ich lebe und atme ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111113
					]
				},
				{
					"id": 722111113,
					"content": "Seirai, nicht wahr? Wenn ich die Chance bekomme, fahre ich auf jeden Fall mal hin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111114
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111114,
					"content": "Äh, also, wegen Nekos Gericht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111115
					]
				},
				{
					"id": 722111115,
					"content": "Ah, ja genau ... Das hätte ich fast vergessen. Lass mich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111116
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111116,
					"content": "Hmm, ein Gericht, das einer Katze gefallen würde, hm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111117
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111117,
					"content": "Wird das schwierig sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722111118,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111119
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111119,
					"content": "Das wird schwierig werden, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111120
					]
				},
				{
					"id": 722111120,
					"content": "Das ist eine echte Herausforderung für die Familie Kiminami! Ich werde sie meistern, egal was passiert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111121
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111121,
					"content": "#Also dann. Ich denke, dass Fisch, rohes Fleisch, Seegras und Reis ein Gericht ergeben, auf das selbst Katzen scharf sind. Überlass das mir, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111122
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111122,
					"content": "P... Paimon will auch was ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111123,
						722111124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722111123,
					"content": "Und ich auch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111125
					]
				},
				{
					"id": 722111125,
					"content": "Kein Problem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111126
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111126,
					"content": "Lass mich mal überlegen, wie ich dieses Rezept gestalte. In der Zwischenzeit kannst du mir helfen, drei Portionen Seegras zu besorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111127,
						722111129
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111127,
					"content": "Das kannst du haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111128
					]
				},
				{
					"id": 722111128,
					"content": "Dann liegt es in deinen Händen. Drei Portionen reichen aus. Sobald du sie gefunden hast, kommst du zurück und gibst sie mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111129,
					"content": "Hast du es schon herausgefunden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111130
					]
				},
				{
					"id": 722111130,
					"content": "Ich hatte ein paar Ideen, aber sie sind noch nicht ganz ausgereift ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111131
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111131,
					"content": "Hilf mir erst mal, die drei Portionen Seegras zu besorgen. Ich danke dir sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722111124,
					"content": "Wir überlassen es dann euch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722111125
					]
				},
				{
					"id": 722111112,
					"content": "Du kannst es dir selbst ansehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722111113
					],
					"speakerTitle": "Kiminami Anna"
				}
			]
		}
	]
}