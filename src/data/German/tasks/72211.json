			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Neko“",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110401,
					"content": "Dieser Geruch ... Du bist also fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110402
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110402,
					"content": "Das haben wir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110403
					]
				},
				{
					"id": 722110403,
					"content": "Miau, miau! Wunderbar! Lass mich mal probieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110404
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110405
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110405,
					"content": "Mmh, das ist etwas anders als das, was Hibiki früher zubereitet hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110406
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110406,
					"content": "E... Es müsste ziemlich gut sein. Komm, lass es uns ausprobieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110407,
					"content": "Ooh, das ist toll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110408,
					"content": "Miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110409
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110409,
					"content": "(Ist Neko unzufrieden darüber, dass es anders schmeckt als das, was Hibiki zubereitet hat?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110410,
					"content": "Das ist sehr gut. Du bist wahrlich sehr zuverlässig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110411
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110411,
					"content": "Schön, dass es dir geschmeckt hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110412
					]
				},
				{
					"id": 722110412,
					"content": "Es ist etwas anders als das, was Hibiki früher zubereitet hat, ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110413
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110413,
					"content": "Aber als ich es aß, war das Gefühl das gleiche wie das, welches ich beim gemeinsamen Essen mit Hibiki hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110414
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110414,
					"content": "Warum ist das so, Mensch? Seid ihr Menschen zu irgendeiner seltsamen Magie fähig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110415,
						722110416
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110415,
					"content": "Es ist einfach schon länger her, dass dir jemand Essen gemacht hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				},
				{
					"id": 722110417,
					"content": "Trotzdem, der Dank dafür gebührt dir. Lange Jahre ist es her, seit ich das letzte Mal etwas so Leckeres gekostet habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110418
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110418,
					"content": "Die Kleinen werden es auch lieben. Bringst du diese Mahlzeit bitte auch zu ihnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110419
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110419,
					"content": "Da ich es genieße, sollten sie es auch tun. Vielleicht sind sie nach so einer wunderbaren Mahlzeit gehorsamer als früher...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110416,
					"content": "Es liegt wohl an der Leidenschaft desjenigen, der es zubereitet hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				}
			]
		},
		{
			"id": 7221105,
			"completionStepIds": [
				7221107
			],
