			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taisuke",
					"Etsuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110101,
					"content": "Frau Etsuko, wo sollten wir als nächstes hin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110102
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110102,
					"content": "Puh ... Ich denke, wir ruhen uns eine Weile aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110103
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110103,
					"content": "Hmm? Du bist es. Können wir etwas für dich tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110104
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110104,
					"content": "Wir müssen einen verlässlichen Chefkoch finden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110105
					]
				},
				{
					"id": 722110105,
					"content": "Du suchst nach einem Chefkoch? Auf der Insel Seirai?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110106
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110106,
					"content": "Nun, die Sache ist die, Neko würde gerne ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110107,
					"content": "Huch. Also Frau Neko will euch etwas zu essen zubereiten lassen, stimmt das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110108
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110108,
					"content": "Ah, verdammt! Wenn ich nur etwas besser kochen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110109
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110109,
					"content": "Mit anderen Worten hättest du gerne einen Chefkoch, der dir dabei helfen kann, zu verstehen, „wie man aus diesen Zutaten etwas macht, das eine Katze mögen würde“, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110110
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110110,
					"content": "Lass mich nachdenken ... Ein Chefkoch ... Ein Chefkoch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110111
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110111,
					"content": "Na ja, warum versuchst du nicht, nach Inazuma zu gehen, und suchst dort Kiminami Anna im Restaurant Kiminami?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110112
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110112,
					"content": "Sie ist eine sehr freundliche Person und sie kocht auch gut. Sie sollte dir helfen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110113
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110113,
					"content": "Danke, wir werden nach ihr suchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110114
					]
				},
				{
					"id": 722110114,
					"content": "Ihr müsst euch nicht bedanken. Nun geht los, Taisuke und ich müssen noch einige Pläne für künftige Erkundungen schmieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110115
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110115,
					"content": "Hehe, na gut, ich hoffe, dass dieser Schrein wirklich aufblüht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110116
					],
					"speakerTitle": "Etsuko"
				},
				{
					"id": 722110116,
					"content": "Andernfalls geht die harte Arbeit, die du und Neko in die Reparatur des Schreins steckt, vielleicht verloren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsuko"
				}
			]
		},
		{
			"id": 7221102,
			"completionStepIds": [
				7221103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
