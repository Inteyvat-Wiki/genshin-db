					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110602
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722110602,
					"content": "Und wenn du fertig bist, iss es gemeinsam mit uns.",
					"roleType": "TALK_ROLE_NPC",
