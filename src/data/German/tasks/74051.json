			"dialogs": [
				{
					"id": 740510301,
					"content": "Großartig! Die Filmkamera ist intakt und der Film ist nicht beschädigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510328
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510328,
					"content": "Dem Himmel sei Dank. Ich habe gedacht, ich müsste von Beginn an alles neu filmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510302,
						740510303
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510302,
					"content": "Warum nehmt ihr hier eigentlich einen Film auf?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510303,
					"content": "Ihr scheint nicht aus Fontaine zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510329,
					"content": "Das ist eine lange Geschichte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510304,
					"content": "Um es kurz zu machen, wir drei sind aus Qiaoying in Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510305,
					"content": "Die meisten Leute in unserer Heimat handeln mit Teeblättern, aber wir ... haben kein Interesse an diesem Geschäft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510306
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510306,
					"content": "Daher haben wir den Beruf gewechselt und drehen nun Werbefilme für die Teehändler in unserem Dorf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510307
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510307,
					"content": "In Wirklichkeit ist es so, dass es einfach zu viele Teehändler gibt und dass unser Geschäft nicht mit ihnen konkurrieren konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510308
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510308,
					"content": "Die besten Leute in unserem Laden sind einer nach dem anderen zu Konkurrenten gegangen. Hätten wir weiter mit Tee gehandelt, dann hätten wir am Ende am Hungertuch genagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510309
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510309,
					"content": "Ihr zwei! Hättet ihr das nicht etwas ausschmücken können?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510310
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510310,
					"content": "Für den Tee in unserem Dorf Werbefilme zu drehen, war bisher recht einträglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510311
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510311,
					"content": "Aber in letzter Zeit haben auch andere Leute in unserem Dorf angefangen, Werbefilme zu drehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510312
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510312,
					"content": "In einigen dieser Filme gibt es sogar traditionelle Gesangseinlagen. Die haben das Ganze wirklich spektakulär aufgezogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510313
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510313,
					"content": "Wir sind daher nach Fontaine gekommen, um uns den Rat von Filmexperten einzuholen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510314
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510314,
					"content": "Ihr seid also in Fontaine, um mehr über das Drehen von Filmen zu lernen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510315
					]
				},
				{
					"id": 740510315,
					"content": "Genau. Wir haben einen „Filmexperten“ namens Geisert gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510316
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510316,
					"content": "Er versteht sich auf die Verwendung von Licht und Schatten in Filmen, um ... Wie war das noch gleich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510317
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510317,
					"content": "„Eine Geschichte zu erzählen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510318
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510318,
					"content": "Richtig! Licht und Schatten werden genutzt, um „eine Geschichte zu erzählen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510319
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510319,
					"content": "Mithilfe von Herrn Geiserts Anleitung werden wir ganz bestimmt den besten Film in ganz Qiaoying drehen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510320
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510320,
					"content": "Frau Qiu, letzten Monat hast du noch gesagt, dass wir den besten Film in ganz Liyue drehen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510321
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510321,
					"content": "Im Geschäftsleben muss man seine Erwartungen an die Zukunft nach rationalen Gesichtspunkten anpassen ... Das verstehst du doch, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510322
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510322,
					"content": "#Jedenfalls danke für deine Hilfe, {M#Reisender}{F#Reisende}. Und hier ist deine Bezahlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510323
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510323,
					"content": "Xingye, Yifeng, stellt alles auf! Wir müssen heute die Musteraufnahmen machen, damit Herr Geisert sie sich ansehen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510324
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510324,
					"content": "Achte auf das Licht! Das Objektiv sollte ... so auf die Lichtquelle gerichtet sein, um einen ... erstklassigen Lichtstrahl abzugeben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510325
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510325,
					"content": "Ihr beide habt doch das Buch gelesen, oder? Licht und Schatten müssen Textur haben. Ist euch klar, was Textur bedeutet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510326
					],
					"speakerTitle": "Frau Qiu"
				},
				{
					"id": 740510326,
					"content": "Frau Qiu, wir haben zwar tatsächlich das Buch von Herrn Geisert gelesen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510327
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510327,
					"content": "Mit diesem Objektiv können wir uns auf den Kopf stellen, aber die Textur des Lichts wird keine gute Qualität erreichen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yifeng"
				}
			]
		},
