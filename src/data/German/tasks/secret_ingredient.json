				"points": []
			},
			"dialogs": [
				{
					"id": 110020701,
					"content": "Ich habe das Gefühl, dass noch etwas fehlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020702,
						110020703
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020702,
					"content": "Was denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020704
					]
				},
				{
					"id": 110020704,
					"content": "Es fehlt noch das gewisse Etwas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020705
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020705,
					"content": "Jetzt, da du’s sagst ... Es könnte wirklich noch etwas Pfiff gebrauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020706,
						110020707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020706,
					"content": "Pfiff?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020708
					]
				},
				{
					"id": 110020708,
					"content": "Aber natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020709,
					"content": "Brook mag zwar sehr konservativ sein, aber sie ist dennoch eine starke Köchin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020710
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020710,
					"content": "Sie wird nur die besten Zutaten verwenden. Wenn ich gewinnen will, muss ich ein völlig neues Gericht zaubern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020711
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020711,
					"content": "Etwas wie Meeresungeheuersalat, kurzgebratener Qingxin oder Schleimbällchen mit wilden Champignons!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020712
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020712,
					"content": "Schleimbällchen mit wilden Champignons?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020713,
					"content": "Hahaha! Klar, das klingt vielleicht seltsam, aber der Geschmack ist unübertrefflich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020714
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020714,
					"content": "Das werde ich euch bei Gelegenheit einmal zubereiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020715,
						110020717
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020715,
					"content": "Ich kann es kaum erwarten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020716
					]
				},
				{
					"id": 110020716,
					"content": "Hehe, ihr werdet sicher nicht enttäuscht sein, obwohl es schon ein ganz klein wenig eklig aussieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020719,
					"content": "Gut, lassen wir das. Mir fällt ein, dass ich letztes Mal an einem Ort nicht war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020720
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020720,
					"content": "Mein Instinkt sagt mir, dass da etwas Gutes zu finden sein wird. Sehen wir doch einfach nach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020717,
					"content": "Äh, nein, danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020718
					]
				},
				{
					"id": 110020718,
					"content": "Was? Das ist doch bestimmt lecker ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020707,
					"content": "Du weißt also, was sie meint, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020708
					]
				},
				{
					"id": 110020703,
					"content": "Ist das noch nicht beeindruckend genug?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020704
					]
				}
			]
		}
	]
