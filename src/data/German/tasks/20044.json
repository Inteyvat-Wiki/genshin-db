			"dialogs": [
				{
					"id": 200440301,
					"content": "Geschafft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440302
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440302,
					"content": "Darauf wäre ich nie im Leben gekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440303
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440303,
					"content": "Danke dir! Ich werde es gleich selbst versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		}
	]
