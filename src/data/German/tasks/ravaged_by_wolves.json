						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530801,
					"content": "Das ist ein Wolfszahn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530802,
					"content": "Er scheint hier hängengeblieben zu sein, als der Wolf gegen die geschlossene Tür rannte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530803,
					"content": "Er sollte mehr Kalzium zu sich nehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530804
					]
				},
				{
					"id": 4530804,
					"content": "Wenigstens sind bei diesem Angriff keine Dorfbewohner verletzt worden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}