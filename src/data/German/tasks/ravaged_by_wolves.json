			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Draff"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530101,
					"content": "Ach, der Arme! Er kann ja nicht einmal mehr aufstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530102
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530102,
					"content": "Oh nein! Das ist ja schrecklich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530103,
					"content": "Aber ... er ist ja gar nicht verletzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530104,
					"content": "Ganz recht, es ist schrecklich. Die Wölfe haben ihn so erschreckt, dass er nicht mehr aufstehen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530105
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530105,
					"content": "Oh, das ist ... wirklich schlimm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530106,
					"content": "Hast du noch etwas anderes gesehen, was wichtig sein könnte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530107,
					"content": "Das war das erste Mal, dass ich Wölfe gesehen habe. Diesen Horror werde ich nie vergessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530108
					],
					"speakerTitle": "Hopkins der Fabelhafte"
				},
				{
					"id": 4530108,
					"content": "Sieht nicht nach hilfreichen Zeugenberichten aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530109,
					"content": "Sehen wir uns lieber weiter nach Spuren um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
		{
			"id": 45305,
			"completionStepIds": [
				45305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45305",
							"2"
						],
						"stepId": 45305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530501,
					"content": "Wolfshaar ... In Liyue sollen sie Pinsel daraus machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530502
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530502,
					"content": "Die Farbe ist aber ganz anders als in den Büchern über die Wölfe um Mondstadt herum beschrieben. Vielleicht kommen sie wirklich woanders her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530503
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530503,
					"content": "Das Fell von Wölfen ist doch an jeder Stelle anders. Da kann die Farbe doch auch unterschiedlich sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530504,
					"content": "Aber sieh dir das doch mal an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530505
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530505,
					"content": "Noch mehr Haare ... Etwas klebt dran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530506,
						4530507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530506,
					"content": "Ein Samen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				},
				{
					"id": 4530508,
					"content": "Es ist der Samen einer Wolfshaken-Beere. Schau, da sind kleine Haken an dem Samen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530509
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530509,
					"content": "Um Mondstadt herum gibt es nur Wolfenlauf und die Glanzkronschlucht, wo sowas wächst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530510
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530510,
					"content": "Also könnten es wirklich die Wölfe aus Wolfenlauf gewesen sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530511,
					"content": "Ja, aus demselben Gebiet schon. Aber es könnte auch ein anderes Rudel sein, das um das Territorium kämpft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530512
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530512,
					"content": "Wir wissen zwar nichts Genaues, aber wir haben hier eine wichtige Spur, mit der wir etwas anfangen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530513
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530513,
					"content": "Bevor wir gehen, beruhige ich die Dorfbewohner noch etwas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530507,
					"content": "Was soll denn da sein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530508
					]
				}
			]
		},
		{
			"id": 45306,
			"completionStepIds": [
				45306
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45306",
							"2"
						],
						"stepId": 45306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hopkins der Fabelhafte"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4530601,
					"content": "Habt ihr schon etwas herausgefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530602
					],
					"speakerTitle": "Hopkins der Fabelhafte"
				},
				{
					"id": 4530602,
					"content": "Oh, du stehst ja wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530603,
					"content": "Ich habe mich glücklicherweise erholt. Es gelang mir, mich wieder aus den Tiefen der Hölle zu kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530604
					],
					"speakerTitle": "Hopkins der Fabelhafte"
				},
				{
					"id": 4530604,
					"content": "Also was hat der Ritterorden herausgefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530605
					],
					"speakerTitle": "Hopkins der Fabelhafte"
				},
				{
					"id": 4530605,
					"content": "Bei der Untersuchung des am Tatort zurückgelassenen Wolfshaars können wir feststellen, dass die Wölfe aus Wolfenlauf stammten. Darüber hinaus wissen wir gar nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530606
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530606,
					"content": "Aber macht euch keine Sorge! Ich werde sofort nach Wolfenlauf gehen und den Fall klären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530607
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530607,
					"content": "Der Ritterorden wird keinesfalls zulassen, dass diese Dinge weiterhin geschehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530608
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530608,
					"content": "Gut. Besser spät als nie, nehme ich an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530609
					],
					"speakerTitle": "Hopkins der Fabelhafte"
				},
				{
					"id": 4530609,
					"content": "Wie unverschämt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530610,
					"content": "Wir müssen uns jetzt selbst um unsere Angelegenheiten kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530611
					],
					"speakerTitle": "Hopkins der Fabelhafte"
				},
				{
					"id": 4530611,
					"content": "Tu nichts Unüberlegtes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530612
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530612,
					"content": "Hah! Bei uns laufen die Dinge ein bisschen anders, ihr Leute vom Orden seid das wahrscheinlich nicht gewohnt. Sie werden für ihre Taten bezahlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530613
					],
					"speakerTitle": "Hopkins der Fabelhafte"
				},
				{
					"id": 4530613,
					"content": "Gehen wir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530614
					],
					"speakerTitle": "Hopkins der Fabelhafte"
				},
				{
					"id": 4530614,
					"content": "Wirklich schrecklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530615
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530615,
					"content": "Wovon sprichst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530616,
					"content": "Von ihrer Zukunft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530617
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530617,
					"content": "Das finde ich auch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530618
					]
				},
				{
					"id": 4530618,
					"content": "Junge Menschen sind manchmal so impulsiv. Ich hoffe, wenn es nicht zu viel verlangt ist, dass du ein Auge auf sie wirfst und sie davon abhältst, in Schwierigkeiten zu geraten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530619
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530619,
					"content": "Aber sicher, dafür sind wir ja hier ... wobei dieser Kerl nicht gerade charmant ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530620
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530620,
					"content": "Überlass das uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530621
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530621,
					"content": "Dann auf nach Wolfenlauf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 45307,
			"completionStepIds": [
				45307
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
