					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000801,
					"content": "Hast du die Sachen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000802
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000802,
					"content": "Ja, hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000803
					]
				},
				{
					"id": 206000803,
					"content": "Lass mich mal sehen. Ah, natürlich konntest du in diesem Stauwasser nichts Gutes finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000804
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000804,
					"content": "Na gut, na gut. Gleich kommt eine Geschichte zu Teuflischen Augen. Lass mich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000805
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000805,
					"content": "Teuflische Augen sind Schätze von unglaublicher Macht, die von Ihrer Majestät der Zarin persönlich vergeben werden. Ob Glaube oder Göttliches Auge, ein Teuflisches Auge lässt sie alle wie ein Kinderspiel aussehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000806
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000806,
					"content": "Trotzdem kann nicht jeder eine führen. Neben den Elf besitzen nur sehr wenige andere Fatui ein Teuflisches Auge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000807
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000807,
					"content": "Nichtsdestotrotz ist ein Teuflisches Auge für einen gewöhnlichen Sterblichen wie mich viel praktischer als ein Göttliches Auge, welches man nur durch die Gnade der Götter erhalten kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000808
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000808,
					"content": "Ha, ich sehe, dass du auch kein Teuflisches Auge hast. Wie wäre es dann damit? Wenn du den Fatui beitrittst, wer weiß? Vielleicht besitzt du wirklich irgendwann ein Teuflisches Auge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000809
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000809,
					"content": "Und das ist alles, was ich zu Teuflischen Augen zu sagen habe. Der Ordo Favonius ist ziemlich reizbar bei diesen Dingen, schick sie mir also am besten nicht über den Weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 2060009,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
