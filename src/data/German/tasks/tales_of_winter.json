	"talks": [
		{
			"id": 2060001,
			"completionStepIds": [
				2060001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2060001",
							"2"
						],
						"stepId": 2060001,
						"stateName": "QUEST_STATE_UNFINISHED"
