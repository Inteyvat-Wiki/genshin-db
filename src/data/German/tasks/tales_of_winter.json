			},
			"dialogs": [
				{
					"id": 206000501,
					"content": "Vergiss nicht, dass du eine Mitachurl-Trophäe willst. Komm zurück, sobald du sie hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000502
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000502,
					"content": "Was ist es genau? Es ist ... ein Horn. Geh schon und hol es dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
