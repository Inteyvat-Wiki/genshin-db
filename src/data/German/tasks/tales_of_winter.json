			},
			"dialogs": [
				{
					"id": 206000901,
					"content": "Du suchst nach einer Trophäe von einem Ruinenwächter, richtig? Werd ja nicht faul und versuch, mich mit etwas anderem hinters Licht zu führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000902
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000902,
					"content": "*seufz* Ich werde mit jeder Minute schläfriger ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
