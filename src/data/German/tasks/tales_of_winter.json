			},
			"dialogs": [
				{
					"id": 206000701,
					"content": "Denk daran, du willst den Schatzräubern etwas abnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000702
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000702,
					"content": "Die Vereinbarung ist vom Tisch, wenn du mich mit irgendetwas Altem hinters Licht führen willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
