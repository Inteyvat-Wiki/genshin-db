			},
			"dialogs": [
				{
					"id": 206001001,
					"content": "Hast du die Sachen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001002
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001002,
					"content": "Ja, hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206001003
					]
				},
				{
					"id": 206001003,
					"content": "Oh, das ist gar nicht übel. Du hast was drauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001004
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001004,
					"content": "Du willst also etwas über Ihre Majestät die Zarin wissen, richtig? Wo soll ich bloß anfangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001005
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001005,
					"content": "Falls du eine einfache Zusammenfassung willst, ist sie, dass die Zarin unsere Göttin ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001006
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001006,
					"content": "Es gibt keine Abstraktion, nur konkrete Wahrheit. Die Zarin ist der Kryo-Archon, einer der Sieben, die über die Welt der Sterblichen herrschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001007
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001007,
					"content": "Aber für uns Fatui hat Ihre Majestät einen Status, der sogar über den einer Göttin hinausgeht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001008
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001008,
					"content": "Zu dem Warum ... Ich habe Zweifel, ob du es verstehen würdest, auch wenn ich es dir erkläre. Oder sollte ich sagen, du kannst es nicht verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001009
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001009,
					"content": "Falls du es verstehen willst, tritt uns bei. Sobald du das machst, wirst du verstehen, wie Ihre Majestät die Zarin ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001010
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001010,
					"content": "... Ha, und das ist alles, was ich jetzt sagen werde. Diese Ordensschwester schaut mich schon wieder abschätzig an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		}
	]
}