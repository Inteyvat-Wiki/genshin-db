			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206000401,
					"content": "Nun zur Zarin ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000402
					]
				},
				{
					"id": 206000402,
					"content": "Was, du willst mich zur Zarin befragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000403
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000403,
					"content": "Ist sie der Grund, warum du den Fatui beitreten willst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000404,
					"content": "Ich will dich nicht runterziehen, aber wäge deine Worte kurz ab. Warum nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000405
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000405,
					"content": "Trotzdem ist die Zarin ein Thema, worüber ich dir nichts erzählen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000406
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000406,
					"content": "Warum schnappst du dir nicht etwas von einem Ruinenwächter? Ich brauche etwas zum Spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000407,
						206000409
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000407,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000408
					]
				},
				{
					"id": 206000408,
					"content": "Dann mal los. Ich werde hier warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000409,
					"content": "Für was brauchst du das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000410
					]
				},
				{
					"id": 206000410,
					"content": "Äh? Darf ein Mann keine Schmuckstücke sammeln? Oder habt ihr Leute aus Mondstadt Angst vor Ruinenwächtern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000411
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000411,
					"content": "Wir Fatui müssten kaum einen Finger rühren, um es zu erledigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000412
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000412,
					"content": "Trotzdem ... *seufz* Diese Brise singt mich in den Schlaf, also werde ich diese Lappalie dir überlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 2060005,
			"completionStepIds": [],
