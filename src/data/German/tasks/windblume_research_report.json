			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000401,
					"content": "Willkommen bei „Sprache der Blumen“! Was kann ich für dich tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000402
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700000402,
					"content": "Also, was Sayids Foto angeht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000403
					]
				},
				{
					"id": 700000403,
					"content": "Hm, ich schätze es stimmt, dass das Windblumenfest eine einzigartige Besonderheit von Mondstadt ist. Die Menschen in Sumeru feiern es vermutlich nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000404
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700000404,
					"content": "Er möchte ein Foto von mir und den Blumen haben? Klar. Herr Sayid hat wirklich eine einzigartige Art zu denken. So sind Wissenschaftler wohl, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
