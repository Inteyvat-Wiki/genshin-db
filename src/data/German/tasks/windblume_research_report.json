			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000601,
					"content": "Bist du fertig mit den Bildern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000602
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000602,
					"content": "Ich habe sie alle hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000603
					]
				},
				{
					"id": 700000603,
					"content": "Oh, das sind sehr gute Aufnahmen. Sie werden meiner Forschung sicher sehr nützlich sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000604
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000604,
					"content": "Diese schönen Aufnahmen zu sehen erinnert mich an die Feste in meiner Heimatstadt, Sumeru ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000605
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000605,
					"content": "Was feiert ihr dort?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000606
					]
				},
				{
					"id": 700000606,
					"content": "Ah, du kennst unsere Traditionen wohl nicht. Jedes Jahr feiern wir das Sabzeruz-Fest, um der Geburt der Niederen Herrin Kusanali zu gedenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000607
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000607,
					"content": "Aber wenn ich die Atmosphäre vergleiche, würde ich schon sagen, dass es zwischen dem Fest hier und denen zu Hause einige Unterschiede gibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000608
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000608,
					"content": "Apropos, ich konnte auch nicht am diesjährigen Sabzeruz-Fest teilnehmen. Es ist so lange her ... Ich frage mich, wie die Dinge heutzutage an der Akademie so stehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000609
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000609,
					"content": "Aber ich schweife ab. Ich danke dir vielmals für deine Hilfe. Bitte akzeptiere dies als Bezahlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				}
			]
		}
	]
}