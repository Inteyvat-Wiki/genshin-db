			"trigger": {
				"objectNames": [
					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000101,
					"content": "Was für eine romantische Tradition. Das ist ein paar Nachforschungen wert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000102
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000102,
					"content": "Was tust du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000103
					]
				},
				{
					"id": 700000103,
					"content": "#Oh, du bist es, {F#Reisende}{M#Reisender}. Bist auch du aus Interesse an Mondstadts romantischen Liedern zur Bibliothek gekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000104
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000104,
					"content": "Dennoch, geschriebene Wörter können jederzeit gelesen werden, doch die Geschichte, die gerade um uns herum geschrieben wird, ist in einem Wimpernschlag vergangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000105
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000105,
					"content": "Die Menschen von Mondstadt haben während dieser gemütlichen und romantischen Zeit, die sich Windblumenfest nennt, viele besondere Rituale.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000106
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000106,
					"content": "Wie diese Rituale aussehen und was die Geschichte hinter ihnen ist? Beides sind vielversprechende Themen für Nachforschungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000107
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000107,
					"content": "Ich schreibe momentan einen Forschungsbericht und denke, dass Beschreibungen alleine nicht ausreichen werden. Könntest du mir helfen, indem du einige der Sehenswürdigkeiten rund um das Windblumenfest fotografierst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000108,
						700000110
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000108,
					"content": "Klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000109
					]
				},
				{
					"id": 700000109,
					"content": "Danke für deine Hilfe bei meiner Forschung. Ich werde dich in den Danksagungen erwähnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000113,
					"content": "Folgendes muss aufgenommen werden: <color=#00E1FFFF>die Blumendekoration auf dem Brunnenplatz</color>, <color=#00E1FFFF>die mit Blumen geschmückte Statue des Windgottes vor der Kathedrale</color> und die <color=#00E1FFFF>Besitzerin des Blumenladens, wie sie geschäftig arbeitet</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000115
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000115,
					"content": "Bitte fotografiere diese Sehenswürdigkeiten für mich und bring mir die Bilder danach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000110,
					"content": "Du machst das besser selbst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000111
					]
				},
				{
					"id": 700000111,
					"content": "Nein, nein! Ich kann jetzt nicht gehen. Ich habe bis jetzt nur die grobe Gliederung von meinem Bericht fertig. Wenn ich jetzt gehe, dann wird mein Denkprozess unterbrochen und ich verliere den roten Faden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000112
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000112,
					"content": "#Ich zähle auf dich, {F#Reisende}{M#Reisender}. Wenn ich auch nicht viel habe, aber ich werde dich entlohnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "Sayid"
				}
			]
		},
		{
			"id": 7000003,
