					"nextDialogs": [
						730030604
					]
				},
				{
					"id": 730030604,
					"content": "Keine Antwort ... Verdammt! Was geht hier vor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030605,
					"content": "Hm? Diese Spuren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030607,
					"content": "Folgen wir ihnen, vielleicht hat uns Rana ja eine Fährte hinterlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030606,
					"content": "Sind diese Spuren etwa ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030607
					]
				}
			]
		},
		{
