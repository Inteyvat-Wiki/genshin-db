					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030301,
					"content": "Puh ... Ah ... Endlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030302
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030302,
					"content": "Rana ... Uääh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030303
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030303,
					"content": "Iotham ... Männer weinen nicht. Schau ... Ich kann jetzt ihnen erzählen, was ich in der Verwelkung gespürt habe ... den Gelehrten der Akademie ... Danach werden sie die Verwelkung beseitigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030304
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030304,
					"content": "#Und ... hast du gesehen, wie ich gekämpft ... Nein, wie {NICKNAME} gekämpft hat? Du solltest {M#ihm}{F#ihr} danken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030305
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030305,
					"content": "Rana ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030306,
						730030308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030306,
					"content": "Sag nichts.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030307
					]
				},
				{
					"id": 730030307,
					"content": "Rana, ruh dich erstmal aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030309,
					"content": "Ha... haha, es ist nichts, mir ist nur ein wenig schwindelig und ... ich bin müde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030310
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030310,
					"content": "Rana ... Entschuldigung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030311
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030311,
					"content": "Was ... soll das heißen ... Du bist doch mein kleiner Tiger, weine nicht! Bist du in Ordnung? Iotham ... ist dir unwohl? ... Ist dir schwindelig oder fühlst du dich schwach?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030312
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030312,
					"content": "Alles gut, aber Rana ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030313
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030313,
					"content": "Kein Problem! Mach dir um mich keine Sorgen, ich bin doch eine erfahrene Waldhütermeisterin! Lasst uns gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030308,
					"content": "Ich hole Hilfe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030309
					]
				}
			]
		},
