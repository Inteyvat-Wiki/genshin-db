					"speakerTitle": "Iotham"
				},
				{
					"id": 730030825,
					"content": "„Marana“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030826
					]
				},
				{
					"id": 730030826,
					"content": "Das bedeutet ... die Verwelkung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
