					"id": 730031102,
					"content": "Ja, keine Sorge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730031105
					]
				},
				{
					"id": 730031105,
					"content": "Scheint so, als hatte Alphonso recht. Die Fatui sind wirklich sehr gefährlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031106
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730031106,
					"content": "Lasst uns später darüber sprechen. Iotham sollte sich noch tiefer drinnen in der Höhle befinden. Lasst uns losgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730031103,
					"content": "Du hast gut gekämpft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730031104
					]
				},
				{
					"id": 730031104,
					"content": "Wirklich? Hehe, vielleicht liegt es daran, dass du und Paimon an meiner Seite waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031105
					],
					"speakerTitle": "Rana"
				}
