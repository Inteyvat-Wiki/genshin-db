			"dialogs": [
				{
					"id": 730030601,
					"content": "... Hä? Paimon war sich sicher, dass es hier war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030602
					],
					"speakerTitle": "Paimon"
				},
				{
