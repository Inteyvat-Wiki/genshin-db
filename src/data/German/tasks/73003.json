			"dialogs": [
				{
					"id": 730031001,
					"content": "W... Wer seid ihr? Kommt uns nicht in die Quere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031002
					],
					"speakerTitle": "Fatui-Offizier"
				},
				{
					"id": 730031002,
					"content": "Ha! Wir sollten euch fragen, wer ihr seid! Ich bin die Waldhütermeisterin hier und suche nach einem vermissten Kind. Und wer seid ihr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031003,
						730031004
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730031003,
					"content": "Ooh, Fatui! Woher kommen sie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730031005
					]
				},
				{
					"id": 730031005,
					"content": "Oh? Das sind also die „Fatui“, die Alphonso erwähnt hat. Warum seid ihr hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031006
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730031006,
					"content": "Alphonso ...? Egal. Ihr kommt mir jedenfalls nicht so leicht davon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031007
					],
					"speakerTitle": "Fatui-Offizier"
				},
				{
					"id": 730031007,
					"content": "Ach, es scheint keinen anderen Weg zu geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730031004,
					"content": "Das sind Fatui, Vorsicht!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730031005
					]
				}
			]
