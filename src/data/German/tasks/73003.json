			"dialogs": [
				{
					"id": 730030701,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030702
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030702,
					"content": "He! Rana! Hörst du uns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030703,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030704
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030704,
					"content": "Wie ... Wie kann das sein ... Ist es das, wovon Rana und Iotham gesprochen haben? Es heißt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030705,
						730030708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030705,
					"content": "„Ararakalari“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030706
					]
				},
				{
					"id": 730030706,
					"content": "Ah, jajaja! Genau das ist es! Paimon glaubt, sie sagten, es könnte der Korrosion durch Marana entgegenwirken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030707,
					"content": "Ja ... Nara ist nicht dumm. Das ist Ararakalari. Damit kann man Marana widerstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030711,
					"content": "Wah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030712,
					"content": "Wah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030713,
						730030715
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030713,
					"content": "Das kommt mir bekannt vor ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030714
					]
				},
				{
					"id": 730030714,
					"content": "Uff ... Was für ein Schreck! Paimon hatte schon gedacht, das Gemüse könne sprechen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030716,
					"content": "Kein Gemüse, ich bin Arana. Arana ist eine Freundin, ein Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030717,
						730030722
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030717,
					"content": "„Aranara“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030718
					]
				},
				{
					"id": 730030718,
					"content": "Hm? Aranara? Bei näherer Betrachtung glaubt Paimon, dass dies eines der mysteriösen Wesen ist, die wir vorhin gesehen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030719,
					"content": "„Arana“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030720
					]
				},
				{
					"id": 730030720,
					"content": "Paimon meint, wir haben diesen Namen schon einmal gehört, als wir Iotham Geschichte erzählte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030721,
					"content": "Ja. Nara Iotham ist ein Freund von Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030727
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030727,
					"content": "#Aranara sind die Kinder des Waldes, die mit den Bäumen leben. Anders als du, Nara {NICKNAME}. Du bist wie ein Kind des Löwenzahns ... immer auf Reisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030728
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030728,
					"content": "#Woher kennst du den Namen von {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030729,
					"content": "Woher Arana das weiß, ist nicht wichtig. Aber es ist wichtig, dass Arana Nara Rana helfen will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030730,
						730030732
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030730,
					"content": "Nara Rana ... Was für ein Zungenbrecher ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030731
					]
				},
				{
					"id": 730030731,
					"content": "Rana helfen? Was sollen wir tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030733,
					"content": "Danke euch. Ihr seid gute Nara. Sie ist eine gute, sehr wichtige Freundin von Arana. Deswegen muss Arana sie schützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030734
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030734,
					"content": "#Aber das genügt noch nicht. Um Nara Rana zu heilen, benötigen wir die „Bija“. Nara {NICKNAME}, geh nach „Vanarana“ und bitte alle darum, „Bija“ zu kriegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030735,
						730030736
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030735,
					"content": "„Bija“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030737
					]
				},
				{
					"id": 730030737,
					"content": "Nara Rana ist schwer von Marana korrodiert. Wenn Schädlinge in die Wurzeln eines Baumes beißen, verdorrt der Baum und verfaulen seine Früchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030738
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030738,
					"content": "Leben der Nara sind wie ein Baum und die Schädlinge sind wie Marana. Nur mithilfe der „Bija“ kann sich Nara Rana wieder erholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030739
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030739,
					"content": "Ähm ... Wir müssen also zu einem Ort namens „Vanarana“ gehen und einen Weg finden, die „Bija“ zu bekommen. Und dann können wir Rana heilen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030740
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030740,
					"content": "Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030741,
						730030744
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030741,
					"content": "Ranas jetziger Zustand ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030742
					]
				},
				{
					"id": 730030742,
					"content": "Keine Sorge. Arana ist hier, um der Korrosion durch Marana entgegenzuwirken. Wird also nicht schlechter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030743
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030743,
					"content": "Aber ohne die „Bija“ kann auch nichts besser werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030745
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030745,
					"content": "Folgt dem „Waldpfad“, immer der Wasserquelle entgegen. So kommt ihr nach „Vanarana“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030746
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030746,
					"content": "Dann singen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030747,
						730030748
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030747,
					"content": "Singen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030750
					]
				},
				{
					"id": 730030750,
					"content": "(Eine Melodie ertönt in deinem Bewusstsein ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030751
					]
				},
				{
					"id": 730030751,
					"content": "Das ist die „Melodie des Großen Traums“. Man muss sie singen, um das „Vanarana“ betreten zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030752
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030752,
					"content": "Betretet unseren Traum, betretet unsere Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030748,
					"content": "Das wird Vaniloquen anlocken ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030749
					]
				},
				{
					"id": 730030749,
					"content": "#Nara {NICKNAME}, sehr witzig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030750
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030744,
					"content": "Verstehe. Wie kommen wir da hin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030745
					]
				},
				{
					"id": 730030736,
					"content": "Was ist das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030737
					]
				},
				{
					"id": 730030732,
					"content": "Was kann ich tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030733
					]
				},
				{
					"id": 730030722,
					"content": "„Arana“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030723
					]
				},
				{
					"id": 730030723,
					"content": "Paimon meint, wir haben diesen Namen schon einmal gehört, als wir Iotham Geschichte erzählte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030724,
					"content": "Ja. Nara Iotham ist ein Freund von Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030725
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030725,
					"content": "„Aranara“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030726
					]
				},
				{
					"id": 730030726,
					"content": "Hm? Aranara? Bei näherer Betrachtung glaubt Paimon, dass dies eines der mysteriösen Wesen ist, die wir vorhin gesehen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030715,
					"content": "Gemüse ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030716
					]
				},
				{
					"id": 730030708,
					"content": "Was?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030709
					]
				},
				{
					"id": 730030709,
					"content": "Paimon glaubt, sie sagten, es könnte der Korrosion durch Marana entgegenwirken ... Es hat einen seltsamen Namen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030710,
					"content": "Das ist Ararakalari. Damit kann man die Korrosion durch Marana verhindern. Der Name ist nicht seltsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "Arana"
				}
			]
		},
		{
			"id": 7300308,
			"completionStepIds": [
				7300314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7300314",
							"2"
						],
						"stepId": 7300314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rana",
					"Paimon",
					"Iotham"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030801,
					"content": "#Es tut mir leid, {NICKNAME}, Paimon, ich muss mich etwas ausruhen ... Iotham, warte auf mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030802
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030802,
					"content": "Sicher, dass es dir gut geht, Rana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030803,
					"content": "Wir holen jetzt Hilfe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030804
					]
				},
				{
					"id": 730030804,
					"content": "Kein Problem, kein Problem ... Mir ist nur ein bisschen ... Ich muss mich nur etwas ausruhen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030805
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030805,
					"content": "Entschuldigung, Rana ... Entschuldigung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030806
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030806,
					"content": "Ich habe dir gesagt, dass es mir gut geht! Aber ich bin auch sehr wütend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030807
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030807,
					"content": "Hast du mir nicht ausdrücklich versprochen, nicht in den Wald zu gehen? ... Warte nur, bis ich mich erholt habe, werde ich dir ... sicher eine Lehre erteilen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030808
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030808,
					"content": "*wimmer* ... Ich habe doch nur von Alphonso gehört, dass es hier riesige Pilze geben würde! Und ich wollte dir nur ein paar frische Pilze bringen ... Sie sind köstlich, sie werden dich aufheitern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030809
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030809,
					"content": "Kleiner Idiot ... so etwas Überflüssiges ... Ich muss nur an alle denken, davon allein habe ich schon viel Energie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030810
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030810,
					"content": "Aber, hahaha ... Die Pilze hier sind wirklich groß ... In einem Curry würden sie bestimmt super schmecken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030811
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030811,
					"content": "Hat Alphonso dich geschickt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030812
					]
				},
				{
					"id": 730030812,
					"content": "Nein, Alphonso hat auch gesagt, dass ich nicht in den Wald gehen sollte. Aber ich möchte eben, dass Rana gut isst ... und deshalb ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030813
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030813,
					"content": "So etwas würde Alphonso nicht tun, er ist doch Iothams großer Bruder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030814
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030814,
					"content": "Ja aber ... wie konnte Iotham dann nur in die Verwelkung geraten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030815,
					"content": "Als ich im Wald war, dachte ich, jemand würde mir folgen ... Ich bekam Angst, ich dachte, es wäre die „Inkarnation von Marana“ ... Also rannte ich einfach weiter ... *schluchz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030816
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030816,
					"content": "Und am Ende bin ich in „Marana“ hineingerannt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030817
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030817,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030818,
						730030823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030818,
					"content": "„Marana“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030819
					]
				},
				{
					"id": 730030819,
					"content": "Das bedeutet ... die Verwelkung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030820
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030820,
					"content": "Ah, ja ... die Verwelkung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030821
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030821,
					"content": "Die „Inkarnation von Marana“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030822
					]
				},
				{
					"id": 730030822,
					"content": "Ja, der Ersatz für Marana auf Erden, der üble Dinge verrichten kann ... Das dunkle, böse Ding ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030828
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030828,
					"content": "Marana ... was für ein seltsamer Name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030829,
					"content": "Hmm ... Woher wusste ich, dass Marana die Verwelkung ist ... Ach, ich hab Kopfweh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030830
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030830,
					"content": "Iotham, was war dieses grüne Ding gerade eben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030831
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030831,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030832
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030832,
					"content": "Das war „Ararakalari“ ... Damit kann man die Menschen beschützen, denn Marana kann Ararakalari keine Korrosion antun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030833
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030833,
					"content": "Das werden immer mehr Sachen, die ich nicht verstehe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030834
					]
				},
				{
					"id": 730030834,
					"content": "Das ist ... eine Art „Magie“ des Waldes, aber auch eine Art „Musik“ ... Das ist Ara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030835,
						730030837
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030835,
					"content": "Was denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030836
					]
				},
				{
					"id": 730030836,
					"content": "Denk nicht so viel darüber nach! Ruhe dich erst mal gut aus, Rana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030838,
					"content": "Ich erinnere mich gleich, es ist aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030839
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030839,
					"content": "Entschuldigung, Rana, Entschuldigung ... in Zukunft werde ich nicht mehr herumlaufen, sondern brav zu Hause bleiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030840
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030840,
					"content": "Ja, ich weiß. Du musst klüger und gesünder werden und verstehen, was der Unterschied zwischen falsch und richtig ist. So wie du auch weißt, welchen Pilz du essen kannst und von welchem Pilz du die Finger lassen solltest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030841
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030841,
					"content": "Ich weiß ... Ich weiß ... Entschuldige ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030842
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030842,
					"content": "#Du musst verstehen, dass „Marana“ böse ist und ... der Wald ist gut ... du sollst stark und ehrlich werden und Menschen in Not helfen ... so wie {NICKNAME} und Paimon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030843
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030843,
					"content": "Und dann sollst du nicht vergessen ... dass der Wald nichts vergisst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030844
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030844,
					"content": "Wah, das geht nicht! Paimon scheint, dass sich Ranas Zustand zunehmend verschlechtert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030845,
						730030846
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030845,
					"content": "Wir werden jemand um Hilfe bitten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030847,
					"content": "Hä? Ah ... kein Problem, kein Problem ... ich ruhe mich nur etwas aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030848
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030848,
					"content": "#{NICKNAME}, ich bitte dich ... bring für mich Iotham zurück ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030849
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030849,
					"content": "Ja, lass uns gehen, Iotham. Rana, renn nicht einfach weg! Wir sind bald zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030846,
					"content": "Rana, warte auf uns.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030837,
					"content": "Denk nicht so viel darüber nach, ruhe dich erstmal aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030838
					]
				},
				{
					"id": 730030823,
					"content": "Die „Inkarnation von Marana“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030824
					]
				},
				{
					"id": 730030824,
					"content": "Ja, der Ersatz für „Marana“ auf Erden, der üble Dinge verrichten kann ... Das dunkle, böse Ding ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030825
