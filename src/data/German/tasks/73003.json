			"dialogs": [
				{
					"id": 730030201,
					"content": "Iotham, wie kann das sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030202
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030202,
					"content": "#*wimmer* Rana und {NICKNAME} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030203
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030203,
					"content": "Was? Was macht Iotham hier ... in einer Verwelkung?! Und so viele Monster ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030204,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030205,
						730030206
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030205,
					"content": "Überlasse das hier mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				},
				{
					"id": 730030207,
					"content": "Nein, wir haben keine Zeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030208
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030208,
					"content": "#Verdammt! {NICKNAME}, bitte! Zusammen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030209
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030209,
					"content": "Iotham, sei brav und beweg dich nicht! Wir kommen, um dich zu retten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030206,
					"content": "Was ist das Grüne da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				}
			]
		},
		{
			"id": 7300303,
			"completionStepIds": [
				7300306
			],
