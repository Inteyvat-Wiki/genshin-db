			"dialogs": [
				{
					"id": 730030501,
					"content": "#Iotham? Wieso bist du ... Und {NICKNAME} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030502
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730030502,
					"content": "Die Zeit drängt, machen wir es kurz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030503,
					"content": "Ihr berichtet schnell, was passiert ist.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730030504
					]
				},
				{
					"id": 730030504,
					"content": "... Ich verstehe. Iotham, ruh dich gut aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030505
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730030505,
					"content": "... Es tut mir leid, Alphonso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030506
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030506,
					"content": "#Es macht nichts, Hauptsache, es geht dir gut ... {NICKNAME}, warte kurz auf mich. Ich präpariere etwas Medizin und dann können wir gleich los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030507
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730030507,
					"content": "Wir haben keine Zeit. Hier ist der Ort, mach dich so schnell wie möglich auf den Weg.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030508
					]
				},
				{
					"id": 730030508,
					"content": "Ja, wir müssen schnell zurück und nach Rana sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030509,
					"content": "He, wartet ...",
