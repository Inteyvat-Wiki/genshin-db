			"dialogs": [
				{
					"id": 401450101,
					"content": "Nach einer kurzen Probezeit wird der Trankladen nun mit großem Erfolg eröffnet ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401450102
					]
				},
				{
					"id": 401450102,
					"content": "*seufz* Wir werden einfach von immer mehr Kunden überrannt. Wir arbeiten schon so lange ununterbrochen, dass Paimon langsam ein bisschen schwindelig wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450103,
						401450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450103,
					"content": "Das Geschäft läuft wirklich gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				},
				{
					"id": 401450105,
					"content": "Wir haben eine Menge Aufträge. Paimon ist sich nicht sicher, ob wir sie alle allein erledigen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450106,
					"content": "Vielleicht sollten wir einen Helfer einstellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450107,
					"content": "Macht ihr eine Pause, ihr Süßen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450108,
					"content": "Ich habe mir gerade die Verkaufszahlen angesehen und es scheint, als hättet ihr beiden ein ziemliches Talent fürs Geschäft. Die Tränke scheinen förmlich aus den Regalen zu fliegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450109,
					"content": "Oh, Lisa! Ihr kommt gerade richtig! Wir haben eben darüber gesprochen, dass wir im Laden Hilfe gebrauchen könnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450110,
					"content": "Oh? Stapeln sich die Bestellungen schon? Habt ihr Schwierigkeiten mitzuhalten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450111,
					"content": "Ja, wir ertrinken offiziell in Bestellungen! Paimon hätte nie gedacht, dass wir so viele Kunden bekommen würden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450112,
					"content": "Nun, ich kann nicht sagen, dass mich der Erfolg überrascht. Ich hatte sogar mit einer solchen Reaktion gerechnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450113,
					"content": "Während ihr beiden mit dem Laden beschäftigt wart, habe ich mit Freda über Möglichkeiten gesprochen, das Geschäft effizienter zu gestalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450114,
					"content": "Nachdem ich mir eure Arbeit angesehen habe, sind mir mehrere Dinge aufgefallen, die wir bei der Herstellung, dem Anbau und dem Verkauf von Produkten verbessern könnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450115,
					"content": "Moment, Ihr habt also die ganze Zeit hinter den Kulissen zugesehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450116,
					"content": "Paimon dachte schon, Ihr würdet irgendwo auf der faulen Haut liegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450117,
					"content": "He, jetzt kommt schon, ich bin ziemlich zuverlässig, wenn es darauf ankommt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450118,
					"content": "Wie also sollen wir diese Verbesserungen in die Tat umsetzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450119,
					"content": "Nun, ich habe mit Freda darüber gesprochen und wir beide haben einen Plan ausgearbeitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450120,
					"content": "Ich lasse sie dir aber die Details erzählen. Warum gehst du nicht zu ihr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450104,
					"content": "Wir haben uns einen guten Namen gemacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				}
			]
		},
