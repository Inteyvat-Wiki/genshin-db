				]
			},
			"dialogs": [
				{
					"id": 401450201,
					"content": "#{NICKNAME}! Paimon! Hallo! Gibt es etwas, wobei ich euch helfen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450202
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450202,
					"content": "Nun, wir waren in letzter Zeit etwas überlastet, also hat Lisa vorgeschlagen, dass wir einige Möglichkeiten finden, unsere Effizienz zu steigern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450203,
					"content": "Ah, ja! Darüber hat sie auch mit mir gesprochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450204
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450204,
					"content": "Derzeit gibt es drei Bereiche, in denen ihr euch verbessern könnt: beim Brauen, beim Anbau und beim Verkauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450205
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450205,
					"content": "Wenn ihr eure Effizienz in diesen Bereichen steigert, wird es viel einfacher, euer Unternehmen zu führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450206
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450206,
					"content": "#Wah, das klingt genau nach dem, was wir brauchen! Versuchen wir es mal, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450207,
						401450209,
						401450211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450207,
					"content": "Die Effizienz des Unternehmens steigern",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450208
					]
				},
				{
					"id": 401450208,
					"content": "Es sieht so aus, als ob alle Vorbereitungen für diese Verbesserung getroffen worden sind! Probiert sie bitte aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450209,
					"content": "Vorräte kaufen",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450210
					]
				},
				{
					"id": 401450210,
					"content": "Dann habt ihr Glück! Ich habe gerade eine neue Ladung an Vorräten bekommen! Schaut doch mal rein, ob euch etwas ins Auge fällt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450211,
					"content": "Tschüs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450212
					]
				},
				{
					"id": 401450212,
					"content": "Viel Erfolg bei eurem Unternehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				}
			]
		}
	]
}