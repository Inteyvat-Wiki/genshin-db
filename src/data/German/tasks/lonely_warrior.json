					}
				]
			},
			"dialogs": [
				{
					"id": 160110701,
					"content": "Ist das ... das Herz des Wolfs?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110702
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110702,
					"content": "...! Roland!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
		{
			"id": 1601109,
			"completionStepIds": [
				1601109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1601109",
							"2"
						],
						"stepId": 1601109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roland"
				],
				"points": [
					{
						"sceneId": 20336,
						"position": [
							387.989,
							123.18,
							197.075
						],
						"pointId": 1
					},
					{
						"sceneId": 20336,
						"position": [
							387.824,
							111.946,
							237.497
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 160110901,
					"content": "... Wie du wünschst, Ritter des Nordwinds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110902
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110902,
					"content": "Hah, du bist nicht ganz so, wie ich dich mir vorgestellt habe. Du wirkst nicht mal halb so wahnsinnig wie in den Erinnerungen des Wolfsgeistes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110903
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110903,
					"content": "Nicht ein einziges Mal bin ich vom rechten Weg abgekommen. Aber wenn ich dich ansehe ... sehe ich keinen Helden, der Drachen erschlagen kann. Nur eine verlorene Seele, die schon viel zu lange umherirrt. Einen Schatten des Ritters, der du einst warst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110904
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110904,
					"content": "Das haben wir wohl gemeinsam. Keiner von uns ist in Bestform.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110905
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110905,
					"content": "Die Truppen des Rächers von Solnari sind besiegt, und der Roland, den du siehst, ist nur ein unvollkommenes Abbild aus dem Abgrund.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110906
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110906,
					"content": "Ich besitze die Macht, die Roland auf seinem Höhepunkt hatte, doch mein Herz und mein Verstand sind in jenem blutbefleckten Moment erstarrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110907
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110907,
					"content": "Deswegen bin ich in meiner jetzigen Form fehlerhaft ... Ein Ritter kann seinen eigenen Stillstand nicht ertragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110908
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110908,
					"content": "Nachdem ich dich von der Ungerechtigkeit erlöst und deine Hingabe an den Abgrund geleitet habe, werde ich mich selbst läutern und weiter den ritterlichen Weg beschreiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110909
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110909,
					"content": "Hah! Die Welt dort draußen kann deine Qualen nicht mehr ertragen. Deine Besessenheit ist eindeutig genau so geblieben, wie ich es mir vorgestellt hatte. Ich nehme an, es gibt keine Chance, dich zur Vernunft zu bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110910
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110910,
					"content": "Keine Worte können einen Ritter an seinen Überzeugungen zweifeln lassen, ganz gleich, wie edel sie klingen. Keiner von uns wird den anderen umstimmen ... Aber das weißt du doch längst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110911
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110911,
					"content": "Warum solltest du sonst all deine Hoffnung auf einen einzigen Gedanken von Boreas setzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110912
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110912,
					"content": "Aber nun ist die Klinge, die einst den Wolfsgeist beherbergte, zersplittert. Was du jetzt in Händen hältst, ist nur ein Phantom, das ihre Form trägt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110913
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110913,
					"content": "Du hast keine Mittel mehr, um die Situation zu ändern, und niemand wird kommen, um dich zu retten ... Dieser Ort soll dein Grab werden, einsamer Krieger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110914
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110914,
					"content": "Äh, vielleicht hast du teilweise recht ... Aber ich glaube, ich habe eine Chance auf Rettung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110915,
					"content": "... Was meinst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110916
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110916,
					"content": "Ich muss nur die Meinung einer einzigen Person ändern, und das ist nicht deine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110917,
					"content": "Hast du vergessen, wo wir sind? Das ist das Herz von Andrius – dem Gott des Nordwinds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110918
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110918,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110919
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110919,
					"content": "Andrius! Kannst du mich hören?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110920
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110920,
					"content": "Wach auf! Du bist der große Gott des Nordwindes! Wie lange willst du dich noch vom Abgrund beherrschen lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110921
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110922
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110922,
					"content": "... Wenn das dein letzter Schachzug ist, dann bin ich zutiefst enttäuscht, Ritter des Nordwinds.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110923
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110923,
					"content": "Große Gesten innigster Wünsche können keine Wunder wirken. Diese Welt zeigt ihren Bewohnern keine solche Gnade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110924
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110924,
					"content": "... Zurück ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110925
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110925,
					"content": "... Zurück ... zum ... Fluss der Elemente ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110926
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110926,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110927
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110927,
					"content": "... Das ist meine Entscheidung ... meine Erinnerung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110928
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110928,
					"content": "... Ist das die Antwort, die ich ... am Ende meiner Reise gefunden habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110929
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110929,
					"content": "And{RUBY#[D]Boreas}rius ... Endlich habe ich dein Andenken zurück in dein Herz gebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110930
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110930,
					"content": "Heh ... Ein Ritter des Nordwinds? Schau nur zu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110931
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110931,
					"content": "... Das ist alles, was ein Wo{RUBY#[S]Ich}lf für die Mensch{RUBY#[S]Euch}heit tun kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110932
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110932,
					"content": "Im Namen der gesamten Menschheit danke ich dir, Wolfskönig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110933
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110933,
					"content": "Boreas ... kehrt in den Fluss der Elemente zurück? Aber warum? Dein Schwert ist zerbrochen – du kannst seine Seele nicht länger tragen ... Es sei denn ... Das kann doch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110934
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110934,
					"content": "Um Wunder zu betteln ist ein sinnloses Unterfangen. Das weiß ich besser als jeder andere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110935
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110935,
					"content": "... Aber ein Schwert ist nur eine Art von Gefäß. Es gibt auch andere Möglichkeiten, eine Seele zu bewahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110936
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110936,
					"content": "Der Herr von Wolfenlauf verlieh einst seinem Rudel die Kraft seiner Seele, stärkte ihre Herzen und schärfte ihre Klauen und Reißzähne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110937
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 160110937,
					"content": "... Selbst wenn es nicht meine Absicht ist, wird die Seele von Lupus Boreas ein sterbliches Herz unweigerlich verwüsten, verschlingen und assimilieren ... Als ob Mensch und Wolf gewaltsam zu einem einzigen Wesen verschmolzen würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110938
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 160110938,
					"content": "... Wenn ein sterbliches Herz die Seele eines Gottes tragen soll ... Das ist ein Weg, der nicht wieder zurückgegangen werden kann. Doch werde ich einen Ritter nicht davon abbringen, sich auf die Suche seiner Wahl zu begeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110939
					],
					"speakerTitle": "„Capitano“"
				},
				{
					"id": 160110939,
					"content": "Dein Herz, deine Seele ... sie brechen zusammen? ... Ah, jetzt verstehe ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110940
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110940,
					"content": "Du hast dich gefragt, wie ein Lamm das Herz eines Wolfs zähmen kann ... nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110941
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110941,
					"content": "Hier ist meine Antwort: Man bringt den Wolf dazu, das Herz zu verschlucken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110942
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110942,
					"content": "Der Wolfsgeist im Schwert war nur eine Täuschung ... Die wahren Gedanken und Erinnerungen hast du in deinem Herzen getragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110943
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110943,
					"content": "Um keinen Verdacht zu erregen, hast du absichtlich zugelassen, dass die Seele des Lupus Boreas die deine assimiliert und dann von mir verschlungen wird ... Aber ... wie hattest du die Kraft zu kämpfen, während du solch eine große Last getragen hast ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110944
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110944,
					"content": "Verglichen mit Lupus Boreas’ Entscheidung ... ist mein Opfer nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110945
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110945,
					"content": "Du hast einen sturen Willen und eine außergewöhnliche Strategie angewandt ... Aber so kämpft kein wahrer Ritter. Deine Entscheidung ist fehlerhaft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110946
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110946,
					"content": "Deine Seele ist nun mit der von Andrius verschmolzen. Wenn er sich vollständig mit dem Fluss der Elemente vereint, wirst auch du vergehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110947
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110947,
					"content": "#Weder Barbatos noch {F#die}{M#der} Reisende werden deine Seele aus dem Fluss der Elemente heraus verankern können, geschweige denn dich retten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110948
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110948,
					"content": "Du hast verloren, und ich auch. Bedauerlicherweise kann ich dir keine Erlösung mehr bieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110949
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110949,
					"content": "... Möge deine Seele in Frieden bei Boreas ruhen, einsamer Krieger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110950
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110950,
					"content": "... Haha, einsam ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110951
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110951,
					"content": "Tut mir leid, dich enttäuschen zu müssen, aber ... Auch wenn es wie das perfekte Ende klang, dass wir beide gemeinsam in den Fluss der Elemente zurückkehren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110952
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110952,
					"content": "Tatsache ist, dass ich, anders als der wahre Roland von früher, noch guten Wein und gute Freunde habe, zu denen ich zurückkehren kann. Sie freuen sich auf meine triumphale Rückkehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110953
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110953,
					"content": "Also bin ich noch nicht bereit, mein Schicksal zu akzeptieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110954
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110954,
					"content": "Ding-dong! Du hast Post!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1601111,
			"completionStepIds": [
				1601111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
