					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varka"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1901.891,
							200.883,
							-1273.284
						],
						"pointId": 14920
					},
					{
						"sceneId": 3,
						"position": [
							1901.932,
							200.526,
							-1275.205
						],
						"pointId": 15700
					},
					{
						"sceneId": 3,
						"position": [
							1902.579,
							200.345,
							-1275.58
						],
						"pointId": 15701
					}
				]
			},
			"dialogs": [
				{
					"id": 160111201,
					"content": "Ahhh ... Es ist eine Weile her, seit ich diesen Wind in meinem Gesicht gespürt habe ... Genauso, wie ich es in Erinnerung habe. Also, gibt es etwas, worüber du reden möchtest? Jetzt ist deine Chance, bevor ich wieder ins Büro gezerrt werde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111202,
						160111215,
						160111219,
						160111231
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111202,
					"content": "Über deinen Plan ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111203
					]
				},
				{
					"id": 160111203,
					"content": "Das Schwert war nur eine Ablenkung – ich trug seine Seele in meinem eigenen Herzen ... Das war der Plan, bei dem ich mir am sichersten war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111204
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111204,
					"content": "Aber beim zweiten Teil – die Gedanken aller zu nutzen, um mich aus dem Fluss der Elemente zurückzuholen ... Da war ich mir nicht so sicher, ob das klappt, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111205
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111205,
					"content": "#Spaß beiseite, was hättest du getan, wenn {NICKNAME} den Wolfsgeist nicht von Rolands Einfluss hätte trennen können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 160111206,
					"content": "#Hmm ... Ursprünglich wollte ich, dass Barbatos diesen Schritt übernimmt. Doch als ich ihn fragte, meinte er, ein anderer Kandidat sei viel besser geeignet ... {F#Die Fremde, die den Wind fing}{M#Der Fremde, der den Wind fing}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111207
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111207,
					"content": "#Stellt sich heraus, dass unser Vertrauen nicht fehl am Platz war. Danke, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111208
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111208,
					"content": "Aber was, wenn ich gescheitert wäre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111209
					]
				},
				{
					"id": 160111209,
					"content": "Dann ... müssten wir wohl Barbatos bitten, mich mit einem Windstoß nach Hause zu wehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111210
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111210,
					"content": "... Aber der Preis wäre hoch gewesen, und es gab keine Garantie auf Erfolg. Außerdem möchte ich nicht, dass er solche Kräfte aufwenden muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111211,
						160111212
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111211,
					"content": "... Die Macht eines Archons beschwören ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111213
					]
				},
				{
					"id": 160111213,
					"content": "Hmm, gute Frage ... vielleicht ein Glas vom feinsten Löwenzahnschnaps? Zweifellos müsste ich dafür das geheime Bargeldversteck in meinem Büro plündern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111214
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111214,
					"content": "Träum weiter, wenn du denkst, dass es so billig wäre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 160111212,
					"content": "... Wie hoch ist der Preis, von dem wir hier sprechen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111213
					]
				},
				{
					"id": 160111215,
					"content": "Über die Expeditionstruppe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111216
					]
				},
				{
					"id": 160111216,
					"content": "Nun, da der Schatten von Roland besiegt ist, wird die Wilde Jagd ihre Truppen in absehbarer Zeit nicht neu formieren können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111217
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111217,
					"content": "Ein paar Ritter bleiben abwechselnd im Stützpunkt in Nod-Krai, aber alle anderen werden in Wellen nach Hause geschickt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111218
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111218,
					"content": "Albedo und Durin kommen mit der ersten Welle zurück, also solltest du sie bald wiedersehen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111219,
					"content": "Über deine Zukunft ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111220
					]
				},
				{
					"id": 160111220,
					"content": "Meine Zukunft, hm ... Vielleicht hast du es schon von Barbatos oder dem Hexenzirkel erfahren, aber ich habe einen Blick in die Zukunft durch Barbeloths Wasserspiegel geworfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111221
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111221,
					"content": "Du hast im Norden eine große Katastrophe aus dem Abgrund gesehen, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111222
					]
				},
				{
					"id": 160111222,
					"content": "Richtig. Allerdings ... so wie die Dinge jetzt stehen ... glaube ich, dass wir den Lauf der Zukunft vielleicht verändert haben – nicht zuletzt dank dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111223
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111223,
					"content": "Aber wenn ich hier beim Ritterorden alles erledigt habe, muss ich nochmal hoch in den Norden reisen ... Am Stützpunkt Nod-Krai gibt es noch viel zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111224
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111224,
					"content": "Außerdem muss die erste Gruppe Ritter, die freiwillig dort geblieben ist, noch abgelöst werden. Wie könnte ich sie einfach im Stich lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111225
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111225,
					"content": "Och, wie edel ... Aber sei ehrlich, du gehst doch hauptsächlich nach Nod-Krai zurück, damit du deine ganze Arbeit hier wieder auf Jean abwälzen kannst, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 160111226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111227
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111227,
					"content": "... Warte, im Ernst?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111228,
						160111229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 160111228,
					"content": "Willst du nicht mal was zu deiner Verteidigung sagen ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111230
					]
				},
				{
					"id": 160111230,
					"content": "Haha. Ich nehme euch doch nur auf den Arm. Ihr werdet mich ab jetzt noch viel öfter in Mondstadt sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111229,
					"content": "Steh nicht einfach nur da und grinse!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111230
					]
				},
				{
					"id": 160111231,
					"content": "Ich habe keine Fragen mehr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111232
					]
				},
				{
					"id": 160111232,
					"content": "Alles klar. Ich werde noch eine Weile hier bleiben und die Brise genießen ... Es gibt für mich nichts Schöneres, als den Wind meiner Heimat wiederzuspüren, nachdem ich so lange weg war.",
					"roleType": "TALK_ROLE_NPC",
