						],
						"pointId": 14921
					}
				]
			},
			"dialogs": [
				{
					"id": 160111101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111102
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111102,
					"content": "... Geh vorwärts und blick nicht zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111103
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160111103,
					"content": "„Varka ... Jetzt kenne ich die Bedeutung meines Namens.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 160111104,
					"content": "„... Wenn man bedenkt, wie sehr wir uns alle für dich ins Zeug gelegt haben, solltest du dich besser ordentlich bei uns bedanken, wenn du zurück bist.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111105
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 160111105,
					"content": "„Weißt du, es gibt vieles, was ich dir erzählen muss ... Aber das kann warten, bis du zurück bist.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 160111106,
					"content": "„Ich habe nicht die Absicht, zum Ritterorden zurückzukehren ... Aber ich vertraue darauf, dass du einen Weg finden wirst, allein zurechtzukommen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111107
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 160111107,
					"content": "„... Großmeister, wir warten alle auf dich.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 160111108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111109
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111109,
					"content": "Hmm? ... Oh. Heh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111110,
					"content": "Ich ... mache meinen Job als Großmeister gar nicht so schlecht, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111111
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111111,
					"content": "... Ich nehme das Schweigen als eure Zustimmung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111112,
					"content": "Alles, was ihr geschworen habt, mit eurem Leben zu beschützen ... Es ist alles noch hier, sicher und unversehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111113
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111113,
					"content": "Der Ritterorden, Mondstadt ... und der Eid, den jeder Ritter geschworen hat. Ich beschütze sie alle mit meinem Leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111114
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111114,
					"content": "Und so ... werde ich diesen Brief in deinem Namen überbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111115,
					"content": "... Ich weiß, dass es nur ein Schatten des echten Rolands ist, aber ... wenn du die Zeit hast, könntest du ihn ihm bitte vorlesen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111116
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111116,
					"content": "Rostam und Arundolyn ... Sie haben dich nie vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111117
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111117,
					"content": "Puh ... Das war eine lange Expedition.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111118
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111118,
					"content": "Von hier an werde ich wohl ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111119,
					"content": "... Möge der Wind dich führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111122
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111122,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111130
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 160111130,
					"content": "... He, ihr alle. Es ist schon eine ganze Ewigkeit her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111131
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111131,
					"content": "Ich ... freue mich riesig, euch alle wiederzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111132
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111132,
					"content": "Willkommen zurück, Großmeister.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111133
					]
				},
				{
					"id": 160111133,
					"content": "... Ja, ich bin wieder da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111123
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111123,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111124
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111124,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111125
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111125,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111126
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111126,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
