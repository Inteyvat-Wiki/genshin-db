						],
						"pointId": 3
					}
				]
			},
			"dialogs": [
				{
					"id": 160110201,
					"content": "Ugh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110202
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110202,
					"content": "... Das Schwert ist unversehrt? Aber ich kann den Wolfsgeist nicht spüren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110203
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110203,
					"content": "(... Sieht so aus, als ob ich nicht mehr in der Realität wäre. Das muss ein Raum sein, der aus dem verstrickten Bewusstsein vom „Nordwind“ und Roland entstanden ist.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110204
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110204,
					"content": "Es gibt keinen Weg zurück und vor mir liegt nur das Maul des Wolfs ... Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110205
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110205,
					"content": "Hah, schätze, der einzige Weg führt da durch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
		{
			"id": 1601107,
			"completionStepIds": [
				1601107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
