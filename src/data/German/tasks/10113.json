			"dialogs": [
				{
					"id": 101130201,
					"content": "Weißt du, ich bin froh, dass ich tatsächlich die Gelegenheit hatte, heute hier runter zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130202
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101130202,
					"content": "Die Taverne ist nicht überfüllt und ich könnte nicht besser drauf sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
		},
		{
			"id": 1011302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011305",
							"2"
						],
						"stepId": 1011305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130211,
					"content": "Stanley ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130212
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101130212,
					"content": "So viele Jahre danach ist es nicht einmal mehr sein Freund selbst, der ihn zurückhält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130213
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101130213,
					"content": "Aber zumindest ich bin zuversichtlich, dass die Menschen in Mondstadt die Geschichte seines Freundes nicht vergessen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
		},
		{
			"id": 1011303,
			"completionStepIds": [
				1011303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011303",
							"2"
						],
						"stepId": 1011303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Stanley"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130301,
					"content": "Sag mir, Stanley ... Sag mir, was ich machen soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130302
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130302,
					"content": "Hm? Warum wiederholt er ständig seinen eigenen Namen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130303,
						101130305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130303,
					"content": "Er versteckt etwas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130304
					]
				},
				{
					"id": 101130304,
					"content": "Könnte es eine andere Person geben, die Stanley heißt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130307,
					"content": "*schluchz* Oh, Stanley ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130308
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130308,
					"content": "Es hätte mich treffen sollen! Ich hätte an diesem Tag im Mare Jivari sterben sollen ... Warum kommt dein Geist nicht und hält mich davon ab, deinen Namen zu benutzen? Warum, Stanley, warum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130309
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130309,
					"content": "Hättest du nur nicht so einen Anfänger wie mich retten müssen, dann wärst du nie in dieser windstillen Ecke der Welt gestorben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130310
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130310,
					"content": "Du warst ein berühmter Abenteurer, dazu bestimmt, eines Tages eine Legende zu werden ... Aber jetzt ... wird das nie passieren, denn dein Leben wurde zu früh beendet – und das alles wegen eines wertlosen Mitläufers ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130311
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130311,
					"content": "Uhh ... Versteht jemand, was hier los ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130312,
					"content": "Ich glaube, unser Freund hat es wirklich zum Mare Jivari geschafft. Und ich denke, dass auch die Tragödie, die er dort erlebt hat, echt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130313
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130313,
					"content": "Aber der echte große Abenteurer, der echte Stanley – das war sein Gefährte, nicht er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130314
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130314,
					"content": "Der wahre Stanley ist derjenige, der gestorben ist, um unseren „Stanley“ zu retten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130315
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130315,
					"content": "Ähm ... Also ist der einzige Grund, weshalb Stanley Stanley genannt wird, der, dass er den Namen vom anderen Stanley gestohlen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130316,
					"content": "Ich fürchte, das könnte der Fall sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130317
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130317,
					"content": "Stanley, seit so vielen Jahren lebe ich in Angst ... fürchte, dass Mondstadt dich vergessen wird ... Also erzähle ich deine Geschichten bei jeder Gelegenheit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130318
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130318,
					"content": "Mondstadt muss sich daran erinnern: Stanley hat das Zentrum des Mare Jivari erreicht ... Er ist der größte Abenteurer, den es je gab und er lebt weiter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130319
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130319,
					"content": "Stanley wird nie sterben, weil ich Stanley bin! Ich ... bin Stanley ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130320
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130320,
					"content": "Es tut mir leid, Stanley ... Ich werde alt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130321
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130321,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130322
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130322,
					"content": "Habt ihr vor, noch länger zu lauschen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130323
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130323,
					"content": "Oh nein! Wir sind aufgeflogen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130305,
					"content": "Es gibt einen anderen Stanley.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130306
					]
				},
				{
					"id": 101130306,
					"content": "Sicher nicht. Selbst ich habe noch nie von einem zweiten Stanley gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1011304,
			"completionStepIds": [
				1011304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011304",
							"2"
						],
						"stepId": 1011304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Stanley"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130401,
					"content": "Geht. Spart euch eure Fragen und lasst mich bitte einfach in Ruhe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130402
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130402,
					"content": "Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130403,
					"content": "Geht jetzt! Zwingt mich nicht, es euch noch einmal zu sagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130404
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130404,
					"content": "Ehrenritter! Venti! Und Paimon! Ich bin so froh, dass ihr hier seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130405
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130405,
					"content": "Ich habe euch überall gesucht! Ich wollte euch noch einmal dafür danken, dass ihr mir geholfen habt, das Schwert und den Schild zu finden. Meine Eltern unterstützen mich endlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130406,
					"content": "Oh? Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130407,
					"content": "Ja, wirklich! Sie haben sogar gesagt, dass sie jemanden bezahlen würden, um das Schwert des Heldenmuts und den Schild des Siegeswillens für mich zu reparieren, damit ich sie mitnehmen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130408
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130408,
					"content": "Das ist wunderbar. Also, Jack, ist das der Zeitpunkt, an dem du dich von Mondstadt verabschiedest und dich auf deine kühne Reise durch Teyvat begibst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130409
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130409,
					"content": "Nein, noch nicht. Ich habe immer noch nicht das Zeug dazu, zu weit von Zuhause weg zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130410
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130410,
					"content": "Außerdem hat Stanley sicher noch ein paar Geschichten zu erzählen. Hehe ... Sie haben mich dazu inspiriert, überhaupt Abenteurer zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130411
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130411,
					"content": "Stanley ... Oh, du bist wieder betrunken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130412
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130412,
					"content": "Dann sehen wir uns morgen. Kannst du mir vielleicht noch ein paar deiner Geschichten erzählen, wenn dein Kater nachgelassen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130413
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130413,
					"content": "Stanley mag diesen Jungen wirklich, findest du nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130414,
					"content": "*hick* Jack? Jack!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130415
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130415,
					"content": "Jack ist gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130416,
					"content": "Ah, ich verstehe ... Danke, dass du ihm nichts von meinem Geheimnis erzählt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130417
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130417,
					"content": "Wie? Du stellst dich plötzlich den Fakten? Das passt nicht zu dir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130418
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130418,
					"content": "Gerade eben ... konnte ich es nicht ertragen, ihn anzusehen. Sein Abenteurergeist ist so rein ... makellos ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130419
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130419,
					"content": "Ich bin nur ein müder alter Hochstapler, aber dieser Junge ist ein neuer, glänzender Stern, voller Potenzial ... Ich kann nicht zulassen, dass seine Träume zerstört werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130421
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130420,
					"content": "Du bist kein völliger Hochstapler ... Stanleys Abenteuergeschichten und Erlebnisse sind alle wahr, stimmt’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130421,
					"content": "Geschichten ... Erlebnisse ... Was haben die noch für einen Sinn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130423
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130422,
					"content": "Um ehrlich zu sein, sind meine Erinnerungen an Abenteuer und an Stanley ... dieser Tage verschwommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130424
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130423,
					"content": "Das ist mein größtes Geheimnis. Und meine größte Angst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130425
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130424,
					"content": "All die Jahre habe ich gelebt, um seine Geschichte zu erzählen. Aber an seine Persönlichkeit und die Details seines Lebens erinnere ich mich nicht mehr klar. Ahaha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130426,
					"content": "Sein ganzes Leben lang ist er in Schuld ertrunken ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130427,
					"content": "Alles, was bleibt, ist dieser eingebildete Freund ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130425,
					"content": "Aber das Einzige, was ich nie vergessen kann ... ist, dass er in einem windstillen Land starb, aus dem sein Geist nie wiedergewonnen werden kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426,
						101130427
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130428,
					"content": "Genau ... Selbst in seinen Erinnerungen ist der echte Stanley nicht der lebendige, atmende Freund, den er kannte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130429
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130429,
					"content": "Stattdessen hat er sich auf das Bild von ihm als kampferprobten Krieger fixiert ... und dieses Bild hat ihn sein ganzes Leben gefangengehalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130430,
					"content": "Ich bin zu alt ... Ich habe nie losgelassen, aber trotzdem ist mir so viel entglitten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130431
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130431,
					"content": "Ich bin absolut nutzlos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130432
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130432,
					"content": "Kein Abenteurer sollte auf diesem Wege gehen müssen ... Kein Abenteurer ... jemals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130433
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130433,
					"content": "Ich ... Ich kann es nicht glauben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130434
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130434,
					"content": "Vielen Dank euch allen! Und danke, Barbatos ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130435
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130435,
					"content": "Es tut mir leid, ich werde etwas Zeit brauchen, um mich wieder zu beruhigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130436
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130436,
					"content": "Aber ich denke, dass ... Ich werde schon wieder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130437
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130437,
					"content": "Ah, wunderbar! Stanley fand wieder zu seinem wahren Selbst und Jack kann endlich seinen eigenen Weg gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130438
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130438,
					"content": "Das sollte gefeiert werden! Und mit Feier meinst du natürlich einen Umtrunk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130439
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130439,
					"content": "Und mit Umtrunk meinst du, dass du diese Taverne nicht verlässt, bevor du zu betrunken bist, um zu laufen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130440,
					"content": "Haha, nein, der Wein hier ist zu teuer. Obwohl mir Jack noch Wein schuldet. Er hat mir einen seltenen, erlesenen dafür geboten, dass wir ihm helfen, erinnerst du dich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130441
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130441,
					"content": "Ich gehe jetzt los, um den Wein zu holen. Bis gleich. Treffen wir uns am <color=#00E1FFFF>üblichen Ort</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130442
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130443,
					"content": "Da bleibt uns nur zu raten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130444,
					"content": "Ich glaube ... ich weiß womöglich, wo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130445,
					"content": "Na gut, wir sehen uns <color=#00E1FFFF>dort</color>!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130442,
					"content": "Hm? Wo soll das denn sein? Warum hat Paimon noch nie davon gehört? He, Straßenmusikant!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130443,
						101130444,
						101130445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130446,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1011305,
			"completionStepIds": [
				1011305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011305",
							"2"
						],
						"stepId": 1011305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130501,
					"content": "Du hast es geschafft ... endlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130502
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130502,
					"content": "Sag uns das nächste Mal einfach, welchen Ort du meinst, ja!? Wir haben überall gesucht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130503,
					"content": "Also, hast du es wenigstens geschafft, deinen Wein zu finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130504,
					"content": "Ja! Na ja, irgendwie ... Jack hat behauptet, es wäre eine seltene, erlesene Sammleredition ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130505
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130505,
					"content": "Obwohl es sich eigentlich nur um eine halbe Flasche gewöhnliche Apfelschorle handelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130506
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130506,
					"content": "Ah, das bringt Erinnerungen zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130507
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130507,
					"content": "Das erste Mal, als ich diese Aussicht gesehen habe, hatte ich noch nicht einmal diese Form angenommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130508
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130508,
					"content": "Was? Form?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130509
					]
				},
				{
					"id": 101130509,
					"content": "Es war vor etwa 2600 Jahren, bevor die Welt unter der Herrschaft der Sieben stand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130510
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130510,
					"content": "Zu dieser Zeit wurde das alte Mondstadt von einem Tyrannen regiert, der die Stadt mit einem wilden Wirbelsturm abriegelte. Selbst die Vögel konnten weder rein noch raus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130511
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130511,
					"content": "Das alte Mondstadt? Oh, Paimon erinnert sich! Heutzutage kennt man es als Dvalins Ruinen, oder? Du hast das schon mal erwähnt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130512,
					"content": "Das ist richtig. Der Tyrann der Winde, der einst von diesem Turm aus herrschte, war Decarabian, Gott der Stürme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130513
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130513,
					"content": "Damals war ich nur ein Hauch unter den Tausend Winden. Ich war kein Gott von irgendetwas – ich hatte nicht einmal eine menschliche Form ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130514
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130514,
					"content": "Ich war nur ein winziges elementares Wesen, das im Wind lebte. Eine sanfte Brise, die kleine Veränderungen zum Besseren machte, oder ein winziger Samen der Hoffnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130515
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130515,
					"content": "Ein winziges, elementares Wesen? Ohne menschliche Form? Venti ... meinst du, du hast früher anders ausgesehen als jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130516,
					"content": "Jap. Meine jetzige Form unterscheidet sich nicht so sehr von der Situation mit dem falschen Stanley ... Ich nahm die Form eines Freundes an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130517,
					"content": "Und was geschah dann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130518,
					"content": "Was ist mit deinem Freund passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130519,
					"content": "(Das Gleiche wie bei Stanleys Freund ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130520
					]
				},
				{
					"id": 101130520,
					"content": "Sag mal, Paimon, möchtest du den nächsten Teil der Geschichte hören?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130521
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130521,
					"content": "Ja, natürlich! Die Spannung bringt Paimon um!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130522,
						101130524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130522,
					"content": "Paimon, hol uns ein paar Äpfel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130523
					]
				},
				{
					"id": 101130523,
					"content": "Gerade jetzt möchtest du plötzlich Äpfel? Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130526,
					"content": "Hahaha, ich werde ein bisschen hungrig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130527
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130527,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130528
					]
				},
				{
					"id": 101130528,
					"content": "Huh! Paimon hat die Nase voll mit dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130529,
					"content": "Ah ... Weißt du, du bist so schlau, dass es mir manchmal fast unangenehm wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130530
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130530,
					"content": "Aber vielleicht stimmt es auch, dass echte Freunde sagen können, was der andere denkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130531
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130531,
					"content": "Ein erfrischendes Getränk, eine sanfte Brise ... Solche Momente wecken immer Erinnerungen in mir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130532
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130532,
					"content": "Erinnerungen an ein Lied, dass ich das erste Mal von ihm gehört habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130533
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130533,
					"content": "Ich höre zu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 101130524,
					"content": "Paimon, könntest du uns etwas Fleisch oder Fisch holen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130525
					]
				},
				{
					"id": 101130525,
					"content": "Aber Venti erzählt seine Geschichte! Wieso möchtest du plötzlich ein Fleischgelage!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}