					"content": "Schnell, ihr könnt ihn sicher noch einholen, wenn ihr euch beeilt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		}
