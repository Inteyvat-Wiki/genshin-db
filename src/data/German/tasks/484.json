					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4840601,
					"content": "Hier ist ein Stück Stoff mit Anemo-Spuren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840602,
					"content": "Wenn man sich das Design und die Art des Gewebes ansieht, ist es gut möglich, dass es von einem Windgleiter stammt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840603
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840603,
					"content": "Daran kannst du erkennen, dass es ein Windgleiter sein könnte? Als Kundschafter hat man wohl doch einiges drauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4840604,
					"content": "Ja, wenn er dem komischen Vogel gehört, muss der Windgleiter wohl kaputt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841101,
					"content": "Die elementaren Spuren zeigen immer nach vorn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841102,
					"content": "Ob der komische Vogel immer nur geradeaus geflohen ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4841103,
					"content": "Wenn wir hier nur herumraten, finden wir das nie heraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841104,
					"content": "#{NICKNAME}, folgen wir weiter den Spuren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841105,
					"content": "Hm, was ist denn da vorn los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4841106,
					"content": "Klingt nach einem Kampf. Ist das der komische Vogel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4841107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4841107,
					"content": "Lass uns schnell nachsehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
