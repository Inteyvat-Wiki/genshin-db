			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4842201,
					"content": "Jetzt sind wir schon hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4842202,
					"content": "Es gibt keine weiteren elementaren Spuren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4842203
					]
				},
				{
					"id": 4842203,
					"content": "Die elementare Energie an dem Kulturschatz ist wohl aufgebraucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842204,
					"content": "Ach, jetzt verstehe ich! Der komische Vogel hat gewusst, dass er die elementaren Spuren nicht loswerden würde, und hat deshalb seine Helfer geschickt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842205
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842205,
					"content": "Dadurch konnte er warten, bis die elementare Energie aufgebraucht war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842206
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842206,
					"content": "Er wird damit nicht davonkommen! Wir werden ihn aufhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
		{
			"id": 48435,
			"completionStepIds": [
				48432
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48432",
							"2"
						],
						"stepId": 48432,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4843101,
					"content": "Was für ein Glück! Die Ritter des Ordo Favonius! Die Hilichurle werden mich nicht mehr verfolgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843102
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843102,
					"content": "Was ist passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843103,
					"content": "Es ist wirklich dumm gelaufen ... Unsere Wagen wurden von Hilichurlen angegriffen. Zum Glück sind wir schnell davongerannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843104
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843104,
					"content": "Von Hilichurlen angegriffen? Die meisten Lager müssten aber schon längst vom Ritterorden beseitigt worden sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843105,
					"content": "Sie haben ein ganz kleines Lager in der Nähe des Dorfs. Bei meinen Warenlieferungen mache ich normalerweise einen großen Bogen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843106
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843106,
					"content": "Aber heute ist jemand aus dem Himmel gefallen und direkt in diesem Hilichurl-Lager gelandet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843107
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843107,
					"content": "Hm ... Das kommt mir irgendwie bekannt vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4843108,
					"content": "Die Hilichurle waren natürlich total aufgebracht und sind diesem Kerl, der natürlich sofort ins Freie gerannt ist, gefolgt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843109
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843109,
					"content": "Als sie näherkamen, bin ich auch geflohen. Meinen Wagen mit all den Früchten haben sie aber umgerannt! Wie soll ich morgen Geschäfte machen, wenn die Händler da sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843110
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843110,
					"content": "Dieser Kerl ... Wie sah er denn aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843111,
					"content": "Er hielt etwas fest und konnte daher nicht gerade fliegen ... Wahrscheinlich ist er deswegen auch abgestürzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843112
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843112,
					"content": "Aber wirklich, hat der keinen Flugschein? Man darf doch keine schweren Sachen beim Fliegen tragen. Ich werde ihn anzeigen und dafür sorgen, dass man ihm den Flugschein abnimmt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843113
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843113,
					"content": "Er hatte also etwas Schweres dabei ... Dann war das sicher der komische Vogel mit dem Kulturschatz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843114,
					"content": "Wohin ist er denn gegangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843115,
					"content": "Ich konnte gerade noch sehen, dass er geradeaus gerannt war, als ich vor den Hilichurlen floh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843116
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843116,
					"content": "#Endlich haben wir eine Spur, {NICKNAME}. Folgen wir ihr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843117,
					"content": "Ach so, mach dir keine Sorgen. Zurück im Ritterorden werde ich Bescheid geben, dass die restlichen Hilichurl-Lager schnellstmöglich ausradiert werden müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
