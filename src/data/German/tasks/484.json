			},
			"dialogs": [
				{
					"id": 4840201,
					"content": "Dort vorn liegt Quellingen. Da finden wir bestimmt Spuren des komischen Vogels.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840202
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840202,
					"content": "Der Kulturschatz, den er gestohlen hat, ist mit einer Anemo-Markierung der Ordensschwester versehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840203,
					"content": "Dann solltest du den <color=#00E1FFFF>Elementarblick</color> anwenden, um die Markierungen im Blick zu behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 48409,
