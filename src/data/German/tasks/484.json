			"dialogs": [
				{
					"id": 4840401,
					"content": "Diese Spuren könnten von dem komischen Vogel oder von Anemo-Schleimen stammen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4840402,
					"content": "Anemo-Schleime schweben durch die Luft. Da müsste schon jemand auf sie getreten sein, um loszufliegen. Sonst hat das keinen Sinn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840403
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4840403,
					"content": "Hat das schon einmal jemand gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4840404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4840404,
