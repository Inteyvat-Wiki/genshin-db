			"dialogs": [
				{
					"id": 761210101,
					"content": "♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210102
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761210102,
					"content": "He, Columbina! Du scheinst heute ja richtig gut drauf zu sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210103,
					"content": "Heh ... Kommt rauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210104
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761210104,
					"content": "Oh! Willst du wieder Mondschach spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210105,
					"content": "Ja. Es ist schon eine Weile her, und ich vermisse das Spiel ein wenig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210106
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761210106,
					"content": "Sind die Regeln noch die gleichen wie vorher?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210107
					]
				},
				{
					"id": 761210107,
					"content": "Oder kannst du jetzt mehrere Figuren pro Zug bewegen, weil du die Göttin der drei Monde bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210108,
					"content": "Das wäre Betrug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210109
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761210109,
					"content": "Hehe, ja, das weiß Paimon! Paimon hat nur Spaß gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210110,
					"content": "Sollen wir dann anfangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		},
		{
			"id": 7612102,
			"completionStepIds": [
				7612102
			],
