							11193.69
						],
						"pointId": 360300034
					}
				]
			},
			"dialogs": [
				{
					"id": 760540301,
					"content": "Vielleicht ... So?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540302,
					"content": "Hm, lass mich mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540303,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540304,
					"content": "Monde ... Monde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540305,
					"content": "Vielleicht hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540306,
					"content": "Die Runde habe ich wohl gewonnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540307,
					"content": "Meine drei Monde sind verbunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540308,
					"content": "Mh, damit sollte ich gewinnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540309,
					"content": "Mh ... gehen in einem endlosen Zyklus auf und unter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540310,
					"content": "Offenbar weigern sich beide Monde, von der Finsternis verschluckt zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540311,
					"content": "Steuern wir hier etwas auf ein ... Patt zu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540312,
					"content": "Ah, du wägt deine Entscheidungen sorgfältig ab, bevor du sie triffst, wie ich sehe. Lass dir ruhig Zeit — davon haben wir schließlich mehr als genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540313,
					"content": "Hast du vergessen, wie du deine Monde am Nachthimmel platzieren kannst? Soll ich dir helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540314,
					"content": "Du magst das Spiel nicht? Hm ... Ich persönlich finde es ziemlich unterhaltsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540315,
					"content": "Mh? Starrst du mich an? Der Blick ist nicht gerade subtil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540316,
					"content": "Du starrst ... Steht mir die Wahrheit der Monde ins Gesicht geschrieben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540317,
					"content": "Übrigens, das Brett ist da drüben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540318,
					"content": "Hm, deine Monde sind in Reih und Glied.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540319,
					"content": "Der Nachthimmel gehört dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540320,
					"content": "Ah ... Da war ich wohl ... unachtsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760540321,
					"content": "Du hast eine gute Zeit, während du mit Columbina das Spiel spielst ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 761210202,
					"content": "Die drei Monde, aufgereiht in einer Linie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210203
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761210203,
					"content": "Hmm? Denkst du immer noch darüber nach, wie die letzte Runde gelaufen ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210204,
					"content": "Ach nein. Es ist nur ... Wenn ich jetzt an das Spiel zurückdenke, gibt es mir ein seltsames Gefühl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210205
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761210205,
					"content": "Oh ja. Jetzt, da du die Macht der drei Monde besitzt, bist du mehr als nur etwas, das den Nachthimmel beherrschen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210206,
					"content": "Ja. Und ich denke auch ... dass das Schicksal der Welt anders ausgesehen hätte, wenn es keine Spaltung zwischen den drei Mondgöttinnen gegeben hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210207
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761210207,
					"content": "Wie waren sie denn so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210208
					]
				},
				{
					"id": 761210208,
					"content": "Die Erste, die ich sah, war Sonett, die Göttin des Schillernden Mondes. Sie war lebhafter als ich sie mir vorgestellt hatte, eher wie eine verspielte kleine Schwester.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210209
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761210209,
					"content": "Arya des Ewigen Mondes war die Reifste von den dreien. Sie war eine geborene Anführerin und ging besonders sanft mit anderen um. Ach, genauso wie Lauma eigentlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210210
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761210210,
					"content": "Was Kanon des Frostmondes angeht ... Sie wirkte weise und weitsichtig. Und sie war es, die mir ihren Mond schenkte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210211
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761210211,
					"content": "Klingt so, als wären sie alle gütige Gottheiten gewesen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210212
					]
				},
				{
					"id": 761210212,
					"content": "Ja. Trotz ihrer Unterschiede liebten sie Teyvat, und sie lieben dieses Zuhause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210213
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761210213,
					"content": "Als ich ihnen von der Zukunft erzählte, wirkten sie alle erleichtert und froh darüber, dass diese Welt eine so reiche Zukunft hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210214
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761210214,
					"content": "Deshalb haben sie mir auch die Kraft gegeben, nach „Hause“ zurückzukehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210215
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761210215,
					"content": "Hmm ... Paimon würde sie gerne sehen und ihnen angemessen „Danke“ sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210216,
					"content": "Das würde ich auch sehr gerne. Aber ich fürchte, das ist nicht mehr möglich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210217
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761210217,
					"content": "Zum Glück dreht sich diese Welt weiter, und die Menschen, die sie beschützt haben, haben überlebt und geben ihre Geschichten bis heute weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210218
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761210218,
					"content": "Genau! Solange wir gut leben und nicht zulassen, dass die Bösen die Welt zerstören, ist das der beste Dank, den wir ihnen erweisen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210219,
						761210220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210219,
					"content": "Du hast wirklich eine Begabung für Worte, Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210220,
					"content": "Dann bedankst du dich buchstäblich jeden einzelnen Tag bei ihnen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210221,
					"content": "Na klar! Paimon gibt sich immer die allergrößte Mühe, das Beste aus dem Leben zu machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210222,
					"content": "Du auch, Columbina! Achte jeden Tag auf gutes Essen und genügend Schlaf, und komm zu uns, wenn du Lust auf Spiele hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210223,
					"content": "Haha, klar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210224
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761210224,
					"content": "Ich vermute, dass ich von nun an jedes Mal an diese drei sanften Göttinnen denken werde, wenn ich Mondschach spiele ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		},
		{
