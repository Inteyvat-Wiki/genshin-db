				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741920301,
					"content": "Da man mit Erinnerungen Bücher schreiben kann, sollte man umgekehrt auch den Inhalt von Büchern direkt in seine Erinnerungen schreiben können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920302,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920303
					]
				},
				{
					"id": 741920303,
					"content": "#Ah, es ist {NICKNAME}! Was gibt’s, was kann ich für dich tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920304,
					"content": "Wovon redest du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920305
					]
				},
				{
					"id": 741920305,
					"content": "Hm, egal wie ich darüber denke, es ist ziemlich unglaublich, aus Erinnerungen ein Buch zu machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920306
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920306,
					"content": "Wer dieses Buch gemacht hat, muss wohl die Gefühlslagen in der „Erinnerung {RUBY#[D]Illusion}“ als das Kostbarste angesehen haben. Nur deshalb konnte daraus ein Buch wie dieses entstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920307
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920307,
					"content": "Aber es ändert nichts daran, dass der Inhalt wirklich schwer zu verstehen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920308
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920308,
					"content": "... Was es außerdem beim „Leser“ für einen Einfluss bewirkt, das weiß ich auch nicht. Das ist echt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
