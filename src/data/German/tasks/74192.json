					"Canotila"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741920101,
					"content": "Ich sehe: Die Flammen auf dem Thron sind erloschen und die verbrannte Asche wurde wieder zu einem Baum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920102
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920102,
					"content": "Blumen sprießen deinen Schritten folgend. Du kannst eine Zukunft, die zum Niedergang bestimmt ist, verändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920103
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920103,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920104
					]
				},
				{
					"id": 741920104,
					"content": "#Ah, es ist {NICKNAME}! Was treibst du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920105
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920105,
					"content": "Übrigens! Der goldene Schmetterling ist zurück. Ich muss mich beeilen, um ihn zu sehen! Bis dann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
		{
			"id": 7419202,
			"completionStepIds": [
				7419202
