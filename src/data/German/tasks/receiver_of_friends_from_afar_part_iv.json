			"dialogs": [
				{
					"id": 401499701,
					"content": "Als ich mit dem Großmeister auf Expedition war, war ich oft fürs Kochen zuständig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499702
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401499702,
					"content": "Unter den gegebenen Umständen konnte ich lediglich ein paar ziemlich primitive Gerichte zubereiten ... Aber sie haben trotzdem allen geschmeckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499703
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401499703,
					"content": "Vielleicht war ja „Leidenschaft“ damals auch die geheime Zutat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
				}
