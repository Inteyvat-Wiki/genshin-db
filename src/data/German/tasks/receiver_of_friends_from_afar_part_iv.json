						"pointId": 310400533
					}
				]
			},
			"dialogs": [
				{
					"id": 401490401,
					"content": "„Einfach irgendwas“? *seufz* Eines jeden Kochs schlimmster Albtraum. Ohne den Geschmack der Gäste zu kennen, kann man einfach nur drauflosraten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490402
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 401490402,
					"content": "Aber jetzt, wo du so viele Tage in der Küche gearbeitet hast, bin ich zuversichtlich, dass du das schon schaffen wirst. Also los, zeig ihnen, was du drauf hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490403
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 401490403,
					"content": "(Lass mich mal nachdenken ... Was mögen sie? Wonach könnte es sie verlangen?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
