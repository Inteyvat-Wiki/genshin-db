			},
			"dialogs": [
				{
					"id": 401490301,
					"content": "#Da bist du ja, {NICKNAME}! Vielen Dank für deine harte Arbeit in den letzten Tagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490302
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 401490302,
					"content": "Mit Vergnügen ... Vorausgesetzt, ich werde noch bezahlt, versteht sich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490303
					]
				},
				{
					"id": 401490303,
					"content": "Hahaha, nie um den heißen Brei, was? Hier, nimm. Ich habe auch noch ein kleines Extra draufgelegt, sieh es als Bonus. Harte Arbeit wird hier belohnt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490304
					],
					"speakerTitle": "Huai’an"
				},
				{
					"id": 401490304,
					"content": "Juhu! Es ist, als wären all die Müdigkeit und der Stress plötzlich wie weggeblasen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490305,
					"content": "Ich kann von Glück reden, dass du diese Arbeit nur ein paar Tage lang gemacht hast. Bei dem Tempo, das du vorgelegt hast, wäre ich wohl in ein paar Wochen überflüssig geworden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490306
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 401490306,
					"content": "Ich freue mich darauf, deine Küche in Zukunft wieder zu probieren!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490307
					]
				},
				{
					"id": 401490307,
					"content": "Haha, jederzeit! Bring nächstes Mal ein paar Freunde mit, und ich zeige euch, was der Lächelnde Yanxiao alles auf dem Kasten hat, wenn er beide Hände zur Verfügung hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490308
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 401490308,
					"content": "Super! Nur ... koch in der Zwischenzeit sicherheitshalber lieber vorsichtig! Vielleicht hast du es gerade wieder verhext!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
