			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							922.885,
							258.972,
							363.918
						],
						"pointId": 310400534
					},
					{
						"sceneId": 3,
						"position": [
							924.154,
							258.972,
							367.775
						],
						"pointId": 310400535
					},
					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401490201,
					"content": "... Mhm, das ist ja köstlich! Perfekt gewürzt, und selbst der Reis ist voller Geschmack!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490202
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490202,
					"content": "Es geht doch nichts über eine heiße Mahlzeit, die frisch vom Herd kommt ... Das habe ich vermisst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490203,
					"content": "#Hehe, du hast die feinsten Feldrationen des Ritterordens in den Schatten gestellt, und das ist keine Kleinigkeit ... Also raus damit, {F#Reisende}{M#Reisender}, wie heißt dieses Gericht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490204
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490204,
					"content": "Es heißt ... ähm ... Paimon schätzt, wir könnten es doch nicht wirklich „Einfach irgendwas“ nennen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490205,
					"content": "... Hilfe, Paimon hat keine Ahnung, wie man dieses Gericht erklären soll! Es hat keinen Namen und besteht aus irgendwelchen Grundzutaten, die dann einfach gekocht werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490206,
					"content": "Irgendwelchen Grundzutaten, die dann einfach gekocht werden? Wirklich? Ich hätte schwören können, dass du irgendetwas Ausgefallenes hineingetan hast, oder dass du es mit einer Art Kochzauber versehen hast ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490207,
						401490208
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490207,
					"content": "Es ist nicht das feinste Gericht der Welt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490208,
					"content": "Aber es ist das, was ihre gerade nötig habt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490209,
					"content": "Nicht das feinste Gericht, aber das, was sie gerade nötig haben? Oh, jetzt hat Paimon den Faden verloren ... Was meinst du damit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490210,
						401490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490210,
					"content": "Ihr seid schon lange unterwegs ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490211,
					"content": "Und habt die ganze Zeit nur Feldrationen gegessen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490212,
					"content": "Du meinst also ... wir finden es nur lecker, weil wir so hungrig waren? Hm, da muss doch noch mehr dran sein als das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490213
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490213,
					"content": "... Vielleicht ja die Tatsache, dass der Duft von frisch gekochtem, heißem Essen eine willkommene Abwechslung zu den kalten Fertigrationen ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490214,
					"content": "Ah, also so wie das Gefühl, morgens zu dem Duft von frisch gebackenem Brot aufzuwachen? Das ergibt Sinn ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490215
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490215,
					"content": "Ja ... Es ist fast so, als wären wir wieder beim „Hirschjäger“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490216
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490216,
					"content": "Hä? Aber der „Hirschjäger“ ist in Mondstadt ... Warum sollte man denn unbedingt die Liyue-Küche probieren wollen, wenn man den Unterschied sowieso nicht schmeckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490217,
					"content": "Oh, ich rede nicht vom Geschmack. Ich meine nur dieses Gefühl von ... Behaglichkeit, verstehst du? Es ist wie das Gefühl, zu Hause zu sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490218
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490218,
					"content": "Behaglichkeit ... zu Hause ... Nun, Yanxiao hat schließlich gesagt, wir wollen, dass sich unsere Gäste wie zu Hause fühlen sollen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490219,
					"content": "Was ein leckeres Gericht lecker macht, ist sehr subjektiv.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490220
					]
				},
				{
					"id": 401490220,
					"content": "Jeder hat seine eigenen Vorlieben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490221
					]
				},
				{
					"id": 401490221,
					"content": "Aber es liegt am Koch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490222
					]
				},
				{
					"id": 401490222,
					"content": "Sich in die Position eines jeden Gastes zu versetzen und herauszufinden, was er möchte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490229,
					"content": "... Und das ist die Leidenschaft eines Kochs, der seinen Gästen ein Lächeln aufs Gesicht zaubert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490223,
					"content": "Mit anderen Worten ... Die geheime Zutat ist „Leidenschaft“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490224
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490224,
					"content": "Abgesehen von der Tatsache, wie furchtbar klischeehaft das klingt, gebe ich zu, dass es auf dieses Gericht durchaus zutrifft. Gut gespielt ... Denk an meine Worte, ich werde mir dieses Rezept merken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490225
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490225,
					"content": "In Ordnung, aber es gibt kein richtiges Rezept ohne einen Namen, richtig? Haben wir denn schon einen Namen für dieses Gericht gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490226,
						401490227
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490226,
					"content": "So weit hatte ich noch gar nicht gedacht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490228
					]
				},
				{
					"id": 401490227,
					"content": "Habt ihr irgendwelche Idee?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490228
					]
				},
				{
					"id": 401490228,
					"content": "Hmm ... Wie wär’s mit „Zuhause auf Reisen“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
