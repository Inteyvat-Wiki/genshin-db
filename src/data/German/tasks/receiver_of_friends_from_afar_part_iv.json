			},
			"dialogs": [
				{
					"id": 401499601,
					"content": "Es tut mir leid! Mir fällt auf Anhieb nichts ein ... Ich meine, ich könnte wahllos etwas von der Speisekarte wählen, aber ich würde mich wohler fühlen, wenn ich die Wahl dem Koch überlasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499602,
					"content": "Oh, eine Sache noch, ich weiß, dass ich gesagt habe, dass es mir egal ist, was wir bekommen, aber keinen Alkohol, bitte. Keiner von denen ist besonders trinkfest ... was ’ne Schande.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499603
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401499603,
					"content": "I... Ich habe hier noch etwas Sprudelwasser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
				}
			]
