					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401490101,
					"content": "... Wie die Zeit vergeht. Meine Verbrennungen sind fast verheilt, ich sollte morgen wieder bereit sein, die Küche zu übernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490102
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 401490102,
					"content": "#Du hast dich in den letzten Tagen wirklich gut geschlagen, {NICKNAME}. Heute ist dein letzter Tag. Ich hoffe, wir überstehen ihn ohne Zwischenfälle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490103
					],
					"speakerTitle": "Lächelnder Yanxiao"
				},
				{
					"id": 401490103,
					"content": "Ach, warum hat Paimon das Gefühl, dass du uns schon wieder verhext hast ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490104,
					"content": "Der Tag vergeht ohne Zwischenfälle ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401490105
					]
				},
				{
					"id": 401490105,
					"content": "*seufz* Wir haben bis zum Abend durchgehalten! Am Ende lief doch alles ziemlich reibungslos. Vielleicht liegt es daran, dass wir inzwischen so viel Routine haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490106,
					"content": "Seit unserem ersten Arbeitstag war es ein langer Weg, nicht wahr? Damals hatten wir Mühe, uns zu merken, wer was bestellt hat ... Aber jetzt ist alles ein Kinderspiel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490107,
						401490108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490107,
					"content": "Übernimm dich jetzt nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				},
				{
					"id": 401490109,
					"content": "Ja, aber wer würde denn so spät noch vorbeikommen? Oh ... Jetzt, wo Paimon so darüber nachdenkt, kamen Lyney und seine Geschwister am ersten Tag ungefähr um diese Zeit noch vorbei, nicht wahr ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490110,
					"content": "#{NICKNAME}? Paimon? Schön, euch beide hier zu sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490111,
					"content": "Amber? Und da sind auch Eula und Mika! Seid ihr zum Abendessen hier? Warum denn noch so spät?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490112,
					"content": "Wir haben gerade eine Eskorte für eine Händlerkarawane abgeschlossen. Eigentlich wollten wir uns mit ein paar Rationen für heute Abend behelfen und dann weiter nach Norden Richtung Steintor weiter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490113
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490113,
					"content": "Aber Truppenführerin Eula hat uns daran erinnert, dass wir schon lange nichts mehr aus der Liyue-Küche gegessen haben. Also dachten wir uns, wir könnten auch in diesem Gasthaus vorbeischauen und sehen, ob wir noch etwas bestellen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490114
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490114,
					"content": "Oh, das war also Eulas Vorschlag, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490115,
					"content": "... Ähem! Wir haben die ganze Reise über die immer die gleichen Rationen gegessen, also dachte ich mir, es wäre einfach an der Zeit, dass wir uns eine richtige Mahlzeit gönnen. Oder ist das ein Problem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490116,
						401490117
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490116,
					"content": "Überhaupt nicht, willkommen im Gasthaus Wangshu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490118,
					"content": "Nun gut, was sollen wir nehmen ... Hm? Moment mal, warum nimmst du unsere Bestellung auf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490119
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490119,
					"content": "#{NICKNAME} ist hier als Chefkoch eingesprungen! Ihr kommt genau zum richtigen Zeitpunkt, denn ihr werdet die letzten Gäste sein, die in den Genuss {M#seiner}{F#ihrer} Kochkünste kommen werden, bevor der eigentliche Küchenchef wieder die Zügel in die Hand nimmt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490120,
					"content": "Oh, wirklich? Gut, dass Eula vorschlug, hierherzukommen! Das hätte ich um nichts in der Welt verpassen wollen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490121,
					"content": "Also, was sollen wir nehmen? Hmm ... Ich bin mit der Küche von Liyue nicht so bewandert, wie ich es früher einmal war. Mika, Eula, worauf habt ihr Lust?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490122,
					"content": "#Einfach irgendwas! Ich freue mich einfach darauf, die Kochkünste {F#der Ehrenritterin}{M#des Ehrenritters} selbst zu probieren. Ich bin sicher, dass ich viel dabei lernen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490123
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490123,
					"content": "... Irgendetwas Einfaches würde genügen. Wir müssen uns nach dem Essen wieder auf den Weg machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490124
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490124,
					"content": "Aber hattest du denn nicht eigentlich die Idee, hierherzukommen? Oh Mann, du kannst es einem aber auch schwer machen ... Na gut, dann liegt es wohl an dir, Amber. Du sagst es, wir kochen es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490125,
					"content": "Huch? Nun, dann schätze ich ... Mir ist es auch egal, ich bin mit allem glücklich. Einfach irgendwas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490126,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490117,
					"content": "Darf ich eure Bestellung aufnehmen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490108,
					"content": "Der Tag ist noch nicht vorbei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				}
			]
		},
		{
			"id": 4014902,
