			"dialogs": [
				{
					"id": 401499801,
					"content": "Die Verpflegung, die wir dabei hatten, wurde von meinen charakteristischen Mondkuchen abgeleitet. Mit etwas noch Leckerem aufzuwarten ... Das muss ich dir lassen, das hast du toll gemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499802
					],
					"speakerTitle": "Eula"
				},
				{
