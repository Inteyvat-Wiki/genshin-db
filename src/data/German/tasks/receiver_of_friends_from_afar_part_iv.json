					"nextDialogs": [
						401499402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499402,
					"content": "Amber?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499403
					]
				},
				{
					"id": 401499403,
					"content": "... Ah, Entschuldigung. Ich war gerade kurz abwesend. Ich habe dich gar nicht kommen sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499404,
					"content": "Hast du was auf dem Herzen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499405
					]
				},
				{
					"id": 401499405,
					"content": "Na ja ... Das Essen, das du uns gerade gekocht hast, hat mich an die Gerichte erinnert, die mein Großvater immer für mich gemacht hat. Ich hatte schon gedacht, ich hätte vergessen, wie sie schmecken, aber dann kam alles wieder zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499406
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499406,
					"content": "Er hat immer Liyue-Gerichte gekocht. Ich trainierte mit ihm bis in den Abend und wartete dann, bis das Essen fertig war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499407
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499407,
					"content": "... Ich saß da, der Duft des köstlichen Essens wehte aus der Küche hinein, und ich wartete darauf, dass er endlich mit dem Gericht auftauchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499408,
					"content": "Manchmal hatten wir Eula zum Abendessen da, und obwohl sie immer etwas zu meckern hatte, merkte ich doch, dass ihr das Essen wirklich schmeckte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499409,
						401499410
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499409,
					"content": "Vielleicht ist das der wahre Grund für ihren Vorschlag ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499411
					]
				},
				{
					"id": 401499411,
					"content": "... Deine Worte, nicht meine. Frag sie bloß nicht danach ... sie wird dich nur zusammenfalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499410,
					"content": "Liyue-Küche zu essen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499411
					]
				}
			]
		},
