						740760302
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760302,
					"content": "Bisher stehen wir mit leeren Händen da ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760303,
					"content": "Stimmt. Aber der Eingang hier ist immer noch verschlossen. Das bedeutet, dass wir noch eine Chance haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760304
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760304,
					"content": "Wie es scheint, konnte unser Widersacher das Rätsel hier noch nicht lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760305
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760305,
					"content": "Aber wer ist es, der in diesem Rätselwettbewerb gegen uns antritt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760306,
					"content": "Ausgehend davon, dass der Narzissenkreuz-Verein über mehrere Jahrhunderte nicht erneut in Erscheinung treten konnte, sondern in Stille versunken ist, dann ist das Wissen, das ich besitze, weiterhin von Bedeutung. Und in Anbetracht der vorherigen Vorfälle ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760307
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760307,
					"content": "Ich befürchte, dass es sich um Jakob handelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760308
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760308,
					"content": "Dieser Schurke, der Seymour drangsaliert hat? Was will er denn mit diesen Dingen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760309
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760309,
					"content": "Ich befürchte, er hat das gleiche Ziel wie wir: Er sucht nach den Materialien, um das heilige Schwert des Narzissenkreuzes zu schmieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760310
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760310,
					"content": "Basierend auf dem Mystizismus des Unterweltreiches und des antiken Fontaines hat der Narzissenkreuz-Verein die vier Arten von erforderlichen fiktiven Substanzen in der materiellen Welt neu erschaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760311
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760311,
					"content": "Das ist unbegreiflich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760312
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760312,
					"content": "Mystische Dinge dieser Art erschließen sich einem nur durch die direkte Erfahrung. Man könnte sagen, dass sie die Vorstellungskraft eines Menschen noch weiter übersteigen als die Elementarkräfte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760313
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760313,
					"content": "Vor einigen Jahrzehnten habe ich einmal die Stoffkundelehrmaterialien der Sumeru-Akademie abgespeichert, von den Grundlagen bis hin zur mittleren Stufe. Die Elementarkräfte sind eigentlich nicht so mystisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760314
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760314,
					"content": "Ach so? Jedenfalls kann man zusammenfassend sagen, dass es sich um eine Verbindung von antiken Praktiken aus Fontaine und den Techniken des Unterweltreichs handelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760315
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760315,
					"content": "Auf der Welt sind die folgenden vier Arten von Substanzen aufgetreten: „Erinnerung“, „Wunsch“, „Seele“ und „Persönlichkeit“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760316
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760316,
					"content": "Um Missverständnisse zu vermeiden, nennen wir sie Brocken der „Erinnerung“, Brocken des „Wunsches“, Brocken der „Seele“ und Brocken der „Persönlichkeit“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760317
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760317,
					"content": "Wie kommt es, dass man solche Dinge zum Schmieden des heiligen Schwerts braucht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760318,
					"content": "Im Mystizismus des Narzissenkreuz-Vereins ist der Tempel ein Mikrokosmos des Universums, die Mitglieder sind die Stellvertreter der Götter und das heilige Salböl ist die geschmiedete Willenskraft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760319
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760319,
					"content": "Und das heilige Schwert hingegen ist die „Vernunft“, die alles spalten kann. Sie kann nur aus dem Willen eines vollkommenen Menschen geboren werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760320
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760320,
					"content": "Wie esoterisch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760321
					]
				},
				{
					"id": 740760321,
					"content": "Tja, so ist der Mystizismus nun einmal. Wenn zwei Objekte sich ähnlich genug sind, würde man eine Verbindung zwischen ihnen herstellen. Und wenn man die Magie hat, solche Dinge zu realisieren, dann werden Illusionen zur Realität.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760322
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760322,
					"content": "In jedem Fall hat unser Gegenspieler das Rätsel entweder nicht gelöst oder es zwar gelöst, aber keinen Weg gefunden, die Lösung anzubieten. Da es sich bei unserem Gegenspieler um Jakob handelt, ist letztere Möglichkeit wahrscheinlicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760323
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760323,
					"content": "Die Steininschrift hier besagt: „Immer vereint“ ... „In einem Augenblick geboren, oft widersprüchlich, ewige Ruhe bei dir“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760324
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760324,
					"content": "Und der letzte Satz lautet ... „Der ursprüngliche Tropfen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760325,
					"content": "Wir haben solche Rätsel schon an anderen Orten gesehen. Wisst ihr noch, was die Lösungen waren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760326
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760326,
					"content": "„Schatten“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760327
					]
				},
				{
					"id": 740760327,
					"content": "„Leben“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760328
					]
				},
				{
					"id": 740760328,
					"content": "„Liebe“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760329
					]
				},
				{
					"id": 740760329,
					"content": "Hmm, die Lösungen werden immer abstrakter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760330,
					"content": "Caterpillar, Seymour, kennt ihr die Lösung für dieses Rätsel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7407604,
			"completionStepIds": [
				7407602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
