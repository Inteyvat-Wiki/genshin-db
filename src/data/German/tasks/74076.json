					}
				]
			},
			"dialogs": [
				{
					"id": 740760401,
					"content": "Ich habe eine Idee bezüglich dieses „ursprünglichen Tropfens“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760402
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760402,
					"content": "Das klingt ganz danach, als ginge es dabei um den ersten Regen nach Erschaffung der Welt. Eine solche Szenerie ist sowohl im antiken Fontaine als auch beim Narzissenkreuz-Verein sehr beliebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760403
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760403,
					"content": "Argh! Wie kann man so etwas finden?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760404,
					"content": "Da dieser Tropfen sich bereits mit allem Wasser vermischt hat, sollte jeder Wassertropfen ein ursprünglicher Tropfen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760405
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760405,
					"content": "Es ist wie mit der ursprünglichen Gottheit, die ihr unermessliches Potenzial überall ausgebreitet hat, und daher ist in jedem von uns eine göttliche Komponente zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760406
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760406,
					"content": "Aber wenn die Lösung so einfach ist, dann hätte die Person, die uns zuvorgekommen ist, sie doch ohne Probleme anbieten könnten, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760407,
					"content": "Stimmt. Ich muss mich wohl irren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760408
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760408,
					"content": "Auch wenn es nicht die richtige Lösung ist, ist es dennoch eine gute Lösung. Ich finde nur, dass die Person, die die Rätsel gestellt hat, nichts von Romantik versteht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760409
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760409,
					"content": "Und er macht sich über dich lustig, dass du nichts von Sicherheitsmaßnahmen verstehst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760410,
					"content": "Eine Antwort ist mir nicht möglich. Es gibt eintausendzweihundert Suchergebnisse zu „ursprünglicher Tropfen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760411
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760411,
					"content": "„Der Legende nach soll der erste Tropfen Wein auf der Welt vom Anemo-Archon ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760412,
						740760414
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760412,
					"content": "Schon gut, du brauchst nicht weiter zu sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760413
					]
				},
				{
					"id": 740760413,
					"content": "Klar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760416,
					"content": "Was das angeht ... Ich glaube, ich habe etwas, das ich mitteilen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760417
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760417,
					"content": "Einer Legende zufolge sind die Okeaniden die erste Träne des ehemaligen Hydro-Archons.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760418
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760418,
					"content": "Und die erste Träne auf dem Land soll von der frühsten Okeanide vergossen worden sein, nachdem sie die Menschen verstanden hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760419
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760419,
					"content": "Sollte nicht die erste Träne auf der Welt vergossen worden sein, als der erste menschliche Säugling weinte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760420,
					"content": "Bei Tieren dienen die Tränen in Wirklichkeit dazu, Salz auszuscheiden, und in jenen friedlichen Zeiten haben Menschen sogar bei ihrer Geburt lachend ihren ersten Atemzug getan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760421
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760421,
					"content": "So heißt es zumindest in der Legende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760422
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760422,
					"content": "Ich finde, dass das Weinen von Säuglingen und die Salzausscheidung von Tieren eigentlich beide als die gleiche Art von emotionsloser Verhaltensweise angesehen werden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760423
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760423,
					"content": "Das Weinen von Säuglingen ist auf äußere Reize zurückzuführen, und auf diese Weise können sie auch ihre Lungen so schnell wie möglich mit Luft füllen. Diese Erklärung findet sich in Lehrmaterialien der Lebenskunde von Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760424
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760424,
					"content": "Die Lösung lautet also „Okeanide“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760425,
					"content": "Die Person vor uns war wahrscheinlich tatsächlich nicht in der Lage, die richtige Lösung anzubieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760426,
						740760428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760426,
					"content": "Zeit für einen verzweifelten Versuch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760427
					]
				},
				{
					"id": 740760427,
					"content": "Paimon findet, dass dies eine vielversprechende Antwort ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760430,
					"content": "Basierend auf meinem Verständnis des Narzissenkreuz-Vereins könnte das tatsächlich Sinn ergeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760431
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760431,
					"content": "Die „Rote Königin“, die an einem unbekannten Ort träumt. Eine Gestalt im Traum, deren Worte immer so zweideutig sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760432
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760432,
					"content": "Hm, was du da sagst, ist noch unverständlicher als diese Rätsel selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760433,
					"content": "Es spielt keine Rolle. Wir sind bereits in der letzten Phase angelangt. Egal wie sich die Sache entwickelt, am Ende wird die Lösung enthüllt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760434
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760434,
					"content": "Ann, es kommt nun auf dich an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760435
					]
				},
				{
					"id": 740760435,
					"content": "Ja, lasst es mich probieren. Sollte es in einem Fehlschlag enden, dann müsst ihr euch schnell eine andere Lösung einfallen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760436
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760436,
					"content": "Es hat sich geöffnet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760437,
					"content": "Wir müssen unbedingt den letzten Brocken bekommen, andernfalls wird das heilige Schwert in die Hände des Narzissenkreuz-Vereins fallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760428,
					"content": "Ich finde, dass dies eine vielversprechende Antwort ist!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760429
					]
				},
				{
					"id": 740760429,
					"content": "Und es ist wesentlich besser als die Idee, nach dem Wein des Anemo-Archons zu suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760414,
					"content": "Einen Versuch ist es wert. Lasst uns nach Mondstadt gehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760415
					]
				},
				{
					"id": 740760415,
					"content": "Wenn du schon unbedingt verzweifelte Versuche unternehmen willst, dann solltest du wenigstens einen zuverlässigeren Ansatz wählen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
