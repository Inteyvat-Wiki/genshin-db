				]
			},
			"dialogs": [
				{
					"id": 740760501,
					"content": "Das Ding da vorn, ist das der Brocken der „Persönlichkeit“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760502
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760502,
					"content": "Dichteanalyse der Materie vor uns nicht möglich. Die Masse beträgt anscheinend ... Null.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760503
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760503,
					"content": "Es scheint, dass wir die letzte Runde gewonnen haben, jetzt können wir zumindest versuchen, mit dem Gegner zu verhandeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760504
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760504,
					"content": "Hmm ... Jetzt haben wir zumindest den Vorteil, dass wir den Narzissenkreuz-Verein letztlich davon abhalten können, das heilige Schwert zu schmieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760505,
					"content": "Es ist nicht wirklich ein Vorteil, Paimon. Unser eigentliches Ziel ist es, das heilige Schwert zu schmieden und damit ihren Plan zu durchkreuzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760506
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760506,
					"content": "Und Ann, ich habe natürlich nicht vergessen, was dir dieses Schwert bedeutet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760507
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760507,
					"content": "Das heilige Schwert, das den Willen sezieren kann, ist der Schlüssel zur Lösung deines Rätsels. Tatsächlich ist es für mich genauso wichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760508
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760508,
					"content": "Aber jetzt haben wir es mit wichtigeren und dringenderen Dingen zu tun. Bist du damit einverstanden, unsere eigenen Rätsel erst dann zu lösen, wenn alles vorbei ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760509
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760509,
					"content": "Ich habe kein Problem damit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760510
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760510,
					"content": "#Also {NICKNAME}, bitte nimm die „Persönlichkeit“ entgegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
