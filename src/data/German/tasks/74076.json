			"dialogs": [
				{
					"id": 740760101,
					"content": "Jetzt verbleibt nur noch dieser Ort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760102
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760102,
					"content": "Glücklicherweise ist der Eingang immer noch verschlossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760103
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760103,
					"content": "Wie es scheint, konnte Jakob das Rätsel hier noch nicht lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760104
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760104,
					"content": "Oder er hat es gelöst, aber keine Möglichkeit gefunden, die Lösung anzubieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760105
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740760105,
					"content": "Mal überlegen, die letzten Lösungen waren „Schatten“, „Leben“ und „Liebe“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760106,
					"content": "Basierend auf den vorhergehenden Mustern, stellt mein Logikmodul folgende Vermutung für die Steininschrift an:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760107,
					"content": "„Immer vereint“ ... „In einem Augenblick geboren, oft widersprüchlich, ewige Ruhe bei dir“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760108
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760108,
					"content": "Und der letzte Satz lautet ... „Der ursprüngliche Tropfen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760109,
					"content": "Caterpillar, Seymour, kennt ihr die Lösung für dieses Rätsel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
