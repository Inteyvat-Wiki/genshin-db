			"dialogs": [
				{
					"id": 220270401,
					"content": "Dreifarbige Klößchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270402
					]
				},
				{
					"id": 220270402,
					"content": "Echt jetzt? Na gut! Ich habe zufällig eine Portion mitgebracht. Meine Mama hat sie für mich gemacht und ich habe sie noch nicht einmal gegessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270403
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270403,
					"content": "Dann lass uns sie darbringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270601
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270601,
					"content": "O Archon, segne mich und erfüll mir meine Wünsche ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270602
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270602,
					"content": "Danke, dass du bis jetzt bei mir geblieben bist. Bitte nimm diese hier. Sie sind für dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270603
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270603,
					"content": "Ich komme morgen wieder hierher und schaue noch einmal nach. Ich hoffe, dass ich eine Antwort erhalten werde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
