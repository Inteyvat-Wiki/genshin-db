			"dialogs": [
				{
					"id": 220270301,
					"content": "Ich meine, Nanatsuki hat gesagt, dass ich das tun soll, oder? Aber was genau soll ich anbieten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270302
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270302,
					"content": "Apropos Dinge, die ich mag, das müssen dreifarbige Klößchen sein. Ich liebe sie so sehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270303
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270303,
					"content": "Aber wäre es respektlos, dreifarbige Klößchen darzubringen? Ich habe auch schon Konfekt dargebracht, aber ich habe keine Antwort bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270304
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270304,
					"content": "Ich habe auch gehört, dass manche Leute frische Blütenblätter in Tütchen verpacken und diese darbringen. Das klingt angemessener als Klößchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270305
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270305,
					"content": "Was sollten wir tun? Was denkst du, was wir darbringen sollten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 2202704,
