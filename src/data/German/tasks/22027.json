			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shouta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270101,
					"content": "Lackwaren ... wie macht man die ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270102
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270102,
					"content": "Warum brauchst du Lackwaren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270103
					]
				},
				{
					"id": 220270103,
					"content": "Oh, du bist es. Hast du jemals von der göttlichen Intervention eines Schreins gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270104
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270104,
					"content": "Nach dem, was ich gehört habe, werden deine Wünsche vielleicht in Erfüllung gehen, wenn du dem Schrein wertvolle Opfergaben gibst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270105
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270105,
					"content": "Ich denke, dass die hübschen Lackwaren sehr wertvoll sind. Wenn ich die als Opfergaben für den Schrein verwenden würde, dann würde ich sicher eine Antwort bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270106
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270106,
					"content": "Allerdings habe ich kein Geld, um mir irgendwelche Lackwaren zu kaufen. Deshalb möchte ich eine für mich selbst machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270107
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270107,
					"content": "Ich habe gehört, dass Nanatsuki von Yayoi-Lackwaren sehr gut darin ist, sie herzustellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270108
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270108,
					"content": "Könntest du sie nach den Lackwaren fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270109,
						220270111
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270109,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270110
					]
				},
				{
					"id": 220270110,
					"content": "Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270111,
					"content": "Wieso gehst du nicht selbst hin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270112
					]
				},
				{
					"id": 220270112,
					"content": "Ich habe Angst vor ihr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270113
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270113,
					"content": "Wenn du da bist, ist es bestimmt besser ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 2202702,
			"completionStepIds": [
				2202702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202702",
							"2"
						],
						"stepId": 2202702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yayoi Nanatsuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270201,
					"content": "Hallo, kann ich helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270202
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270202,
					"content": "Oh ... also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270203
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270203,
					"content": "Also, er will nach Lackwaren fragen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270204
					]
				},
				{
					"id": 220270204,
					"content": "Ah, du willst also dem Schrein Lackwaren anbieten und du willst selbst welche herstellen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270205
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270205,
					"content": "Bitte, Nanatsuki. Ich habe einen Wunsch, den ich erfüllt haben möchte! Deshalb habe ich ... Mach dir keine Sorgen, ich werde niemandem von deiner Geheimformel erzählen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270206
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270206,
					"content": "Das Problem ist nicht die Lackierformel. Wenn du schöne Lackwaren machen willst, abgesehen von der Farbe, brauchst du auch viel Zeit und Übung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270207
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270207,
					"content": "Und dabei geht es nicht nur um die Zeit, sondern das Kapital. Ich bin der Nachfolger in vierter Generation einer Familie von Lackwarenherstellern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270208
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270208,
					"content": "Ich bin sogar nach Sumeru gereist, um Lackwaren zu studieren. Es ist also unmöglich für dich, Lackwaren über Nacht zu begreifen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270209
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270209,
					"content": "Ist ... Ist das so? Aber mir fällt nicht wirklich etwas anderes ein, was ich dem Schrein darbringen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270210
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270210,
					"content": "Meiner Meinung nach geht es nicht um den Wert des Gegenstandes, der dem Schrein dargebracht wird. Dieser Gegenstand, den du anbietest, sollte deine Gefühle repräsentieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270211
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270211,
					"content": "Solange du die richtigen Gefühle und Absichten hast und deine Lieblingsgegenstände darbringst, solltest du in der Lage sein, eine Antwort von dem Archon zu bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270212
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270212,
					"content": "Richtige Gefühle und Absichten ... die Dinge, die ich mag ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270213
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270213,
					"content": "Hmm, ich glaube ich verstehe es ... aber auch wieder nicht. Aber trotzdem danke, Nanatsuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270214
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270214,
					"content": "Lass uns zuerst zum Schrein zurückgehen. Ich brauche immer noch deine Hilfe, um herauszufinden, welche Dinge ich darbringen möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 2202703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
