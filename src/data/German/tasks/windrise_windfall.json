			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elzer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207432001,
					"content": "Hast du die Händlerstraßen befreit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432002
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432002,
					"content": "Sie sind tadellos sauber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207432003
					]
				},
				{
					"id": 207432003,
					"content": "Das ist großartig. Das Geschäft unseres Weinguts kann nun Schritt für Schritt wieder beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432004
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432004,
					"content": "Ehrlich gesagt, ich hätte diese Angelegenheit an Meister Diluc melden sollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432005
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432005,
					"content": "Aber er ist einfach so verschwunden. Ich habe überall im Weingut nach ihm gesucht, aber niemand weiß, wohin er gegangen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432006
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432006,
					"content": "Abelinde hat so etwas gesagt wie: „Meister Diluc ist gegangen, um sich um eine persönliche Angelegenheit zu kümmern“, hat sich aber geweigert, mehr zu sagen. Sie hat nicht einmal besorgt ausgesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207432007
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207432007,
					"content": "*seufz* Vergiss es. Sobald er zurück ist, werde ich mich lange mit ihm unterhalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elzer"
				}
			]
		}
	]
