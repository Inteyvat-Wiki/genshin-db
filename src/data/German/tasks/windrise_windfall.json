			"dialogs": [
				{
					"id": 207431001,
					"content": "Wie soll ich Meister Diluc unter die Augen treten, wenn unser Weingut noch länger geschlossen bleibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207431002
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207431002,
					"content": "Reisender, wenn du Meister Diluc triffst, kannst du ihm davon erzählen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207431003
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 207431003,
					"content": "Es reicht einfach nicht. Die Art, wie er das Weingut einfach immer sich selbst überlässt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elzer"
				}
			]
		},
		{
			"id": 2074320,
			"completionStepIds": [
				2074306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
