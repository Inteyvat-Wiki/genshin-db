			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020301,
					"content": "Hier ist sie! Das ist die Kiste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020302
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020302,
					"content": "Zum Glück ist sie nicht bei den Explosionen kaputtgegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020303,
					"content": "Jetzt haben wir alles und können dem Mädchen die Kiste bringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
		{
			"id": 1050204,
			"completionStepIds": [
				1050207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050207",
							"2"
						],
						"stepId": 1050207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020401,
					"content": "Da seid ihr ja endlich. Ihr habt echt lange gebraucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020402,
					"content": "Ich wollte eigentlich ein Buch lesen, um die Zeit rumzukriegen. Das war aber nur so ein komisches Tagebuch, total langweilig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020403
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020403,
					"content": "Es ist aus Klees Tasche gefallen. Da dachte ich, es könnte sich um uraltes Wissen handeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020404
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020404,
					"content": "Auch egal. Also, habt ihr die Kiste gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020405,
					"content": "Ja, alles noch ganz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020406
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020406,
					"content": "Perfekt! Aber warte ... Warum ist sie nicht verschlossen? Und ... Da ist ja gar nichts drin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020407
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020407,
					"content": "Was?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020408,
					"content": "Na, ich hab die Kiste doch genommen, um meine Schätze zu verstecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020409
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020409,
					"content": "Für deine Schätze?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020410
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020410,
					"content": "Ja, du wolltest doch die Kiste haben. Da habe ich meine Schätze rausgenommen. Deswegen ist sie jetzt leer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020411
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020411,
					"content": "Und du hast einfach deine eigenen Sachen hineingetan?! Wa... Was ist mit dem ursprünglichen Inhalt? Deswegen bin ich hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020412
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020412,
					"content": "Ach, du wolltest das, was IN der Kiste war! Warum sagst du das nicht gleich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020413
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020413,
					"content": "Du hast es doch nicht etwa kaputtgemacht?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020414
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020414,
					"content": "Ach, Quatsch! Alles noch heil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020415
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020415,
					"content": "Puh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020416,
					"content": "Du hältst es gerade in der Hand. Es ist das Buch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020417
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020417,
					"content": "Wie bitte?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020418,
					"content": "I... Ist dieses Buch etwa ... von dem alten Weib? Ist das ihr Tagebuch von vor fünfzig Jahren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020419,
					"content": "Was sie nach fünfzig Jahren zurückhaben wollte, ist ihre dunkle Vergangenheit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020420
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020420,
					"content": "Oh nein! Mist! Deswegen hat die Alte gesagt, dass ich mir in keinem Fall das Objekt ansehen dürfte. Sonst würde sie mich vierteilen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020421
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020421,
					"content": "Ha... Hab ich was falsch gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020422
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020422,
					"content": "Aah! Du hast doch gesagt, du wolltest die Kiste! Nicht das, was drin war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020423
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020423,
					"content": "Das hab ich nicht mit Absicht gemacht! Ich bin weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020424,
						105020425
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020424,
					"content": "Ein rührendes Ende ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				},
				{
					"id": 105020426,
					"content": "Aber Mona, wenn du deiner Meisterin nichts sagst, sollte sie doch auch nicht erfahren, dass du ihr Tagebuch gelesen hast, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020427,
					"content": "Natürlich wird sie das! Vor einer Astrologin kann man nicht lügen. Das habt ihr doch selbst gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020428
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020428,
					"content": "Jetzt hab ich all meine Mora ausgegeben, um nach Mondstadt zu kommen, und nun stehe ich da ohne neues Wissen und kann auch nicht zurückkehren. Wie konnte es nur so weit kommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020429
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020429,
					"content": "Du tust Paimon leid. Vielleicht solltest du einfach warten, bis du alles aus dem Tagebuch vergessen hast, und dann erst zurückgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020430,
					"content": "Wie stellst du dir das vor? In Mondstadt zu bleiben, wäre außerdem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020431,
						105020433
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020431,
					"content": "Peinlich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020432
					]
				},
				{
					"id": 105020432,
					"content": "Genau. Wie soll ich mein astrologisches Wissen inmitten dieser einfältigen Leute hier aufrechterhalten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020435,
					"content": "In dem Fall kannst du nur zurückgehen und dich deinen Ängsten stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020436,
					"content": "Ach, jetzt hört doch auf damit! Ich werde das so machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020437
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020437,
					"content": "Ja, ich habe mich entschlossen, solange in Mondstadt zu bleiben, bis das alte Weib das Zeitliche gesegnet hat. Dann werde ich frei sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020438,
						105020439
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020438,
					"content": "Du bist zu einer erschreckenden Schlussfolgerung gekommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020440,
					"content": "Aber wie soll ich meine Astrologie weiter betreiben? Ich hab ja nicht einmal eine Bleibe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020441
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020441,
					"content": "Wir könnten doch <color=#00E1FFFF>Katheryne von der Abenteurergilde</color> fragen, ob sie dir helfen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020442,
					"content": "Von der Abenteurergilde? Ah, du meinst, ich könnte eine Mission für sie erfüllen im Austausch gegen ... einen Gefallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020443,
						105020444
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020443,
					"content": "Ganz recht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020445,
					"content": "Ah, na dann ... danke ... denk ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020444,
					"content": "Zumindest ist das der Plan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020439,
					"content": "Hältst du das für eine endgültige Lösung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020433,
					"content": "Teuer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020434
					]
				},
				{
					"id": 105020434,
					"content": "Genau ... Äh, nein! Du hast echt kein Mitgefühl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020425,
					"content": "Klee kann doch nichts dafür.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				}
			]
		},
		{
			"id": 1050205,
			"completionStepIds": [
				1050208
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050208",
							"2"
						],
						"stepId": 1050208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020501,
					"content": "Monas Geschichte und ihre missliche Lage",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020502
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020502,
					"content": "Ah, alles klar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020503
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020503,
					"content": "In Mondstadt gibt es eine unbenutztes <color=#00E1FFFF>Magielabor</color>, das ihr nehmen könntet. Leider hat es jemand versiegelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020504
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020504,
					"content": "Wir haben zwar einige Experten, die das Siegel lösen könnten. Aber sie haben alle ihr eigenes Labor und interessieren sich nicht allzu sehr für die Sache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020505
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020505,
					"content": "Ich denke, dass der Besitzer die Astrologin, von der du gesprochen hast, sicher darin wohnen lassen würde, wenn sie das Siegel lösen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020506,
						105020507
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020506,
					"content": "Das schafft sie bestimmt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				},
				{
					"id": 105020508,
					"content": "Na gut, dann werde ich dir sagen, wo sich das Labor befindet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 105020507,
					"content": "Ich werde sie dorthin begleiten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020508
					]
				}
			]
		},
		{
			"id": 1050206,
			"completionStepIds": [
				1050211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050211",
							"2"
						],
						"stepId": 1050211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020601,
					"content": "Wer dieses Siegel nur erstellt hat ... Es scheint unmöglich, es mit Gewalt zu lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020602
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020602,
					"content": "Faszinierend ... Ich denke ich sollte es mit meiner Astrologie versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020603,
					"content": "Ah, ich kann es deutlich sehen ... Erst so, dann so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020604
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020604,
					"content": "Fertig. Offen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020605
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020605,
					"content": "Ohoho, das war beeindruckend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020606,
					"content": "Jetzt müssen wir nur noch Katheryne Bescheid geben und du solltest hier wohnen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020607,
					"content": "Ach, das wird nicht nötig sein. Vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020608
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020608,
					"content": "Wer bist du, wenn ich fragen darf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020609
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020609,
					"content": "Ich bin Goth, der Eigentümer dieses Gebäudes. Ich war vorhin bei der Abenteurergilde. Da hat Katheryne mir alles erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020610
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020610,
					"content": "Ich bin natürlich nicht davon ausgegangen, dass ihr so schnell wärt. Endlich ist dieses nervige Siegel gelöst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020611
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020611,
					"content": "Heißt das, ich darf hier wohnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020612
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020612,
					"content": "Aber natürlich, sicher doch! Die Geräte stehen ja sonst nur ungenutzt herum. Wenn sie jemand benutzen würde, wären sie wenigstens nicht umsonst da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020613
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020613,
					"content": "Um meinen Dank auszudrücken, werde ich dir das Gebäude zum allerniedrigsten Preis vermieten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020614
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020614,
					"content": "V... Vermieten?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020615
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020615,
					"content": "Mir hat keiner was von Miete gesagt. Und ich habe extra geholfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020616
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020616,
					"content": "Geholfen? Ja, klar. Dafür bin ich dir auch dankbar. Deswegen werde ich dir einen sehr guten Preis geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020617
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020617,
					"content": "Äh, also, ich meine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020618
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020618,
					"content": "Mona scheint das Ganze missverstanden zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020619,
						105020620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020619,
					"content": "Das scheint immer noch die beste Wahl zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020621
					]
				},
				{
					"id": 105020621,
					"content": "*seufz* Dann habe ich wohl keine andere Wahl. Ich werde das Labor mieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020622
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020622,
					"content": "Abgemacht! Wartet nur kurz, während ich die Papiere vorbereite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020623
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 105020623,
					"content": "Danke für eure Hilfe! Jetzt musst du wohl oder übel etwas warten, bis ich tun kann, was ich dir versprochen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020624
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020624,
					"content": "Ohne die nötigen Geräte und neues Wissen werde ich dein Schicksal nicht so schnell erkennen können. Das wird einiges an Zeit brauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020625
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020625,
					"content": "Aber ich verspreche dir, dass ich dir sofort helfen werde, sobald ich dazu in der Lage bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020626,
						105020628
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020626,
					"content": "Wie du schon sagtest, diese Reise schadet niemandem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020627
					]
				},
				{
					"id": 105020627,
					"content": "Danke. Unsere gemeinsame Reise war Schicksal, um nicht zu sagen Glück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020630
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020630,
					"content": "Euch beiden noch eine gute Reise! Ich ... Ich werde solange überlegen, wie ich die Zukunft angehen soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020631
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020631,
					"content": "Wovon soll sie eigentlich leben, wenn sie kein Geld mit Astrologie verdienen will?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020632,
					"content": "Wir sollten vielleicht von Zeit zu Zeit mal vorbeischauen. Nicht, dass sie uns noch ohnmächtig vor Hunger wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020628,
					"content": "Dann wünsch ich dir viel Glück!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020629
					]
				},
				{
					"id": 105020629,
					"content": "Ich dir auch. Ich weiß zwar noch nicht, wie ich jetzt weitermachen soll. Aber ich werde mir etwas einfallen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020630
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020620,
					"content": "Du musst einfach etwas sparsamer sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020621
					]
				}
			]
		},
