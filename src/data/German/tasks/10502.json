					"content": "Diese Kiste ist wirklich sehr wichtig für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020702
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020702,
					"content": "Wenn etwas passieren sollte, könnte ich noch nicht einmal zur dem alten Weib zurück ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
