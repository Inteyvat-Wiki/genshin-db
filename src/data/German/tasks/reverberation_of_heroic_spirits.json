			"dialogs": [
				{
					"id": 761420401,
					"content": "Filaev, hab keine Angst, Patoli und ich bringen dich hier raus. Reiß dich zusammen und halt dein Schwert fest wie ein richtiger Lichthüter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420402
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420402,
					"content": "Ich ... Ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420403
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420403,
					"content": "Was für einen Plan? Welchen Plan soll es schon geben, Patoli? Wenn das das Ende ist, dann werde ich hier bis zum Schluss kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420404
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420404,
					"content": "Ihr seid die beste Truppe, und egal wie das Ergebnis aussieht, es war mir eine Ehre, an eurer Seite zu kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420405
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420405,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420406
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420406,
					"content": "Die Ehre liegt ganz bei uns, Truppenführer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420407
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420407,
					"content": "Los, machen wir uns bereit zur Verteidigung! Zeigen wir diesen Bastarden, was die Frostwind-Ritter auf dem Kasten haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
