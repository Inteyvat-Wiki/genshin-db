			"dialogs": [
				{
					"id": 761420301,
					"content": "He, Chernov, geht es dir gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420302
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420302,
					"content": "Ich kann noch mein Schwert halten ... Truppenführer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420303
					],
					"speakerTitle": "Chernov"
				},
				{
					"id": 761420303,
					"content": "Shonokovych ... Filaev ... geht es euch gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420304
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420304,
					"content": "Ugh ... mein Bein scheint gebrochen zu sein, aber zum Glück lebe ich noch. Hast du mitgezählt? Wie viele habe ich erledigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420305
					],
					"speakerTitle": "Shonokovych"
				},
				{
					"id": 761420305,
					"content": "W... Wie viele Monster gibt es denn noch ... Wir ... Wir werden doch hier nicht sterben, oder, Truppenführer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420306
					],
					"speakerTitle": "Filaev"
				},
				{
					"id": 761420306,
					"content": "Was redest du da für einen Unsinn, du Bengel? Wir kommen hier ganz sicher raus! Mach dir keine Sorgen – der Späher ist bestimmt schon zurück in der Stadt und hat dem Alten Bescheid gegeben. Unsere Verstärkung ist längst unterwegs!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420307
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420307,
					"content": "Da sind sie wieder, das nimmt aber auch kein Ende mit der Wilden Jagd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761420308
					],
					"speakerTitle": "???"
				},
				{
					"id": 761420308,
					"content": "He! Haltet eure Waffen und die Laternen bereit – wir haben noch einen harten Kampf vor uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
