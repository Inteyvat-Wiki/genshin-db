			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lauma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761860201,
					"content": "Ein wirklich köstlicher Kräutertee, Fräulein Sandrone. Es ist, als könnte ich deine Aufrichtigkeit schmecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860202,
						761860203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860202,
					"content": "(Lass uns noch ein Weilchen so sitzen bleiben.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860204,
					"content": "Also gut. Nächstes Mal muss ich dich zum Tee einladen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860203,
					"content": "Ich glaube, es wird Zeit, dass ich mit dem Aufräumen anfange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
}