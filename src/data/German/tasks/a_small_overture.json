			"dialogs": [
				{
					"id": 761860101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860102
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860103,
					"content": "... Also, wie ist es den Nachkommen des Frostmonds in letzter Zeit ergangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860104,
					"content": "Ganz gut. Die Rückkehr der Mondgöttin hat unsere Entschlossenheit gestärkt, unseren vorbestimmten Weg zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860105
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860105,
					"content": "Wirklich? Na, das ist ja schön zu hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860106,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860108,
					"content": "Hah ... Ich schätze, wir haben uns wirklich nichts zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860109,
					"content": "Ich fürchte das ... liegt daran, dass zwischen den Nachkommen des Frostmonds und den Fatui einfach viel zu viel vorgefallen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860110,
					"content": "Ich für meinen Teil bin dankbar für deine Bemühungen, Nod-Krai zu beschützen und die Mondgöttin wieder willkommen zu heißen, Fräulein Sandrone. Aber was deine Verbündeten angeht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860111,
					"content": "Ich verstehe. Aus verschiedenen Gründen ist es uns nicht gelungen, freundschaftliche Beziehungen aufzubauen – oder auch nur solche, die für beide Seiten von Vorteil sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860112,
					"content": "Aber die Fatui wollen nichts mehr von den Nachkommen des Frostmonds, und ich habe meine Untergebenen daran erinnert, keinen Ärger zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860113
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860113,
					"content": "Da wir Nachbarn sind, wäre es aus meiner Sicht schön, wenn wir uns zumindest mit gegenseitigem Respekt begegnen könnten, selbst wenn wir nicht in perfekter Harmonie zusammenleben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860114,
					"content": "Ich fürchte, das wird Zeit brauchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860115,
					"content": "Zweifellos. Aber wir können einen kleinen Schritt nach dem anderen machen. Möchtest du diesen Kräutertee probieren, den ich zubereitet habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860116,
					"content": "Oh? Kräutertee ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860117,
					"content": "Hmm ... So ein kräftiger Geschmack. Hast du den etwa nach Art der Nachkommen des Frostmonds aufgebrüht? Die meisten Fremden, die ich treffe, mögen unseren Tee nicht. Wie hast du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860118
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860118,
					"content": "Durch Lernen. Und indem ich Respekt zeige.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860119,
					"content": "Hah ... Kein schlechter erster Schritt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860120
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860120,
					"content": "Ich hoffe, er trifft deinen Geschmack.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860121
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761860121,
					"content": "Ich mag ihn sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860122
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860122,
					"content": "Nette Gespräche bei einer heißen Kanne Tee waren schon immer ein toller Weg, um Freundschaften zu schließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860123
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860123,
					"content": "Ich habe das Gefühl, dass es dieses Mal keine Ausnahme sein wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
