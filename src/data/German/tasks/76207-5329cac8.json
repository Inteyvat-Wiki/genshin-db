			"dialogs": [
				{
					"id": 762070201,
					"content": "Ah ... Einst war ich Sprache, doch nun bin ich zum zerbrochenen Subjekt der Täuschung verkommen und kehre zurück zu diesem unvollkommenen „Symbol“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070202
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070202,
					"content": "Waah! Ein seltsamer Typ spricht seltsames Zeug aus einem seltsamen Buch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762070203,
					"content": "„Seltsam“ ist ein ungenauer Begriff. Er bezeichnet etwas, das man nicht beschreiben, aufschreiben oder darstellen kann, aber ich entspreche dieser Definition offensichtlich nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070204
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070204,
					"content": "Ich habe bloß versucht, zwischen den Seiten einen Zugang zur „Realität“ zu finden, bin aber versehentlich in endlos aufgeschobene Metaphern gerutscht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070205
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070205,
					"content": "Ich wurde zu einem Rest, der nicht symbolisiert werden kann. Dank deines Eingreifens wurde ich von der Tyrannei der Sprache befreit ... und kann nun wieder anfangen, mich selbst zu verkennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070206
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070206,
					"content": "Sprich doch bitte normal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762070207
					]
				},
				{
					"id": 762070207,
					"content": "... Ich bin versehentlich in die Buchseiten gefallen und kam nicht mehr heraus. Danke, dass du mich herausgezogen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tosalis"
				}
			]
		}
	]
