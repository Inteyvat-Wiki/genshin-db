			"dialogs": [
				{
					"id": 761820201,
					"content": "... Es ist wirklich schön hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820202,
						761820203
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761820202,
					"content": "(Lass uns noch ein Weilchen so sitzen bleiben.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761820204,
					"content": "Alles klar, lass uns ein andermal wiederkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761820203,
					"content": "Ich glaube, es wird Zeit, dass ich mit dem Aufräumen anfange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
