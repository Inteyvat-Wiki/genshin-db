			"dialogs": [
				{
					"id": 761820101,
					"content": "Hast du hier früher gewohnt? Hübsch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820102
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761820102,
					"content": "Früher war es sogar noch schöner. Ich habe ein gutes Händchen fürs Gärtnern, weißt du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761820103,
					"content": "Hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820104
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761820104,
					"content": "Worüber lachst du denn jetzt schon wieder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761820105,
					"content": "Ich habe mir nur gerade vorgestellt, wie du dich hinhockst und dich um die Blumen kümmerst. Eine wirklich süße Vorstellung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820106
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761820106,
					"content": "Kann ich da gleich mal reinschauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820107
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761820107,
					"content": "Natürlich. Geputzt und Staub gewischt habe ich schon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761820108,
					"content": "Was hast du mit dem Ort vor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820109
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761820109,
					"content": "Hmm ... Ich glaube, ich möchte ihn noch behalten. Ich kann jederzeit zurückkommen und aufräumen, wenn ich Zeit habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761820110,
					"content": "Wenn du beschäftigt bist, kann ich mich stattdessen darum kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820111
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761820111,
					"content": "Es gibt mir dasselbe Gefühl wie damals dein altes Zimmer. Es ist beruhigend ... Ein glücklicher Ort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820112
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 761820112,
					"content": "Hah ... Wie du meinst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
