			"dialogs": [
				{
					"id": 706580101,
					"content": "Hallöchen, gefallen dir die Aktivitäten beim Windblumenfest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580102,
						706580103
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580102,
					"content": "Dank deiner Empfehlungen, ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580104
					]
				},
				{
					"id": 706580104,
					"content": "Hehe, ich habe hier noch eine lockerere Aktivität mit dem Namen „Lied der Landschaft“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580105
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580105,
					"content": "Sicher kennst du die Barden von Mondstadt. In dieser Aktivität kannst du liebliche Lieder spielen, ganz wie sie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580106
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580106,
					"content": "Spüre den Wind in den Bergen und über den Flüssen, trage dein Lied mit Herz und Seele vor. So vergisst du garantiert all deine Sorgen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580107,
						706580108
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580107,
					"content": "Aber das ist ganz neu für mich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
				{
					"id": 706580109,
					"content": "Keine Sorge. Diese Aktivität dient genau dazu, den musikalisch Unerfahrenen die Freuden des Musizierens zu unterbreiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580110
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580110,
					"content": "Solange du die Hinweise befolgst und dich an den Rhythmus hältst, geht alles gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706580111,
						706580112
					],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580111,
					"content": "Das beruhigt mich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580113,
					"content": "Na klar. Ein schönes Windblumenfest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lizz"
				},
				{
					"id": 706580112,
					"content": "Dann probiere ich es mal aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580113
					]
				},
				{
					"id": 706580108,
					"content": "Wird es auch gut klingen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580109
					]
				},
				{
					"id": 706580103,
					"content": "Ich hatte noch keine Zeit dazu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706580104
					]
				}
			]
		}
	]
