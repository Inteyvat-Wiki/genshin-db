			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4541101,
					"content": "Das sind Blutspuren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541102,
					"content": "Nicht von Menschen, von Wölfen. Meine Lupical ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541103
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541103,
					"content": "Was ist dieses Lupical jetzt eigentlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541104,
					"content": "Lupical ... Familie durch Schicksal. Mensch bei Wölfen oder Wolf bei Menschen, alles Lupical.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541105
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541105,
					"content": "Klingt nicht wie menschliche Sprache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541106,
					"content": "Komisch klingt es wirklich. Das haben sich die Wölfe sicher nicht selbst ausgedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541107,
					"content": "Er zeigt mir Namen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541108,
					"content": "Und wer ist er?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541109,
					"content": "Herrscher von Land.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541110
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541110,
					"content": "Der Herrscher von Mondstadt, das müsste doch Barbatos sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541111,
					"content": "Genug geredet. Spur gefunden. Kommt mit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541112,
					"content": "Warte! Ich will dir doch nur eine Gelegenheit geben, dich zu rechtfertigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541113,
					"content": "Tja, Razor ist schon auf und davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 45413,
