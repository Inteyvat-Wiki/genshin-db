			},
			"dialogs": [
				{
					"id": 4540601,
					"content": "Bitte, beruhigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540602
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540602,
					"content": "Hmpf, schon gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540603
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540603,
					"content": "Wie er es zuvor selbst gesagt hat, werden die Wölfe, die in unser Gebiet eingedrungen sind und die Regeln gebrochen haben, die Konsequenzen dafür tragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540604
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540604,
					"content": "Aber das hat nichts mit dir zu tun, Razor. Hier geht es nur um die Wölfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540605
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540605,
					"content": "Du kämpfst mit Eisen, nicht mit Klauen. Du schlägst mit Blitzen zu, aber beißt nicht mit Zähnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540606
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540606,
					"content": "Du bist ein Mensch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540607
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540607,
					"content": "Nicht wie sie, anders! Nicht zu Menschen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540608
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540608,
					"content": "Du ... bist kein Wolf. Dieses Sache müssen die Wölfe unter sich klären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540609
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540609,
					"content": "Doch du, Razor, bist Teil der Lupical der Menschen, auch wenn du ein ganz besonderes Exemplar bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540610
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540610,
					"content": "Wenn du möchtest, kann ich dich trainieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540611
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540611,
					"content": "Präge dir meine Worte ein, Razor! Mögen wir uns wiedersehen, wenn uns das Schicksal wieder zusammenführt, Razor und seine menschlichen Gefährten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540612
					],
					"speakerTitle": "Boreas"
				},
				{
					"id": 4540612,
					"content": "Ach, Razor, mach nicht so ein Gesicht! Stimmt ja, du kannst doch für ein paar Tage mit in die Stadt kommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540613
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540613,
					"content": "Genau! Du hast doch einen Freund in Mondstadt, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540614,
					"content": "Der rote, heiße Ritter, von dem du gesprochen hast ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540615,
					"content": "Du bist in der Wildnis nicht mehr sicher. Doch ich weiß, dass du ihnen nicht wehtun willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540616
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540616,
					"content": "Alles gut, keine Sorge. Ich nicht für Stadt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540617
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540617,
					"content": "Aber auch nicht hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540618,
						4540619
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540618,
					"content": "Razor ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540621
					]
				},
				{
					"id": 4540621,
					"content": "#Danke. {NICKNAME}, Paimon und ... anderes rotes Mädchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540622
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540622,
					"content": "Wir haben so lange geredet und du weißt meinen Namen nicht? Er lautet Amber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540623
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540623,
					"content": "Gut, bis bald!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540619,
					"content": "Sei nicht so bedrückt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4540621
					]
				}
			]
		},
