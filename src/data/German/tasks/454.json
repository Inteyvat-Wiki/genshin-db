			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4540301,
					"content": "Wir sind zurück! Ist das genug?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540302,
					"content": "Genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540303
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540303,
					"content": "Er hat mir gerade von den Regeln in der Welt der Wölfe erzählt. Echt unfassbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540304,
					"content": "Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540305,
					"content": "Wir haben alles durchsucht und sind auf keine anderen Wölfe getroffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540307
					],
					"speakerTitle": "Hopkins der Fabelhafte"
				},
				{
					"id": 4540307,
					"content": "Wölfe sind eben so. Der, den wir eben geschnappt haben, hat offensichtlich Probleme mit dem Kopf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540308
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540308,
					"content": "Was machst du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540309
					],
					"speakerTitle": "Hopkins der Fabelhafte"
				},
				{
					"id": 4540309,
					"content": "Rechnung begleichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540310
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540310,
					"content": "Das ist er, der von den Wölfen großgezogen wurde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540311
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540311,
					"content": "*erschrocken*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540312
					],
					"speakerTitle": "Hopkins der Fabelhafte"
				},
				{
					"id": 4540312,
					"content": "Du warst es also. Ich hätte es wissen müssen, Wölfe sind nicht schlau genug, um dafür verantwortlich zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540313
					],
					"speakerTitle": "Hopkins der Fabelhafte"
				},
				{
					"id": 4540313,
					"content": "Wie kannst du diesen wilden Tieren nur helfen, sich gegen Menschen zu stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540314
					],
					"speakerTitle": "Hopkins der Fabelhafte"
				},
				{
					"id": 4540314,
					"content": "Glaubst du, du bist ein Wolf, weil Wölfe dich gefüttert haben? Hast du vergessen, wo du herkommst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540315
					],
					"speakerTitle": "Hopkins der Fabelhafte"
				},
				{
					"id": 4540315,
					"content": "Es reicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540316
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540316,
					"content": "Ihr redet auf einen Jungen ein, der nicht gut sprechen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540317,
					"content": "Wie? Die Ritter stellen sich auf seine Seite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540318
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540318,
					"content": "Wir nicht angreifen Dorf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				}
			]
		},
