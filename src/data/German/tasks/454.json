					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4541301,
					"content": "Er! Böse Menschen fangen Wolf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541302
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541302,
					"content": "Das kann ja nicht wahr sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541303,
					"content": "Das ist natürlich schlimm, aber das ändert meinen Standpunkt ja n...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541304,
					"content": "Wir nicht angreifen Dorf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541305,
					"content": "Fremder schwarzer Wolf und Rudel, wollen Land, brechen Gesetze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541306
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541306,
					"content": "Was für <color=#00E1FFFF>Gesetze</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541307,
					"content": "Gesetze von Herrscher von Land.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541308
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541308,
					"content": "Den hattest du schon einmal erwähnt. Kannst du näher darauf eingehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541309
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541309,
					"content": "Muss weiter hinein mit Lupical. Du mit uns und selbst sehen. Vielleicht finden Antwort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				}
			]
		},
