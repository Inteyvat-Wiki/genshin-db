			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700250101,
					"content": "#Sei gegrüßt, {F#Abenteurerin}{M#Abenteurer}! Ich wurde bereits über die Erledigung des Auftrags informiert. Die Gilde ist dankbar für deine anhaltende Unterstützung! Hier ist deine Entschädigung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700250102,
					"content": "Obwohl es dir nicht gelungen ist, den merkwürdigen Hilichurl zu fangen, und wir den Grund für die jüngste Flut von Unruhen immer noch nicht kennen ... ist die Wildnis jetzt viel sicherer, also danke ich dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 700250103,
					"content": "Apropos, Ella Musk wartet in der Bibliothek auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 7002502,
			"completionStepIds": [
				7002502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002502",
							"2"
						],
						"stepId": 7002502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700250201,
					"content": "Homu ... mimi tomo ... Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250202
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250202,
					"content": "Hallo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250203
					]
				},
				{
					"id": 700250203,
					"content": "Ya ika!! ... O... Oh, du bist es nur, puh ... Meine Güte, du hast mich zu Tode erschreckt. Bitte, ich würde es begrüßen, wenn du mich nicht so unterbrechen würdest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250204,
					"content": "Wie können wir stören, wo du uns doch herbeigerufen hast!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700250212,
					"content": "Hmm ...? Oh, du bist es! Danke für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250205
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250205,
					"content": "Also, stimmt es, was im Buche steht? Hat es sich beim Umgang mit den Hilichurlen als nützlich erwiesen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250206,
						700250207
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250206,
					"content": "Es bedurfte keiner Anstrengung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				},
				{
					"id": 700250208,
					"content": "Haha! Ein weiterer Schritt vorwärts in der Entwicklung meines Wörterbuchs. Dies liefert weitere Beweise für meine These über die Realisierbarkeit einer harmonischen Koexistenz zwischen den Menschen und den Hilichurlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250209
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250209,
					"content": "Trotzdem ist es schade, dass du nicht die Gelegenheit hattest, dich mit dem merkwürdigen Hilichurl zu unterhalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250210
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250210,
					"content": "Aber aus dem linguistischen Korpus, den ich bisher zusammenstellen konnte, scheint es wahrscheinlich, dass er einfach hierherkam und einen neuen Ort suchte, um neue Freunde zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250213
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250213,
					"content": "Es ist wirklich schade, dass du nicht dazu gekommen bist, dich mit ihm zu unterhalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250214
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250214,
					"content": "Ah, das hätte ich fast vergessen — das ist für dich, als Dank für dein Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250215
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250215,
					"content": "Du hast mir hier sehr geholfen und ich entschuldige mich dafür, dass ich dich so sehr in Verlegenheit gebracht habe ... Aber ich hoffe, dass ich in Zukunft wieder das Vergnügen haben werde, mit dir zu arbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700250211
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700250211,
					"content": "... Moment, was? Damit er eine Unterhaltung führen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700250207,
					"content": "Ja, obwohl ich immer noch meine übliche Art des Umgangs bevorzuge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700250208
					]
				}
			]
		}
	]
}