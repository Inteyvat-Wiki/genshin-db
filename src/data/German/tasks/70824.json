			"dialogs": [
				{
					"id": 708240601,
					"content": "Uh, das Weingut ist einfach zu groß. Wie sollen wir den ganzen Ort reinigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240602
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240602,
					"content": "Nachdem wir draußen saubergemacht haben, bleibt immer noch drinnen. Werden wir diesen Ort jemals sauber kriegen ...",
