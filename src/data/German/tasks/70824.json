					"Adelinde"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708240101,
					"content": "Säubere den Ort nochmal. Ich will, dass er dieses Mal makellos ist! Hierbei geht es um einen guten ersten Eindruck!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240102
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240102,
					"content": "Entschuldigung, Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240103
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 708240103,
					"content": "Wir werden dieses Mal sorgfältiger sein, Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240104
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240104,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240105
					]
				},
				{
					"id": 708240105,
					"content": "Ah, hallo, Reisender. Willkommen auf dem Weingut Morgenröte. Der Sturm mag vorüber sein, aber hier auf dem Weingut beseitigen wir noch immer das Chaos, welches er angerichtet hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240106
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240106,
					"content": "Ich versuche, die Aufräumarbeiten zu organisieren, aber diese Mädchen, sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240107
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240107,
					"content": "Entschuldigung, Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240108
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 708240108,
					"content": "Wir werden dieses Mal sorgfältiger sein, Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240109
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240109,
					"content": "Ja, das hast du bereits gesagt, vielen Dank dir! Warum verwendest du jetzt nicht etwas mehr Anstrengung auf das Saubermachen anstatt dich hier bei mir zu entschuldigen? Husch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240110
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240110,
					"content": "Diese Kinder ... Uh, sie sind so schlampig. Ich weiß nicht, wie wir das alles in diesem Tempo schaffen sollen. Und auch danach muss noch drinnen saubergemacht werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
		{
			"id": 7082402,
			"completionStepIds": [
				7082401
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adelinde"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708240201,
					"content": "Ich kann helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240202
					]
				},
				{
					"id": 708240202,
					"content": "Weißt du, wie man kehrt? Ähm, streich das. Wir haben so wenig Arbeitskräfte, dass ich jede Hilfe nehmen sollte, die ich kriegen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240203
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240203,
					"content": "Folge mir hinein, es gibt hier auch viel zu reinigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
		{
			"id": 7082403,
			"completionStepIds": [
				7082401
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Adelinde"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708240301,
					"content": "Ich bin exzellent im kehren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240302
					]
				},
				{
					"id": 708240302,
					"content": "Wirklich? Das ist großartig. Na ja, da du dazu bereit bist, werde ich dein Angebot gerne annehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240303
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240303,
					"content": "Folge mir hinein, es gibt hier auch viel zu reinigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
		{
			"id": 7082404,
