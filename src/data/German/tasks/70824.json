			"dialogs": [
				{
					"id": 708240401,
					"content": "Fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240402
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240402,
					"content": "Alles erledigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240403
					]
				},
				{
					"id": 708240403,
					"content": "Wundervoll, das war eine große Hilfe. Ich kann mir nicht vorstellen, wie lange ich selbst dafür gebraucht hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240404
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240404,
					"content": "Und wenn ich die Mädchen dazu gebracht hätte, es zu machen ... Wer weiß, wie viele Gegenstände sie dabei am Ende zerstört hätten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240405
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240405,
					"content": "Danke dir, nimm bitte das. Ich entschuldige mich dafür, dich, einen Besucher, mit der Arbeit des Dienstmädchens vom Weingut zu belasten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240406
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240406,
					"content": "Das nächste Mal, wenn du uns besuchst, wird das Weingut makellos sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
