				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270401,
					"content": "Sättigender Salat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270402
					]
				},
				{
					"id": 210270402,
					"content": "Dieses Gericht ist wirklich einfach zuzubereiten und schmeckt großartig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2102705,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
