					"content": "Spieß mit Pilzen und Hühnchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270302
					]
				},
				{
					"id": 210270302,
					"content": "Oh, ganz klassisches Abenteureressen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2102704,
