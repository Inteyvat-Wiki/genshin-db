			"trigger": {
				"objectNames": [
					"Kleiner Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270601,
					"content": "Oh ... dieses Rezept ist so detailliert, so viele Wörter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270602
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270602,
					"content": "Nun, die Überraschung entsteht nicht wirklich, wenn man es so einfach macht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270603
