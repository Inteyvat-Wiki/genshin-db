			},
			"dialogs": [
				{
					"id": 210270201,
					"content": "#{F#Reisende}{M#Reisender}? Meng? Was kann ich für euch tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270202
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 210270202,
					"content": "Äh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270203
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270203,
					"content": "Wir würden die Küche gern für eine Weile ausleihen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270204
					]
				},
				{
					"id": 210270204,
					"content": "Es ist in Ordnung, die Küche auszuleihen. Aber warum seid ihr plötzlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270205
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 210270205,
					"content": "So ist es also ... nun, ihr könnt sie benutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270206
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 210270206,
					"content": "Meng, du kannst nicht wählerisch sein, wenn du einen Ausflug machst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270207
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 210270207,
					"content": "Ich ... Ich weiß ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270208
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270208,
					"content": "Dann bring mir bitte bei, wie man ein gutes Gericht kocht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270209
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270209,
					"content": "Wenn ich mit meinem Vater verreise, werde ich ihn auf jeden Fall überraschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270210
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270210,
					"content": "Überlass das ruhig uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270211,
					"content": "#{NICKNAME}, was für ein Gericht machen wir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
