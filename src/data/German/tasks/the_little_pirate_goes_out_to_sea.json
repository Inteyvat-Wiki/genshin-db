				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270501,
					"content": "Süß mariniertes Hühnchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270502
					]
				},
				{
					"id": 210270502,
					"content": "Das ist köstlich! He, aber wäre das nicht ein bisschen schwierig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2102706,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
