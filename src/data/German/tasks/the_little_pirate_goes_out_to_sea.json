			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kleiner Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270101,
					"content": "Du kommst gerade rechtzeitig, ich wollte dich schon suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270102
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270102,
					"content": "Was gibt’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270103,
					"content": "Hatte ich dich nicht letztes Mal gebeten, mich zu begleiten, um eine Flaschenpost mit meinen Sorgen loszuwerden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270104
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270104,
					"content": "Ich hatte eigentlich keine Hoffnung mehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270105
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270105,
					"content": "Doch neulich erzählte mein Vater, dass einer seiner Geschäftspartner aus heiterem Himmel auf ihn zugekommen sei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270106
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270106,
					"content": "Der Freund sagte, dass sie ein Pilzgeschäft planten und einige Zeit später nach Sumeru fahren würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270107
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270107,
					"content": "Sie fragten meinen Vater, ob er mitkommen wolle, um zu sehen, was da drüben los sei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270108
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270108,
					"content": "Und sagte, dass ich mitkommen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270109
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270109,
					"content": "Mein Vater war zunächst nicht einverstanden, aber ... ein Mann zückte plötzlich einen Brief und sagte, er wolle rausgehen und mit meinem Vater allein sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270110
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270110,
					"content": "Nachdem sie das Gespräch beendet hatten, stimmte Papa zu, mich nach Sumeru zu bringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270111
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270111,
					"content": "Nun, ich weiß nicht, warum Papa plötzlich seine Meinung geändert hat ... aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270112
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270112,
					"content": "Ich kann nach Sumeru! Super!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270113,
						210270115
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270113,
					"content": "Gratuliere!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270114
					]
				},
				{
					"id": 210270114,
					"content": "Die Flaschenpost hat sicher Wirkung gezeigt, danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270117,
					"content": "Papa sagte, dass sie nach Sumeru zu einem Dorf namens „Qiaoying“ gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270118
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270118,
					"content": "Qiaoying?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270119
					]
				},
				{
					"id": 210270119,
					"content": "Nun, Papa sagte, es sei ein Teedorf mit vielen Teebäumen und die Qualität der Teeblätter sei außergewöhnlich gut. Aber es ist ein schwer zu merkender Name ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270120
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270120,
					"content": "Darüber wollen wir im Moment nicht sprechen! Wir müssen noch nach Sumeru kommen, bevor wir dorthin fahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270121
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270121,
					"content": "Sumeru ist auch weit weg von hier und es muss lange dauern dorthinzukommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270122
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270122,
					"content": "Ich habe aber schon gehört, dass man sich auf eine Reise gut vorbereiten muss, weil man unterwegs auf viele Situationen trifft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270123
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270123,
					"content": "Du reist viel. Kannst du mir bitte ein paar Tipps geben, wie man draußen reist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270124
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270124,
					"content": "Wie zum Beispiel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270125
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270125,
					"content": "Was isst du normalerweise, wenn du draußen unterwegs bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270126
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270126,
					"content": "Papa sagte, dass sie alle ihr eigenes Essen kochten. Aber ich kenne nur ein paar einfache Gerichte und ich weiß nicht, ob ich sie gut kochen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270127
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270127,
					"content": "#Hehe, Kochen ist unsere Spezialität, nicht wahr, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270128,
						210270129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270128,
					"content": "Ich bringe es dir bei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270130,
					"content": "Dann müssen wir zuerst einen Herd finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270131,
					"content": "Mal sehen ... Warum leihen wir uns nicht wieder die Küche von Koch Mao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270132,
					"content": "Koch Mao? Oooh, er ist normalerweise so unheimlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270133
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270133,
					"content": "Was? Überhaupt nicht, er ist sehr nett.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270134,
					"content": "Ja, wirklich? Aber jedes Mal, wenn ich mit meinem Vater dort esse, runzelt er die Stirn, wenn ich die Qingxin herausnehme und sie nicht esse ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210270129,
					"content": "Ich werde das machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270115,
					"content": "Ich könnte genauso gut nach Sumeru gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270116
					]
				},
				{
					"id": 210270116,
					"content": "Wirklich? Wir sehen uns dann in Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Kleiner Meng"
				}
			]
		},
