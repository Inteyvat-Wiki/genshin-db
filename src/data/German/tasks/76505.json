			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varesa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765050101,
					"content": "#{NICKNAME} und Paimon? Was für ein Zufall! Ich hatte gehört, dass ihr nach Nod-Krai aufgebrochen seid, aber ich hätte nicht gedacht, euch so schnell hier anzutreffen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050102
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050102,
					"content": "Ja! Paimon dachte schon, sie hätte sich verguckt! Varesa, wie kommt es, dass du an einem so weit entfernten Ort auftauchst? Bist du etwa auch auf Reisen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765050103,
					"content": "Hehe, so ähnlich! Ich bin hier, um landwirtschaftliche Maschinen für die Obstplantage meiner Familie zu besorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050104
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050104,
					"content": "Papa meinte, in Nod-Krai gäbe es Dinge, die die Früchte besser wachsen lassen und mir etwas Arbeit ersparen würden, damit ich mehr Zeit zum Schlafen ... und für mein Training habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050105
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050105,
					"content": "Und dann entdeckte ich hier so viele Leckereien, die es in Natlan nicht gibt! Daher habe ich die meiste Zeit hier hauptsächlich mit Essen und Trinken verbracht, wenn ich nicht gerade mit etwas Wichtigem beschäftigt war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050106
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050106,
					"content": "Die Zeit ist wie im Flug vergangen und jetzt, da die Rückreise bevorsteht, fällt mir der Abschied schon etwas schwer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050107
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050107,
					"content": "Deshalb will ich diese letzte Gelegenheit ausnutzen, um mich noch einmal richtig umzuschauen, alles zu probieren, was ich noch nicht gegessen habe, und alles zu sehen, was ich noch nicht gesehen habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050108
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050108,
					"content": "#Und ihr? Lasst mich raten ... {F#Unsere unbesiegbare Heldin}{M#Unser unbesiegbarer Held} {NICKNAME} ist wohl wieder damit beschäftigt, in diesem neuen Land für Gerechtigkeit zu sorgen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050109,
						765050110
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050109,
					"content": "Wir erkunden einfach nur die Umgebung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				},
				{
					"id": 765050111,
					"content": "Hehe, ich verstehe, was du meinst! Wenn man in einer neuen Region ist, ist alles so aufregend, dass man am liebsten jeden interessanten Winkel mit einem „Knips“ des Fotoapparats festhalten möchte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050112
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050112,
					"content": "Oh, jetzt, da du es erwähnst ... Ich hätte auch alle Speisen, die ich hier gegessen habe, ganz genau fotografieren sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050113
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050113,
					"content": "Wieder zurück in Natlan könnte dann Atolli vielleicht versuchen, diese Köstlichkeiten anhand der Fotos nachzukochen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050114
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050114,
					"content": "Varesa, du könntest vielleicht zu einer Gourmetfotografin werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050115
					]
				},
				{
					"id": 765050115,
					"content": "Hehe, wirklich? Gourmetfotografin ... Das klingt toll! Täglich mit Leckereien arbeiten und sie so appetitlich ablichten, dass einem das Wasser im Mund zusammenläuft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050116,
						765050117
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050116,
					"content": "Aber bevor wir das Essen fotografieren ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050118,
					"content": "Hm? Ihr wollt mich fotografieren? Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050119
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050119,
					"content": "M... Meine Haare sind nicht zerzaust, oder? Habe ich Soßenreste am Mundwinkel? Ach, hätte ich gewusst, dass ich euch heute treffe, hätte ich das Accessoire getragen, das ich gestern auf dem Markt gekauft habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050120,
						765050121
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050120,
					"content": "Du siehst jetzt schon perfekt aus!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050122,
					"content": "Gut! Dann ... Dann verlasse ich mich ganz auf euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050121,
					"content": "Ich möchte auf dem Foto festhalten, wie glücklich du jetzt aussiehst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050117,
					"content": "Darf ich ein Foto von dir machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050110,
					"content": "Wir suchen einfach nur nach Motiven für unsere Aufnahmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				}
			]
		},
