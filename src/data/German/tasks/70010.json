			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100601,
					"content": "Wie ist es gelaufen? Konntest du allgemeines Interesse wecken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100602
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100602,
					"content": "Ja, konnte ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100603
					]
				},
				{
					"id": 700100603,
					"content": "Dann verstehst du mich jetzt ... Die Lage ändert sich nicht. Ich habe mich nur daran angepasst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100604
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100604,
					"content": "*seufz* Mir ist jedes Mittel recht ... Wenn wir eine erfolgsversprechende Methode finden, werde ich den Göttern dafür danken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100605
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100605,
					"content": "Gehst du bald zurück zum Drachengrat, um Iris Bericht zu erstatten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100606
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100606,
					"content": "Bitte bring ihr diesen Brief von mir, sie möchte bestimmt über die Lage der Gilde informiert sein. Vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100607
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100607,
					"content": "*seufz* Hoffentlich bekommen wir neue Rekruten ... Doch eignet die Zielgruppe so einer Vermarktungsaktion sich auch als Abenteurer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
