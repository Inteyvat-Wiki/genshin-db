			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100101,
					"content": "Wegen deiner Mission ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100102
					]
				},
				{
					"id": 700100102,
					"content": "Du hast meine Mission gesehen und wolltest gleich loslegen, was? Ich habe etwas, bei dem ich deine Hilfe brauche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100103
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100103,
					"content": "Es geht darum, Bilder von zwei Orten auf dem Drachengrat zu schießen. Ich markiere die genauen Standorte auf deiner Karte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100104
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100104,
					"content": "Ich werde dich den Regeln der Abenteurergilde entsprechend entlohnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100105,
					"content": "Wie sieht’s aus? Nimmst du die Mission an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100106
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100106,
					"content": "Wozu brauchst du Bilder von diesen beiden Orten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100107
					]
				},
				{
					"id": 700100107,
					"content": "Nun ... letzten Endes wegen Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100108
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100108,
					"content": "Er hat mich um einige regionale Besonderheiten vom Drachengrat gebeten. Das gehört zu einer Rekrutierungsaktion während des Windblumenfests.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100109
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100109,
					"content": "Nun, das Fest ist im Gang, aber er hat mich nicht kontaktiert. Er muss wohl beschäftigt sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100110
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100110,
					"content": "Jetzt, da du es sagst, ist er wohl mit Feiern beschäftigt, oder? Alt genug dafür ist er ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100111
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100111,
					"content": "Ich glaube, dass er mittlerweile viel zu alt dafür sein könnte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100112
					]
				},
				{
					"id": 700100112,
					"content": "Wirklich? Den Eindruck habe ich nicht. Stattdessen ... Hmm, egal. Reden wir ein andermal darüber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100113
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100113,
					"content": "Bislang habe ich ein paar Erze gesammelt und topographische Karten sowie Monsterberichte erstellt. Ein paar Bilder vom Drachengrat würden gut dazu passen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100114
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100114,
					"content": "#Also, {F#Reisende}{M#Reisender}, würdest du an zwei Orten auf dem Drachengrat Bilder für mich schießen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100115
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100115,
					"content": "Du kannst auf mich zählen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100116
					]
				},
				{
					"id": 700100116,
					"content": "Prima, dann überlasse ich das dir. Ich habe die beiden Orte auf deiner Karte markiert. Komm zurück zu mir, sobald du das erledigt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100117
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100117,
					"content": "Willst du in der Stadt nicht nach dem Rechten sehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100118
					]
				},
				{
					"id": 700100118,
					"content": "Für mich ist das alles ein bisschen zu viel dort. Ich fühle mich hier wohler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100119
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100119,
					"content": "Ich habe jede Menge zu tun. Darum kann ich momentan nicht selbst gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100120
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100120,
					"content": "Ich habe die zwei malerischsten Orte auf deiner Karte markiert. Komm zurück zu mir, sobald du das erledigt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7001002,
			"completionStepIds": [
				7001008
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001008",
							"2"
						],
						"stepId": 7001008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100201,
					"content": "Wegen deiner Mission ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100202
					]
				},
				{
					"id": 700100202,
					"content": "Oh, bist du schon fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100203
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100203,
					"content": "Logisch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100204
					]
				},
				{
					"id": 700100204,
					"content": "Danke für deine Mühen. Mein Paket für den Jungen ist auch schon fertig. Könntest du es ihm überbringen? Sobald du das erledigt hast, bezahle ich dich. Komm also zurück zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100205
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100205,
					"content": "Ich weiß zwar nicht, ob es ausreicht, aber wenn er rekrutiert, sollten Monsterberichte und Erze eigentlich passen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7001003,
			"completionStepIds": [
				7001009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001009",
							"2"
						],
						"stepId": 7001009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100301,
					"content": "*seufz* Diese Rekrutierungsprogramm scheint nicht sonderlich brauchbar zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100302
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100302,
					"content": "Eine Sonderlieferung von Iris ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100303
					]
				},
				{
					"id": 700100303,
					"content": "Oh, sie hat mir etwas geschickt? Ja, das stimmt. Ich hatte sie schon mal gefragt, aber ich habe es vergessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100304
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100304,
					"content": "Wolltest du nicht das Windblumenfest feiern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100305
					]
				},
				{
					"id": 700100305,
					"content": "Das Windblumenfest? Nein, dafür fehlt mir die Zeit. Unser altes Rekrutierungsprogramm ist hinfällig, ich muss mir ein neues ausdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100306
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100306,
					"content": "Mal sehen, was Iris mir geschickt hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100307
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100307,
					"content": "Erze ... Nein, das ist unbrauchbar ... Die Jugend von heute hält sich nicht mit so was auf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100308
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100308,
					"content": "Karten? *seufz* Nun, die Gilde kann das zwar gebrauchen, aber zur Rekrutierung taugt das sicher nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100309
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100309,
					"content": "Berichte zu Monstern? Die sollten wir für unsere Abenteurer vervielfältigen, aber neue Mitglieder locken wir damit nicht an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100310
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100310,
					"content": "Oho, was ist das? Das sind zwei ziemlich schicke Fotos. Malerische Landschaften – und ungefährlich. Ah, das erweckt auf jeden Fall Aufmerksamkeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100311
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100311,
					"content": "Warum wählst du das aus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100312
					]
				},
				{
					"id": 700100312,
					"content": "Alles, was mit Abenteuern zu hat, hat er aussortiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700100313,
					"content": "Ach, du weißt nicht, in welchem Zustand die Gilde ist. Die Jugend von heute interessiert sich nicht mehr für Dinge wie Monster, Erze und topografische Karten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100314
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100314,
					"content": "So zieht man heutzutage Aufmerksamkeit auf sich. Man braucht etwas ... etwas „Pragmatisches“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100315
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100315,
					"content": "Das Windblumenfest ist im Gang. Diese jungen Leute wollen alle auffallen und beliebt sein, aber sicher nicht so, dass sie in Gefahr geraten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100316
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100316,
					"content": "Da kommt ein Abenteuer auf dem Drachengrat gerade recht. Die Fotos könnten sie auf die Gilde aufmerksam machen und dann schließen sie sich ihr vielleicht an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100317
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100317,
					"content": "Und ... selbst wenn sie keine Mitglieder werden ... springen vielleicht ein paar Missionen dabei heraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100319
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100319,
					"content": "Und wenn man diese beiden Zeichnungen betrachtet, liegen sie beide neben der Hauptstraße. Wenn du vorsichtig bist, besteht für dich keine Gefahr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100320
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100320,
					"content": "Wir pfeifen wirklich aus dem letzten Loch, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100321
					]
				},
				{
					"id": 700100321,
					"content": "Nun, so ist die Lage. Und es gibt keine anderen brauchbaren Ideen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100322
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100322,
					"content": "Wenn du mir nicht glaubst, zeig diese beiden Fotos doch den Leuten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100323
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100323,
					"content": "Sag ihnen, dass wir neue Mitglieder suchen. Danach präsentiere ihnen diese beiden Fotos als „Anschauungsmaterial.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100324
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 700100324,
					"content": "Dann wirst du verstehen, warum ich auf diese Idee gekommen bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
			"id": 7001004,
			"completionStepIds": [
				7001011
			],
