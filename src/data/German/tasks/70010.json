			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"José mit den sechs Fingern"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100401,
					"content": "#{M#Amigo}{F#Amiga}, soll ich dir mein neuestes Werk vorführen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100402
					],
					"speakerTitle": "José mit den sechs Fingern"
				},
				{
					"id": 700100402,
					"content": "Wegen der Rekrutierung der Abenteurergilde ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100403
					]
				},
				{
					"id": 700100403,
					"content": "Rekrutierung der Abenteurergilde? Lo siento, das interessiert mich wenig. Herumzurennen wie ein kopfloses Huhn, geziemt einem Barden nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100404
					],
					"speakerTitle": "José mit den sechs Fingern"
				},
				{
					"id": 700100404,
					"content": "Außerdem stellt an einem Ort wie Mondstadt der Ordo Favonius eine bessere Quelle dar, um ein Epos zu verfassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100405
					],
					"speakerTitle": "José mit den sechs Fingern"
				},
				{
					"id": 700100405,
					"content": "Lo siento, die Rekrutierung durch die Abenteurergilde interessiert mich nicht. Über gerettete Katzen lassen sich ... schlecht Lieder schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100406
					],
					"speakerTitle": "José mit den sechs Fingern"
				},
				{
					"id": 700100406,
					"content": "Hier ist etwas Anschauungsmaterial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100407
					]
				},
				{
					"id": 700100407,
					"content": "Ist das der ... Drachengrat? Qué vista magnífica ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100408
					],
					"speakerTitle": "José mit den sechs Fingern"
				},
				{
					"id": 700100408,
					"content": "Ein malerischer Ort könnte mir neue Inspiration eingeben. Und es scheint dort ungefährlich zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100409
					],
					"speakerTitle": "José mit den sechs Fingern"
				},
				{
					"id": 700100409,
					"content": "Hmm ... Ich werde später bei der Gilde vorbeischauen. Selbst wenn ich nicht beitrete, heuere ich vielleicht einen Abenteurer als Eskorte an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100410
					],
					"speakerTitle": "José mit den sechs Fingern"
				},
				{
					"id": 700100410,
					"content": "Eine Tour zum Drachengrat ... Ich kann es kaum abwarten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "José mit den sechs Fingern"
				}
			]
		},
		{
			"id": 7001005,
			"completionStepIds": [
				7001012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7001012",
							"2"
						],
						"stepId": 7001012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Helen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700100501,
					"content": "Oh! Kann ich dir helfen? Ich wollte gerade ein Lied anstimmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100502
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100502,
					"content": "Wegen der Rekrutierung der Abenteurergilde ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100503
					]
				},
				{
					"id": 700100503,
					"content": "Oh, das ... Ich habe den Aushang gesehen, aber für mich ist das nichts. Ich kann Mondstadt mit meinen Liedern beschützen, dafür muss ich kein Abenteurer werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100504
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100504,
					"content": "Die meisten Aufträge sollen skurriler Natur sein. Zu mir passt das nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100505
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100505,
					"content": "Tut mir leid, aber ich muss höflich ablehnen. Danke fürs Angebot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100506
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100506,
					"content": "Hier ist etwas Anschauungsmaterial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100507
					]
				},
				{
					"id": 700100507,
					"content": "Wie? Sieht aus wie der Drachengrat. Eine Statue der Sieben von Schnee umgeben ... ein beeindruckendes Motiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100508
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100508,
					"content": "Das ist recht hochgelegen, oder? Man sagt, von da oben reiche der Blick meilenweit ... Meine Stimme wäre sehr weit zu hören ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100509
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100509,
					"content": "Ich werde mich nachher bei der Gilde erkundigen. Ich glaube, man kann dort Abenteurer anheuern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100510
					],
					"speakerTitle": "Helen"
				},
				{
					"id": 700100510,
					"content": "Ich hatte keine Ahnung, dass man als Abenteurer solche Orte besucht ... faszinierend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Helen"
				}
			]
		},
		{
			"id": 7001006,
			"completionStepIds": [
				7001015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
