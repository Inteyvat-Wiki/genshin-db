			"dialogs": [
				{
					"id": 700100701,
					"content": "Wegen der Mission ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100702
					]
				},
				{
					"id": 700100702,
					"content": "Du bist zurück! Warum hat das so lange gedauert? Bestimmt hat Cyrus dich mit Aufgaben aufgehalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100703
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100703,
					"content": "Ich half ihm bei einigen Erkundigungen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100704
					]
				},
				{
					"id": 700100704,
					"content": "Was hat der Junge nun wieder vor ... Oh? Ein Brief?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100705
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100705,
					"content": "Dieser Brief erzählt vom aktuellen Stand der Gilde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700100706
					]
				},
				{
					"id": 700100706,
					"content": "Hmm, umfangreiche Lektüre. Er war wohl doch fleißig, trotz des Windblumenfests ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100707
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100707,
					"content": "Aber wenn er so hart arbeitet, wird es Zeit, dass die Abenteurergilde von Mondstadt einige neue Rekruten erhält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100708
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100708,
					"content": "Sobald es genug Rekruten gibt, sollte er die kleineren Missionen verteilen können, um wieder Abenteuer mit mir zu erleben *seufz* ... Das wäre schön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100709
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100709,
					"content": "Ich werde das aufmerksam lesen. Aber da Cyrus dich auf Trab hielt, sollte ich es nicht versäumen, dich zusätzlich zu entlohnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700100710
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 700100710,
					"content": "Hier, bitte. Danke für deine harte Arbeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
