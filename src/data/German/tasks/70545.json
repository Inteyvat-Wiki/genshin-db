			},
			"dialogs": [
				{
					"id": 705450101,
					"content": "Miau! Miau miau ... miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450102,
					"content": "Miau! Miau miau miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450103
					],
					"speakerTitle": "„Häschen“"
				},
				{
					"id": 705450103,
					"content": "Oh ... Sowohl Häschen als auch Amber haben recht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450104,
					"content": "Oh, so ist das also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450105,
						705450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450105,
					"content": "Aber echt! So ist es ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				},
				{
					"id": 705450107,
					"content": "Eigentlich hat Paimon es auch nicht ganz verstanden. Aber es ist offensichtlich, dass Häschen und Amber sich einig geworden sind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450108,
					"content": "#{NICKNAME}, Paimon! Da seid ihr ja! Ich wollte euch gerade suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450109,
					"content": "Ich habe schon von Fräulein Valerina gehört, dass ihr im Flauschigen Katzenschloss aushelft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450110,
					"content": "#Das passt wirklich zu dir, {NICKNAME}, gerade zurück in Mondstadt angekommen seid ihr schon so eine große Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450111,
						705450112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450111,
					"content": "#Schließlich bin ich Ehrenritter{F#in} und kümmere mich um alles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450113,
					"content": "Apropos, wovon haben Amber und Häschen gerade gesprochen? Ihr scheint euch köstlich amüsiert zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450114,
					"content": "Miau, miau miau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450115
					],
					"speakerTitle": "„Häschen“"
				},
				{
					"id": 705450115,
					"content": "Hm ... Ich fragte Häschen gerade, wie heute das Wetter wird und ob es regnen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450116,
					"content": "Äh? Wissen Kätzchen solche Dinge?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450117,
					"content": "Hehe, Fräulein Lisa sagte etwas in der Art.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450118
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450118,
					"content": "Einem Buch zufolge, das Fräulein Lisa gelesen hat, reagieren Kätzchen sehr empfindlich auf feuchtes Wetter, außerdem mögen sie es überhaupt nicht, nass zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450119
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450119,
					"content": "Wenn sie also eine plötzliche Erhöhung der Luftfeuchtigkeit spüren, werden sie unruhig und fangen an, sich das Gesicht zu putzen und ihr Fell zu lecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450120,
					"content": "Sobald ein Kätzchen dieses Verhalten zeigt, ist davon auszugehen, dass ein Gewitter bevorsteht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450121,
					"content": "Paimon wusste nichts von dieser geheimnisvollen Sache ... Wie durch Zufall wieder etwas Besonderes gelernt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450122,
					"content": "#{NICKNAME}, in Zukunft sollten wir auf unseren Reisen die Katzen im Auge behalten. Dann werden wir nicht immer von diesen dunklen Wolken überrascht und durchnässt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450123,
						705450124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450123,
					"content": "Wir sollten künftig wirklich mehr darauf achten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450125,
					"content": "Eigentlich bin ich heute hier, um Valerina etwas zu fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450126,
					"content": "Und als wir gerade miteinander redeten, schleicht dieses Kätzchen heran, legt sich neben mich auf den Bauch und gähnt herzhaft! Wie niedlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450127
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450127,
					"content": "Wenn sie sich zu mir so zutraulich verhält, dann ... dann sollte ich auch freundlich zu ihr sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450128,
					"content": "Dann fiel mir wieder ein, was Fräulein Lisa mir erzählte, also fragte ich nebenbei Häschen nach dem Wetter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450129,
					"content": "Dann putzte Häschen ihr Gesicht, wackelte erst mit dem Schwanz und kuschelte sich an meine Hand ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450130
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450130,
					"content": "Hmm, also wird es nun in den kommenden Tagen regnen oder nicht ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450124,
					"content": "Ich habe schon immer auf Katzen am Wegesrand geachtet!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450112,
					"content": "Die Behütung der Kätzchen von Mondstadt ist eine meiner vielen Verpflichtungen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450106,
					"content": "Langsam, ich verstehe nicht!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				}
			]
		}
	]
}