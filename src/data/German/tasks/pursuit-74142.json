				]
			},
			"dialogs": [
				{
					"id": 741421301,
					"content": "#*schluchz* ... Danke, {F#Frau}{M#Herr} {NICKNAME} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421302,
					"content": "Was ist denn los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421303
					]
				},
				{
					"id": 741421303,
					"content": "Ich weiß es nicht ... Ich bin nur gekommen, um die Sonnenblumen und das niedliche Hündchen zu sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421304,
					"content": "Aber unterwegs ist plötzlich ein Monster aufgetaucht und hat mich verfolgt. Dabei ist der Himmel immer dunkler geworden ... Außerdem habe ich viele unterschiedliche Stimmen gehört, die über Dinge gesprochen haben, die ich nicht verstanden habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421305
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421305,
					"content": "Ich hatte furchtbare Angst, also bin ich dem goldenen Licht gefolgt und bin vorwärts gerannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421306
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421306,
					"content": "Immer, wenn sich das Monster näherte, verfinsterte sich die Welt ein Stück ... Der Garten, der Palast, die großen Bäume und die Blumen sind alle verschwunden. Es war so dunkel, und konnte nur noch Ruinen erkennen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421307
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421307,
					"content": "Dann hat mich das Monster erwischt ... *schluchz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421308
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421308,
					"content": "Du brauchst jetzt keine Angst mehr zu haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421309
					]
				},
				{
					"id": 741421309,
					"content": "„Hündchen“, bring sie bitte zurück.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421310
					]
				},
				{
					"id": 741421310,
					"content": "Fräulein, lass dich hier nicht mehr blicken. Hier gibt es nichts, aber da draußen steht dir eine ganze Welt offen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421311
					]
				},
				{
					"id": 741421311,
					"content": "Hä? Bist du das Hündchen? Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421312
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421312,
					"content": "... Werden wir uns überhaupt wiedersehen? Wird diese Welt wieder ein schöner Garten werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421313
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421313,
					"content": "Wohl nicht. Auf Wiedersehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421314
					]
				},
				{
					"id": 741421314,
					"content": "Und du, ich frage dich noch einmal. In was für einer Gestalt siehst du mich eigentlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421315
					]
				},
				{
					"id": 741421315,
					"content": "Hund.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421316
					]
				},
				{
					"id": 741421316,
					"content": "Dann ist ja gut. Du hast die Person, die niemals hätte herkommen sollen, vertrieben. Dank dir wurde der Zusammenbruch dieser Welt aufgehalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421317
					]
				},
				{
					"id": 741421317,
					"content": "Aber hierzubleiben wäre unklug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421318,
						741421320
					]
				},
				{
					"id": 741421318,
					"content": "Das denke ich auch. Bitte schick mich zurück.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421319
					]
				},
				{
					"id": 741421319,
					"content": "Du bist sehr weise. Lebe wohl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741421320,
					"content": "Was geht hier eigentlich vor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421321
					]
				},
				{
					"id": 741421321,
					"content": "Diese Welt stand kurz vor dem kompletten Zusammenbruch. Eine Person, die niemals hätte herkommen dürfen, hat das Fundament dieser Welt erschüttert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421322
					]
				},
				{
					"id": 741421322,
					"content": "Hat das die Phänomene, die ich gesehen habe, hervorgerufen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421323
					]
				},
				{
					"id": 741421323,
					"content": "Ich kann nicht wissen, was du erlebt hast. Schließlich bin ich nicht du.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421324
					]
				},
				{
					"id": 741421324,
					"content": "Und wer bist du dann?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421325
					]
				},
				{
					"id": 741421325,
					"content": "... Wer ich bin, ist unwichtig. Wichtig sind die Meister dieser Scheinwelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421326
					]
				},
				{
					"id": 741421326,
					"content": "Sie glaubten, sie können die Welt retten, doch sie wissen gar nicht, ob die Welt gerettet werden muss. Möglicherweise ist die Welt aus ihren Erinnerungen nur der längst verlorene Nachmittag, der die Sonnenblumen erblühen ließ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421327
					]
				},
				{
					"id": 741421327,
					"content": "Aber das ist ihre Geschichte, nicht meine. Ich bin nur die Erinnerung an einen ihrer Freunde. Sie hatten geglaubt, sie könnten mich retten, aber schlussendlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421328
					]
				},
				{
					"id": 741421328,
					"content": "Der Schmetterling wird zum Kokon, der Kokon zerbricht und eine Larve entsteigt. Diese geht schließlich in ein Nichts, in dem sie nie geboren wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421329
					]
				},
				{
					"id": 741421329,
					"content": "Aber das ist schon alles nicht mehr wichtig, denn von mir ist inzwischen nichts mehr geblieben. Ich bin nur der Schatten in ihrer Erinnerung, der aus ihrer Entschlossenheit, mich zu „retten“, bewahrt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421330
					]
				},
				{
					"id": 741421330,
					"content": "Aber ich kann ihnen das auch nicht verübeln. Denn selbst wenn sie sich durch den Verzicht verändert haben, bin ich inmitten dieser Welt aus Erinnerungen und Wunschträumen der Beweis für ihrer Entschlossenheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421331
					]
				},
				{
					"id": 741421331,
					"content": "Mir reicht es, ihr einstiger Freund zu sein. Egal, welche Gestalt ich annehme, ich werde mich immer an unsere einstige Freundschaft erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421332
					]
				},
				{
					"id": 741421332,
					"content": "Also gut, genug geredet. Du kannst ebenfalls den Einfluss, den dieser Ort auf dich hat, spüren, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421333
					]
				},
				{
					"id": 741421333,
					"content": "Lebe wohl. Wir werden uns nicht wiedersehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				}
			]
		},
		{
