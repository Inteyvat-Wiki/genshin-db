						],
						"pointId": 6840
					}
				]
			},
			"dialogs": [
				{
					"id": 741421401,
					"content": "Wah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421402,
					"content": "Paimon, ich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421403
					]
				},
				{
					"id": 741421403,
					"content": "Das ging aber wieder schnell! Paimon hatte nicht einmal die Zeit, zu blinzeln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421404,
					"content": "... Da bin ich erleichtert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421405
					]
				},
				{
					"id": 741421405,
					"content": "#Sehr gut! Unsere kleine Unruhestifterin ist auch zurück! Canotila, du hast {NICKNAME} wirklich große Sorgen bereitet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421406,
					"content": "Ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421407
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421407,
					"content": "*schluchz* Es tut mir leid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421408
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421408,
					"content": "Wie? Ah ... Paimon gibt dir doch nicht die Schuld! Weine doch nicht, Canotila. Paimon gibt dir etwas Leckeres zu essen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421409,
					"content": "(Was ist passiert?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421410,
					"content": "(Wir sind drinnen auf einige Gefahren gestoßen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421411
					]
				},
				{
					"id": 741421411,
					"content": "(Oh ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421412,
					"content": "Weine doch nicht, Canotila. Du bist so tapfer! Komm, Canotila, das ist Paimons liebster Spieß mit Pilzen und Hühnchen. Er gehört ganz allein dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421413,
					"content": "*schluchz* ... Danke, Paimon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421414
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421414,
					"content": "*kau*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421415
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421415,
					"content": "Ui, was für ein seltsamer Geschmack! So etwas essen also die Menschen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421416
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421416,
					"content": "He! Wenn du es nicht essen willst, dann gib es Paimon zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421417,
					"content": "#Aber ... Danke, Paimon. Und danke, {F#Frau}{M#Herr} {NICKNAME}, dass du mich gerettet hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421418
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421418,
					"content": "Was hast du jetzt als Nächstes vor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421419
					]
				},
				{
					"id": 741421419,
					"content": "Ich weiß es nicht, aber ich möchte keine weiteren Bücher mehr lesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421420
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421420,
					"content": "... Canotila, ist das nicht etwas übertrieben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421421,
					"content": "Hm, aber das „Buch der Aufdeckung“ ist wirklich zum Fürchten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421422
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421422,
					"content": "(Was ist denn nun passiert?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421423,
					"content": "(Das ist sehr schwer zu erklären ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421424,
						741421425
					]
				},
				{
					"id": 741421424,
					"content": "(Das verstehst du nur, wenn du selbst dort warst.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421426
					]
				},
				{
					"id": 741421426,
					"content": "(Was? Das macht Paimon aber wütend ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421427,
					"content": "... Jedenfalls möchte ich nicht mehr hierbleiben. Ich will mit allen zusammen in Mérusea leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421428
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421428,
					"content": "Richtig so! Die anderen Melusinen werden sich gut um dich kümmern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421429,
					"content": "#Schön. Ich danke euch, {F#Frau}{M#Herr} {NICKNAME} und Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421425,
					"content": "(Gut, dass du nicht dabei warst.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421426
					]
				}
			]
		},
