							4764.004
						],
						"pointId": 6836
					}
				]
			},
			"dialogs": [
				{
					"id": 741420401,
					"content": "#Oh, {F#Frau}{M#Herr} {NICKNAME} ... Sind wir uns nicht gerade erst begegnet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420402
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420402,
					"content": "Wann war das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420403
					]
				},
				{
					"id": 741420403,
					"content": "Hm, das weiß ich auch nicht genau ... Schließlich kennt ein solcher Ort keine Zeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420404
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420404,
					"content": "Canotila, folge mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420405
					]
				},
				{
					"id": 741420405,
					"content": "Dieser Ort ist wirklich surreal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420406
					]
				},
				{
					"id": 741420406,
					"content": "Ob real oder surreal, liegt das nicht in unserem eigenen Ermessen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420407
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420407,
					"content": "Hm ... Ich will gar nichts weiter damit sagen, nur dass ich es hier wirklich großartig finde. Hier sprüht es vor Leben und Farben, auf der anderen Seite habe ich so etwas noch nie gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420408
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420408,
					"content": "Ich habe nur eine Sonnenblume gesehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420409
					]
				},
				{
					"id": 741420409,
					"content": "Wirklich? Ui! Wo denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420410
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420410,
					"content": "Dort, wo wir dem Hündchen begegnet sind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420411
					]
				},
				{
					"id": 741420411,
					"content": "Juhu! Dann mache ich mich gleich auf den Weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420412
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420412,
					"content": "Warte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
