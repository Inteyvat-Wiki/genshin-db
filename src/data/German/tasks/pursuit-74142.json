				]
			},
			"dialogs": [
				{
					"id": 741420701,
					"content": "#Oh! {F#Frau}{M#Herr} {NICKNAME}, du bist es. Ist Paimon nicht bei dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420702
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420702,
					"content": "Dieser Riss ... Wonach hältst du Ausschau?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420703
					]
				},
				{
					"id": 741420703,
					"content": "Hä? Was für ein Riss? Ist das nicht ein Spiegel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420704
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420704,
					"content": "Hm. Es gibt tatsächlich etwas, wonach ich suche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420705
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420705,
					"content": "Ich suche nach Hinweisen zu dem Mysterienspiegel ... Er sollte so etwas wie ein Bild sein. Durch ihn kann man „meditieren“, wie durch das „Buch der Aufdeckung“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420706
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420706,
					"content": "Über die vier Orthanten und das Bild im Turm der Gestalt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420707
					]
				},
				{
					"id": 741420707,
					"content": "#... Wirklich? Sie sind tatsächlich an so einem Ort? Verstehe! Danke, {F#Frau}{M#Herr} {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
