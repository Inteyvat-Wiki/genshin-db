					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421505
					]
				},
				{
					"id": 741421505,
					"content": "Äh ... Na gut! Es handelt sich ja nur um einen Wimpernschlag. Paimon macht sich überhaupt keine Sorgen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421506,
					"content": "#Du musst aber trotzdem auf dich aufpassen, {NICKNAME}.",
