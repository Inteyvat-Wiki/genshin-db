			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zakariya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180201,
					"content": "Dies ist die Medizin für Gurgen beim Heilkräuterfeld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180202
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180202,
					"content": "Er hat zu hart gearbeitet und seinen Arm überstrapaziert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180203
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180203,
					"content": "Bringe ihm diese Medizin und sage ihm, dass er heute zu Hause bleiben und still zur Göttin der Pflanzen beten soll. Die Arbeit auf dem Feld kann warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180204,
						230180205
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180204,
					"content": "Klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180207
					]
				},
				{
					"id": 230180207,
					"content": "Komme wieder zu mir, wenn du die Medizin abgeliefert hast. Ich kümmere mich um deine Bezahlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180205,
					"content": "Still zur Göttin der Pflanzen beten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180206
					]
				},
				{
					"id": 230180206,
					"content": "Wie soll er meinem Rat folgen, wenn ich das nicht sage? Mach bitte, was ich dir gesagt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180207
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
		{
			"id": 2301803,
			"completionStepIds": [
				2301803
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301803",
							"2"
						],
						"stepId": 2301803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gurgen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180301,
					"content": "Hä, das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180302
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230180302,
					"content": "Das ist deine Medizin. Denke daran, zu Hause ein stilles Gebet an die Göttin der Pflanzen zu senden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180303
					]
				},
				{
					"id": 230180303,
					"content": "Oh, danke. Ich bete still zur Göttin der Pflanzen ... Da ist Bitternis nötig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180304
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230180304,
