			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zakariya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180101,
					"content": "*seufz* Wie frustrierend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180102,
						230180103
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180102,
					"content": "Kann ich irgendwie behilflich sein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180119
					]
				},
				{
					"id": 230180119,
					"content": "In letzter Zeit sind wir unterbesetzt und ich habe seit Tagen kein Auge zugetan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180120
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180120,
					"content": "#{F#Reisende}{M#Reisender}, wenn du Zeit hast, kannst du Medizin an die Patienten ausliefern? Bitte sieh bei ihnen auch nach dem Rechten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180121,
						230180124
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180121,
					"content": "Überlasse es mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180122
					]
				},
				{
					"id": 230180122,
					"content": "Ich zähle auf dich. Im Namen der Göttin der Pflanzen brauche ich jede Hilfe, die ich bekommen kann, solange ich nicht mit dem Segen der Göttin der Pflanzen vollgequasselt werde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180123
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180123,
					"content": "Ha, im Namen der Göttin der Pflanzen ... Das sage ich ganz schön häufig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180124,
					"content": "Ruh dich am besten aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180125
					]
				},
				{
					"id": 230180125,
					"content": "Ich kann nicht. Ich habe schwerkranke Patienten anderweitig, für die ich Medizin zusammenstellen muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180126
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180126,
					"content": "Hach, sie werden mich bestimmt fragen, wie sie den Segen der Göttin der Pflanzen empfangen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180127
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180127,
					"content": "#Ich zähle auf dich, {F#Reisende}{M#Reisender}. Ich brauche wirklich einen Helfer, der mich nicht den ganzen Tag mit dem Segen der Göttin der Pflanzen vollquasselt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180103,
					"content": "Was ist hier passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180104
					]
				},
				{
					"id": 230180104,
					"content": "#Du bist bestimmt {F#eine Reisende}{M#ein Reisender}. Willkommen im „Bimarstan“, einem Krankenhaus, das ... ähm ... den Segen der Göttin der Pflanzen an die Massen verbreitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180105
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180105,
					"content": "Egal ob arm oder reich, alle Menschen erhalten hier medizinische Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180106
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180106,
					"content": "Aber gerade deshalb ... sind wir mit Patienten überfüllt und sind unterbesetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180107
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180107,
					"content": "Ach, so gnädig die Göttin der Pflanzen uns gegenüber auch sein mag ... kommen das Budget und Personal des Krankenhauses an ihre Grenzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180108
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180108,
					"content": "Manche Patienten missachten ärztliche Anordnungen und fragen mir stattdessen Löcher in den Bauch, wie sie den Segen der Göttin der Pflanzen besser in Empfang nehmen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180109
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180109,
					"content": "Haha, der Segen der Göttin der Pflanzen ... Um Himmels Willen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180110
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180110,
					"content": "Könnte die Göttin der Pflanzen tatsächlich ihren Segen direkt vom Himmel herunterprasseln lassen, wären sie gar nicht einmal krank geworden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180111
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180111,
					"content": "... Ups, tut mir leid. Ich hätte das nicht sagen sollen. Bitte erzähle Golshan nicht davon, sonst nörgelt sie schon wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180112,
						230180115
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180112,
					"content": "Bist du etwa kein demütiger Jünger der Göttin der Pflanzen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180113
					]
				},
				{
					"id": 230180113,
					"content": "Bin ich. Aber wer ist es schon nicht in Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180114
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180114,
					"content": "Du kannst das Wort „demütig“ auswechseln. Ich bin eher ein ... vernünftiger Jünger der Göttin der Pflanzen, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180118,
					"content": "Ähm ... Tut mir leid, ich bin erschöpft. Da musste ich meinem Frust Luft machen. Mach dir nichts draus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180119
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180115,
					"content": "Manche sagen, dass die Behandlung selbst ein Segen der Göttin der Pflanzen sei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180116
					]
				},
				{
					"id": 230180116,
					"content": "Hach, Geschichten bleiben Geschichten. Lass dich nicht für dumm verkaufen, wie die Patienten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180117
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180117,
					"content": "Wäre die Göttin der Pflanzen wirklich so allmächtig, bräuchte ich meinen Patienten nur etwas Pilze zu geben, um sie zu heilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
		{
			"id": 2301802,
			"completionStepIds": [
				2301802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
