			},
			"dialogs": [
				{
					"id": 230181801,
					"content": "Was ist das? Nein ... Der Geruch ist viel zu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181802
					],
					"speakerTitle": "Aftab"
				},
				{
					"id": 230181802,
					"content": "Also, Folgendes ist geschehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181803
					]
				},
				{
					"id": 230181803,
					"content": "Wirklich? Ich kann auch bei einer leichten Ernährung Fleisch essen? Die Gelehrten in der Akademie machen es auch so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181804
					],
					"speakerTitle": "Aftab"
				},
				{
					"id": 230181804,
					"content": "So ... So ist das also! Dann muss ich mir also keine Gedanken machen, dass ich den Zorn der Göttin der Pflanzen errege, wenn ich Fleisch esse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181805
					],
					"speakerTitle": "Aftab"
				},
				{
					"id": 230181805,
					"content": "Wenn die Gelehrten das so machen ... dann kann auch ich unbeschwert mein Fleisch genießen. Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aftab"
				}
			]
		},
