			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413590201,
					"content": "Wie lief die Schatzsuche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590202
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590202,
					"content": "Hab alle gefunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590203
					]
				},
				{
					"id": 413590203,
					"content": "Oha, du hast alle drei Bilder entschlüsselt ... Beeindruckend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590204
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590204,
					"content": "Ähem. Da du als Abenteurer solche Leistungen vollbracht hast, hat die Gilde ein besonderes Geschenk für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590205
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590205,
					"content": "Siehst du diese Truhen. Öffne sie. Der Inhalt gehört dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590206
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590206,
					"content": "Jetzt habe ich alles ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590207
					]
				},
				{
					"id": 413590207,
					"content": "Jupp, für die anderen bleibt nichts übrig. Der Lohn des Abenteuers für dich! Wer’s findet, darf’s behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590208
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590208,
					"content": "Also gut, hab noch ein frohes Laternenritual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
