			"dialogs": [
				{
					"id": 413590301,
					"content": "Oha, du, äh, hast es geschafft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590302
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590302,
					"content": "Das war kein Problem für dich, was? Zugegeben, auf Abenteuer verstehst du dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590303
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590303,
					"content": "Sieh dir diese Schirme an. Sie enthalten alle Hinweise auf den Schatz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
