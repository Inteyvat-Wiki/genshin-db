					"Qian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413590101,
					"content": "Probiere den Leuchtschirm aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590102
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590102,
					"content": "Hast du noch ein Bild für mich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413590103
					]
				},
				{
					"id": 413590103,
					"content": "Aber sicher! Und da du die vorigen so schnell gelöst hast, warten jetzt die schwierigsten Laternen auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590104
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590104,
					"content": "Es gilt das gleiche Prinzip: Kombiniere alle drei Bilder zu einem ganzen. Der Kniff liegt darin, dass sie diesmal <color=#00E1FFFF>miteinander verbunden</color> sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590105
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590105,
					"content": "Hehe, du wirst es schon sehen, wenn du es ausprobierst. Diesmal handelt es sich um einen <color=#00E1FFFF>göttlichen Kranich</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413590106
					],
					"speakerTitle": "Qian"
				},
				{
					"id": 413590106,
					"content": "Sobald die Bilder ein Ganzes ergeben, kannst du dich auf die Schatzsuche begeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian"
				}
			]
		},
		{
			"id": 4135902,
