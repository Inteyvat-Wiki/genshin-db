			"trigger": {
				"objectNames": [
					"Masseira"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820101,
					"content": "Ah, du bist da! Warte bitte ein Moment. Ich fürchte, das ist das letzte Mal, dass ich dich um einen Gefallen bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820102,
						732820104
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820102,
					"content": "Womit brauchst du dann Hilfe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820103
					]
				},
				{
					"id": 732820103,
					"content": "Tadhla möchte mit dir reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820106,
					"content": "Hm? Was ist los, warum so förmlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820107,
					"content": "Bei den Ruinen im Norden, in der Nähe des Orts, an dem ihr euch zum ersten Mal begegnet seid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820108,
						732820110
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820108,
					"content": "Was meinst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820109
					]
				},
				{
					"id": 732820109,
					"content": "Bei den Ruinen im Norden, in der Nähe des Orts, an dem ihr euch zum ersten Mal begegnet seid ... Vergiss das nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820110,
					"content": "Ich verstehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820111
					]
				},
				{
					"id": 732820111,
					"content": "Ja, bitte sei gut zu ihr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732820104,
					"content": "Ich habe noch andere Dinge zu erledigen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820105
					]
				},
				{
					"id": 732820105,
					"content": "Hör mir bitte zu ... Tadhla möchte mit dir reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820106
					],
					"speakerTitle": "Masseira"
				}
			]
		},
		{
			"id": 7328202,
