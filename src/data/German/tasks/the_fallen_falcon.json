		},
		{
			"id": 7328204,
			"completionStepIds": [
				7328204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328204",
							"2"
						],
						"stepId": 7328204,
						"stateName": "QUEST_STATE_UNFINISHED"
