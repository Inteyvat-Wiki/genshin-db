				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadhla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820401,
					"content": "Du bist wirklich gekommen, das freut mich sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820402,
						732820403
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820402,
					"content": "Ich habe gehört, du suchst nach mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				},
				{
					"id": 732820404,
					"content": "Mir gefällt die Wüste in dieser Zeit sehr, sie ist wirklich schön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820405
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820405,
					"content": "Aber leider ... Hatte ich nie die Gelegenheit hier zusammen mit Freunden den allmählichen Sonnenuntergang beobachten zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820406
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820406,
					"content": "Ja, die ganze Wüste wird in rot getaucht ... Es ist wunderschön und so ruhig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820407,
					"content": "Aber hast du uns nur dafür hierhergerufen, Tadhla?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820409
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820409,
					"content": "#Für Tanit bist du ein Gast, für einen „Falken“ bist du aber eine potenzielle „Beute“ ... Ich hoffe, dass du {F#diejenige}{M#derjenige} sein wirst, {F#die}{M#der} lebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820410
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820410,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820411
					]
				},
				{
					"id": 732820411,
					"content": "Also, es tut mir leid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820403,
					"content": "Wie geht es dir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				}
			]
		},
		{
			"id": 7328206,
			"completionStepIds": [
				7328206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328206",
							"2"
						],
						"stepId": 7328206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820601,
					"content": "Aaargh! Wo steckt Masseira?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820602,
					"content": "Er hat diesen Zettel hier hinterlassen ... Dieser Fuchs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820603
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732820603,
					"content": "Wenn du diese Nachricht liest, sollte ich bereits in meinem Versteck in den Schluchten sein.\\nWenn du den Kopf noch auf den Schultern trägst, weine nicht über Tadhlas Entscheidung.\\n\\nDie Jagd ist noch nicht beendet. Es ist erst der Anfang des Sturms.\\nIch, Masseira, ein Jäger und ein Ältester von Tanit, warne dich hiermit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820604
					],
					"speakerTitle": "Untersuchen"
				},
				{
					"id": 732820604,
					"content": "Was meint er mit all dem? Paimon begreift es nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820605,
					"content": "Es scheint, dass er unter einem gewissen Druck aus dem Stamm geflohen ist und diese Nachricht für dich hinterlassen hat. Pah, Tanit ist wirklich nicht so friedlich, wie es scheint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				}
			]
		},
		{
			"id": 7328228,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328207",
							"2"
						],
						"stepId": 7328207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadhla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822801,
					"content": "(Tadhla vermeidet den Blickkontakt und senkt nervös den Kopf.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822802,
						732822805
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822802,
					"content": "Ist alles in Ordnung mit dir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822803
					]
				},
				{
					"id": 732822803,
					"content": "Tut mir leid, die Jagd ist beendet. Ich bin der „Jagdfalke“ von meinem Vater.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822804
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822804,
					"content": "Aber es geht mir gut. Mach dir keine Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822808,
					"content": "Ganz extrem ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822809
					]
				},
				{
					"id": 732822809,
					"content": "Extrem? Ich habe keine Ahnung. Ich habe schon immer so gelebt, seit ich ein Kind war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822814,
					"content": "Ah ... Aber die Geschichten von dir und Paimon, und die Abenteuer von euch beiden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822815
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822815,
					"content": "Wenn es möglich ist, würde ich gerne mehr davon hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822816
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822816,
					"content": "Kein Problem! Wir haben jede Menge Geschichten zu erzählen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822817,
						732822818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732822817,
					"content": "Ja, ich erzähle dir alle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822819,
					"content": "Pff ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822820
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822820,
					"content": "*hust* Nichts. Ich bin einfach sehr froh. Danke ... Ähem ... Ich danke dir von ganzem Herzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822818,
					"content": "Ich erzähle sie dir, wann immer du willst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822810,
					"content": "Hast du noch nie darüber nachgedacht, für dich selbst zu leben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822811
					]
				},
				{
					"id": 732822811,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822812
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822812,
					"content": "... Nein, niemals. Ich hatte nie solche Gedanken oder Erwartungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822813
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822813,
					"content": "Die Wüste ist ein brutaler Ort, also habe ich keine Zeit, an mein eigenes Wohl zu denken. Ohne mich lebt mein Stamm genauso weiter wie bisher. Aber ohne meinen Stamm werde ich auf keinen Fall überleben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822805,
					"content": "Über deine Beziehung zu Masseira ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822806
					]
				},
				{
					"id": 732822806,
					"content": "Wie gesagt, er ist mein Vater, und ich bin sein „Jagdfalke“. Ich befolge seine Befehle. Ich jage und riskiere mein Leben für ihn ... weil er den Willen Tanits symbolisiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822807
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822807,
					"content": "Wenn der Tag kommt, an dem ich die Befehle meines Vaters nicht mehr vollständig ausführen kann, wird mein Leben als „Jagdfalke“ enden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "Tadhla"
				}
			]
		},
		{
			"id": 7328229,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7328207",
							"2"
						],
						"stepId": 7328207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Masseira"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822901,
					"content": "#Ah, da bist du ja, {M#verehrter Herr}{F#verehrte Herrin} des Dschinn! Was kann ich für dich tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822902,
						732822906
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732822902,
					"content": "Über Tadhla ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822903
					]
				},
				{
					"id": 732822903,
					"content": "Sie mag dich sehr. Das habe ich gemerkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822904
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732822904,
					"content": "Keine Sorge, es macht mir nichts aus. Ihr seid noch sehr jung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822905
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732822905,
