					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580552,
					"content": "Urteile nicht nach deinen eigenen Maßstäben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580553
					]
				},
				{
					"id": 710580537,
					"content": "#Wie du vielleicht schon gehört hast, bin ich {NICKNAME}.",
