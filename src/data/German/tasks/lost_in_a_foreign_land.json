					"nextDialogs": [
						710580548
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580548,
					"content": "He! Wir haben noch nichts gegessen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580549
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580549,
					"content": "Raus mit euch! Ihr mögt doch mein Feuerwasser nicht!",
