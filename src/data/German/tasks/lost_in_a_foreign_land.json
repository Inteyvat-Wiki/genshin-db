			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580101,
					"content": "Ähm ... puh ... Wartet, hört bitte erst mal auf ... Wer bist du? Warum bist du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580102,
					"content": "Und ... warum hast du mich angegriffen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580103
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580103,
					"content": "Das sind unsere Fragen! Wir haben dich herumschleichen sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580104,
					"content": "Du bist der Bösewicht, also solltest du dich zuerst erklären.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580105
					]
				},
				{
					"id": 710580105,
					"content": "... Katarina, Katarina Snezhevna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580106
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580106,
					"content": "Namen sind die Informationen, die am wenigsten geheim gehalten werden müssen, also ist das alles, was ich preisgeben kann, tut mir leid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580107
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580107,
					"content": "Nun ... Wir wollten nur einige Informationen, wir wollten dich nicht ausfragen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580108,
					"content": "Tut, tut mir leid, das ist alles, was ich euch sagen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580109
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580109,
					"content": "Warum sind Fatui hier aktiv?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580110
					]
				},
				{
					"id": 710580110,
					"content": "Das ist ein Geheimnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580111
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580111,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580112
					]
				},
				{
					"id": 710580112,
					"content": "Was soll’s! Ihr geheimnisvollen Bösewichte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580113,
					"content": "Oh ja, wir sind solche Bösewichte, oh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580114
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580114,
					"content": "Gut, die Zeit der Neugier ist vorbei ... Wir haben ein Problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105802,
			"completionStepIds": [
				7105804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105804",
							"2"
						],
						"stepId": 7105804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580201,
					"content": "Danke ... Wie auch immer, ich bin froh, dass du die Gelegenheit nicht genutzt hast, mir in den Rücken zu fallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580202,
						710580203
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580202,
					"content": "Das sind meine Zeilen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				},
				{
					"id": 710580204,
					"content": "Pfft ... Ich weiß nicht, welche Vorurteile du über die Fatui hast, aber es ist nichts Romantisches daran, an einem Ort wie diesem ein Gespräch zu beginnen ... Wenn du etwas zu sagen hast, komm bitte zu meinem Versteck für ein Gespräch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580207
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580207,
					"content": "Katarina verschwindet.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710580205
					]
				},
				{
					"id": 710580205,
					"content": "Was? Sie ist von den Fatui. Sollen wir sie einfach gehen lassen? Sollten wir sie nicht an die Millelithen ausliefern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580206,
					"content": "Hmm, Paimon weiß schon, vergiss es, sie hat uns nichts getan. Verschonen wir mal ihr Leben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580203,
					"content": "Sind alle Fatui so misstrauisch gegenüber anderen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				}
			]
		},
		{
			"id": 7105805,
			"completionStepIds": [
				7105806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105806",
							"2"
						],
						"stepId": 7105806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580501,
					"content": "Ihr seid wirklich hier, also nehmt bitte Platz und ruht euch aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580502
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580502,
					"content": "Ich habe noch etwas ... ähm ... schwarzen Tee hier, aber ohne ... Zucker, auch keine ... ähm ... Milch, *bäh* ... sie ist sauer, ich werfe sie später einfach weg ... Es tut mir so leid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580503
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580503,
					"content": "Aber es gibt immer noch reichlich Feuerwasser ... auch knusprige Kekse für den Tee und ein bisschen saure Marmelade ... genug für eine Teegesellschaft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580504
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580504,
					"content": "Wah ... Trinkt ihr alle Tee mit Feuerwasser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580505,
					"content": "Klar. Ist das komisch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580506,
						710580508
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580506,
					"content": "Äh, lieber nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580507
					]
				},
				{
					"id": 710580507,
					"content": "Wie? Hehe, niemand interessiert sich hier für deinen Alkoholkonsum. Sei nicht so förmlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580510,
						710580511
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580510,
					"content": "Was tust du denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580512
					]
				},
				{
					"id": 710580512,
					"content": "„Wenn man Lebensmittel und Informationen auf die richtige Art und Weise weitergibt, kann man dem Fragesteller den Mund stopfen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580513
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580513,
					"content": "... So steht es in unserer Broschüre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580514
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580514,
					"content": "Aber die Information?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580515
					]
				},
				{
					"id": 710580515,
					"content": "Hm? Das war es gerade eben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580516
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580516,
					"content": "Was? Hast du etwas gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580517,
					"content": "„‚Trainingsbroschüre des Vordringens der Fatui‘, Anhang 4-4, Artikel 32: Wenn man Lebensmittel und Informationen auf die richtige Art und Weise weitergibt, kann man dem Fragesteller den Mund stopfen.“ Klar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580518
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580518,
					"content": "Im Gegenzug für die Rettung meines Lebens habe ich sogar den Inhalt eines vertraulichen Schulungshandbuchs preisgegeben! Na, ist das nicht aufrichtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580519
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580519,
					"content": "Sag uns, wozu das gut sein soll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580520,
					"content": "Oh, ich mache keine Witze mit euch ... Im Ernst, vielen Dank für eure Hilfe und bitte überinterpretiert meine guten Absichten nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580521
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580521,
					"content": "Angesichts all der schlechten Dinge, die du getan hast, ist es schwer zu glauben, dass die Fatui gute Absichten haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580522,
					"content": "Was ist dein Plan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580523
					]
				},
				{
					"id": 710580523,
					"content": "Es überrascht mich nicht, dass Außenstehende die Philosophie der Fatui nicht verstehen können. Aber wenn wir nicht über Ideen und Positionen sprechen, sind wir ganz normale Menschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580524
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580524,
					"content": "... Außerdem ist alles, was wir tun, egal zu welchem Zweck, lediglich eine Vorbereitung auf die letzte Herausforderung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580525
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580525,
					"content": "Letzte Herausforderung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580526
					]
				},
				{
					"id": 710580526,
					"content": "Nun, wir stehen endlich vor einem gemeinsamen Feind und einer langen Nacht, aus der es kein Entrinnen gibt ... Die Bürger von Snezhnaya haben diese Warnung akzeptiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580527
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580527,
					"content": "Um dieser kalten Welt willen ist also jede Träne und jeder Tropfen menschlichen Blutes, der vergossen wird, nicht ohne Bedeutung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580528
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580528,
					"content": "Prost? Hm, na gut, ich werde mich bedienen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580529,
						710580531
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580529,
					"content": "Suchst du Entschuldigungen für ihre böse Taten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580530
					]
				},
				{
					"id": 710580530,
					"content": "Vielleicht ... Keine Ahnung, ist mir egal. Du willst eine Erklärung, ich gebe dir einen Grund ... nur ist es meine Version, die dir vielleicht nicht gefällt. So einfach ist das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580534
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580534,
					"content": "Nun ... Warum redet ihr plötzlich so ernsthaft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580535,
					"content": "Übrigens, ich habe mich bereits vorgestellt, aber ich kenne eure Namen noch nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580536,
						710580537
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580536,
					"content": "#{NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580538
					]
				},
				{
					"id": 710580538,
					"content": "Paimon ist Paimon! Du hast sicher schon von Paimon gehört!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580539,
					"content": "Oh! Eure Namen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580540
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580540,
					"content": "Hmpf! Wie sieht es aus? Die müssen sich in ganz Teyvat herumgesprochen haben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580541,
					"content": "Tut mir leid, ich habe noch nie von euren Namen gehört, nicht ein einziges Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580542
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580542,
					"content": "Waaah?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580543
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580543,
					"content": "Nichts für ungut, aber wir wurden vor langer Zeit hier geschickt. Wir wissen fast nichts über die Nachrichten vor Ort, außer dem, was über die Versorgungslinie kommt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580544
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580544,
					"content": "Oh! Heißt das nicht, dass ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580545
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580545,
					"content": "Sind eure Versorgungslinien schon seit längerer Zeit unterbrochen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580546
					]
				},
				{
