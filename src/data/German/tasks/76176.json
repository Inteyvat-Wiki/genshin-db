						],
						"pointId": 344
					}
				]
			},
			"dialogs": [
				{
					"id": 761760301,
					"content": "... Arya, Kanon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760302
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760302,
					"content": "Das ist nicht das erste Mal. Das geht schon ... weit über den Rahmen einer „Bestrafung“ hinaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760303
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760303,
					"content": "Ob es nun die Stadt der Drachen ist, die uns der König anvertraut hat, oder die zerbrechlichen, aber wunderschönen Heimstätten, die diese kleinen Menschen errichtet haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760304
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760304,
					"content": "Wie viele unschuldige Leben müsst ihr noch sterben sehen, bevor ihr nicht mehr tatenlos zuseht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760305
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760305,
					"content": "Wenn doch unser König noch da wäre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760306
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760306,
					"content": "... Er ist es aber nicht, Sonett.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760307
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 761760307,
					"content": "Wenn dieser Herrscher, der alles andere als allmächtig ist, dieses trostlose und schreckliche Schicksal als „Ordnung“ betrachtet, wenn dies die einzige Möglichkeit ist, diese zum Untergang verurteilte Welt vor dem Verschlungenwerden zu bewahren, dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760308
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 761760308,
					"content": "Egal, wie hoch der Preis auch sein mag ... und egal, wie viel Leid mir dieser Preis bereitet, es ist immer noch weitaus besser als pechschwarze Stille.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760309
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 761760309,
					"content": "Wenn die Welt doch zum Untergang verdammt ist ... welchen Sinn hätte es dann noch, gegen die Dunkelheit anzukämpfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760310
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760310,
					"content": "... Sonett?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760311
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 761760311,
					"content": "Ach ... nichts, Arya! Ich hab nichts gesagt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760312
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760312,
					"content": "Ich finde nur, dass wir nicht dabei zusehen sollten, wie dieser Tyrann die Wesen abschlachtet, die uns vertrauen ... Egal, ob es Drachen sind oder diese kleinen Menschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760313
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760313,
					"content": "Sollten wir ... sie nicht retten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760314
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760314,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760315
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 761760315,
					"content": "... Ich kann Sonetts Wut verstehen, Arya. Meiner Meinung nach war das Vorgehen dieses Tyrannen viel zu grausam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760316
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 761760316,
					"content": "Selbst wenn nur eine winzige Chance besteht ... ich möchte alles in meiner Macht Stehende tun, um die Lebewesen zu retten, die gerettet werden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760317
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 761760317,
					"content": "Aber ... was ist mit denen, die nicht gerettet werden können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760318
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760318,
					"content": "Die Menschen, die nicht gerettet wurden, die Leben, die nicht gerettet wurden ... Sollen ihr Blut, ihre Tränen und ihr Wehklagen einfach spurlos verschwinden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760319
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760319,
					"content": "Nein ... Das soll nicht passieren. Ich wünsche mir, dass jeder gerettet wird, dass niemand verloren geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760320
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760320,
					"content": "Solange ihre „Ordnung“ mit ihr stirbt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760321
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760321,
					"content": "... Sonett. Bitte vergiss nicht, warum wir ursprünglich entstanden sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760322
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 761760322,
					"content": "Unsere Mission ist es, diese Welt zu erhalten, bis der König, der uns das Leben schenkte, aus der Ferne zurückkehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760323
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 761760323,
					"content": "Von Anfang an war uns der Preis für diese Ordnung klar ... denn wir konnten nicht zulassen, dass diese Welt in den Untergang treibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760324
					],
					"speakerTitle": "Arya"
				},
				{
					"id": 761760324,
					"content": "... Nein, das hat nicht einmal etwas mit Ordnung zu tun, Arya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760325
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 761760325,
					"content": "Sonett, für uns ... für mich bist du die wichtigste kleine Schwester.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760326
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 761760326,
					"content": "Also ... bitte tu nichts, was Arya und mich verletzen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760327
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 761760327,
					"content": "Stellt euch nicht direkt gegen die Ordnung des Hohen Himmels. Zumindest ... nicht jetzt, wo die Welt noch so zerbrechlich ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760328
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 761760328,
					"content": "Kanon ... ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760329
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760329,
					"content": "Istaroth hat mir mal ein Wort beigebracht, das nur Menschen benutzen ... „Hoffnung“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760330
					],
					"speakerTitle": "Kanon"
				},
				{
					"id": 761760330,
					"content": "Solange es Leben gibt, gibt es auch Hoffnung ... Es wird immer Hoffnung geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kanon"
				}
			]
		}
	]
}