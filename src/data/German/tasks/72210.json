			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Neko“",
					"Paimon",
					"„Hachihou“",
					"„Konbumaru“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722100401,
					"content": "Hast du sie gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100402
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100402,
					"content": "Jap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100403
					]
				},
				{
					"id": 722100403,
					"content": "Ihr! Ihr hört mir niemals zu, oder? Warum könnt ihr zwei nicht so brav wie Meshi sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100404
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100404,
					"content": "Meshi ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100405
					]
				},
				{
					"id": 722100405,
					"content": "Haha, du gibst ihnen wirklich die Namen von guten Dingen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100406,
					"content": "Miau, miau, miau, miau ... miau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100407
					],
					"speakerTitle": "„Hachihou“"
				},
				{
					"id": 722100407,
					"content": "Miau! Miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100408
					],
					"speakerTitle": "„Konbumaru“"
				},
				{
					"id": 722100408,
					"content": "Keine Widerrede! Oder sollte ich nicht gehen und dich finden, dich einfach ... hungern lassen vom Tage bis in die Nacht und wieder bis zum Tage und es dir überlassen, den Weg nach Hause zu finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100409
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100409,
					"content": "Miau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100410
					],
					"speakerTitle": "„Konbumaru“"
				},
				{
					"id": 722100410,
					"content": "Haha, das ist ein braves Kind. Na gut, na gut. Es ist nur gut, dass ihr zurückgekommen seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100411
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100411,
					"content": "Ich schulde euch viel. Ohne eure Hilfe wären diese kleinen Rabauken hungrig in die Welt hinausgegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100412
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100412,
					"content": "Ich denke tatsächlich, sie hätten es alleine zurückgeschafft ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100413
					]
				},
				{
					"id": 722100413,
					"content": "Wie auch immer, mein Dank gehört dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100414
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100414,
					"content": "Wenn du Zeit hast, komm wieder. Ich habe vielleicht andere Angelegenheiten, bei denen du helfen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		},
