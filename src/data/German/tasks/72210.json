			"dialogs": [
				{
					"id": 722100201,
					"content": "Miau, miaumiau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100202
					],
					"speakerTitle": "„Hachihou“"
				},
				{
					"id": 722100202,
					"content": "Oh, das muss also „Hachihou“ sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100203,
						722100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100203,
					"content": "Komm jetzt hierher, sei brav ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100204
					]
				},
				{
					"id": 722100204,
					"content": "Miau miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100207
					],
					"speakerTitle": "„Hachihou“"
				},
				{
					"id": 722100207,
					"content": "Oh, was für eine gehorsame kleine Katze ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100205,
					"content": "Miau, miau ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100206
					]
				},
				{
					"id": 722100206,
					"content": "Miau ... miau miau miau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100207
					],
					"speakerTitle": "„Hachihou“"
				}
			]
		},
		{
