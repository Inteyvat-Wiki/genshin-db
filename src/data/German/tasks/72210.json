				"points": []
			},
			"dialogs": [
				{
					"id": 722100301,
					"content": "Miau! Miau miau, miau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100302
					],
					"speakerTitle": "„Konbumaru“"
				},
				{
					"id": 722100302,
					"content": "Oh! Das ist ja eine stürmische kleine Katze. Sei vorsichtig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100303,
						722100305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100303,
					"content": "Miau, miau ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100304
					]
				},
				{
					"id": 722100304,
					"content": "Miau, miau? Miau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "„Konbumaru“"
				},
				{
					"id": 722100307,
					"content": "Hehe, sie hat sicher stürmisch ausgesehen, aber schließlich lässt sie sich doch einfach von dir herumtragen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100305,
					"content": "Ich bin gekommen, um dich mit nach Hause zu nehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100306
					]
				},
				{
					"id": 722100306,
					"content": "Miau! Miau, miau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "„Konbumaru“"
				}
			]
		},
		{
			"id": 7221004,
