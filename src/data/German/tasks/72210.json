			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"„Neko“",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722100101,
					"content": "Oh, miau, miau ... Wo sind sie hin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100102
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100102,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100103
					]
				},
				{
					"id": 722100103,
					"content": "Ah, du bist es. Einige von diesen kleinen Rabauken sind davongelaufen. Und ich weiß nicht, wohin sie sind. Das ist sehr besorgniserregend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100104
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100104,
					"content": "Draußen ist es sehr gefährlich. Obwohl ich ihnen so viel beigebracht habe, sind diese haarigen Rüpel mit Stöcken und diese Bälle aus Wasser und Feuer trotzdem gefährlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100105
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100105,
					"content": "Und wenn sie auf einen kribbelnden, spritzigen Ort reffen, werden ihnen die Haare zu Berge stehen. Ich möchte keine kleinen Rabauken sehen, die etwas so Fürchterliches erleben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100106
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100106,
					"content": "Aber es gibt immer einige, die nicht zuhören und in der Gegend herumscharwenzeln. Ich muss mich stark anstrengen, um sie nach Hause zu bringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100107
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100107,
					"content": "Einige von ihnen sind heute davongelaufen, was wirklich besorgniserregend ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100108
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100108,
					"content": "Bitte, ich benötige deine Hilfe, um Konbumaru und Hachihou zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100109
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100109,
					"content": "Wer ist Konbumaru ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100110
					]
				},
				{
					"id": 722100110,
					"content": "Ein gutes Kind. Der Konbumaru dieser Generation ist klug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100111
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100111,
					"content": "„Diese Generation“ sagst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100112
					]
				},
				{
					"id": 722100112,
					"content": "Hibiki hat manchmal darüber gesprochen. Ich kann nicht von mir behaupten, es verstanden zu haben, aber wenn sie über Konbumaru sprach, war in ihrem Ausdruck zu sehen, dass es etwas Gutes gewesen sein muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100113
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100113,
					"content": "Ich benenne die Kleinen nach guten Dingen. Und sobald die Kleinen nicht mehr klein sind und gehen, werde ich die gleichen Namen für noch jüngere Katzen verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100114
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100114,
					"content": "Konbumaru liebt es, an hohen Orten zu schlafen. Es wäre also das Beste, wenn ihr dort startet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100115
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100115,
					"content": "Dann ist Hachihou ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100116
					]
				},
				{
					"id": 722100116,
					"content": "Ein sehr agiler kleiner Gefährte. Und auch den Fischen sehr zugeneigt. Daher geht er manchmal zum Strand, um nach Fischen zu suchen, die an die Küste gespült wurden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100117
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100117,
					"content": "Aber es ist sehr gefährlich. Wasser ist am beängstigendsten. Vor einer langen, langen Zeit ist ein gewisser ... Tanuki, nicht wahr? Dieser Kerl ist in das Wasser gefallen und wäre fast nicht zurückgekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100118
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100118,
					"content": "Du kannst vielleicht Hachihou im Salzwasser finden, wenn er nach Fischen oder Krebsen sucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100119
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100119,
					"content": "Das sind zu viele Möglichkeiten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100120
					]
				},
				{
					"id": 722100120,
					"content": "Wirklich? Also, ein sehr hoher Ort und ein Gewässer mit Salzwasser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100121
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100121,
					"content": "Öhm, wie wäre es, wenn wir Neko unsere Karte zeigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100122,
					"content": "Du ... Du hast wirklich ein Verständnisproblem, oder? Das ist der sehr hohe Ort und das ist das Salzwasser. Sie werden sicher dort sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100123,
						722100125
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100123,
					"content": "Überlass das uns.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100124
					]
				},
				{
					"id": 722100124,
					"content": "Dann ist es in euren Händen, miau, miau. Ah, diese Kinder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100125,
					"content": "Ich bin kein Experte darin, Katzen zu fangen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100126
					]
				},
				{
					"id": 722100126,
					"content": "Miau, miau. Keine Angst. Die kleinen haben eh keine Angst vor Menschen ... Man könnte tatsächlich sagen, dass sie genau deswegen immer alleine davonlaufen, weil keiner mit ihnen spielt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100127
					],
					"speakerTitle": "„Neko“"
				},
				{
					"id": 722100127,
					"content": "Dann ist es in euren Händen, miau, miau. Ah, diese Kinder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Neko“"
				}
			]
		},
