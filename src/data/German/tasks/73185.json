					"nextDialogs": [
						731850512
					]
				},
				{
					"id": 731850516,
					"content": "#Ausgezeichnet, du hast beide Packtiere wiedergefunden! Ich danke dir vielmals, {M#Reisender}{F#Reisende}.",
