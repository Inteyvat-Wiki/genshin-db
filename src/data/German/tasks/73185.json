					"nextDialogs": [
						731850702
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850702,
					"content": "Wenn diese beiden Packtiere samt den Waren verloren gegangen wären, dann wäre ich jetzt bankrott.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850703,
						731850704
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850703,
					"content": "Gern geschehen.",
