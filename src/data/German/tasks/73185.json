					"nextDialogs": [
						731850705
					]
				},
				{
					"id": 731850705,
					"content": "Ach! Ja, ich muss dir noch deine Belohnung geben, warte mal bitte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850706
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850706,
					"content": "Nimm diese Dinge an dich. Wenn ich dich so ansehe, wirst du wohl das ganze Jahr über in der Wildnis unterwegs sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850707
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850707,
					"content": "Mein Geschäft hat zufälligerweise etwas mit Abenteurerausrüstung zu tun, also bin ich sicher, dass diese Dinge auch für dich nützlich sein werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850708
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850708,
					"content": "Puh ... Die Packtiere sind wieder zurückgebracht, die Waren sind großenteils unversehrt, ich sollte mich schnell von hier davon machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850709
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850709,
					"content": "#Noch einmal verbindlichsten Dank, {M#Reisender}{F#Reisende}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850704,
