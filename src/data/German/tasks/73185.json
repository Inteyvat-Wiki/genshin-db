			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731850101,
					"content": "#*keuch* ... Ich danke dir, {M#Reisender}{F#Reisende} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850102,
						731850103
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850102,
					"content": "Zum Glück bist du unverletzt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				},
				{
					"id": 731850104,
					"content": "Ich heiße Elber und bin Kaufmann. Eigentlich wollte ich mich hier nur ein wenig ausruhen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850105
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850105,
					"content": "Ich hatte nicht damit gerechnet, plötzlich von Hilichurl angegriffen zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850106,
						731850107
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850106,
					"content": "Hast du keine Eskorte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850108,
					"content": "Ja, wir haben in der Stadt gehört, dass die Kaufleute, die draußen mit Waren unterwegs sind, normalerweise von Leuten der „Goldbrigade“ beschützt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850109,
					"content": "Nun, bei mir ... mir ist es schade um das Geld!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850110
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850110,
					"content": "Diese Leute von der „Goldbrigade“ verlangen zu hohe Preise und der eine verlangt mehr als der andere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850111
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850111,
					"content": "Ich betreibe nur ein kleines Geschäft. Ich kann mir solche Preise nicht leisten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850112
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850112,
					"content": "Ich dachte mir, ich beherrsche selbst ein wenig Kampfkunst, und es ist kein langer Weg, also kann ich auch alleine gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850113
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850113,
					"content": "Ich hatte nicht damit gerechnet, dass bei einem Angriff der Hilichurle meine beiden Packtiere davonlaufen würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850114
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850114,
					"content": "Ich wurde von einem der Packtiere umgerannt, bevor ich überhaupt reagieren konnte, und als ich wieder auf die Füße kam, wurde ich von dem anderen niedergetreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850115
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850115,
					"content": "Herrje ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850116,
					"content": "Die beiden Packtiere rannten weg und ich wurde von den Hilichurlen belagert ... Zum Glück warst du da, um mir zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850117
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850117,
					"content": "#Aber mein gesamter Besitz liegt auf dem Rücken dieser beiden Packtiere ... {M#Reisender}{F#Reisende}, kannst du mir helfen, sie zu finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850118,
						731850119
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850118,
					"content": "I... Ich möchte nicht getreten werden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850120,
					"content": "Keine Sorge. Sie sind eigentlich sehr zahm, es ist nur so, dass die Hilichurle ihr Futter verschüttet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850121
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850121,
					"content": "Sie waren viel mit Waren auf dem Rücken gelaufen und waren sehr hungrig. Als dann jemand ihre Nahrung verschüttete, wurden sie sehr ungehalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850122
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850122,
					"content": "Ach so ist das ... Beim Essen gestört zu werden und dass ihr ganzes Essen verschüttet wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850123,
					"content": "Oh oh, allein der Gedanke daran bringt Paimon schon auf die Palme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850124,
					"content": "Paimon begreift wirklich rasch!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850125
					]
				},
				{
					"id": 731850125,
					"content": "Gut ... Hier, nimm dieses Essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850126
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850126,
					"content": "Wenn du die Packtiere gefunden hast, füttere sie bitte damit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850127
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850127,
					"content": "Solange sie etwas zu Essen bekommen, werde sie sich nicht aufregen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850128
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850128,
					"content": "Wenn ich mich recht erinnere, ist ein Packtier auf die Hilichurle gestoßen und hat sich dann davon gemacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850129
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850129,
					"content": "Das andere wurde anscheinend von den Hilichurlen gefangen und mitgenommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850130
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850130,
					"content": "#Ich werde dir die ungefähre Richtung, in die die beiden Packtiere davongegangen sind, hier aufzeichnen ... Damit übergebe ich dir diese Aufgabe, {M#Reisender}{F#Reisende}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850131
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850131,
					"content": "Solange ich meine Waren zurückbekomme, werde ich dir eine hohe Belohnung zahlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850119,
					"content": "I... Ich möchte nicht umgerannt werden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850120
					]
				},
				{
					"id": 731850107,
					"content": "Niemand beschützt dich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850108
					]
				},
				{
					"id": 731850103,
					"content": "Ach das ist nichts.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850104
					]
				}
			]
		},
