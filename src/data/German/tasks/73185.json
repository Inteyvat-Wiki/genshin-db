					]
				},
				{
					"id": 731850404,
					"content": "Reicht das aus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850405
					]
				},
				{
					"id": 731850408,
					"content": "Das Packtier verschlingt in Windeseile die Nahrung, schon scheint sein Gemüt etwas aufgeheitert ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850409
					]
				},
				{
					"id": 731850405,
					"content": "Es scheint, seine Laune hat sich verbessert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850406,
					"content": "Schnell, lass es uns zurückbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850407,
					"content": "Du bist mit dem Packtier zurück zu Elber gegangen ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850408
					]
				},
				{
					"id": 731850409,
					"content": "Welch ein Glück ... Ich dachte schon, das Packtier wäre wirklich davon gelaufen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850410
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850410,
					"content": "#Danke dir, {M#Reisender}{F#Reisende}, ich kann dir gar nicht genug danken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850411
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850411,
					"content": "Ich muss mir sofort einmal dieses Packtier ansehen, hoffentlich ist es nicht verletzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850412
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850412,
					"content": "#Bitte hilf mir, noch ein weiteres Packtier zu finden, {M#Reisender}{F#Reisende}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850413
