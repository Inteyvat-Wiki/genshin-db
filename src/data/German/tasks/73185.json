			},
			"dialogs": [
				{
					"id": 731850501,
					"content": "Dieses Packtier sieht etwas verstimmt aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850502,
					"content": "Waah, schau auf seine Hufe, es scheint ganz stramm zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850503,
					"content": "Wenn jemand von ihm getreten wird, könnte er sofort in Ohnmacht fallen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850504,
					"content": "Paimon, gib ihm die Nahrung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850505
					]
				},
				{
					"id": 731850505,
					"content": "Du, los! Beeil dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850506,
						731850507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850506,
					"content": "Guten Appetit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850508
					]
				},
				{
					"id": 731850507,
					"content": "Ich wollte dich keineswegs wegen der Hufe beleidigen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850516
					]
				},
				{
					"id": 731850510,
					"content": "Das Packtier verzehrt gemächlich seine Nahrung, es scheint sich ein wenig beruhigt zu haben ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850511
					]
				},
				{
					"id": 731850508,
					"content": "Es scheint sich nicht mehr so sehr zu ärgern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850509,
					"content": "Lass es uns schnell zurückbringen, vorsichtig! Lass dich nicht treten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850511,
					"content": "Du bist mit dem Packtier zurück zu Elber gegangen ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850512
					]
				},
				{
					"id": 731850512,
					"content": "Welch ein Glück ... Ich dachte schon, das Packtier wäre wirklich davon gelaufen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850513
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850513,
					"content": "#Danke dir, {M#Reisender}{F#Reisende}, ich kann dir gar nicht genug danken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850514
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850514,
					"content": "Ich muss mir sofort einmal dieses Packtier ansehen, hoffentlich ist es nicht verletzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850515
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850515,
					"content": "#Bitte hilf mir, noch ein weiteres Packtier zu finden, {M#Reisender}{F#Reisende}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850516
					],
					"speakerTitle": "Elber"
				}
			]
		},
