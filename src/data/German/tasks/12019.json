			"dialogs": [
				{
					"id": 120190101,
					"content": "Was ist los, wollen wir noch über etwas anderes reden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190102,
						120190105,
						120190109,
						120190113
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190102,
					"content": "Über die Kloßmilch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190103
					]
				},
				{
					"id": 120190103,
					"content": "Sie liebte vor allem dieses Getränk und war wahrscheinlich überglücklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190104,
					"content": "Sie dachte sich wahrscheinlich: „Schnell, eröffne diesen Laden in den utopischen Gefilden“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190105,
					"content": "Über Shougun Raiden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190106
					]
				},
				{
					"id": 120190106,
					"content": "Die Puppe, richtig? Es ist schwierig, die Regeln für die Puppe zu ändern, das habe ich gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190107,
					"content": "Diese Schwierigkeit mag beispiellos sein und du kannst es dir vorstellen, wenn es selbst für die göttliche und weise Ei schwierig scheint ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190108,
					"content": "Was nicht einmal „Musou no Hitotachi“ erledigen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190109,
					"content": "Über „kurze Erzählungen“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190110
					]
				},
				{
					"id": 120190110,
					"content": "Wäre es nicht eine interessante Idee, als Shougun Raiden wiedergeboren zu werden? Kurze Erzählungen machen Spaß, solange sie interessant sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190111,
					"content": "Aber für sie, nun ja, ein bisschen zu kantig, denke ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190112,
					"content": "Nun, sollten wir das nächste Mal zu Einsendungen zum Thema „Wiedergeburt als Guuji Yae“ aufrufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190113,
					"content": "Nein, ich habe nichts mehr zu sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}