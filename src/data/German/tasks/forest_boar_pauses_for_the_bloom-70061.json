			"dialogs": [
				{
					"id": 700610701,
					"content": "Oh ... Ihr seid zurück? Und, wie war’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610702
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610702,
					"content": "Wir haben es schon vertrieben!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610703
					]
				},
				{
					"id": 700610703,
					"content": "Ah, vielen Dank! Hier, das ist deine Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610704
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610704,
					"content": "Wer arbeitet, soll auch eine Belohnung bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610705
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610705,
					"content": "Endlich kann ich mich wieder um das Blumenfeld kümmern. Hoffentlich kommt diesmal nicht wieder irgendetwas Unmenschliches, um Ärger zu machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leopoldine"
				}
			]
		}
	]
