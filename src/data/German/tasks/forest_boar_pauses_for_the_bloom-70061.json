			"dialogs": [
				{
					"id": 700610101,
					"content": "Hach, schon wieder. Was ist nur wieder aus dem Blumenfeld geworden ... Also wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610102
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610102,
					"content": "So können die Blumen wieder nicht rechtzeitig geliefert werden. Wie soll ich das nur den Empfängern erklären?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610103
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610103,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610104
					]
				},
				{
					"id": 700610104,
					"content": "Das Blumenfeld ist ruiniert ... Ach, sieh dir das an. Das waren mal so schöne Blumen, jetzt sind sie völlig zerstört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610105
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610105,
					"content": "Das hat alles dieser Kerl getan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610106
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610106,
					"content": "Das geht zu weit! Einfach unmenschlich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610107
					]
				},
				{
					"id": 700610107,
					"content": "Ja! Echt unmenschlich ... Wobei das hier wörtlich zu nehmen ist. Wirklich kein Mensch, sondern ein Waldschwein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610108
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610108,
					"content": "Ich weiß nicht, warum, aber in letzter Zeit läuft es ständig hier runter, frisst die Blumen und wälzt sich im Blumenfeld herum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610109
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610109,
					"content": "Und es ist extrem hinterlistig. Immer wenn es Lärm macht und Leute kommen, haut es sofort ab. Gerade eben hat es fast einen alten Mann, der vorbeikam, umgerannt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610110
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610110,
					"content": "Das geht zu weit! Das ist wirklich kein ... wirklich kein gutes Waldschwein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610111
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610111,
					"content": "#Hm ... Wenn man genauer hinsieht ... Oh, bist du nicht {F#die Ehrenritterin, die große Heldin, die}{M#der Ehrenritter, der große Held, der} Mondstadt gerettet hat? H... Hilf mir doch bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610112
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610112,
					"content": "Gut, ich werde es vertreiben!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610113
					]
				},
				{
					"id": 700610113,
					"content": "Wirklich nett, dass du helfen willst ... Soweit ich weiß, ist es wohl ins Tal gelaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610114
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610114,
					"content": "Aber das Ding ist echt fies. Vielleicht brauchen wir Blumen, um es rauszulocken ... Aber leider sieht das Blumenfeld jetzt so aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610115
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610115,
					"content": "Vielleicht kannst du unterwegs ein paar Windhauchblumen pflücken, um es herauszulocken. Dann merkt es auch endlich mal, wie es sich anfühlt, reingelegt zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leopoldine"
				}
			]
		},
