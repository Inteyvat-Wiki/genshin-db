			"dialogs": [
				{
					"id": 742500101,
					"content": "Wenn ich so darüber nachdenke, war ich nicht gerade die aufmerksamste Gastgeberin, als ihr Snezhnaya zuvor besucht habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500102,
					"content": "Ach wo, Fräulein Sandrone. Auch wenn wir uns nie zusammengesetzt haben, um zu plaudern, hast du uns immer mit den besten Erfrischungen versorgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500103
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500103,
					"content": "*seufz* Es tut mir leid. Ich war damals zu beschäftigt. Ich werde mich bei eurem nächsten Besuch auf jeden Fall besser um euch kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500104,
					"content": "Du hast mich früher auch nie deine Erfindungen ausprobieren lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500105
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500105,
					"content": "Das hatte verschiedene Gründe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500106,
					"content": "Hmpf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500107
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500107,
					"content": "Eigentlich hat Vater gesagt, dass wir dich möglichst nicht stören sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500108
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 742500108,
					"content": "Mach dir darüber keine Sorgen, gelegentliche Störungen machen mir nichts aus. Du kannst jederzeit auf einen Tee vorbeikommen, wenn du Lust hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500109,
					"content": "Wirklich? Eigentlich ... Ich wollte dich schon immer bitten, dir Pers mal anzusehen ... Ich habe ein paar Ideen für Verbesserungen, die ich gerne mit dir besprechen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500110
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 742500110,
					"content": "Aber sicher, das ist schließlich mein Spezialgebiet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500111,
					"content": "... Vielen Dank, Fräulein Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500112
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 742500112,
					"content": "Ist es wirklich so schwer, eine von den Elf der Fatui zu sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500113
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500113,
					"content": "Wenn du es so sagst ... Ich schätze, ein bisschen schon. Es gibt viel zu bedenken. Allerdings kommt der meiste Frust von meinen Kollegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500114,
					"content": "Das heißt also ... dass es eine unverzichtbare Fähigkeit ist, gut mit anderen auszukommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500115
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 742500115,
					"content": "Ich schätze schon ... Aber ich bezweifle, dass du dir darüber große Sorgen machen musst. Zumindest Lyney muss das ganz sicher nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500116,
					"content": "Haha, du schmeichelst mir, Fräulein Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500117
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500117,
					"content": "#Willst du einer von den Elf der Fatui werden? Wobei{NON_BREAK_SPACE}... Vergiss es. Es steht mir nicht zu, danach zu fragen. Tu einfach so, als hätte ich nichts gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500118,
					"content": "Hmm ... Das ist für mich alles noch ein bisschen weit weg. Ich habe es wirklich nicht so eilig, jetzt schon darüber nachzudenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500119
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500119,
					"content": "Wenn du zu einem von den Elf der Fatui werden würdest, würde das nicht bedeuten, dass du keine Zeit mehr hättest, uns auf Missionen zu begleiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500120
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500120,
					"content": "In dem Fall ... Würde das bedeuten ... Lynette und ich müssten auch Elf der Fatui werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500121
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 742500121,
					"content": "Ich habe dir doch gesagt, so etwas liegt noch in zu weiter Ferne, um darüber nachzudenken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500122
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500122,
					"content": "Außerdem werde ich euch beide niemals zurücklassen, egal, wohin ich gehe. Versprochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500123
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500123,
					"content": "Hah ... Manchmal beneide ich dich wirklich um diese kleine Familie, die du da hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
