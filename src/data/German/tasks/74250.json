			"dialogs": [
				{
					"id": 742500201,
					"content": "Danke für deine Gastfreundschaft, Fräulein Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500202,
						742500203
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500202,
					"content": "(Lass uns noch ein Weilchen so sitzen bleiben.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742500204,
					"content": "Also gut, pass auf dich auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500203,
					"content": "Ich glaube, es wird Zeit, dass ich mit dem Aufräumen anfange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
