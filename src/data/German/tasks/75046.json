				},
				{
					"id": 750460503,
					"content": "Ich habe ein paar gefunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460504
					]
				},
				{
					"id": 750460504,
					"content": "Danke dir, guter Mensch. Zum Glück ist ihnen nichts passiert, ich habe mir solche Sorgen gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460505
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460505,
					"content": "Es sind aber noch ein paar übrig, die irgendwo herumlaufen. Ach, tut mir leid, dass ich dich damit belästigen muss. Wenn du sie findest, bring sie bitte auch zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
		},
