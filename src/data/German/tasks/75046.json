					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460414
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460414,
					"content": "Sie sind alle wieder da.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460415
					]
				},
				{
					"id": 750460415,
					"content": "#Warst du es, {M#der}{F#die} sie zurückgebracht hat? Vielen Dank! Bitte nimm diese Kisten als Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460416
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460416,
					"content": "Ich werde später gleich nach ihnen sehen. Oh, meine kleinen, kleinen Saurier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460417
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460417,
					"content": "Jetzt kann ich mich beruhigt meiner Arbeit als Trainer widmen. Übrigens, gütiger Gast, wenn du Interesse an der Recken-Herausforderung hast, komm gerne wieder zu mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
