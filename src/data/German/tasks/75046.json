			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Urubamba"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750460101,
					"content": "Ululuu! ... Kommt hierher, kommt zurück! Uluuuuluu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460102
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460102,
					"content": "Hallo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460103
					]
				},
				{
					"id": 750460103,
					"content": "Ululuu! ... *seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460104
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460104,
					"content": "Mir geht es nicht gut, hier, traurig. Das verkrafte ich nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460105
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460105,
					"content": "Ich war nur kurz draußen, um etwas Heu zu kaufen, und schwupps, sind meine acht kleinen Tatankasaurier wie vom Erdboden verschluckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460106
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460106,
					"content": "Sie sind noch so klein! Was, wenn sie von Hilichurlen schikaniert werden? Oder sich verlaufen? Oder irgendwo festsitzen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460107
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460107,
					"content": "He, guter Mensch, hast du zufällig meine kleinen Tatankasaurier gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460108
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460108,
					"content": "Wie sehen die denn aus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460109
					]
				},
				{
					"id": 750460109,
					"content": "Ich habe die Mutter dieser acht kleinen Tatankasaurier selbst aufgezogen, so, als wäre sie meine Tochter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460110
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460110,
					"content": "Sie gilt als einer der schönsten Saurier im Kollektiv der Fülle und hat sogar den ersten Preis beim regionalen Schönheitswettbewerb gewonnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460111
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460111,
					"content": "Diese acht kleinen Frechdachse haben die Schönheit ihrer Mama geerbt ... Sie haben eine helle, zartrosa Haut und perfekt-symmetrische lilafarbene Hörner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460112
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460112,
					"content": "Wenn du sie siehst, bring sie bitte irgendwie zurück zu mir. Ich flehe dich an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460113
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460113,
					"content": "Meine kleinen Saurier ... Opa wird euch nie wieder schimpfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460118
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460118,
					"content": "Ich werde die Augen offen halten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460119
					]
				},
				{
					"id": 750460119,
					"content": "Danke dir, guter Mensch. Heute wirst du beim Bankdrücken sicher einen neuen Rekord aufstellen und bei Klimmzügen keine Krämpfe bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
		},
