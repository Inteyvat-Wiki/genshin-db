			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pedrush",
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150101,
					"content": "Großartig, ihr seid auch aufgewacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150102
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150102,
					"content": "Alle sind nacheinander aufgewacht. Und es gibt gute Neuigkeiten aus der Stadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150103
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150103,
					"content": "Sieht aus, als ob die Dinge gut gelaufen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150104
					],
					"speakerTitle": "Pedrush"
				},
				{
					"id": 130150104,
					"content": "Nun, etwas Mühe hat es schon gekostet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150105,
					"content": "Es wird sich bestimmt bald eine Menge versammeln. Könntest du bitte für Ordnung sorgen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150106,
					"content": "Ich muss mit ihnen in die Akademie gehen, bin aber bald zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301502,
			"completionStepIds": [
				1301502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301502",
							"2"
						],
						"stepId": 1301502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sitt",
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150201,
					"content": "Eure Heiligkeit. Was kann ich für Euch tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150202
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150202,
					"content": "Ich möchte etwas über ein Mitglied erfahren, ob es einen Gelehrten des Kshahrewar-Instituts gibt, der zurzeit im Koma liegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150203
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150203,
					"content": "Alles klar, nur einen Moment bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150204
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150204,
					"content": "Nach einer Weile ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130150205
					]
				},
				{
					"id": 130150205,
					"content": "Vielen Dank für Eure Geduld. Es gibt tatsächlich einen Gelehrten, der durch eine unerlaubte Verwendung des Akasha ins Koma gefallen ist. Er heißt Beynuni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150206
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150206,
					"content": "Bis zum jetzigen Zeitpunkt hat er das Bewusstsein nicht wiedererlangt und wird immer noch im „Bimarstan“ behandelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150207
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150207,
					"content": "Hä? Heißt er nicht Moseis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150208,
					"content": "Ich denke, er wollte nicht erkannt werden, damit ihm niemand in die Quere kommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150209
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150209,
					"content": "Übergib das Wissen, das sich hier drin befindet, bitte den Matra und bitte sie, es in Beynunis Gehirn zu importieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150210
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150210,
					"content": "Alles klar, aber aus Sicherheitsgründen muss ich den Grund dafür erfahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150211
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150211,
					"content": "Ganz einfach, das ist sein Bewusstsein, es war in einem Traum gefangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150212
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150212,
					"content": "Er hat in dem Traum Dinge getan, die die Sicherheit von Sumeru gefährdet haben. Nachdem er aufgewacht ist, werde ich dem Mahamatra die Situation erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150213
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150213,
					"content": "Ich verstehe. Ich werde das gleich erledigen. Vielen Dank, Eure Heiligkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150214
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150214,
					"content": "Gut, das ist in Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150215
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150215,
					"content": "Ich schätze, dass die Leute von „Traummomente“ sich bereits versammelt haben, lasst uns zurückgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301503,
			"completionStepIds": [
				1301503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301503",
							"2"
						],
						"stepId": 1301503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150301,
					"content": "Diesmal sollten wir einfach das Publikum sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150302,
					"content": "Paimon hat keine Ahnung, was sie sagen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150303,
					"content": "Ich begrüße alle, die gerade aufgewacht sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150304
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150304,
					"content": "Es tut mir sehr leid, euren Traum gestört zu haben. Es mag sich kaltherzig angefühlt haben, wie ich euch darin behandelt habe. Dafür möchte ich mich entschuldigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150305
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150305,
					"content": "Träume besitzen eine großartige Macht. Sie können die Entschlossenen anspornen und ihren Wünschen Flügel verleihen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150306
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150306,
					"content": "Aber sie können auch die Schwachstellen treffen, das Bewusstsein durcheinanderbringen, richtig und falsch vertauschen ... Leider wurdet ihr als Beute ausgewählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150307
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150307,
					"content": "Wie ich bereits sagte, habe ich noch viel zu lernen und ich möchte nicht behaupten, dass ich den Schmerz kenne, den man bei einem Abschied verspürt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150308
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150308,
					"content": "Aber ihr werdet in eurem Umfeld viele Menschen finden, die ähnliche Erfahrungen gemacht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150309
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150309,
					"content": "Ihr solltet stolz darauf sein, dass ihr jetzt gemeinsam hier stehen und in die Ferne blicken könnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150310
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150310,
					"content": "Der Lebensweg ist lang und sein Ende kaum sichtbar, deshalb können uns alle möglichen Fragen begegnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150311
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150311,
					"content": "„Was ist der Sinn des Lebens? Was ist mein Ziel? Warum sollte ich ständig diesen Schmerz ertragen?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150312
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150312,
					"content": "Ja, es ist der einfachste Weg, stehen zu bleiben, aufzuhören zu denken und festgefahrene Verhaltensweisen beizubehalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150313
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150313,
					"content": "Immer wenn ihr solche Gedanken habt, solltet ihr auf die Menschen und Dinge in eurer Umgebung schauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150314
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150314,
					"content": "Manche Menschen arbeiten hart, damit sie am Ende des Tages mit ihrer Familie eine gute Mahlzeit genießen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150315
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150315,
					"content": "Manche Menschen bereisen das ganze Festland, um Kunstwerke zu erschaffen, die in ganz Teyvat bewundert werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150316
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150316,
					"content": "Manche Menschen erforschen die Geheimnisse der Welt, um die langsam nahende unaussprechliche Katastrophe aufzuhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150317
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150317,
					"content": "... Das Ich ist nicht der ganze Sinn des Lebens, jede Handlung bedeutet eine Formung des Ich und der Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150318
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150318,
					"content": "Freunde und Familie werden sich an eure Taten erinnern und noch viel mehr Menschen werden davon profitieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150319
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150319,
					"content": "Deshalb gibt es viele Menschen, die völlig neue Wege beschreiten, auch wenn sie dafür Schmerzen in Kauf nehmen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150320
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150320,
					"content": "Und wenn ihr diesen Weg geht, werden die Antworten auf die wichtigste Frage langsam sichtbar und gleichzeitig an Bedeutung verlieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150321
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150321,
					"content": "Aber wenn euch das Leben nichts bedeutet, dann wird es unweigerlich ins Nichts führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150322
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150322,
					"content": "Ihr könnt euer Leben selbst wählen, aber ich als Göttin muss euch zuerst aufwecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150323
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150323,
					"content": "Es ist eure Entscheidung, ob ihr die Wirklichkeit aufgeben und stattdessen einen Traum leben wollt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301504,
			"completionStepIds": [
				1301504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301504",
							"2"
						],
						"stepId": 1301504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150401,
					"content": "Du bist wunderbar, im Traum hatte Paimon ein wenig das Gefühl, diesen Gelehrten nicht widersprechen zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150402,
					"content": "Seine Methode, die Schwächen der Menschen auszunutzen, ist sehr clever, aber vielleicht war er selbst auch schon zu lange in dem Traum gefangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150403
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150403,
					"content": "Der Traum übt eine unwiderstehliche Anziehungskraft aus, so süß, dass ein einfacher Mensch süchtig wird und kaum noch vernünftig urteilen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150404
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150404,
					"content": "Aber es ist nie zu spät, aufzuwachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150405
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150405,
					"content": "Auch du bist viel reifer geworden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150406
					]
				},
				{
					"id": 130150406,
					"content": "Hm? Wie kommst du plötzlich darauf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150407
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150407,
					"content": "Du kannst dich sehr gut in die Menschen hineinversetzen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150408
					]
				},
				{
					"id": 130150408,
					"content": "Genau, du sagst zwar, dass du die menschlichen Gefühle nicht verstehen kannst, aber wir haben dein Zögern sehr wohl bemerkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150409,
					"content": "Und mit dieser Rede hast du ihnen aus dem Herzen gesprochen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150410,
					"content": "Danke. Ich habe in dieser Zeit viele traurige Geschichten gehört und mein Herz wurde mehr als ein Mal tief bewegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150411
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150411,
					"content": "Was die Opfer getan haben war nicht falsch und ihre Wünsche sind nachvollziehbar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150412
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150412,
					"content": "Deshalb verstehe ich ihre Entscheidung, ihren Traum gegen uns zu verteidigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150413
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150413,
					"content": "Aber meine Anteilnahme und meine Empfindungen sind wahrscheinlich nur ein winziger Bruchteil des Schmerzes, den sie empfinden mögen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150414
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150414,
					"content": "Diesen „Bruchteil“ würde ich nicht Einfühlungsvermögen nennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150415
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150415,
					"content": "Du hast natürlich die höchsten Ansprüche an dich selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150416,
						130150417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150416,
					"content": "Absolute Empathie gibt es sowieso nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				},
				{
					"id": 130150418,
					"content": "Hehe, na gut. Man kann nur erwachsen werden, wenn man in die Welt hinausgeht und eigene Erfahrungen macht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150419
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150419,
					"content": "Emotionen sind etwas völlig anderes als Wissen, es fällt mir sogar schwer, es klar auszudrücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150420
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150420,
					"content": "Beynuni ... „Moseis“ sagte, ich hätte nie die Erfahrung eines endgültigen Verlustes gemacht. Aber ich habe das vage Gefühl, dass das nicht stimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150421
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150421,
					"content": "In dem Augenblick, als ich den Traum betrat, fühlte ich, wie mich ein sehr warmer Strom umschloss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150422
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150422,
					"content": "Er war so warm, dass ich das Gefühl hatte, wieder in meiner ursprünglichen Gestalt zu sein, sodass ich selbst gar nicht mehr aufwachen wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150423
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150423,
					"content": "(Heißt das etwa, dass sie auch etwas gesehen hat?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150424
					]
				},
				{
					"id": 130150424,
					"content": "Aber als ich meine Augen öffnete, verschwand dieses Gefühl vollständig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150425
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150425,
					"content": "Es ist so wie ein weißes Blatt Papier, auf dem man die Schrift ausradiert. Man kann sie nicht mehr lesen, aber die flachen Vertiefungen erkennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150426
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150426,
					"content": "Aber nachdem ich diesen Traum erlebt hatte, war mir klar, dass es keine Rolle spielt, was dieser warme Strom bedeutet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150427
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150427,
					"content": "Was ich mit Sicherheit sagen kann, ist, dass ich einst von dieser sehr warmen Kraft getragen wurde, sodass ich dorthin gelangen konnte, wo ich heute bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150428
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150428,
					"content": "Man würde das Pferd von hinten aufzuzäumen, wenn man zu sehr darauf achtet, woher die Wärme kommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150429
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150429,
					"content": "Ich habe den Menschen gerade all diese idealen Theorien vorgetragen und kann mich selbst nicht daran halten. Das ist schon etwas beschämend, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150430
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150430,
					"content": "(Die Höhere Herrin Rukkhadevata hat Nahida bereits mit ihren Taten verändert.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150431
					]
				},
				{
					"id": 130150431,
					"content": "(Selbst wenn die Welt sie vergessen sollte, Nahidas Wille und ihre Wünsche sind bereits der Beweis dafür, dass sie „existiert“ hat.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150432
					]
				},
				{
					"id": 130150432,
					"content": "(Ich sollte ihre Denkweise mehr respektieren, anstatt auf der reinen Wahrheit herumzureiten.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150433
					]
				},
				{
					"id": 130150433,
					"content": "Was ist los? Plötzlich dieses finstere Gesicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150434,
					"content": "Du hast dich jetzt schon einige Male selbst unterbrochen. Möchtest du mir etwas sagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150435,
						130150436
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150435,
					"content": "Ich hab vergessen, was ich sagen wollte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150437,
					"content": "Haha, na gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150438
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150438,
					"content": "Jetzt, da wir wach sind, strecken wir uns ein wenig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150439
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150439,
					"content": "Ein neuer Tag ist in Anmarsch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150436,
					"content": "Nichts Wichtiges.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150417,
					"content": "Du kannst ruhig etwas selbstbewusster sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				}
			]
		},
