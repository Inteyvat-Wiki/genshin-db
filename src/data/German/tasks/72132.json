				"points": []
			},
			"dialogs": [
				{
					"id": 721320101,
					"content": "Danke für deine Bemühungen. Obwohl die Insel immer noch voller Gefahren ist, haben die Menschen, die ihre Heimatstadt verlassen haben, dank dir wieder ein wenig Vertrauen in die Rückkehr gewonnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320102
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320102,
					"content": "Obwohl der Regen jetzt aufhört, könnten die Kriegsparteien noch aggressiver um die Insel kämpfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320103
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320103,
					"content": "Aber sie hatten keine Zeit, die Situation auf der Insel zu ändern. Das, was wir getan haben, ist zumindest besser, als das Problem zu ignorieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320104
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320104,
					"content": "Nun, das ist das Geschenk, das ich dir versprochen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320105
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320105,
					"content": "Dies ist der berühmte Speer, der einst von den Yashiori-Wächtern benutzt wurde. Ich bin mir nicht sicher, ob diese Zeichnung für dich von Nutzen sein wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320107
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320107,
					"content": "Aber wenn du es einem ausreichend erfahrenen Schmied gibst, sollte er in der Lage sein, den Glanz, den es einst in Kitains Händen hatte, wiederherzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320108
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320108,
					"content": "*seufz* Ach, das Zeitalter der Helden ist gekommen und gegangen, und die Kitain, die einst so viele Übel vernichtet haben, werden nie wieder zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320109
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320109,
					"content": "Dennoch scheinen wir dank deiner Hilfe den Taten von Kitain in der Gegenwart einen Schritt näher gekommen zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320110
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320110,
					"content": "Als Nächstes werde ich zu meinen Freunden im Bakufu gehen, um zu sehen, ob ich bei irgendetwas helfen kann. Ich hoffe, wir sehen uns in der Zukunft wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
