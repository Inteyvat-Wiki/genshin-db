			},
			"dialogs": [
				{
					"id": 721310101,
					"content": "Die seltsam geformte Steinlaterne scheint eine unheilvolle Energie auszustrahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310102
					],
					"speakerTitle": "Betrachten"
				},
				{
					"id": 721310102,
					"content": "Das ist ... eine Steinlaterne? Warum befindet sich hier eine Steinlaterne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310103,
					"content": "Oh, da hat jemand etwas auf der Lampensäule geschrieben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310104,
					"content": "„An alle Kollegen: Wenn ihr Fragen zu den Omamori haben, geht bitte in die Musoujin-Schlucht und sprecht mit Herrn Kaji darüber.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310105
					],
					"speakerTitle": "Betrachten"
				},
				{
					"id": 721310105,
					"content": "Die Handschrift sieht neu aus. Darunter befinden sich ein paar kleine grobe Schriftzeilen:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310106
					],
					"speakerTitle": "Betrachten"
				},
				{
					"id": 721310106,
					"content": "„Entschuldigung, aber wir können euch auch nicht helfen. Wir haben erst gestern den Evakuierungsbefehl von der Tenryou-Verwaltung erhalten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310107
					],
					"speakerTitle": "Betrachten"
				},
				{
					"id": 721310107,
					"content": "„Ich hoffe, ich kann euch eines Tages wiedersehen und mit euch besprechen, wie wir unser Problem der Tatarigami lösen können.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310108
					],
					"speakerTitle": "Betrachten"
				},
				{
					"id": 721310108,
					"content": "Herr Kaji scheint ziemlich besorgt über die Steinlaternen zu sein. Warum gehen wir nicht zur Musoujin-Schlucht und fragen ihn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
