				},
				{
					"id": 230110502,
					"content": "Wegen dem Holz von Viktor ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110503
					]
				},
				{
					"id": 230110503,
					"content": "Das Holz ... Hast du alle Monster vertrieben? Ich hätte nicht gedacht, dass du so gut kämpfst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110504
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110504,
					"content": "Vielen Dank. Ich werde später jemanden finden, der mit mir zusammen das Holz holt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110505
