			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230110101,
					"content": "Hm ... Wie soll ich das schnitzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110102,
						230110103
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110102,
					"content": "Hallo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				},
				{
					"id": 230110104,
					"content": "Hä, wer ist das, lass mich in Ruhe ... Ich wollte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110105,
					"content": "#Hä! {F#Reisende}{M#Reisender}? Was machst du hier in Sumeru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110106,
					"content": "Hat dich dieser Rudolf etwa geschickt, um mich zu verprügeln? Ich habe Lily doch nur etwas geschenkt. Das ist schon ewig her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110107,
						230110109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110107,
					"content": "Ich bin nur auf meiner Reise hier vorbeigekommen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110108
					]
				},
				{
					"id": 230110108,
					"content": "Du bist immer noch auf Reise? Du hast echt Elan ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110112,
					"content": "Jedenfalls hätte ich nicht erwartet, dich in Sumeru zu sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110113,
					"content": "Als ich aus Mondstadt abberufen wurde, hatte ich eigentlich den Auftrag, direkt nach Snezhnaya zurückzukehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110114
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110114,
					"content": "Aber unterwegs bekam ich den neuen Auftrag, nach Sumeru zu gehen, um Herrn Vsevolod bei seiner Arbeit zu unterstützen. Außerdem wurde ich informiert, dass ich Herrn „Pulcinella“ unterstellt wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110115,
						230110116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110115,
					"content": "„Pulcinella“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110117,
					"content": "Ja ... Ach, das geht nicht, ich kann nicht mehr sagen, sonst denkt Herr Vsevolod, dass ich nicht mit Geheimnissen umgehen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110118
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110118,
					"content": "Ach, die Namen der Elf sind doch kein Geheimnis, ich weiß auch nicht, warum er so sensibel ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110119
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110119,
					"content": "Und was machst du in Sumeru?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110120
					]
				},
				{
					"id": 230110120,
					"content": "Also, Herr Vsevolod und ich sind für die Versorgungslogistik verantwortlich. Kurz gesagt, wir kaufen Sachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110121,
					"content": "Das klingt nicht sehr wichtig, aber es ist besser, als die ganze Zeit über in der Kathedrale von Mondstadt blöd vor mich hinzustarren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110122,
					"content": "Hehe, bei dieser Art von Arbeit habe ich außerdem eine Menge freier Zeit und niemand schaut mir ständig über die Schulter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110123
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110123,
					"content": "Ich habe die Schnitzkunst meiner Kindheit aus der Mottenkiste hervorgeholt und in Sumeru gibt es eine Menge Holz. Perfekt zum Üben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110124,
					"content": "Ich hätte nicht gedacht, dass meine kleinen Schnitzereien so gut bei den Kindern ankommen. Diese Kleinen haben mich die ganze Zeit angebettelt, da habe ich ihnen versprochen, jedem ein eigenes Spielzeug zu schnitzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110125,
						230110128
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110125,
					"content": "Bist du nicht ein Fatuus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110126
					]
				},
				{
					"id": 230110126,
					"content": "Klar, na und? Ach, wer sagt denn, dass ein Fatuus Kindern keine Spielsachen geben darf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110127
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110127,
					"content": "Außerdem bin ich jetzt für die Logistik verantwortlich. Mit diesen weltbewegenden Dingen sollen sich die wichtigen Herren herumschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110130,
					"content": "Das ist also meine Situation. Ich konnte zwar nicht nach Snezhnaya zurück, aber hier in Sumeru gefällt es mir auch. Es gibt Essen und Spaß und die Umgebung ist schön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110131
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110131,
					"content": "Nach der Arbeit kaufe ich mir was zu essen, suche mir ein sonniges Plätzchen und widme mich meiner Schnitzerei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110132
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110132,
					"content": "Aber ... Hehe, alle betrachten meine Erscheinung mit Misstrauen, so wie du auch beim ersten Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110133
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110133,
					"content": "Ich kann auch nichts dagegen machen, ich bin nun einmal einer der Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110134,
						230110135
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110134,
					"content": "Ich vertraue dir immer noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110136,
					"content": "Na ja ... Alles in allem bin ich zufrieden mit meiner Situation. Und ich habe auch einige Ersparnisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110137
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110137,
					"content": "In ein paar Jahren werde ich mich vielleicht in Sumeru niederlassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110138
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110138,
					"content": "#Oh, genug geredet. {F#Reisende}{M#Reisender}, da du nun auch in Sumeru bist, können wir doch auch mit unserem „gerechten Tausch“ weitermachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110139
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110139,
					"content": "Aber im Moment kann ich dir leider nichts erzählen. Ich kann dich nur in echter Währung bezahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110140,
						230110141
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110140,
					"content": "Das ist noch besser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110143
					]
				},
				{
					"id": 230110143,
					"content": "Na gut, ich verrate dir etwas über meine Mission.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110144
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110144,
					"content": "Ich habe vor ein paar Tagen Holz bei Hamawi bestellt, doch er hat es mir noch nicht geliefert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110145
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110145,
					"content": "Ich habe noch nicht Feierabend und ich traue mich nicht, selbst zu ihm zu gehen, sonst schnauzt Herr Vsevolod mich wieder an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110146
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110146,
					"content": "#{F#Reisende}{M#Reisender}, gehe für mich zu Hamawi und frage ihn, wann das Holz kommt, das ich bestellt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110147,
						230110149
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110147,
					"content": "Halte die Belohnung bereit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110148
					]
				},
				{
					"id": 230110148,
					"content": "Keine Sorge, sie ist bereit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110151,
					"content": "#Also, ich überlasse dir die Sache, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110149,
					"content": "Führst du wirklich nichts im Schilde ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110150
					]
				},
				{
					"id": 230110150,
					"content": "Bei unseren vorherigen Geschäften habe ich doch auch keine krummen Dinger gedreht, du kannst beruhigt sein. Diese Spielchen sind mir viel zu anstrengend, ein gemütliches Leben ist doch viel angenehmer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110141,
					"content": "Ist das eine Mission von den „Fatui“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110142
					]
				},
				{
					"id": 230110142,
					"content": "Natürlich nicht. Das ist nur eine Mission vom „Viktor“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110143
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110135,
					"content": "Niemand traut dir, halte bitte Abstand!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110128,
					"content": "Du versuchst doch nicht etwa, Informationen aus den Kindern herauszubekommen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110129
					]
				},
				{
					"id": 230110129,
					"content": "Ach! Das würde ich nie machen. Du hast solche furchtbaren Vorurteile gegenüber den Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110116,
					"content": "Ist er auch einer der Elf?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110109,
					"content": "Richtig. Komm mit mir zurück nach Mondstadt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110110
					]
				},
				{
					"id": 230110110,
					"content": "Ha, ha, ha. Na gut, willst du mich in Handschellen abführen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110111,
					"content": "Los, keine Scherze, ich habe noch etwas Wichtiges zu erledigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110103,
					"content": "Vi... Viktor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				}
			]
		},
