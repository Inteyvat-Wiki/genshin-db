			"dialogs": [
				{
					"id": 230110601,
					"content": "Und? Ist das Holz da, das ich gekauft habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110602
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110602,
					"content": "Du berichtest Viktor von den Ereignissen ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230110603
					]
				},
				{
					"id": 230110603,
					"content": "Wieder Monster? Ich habe das Gefühl, dass die ganzen Güterwagen auf dieser Welt ein leichtes Ziel für Monster darstellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110604
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110604,
					"content": "Egal, Hauptsache, ich bekomme mein Holz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110605
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110605,
					"content": "Hier, das ist der vereinbarte Lohn, zähle ihn ruhig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110606
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110606,
					"content": "Eins noch ... Wie geht es Lily?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110607
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110607,
					"content": "Als ich ging, habe ich mich nicht persönlich bei dem Mädchen verabschiedet, sie ist mir doch nicht böse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110608,
						230110610
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110608,
					"content": "Ihr geht’s gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110609
					]
				},
				{
					"id": 230110609,
					"content": "Gut. Ähem ... Schau mich nicht so an, ich mache mir nur Sorgen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110614,
					"content": "#Egal, zähle den Lohn, {F#Reisende}{M#Reisender}. Ich habe dir alles bis auf die letzte Mora bezahlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110610,
					"content": "Dann geh selbst zurück und besuche sie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110611
					]
				},
				{
					"id": 230110611,
					"content": "Dann wird Herr Vsevolod mir unbedingt in den Hintern treten, vergiss es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110612
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110612,
					"content": "Ich möchte ihr aber auch keinen Brief schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110613
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110613,
					"content": "Es macht keinen guten Eindruck, Briefe von den Fatui zu erhalten, haha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "Viktor"
				}
			]
		}
