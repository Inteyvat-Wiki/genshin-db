				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230110301,
					"content": "Das ist wirklich Pech ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110302
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110302,
					"content": "Wegen dem Holz von Viktor ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110303
					]
				},
				{
					"id": 230110303,
					"content": "Du meinst das Holz, das dieser Fatuus bei mir bestellt hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110304
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110304,
					"content": "Ach, rede nicht davon. Ich wusste, dass es nicht gut geht, wenn ich mit Fatui Geschäfte mache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110305
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110305,
					"content": "Der Holztransport wurde auf halber Strecke von Monstern angegriffen. Die Leute konnten alle entkommen, aber der Wagen wurde zerstört und das Holz liegen gelassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110306
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110306,
					"content": "*seufz* Unter solchen Umständen traue ich mich selbst nicht dorthin und im Moment kann ich niemanden finden, der diese Monster vertreiben könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110308
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110308,
					"content": "Ich bin kein Fatuus ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110309
					]
				},
				{
					"id": 230110309,
					"content": "Du bist kein Fatuus? Und wieso hilfst du ihm dann? Das ist merkwürdig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110310
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110310,
					"content": "Jedenfalls kann ich den Wagen jetzt nur dort zurücklassen. Mal sehen, ob ich später jemanden anheuern kann, der sich darum kümmern kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110311
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110311,
					"content": "Wenn du das Holz dringend brauchst, kann ich dir den Ort auf der Karte markieren, wo der Wagen ungefähr sein müsste. Dann kannst du selbst hingehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110312
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110312,
					"content": "Ach, sobald man mit Fatui zu tun hat, kann man darauf wetten, dass es Ärger geben wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hamawi"
				}
			]
		},
