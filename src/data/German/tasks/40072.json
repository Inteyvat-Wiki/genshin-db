			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ernsthafter Nachtrabe",
					"Kalter Nachtrabe",
					"Mona",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720201,
					"content": "Halt, ihr dort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720202
					],
					"speakerTitle": "Ernsthafter Nachtrabe"
				},
				{
					"id": 400720202,
					"content": "Ihr seht nicht wie die Untertanen des Immernachtreichs aus! Sprecht! Was tut ihr hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720203
					],
					"speakerTitle": "Kalter Nachtrabe"
				},
				{
					"id": 400720203,
					"content": "Erstaunlicherweise gibt es Wachen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720204,
					"content": "Es gibt keinen Grund zur Panik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720205
					]
				},
				{
					"id": 400720205,
					"content": "Äh? Was meinst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720206,
					"content": "Wir sind die Vasallen Ihrer Hoheit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720207
					]
				},
				{
					"id": 400720207,
					"content": "#{F#Die, die}{M#Der, der} das Sternenmeer durchquert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720208
					]
				},
				{
					"id": 400720208,
					"content": "Wie könnt ihr beweisen, dass ihr Vasallen Ihrer Hoheit seid?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720209
					],
					"speakerTitle": "Ernsthafter Nachtrabe"
				},
				{
					"id": 400720209,
					"content": "Solche arroganten Fragen zu stellen, zeigt nur, wie töricht ihr seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400720210,
					"content": "„Möge mein Volk von den Fesseln der alten Dekrete befreit werden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400720211,
					"content": "Das, das ist das Mantra des Immernachtreichs! Sie sind wirklich die Vasallen Ihrer Hoheit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720212
					],
					"speakerTitle": "Kalter Nachtrabe"
				},
				{
					"id": 400720212,
					"content": "Oh mein ... Ich habe meine Befugnisse überschritten! Meine Herren, bitte verzeiht uns ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720213
					],
					"speakerTitle": "Ernsthafter Nachtrabe"
				},
				{
					"id": 400720213,
					"content": "Warum tretet ihr nicht zurück, jetzt wo ihr wisst, dass ihr falsch liegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720214,
					"content": "Jawohl, ich werde mich zurückziehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720215
					],
					"speakerTitle": "Ernsthafter Nachtrabe"
				},
				{
					"id": 400720215,
					"content": "Sie sind weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400720216,
					"content": "Dies ist der zweite Band der „Hymne des Heiligen Reichs“. Seid ihr bereit, Leute?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720217
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400720217,
					"content": "Gut, los geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4007204,
			"completionStepIds": [
				4007204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
