					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Erzähler",
					"Xinyan",
					"Kaedehara Kazuha",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720401,
					"content": "„Allerdings wurde das Immernachtreich mit einem fortwährenden Albtraum der Düsternis begrüßt. Der teuflische Drache Tasraque steigt aus der Tiefe auf, durchquert den Meeresboden und streift über die Kaiserstadt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720402
					],
					"speakerTitle": "Erzähler"
				},
				{
					"id": 400720402,
					"content": "Hm? Ein Drache? Aber es sieht so aus, als wäre nur das Wetter düster geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720403
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400720403,
					"content": "Drachen ... könnte das eine Metapher sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400720404,
					"content": "Tatsächlich? ... Alles, was sie missbilligt und ihren Fantasien widerspricht, stellt zusammen ihren Erzfeind dar, den „bösen Drachen Tasraque“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007210,
			"completionStepIds": [
				4007210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
