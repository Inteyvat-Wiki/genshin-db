					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Leon",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721001,
					"content": "Toll, irgendjemand ... Hä? Ihr seid es wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721002
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721002,
					"content": "Wir sollten uns fragen, warum du es wieder bist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007213,
			"completionStepIds": [
				4007213
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007213",
							"2"
						],
						"stepId": 4007213,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Xinyan",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721301,
					"content": "Wir sind wieder zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721302,
					"content": "Soeben scheinen wir durch Zufall das wahre Gesicht des bösen Drachens erblickt zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721303
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721303,
					"content": "Das Gefühl kenne ich nur zu gut. Es gibt immer Leute, die denken, unser Interesse sei Zeitverschwendung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400721304,
					"content": "Huch? Du bist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721305,
					"content": "Ich bin „Frag-mich-nach-der-Richtung Arnold“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721306
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721306,
					"content": "Ich meine, was machst du denn wieder hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721307,
					"content": "Oh, oh, ich schätze, du wirst nach „Hymne des Heiligen Reichs“ Band drei, suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721308
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721308,
					"content": "Da hast du recht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721309
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721309,
					"content": "Meine liebe Dame, du brauchst nichts für mich zu tun. Deine Schönheit ist das größte Geschenk an mich. Ich werde dir hier die Antworten geben, die du suchst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721310
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721310,
					"content": "Der dritte Band der heiligen Texte, der sich im obersten Stockwerk des Schlosses der Kaiserstadt befindet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721311
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721311,
					"content": "Gibt es irgendwelche Schutzmaßnahmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721312
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721312,
					"content": "Oh, selbstverständlich, mein Herr, was für eine alberne Frage ist das? Kein Land würde sein wichtigstes Buch ungeschützt lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721313
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721313,
					"content": "Das bedeutet, dass dort immer noch Nachtraben Wache halten werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721314
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721314,
					"content": "Es ist die höchste Ehre eines Vasallen, über die heiligen Texte zu wachen. Aber was soll’s, ich glaube, diese Dame will die heiligen Texte nur lesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721315
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721315,
					"content": "Du hast ein so charmantes Antlitz und bist reich an Weisheit. Deine Kameraden sehen auch wie Helden aus. Wenn ihr es seid, solltet ihr in der Lage sein, die Geschichten unserer heiligen Texte zu lesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721316
					],
					"speakerTitle": "Arnold"
				},
				{
					"id": 400721316,
					"content": "Die Heldentaten Ihrer Hoheit, die der Große Historiograf, Oz, überliefert hat, sind zu einem Wahrzeichen des Immernachtreichs geworden. Jedes Mal, wenn ich dieses Buch lese, freue ich mich darauf, dass Ihre Hoheit glücklich ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arnold"
				}
			]
		},
		{
			"id": 4007218,
			"completionStepIds": [
				4007218
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007218",
							"2"
						],
						"stepId": 4007218,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Leon",
					"Kaedehara Kazuha",
					"Xinyan",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721801,
					"content": "Entschuldigt, dass ihr mich immer wieder in einem solchen Schlamassel erwischt. Ich schätze, es ist noch zu früh für mich, mich als fähigen Nachtrabenritter mit meinen derzeitigen Fähigkeiten zu tarnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721802
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721802,
					"content": "Sich zu tarnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721803
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721803,
					"content": "Ich schäme mich zuzugeben, dass ich nicht wirklich ein Ritter bin, sondern ein frischgebackener Schauspieler, der gerade einen neuen Job gefunden hat und sich nun darauf vorbereitet, die Rolle eines Ritters in einer Theatergruppe zu spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721804
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721804,
					"content": "Worauf soll man da stolz sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721805,
					"content": "Nein, nein, du verstehst das falsch. Im Immernachtreich ist das Theater eine sehr wichtige Kultur. Eine gute Performance ist für Ihre Hoheit die größte Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721806
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721806,
					"content": "Ach so, das ist also deine Heimatkultur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721807
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400721807,
					"content": "Ganz genau! Ich bin also froh, dass ich den Ritter spielen darf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721808
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721808,
					"content": "Warum gefällt Ihrer Hoheit das Theater?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721809
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721809,
					"content": "Ihre Hoheit sagte: „Veranstalte ein Fest für mich und zieh hinaus in die Wildnis, um ein Stück vorzuführen. Verneige dich vor mir und biete mir reine Fantasien im Tausch gegen den Ruhm der Ewigen Nacht.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721810
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721810,
					"content": "Ich denke, es muss daran liegen, dass Ihre Königliche Hoheit die wahre Kunst versteht und die tiefsten verborgenen Freuden und Sorgen der menschlichen Natur erkennen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721811
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721811,
					"content": "Das Herz des Theaters liegt im Zusammenspiel und in der Zähmung von Emotionen. Wer Komödien liest, hat ein sensibles und gefühlvoll schönes Herz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721812
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721812,
					"content": "... Ah, ich verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721813
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400721813,
					"content": "Vielen Dank für deine Antwort, Herr Ritter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721814
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400721814,
					"content": "Oh, oh, oh! Du ... Du bist bereit, mich einen Ritter zu nennen, vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721815
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721815,
					"content": "Mit diesem Ruhm mache ich mich also auf den Weg zu meinem Schlachtfeld. Wir sehen uns alle wieder, falls ihr es schafft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721816
					],
					"speakerTitle": "Leon"
				},
				{
					"id": 400721816,
					"content": "Wir treffen uns nicht wieder, sei beim nächsten Mal vorsichtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400721817,
					"content": "Ach ja! Bitte erinnert euch an das Mantra, um das Tor zu öffnen: „Auf mein Kommando hebst du deine Flügel und setzt die Segel!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leon"
				}
			]
		}
	]
}