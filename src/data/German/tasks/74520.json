			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745200401,
					"content": "#Oh, du bist es, {NICKNAME}. Ich hätte nicht gedacht, dich hier zu treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200402,
						745200403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200402,
					"content": "Lange nicht gesehen, Eula.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				},
				{
					"id": 745200404,
					"content": "Man könnte es eine Routinepatrouille nennen. Für mich ist es aber eher eine notwendige Aktivität, um in Kampfbereitschaft zu bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200405
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200405,
					"content": "In Mondstadt ist es in letzter Zeit ziemlich friedlich. Es gibt kaum eine Bedrohung, die einen Einsatz des gesamten Freischärlertrupps notwendig machen würde. Die Stimmung in der Truppe ist daher merklich lockerer geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200406
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200406,
					"content": "Eine gute Balance zwischen Arbeit und Entspannung ist auch wichtig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200407
					]
				},
				{
					"id": 745200407,
					"content": "Das mag stimmen, aber als Truppenführerin muss ich stets meine Kampfkraft aufrechterhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200408
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200408,
					"content": "Schließlich werden die Schwerter der Gegner nicht stumpf, nur weil Frieden herrscht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200409,
					"content": "Deshalb gehe ich in den Pausen an einen ruhigen Ort und übe mit dem Schwert, damit ich nicht aus der Übung komme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200410,
						745200411
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200410,
					"content": "Genau der richtige Moment ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200412,
					"content": "Oh? Eine durchaus interessante Anfrage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200413
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200413,
					"content": "Aber ich bin sehr schnell, kann dein Fotoapparat da überhaupt mithalten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200414,
						745200415
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200414,
					"content": "Mach es einfach in deinem üblichen Tempo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200416,
					"content": "Gut. Da du so viel Selbstvertrauen hast, gebe ich auch alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200417
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200417,
					"content": "Pass gut auf, denn der Moment, in dem sich die Wellen kräuseln, ist flüchtig wie ein Atemzug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200415,
					"content": "Ich werde mein Bestes geben, kein Problem!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200411,
					"content": "Lass mich ein Foto von dir machen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200403,
					"content": "Bist du hier auf Wachdienst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				}
			]
		}
	]
}