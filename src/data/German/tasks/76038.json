			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380409,
					"content": "(Ob <color=#FFCC33FF>Flins</color> wohl Interesse an Zuckerfiguren hat ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380401
					]
				},
				{
					"id": 760380401,
					"content": "Fräulein Hunajatta. Wenn ich dich um etwas bitten dürfte, würdest du mir eine Zuckerfigur machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380402
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380402,
					"content": "Ja, klar. Und du bist ... Flins, der Ratnik, habe ich recht? Ich glaube, ich habe dich schon mal in unserem Laden gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380403
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380403,
					"content": "Das hast du der Tat. Ich schaue manchmal vorbei, um Vorräte zu kaufen. Es ist eine Ehre und ein Privileg, so in Erinnerung behalten zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380404
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380404,
					"content": "Was den heutigen Tag betrifft, so kam ich zufällig vorbei, als ich Zeuge deiner meisterhaften Zuckerkunstfertigkeit wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380405
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380405,
					"content": "Und nach reiflicher Überlegung habe ich beschlossen, mir von dir eine Figur formen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380406
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380406,
					"content": "Oh, bitte, du brauchst nicht so höflich zu sein. So machst du mich noch ganz verlegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380407
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380407,
					"content": "Warte nur einen Moment, deine Figur kommt gleich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380408
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380408,
					"content": "Hmm. Vielleicht sollten wir etwas Besonderes für unseren guten Ratnik tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
		{
			"id": 7603805,
