			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380101,
					"content": "(Ob <color=#FFCC33FF>Nefer</color> wohl Interesse an Zuckerfiguren hat ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380102
					]
				},
				{
					"id": 760380102,
					"content": "Ich hätte gerne eine Zuckerfigur, Hunajatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380103,
					"content": "Welch Überraschung, dich hier zu sehen, Frau Nefer. Was führt dich heute zu mir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380104
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380104,
					"content": "Ab und an rausgehen und einen Spaziergang machen ist gut für Körper und Geist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380105,
					"content": "Außerdem helfen süße Dinge mit beim Denken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380106,
					"content": "Das höre ich gern! Gib mir eine Minute, ich werde mich umgehend um deine Bestellung kümmern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380107
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380107,
					"content": "Sicher doch. Und übrigens, nimm das Geld hier. Wenn Jahoda das nächste Mal kommt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380108,
					"content": "Soll ich ihr eine größere machen? Oder sie noch süßer machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380109
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380109,
					"content": "... Gib ihr das Geld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760380110,
					"content": "Und sag ihr: „Nefer bezahlt das Doppelte, also sobald du mit dem Herumgammeln fertig bist, geh zurück. Und bring ihr auch eine Zuckerfigur mit, wenn du schonmal dabei bist.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				}
			]
		},
