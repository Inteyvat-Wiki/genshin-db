			"dialogs": [
				{
					"id": 760380508,
					"content": "(Ob <color=#FFCC33FF>Aino</color> wohl Interesse an Zuckerfiguren hat ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380501
					]
				},
				{
					"id": 760380501,
					"content": "Hallo Chefin! Eine Zuckerfigur, bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380502
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380502,
					"content": "Oh, Fräulein Aino! Lange nicht gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380503
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380503,
					"content": "Hehe. Ich bin in die Stadt gerollt, um ein paar Sachen zu reparieren. Ich dachte, ich schaue mal vorbei und hole mir ein paar Süßigkeiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380504
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380504,
					"content": "Außerdem ist Ineffa nicht da, also ... mach mir ein paar Extras, ja? Und besonders süß, bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380505
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380505,
					"content": "Na gut, klar ... Aber denk daran, dir nach dem Essen die Zähne zu putzen, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380506
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380506,
					"content": "Ja, ja, ich weiß, ich weiß. Ich putze mir immer die Zähne, wenn ich Süßigkeiten gegessen habe! Meine Zähne sind einwandfrei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380507
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380507,
					"content": "Haha ... Dann, warte einen Augenblick ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
