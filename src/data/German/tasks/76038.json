					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760381109,
					"content": "(Ob <color=#FFCC33FF>Linnea</color> wohl Interesse an Zuckerfiguren hat ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381101
					]
				},
				{
					"id": 760381101,
					"content": "Oh, hallo, Fräulein Linnea! Bist du wieder hier, um Zuckerskulpturen für Lumi zu kaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381102
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381102,
					"content": "Ja, Lumi liebt deine Zuckerfiguren über alles. Sie bringt es einfach nicht übers Herz, sie zu essen. Immer wenn sie eine bekommt, leckt sie nur kurz daran und gibt sie mir dann zur Aufbewahrung zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381103
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381103,
					"content": "Aber da eine Zuckerfigur aus Zucker besteht ... schmilzt sie mit der Zeit trotzdem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381104
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381104,
					"content": "Also muss ich dich leider bitten, Fräulein Hunajatta, noch eine für Lumi anzufertigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381105
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381105,
					"content": "Kein Problem! Einen Moment bitte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381106
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381106,
					"content": "(Wie niedlich Lumi ist ... Ich würde sie so gerne streicheln! Aber das wäre wohl unhöflich. Ach, egal ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381107
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381107,
					"content": "Bitte sehr, Linnea. Fertig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381108
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381108,
					"content": "Danke! Lumi, deine Zuckerfigur ist fertig. Möchtest du, dass ich ... Oh, sie ist eingeschlafen. Dann gebe ich sie ihr später.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		}
