			"dialogs": [
				{
					"id": 760381001,
					"content": "(Ob <color=#FFCC33FF>Illuga</color> wohl Interesse an Zuckerfiguren hat ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381002
					]
				},
				{
					"id": 760381002,
					"content": "Na ja, wenn ich schon mal hier bin ... Hallo, eine Zuckerfigur, bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381003
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381003,
					"content": "Oh! Könntest du sie etwas kleiner machen? Ich habe Sorge, dass mir etwas dazwischenkommt und ich sie nicht auf einmal aufessen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381004
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381004,
					"content": "Gar kein Problem! Keine Sorge – auch die kleinen schmecken genauso gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381005
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381005,
					"content": "Ihr Lichthüter habt aber auch wirklich alle Hände voll zu tun ... Da bleibt ja sogar eine Zuckerfigur auf der Strecke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381006
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381006,
					"content": "Ähm ... haha ... Na ja, es sind nicht nur die Aufgaben. Manchmal liegt es auch daran, dass ich jemandem begegne, der Hilfe braucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381007
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381007,
					"content": "Du weißt ja, wie das ist – angeknabberte Zuckerfiguren lassen sich nur schwer aufbewahren. Das Einzige, was ich tun kann, ist, sie in ein Tuch zu wickeln und in meine Tasche zu stecken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381008
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381008,
					"content": "Aber wenn ich dann mit dem Helfen fertig bin und sie wieder heraushole, ist die ganze Figur schon geschmolzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381009
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381009,
					"content": "Verstehe ... Lass mich mal überlegen. Eine kleine Zuckerfigur ... hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381010
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381010,
					"content": "Ich hab’s! Ich kann eine kleine Zuckerfigur mit mehreren Geschmacksrichtungen machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381011
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381011,
					"content": "Diese Geschmacksrichtung nach unten ... und diese hier nach oben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381012
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381012,
					"content": "So! Bitte sehr, eine kleine Zuckerfigur mit mehreren Geschmacksrichtungen! Ist das so nach deinem Geschmack, werter Kunde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381013
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381013,
					"content": "Ah, sie ist perfekt! Danke, Fräulein Hunajatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381014
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381014,
					"content": "Ach, gern geschehen. Ich kann euch Lichthütern zwar nicht bei eurer Arbeit helfen ... aber wenn ihr Zuckerfiguren haben wollt, kann ich euch so viele machen, wie ihr möchtet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381015
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381015,
					"content": "Das ist unsere Aufgabe. Du bist zu gütig, Fräulein Hunajatta ... Ich muss dann auch wieder los, die Arbeit wartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381016
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381016,
					"content": "Also, mach’s gut! Und wenn du das nächste Mal eine Zuckerfigur haben möchtest, komm einfach direkt vorbei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
