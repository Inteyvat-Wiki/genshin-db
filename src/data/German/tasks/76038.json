			"dialogs": [
				{
					"id": 760380701,
					"content": "(Ob <color=#FFCC33FF>Jahoda</color> wohl Interesse an Zuckerfiguren hat ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380702
					]
				},
				{
					"id": 760380702,
					"content": "Chefin, ich hätte gern eine große Portion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380703
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380703,
					"content": "Jahoda, du bist ja nicht zum ersten Mal hier. Du solltest wissen, dass meine Zuckerfiguren immer die gleiche Größe haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380704
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380704,
					"content": "Ach, komm schon. Heute war so ein toller Tag! Also los, mach mir eine Größere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380705
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380705,
					"content": "Ein toller Tag? Lief die Mission gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380706
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380706,
					"content": "Hehe, na klar! Es war eine einfache Begleitmission, die habe ich in Nullkommanichts erledigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380707
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380707,
					"content": "Die Ware und der Auftraggeber sind völlig unversehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380708
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380708,
					"content": "Genug geredet! Mach mir schnell eine Große. Ich nehme sie dann mit nach Hause zum Essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380709
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380709,
					"content": "Kein Problem, warte kurz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
