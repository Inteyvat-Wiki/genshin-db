			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hunajatta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380310,
					"content": "(Ob <color=#FFCC33FF>Lauma</color> wohl Interesse an Zuckerfiguren hat ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380301
					]
				},
				{
					"id": 760380301,
					"content": "Ich hätte gerne ein paar davon, Fräulein Hunajatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380302,
					"content": "Kein Problem, Fräulein Lauma. Haben den Kindern die Zuckerfiguren gefallen, die du letztes Mal mitgebracht hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380303
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380303,
					"content": "Hehe, ja, sie haben ihnen gefallen. Einige von ihnen ließen sich sogar erst dazu überreden, ihre schönen Leckereien zu ruinieren, als sie schon fast weggeschmolzen waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380304,
					"content": "Verstehe ... Nächstes Mal bringe ich mein Werkzeug mit und komme zu euch allen. Damit die Kinder sehen können, wie sie hergestellt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380305
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380305,
					"content": "Ah, das wäre toll. Die Kinder werden sich sicher freuen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380306,
					"content": "Oh, sieh mich an, ich habe mich wieder einmal im Plaudern verloren. Ich werde deine Zuckerfiguren machen gehen. Sobald sie fertig sind, lasse ich sie zu den Nachkommen des Frostmonds bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380307
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380307,
					"content": "Aber vorher ... Hehe, mir ist gerade eine Idee gekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380308
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380308,
					"content": "Einen Moment, Fräulein Lauma. Ich werde etwas Besonderes für dich zaubern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
		{
