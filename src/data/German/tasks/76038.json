			},
			"dialogs": [
				{
					"id": 760380601,
					"content": "(Ob <color=#FFCC33FF>Ineffa</color> wohl Interesse an Zuckerfiguren hat ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380602
					]
				},
				{
					"id": 760380602,
					"content": "Entschuldigung. Könntest du mir bitte eine Zuckerfigur machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380603
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380603,
					"content": "Klar. Für Fräulein Aino, nehme ich an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380604
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380604,
					"content": "Negativ. Aino wollte, dass ich komme und mir selbst eine schöne Zuckerfigur kaufe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380605
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380605,
					"content": "Ihrer Meinung nach ist dies Teil meines Trainings für „soziale Aktivitäten“, was das Einkaufen in Zukunft bequemer machen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380606
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380606,
					"content": "Ach so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380607
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380607,
					"content": "Ich habe es allerdings nicht verstanden. Schließlich sind meine Anforderungen an die Zuckeraufnahme nicht so hoch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380608
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380608,
					"content": "Und ich vermute, dass Aino diese Figur vielleicht heimlich essen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380609
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380609,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380610
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380610,
					"content": "Fräulein Hunajatta, könntest du mir eine Zuckerfigur in kleinerem Ausmaß machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380611
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380611,
					"content": "Aino liebt Süßigkeiten, aber ich glaube, sie sollte etwas weniger essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380612
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380612,
					"content": "Keine Sorge, ich habe das im Griff ... Also, lass mich mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
