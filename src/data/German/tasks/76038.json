					"id": 760380201,
					"content": "Ich hätte gern eine Zuckerfigur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380202
					]
				},
				{
					"id": 760380202,
					"content": "So, bitte sehr. Sobald sie offen ist, iss sie schnell, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
