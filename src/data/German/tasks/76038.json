			"dialogs": [
				{
					"id": 760380901,
					"content": "(Ob <color=#FFCC33FF>Columbina</color> wohl Interesse an Zuckerfiguren hat ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380902
					]
				},
				{
					"id": 760380902,
					"content": "Zuckerfiguren ... Ich glaube, ich habe das schon mal probiert. Könntest du eine für mich machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380903
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760380903,
					"content": "Kein Problem! Warte einen Moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380904
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380904,
					"content": "(Hmm ... Habe ich dieses Mädchen schon mal irgendwo in der Stadt gesehen ...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380905
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380905,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380906
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760380906,
					"content": "(Oh! Sie sieht so erwartungsvoll aus ... Ah, nachdenken, nachdenken! Welcher Stil würde ihr am besten stehen?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380907
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380907,
					"content": "(Folge deinem Instinkt ... hör auf dein Bauchgefühl ... gut, gut! Ich schaff das schon!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380908
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380908,
					"content": "Ähm ... ich bin fertig. Schau mal – gefällt es dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380909
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380909,
					"content": "Sieht super aus. Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380910
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760380910,
					"content": "Hehe, schön, dass es dir gefällt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380911
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380911,
					"content": "(Ja, mein Instinkt war richtig – dieser leichte, luftige Stil passt zu so einem leichten, luftigen Kind!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380912
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380912,
					"content": "Mm, sie ist auch wirklich lecker ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380913
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760380913,
					"content": "Könntest du noch zwei machen? Ich möchte sie den Kuuhenki mitbringen, damit sie auch probieren können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380914
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760380914,
					"content": "Für ... die Kuuhenki auch? Nun ja, das ginge schon, aber ich habe nicht genug Zutaten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380915
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380915,
					"content": "Dann komme ich morgen wieder und bringe sie mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380916
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760380916,
					"content": "Kein Problem ... Bis dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
