			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756570201,
					"content": "#{NICKNAME}! Hier, hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570202,
					"content": "Erinnerst du dich noch an diesen Ort? Von hier aus hat unsere Reise begonnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570203,
					"content": "Oh, Paimon kann gar nicht glauben, dass wir schon an so vielen Orten waren! Allein der Gedanke daran macht Paimon irgendwie emotional. Paimon möchte jetzt sogar ein Gedicht schreiben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570204,
						756570205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570204,
					"content": "Bitte gewähre uns deine Verse! O, Paimon, Dichterin aller Dichterinnen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570207
					]
				},
				{
					"id": 756570205,
					"content": "Pff!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570206
					]
				},
				{
					"id": 756570206,
					"content": "Unterbrich Paimon nicht ... Lass Paimon mal nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570207,
					"content": "O Teyvat, du bist so breit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570208,
					"content": "So viele Orte haben wir besucht, aber noch nicht alle haben wir bereist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570209,
						756570210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570209,
					"content": "(Schweigen)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570210,
					"content": "Sag nicht, das war als Reim gedacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570211
					]
				},
				{
					"id": 756570211,
					"content": "O ... O ...! Ooh, mehr fällt Paimon nicht ein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570212,
						756570214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570212,
					"content": "Hahaha ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570213
					]
				},
				{
					"id": 756570214,
					"content": "Wolltest du beschreiben, wie schwierig unsere Reise war?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570215
					]
				},
				{
					"id": 756570213,
					"content": "Ja, ja, lach, wie du willst. Paimon hat sich schon daran gewöhnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570215,
					"content": "Genau! Das ist das Thema des Gedichts. Hehe, du verstehst Paimon eigentlich ganz gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570216,
					"content": "Aber mal im Ernst ... Wenn man zu lange unterwegs ist, vergisst man leicht, wo man angefangen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570217,
					"content": "Zum Beispiel weiß Paimon inzwischen nicht mehr genau, wie süß mariniertes Hühnchen schmeckt ... und das war eines von Paimons Lieblingsgerichten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570218,
					"content": "Deshalb hat Paimon die Alben überhaupt gekauft ... um Fotos von den Orten zu machen, an denen wir waren, und von den Menschen, die wir getroffen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570219,
					"content": "Sehen wir diese Art von Handlung nicht immer wieder in kurzen Erzählungen und Filmen? Wenn die Protagonisten an den Ort zurückkehren, an dem die Geschichte begann, ist das Ende meist nahe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570220,
					"content": "Der Grund, warum Paimon hier Fotos machen will, ist nicht, um die Atmosphäre emotional zu machen, sondern in der Hoffnung, dass wir nicht vergessen, von wo aus wir aufgebrochen sind, und so ohne Zögern weitergehen können, um uns von der Vergangenheit zu trennen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570221,
						756570222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570221,
					"content": "Hast du meine Gespräche mit Kazuha belauscht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570224
					]
				},
				{
					"id": 756570222,
					"content": "Paimon hat sich weiterentwickelt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570223
					]
				},
				{
					"id": 756570223,
					"content": "Na ja ... Paimon hat ein bisschen zugehört, als du mit Kazuha geplaudert hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570224,
					"content": "Argh! Die gute Atmosphäre, die Paimon gerade geschaffen hat, ist weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570225,
					"content": "Keine Sorge, ich verstehe, was du meinst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570226
					]
				},
				{
					"id": 756570226,
					"content": "Wir werden weitergehen, und zwar zusammen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570227
					]
				},
				{
					"id": 756570227,
					"content": "Hehe, solange du verstehst, was Paimon meinte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570228,
					"content": "Also gut! Dein Modell für dieses Foto wird Teyvats beste Reiseführerin sein! Nun, welche Pose soll Paimon einnehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570229,
						756570230,
						756570231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756570101,
					"content": "He, Moment mal! Wo ist der Fotoapparat, den Paimon dir geliehen hat? Sag Paimon nicht, dass du ihn verloren hast! Schau in der Tasche nach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
