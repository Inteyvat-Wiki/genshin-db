					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756570232
					]
				},
				{
					"id": 756570232,
					"content": "Oh, Klar! ... Und, was denkst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756570233,
						756570235,
						756570237
					],
					"speakerTitle": "Paimon"
				},
				{
