			},
			"dialogs": [
				{
					"id": 730310501,
					"content": "Das Utsava-Fest war einst ein Teil meiner Geschichte ... könnte ich es nach all der Zeit tatsächlich wieder „selbst“ erleben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
		},
		{
			"id": 7303106,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
