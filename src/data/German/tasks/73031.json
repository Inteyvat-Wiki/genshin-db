				},
				{
					"id": 730310308,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310309,
					"content": "Die Vorbereitungen für das Utsava-Fest sollten schon sehr bald abgeschlossen sein! Ich bin sooo gespannt darauf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310310,
						730310311
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310310,
					"content": "Ich frage mich, wie es Rana geht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310315
					]
				},
				{
					"id": 730310315,
					"content": "#Ja. Wir sollten mal bei Rana vorbeischauen, {NICKNAME}. Vielleicht geht es ihr ja schon besser! Und dann kommen wir mit ihr zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310316,
						730310317,
						730310318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310316,
					"content": "Gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310320,
					"content": "Ich werde bald auch nach Arana sehen. Ihr zwei könnt schon mal vorgehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310321
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310321,
					"content": "#Wir sehen uns später, Nara {NICKNAME} und Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310317,
					"content": "Hoffentlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310318,
					"content": "Sei lieber nicht zu optimistisch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310319
					]
				},
				{
					"id": 730310319,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310311,
					"content": "Ich kann es auch kaum abwarten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310312
					]
				},
				{
					"id": 730310312,
					"content": "Ja! Paimon fragt sich, wie es im Vergleich zu Festen an anderen Orten sein wird. Wie wird die Atmosphäre sein? Paimon freut sich, zusammen mit Freunden auf ein Fest zu gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310314,
					"content": "... Wenn doch nur Rana auch hier wäre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310306,
					"content": "Oh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310307
					]
				}
			]
		},
