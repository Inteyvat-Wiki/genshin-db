			},
			"dialogs": [
				{
					"id": 730310101,
					"content": "Araja, Arama, wir sind zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310102,
					"content": "#Ich bin froh, Nara {NICKNAME} und Paimon wiederzusehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310103
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310103,
					"content": "#Oh, ihr seid zurück. Alle reden davon, wie der sehr große und starke Nara {NICKNAME} ihnen sehr geholfen hat. Alle sind sehr froh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310104
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310104,
					"content": "#Es ist immer Grund zur Freude, wenn einem jemand hilft! Nicht wahr, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310105,
						730310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310105,
					"content": "Sehr erfreut!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				},
				{
					"id": 730310107,
					"content": "Nein. Sie sind froh, weil sie neue Freunde gemacht haben. Aranakin, Aranaga und Aragaru können sich zwar an nichts erinnern, doch der Wald vergisst nichts. Die Geschichte wird niemals vollständig verloren gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310108
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310108,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310109,
					"content": "Die Vorbereitungen für das Utsava-Fest sollten schon sehr bald abgeschlossen sein! Es braucht nur ein bisschen mehr Zeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310110
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310110,
					"content": "#Ja, wir haben es Nara {NICKNAME} und Paimon zu verdanken, dass das Fest bald beginnen wird. Ich freue mich schon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310106,
					"content": "Oh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				}
			]
		},
