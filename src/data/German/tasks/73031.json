				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730310601,
					"content": "Rana scheint ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310602,
					"content": "Paimon würde gerne sagen, dass sie einen „süßen Traum“ hat, doch das klingt irgendwie nicht besonders gut ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310603,
					"content": "(Ein vages Bild von etwas erscheint in der „Blase“ heraus, in die Rana eingehüllt ist ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310604
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730310604,
					"content": "(Tauche ein in das Bild ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310605
					]
				},
				{
					"id": 730310605,
					"content": "Du befindest dich in einem Dschungel. Alles um dich herum ist riesig und tief, aber du fühlst dich sehr wohl.\\nDer gelegentlich durch die Blätter hindurchfallende Sonnenschein schimmert wie Goldfolie und das Gras, das so hoch wie du selbst ist, lacht mit leiser Stimme und berührt beim Vorbeigehen sanft deine Hand ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310606
					]
				},
				{
					"id": 730310606,
					"content": "Wie du so dem Brummen der Bäume im Wind und dem Musizieren des fließenden Wassers lauschst, hörst du plötzlich ein trauriges Weinen. Folge dem Geräusch und du findest ein kleines Menschlein.\\nAls ob sie vom Weinen völlig erschöpft wäre, schläft sie auf dem Gras. Du gehst auf sie zu und singst ihr eine beruhigende Weise ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310607
					]
				},
				{
					"id": 730310607,
					"content": "#... He! {NICKNAME}, alles in Ordnung mit dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310608,
					"content": "Na dann ist ja gut ... Du hast ausgesehen, also ob du gleich in Ohnmacht fallen würdest ... Paimon hat sich große Sorgen gemacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310609,
					"content": "#Nara {NICKNAME}! Ihr seid gekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310610
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310610,
					"content": "Boah! Du hast Paimon einen Schrecken versetzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310611,
					"content": "Wah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310612,
						730310613
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310612,
					"content": "Wah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310614
					]
				},
				{
					"id": 730310614,
					"content": "Oh mann! Warum müsst ihr Aranara auch immer so unheimlich sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310615,
					"content": "Warum schreit das weißhaarige Schwebedings plötzlich „Wah“!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310616
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310616,
					"content": "Paimon ist Paimon und nicht weißhaariges Schwebedings!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310617,
					"content": "Arana ist im Boden, um Ararakalaris Stärke zu erhalten. Auf diese Weise wird Nara Rana nicht verwelken. Aber um wieder kräftig zu werden, benötigt sie die Bija.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310618
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310618,
					"content": "#So ist das also. Aber, was ist eben mit {NICKNAME} geschehen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310619,
					"content": "(Du beschreibst deine Vision ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310620
					]
				},
				{
					"id": 730310620,
					"content": "Dabei dürfte es sich um Aranas Erinnerungen handeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310621
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310621,
					"content": "Erinnerungen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310622,
					"content": "Paimon ist sich nicht sicher. Erinnerungen und Träume sind die Kraft der Aranara und ihre wertvollsten Dinge. Mit Erinnerungen und Träumen kann Arana das Ararakalari verwenden, um Nara und Aranara in Not zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310623
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310623,
					"content": "#Manche Nara können die Erinnerungen im Ararakalari fühlen. Nara {NICKNAME} zählt auch dazu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310624
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310624,
					"content": "Das klingt ganz so, als ob das Ararakalari eine überaus wichtige Sache wäre! Es war dann wohl auch Arana, die damals in der Höhle Iotham mit dem Ararakalari beschützt hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310625,
					"content": "Es war Arana. Nara Iotham, Nara Kavus und Nara Sudabeh sind allesamt Aranas Freunde. Und daher beschützt sie Arana auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310626
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310626,
					"content": "Sie kommen öfter in den Wald, um mit Arana zu spielen. Arana bringt ihnen Dinge über den Wald bei und lehrt sie die Sprache der Blumen und Gräser. Sie sind Freunde von Arana, genau wie Nara Rana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310627
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310627,
					"content": "Über die vermissten Kinder ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310628
					]
				},
				{
					"id": 730310628,
					"content": "Ja! Da du es gerade erwähnst, vor Iotham sind auch Kavus und Sudabeh verschwunden ... doch später wurden sie wieder nach Vimara zurückgebracht. War das auch Arana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310629,
					"content": "Ja. Arana hat entdeckt, dass böse Nara und Nara Valuka sie entführt haben. Und als die bösen Nara einmal nicht gut aufgepasst haben, hat sie die Gelegenheit genutzt und Nara Kavus und Nara Sudabeh bei der Flucht geholfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310630,
						730310632
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310630,
					"content": "So war das also ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310631
					]
				},
				{
					"id": 730310631,
					"content": "Hmm ... aber warum können sie sich daran nicht mehr erinnern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310633,
					"content": "Arana hat die kleinen Nara in einen Traum gesendet und in dem Traum hat sie sie von allen bösen Erinnerungen befreit. Auf diese Weise werden sie bei ihrem Wachstum nicht zu bösen Dingen verleitet, genau wie kleine Setzlinge, die unbeeinträchtigt zu starken Bäumen heranwachsen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310634
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310634,
					"content": "Andernfalls hätten die kleinen Nara ständig Angst gehabt. Und wer ständig Angst hat, der glaubt schnell an die Macht der „Angst“. So hätten sie einmal aufgewachsen zu bösen Nara werden können, die anderen Angst einjagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310635
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310635,
					"content": "Sie sind Aranas Freunde und daher will Arana nicht, dass sie zu bösen Nara werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310636,
						730310638,
						730310640
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310636,
					"content": "Verständlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310637
					]
				},
				{
					"id": 730310637,
					"content": "Sie werden sicher zu ganz fantastischen Erwachsenen werden! Ah, hat Arana eigentlich irgendwelche Hinweise auf die bösen Nara gefunden, die die beiden entführt haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310641,
					"content": "Arana wird ihnen das nie verzeihen. Diese bösen Nara sind allesamt keine Kinder des Waldes. Sie kommen an der Seite von Nara Valuka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310642
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310642,
					"content": "In Vimara gibt es einen sonderbaren Nara, der kein Kind des Waldes, sondern ein Kind des Schnees ist. Aber er scheint ein guter Nara zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310643
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310643,
					"content": "Weil er oft mit den kleinen Nara zusammen ist, reden sie häufig über ihn. Aber Arana hat gesehen, wie er mit den bösen Nara über die Aranara gesprochen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310644
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310644,
					"content": "In Vimara ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310645,
						730310646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310645,
					"content": "Ein Komplize der Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310647
					]
				},
				{
					"id": 730310647,
					"content": "Wie ist das möglich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310648
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310648,
					"content": "Herrje ... Paimon will gar nicht erst daran denken. Die Einwohner von Vimara sollten eigentlich wie eine große Familie sein ... Doch dieser Kerl ist dafür verantwortlich, was Rana widerfahren ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310649,
						730310650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310649,
					"content": "Wir müssen ihn uns schnappen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310651
					]
				},
				{
					"id": 730310651,
					"content": "Richtig. Wir müssen ihn auf jeden Fall erwischen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310652
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310652,
					"content": "#Nara {NICKNAME} und Paimon, ihr müsst mir das versprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310653
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310653,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310654
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310654,
					"content": "Versprecht mir, dass ihr den bösen Nara bestraft, sodass Nara Iotham, Nara Kavus, and Nara Sudabeh ohne Angst zu großen Nara aufwachsen können, als wären sie kleine Bäume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310655,
						730310656
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310655,
					"content": "Gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310657
					]
				},
				{
					"id": 730310657,
					"content": "Nara Rana ist zu einem großen gesunden Nara herangewachsen und kann daher Arana nicht mehr sehen. Aber das spielt keine Rolle. Arana ist sehr glücklich, dass es ihr gut geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310658
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310658,
					"content": "Ich habe schon sehr, sehr lange nicht mehr mit Nara Rana gespielt. Seither sind so viele Sonnen auf- und wieder untergegangen, so viele Monde am Himmel erschienen und so viele Früchte an Bäumen gewachsen, nur um dann wieder in die Erde zurückzukehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310659
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310659,
					"content": "Nara Rana wurde immer größer. Am Anfang war sie noch in etwa so groß wie Arana. Doch dann wuchs sie auf die Höhe eines kleinen Bäumchens heran. Und dann ist sie nicht mehr gekommen, um mit Arana zu spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310660
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310660,
					"content": "Arana hat ihr viele Geschichten über den Wald erzählt. Sternpilze sind die auf die Erde gefallenen Spiegelbilder der Sterne am Firmament. Wer den Nilotpala-Lotos erblühen sieht, dem wird bis zum nächsten Mondaufgang das Glück hold sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310661
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310661,
					"content": "Arana wird Nara Iotham und seinen Freunden die gleichen Dinge lehren, sodass sie gesund aufwachsen, genau wie Nara Rana. Ah, aber sie dürfen nicht wie Nara Rana in Marana laufen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310662
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310662,
					"content": "Werden sie alles über den Wald vergessen, wenn sie groß geworden sind, genau wie Rana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310663
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310663,
					"content": "Auch Nara Iotham, Nara Kavus, und Nara Sudabeh werden aufwachsen. Aber es macht nichts, dass sie alles vergessen, denn der Wald vergisst nichts und nichts wird je verloren gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310664
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310664,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310665
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310665,
					"content": "Nichts wird je verloren gehen. Alles, was schön ist, bleibt erhalten. Und alles Leid wird zu einem Nährstoff für etwas Schönes werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310666
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310666,
					"content": "#Arana! Nara {NICKNAME} und Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310667
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310667,
					"content": "Arama! Arana hat dich schon lange nicht mehr gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310668,
						730310671
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310668,
					"content": "Paimon, wo bleibt dein berühmtes „Waaah“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310669
					]
				},
				{
					"id": 730310669,
					"content": "Pff, so leicht lässt sich Paimon doch nicht aus der Ruhe bringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310670
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310670,
					"content": "Arama, bist du gekommen, um uns zum Utsava-Fest in Vanarana zu holen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310672
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310672,
					"content": "#Ja! Die Vorbereitungen sind abgeschlossen und alle warten nur noch auf Nara {NICKNAME} und Paimon. Lasst uns aufbrechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310673
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310673,
					"content": "Großartig! Das Utsava-Fest! Aber, Arana, kommst du nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310674
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310674,
					"content": "Nein, Arana kommt nicht mit. Wenn Arana zu lange fort bleibt, dann könnte das Ararakalari versagen und dann wäre Nara Rana in Gefahr. Daher kommt Arana nicht zum Utsava-Fest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310675
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310675,
					"content": "Wie kann das sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310676
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310676,
					"content": "#Keine Sorge. Wenn Nara {NICKNAME} und Paimon glücklich sind, dann sind auch Arana und Arama und alle in Vanarana glücklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310677
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310677,
					"content": "Arana, die Bija braucht deine Kraft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310678
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310678,
					"content": "Wenn die Zeit kommt, wird Arana bereit sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310679
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310679,
					"content": "#Ah, richtig. Nara {NICKNAME}, das ist für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310680
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310680,
					"content": "Eine kleine Blume ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310681
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310681,
					"content": "Ja. Bitte pass gut auf sie auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310682,
						730310683
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310682,
					"content": "Ich werde sie gut aufbewahren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310684
					]
				},
				{
					"id": 730310684,
					"content": "#Danke, Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310685
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310685,
					"content": "#Also gut, dann lasst uns zurückkehren, Nara {NICKNAME} und Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310683,
					"content": "Gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310684
					]
				},
				{
					"id": 730310671,
					"content": "Sollen wir für das Utsava-Fest zurückkehren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310672
					]
				},
				{
					"id": 730310656,
					"content": "Ich werde mein Möglichstes tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310657
					]
				},
				{
					"id": 730310650,
					"content": "Wir werden ihn erwischen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310651
					]
				},
				{
					"id": 730310646,
					"content": "Gibt es jemanden, der den Kindern Böses will?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310647
					]
				},
				{
					"id": 730310638,
					"content": "Hoffentlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310639
					]
				},
				{
					"id": 730310639,
					"content": "Sie werden sicher zu ganz fantastischen Erwachsenen werden! Ah, hat Arana eigentlich irgendwelche Hinweise auf die bösen Nara gefunden, die die beiden entführt haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310640,
					"content": "Über die bösen Nara ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310641
					]
				},
				{
					"id": 730310632,
					"content": "Über den Gedächtnisverlust der Kinder ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310633
					]
				},
				{
					"id": 730310613,
					"content": "Ich habe das Gefühl, dieses Bild schon einmal gesehen zu haben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310614
					]
				}
			]
		},
		{
			"id": 7303107,
