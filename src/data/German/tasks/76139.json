			"dialogs": [
				{
					"id": 761390101,
					"content": "Im Verlagswesen verdient man kaum Geld, vielleicht sollte ich mich nach neuen Investitionsmöglichkeiten umsehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390102
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390102,
					"content": "Ich würde gern die Investitionspapiere sehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390103
					]
				},
				{
					"id": 761390103,
					"content": "Also gut, zweitausend Mora für ein Investitionspapier. Und du kannst einmal wöchentlich die Investitionserträge einsammeln. Hehe, in diesem kleinen Beutel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390104
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390104,
					"content": "... Ach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390105
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390105,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390106
					]
				},
				{
					"id": 761390106,
					"content": "N... Nein, nichts ... Ich wusste nicht, dass auch Frau Nefer hier ist. W... Willst du auch ein Investitionspapier kaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390107
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390107,
					"content": "Nein, ich bin nur mit meinem Freund hier vorbeigekommen, um mich umzuschauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390108,
					"content": "Ich habe gehört, dass dein Investitionsgeschäft ziemlich gut läuft, und als ich heute hierherkam, habe ich gesehen, dass dem tatsächlich so ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390109,
					"content": "Geht so, geht so, hahaha ... Es ist nur ein kleines Geschäft, reicht gerade zum Leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390110
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390110,
					"content": "Kann man damit echt Geld verdienen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390111
					]
				},
				{
					"id": 761390111,
					"content": "Na klar, Herr Dhabit ist ein ausgezeichneter Geschäftsmann. Wer mit ihm investiert, macht bestimmt keinen Verlust.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390112,
					"content": "J... Ja ... Ja ... hahaha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390113
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390113,
					"content": "Na dann mal sehen, ob ich heute Glück habe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390114
					]
				},
				{
					"id": 761390114,
					"content": "Heute! Genau heute hast du unser brandneues kurzfristiges Investitionspapier gekauft! Gewinn oder Verlust wird sofort abgerechnet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390115
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390115,
					"content": "Warum hat Paimon das Gefühl, dass du dir das gerade ausgedacht hast ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761390116,
					"content": "Hm ... W... Wie auch immer, danke dir für den Kauf des kurzfristigen Investitionspapiers!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390117
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390117,
					"content": "Hier, nimm deinen Investitionsertrag entgegen und pass gut drauf auf. Und einen wunderschönen Tag noch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390118,
						761390119
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390118,
					"content": "Na ja ... Wie auch immer, Geld verdienen ist doch was Gutes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390120
					]
				},
				{
					"id": 761390120,
					"content": "Wirklich? Hehehe ... dann kauf Paimon eine in Vogelform, die mag Paimon nämlich am liebsten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761390121,
					"content": "Dann verabschiede ich mich auch. Herr Dhabit, du bist wirklich ein ehrlicher Kaufmann. Ich wünsche dir viel Erfolg mit deinem Geschäft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390122
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390122,
					"content": "Danke für deine netten Worte, Frau Nefer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390123
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390123,
