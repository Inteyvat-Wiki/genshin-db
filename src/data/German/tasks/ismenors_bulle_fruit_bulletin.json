					"speakerTitle": "Ismenor"
				},
				{
					"id": 746560101,
					"content": "Wegen der Blasenmandarinen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746560102
					]
				},
				{
					"id": 746560102,
					"content": "#{M#Mein junger Freund}{F#Meine junge Freundin}, bringst du die Blasenmandarinen? Gib mir ein paar ab, wir können sie essen, während wir plaudern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746560103
					],
					"speakerTitle": "Ismenor"
				},
				{
					"id": 746560103,
					"content": "Skulpturen sind stumme Gedichte. Mit leerem Magen kann man sie nicht genießen. Das hat mir ein Duellant beim letzten Duell seines Lebens gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746560106,
						746560104
					],
					"speakerTitle": "Ismenor"
				},
				{
					"id": 746560106,
					"content": "Ich habe die Blasenmandarinen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746560104,
					"content": "Ich bin noch nicht soweit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746560105
					]
				},
				{
					"id": 746560105,
					"content": "Ganz wie ich es von anderen hörte, habe ich das Geld vorbereitet, mit dem ich mich bei dir für die Blasenmandarine revanchieren möchte. Wie es nun aussieht, sollte ich wohl warten, bis du bereit bist, bevor ich es dir gebe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ismenor"
				}
			]
		},
