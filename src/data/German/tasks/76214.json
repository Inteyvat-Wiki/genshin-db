				]
			},
			"dialogs": [
				{
					"id": 762140301,
					"content": "#Wuff? Was ist los, {M#goldener Reisender}{F#goldene Reisende}? Gibt es etwas, bei dem ich dir helfen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140302
					],
					"speakerTitle": "„Fräulein Damen-Pudel“"
				},
				{
					"id": 762140302,
					"content": "Du hast Fräulein Damen-Pudel die Einladung von Herrn Graufell zur Teegesellschaft überbracht ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140303
					]
				},
				{
					"id": 762140303,
					"content": "Huch? Ist es denn schon so spät?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140304
					],
					"speakerTitle": "„Fräulein Damen-Pudel“"
				},
				{
					"id": 762140304,
					"content": "Danke! Wuff, wenn ich nicht so beschäftigt wäre, hätte ich Fräulein Tigerchen persönlich eingeladen ... Dann hätte Herr Graufell vielleicht auch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140305
					],
					"speakerTitle": "„Fräulein Damen-Pudel“"
				},
				{
					"id": 762140305,
					"content": "Ob Katze oder Hund, alle können friedlich zusammenleben ... Ganz bestimmt. Jedenfalls gehe ich jetzt zur Teegesellschaft. Danke dir für die Erinnerung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Fräulein Damen-Pudel“"
				}
			]
		},
