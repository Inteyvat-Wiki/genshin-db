				{
					"id": 762140401,
					"content": "#Miau, miau! Damit wären alle beisammen, miau! Dank {M#des}{F#der} goldenen Reisenden kann die Teegesellschaft endlich beginnen, miau!",
					"roleType": "TALK_ROLE_NPC",
