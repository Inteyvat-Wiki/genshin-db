					}
				]
			},
			"dialogs": [
				{
					"id": 762140101,
					"content": "Miau ... Es ist schon Zeit für die Teegesellschaft, miau. Ob sie sich wohl verlaufen haben, miau ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140102
					],
					"speakerTitle": "Herr Graufell"
				},
				{
					"id": 762140102,
					"content": "#Ah, {M#goldener Reisender}{F#goldene Reisende}, du bist bestimmt {M#der}{F#die} auserwählte Mutige, miau! Kannst du mir bitte helfen, meine zwei Freunde zu suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140103,
						762140104
					],
					"speakerTitle": "Herr Graufell"
				},
				{
					"id": 762140103,
					"content": "Und deine Freunde sind ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140106
					]
				},
				{
					"id": 762140106,
					"content": "Und von den zwei Fräuleins, die noch nicht da sind, ist eines eine sprechende Katze, genau wie ich, nur in Orange, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140107
					],
					"speakerTitle": "Herr Graufell"
				},
				{
					"id": 762140107,
					"content": "Das andere ist ein sehr höflicher Damen-Pudel. Obwohl das Fräulein ein Hund ist, ist es sehr sanft, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140108
					],
					"speakerTitle": "Herr Graufell"
				},
				{
					"id": 762140108,
					"content": "Auch wenn eine eine Katze und die andere ein Hund ist, solange wir zusammen Tee trinken können, sind sicher alle glücklich, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140109
					],
					"speakerTitle": "Herr Graufell"
				},
				{
					"id": 762140109,
					"content": "Für den Frieden von Miaulanopolis, bitte hilf mir, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herr Graufell"
				},
				{
					"id": 762140104,
					"content": "Die Standards für Mutige sind ja ganz schön beliebig!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140105
					]
				},
				{
					"id": 762140105,
					"content": "Kümmere dich nicht zu sehr um die Details, miau. Auch ohne legendäres Schwert und ohne den legendären Kelch des reinen Wassers, jemand Mutiges ist jemand Mutiges, miau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140106
					],
					"speakerTitle": "Herr Graufell"
				}
			]
		},
