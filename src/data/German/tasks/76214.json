						],
						"pointId": 244
					}
				]
			},
			"dialogs": [
				{
					"id": 762140201,
					"content": "... Miau. Deine Schwertkunst ... beeindruckt mich wirklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140209
					],
					"speakerTitle": "Fräulein Tigerchen"
				},
				{
					"id": 762140209,
					"content": "#Ich danke dir, {F#ehrenwerte fremde Ritterin}{M#ehrenwerter fremder Ritter}. Diese arroganten und mächtigen Übeltäter werden das Heim meines Volkes nicht mehr bedrohen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140210
					],
					"speakerTitle": "Fräulein Tigerchen"
				},
				{
					"id": 762140210,
					"content": "Nun dann, sprich. Warum bist du zu meinem Hof gekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140202,
						762140204
					],
					"speakerTitle": "Fräulein Tigerchen"
				},
				{
					"id": 762140202,
					"content": "Königshof?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140203
					]
				},
				{
					"id": 762140203,
					"content": "Ähm ... da es sich um ein Märchen handelt, gehört das wahrscheinlich einfach dazu, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762140206,
					"content": "Du überbringst Fräulein Tigerchen die Einladung zur Teegesellschaft von Herrn Graufell ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140207
					]
				},
				{
					"id": 762140207,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140208
					],
					"speakerTitle": "Fräulein Tigerchen"
				},
				{
					"id": 762140208,
					"content": "#... Ich verstehe. Danke, {F#ehrenwerte fremde Ritterin}{M#ehrenwerter fremder Ritter}. Dann werde ich deinen Rat befolgen und mich auf den Weg machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fräulein Tigerchen"
				},
				{
					"id": 762140204,
					"content": "Der Erhabenste, lass mich dir Bericht erstatten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140205
					]
				},
				{
					"id": 762140205,
					"content": "Du spielst ja voll gut mit! Ähm, da das also dazugehört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				}
			]
		},
