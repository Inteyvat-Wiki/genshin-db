			"trigger": {
				"objectNames": [
					"„Bootsfahrer“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721740101,
					"content": "Schade um diese Seite des Flusses ... die Silberzypresse, die Silberwiese, der Silberstein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740102,
						721740103
					],
					"speakerTitle": "„Bootsfahrer“"
				},
				{
					"id": 721740102,
					"content": "Verzeihung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				},
				{
					"id": 721740104,
					"content": "Oh ... Gäste? Möchtet ihr an Bord kommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740105
					],
					"speakerTitle": "„Bootsfahrer“"
				},
				{
					"id": 721740105,
					"content": "Aber es ist ein Außenstehender ... Ich kann das nicht tun ... Ich kann das nicht tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740106,
						721740107
					],
					"speakerTitle": "„Bootsfahrer“"
				},
				{
					"id": 721740106,
					"content": "Nein ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740108,
					"content": "Das silberne Boot auf dem Weg zum Mond ist nicht für dich vorbereitet worden ... Setze ja keinen Fuß drauf und beschmutze nicht meine Segel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740109
					],
					"speakerTitle": "„Bootsfahrer“"
				},
				{
					"id": 721740109,
					"content": "Oh weh ... der Nebel ist schon lange weg ... wer noch nicht an Bord ist ... die Heldin des goldenen Hauses wird zornig sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740110
					],
					"speakerTitle": "„Bootsfahrer“"
				},
				{
					"id": 721740110,
					"content": "Boot ...? Wo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740111
					]
				},
				{
					"id": 721740111,
					"content": "Oh ... das silberne Boot, das Boot der Kinder der Sonne und der Berge, alle gehen nach Hause, das große goldene Haus auf dem Mond ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740112
					],
					"speakerTitle": "„Bootsfahrer“"
				},
				{
					"id": 721740112,
					"content": "Aber, aber ... einige der Kinder haben sich verirrt und sind immer noch nicht auf dem Boot ... die Heldin wird böse sein ... das ist nicht gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740113,
						721740114
					],
					"speakerTitle": "„Bootsfahrer“"
				},
				{
					"id": 721740113,
					"content": "Brauchst du Hilfe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740115,
					"content": "Komm schnell aufs Boot, verweile nicht weiter, verliere dich nicht wieder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Bootsfahrer“"
				},
				{
					"id": 721740114,
					"content": "Hörst du mich sprechen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740107,
					"content": "Was sagst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740103,
					"content": "Wer bist du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				}
			]
		},
