				"points": []
			},
			"dialogs": [
				{
					"id": 200280101,
					"content": "#Tausend Dank, {NICKNAME} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280102
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 200280102,
					"content": "Ich bin zwar ein Jäger, aber mit diesen Schleimen kann ich es einfach nicht aufnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280103
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 200280103,
					"content": "Seit diese Dinger mir dazwischenfunken, komme ich ganz ohne Beute nach Hause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280104
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 200280104,
					"content": "Ich hoffe nur, dass es den anderen Jägern nicht genauso geht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280105
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 200280105,
					"content": "Hmm, da fällt mir ein, könntest du dich vielleicht für mich umsehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280106
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 200280106,
					"content": "Ich weiß nicht, ob ich mir das nur einbilde. Aber die Schleime tauchen in der Umgebung des Dorfes immer häufiger auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280107
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 200280107,
					"content": "Würdest du bitte nachsehen? Wenn du Schleime siehst, kannst du sie ja gleich beseitigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280108,
						200280109
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 200280108,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280110
					]
				},
				{
					"id": 200280110,
					"content": "Das ist toll! Ich werde Draff davon erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280111
					],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 200280111,
					"content": "Ich hoffe, dass er nicht zu betrunken ist, um zu verstehen, was ich sage ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Scheuer Morrow"
				},
				{
					"id": 200280109,
					"content": "Ich habe noch zu tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280112
					]
				},
				{
					"id": 200280112,
					"content": "Aber nur du kannst mir noch helfen. Tu es für Quellingen, bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Scheuer Morrow"
				}
			]
		}
	]
