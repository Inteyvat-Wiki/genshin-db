			"dialogs": [
				{
					"id": 742250201,
					"content": "#Vielen Dank, {M#mein Wohltäter}{F#meine Wohltäterin}. Dem König der Götter sei dank, endlich bin ich gerettet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250202
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250202,
					"content": "Gehörst du zu den Soldaten, die für die Sicherheit dieser Stadt sorgen, oder bist du ein durchreisender Streiter für das Gute?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250203
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250203,
					"content": "Ich darf mich eben vorstellen, mein Name ist Faustus, ich bin ein vom König der Götter höchstselbst ernannter Händler der Grenzregionen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250204
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250204,
					"content": "Eigentlich bin ich hier, um Gewürze aus dem Süden zu liefern. Ich habe nicht erwartet, gleich nach dem Anlegen von diesen nervigen Drachenechsen umzingelt zu werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250205
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250205,
					"content": "Drachenechsen? Ich habe keine Drachenechsen gesehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742250206
					]
				},
				{
					"id": 742250206,
					"content": "#Äh? Du {F#Reckin}{M#Recke} hast dir die Gegner, die du gerade besiegt hast, gar nicht angeschaut? Du musst noch stärker sein, als ich es mir vorstellen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250207
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250207,
					"content": "Bitte, nimm das hier. Keine langen Dankesreden, ich muss noch diese Waren in die Stadt transportieren. Vielleicht treffen wir uns in der Stadt wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Foscari"
				}
			]
		}
	]
}