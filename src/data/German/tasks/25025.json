					"content": "Ich kann dir helfen, die anderen Becken zu säubern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250250302
					]
				},
				{
					"id": 250250302,
					"content": "Wenn du helfen willst, wäre das großartig, ich bin wirklich am Anschlag.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250303
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250303,
					"content": "Hm ... Dann geh und fang mit dem Becken dort drüben an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250304
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250304,
					"content": "Ich habe schon den Boden des Thermalbeckens sauber gemacht. Du musst nur den Kram, der oben schwimmt, rausfischen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250305
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250305,
					"content": "Dann danke ich schon mal im Voraus. Ich kümmere mich weiter um den Kleinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250306
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250306,
					"content": "Ach ... Ich verstehe nicht, was mit ihm los ist. Früher reichte ein bisschen Kraulen am Kopf oder Bauch und er war brav ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pele Nui"
				}
			]
		},
