			"dialogs": [
				{
					"id": 250250101,
					"content": "Bitte, komm mal kurz ans Ufer, ja? Ich will das Becken hier sauber machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250102
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250102,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250103
					],
					"speakerTitle": "Träger Koholasaurier"
				},
				{
					"id": 250250103,
					"content": "Sei ein braver Junge und komm hierher. Sonst muss ich dich hochheben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250104
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250104,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250105
					],
					"speakerTitle": "Träger Koholasaurier"
				},
				{
					"id": 250250105,
					"content": "Ach, und schon ist er weggeschwommen, wie soll ich ihn da nur rausheben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250106
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250106,
					"content": "Was treibst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250250107
					]
				},
				{
					"id": 250250107,
					"content": "Hm? Willst du in der heißen Quelle baden gehen? Tut mir leid, ich mache gerade das Becken sauber, du wirst dich ein wenig gedulden müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250108
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250108,
					"content": "Und dieser kleine Strolch will einfach nicht rauskommen. *seufz* ... Ich habe noch so viele Becken zu reinigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250250109
					],
					"speakerTitle": "Pele Nui"
				},
				{
					"id": 250250109,
					"content": "Vielleicht ist er eingeschnappt, weil ich ihn neulich rausgeholt habe? Was für ein Dickkopf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pele Nui"
				}
			]
		},
