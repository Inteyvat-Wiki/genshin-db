			"dialogs": [
				{
					"id": 750691101,
					"content": "Der Wasserfall, haha ... Sein Tosen erfüllt die Ohren, sodass nichts anderes mehr zu hören ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691102
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691102,
					"content": "Ah, du bist es. Brauchst du etwas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691103
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691103,
					"content": "Nein, nichts.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691104
					]
				},
				{
					"id": 750691104,
					"content": "Ist das so ... Hör auf meinen Rat, Recke, und verlasse diesen Ort so schnell wie möglich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
