			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quenin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690201,
					"content": "Ach, hierher kommt kaum jemand ... Es ist ja auch ein gefährlicher Ort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690202
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690202,
					"content": "Bist du auch von der Abenteurertruppe ...? Ich hörte, der Schatten der Schwarzen Schlange ist von der Tonatiuh herabgestiegen ... Sei besser vorsichtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690203
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690203,
					"content": "Oder am besten verschwindest du gleich! In der Abenteuertruppe, ja, da gibt es nämlich auch nichtmenschliche Dinge ... Diese Stimmen, diese Verwünschungen ... welch ein Lärm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690204
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690204,
					"content": "Hier ist es aber schön ruhig, wegen des Wasserfalls. Haha ... Das Rauschen übertönt einfach alles, man hört sonst gar nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
			"id": 7506905,
			"completionStepIds": [
				7506903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7506903",
							"2"
						],
						"stepId": 7506903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690501,
					"content": "(Ein zerrissenes Blatt Papier, das oben ganz ordentlich beschrieben ist ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690502
					],
					"speakerTitle": "Quenins Tagebuch"
				},
				{
					"id": 750690502,
					"content": "„... Die Monster des Abgrunds werden immer mehr, wie erwartet ... Das Abenteuerteam ist letztlich gescheitert, der Rückzug wird vorbereitet.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690503
					],
					"speakerTitle": "Quenins Tagebuch"
				},
				{
					"id": 750690503,
					"content": "„Wir müssen sicherstellen, dass die restlichen Leute sicher evakuiert werden. Passt auf diejenigen auf, die bei Nacht verschwinden und die, die aus der Dunkelheit zurückkehren.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690504
					],
					"speakerTitle": "Quenins Tagebuch"
				},
				{
					"id": 750690504,
					"content": "„... Diese Monster tauchen immer häufiger auf. Vielleicht wird der Stützpunkt bald entdeckt, aber vorher müssen wir ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690505
					],
					"speakerTitle": "Quenins Tagebuch"
				},
				{
					"id": 750690505,
					"content": "(Von hier an wird die Handschrift krakeliger und verworrener ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690506
					],
					"speakerTitle": "Quenins Tagebuch"
				},
				{
					"id": 750690506,
					"content": "„Ah, wie kalt ... so entsetzlich kalt ... Dort, dort drüben ... das Blut läuft aus ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690507
					],
					"speakerTitle": "Quenins Tagebuch"
				},
				{
					"id": 750690507,
					"content": "„Das Rauschen des Wasserfalls ... so laut ... ja, so ist es gut. Unter dem Wasserfall ... da wird es ruhig sein ... bleiche Gesichter, geöffnete Münder, ausgelaufenes Blut ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690508
					],
					"speakerTitle": "Quenins Tagebuch"
				},
				{
					"id": 750690508,
					"content": "„Dort drüben ... genau dort ... da ist ... irgendetwas ist dort ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690509
					],
					"speakerTitle": "Quenins Tagebuch"
				},
				{
					"id": 750690509,
					"content": "„Unter dem Wasserfall unter dem Wasserfall unter dem Wasserfall unter dem Wasserfall unter dem Wasserfall ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenins Tagebuch"
				}
			]
		},
		{
