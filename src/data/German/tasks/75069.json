			},
			"dialogs": [
				{
					"id": 750690801,
					"content": "(Der kalte, statuenhafte Körper, der wie Quenin aussieht, scheint aus unerklärlichen Gründen nicht zu verwesen ... Er bleibt einfach in diesem Zustand ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690802
					],
					"speakerTitle": "Kalter Körper"
				},
				{
					"id": 750690802,
					"content": "(Und der Umgebung nach zu urteilen, ist er schon lange in diesem Zustand ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kalter Körper"
				}
			]
		},
