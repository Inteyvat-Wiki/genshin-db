				{
					"id": 750691309,
					"content": "Hörst du das nicht? Jemand wimmert leise, direkt neben deinem Ohr ... Wie jemand, der im Sterben liegt, aber nicht schreien kann. Nur das Geräusch der Lungen ist zu hören, die um Luft ringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691310
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691310,
					"content": "Und dann siehst du ein blasses Gesicht, das dich wütend anstarrt ... Es sieht aus wie ... dein eigenes Gesicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691311
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691311,
					"content": "Ah, nur am Wasserfall ... nur dort kann ich diesen unheimlichen Geräuschen entkommen. Hehe, hörst du sie denn nicht ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691312
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691312,
					"content": "Bleib nicht zu lange hier, tapferer Recke, sonst wirst du noch so enden wie ich. Geh fort, bevor es zu spät ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691313,
					"content": "Nein, nichts.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691314
					]
				},
				{
					"id": 750691314,
					"content": "Ist das so ... Hör auf meinen Rat, Recke, und verlasse diesen Ort so schnell wie möglich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
