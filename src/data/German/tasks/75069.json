						750691203,
						750691207
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691203,
					"content": "Was machst du hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691204
					]
				},
				{
					"id": 750691204,
					"content": "Ich bin ... ein Krieger der Abenteurertruppe. Ich bin zwar nicht so mächtig wie Taika, aber auch ich habe meine Stärken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691205
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691205,
					"content": "Ich bewache das Lager der Truppe ... Es gibt Nächte, in denen ich nicht schlafen kann, also drehe ich meine Runden, um das Lager zu schützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691206
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691206,
					"content": "Ich weiß nicht genau, wann es angefangen hat, aber es sind immer weniger Leute im Lager ... Äh, hä? Seltsam ... Warum bin ich eigentlich jetzt hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691207,
					"content": "Nein, nichts.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691208
					]
				},
				{
					"id": 750691208,
					"content": "Ist das so ... Hör auf meinen Rat, Recke, und verlasse diesen Ort so schnell wie möglich!",
					"roleType": "TALK_ROLE_NPC",
