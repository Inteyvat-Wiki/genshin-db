			"dialogs": [
				{
					"id": 250330201,
					"content": "#{M#Großer Bursche}{F#Junge Dame}, du bist echt toll! Du kletterst genauso schnell wie Mayta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330202,
						250330203
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330202,
					"content": "Es gab da ein paar Patzer ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330204
					]
				},
				{
					"id": 250330204,
					"content": "Dein Tempo beim Bergsteigen ist schon ganz ordentlich. Da können Qica und ich nicht mehr mithalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330205
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330205,
					"content": "#*seufz* Um so gut zu werden wie du, {M#großer Bursche}{F#junge Dame}, müssen wir wohl noch lange üben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330206
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330206,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330207,
						250330208
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330207,
					"content": "Du schaffst das, Qica!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330209
					]
				},
				{
					"id": 250330209,
					"content": "*brüll*? *brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330210
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330210,
					"content": "Nur Geduld, Qica. Onkel Yawar sagt, nur wenn wir hart arbeiten, werden wir richtig gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330211
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330211,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330212
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330212,
					"content": "#{M#Großer Bursche}{F#Junge Dame}, danke für deine Hilfe, diese Frucht ist für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330213
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330213,
					"content": "Das hat Qica gerade gepflückt. Er ist jetzt viel agiler als vorher!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330214
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330214,
					"content": "#Hehe, diesen Erfolgskurs verdankt er nur dem großartigen Vorbild {M#des großen Burschen}{F#der junge Dame}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330215
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330215,
					"content": "*brüll* ... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330216
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330216,
					"content": "Gut, dann gehen wir mal zurück zum Stamm und suchen Mayta. Hm ... der müsste doch jetzt wieder dort sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330208,
					"content": "Ihr werdet es schaffen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330209
					]
				},
				{
					"id": 250330203,
					"content": "Das war kein Bravourstück ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330204
					]
				}
			]
		},
