			"dialogs": [
				{
					"id": 250330101,
					"content": "He, Kleiner, hast du heute gut gefuttert? Hast du Kraft zum Trainieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330102,
					"content": "*brüll* *brüüüll* *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330103
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330103,
					"content": "Uii, so viel Energie? Klasse! Heute legen wir noch einen Zahn zu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330104
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330104,
					"content": "Los, zusammen reißen wir das!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330106
					]
				},
				{
					"id": 250330106,
					"content": "#Hallo, {M#großer Bursche}{F#junge Dame}! Wir trainieren hier gerade fürs Bergsteigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330107,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330108
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330108,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330109,
						250330112
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330109,
					"content": "Und, wie läuft das Training?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330110
					]
				},
				{
					"id": 250330110,
					"content": "Na ja ... ich würde sagen, wir machen Fortschritte. Qica hat es viel weiter nach oben geschafft als beim letzten Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330111
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330111,
					"content": "Es ist nur so, dass Qica immer noch nicht so gut klettern kann, als ob er noch etwas Übung bräuchte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330116,
					"content": "#{M#Großer Bursche}{F#Junge Dame}, kannst du uns das nochmal vorführen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330117,
						250330121
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330117,
					"content": "Gern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330118
					]
				},
				{
					"id": 250330118,
					"content": "#Vielen Dank! Diesmal werde ich genau auf deine Bewegungen achten, {M#großer Bursche}{F#junge Dame}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330119
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330119,
					"content": "Qica, du musst auch die Augen aufsperren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330120
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330120,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330123,
					"content": "#Dann bitte, {M#großer Bursche}{F#junge Dame}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330124
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330124,
					"content": "Wir bleiben hier unten, schauen dir zu und stoppen die Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330125
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330125,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				},
				{
					"id": 250330121,
					"content": "Achtet diesmal genau auf meine Bewegungen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330122
					]
				},
				{
					"id": 250330122,
					"content": "Klar, Qica und ich werden ganz genau hinschauen. Diesmal verpassen wir nichts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330112,
					"content": "Scheint, als wäre er wieder auf dem Damm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330113
					]
				},
				{
					"id": 250330113,
					"content": "Natürlich! Sogar Mama hat gesagt, ich kümmere mich prima um Qica.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330114
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330114,
					"content": "Qica hat große Fortschritte gemacht, er ist viel höher geklettert als beim letzten Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330115
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250330115,
					"content": "Es ist nur so, dass Qica immer noch nicht so gut klettern kann, als ob er noch etwas Übung bräuchte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "Tlatem"
				}
			]
		},
