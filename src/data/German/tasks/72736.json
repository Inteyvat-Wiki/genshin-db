			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Marschall Hanakado“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360101,
					"content": "Haha, Hut ab!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360102
					],
					"speakerTitle": "„Marschall Hanakado“"
				},
				{
					"id": 727360102,
					"content": "Ich habe nicht erwartet, dass die Arataki-Bande so viele mächtige Käferkämpfer besiegen würde. Es scheint, dass ihr euch auch im Käferkampf gut auskennt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360103
					],
					"speakerTitle": "„Marschall Hanakado“"
				},
				{
					"id": 727360103,
					"content": "Ich nehme zurück, was ich vorher gesagt habe. Ich werde euch als respektable und würdige Gegner entgegentreten, mit meiner ganzen Kraft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360104
					],
					"speakerTitle": "„Marschall Hanakado“"
				},
				{
					"id": 727360104,
					"content": "Kuhhirte, es ist Zeit für den Auftritt des Bosses!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360105,
					"content": "Und nimm das Gesagte nicht ernst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360106,
						727360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360106,
					"content": "Los, „Großer Oni-König des Käferkampfes“!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				},
				{
					"id": 727360108,
					"content": "Hahahahaha, na klar! Der Sieg des letzten Duells gehört natürlich mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360109,
					"content": "Ich weiß nicht, wie du deine Truppe führst, aber das Endergebnis steht außer Zweifel: Meine Arataki-Bande ist eindeutig überlegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360110
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360110,
					"content": "Mach dich bereit, „Marschall Hanakado“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360107,
					"content": "Der Oni-König gegen den Marschall!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				}
			]
		},
		{
			"id": 7273602,
			"completionStepIds": [
				7273603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273603",
							"2"
						],
						"stepId": 7273603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Marschall Hanakado“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360201,
					"content": "Ah, so ist das also ... Lass uns noch einmal kämpfen. Diesmal werde ich alle deine Taktiken durchschauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360202
					],
					"speakerTitle": "„Marschall Hanakado“"
				},
				{
					"id": 727360202,
					"content": "Das Ergebnis des Duells scheint nicht mehr wichtig zu sein. Lass uns nur zum Spaß kämpfen, was sagst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360203
					],
					"speakerTitle": "„Marschall Hanakado“"
				},
				{
					"id": 727360203,
					"content": "Es ist selten, einen Gegner auf meinem Niveau zu treffen. Es wäre eine Schande, unser Duell so schnell zu beenden, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360204
					],
					"speakerTitle": "„Marschall Hanakado“"
				},
				{
					"id": 727360204,
					"content": "Hahaha! Immer her damit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360205
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360205,
					"content": "Aber ... meine Taktiken durchschauen? Haha, das wird nicht passieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360206
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360206,
					"content": "Wenn du zugibst, dass ich der stärkere Käferkämpfer bin, werde ich so viele Runden gegen dich kämpfen, wie du willst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360207
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360207,
					"content": "Hm, es scheint, dass der Kuhhirte und „Marschall Hanakado“ noch ein paar Duelle mehr haben wollen. Nun, lassen wir sie weiter kämpfen, bis sie beide zufrieden sind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
