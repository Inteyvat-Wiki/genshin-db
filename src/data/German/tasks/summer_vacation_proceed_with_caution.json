			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110301,
					"content": "Hmm? Kann ich etwas tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110302,
						400110306
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110302,
					"content": "Über diese Inselgruppe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110303
					]
				},
				{
					"id": 400110303,
					"content": "Ich wollte nur sagen, dass das Meer hier herrlich ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110304
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110304,
					"content": "Meer und Sonne – ein wahr gewordener Sommertraum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110305
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110305,
					"content": "Ich wünsche mir unbedingt einen Auftritt mit Blick auf den Ozean! Das wird sicher großartig sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110306,
					"content": "Über deine Sommerkleidung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110307
					]
				},
				{
					"id": 400110307,
					"content": "Wie sehe ich aus? Nicht schlecht, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110308
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110308,
					"content": "Ich wollte alle überraschen, deshalb suchte ich extra etwas aus, das zu einer Inselstimmung passt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110309
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110309,
					"content": "Oh, aber bitte mach dir keine Sorgen! Auch in Sommerkleidung bin ich im Kampf noch genauso zuverlässig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				}
			]
		},
		{
			"id": 4001104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001109",
							"2"
