				{
					"id": 400110901,
					"content": "Bist du mit deinen Vorbereitungen fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110902,
						400110904
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110902,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110903
					]
				},
				{
					"id": 400110903,
					"content": "Es gibt keinen Grund zur Eile. Nehmt euch Zeit, um eure Angelegenheiten zu organisieren. Ich werde hier auf euch alle warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
