				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara",
					"Paimon",
					"Jean",
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110701,
					"content": "Ehrenritter, schau mal hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110702
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110702,
					"content": "Hä? Was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110703,
					"content": "Schau dir diese aufgestapelten Steine und die kleinen Blumen an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110704
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110704,
					"content": "Das sieht aus wie ein Denkmal für jemanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110705,
						400110706
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110705,
					"content": "Ihr seid sehr aufmerksam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110707
					]
				},
				{
					"id": 400110707,
					"content": "He, du bringst mich in Verlegenheit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110708
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110708,
					"content": "Aber sonst gibt es hier nur diese Maschine in der Kleidung von Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110709,
					"content": "Könnte das ein Denkmal für die Maschine sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110710
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110710,
					"content": "Vielleicht hat es einmal etwas vollbracht, das ein Denkmal verdient hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110711
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110711,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110712
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110712,
					"content": "Alles, was wir hier sehen, deutet darauf hin, dass es einst eine menschliche Besiedlung in diesen Gewässern gab. Dennoch gibt es nicht genug, um Rückschlüsse auf die Art der Zivilisation zu ziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110713
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110713,
					"content": "Und bis jetzt haben wir auch noch keine Menschen oder Grabsteine gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110714
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110714,
					"content": "Jean, darf ich mal da rübergehen und mir das ansehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110715
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110715,
					"content": "Ja, aber sei vorsichtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110716
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110716,
					"content": "Geht klar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110717
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110717,
					"content": "Wie viele Geheimnisse birgt diese Insel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110718
					]
				},
				{
					"id": 400110718,
					"content": "#Klee ist zu jung, um ein gutes Gefühl für Gefahren zu haben. {F#Reisende}{M#Reisender}, wir anderen müssen die Situation im Auge behalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110719
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110719,
					"content": "Um ehrlich zu sein, dachte ich zuerst, dass dieser Brief nur ein Streich wäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110720
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110720,
					"content": "Das haben wir alle gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110721,
					"content": "Das hatte ich auch schon vermutet, aber wer würde schon einem Kind einen solchen Brief schicken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110722
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110722,
					"content": "Ein Brief, der uns dazu bringt, auf einer verlassenen Inselgruppe Vorrichtungen zu aktivieren ... Das ist bizarr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110723
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110723,
					"content": "Ich frage mich, ob das nicht eine Art Falle ist, die von langer Hand vorbereitet wurde. Wir müssen wachsam bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110724
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110724,
					"content": "Fräulein Barbara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110725
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110725,
					"content": "Klee, was ist los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110726
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110726,
					"content": "Denkst du, dass der Dodo-König mich nicht sehen will?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110727
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110727,
					"content": "Warum sollte der Dodo-König dich nicht sehen wollen, Klee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110728
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110728,
					"content": "Dodoco hat mich lieb und ich habe Dodoco lieb, also kann uns der Dodo-König niemals trennen. Deshalb will uns der Dodo-König auch nicht sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110729
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110729,
					"content": "*wimmer* Ich will nicht, dass er uns trennt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110730
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110730,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110731
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110731,
					"content": "He, Klee, weißt du, was das ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110732
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110732,
					"content": "Das ist ein Harpastum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110733
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110733,
					"content": "Ich hörte, dass meine Schwes... Jean sagte, dass Klee immer mit dem Harpastum spielen wollte, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110734
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110734,
					"content": "Ja! Klee hat gerade an die Ludi Harpastum gedacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110735
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110735,
					"content": "Ich habe diesen Harpastum speziell für Klee angefertigt. Jetzt ist es jeden Tag Zeit für die Ludi Harpastum, hehehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110736
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110736,
					"content": "Juhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110737
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110737,
					"content": "Die Freundlichkeit einer Bischöfin ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110738
					]
				},
				{
					"id": 400110738,
					"content": "Kopf hoch, Klee! Wenn wir den Dodo-König treffen, können wir alle mithelfen, ihn zu überzeugen, dass du und Dodoco zusammenbleiben dürfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110739
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110739,
					"content": "Verstehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110740
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110740,
					"content": "Verdoppeln wir unsere Anstrengungen. Wir müssen ihn finden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110741
					]
				},
				{
					"id": 400110741,
					"content": "Jaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110742
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110742,
					"content": "Überlass das alles uns, Klee. Dieser Dodo-Trottel kann sich nicht ewig verstecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110743
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110743,
					"content": "Selbst wenn wir tausend Jahre suchen müssten ... äh, wir werden ihn kriegen! Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110744,
					"content": "Aber lass uns bis dahin die Gegend etwas genauer unter die Lupe nehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110706,
					"content": "Das ist die Intuition einer Bischöfin, wohlgemerkt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110707
					]
				}
			]
		},
