	"talks": [
		{
			"id": 4001101,
			"completionStepIds": [
				4001101
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001101",
							"2"
						],
						"stepId": 4001101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Jean",
					"Barbara",
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110101,
					"content": "Aah ... Das Wetter ist herrlich. Paimon fühlt sich immer noch so, als würde Paimon träumen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110102,
					"content": "Guten Morgen! Ah, was ist denn mit den Klamotten von allen los?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110103,
					"content": "Hehe! Also, wie sehen wir aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110104
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110104,
					"content": "Wir haben uns in unsere Sommerklamotten geschmissen! Auch wenn wir nicht hierhergekommen sind, um Spaß zu haben, wollten wir uns einen herrlichen Sommertag am Meer nicht entgehen lassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110105
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110105,
					"content": "Da... Das sieht doch nicht komisch aus, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110106
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110106,
					"content": "So eine elegante und luftige Kleidung passt einfach nicht zu mir ... *ähem* Entschuldigt mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110107,
						400110108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110107,
					"content": "Nein, ganz und gar nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				},
				{
					"id": 400110109,
					"content": "#Wirklich? Danke vielmals, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110110
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110110,
					"content": "Erstaunlich, dass Jean extra Sommersachen einpacken würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110111,
					"content": "Oh nein, meine große Schwester würde das niemals selbst vorbereiten. Lisa und ich haben alles für sie ausgesucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110112
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110112,
					"content": "Sie posaunt „große Schwester“ heraus und merkt es nicht einmal ... Barbara ist schon ganz sommertrunken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110113,
					"content": "Hinter diesen Sommersachen steckt eine ganze Geschichte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110114,
					"content": "Ich dachte, dass Lisas Beutel für einen Notfall bestimmt war. Ich hätte nicht erwartet, dass er ein ganzes Sortiment an Sommerkleidung enthält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110115
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110115,
					"content": "Und all diese Accessoires ... Eindeutig Lisas Handschrift.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110116,
					"content": "Alle bei den Rittern des Ordo Favonius versuchen immer, mich dazu zu bewegen, Urlaub zu nehmen. Ich schätze, ich setze mich zu sehr unter Druck ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110117,
					"content": "Kommt mal alle her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110118
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110118,
					"content": "Das ist Klees Stimme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110119
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110119,
					"content": "Da ist etwas Merkwürdiges!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110120,
					"content": "Hm? Was ist hier los? Was meinst du mit „etwas Merkwürdiges“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110121,
					"content": "Schau dir den Ozean an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110122,
					"content": "Siehst du? Da schwimmt etwas Merkwürdiges auf dem Wasser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110123,
					"content": "Dieser kleine Apparat ... Er sieht wie eine Boje aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110124,
					"content": "Aber als wir gestern hier ankamen, haben wir noch gar nichts gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110125
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110125,
					"content": "Der Dodo-König muss ihn hierhingelegt haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110126,
					"content": "Seltsame Apparate, die plötzlich über Nacht erscheinen ... Irgendetwas stimmt hier nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110127,
					"content": "Er kam noch nie, um nach mir zu sehen. Heißt das, dass er mich nicht anerkennt? Oder vielleicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110128
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110128,
					"content": "Vielleicht wartet er darauf, dass ich ihn finde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110129,
					"content": "Gibt es irgendeinen Grund dafür, dass plötzlich Bojen auftauchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110130
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110130,
					"content": "Lass uns das näher anschauen, vielleicht finden wir es heraus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110131
					]
				},
				{
					"id": 400110131,
					"content": "Stimmt, hier an Land werden wir nichts erreichen, wenn wir nur raten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110132,
					"content": "Ist es dennoch gut, da rauszufahren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110133
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110133,
					"content": "Es wäre am besten, näher an die Bojen heranzugehen und das genauer zu untersuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110134,
					"content": "Es ist schwierig zu sagen, was uns auf dem Meer erwartet. Bereiten wir uns vorsichtshalber auf einen Kampf vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110135
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110135,
					"content": "Wenn ihr bereit seid, versammeln wir uns hier und fahren gemeinsam mit dem Boot hinüber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110136,
						400110137
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110136,
					"content": "Ja, Jean, so machen wir es!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110138,
					"content": "N... Nein. Das ist einfach meine Pflicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110139
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110139,
					"content": "Also dann, ich werde euch alle mit den Vorbereitungsarbeiten betrauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110137,
					"content": "Auch in Sommerkleidung bleibt sie absolut professionell.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110108,
					"content": "Ihr seht großartig aus!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				}
			]
		},
		{
			"id": 4001102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001109",
							"2"
						],
						"stepId": 4001109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110201,
					"content": "Was könnten diese Bojen wohl für eine Bedeutung haben ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110202,
						400110206
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110202,
					"content": "Über diese Inselgruppe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110203
					]
				},
				{
					"id": 400110203,
					"content": "Diese Inseln sind von der Außenwelt abgeschottet, wie eine von der Natur selbst geschaffene geheime Sphäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110204
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110204,
					"content": "Der Brief hat uns hierhergelotst und Venti und Dvalin haben uns geholfen ... Das alles scheint ein bisschen zu auffällig zu sein. Ich mache mir ein wenig Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110205,
					"content": "Aber ich bin hier, um euch alle zu verteidigen, also bitte macht euch keine Sorgen. Was auch immer kommen mag, ich werde ihm gegenübertreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110206,
					"content": "Über deine Sommerkleidung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110207
					]
				},
				{
					"id": 400110207,
					"content": "Ah ... Die So... Sommerkleidung ... die ist, äh ... Sie ist eine Überraschung, die Lisa für mich vorbereitet hatte. Ich vermute, dass es ursprünglich ein Vorschlag von Barbara war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110208,
					"content": "Barbara meinte, dass wir so selten die Gelegenheit haben, auf eine Insel zu kommen, dass wir uns in Sommerkleider hüllen sollten, um die richtige Atmosphäre zu schaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110209
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110209,
					"content": "Ich habe mich jedoch noch nicht an diesen Stil gewöhnt. *seufz* Ich hoffe, das zu tragen, sieht nicht zu schräg aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		},
		{
			"id": 4001103,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
