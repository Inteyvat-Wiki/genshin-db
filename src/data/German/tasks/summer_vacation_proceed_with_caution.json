			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110401,
					"content": "Hmm, ich muss Bimm-Bamm-Bomben, Dodoco und ... mich selbst mitbringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110406,
						400110402
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110406,
					"content": "Wegen der Bojen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110407
					]
				},
				{
					"id": 400110407,
					"content": "Der Dodo-König muss diese Dinger auf dem Meer ausgesetzt haben! Er ist ein Bösewicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110408
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110408,
					"content": "Aber ich werde ihm wacker gegenübertreten und mein Bestes für Dodoco geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110409
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110409,
					"content": "#{F#Frau}{M#Herr} Ehrenritter, danke, dass du mir geholfen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110402,
					"content": "Wegen des Sommers ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110403
					]
				},
				{
					"id": 400110403,
					"content": "Ich mag den Sommer! Doch nicht nur den Sommer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110404
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110404,
					"content": "Ich mag auch den Herbst. Oh ja, und ich mag auch den Frühling und den Winter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110405
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110405,
					"content": "Im Winter ist es zwar bitterkalt, aber ich habe Bimm-Bamm-Bomben. Immer, wenn mir kalt ist, jage ich irgendwas in die Luft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
		{
			"id": 4001105,
			"completionStepIds": [
				4001104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001104",
							"2"
						],
						"stepId": 4001104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Barbara",
					"Klee",
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110501,
					"content": "Was geht hier vor sich? Dieser Teil des Ozeans ist einfach zu geheimnisvoll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110502,
					"content": "Dieser ganze Küstenstreifen ist einfach aus dem Wasser aufgetaucht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110503
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110503,
					"content": "Dodo-König, Dodo-König, ich fange dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110504
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110504,
					"content": "Klee wirkt so munter wie eh und je.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110505,
					"content": "Bevor der Boden zu schwanken begann, hörte ich Maschinengeräusche. Ich vermute, dass unter dieser Region des Ozeans eine riesige mechanische Struktur vorhanden sein könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110506
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110506,
					"content": "Wenn die ganze Inselgruppe auf einem mechanischen Gerüst steht, kann dieses aktiviert werden, um jede Insel aus dem Wasser zu heben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110507
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110507,
					"content": "So etwas wäre nichts weniger als ein Wunderwerk ... Könnte dahinter die Macht des Anemo-Archons, Barbatos, stecken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110508
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110508,
					"content": "Hmm, eher nicht. Paimon hat das Gefühl, dass dies eher ein abgekartetes Spiel ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110509,
					"content": "Es ist unglaublich, ganz egal, wie man es dreht und wendet. Einen Brief zu benutzen, um uns hierherzulocken und uns dann mit dieser Vorrichtung herauszufordern ... Dieser sogenannte Dodo-König ist kein Amateur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110510
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110510,
					"content": "Jean hat recht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110511
					]
				},
				{
					"id": 400110511,
					"content": "Und damit ist die Urlaubsstimmung vorbei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110512
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110512,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110513
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110513,
					"content": "Ich werde mein Bestes tun, um größtmögliche Sicherheit zu gewährleisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110514
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110514,
					"content": "Hach! Jean ist so cool, wenn sie so wild entschlossen ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110515,
					"content": "Paimon und ich werden auch wachsam sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110516
					]
				},
				{
					"id": 400110516,
					"content": "Danke für dein Verständnis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110517
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110517,
					"content": "Ich hab ihn gefunden! Es ist der Dodo-König!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110518
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110518,
					"content": "Er ist auf dieser Insel! Hihi, hab dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110519
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110519,
					"content": "Du wolltest, dass ich dich finde, also komm ich auch! Bimm-Bamm-Bomben, macht euch bereit! Laufen wir looos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110520
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110520,
					"content": "Ist das da etwa ... eine <color=#00E1FFFF>Plattform mitten auf dem Meer</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110521
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110521,
					"content": "Irgendetwas ist da aufgetaucht. Wir können uns das genauer ansehen, aber bitte seid auf der Hut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				}
			]
		},
		{
			"id": 4001106,
			"completionStepIds": [
				4001106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4001106",
							"2"
						],
						"stepId": 4001106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean",
					"Paimon",
					"Barbara",
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110601,
					"content": "Seid alle vorsichtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110602
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110602,
					"content": "Hä? Ist das etwa eine riesengroße Person?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110603,
					"content": "Es ähnelt einem Menschen, aber irgendetwas passt nicht ganz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110604
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110604,
					"content": "Dodo-König, Ich sehe dich! Du kannst, öh, ver... vermi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110605
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110605,
					"content": "Vermitteln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110606,
					"content": "Richtig! Du kannst Klee vermitteln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110607
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110607,
					"content": "Aah! Was sagt die Kleine da?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110608,
					"content": "Sie versteht offensichtlich nicht, was dieses Wort bedeutet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110609
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110609,
					"content": "He, Dodo-König! Warum hörst du mir nicht zu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110610
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110610,
					"content": "Weil ich zu lange gebraucht habe und dich wütend gemacht habe? Dann ... tut es mir leid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110611
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110611,
					"content": "Sich bei der anderen Seite entschuldigen? Klees Gedankengang ist sicherlich ... ein bisschen unkonventionell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110612
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110612,
					"content": "Do! Do! König!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110613
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110613,
					"content": "Die interessieren sich gar nicht für Klee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110614
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110614,
					"content": "Es ist eine Art humanoide Maschine. Keine Reaktion ... Sie muss beschädigt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110615
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110615,
					"content": "Kannst du sie erkennen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110616
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110616,
					"content": "Nein, ich kann nur raten. Sie ist hier völlig deplatziert auf der Insel ... Sieh dir die Kleidung an. Es scheint, als käme sie aus Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110617
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110617,
					"content": "Inazuma? Aber ist das nicht ganz schön weit entfernt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110618,
					"content": "Ist es ein Fremder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110619
					]
				},
				{
					"id": 400110619,
					"content": "Sieht ganz so aus. Dieser Bereich des Meeres ist unabhängig und grenzt an kein Land. Hier ist es also auch ein Fremder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110620
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110620,
					"content": "Aber wie kann so etwas in Anbetracht von Inazumas derzeitiger Situation geschehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110621
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110621,
					"content": "Ein Fremder, der nicht reagiert ... Seltsam! Hat ihn jemand hergebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110622,
					"content": "Oh nein! Der Dodo-König bewegt sich nicht mehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110623
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110623,
					"content": "Klee, vielleicht ist der Dodo-König ja müde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110624
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110624,
					"content": "Ja, ja der Dodo-König schläft vermutlich. Er hat so geduldig auf dich gewartet und dann *gähn* – Schlafenszeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110625,
					"content": "Gehen wir mit Klee woanders spielen und kehren wir zurück, sobald der Dodo-König aufgewacht ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110626
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110626,
					"content": "Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110627
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110627,
					"content": "Natürlich! Du kannst uns vertrauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110628
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 400110628,
					"content": "Hmm ... Nein, ich verstehe es jetzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110629
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110629,
					"content": "Das ist nicht der Dodo-König. Der echte Dodo-König ist woanders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110630
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110630,
					"content": "Hmm? I... Ich verstehe, ist das wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110631
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 400110631,
					"content": "Ich werde nicht aufgeben! Dodo-König, warte nur! Wir finden dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110632
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 400110632,
					"content": "Und schon ist sie wieder weg ... Sie hat echt eine Menge Energie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400110633,
					"content": "Klee, warte auf uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				}
			]
		},
		{
			"id": 4001107,
			"completionStepIds": [
				4001111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
