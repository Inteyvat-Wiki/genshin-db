			},
			"dialogs": [
				{
					"id": 230135201,
					"content": "#{F#Reisende}{M#Reisender}, hast du Schleimabsonderungen besorgt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135202
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135202,
					"content": "Ja, hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135203
					]
				},
				{
					"id": 230135203,
					"content": "#Gut, das reicht. Lutong, kannst du {F#die Reisende}{M#den Reisenden} bezahlen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135204
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135204,
					"content": "Ich muss mir zuerst die Qualität der Schleimabsonderung ansehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135205
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135205,
					"content": "#Hier ist deine Bezahlung, {F#Reisende}{M#Reisender}. Danke, dass du uns wieder geholfen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135206
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135206,
					"content": "Du kannst uns in Zukunft öfter besuchen, wenn du Zeit hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135207
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135207,
					"content": "Falls Herr Garcias Geisteszustand zu sehr ... abnimmt, könntest du mir vielleicht zur Hand gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		}
	]
