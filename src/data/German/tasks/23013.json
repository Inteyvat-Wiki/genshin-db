			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130101,
					"content": "Mein lieber Lutong, bist du ... dir sicher, dass das der Ort ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130102,
					"content": "Jawohl, Herr Garcia. Hier treten Schleime am häufigsten auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130103,
					"content": "Ich zweifle nicht daran, dass sich Schleime hier versammeln. Was mich verunsichert, ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130104,
					"content": "... Findest du nicht, dass hier zu viele Schleime sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130105,
					"content": "Herr Garcia, das liegt daran, dass unsere Finanzen nicht ausreichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130106,
						230130107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130106,
					"content": "Du bist ... Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				},
				{
					"id": 230130108,
					"content": "#{F#Reisende}{M#Reisender}? Was für ein Zufall! Du bist auch in Sumeru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130109,
					"content": "Was machst du denn hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130110
					]
				},
				{
					"id": 230130110,
					"content": "Hahaha, ich bin hier, weil ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130111,
					"content": "... weil er nach Ärger gesucht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130112,
					"content": "... weil ich nach einem Abenteuer gesucht habe. Danke, Lutong, kannst du bitte nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130113,
					"content": "Wie du wünschst, mein Herr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130114,
					"content": "Zurück zum Thema! Ich bin hier, um „Schleimabsonderungen“ als Schmiermittel für meine „Zahlenmaschine“ zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130115,
					"content": "Aber einerseits sind die auf dem Markt vorhandenen „Schleimabsonderungen“ allgemein wegen der langen Aufbewahrungszeit von minderwertiger Qualität. Außerdem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130116,
					"content": "... hat Herr Garcia zu viele Bücher gekauft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130117,
					"content": "... hatten wir zu viele Ausgaben für ... Notwendigkeiten! Deshalb sind wir knapp bei Kasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130118,
					"content": "Also sind wir gekommen, um frische Schleimabsonderungen zu besorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130119,
					"content": "Aber wie du siehst, beherrscht mein lieber Lutong aus Liyue weder Kampf- noch Kochkunst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130120
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130120,
					"content": "Glücklicherweise habe ich ein Händchen für die Buchhaltung ... Das habe ich den komplexen Steuerregelungen des Rats für Allgemeine Angelegenheiten zu verdanken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130121
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130121,
					"content": "... Und ich kann natürlich nicht mit den Teilen meiner „Zahlenmaschine“ kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130122
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130122,
					"content": "Brauchst du meine Hilfe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130123
					]
				},
				{
					"id": 230130123,
					"content": "Gewissermaßen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130124
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130124,
					"content": "Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130125
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130125,
					"content": "Lutong, haben wir ... ähm, haben wir noch Geld?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130126
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130126,
					"content": "#Nun ja, ich denke, wir werden schon auf die eine oder andere Weise überleben, nachdem wir {F#die Reisende}{M#den Reisenden} ausgezahlt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130127
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130127,
					"content": "#Gut! Ich brauche deine Hilfe, {F#Reisende}{M#Reisender}. Sammle bitte etwas Schleimabsonderung für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130107,
					"content": "Was bringt dich hierher?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130108
					]
				}
			]
		},
		{
			"id": 2301302,
