					"Lutong",
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230135001,
					"content": "Dies scheint der Ort zu sein, nach dem wir gesucht haben. Als Nächstes brauchen wir ein paar neue Rekruten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135002,
					"content": "Herr? Herr Garcia, hörst du mir zu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135003
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135003,
					"content": "Huch? Ähem ... Natürlich höre ich dir zu. Dann sollten wir zurückgehen und jemanden anheuern. Das sollte nicht lange dauern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135004
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135004,
					"content": "Geht ... Geht es dir gut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135005
					]
				},
				{
					"id": 230135005,
					"content": "#{F#Reisende}{M#Reisender}, haha ... Keine Sorge, mir geht es gut. Warum sollte es mir nicht gut gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135006,
					"content": "Ich widme mich voll und ganz meiner Forschung zur „Zahlenmaschine“ und ich spüre, dass ich nur einen winzigen Schritt zum Erfolg entfernt bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135007
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135007,
					"content": "Wenn es dich nicht stört, könntest du mir ein bisschen Schleimabsonderung besorgen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135008
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135008,
					"content": "Wenn du schon hier bist, brauche ich nicht zurück in die Stadt gehen und jemand anderes einstellen. Ich bin gerade zu etwas Geld gekommen, also kann ich dir eine bessere Bezahlung anbieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135009,
						230135010
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135009,
					"content": "Überlasse es mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				},
				{
					"id": 230135011,
					"content": "#Dann überlasse ich dir alles, {F#Reisende}{M#Reisender}. Ich muss einen Weg finden, um die Struktur der Maschine zu verbessern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135010,
					"content": "Das ist kein Problem ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				}
			]
		},
