				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130201,
					"content": "Lutong, unsere Finanzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130202
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130202,
					"content": "Wir werden schon durchkommen, Herr Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130203
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130203,
					"content": "In Liyue haben wir ein Sprichwort: „Wo ein Berg ist, ist ein Weg“. Ich finde, es passt sehr gut zu unserer gegenwärtigen Situation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130204
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130204,
					"content": "Es bedeutet, dass wir einen Weg finden werden, auch wenn unser Weg von einem Berg versperrt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130205
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130205,
					"content": "Aha! Was für eine clevere Metapher. Dann ist unsere Lage gar nicht schlimm wie gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130206
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130206,
					"content": "Herr Garcia, meinst du, die Person, die das Sprichwort erfunden hat, hat einen Weg über den Berg gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130207
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130207,
					"content": "Hm? Oh, ach, zum ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
			"id": 2301303,
			"completionStepIds": [
				2301303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301303",
							"2"
						],
						"stepId": 2301303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230130301,
					"content": "#{F#Reisende}{M#Reisender}, hast du Schleimabsonderungen besorgt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130302,
					"content": "Ja, hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130303
					]
				},
				{
					"id": 230130303,
					"content": "Wundervoll! Das sollte ausreichen. Ich werde mit meinem Experiment fortfahren, sobald ich wieder zurück bin. Mit dem Schmiermittel wird meine „Zahlenmaschine“ bestimmt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130304
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130304,
					"content": "Ich muss mit meinen Forschungen weitermachen. Lutong, kümmere du dich um den Rest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130305
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130305,
					"content": "Ja, mein Herr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130306,
					"content": "#Hier ist deine Bezahlung, {F#Reisende}{M#Reisender}. Danke für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130307
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130307,
					"content": "Und ähm ... meiner bescheidenen Meinung nach werden wir deine Hilfe auch in Zukunft benötigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130308
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130308,
					"content": "Bitte sei unbesorgt. Solange ich für die Buchhaltung zuständig bin, wirst du anständig ausgezahlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130309,
					"content": "*seufz* ... Ich reise mit Herrn Garcia, weil ich nicht so enden möchte wie meine Eltern. Sie haben ihr ganzes Leben mit Buchhaltung in einer Abteilung des Rats für Allgemeine Angelegenheiten in Liyue verbracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130310
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130310,
					"content": "Aber jetzt ... unterstütze ich Herrn Garcia bei seinen Berechnungen ... und helfe bei seiner Buchführung aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130311
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130311,
					"content": "Ich schätze, das nennt man „Schicksal“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
		{
			"id": 2301311,
			"completionStepIds": [
				2301301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
