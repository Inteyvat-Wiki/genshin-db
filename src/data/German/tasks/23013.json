						"stepId": 2301301,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_DAILY_TASK_VAR_GT",
						"rawParams": [
							"42020",
							"1",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230131101,
					"content": "Herr Garcia, ich lege dir meine Empfehlung erneut eindringlich ans Herz. Wir können ein paar Bücher verkaufen und ein bisschen Geld beschaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131102,
					"content": "Nein! Auf keinen Fall! Mein lieber Lutong, du möchtest, dass ich meine Seele verkaufe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131103
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131103,
					"content": "Herr, das Problem ist, dass niemand für deine Seele zahlen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131104,
						230131105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131104,
					"content": "Warum bist du denn immer noch hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				},
				{
					"id": 230131106,
					"content": "#{F#Reisende}{M#Reisender}? Was machst du denn hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131107,
					"content": "Ach ... Mein letztes Experiment ist fehlgeschlagen. Ich hatte ein Problem mit der Verdünnung der Schleimabsonderung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131108,
					"content": "Anstelle die Achslager der „Zahlenmaschine“ zu schmieren, hat das Schmiermittel dafür gesorgt, dass sie noch leichter stecken bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131109,
					"content": "Deshalb brauche ich mehr Schleimabsonderung zum Experimentieren. Kannst du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131110,
						230131111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131110,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131120
					]
				},
				{
					"id": 230131120,
					"content": "#{F#Reisende}{M#Reisender}, bitte sammle noch mehr Schleimabsonderung für mich. Ich halte deine Bezahlung bereit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131111,
					"content": "Wisst ihr denn nicht, wie ihr Geld verdienen könnt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131112
					]
				},
				{
					"id": 230131112,
					"content": "Das ist nicht das Problem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131113,
					"content": "... sondern dass uns die Fähigkeit fehlt, Geld zu verdienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131114,
					"content": "Danke für deine hilfreiche Präzisierung, Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131115,
					"content": "Ach, eine Schande, aber ich muss zugeben ... wenn es um die Funktionalität der „Zahlenmaschine“ geht, kann sie nicht sonderlich viel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131116,
					"content": "Wie soll ich sagen ... Selbst „Berechnungen“ kann sie nicht von selbst. Ich muss manuell Hilfestellung leisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131117
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131117,
					"content": "Aber ... ich werde sie verbessern! Ich glaube fest daran, dass meine „Zahlenmaschine“ eine großartige Erfindung sein wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131118,
					"content": "Eine ... Eine Erfindung, die eine neue Ära einläutet! Ich bin mir sicher, dass ich ein Mittel zum Geldverdienen finden werde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131119,
					"content": "A... Aber zuvor ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131120
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131105,
					"content": "Brauchst du noch Schleimabsonderungen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				}
			]
		},
		{
			"id": 2301350,
