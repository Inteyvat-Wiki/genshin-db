			},
			"dialogs": [
				{
					"id": 230135101,
					"content": "#{F#Reisende}{M#Reisender}, wie schön, dass du hier bist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135102,
						230135103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135102,
					"content": "Über Garcia ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135104
					]
				},
				{
					"id": 230135104,
					"content": "Na klar, es ist immer noch wegen Fräulein Kaia. Herr Garcia spricht zwar nie darüber, aber er ist bei der Arbeit immer öfter abgelenkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135105,
					"content": "Außerdem ist er nie wieder zu jenem Kaffeehaus gegangen. Er verlangt nur von mir, ihm Kaffee zu besorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135106
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135106,
					"content": "Selbst Herr Ahangar ist zu mir gekommen und meinte, dass er sich im Notfall mit Herrn Garcia unterhalten könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135107,
					"content": "Ich weiß auch nicht, wie ich ihn von der schiefen Bahn holen kann. Immerhin habe ich keine Erfahrung mit solchen Dingen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135108
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135108,
					"content": "Ach, Herrn Garcia und mich trennt eine neue große Mauer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135103,
					"content": "Er ist immer noch wegen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135104
					]
				}
			]
		},
