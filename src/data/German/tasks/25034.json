			"dialogs": [
				{
					"id": 250340501,
					"content": "#{M#Großer Bursche}{F#Junge Dame}, danke, dass du uns gerettet hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340502
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340502,
					"content": "*brüll* ... *brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340503
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340503,
					"content": "Wir sind viel zu weit vom Stamm entfernt und es gibt keine Möglichkeit, Illapa um Hilfe zu rufen. Ohne dich hätten sie Qica bestimmt verschleppt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340504
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340504,
					"content": "Was machst du hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340505
					]
				},
				{
					"id": 250340505,
					"content": "Wir sind hier zum Klettertraining. Aber auf halbem Weg haben wir Hunger bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340506
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340506,
					"content": "Also bin ich mit Qica los, um ein paar Früchte zu pflücken. Und dabei sind wir wohl weiter gegangen, als wir sollten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340507
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340507,
					"content": "Als wir endlich satt waren, hatten wir uns schon ganz schön weit draußen. Mama wird uns bestimmt wieder die Ohren langziehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340508
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340508,
					"content": "#Danke nochmal, dass du mich gerettet hast, {M#großer Bursche}{F#junge Dame}. Hier, nimm diese Cacahuatl, die ich gerade gepflückt habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340509
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340509,
					"content": "Komm, Qica, wir müssen zurück, schnell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340510
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340510,
					"content": "*brüll*! *brüüüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				}
			]
		}
	]
