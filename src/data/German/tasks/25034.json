			"dialogs": [
				{
					"id": 250340101,
					"content": "Er mag euch nicht, also verschwindet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340102,
					"content": "Sag mal, Kind ... Kennst du diesen Saurier? Was habt ihr miteinander zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340103
					],
					"speakerTitle": "Ungeduldige Diebe"
				},
				{
					"id": 250340103,
					"content": "*brüll* ... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340104
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340104,
					"content": "Schau an, schau an, der Saurier wird ungeduldig! Hau jetzt ab, Kleiner, wir verprügeln keine Kinder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340105
					],
					"speakerTitle": "Ungeduldige Diebe"
				},
				{
					"id": 250340105,
					"content": "He, Leute, holt einen Sack. Für diesen Saurier kriegen wir bestimmt eine Menge Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340106
					],
					"speakerTitle": "Ungeduldige Diebe"
				},
				{
					"id": 250340106,
					"content": "Keinen Schritt weiter! Noch ein Schritt und ich zeig dir, was ich kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340107,
					"content": "Du willst uns was zeigen? Hahaha, Leute, der Kleine will uns eine Lektion erteilen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340108
					],
					"speakerTitle": "Ungeduldige Diebe"
				},
				{
					"id": 250340108,
					"content": "Oh, ich zittere schon vor Angst. Aber wenn du schon so mutig bist, dann beschwere dich hinterher nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340109
					],
					"speakerTitle": "Ungeduldige Diebe"
				},
				{
					"id": 250340109,
					"content": "*brüll*! *brüüüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340110
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340110,
					"content": "Der kleine Saurier ist ja richtig frech ... Kleiner, schlaf lieber eine Runde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340111,
						250340112
					],
					"speakerTitle": "Ungeduldige Diebe"
				},
				{
					"id": 250340111,
					"content": "Ihr seid diejenigen, die ein Nickerchen machen sollten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				},
				{
					"id": 250340113,
					"content": "#{M#Großer Bursche}{F#junge Dame}! Das sind Bösewichte! Sie wollen Qica entführen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340114
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340114,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340115
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340115,
					"content": "... He, du unbeteiligter Passant! Wie wäre es, wenn du dich raushältst, dann teilen wir nämlich den Gewinn mit dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340116,
						250340117
					],
					"speakerTitle": "Ungeduldige Diebe"
				},
				{
					"id": 250340116,
					"content": "Wagt es nicht, Qica etwas anzutun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340118,
					"content": "Du willst nicht hören, was? Dann klären wir das eben auf die altbekannte Weise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340119
					],
					"speakerTitle": "Ungeduldige Diebe"
				},
				{
					"id": 250340119,
					"content": "Hehe ... Leute, schnappt ihn euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ungeduldige Diebe"
				},
				{
					"id": 250340117,
					"content": "Wir brauchen deine „Freundlichkeit“ nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340112,
					"content": "Und ihr solltet euch später auch nicht beschweren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				}
			]
		},
