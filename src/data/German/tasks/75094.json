							9642.107
						],
						"pointId": 9945
					}
				]
			},
			"dialogs": [
				{
					"id": 751260601,
					"content": "Wer hätte gedacht, dass sowas mal passiert ist ... Milchi und die Leute, die diese Notizen hinterlassen haben, waren echt tapfer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260602,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260603,
					"content": "Hier ist es ... das schlafende Saurierei, das in den Notizen erwähnt wurde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260604,
					"content": "#Willst du, dass wir das Ei mit dem Brüter ausbrüten, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260605,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260606,
					"content": "#Hm, das Saurierei sieht gut aus, und der Brüter hat auch eine Anleitung. {NICKNAME}, wollen wir es mal ausprobieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260607,
						751260608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260607,
					"content": "Auch wenn nicht sicher ist, ob es funktioniert, ein Versuch lohnt sich allemal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751260609
					]
				},
				{
					"id": 751260609,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260608,
					"content": "Juhuu! Der Kleine wird bald einen neuen Gefährten haben!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751260609
					]
				}
			]
		}
	]
}