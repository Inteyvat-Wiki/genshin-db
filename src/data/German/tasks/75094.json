		{
			"id": 7509406,
			"completionStepIds": [
				7509406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7509406",
							"2"
						],
						"stepId": 7509406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"#{REALNAME[ID(2)|SHOWHOST(true)]}",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750940601,
					"content": "Puh ... Welch ein Schreck! Das Monster hat uns aus dem Nichts angegriffen! Zum Glück sind wir stark genug!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940602,
						750940604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940602,
					"content": "Dann überlasse ich das beim nächsten Mal dir, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940603
					]
				},
				{
					"id": 750940603,
					"content": "Was? Nein, nein, das kannst du nicht Paimon überlassen! Paimon kämpft sicher nicht wieder gegen diese gruseligen Monster!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940606,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940607
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940607,
					"content": "#{NICKNAME}, schau mal, der Kleine wird unruhig. Lass uns lieber schauen, wie wir das Saurierei ausbrüten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940608,
					"content": "Den Brüter aktivieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940609
					]
				},
				{
					"id": 750940609,
					"content": "Der Brüter hat seine Arbeit wieder aufgenommen ...\\nNun bleibt euch nichts anderes übrig, als zu warten ...\\nDoch die Zeit verstrich ... und das Saurierei zeigt keinerlei Veränderung, nicht den kleinsten Anschein ...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940610
					]
				},
				{
					"id": 750940610,
					"content": "*brüll* ... *brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940611
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940611,
					"content": "Seltsam, es passiert einfach nichts! Haben wir irgendwas falsch gemacht? Lass es uns nochmal versuchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940612,
						750940632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940612,
					"content": "Versuchen wir es noch einmal ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940613
					]
				},
				{
					"id": 750940613,
					"content": "Ihr habt den Brüter gemäß der Anleitung neu gestartet ...\\nDoch wie zuvor bleibt das Saurierei völlig unverändert ...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940614
					]
				},
				{
					"id": 750940614,
					"content": "Ach ... Wie lange sollen wir denn noch warten? Paimons Augen flimmern schon ... der Kopf dreht sich ... und der Magen knurrt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940615,
					"content": "*brüll* ... *brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940616
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940616,
					"content": "Äh? Hä!? Warte mal! Es hat sich gerade bewegt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940617,
						750940627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940617,
					"content": "Wollen wir nicht noch ein bisschen Geduld haben ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940618
					]
				},
				{
					"id": 750940618,
					"content": "Wieder vergeht eine schiere Ewigkeit ...\\nDas Saurierei bleibt unverändert, ohne irgendeine Veränderung, ohne Anzeichen, dass bald etwas schlüpfen würde.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940619
					]
				},
				{
					"id": 750940619,
					"content": "Immer noch keine Reaktion ... Ist der Brüter vielleicht kaputt? Aber er leuchtet doch! Liegt es vielleicht am Ei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940620,
					"content": "... Hmm, hier herumzusitzen bringt nichts ... Wollen wir das Ei nicht einfach mitnehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940621,
						750940624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940621,
					"content": "Egal wie hungrig du bist, denk bloß nicht dran, das Saurierei zu essen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940622
					]
				},
				{
					"id": 750940622,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940623
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940623,
					"content": "#Natürlich würde Paimon das Ei nicht essen! {REALNAME[ID(2)|SHOWHOST(true)]} bekommt noch ganz falsche Vorstellungen, wenn du so etwas sagst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940626,
					"content": "Kleiner, weißt du, wenn das Problem wirklich am Ei liegt, dann wird es vielleicht niemals ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940634,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940635
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940635,
					"content": "#Sei nicht traurig, {REALNAME[ID(2)|SHOWHOST(true)]}, wir können nichts daran ändern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940636,
						750940637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940636,
					"content": "Vielleicht ist nur die Umgebung hier einfach nicht geeignet ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940638,
					"content": "Ja genau! Vielleicht schlüpft es nicht, weil das Ei denkt, Natlan sei immer noch so wie früher und taugt überhaupt nicht als sein Zuhause!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940639,
					"content": "Es war ja die ganze Zeit hier versteckt. Es kann unmöglich wissen, wie großartig Natlan inzwischen geworden ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940640
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940640,
					"content": "Also lass uns das Ei mitnehmen und es liebevoll pflegen! Jeden Tag erzählen wir ihm Geschichten von den herrlichen Landschaften, den aufregenden Abenteuern und all den wunderbaren Menschen, die wir getroffen haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940641,
					"content": "Kurz gesagt, wir müssen ihm klarmachen, wie toll Natlan jetzt ist! Wenn es das merkt, wird es ganz von selbst schlüpfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940642,
					"content": "... *brüll*.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940637,
					"content": "Oder vielleicht ist das Ei der Meinung, dass die Zeit noch nicht reif ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940624,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, was meinst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940625
					]
				},
				{
					"id": 750940625,
					"content": "*brüll* ... *brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940627,
					"content": "Nein, das hat es nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940628
					]
				},
				{
					"id": 750940628,
					"content": "#Was?! Aber ... eben ... Hat Paimon sich das nur eingebildet? Nein, nein! {REALNAME[ID(2)|SHOWHOST(true)]}, hast du das auch gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940629,
					"content": "*brüll* ... *brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940630
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940630,
					"content": "#Ach ... Der Kleine hat es auch nicht gesehen? War das wirklich nur eine Täuschung? Was machen wir jetzt, {NICKNAME}? Sollen wir weiter warten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940631,
					"content": "Oder liegt das Problem doch beim Ei? A... Aber, wenn das so ist, heißt das, es wird nie schlüpfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940632,
					"content": "Es liegt wahrscheinlich am Ei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940633
					]
				},
				{
					"id": 750940633,
					"content": "Ah? Heißt das ... das Ei wird vielleicht niemals schlüpfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940604,
					"content": "Ach, das war doch ein Klacks.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940605
					]
				},
				{
					"id": 750940605,
					"content": "Genau! So zähnefletschend wie die aussahen, dachte Paimon, die wären besonders starke Gegner! Dabei waren ihre Angriffe kaum schlimmer als die Stupser von dem Kleinen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7512606,
