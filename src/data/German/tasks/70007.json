				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mann, der Zaubertricks vorführt",
					"Verliebte Frau"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070301,
					"content": "Wie bitte? Wolltest du etwas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070302,
						700070303
					],
					"speakerTitle": "Verliebte Frau"
				},
				{
					"id": 700070302,
					"content": "Ihr müsst in der Bibliothek leise sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				},
				{
					"id": 700070304,
					"content": "Entschuldigung, ich werde mehr darauf achten. Aber manchmal muss ich meinen Gefühlen Ausdruck verleihen, ich kann nichts dagegen tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070305
					],
					"speakerTitle": "Verliebte Frau"
				},
				{
					"id": 700070305,
					"content": "Als du nicht aufgepasst hast, habe ich diese Rose aus den Seiten hervorgezaubert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070306
					],
					"speakerTitle": "Mann, der Zaubertricks vorführt"
				},
				{
					"id": 700070306,
					"content": "Diese aus dem Buch geborene Rose ist genau wie du – zerbrechlich und voll von intelligenter Schönheit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070307
					],
					"speakerTitle": "Mann, der Zaubertricks vorführt"
				},
				{
					"id": 700070307,
					"content": "Wa...?! Das war unglaublich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070308
					],
					"speakerTitle": "Verliebte Frau"
				},
				{
					"id": 700070308,
					"content": "Ihr seid zu laut! Und Bücher sind keine Requisite für irgendwelche Magie-Spielereien! Du wirst sie noch kaputt reißen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070309,
					"content": "Du solltest auch auf deine Lautstärke achten, Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070310
					]
				},
				{
					"id": 700070310,
					"content": "Oh, tut mir leid, Paimon wollte das nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070311,
					"content": "Jetzt verstehst du es. Einige Dinge können wir nicht kontrollieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070312
					],
					"speakerTitle": "Verliebte Frau"
				},
				{
					"id": 700070312,
					"content": "Ich möchte mich nochmal entschuldigen, ich werde von nun an darauf achten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070313
					],
					"speakerTitle": "Verliebte Frau"
				},
				{
					"id": 700070313,
					"content": "Scheint nicht so, als ob sie es ernst genommen haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070303,
					"content": "Jemand hat sich beschwert, dass ihr zu laut seid.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				}
			]
		},
		{
			"id": 7000704,
			"completionStepIds": [
				7000704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000704",
							"2"
						],
						"stepId": 7000704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Scheinbar vernünftiger Mann",
					"Scheinbar vernünftige Frau"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070401,
					"content": "Du behauptest, dass „die Fluktuation von Emotionen die Genauigkeit von Forschung und Analyse beeinflussen könnte“? Diese Aussage ist nicht ausreichend begründet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070402
					],
					"speakerTitle": "Scheinbar vernünftige Frau"
				},
				{
					"id": 700070402,
					"content": "Äh, das ist mir klar. Ich bin bei meinen Untersuchungen auf ein seltsames Hindernis gestoßen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070403
					],
					"speakerTitle": "Scheinbar vernünftiger Mann"
				},
				{
					"id": 700070403,
					"content": "#Du kommst gerade im rechten Augenblick. Ich stecke gerade etwas in Schwierigkeiten und würde gerne deine Meinung als {F#Nichteinheimische}{M#Nichteinheimischer} hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070404
					],
					"speakerTitle": "Scheinbar vernünftiger Mann"
				},
				{
					"id": 700070404,
					"content": "Wenn ich mich auf meine Logikfähigkeiten verlassen will, muss ich einen kühlen Kopf bewahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070405
					],
					"speakerTitle": "Scheinbar vernünftiger Mann"
				},
				{
					"id": 700070405,
					"content": "Aber das will mir nie gelingen, insbesondere nicht, wenn ich mit ihr diskutiere. Ich kann einfach nicht ruhig bleiben und nachdenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070406
					],
					"speakerTitle": "Scheinbar vernünftiger Mann"
				},
				{
					"id": 700070406,
					"content": "Das finde ich auch seltsam. Hast du letzte Nacht nicht gut geschlafen? Oder hast du einen Kater?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070407,
						700070408
					],
					"speakerTitle": "Scheinbar vernünftige Frau"
				},
				{
					"id": 700070407,
					"content": "So oder so solltest du in der Bibliothek nicht so laut sprechen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070408
					]
				},
				{
					"id": 700070408,
					"content": "So oder so solltet ihr beide euch etwas ruhiger verhalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070409
					]
				},
				{
					"id": 700070409,
					"content": "Tut mir leid, aber ich werde nicht ruhen können, bis ich das herausgefunden habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070410
					],
					"speakerTitle": "Scheinbar vernünftiger Mann"
				},
				{
					"id": 700070410,
					"content": "Er ... er hat gar nicht zugehört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070411,
					"content": "Du solltest andere trotzdem nicht stören. Und hör auf damit, die Bücher falsch herum ins Regal zurückzustellen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070412,
					"content": "Uff ... sie schenken uns gar keine Aufmerksamkeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
