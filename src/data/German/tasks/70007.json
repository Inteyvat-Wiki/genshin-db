			"dialogs": [
				{
					"id": 700070701,
					"content": "*seufz* Hier ist wohl niemand scharf auf einen guten Rat, hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070702,
					"content": "Keiner von ihnen legt ein gutes Benehmen in der Bibliothek an den Tag. Wir sollten mit Wyratt darüber sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000708,
			"completionStepIds": [
				7000708
			],
			"beginWay": "TALK_BEGIN_NONE",
