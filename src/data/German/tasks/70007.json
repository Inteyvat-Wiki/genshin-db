					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Verliebter junger Mann",
					"Verliebte junge Frau"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070201,
					"content": "So eine aufregende Geschichte! Schade, dass sie keinen positiven Ausgang hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070202
					],
					"speakerTitle": "Verliebter junger Mann"
				},
				{
					"id": 700070202,
					"content": "Wir werden sicherlich nicht so, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070203
					],
					"speakerTitle": "Verliebte junge Frau"
				},
				{
					"id": 700070203,
					"content": "Das ist selbstverständlich. Selbst wenn wir getrennt und in alle Winde zerstreut wären, würde ich einen Weg finden, dich zu mir zurückzubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070204,
						700070205
					],
					"speakerTitle": "Verliebter junger Mann"
				},
				{
					"id": 700070204,
					"content": "Ihr müsst in der Bibliothek leise sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				},
				{
					"id": 700070206,
					"content": "Was? Ich habe die ganze Zeit ganz leise gesprochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070207
					],
					"speakerTitle": "Verliebte junge Frau"
				},
				{
					"id": 700070207,
					"content": "Hm, es ist wie im Buch. Ein Hindernis, das unserer Liebe im Wege liegt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070208
					],
					"speakerTitle": "Verliebter junger Mann"
				},
				{
					"id": 700070208,
					"content": "Ihr solltet die Bücher nach dem Lesen außerdem dorthin zurücklegen, wo sie hingehören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070209,
					"content": "Seht euch all die durcheinander liegenden Bücher an. Jemand muss sie wieder zurück zu ihrem richtigen Regal bringen ... Und dieser Jemand wird von dieser Unordnung nicht sehr erfreut sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070210,
					"content": "Ja, ja, wir haben es verstanden. Kannst du uns jetzt alleine lassen? Du hast uns zu einem entscheidenden Moment unterbrochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070211
					],
					"speakerTitle": "Verliebter junger Mann"
				},
				{
					"id": 700070211,
					"content": "Entscheidender Moment ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070212,
					"content": "Versprichst du mir, egal welche Schwierigkeiten sich uns auch in den Weg stellen, immer so, wie du jetzt bist, zu bleiben und dich nie zu verändern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070213
					],
					"speakerTitle": "Verliebte junge Frau"
				},
				{
					"id": 700070213,
					"content": "Das werde ich. Ich schwöre es dir bei meinem Leben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070214
					],
					"speakerTitle": "Verliebter junger Mann"
				},
				{
					"id": 700070214,
					"content": "Das scheint vielleicht etwas extrem ... Aber der bloße Gedanke, dich verlieren zu können, zerbricht mein Herz in zwei Hälften.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070215
					],
					"speakerTitle": "Verliebte junge Frau"
				},
				{
					"id": 700070215,
					"content": "Dein sanftes Wesen macht mich noch verrückter nach dir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070216
					],
					"speakerTitle": "Verliebter junger Mann"
				},
				{
					"id": 700070216,
					"content": "Als ob man mit einer Wand spricht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070205,
					"content": "Jemand hat sich beschwert, dass ihr zu laut seid.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				}
			]
		},
		{
			"id": 7000703,
			"completionStepIds": [
				7000703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
