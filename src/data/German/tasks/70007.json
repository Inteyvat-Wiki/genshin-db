			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070101,
					"content": "Ye ika gusha mosi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070102,
						700070103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070102,
					"content": "Du scheinst aufgebracht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				},
				{
					"id": 700070104,
					"content": "Tut mir leid ... Das liegt daran, dass es in der Bibliothek in letzter Zeit so laut ist und ich nicht in Ruhe Hilichurlisch lernen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070105,
					"content": "Seit Beginn des Windblumenfestes tummeln sich hier viele Leute. Am Anfang waren sie still und lasen Bücher, aber dann fingen sie an ... zu plaudern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070106
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070106,
					"content": "Aber das ist noch nicht alles ... Sie haben viele verstörende Dinge getan ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070107,
					"content": "Eselsohren ... Seltsame Objekte zwischen die Seiten stecken ... Sie sind sogar so weit gegangen, die Bücher falsch herum wieder in die Regale zu stellen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070108,
					"content": "Eine Bibliothek ist kein Ort für romantische Verabredungen! Es sei denn man will alle Gelehrten stören, die dort studieren, wie es ja vorgesehen ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070109,
						700070111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070109,
					"content": "Wyratt sollte hier für Ordnung sorgen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070110
					]
				},
				{
					"id": 700070110,
					"content": "Was kann er schon tun? Die Leute rauszuwerfen, wird die Wurzel des Problems nicht lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070113,
					"content": "Deshalb muss ich dich um Hilfe bitten. Bitte sag ihnen, sie sollen sich zusammenreißen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070114,
						700070115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070114,
					"content": "Ich kümmere mich drum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070116,
					"content": "Danke. Die drei Pärchen dort drüben machen den meisten Lärm. Wenn du ihnen klarmachen kannst, wie störend ihr Geplapper ist, werde ich meine Forschung fortsetzen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070117
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070117,
					"content": "Aber sei vorsichtig. Sie sind ein bisschen schwierig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070115,
					"content": "Ich werde mal sehen, was ich tun kann.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070111,
					"content": "Lisa könnte das Problem lösen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070112
					]
				},
				{
					"id": 700070112,
					"content": "Aber ich habe gehört, dass sie momentan mit dem stellvertretenden Großmeister auf Patrouille ist. Wenn sie hier wäre, würden sich die Pärchen sicherlich alle bestens benehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700070103,
					"content": "Du klingst angespannter als sonst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				}
			]
		},
		{
			"id": 7000702,
			"completionStepIds": [
				7000702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
