					"Wyratt"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070801,
					"content": "In der Bibliothek ist es ziemlich unruhig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070802
					]
				},
				{
					"id": 700070802,
					"content": "Ich verstehe ... Dann werden wir wohl „diese Methode“ anwenden müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070803
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070803,
					"content": "Lisa hat in der Vergangenheit bereits erwähnt, dass das Brechen der Bibliotheksregeln Konsequenzen haben wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070804
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070804,
					"content": "Würde es dir etwas ausmachen, Lisas Nachricht in der Bibliothek zu verbreiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070805
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 700070805,
					"content": "Eselsohren, Rosen in Bücher zu stecken, sie falsch herum ins Regal zu stellen ... Das sind definitiv Verstöße gegen die Bibliotheksregeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700070806,
					"content": "Gehen wir und verbreiten diese Nachricht unter den Leuten, die in der Bibliothek sitzen und keine Bücher lesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7000710,
