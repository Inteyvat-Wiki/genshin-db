				"points": []
			},
			"dialogs": [
				{
					"id": 700071001,
					"content": "Hä?! Was? Lisa kommt bald zurück?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071002,
					"content": "Oh nein! Sie wird sicher furchtbar aufgebracht sein, wenn sie herausfindet, dass Leute die Bücher durcheinandergebracht und sogar Eselsohren in die Seiten gemacht haben, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071003,
					"content": "Oh nein! Wie furchtbar! Wer wird uns nur retten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071004
					]
				},
				{
					"id": 700071004,
					"content": "Oh, was sollen wir nur tun? Oh nein! Vielleicht schaffen wir es noch rechtzeitig, wenn wir jetzt mit dem Aufräumen beginnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700071005,
					"content": "Das war wirklich genial von dir. Wie unerwartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071006
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700071006,
					"content": "Das war Wyratts Idee.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071007
					]
				},
				{
					"id": 700071007,
					"content": "Na ja, Lisas Ruf eilt ihr voraus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700071008
					]
				},
				{
					"id": 700071008,
					"content": "Dennoch ... Lisa wäre vermutlich wütend gewesen, hätte sie gesehen, in welchem Zustand sich die Bibliothek befand. Dies ist schließlich eine Bibliothek, ein Ort des Lernens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071009
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700071009,
					"content": "Jetzt kann ich meine Forschung wohl endlich in Ruhe fortsetzen. Hier, nimm dies als Dankeschön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
