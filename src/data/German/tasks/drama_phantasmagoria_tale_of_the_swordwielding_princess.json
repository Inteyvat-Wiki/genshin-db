			"dialogs": [
				{
					"id": 790260101,
					"content": "Willkommen! Willkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260102
					],
					"speakerTitle": "Leiter der Theatergruppe Zwielicht"
				},
				{
					"id": 790260102,
					"content": "Willkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260104
					],
					"speakerTitle": "Leiter der Theatergruppe Zwielicht"
				},
				{
					"id": 790260104,
					"content": "#Du bist {F#die}{M#der} berühmte {NICKNAME}! Und die beste Partnerin, die ehrwürdige Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260105
					],
					"speakerTitle": "Leiter der Theatergruppe Zwielicht"
				},
				{
					"id": 790260105,
					"content": "Oh! Woher kennst du unsere Namen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260106,
					"content": "Ihr seid hochgeschätzte Gäste auf dieser Insel, also muss ich das natürlich wissen. Schließlich bin ich es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260107
					],
					"speakerTitle": "Leiter der Theatergruppe Zwielicht"
				},
				{
					"id": 790260107,
					"content": "Du bist ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260108,
					"content": "Ich bin der berühmte Leiter der Theatergruppe Zwielicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260109
					],
					"speakerTitle": "Leiter der Theatergruppe Zwielicht"
				},
				{
					"id": 790260109,
					"content": "Es gibt also wirklich Leute, die sich berühmt nennen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790260110
					]
				},
				{
					"id": 790260110,
					"content": "Obwohl du behauptest, berühmt zu sein, haben wir noch nie von dir gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790260111,
					"content": "Das macht nichts! Jetzt habt ihr beide ja von mir gehört!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260112
					],
					"speakerTitle": "Leiter der Theatergruppe Zwielicht"
				},
				{
					"id": 790260112,
					"content": "Nach intensiven Vorbereitungen steht unser Theaterstück „Märchen von der schwertschwingenden Prinzessin“ kurz vor der Premiere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260113
					],
					"speakerTitle": "Leiter der Theatergruppe Zwielicht"
				},
				{
					"id": 790260113,
					"content": "Das Stück besteht aus fünf Akten und jeder Akt ist in zwei Szenen unterteilt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260114
					],
					"speakerTitle": "Leiter der Theatergruppe Zwielicht"
				},
				{
					"id": 790260114,
					"content": "Ihr kommt genau zur richtigen Zeit! Der Prolog beginnt gleich! Bitte nehmt eure Plätze ein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260115
					],
					"speakerTitle": "Leiter der Theatergruppe Zwielicht"
				},
				{
					"id": 790260115,
					"content": "Ich muss mich noch um etwas hinter der Bühne kümmern. Bitte entschuldigt mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790260116
					],
					"speakerTitle": "Leiter der Theatergruppe Zwielicht"
				},
				{
					"id": 790260116,
					"content": "Das fabelhafte Theater der Theatergruppe Zwielicht wird bald beginnen, viel Spaß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leiter der Theatergruppe Zwielicht"
				}
			]
		}
	]
}