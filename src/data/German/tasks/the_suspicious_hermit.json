			"dialogs": [
				{
					"id": 761140201,
					"content": "Hallo, ist da jemand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140202
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140202,
					"content": "Bist du zu Hause, Herr Derwent?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140203,
					"content": "... Wer ist da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140204
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140204,
					"content": "Ich bin Jahoda vom „Kuratorium der Geheimnisse“. Ich wollte dir ein paar Fragen stellen und bin deshalb persönlich gekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140205
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140205,
					"content": "... Frag nur. Ich bin aber krank, kann also nicht aufstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140206
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140206,
					"content": "(Seltsam ... Die Kinder der Meeresschnecken-Bande meinten, Herr Derwent habe ihnen das Lesen beigebracht und immer ganz einfühlsam mit ihnen gesprochen ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140207
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140207,
					"content": "(Jetzt klingt seine Stimme heiser, aber nicht wie bei einer Krankheit, sondern als wäre sie von Natur aus so ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140208
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140208,
					"content": "Aber du kommst zurecht, oder? Wenn es gar nicht mehr geht, kann ich auch einen Arzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140209,
					"content": "... Schon gut. Mir wird’s schon bald wieder besser gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140210
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140210,
					"content": "Na gut, dann geh nach Nasha, wenn du wieder fit bist. Deine Freunde machen sich nämlich Sorgen um dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140211
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140212
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140212,
					"content": "(... Warum sagt er nichts? Ich höre jemanden im Haus herumgehen, aber die Schritte klingen ziemlich schwer ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140213,
					"content": "Du warst in letzter Zeit wohl kaum draußen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140214,
					"content": "... Um mich ganz auf meine Selbstkultivierung zu konzentrieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140215
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140215,
					"content": "Ich hab gehört, dass du in letzter Zeit ganz anders aussiehst. Einige Leute hätten nie gedacht, dass du so gut gebaut bist. In deinem Einsiedlergewand hat man das nämlich gar nicht erkennen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140216
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140216,
					"content": "Oh, und dann noch diese Maske gegen das Kuuvahki ... trägt man das denn jetzt so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140217
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140217,
					"content": "... Damit schirme ich mich von den störenden Geräuschen von außerhalb ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140218
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140218,
					"content": "Und ist die auch für deine Selbstkultivierung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140219
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140220
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140220,
					"content": "Der reisende Händler, der dich neulich besucht hat, weißt du, wohin er danach gegangen ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140221
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140221,
					"content": "... Weiß ich nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140222
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140222,
					"content": "Oh ... na gut. Dann stör ich dich nicht länger. Entschuldige die Störung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140223
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140223,
					"content": "(Ich weiß nicht warum, aber ich hab das Gefühl, es könnte gefährlich werden, wenn ich weiter frage ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140224
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140224,
					"content": "(Hm, sie haben recht ... es ist, als wäre er eine ganz andere Person geworden ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140225
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140225,
					"content": "(Ich hab viel zu wenig herausgefunden ... so kann ich doch nicht einfach zu Chefin Nef zurück. Ich sollte hier in der Nähe lieber noch mal genauer nachsehen.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
