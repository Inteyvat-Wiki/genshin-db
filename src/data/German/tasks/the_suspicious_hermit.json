			"dialogs": [
				{
					"id": 761140101,
					"content": "Diesmal geht es also um ... den „verdächtigen Einsiedler“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140102
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140102,
					"content": "Sind Einsiedler nicht sowieso so eine Art Sonderlinge? Wer in solchen abgelegenen Bergen lebt, da wundert’s doch nicht, wenn er sich komisch verhält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140103,
					"content": "Aber für Veränderungen gibt’s immer einen Grund, egal ob er von innen kommt oder von außen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140104
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140104,
					"content": "Außerdem machen mir die verschwundenen reisenden Händler auch Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140105,
					"content": "Hm? Aber die Gegend ist doch supergefährlich, das weiß jeder. Da kann man von Räubern überfallen oder von Monstern angegriffen werden ... Möglichkeiten gibt’s genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140106,
					"content": "Und genau weil das jeder weiß, haben die reisenden Händler dort natürlich ihre eigenen Wege, damit umzugehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140107,
					"content": "Trotzdem ist ein erfahrener Händler verschwunden, also steckt da bestimmt mehr dahinter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140108,
					"content": "Jahoda, diesmal gehst du selbst zu diesem „verdächtigen Einsiedler“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140109,
					"content": "Der Weg ist weit, also bleib besser auf der Hauptstraße.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140110,
					"content": "Ah? Schon klar, Chefin! So eine Kleinigkeit kannst du getrost mir überlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
		{
