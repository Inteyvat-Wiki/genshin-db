			},
			"dialogs": [
				{
					"id": 761140301,
					"content": "(Hm? Das ... sieht aus, als wär es noch nicht gänzlich verbrannt ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140302
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140302,
					"content": "(Ich hab mal gehört, dass Herr Derwent immer wieder verletzte Abenteurer aufgenommen hat ... das scheint erst vor Kurzem passiert zu sein.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140303
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140303,
					"content": "(Warum hat er das alles verbrannt ...?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
