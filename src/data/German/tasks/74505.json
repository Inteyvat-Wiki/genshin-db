			"dialogs": [
				{
					"id": 745050101,
					"content": "H... Hallo, i... ihr b... beide, i... ich ... ich bin A... Armand ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050102
					],
					"speakerTitle": "Armand"
				},
				{
					"id": 745050102,
					"content": "Du siehst etwas nervös aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745050103,
					"content": "E... Entschuldigung! B... Bei vielen M... Menschen w... werde ich n... nervös.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050104
					],
					"speakerTitle": "Armand"
				},
				{
					"id": 745050104,
					"content": "Kein Problem, nimm dir ruhig Zeit! Wir sind nur hier, um diese Spielzeuge auszuprobieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745050105,
					"content": "Gut. I... Ich habe ein Hand... Handbuch f... für euch v... vorbereitet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050106
					],
					"speakerTitle": "Armand"
				},
				{
					"id": 745050106,
					"content": "Oh, das ist sehr nett von dir, Armand! Wir werden es später sorgfältig lesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745050107,
					"content": "Es i... ist in Ordnung, auch wenn ihr es n... nicht lest. Das i... ist leicht u... und lustig. W... Wollt ihr es a... ausprobieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745050108
					],
					"speakerTitle": "Armand"
				},
				{
					"id": 745050108,
					"content": "Danke, ich probiere es mal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745050109
					]
				},
				{
					"id": 745050109,
					"content": "Ich h... hoffe, ihr h... habt Spaß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Armand"
				}
			]
		}
