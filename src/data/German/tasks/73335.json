				]
			},
			"dialogs": [
				{
					"id": 733350701,
					"content": "Oha! Sorush, du bist einfach großartig. Du hast die Umgebung hier in einem Aufwasch wieder mit Lebenskraft gefüllt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733350702,
					"content": "Die Pari verfügen über wirklich erstaunliche Kräfte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733350703
					]
				},
				{
					"id": 733350703,
					"content": "Das war doch ein Kinderspiel! Mit meinen Fähigkeiten werden wir die „Sunyata-Blumen“ im Handumdrehen retten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350704
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350704,
					"content": "Die dunkle Korrosion breitet sich noch immer aus. Diese „Sunyata-Blumen“ hier sind nur einige ihrer vielen Opfer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350705
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350705,
					"content": "Die anderen Blumenteiche konnten diesem Unheil ebenfalls nicht entgehen. Sefana wird wohl ganz außer sich vor Sorge sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350706
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350706,
					"content": "Diese Sefana, von der du sprichst, sollte eine nette Pari sein, die sich so fleißig um die Blumen kümmert, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733350707,
					"content": "#Wir sollten dieser Pari helfen, meinst du nicht auch, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733350708,
					"content": "Diese kleine Leistung könnte man durchaus als eine kleine Verzierung auf dem Pfad einer großen und rechtschaffenen Karriere ansehen. Mein Yasnapati, du solltest gut auf diese „Sunyata-Blumen“ achten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733350709
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733350709,
					"content": "Wenn ich das nächste Mal welche sehe, werde ich dir gleich Bescheid geben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733350710
					]
				},
				{
					"id": 733350710,
					"content": "Ja, lasst uns zusammen diese hübschen Blumen retten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
