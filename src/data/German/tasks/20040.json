			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vind"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200400401,
					"content": "Hmm ... es ist ziemlich ruhig heute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400402
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400402,
					"content": "Vennessa persönlich hat unserer Familie den Auftrag gegeben, hier nach Stürmen Ausschau zu halten. Das machen wir nun Generation für Generation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400403
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400403,
					"content": "Dennoch muss ich sagen, dass der Aussichtsturm irgendwann nicht mehr weiter gepflegt wurde, weil es keine Stürme mehr gab, seit Barbatos Mondstadt beschützt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400404
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400404,
					"content": "Doch obgleich dem so ist, gehe ich aus freien Stücken zum Aussichtsturm, um nach Stürmen Ausschau zu halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400405,
						200400408
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400405,
					"content": "Du bist wirklich pflichtbewusst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400406
					]
				},
				{
					"id": 200400406,
					"content": "Danke. Da wir aber von Pflicht reden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400407
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400407,
					"content": "Ich hoffe, dass es nie dazu kommt, dass ich meiner Pflicht nachkommen muss, einen Sturm zu melden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400410,
					"content": "Jedenfalls bin ich dir zu Dank verpflichtet. Windmühlenastern als Gegenleistung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400411
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400411,
					"content": "Unsere Familie hat früher anhand der Windmühlenastern die Stärke des Windes in einem bestimmten Gebiet abgelesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400412
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400412,
					"content": "Diese Windmühlenastern gibt es nicht an sehr windigen Orten oder an solchen, wo kein einziges Lüftchen weht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400413
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400413,
					"content": "Sie wachsen nur an Orten wie Mondstadt, wo immer ein sanfter Wind weht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400414
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400414,
					"content": "Hoffentlich wachsen sie weiter so schön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400408,
					"content": "Die Vergangenheit zeigt, dass das verheerend wäre ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400409
					]
				},
				{
					"id": 200400409,
					"content": "Ja, hoffen wir, dass so etwas nie wieder geschehen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "Vind"
				}
			]
		},
		{
			"id": 2004005,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
