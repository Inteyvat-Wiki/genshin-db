			},
			"dialogs": [
				{
					"id": 200400301,
					"content": "Hm ... Glaubst du, man könnte direkt an der Seite hoch laufen, wenn man nur genügend Anlauf hätte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
