			"dialogs": [
				{
					"id": 120170401,
					"content": "Nun wird dieser Moment verewigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170402
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170402,
					"content": "Nun gut, wieder etwas Neues gelernt. Fangen wir an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				}
			]
		},
		{
			"id": 1201705,
			"completionStepIds": [
				1201705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201705",
							"2"
						],
						"stepId": 1201705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170501,
					"content": "So, das ist das Bild, das gerade für dich aufgenommen wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170502,
					"content": "Es ist ... so magisch. Ist es eine Art Zauber? Ist das da drin ... Ist es eine weitere Kopie von mir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170503
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170503,
					"content": "Aber dann scheint sie sich auch wieder nicht zu bewegen oder zu sprechen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170504,
						120170505
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170504,
					"content": "Dies ist nur eine Aufnahme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170506
					]
				},
				{
					"id": 120170506,
					"content": "Ich dachte erst, es wäre keine gute Aufnahme, mein Körper war ein bisschen steif, aber jetzt sieht es viel natürlicher aus, als ich dachte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170507
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170507,
					"content": "Die Bewegungen sind genau gleich und die Aussicht hinten ist genau gleich ... Wie wird das gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170508
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170508,
					"content": "Das ist die Stärke des Apparats.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170509,
					"content": "Warte, ich verstehe immer noch nicht ganz, wie es funktioniert, erkläre es mehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170510
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170510,
					"content": "Das heißt, in diesem Fall bin ich gar nicht darin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170511
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170511,
					"content": "Wenn es nicht ich bin, warum kann es dann genau wie ich sein. Wenn ich es bin, was bin ich dann jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170512
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170512,
					"content": "#Das ist ... jenseits von Paimons Fähigkeiten, das zu beantworten ... Sag was, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170513,
					"content": "Vielleicht ist es wie der Unterschied zwischen dir und dem Shougun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170514
					]
				},
				{
					"id": 120170514,
					"content": "Richtig, oh, denkst du, der Shougun bist du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170515,
					"content": "Das zählt auf jeden Fall und ich hatte noch nie den Wunsch, Inazuma in die Hände eines anderen zu legen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170516
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170516,
					"content": "Und was bist du jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170517,
					"content": "In diesem Fall besteht kein Zweifel, dass ich auch ich bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170518
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170518,
					"content": "Deine Existenz ist also nicht singulär.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170519
					]
				},
				{
					"id": 120170519,
					"content": "Meine Existenz, hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170520
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170520,
					"content": "Ich verstehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170521
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170521,
					"content": "Ich bin ich. Es gibt nur eine, aber es kann eine unendliche Anzahl von Existenzformen geben. Es ist nicht wirklich wichtig, in welcher Form ich existiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170522
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170522,
					"content": "Der Shougun zum Beispiel ist eine Form meines Wesens und die Frage, ob sie ich ist oder nicht, wird niemals durch einen Teil ihres Körpers entschieden werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170523
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170523,
					"content": "In diesem Fall ist dieses Bild auch eine Form deiner Existenz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170524,
					"content": "Nun, selbst ich, die die „Ewigkeit“ sucht, bin in einem ständigen Zustand des Wandels ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170525
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170525,
					"content": "Wie kann ich also Inazuma und alle, die in Inazuma leben, bitten, gleich zu bleiben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170526,
						120170527
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170526,
					"content": "Die Natur von Inazuma lässt sich nicht so einfach ändern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170528
					]
				},
				{
					"id": 120170528,
					"content": "Auf dem ganzen Weg hierher mit euch habe ich Dinge gesehen, die außerhalb meiner Wahrnehmung liegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170529
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170529,
					"content": "Leider habe ich euch meine ungeschickte Seite gezeigt. Du spürst es vielleicht nicht, aber diese Dinge schockieren meine Wahrnehmung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170530
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170530,
					"content": "Wenn diese Dinge zur Definition herangezogen werden, dann ist das Inazuma von heute ganz anders als das, was ich in Erinnerung habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170531
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170531,
					"content": "Es darf aber nicht gesagt werden, dass das aktuelle Inazuma nicht mehr Inazuma ist, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170532
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170532,
					"content": "Richtig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170533
					]
				},
				{
					"id": 120170533,
					"content": "Das Augenhatz-Dekret, die Statue des Allgegenwärtigen, all das soll die „Ewigkeit“ hervorbringen, aber wenn ich mich der „Ewigkeit“ wirklich nähern würde, wäre keine dieser Geschichten passiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170534
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170534,
					"content": "Hehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170535
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170535,
					"content": "Halte ich ... zu sehr an allem fest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170536
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170536,
					"content": "Sieht aus, als ob Ei es begriffen hätte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170537,
					"content": "Ich denke also, dass wir mit dieser Führung eine sehr lohnenswerte Arbeit geleistet haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170538,
					"content": "Mein Herr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170539
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170539,
					"content": "Meine Güte, warum ist es da unten so laut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170540,
					"content": "Es scheint Ippei zu sein. Was ist mit ihm passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170541,
					"content": "Ist das die Tenryou-Verwaltung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170542
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170542,
					"content": "Ja, wir gehen hin und fragen nach, was passiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170527,
					"content": "Die Natur des Menschen lässt sich nicht so einfach ändern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170528
					]
				},
				{
					"id": 120170505,
					"content": "Es ist nicht das echte Du.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170506
					]
				}
			]
		},
		{
			"id": 1201707,
			"completionStepIds": [
				1201707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201707",
							"2"
						],
						"stepId": 1201707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ippei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170701,
					"content": "Ippei, ist was passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170702,
					"content": "Ah, ihr seid es, ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170703
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170703,
					"content": "He? Shougun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170704
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170704,
					"content": "Bist du hier, um Kujou Kamaji zu sehen? Es tut mir leid, aber er ist noch nicht zurück. Wenn es dir recht ist, darf ich dein Anliegen an ihn übermitteln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170705
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170705,
					"content": "Es gibt keinen Grund, zu höflich zu sein, es ist kein besonderer Besuch. Ich habe nur deine Stimme gehört, die gerufen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170706
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170706,
					"content": "Suchst du den zweiten jungen Meister des Hauses?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170707
					]
				},
				{
					"id": 120170707,
					"content": "Ja, ich werde dich nicht anlügen, der zweite junge Meister ging zu Verhandlungen und kam noch nicht zurück, und ich bin besorgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170708
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170708,
					"content": "Er hat normalerweise die Angewohnheit, ein wenig herumzuhängen und nicht zurückzukommen, also könnte er sich einfach etwas verirrt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170709
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170709,
					"content": "Aber aus irgendeinem Grund bin ich heute besonders unruhig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170710
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170710,
					"content": "Kujou Kamaji, klingt nach einem Nachfahren des Kujou-Klans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170711
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170711,
					"content": "Ja, es tut mir wirklich leid. Da das Klanoberhaupt erkrankt und der Älteste für viele Jahre verreist ist, wird der Kujou-Klan nun vom jungen Meister Kujou Kamaji geleitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170712
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170712,
					"content": "Ich habe ein wenig von dem Chaos gehört, das die Tenryou-Verwaltung verschlungen hat. Hat diese Angelegenheit etwas mit Kujou Kamaji zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170713
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170713,
					"content": "Es tut mir leid, Shougun, aber das ist auch eine Pflichtverletzung seitens des Kujou-Klans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170714
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170714,
					"content": "Da der Ruf des Kujou-Klans in Scherben liegt und ihre Macht im Niedergang begriffen ist, und du, nun, du hast noch keine Entscheidung getroffen, Shougun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170715
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170715,
					"content": "Deshalb ging der zweite junge Meister hin, um zu besprechen, ob er die Takatsukasa bitten könnte, die Situation in die Hand zu nehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170716
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170716,
					"content": "Darüber sollte in der Verwaltung gesprochen werden. Warum also hierherkommen, um es herauszufinden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170717,
					"content": "Ah, nein, das Treffen ist etwas Besonderes. Ich war tatsächlich ein bisschen verwundert, aber ich traute mich nicht, zu viele Fragen über die Geschäfte der Großen zu stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170718
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170718,
					"content": "Der Ort liegt in den Hügeln in der Nähe vom Großen Narukami-Schrein, wo es ein spezielles Lager für den „Takatsukasa-Klan“ zu geben scheint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170719
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170719,
					"content": "Der Name „Takatsukasa“ ... ist auch ein bekannter Name. Sie müssen den Kujou all die Jahre treu zur Seite gestanden haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170720
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170720,
					"content": "Ja, ja, deshalb ist der zweite junge Meister da, um zu verhandeln. Aber egal, wie viel es zu verhandeln gab, dies dauert nun zu lange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170721
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170721,
					"content": "Ich habe die ganze Stadt abgesucht. Wenn er noch nicht zurückgekommen ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170722,
						120170723
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170722,
					"content": "Es ist noch nicht vorbei, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170724
					]
				},
				{
					"id": 120170724,
					"content": "Ja, an diese Möglichkeit habe ich auch gedacht ... aber in meiner Position kann ich mich nicht allein in das Anwesen der „Takatsukasa“ wagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170725
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170725,
					"content": "Wir schauen es uns für dich an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170726
					]
				},
				{
					"id": 120170726,
					"content": "Nein, nein, es ist wahrscheinlich nur, dass ich etwas paranoid bin. Wenn ich die Verhandlungen störe, werde ich mich nicht mehr erklären können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170727
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170727,
					"content": "Obwohl ich nur der kleine Gefolgsmann des jungen Meisters bin, bin ich eigentlich seit meiner Kindheit mit ihm aufgewachsen, ich habe nur ... große Angst, dass ihm etwas zustoßen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170728
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170728,
					"content": "Ich bin nicht so schlau und klug wie der junge Meister und kann ihm nicht allzu viel von dem Druck abnehmen, aber ich möchte ihn wegen meiner Pflichtverletzung nicht in Gefahr bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170729
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170729,
					"content": "Shougun, wie siehst du das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170730,
					"content": "Lass uns selbst hingehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170731
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170731,
					"content": "In meiner Position sollte es dich nicht beeinträchtigen, auch wenn es den Verhandlungen im Wege steht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170732
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170732,
					"content": "Außerdem war es mein Versäumnis, keine rechtzeitige Entscheidung getroffen zu haben, die mich hätte veranlassen müssen, einzuschreiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170733,
						120170734
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170733,
					"content": "Sehr verantwortungsbewusst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170735
					]
				},
				{
					"id": 120170735,
					"content": "Vielen Dank, Shougun! Ich werde mich in der Zwischenzeit auch weiter umsehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170736
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170736,
					"content": "Also markiere ich euch jetzt den Standort des Lagers und wünsche euch eine gute Reise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170734,
					"content": "Sehr cool!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170735
					]
				},
				{
					"id": 120170723,
					"content": "Es könnte eine unerwartete Situation eingetreten sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170724
					]
				}
			]
		},
