				"objectNames": [
					"Ei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170201,
					"content": "Und was machen wir jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170202
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170202,
					"content": "Wir machen ein Bild von dir. Überlasse uns die Details, du musst nur dort drüben stehen und posieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170203,
					"content": "Einfach gesagt, ein Bild fängt dich in diesem Moment ein und eignet sich hervorragend als Erinnerungsstück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170204,
					"content": "Was meinst du jetzt wieder mit Posieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170205
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170205,
					"content": "Damit wird deine Pose verewigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170206
					]
				},
				{
					"id": 120170206,
					"content": "Verstehe, das bedeutet eine schöne Pose also?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170207
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170207,
					"content": "Es ist ein bisschen peinlich, wenn man darüber nachdenkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170208,
					"content": "Was wäre der beste Weg, dies zu tun? Hilf mir, gut auszusehen, aber nicht zu übertrieben. Ich glaube, ich werde mich nicht komplett entfalten können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170209,
						120170211,
						120170213
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170209,
					"content": "Nimm eine zurückhaltende Pose ein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170210
					]
				},
				{
					"id": 120170210,
					"content": "Na dann einfach so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170215,
					"content": "So ist es gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170218
					]
				},
				{
					"id": 120170218,
					"content": "Gut, dann fangen wir mal an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170219
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170219,
					"content": "Wir wählen einen guten Winkel und nehmen ihn für sie auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170216,
					"content": "Vielleicht versuchen wir es mit etwas anderem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170217
					]
				},
				{
					"id": 120170217,
					"content": "Nun, ich überlasse es dir, hier zu entscheiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170208
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170211,
					"content": "Nimm eine ernste Pose ein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170212
					]
				},
				{
					"id": 120170212,
					"content": "Ein wenig ungewohnt, so vielleicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170213,
					"content": "Sei lässig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170214
					]
				},
				{
					"id": 120170214,
					"content": "So in etwa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170215,
						120170216
					],
					"speakerTitle": "Ei"
				}
			]
		},
		{
