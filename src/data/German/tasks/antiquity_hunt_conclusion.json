			"trigger": {
				"objectNames": [
					"Daneh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736950201,
					"content": "Oh, hast du alle „Replika-Relikten“ gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950202
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950202,
					"content": "Super! Du hast ein gewisses Talent für Archäologie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950203
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950203,
					"content": "Dieses Geschenk ist also für dich. Ich danke dir, dass du an unserer Aktion teilgenommen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950204
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950204,
					"content": "#Ich hoffe, die Archäologie hat dir Freude bereitet, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950205
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950205,
					"content": "Obwohl eine echte archäologische Ausgrabung überwiegend langweilig ist und harte Arbeit bedeutet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950206
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950206,
					"content": "... Aber sobald du das entscheidende Relikt gefunden hast, wirst du das Gefühl haben, dass sich der ganze Aufwand gelohnt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950207,
						736950208
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950207,
					"content": "Und was, wenn man keinen finden kann?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				},
				{
					"id": 736950209,
					"content": "Wenn man nichts findet, ist es „eine vergebliche Mühe“, wie man immer sagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950210
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950210,
					"content": "Und das ist tatsächlich der Normalfall. Es kommt nur ganz selten vor, dass ein wichtiges Kulturrelikt ohne weiteres ausgegraben werden kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950211
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950211,
					"content": "Aber man muss sich als Archäologe an diese Situation gewöhnen und immer optimistisch sein, sonst kann man diese Arbeit nicht lange durchhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950208,
					"content": "Es muss auch Fälle geben, in denen nichts gefunden wird.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				}
			]
		},
