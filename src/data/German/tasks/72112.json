			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gendou Ringo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721123501,
					"content": "Willst du einen Zettel ziehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123502
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123502,
					"content": "Mann, sie ist so kalt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721123503,
					"content": "Ich hätte gern einen Zettel ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123504
					]
				},
				{
					"id": 721123504,
					"content": "Verstanden. Es funktioniert folgendermaßen ... Du musst das hier schütteln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123505
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123505,
					"content": "Das ist doch ein Orakelbehälter, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123506
					]
				},
				{
					"id": 721123506,
					"content": "Genau, ein Bambusstäbchen wird herauskommen, das du mir geben kannst. Dafür gebe ich dir dann einen passenden Zettel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123507
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123507,
					"content": "Die heißen Orakelzettel, nicht wahr?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123508
					]
				},
				{
					"id": 721123508,
					"content": "Wie auch immer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123509
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123509,
					"content": "Paimon hat eine Frage! Wenn jetzt ... Was tun wir, wenn wir eines bekommen, das für Pech steht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721123510,
					"content": "Das ist Schicksal. Hast du damit ein Problem? Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123511
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123511,
					"content": "Hä!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721123512,
					"content": "Ist draußen nicht so etwas wie ein Gerüst, wo man ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123513
					]
				},
				{
					"id": 721123513,
					"content": "Tss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123514
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123514,
					"content": "Hat sie jetzt wirklich einfach „tss“ geantwortet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721123515,
					"content": "Lass mich sehen ... Oh richtig, es ist so. „Binde den Zettel mit Unglück an den Orakelzettelanhänger, um das Unglück in Glück zu verwandeln.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123516
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123516,
					"content": "Ah richtig! Wenn du einen Zettel mit Unglück bekommst, bindest du ihn einfach an dieses Gerüst, das reicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123517
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123517,
					"content": "Pff, was für ein Haufen ... Nein, tut mir leid. Wir vom Großen Narukami-Schrein sind wirklich sehr großmütig. Auch wenn ihr einen Zettel mit Unglück ziehen solltet, habt ihr die Chance, es zu Glück zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123518
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721123518,
					"content": "Irgendwie findet Paimon das komisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721123519,
					"content": "#Lass uns einen Zettel zeichnen, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
