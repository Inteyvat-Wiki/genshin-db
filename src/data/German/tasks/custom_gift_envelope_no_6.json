			"dialogs": [
				{
					"id": 715380101,
					"content": "#Hallo, {NICKNAME}. Frohes Laternenritual.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380102,
						715380103
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380102,
					"content": "Bist du ... wegen eines Falls hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				},
				{
					"id": 715380104,
					"content": "Ich bin gezwungenermaßen auf Urlaub.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380105
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380105,
					"content": "Gezwungenermaßen auf Urlaub?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380106
					]
				},
				{
					"id": 715380106,
					"content": "Am Ende eines jeden Jahres muss nach den Regeln der Maison Gardiennage jeder seinen gesetzlich vorgeschriebenen Urlaub genommen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380107
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380107,
					"content": "Nach der diesjährigen Jahresabrechnung stellte die Sonderpatrouille jedoch fest, dass ich nicht mal einen einzigen Feiertag Urlaub hatte. Also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380108,
						715380109
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380108,
					"content": "In der Sonderpatrouille muss viel los sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380110,
					"content": "Nein, in der Sonderpatrouille für Sicherheit und Überwachung gibt es ein Schichturlaubssystem, aber als Truppenführerin muss ich ständig im Dienst sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380111
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380111,
					"content": "Außerdem gibt es hin und wieder unerwartete Situationen, die ich bewältigen muss, und mit der Zeit vergesse ich dann, mir Urlaub zu nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380112
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380112,
					"content": "Mir bedeuten diese Feiertage ja nichts und ich hätte dieses Jahr gern auf diese verzichtet. Jedoch wollten meine Kollegen der Sonderpatrouille das nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380113
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380113,
					"content": "Sie schrien, „Das steht Schwarz auf Weiß in den Regeln. Eine Truppenführerin muss ein Vorbild sein.“ Sie bestanden darauf, dass ich den Urlaub nehmen sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380114
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380114,
					"content": "Ein Gestionär, der immer geschäftlich zu uns kommt, meinte auch, dass Liyue während des Laternenrituals definitiv der beste Ort ist, um Urlaub zu machen ... Er hat sogar aus heiterem Himmel einen Bootsfahrschein hervorgeholt und ... hier bin ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380115
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380115,
					"content": "Aber ich muss sagen, dass Liyue zu dieser Zeit wirklich toll ist. Ich bin gerade aus Qiaoying zurück und ich liebe das Dim-Sum, das dort mit Teeblättern gemacht wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380116
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380116,
					"content": "Ich habe einige davon gekauft, um sie der Sonderpatrouille zum Probieren mitzubringen, und ich wollte auch ein paar Glückwunschkarten dazu anfertigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380117
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380117,
					"content": "Es ist nur ... Ich bin nicht wirklich gut darin, solche Sachen zu machen, und es fühlt sich einfach komisch an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380118
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380118,
					"content": "#Kennst du dich damit aus, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380119
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380119,
					"content": "Ich habe zumindest ein paar Vorschläge ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 715380109,
					"content": "Ist das bei jedem in der Sonderpatrouille so?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380103,
					"content": "Du ... scheinst nicht wegen deiner Arbeit hier zu sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				}
			]
		},
