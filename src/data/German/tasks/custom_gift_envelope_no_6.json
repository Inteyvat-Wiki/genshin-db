			"dialogs": [
				{
					"id": 715380301,
					"content": "Oh, das sieht wirklich toll aus. Hmm ... ich muss mich bei dir revanchieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380302
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380302,
					"content": "Hier, nimm dieses Dim-Sum. Ich bin dir sehr dankbar. Mit dieser Glückwunschkarte von dir habe ich die Reise auch nicht umsonst gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380303
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380303,
					"content": "Allerdings bin ich schon so lange aus Fontaine weg, dass ich nicht weiß, ob die Kollegen auch immer pünktlich trainieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380304
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380304,
					"content": "Na ja, ich denke, ich sollte erstmal einen Plan für einen Fitnesstest ausarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		}
	]
