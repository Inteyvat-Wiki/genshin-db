		{
			"id": 7410025,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410003",
							"2"
						],
						"stepId": 7410003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Al",
					"Petit Chou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741002501,
					"content": "Wenn es uns gelingt, den Schatz von Prinzessin Lyris zu bergen, werden die Kräfte der Gerechtigkeit mit der „Zeit“ wachsen und der Tag des Sieges gegen „Narcissus“ wird bald kommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002502
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002502,
					"content": "... Und wir dürfen dabei nicht Neys Opfer vergessen, denn wenn er den Schatz nicht versteckt hätte, wäre „Narcissus“ in den Turm eingebrochen, in dem sich die Prinzessin befand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002503
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002503,
					"content": "Ja, Ney ist erstaunlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002504
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002504,
					"content": "#Wir müssen uns der Bemühungen von Ney und {NICKNAME} würdig erweisen. Dieses Mal können wir Prinzessin Lyris mit der Hilfe aller sicherlich retten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002505
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002505,
					"content": "Ja, Prinzessin Lyris retten, und dann, dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002506
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002506,
					"content": "Dann wird das Reich des Narzissenkreuzes wiederhergestellt und Prinzessin Lyris kann dich wieder in den Arm nehmen, dir die Federn striegeln und dir sanft über die Stirn streichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002507
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002507,
					"content": "All die Erinnerungen, die am Wasser verloren gegangen sind, werden zurückkehren. All die Freunde werden um die Prinzessin herum lachen. Alle werden auf ewig glücklich sein, ohne Streit und Ärger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002508
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002508,
					"content": "Genau wie früher!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002509
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002509,
					"content": "... Ja, genau wie in den alten Zeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Al"
				}
			]
		},
		{
			"id": 7410026,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410003",
							"2"
						],
						"stepId": 7410003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jak"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741002601,
					"content": "#Du bist es, {NICKNAME}. Sobald wir Fräulein Lyris’ Schatz bergen können, werden wir den Schlüssel zum Sieg haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002602
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002602,
					"content": "Endlich haben wir die Chance, die eindringenden Fremden zu besiegen und Fräulein Lyris zu retten. Und so können wir, das „Jaks Orchester“, endlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002603
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002603,
					"content": "Den letzten Satz der Ouvertüre spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002604,
						741002605
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002604,
					"content": "Wir sind erst bei der Ouvertüre ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				},
				{
					"id": 741002606,
					"content": "Wie bitte? Du hast doch nicht geglaubt, dass es nach der Rettung von Fräulein Lyris und der Rettung des Königreichs einfach zu Ende ist, oder? Ha! Die reale Welt ist kein Märchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002607
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002607,
					"content": "Die Geschichte wiederholt sich immer wieder, weil es so viele naive Menschen gibt, die so denken wie du. Der nächste Schritt besteht darin, das eingefahrene Klassensystem und die Verteilungssysteme zu überwinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002608
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002608,
					"content": "In einer Welt der vernünftigen Gleichberechtigung ... Und natürlich ist die Gleichberechtigung der vernünftigste Zustand und muss auch der Zustand sein, den Fräulein Lyris anstrebt. Der Grund für diese Gegenüberstellung ist, dass der Status quo berücksichtigt wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002609
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002609,
					"content": "Ich werde zuerst losgehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002610
					]
				},
				{
					"id": 741002610,
					"content": "Wir sollten dementsprechend ... aufbauen ... bevor wir ... anderes umstoßen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002605,
					"content": "Vielleicht können wir es ein wenig abkürzen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				}
			]
		},
		{
			"id": 7410031,
