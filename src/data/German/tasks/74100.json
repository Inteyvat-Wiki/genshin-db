			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741003101,
					"content": "*schnüffel*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003102
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003102,
					"content": "Wuff, wuff, guter Mensch. Streicheln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003103,
						741003106
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003103,
					"content": "Guter Mori, Komm her.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003104
					]
				},
				{
					"id": 741003104,
					"content": "Du streichelst Mori.\\nDeine Hand ist nass, weil es ein „Wasserhund“ ist.\\nMori sieht glücklich aus.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003105
					]
				},
				{
					"id": 741003105,
					"content": "Wuff, wuff! Danke dir, guter Mensch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003106,
					"content": "Das nächste Mal streichle ich dich, Mori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003107
					]
				},
				{
					"id": 741003107,
					"content": "Wuff, war ich böse, deshalb kein Streicheln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003108
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003108,
					"content": "Was hat das damit zu tun, ob du gut oder böse bist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003109
					]
				},
				{
					"id": 741003109,
					"content": "Wuff, gutes Hündchen streicheln, böses Hündchen ... behandeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003110
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003110,
					"content": "*schluchz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003111
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003111,
					"content": "Da du siehst, dass Mori traurig ist, streckst du die Hand aus und streichelst Mori.\\nDeine Hand ist nass, weil es ein „Wasserhund“ ist.\\nIn Moris blauen Augen erscheint wieder ein Glanz.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003112
					]
				},
				{
					"id": 741003112,
					"content": "Wuff, wuff, danke fürs Streicheln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mori"
				}
			]
		}
	]
