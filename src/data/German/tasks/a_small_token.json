				"points": []
			},
			"dialogs": [
				{
					"id": 752380201,
					"content": "#Hmpf ... Mal sehen, wie ich {M#ihm}{F#ihr} beim nächsten Mal die Leviten lese.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380202,
						752380203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380202,
					"content": "(Lass uns noch ein Weilchen so sitzen bleiben.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380204,
					"content": "Ist es schon so spät? In Ordnung, Fräulein Guillotin, pass auf deinem Weg auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380203,
					"content": "Ich glaube, es wird Zeit, dass ich mit dem Aufräumen anfange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
}