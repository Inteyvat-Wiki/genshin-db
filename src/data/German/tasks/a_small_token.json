			"dialogs": [
				{
					"id": 752380101,
					"content": "Schmeckt dir der Tee? Oder hättest du lieber etwas Stärkeres?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380102,
					"content": "Tee ist völlig in Ordnung. Ich habe ein schlechtes Gewissen, wenn ich tagsüber trinke. Besser nicht zu oft machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380103
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380103,
					"content": "Wie auch immer, Fräulein Guillotin, was führt dich nach Natlan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380104,
					"content": "Ich reise nur etwas herum und besuche alte Bekannte. Außerdem wollte ich mich bei dir bedanken, dass du zugesagt hast, während der Fontainale auszuhelfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380105
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380105,
					"content": "Du bist zu höflich. Bist du wirklich nur dafür den ganzen Weg hierhergekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380106
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380106,
					"content": "Nun ... Obwohl du so nett warst, es letztes Mal nicht zu erwähnen, weiß ich sehr gut, dass ich dir in der Vergangenheit Probleme bereitet habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380107,
					"content": "Ah ... Die Sache mit deinem Untergebenen? Der Vorfall mit dem Roboter, Ineffa ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380108
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380108,
					"content": "Heh ... Ist das Leben nicht seltsam? Plötzlich freundest du dich mit dem Boss deines früheren Feindes an ... Vielleicht erlebst du sogar, dass er dein eigener Boss wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380109
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380109,
					"content": "Ich hoffe, du kannst das als kleine Wiedergutmachung annehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380110,
					"content": "D... Das ... ist eine limitierte Edition ... Nein, eine Sammleredition!? Und es ist mein Lieblingsgenre?! W... Woher wusstest du das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380111
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380111,
					"content": "#Ich habe {NICKNAME} gefragt, was dir gefallen könnte, und auf {M#seinen}{F#ihren} Rat gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380112,
					"content": "#{NICKNAME} ...?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380113
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380113,
					"content": "(Ugh ...! Was sind das für widersprüchliche Gefühle!? Irgendwie freue ich mich, aber gleichzeitig ist es mir auch peinlich.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380114
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380114,
					"content": "#(Es freut mich natürlich, dass {M#er}{F#sie} weiß, was ich mag, aber könnte {M#er}{F#sie} das nicht einfach für sich behalten und es mir stattdessen lieber persönlich vorbeibringen?!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380115
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380115,
					"content": "Gefällt es dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380116,
					"content": "Ah ... D... Danke! Du bist zu freundlich, Fräulein Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380117
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380117,
					"content": "#Wenn es dir gefällt, bringe ich dir nächstes Mal noch welche mit. Natürlich muss ich {NICKNAME} dann wohl wieder darum bitten, sie mit mir zusammen auszuwählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380118,
					"content": "... M... Mit dir!? Du meinst ... Ihr seid zusammen in die Buchhandlung gegangen, um das zu holen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380119
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380119,
					"content": "#Ja, {M#er}{F#sie} hat dieses Buch sehr gewissenhaft für dich ausgesucht. Vielleicht beim nächsten Mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 752380120,
					"content": "... Es sollte besser kein nächstes Mal geben!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380121
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380121,
					"content": "Oh ... Ich ... Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
