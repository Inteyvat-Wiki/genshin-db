			"dialogs": [
				{
					"id": 221161301,
					"content": "Wie sieht’s aus, hast du irgendwas gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161302
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221161302,
					"content": "Ich habe das hier aufgeschrieben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161303
					]
				},
				{
					"id": 221161303,
					"content": "Es hat sich wirklich gelohnt, zeig mal her ... Zhihua und Qiming, es stimmt also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161304
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221161304,
					"content": "Nicht schlecht, nicht schlecht, kann sich wirklich sehen lassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161305
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221161305,
					"content": "Was ist denn so besonders daran?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161306
					]
				},
				{
					"id": 221161306,
					"content": "Du, du siehst es nicht? Du fühlst es nicht? Sieh noch einmal genauer hin, es ist sehr subtil. Vielleicht kann es nicht jeder Mensch sehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161307
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221161307,
					"content": "Das ist nicht schlecht, ich glaube, damit kann ich etwas anfangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161308
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221161308,
					"content": "Ach ja, dieses Geschenk ist für dich, nimm es bitte an. Ich muss gut überlegen, wie ich meinen Anfang schreibe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang IX."
				}
			]
		},
