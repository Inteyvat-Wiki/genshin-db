			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kleiner Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221161201,
					"content": "Lulu, dieses Mal sollte wirklich der kleine Fei Kapitän sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161202
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 221161202,
					"content": "Genau, wie oft hab ich das schon gesagt, ich bin immer nur Matrose ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161203
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 221161203,
					"content": "Ich finde aber, dass der kleine Meng als Kapitän nicht schlecht ist. Wir waren dann immer am fröhlichsten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161204
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 221161204,
					"content": "Lulu, das kann man so aber auch nicht sagen. Der kleine Fei war nicht schlecht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161205
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 221161205,
					"content": "Stimmt, als du Kapitän warst, habe ich mich aufgebrezelt und der kleine Fei war Matrose.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161206
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 221161206,
					"content": "In der Konstellation hatten wir den meisten Spaß, oder Fei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161207
					],
					"speakerTitle": "Kleine Lulu"
				},
				{
					"id": 221161207,
					"content": "Lulu, du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161208
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 221161208,
					"content": "Wenn Lulu das sagt, dann stimme ich auch zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161209
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 221161209,
					"content": "Fei, was hat das zu bedeuten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161210
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 221161210,
					"content": "Das macht doch gar nichts! Hauptsache die kleine Lulu ist glücklich, dann lass uns weiter spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161211
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 221161211,
					"content": "Es geht doch bloß darum, wer den Kapitän spielt. Das macht mir doch nichts aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161212
					],
					"speakerTitle": "Kleiner Fei"
				},
				{
					"id": 221161212,
					"content": "Ihr, ach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleiner Meng"
				}
			]
		},
