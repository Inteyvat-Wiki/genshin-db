					"Chang IX."
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221161601,
					"content": "Du hast aber schon recht, es gibt genug Leute wie mich, die Romantik nicht verstehen und auch nie Romantik erlebt haben. Solche Art von „zutiefst romantischen Geschichten“ sollten sich auch gut verkaufen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161602
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221161602,
					"content": "Aber, wie sammel ich denn da nur Stoff für dieses Thema? Mal nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang IX."
				}
			]
		},
