			"dialogs": [
				{
					"id": 221160201,
					"content": "Die Fähigkeit die Gedanken des Lesers zu kennen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160202
					]
				},
				{
					"id": 221160202,
					"content": "Du, du solltest keine Scherze mit mir treiben, ich meine es ernst, überleg dir was!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang IX."
