			},
			"dialogs": [
				{
					"id": 221161101,
					"content": "Chaoxi, du ... du bist zurück, ich habe gerade ein neues Gericht gelernt. Möchtest du, dass ich es dir zu Hause zubereite?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161102
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161102,
					"content": "Meine liebe Sisi, ich bin gerade erst angekommen und völlig erschöpft, ich möchte mich erst einmal nur ausruhen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161103
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161103,
					"content": "Stimmt, das habe ich nicht bedacht, ruh dich erstmal gut aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161104
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161104,
					"content": "Also ... warte ich erstmal, bis du dich ausgeruht hast und dann unterhalten wir uns ein bisschen? Außerdem sollten wir doch noch ein Datum festlegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161105
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161105,
					"content": "Ja, das weiß ich, aber ich habe mir dazu bisher noch keine Gedanken gemacht. Das heißt nicht, dass ich keine Verantwortung übernehmen will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161106
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161106,
					"content": "Hach, meine liebe Sisi, ich bin doch nur ein einfacher Matrose, dessen Schicksal an das Meer gebunden ist. Du verdienst jemand so viel besseres ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161107
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161107,
					"content": "Chaoxi, sag sowas nicht, ich weiß doch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sisi"
				}
			]
		},
