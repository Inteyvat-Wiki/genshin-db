			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang IX."
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160301,
					"content": "Voller epischer Kämpfe bis aufs Blut!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160302
					]
				},
				{
					"id": 221160302,
					"content": "Kämpfe bis aufs Blut ... Hmm, da ist was dran, das kommt immer gut an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160303
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160303,
					"content": "Allerdings, solche „epischen Kämpfe bis aufs Blut“ haben wir hier im Qingce-Dorf eigentlich gar nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160304
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160304,
					"content": "Ich muss mal raus, um Holz holen zu gehen. Stimmt ja! Ich habe gehört in der Wildnis gibt es viele Abenteurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160305
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160305,
					"content": "Für ein paar Schätze laufen sie in der Wildnis herum und schlagen sich mit Monstern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160306
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160306,
					"content": "Ich weiß genau den richtigen Ort mit vielen Monstern und er sieht aus ... er sieht aus, als ob es dort leichte Beute gibt, wir warten am besten dort! Wir warten, bis ein paar Abenteurer kommen und diese sich dann mit den Monstern ordentlich schlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160307
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160307,
					"content": "Und dann, hihi, dann fliegt mir das Material nur so zu. Keine Zeit zu verlieren, es ist recht weit weg, komm du auch schnell her!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang IX."
				}
			]
		},
		{
			"id": 2211605,
			"completionStepIds": [
				2211608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211608",
							"2"
						],
						"stepId": 2211608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang IX."
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160501,
					"content": "He, so gesehen, jetzt kann ich sagen, ich habe einen „epischen Kampf bis aufs Blut“ am eigenen Leib erfahren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160502
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160502,
					"content": "Hast du nicht vom Rand aus nur zugesehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160503
					]
				},
				{
					"id": 221160503,
					"content": "Ja, schon, das hab ich mir erst auch gedacht, aber dann kam und kam der Abenteurer nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160504
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160504,
					"content": "Die Monster kamen immer näher und näher und ich versuchte zu entkommen. Wären sie alle auf einmal gekommen, hätte ich vergeblich gewartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160505
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160505,
					"content": "Dann hab ich ihnen einen kleinen Stein an den Kopf geschmissen. So geht es in Geschichten doch immer, oder? Um Aufmerksamkeit zu erlangen wird ein Stein oder sowas geworfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160506
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160506,
					"content": "Wer konnte denn ahnen, dass mein Stein wirklich genau auf dem Kopf eines Monsters landet ... Und den Rest kennst ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160507
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160507,
					"content": "Na ja, verdient hab ich es ja, ein bisschen bitterer Geschmack bleibt zurück, aber endlich habe ich meine Geschichte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160508
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160508,
					"content": "Die Ideen sprudeln jetzt förmlich aus mir heraus! Danke für eure Hilfe, das ist für euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160509
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160509,
					"content": "Ich kann es schon fühlen, sobald ich zurückkehre, kann ich beginnen zu schreiben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang IX."
				}
			]
		},
