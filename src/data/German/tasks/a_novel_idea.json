					"Chang IX."
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160101,
					"content": "Wo soll ich nur anfangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160102
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160102,
					"content": "Was machst du denn schon wieder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160103
					]
				},
				{
					"id": 221160103,
					"content": "Ah, du bist es. Ich bereite ein neues Buch vor. Aber egal wie ich auch anfange, irgendwas fehlt noch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160104
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160104,
					"content": "Ich hab mir schon den Kopf zermartert, aber mir will einfach kein Anfang einfallen. Wie lange soll das noch so weiter gehen bis ich einen Anfang finde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160105
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160105,
					"content": "Übrigens, ich weiß du bist sehr belesen. Deiner Erfahrung nach, was sollte ein erfolgreiches Buch auf jeden Fall haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160106
					],
					"speakerTitle": "Chang IX."
				}
			]
		},
