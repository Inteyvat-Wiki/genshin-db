			"dialogs": [
				{
					"id": 221161501,
					"content": "Eine romantische Handlung, das wäre mein Handicap, ich bin nicht mal sicher wie man „romantisch“ schreibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
