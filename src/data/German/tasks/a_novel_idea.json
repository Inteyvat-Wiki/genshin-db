			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang IX."
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160701,
					"content": "Als ich das letzte Mal in der Stadt war, sah ich zufällig einen Mann der mit einer Wünschelruten-Geherin diskutierte, jedoch habe ich nicht so genau zugehört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160702
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160702,
					"content": "Später hörte ich, dass einer von den beiden Zhihua und der andere Qiming hieß. Geh und vergewissere dich noch einmal, ob es dort eine Geschichte abzustauben gibt, dann bring sie mir unverzüglich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang IX."
				}
			]
		},
		{
			"id": 2211608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
							"2",
							"22116"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang IX."
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160801,
					"content": "Da fällt mir ein, hast du schon einmal von einem Mädchen namens Sisi gehört? Sie wartet wohl die ganze Zeit auf einen Matrosen namens Chaoxi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160802
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160802,
					"content": "Wie ich das sehe, wartet sie immer wieder auf ihn ... Diese Sisi und dieser Chaoxi, welche Geschichte die beiden wohl verbindet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160803
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160803,
					"content": "Warum gehst du nicht und hilfst mir ein paar Notizen zu machen? Wenn du eine gute Geschichte hörst, schreib sie nieder und bring sie mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang IX."
				}
			]
		},
