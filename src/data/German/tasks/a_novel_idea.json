				{
					"id": 221160901,
					"content": "Erinnerst du dich noch an die drei Kinder die immer an der Anlegestelle spielen? Der kleine Meng, die kleine Lulu und der kleine Fei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160902
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160902,
					"content": "Auch wenn es nur Kinder sind, aber unter den Dreien gibt es bestimmt auch eine Geschichte zu erzählen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160903
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221160903,
					"content": "Sei doch so gut und hör dich da mal um. Sollte es tatsächlich guten Stoff für eine Geschichte geben, schreib es auf und komm zu mir zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang IX."
				}
			]
		},
