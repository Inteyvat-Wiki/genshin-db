			"dialogs": [
				{
					"id": 221161701,
					"content": "Wie sieht’s aus, hast du irgendwas gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161702
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221161702,
					"content": "Ich habe das hier aufgeschrieben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161703
					]
				},
				{
					"id": 221161703,
					"content": "Eine reiche Ausbeute, lass mal sehen ... Dieser Chaoxi, warum habe ich das Gefühl, da stimmt etwas nicht? Oder besser gesagt, bei den beiden stimmt etwas nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161704
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221161704,
					"content": "Das soll also „romantisch“ sein? Egal, auch wenn es nicht sonderlich romantisch ist, kann man es als Anfang schon verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161705
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221161705,
					"content": "Ach ja, dieses Geschenk ist für dich. Danke für die Materialbeschaffung! Ich muss gut überlegen, wie ich meinen Anfang schreibe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161706
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221161706,
					"content": "Es macht sich zwar in einem Roman gut, im wirklichen Leben aber ... Nachher steht noch eine Millelithen-Armee vor der Tür ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161707
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221161707,
					"content": "Dieses Paar, ich habe das Gefühl, dass etwas passieren wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang IX."
