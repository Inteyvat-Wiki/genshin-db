			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang IX."
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221161801,
					"content": "Wie sieht’s aus, hast du irgendwas gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161802
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221161802,
					"content": "Ich habe das hier aufgeschrieben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161803
					]
				},
				{
					"id": 221161803,
					"content": "Es hat sich wirklich gelohnt. Ja, obwohl ... du solltest dich nicht so an Kindesgebrabbel stören, du gibst dich diesen Kindern gegenüber zu altklug. Warte, bis sie noch ein wenig älter werden. Wer weiß, vielleicht entwickeln sich ja noch „romantische“ Gefühle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161804
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221161804,
					"content": "Ich werde es erstmal so annehmen. Immerhin ist es auch eine mögliche Geschichte, auch wenn es sich nicht zur reinen Romanze eignet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161805
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221161805,
					"content": "Ach ja, dieses Geschenk ist für dich. Danke für die Materialbeschaffung! Ich muss gut überlegen, wie ich meinen Anfang schreibe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang IX."
				}
			]
		},
