			"dialogs": [
				{
					"id": 210039901,
					"content": "Hast du alle Monster beseitigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039902
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210039902,
					"content": "Alle beseitigt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210039903
					]
				},
				{
					"id": 210039903,
					"content": "Ich habe dir wirklich viel Mühe gemacht, das tut mir leid, da lasse ich euch einfach meine Arbeit verrichten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039904
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210039904,
					"content": "Du brauchst es nicht zu verbergen, du bist ja ganz mit Staub bedeckt, das muss ein Kampf mit schrecklichen Monstern gewesen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039905
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210039905,
					"content": "Hmm, ich weiß auch nicht, was sich die Führung dabei gedacht hat, niemals wurde jemand hierher entsendet. Ich kann auch nicht alles auf einmal machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039906
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210039906,
					"content": "Es sind zwar nur zwei Brücken, aber bei so vielen Passanten täglich und wenn dann einmal was schiefgeht, dann ist aber was los ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210039907
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210039907,
					"content": "Ich muss auf jeden Fall eine Gelegenheit finden, um mit der Führung diese Angelegenheit zu besprechen.",
					"roleType": "TALK_ROLE_NPC",
