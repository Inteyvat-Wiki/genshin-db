					"Qiaoxi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210033001,
					"content": "Und was jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033002
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033002,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033003
					]
				},
				{
					"id": 210033003,
					"content": "Hö? Ja, wer bist du denn? Jeder, der die Brücke überqueren will, muss sich einer Befragung unterziehen. Du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033004
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033004,
					"content": "Obwohl, wenn ich dich so ansehe, du siehst nicht wie ein Ganove aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033005
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033005,
					"content": "Warum? ... Denk doch mal nach. Wenn jemand etwas Böses vorhat, wird er sicher versuchen, so unauffällig wie möglich daherzukommen. Wo trägt man denn sowas Auffälliges wie du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033015
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033015,
					"content": "Was machst du hier denn überhaupt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033006
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033006,
					"content": "Ich bin der hier zuständige Millelith. Da dies die Hauptverbindung zum Dihua-Moor ist, die sowohl Güter als auch Passanten überqueren, wurde mir dieser Wachposten zugeteilt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033007
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033007,
					"content": "Vor ein paar Tagen entdeckte ich in der Nähe eine Horde von Monstern ... Es sah so aus, als ob die Monsterhorde ein richtiges Lager aufgeschlagen hatte, auch wenn sie gerade keinerlei Aktivitäten nachging. Sicherheitsabstand muss jedoch sein, man weiß ja nie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033008
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033008,
					"content": "Es brannte mir in den Fingern sie zu beseitigen ... Aber ich mache mir Sorgen, dass, wenn ich meinen Posten verlassen würde, vielleicht unschuldige Passanten in meinem Zuständigkeitsgebiet von anderen Monstern angegriffen würden, also habe ich es gelassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033009
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033009,
					"content": "Ich habe die Horde Monster bereinigt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033010
					]
				},
				{
					"id": 210033010,
					"content": "Völlig bereinigt? Na das ... das könnte ja gar nicht besser sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033011
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033011,
					"content": "Ich hätte dir das wirklich nicht aufdrängen sollen, es tut mir so leid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033012
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033012,
					"content": "Hmm, ich weiß auch nicht, was sich die Führung dabei gedacht hat, niemals wurde jemand hierher entsendet. Ich kann auch nicht alles auf einmal machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033013
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033013,
					"content": "Ich muss auf jeden Fall eine Gelegenheit finden, um mit der Führung diese Angelegenheit zu besprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033014
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033014,
					"content": "Vielen Dank, die hier sind für dich, als Zeichen meiner Dankbarkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiaoxi"
				}
			]
		},
