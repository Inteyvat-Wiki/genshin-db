			"dialogs": [
				{
					"id": 210030111,
					"content": "Hach, wenn wir nur mehr Unterstützung hätten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210030112
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210030112,
					"content": "Es brannte mir in den Fingern sie zu beseitigen, aber ich habe mir Sorgen gemacht, dass, wenn ich meinen Posten verlassen würde, vielleicht unschuldige Passanten in meinem Zuständigkeitsgebiet angegriffen würden, also habe ich es gelassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210030113
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210030113,
					"content": "Ich könnte beim Verkloppen dieses Monsters dahinten etwas Hilfe gebrauchen. Dann kann ich mich endlich wieder anderen Problemen widmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiaoxi"
				}
			]
		},
		{
