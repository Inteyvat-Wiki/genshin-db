			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paqarin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880101,
					"content": "Hilf mir doch bitte, meine <color=#00E1FFFF>drei kleinen Saurier</color> auf dem Feld zu finden und sie zu mir zurückzubringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				}
			]
		},
		{
			"id": 7518802,
			"completionStepIds": [
				7518802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7518802",
							"2"
						],
						"stepId": 7518802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paqarin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880201,
					"content": "He du da, ja genau, du bist gemeint!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880202
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880202,
					"content": "Wie du dich so schwungvoll bewegst und so schnell rennst ... Du musst ziemlich kräftig sein. Sieht aus, als würdest du regelmäßig trainieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880203
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880203,
					"content": "#Bist du ein{F#e} Krieger{F#in} aus unserem Kollektiv der Fülle oder gehörst du einem anderen Stamm an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880204,
						751880205
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880204,
					"content": "#Ich bin ein{F#e} Abenteurer{F#in} auf der Durchreise.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				},
				{
					"id": 751880206,
					"content": "Ach so, das ist wirklich schade. Tja, genau wenn man Hilfe braucht, plötzlich auf jemanden zu treffen, der helfen will ... Sowas passiert wohl nur im Traum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880207
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880207,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880208
					]
				},
				{
					"id": 751880208,
					"content": "Also, wie du sehen kannst, habe ich hier ein kleines Stück Ackerland.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880209
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880209,
					"content": "Ich bewirtschafte diese Farm ganz allein, aber in letzter Zeit läuft es nicht mehr so gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880210
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880210,
					"content": "Vor ein paar Tagen habe ich mir beim Ringen mit den Kriegern des Stammes den Rücken verletzt ... Ja, ich weiß, das war ziemlich dumm von mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880211
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880211,
					"content": "Jetzt kann ich weder meinem Vater bei der Urbarmachung neuer Felder helfen noch meine eigene Farm bewirtschaften. Um ehrlich zu sein, tut sogar das Gehen weh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880212
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880212,
					"content": "Gerade hatte ich überlegt, für ein paar Tage jemanden zur Hilfe einzustellen, und da bist du plötzlich aufgetaucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880213
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880213,
					"content": "Schade, dass du nur auf der Durchreise bist. Landwirtschaft erfordert tägliche Feldarbeit. Wenn du nur ab und zu kommst, würde mein Acker völlig verwildern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880214
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880214,
					"content": "Aber jetzt habe ich keine Kraft mehr, den weiten Weg zum Stamm zu gehen und dort Hilfe zu suchen. *seufz* Außer meinen paar kleinen Tatankasauriern gibt es niemanden, der mir helfen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880215
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880215,
					"content": "Die kleinen Frechdachse waren in den letzten Tagen besonders unartig. Alle drei hocken faul auf dem Feld und wollen einfach nicht zu mir kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880216
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880216,
					"content": "Hör mal, könntest du mir einen kleinen Gefallen tun und sie für mich herholen? Ich kann wirklich kaum laufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880217
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880217,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880218
					]
				},
				{
					"id": 751880218,
					"content": "Das ist wunderbar, sie sind normalerweise sehr gehorsam und helfen mir oft bei der Feldarbeit, aber in den letzten Tagen verhalten sie sich irgendwie seltsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880219
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880219,
					"content": "Wenn du sie rufst, kommen meine drei kleinen Saurier wahrscheinlich von allein zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880205,
					"content": "Ich komme nicht aus Natlan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				}
			]
		},
		{
			"id": 7518804,
			"completionStepIds": [
				7518804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
