				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paqarin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880401,
					"content": "Alle drei Kleinen sind zurück. Das ist zweifellos dein Verdienst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880402
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880402,
					"content": "Edler Recke, ich danke dir für deine Güte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880403
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880403,
					"content": "Mein Rücken schmerzt zwar noch, aber wenigstens sind die kleinen Saurier wieder bei mir. In ihrer Gesellschaft fühle ich mich gleich viel wohler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880404
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880404,
					"content": "Ich habe zwar nicht viel, aber eine kleine Belohnung kann ich dir geben. Bitte nimm diese Dinge an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				}
			]
		}
	]
}