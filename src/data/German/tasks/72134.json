			"dialogs": [
				{
					"id": 721340101,
					"content": "Danke für deine Bemühungen. Der Regen hat aufgehört, die Wolken haben sich verzogen und die Luft ist nicht mehr ganz so stickig. Es wird allerdings einige Zeit dauern, bis sich die über dem Boden schwebende „Tatarigami“ auflösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721340102
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721340102,
					"content": "Hm. Trotzdem, meine Untersuchung bleibt ergebnislos. Vielleicht denke ich zu viel darüber nach, aber die Ruinen der Mumei-Festung können nicht mit den Omamori auf der Insel zusammenhängen ... oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721340103,
						721340104
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721340103,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721340105
					]
				},
				{
					"id": 721340105,
					"content": "Es ist die Mumei-Festung! Die Mumei-Festung ist aus dem Meer aufgestiegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721340106
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721340106,
					"content": "Wer weiß, wann wir wieder eine Gelegenheit bekommen ... Lasst uns nachforschen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721340104,
					"content": "Was ist das Geräusch?",
