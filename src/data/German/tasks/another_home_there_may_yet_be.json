			"dialogs": [
				{
					"id": 130280201,
					"content": "Bei der Ankunft im Lager wurden die beiden Pilzbestien ohne Probleme aufgenommen.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130280202
					]
				},
				{
					"id": 130280202,
					"content": "Die Pilzbestien scheinen sich an uns zu erinnern. Sie sind ja richtig lieb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280203,
					"content": "Es scheint, dass dieses Elementarwesen hier eine hohe Stellung genießt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280204
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280204,
					"content": "Huch, was habt ihr denn vor? Wollt ihr etwa mit Paimon spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280205,
					"content": "♩ ~ ♩ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280206
					],
					"speakerTitle": "Schwebende Anemo-Pilzbestie"
				},
				{
					"id": 130280206,
					"content": "#Na gut, na gut. He, {NICKNAME}, Paimon wird ein bisschen mit ihnen spielen, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280207,
						130280208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280207,
					"content": "Klar, verschwinde schon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280209
					]
				},
				{
					"id": 130280209,
					"content": "Es gibt da etwas, wofür ich mich bei dir entschuldigen muss. Als der „Feuersamen“ in Apep zersprang, da ... wollte ich meine Kraft opfern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280210
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280210,
					"content": "Hat Paimon es dir erzählt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280211,
						130280212
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280211,
					"content": "Ja, ich habe mir Sorgen gemacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280213
					]
				},
				{
					"id": 130280213,
					"content": "Ich war nicht ruhig genug, und ich hätte damals mehr darüber nachdenken und eine bessere Entscheidung treffen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280214
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280214,
					"content": "Aber ich hatte Angst, wenn ich nur daran dachte, dass der Dendro-Drache und ganz Sumeru in Gefahr waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280215
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280215,
					"content": "Wenn ich mich entscheide, nicht zu handeln, auch wenn noch etwas hätte getan werden können, oder wenn die Zeit abgelaufen wäre, bevor ich meine ganze Energie aufgebraucht hatte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280216
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280216,
					"content": "Meine Kräfte zu nutzen ist das Leichteste, aber tatsächlich auch das Schwierigste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280217
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280217,
					"content": "Du kannst immer noch „wachsen“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280218
					]
				},
				{
					"id": 130280218,
					"content": "Ja, ich glaube, ich habe eine Menge von ihnen gelernt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280219
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280219,
					"content": "Ich wusste damals zwar schon, was es heißt, als ich den Satz „dann wäre unser Wunsch in Erfüllung gegangen“ hörte, aber es fiel mir schwer, es zu akzeptieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280220
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280220,
					"content": "Ich versteh es einfach nicht. Wie kann etwas so leicht und fröhlich klingen, wenn es dich doch zum Weinen bringt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280221
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280221,
					"content": "Wieder einmal habe ich meine Probleme damit, „Empathie“ zu empfinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280222,
						130280223
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280222,
					"content": "Das ist nicht deine Schuld.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280224
					]
				},
				{
					"id": 130280224,
					"content": "Danke, dass du mich tröstest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280225
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280225,
					"content": "Emotionen sind so kompliziert. Ich habe noch viel zu lernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280226
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280226,
					"content": "Huch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280227
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280227,
					"content": "♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280228
					],
					"speakerTitle": "Schwebende Hydro-Pilzbestie"
				},
				{
					"id": 130280228,
					"content": "♪ ~ ♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280229
					],
					"speakerTitle": "Schwebende Hydro-Pilzbestie"
				},
				{
					"id": 130280229,
					"content": "Sie wissen sogar, wie man Felder bewirtschaftet ... Das müssen sie sich wohl abgeschaut haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280230
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280230,
					"content": "Aber da diese Pilzbestie sogar sprechen gelernt hat, könnte es vielleicht auch an den Elementarkräften, und deren Einfluss über eine lange Zeit, liegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280231
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280231,
					"content": "Die Zeit ist schon etwas Machtvolles.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280232
					]
				},
				{
					"id": 130280232,
					"content": "Ganz genau. Und die Sorgen um diese zwei Elementarwesen sind wie weggeblasen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280233
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280233,
					"content": "Ich werde mich dann um dieses Lager kümmern und von Zeit zu Zeit vorbeischauen, um zu sehen, wie es hier läuft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280234
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280234,
					"content": "Ich will die Spuren, die sie hinterlassen, bewahren und Möglichkeiten für künftige Begegnungen schaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280235
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280235,
					"content": "Schließlich erinnerte sich diese Pilzbestie an ihren Namen, „Nur“. Und ihre Erinnerungen sind zurückgekehrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280236,
						130280237
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280236,
					"content": "Ich glaube an den Bund der Familie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280238
					]
				},
				{
					"id": 130280238,
					"content": "Ja, sehen wir es als eine Art wunderschönen Wunsch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280239
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280239,
					"content": "Nahida, die Pilzbestien haben Früchte mitgebracht. Komm, hauen wir rein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280240,
					"content": "He, du kannst dir sicher sein, dass ich dabei bin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280237,
					"content": "Ich glaube daran, dass Wunder geschehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280238
					]
				},
				{
					"id": 130280223,
					"content": "Mir geht’s da genauso.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280224
					]
				},
				{
					"id": 130280212,
					"content": "Ja, und ich war ziemlich sauer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280213
					]
				},
				{
					"id": 130280208,
					"content": "Viel Spaß!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130280209
					]
				}
			]
		}
	]
}