			"dialogs": [
				{
					"id": 130280113,
					"content": "Sie sind schon lange hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280101
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280101,
					"content": "Ich würde gerne noch mehr dafür tun, dass sie sich wiedersehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280102,
					"content": "Neben diesen beiden Pilzbestien macht sich Paimon auch ein wenig Sorgen um das Lager der schwebenden Anemo-Pilzbestie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280103,
					"content": "Ja, geht mir ähnlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280104
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280104,
					"content": "Ich habe eine Idee: Warum bringen wir sie nicht weg von hier und lassen sie mit den anderen zusammenleben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280105,
					"content": "Da sie für gewöhnlich eh alle unter der Führung von Elementarwesen leben, sollten sich ihre Gewohnheiten eigentlich gleichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280106,
					"content": "Stimmt! Und sie könnten gegenseitig aufeinander achtgeben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280107,
					"content": "Also, wollt ihr mit uns kommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280108
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280108,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280109
					],
					"speakerTitle": "Schwebende Hydro-Pilzbestie"
				},
				{
					"id": 130280109,
					"content": "♪ ~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280110
					],
					"speakerTitle": "Schwebende Hydro-Pilzbestie"
				},
				{
					"id": 130280110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280111
					],
					"speakerTitle": "Schwebende Hydro-Pilzbestie"
				},
				{
					"id": 130280111,
					"content": "Da scheint jemand aber überzeugt zu sein, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280112,
					"content": "Lass uns gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
