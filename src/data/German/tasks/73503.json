	"talks": [
		{
			"id": 7350301,
			"completionStepIds": [
				7350301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
