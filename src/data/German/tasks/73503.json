						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030301,
					"content": "„Der Zweig der Weisheit, mit dem man die Untiefen des Meeres prüft.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fragebox mit Rätseln"
				}
			]
		},
		{
			"id": 7350304,
			"completionStepIds": [
				7350304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350304",
							"2"
						],
						"stepId": 7350304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Drusus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030401,
					"content": "Dies ist die letzte Truhe, darum muss diesmal kein Rätsel mehr geschrieben werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030402
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030402,
					"content": "Aber was soll ich denn hineinlegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030403,
						735030406,
						735030409
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030403,
					"content": "Wertvoller Gegenstand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030404
					]
				},
				{
					"id": 735030404,
					"content": "Das ergibt Sinn. Der Wert des Inhalts dieser Truhe sollte zumindest dem anstrengenden Denken des Rätsellösers auf seiner Reise würdig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030405
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030405,
					"content": "Apropos Wert, natürlich wäre Mora am logischsten, ähm ... Ich werde mehr Mora einsetzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030413,
					"content": "#Gut, dieses Rätsel ist fertiggestellt, vielen Dank für deine Hilfe, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030414
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030414,
					"content": "Hier ist übrigens deine Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030415
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030415,
					"content": "Oh, ich wollte noch ausführlicher mit dir über das Rätsel sprechen, aber ich muss an die Akademie zurückkehren, um ein paar Dinge zu erledigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030416
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030416,
					"content": "Falls du einzigartige Rätsel auf der Reise entdeckst oder von einem Rätsel überrascht wirst, das du nicht sofort lösen kannst, komm unbedingt zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030417
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030417,
					"content": "Wir können sie gemeinsam im Detail besprechen und dann ... neue Rätsel für andere Abenteurer aufstellen! Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030418
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030418,
					"content": "#Ich verabschiede mich, {F#Reisende}{M#Reisender}, ich wünsche dir alles Gute auf deiner weiteren Reise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030419
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030419,
					"content": "Wir hoffen, dass die Schatzräuberin namens Narzam keinen großen Ärger macht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030406,
					"content": "Ein nützlicher Gegenstand.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030407
					]
				},
				{
					"id": 735030407,
					"content": "Nützlich? Welche Gegenstände sind nützlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030408
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030408,
					"content": "Stimmt! Ich habe vor einigen Tagen ein Rezept von jemandem erhalten, das ich als Belohnung in die Truhe hinein lege.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030409,
					"content": "Diese Erfahrung der Denkaufgabe ist der beste Schatz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030410
					]
				},
				{
					"id": 735030410,
					"content": "Hahahahahaha, du hast recht! Vollkommen richtig! Diese mühselige Denkphase ist in der Tat eine unschätzbare Erfahrung! Im Vergleich dazu sind andere Dinge fast wertlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030411
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030411,
					"content": "Das ist einfach nicht richtig! Setz ein gutes Stück Mora oder ein Rezept ein! Oder füge Obst oder Gemüse hinzu, falls gar nicht mehr anders geht. Gar nichts hineingeben, geht einfach nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030412,
					"content": "Ist nur ein Scherz, ist nur ein Scherz, ich werde ganz bestimmt etwas als Belohnung hineinlegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030413
					],
					"speakerTitle": "Drusus"
				}
			]
		},
