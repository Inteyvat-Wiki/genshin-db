			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670301,
					"content": "Hm, Arashakun ... Dieser Arashakun ist der Aranara, der diese Notizen geschrieben hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670302,
					"content": "Die Buchstaben in den Notizen sind manchmal sehr groß und dann wieder sehr klein, die großen sind in Ordnung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670303,
					"content": "Von den kleinen Buchstaben tun Paimon die Augen weh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670304,
					"content": "Kleine Buchstaben bereiten Paimon auch Unbehagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670305
					]
				},
				{
					"id": 730670305,
					"content": "Paimon liest immer normale Buchstaben, an kleine Buchstaben ist Paimon natürlich nicht gewohnt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670306,
					"content": "Hm, ist dieser Arashakun nicht zurückgekommen, nachdem er die letzten Seiten geschrieben hatte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670307,
					"content": "Wir sollten uns nun in der Höhle im Osten umsehen. In den Notizen steht, der „Mut“ sei verschwunden ... Wirklich seltsam. Wie kann „Mut“ denn verschwinden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306704,
