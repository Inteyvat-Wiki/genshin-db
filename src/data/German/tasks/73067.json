						],
						"stepId": 7306705,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306706",
							"2"
						],
						"stepId": 7306706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670201,
					"content": "(Die ersten Seiten sind in einer kleinen Handschrift verfasst ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670202
					],
					"speakerTitle": "Notizen in unterschiedlichen Handschriften"
				},
				{
					"id": 730670202,
					"content": "„Hach, das ist wirklich ein lieber Nara, der mit Arashakun befreundet sein will. Der Liebe Nara mag den ängstlichen Arashakun und brachte ihm sogar die Schrift der Nara bei ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670203
					],
					"speakerTitle": "Notizen in unterschiedlichen Handschriften"
				},
				{
					"id": 730670203,
					"content": "„Der liebe Nara hat Arashakun getröstet, als Blätter auf seinen Kopf fielen und ihn erschreckten. Der liebe Nara wird für immer Arashakuns guter Freund sein!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670204
					],
					"speakerTitle": "Notizen in unterschiedlichen Handschriften"
				},
				{
					"id": 730670204,
					"content": "(Auf den nächsten Seiten wird die Schrift immer kleiner und verwirrter ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670205
					],
					"speakerTitle": "Notizen in unterschiedlichen Handschriften"
				},
				{
					"id": 730670205,
					"content": "„... Ooh, der Nara wurde von der ‚haarigen Dämonenfratze‘ geholt. Die ‚haarige Dämonenfratze‘ hat so lange Klauen und ist ganz, ganz schrecklich ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670206
					],
					"speakerTitle": "Notizen in unterschiedlichen Handschriften"
				},
				{
					"id": 730670206,
					"content": "„... Aber ich muss Nara retten. Ooh ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670207
					],
					"speakerTitle": "Notizen in unterschiedlichen Handschriften"
				},
				{
					"id": 730670207,
					"content": "(Auf den nächsten Seiten ist die Schrift sehr groß und hart ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670208
					],
					"speakerTitle": "Notizen in unterschiedlichen Handschriften"
				},
				{
					"id": 730670208,
					"content": "„Ich habe die ‚haarige Dämonenfratze‘ besiegt und den Nara-Freund gerettet. Der Nara-Freund hat Arashakun ‚Mut‘ gegeben, Arashakun wird jetzt nie wieder ein Feigling sein.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670209
					],
					"speakerTitle": "Notizen in unterschiedlichen Handschriften"
				},
				{
					"id": 730670209,
					"content": "„... Der ‚mutige‘ Arashakun kämpft tapfer gegen die ‚haarige Monsterfratze‘. Nara muß jetzt keine Angst mehr haben, von einer ‚haarigen Monsterfratze‘ bedroht zu werden!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670210
					],
					"speakerTitle": "Notizen in unterschiedlichen Handschriften"
				},
				{
					"id": 730670210,
					"content": "(Auf den letzten Seiten wird die Handschrift wieder ganz klein ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670211
					],
					"speakerTitle": "Notizen in unterschiedlichen Handschriften"
				},
				{
					"id": 730670211,
					"content": "„... Aah, wie kann das sein, der ‚Mut‘ von Arashakun ist verschwunden, der ‚Mut‘ den Nara Arashakun geschenkt hat. Er muss von der ‚haarigen Dämonenfratze‘ gestohlen worden sein.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670212
					],
					"speakerTitle": "Notizen in unterschiedlichen Handschriften"
				},
				{
					"id": 730670212,
					"content": "„Die ‚haarige Dämonenfratze‘ hat lange Klauen und ist furchtbar gerissen. Aber Arashakun fehlt der ‚Mut‘, um etwas zu unternehmen ... Ah, Arashakun muss in der <color=#00E1FFFF>Höhle im Osten</color> suchen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Notizen in unterschiedlichen Handschriften"
				}
			]
		},
		{
