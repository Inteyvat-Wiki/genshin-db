					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670101,
					"content": "He, diese Hilichurle haben etwas Seltsames verloren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670102,
					"content": "Es scheint aus Blumen gemacht zu sein. Seltsam, es sind offensichtlich ganz normale Blumen. Sie wurden vor längerer Zeit gepflückt ... haben sich aber gut gehalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670103,
					"content": "Paimon kann fühlen, dass dem Ding ziemlich viel Dendro-Kraft anhaftet ... Und es wurde hier zurückgelassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670104,
						730670106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670104,
					"content": "Es stammt sicher von den Aranara ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670105
					]
				},
				{
					"id": 730670105,
					"content": "Ja, ganz bestimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670108,
					"content": "Hm, diesem Ding aus Blumen wohnt so viel Dendro-Kraft inne, dass es sogar in den Händen der Hilichurle nicht verwelkt ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670109,
						730670110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670109,
					"content": "Vielleicht haben sie es immer bei sich getragen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670111,
					"content": "Ja, wir geben das besser so schnell wie möglich den Aranara zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670112,
					"content": "#Lass uns ins Haus gehen und nachschauen, {NICKNAME}. Wer auch immer es verloren hat, weint vielleicht gerade in dem Haus vor sich hin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670110,
					"content": "Vielleicht ist das etwas sehr Wertvolles ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670106,
					"content": "Das sind Dendro-Hilichurle ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670107
					]
				},
				{
					"id": 730670107,
					"content": "Was soll das sein? Das müssen die Aranara verloren haben, die hier leben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306702,
			"completionStepIds": [
				7306705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306705",
