				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arashakun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670401,
					"content": "Bist du Arashakun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670402,
					"content": "*wimmer* Ooh, Arashakun ist tatsächlich mein Name. Kommt mir nicht so nahe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670403
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670403,
					"content": "Ich bin euch zwar dankbar, dass ihr mich gerettet habt, aber Arashakun bittet euch dennoch, euch von mir fern zu halten ... Ooh *wimmer*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670404
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670404,
					"content": "Arashakun fühlt sich so ein bisschen sicherer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670405
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670405,
					"content": "Was? Wir haben dich doch gerade eben gerettet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670406,
					"content": "Ooh, Entschuldigung! Tut mir leid! Arashakuns Bitte ging zu weit und hat euch wütend gemacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670407
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670407,
					"content": "Aber Arashakun ist hier gefangen und immer noch ganz erschrocken. *wimmer* Ich hoffe, ihr könnt mir verzeihen, wenn ich unhöflich war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670408
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670408,
					"content": "Macht nichts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670409,
					"content": "Das ist gut. Dürfte Arashakun eure Namen erfahren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670410
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670410,
					"content": "Paimons Name ist Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670411,
					"content": "#Ich bin {NICKNAME} ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670412
					]
				},
				{
					"id": 730670412,
					"content": "#*wimmer* Ooh, der goldene Nara {NICKNAME} und Paimon. Aber woher kennt ihr den Namen von Arashakun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670413
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670413,
					"content": "Wir haben die Notizen in dem Haus gelesen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670414
					]
				},
				{
					"id": 730670414,
					"content": "#Der goldhaarige Nara {NICKNAME} hat die Notizen gelesen und hat Arashakun gesucht und befreit. Der liebe Nara ist wirklich gutherzig und wunderbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670415
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670415,
					"content": "*wimmer* Ooh, wenn der „Mut“ von Arashakun nicht verschwunden wäre, wäre er nicht in diese Lage geraten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670416
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670416,
					"content": "Genau, das hat Paimon auch in den Notizen gelesen. Arashakun, was meinst du damit, dass dein „Mut“ verschwunden ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670417,
					"content": "Das ist eine ganz alte Geschichte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670418
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670418,
					"content": "Vor vielen Monden hatte Arashakun keinen „Mut“, so wie jetzt auch. Damals hielt sogar das Geräusch eines knackenden Zweigs Arashakun nachts wach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670419
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670419,
					"content": "Aber selbst der feige Arashakun kannte einen Nara, der mit Arashakun befreundet sein wollte. Der Nara war zwar nicht so mächtig wie Nara Varuna, aber auch ganz lieb!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670420
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670420,
					"content": "Er hätte sich niemals über Arashakun lustig gemacht, nur weil Arashakun feige ist. Wenn Arashakun Angst hatte, hat er von sich aus Arashakuns Hand gehalten. Arashakun wird seinen Freund niemals vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670421
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670421,
					"content": "Eines Tages wurde Nara von der „haarigen Dämonenfratze“ entführt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670422
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670422,
					"content": "Warte, was ist denn diese „haarige Dämonenfratze“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670423,
					"content": "„Haarige Dämonenfratze“, hat lange Klauen, trägt eine Fratze, ist Dämon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670424
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670424,
					"content": "... Ähm, ach so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670425,
						730670427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670425,
					"content": "Weiß Paimon, was das ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670426
					]
				},
				{
					"id": 730670426,
					"content": "Wäre schon komisch, wenn Paimon das wüsste ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670429,
					"content": "Also diese „haarige Dämonenfratze“ hat Arashakuns Freund entführt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670430,
					"content": "... „Haarige Dämonenfratze“, durchtrieben und gerissen. Beim bloßen Gedanken an sie, fängt Arashakuns ganzer Körper an zu zittern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670431
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670431,
					"content": "*wimmer* Ooh, Arashakun fürchtete sich sehr, als sein Nara Freund entführt wurde, aber obwohl Arashakun Angst hatte, von der „haarigen Dämonenfratze“ geschlagen zu werden, war die Angst größer, den Nara Freund nie wiederzusehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670432
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670432,
					"content": "Also hat Arashakun die Augen ganz fest zugekniffen, die Zähne zusammengebissen und in die Hände geklatscht! Und dann hat Arashakun den Nara Freund befreit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670433
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670433,
					"content": "Danach hat der Nara Freund ein „Mutamulett“ aus Blumen gemacht und gesagt: „Arashakun ist ein mutiger Aranara, kein feiger Aranara!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670434
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670434,
					"content": "Und so hat Arashakun „Mut“ bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670435
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670435,
					"content": "Aber so gesehen, war denn dein „die Augen ganz fest zugekniffen, die Zähne zusammengebissen und in die Hände geklatscht“ auch eine ganz mutige Tat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670436,
					"content": "Nein, nein. Arashakun hat doch danach den „Mut“ von dem Nara Freund bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670437
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670437,
					"content": "Aber du selbst hast doch deinen Freund gerettet, das war sehr mutig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670438,
					"content": "Nein, nein. Als Arashakun seinen Freund gerettet hat, waren die Knie ganz weich, aber nachdem Arashakun den „Mut“ bekommen hat, waren die Knie nicht mehr weich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670439
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670439,
					"content": "Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670440,
						730670441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670440,
					"content": "Das Amulett ist doch nur ein Symbol!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670442,
					"content": "#*wimmer* Ooh, die Worte von Nara {NICKNAME} sind zu kompliziert. Arashakun weiß nur, dass er „Mut“ hat, wenn er das „Mutamulett“ hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670443
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670443,
					"content": "Als der „Mut“ gestohlen wurde, wollte Arashakun heimlich in der Höhle der „haarigen Dämonenfratze“ suchen, um vielleicht eine Spur von Arashakuns „Mut“ zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670444
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670444,
					"content": "Dabei wurde Arashakun von Schleimen in der Höhle eingeschlossen. Zum Glück hat dich die „haarige Dämonenfratze“ nicht entdeckt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670445,
					"content": "#Ach ja, {NICKNAME}, erinnerst du dich noch an das Ding, das wir bei den Hilichurlen gefunden haben? Könnte es sich dabei um Arashakuns Amulett handeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670446,
					"content": "Arashakun, wir haben vielleicht den „Mut“ gefunden, den du verloren hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670447,
					"content": "#Wirklich?! Nara {NICKNAME} und Paimon haben wirklich Arashakuns „Mut“ gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670441,
					"content": "Du hast den Mut aus deinem Herzen geschöpft!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670427,
					"content": "Typische Aranara-Antwort ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670428
					]
				},
				{
					"id": 730670428,
					"content": "Ja, keine Ahnung, was diese „haarige Dämonenfratze“ sein soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Paimon"
				}
			]
		},
