					"Arashakun",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670601,
					"content": "Das ist es! Das ist es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670602
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670602,
					"content": "Das ist Arashakuns „Mutamulett“. Nachdem Arashakun es einige Tage nicht bei sich hatte, sind die Blumen etwas ausgeblichen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670603
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670603,
					"content": "Aber das macht nichts, Arashakun wird ab jetzt gut darauf aufpassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670604
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670604,
					"content": "„Arashakun ist ein mutiger Aranara! Kein feiger Aranara!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670605
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670605,
					"content": "#Ich bin euch wirklich überaus dankbar, Nara {NICKNAME} und Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670606
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670606,
					"content": "Arashakun hat jetzt seinen „Mut“ wiedergefunden. Ab jetzt kann Arashakun nichts mehr aufhalten. Und die lächerliche „haarige Dämonenfratze“ wird von Arashakun besiegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670607
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670607,
					"content": "(Oh, seine Stimme klingt ganz anders als zuvor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670608,
					"content": "#Die „Haarige Dämonenfratze“ hat viele böse Sachen gemacht. Nara {NICKNAME} und Paimon, bitte kommt mit mir. Mit eurer Hilfe, können wir das Problem garantiert lösen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670609
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670609,
					"content": "Arashakun fühlt, dass heute ... Wir gehen zu der Monsterhöhle und ihre Tage sind gezählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670610
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670610,
					"content": "#Ooh, {NICKNAME}, wir gehen besser mit und schauen, was diese „haarige Dämonenfratze“ wirklich ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306707,
			"completionStepIds": [
				7306711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306711",
							"2"
						],
						"stepId": 7306711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arashakun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730670701,
					"content": "Paimon hatte es sich schon ein wenig gedacht ... Die „haarige Dämonenfratze“ ist tatsächlich ein Hilichurl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670702,
					"content": "Ein Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670703
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670703,
					"content": "Ja, die „haarige Dämonenfratze“ ist ein Hilichurl ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670704,
					"content": "Sind alle „Hilichurle“ „haarige Dämonenfratzen“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670705
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670705,
					"content": "Nein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670706,
					"content": "Du kannst es einfach so verstehen, Arashakun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670707
					]
				},
				{
					"id": 730670707,
					"content": "Ja, Arashakun hat es verstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670708
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670708,
					"content": "#Ah, mit der Hilfe von Nara {NICKNAME} und Paimon ist Arashakun der Aranara Nummer Eins und unbesiegbar. Die durchtriebene und listige „haarige Dämonenfratze“ ist kein Gegner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670709
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670709,
					"content": "Arashakun muss heute unbedingt nach Hause gehen und einen großen Eintrag schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670710
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670710,
					"content": "Einen großen Eintrag schreiben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670711
					]
				},
				{
					"id": 730670711,
					"content": "Ich meine einen Eintrag mit großen Strichen und großen Buchstaben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670712
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670712,
					"content": "Der Arashakun mit „Mut“ und der Arashakun ohne „Mut“ scheinen zwei völlig verschiedene Aranara zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670713,
					"content": "Der Arashakun ohne „Mut“ hat ganz weiche Knie und kann nichts machen, der Arashakun mit „Mut“ kann alle möglichen beeindruckenden Sachen machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670714
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670714,
					"content": "Deshalb ist der „Mut“ für Arashakun nicht nur ein tolles Geschenk von dem Nara Freund, sondern auch eine ganz, ganz wichtige Sache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670715
					],
					"speakerTitle": "Arashakun"
				},
