				]
			},
			"dialogs": [
				{
					"id": 750790301,
					"content": "#Herzlich willkommen ... Hmm, es sieht so aus, als ob eine von euch bereits die Kunst des Fliegens beherrscht. Ist es also {M#dieser junge Mann}{F#diese junge Frau}, {M#der}{F#die} das Fliegen lernen möchte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790302,
						750790304
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790302,
					"content": "Ich habe schon meinen Flugschein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790303
					]
				},
				{
					"id": 750790303,
					"content": "Flugschein? Nun, davon höre ich zum ersten Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790305
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790305,
					"content": "Unser Ziel ist es, dass sich Saurier und Menschen gemeinsam verbessern. Und dein Gefährte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790306
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790306,
					"content": "*brüll* ... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790307
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790307,
					"content": "... Hmm, tut mir leid, Kleiner, aber ich bezweifle, dass die Flugschule Pakpaka der richtige Ort für dich ist, um dein Können unter Beweis zu stellen. Aber es ist nicht deine Schuld, also nimm es nicht persönlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790308
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790308,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790309,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} ist noch jung und hat viel Potenzial.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790310
					]
				},
				{
					"id": 750790310,
					"content": "Das Flugpotential eines Tepetlisauriers kann keinesfalls mit dem eines Qucusauriers oder Iktomisauriers mithalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790311,
					"content": "#Wie auch immer, {M#junger Mann}{F#junge Frau}, wenn du dich für unsere Flugübung interessierst, empfehle ich dir, unsere Trainingsrennstrecke auszuprobieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790313
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790313,
					"content": "Um einen Qucusaurier zu steuern, musst du Hindernissen ausweichen und dich flexibel bewegen. Wie gut du wirklich bist, findest du auf der Trainingsrennstrecke heraus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790312
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790312,
					"content": "Um ehrlich zu sein, haben wir wirklich hart gearbeitet, um sie zu bewerben. Wir haben die Preise vorbereitet, den Wettbewerb organisiert und so weiter. Wenn du es geschafft hast, kannst du deinen Preis bei Lamizana abholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790304,
					"content": "Was kannst du mir beibringen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790305
					]
				}
			]
		},
