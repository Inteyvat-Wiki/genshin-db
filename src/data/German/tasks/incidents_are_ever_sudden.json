					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791905,
					"content": "Entschuldige bitte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750791906
					]
				},
				{
					"id": 750791906,
					"content": "Alles gut. Auf Wiedersehen.",
					"roleType": "TALK_ROLE_NPC",
