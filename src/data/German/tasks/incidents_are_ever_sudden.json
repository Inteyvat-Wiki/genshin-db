			},
			"dialogs": [
				{
					"id": 750790901,
					"content": "Es war so einfach, diese Preise zu gewinnen ... Paimon wünschte, dass die Aufträge der Abenteurergilde alle so einfach wären!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790902,
					"content": "#Seid ihr etwa Abenteurer, {M#Herr}{F#Frau} {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790903
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790903,
					"content": "Ich habe eine Abenteurerlizenz, aber Paimon nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790904
					]
				},
				{
					"id": 750790904,
					"content": "#Hmpf! Paimon kann auch ohne so einen Wisch Abenteurer sein! Und Paimon kann auch genauso gut fliegen wie {NICKNAME}, obwohl sie keinen Flugschein hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790905,
					"content": "Fragst du, weil du einen Auftrag für uns hast? Warte, verrate es Paimon noch nicht ... Lass Paimon mal raten. Es kann nur eine Antwort geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790906,
					"content": "#Du hast bestimmt gesehen, wie nahe wir {REALNAME[ID(2)|SHOWHOST(true)]} stehen, und jetzt willst du uns nach dem Geheimnis unseres guten Verhältnisses fragen! Ist es das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790907,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790908
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790908,
					"content": "Ähm, nicht im Geringsten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790909
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790909,
					"content": "Hä? Aber Lamizana sagte doch gerade ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790910,
					"content": "Er ist derjenige, der ein Problem hat. Er ist wirklich gut darin, Leute für sich zu gewinnen. Sogar Oberon hört auf ihn, nachdem er ihm ein paar Saurierkekse gegeben hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790911
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790911,
					"content": "Uoooh ... Uoooh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790912
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750790912,
					"content": "Hör auf, so zu tun, als wärst du derjenige, dem Unrecht widerfahren ist. Ein erstklassiger Qucusaurier muss eine strenge Diät halten. Außerdem bist du einer, der leicht zunimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790913
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790913,
					"content": "Der Kerl muss etwas vorhaben, wenn er meiner Schwester Lliwa so oft schmeichelt ... Ich verstehe nicht, warum sie sich nicht vor ihm in Acht nimmt. Sie lacht sogar, wenn sie sich unterhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790914
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790914,
					"content": "Hm? Hört sich aber nach einem netten Kerl an. Hast du etwa ein paar Vorurteile, weil du ihn nicht magst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790915,
					"content": "Nein, es ist mehr als das. Er hat sich in letzter Zeit ziemlich verdächtig verhalten, aber ich weiß nicht, was er die Tage so treibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790916
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790916,
					"content": "Erwachsene haben immer etwas zu tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790917
					]
				},
				{
					"id": 750790917,
					"content": "Ja, hat er nicht ein Flugturnier erwähnt? Vielleicht ist er mit den Vorbereitungen beschäftigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790918,
					"content": "Er hat von einem bevorstehenden Flugturnier gesprochen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790919
					]
				},
				{
					"id": 750790919,
					"content": "Aber er hat nicht viel Arbeit in die Sache gesteckt. Die Vorbereitungen und die harte Arbeit hat Paran gemacht. Er lief die ganze Zeit mit Carrewuff durch die Gegend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790920
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790920,
					"content": "Gestern habe ich auch etwas gehört! Er hat heimlich mit einem Fremden über etwas Gefährliches gesprochen. Ich habe mich nicht näher heran getraut, weswegen ich nicht alles gehört habe, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790921
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790921,
					"content": "Ich habe sie sagen gehört „Sei pünktlich am Tag des Turniers“, „Geh nicht zu weit weg“, „Menschenleben“, „Ich zahle die andere Hälfte, wenn du erfolgreich bist“ und „Wir besprechen die Details morgen Abend im Nordlager“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790922
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790922,
					"content": "Wie kommt es, dass du nur die zweite Hälfte so klar und deutlich gehört hast?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790923
					]
				},
				{
					"id": 750790923,
					"content": "Das ist alles Oberon zu verdanken. Er war zu dieser Zeit besonders unruhig und wollte unbedingt zu Lamizana gehen. Am Ende konnte ich ihn nicht mehr aufhalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790924
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790924,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790925
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750790925,
					"content": "Das ist kein Lob, du Trottel. Jedenfalls ging der Fremde dann schnell weg, als er sah, dass ich Oberon verfolgte. Lamizana benahm sich danach auch komisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790926
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790926,
					"content": "Ich glaube, er hat heute versucht, einen Streit mit mir anzuzetteln, weil er Angst hat, dass er auffliegt. Er will nur eine gute Ausrede haben, um mich zu überwachen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790927
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790927,
					"content": "Ooh, dafür, dass du ein Kind bist, denkst du wirklich über komplizierte Dinge nach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790928,
					"content": "Ich seh schon ... Ihr traut den Worten eines Kindes auch nicht, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790929
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790929,
					"content": "#Aber genau deshalb möchte ich {M#Herrn}{F#Frau} {NICKNAME} bitten, mit mir nachts das nördliche Lager zu untersuchen ... Nur für den Fall, dass er wirklich etwas Gefährliches vorhat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790930
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790930,
					"content": "Wir müssen einen Weg finden, ihn aufzuhalten! Mit dir als Zeuge werden mir die anderen sicher glauben ... und Lliwa auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790931
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790931,
					"content": "#Wenn {M#Herr}{F#Frau} {NICKNAME} denkt, dass das nur die verrückten Gedanken eines Kindes sind, dann hilf mir wenigstens, einen Brief zu überbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790932
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790932,
					"content": "Ich habe einen Brief geschrieben, in dem ich die ganze Situation erkläre. Wenn ich morgen nicht zurückkomme, bring ihn bitte Lliwa. Auch Oberon werde ich in ihre Obhut geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790933
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790933,
					"content": "Warte doch mal! Das wird immer unheimlicher. Das kann doch alles nicht wahr sein, oder? ... Hmm, aber wenn es doch wahr wäre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790934,
					"content": "#{NICKNAME}, warum gehen wir der Sache nicht nach? Paimon wird Alpträume haben, falls wirklich etwas passieren sollte, nachdem wir das alles ignoriert haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790935
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790935,
					"content": "Ihr wollt mir helfen? Hurra! Dann lasst uns heute Abend doch zusammen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790936
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790936,
					"content": "Überlass das einfach uns. Du bleibst hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790937
					]
				},
				{
					"id": 750790937,
					"content": "Ja, genau! Mehr Leute machen die Untersuchungen nicht unbedingt leichter. Du solltest hier bleiben und auf Nachricht von uns warten. Siehst du, Paimon ist auch eine erfahrene Abenteurerin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790938,
					"content": "Nun ... Du hast recht. Dann bleibe ich hier und kümmere mich um Oberon. Ich muss auch Lliwa überzeugen, sich von Lamizana fernzuhalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790939
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790939,
					"content": "Ich zähle also auf euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taruka"
				}
			]
		},
