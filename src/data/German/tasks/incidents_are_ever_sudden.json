			"dialogs": [
				{
					"id": 750790701,
					"content": "Als Veteran und dein großer Bruder muss ich dir beibringen, dich anzupassen und beliebt zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790702
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790702,
					"content": "Danke, aber das ist nicht nötig. Außerdem bist du nicht mein großer Bruder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790703
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790703,
					"content": "Übrigens, könntest du aufhören, Oberon Kekse zu geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790704
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790704,
					"content": "*brüll* ... *brüüüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790705
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750790705,
					"content": "He, hör mal, du Gör, wenn deine Schwester nicht wäre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790706
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790706,
					"content": "Entschuldigung, ich bin hier, um meinen Preis entgegenzunehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790707
					]
				},
				{
					"id": 750790707,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790708,
					"content": "Oh, ein seltener Gast. Kleine Tepetlisaurier sieht man hier nicht alle Tage. Und dann noch das hier ... Na, da hast du ja wirklich viele Arten von Gefährten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790709
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790709,
					"content": "#Art?! Paimon und {REALNAME[ID(2)|SHOWHOST(true)]} sind noch viel unterschiedlicher!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790710,
					"content": "*brüll*? *brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790711
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790711,
					"content": "#Hm? Nein, also wir sind beide Gefährten von {NICKNAME}, das ist sicher, aber wir sind nicht ganz gleich. Paimon wollte damit nicht sagen, dass einer von uns besser oder schlechter ist, also sei nicht traurig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790712,
					"content": "Die Wahrheit schmerzt am meisten, wenn sie versehentlich ausgesprochen wird ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790713
					]
				},
				{
					"id": 750790713,
					"content": "#He, du weißt, dass Paimon es nicht so meint, also mach die Dinge nicht komplizierter, als sie sind. {REALNAME[ID(2)|SHOWHOST(true)]} ist ein richtig guter Kumpel von uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790714,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} ist wirklich ein richtig guter Kumpel von uns.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790715
					]
				},
				{
					"id": 750790715,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790716,
					"content": "#Hehe, Paimon wusste, dass du es kapieren würdest, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790717,
					"content": "Beneidenswert, dass ihr euch so gut miteinander versteht. Eure Kleidung verrät, dass ihr nicht von hier seid, aber das Vertrauen und die Freundschaft zwischen euch und diesem kleinen Tepetlisaurier scheinen wirklich tief zu reichen. Was ist euer Geheimnis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790718
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790718,
					"content": "Ich will nichts beschönigen. Taruka und sein Qucusaurier sind zwar Gefährten, aber sie kommen nicht sehr gut miteinander aus. Und falls es einen Trick gibt, wie man eine gute Beziehung aufbaut, dann würde es mich freuen, wenn er ihn lernen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790719
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790719,
					"content": "Zurück zum Thema ... Wo sind ihre Preise? Sag mir nicht, dass sie noch nicht fertig sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790720
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790720,
					"content": "Natürlich sind sie schon fertig! Du bist echt gut darin, das Thema zu wechseln. Wie auch immer, wir reden später darüber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790721
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790721,
					"content": "Wir werden bald ein Flugturnier veranstalten. Wenn ihr daran interessiert seid, lasst euch die Gelegenheit nicht entgehen, zuzusehen und meine tolle Vorführung zu bewundern! Ich habe noch etwas zu erledigen, daher mache ich mich erst mal auf den Weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizana"
				}
			]
		},
		{
