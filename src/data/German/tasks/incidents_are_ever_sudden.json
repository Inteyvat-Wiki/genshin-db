			"dialogs": [
				{
					"id": 750790101,
					"content": "Einfach nur diesen Kreis passieren ... Nur diesen Kreis ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790102
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790102,
					"content": "Die Flugübungsrennstrecke sollte jetzt leicht genug sein, oder? Wie bitte? Sie muss noch leichter werden? Du meinst also, es ist am besten, wenn jeder mitmachen und bestehen kann?",
					"roleType": "TALK_ROLE_NPC",
