				"points": []
			},
			"dialogs": [
				{
					"id": 750791601,
					"content": "Nicht anfassen, das ist ein Preis. Wenn du dich für unsere Preise interessierst, schließe die von Temach vorbereitete Trainingsrennstrecke ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizana"
				}
			]
		},
		{
			"id": 7507917,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7507907",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7507907"
						],
						"stepId": 7507907
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lamizana",
					"Taruka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791701,
					"content": "Ha, du solltest wirklich etwas gegen deine schlechte Laune tun. Ich sage das nur zu deinem Besten, klar? Du bist alt genug, um zu lernen, vernünftiger zu sein. Selbst wenn du es nicht für deine Schwester tust, so solltest du es doch aus Eigeninteresse tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791702
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750791702,
					"content": "*brüll* ... *brüüüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791703
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750791703,
					"content": "Siehst du? Er stimmt mit mir überein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791704
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750791704,
					"content": "Auch wenn es einem von uns an Vernunft fehlen müsste, ich wäre es ganz sicher nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791705
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750791705,
					"content": "He! Du Gör ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizana"
				}
			]
		},
		{
			"id": 7507918,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7507909",
							"1"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7507909"
						],
						"stepId": 7507909
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paran"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791801,
					"content": "Tut mir leid, Fräulein Quilla. Hat Carrewuff dich verletzt? Diese Art der Begeisterung für Fremde ist nicht normal für ihn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791802
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750791802,
					"content": "Hehe, kein Problem. Ich habe gern mit Tieren zu tun. Ihre Zuneigung macht mich glücklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791803
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750791803,
					"content": "Hauka vermisst dich übrigens sehr. Als er hörte, dass ich bald hierherkomme, ließ er mich fragen, wie es dir geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791804
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750791804,
					"content": "... Onkel Hauka? Warum interessiert er sich für mich? Tut mir leid, wir hatten ein paar Meinungsverschiedenheiten, die sind aber nicht der Rede wert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paran"
				}
			]
		},
		{
			"id": 7507919,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_STATE_NOT_EQUAL",
						"rawParams": [
							"7507909",
							"3"
						],
						"stepId": 7507909,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lliwa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791901,
					"content": "Wie lästig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791902,
						750791905
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791902,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750791903
					]
				},
				{
					"id": 750791903,
					"content": "Nun, ich habe einen kleinen Bruder, der viel jünger ist als ich. Vielleicht liegt es daran, dass er in seinen rebellischen Jahren ist, aber er versteht sich mit niemandem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791904
					],
