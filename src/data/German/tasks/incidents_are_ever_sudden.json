					"Temach"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750875101,
					"content": "Wir haben hier noch ein paar Flugherausforderungen, die Details dazu stehen auf der Anzeigetafel. Versuch es ruhig, wenn du Lust hast. Selbstverständlich gibt es auch etwas zu gewinnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875102,
						750875103,
						750875104
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875102,
					"content": "Über die Flugschule Pakpaka ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875105
					]
				},
				{
					"id": 750875105,
					"content": "Eigentlich weiß ich gar nicht, warum sie so heißt. Apropos Pakpaka ... Hast du schon mal die Geschichte von Kuntur und dem bösen Zauberer Rumi gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875106
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875106,
					"content": "Die Krieger des Stammes haben gegen den bösen Zauberer Rumi verloren und wurden von ihm in Pakpakas verwandelt. Hört sich nicht gut an, oder? Ich weiß auch nicht ... Aber Pakpakas fliegen vielleicht ziemlich schnell, oder so. Wer weiß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875103,
					"content": "Über Lamizana ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875107
					]
				},
				{
					"id": 750875107,
					"content": "Haha ... Er ist ein Profi, aber nicht unbedingt ein guter Lehrer. Aber als Gegner in einem Flugturnier ... ganz passabel, würde ich sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875108
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875108,
					"content": "Wer würde schon hierherkommen, wenn er gut fliegen könnte? Also, wenn ich jetzt sehr streng wäre ... *seufz* Hach, ist ja nicht so, dass das nicht schon mal vorgekommen wäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875109
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875109,
					"content": "Darum fokussiere ich mich mittlerweile mehr darauf, Leute zu motivieren. Ich bin überzeugt, dass man so auch gute Resultate erzielen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875104,
					"content": "Tschüs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875110
					]
				},
				{
					"id": 750875110,
					"content": "Auf Wiedersehen und bis bald! Du bist jederzeit wieder willkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				}
			]
		},
