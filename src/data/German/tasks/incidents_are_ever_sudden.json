			"dialogs": [
				{
					"id": 750791501,
					"content": "Herzlichen Glückwunsch zum Abschluss der Herausforderung! Du kannst deinen Preis bei Lamizana abholen. Er befindet sich in der Nähe an einer gut sichtbaren Stelle.",
					"roleType": "TALK_ROLE_NPC",
