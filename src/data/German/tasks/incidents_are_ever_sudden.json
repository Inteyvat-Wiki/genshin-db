			"dialogs": [
				{
					"id": 750876001,
					"content": "Willkommen in der Flugschule Pakpaka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876002,
						750876003
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876002,
					"content": "Was machst du denn hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876004
					]
				},
				{
					"id": 750876004,
					"content": "Ich leite die Schüler an, und helfe ihnen, wenn sie Fragen haben. Das ist jetzt ganz anders als früher, weißt du. Damals konnten die Schüler nicht auf derart umsichtige Fürsorge hoffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876005
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876005,
					"content": "Aber einmal gab es ein kleines Problem, weil der Trainer ... Na ja, er war vielleicht ein bisschen zu harsch in seiner Wortwahl? Und leider war der betreffende Schüler auch einer, der schnell aus der Haut fahren konnte ... Hach, ich muss zugeben, dass ich darüber nur sehr ungern spreche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876006
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876006,
					"content": "Wie auch immer ... Seitdem hat die Flugschule ihre didaktische Ausrichtung geändert. Wie man so schön sagt, kann ja niemand einem freundlichen Lächeln widerstehen. Und wer freut sich nicht über ein Kompliment?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876003,
					"content": "Ich muss los, bis später.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876007
					]
				},
				{
					"id": 750876007,
					"content": "Ich wünsche dir einen wundervollen Tag!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cisik"
				}
			]
		}
	]
