			"dialogs": [
				{
					"id": 711280201,
					"content": "„Wenn der Baum ein wenig gewachsen ist, werde ich die Blätter pflücken und einen Tee für euch kochen.“",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280202
					]
				},
				{
					"id": 711280202,
					"content": "„Wenn die Zeit gekommen ist, machen wir es genau hier, laden sie alle ein, die Fürstin der stehenden Wolken und des stillen Windes und den Fürsten der fließenden Wasser und aufgetürmten Berge ...“",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280203
					]
				},
				{
					"id": 711280203,
					"content": "„Du besitzt die Unverfrorenheit, solche Töne anzuschlagen, nachdem du auf meinem Grundstück nach Belieben Bäume angepflanzt hast!“",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280204
					]
				},
				{
					"id": 711280204,
					"content": "... Es kam nie der Tag, an dem das Versprechen der Vergangenheit eingelöst wurde, aber der uralte schweigende Baum weiß noch um das Antlitz jenes Versprechens ...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280205
					]
				},
				{
					"id": 711280205,
					"content": "... Der Teeduft von heute weht schon seit Langem durch die Bergwelt des Chenyu-Tals und wurde an noch entferntere Orte geweht ...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}