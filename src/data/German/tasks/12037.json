					"id": 120370701,
					"content": "Ich habe gehört, dass die Person, die das „Musou no Hitotachi“ abgewehrt hat, tatsächlich ein Besatzungsmitglied der „Crux“ war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370702
					],
					"speakerTitle": "Ryouhei"
				},
				{
					"id": 120370702,
					"content": "Was? Gehört er nicht zu den Truppen von Sangonomiya?",
					"roleType": "TALK_ROLE_NPC",
