				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kagotsurube Isshin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370401,
					"content": "Oh? Du hast ja gar kein Göttliches Auge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370402
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370402,
					"content": "Anscheinend habe ich dich mit jemandem verwechselt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370403
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370403,
					"content": "Bevor du angreifst, solltest du dich zumindest vergewissern, dass es die richtige Person ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370404,
					"content": "Egal, wen du suchst, einfach anzugreifen ist gefährlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370405,
					"content": "Kennt ihr einen Jungen namens Kaedehara Kazuha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370406
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370406,
					"content": "Er benutzt wie du einen Einhänder. Ich habe auch gehört, dass er ein Göttliches Auge mit Anemo-Kraft besitzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370407
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370407,
					"content": "Warum suchst du nach ihm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370408
					]
				},
				{
					"id": 120370408,
					"content": "Das geht dich nichts an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370409
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370409,
					"content": "Vergiss es, du weißt es sowieso nicht. Es war Zeitverschwendung, dich zu fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370410
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370410,
					"content": "Was war denn mit diesem Kerl los? Er fuchtelt hier mit einem seltsamen Schwert rum und entschuldigt sich nicht einmal für sein bizarres Auftreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370411,
					"content": "Wieso sollten wir einer solchen Person einfach so Informationen über Kazuha liefern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370412,
						120370414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370412,
					"content": "Da hast du recht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370413
					]
				},
				{
					"id": 120370413,
					"content": "Nicht wahr? Allerdings denkt Paimon nicht, dass er gegen Kazuha bei einem würdevollen Duell eine Chance hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370416,
					"content": "Für alle Fälle müssen wir Kazuha dennoch so schnell wie möglich informieren und ihn daran erinnern, vorsichtig zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370417,
					"content": "Ich habe ein bisschen das Gefühl ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370418
					]
				},
				{
					"id": 120370418,
					"content": "Hm? Was denn für ein Gefühl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370419,
					"content": "Vielleicht hat er eine besondere Verbindung zu Kazuha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370420
					]
				},
				{
					"id": 120370420,
					"content": "Eine besondere Verbindung? Meinst du, dass er Kazuha kennt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370421,
						120370422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370421,
					"content": "Es ist zwar nur ein vages Gefühl ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370423,
					"content": "Ja, aber die Bewegungen von allen ähneln sich ein wenig, das muss also nichts heißen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370424,
					"content": "Wie dem auch sei! Lass uns gehen und Kazuha warnen, bevor er in Gefahr gerät.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370425,
					"content": "Paimon hat gehört, dass die „Crux“ gerade ihre Vorräte an Ritou verlädt. Er müsste dort sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370422,
					"content": "Aber seine Bewegungen und Fähigkeiten ähneln Kazuha ein wenig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370414,
					"content": "Du bist ausnahmsweise mal schlau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370415
					]
				},
				{
					"id": 120370415,
					"content": "He! Was soll das heißen? Paimon ist immer so schlau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1203705,
			"completionStepIds": [
				1203705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203705",
							"2"
						],
						"stepId": 1203705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370501,
					"content": "Hallo. Weißt du, wo Kazuha ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370502,
					"content": "Ihr sucht auch nach Kazuha? Er muss ja etwas Erstaunliches geleistet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370503
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370503,
					"content": "„Auch“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370504
					]
				},
				{
					"id": 120370504,
					"content": "Hahaha, diesmal sind wir mit dem Boot hierhergefahren, um Vorräte zu kaufen. Aber kaum waren wir hier, kamen schon viele Einheimische vorbei, um uns nach Kazuha zu fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370505
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370505,
					"content": "Kapitän Beidou erhielt bei der Schlacht am Nazuchi-Strand auch viel Aufmerksamkeit. Ich habe sie aber noch nie so große Beliebtheit genießen sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370506
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370506,
					"content": "In der Flotte ist Kazuha ein Mann von wenigen Worten. Es gibt sogar Zeiten, in denen er Kapitän Beidou nicht einmal zuhört, aber sie lacht nur darüber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370507
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370507,
					"content": "Du weißt also nicht, was er geleistet hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370508,
					"content": "Ich habe einiges gehört, wie das Abwehren von Shougun Raidens „Musou no Hitotachi“ und dergleichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370509
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370509,
					"content": "Ist das beeindruckend?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370510
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370510,
					"content": "Das ist genauso beeindruckend wie der Kampf von Beidou gegen Haishan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370511
					]
				},
				{
					"id": 120370511,
					"content": "Ah, darunter kann ich mir etwas vorstellen. Hahaha, dass ihm so viel Verehrung entgegengebracht wird, versteht sich doch von selbst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370512
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370512,
					"content": "Die Leute der Tenryou-Verwaltung haben Kazuha zuvor zu sich bestellt. Sie sagten, dass es etwas Wichtiges mit ihm zu besprechen gäbe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370513
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370513,
					"content": "Am Anfang dachte ich, sie wollten ihn verhaften. Allerdings waren sie sehr freundlich zu ihm. Deswegen hatte ich den Eindruck, dass er sehr respektiert wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370514
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370514,
					"content": "Vor nicht allzu langer Zeit war es völlig unvorstellbar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370515,
						120370516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370515,
					"content": "Auch das Bakufu will Freundschaft zeigen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				},
				{
					"id": 120370517,
					"content": "Danke, dann lass uns in der Tenryou-Verwaltung vorbeischauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370518,
					"content": "Alles klar. Ich werde mich hier weiter mit den Schaulustigen beschäftigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370516,
					"content": "Schließlich hat sich die Einstellung von Shougun Raiden geändert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				}
			]
		},
		{
			"id": 1203706,
			"completionStepIds": [
				1203706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203706",
							"2"
						],
						"stepId": 1203706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Kujou Kamaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370601,
					"content": "#Ah? Da bist du ja, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370602
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370602,
					"content": "Hallo zusammen. Wir haben gerade über die Abschaffung des „Augenhatz-Dekrets“ gesprochen. Da ihr auch hier seid, nehmt bitte Platz und hört zu, wenn ihr wollt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370603
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370603,
					"content": "Wir haben Herrn Kaedehara Kazuha diesmal eingeladen, um den Respekt des Bakufu zum Ausdruck zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370604
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370604,
					"content": "Dank eurer Bemühungen befinden wir uns jetzt in dieser ausgezeichneten Situation. Damit hatte ich auch die Möglichkeit, Fehler meiner Familie zu korrigieren. Dafür bin ich sehr dankbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370605
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370605,
					"content": "Der Shougun zieht viele Aspekte in Betracht, um die in der Vergangenheit angesammelten Konflikte zu lösen oder abzumildern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370606
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370606,
					"content": "Die Dreierverwaltung hat den Vorschlag gemacht, diese Gelegenheit zu nutzen, um den Ruf der Familie Kaedehara wiederherzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370607
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370607,
					"content": "Du solltest auch einiges über die Familie Kaedehara wissen, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370608,
						120370609
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370608,
					"content": "Ein wenig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				},
				{
					"id": 120370610,
					"content": "Kurz gesagt, Inazuma hatte früher eine Gruppe von hochrangigen Schwertschmieden, die die Schwertschmiedefähigkeiten des Shougun erbten und weiterführten. Die Familie Kaedehara war eine von ihnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370611
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370611,
					"content": "Doch irgendwann verschwanden einige Schwertschmiede nach Snezhnaya. Sowohl die Familie Kaedehara als auch die Familie Kamisato wurden für ihre Unfähigkeit zur Rechenschaft gezogen und erlebten schwere Turbulenzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370612
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370612,
					"content": "Später erfuhren wir jedoch, dass die Drahtzieher hinter dem Vorfall die Fatui waren. Es ist weder angemessen noch fair, die ganze Schuld den Familien Kaedehara und Kamisato anzulasten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370613
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370613,
					"content": "Diesmal hat Herr Kaedehara Kazuha einen weiteren wichtigen Beitrag geleistet. Der Shougun denkt, dass sie ihn nicht nur belohnen, sondern auch für die Misshandlungen in der Vergangenheit entschädigen sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370614
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370614,
					"content": "Bitte verzeih mir, dass ich die Ergebnisse dieser Untersuchung nicht veröffentlicht habe. Das tue ich, um weitere Nachstellungen der Schwertschmiedefamilie durch die Fatui zu verhindern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370615
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370615,
					"content": "Das ist nicht nötig. Es ist mir eine Freude, an den guten Absichten des Shougun und des Bakufu teilhaben zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370616
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370616,
					"content": "Allerdings sind diese guten Absichten bestimmt nicht umsonst, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370617
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370617,
					"content": "Du machst dir zu viele Gedanken. Das ist eine „Entschädigung“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370618
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370618,
					"content": "Nachdem der Ruf wiederhergestellt ist, kann die Familie Kaedehara das Schwertschmiedegeschäft wieder aufnehmen und du brauchst nicht mehr herumzuwandern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370619
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370619,
					"content": "Mit dem Schutz des Shougun und der Unterstützung des Bakufu kannst du in der Stadt Inazuma ein angenehmes Leben führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370620
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370620,
					"content": "Vielen Dank für deine Freundlichkeit. Aber ich könnte mich vermutlich nicht an ein Leben in Luxus gewöhnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370621
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370621,
					"content": "Meine Vorfahren waren jedoch immer stolz auf den Namen Kaedehara und ihre ererbten Schwertschmiedefähigkeiten. Daher habe ich die Verantwortung, ihren Ruf wiederherzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370622
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370622,
					"content": "Es hört sich so an, als wärst du noch etwas zögerlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370623
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370623,
					"content": "Wenn du mein Angebot annimmst, denke ich, dass viele Gerüchte über dich, die in letzter Zeit in der Stadt kursierten, verschwinden werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370624
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370624,
					"content": "Gerüchte? Unterwegs hört Paimon nur Gutes über ihn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370625,
					"content": "Für manche Menschen ist „Musou no Hitotachi“ ein Symbol für Unbesiegbarkeit. Deswegen können und wollen sie nicht akzeptieren, dass Herr Kaedehara diese Schwertkunst so einfach abgewehrt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370626
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370626,
					"content": "Zu dieser Zeit wurde jemand Zeuge, dass die von Kazuha verwendete Elementarkraft nicht nur Anemo-Kraft, sondern auch Elektro-Kraft war. Danach verbreitete sich das Gerücht, dass „Kaedehara Kazuha das Teuflische Auge benutzt hat“, wie ein Lauffeuer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370627
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370627,
					"content": "Was? Aber es heißt doch, Menschen, die das Teuflische Auge benutzt haben, altern schnell. Aber Kazuha hat offenbar keine derartigen Veränderungen durchgemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370628,
					"content": "Ja, aber es ist für sie noch schwieriger zu verstehen, dass eine Person zwei Elementarkräfte gleichzeitig einsetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370629
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370629,
					"content": "Es gibt immer noch viele solcher Gerüchte. Ich bin es nicht gewohnt, im Zentrum der öffentlichen Meinung zu stehen, gejagt oder verdächtigt zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370630
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370630,
					"content": "Aber wenn das Bakufu bereit ist, mich zu unterstützen, beruhigt sich der Sturm dieser Angelegenheit vielleicht schneller ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370631
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370631,
					"content": "Deswegen solltest du gut darüber nachdenken. Das würde für beide Seiten hilfreich sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370632
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370632,
					"content": "Gut. Lass mich darüber nachdenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370633
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370633,
					"content": "Dieses Thema legen wir erstmal beiseite. Warum seid ihr beide hierhergekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370634
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370634,
					"content": "Ach ja! Da wäre noch ein wichtiges Thema, das Paimon fast vergessen hätte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370635,
					"content": "Du informierst Kaedehara Kazuha über den Angreifer in der Wildnis.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120370636
					]
				},
				{
					"id": 120370636,
					"content": "So eine gefährliche Person sucht nach mir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370637,
						120370638
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370637,
					"content": "Hast du Geschwister?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370639,
					"content": "Nein. Da bin ich auch verzweifelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370640
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370640,
					"content": "Meine Kampfkünste wurden mir von meiner Familie beigebracht und dienten ursprünglich dazu, Schwerter auszuprobieren. Um beim Probeschnitt eine korrekte Schwertbewegung zu schaffen und die Qualität jedes einzelnen Schwertes genau zu überprüfen, machen wir viele Übungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370641
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370641,
					"content": "Im Laufe der Zeit bildete die Familie eine Reihe von Probetechniken für die geschmiedeten Schwerter und erschuf daraus ebenfalls entsprechende Fähigkeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370642
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370642,
					"content": "Diese Techniken unterscheiden sich stark von der praktischen Kampfkunst auf dem Schlachtfeld. Es ist schwer vorstellbar, dass dies nur ein Zufall ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370643
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370643,
					"content": "Dann solltest du vorsichtig sein. Dieser Kerl ist sehr kurios.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370644
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370644,
					"content": "Ja. Er scheint ziemlich aggressiv zu sein. Wenn er anderen etwas antut, wird er schnell schlimme Konsequenzen verursachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370645
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370645,
					"content": "Na, dann schicke ich sofort jemanden zur Untersuchung dorthin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370646
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370646,
					"content": "Danke. Ich bin auch ziemlich neugierig auf diese Sache. Aber gut, ich brauche sowieso noch eine Weile, um über deinen Vorschlag nachzudenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370647
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370647,
					"content": "Ich begleite sie erstmal bei den Nachforschungen wegen des Angreifers und werde dir dann eine eindeutige Antwort geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370648
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370648,
					"content": "Gut, dann passt gut auf euch auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370649
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370649,
					"content": "Komm schon, lass uns den Angreifer finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370638,
					"content": "Hast du Schulkameraden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370609,
					"content": "Ich kann mich nicht mehr genau daran erinnern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				}
			]
		},
