			"dialogs": [
				{
					"id": 120370801,
					"content": "Ist dieser Kaedehara Kazuha noch nicht gekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370802
					],
					"speakerTitle": "Asano"
				},
				{
					"id": 120370802,
					"content": "Ich möchte diesen Helden unbedingt persönlich kennenlernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nosaki"
				}
			]
		},
