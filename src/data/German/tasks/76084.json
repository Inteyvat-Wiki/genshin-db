				},
				{
					"id": 760490707,
					"content": "Ah, das war auch nicht meine Absicht ... Ich wollte deine Melodie nur mit einem Hauch des sanften Mondlichts schmücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490709,
					"content": "Wir haben Wolken und Nebel durchdrungen und gemeinsam die Antwort auf dem Mond erblickt ... Ihre Schönheit gleicht der Musik, die deine Saiten nun singen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		},
		{
