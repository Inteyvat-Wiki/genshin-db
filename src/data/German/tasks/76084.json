				]
			},
			"dialogs": [
				{
					"id": 760840201,
					"content": "Probieren wir das, was Columbina immer singt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202
					]
				},
				{
					"id": 760490202,
					"content": "Probieren wir das, was Columbina immer singt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "(Aber welche Stimmung soll das Stück haben ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "Versuchen wir etwas Ruhiges und Sanftes ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "Das war hinreißend. Du hast dich also wirklich an die Melodie erinnert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490605,
					"content": "Hehe, nur, weil du so eine fantastische Sängerin bist! Wenn wir deine Stimme hören, halten wir manchmal sogar inne und hören einfach nur zu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490606,
					"content": "Hm, die Kuuhenki schienen von deiner Darbietung auch ganz entzückt zu sein. Vielleicht haben sie ja etwas dabei gelernt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490607,
					"content": "Ich könnte in Zukunft wieder auf deine lehrreiche Unterstützung angewiesen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490608,
					"content": "Komm, gib mir deine Hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490609,
					"content": "Hm? Nein, nein, das war eine kostenlose Darbietung. Keine Lehrgebühren notwendig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490610,
					"content": "Hmm? Lehrgebühren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490611,
					"content": "Ich dachte nur ... dass der sanfte Glanz des Mondlichts ein passender Begleiter wäre für solch eine schöne Melodie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490701,
					"content": "Versuchen wir etwas Fröhliches ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "Oh, schon vorbei? Da könnte ich wirklich ewig zuhören ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490703,
					"content": "Wie ich dir schon mal gesagt habe, ist das das einzige Schlaflied, an das ich mich erinnern kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490704,
					"content": "Auch wenn ich den Sinn dahinter noch nicht ganz erfassen kann – nachdem ich dich spielen gehört habe, habe ich das Gefühl, dass die Antwort, die dort oben auf dem Mond auf mich wartet ... zumindest eine wunderschöne sein muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490705,
					"content": "Hier, gib mir deine Hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760490706,
					"content": "Das passt schon. Wirklich, du musst uns nichts dafür geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490707,
					"content": "Ah, das war auch nicht meine Absicht ... Ich wollte deine Melodie nur mit einem Hauch des sanften Mondlichts schmücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		},
