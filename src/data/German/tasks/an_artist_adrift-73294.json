		},
		{
			"id": 7329405,
			"completionStepIds": [
				7329405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329405",
							"2"
						],
						"stepId": 7329405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940501,
					"content": "Das ist aber ein spartanisches Lager! Kann man das überhaupt Lager nennen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940502,
					"content": "Aber wenigstens ist die Aussicht nicht schlecht. Wenn man zum Strand geht, fühlt man sich ganz frei, viel entspannter als in Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940503
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940503,
					"content": "Wie lebst du denn in Fontaine ... Anscheinend ganz anders, als man von einem berühmten Maler erwarten würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940504,
					"content": "Meine Bleibe in Fontaine ist wirklich recht eng. *räusper* Ich bin schließlich kein Angeber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940505
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940505,
					"content": "Die Abenteurerlager draußen in der Wildnis sind ja luxuriöser als das hier. Oh? Ist das ... Wo ist dein tierischer Begleiter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940506,
					"content": "Ähm ... Ich habe keinen tierischen Begleiter. Den müssen irgendwelche Abenteurer hiergelassen haben. Jedenfalls ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940507
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940507,
					"content": "Ich würde euch zwei zum Dank wirklich gern etwas anbieten, aber mein Gepäck ist ins Wasser gefallen, als sich das Floß in Luft aufgelöst hat, und ich kann nicht schwimmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940508
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940508,
					"content": "Wenn ihr zwei mir helfen könntet, mein über Bord gegangenes Gepäck zu finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940509
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940509,
					"content": "Kannst du denn mit dem durchnässten Gepäck noch etwas anfangen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940510
					]
				},
				{
					"id": 732940510,
					"content": "Ich habe alles sorgfältig eingepackt, aber etwas ... Ach, auch egal, macht nichts. Ich kann es noch einmal malen ... noch einmal ... malen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940511
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940511,
					"content": "#Oh ... Er tut Paimon leid ... {NICKNAME}, wir helfen ihm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940512,
					"content": "Es gibt hier sonst wirklich niemanden mehr, der mir helfen könnte ... Ihr seid meine letzte Rettung, ich werde hier mit dem Tee auf euch warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				}
			]
		},
		{
			"id": 7329410,
			"completionStepIds": [
				7329410
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329410",
							"2"
						],
						"stepId": 7329410,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hund"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732941001,
					"content": "Seltsam, warum gibt es hier einen Hund? Und er scheint etwas zu bewachen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941002,
					"content": "(Schaut dich argwöhnisch an.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941003,
						732941005
					],
					"speakerTitle": "Hund"
				},
				{
					"id": 732941003,
					"content": "Er sieht klug aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941004
					]
				},
				{
					"id": 732941004,
					"content": "(Ein kurzes Bellen.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "Hund"
				},
				{
					"id": 732941007,
					"content": "Ach, war da nicht ein Fressnapf in Juliens Lager? Das kann doch nicht seiner sein! Komisch, warum hat Julien dann gesagt, dass er keinen tierischen Begleiter hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941008,
					"content": "*winsel* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941009
					],
					"speakerTitle": "Hund"
				},
				{
					"id": 732941009,
					"content": "Der Hund läuft in Richtung des Lagers ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941010
					]
				},
				{
					"id": 732941010,
					"content": "Er ist fortgerannt ... Wir fragen Julien später. Aber jetzt ... Was mag wohl unter diesem Sandhügel begraben sein, wollen wir nachschauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941005,
					"content": "Heimatloser Streuner ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941006
					]
				},
				{
					"id": 732941006,
					"content": "(Knurrt.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "Hund"
				}
			]
		},
		{
			"id": 7329412,
			"completionStepIds": [
				7329412
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329412",
							"2"
						],
						"stepId": 7329412,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732941201,
					"content": "Wir sind zurück ... Oh! Wenn das nicht Juliens tierischer Begleiter ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941202,
					"content": "(Knurrt bedrohlich.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941203
					],
					"speakerTitle": "Hund"
				},
				{
					"id": 732941203,
					"content": "... Oh, „Pfeffer“, du Streuner ... Knurrst du mich immer noch an. Hast du vergessen, wer hier für alle sorgt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941204
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941204,
					"content": "(Er hat also doch einen Namen! Aber ist mit diesem Kerl alles in Ordnung? Wieso zankt er mit dem Hund ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941205,
						732941207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941205,
					"content": "(Sie scheinen sich gut zu verstehen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941206
					]
				},
				{
					"id": 732941206,
					"content": "(Kann man das „sich gut verstehen“ nennen?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941244,
					"content": "Ähm ... Julien! Wir haben dir alle Sachen, die du verloren hast, zurückgebracht. Ach, und „Pfeffer“ ist doch dein tierischer Begleiter, oder nicht? Warum wolltest du uns hereinlegen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941209,
					"content": "Dieses undankbare Vieh? Da hätte ich lieber einen Garm als Begleiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941210
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941210,
					"content": "Dann könnt ihr wohl keine langfristigen Begleiter sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941211
					]
				},
				{
					"id": 732941211,
					"content": "Genau. Einfache Leute wie Julien, die schon vor Hunger in Ohnmacht fallen, können sich wohl kaum mit einem Teyvat-Spiegelei retten, wenn sie einem Garm begegnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941212,
					"content": "Übrigens, er schien an dem Strand ein Zeichenbrett zu bewachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941213,
						732941215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941213,
					"content": "Vielleicht wollte er das Zeichenbrett verbergen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941214
					]
				},
				{
					"id": 732941214,
					"content": "Uh, böses Hundchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941217,
					"content": "(Bellt protestierend.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941218
					],
					"speakerTitle": "Hund"
				},
				{
					"id": 732941218,
					"content": "Hast du immer noch den Nerv, hier herumzujaulen? Wenn ich dir nicht in diese Sackgasse gefolgt wäre, hätte ich wenigstens auf dem ursprünglichen Weg nach Fontaine zurückkehren können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941219
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941219,
					"content": "Wie? Sagtest du nicht, dass du den Wasserweg wegen der Landschaft nehmen wolltest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941220,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941221
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941221,
					"content": "Nun, bevor ich überhaupt die Gelegenheit hatte, die Landschaft zu genießen, wurde ich von ihm hierhergeführt. Auf diesen verschlungenen Wegen verliert man schnell die Orientierung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941222
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941222,
					"content": "So war das also. Warum hast du uns das nicht gleich gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941223,
					"content": "Ähm ... Um ... das Image eines berühmten Malers zu bewahren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941224
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941224,
					"content": "Warum hat Paimon immer, wenn du so herumdruckst, das Gefühl, dass du uns für dumm verkaufen willst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941225,
					"content": "#Nun, in Sachen Landschaft von Sumeru kennen {NICKNAME} und Paimon jedenfalls ein paar schöne Plätzchen. Wir können dich hinführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941226,
					"content": "Nein, nicht nötig. Ich meine, ich bin euch ja dankbar, aber, äh ... Ich bin ja schließlich ein berühmter Maler und glaube, dass eine Landschaft es nur verdient, von mir gemalt zu werden, wenn ich sie selbst entdeckt habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941227
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941227,
					"content": "Ach, der Tee ist aufgebrüht, lasst uns lieber ein Tässchen trinken. Habt ihr nicht noch etwas von dem Spiegelei? Als kleiner Snack zum Tee ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941228,
						732941230
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941228,
					"content": "Spiegelei zum Tee ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941229
					]
				},
				{
					"id": 732941229,
					"content": "#Genau, {NICKNAME} hat eine Menge Gerichte auf der Pfanne! Wir können doch etwas anderes essen, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941232,
					"content": "Zusammen mit Julien trinkt ihr den Tee mit ein paar Snacks.\\nAber irgendwie schmeckt er komisch ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941233
					]
				},
				{
					"id": 732941233,
					"content": "Dieser Tee ... Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941234,
					"content": "Also, den habe ich einem Freund abgekauft. Er soll die Intelligenz stimulieren. Ich finde ihn ja lecker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941235,
						732941237
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941235,
					"content": "Ich bin froh, dass ich keine solchen Freunde habe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941236
					]
				},
				{
					"id": 732941236,
					"content": "Warum sagst du das? Freunde sind doch etwas Gutes. Es war auch ein Freund, der mir geraten hat, nach Sumeru zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941240,
					"content": "Ich bin euch beiden für heute sehr dankbar, auch wenn ich nicht weiß, ob euch die Belohnung ausreicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941241
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941241,
					"content": "Kein Problem. Du willst dich ja von der Landschaft inspirieren lassen ... Brauchst du unsere Hilfe wirklich nicht? Paimon hat Angst, du könntest dich wieder verlaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941242,
					"content": "Pilgerweg ... Äh, ich meine, der Sinn der Reise, ist ja, sie selbst zu unternehmen ... Macht euch keine Mühe, ich komme schon zurecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941243
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941243,
					"content": "Wenn du es sagst ... Na gut. Denk aber daran, nicht wieder vor Hunger umzufallen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941237,
					"content": "Könnte ich noch ein Tässchen haben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941238
					]
				},
				{
					"id": 732941238,
					"content": "#{NICKNAME}, ist mit deiner Zunge alles in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941239,
					"content": "Hehe, nicht, dass ich geizig wäre, aber ich muss es noch ein Weilchen in Sumeru aushalten und brauche noch etwas für mich selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941230,
					"content": "Leider hast du sie alle aufgegessen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941231
					]
				},
				{
					"id": 732941231,
					"content": "Hm ... Aber Tee allein ist doch auch nichts, zaubern wir lieber noch etwas Leckeres!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941215,
					"content": "Vielleicht wollte er verhindern, dass das Zeichenbrett gestohlen wird.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941216
					]
				},
				{
					"id": 732941216,
					"content": "Aber er ist sofort davongelaufen, als wir es gefunden haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941207,
					"content": "(Es liegt kein Geruch von Alkohol in der Luft ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941208
					]
				},
				{
					"id": 732941208,
					"content": "(Ist der etwa immer so? Hm ... Scheint ein ziemlich seltsamer Typ zu sein ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}