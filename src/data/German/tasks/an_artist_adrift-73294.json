			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940101,
					"content": "Hm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940102
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940102,
					"content": "#Der sieht aber nicht gut aus ... Er muss ja umkommen vor Hunger! {NICKNAME}, wollen wir ihm nicht etwas zu essen geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940103,
						732940105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940103,
					"content": "Hoffentlich bringt ihn das Essen wieder auf die Beine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940104
					]
				},
				{
					"id": 732940104,
					"content": "#Paimon sagt das nicht aus Schmeichelei, aber die Gerichte von {NICKNAME} sind wahre Leckerbissen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940107,
					"content": "Ihr gebt dem am Boden Liegenden Teyvat-Spiegelei.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732940108
					]
				},
				{
					"id": 732940108,
					"content": "Heißa! Wie neu geboren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940109
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940109,
					"content": "Oha ... Der stand wirklich kurz vorm Verhungern, das war doch nur ein Spiegelei ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940110,
					"content": "Diese Delikatesse weckt wirklich die Lebensgeister ... Hm, wenn ich gewusst hätte, dass Spiegelei so lecker ist, hätte ich dem Typen das magische Vogelei ganz sicher abgekauft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940111
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940111,
					"content": "Was für ein magisches Vogelei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940112,
					"content": "Nach seinem Verzehr soll man einen ganzen Tag lang vom Pech befreit sein. Hätte ich doch nur dieses magische Vogelei gekauft ... Nein, besser gleich ein Dutzend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940113
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940113,
					"content": "Hm ... Das klingt äußerst verdächtig, das ist doch bestimmt Betrug. Aber wie kommst du denn überhaupt allein hierher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940114,
					"content": "Ich bin ... ein berühmter Maler aus Fontaine und wollte in Sumeru nach Inspirationen suchen. Ihr könnt mich Julien nennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940115,
						732940117
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940115,
					"content": "An so einem Ort suchst du nach Inspirationen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940116
					]
				},
				{
					"id": 732940116,
					"content": "Es gibt bestimmt einen besseren Ort, um Inspirationen zu suchen, oder? Vielleicht mit einer schöneren Aussicht und wo es etwas sicherer ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940119,
					"content": "Und wenn du wirklich ein Maler aus Fontaine bist, wieso stehst du dann mit leeren Händen da? Hm ... Du bist in Wirklichkeit ein Spion der Fatui, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940120,
					"content": "Das ist aber ein hartes Urteil! Ich kann mir gar nicht vorstellen, was du durchgemacht haben musst, dass du so hart urteilst. Jedenfalls bin ich wirklich ein Maler, nur ein Maler, sonst gar nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940121
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940121,
					"content": "Ich habe ... Nun, ich habe hier schon genug Inspirationen gesammelt und wollte gerade nach Fontaine zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940122
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940122,
					"content": "Ich hatte aber nicht damit gerechnet, dass das Klima in Sumeru so trocken ist. Im Vergleich dazu war es im Chenyu-Tal etwas feuchter. Aber sobald ich die Grenze zu Sumeru überschritten hatte, nahmen die Sandstürme zu ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940123
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940123,
					"content": "Zu meiner Schande muss ich gestehen, dass ich nach wie vor ein feuchteres Klima bevorzuge, also wollte ich den Wasserweg wählen und die verschiedenen Landschaften auf dem Weg genießen. Aber dann hat sich mein Floß in Nichts aufgelöst und ich kann doch nicht schwimmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940124
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940124,
					"content": "Dann musst du es in Fontaine ja schwer haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940125
					]
				},
				{
					"id": 732940125,
					"content": "Stimmt, und es ist ja nicht nur das Wasser. Ach, vergesst das. Ich habe am Ufer ein Plätzchen gefunden, an dem ich mich ausruhen kann. Es muss noch etwas Tee da sein, der nicht durchgeweicht ist. Das soll mein Dank sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940126
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940126,
					"content": "Du willst uns zum Tee einladen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940127,
					"content": "Ähm ... Natürlich! Um mich für das Spiegelei zu bedanken, möchte ich euch zwei ... Wie heißt ihr zwei eigentlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940128
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940128,
					"content": "Ach ja, Paimon hat ja fast vergessen, sich vorzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940129,
						732940130,
						732940132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940129,
					"content": "#{NICKNAME} und Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940134
					]
				},
				{
					"id": 732940134,
					"content": "Oh, welch klangvolle Namen. Also, ich lade euch zum Tee ein. Mein Lager ist ganz in der Nähe, wir sind gleich da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940130,
					"content": "#{M#Der Botschafter der Gerechtigkeit und sein}{F#Die Botschafterin der Gerechtigkeit und ihr} Gefolge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940131
					]
				},
				{
					"id": 732940131,
					"content": "#Nein, es sollten {NICKNAME} und {M#seine}{F#ihre} beste Gefährtin ... Paimon sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940132,
					"content": "Glänzendes Gold und funkelndes Silber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940133
					]
				},
				{
					"id": 732940133,
					"content": "#Wir sind glänzendes Gold {NICKNAME} und funkelndes Silber Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940117,
					"content": "Wer sagt denn von sich selbst, dass er „berühmt“ ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940118
					]
				},
				{
					"id": 732940118,
					"content": "Ja, eben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940105,
					"content": "Haha, aber er ist ja nicht Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940106
					]
				},
				{
					"id": 732940106,
					"content": "Was denn! Ist doch egal, wer das ist, ist nicht jeder schon einmal vor Hunger umgekippt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
