			"dialogs": [
				{
					"id": 752440302,
					"content": "Ja, genau! Vielen lieben Dank! Jetzt kann ich viel beruhigter angeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440303
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440303,
					"content": "Das ist übrigens ein Spezial-Helm. Der hält sogar einem Gewehrschuss stand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440307
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440307,
					"content": "Du machst dir zu viele Gedanken. Ist doch nur Angeln.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440304
					]
				},
				{
					"id": 752440304,
					"content": "Du hast ja keine Ahnung. Neulich wurde hier am Ufer jemand beim Angeln durch einen Pfeil oder eine Kugel am Auge verletzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440305
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440305,
					"content": "Das war wohl irgendein Streit unter Banditen aus Nod-Krai ... Man weiß aber auch nichts Genaueres. Seitdem ist Vorsicht halt besser als Nachsicht, meinst du nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Rantiy"
				}
			]
		},
