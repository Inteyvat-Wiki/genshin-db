			"dialogs": [
				{
					"id": 752440101,
					"content": "Oh! Du bist auch zum Angeln hier? Weißt du, zum Angeln braucht man einen robusten Hut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440106
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440106,
					"content": "Warum braucht man überhaupt einen Hut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440102
					]
				},
				{
					"id": 752440102,
					"content": "Weil ein Hut eben für mehr Sicherheit sorgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440107
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440107,
					"content": "Aber du hast doch auch keinen auf?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440103
					]
				},
				{
					"id": 752440103,
					"content": "Genau deswegen spreche ich dich überhaupt an ... Tut mir leid, aber mein Hut ist vom Wind weggefegt worden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440104
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440104,
					"content": "Hättest du kurz Zeit, mir bei der Suche zu helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440108
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440108,
					"content": "Warum gehst du nicht selbst suchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440105
					]
				},
				{
					"id": 752440105,
					"content": "Wenn ich nach dem Hut suche, kann ich nicht gleichzeitig die Angel halten. Und andersrum kann ich nicht den Hut suchen, solange ich die Angel in der Hand habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440109
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440109,
					"content": "Hilf mir bitte! Ich wäre dir echt dankbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rantiy"
				}
			]
		},
