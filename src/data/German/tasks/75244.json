			"dialogs": [
				{
					"id": 752440402,
					"content": "Machst du dir Sorgen wegen dieser Raufbolde? Das brauchst du nicht. Wenn du ihnen begegnest, sag ihnen einfach meinen Namen und schon lassen sie dich in Ruhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440403
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440403,
					"content": "Und komm bloß nicht auf die Idee, nach was anderem zu fragen. Es war Schicksal, dass wir beide uns getroffen haben, und du hast mir sogar meinen Hut zurückgebracht. Betrachte es einfach als ein Zeichen meiner Dankbarkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
