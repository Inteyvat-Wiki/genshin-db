				"objectNames": [
					"Hannelore"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708190201,
					"content": "Oh ... danke für deine Freundlichkeit. Aber als Ordensschwester der Favonius-Kathedrale darf ich solche Geschenke nicht annehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190202
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190202,
					"content": "Für mich genügt es, einen Hauch dieses Duftes einzuatmen, der mit der Meeresbrise herüberweht. Schöne Dinge gehören dem Wind, und keiner bestimmten Person. Das ist der Weg derer, die im Glauben wandeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190203
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190203,
					"content": "Trotzdem bewegt mich deine Freundlichkeit wie eine warme Brise aus dem Süden. Bitte nimm dieses Buch als kleines Dankeschön an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190204
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190204,
					"content": "Möge der Anemo-Archon über dich wachen. Und möge der Weg vor dir, wie dieser Duft, von Tugend, Freiheit und Mitgefühl erfüllt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hannelore"
				}
			]
		},
