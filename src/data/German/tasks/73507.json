	"talks": [
		{
			"id": 7350701,
			"completionStepIds": [
				7350701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350701",
							"2"
						],
						"stepId": 7350701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Haniyyah",
					"Balfour"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735070101,
					"content": "#{NICKNAME}, der „Goldene Meteorit“, und Paimon, der „Silberne Satellit“. Lange nicht mehr gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070102
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070102,
					"content": "Ich sehe, dass es euch gut geht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070103,
						735070106
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070103,
					"content": "Lange nicht gesehen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070104
					]
				},
				{
					"id": 735070104,
					"content": "Ha... Haniyyah! Und der super verantwortungsbewusste Herr Balfour!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070105,
					"content": "Paimon freut sich sehr, euch wieder in Ormos zu sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070114,
					"content": "Nun, zurück zur Sache. Was macht ihr zwei denn hier? Wenn Paimon sich noch richtig erinnert, befand sich hier früher der „Blumengelee“-Stand ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070115,
					"content": "#Ah, liebe {M#Helden}{F#Heldinnen}! Wenn ich nur eure Stimmen höre, fühle ich mich gleich viel sicherer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070116
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070116,
					"content": "Und jetzt möchte ich euch über die Ergebnisse unserer Arbeit berichten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070117
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070117,
					"content": "Zuvor habt ihr beide die „Nilotpala-Lotos-Zähmermeisterschaft“ gewonnen und verkündet, dass die Meisterschaft eine Zeit lang ausgesetzt werden sollte, bis die Akademie die „Weisheitsperle“ verbessert hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070118
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070118,
					"content": "Ich glaube, ihr wartet immer noch auf Nachrichten von der Akademie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070119
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070119,
					"content": "Ja, genau! Layla, Cyno oder die zuständigen Forscher sollten uns informieren, wenn es Fortschritte gibt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070120,
						735070121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070120,
					"content": "Paimon ist keine Gelehrte, sie kann die technischen Details nicht verstehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070122,
					"content": "Das stimmt, sich ständig nach dem Stand der Dinge zu erkundigen bringt auch nichts, also haben wir sie nicht gestört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070123,
					"content": "Wie geduldig, wie rücksichtsvoll! Was mich betrifft, so bin ich jedes Mal, wenn ich mich an die letzte Meisterschaft erinnere, so aufgeregt und kann die Nächste kaum erwarten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070124
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070124,
					"content": "Deshalb habe ich vor Kurzem die Akademie besucht und einige der verantwortlichen Gelehrten nach den Fortschritten befragt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070125
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070125,
					"content": "Im Moment befindet sich die Verbesserung der „Weisheitsperle“ in einer kritischen Phase, und es gibt noch einige theoretische Probleme zu lösen. Wir müssen noch lange warten, bis sie in Produktion gehen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070126
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070126,
					"content": "Aber über die erste Meisterschaft wird immer weniger diskutiert. Die Menschen vergessen sie langsam, wir können den Einfluss der letzten Meisterschaft nicht einfach so verschwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070127
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070127,
					"content": "Aus diesem Grund habe ich mich mit Fräulein Haniyyah zusammengetan, um eine „thematische Veranstaltung“ zu organisieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070128
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070128,
					"content": "Eine „thematische Veranstaltung“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070129
					]
				},
				{
					"id": 735070129,
					"content": "Haben diese ... Schachfiguren in Form von Pilzbestien auf dem Tisch also etwas damit zu tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070130,
					"content": "Ganz genau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070131
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070131,
					"content": "Herr Balfour hat nach neuen Sponsoren gesucht und Pläne für die nächste Meisterschaft geschmiedet. Er hat es sogar bis nach Liyue geschafft und einige neue Geschäftsmethoden gelernt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070132
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070132,
					"content": "Und dort hat er ein Spiel namens „Theater der Vorrichtungen“ gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070133
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070133,
					"content": "Dann hat er die Rechte am „Theater der Vorrichtungen“ für die Region Sumeru gekauft und mich gebeten, seine Beraterin zu werden, um ihm bei der Entwicklung einer völlig neuen Art von Spiel zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070134
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070134,
					"content": "Und der Name des Spiels lautet „Theater der Pilze“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070135
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070135,
					"content": "„Theater der Pilze“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070136,
					"content": "Lass Paimon raten ... Werden wir also Pilzbestien befehlen, um gegen alle Arten von Vorrichtungen zu kämpfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070137,
					"content": "Ganz richtig, „Silberner Satellit“, du bist sehr scharfsinnig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070138
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070138,
					"content": "Ich denke, dass dieses Spiel leicht zu verstehen und zu fördern ist. Sein Potenzial ist grenzenlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070139
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070139,
					"content": "Wenn es uns gelingt, es als ein mit der „Zähmermeisterschaft“ verbundenes Spiel zu vermarkten, können wir es schaffen, dass die Meisterschaft langfristig in den Köpfen der Menschen bleibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070140
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070140,
					"content": "Auf diese Weise wird die nächste Meisterschaft ein größeres Publikum und mehr Teilnehmer anziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070141
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070141,
					"content": "Natürlich kann dies nur mit eurer Zustimmung geschehen. Schließlich habt ihr das letzte Wort darüber, wie die Meisterschaft organisiert werden soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070142,
						735070143
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070142,
					"content": "Einen Versuch ist es wert!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070144,
					"content": "#Genau! {NICKNAME} und Paimon verstehen nicht viel von Geschäften, aber Paimon glaubt, dass du einen guten Plan hast, Herr Balfour!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070145,
					"content": "Du und Haniyyah habt gemeinsam hart daran gearbeitet, und Paimon glaubt an euch beide, also macht nur weiter so!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070146,
					"content": "Wir haben das Spiel noch nicht gespielt, aber Paimon wettet, dass viele Leute es lieben werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070147,
					"content": "Wunderbar! Da ihr zugestimmt habt, kann ich weitermachen und „Theater der Pilze“ bewerben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070148
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070148,
					"content": "Das Spiel befindet sich derzeit noch in der Testphase. Wir müssen also noch Leute einladen, um es zu erproben und ihre Rückmeldungen zu sammeln, damit wir weitere Verbesserungen vornehmen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070149
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070149,
					"content": "Ich bin mir sicher, dass du, der „Goldene Meteorit“, der auf seiner Reise durch Teyvat allen möglichen Spielen begegnet ist, die besten Vorschläge von allen machen wirst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070150
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070150,
					"content": "#Gut, dann machen wir es! {NICKNAME}, du bist doch {F#eine Meisterin}{M#ein Meister} auf diesem Gebiet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070151,
						735070152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070151,
					"content": "Hm, warum habe ich das Gefühl, dass du mir Befehle erteilst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070153,
					"content": "Paimon hat noch eine Frage an dich, Haniyyah ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070154
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070154,
					"content": "Du willst nach „Trommelkäppchen“ und den anderen fragen, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070155
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070155,
					"content": "Ja! Paimon vermisst die Pilzgefährten. Wie geht’s ihnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070156,
					"content": "Mach dir keine Sorgen, sie sind alle glücklich und gesund.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070157
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070157,
					"content": "„Wirbelnde Bestie“ und „Blitzor“ befinden sich derzeit in <color=#00E1FFFF>meinem vorübergehenden Wohnort im Norden von Ormos</color>. Eine der früheren Teilnehmerinnen kümmert sich um sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070158
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070158,
					"content": "Außerdem sind „Trommelkäppchen“ und „Freude-Funke“ gleich in der Nähe, du kannst mit ihnen spielen, „Silberner Satellit“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070159
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070159,
					"content": "#Gleich in der Nähe! Also gut, {NICKNAME}, Paimon wird mit „Trommelkäppchen“ spielen, während du später das neue Spiel ausprobierst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070160,
						735070161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070160,
					"content": "Gut!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070162,
					"content": "Na dann, lass uns keine Zeit verlieren. Komm, „Goldener Meteorit“, bitte probiere die Testversion des „Theaters der Pilze“ aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070161,
					"content": "Ich komme später nach!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070152,
					"content": "Wie auch immer, los, „Goldener Meteorit“!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070143,
					"content": "Vielen Dank für deine harte Arbeit!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070121,
					"content": "Ich weiß nichts über die technischen Details, also mache ich keine Vorschläge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070106,
					"content": "Wer seid ihr?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070107
					]
				},
				{
					"id": 735070107,
					"content": "#... {NICKNAME}, wovon redest du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070108,
					"content": "Wir haben früher an der „Nilotpala-Lotos-Zähmermeisterschaft“ teilgenommen und hatten so viel Spaß mit den Pilzgefährten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070109,
					"content": "Damals lernten wir Haniyyah kennen, und Herr Balfour war der verantwortungsvollste Mitarbeiter der letzten Meisterschaft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070110,
					"content": "Oh nein! Hast du etwa auch die Pilzgefährten „Trommelkäppchen“ und „Wirbelnde Bestie“ vergessen?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070111,
						735070112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070111,
					"content": "Ach ja, jetzt erinnere ich mich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070113
					]
				},
				{
					"id": 735070113,
					"content": "Ach, erschrecke Paimon nicht so! Paimon wollte dich sogar zum Arzt bringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070112,
					"content": "Haha, das war nur ein Scherz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070113
					]
				}
			]
		},
		{
			"id": 7350703,
			"completionStepIds": [
				7350703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
