					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070510
					]
				},
				{
					"id": 735070510,
					"content": "Haniyyah und die Pilzgefährten werden länger hier bleiben? Toll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070511,
					"content": "Paimon hatte vor, dich zu bitten, noch einen Tag länger hier zu bleiben, damit wir mehr Zeit mit den Pilzgefährten verbringen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070512,
					"content": "Aber es sieht so aus, als könnten wir nun zwei Fliegen mit einer Klappe schlagen! Das Spiel testen und gleichzeitig mit unseren Pilzgefährten spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070513,
					"content": "Du hast eine schöne, sorgenfreie Zeit mit Paimon, „Trommelkäppchen“ und „Freude-Funke“ verbracht und das Wundergelee an die Pilzgefährten verfüttert.\\nPaimon und die Pilzgefährten haben viel Spaß gehabt.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735070514
					]
				},
				{
					"id": 735070514,
					"content": "Hehe! Paimon fühlt sich innerlich so warm, als wären alle ihre Sorgen wie weggeflogen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070515,
					"content": "„Trommelkäppchen“, „Freude-Funke“, bis morgen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070516
					],
