			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Balfour",
					"Haniyyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735070301,
					"content": "Was denkst du, wie war dein erster Eindruck vom „Theater der Pilze“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070302
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070302,
					"content": "Nach deinem Gesichtsausdruck zu urteilen, bist du wohl noch nicht zu einem Schluss gekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070303,
						735070304
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070303,
					"content": "Ich habe ja nur eine Runde gespielt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070305
					]
				},
				{
					"id": 735070305,
					"content": "Stimmt schon. Mit so einem geringen Testinhalt ist es in der Tat ziemlich schwierig, die Vor- und Nachteile des Spiels zu beurteilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070306
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070306,
					"content": "Aber das ist kein Problem. Fräulein Haniyyah und ich werden noch eine Weile hier sein, und wir werden jeden Tag eine neue Runde für dich haben, insgesamt sieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070307
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070307,
					"content": "Bitte komm und probiere sie aus, wenn du Zeit hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070308
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070308,
					"content": "#Obwohl du jetzt {M#der Veranstalter}{F#die Veranstalterin} der Meisterschaft bist, haben Fräulein Haniyyah und ich uns dieses Spiel selbst ausgedacht, also ist es etwas außerhalb des ursprünglichen Plans. Vielen Dank, dass du bereit bist, zusätzliche Zeit zu investieren, um bei der Vorbereitung des Spiels zu helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070309
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070309,
					"content": "Und ich werde eine schöne Belohnung für dich vorbereiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070310,
						735070311
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070310,
					"content": "Haha, da kann ich nicht nein sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070312,
					"content": "Wie direkt und offen! Ich bewundere deinen Charakter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070313
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070313,
					"content": "Ich habe für die beiden Pilzgefährten eine ausreichend lange Aufenthaltsdauer beantragt, sodass sie während der gesamten Testphase vom „Theater der Pilze“ in Ormos bleiben können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070314
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070314,
					"content": "„Silberner Satellit“ kann dann mehr Zeit mit „Trommelkäppchen“ verbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070315,
						735070316
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070315,
					"content": "Ich freue mich für Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070317,
					"content": "Hehe, geh nur, „Trommelkäppchen“ vermisst dich auch sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070318
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070318,
					"content": "Ach ja, nimm das mit. Du kannst „Trommelkäppchen“ und „Freude-Funke“ damit füttern, wenn du mit ihnen spielst, es ist ihr Lieblingsessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070316,
					"content": "Ich möchte sie auch sehen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070311,
					"content": "Und ich werde dich bei der nächsten Meisterschaft auch gut bezahlen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070304,
					"content": "Ich muss noch etwas mehr spielen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070305
					]
				}
			]
		},
