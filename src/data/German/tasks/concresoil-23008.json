			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230080101,
					"content": "Ich glaube, ich stehe kurz vorm Durchbruch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080102,
					"content": "#{M#Reisender}{F#Reisende}! Warte einen Moment, {M#Reisender}{F#Reisende}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080103,
						230080104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080103,
					"content": "Stimmt etwas nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				},
				{
					"id": 230080105,
					"content": "Ich suche nach Schleimabsonderungen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080106,
					"content": "Die Sache ist die: Ich habe in den letzten Tagen experimentiert und den Lehm, den du mir mitgebracht hast, in verschiedenen Anteilen gemischt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080107,
					"content": "Obwohl ich viele Male gescheitert bin, habe ich zuletzt doch noch ein probates Mischungsverhältnis gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080108,
					"content": "Der „verdichtete Lehm“, der mit diesem Mischungsverhältnis hergestellt wird, ist zwar vor dem Aushärten nicht sehr formbar, aber er ist solide und haltbar, nachdem er ausgehärtet ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080109
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080109,
					"content": "Ich glaube, ich muss mehr mit Schleimabsonderungen vermischten Lehm hinzufügen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080110,
					"content": "#{M#Reisender}{F#Reisende}, könntest du mir bitte noch drei Portionen Schleimabsonderung bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080111
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080111,
					"content": "Mit diesen Schleimabsonderungen werde ich bestimmt den Lehm herstellen können, den ich brauche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080104,
					"content": "Was suchst du dieses Mal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080105
					]
				}
			]
		},
		{
			"id": 2300802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300802",
							"2"
						],
						"stepId": 2300802,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"2300802"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230080201,
					"content": "Hast du die Schleimabsonderungen erhalten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				}
			]
		},
		{
			"id": 2300803,
			"completionStepIds": [
				2300803
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300803",
							"2"
						],
						"stepId": 2300803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230080301,
					"content": "Sehr gut! Das ist es. Gib mir eine Sekunde. Gleich habe ich es geschafft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080302
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080302,
					"content": "Nach einer Weile ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230080303
					]
				},
				{
					"id": 230080303,
					"content": "Wie erwartet, war meine Vermutung richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080304
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080304,
					"content": "So gut seine Haftung auch ist, bricht der nasse Lehm leicht, wenn er erst einmal ausgehärtet ist. Nach dem Vermischen mit dem Vaniloqua-Lehm wird der ausgehärtete Lehm jedoch geschmeidiger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080305
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080305,
					"content": "Die Formbarkeit dieses Lehms vor dem Aushärten ist unzureichend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080306
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080306,
					"content": "Fügt man aber den mit Schleimabsonderungen vermischten Leim hinzu, wird die Formbarkeit dieses Lehms vor dem Aushärten plötzlich viel besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080307
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080307,
					"content": "Ich weiß auch nicht, woran das liegt, aber wenn ich es genauer beschreiben müsste, so wird der Lehm so schleimig wie die Schleime ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080308,
						230080309
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080308,
					"content": "Also „Schleimlehm“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080311
					]
				},
				{
					"id": 230080311,
					"content": "Der Schleim scheint die Mischung in irgendeiner Weise beeinflusst zu haben, also frage ich mich, ob die direkte Zugabe von Schleimabsonderungen die Sache effektiver machen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080312
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080312,
					"content": "Und wie sich gezeigt hat, änderte sich die Formbarkeit und Stabilität der Mischung entsprechend der hinzugefügten Menge der Schleimabsonderungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080313
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080313,
					"content": "Mit anderen Worten: Dieser Lehm ist nicht nur ein Baumaterial, sondern kann auch zur Herstellung von Töpferwaren verwendet werden, neben vielen anderen Dingen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080314,
						230080315
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080314,
					"content": "Glückwunsch!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080316,
					"content": "Danke. Das ist es, was die schlauen vornehmen Leute zu sagen pflegen: „Kleinvieh macht auch Mist“, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080317
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080317,
					"content": "Unterschätze nicht den Lehm. Eines Tages kann ich damit vielleicht einen Wolkenkratzer bauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080318
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080318,
					"content": "Ich werde diesem gemischten Lehm den Namen „verdichteter Lehm“ geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080319
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080319,
					"content": "Als Nächstes möchte ich sehen, was der „verdichtete Lehm“ so alles kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080320
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080320,
					"content": "Außerdem bietet er möglicherweise eine Lösung für die hartnäckigen Wohnungsprobleme, die die Menschen heutzutage plagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080321
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080321,
					"content": "#Also nochmals vielen Dank, {M#Reisender}{F#Reisende}. Bitte nimm dies als deine Belohnung an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080315,
					"content": "Deine Mühen haben sich gelohnt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080309,
					"content": "Wird das Paimon gefallen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080310
					]
				},
				{
					"id": 230080310,
					"content": "Paimon isst keinen Lehm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080311
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}