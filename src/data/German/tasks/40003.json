			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinghuo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030401,
					"content": "Gut, die Monster scheinen alle beseitigt zu sein. Ich denke, wir können ... Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030402
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030402,
					"content": "Wer seid ihr denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030403
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030403,
					"content": "Jiayi hat uns beauftragt, nach euch zu suchen. Er sagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030404,
					"content": "Oh, ich verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030405
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030405,
					"content": "Danke für eure Unterstützung! Wir wissen jetzt Bescheid und werden uns darum kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030406
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030406,
					"content": "#Vielleicht sehen wir uns ja im Hafen wieder, {F#nette Abenteurerin}{M#netter Abenteurer}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030407
					],
					"speakerTitle": "Xinghuo"
				},
				{
					"id": 400030407,
					"content": "#{NICKNAME}, findest du nicht auch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030408,
						400030413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030408,
					"content": "dass der Rat für Allgemeine Angelegenheiten nicht so ganz bei der Sache ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030409
					]
				},
				{
					"id": 400030409,
					"content": "Paimon ist ganz deiner Meinung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030410,
					"content": "Für die Einheimischen sind diese leckeren Sachen bestimmt nichts Besonderes mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030411,
					"content": "Aber für uns Abenteurer, die einsam durch die Wildnis streifen und hin und wieder ein paar Pilze sammeln, um nicht zu verhungern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030412,
					"content": "Für uns ist das Laternenritual etwas ganz Besonderes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030416,
					"content": "Dann gehen wir doch zu der Stelle, wo wir den Kerl gesehen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030417,
					"content": "Jemand von der Patrouille hat gesagt, dass Verbrecher immer wieder an den Tatort zurückkehren. Sie können einfach nicht anders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030418,
					"content": "Immer noch keiner hier zur Untersuchung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030419
					]
				},
				{
					"id": 400030419,
					"content": "Sie müssen sich ranhalten! Wenn der Kerl an den Materialien herumgepfuscht hat, wird alles zu spät sein, wenn die Millelithen eintreffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030413,
					"content": "Deswegen werden wir uns um die Lösung des Problems kümmern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030414
					]
				},
				{
					"id": 400030414,
					"content": "Genau so ist es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030415,
					"content": "Bei dem, was wir alles auf unserer Reise erlebt haben, ist es besser, der Sache auf den Grund zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4000307,
