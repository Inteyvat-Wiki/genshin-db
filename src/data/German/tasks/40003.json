			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030701,
					"content": "Ha, da ist er ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030702,
						400030703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030702,
					"content": "Wollen wir ihm hinterher?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030704
					]
				},
				{
					"id": 400030704,
					"content": "Warte, da scheint noch jemand zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030703,
					"content": "Ja, wir kriegen ihn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030704
					]
				}
			]
		},
		{
