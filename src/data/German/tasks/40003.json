			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiayi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030201,
					"content": "Hal... Oh, ihr seid. Ihr habt mir doch gestern von diesem Mann erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030202
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030202,
					"content": "Tja, um ehrlich zu sein, hat der Rat für Allgemeine Angelegenheiten während des Laternenrituals viel um die Ohren. Da kommt einfach niemand dazu, sich um den Fall zu kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030203
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030203,
					"content": "Oh, aber was wäre, wenn ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030204,
					"content": "Ich will ja nicht unhöflich sein. Aber ihr scheint euch ja wirklich ernsthaft Sorgen zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030205
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030205,
					"content": "Vielleicht könnt ihr der einen Truppe helfen, die ihren letzten Auftrag für heute ausführt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030206
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 400030206,
					"content": "Sie ist auf der Guili-Ebene und kümmert sich um die Monster dort. Wenn ihr sie findet, könntet ihr ihnen ja zur Hand gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
		{
			"id": 4000304,
			"completionStepIds": [
				4000304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
