				"points": []
			},
			"dialogs": [
				{
					"id": 400030901,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030902,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030903
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030903,
					"content": "#{NICKNAME}, was jetzt? Mit dem scheint man nicht wirklich reden zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030904,
					"content": "Johoho, der scheint keine guten Absichten zu haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030905,
					"content": "Du solltest nicht einfach so nach Gefühl über jemanden urteilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030906
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030906,
					"content": "Aber es stimmt schon, ich bin ein Dämon namens Xiao. Man nennt mich den schützenden Yaksha, weil ich böse Geister und Ungeheuer vertreibe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030907
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030908,
					"content": "Davon hat Paimon vor ein paar Tagen doch erst gehört.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030910
					]
				},
				{
					"id": 400030909,
					"content": "Paimon, du weißt, was ein „Yaksha“ ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030910
					]
				},
				{
					"id": 400030907,
					"content": "Den schützenden Yaksha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030908,
						400030909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030910,
					"content": "Aber ja, jemand in Liyue hat doch gesagt, dass ... dass der Yaksha ein Adept ist, der Liyue beschützt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030911,
					"content": "Im Dunkeln beschützt er die Welt der Sterblichen, damit diese nicht von Monstern heimgesucht werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030912,
					"content": "Das klingt doch nach der Definition eines guten Wesens!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030913,
					"content": "Nein, der Schutz des Yaksha ist nicht auf die Menschheit gerichtet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030914
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030914,
					"content": "Aber das Laternenritual dreht sich doch um große Helden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030915,
					"content": "Da lebt mal einer der Helden, derer man in Liyue gedenkt, noch und dann vergisst er auch noch, worum es in seinem eigenen Fest geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030916,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030917
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030917,
					"content": "Ähm, Herr Xiao ... Adept Xiao ...? Warum habt Ihr den Verdächtigen nicht einfach dingfest gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030918,
					"content": "Ich dachte erst, es ginge um ein böses Ungeheuer. Deswegen bin ich überhaupt erst gekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030919
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030919,
					"content": "Wenn ein magisches Wesen seine Fesseln sprengt, bin ich dafür verantwortlich, sie ihm wieder anzulegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030920
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030920,
					"content": "#Dieses Mal kommt die Bedrohung aber aus der Mitte der Menschen. Es ist also nun deine Pflicht, Reisende{M#r}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030921
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030921,
					"content": "Wenn es nötig wird, solltest du dich nicht zurückhalten. Alles Mittel sind recht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030922
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030922,
					"content": "Du darfst nicht zulassen, dass das Blut von Sterblichen an der Waffe eines Monsters klebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030923
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030923,
					"content": "Das ist doch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400030925,
					"content": "Erkennst du es, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030926
					]
				},
				{
					"id": 400030924,
					"content": "Dieses Zeichen hat dieser Mann zurückgelassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030925
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 400030926,
