			"dialogs": [
				{
					"id": 150450601,
					"content": "Oh, das sieht toll aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450602
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450602,
					"content": "Leute, hierher! Wir machen zusammen ein Foto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450603
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450603,
					"content": "Nicht schlecht, nicht schlecht! Ihr seht alle total energiegeladen aus – keine Spur von verstrubbelten Haaren oder müden Augen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450604
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450604,
					"content": "Oha, du achtest sogar auf so etwas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450605,
					"content": "Was wäre ich denn für eine Reiseführerin, wenn ich nicht auf die Details achten würde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450606
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450606,
					"content": "Ja, und was wäre ich für ein Barde, wenn ich einen guten Drink nicht zu schätzen wüsste?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450607,
					"content": "... Was hat das mit irgendetwas zu tun!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450608,
					"content": "Haha! Irgendwie weiß ich aber genau, was er meint!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450609
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450609,
					"content": "Es ist das Privileg von Freundschaft, Blödsinn zu reden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450610
					]
				},
				{
					"id": 150450610,
					"content": "Bist du sicher, dass das eine gute Idee ist? Oder spielst du nur mit, um auch den Straßenmusikanten bei Laune zu halten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450611,
					"content": "He, ein bisschen Blödsinn kann nicht schaden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450612
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450612,
					"content": "Hier, zieh dieses Asha-Stirnband an. Ein Andenken an den Rest von uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450613
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450613,
					"content": "Danke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450614
					]
				},
				{
					"id": 150450614,
					"content": "Das steht dir sehr gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450615
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450615,
					"content": "Gut, also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450616
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450616,
					"content": "Drei, zwei, eins ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450617
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450617,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450618,
					"content": "Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450619
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450619,
					"content": "... Tut Paimon leid, dieser ganze Unsinn hat Paimons Kopf durcheinander gebracht. Paimons Verstand ist völlig leer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450620,
					"content": "Du kannst die Trennung nicht ertragen, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450621
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450621,
					"content": "Oder hast du Angst, dass der ganze Urlaub vorbei ist, wenn du es einmal gesagt hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450622
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450622,
					"content": "Wie?! ... Paimon dachte, du hättest gesagt, die Friedensstifter könnten keine Gedanken lesen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450623,
					"content": "Haha, Paimon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450624
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450624,
					"content": "Keine Sorge, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450625
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450625,
					"content": "Der Sommer wird sicher wiederkommen – wie du gesagt hast, als du dem Pyro-Archon diesen Wunsch geäußert hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450626
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450626,
					"content": "Auch wenn wir alle getrennte Wege gehen werden, so weiß ich doch, dass sich unsere Wege wieder kreuzen werden, solange wir unsere Freundschaft pflegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450627
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450627,
					"content": "Bennett wird ein guter Redner, nicht wahr, Herr Venti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450628
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450628,
					"content": "Na ja, ich werde nicht sagen, dass das mein Verdienst ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450629
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450629,
					"content": "Warum klingst du dann so selbstgefällig? Ach was, Paimon war gerade dabei, sich inspiriert zu fühlen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450630,
					"content": "Sollen wir es nochmal versuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450631
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450631,
					"content": "Ja, lasst es uns dieses Mal gemeinsam tun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450632
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450632,
					"content": "Was sollen wir rufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450633
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450633,
					"content": "Glücksstern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450634
					]
				},
				{
					"id": 150450634,
					"content": "Hört sich gut an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450635,
					"content": "Drei, zwei, eins ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450636
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450636,
					"content": "Glücksstern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450641
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450641,
					"content": "Du hast eine tolle Zeit mit deinen Freunden ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150450642
					]
				},
				{
					"id": 150450642,
					"content": "... Was sind deine Pläne für die Zukunft, Bennett?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450643
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450643,
					"content": "Wenn du dich nicht entscheiden kannst, kannst du jederzeit zu den Menschen der Quellen kommen. Du kannst so lange bleiben, wie du willst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450644
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450644,
					"content": "Danke für das freundliche Angebot, Mualani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450645
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450645,
					"content": "Ich habe früher den Pyro-Archon aufgesucht, um ihr zu sagen, wie dankbar ich ihr für alles bin, was sie für mich getan hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450646
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450646,
					"content": "Sie sagte mir, dass die Sphäre, die wir betraten, eine Abgrund-Simulation von Mare Jivari war. Sie war extrem instabil, und jetzt ist sie völlig verschwunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450647
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450647,
					"content": "Später, als wir über meine Zukunft sprachen, sagte der Archon, ich könne gerne hier in Natlan bleiben ... aber auch, dass sie meine Entscheidung respektieren würde, wie auch immer sie ausfallen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450648
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450648,
					"content": "Ich habe lange darüber nachgedacht ... und mich entschlossen, nach Mondstadt zurückzukehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450649
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450649,
					"content": "Du vermisst deine Väter, stimmt’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450650
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450650,
					"content": "Das ist sicherlich einer meiner Gründe. Ich habe versprochen, ihnen alles zu erzählen, was bei diesem Abenteuer passiert ist, also kann ich mein Wort nicht brechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450651
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450651,
					"content": "Außerdem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450652
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450652,
					"content": "Als ich mich von meiner Mutter und meinem Vater verabschiedete, versprach ich ihnen, dass ich eines Tages der legendärste Abenteurer in ganz Teyvat werden würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450653
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450653,
					"content": "Und wer hat schon einmal von einem Abenteurer gehört, der sein ganzes Leben lang an einem Ort geblieben ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450654
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450654,
					"content": "Bennett ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450655
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450655,
					"content": "Was ist, wenn es mit deinem Glück wieder bergab geht, wenn du Natlan verlässt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450656
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450656,
					"content": "Haha, kein Problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450657
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450657,
					"content": "Die Wärme und Freundlichkeit, die ich bei diesem Abenteuer erfahren habe, werden ausreichen, um all die Herausforderungen zu meistern, die vor mir liegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450658
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450658,
					"content": "Ich bin nicht nur entschlossen, mein eigenes Schicksal zu gestalten, sondern möchte auch all die Wärme weitergeben, die mir meine Familie und Freunde entgegengebracht haben. Das ist etwas, woran ich immer geglaubt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450659
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450659,
					"content": "Hört, hört! Auf unseren Anführer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450660
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450660,
					"content": "Auf unseren Anführer Bennett!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450661
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450661,
					"content": "Prost!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450662
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450662,
					"content": "Uuh ... Das wird wieder eine lange Nacht, nicht wahr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450663
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450663,
					"content": "Hehe! Das macht so viel Spaß! Wer wird als Nächstes auftreten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450664
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450664,
					"content": "Bennett ist jetzt schon mehrmals fast eingeschlafen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450665
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450665,
					"content": "Nein, nein ... Ich kann immer noch ... weitermachen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450666
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450666,
					"content": "Ruht euch jetzt etwas aus, Leute. Und da du noch so viel Energie hast, überlasse ich dir das Aufräumen, Mualani ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450667
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450667,
					"content": "Hm? Warum ich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450668
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450668,
					"content": "#{NICKNAME}, vielleicht kannst du mich auf einen Spaziergang begleiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450669
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450669,
					"content": "Ich kenne eine tolle Stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1504507,
			"completionStepIds": [
				1504507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1504507",
							"2"
						],
						"stepId": 1504507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							984.35,
							298.017,
							14628.56
						],
						"pointId": 11712
					}
				]
			},
			"dialogs": [
				{
					"id": 150450701,
					"content": "Du bist vielleicht nicht so gut in Musik, aber du bist sicher gut darin, schöne Orte zu finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450702,
					"content": "Haha, schön, dass es dir gefällt. Manche Geschichten sind nicht für die Vögel bestimmt – nur für die Sterne hoch oben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450703,
					"content": "Zeit für eine Gutenachtgeschichte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450704
					]
				},
				{
					"id": 150450704,
					"content": "Haha ... Eher eine Geschichte, die mit der „Zeit“ selbst beginnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450705,
					"content": "Vor vielen, vielen Jahren begann die „Ze{RUBY#[D]Istaroth}it“, die Geschichte dieser Welt zu schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450706,
					"content": "Für sie waren alle Lebewesen gleich, sowohl in ihrem Wert als auch in ihrer Unbedeutsamkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450707,
					"content": "Wie eine uralte Schriftrolle hat sie alle Menschen, alle Ereignisse, alle Begegnungen und alle Abschiede in ihr Gedächtnis eingeprägt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450708
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450708,
					"content": "Damals, als Anemo-Geist, hatte ich eine zufällige Begegnung mit „Zeit“ im Tempel der Tausend Winde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450709
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450709,
					"content": "Als sie meine Wünsche hörte, vertraute sie mir einen Teil ihrer Macht und Autorität an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450710,
						150450711
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450710,
					"content": "Der Wind hat die Samen herbeigeweht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450712
					]
				},
				{
					"id": 150450712,
					"content": "Es klingt, als hättest du die Geschichte von „Zeit und Wind“ schon einmal gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450713
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450713,
					"content": "Charmant, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450714,
					"content": "Durch die Erinnerungen, die in Ritualen, Gedichten, Ruinen und alten Texten eingraviert sind, sind diese Wesen, die sie für so unbedeutend hielt, ihr begegnet ... immer und immer wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450715
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450715,
					"content": "Das ist also die Geschichte, die du erzählen wolltest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450716,
					"content": "Ähm ... Eher wie der Prolog.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450717
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450717,
					"content": "Die Verschmutzung des Mare Jivari ist mit der Zeit selbst verbunden. Anders ausgedrückt: Es ist ein Unglück, das in jedem Moment, der jemals sein wird, präsent ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450718
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450718,
					"content": "Im Gegensatz zur „Zeit“ selbst habe ich immer viele Wünsche in meinem Herzen gehabt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450719,
					"content": "Um zu verhindern, dass sich die Verschmutzung des Mare Jivari über Tenochtzitoc hinaus ausbreitet, habe ich es vor fünfhundert Jahren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450720
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450720,
					"content": "... von der Zeitlinie weggeblasen und in das „Land ohne Wind“ verwandelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450721
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450721,
					"content": "Das ist also die Wahrheit über das Verschwinden des Mare Jivari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450722
					]
				},
				{
					"id": 150450722,
					"content": "Ups, da habe ich dich wohl etwas verwirrt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450723
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450723,
					"content": "Wenn du wissen willst, wie das Mare Jivari vor zwei oder drei Jahrzehnten aus Tenochtzitoc verschwunden ist, gibt es vielleicht jemand anderen, der diese Geschichte besser erzählen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450724
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450724,
					"content": "Das Mare Jivari beherbergt zu viele Geschichten, die nicht nur seine eigenen hätten sein sollen ... Ich habe lediglich eine Rolle in einem Kapitel davon gespielt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450725
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450725,
					"content": "Und die Entscheidung, die ich vor fünfhundert Jahren getroffen habe, hatte ihren Preis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450726
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450726,
					"content": "Einige Seelen konnten deshalb nicht nach Mondstadt zurückkehren ... andere blieben und ließen sich in diesem Land nieder und verschmolzen mit den Monetoo zu den Asha, die wir heute sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450727
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450727,
					"content": "Der Grund, warum du hier in Tenochtzitoc bist, ist also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450728,
					"content": "Richtig. Ich bin hier, um mit dem derzeitigen Pyro-Archon, Mavuika, zusammenzuarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450729,
					"content": "Du meinst, als wir die Kerze angezündet haben ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450730
					]
				},
				{
					"id": 150450730,
					"content": "Wieder richtig. Die Flamme war unser Signal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450731
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450731,
					"content": "Nur als Mavuika einen Spalt zwischen diesem Raum und der wahren Mare Jivari öffnete, konnte ich hoffen, dass ich mich hineinschleichen konnte. Das war die einzige Möglichkeit, all die Seelen zurückzubringen, die zurückkehren wollten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450732
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450732,
					"content": "Was meinen kleinen Trick angeht, auch Erinnerungen zu wecken ... Ehehe, wie du weißt, ist das nicht das erste Mal, dass ich das geschafft habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450733,
					"content": "Mavuika hat auch erwähnt, dass du helfen wolltest, indem du uns vorstellst ... Sieht aus, als wäre ich dir zuvorgekommen, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450734
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450734,
					"content": "Ich war froh, als ich feststellte, dass auch sie meine Liebe zu gutem Wein und zur Freiheit teilt. Wir haben uns blendend verstanden, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450735,
						150450736
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450735,
					"content": "Diesmal hast du dich selbst übertroffen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450737
					]
				},
				{
					"id": 150450737,
					"content": "Nun, ich war in den letzten Tagen wirklich müde ... So müde, dass ich fast wieder ohnmächtig geworden wäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450738
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450738,
					"content": "Oh, wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450739,
					"content": "Aber der Gedanke an all den nicht getrunkenen Aphimead und Löwenzahnschnaps hat mich überzeugt, noch ein wenig länger durchzuhalten.",
					"roleType": "TALK_ROLE_NPC",
