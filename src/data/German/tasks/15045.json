				]
			},
			"dialogs": [
				{
					"id": 150450401,
					"content": "#Morgen, {NICKNAME} und Paimon! Ratet mal, wer ... Ich bin’s nur und meine Kugelfisch-Bälle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450402,
					"content": "Guten Morgen, Mualani! Wie kannst du nur so voller Energie sein? Warst du nicht diejenige, die gestern Abend am meisten gefeiert hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450403,
					"content": "Das war gestern Abend! Alles, was ich brauche, ist eine gute Nachtruhe, und ich bin so gut wie neu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450404,
					"content": "Hier, nimm das. Das ist dein Preis für die Fertigstellung des Albums – ich habe deinen auch abgeholt, um dir den Weg zu ersparen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450405
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450405,
					"content": "Oh, wie nett von dir, Mualani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450406,
					"content": "Eine gute Reiseführerin denkt immer voraus und hilft, wo immer sie kann, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450407
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450407,
					"content": "Ich sage es nur ungern, aber da wir gerade von der Arbeit sprechen – ich schätze, unser Urlaub ist jetzt fast vorbei ... Außerdem fürchte ich, wenn ich nicht bald zurückkomme, weiß mein kleines Hündchen nicht mehr, wer ich bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450408
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450408,
					"content": "Als ich mit den anderen spreche, scheint es, als hätten sie alle ihre eigenen Gründe, zurückzukehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450409,
					"content": "Einige haben gesagt, sie vermissen ihre Familien, andere den Geschmack von Löwenzahnschnaps ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450410
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450410,
					"content": "Selbst Chasca scheint es zu spüren. Nicht, dass sie es wirklich gesagt hätte, aber am Abend würde sie in den Baumkronen sitzen und zum Blumenfeder-Klan zurückblicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450411
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450411,
					"content": "Kann ich verstehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450412
					]
				},
				{
					"id": 150450412,
					"content": "Aber der Sommer ist noch nicht vorbei! Also sage ich ... wir quetschen noch ein paar unvergessliche Momente in die Zeit, die uns noch bleibt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450413
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450413,
					"content": "Wie ein weiteres Gruppenfoto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450414
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450414,
					"content": "He, wie wär’s, wenn du gleich hier eins machst? Nach all der Zeit ist Paimon dieser Ort irgendwie ans Herz gewachsen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450415,
					"content": "Tolle Idee! Warum verschönerst du nicht diese Wand, und ich hole die anderen?! Wir sehen uns drüben auf dem Platz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
		{
