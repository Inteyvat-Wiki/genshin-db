			"dialogs": [
				{
					"id": 761840301,
					"content": "Gar nicht mal so schlecht, diese Teegesellschaften, alles in allem. Wenn ich gewusst hätte, dass sie so viel Spaß machen, wäre ich schon früher dazugestoßen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840302,
						761840303
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 761840302,
					"content": "(Lass uns noch ein Weilchen so sitzen bleiben.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				},
				{
					"id": 761840304,
					"content": "Also gut, bis zum nächsten Mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 761840303,
					"content": "Ich glaube, es wird Zeit, dass ich mit dem Aufräumen anfange.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				}
			]
		}
	]
