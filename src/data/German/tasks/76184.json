			"dialogs": [
				{
					"id": 761840101,
					"content": "Na, das ist ja mal eine Überraschung. Ich hätte nie gedacht, dass ich den Tag noch erlebe, an dem du mich zu einer deiner Teegesellschaften einlädst, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840102
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 761840102,
					"content": "Vielleicht hätte ich dich schon früher eingeladen, wenn du an deinen Manieren gearbeitet hättest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840103,
					"content": "Da stimme ich zu. Es würde dir vielleicht auch helfen, wenn du aufhören würdest, ständig Leute zu Duellen herauszufordern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840104
					],
					"speakerTitle": "„Arlecchino“"
				},
				{
					"id": 761840104,
					"content": "Du klingst genau wie meine großen Brüder und Schwestern. Ich kann nichts dafür. Damals, als mein Meister mich in der Wildnis ausgebildet hat, stand Etikette nicht gerade an erster Stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840105
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 761840105,
					"content": "Egal. Es kommt nicht oft vor, dass wir alle zusammen sind. Lasst uns einfach entspannen und den Moment genießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840106,
					"content": "Hmm? Ist das deine neueste Erfindung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840107
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 761840107,
					"content": "Ihr Name ist Fagio. Sie ist eine Facilitatrice Automatisé Généraliste Interactif et Omnitâche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840108,
					"content": "Heißt das, dass Pulonia wirklich nicht mehr zu reparieren ist ...? Tut mir leid, das zu hören, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840109
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 761840109,
					"content": "Schon gut, ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840110,
					"content": "... Es tut mir leid zu hören, dass ich nie die Chance haben werde, gegen ihn zu kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840111
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 761840111,
					"content": "War ja klar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840112,
					"content": "Pulonia sah stark aus, aber diese „Fagio“ hingegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840113
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 761840113,
					"content": "... Wolltest du gerade sagen, dass sie schwach aussieht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840114,
					"content": "Ähm ... Haha, nein, nein. Es ist nur so, dass sie nicht ganz so stark aussieht wie Pulonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840115
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 761840115,
					"content": "Hmph. Pulonia wurde für Messungen und Berechnungen gebaut. Ich habe darauf geachtet, seine Rechenleistung nicht einzuschränken, als ich ihm Kampffähigkeiten gegeben habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840116,
					"content": "Aber Fagio muss keine komplizierten Formeln verarbeiten. Ihre gesamte Rechenleistung kann für ihr Kampfmodul genutzt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840117
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840117,
					"content": "Also ... Heißt das, sie ist wirklich stärker als Pulonia? Ist das überhaupt möglich ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840118
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 761840118,
					"content": "Ohne eine Demonstration gibst du dich wohl wirklich nicht zufrieden, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840119,
					"content": "Nur damit wir uns verstehen, ich zahle nicht für Reparaturen, wenn ich sie kaputt mache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840120
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 761840120,
					"content": "Und ich bezahle deine Krankenhausrechnung nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840121
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 761840121,
					"content": "(*Seufz* ... Ich wusste, dass das passiert.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840122
					],
					"speakerTitle": "„Arlecchino“"
				},
				{
					"id": 761840122,
					"content": "(*mampf* ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		},
