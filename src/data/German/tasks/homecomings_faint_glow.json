			"dialogs": [
				{
					"id": 760300501,
					"content": "*wimmer* ... Hmm? Was ist das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300502
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300502,
					"content": "Das ist ... so schön ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300503
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300503,
					"content": "So sollte es gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300504
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760300504,
					"content": "Und fort ist sie! Sie sammelt unterwegs die ganzen Steine auf. Das sollte sie in Richtung der Enklave des Frostmonds führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300505,
					"content": "(Columbina ... sagt zwar, sie will nicht als Göttin behandelt werden, aber sie hilft dennoch denen in Not ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300506
					]
				},
				{
					"id": 760300506,
					"content": "Ah, aber was das Bild anbelangt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300507,
					"content": "Ist schon in Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300508
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760300508,
					"content": "Ein unvollständiges Bild kann immer noch vollendet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300509
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760300509,
					"content": "Ich sehe gern dabei zu, wie Menschen ihren Weg zurück nach Hause finden, zu dem Ort, an den sie gehören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		}
