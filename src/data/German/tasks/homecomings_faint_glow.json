			},
			"dialogs": [
				{
					"id": 760300301,
					"content": "Das sollte genügen. Es fühlt sich so an, als hätten wir schon ganz schön viel gesammelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300302,
					"content": "Gehen wir. Wir können das Gemälde nicht unvollendet lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300303,
					"content": "*wimmer* ... *wimmer* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300304
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300304,
					"content": "Aaah! Schnell, verstecken wir uns! Da kommt jemand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300305,
					"content": "*wimmer* ... Wo bin ich ...? Mama ... ich will nach Hause ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300306
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300306,
					"content": "Sieht aus wie eine von den Nachkommen des Frostmonds. Hat sie sich verlaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300307,
					"content": "Ich werde ihr helfen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300308
					]
				},
				{
					"id": 760300308,
					"content": "Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300309
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760300309,
					"content": "Hä? Sie braucht doch auf jeden Fall Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300310,
					"content": "Aber soviel ich weiß, sind Nachkommen des Frostmonds sehr misstrauisch gegenüber Fremdlingen. Du hast kein Geweih und es ist spät, also wenn sie vor Schreck wegrennt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300311
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760300311,
					"content": "D... Das kann schon sein, aber wir können nicht einfach tatenlos dabei zusehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300312,
					"content": "Hmm ... Kommt mit mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300313
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760300313,
					"content": "Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
