			"dialogs": [
				{
					"id": 760300101,
					"content": "Hmm. Die Atmosphäre ist heute etwas ungewöhnlich. Dekorierst du hier das Blumenfeld, Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300102,
					"content": "Nicht ich. Sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300103
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760300103,
					"content": "Du meinst ... die Kuuhenki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300104,
					"content": "Ja. Diese Steine leuchten auf, wenn sie Kuuvahki absorbiert haben. Sie gefallen den Kuuhenki sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300105
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760300105,
					"content": "Also ... legen sie die Steine auf den Boden und spielen damit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300106,
					"content": "Nicht wirklich. Kommt mal her und schaut euch das an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300107
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760300107,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300108,
					"content": "Oh! Von Weitem sieht es also aus wie ein Bild!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300109,
					"content": "Aber da fehlt etwas ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300110
					]
				},
				{
					"id": 760300110,
					"content": "Genau. Ich werde mehr sammeln gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300111
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760300111,
					"content": "Ach? Du gehst sie sammeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300112,
					"content": "Ja. Ich kenne einen guten Ort, an dem das Mondlicht scheint und es viele dieser Steine gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300113
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760300113,
					"content": "Möchtest du, dass wir mitkommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300114
					]
				},
				{
					"id": 760300114,
					"content": "Na klar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300115
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760300115,
					"content": "Also gut, holen wir also noch ein paar mehr. Wir wollen auch das vollständige Bild sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
