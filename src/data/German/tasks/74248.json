			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Columbina“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742480201,
					"content": "Dieses Spiel namens „Spielbrett-Truppe“ macht wirklich ziemlich viel Spaß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480202,
						742480203
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 742480202,
					"content": "(Lass uns noch ein Weilchen so sitzen bleiben.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480204,
					"content": "Ja. Ich glaube, der große, böse Vampir sollte sich auch auf den Heimweg machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 742480203,
					"content": "Ich glaube, es wird Zeit, dass ich mit dem Aufräumen anfange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
}