					}
				]
			},
			"dialogs": [
				{
					"id": 742480101,
					"content": "Fräulein Columbina, Fräulein Sandrone! Danke, dass ihr euch die Zeit nehmt, unserer Spielbrett-Truppe beizutreten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480102
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480102,
					"content": "Das Vergnügen ist ganz unsererseits. Wir haben das vorher noch nie wirklich gespielt, also zählen wir auf euch, dass ihr uns zeigt, wie es geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480103,
					"content": "Keine Sorge, macht euch keinen Druck. Das Wichtigste ist, dass alle Spaß haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480104
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480104,
					"content": "Das ist super! Ich freue mich wirklich sehr darauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480105
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 742480105,
					"content": "Dann lasst mich kurz die Geschichte erklären ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480106
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480106,
					"content": "„Dies ist ein Zeitalter, in dem Vampire und Menschen zusammenleben. Unsere Geschichte spielt in einer Stadt, die sich die beiden Völker teilen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480107
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Gespielt von Clorinde"
				},
				{
					"id": 742480107,
					"content": "„Die Beziehung zwischen Menschen und Vampiren ist zwar nicht offen feindselig, aber alles andere als harmonisch. Nun hat ein Mord mitten in der Nacht das empfindliche Gleichgewicht völlig zerstört ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480108
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Gespielt von Clorinde"
				},
				{
					"id": 742480108,
					"content": "Vampire?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480109
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 742480109,
					"content": "Sie sind ein Volk, das menschliches Blut trinkt, um zu überleben. Sie kommen häufig in Fantasy-Romanen vor. Hast du schon einmal solche Geschichten gelesen, Fräulein Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480110
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480110,
					"content": "Hmm, ich glaube, davon habe ich schon mal gehört. Und was machen wir in dieser Geschichte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480111
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 742480111,
					"content": "Zuerst muss jeder entscheiden, welchen Charakter er spielen möchte. Ihr könnt euch jede beliebige Identität und jeden Beruf aussuchen, solange es zum Setting passt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480112,
					"content": "Welcher Charakter möchte ich sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480113
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 742480113,
					"content": "Wenn du dich nicht entscheiden kannst, kannst du dich mit jemand anderem zusammentun und dir von dieser Person einen Charakter ausdenken lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480114,
					"content": "Oh? Du meinst ... wir können unsere Hintergrundgeschichten von jemand anderem erstellen lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480115,
					"content": "Oh, das klingt nach Spaß! Machen wir das alle so! Ich überlasse dir meinen Charakterbogen, Clorinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480116
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480116,
					"content": "Dann kannst du meinen Charakter bestimmen, Sandrone, und ich überlege mir die perfekte Rolle für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480117
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 742480117,
					"content": "Hah ... Na gut. Ich habe ohnehin noch keine wirkliche Idee für meinen Beruf in der Geschichte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480118,
					"content": "Seid ihr alle fertig? Hehe, ich kann es kaum erwarten zu sehen, was bei mir steht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480119
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480119,
					"content": "„Ich bin eine Händlerin, die ihre Waren in einer Stadt verkauft, in der Vampire und Menschen zusammenleben ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480120
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Reisende Händlerin"
				},
				{
					"id": 742480120,
					"content": "... Moment mal. Spielleiterin, dieser Charakterbogen ist meinem letzten verdächtig ähnlich ... Sogar die Werte sind gleich! Du hast einfach alles kopiert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480121
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480121,
					"content": "Egal, was ich dir gebe, du findest immer einen seltsamen Weg, die Geschichte aus dem Ruder laufen zu lassen. Außerdem finde ich, dass so ein gerissener, lauter Charakter perfekt zu dir passt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480122
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480122,
					"content": "... He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480123,
					"content": "Haha. Mal sehen, wer ich bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480124
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 742480124,
					"content": "„Ich bin ein großer, böser Vampir. Tagsüber schlafe ich gerne zu Hause und gehe nur nachts nach draußen, um im Garten spazieren zu gehen, wenn der Mond scheint.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480125
					],
					"speakerTitle": "„Columbina“",
					"speakerSubtitle": "Bitterböser Vampir"
				},
				{
					"id": 742480125,
					"content": "„Ich singe gern und nutze meine Stimme, um meine Beute anzulocken. Niemand, der mir in die Augen gesehen hat, hat je den Sonnenaufgang erlebt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480126
					],
					"speakerTitle": "„Columbina“",
					"speakerSubtitle": "Bitterböser Vampir"
				},
				{
					"id": 742480126,
					"content": "Hmm ... Siehst du mich so, Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480127
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 742480127,
					"content": "Hehe, findest du nicht, dass es zu dir passt? Außerdem ist es ein faszinierender Charakter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480128
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480128,
					"content": "Na gut, aber ich möchte trotzdem mein Bestes geben, ein etwas ... gutherzigerer Vampir zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480129
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 742480129,
					"content": "Wie du meinst. Gut, schauen wir uns mal meins an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480130
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480130,
					"content": "„Ich bin eine elegante, edle Dame, die in ihrem Zimmer gerne an Erfindungen bastelt. Ich gehe sehr spät schlafen und habe einen sehr unregelmäßigen Tagesablauf ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480131
					],
					"speakerTitle": "Marionette",
					"speakerSubtitle": "Vampirjägerin"
				},
				{
					"id": 742480131,
					"content": "He! Welcher Mensch stellt sich denn so vor?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480132
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480132,
					"content": "Hmpf ... „Aber ich bin auch eine Vampirjägerin. Wenn jemand in der Stadt in Gefahr ist, benutze ich mutig meine Erfindungen, um ihn zu retten ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480133
					],
					"speakerTitle": "Marionette",
					"speakerSubtitle": "Vampirjägerin"
				},
				{
					"id": 742480133,
					"content": "... Häh? So bin ich doch überhaupt nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480134
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742480134,
					"content": "Findest du nicht? Ich finde, das passt ziemlich gut zu dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480135
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 742480135,
					"content": "Aber nach diesen Vorstellungen sieht es so aus, als müssten die Charaktere von Fräulein Columbina und Fräulein Sandrone Erzfeinde sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480136
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Reisende Händlerin"
				},
				{
					"id": 742480136,
					"content": "Hmm, es sieht ganz danach aus, als würde diese Geschichte noch einige faszinierende Wendungen bereithalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480137
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Gespielt von Clorinde"
				},
				{
					"id": 742480137,
					"content": "Oh! Ich kann es kaum erwarten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480138
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Reisende Händlerin"
				},
				{
					"id": 742480138,
					"content": "Hah ... Ich habe das Gefühl, dass diese Geschichte uns einiges an Kopfzerbrechen bereiten wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480139
					],
					"speakerTitle": "Marionette",
					"speakerSubtitle": "Vampirjägerin"
				},
				{
					"id": 742480139,
					"content": "Du machst dir Sorgen, wie das Ganze ausgeht, nicht wahr, Sandrone? Liegt es daran, dass ich ein böser, blutsaugender Vampir bin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480140
					],
					"speakerTitle": "„Columbina“",
					"speakerSubtitle": "Bitterböser Vampir"
				},
				{
					"id": 742480140,
					"content": "Hah! Das Einzige, worüber ich mir Sorgen mache, ist, die Chance zu verpassen, dir den Kopf zu waschen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette",
					"speakerSubtitle": "Vampirjägerin"
				}
			]
		},
		{
