			"dialogs": [
				{
					"id": 752710201,
					"content": "Ach, zum Glück habe ich dich heute getroffen! Bitte, mach mir diese Ballons hier rot.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
