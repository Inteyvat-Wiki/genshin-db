			"dialogs": [
				{
					"id": 752710101,
					"content": "Vorsicht, lass diese Ballons bitte nicht platzen. Wenn du selber welche möchtest, kann ich dir ein paar andere zum Spielen geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710102
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710102,
					"content": "Diese hier sind echt etwas Besonderes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710103
					]
				},
				{
					"id": 752710103,
					"content": "Es ist ein bisschen peinlich zu sagen ... aber das hier sind wichtige Requisiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710104
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710104,
					"content": "Wenn du sie dir ansiehst, hast du bestimmt schon eine Idee, wofür sie sind, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710105,
						752710107
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710105,
					"content": "... Einen Heiratsantrag?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710106
					]
				},
				{
					"id": 752710106,
					"content": "Na ja, eine Liebeserklärung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710109,
					"content": "Ich will sie inmitten dieser romantischen Ballons der lieben Yopoyi machen. Was meinst du dazu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710110
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710110,
					"content": "Du solltest am besten rote Ballons nehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710111
					]
				},
				{
					"id": 752710111,
					"content": "Hä? Da hast du echt recht ... Es fehlt mir doch ein bisschen das romantische Händchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710112
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710112,
					"content": "Nur leider kommt Yopoyi gleich schon ... wo soll ich jetzt noch rote Ballons herbekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710107,
					"content": "Eine Liebeserklärung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710108
					]
				},
				{
					"id": 752710108,
					"content": "J... Ja, genau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "Ziki"
				}
			]
		},
		{
			"id": 7527102,
