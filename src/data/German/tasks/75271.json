				"points": []
			},
			"dialogs": [
				{
					"id": 752710501,
					"content": "Danke dir, du gute Seele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710502
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710502,
					"content": "Hat dir Ziki Ärger gemacht? Der tickt ein bisschen anders als andere, aber genau das mag ich so an ihm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yopoyi"
				}
			]
		},
		{
