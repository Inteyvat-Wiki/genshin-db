			},
			"dialogs": [
				{
					"id": 752710601,
					"content": "Yopoyi! Da bist du ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710602
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710602,
					"content": "Ziki ...? Bist du das? Warum hast du dich denn so angezogen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710603
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710603,
					"content": "Das ist dein Lieblingskostüm der Nanasier ... Ich habe es mir extra ausgeliehen. Sieht gut aus, oder? Und schau mal, auch die Ballons sind extra für dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710604
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710604,
					"content": "Weißt du, es gibt da etwas, das ich dir schon ewig sagen wollte ... Willst du mit mir zusammen sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710605
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710605,
					"content": "B... Bist du verrückt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710606
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710606,
					"content": "Nein! Meine geliebte Yopoyi, bitte werd meine Freundin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710607
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710607,
					"content": "Bist du dir sicher, dass bei dir alles in Ordnung ist? Heute ist doch unser dritter Hochzeitstag!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710608
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710608,
					"content": "Klar, das weiß ich doch! Aber ... du hast immer gesagt, dass ich überhaupt nicht romantisch bin und dass ich dir vor der Hochzeit nie eine richtige Liebeserklärung gemacht habe ... Das hier ist also meine verspätete Liebeserklärung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710609
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710609,
					"content": "Ach so ... verstanden. Na gut, ich sage ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710610
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710610,
					"content": "Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710611
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710611,
					"content": "Ja! Ich sage ja, du romantischer kleiner Trottel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710612
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710612,
					"content": "Ein sanfter Wind legt sich um das Paar, das sich fest umarmt.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
