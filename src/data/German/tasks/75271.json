					"Ziki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752710301,
					"content": "Rote Ballons voller Romantik! Sie sind wunderschön ... Yopoyi wird sie bestimmt lieben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710302
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710302,
					"content": "Meinst du nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710303,
						752710304
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710303,
					"content": "Ähm ... schwer zu sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				},
				{
					"id": 752710305,
					"content": "Was auch immer, vielen lieben Dank! Bitte geh nicht gleich weg, ich möchte, dass Yopoyi dich kurz kennenlernt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710306
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710306,
					"content": "Wenn alles klappt, müsste sie gleich hier sein. Wir sind verabredet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710304,
					"content": "Klar doch, sie wird begeistert sein!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				}
			]
		},
		{
			"id": 7527104,
