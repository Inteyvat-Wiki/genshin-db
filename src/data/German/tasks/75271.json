					"nextDialogs": [
						752710402
					]
				},
				{
					"id": 752710402,
					"content": "Echt? Das wäre der Hammer! Tausend Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
				}
			]
		},
		{
