					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320906,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320902",
							"2"
						],
						"stepId": 7320902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090601,
					"content": "Wenn diese paar Rosen gesund aufwachsen, können wir in Zukunft ganz sicher noch mehr Goldrosen heranziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090602
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090602,
					"content": "Doch noch ist es nicht so weit. Zunächst einmal will ich diese Goldrosen hier aufblühen sehen, erst dann bin ich beruhigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320908",
							"2"
						],
						"stepId": 7320908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan",
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090701,
					"content": "Ich habe schon längst die Hoffnung verloren, doch am Ende wuchsen die Blumen trotzdem! Das Leben ist voller Wunder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090702
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090702,
					"content": "Kleines Mädchen, bist du immer noch traurig wegen Onkel Shafaqat? Nicht traurig sein, die Lebenden müssen mit den Träumen der Toten weiterleben, um ihnen gerecht zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090703
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090703,
					"content": "Herr Affan ... Ich bin kein Mädchen mehr. Vielleicht können die Kinder meiner Freunde, die mit mir aufgewachsen sind, schon Gewürze im Laden kaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090704
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090704,
					"content": "Aber trotzdem hast du recht. Solange wir am Leben sind, sollten wir unser Leben glücklich verbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
}