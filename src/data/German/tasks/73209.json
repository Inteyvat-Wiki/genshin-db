			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090301,
					"content": "„Rose, oh, Rose, mach meinen Wunsch wahr.“",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090302
					]
				},
				{
					"id": 732090302,
					"content": "„Die Blume erblüht aus den Steinen und die Goldrose bietet mir ein Lied dar.“",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7320904,
			"completionStepIds": [
				7320903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320903",
							"2"
						],
						"stepId": 7320903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah",
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090426,
					"content": "„Rose, oh, Rose, mach meinen Wunsch wahr.“",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090427
					]
				},
				{
					"id": 732090427,
					"content": "„Die Blume erblüht aus den Steinen und die Goldrose bietet mir ein Lied dar.“",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090401
					]
				},
				{
					"id": 732090401,
					"content": "Die goldenen Rosen sind wirklich sehr hübsch. Es macht Paimon glücklich, sie aufblühen zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090402,
					"content": "Paimon ist so froh, dass die ganze harte Arbeit der letzten Tage nicht umsonst war!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090403,
						732090404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090403,
					"content": "Endlich ist der Wunsch in Erfüllung gegangen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				},
				{
					"id": 732090405,
					"content": "Am Ende habe ich doch noch eine Sache richtig gut gemacht. Onkel Shafaqat, ich habe deinen Wunsch für dich wahr gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090406
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090406,
					"content": "Es ist nur schade, dass er das nicht sehen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090407
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090407,
					"content": "Sabbah, das stimmt so nicht, erinnerst du dich noch an die letzte Strophe des Lieds?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090408
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090408,
					"content": "„Kein Boden, der mich trägt, einzig das Lied will mich tragen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090409
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090409,
					"content": "„Das Lied besiegt mein grausames Schicksal, genauso wie mein Ende.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090410
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090410,
					"content": "„Es besiegt mich, es besiegt die Zeit, es besiegt das niemals vergehende Vergehen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090411
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090411,
					"content": "Onkel Shafaqats Leben, seine Goldrosen und das von ihm komponierte Lied sind immer noch bei uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090412
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090412,
					"content": "Hmm, das stimmt. Er ist jemand, der das Vergehen besiegt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090413
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090413,
					"content": "Danke, dass ihr mir von Shafaqat erzählt habt. Das ist sehr wichtig für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090414
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090414,
					"content": "Er wurde vor mir hierher verbannt und wenn ich mir die Spuren seines Lebens ansehe, kommt es mir vor, als würde ich eine Zeitreise machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090415
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090415,
					"content": "Als ob ich nicht nur Shafaqat, sondern auch mich selbst sehen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090416
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090416,
					"content": "Auch wenn ich nicht direkt mit ihm sprechen kann, kann ich sein Reuegefühl auf mich nehmend weiterleben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090417
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090417,
					"content": "Wenn es mir gelingt, für ihn und für mich selbst weiterzuleben, dann werde ich mich am Ende bestimmt selbst erlösen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090418,
						732090419
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090418,
					"content": "Ich hoffe, dass du glücklich sein wirst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090420,
					"content": "Ich finde das Leben hier gar nicht mehr so schlimm. Ich habe mich wirklich gefreut, euch zu treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090421
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090421,
					"content": "Rosen sind in der Tat Blumen, mit denen man andere glücklich machen kann. Herr Affan, wir müssen in Zukunft noch mehr von ihnen anpflanzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090422
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090422,
					"content": "Hahaha, abgemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090423
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090423,
					"content": "Sehr gut, ich werde mein Bestes geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090419,
					"content": "Kopf hoch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090420
					]
				},
				{
					"id": 732090404,
					"content": "Es war das Ganze wirklich wert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090405
					]
				}
			]
		},
		{
