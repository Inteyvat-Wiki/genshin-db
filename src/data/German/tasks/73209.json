			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090101,
					"content": "Ah, ihr seid es. Die Rosen und wir haben schon auf euch gewartet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090102,
					"content": "Sabbah, du bist ja auch schon da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090103,
					"content": "Ich komme in letzter Zeit oft hierher und habe mir schon alle Notizen durchgelesen, die Herr Shafaqat hinterlassen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090104
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090104,
					"content": "Früher habe ich immer gedacht, dass das Leben im Aaru-Dorf sehr einsam wäre, doch nun sehe ich das anders.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090105
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090105,
					"content": "Wenigstens bin ich nicht völlig alleine und ich habe diese Rosen und die Erinnerungen an die Zeit mit euch und Herrn Affan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090106
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090106,
					"content": "Es gibt noch einige schöne Dinge in meinem Leben und deswegen fühle ich mich nicht mehr ganz so einsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090107
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090107,
					"content": "Ich habe mich mit Herrn Affan darauf geeignet, dass wir uns von nun an gemeinsam um die Rosen kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090108
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090108,
					"content": "Wir wollen immer mehr von ihnen aufziehen und die ganze Baumschule mit ihnen füllen. Für den Moment sollten wir aber zunächst dafür sorgen, dass diese paar hier erblühen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090109
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090109,
					"content": "Erinnerst du dich noch daran, wie du vorher meine Sumeru-Rosen zum Blühen gebracht hast? Nutze einfach dieselbe Methode, das sollte funktionieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090110
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090110,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090111
					]
				},
				{
					"id": 732090111,
					"content": "Leg los, alles hängt von dir ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
