			"dialogs": [
				{
					"id": 200380201,
					"content": "Hast du die Statuen der Sieben vom Schmutz befreit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380202
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380202,
					"content": "Ich bin noch nicht ganz fertig damit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380203
					]
				},
				{
					"id": 200380203,
					"content": "Ach so. Es hat ja keine Eile.",
