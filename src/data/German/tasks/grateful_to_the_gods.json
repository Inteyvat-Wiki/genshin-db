			"dialogs": [
				{
					"id": 200380301,
					"content": "Hast du die Statuen der Sieben vom Schmutz befreit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380302
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380302,
					"content": "Ja, das habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380303
					]
				},
				{
					"id": 200380303,
					"content": "Dann danke ich dir vielmals! Möge Barbatos dich segnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380304
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380304,
					"content": "Hier, das ist ein Geschenk für dich. Später brauche ich deine Hilfe vielleicht noch einmal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				}
			]
		}
