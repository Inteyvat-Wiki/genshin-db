				"objectNames": [
					"Jilliana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200380101,
					"content": "Hm, was ist denn mit dieser Statue der Sieben los ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380102
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380102,
					"content": "Was ist mit der Statue der Sieben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380103
					]
				},
				{
					"id": 200380103,
					"content": "Das ist folgendermaßen: Jede Woche gehe ich zu den Statuen der Sieben, um vor ihnen zu beten. Bei der Gelegenheit kehre ich gleich den ganzen Dreck weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380104
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380104,
					"content": "Dank der Gottheit habe ich jetzt ein glückliches Leben. Ich möchte einfach etwas Gutes für sie tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380105
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380105,
					"content": "Seit ich Lily habe, komme ich aber immer seltener raus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380106
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380106,
					"content": "Die Statuen müssen schon total verdreckt sein, weil niemand saubermacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380107
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380107,
					"content": "Es mag vielleicht klingen, als wollte ich meine Pflicht nur auf dich abwälzen. Aber glaubst du, du könntest mir dabei helfen, die Statuen der Sieben vom Dreck zu befreien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380109,
						200380110
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380109,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380111
					]
				},
				{
					"id": 200380111,
					"content": "Danke dir! Möge der Gott des Windes dich segnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380115,
					"content": "Eins noch: Die Statuen der Sieben besitzen die Kraft der Gottheiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380116
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380116,
					"content": "Um den Staub auf ihnen beseitigen zu können, brauchst du mehr als einen Handfeger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380117
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380117,
					"content": "Da du aber die elementaren Kräfte beherrschst, sollte das für dich kein Problem darstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380118
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380118,
					"content": "Nicht so wie ich ... Wenn ich einmal anfange, brauche ich den ganzen Tag dafür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380110,
					"content": "Kann der Wind nicht den ganzen Schmutz wegfegen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380112
					]
				},
				{
					"id": 200380112,
					"content": "Barbartos und seine Winde sind sicher jeden Tag sehr beschäftigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380113
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380113,
					"content": "Davon abgesehen können wir nicht alles von den Göttern machen lassen. Wir können uns nicht vor unseren Pflichten drücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380114
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380114,
					"content": "Lass uns zusammen Barbatos etwas Arbeit abnehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "Jilliana"
				}
			]
		},
