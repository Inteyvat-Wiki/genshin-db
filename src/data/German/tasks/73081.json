			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arakavi",
					"Arama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730810301,
					"content": "Es ist Arama und der goldene Nara. Du bist ganz schön groß. Aber neben dran der silberne ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810302
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810302,
					"content": "Hm? Was ist mit dem Silbernen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810303,
					"content": "Wie soll ich es sagen ... Du könntest dich in die Löcher von Bäumen quetschen, das wäre sehr praktisch! Großartig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810304
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810304,
					"content": "#So, nach den Gewohnheiten der Nara sollten wir einander erst einmal vorstellen. Das hier sind Nara {NICKNAME} und Paimon. Das ist Arakavi. Gebt euch die Hände!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810305
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810305,
					"content": "Irgendwie gibst du Arakavi die Hand ...\\nDu wagst es nicht, zu viel Kraft zu benutzen.\\nEine ungewöhnliche Berührung.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730810306
					]
				},
				{
					"id": 730810306,
					"content": "Echt interessant. Ich habe schon viel über die Nara gehört, aber das ist das erste Mal, dass ich den Körper eines Nara berührt habe. Es fühlt sich faszinierend an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810307
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810307,
					"content": "Wir hatten schon lange keine Nara mehr hier. Viele Setzlinge sind zu Bäumen herangewachsen. Viele Geschichten wurden zu Legenden. Es heißt, dass der letzte Nara sehr gut sei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810308
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810308,
					"content": "#Auch der Nara {NICKNAME} ist ein sehr guter Nara, tapfer und stark, wie ein junger Baum, der aus einer Steinmauer wächst. Und sie sind hier, um Arana zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810309
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810309,
					"content": "Oh ... Ich habe Arana schon so lange nicht mehr gesehen, ich hoffe, es ist alles in Ordnung. Und ich hoffe, auch bei den kleinen Nara im Dorf Vimara ist alles gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810310
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810310,
					"content": "Du kennst auch die Kinder von Vimara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810311
					]
				},
				{
					"id": 730810311,
					"content": "Natürlich kenne ich sie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810312
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810312,
					"content": "Wir alle kennen sie! Arana kam zurück und erzählte uns Geschichten über die kleinen Nara. Also sind Nara Iotham, Nara Bahram und Nara Rana unsere Freunde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810313
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810313,
					"content": "Paimon ist sich nicht sicher, ob das bedeutet, dass ihr sie wirklich kennt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810314,
					"content": "Was braucht es denn, damit man einander kennt? Musst man „sich vorstellen“ und „einander die Hand geben“, so wie es die Nara tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810315
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810315,
					"content": "Ja, ja, ich weiß, was Paimon meint. Und Nara müssen zusammen essen und gemeinsam „Schätze“ finden, erst dann kennen sie einander. Nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810316,
						730810317,
						730810318
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810316,
					"content": "So einfach ist das auch wieder nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810321,
					"content": "Solange wir die Geschichten des anderen kennen, kennen wir uns. Denn die Welt der Aranara ist ein Ort für Lieder und Träume.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810322
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810322,
					"content": "#Arakavi hat recht. Solange wir durch Lieder von Nara {NICKNAME} hören und durch Träume sehen, wie Nara {NICKNAME} aussieht, zählt es, dass wir dich kennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810323
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810323,
					"content": "Paimon denkt, das können wir vorerst beiseite lassen ... Denn wir sind bereits mit den Aranara befreundet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810324,
					"content": "Gute Freunde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810325,
						730810327
					],
					"speakerTitle": "Arama und Arakavi"
				},
				{
					"id": 730810325,
					"content": "Gute Freunde!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810328,
					"content": "Ja. Wir werden das Utsava-Fest feiern. Arakavi muss sich darauf vorbereiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810329,
					"content": "Das ist wahr. Es geht um die Bija, nicht wahr? Ich habe Arayasa, Aradasa und Arasudraka geschickt, um die „Halle des Ashvattha“ zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810330
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810330,
					"content": "Das ist wirklich ein gutes Gespür ... Aber warum weißt ihr nicht, wo die Halle des Ashvattha ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810331,
					"content": "Die Halle des Ashvattha ist ein sehr heiliger Ort und wir gehen normalerweise nicht dorthin. Lass den Vasara einfach ruhig weiterträumen. Bis sich alle Erinnerungen in Sarva treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810332
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810332,
					"content": "Der Wald vergisst nichts. All die guten Dinge lösen sich nicht einfach in Luft auf. Alle Schmerzen sind der Nährboden für gute Dinge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810333
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810333,
					"content": "In jedem Fall sind Arayasa, Aradasa und Arasudraka draußen, um Halle des Ashvattha zu suchen. Arama, geh und hilf ihnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810334
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810334,
					"content": "#Ja, ich werde hingehen. Wenn Nara {NICKNAME} und Paimon uns im Wald treffen, dann lasst uns gemeinsam ein Abenteuer erleben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810335
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810335,
					"content": "#Sehr gut, angenehm. Ich freue mich, euch kennenzulernen, Nara {NICKNAME} und Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810327,
					"content": "Lasst uns zur Sache kommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810317,
					"content": "Wie soll man es sagen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810318,
					"content": "Paimon und ich essen zusammen und suchen nach Schätzen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810319
					]
				},
				{
					"id": 730810319,
					"content": "Ja! Wir kennen uns nicht nur, sondern wir sind sogar beste Freunde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810320,
					"content": "#Nara {NICKNAME} und Paimon, wirklich toll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810321
					],
					"speakerTitle": "Arama"
				}
			]
		},
