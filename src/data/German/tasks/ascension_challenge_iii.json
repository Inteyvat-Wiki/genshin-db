			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Prinz“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706680201,
					"content": "#Miau! „Du bist wirklich {F#eine tolle Kartenbeschwörerin}{M#ein toller Kartenbeschwörer}! Herzlichen Glückwunsch zum Bestehen der Aufstiegsprüfung, jetzt bist du {F#eine wahre Expertin}{M#ein wahrer Experte}!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680202
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706680202,
					"content": "#Miau. „{F#Eine Expertin}{M#Ein Experte} zu sein, bedeutet ... dass du schon besser bist als viele, die diesen Weg eingeschlagen haben. Wer nicht bereit ist, Opfer zu bringen, kann nicht so weit kommen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680203
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706680203,
					"content": "„Natürlich ist es für jemanden, der nicht bereit ist, Opfer dafür zu bringen, sondern nur einen entspannten Spaß haben will, auch völlig unverständlich, warum wir unnachgiebig so viel Zeit aufwenden ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680205
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706680205,
					"content": "Miau! „Wenn von dir eingeladene Kartenbeschwörer davon erfahren, dass du den Titel eines Experten trägst, werden sie das Spiel mit dir bestimmt noch ernster nehmen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680206
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706680206,
					"content": "#„Wahrscheinlich sind einige Leute erst dann bereit, sich von dir herausfordern zu lassen, wenn du {F#eine Expertin}{M#ein Experte} geworden bist ... Ja, es gibt auch solche Leute in der Taverne.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680207
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706680207,
					"content": "#Miau ... „Also dann, {NICKNAME} ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680208
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706680208,
					"content": "„Ich hoffe, dass du die Freude, ‚Geniale Beschwörung‘ zu spielen, spüren kannst!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Prinz“"
				}
			]
		},
