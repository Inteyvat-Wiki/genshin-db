			"dialogs": [
				{
					"id": 706660101,
					"content": "Zur Aufstiegsherausforderung!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660102
					]
				},
				{
					"id": 706660102,
					"content": "#Miau ... „Ah, du möchtest zur Aufstiegsprüfung antreten ... Nun, {NICKNAME}, du bist wahrhaft bereit für diese Herausforderung, dann werde ich ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660103
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706660103,
					"content": "„Dann werde ich Shuyun die Partie für die Aufstiegsprüfung vorbereiten lassen, geh das vorsichtig an ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Prinz“"
				}
			]
		},
		{
			"id": 7066802,
			"completionStepIds": [
				7066804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
