			"dialogs": [
				{
					"id": 728011501,
					"content": "#{F#Reisende}{M#Reisender}, habt ihr den „Reisebericht“ schon bekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011502
					],
					"speakerTitle": "Midori"
				},
				{
					"id": 728011502,
					"content": "Das ist für dich von Herrn Ramsay ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011503
					]
				},
				{
					"id": 728011503,
					"content": "In achtzig Tagen um Teyvat... Toll! Danke dir! Lass mich mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011504
					],
					"speakerTitle": "Midori"
				},
				{
					"id": 728011504,
					"content": "Huch, wie kommt es, dass es so dünn ist? Die vorherigen „Reiseberichte“ waren sehr dick ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011505
					],
					"speakerTitle": "Midori"
				},
				{
					"id": 728011505,
					"content": "Er ist noch nicht fertig mit dem Schreiben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011506
					]
				},
				{
					"id": 728011506,
					"content": "Ist das so ... Ich warte darauf, dass Onkel Ramsay es zu Ende schreibt und wenn er es tut, werde ich alles lesen ... und ich werde eine weitere Geschichte haben, die ich Kouichi erzählen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011507
					],
					"speakerTitle": "Midori"
				},
				{
					"id": 728011507,
					"content": "Danke, dies ist für dich, bitte nimm es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Midori"
				}
			]
		},
