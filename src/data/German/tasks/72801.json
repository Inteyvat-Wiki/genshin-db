			},
			"dialogs": [
				{
					"id": 728010801,
					"content": "Warum stehst du vor mir? Bist du auf der Suche nach einem Kampf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010802
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728010802,
					"content": "Warum verfolgt du uns?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010803
					]
				},
				{
					"id": 728010803,
					"content": "Verfolgen? Wovon sprichst du? Ich spaziere hier! Gehört dir dieser Strand? Was glaubst du, wer du bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Heihachi"
				}
			]
		},
		{
			"id": 7280109,
			"completionStepIds": [
				7280109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
