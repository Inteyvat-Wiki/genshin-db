					"Ramsay"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010901,
					"content": "Schön! Die Aussicht hier ist wirklich schön ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010902
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010902,
					"content": "Und dann ist es ... Mal sehen ... Ah, es gibt eine Flussbucht am Rande der Nordseite der Stadt, die einen netten kleinen Wasserfall hat, also gehen wir einfach dorthin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				}
			]
		},
		{
			"id": 7280111,
			"completionStepIds": [
				7280111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280111",
							"2"
						],
						"stepId": 7280111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ramsay"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728011103,
					"content": "Ich habe nicht erwartet, dass es hier Aktivitäten von Monstern gibt ... Obwohl die Landschaft nicht schlecht ist, ist es ein bisschen gefährlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011104
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011104,
					"content": "Die Begegnung könnte aber auch als kleine Überbrückung in einen „Reisebericht“ einfließen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011105
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011105,
					"content": "Aber lass uns hier verschwinden und einen sicheren Ort suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011106
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011106,
					"content": "Der Typ verfolgt uns immer noch ... hm ... Was für eine Ausdauer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				}
			]
		},
		{
