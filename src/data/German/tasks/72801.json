			},
			"dialogs": [
				{
					"id": 728010201,
					"content": "Was führt dich heute in die Teestube Komore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010202
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 728010202,
					"content": "Wegen Ramsay ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010203
					]
				},
				{
					"id": 728010203,
					"content": "Dieser Händler, ah ... Er war tatsächlich in der Teestube, aber er scheint in letzter Zeit etwas nervös zu sein, bin mir nicht sicher, was ihm passiert ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010204
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 728010204,
					"content": "Wenn du ihn suchst, geh einfach hinein und du wirst ihn sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kozue"
				}
			]
		},
		{
			"id": 7280103,
			"completionStepIds": [
				7280103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280103",
							"2"
						],
						"stepId": 7280103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ramsay"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010301,
					"content": "#Du bist ... {F#eine Reisende}{M#ein Reisender}? Was willst du von mir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010302
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010302,
					"content": "Über den „Reisebericht“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010303
					]
				},
				{
					"id": 728010303,
					"content": "Oh, du meinst den „Reisebericht“, den ich für das kleine Kind Midori geschrieben habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010304
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010304,
					"content": "Das ist ... Ich hatte in letzter Zeit wirklich keine Zeit zum Schreiben, also muss das Kind wohl warten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010305
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010305,
					"content": "Sind diese „Reiseberichte“ echt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010306
					]
				},
				{
					"id": 728010306,
					"content": "Hahaha, was denkst du darüber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010307,
						728010309
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010307,
					"content": "Klingt nicht sehr glaubwürdig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010308
					]
				},
				{
					"id": 728010308,
					"content": "Hahaha, nicht schlecht für jemanden, der ein bisschen herumgereist ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010311,
					"content": "Ja, allen Ernstes, keiner dieser „Reiseberichte“ ist wahr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010312
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010312,
					"content": "Einige der Schauplätze und Figuren sind tatsächlich der Realität entnommen ... Aber das meiste ist meiner persönlichen Vorstellungskraft entsprungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010313
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010313,
					"content": "Natürlich sind einige der Inhalte nicht völlig imaginär. In einem der „Reiseberichte“, die ich schreibe, macht zum Beispiel ein Typ einen Superballon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010314
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010314,
					"content": "Dann sammelte er ein paar Gefährten und wollte mit einem Ballon Teyvat in achtzig Tagen umrunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010315
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010315,
					"content": "Außerdem benötigt man für den Betrieb dieses Ballons überhaupt kein „Göttliches Auge“, sondern nur gutes technisches Wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010316
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010316,
					"content": "Die Gruppe reist mit einem Ballon um die Welt und begegnet unterwegs unzähligen seltsamen Dingen und Phänomenen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010317
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010317,
					"content": "Das war das, was ich Midori schreiben wollte, aber aus ... irgendeinem Grund hatte ich bis jetzt keine Chance, auch nur einen kleinen Absatz zu beenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010318
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010318,
					"content": "Was ist der Grund dafür?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010319
					]
				},
				{
					"id": 728010319,
					"content": "Hast du den Typen im Flur gesehen? Sein Name ist Heihachi. Ich weiß nicht, seit wann, aber der Typ hat mich die ganze Zeit angestarrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010320
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010320,
					"content": "Ich wollte losziehen und Material für diesen „Reisebericht“ sammeln, aber dieser Typ ist mir jedes Mal gefolgt, ohne zu wissen, was er vorhatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010321
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010321,
					"content": "Weil ich Angst hatte, dass dieser Kerl mir etwas Schlimmes antun würde, traute ich mich nicht hinaus, um einen Ausflug zu machen, also legte ich diesen „Reisebericht auf Eis ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010322
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010322,
					"content": "#Aber zum Glück bist du jetzt hier, {F#Reisende}{M#Reisender}, begleitest du mich auf einen Ausflug? Ich denke, dass der Typ sich nicht trauen würde, mir etwas anzutun, wenn du bei mir bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010323,
						728010325
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010323,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010324
					]
				},
				{
					"id": 728010324,
					"content": "Danke sehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010327,
					"content": "Und wie das Sprichwort sagt: „Man muss vor anderen auf der Hut sein“, mit so einer Person, die mir nachstellt, muss ich mehr oder weniger auf der Hut sein, was auch immer er im Sinn hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010328
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010328,
					"content": "#Ich zähle also auf dich, {F#Reisende}{M#Reisender}, dass du mich begleitest, während ich meinen Ausflug mache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010329
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010329,
					"content": "Ich habe eigentlich schon ein paar Ausflugsorte im Sinn, also gehen wir einfach direkt hin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010330
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010330,
					"content": "Der erste Ort ist ein nahegelegener Strand. Lass uns jetzt loslegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010325,
					"content": "Warum sollte er das tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010326
					]
				},
				{
					"id": 728010326,
					"content": "Ich weiß es nicht. Aber ... es braucht nicht viel, um einen guten Grund zu haben, um jemandem gegenüber böse zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010309,
					"content": "Ich hoffe, es ist wahr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010310
					]
				},
				{
					"id": 728010310,
					"content": "Hahahaha, ich wünschte, diese Dinge, die ich geschrieben habe, würden auch wahr werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "Ramsay"
				}
			]
		},
