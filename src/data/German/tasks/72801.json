			},
			"dialogs": [
				{
					"id": 728010401,
					"content": "Warum schaust du mich an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010402
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728010402,
					"content": "Geh mir aus dem Weg und halte dich aus meinem Geschäft raus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Heihachi"
				}
			]
		},
		{
			"id": 7280105,
			"completionStepIds": [
				7280105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280105",
							"2"
						],
						"stepId": 7280105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ramsay"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010501,
					"content": "Das Wasser an diesem Strand ist außerordentlich klar und der feine Sand hat eine weiße Farbe, völlig anders als das offene Meer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010502
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010502,
					"content": "Segeln von hier aus ... Oder Abheben sollte ziemlich aufregend sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010503
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010503,
					"content": "Das ist eine tolle Aussicht, die muss ich dokumentieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010504
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010504,
					"content": "#{F#Reisende}{M#Reisender}, bitte warte einen Moment, während ich über den Reisebericht nachdenken muss. Ihr könnt herumlaufen und den Strand genießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010505
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010505,
					"content": "Aber bitte nicht zu weit von mir weggehen. Der Typ Heihachi ist mir weiter gefolgt, er ist ganz in der Nähe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				}
			]
		},
		{
			"id": 7280106,
