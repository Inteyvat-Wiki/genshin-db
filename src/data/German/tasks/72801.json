			"dialogs": [
				{
					"id": 728011301,
					"content": "Vom Gipfel des Berges aus kann man ganz viel von Narukami sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011302
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011302,
					"content": "Der Wind auf dem Berggipfel ist ziemlich stark und die Höhe ist perfekt zum Abheben. Hier gibt es keine Hindernisse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011303
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011303,
					"content": "Und es ist weit genug von Inazuma entfernt, dass ein Doushin stören würde ... oder andere Leute.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011304
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011304,
					"content": "Ein toller Ort.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011305
					]
				},
				{
					"id": 728011305,
					"content": "Auf jeden Fall sollte es toll sein, hier abzuheben ... und es muss sehr schön sein, darüber in einem „Reisebericht“ zu schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011306
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011306,
					"content": "Dieser Typ ... Er folgt uns wirklich immer noch, es nimmt kein Ende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011307
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011307,
					"content": "Ich werde ihn loswerden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011308
					]
				},
				{
					"id": 728011308,
					"content": "Vergiss es, kein Grund, sich mit ihm abzugeben. Mit dir in der Nähe wird er es nicht wagen, etwas Unüberlegtes zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011309
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011309,
					"content": "Und der Umgang mit dieser Art von Person ... Wenn du die Initiative ergreifst, wird er dich nur noch mehr belästigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011310
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011310,
					"content": "Wie auch immer, genug von diesem Ausflug, lass uns zurück zur Teestube Komore gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				}
			]
		},
