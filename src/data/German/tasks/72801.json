			"dialogs": [
				{
					"id": 728010601,
					"content": "Das Wasser an diesem Strand ist außerordentlich klar und der feine Sand hat eine weiße Farbe, völlig anders als das offene Meer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010602
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010602,
					"content": "Es sollte glattgehen, wenn du von hier aus segelst ...",
