			"dialogs": [
				{
					"id": 728011401,
					"content": "Ich habe bereits die Hauptpunkte des Reiseberichts im Kopf, aber es wird ein oder zwei Tage dauern, bis ich sie in ein volles Kapitel schreiben kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011402
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011402,
					"content": "Ich habe schon ein paar kleine Absätze geschrieben, also wenn du sie zuerst zu Midori bringen könntest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011403
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011403,
					"content": "Ich werde jemanden bitten, ihr den kompletten „Reisebericht“ zu bringen, wenn ich alles aufgeschrieben habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011404
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011404,
					"content": "„Reisebericht“ ... Hm, das sagt er zwar, aber wer weiß, ob er andere Absichten hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011405
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728011405,
					"content": "Wovon sprichst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011406
					]
				},
				{
					"id": 728011406,
					"content": "Ich sage, dieser Typ schreibt diese „Reiseberichte“ für einen anderen Zweck.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011407
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728011407,
					"content": "Wer nichts Besseres zu tun hat, als über all diesen Unsinn nachzudenken und Teyvat in einem Heißluftballon zu umrunden und dabei kein „Göttliches Auge“ zu benutzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011408
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728011408,
					"content": "Hm, dieser Kerl muss irgendetwas im Schilde führen ... nur, dass man es noch nicht sieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Heihachi"
				}
			]
		},
