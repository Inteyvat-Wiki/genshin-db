			"dialogs": [
				{
					"id": 728011203,
					"content": "Was ist das für ein Ort? Hier sind überall Monster ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011204
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728011204,
					"content": "Warum verfolgt du uns?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011205
					]
				},
				{
					"id": 728011205,
					"content": "Ich ... euch folgen? Ich bin hierhergekommen, um Früchte beim Spazieren zu pflücken. Hast du was dagegen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Heihachi"
				}
			]
