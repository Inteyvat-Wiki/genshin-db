			"dialogs": [
				{
					"id": 740310101,
					"content": "#{F#Junge Kriegerin}{M#Junger Krieger}, lass uns ein Kräftemessen austragen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310102
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310102,
					"content": "So plötzlich?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740310103,
					"content": "#{M#Blonder}{F#Blonde}, ich sehe auf den ersten Blick, dass du {M#ein erfahrener Krieger}{F#eine erfahrene Kriegerin} bist, {M#der}{F#die} schon viel durchgemacht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310104
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310104,
					"content": "In letzter Zeit hat mich niemand herausgefordert, und mir ist so langweilig. Wenn du mit mir trainierst, gebe ich dir dafür Tauschscheine! Ich habe kürzlich eine Menge von Roussimoff gewonnen und weiß nicht, wie ich sie ausgeben soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310105
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310105,
					"content": "Na, was sagst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nizami"
				}
			]
		},
