			"dialogs": [
				{
					"id": 740318101,
					"content": "#Ich bin {F#eine Pazifistin}{M#ein Pazifist} und möchte nicht mit Leuten kämpfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740318102
					]
				},
				{
					"id": 740318102,
					"content": "#{F#Eine Pazifistin}{M#Ein Pazifist}, {F#die}{M#der} Gewalt mit Gewalt bekämpft? Hm, davon mag jeder halten, was er mag.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740318103
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740318103,
					"content": "#Aber das hier ist kein Kampf, sondern ein Kräftemessen. Das Ziel des Kräftemessens ist es, den Frieden noch besser zu bewachen. Du bist {F#eine Pazifistin}{M#ein Pazifist}, dann solltest du umso mehr mit mir Kräfte messen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740318104
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740318104,
					"content": "Das klingt überzeugend, lass uns unsere Kräfte messen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740318105
					]
				},
				{
					"id": 740318105,
					"content": "Haha, gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740318106
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740318106,
					"content": "Hier ist es nicht praktisch, gehen wir an einen Ort mit mehr Platz!",
