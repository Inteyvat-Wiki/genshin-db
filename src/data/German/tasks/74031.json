			"dialogs": [
				{
					"id": 740310301,
					"content": "Haha! Was für ein Duell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310302
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310302,
					"content": "#Ich wusste doch, dass du {F#eine würdige Gegnerin}{M#ein würdiger Gegner} bist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310303,
						740310305
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310303,
					"content": "Du bist auch nicht schlecht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740310304
					]
				},
				{
					"id": 740310304,
					"content": "Haha, ich muss noch üben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310307
					],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310307,
					"content": "Nun, ich bin auch ein direkter Typ. Hier sind die versprochenen Tauschscheine, nimm sie an. Bei Gelegenheit lass uns noch einmal duellieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nizami"
				},
				{
					"id": 740310305,
					"content": "Du musst noch viel üben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740310306
					]
				},
				{
					"id": 740310306,
					"content": "*hust* Du nennst die Dinge beim Namen, sehr gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740310307
