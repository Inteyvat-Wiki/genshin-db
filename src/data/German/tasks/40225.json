			},
			"dialogs": [
				{
					"id": 402250201,
					"content": "Beidou weist ihre Mannschaft an, die Fracht zu entladen, und folgt euch zum Veranstaltungsort.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402250202
					]
				},
				{
					"id": 402250202,
					"content": "Das ist also der Ort, hm? Nicht schlecht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250203,
					"content": "Komm doch mal vorbei, wenn du Zeit hast, und hilf mir, die Fernsteuerung dieses Geräts zu testen. Das wird ein Riesenspaß, du wirst es lieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
				}
			]
		}
	]
