			},
			"dialogs": [
				{
					"id": 402250101,
					"content": "Moment mal, ist das ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250102,
					"content": "Die Alcor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250103
					]
				},
				{
					"id": 402250103,
					"content": "Eigentlich ist dies das Schiff Nummer zwei unserer Flotte. Die Alcor ist zu Hause geblieben und patrouilliert um die Guyun-Türme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250104
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250104,
					"content": "Beidou! Die berüchtigte Söldnerkapitänin, die die Weltmeere bereist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250105,
					"content": "Äh, ja, haha. Wir kennen uns doch, weißt du noch? Was soll das ganze Getue?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250106,
					"content": "Das ist eine lange Geschichte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250107,
					"content": "Nun, es macht keinen Sinn, hier herumzustehen. Setz dich doch und erzähl mir alles. Ich werde meine Leute anweisen, den roten Teppich auszurollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250108
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250108,
					"content": "Ach so, ich verstehe. Du kennst also die Chefin des Kuratoriums, hm ... Dein Netzwerk an Kontakten ist schon beeindruckend, so viel steht fest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250109
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250109,
					"content": "Hehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250110,
					"content": "Was die Registrierung angeht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250111
					]
				},
				{
					"id": 402250111,
					"content": "Richtig! Wir brauchen eine Liste der Aussteller und der Waren, die du handeln willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250112,
					"content": "Nun, trag mich und ein paar Besatzungsmitglieder als Teilnehmer ein, der Rest bleibt auf dem Schiff. Was wir handeln werden ... Schau mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250113
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250113,
					"content": "Was ist das ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250114,
					"content": "Ningguang hat vor einiger Zeit das Guizhong-Geschütz überarbeitet. Die Schönheit, die du hier siehst, ist eines ihrer neuen und verbesserten Modelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250115
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250115,
					"content": "Es verfügt über eine unglaubliche Feuerkraft und ist mit einer Fernsteuerung ausgestattet, die auch auf große Entfernungen präzise Treffer garantiert. Ich bin mir sicher, dass sich die Leute darum reißen werden, um eines davon zu ergattern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250116
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250116,
					"content": "Bist du sicher, dass du sowas verkaufen darfst!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250117,
					"content": "Haha, keine Sorge. Im Vergleich zu dem Modell, das die Millelithen verwenden, könnte dieses hier genauso gut eine Antiquität sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250118
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250118,
					"content": "... Nefer hat wohl nicht gescherzt, als sie meinte „keine Einschränkungen“, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250119,
					"content": "Aber wer würde sowas kaufen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250120
					]
				},
				{
					"id": 402250120,
					"content": "Oh, ich bin mir sicher, dass jemand anbeißen wird. Schließlich werden Käufer aus ganz Teyvat vor Ort sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250121
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250121,
					"content": "Yelan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250122,
					"content": "Ah, entschuldige bitte. Ich war so mit der Ladung beschäftigt, dass ich ganz vergessen hatte, zu erwähnen, dass Yelan auch an Bord ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250123
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250123,
					"content": "Keine Sorge. Bist du auch wegen der Messe hier, Yelan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250124,
					"content": "Ach nein, ich bin nur wegen der Arbeit hier. Kapitän Beidou war so freundlich, mich mitzunehmen. Ich muss mich also nicht für die Messe registrieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250125
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250125,
					"content": "#Wie auch immer, es ist schon eine Weile her, {NICKNAME}. Wenn du die Gelegenheit bekommst, richte doch bitte der Chefin des Kuratoriums meine besten Grüße aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250126
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250126,
					"content": "Was denn für eine Arbeit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250127
					]
				},
				{
					"id": 402250127,
					"content": "Die Art von Arbeit, die ... Diskretion erfordert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250128
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250128,
					"content": "Klingt, als wäre das unser Stichwort, keine weiteren Fragen mehr zu stellen, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250129,
					"content": "Ganz richtig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250130
					]
				},
				{
					"id": 402250130,
					"content": "Nun, ich bin dann mal weg. Sobald ich fertig bin, gehen die Getränke auf mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250131
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250131,
					"content": "Wird auch Zeit! Ich kann’s kaum erwarten, Nod-Krai ausgiebig zu genießen, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250132
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250132,
					"content": "In Ordnung, das war’s mit der Registrierung. Bitte folge uns, wir bringen dich zum Veranstaltungsort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
