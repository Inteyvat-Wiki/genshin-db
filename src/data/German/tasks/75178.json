			"dialogs": [
				{
					"id": 751781701,
					"content": "#{NICKNAME}! Hallo, lange nicht gesehen! Wie ist es euch so ergangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781702,
