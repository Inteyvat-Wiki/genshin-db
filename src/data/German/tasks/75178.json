			"dialogs": [
				{
					"id": 751780901,
					"content": "#{NICKNAME}, hallo ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780902,
						751780903
					],
					"speakerTitle": "???"
				},
				{
					"id": 751780902,
					"content": "Warum das lange Gesicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780904
					]
				},
				{
					"id": 751780904,
					"content": "Eigentlich ... fühlt sich das Wasser der heißen Quelle immer noch kälter an als früher. Diesmal habe ich es wirklich vermasselt. Was soll ich nur tun, wenn ich zurückkehre ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780905
					],
					"speakerTitle": "???"
				},
				{
					"id": 751780905,
					"content": "Keine Sorge, nur noch etwas Geduld.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780906
					]
				},
				{
					"id": 751780906,
					"content": "In Ordnung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 751780903,
					"content": "Bis bald.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780907
					]
				},
				{
					"id": 751780907,
					"content": "#Und, ähm, pass auf dich auf, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
