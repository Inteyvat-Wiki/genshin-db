			},
			"dialogs": [
				{
					"id": 751781401,
					"content": "Oh, ein kleiner Koholasaurier? Was macht der denn hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781402,
					"content": "Ki’o-ki’o! Da bist du ja ... Wenn ihr nicht sofort herausgekommen wärt, dann ... dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781403
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781403,
					"content": "Was, wenn du dich verletzt? Nächstes Mal darfst du nicht einfach so weglaufen ... *schluchz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781404
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781404,
					"content": "N... Nicht weinen. Sieh nur, dem kleinen Saurier geht’s gut. Er sprüht nur so vor Energie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781405,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781406,
					"content": "Ja, i... in Ordnung. Ich heiße Linaha, ich bin vom Stamm der „Menschen der Quellen“ ... Normalerweise passe ich auf die kleinen Koholasaurier auf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781407
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781407,
					"content": "Du passt auf sie auf? Beeindruckend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781408,
					"content": "Ü... Überhaupt nicht. Wenn ich doch nur so sein könnte wie du, dann wären sie mir sicher nicht weggelaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781409
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781409,
					"content": "Gerade habe ich mich noch gefragt, ob sie alle zum Spielen zur Phlogiston-Öffnung gelaufen sind, weshalb ich sie nicht finden konnte. Und jetzt stellt sich heraus, dass ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781410
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781410,
					"content": "Ach, so ist das also. Die heiße Quelle ist abgekühlt, weil die kleinen Koholasaurier die Phlogiston-Öffnung blockiert haben. Kein Wunder, dass der Verwalter es nicht bemerkt hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781411,
					"content": "Tatsächlich ... fehlen mir immer noch zwei Sauriergefährten. Ich schätze, dass sie sich auch in der Öffnung verstecken und dort spielen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781412
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781412,
					"content": "Keine Sorge! Während wir uns um die Wassertemperatur kümmern, können wir auch gleich noch die kleinen Koholasaurier zurückbringen! Zwei Fliegen mit einer Klappe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781413,
					"content": "Wirklich? Ich danke euch! Es ist schön, Fräulein Paimon hier zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781414
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781414,
					"content": "Haha, natürlich! Paimon ist schließlich eine legendäre Abenteurerin. Für Paimon ist das doch ein Klacks!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781415,
					"content": "Wahnsinn! Fräulein Paimon, du bist unglaublich! Ich möchte eines Tages genau so sein wie du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781416,
						751781417
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781416,
					"content": "Stimmt, Fräulein Paimon hat’s eben voll drauf, nicht wahr?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781418
					]
				},
				{
					"id": 751781418,
					"content": "(Lass Paimon vor Fremden doch ein bisschen das Gesicht wahren! Wie wär’s, dafür überlässt Paimon dir heute Abend auch die leckersten Gerichte, abgemacht?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781419,
					"content": "Ähem, na gut, wir brechen dann mal auf, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
