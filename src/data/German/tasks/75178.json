				]
			},
			"dialogs": [
				{
					"id": 751780101,
					"content": "Hallo! Entschuldigung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780102,
					"content": "#Was für eine „Intensität“! So voller Kraft. Wie nicht anders zu erwarten von {M#dem}{F#der} legendären {NICKNAME} und Paimon! Ihr habt einen weiten Weg zurückgelegt. Ihr seid doch nicht etwa hier, um euch den Titel „Stärkste{M#r} im Kollektiv der Fülle“ zu erkämpfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780103
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780103,
					"content": "#„Stärkste{M#r} im Kollektiv der Fülle“? Ist das hier nicht eine normale Recken-Herausforderung? Da stehen ja so viele Leute an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780104,
					"content": "#Hahaha, die können euch auf keinen Fall das Wasser reichen. Ihr müsst wissen, dass der einzige Weg, den Titel {F#der}{M#des} „Stärksten“ zu bekommen, darin besteht, den bisher „Stärksten“ zu besiegen. Das ist nichts für irgendwelche Normalos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780105
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780105,
					"content": "Ihr kommt genau richtig! Obwohl ... ach, zu schade. Der Zeitpunkt ist schlecht gewählt. Der Meister hat leider keine Zeit, sich um weltliche Angelegenheiten zu kümmern. Ich fürchte, ihr werdet wohl keine Chance haben, ihm gegenüberzutreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780106,
						751780107
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780106,
					"content": "Wo ist denn der „Stärkste“ gerade?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780108
					]
				},
				{
					"id": 751780108,
					"content": "Oh ... Du hast also vor, zu kämpfen? Das nenn’ ich mal mutig! Dann kann ich dir ja sagen, wo der Meister sich aufhält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780110
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780110,
					"content": "Sucht entlang des zerklüfteten Pfades der Kultivierung. Dort werdet ihr auf ein bergiges Gebiet stoßen, voll mit „Wasser der Intensität“. Vielleicht ist der „Stärkste“ ja gerade dort ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780107,
					"content": "Ist schon gut, wir warten, bis er zurückkommt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780109
					]
				},
				{
					"id": 751780109,
					"content": "Ja, ja, „Intensität“ und „Intensität“ ziehen sich stets gegenseitig an und die „Stärksten“ werden immer aufeinandertreffen. Abzuwarten ist da natürlich auch eine Option.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				}
			]
		},
