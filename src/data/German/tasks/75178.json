					"Loshts"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751780501,
					"content": "Fremder Recke, wie steht es? Habt ihr den Weg zum „Stärksten“ gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780502,
						751780503
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780502,
					"content": "Über den Verbleib des „Stärksten“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780504
					]
				},
				{
					"id": 751780504,
					"content": "Geht den Berg hinauf, dort werdet ihr auf ein bergiges Gebiet stoßen, voll mit „Wasser der Intensität“. Vielleicht ist der „Stärkste“ ja gerade dort ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780503,
					"content": "Ich bin noch dran ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780505
					]
				},
				{
					"id": 751780505,
					"content": "Ausgezeichnet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				}
			]
		},
