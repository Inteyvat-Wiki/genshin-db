			},
			"dialogs": [
				{
					"id": 751780201,
					"content": "H... Hilfe! Kann mir jemand helfen! Jemand ist ohnmächtig geworden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780202
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780202,
					"content": "#V... Verdammt! Der Meister ist anscheinend ohnmächtig geworden! Lass uns schnell helfen, {NICKNAME}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780203
					]
				},
				{
					"id": 751780203,
					"content": "Der Meister scheint durch die Hitze ohnmächtig geworden zu sein, sein Zustand ist nicht ernst. Mit eurer Hilfe wird er von Yoleehe weggebracht ...\\nEs scheint, dass die Belastbarkeit des Meisters für „Intensität“ wohl noch einiges an Verbesserung vertragen kann ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
