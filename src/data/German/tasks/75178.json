						751781803
					]
				},
				{
					"id": 751781803,
					"content": "Genau, genau! Wie sieht’s aus, willst du dich an der „Recken-Herausforderung“ versuchen? Melde dich einfach beim Meister an, ich setze große Hoffnungen in dich!",
					"roleType": "TALK_ROLE_NPC",
