					"nextDialogs": [
						751781705
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781705,
					"content": "Jetzt werde ich mich richtig amüsieren! Ich werde die Quelle und den Vulkan in vollen Zügen genießen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781706
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781706,
					"content": "Dann mal viel Spaß!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781707
					]
				},
				{
					"id": 751781707,
					"content": "#Hehe, ich hoffe, du wirst auch viel Spaß haben, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
