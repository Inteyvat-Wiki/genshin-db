				]
			},
			"dialogs": [
				{
					"id": 751780701,
					"content": "„Kalt“! So „eiskalt“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780702
					],
					"speakerTitle": "Ma’chah"
				},
				{
					"id": 751780702,
					"content": "Hä? Kalt? Wo ist es denn kalt? Du sitzt doch in einer heißen Quelle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780703,
					"content": "Nicht genug! Immer noch nicht genug! Das ist bei weitem nicht heiß genug für den „Stärksten“! Um der Stärkste des „Kollektivs der Fülle“ ... nein, von ganz „Natlan“ zu werden, reicht diese „Intensität“ bei weitem noch nicht aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780704
					],
					"speakerTitle": "Ma’chah"
				},
				{
					"id": 751780704,
					"content": "Hä? Warum sitzt du denn schon wieder? Was soll das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780705,
						751780707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780705,
					"content": "Scheint so, als wäre es noch nicht genug „Intensität“!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780706
					]
				},
				{
					"id": 751780706,
					"content": "„Intensität“!? Was soll das überhaupt bedeuten? Paimon versteht kein Wort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780709,
					"content": "#Fantastisch! Ihr müsst wohl die berühmten Abenteurer{F#innen} {NICKNAME} und Paimon sein. Wir sind gerettet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780710
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780710,
					"content": "W... Was ist denn passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780711,
					"content": "Also, ich werde alles ausplaudern. Der Meister selbst sagt, er sei auf einer Reise, um der „Stärkste“ zu werden. Zu diesem Zweck hat er sich vollständig in eine Art Training in der heißen Quelle vertieft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780712
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780712,
					"content": "Training? In einer heißen Quelle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780713,
					"content": "Ja, ja, so ist es ... obwohl ich es selbst nicht wirklich zu glauben wage. Aber diese Methode scheint der Meister aus einem Kampfkunstbuch namens „Buch der fünf Quellen“ gelernt zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780714
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780714,
					"content": "In dem Buch heißt es, wenn man sich nach dem Pfad der rauschenden Quellen kultiviert, könnte man eines Tages <color=#00E1FFFF>kaltes Wasser zum Kochen bringen</color>, allein mithilfe der eigenen „Intensiät“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780715
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780715,
					"content": "Dieses Buch berichtet auch von vielen mächtigen Menschen. So sollen einige in einer Nacht mit ihren bloßen Fäusten Berge durchschlagen und andere mit ihren leeren Händen Steine zu Edelsteinen zerdrückt haben können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780716
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780716,
					"content": "#Wer hätte gedacht, dass es solche tollen Kampfkünste auf der Welt gibt! Wenn {NICKNAME} das auch lernen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780717,
						751780718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780717,
					"content": "Hm, das klingt nach einer kurzen Erzählung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780719,
					"content": "Ihr haltet das alles wahrscheinlich für Quatsch, aber immerhin handelt es sich um ein seltenes Buch, das der Meister in einem Stapel Bücher der „Meister des Nachtwinds“ gefunden hat. Außerdem ist der Meister selbst davon überzeugt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780720
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780720,
					"content": "Deswegen wählte der Meister absichtlich diese besondere heiße Quelle ... ach nein, es war ja eine „kalte Quelle“. Jedenfalls will er diese ultimative „kalte Quelle“ in die ultimative „heiße Quelle“ verwandeln, nur mit Kraft seiner „Intensität“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780721
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780721,
					"content": "E... Echt? Das Wasser in dieser heißen Quelle ist eigentlich gar nicht heiß! Aber ... wenn man so lange in diesem Wasser badet, wird doch selbst der stärkste Mensch krank ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780722,
					"content": "Nun, selbst wenn er nicht krank wird, wird das nichts! Die „Recken-Herausforderung“ wurde für mehrere Tage ausgesetzt und alle warten nur auf die Rückkehr des Meisters.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780723
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780723,
					"content": "Doch der Meister meinte, dass auf halbem Weg aufzugeben nicht der Praxis der „Intensität“ entspreche. Deshalb würde er die Quelle auch so lange nicht verlassen, bis sie anfängt zu kochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780724
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780724,
					"content": "#Der Verwalter hier konnte bisher keinen Grund feststellen, warum diese heiße Quelle kalt ist. *seufz* Wenn doch nur ein{F#e} erfahrene{M#r} Abenteurer{F#in} vorbeikäme ... Ich habe sogar die Bezahlung arrangiert, schaut mal, wie viel es ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780725,
						751780726
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780725,
					"content": "Diese Angelegenheit solltest du bei den „Menschen der Quellen“ erfragen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780727,
					"content": "(Jetzt nicht so voreilig. Schauen wir doch erstmal, wie viel es ist, bevor wir ablehnen.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780728,
					"content": "*räusper* Keine Sorge, die heiße Quelle kriegen wir schon heiß. Außerdem können wir doch nicht zulassen, dass er wegen der kalten heißen Quelle noch krank wird. Ein guter Abenteurer ist stets bereit, den Menschen zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780729,
					"content": "Super, ich zähle auf euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780730
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780730,
					"content": "Du wartest hier. Wir kommen dann mit guten Nachrichten zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780726,
					"content": "Hast du etwa vor, mich zu bestechen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780718,
					"content": "Du glaubst doch nicht wirklich an so etwas ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780707,
					"content": "Vielleicht ist ihm ja kalt, wenn er aufsteht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780708
					]
				},
				{
					"id": 751780708,
					"content": "Das ist es also! Kein Wunder, dass er so zittert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "Paimon"
				}
			]
		},
