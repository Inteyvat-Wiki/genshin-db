			"dialogs": [
				{
					"id": 751781001,
					"content": "Hmm, wir haben zwar versprochen zu helfen, aber ... wo sollen wir anfangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781002,
						751781005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781002,
					"content": "Wollen wir es mit dem magischen Phlogiston probieren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781003
					]
				},
				{
					"id": 751781003,
					"content": "*brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781004
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781004,
					"content": "Das klappt niemals! Der Bereich ist viel zu groß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781009,
					"content": "*seufz* ... Gibt es denn keine praktischere Lösung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781010,
					"content": "*brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781011
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781011,
					"content": "#Warte! {REALNAME[ID(2)|SHOWHOST(true)]}, jetzt renn hier doch nicht so wild herum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781005,
					"content": "In diesem Vulkan sollte es doch eine Menge Magma geben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781006
					]
				},
				{
					"id": 751781006,
					"content": "Oh, Paimon versteht! Der Kleine soll helfen, ein Loch zu graben, damit die Lava aus dem Vulkan die heiße Quelle erhitzt, richtig? Gute Idee ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781007,
					"content": "*brüll*! *brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781008
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781008,
					"content": "#Du hast recht, Kleiner! Die Lava könnte noch jemanden umbringen! Ganz im Ernst! Sieh mal, selbst {REALNAME[ID(2)|SHOWHOST(true)]} glaubt das!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781009
					],
					"speakerTitle": "Paimon"
				}
			]
