			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3750101,
					"content": "Wie ich mir gedacht hatte ... es hat nicht geklappt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750102,
					"content": "Wie du dir gedacht hattest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750103,
					"content": "#Ich wollte nur sehen, wie viel Einfluss {NICKNAME} als großer Held des Ritterordens hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750104
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750104,
					"content": "Der beste Krieger ist schließlich nichts ohne seine Waffe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750105
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750105,
					"content": "Wäre das nicht etwas für eine Heldengeschichte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750106
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750106,
					"content": "Püh, deine Vergleiche sind ziemlich unpassend, Barde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750107,
					"content": "Ach, du verstehst mich falsch. Es geht um die Enttäuschung gegenüber Mondstadt. Selbst im Angesicht des Helden wird dessen große Waffe verschlossen gehalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750108
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750108,
					"content": "Überreden können wir sie also nicht. Wir müssen einen anderen Weg finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750109
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750110,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750111
					]
				},
				{
					"id": 3750109,
					"content": "Wir respektieren den freien Willen und lassen die Ideen in unseren Geist fließen. Sagt schon, was denkt ihr gerade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750110
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750112,
					"content": "Ehrlich gesagt will ich gar nichts stehlen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750113
					]
				},
				{
					"id": 3750111,
					"content": "Na los, traut euch! Dafür ist der freie Wille doch da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750113,
					"content": "Ahaha! Du bist mir ja einer! Kommst gleich am Anfang vom Thema ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750114
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750114,
					"content": "Aber ganz im Ernst, du bist hierfür viel besser als ich geeignet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750115
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750115,
					"content": "Vom Singen abgesehen habe ich nichts Besonderes zu bieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750116,
					"content": "Außerdem habe ich niemanden in Mondstadt, der für mich sprechen kann. Wenn man mich schnappt, werde ich sicher hart bestraft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750117,
					"content": "Hat man das nicht verdient, wenn man beim Stehlen erwischt wird?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750118,
					"content": "#Bei dir ist das aber anders, {NICKNAME}. Du hast für Mondstadt einen großen Beitrag geleistet und bist zum Stern des Ritterordens geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750119
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750119,
					"content": "Selbst wenn du scheiterst, kannst du dich noch herausreden. Dann kommst du sicher mit einem blauen Auge davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750120
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750140,
					"content": "Die Wächter hier scheinen nachts keinen Dienst zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750141,
					"content": "Hach, wenn wir diese Gelegenheit ergreifen, sollte es keine größeren Probleme mehr geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750120,
					"content": "Gehst du etwa jetzt schon davon aus, dass wir scheitern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750122,
					"content": "Du hast vorhin gesagt, du wärst Barbatos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750123
					]
				},
				{
					"id": 3750121,
					"content": "#{NICKNAME} ... Was denkst du denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750123,
					"content": "Ah ja, das habe ich wohl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750124
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750125,
					"content": "Wenn du wirklich ein Gott bist, können wir dich nicht einfach im Stich lassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750126
					]
				},
				{
					"id": 3750124,
					"content": "Warum fragst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750125
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750126,
					"content": "Meinst du? Wie hängt das zusammen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750128,
					"content": "Ich werde Dvalin auch retten, wenn du kein Gott bist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750129
					]
				},
				{
					"id": 3750127,
					"content": "#Wir erzählen dir zu gegebener Zeit, was es mit der Vergangenheit von {NICKNAME} auf sich hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750130,
					"content": "Ich werde dir „Der Himmel“ bringen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750131,
					"content": "Denn ich kann eine weitere „Trennung“ nicht ertragen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750129,
					"content": "Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750130,
						3750131
					],
					"speakerTitle": "Venti"
				}
			]
		},
