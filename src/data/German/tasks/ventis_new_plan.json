			"dialogs": [
				{
					"id": 3750202,
					"content": "Mann, ist das ätzend! Muss ich wirklich den ganzen Tag <color=#00E1FFFF>von morgens bis abends</color> hier Wache stehen?\\nHe, bleib stehen! Hier hast du keinen Zutritt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750203
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3750203,
					"content": "Wir müssen wohl warten, bis es <color=#00E1FFFF>Nacht</color> wird, damit wir uns einschleichen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
