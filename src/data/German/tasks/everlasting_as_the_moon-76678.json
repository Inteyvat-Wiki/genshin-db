			"dialogs": [
				{
					"id": 760840101,
					"content": "Ihr seid wieder da? Heute spielen die Kuuhenki wieder mit der Leier. Könnt ihr wie letztes Mal ein Lied für sie spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840102
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760840102,
					"content": "Ich hätte auch gerade Lust auf ein paar andere Melodien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840103
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760840103,
					"content": "(Hmm, was soll ich nur spielen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
