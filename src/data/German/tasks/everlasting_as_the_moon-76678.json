			"dialogs": [
				{
					"id": 760830401,
					"content": "Los, Kuuhenki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830402
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830402,
					"content": "Rate mal, was das sein soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830403,
						760830407,
						760830412
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830403,
					"content": "Der Mond.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830404
					]
				},
				{
					"id": 760830404,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830405
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760830405,
					"content": "Hehe, diesmal war es ziemlich offensichtlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830406,
					"content": "Für uns ist dieses Rätsel etwas zu einfach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830407,
					"content": "Ein Unagi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830408
					]
				},
				{
					"id": 760830408,
					"content": "Aber er scheint es irgendwie mit der Hüfte zu haben, so wie er aussieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830409,
					"content": "Ihr habt wirklich was von der Welt gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830410
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830410,
					"content": "Die richtige Antwort lautet: der Mond.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830411
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830411,
					"content": "Kommt zurück, ihr habt das sehr gut gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830412,
					"content": "Ein Kreisbogen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830413
					]
				},
				{
					"id": 760830413,
					"content": "Jeder kann doch sehen, dass es ein Kreisbogen ist! Irgendwie ist diese Antwort zu einfach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830414,
					"content": "Das ist zwar nicht unbedingt falsch, aber das war nicht, was die Kuuhenki gemeint haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830415
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830415,
					"content": "Die richtige Antwort lautet: der Mond.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830416
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830416,
					"content": "Kommt zurück, ihr habt das sehr gut gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		},
