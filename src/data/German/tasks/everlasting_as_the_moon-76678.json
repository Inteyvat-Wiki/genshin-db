					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830504
					]
				},
				{
					"id": 760830504,
					"content": "!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830505
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760830505,
					"content": "Wie hast du das denn erkannt?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830506,
					"content": "So nennt man das also. Kann sie denn auch diese Mechanikerin auf den Händen überall hintragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830507
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830507,
					"content": "Der Schatten deiner ehemaligen Kollegin scheint sich in deine Vorstellungskraft eingeschlichen zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830508,
					"content": "Ein Schatzmarder, der vom Essen einen ganz runden Bauch hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830509
					]
				},
				{
					"id": 760830509,
					"content": "Wenn er schon so vollgefressen ist, kann er dann überhaupt noch Schätze stehlen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830510,
					"content": "Oder vielleicht hat er es ja gar nicht mehr nötig, Sachen zu stehlen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830511
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830511,
					"content": "Die richtige Antwort ist ... die große mechanische Ente in der Nähe von Ainos Werkstatt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830512
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830512,
					"content": "Kommt zurück, danke für eure Mühe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830513,
					"content": "Ein Glaskolben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830514
					]
				},
				{
					"id": 760830514,
					"content": "Die Kuuhenki geben sich wirklich Mühe! Um die Muster für das Spiel zu legen, müssen sie sogar die Laborgeräte genau ansehen und erforschen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830515,
					"content": "Ganz nah dran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830516
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830516,
					"content": "Die richtige Antwort ist ... die große mechanische Ente in der Nähe von Ainos Werkstatt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830517
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760830517,
					"content": "Wo ist das denn nah dran!",
