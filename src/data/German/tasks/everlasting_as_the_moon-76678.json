			"dialogs": [
				{
					"id": 766780801,
					"content": "Danke. Ich habe unsere gemeinsame Zeit genossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766780802
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 766780802,
					"content": "Wohin du auch gehst, möge dieser Strahl des Mondlichts auf dir verweilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				}
			]
		},
		{
