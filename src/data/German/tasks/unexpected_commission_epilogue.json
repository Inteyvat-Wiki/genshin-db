				"points": []
			},
			"dialogs": [
				{
					"id": 706900301,
					"content": "Oh? Ihr seid schon fertig mit dem Sortieren? Das ging ja viel schneller, als ich gedacht hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900302
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900302,
					"content": "#Also, was möchtest du dafür, {F#meine Süße}{M#mein Süßer}? Du hast mir damit den ganzen Nachmittag gerettet. Wie wäre es, wenn wir ihn zusammen verbringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900303,
						706900305
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900303,
					"content": "Wie wäre es mit einer Bezahlung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900304
					]
				},
				{
					"id": 706900304,
					"content": "Oh, das ist alles? Keine Sorge, ich werde dran denken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900306
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900306,
					"content": "Ah, dir ist es also auch aufgefallen. Diese seltsamen Namen und noch seltsameren Inhalte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900307
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900307,
					"content": "Ganz zu schweigen davon, dass dies die größte Bibliothek im Norden von Teyvat ist, und ich kenne keinen einzigen Titel aus der Liste. Das erscheint mir einfach unmöglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900308
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900308,
					"content": "Es sei denn ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900309
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900309,
					"content": "Eigentlich sind wir gerade auf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706900310,
					"content": "... Ärger gestoßen, nehme ich an? Ich denke, ich halte mich da lieber raus, wenn es dir recht ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900311
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900311,
					"content": "Außerdem, wenn ein Buch in dieser Welt existiert, dann gibt es auch einen Platz dafür in dieser Bibliothek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900312
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900312,
					"content": "Es ist besser, wenn sie hier bleiben, als dass sie in die Hände von ... verdächtigeren Personen geraten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900313
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900313,
					"content": "Hier ist jedenfalls deine Bezahlung. Nochmals vielen Dank für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900305,
					"content": "Ich würde gerne etwas über diese Bücher wissen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900306
					]
				}
			]
		}
	]
