			"dialogs": [
				{
					"id": 740831001,
					"content": "Toll, noch ein Schlüssel. Dann brauchen wir nur noch den letzten Schlüssel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831002,
					"content": "Schlüssel, Schlüssel, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831003
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831003,
					"content": "Boah, Pahsiv! Wie tauchst du plötzlich hier auf?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831004,
					"content": "Keine Spur, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831005
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831005,
					"content": "Nun gut ... Paimon hat wirklich noch nie eine so besondere Melusine wie dich gesehen ... Und Paimon dachte, dass alle Melusinen am Hof von Fontaine oder in Mérusea leben. Wie kommt es, dass du allein hier bist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831006,
					"content": "Hof von Fontaine? Mérusea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831007
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831007,
					"content": "Du scheinst ziemlich verwirrt zu sein. Hast du diese beiden Namen noch nie gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831008,
					"content": "Hof von Fontaine, Melusine ... Mérusea, Melusine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831009
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831009,
					"content": "Äh ... Erinnyes, Pahsiv, Zuhause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831010
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831010,
					"content": "Erinnyes, Pahsiv, schützen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831011
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831011,
					"content": "Warte mal. Hast du gerade gesagt, dass dies dein Zuhause ist und du es beschützt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831012,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831013
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831013,
					"content": "Aber kommen nicht alle Melusinen aus Mérusea?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831014
					]
				},
				{
					"id": 740831014,
					"content": "Genau! Seltsam ... Es gibt noch Melusinen, die an einem anderen Ort geboren wurden? Aber es gibt hier anscheinend keine anderen Melusinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831015,
					"content": "Pahsiv, lebst du hier ganz alleine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831016,
					"content": "Alleine? Melusine. Nur wie nett! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831017
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831017,
					"content": "Nur ... wie nett? Wen meinst du damit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831018,
					"content": "#Nur wie nett! Paimon, Paimon. {NICKNAME}, {NICKNAME}. Nur wie nett, nur wie nett!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831019
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831019,
					"content": "Und wer ist das genau?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831020
					]
				},
				{
					"id": 740831020,
					"content": "Pahsiv, meinst du, dass der Name dieser Person einfach „nur wie nett“ ist, so wie Paimon Paimon heißt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831021,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831022
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831022,
					"content": "Aha! So ist das. Hehe, Paimon hat doch gesagt, dass Paimon auch sehr schlau ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831023,
						740831024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831023,
					"content": "Ein sehr seltsamer Name.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831025
					]
				},
				{
					"id": 740831025,
					"content": "Nur wie nett, Pahsiv, Wissen, hellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831026
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831026,
					"content": "Hmm ... Willst du sagen, dass diese nette Person dir hilft, Dinge zu lernen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831027,
					"content": "Pahsiv! Sehr viel. Sprache, Wissen ... Sehr, sehr viel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831028
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831028,
					"content": "Ähm ... Irgendwie hat Paimon das Gefühl, dass es doch nicht so viel ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831029,
					"content": "Pahsiv, nur wie nett, schützen, hellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831030
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831030,
					"content": "Diese Person hilft dir auch, diesen Ort zu schützen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831031,
					"content": "Melusine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831032
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831032,
					"content": "Du hilfst ihr, diesen Ort zu beschützen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831033
					]
				},
				{
					"id": 740831033,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831034
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831034,
					"content": "So ist das also ... Wer ist diese Person eigentlich? Weshalb braucht sie deine Hilfe, um diesen Ort zu beschützen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831035,
					"content": "Zudem haben sich hier wirklich einige üble Dinge ereignet. Die Texte von der Steinplatte, die wir gesehen haben, wurden von jemandem weggekratzt. Und es gibt auch eine Menge Unreinheiten ... Gibt es hier irgendwelche Feinde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831036
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831036,
					"content": "Paimon neugierig, Pahsiv! Aber Zeit, sehr, sehr wenig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831037
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831037,
					"content": "Schlüssel, Schlüssel, Schlüssel, Platz, West. Hellen, hellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831038
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831038,
					"content": "Wir werden uns beeilen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831039
					]
				},
				{
					"id": 740831039,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831040
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831040,
					"content": "Pahsiv macht zwei Sprünge vor Freude in die Luft und geht etwas in Eile davon.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740831041
					]
				},
				{
					"id": 740831041,
					"content": "Anscheinend drängt wirklich die Zeit. Glücklicherweise haben wir bereits zwei Schlüssel. Lass uns mit Volldampf den dritten Schlüssel besorgen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831024,
					"content": "Ein sehr netter Name.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831025
					]
				}
			]
		},
