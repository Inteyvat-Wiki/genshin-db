			"dialogs": [
				{
					"id": 740820701,
					"content": "Ein kristallklarer Wassertropfen erschien auf dem Altar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740830102,
					"content": "Hm, dieser Wassertropfen ... Könnte dieser Wassertropfen ein Schatz sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830103,
					"content": "Er sieht nicht wie ein Schatz aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830104
					]
				},
				{
					"id": 740830104,
					"content": "Paimon findet das auch ... Schließlich haben wir ihn zu leicht bekommen ... Aber was ist das dann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830105,
						740830110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830105,
					"content": "Er ist vielleicht ein wichtiges Objekt, um den Dämonenkönig zu versiegeln.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830106
					]
				},
				{
					"id": 740830110,
					"content": "Vielleicht hat ihn jemand anderes hier abgelegt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830111
					]
				},
				{
					"id": 740830106,
					"content": "Was? Haben wir dann gerade etwas ganz Schlimmes getan?! Schnell, leg ihn zurück! Hoffentlich ist es nicht zu spät!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830107,
					"content": "Aah ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830108
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830108,
					"content": "Auweia! Der Dämonenkönig ist erschienen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830109,
					"content": "Dämonenkönig? Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830111,
					"content": "Was? Nein! Dann sind wir also Diebe, oder? Tut Paimon leid, wer auch immer das ist ... Wir sollten das Ding schnell wieder zurücklegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830112,
					"content": "Aah ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830113
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830113,
					"content": "Oh nein! Der Besitzer ist zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830114,
					"content": "Besitzer? Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830115,
					"content": "Puh ... Paimon hat sich zu Tode erschreckt ... Es ist nur eine Melusine ... Was machst du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830116,
					"content": "Schlüssel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830117
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830117,
					"content": "Was für ein Schlüssel? Ist dieser Wassertropfen etwa ein Schlüssel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830118,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830119
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830119,
					"content": "Ähm ... Ist dieser Wassertropfen Pahsiv?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830120,
					"content": "Melusine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830121
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830121,
					"content": "Herrje! Was soll das bedeuten? Ist dieser Wassertropfen eine Melusine? Paimon wird schwindelig, was ist das denn nun! Bist du eine Melusine oder nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830122,
					"content": "Pahsiv ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830123
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830123,
					"content": "Ähm ... Du bist ein Pahsiv? Oder heißt du Pahsiv? Warte, antworte nicht ... Du wirst Paimon nur noch mehr verwirren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830124,
					"content": "Paimon hat beschlossen, dich Pahsiv zu nennen, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830125,
					"content": "Melusine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830126
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830126,
					"content": "#{NICKNAME} ... Was sollen wir tun? Paimon hat nicht den blassesten Schimmer, was sie meint. Was redet sie da nur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830127,
					"content": "Du kannst uns verstehen, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830128
					]
				},
				{
					"id": 740830128,
					"content": "Pahsiv ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830129
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830129,
					"content": "Dieser Wassertropfen ist ein Schlüssel, richtig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830130
					]
				},
				{
					"id": 740830130,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830131
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830131,
					"content": "Du bist kein Mensch, richtig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830132
					]
				},
				{
					"id": 740830132,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830133
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830133,
					"content": "*räusper* ... Lass uns nicht plötzlich unhöflich sein, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830134,
					"content": "Ich bin kein Mensch, richtig?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830135
					]
				},
				{
					"id": 740830135,
					"content": "Me... Melusine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830136
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830136,
					"content": "Ah! Paimon hat es irgendwie kapiert! „Pahsiv“ bedeutet „Ja“ und „Melusine“ bedeutet „Nein“, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830137,
					"content": "Pahsiv! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830138
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830138,
					"content": "Dann ist Pahsiv also nicht dein Name ... Entschuldige, Paimon hat dich falsch angesprochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830139,
					"content": "Mögen ... Pahsiv ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830140
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830140,
					"content": "Gefällt dir dieser Name?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830141
					]
				},
				{
					"id": 740830141,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830142
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830142,
					"content": "#Klasse! Na dann nennt Paimon dich so, hehe! Du kannst Paimon einfach Paimon nennen. Und das ist {NICKNAME}. Wir freuen uns, dich kennenzulernen, Pahsiv! Paimon hat noch nie eine Melusine wie dich gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830143,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830144
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830144,
					"content": "Erinnyes ... Melusine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830145
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830145,
					"content": "... Erinnyes nein? ... Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830146,
					"content": "Ist etwas Schlimmes auf Erinnyes passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830147
					]
				},
				{
					"id": 740830147,
					"content": "Erinnyes, Melusine, jetzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830148
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830148,
					"content": "Pahsiv, Erinnyes, schützen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830149
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830149,
					"content": "Also, irgendetwas Schlimmes passiert auf Erinnyes und du willst es schützen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830150,
					"content": "#Paimon, {NICKNAME}, Erinnyes, hellen, hellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830151
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830151,
					"content": "Ähm ... Dieses Mal sind es fünf Wörter ... Erinnyes hellen ... Hm, du willst, dass wir die Insel erhellen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830152,
					"content": "Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830153
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830153,
					"content": "Du willst, dass wir dir „helfen“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830154
					]
				},
				{
					"id": 740830154,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830155
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830155,
					"content": "Oh, du willst also nur, dass wir dir helfen! Was für eine Erleichterung. Paimon weiß wirklich nicht, wie wir die ganze Insel beleuchten sollen, hehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830156,
					"content": "Hellen, hellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830157,
						740830161
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830157,
					"content": "Wird es eine Belohnung geben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830158
					]
				},
				{
					"id": 740830161,
					"content": "Also, wie sollen wir helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830158,
					"content": "Be...lohnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830159
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830159,
					"content": "#Ach komm schon, {NICKNAME}, Pahsiv kann kaum sprechen! Sie wird wohl keine andere Person finden, die ihr hilft. Lass uns ihr einfach helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830160,
					"content": "Also, wie sollen wir helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830162,
					"content": "Schlüssel, Schlüssel, Schlüssel, Zahl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830163
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830163,
					"content": "Ja und? Was ist die Anzahl der Schlüssel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830164
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830164,
					"content": "Schlüssel! Schlüssel! Schlüssel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830165
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830165,
					"content": "Drei Schlüssel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830166
					]
				},
				{
					"id": 740830166,
					"content": "Pahsiv! Schlüssel, Nebelpfad, Süd ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830167
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830167,
					"content": "Schlüssel, Quelle, Nord ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830168
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830168,
					"content": "Schlüssel, Trauerweide, Ost ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830169
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830169,
					"content": "Aha, so ist das also ... Paimon merkt sich mal ... Es gibt insgesamt drei Schlüssel, einen beim Nebelpfad im Süden, einen bei der Quelle im Norden und einen bei der Trauerweide im Osten ... Ist das so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830170,
					"content": "Schlüssel, Schlüssel, Schlüssel, Platz, West.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830171
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830171,
					"content": "Und es gibt drei weitere Schlüssel auf dem Platz im Westen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830172
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830172,
					"content": "Wir sollen die drei Schlüssel einsammeln und dann auf den Platz gehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830173
					]
				},
				{
					"id": 740830173,
					"content": "#Paimon, Melusine! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830174
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830174,
					"content": "#Pahsiv, du solltest nicht ständig Sachen sagen, die {NICKNAME} schlauer als Paimon aussehen lassen! Es ist ganz klar, dass Paimon und {M#er}{F#sie} mehr oder weniger gleichermaßen schlau sind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830175
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830175,
					"content": "Nun, wir haben bereits einen Schlüssel. Es scheint, dass wir nur noch zwei Schlüssel in die Finger bekommen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830176
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830176,
					"content": "Erinnyes, Melusine ... Pahsiv, schützen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830177
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830177,
					"content": "Sei beruhigt. Obwohl wir nicht wissen, was sich ereignet hat, werden wir dir helfen, Erinnyes zu beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830178
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830178,
					"content": "Paimon will aber noch einen Punkt hinzufügen, Pahsiv. Falls du etwas Goldenes, Rundes siehst, was niemand braucht oder eine Truhe, die auf den ersten Blick sehr wertvoll aussieht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830179
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830179,
					"content": "Wäre es super, wenn du uns Bescheid gibst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830180
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820780,
					"content": "Pahsiv kratzt sich ein bisschen verwirrt am Kopf, macht zwei Sprünge vor Freude in die Luft und geht etwas in Eile davon.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740830181,
					"content": "#Ah, sie hat sich direkt aus dem Staub gemacht. Anscheinend geht es um eine dringende Sache. {NICKNAME}, sollen wir jetzt die anderen beiden Schlüssel suchen gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
