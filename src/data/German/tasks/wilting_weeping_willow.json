					"content": "Ein kristallklarer Wassertropfen erschien auf dem Altar.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740830202
					]
				},
				{
					"id": 740830202,
					"content": "Toll, dann haben wir jetzt den dritten Schlüssel, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830203,
					"content": "Schlüssel, Schlüssel, Schlüssel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830204
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830204,
					"content": "Keine Spur, Pahsiv!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830205
					]
				},
				{
					"id": 740830205,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv! Schlüssel, Schlüssel, Schlüssel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830206
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830206,
					"content": "Platz, West!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830207,
					"content": "Hehe. Ist es das, was du sagen willst? Keine Sorge, wir gehen jetzt hin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
