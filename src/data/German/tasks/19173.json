					"nextDialogs": [
						191730602
					],
					"speakerTitle": "Neugieriger Dorfbewohner"
				},
				{
					"id": 191730602,
					"content": "#Ich habe gehört, {F#eine Reisende}{M#ein Reisender} soll das beendet haben. Kann ein Mensch so etwas überhaupt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neugieriger Dorfbewohner"
				}
			]
		},
