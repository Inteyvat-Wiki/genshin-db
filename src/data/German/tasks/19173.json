			"dialogs": [
				{
					"id": 191730701,
					"content": "Diese große Maschine sieht wirklich eindrucksvoll aus! Ist das etwa so ein „Ruinenwanderer“ aus den Legenden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191730702
