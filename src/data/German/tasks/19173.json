			"dialogs": [
				{
					"id": 191737101,
					"content": "„Tamimis Modifikation verlief problemlos. Das jetzige Tamimi kann durch Selbst-Aktualisierung alle möglichen Schwierigkeiten in den Ruinen bewältigen. Ich wünschte, du könntest es selbst sehen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737102
					],
					"speakerTitle": "Vergilbter Brief"
				},
				{
					"id": 191737102,
					"content": "„Während der Modifikation habe ich mich immerfort gefragt: Wenn die Verantwortung in deiner Hand wäre, hättest du es nicht noch besser gemacht?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737103
					],
					"speakerTitle": "Vergilbter Brief"
				},
				{
					"id": 191737103,
					"content": "„Immerhin bist du die talentierteste Studentin, die ich je sah.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vergilbter Brief"
				}
			]
		},
