			"dialogs": [
				{
					"id": 191737201,
					"content": "„Sehr geehrte Frau Faruzan,“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737202
					],
					"speakerTitle": "Ordentlich geschriebener Brief"
				},
				{
					"id": 191737202,
					"content": "„die Manuskripte, Notizen usw., die wir bei Tamimi gefunden haben, wurden alle zusammengetragen und transkribiert. Alle diese Werke sind mit Eurem Namen als Autorin gekennzeichnet.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191737203
					],
					"speakerTitle": "Ordentlich geschriebener Brief"
				},
				{
					"id": 191737203,
					"content": "„Es ist zu hoffen, dass sich auch in hundert Jahren noch Generationen von Studenten an Euren Namen erinnern werden, Frau Faruzan.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ordentlich geschriebener Brief"
				}
			]
		},
