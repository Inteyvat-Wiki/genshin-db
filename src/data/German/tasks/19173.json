			},
			"dialogs": [
				{
					"id": 191735301,
					"content": "„Vollautomatische Vorrichtung zur Bewässerung“ ... Frau Faruzan hat uns wirklich vor eine schwierige Aufgabe gestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735302
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 191735302,
					"content": "Meister, kann ich irgendwie behilflich sein? Ich könnte Material kaufen oder Schreibmaterial vorbereiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735303
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 191735303,
					"content": "Ach ... Ich erinnere mich, du musst heute noch einiges an Hausaufgaben erledigen, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735304
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 191735304,
					"content": "Ähm? Ja, ja, richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735305
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 191735305,
					"content": "Kümmere dich zuerst um deine Hausaufgaben und gehe etwas früher zu Bett. Deine größte Hilfe ist, Frau Faruzan keine Sorgen zu bereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735306
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 191735306,
					"content": "Oh ... na gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191735307
					],
					"speakerTitle": "Collei"
				},
				{
