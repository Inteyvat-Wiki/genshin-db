				"objectNames": [
					"Yuan Liang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070401,
					"content": "Hehe, der Schatz wird nur mir gehören ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070402
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070402,
					"content": "Die zwei Brüder sind so einfältig, nach nur zwei Sätzen sind sie bereits losgestürmt, hehehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070403
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070403,
					"content": "Was für ein Testament ist das? Darin stand bis auf einen Satz nichts Nützliches. Der Schatz ist in der Mine, hehehe. Und im Handumdrehen ist er mein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Liang"
				}
			]
		},
