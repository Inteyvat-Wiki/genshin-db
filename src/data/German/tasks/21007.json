			},
			"dialogs": [
				{
					"id": 210070501,
					"content": "Weg, alles ist weg ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070502
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070502,
					"content": "Yuan Qing, Yuan Liang und Yuan Cheng, ihr törichten Kinder, seht nochmal nach und denkt etwas mehr nach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Hong"
				}
			]
		},
		{
			"id": 2100706,
			"completionStepIds": [
				2100710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100708",
