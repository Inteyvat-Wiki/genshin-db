			},
			"dialogs": [
				{
					"id": 210070201,
					"content": "Verdammt! Was habe ich nur angerichtet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070202
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070202,
					"content": "Es war nicht einfach, sich an ihnen vorbeizuschleichen, um als erster in die Mine zu gelangen und dann den Schatz zu finden. Wo kommen denn die ganzen Monster nur her ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070203
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070203,
					"content": "Mist, so ein Mist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Qing"
				}
			]
		},
