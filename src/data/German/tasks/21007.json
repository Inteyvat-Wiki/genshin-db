						],
						"stepId": 2100708,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuan Qing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070601,
					"content": "Ooh, ja, das sind genau diese Leute ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210070602,
					"content": "Ein Baum ist einsam ohne seinen Wald ... Haha, ja, eine Person ohne Rückhalt ist genauso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070603
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070603,
					"content": "Üppige, rote Blätter, kein Wind berührt sie, dennoch tanzen sie ... Wenn ich meinen Brüdern und meinem alten Herrn doch nur trauen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070604
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070604,
					"content": "Raschelnde, rote Blätter, vom Winde verweht ... Mein Schatz, mein Schatz, deinetwegen habe ich nun nichts mehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070605
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070605,
					"content": "Dickes, schweres Holz, behütet die Familie ... Kinder, wir sind alle eine Familie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070606
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070606,
					"content": "Ihr denkt doch alle, ich hätte meinen Schatz in der Mine versteckt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070607
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070607,
					"content": "Aber wo habe ich denn wirklich einen Schatz versteckt ... Erinnert ihr euch noch an den Baum? Den Baum, den wir zusammen als Familie gepflanzt haben, als ihr noch klein wart?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070608
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070608,
					"content": "Jedes Jahr komme ich zu diesem Baum und vergrabe etwas. Ich hoffe, wenn ihr eines Tages groß seid, können wir alles gemeinsam als Familie wieder ausgraben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070609
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070609,
					"content": "Wenn es so weit ist, nutzen wir die vergrabenen Dinge und kaufen uns davon was Leckeres, ein bisschen Wein dazu und die ganze Familie kann über alte Erinnerungen plaudern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070610
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070610,
					"content": "Kinder, meine Kinder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Hong"
				}
			]
		}
	]
}