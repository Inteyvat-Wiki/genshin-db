				"objectNames": [
					"Yuan Cheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070301,
					"content": "Das sind mir schöne Brüder, scheren sich nur darum, die besten Teile für sich zu beanspruchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070302
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070302,
					"content": "Der alte Mann stand wie ein Idiot da und zog es vor, sich nicht zu kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070303
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070303,
					"content": "Sie wissen es nur noch nicht, dass der Schatz in der Mine liegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070304
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070304,
					"content": "Ich muss den Schatz schnell holen und dann gehe ich damit an einen weit entfernten Ort ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Cheng"
				}
			]
		},
		{
