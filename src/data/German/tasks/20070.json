			"dialogs": [
				{
					"id": 200700301,
					"content": "Wie steht es um die Blumen, die ihr zuvor auf dem Drachengrat gelagert habt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700302
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700302,
					"content": "Ich habe sie alle hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700303
					]
				},
				{
					"id": 200700303,
					"content": "Alle? Das ist toll! Lass mich sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700304
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700304,
					"content": "Hehe, nicht schlecht. Hmm ... Diese Methode scheint wirklich zu funktionieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700305
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700305,
					"content": "Das einzige Problem ist, dass der Drachengrat sehr weit von Mondstadt entfernt liegt. Ich kann dich auch nicht jedes Mal belästigen. Ich muss in Zukunft einen anderen Weg finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700306
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700306,
					"content": "Trotzdem vielen Dank! Hier ist deine Vergütung, bitteschön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
