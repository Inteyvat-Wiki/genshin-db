			"dialogs": [
				{
					"id": 200700101,
					"content": "Wie steht es um die Blumen, die ihr zuvor auf dem Drachengrat gelagert habt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700102,
					"content": "Ich habe nur einen Behälter geborgen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700103
					]
				},
				{
					"id": 200700103,
					"content": "Die anderen ließen sich nicht bergen? Ähm ... Na gut, in Ordnung. Es ist ja ziemlich schwer, die Bedingungen auf diesem Berg vorherzusagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700104,
					"content": "Aber wenn wir nur einen haben, dann können wir keine Vergleiche anstellen. Ich vermute, wir müssen einfach auf eine neue Gelegenheit warten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700105,
					"content": "Danke, dass du dir trotzdem die Mühe gemacht hast. Hier, ich habe dies als Gegenleistung vorbereitet. Vielleicht werde ich auch in Zukunft deine Hilfe in Anspruch nehmen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
			"id": 2007002,
			"completionStepIds": [
				2007007
			],
