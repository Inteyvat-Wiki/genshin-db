					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200201,
					"content": "Hoffen wir, dass alles reibungslos abläuft. Je früher wir diese Angelegenheit regeln, desto besser. Wer weiß, was passieren wird, wenn wir weiter zögern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7212003,
			"completionStepIds": [
				7212009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212009",
							"2"
						],
						"stepId": 7212009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200301,
					"content": "Also gut. Hast du unsere Straßen überprüft?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200302,
					"content": "Sie sind jetzt so glatt wie nur möglich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200303
					]
				},
				{
					"id": 721200303,
					"content": "Na gut. Dann lass uns nach einer kurzen Wartezeit aufbrechen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200304,
					"content": "He. Bist du ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200305
					]
				},
				{
					"id": 721200305,
					"content": "Ich ... Ich denke nach! Ich denke an all die Dinge, die möglicherweise passieren könnten, verstehst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200306,
					"content": "Zum Beispiel, was wir tun, wenn diese maskierten Verrückten den Kern bereits extrahiert haben, wenn wir eintreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200307,
					"content": "Und dann könnten sie ihn in einen Ruinenwächter schieben, wodurch dieser durchdreht und uns alle zerfetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200308
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200308,
					"content": "Oder vielleicht taucht eine Art Elementarkreatur auf, während wir den Mikage-Hochofen reinigen, und verschlingt den Kern in einem einzigen Biss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200309
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200309,
					"content": "Und im schlimmsten Fall könnte diese legendäre Schlange diese Gelegenheit nutzen, um sich selbst wiederzuerwecken. Dann wären wir verdammt! Das Spiel wäre vorbei! Game over!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200310,
						721200311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200310,
					"content": "Nimm dich zusammen, Xavier ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				},
				{
					"id": 721200312,
					"content": "Ah! Ähm, tut mir leid, ich ... Meine alten Gewohnheiten kommen wieder zum Vorschein. Ich stelle mir immer die schlimmsten Szenarien vor ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200313,
					"content": "Ich werde einige Pläne machen und wenn die Zeit gekommen ist, lass uns gehen und dem ein Ende setzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200314,
					"content": "Hoffentlich geht alles gut ... hoffentlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200311,
					"content": "Es wird nicht so dramatisch sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				}
			]
		},
