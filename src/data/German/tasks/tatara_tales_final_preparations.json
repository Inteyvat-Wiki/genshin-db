			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200101,
					"content": "Ha, großartig! Die vorherigen Tests verliefen sehr reibungslos. Die Onikabuto sind vollständig gereinigt worden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200102,
					"content": "Na dann, lass uns ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200103
					]
				},
				{
					"id": 721200103,
					"content": "Alles, was wir jetzt noch tun müssen, ist, unsere Eintrittsroute zu bestätigen, und wir können ernsthaft beginnen. Allerdings müssen wir den Fatui aus dem Weg gehen ... Es scheint, dass wir den langen Weg nehmen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200104,
					"content": "Dieser Kerl ist ziemlich sperrig, also wäre es am besten, wenn wir dafür sorgen, dass es glatte Wege für uns gibt, wenn wir ihn im Inneren bewegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200105,
					"content": "Daher möchte ich, dass du den Mikage-Hochofen erneut betrittst, um ihn zu untersuchen. Solltest du auf kaputte Pfade stoßen, hilf bitte, sie ein wenig wiederherzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200106,
					"content": "Ich muss mich noch für eine Route entscheiden, aber mehr Straßen für uns offen zu haben, kann sicher nicht schaden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200107,
					"content": "Ich bin kein Experte im Reparieren von Straßen, weißt du.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200108
					]
				},
				{
					"id": 721200108,
					"content": "Du musst sie nicht wieder auf ... nun ja, perfekte Zuverlässigkeit bringen. Lege einfach eine Schicht Holzbretter über den Weg, damit wir diesen Apparat hinüber bewegen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200109,
					"content": "Ah, du kannst dir einfach die Holzbretter aus der Nähe holen. Ich werde hierbleiben und versuchen, unsere Maschine so zuverlässig wie möglich zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7212002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
