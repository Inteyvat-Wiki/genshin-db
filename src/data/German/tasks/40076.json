				{
					"id": 400761601,
					"content": "Nun, da sind wir wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761602
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761602,
					"content": "Paimon hat das Gefühl, die Geschichte ist noch nicht zu Ende, also weiter mit der Expedition!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
