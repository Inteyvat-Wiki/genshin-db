			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Kaedehara Kazuha",
					"Fischl",
					"Oz",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400760901,
					"content": "Ooh! Hier ... Hier ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760902
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760902,
					"content": "Noch ein Haus von Mondstadt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760903
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760903,
					"content": "Wie sind wir in mein Haus gekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760904
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760904,
					"content": "Dein Haus? Ist das dein Zuhause?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760905
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760905,
					"content": "Oh, das kommt wirklich unerwartet ... Ich habe gehört, dass Megistus eher bescheiden gelebt hat, aber dieses Haus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760906
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760906,
					"content": "Die Bücher auf dem Boden sind mit Preisschildern versehen, „Exklusiv, nur 990.000 Mora ...“ Hä?! Sind die so teuer?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400760907,
					"content": "Hier gibt es auch viele teure gebundene Bücher ... Ist das das Zimmer einer Astrologin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760908
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400760908,
					"content": "Das Zimmer ist sehr gut ausgestattet ... Dieses Haus kann nicht billig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760909,
						400760910
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760909,
					"content": "Mona, bist du so reich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				},
				{
					"id": 400760911,
					"content": "Du, ich habe nur ab und zu kein Bargeld, aber ich bin nicht wirklich arm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760912
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760912,
					"content": "Bist du nicht? Ich habe dich zum Essen eingeladen und dich sogar zu mir nach Hause zum Essen mitgenommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760913
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760913,
					"content": "Mein Fräulein, achtet auf Eure Worte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760914
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760914,
					"content": "Ah, ähem! Dir wurde gewährt, mir, der Prinzessin, in die Kaiserstadt des Immernachtreichs zu folgen, um dem Kaiser und der Kaiserin der Verurteilung zu huldigen. Wie kannst du es wagen, ein so wichtiges Ereignis zu vergessen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760915
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760915,
					"content": "Ah ja, die Eintöpfe und der Aufschnitt deiner Mutter waren köstlich! Mmmh, auf einmal möchte ich die Gerichte nochmal essen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760916
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760916,
					"content": "Megistus, dies ist nicht der richtige Zeitpunkt, um über Essen zu reden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760917
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760917,
					"content": "Ist es ein Gericht aus Mondstadt? Das würde ich gern probieren! Ich habe gehört, dass es in Mondstadt sehr gutes Essen gibt, vor allem Fleischgerichte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760918
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400760918,
					"content": "Hmpf, dann gewähre ich euch die Gnade, und das nächste Mal dürft ihr die Prinzessin zu dem Kaiser und der Kaiserin begleiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760919
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400760919,
					"content": "#Wirklich? He, {NICKNAME}, lass uns auch mitgehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400760920,
					"content": "Also es ist schon eine Weile her, dass ich meine Freunde besucht habe, und ich bin geneigt, mitzukommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760921
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760921,
					"content": "Hm ... Sollte ich im Voraus Mitbringsel vorbereiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760922
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400760922,
					"content": "Sie sind beide unkompliziert und liebenswürdig, solche Sachen sind ihnen nicht wichtig. Aber wie du willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760923
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760923,
					"content": "Wenn ihr hingeht, müsst ihr unbedingt den Aufschnitt probieren, der soll ihre Spezialität sein, sehr sehr gut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760924
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760924,
					"content": "Sollten wir nicht lieber zuerst das Rätsel lösen? Schon als ich das Haus betrat, wurde ich auf das Dekor aufmerksam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760925
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400760925,
					"content": "Oh, stimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400760910,
					"content": "Es ist meine Schuld, dass ich das nicht erkannt habe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				}
			]
		},
		{
			"id": 4007613,
			"completionStepIds": [
				4007613
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007613",
							"2"
						],
						"stepId": 4007613,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona",
					"Xinyan",
					"Fischl",
					"Kaedehara Kazuha",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761301,
					"content": "Wir sind wieder hier. Das heißt, wir haben die Illusion jetzt endgültig verlassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761302,
					"content": "Komisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761303
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761303,
					"content": "In meiner Illusion gab es die Hinweise auf die Fatui und den Apparat nicht ... Bedeutet das, dass diese Sachen nichts mit ihnen zu tun haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761304,
					"content": "Oder sind diese Illusionen, die uns beschäftigen, von Natur aus keine „Prozesse“, sondern „Ergebnisse“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761305,
					"content": "Äh, was soll das heißen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761306,
					"content": "Das heißt, diese Illusionen sind keine Hinweise, die uns zur Lösung des Rätsels führen, sondern sie sind einfach das Ergebnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761307,
					"content": "Irgendjemand hat etwas getan, um diese Illusionen in die Welt zu bringen. Da es sich um etwas handelt, das von jemandem gemacht wurde, kann es uns natürlich auf nichts hinweisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761308
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761308,
					"content": "Vielmehr sind diese Illusionen nur für uns selbst relevant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761309
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761309,
					"content": "Reine Selbstdarstellung also ... Hmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761310
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761310,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761311
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761311,
					"content": "Leute, vielleicht sollten wir die ganze Sache noch einmal überdenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761312
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761312,
					"content": "#An dem Tag, an dem ich auf der Insel gelandet bin, habe ich mit {NICKNAME} das Lager der Fatui untersucht. Dort gab es einen seltsamen Apparat, neben dem die Fatui standen, vollkommen im Delirium.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761313
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761313,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761314
					]
				},
				{
					"id": 400761314,
					"content": "Der Forscher, mit dem wir sprachen, behauptete, der Apparat sei nur eine industrielle Erfindung der Fatui, und versprach, uns in Ruhe zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761315
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761315,
					"content": "Ja, ja, der dicke Kerl mit dem Hut sah aus, als wäre er nicht ganz wach, und hat ständig Blödsinn geredet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761316,
					"content": "Ich habe mich gefragt, ob es möglich ist, dass „in Wahnsinn verfallen“ und „Illusionen generieren“ zwei verschiedene Ergebnisse sind, die durch den Apparat erzeugt werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761317
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761317,
					"content": "Und alles hat etwas mit diesem beschädigten Apparat zu tun. Aber es ist nicht der Apparat, der für die unterschiedlichen Ergebnisse zuständig ist, sondern die betroffenen Menschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761318
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761318,
					"content": "...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761319
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761319,
					"content": "Also es ist tatsächlich schwierig, zwischen Träumen und Illusionen zu unterscheiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761320
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761320,
					"content": "Willst du damit sagen, dass wir uns in mancher Hinsicht von ihnen unterscheiden und daher von anderen Ergebnissen betroffen sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761321
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761321,
					"content": "Richtig. Und nach dem, was ich in den letzten Tagen gesehen habe, denke ich, dass der Unterschied zwischen uns und diesen Menschen darin besteht, dass wir einen viel stärkeren und entschlosseneren Willen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761322
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761322,
					"content": "... Ja, das stimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761323
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761323,
					"content": "Wer willensstark ist, verfällt nicht in Wahnsinn und generiert daher nur Illusionen, während diejenigen, die leicht zu brechen sind, eine so stabile Illusion nicht verlassen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761324
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761324,
					"content": "Du meinst also: Wir sollten sofort zum Lager der Fatui zurückkehren und den Apparat zerstören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761325,
					"content": "Nein, es geht mehr um „Reparieren“ als um „Zerstören“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761326
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761326,
					"content": "Das Fräulein meint, dass eine überstürzte Zerstörung des unbekannten Apparates schwerwiegendere Folgen nach sich ziehen könnte, weshalb es besser sei, zunächst einen Weg zu suchen, ihn zu reparieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761327
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400761327,
					"content": "Nun gut, man kann nicht vorsichtig genug sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761328,
					"content": "Wenn ich richtig liege, beeinflusst dieser Apparat wahrscheinlich das menschliche Gehirn, wir sollten also besser vorsichtig damit umgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761329
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761329,
					"content": "Dann gehen wir jetzt hin! Carpe diem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4007615,
			"completionStepIds": [
				4007615
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007615",
							"2"
						],
						"stepId": 4007615,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fischl",
					"Oz",
					"Mona",
					"Kaedehara Kazuha",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761501,
					"content": "So eine herrliche Aussicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761502
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400761502,
					"content": "Ich muss zugeben, dass du des Titels einer begabten Astrologin würdig bist. Megistus, du bist wahrlich der beste Magier, den das Immernachtreich je hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761503
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400761503,
					"content": "Danke, aber wie viele Jahre gibt es das Immernachtreich gerade ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761504
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761504,
					"content": "... Die Sterne sind wie kostbare Diamanten und der Mond ist wie eine Perle. Dies ist der weiteste Sternenhimmel, den ich je gesehen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761505
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400761505,
					"content": "Es ist wunderschön ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761506
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761506,
					"content": "Um eine solche Illusion zu haben, muss Mona auch ein weites und endloses Meer von Sternen in ihrem Herzen tragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761507
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400761507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761508,
					"content": "Mona, was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761509
					]
				},
				{
					"id": 400761509,
					"content": "... Ich denke, dass dies etwas ist, zu dem wir aufschauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761510,
					"content": "Der Sternenhimmel ist sehr schön. Und ich könnte sogar sagen, dass er prächtiger ist als das, was ich normalerweise in meinen Visionen sehe, wenn ich wahrsage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761511
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761511,
					"content": "Jeder dieser Sterne befindet sich an der richtigen Stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761512,
					"content": "... Das ist definitiv meine Illusion, und nur hier kann ich ein solches Schauspiel sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761513
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761513,
					"content": "Ein Schauspiel? Warum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400761514,
					"content": "Wusstet ihr das nicht? Die Sterne von Teyvat sind so wunderbar, dass in ihnen die Antworten der ganzen Welt zu stehen scheinen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761515,
					"content": "„Wann wird mein verschwundener Sohn nach Hause zurückkommen?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761516
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761516,
					"content": "„Ist diese Person in mich verliebt?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761517
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761517,
					"content": "„Werde ich wieder gesund?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761518
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761518,
					"content": "Was auch immer geschieht, es wird in der Bahnen von Stella Fortuna aufgezeichnet werden. Und von allen Menschen auf der Welt wird ein guter Prozentsatz von der Bahn abgekommen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761519
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761519,
					"content": "Der Stern, der dich repräsentiert, befindet sich in seiner Bahn, was bedeutet, dass du Gesundheit, Glück und Frieden erlangen wirst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761520
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761520,
					"content": "Wenn dein Stern umgekehrt vom Kurs abweicht, geht alles schief.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761521
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761521,
					"content": "Der Sternenhimmel sieht in den Wahrsagungen also niemals so aus. Manchmal gehen die Sterne verloren oder fallen herunter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761522
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761522,
					"content": "... Ich will, dass alle Glück erfahren, und ich will, dass alle auf dem richtigen Weg sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761523
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761523,
					"content": "Zu diesem Zweck gebe ich Ratschläge und sage die Wahrheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761524
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761524,
					"content": "Ich weiß, dass es sinnlos ist, denn die Schicksale der Menschen manifestieren sich am Nachthimmel. Ich bin nur einer von ihnen und kann nichts ändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761525
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761525,
					"content": "Trotzdem ... Außerhalb der Astrologie, außerhalb der Worte, die die Wahrheit offenbaren, habe ich immer noch eine etwas unrealistische Illusion in mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761526
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761526,
					"content": "Man muss den Weg der Wahrheit beschreiten, aber ... sagen wir mal, ich überschätze mich, und ich erwarte und glaube immer noch an „Wunder“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761527
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761527,
					"content": "Dieses riesige Sternenmeer enthält deine, meine, seine Sterne, die Sterne aller Menschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761528
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761528,
					"content": "Wie groß ist die Wahrscheinlichkeit, dass sich die Sterne treffen? Sind diese Begegnungen die schönsten „Wunder“ des Schicksals? ... Ich weiß es nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761529
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761529,
					"content": "Aber es wird immer einen Platz für dich und mich am Sternenhimmel von Teyvat geben. Auch wenn die Astrologie absolut rational ist ... Das Schicksal ist unbeständig, grausam und romantisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761530
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761530,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761531
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761531,
					"content": "Mona, vorhin schienst du nachdenklich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761532
					]
				},
				{
					"id": 400761532,
					"content": "Hast du jetzt die Antwort gefunden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761533
					]
				},
				{
					"id": 400761533,
					"content": "... Ich glaube, ich weiß, was sich in diesen Sternen verbirgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761534
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400761534,
					"content": "... „Jetzt werde ich mein Schicksal in die Hand nehmen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
