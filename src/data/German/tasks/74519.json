					"Noelle"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745190401,
					"content": "Ah ... Hallo! Bist du hier, um Jean zu treffen? Oder ... gibt es etwas, wobei ich dir helfen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190402,
						745190403
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190402,
					"content": "Ich schaue mich nur ein bisschen um.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				},
				{
					"id": 745190404,
					"content": "Ich führe gerade die routinemäßige Großreinigung im Bürobereich des Ritterordens durch. Der Staub ist bereits weitestgehend beseitigt, und als Nächstes werde ich die alten Akten sortieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190405
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190405,
					"content": "Die Dokumente haben sich über lange Zeit angesammelt. Ich denke, wenn ich sie ordentlich nach Kategorien sortiere, wird es für alle viel einfacher sein, sie später wiederzufinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190406
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190406,
					"content": "Außerdem kann ich viel lernen, wenn ich die Aufzeichnungen der Vorgänger sortiere. Für mich ist das auch eine Art Training!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190407
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190407,
					"content": "Du bist wie immer sehr zuverlässig und gewissenhaft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190408
					]
				},
				{
					"id": 745190408,
					"content": "Das ist meine Pflicht. Außerdem machen du und die anderen im Ritterorden ständig Fortschritte, und ich möchte auch so schnell wie möglich zu euch aufschließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190409,
						745190410
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190409,
					"content": "Zur Erinnerung an diese Entschlossenheit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190411,
					"content": "Hä? Du möchtest ein Foto von mir machen? Ich ... freue mich natürlich sehr! Aber ich habe gerade erst mit dem Putzen aufgehört und bin noch voller Staub ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190412,
						745190413
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190412,
					"content": "Ich möchte genau das fotografieren – wie fleißig du arbeitest, Noelle!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190414,
					"content": "D... Diese Anrede steht mir noch nicht zu! Aber wenn du ein Foto von mir machen möchtest ... dann fühle ich mich geehrt, auch wenn ich noch voller Staub bin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190415
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190415,
					"content": "Drück dann bitte den Auslöser, wenn du denkst, dass der richtige Moment gekommen ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190413,
					"content": "Das ist der „entscheidende Moment“ für die Rittermagd!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190410,
					"content": "Lass mich ein Foto von dir machen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190403,
					"content": "Womit bist du gerade beschäftigt, Noelle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				}
			]
		}
	]
}