			},
			"dialogs": [
				{
					"id": 735150101,
					"content": "#{F#Abenteurerin}{M#Abenteurer}, da bist du ja. Wir wollten gerade mit der Montage beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150102
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150102,
					"content": "Wenn alles glattgeht, kann dieses Biest heute etwas erleben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150103,
					"content": "Während der regulären Ladephase könnten wieder Monster auftauchen. Achte in diesem Fall bitte besonders darauf, dass die Ladeeinheit nicht beschädigt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150104,
						735150105
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150104,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				},
				{
					"id": 735150106,
					"content": "#Vielen Dank, {F#Abenteurerin}{M#Abenteurer}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150107,
					"content": "Oh ... Mir kommt da eine tolle Idee! Du hattest wegen der „Wenut-Kammerjägerkanone“ so viel um die Ohren, deswegen sollst du die Ehre ... für den ersten Test haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150108,
						735150110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150108,
					"content": "Willst du das nicht selbst machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150109
					]
				},
				{
					"id": 735150109,
					"content": "Ich bin zufrieden, wenn ich die Schüsse landen sehe! Wenn jemand anderes den Zünder bedient, können wir außerdem die Schüsse in ihrer ganzen Pracht bewundern ... *hust*! Oder so!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150112,
					"content": "Du musst den Aufladeapparat nur vor den Monstern beschützen. Wenn er vollständig geladen ist und sich der Wenut zeigt ... Dann verpasst du der Kanone einen harten Schlag!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150113
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150113,
					"content": "Den Rest erledigen das Zündmodul und die Korrektureinrichtung für dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150114,
					"content": "#Das klingt ja toll ... {NICKNAME}! Paimon kommt auch mit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735150115,
					"content": "Gut, ich bediene sie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150116
					]
				},
				{
					"id": 735150116,
					"content": "Hehe, dann machen wir es so! Ich erkläre dir mal, wie es im Einzelnen abläuft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150110,
					"content": "Ich weiß nicht, wie man sie bedient ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150111
					]
				},
				{
					"id": 735150111,
					"content": "Keine Sorge, bei ihrem Entwurf bin ich dem Prinzip der einfachen Handhabung getreu gefolgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150105,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				}
			]
		}
	]
}