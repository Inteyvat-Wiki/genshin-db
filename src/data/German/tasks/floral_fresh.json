				{
					"id": 200690325,
					"content": "Dann suche bitte ein Gebiet <color=#00E1FFFF>mit Wasser auf dem Berg</color>, entweder einen See oder einen Teich. Vergrabe sie einfach am Rand des Gewässers.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690326
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690326,
					"content": "Sei bitte sehr vorsichtig, um sie diesmal nicht zu beschädigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690321,
					"content": "Wo soll ich sie denn versenken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690322
					]
				},
				{
					"id": 200690311,
					"content": "Am besten verkauft man sie am selben Tag.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690312
					]
				},
				{
					"id": 200690312,
					"content": "Das wäre das Beste. Aber es gibt immer ein oder zwei Blumen, die sich nicht verkaufen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690313
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690313,
					"content": "Ich weiß, es sind nur ein oder zwei, aber ich will sie nicht so einfach welken lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690314
					],
					"speakerTitle": "Flora"
				}
			]
		},
