			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200690101,
					"content": "Diese Blumen sehen auch nicht so gut aus. Wie schade ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690102,
					"content": "Gibt es ein Problem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690103
					]
				},
				{
					"id": 200690103,
					"content": "Tja, viele Leute kaufen meist einzelne Blumen, um sie zu verschenken, also schneide ich normalerweise einige Blumen speziell dafür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690104,
					"content": "Aber die Blumen, die ich zuschneide, bleiben nicht lange frisch. Wenn ich sie nicht alle verkaufe, verwelken sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690105,
					"content": "Ich habe schon viele Methoden ausprobiert, aber die Blumen zerfallen trotzdem am Ende des Tages.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690106
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690106,
					"content": "Ich frage mich, ob man diese Blumen irgendwie länger frisch halten kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690107,
						200690111
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690107,
					"content": "Frisch halten, hast du gesagt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690108
					]
				},
				{
					"id": 200690108,
					"content": "Ich hörte Sara vom Hirschjäger sagen, dass sie nicht verwendete Zutaten an einem kühlen Ort aufbewahrt oder mit Eisblöcken konserviert haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690109
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690109,
					"content": "Ich habe diese Verfahren auch schon probiert, aber Blumen, die mithilfe von Eisblöcken gelagert werden, sehen am Ende immer seltsam aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690110
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690110,
					"content": "Sie sind zwar nicht verwelkt, aber ich würde sie auch nicht als frisch bezeichnen ... So oder so, sie sind nicht mehr vorzeigbar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690114,
					"content": "Ich habe viele Leute gefragt und Sayid ... Du kennst ihn doch, oder? Er ist dieser Gelehrte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690115
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690115,
					"content": "Eines Tages kam er, um Blumen zu kaufen, und erzählte mir, dass er einst in einem Buch darüber las, wie man Blumen gekühlt lagert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690116
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690116,
					"content": "Es geht insbesondere darum, einen Behälter zur Aufbewahrung der Blumen zu benutzen, bevor dieser Behälter neben die Eisblöcke gestellt wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690117
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690117,
					"content": "Er hat auch erwähnt, dass ich einige Experimente durchführen sollte und dass der geeignetste Ort dafür der Drachengrat mit seinen niedrigen Temperaturen wäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690118
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690118,
					"content": "Aber ich hörte, dass der Drachengrat ein sehr gefährlicher Ort wäre. Deshalb konnte ich keine Abenteurer finden, die mir so kurzfristig helfen wollten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690119
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690119,
					"content": "#{F#Reisende}{M#Reisender}, kannst du mir helfen, diese drei Blumenbehälter im Schnee des Drachengrats zu versenken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690120,
						200690121
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690120,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690122,
					"content": "Danke für deine Hilfe! Lass mich nachdenken ... Ich habe gehört, dass der Drachengrat riesig ist und viele verschiedene Regionen hat. Das könnte zu sehr unterschiedlichen Ergebnissen führen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690123
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690123,
					"content": "Vielleicht wäre ein Vergleich angesagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690124
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690124,
					"content": "Bitte hilf mir, diese Blumen <color=#00E1FFFF>neben die Statue der Sieben</color> zu legen, <color=#00E1FFFF>neben dem Gewässer</color> und dann ... <color=#00E1FFFF>an einem Höhleneingang</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690121,
					"content": "Wo soll ich sie denn versenken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690111,
					"content": "Am besten verkauft man sie am selben Tag.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690112
					]
				},
				{
					"id": 200690112,
					"content": "Das wäre das Beste. Aber es gibt immer ein oder zwei Blumen, die sich nicht verkaufen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690113
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690113,
					"content": "Ich weiß, es sind nur ein oder zwei, aber ich will sie nicht so einfach welken lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				}
			]
		},
