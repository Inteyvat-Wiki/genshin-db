					"nextDialogs": [
						206010804
					]
				},
				{
					"id": 206010804,
					"content": "Hast du etwa mit ihm gekämpft? So hat er sich also verletzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010805
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010805,
					"content": "Nun, tapfer ist eine Sache, aber ich wünschte, er wäre mal ein bisschen nüchterner. Nur der lebende Abenteurer ist ein echter Abenteurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010806
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010806,
					"content": "#{F#Reisende}{M#Reisender}, du und Jack, ihr verdient beide Anerkennung für euren Mut, dies soll euch gehören, eine Prämie für euer Abenteuer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				},
