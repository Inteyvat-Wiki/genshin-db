				{
					"id": 206010701,
					"content": "Da bist du ja wieder, Jack ist auch zurück, aber er humpelt etwas ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010702
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010702,
					"content": "Was ist denn passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010703
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010703,
					"content": "Jack wurde aus Übermut verletzt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010704
					]
				},
				{
					"id": 206010704,
					"content": "Das habe ich mir gedacht, er hört einfach nicht zu und erinnert sich nie an das was ich ihm sage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010705
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010705,
					"content": "Ich verstehe ja, dass er sich beweisen will, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010706
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010706,
					"content": "Egal, jetzt weiß ich alles was ich wissen muss. Ich werde mit Jack darüber reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010707
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206010707,
					"content": "Dies ist für dich, eine Art Abenteuer Prämie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
