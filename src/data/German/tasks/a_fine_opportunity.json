			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010601,
					"content": "Ich nehme an, du hast sie beseitigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010602
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010602,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010603
					]
				},
				{
					"id": 206010603,
					"content": "Du bist wirklich sehr stark. Wenn ich nur so herausragen könnte wie du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010604
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010604,
					"content": "Ich würde auch gerne Legenden vom Drachentöten und Weltretten hinterlassen, aber am Ende konnte ich nicht einmal ein Rudel Hilichurle besiegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010605
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010605,
					"content": "Uh ... Jedenfalls, ich ... Es ist beschämend, aber ich muss dich etwas fragen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010606
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010606,
					"content": "Ich bin tatsächlich deswegen zum Tempel der Tausend Winde gekommen, weil ich bald einen Abenteurer-Einstufungstest mache ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010607
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010607,
					"content": "Ich dachte, die Einstufung wäre viel angenehmer, wenn ich dieses Mal meine Sachen vorzeigen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010608
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010608,
					"content": "Ich hätte nie gedacht, dass ich nicht nur nichts dafür vorzeigen kann, sondern auch noch fast mein Leben dabei verliere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010609
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010609,
					"content": "K... kann ich dich bitten, Cyrus nichts davon zu erzählen? Ich säße wirklich in der Tinte, sollte das meinen Rang beeinflussen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010610,
						206010612
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010610,
					"content": "Na gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010611
					]
				},
				{
					"id": 206010611,
					"content": "Danke dafür! Ich verspreche, ich werde in der Zukunft nicht so rücksichtslos sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010612,
					"content": "Das ist nicht richtig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010613
					]
				},
				{
					"id": 206010613,
					"content": "Ich weiß, dass es das nicht ist. Und Cyrus sagt immer, dass die Abenteurer ehrlich zu sich selbst sein sollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010614
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010614,
					"content": "Aber ... *seufz* Vergiss es. Ich hoffe, er wird nicht zu sauer auf mich sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
