				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206010501,
					"content": "*flüsternd* Das ... tut weh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010502
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010502,
					"content": "Dank dir vielmals. Ich dachte, ich käme heute nicht nach Hause ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010503
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010503,
					"content": "Wie fühlst du dich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010504
					]
				},
				{
					"id": 206010504,
					"content": "Ha, es ist nur ein bisschen ... *knurr* verletzt! Nur ein bisschen. Mir geht’s gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010505
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010505,
					"content": "Im Lager uns habe ich eine Gruppe Hilichurle entdeckt, die sich dort gesammelt haben. Ich habe mir gedacht, dass sie etwas im Schilde führen. Also bin ich ihnen gefolgt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010506
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010506,
					"content": "... aber ich bin ihnen zu nahe gekommen und sie haben mich entdeckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010507
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010507,
					"content": "Mach dir nichts draus, oder aus mir. Bitte hilf mir, diese Hilichurle zu beseitigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010508
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010508,
					"content": "Es werden immer mehr. Wir müssen ihre Pläne vereiteln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010509
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010509,
					"content": "Und ich ... ich kann mich um mich selbst kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2060106,
			"completionStepIds": [
				2060108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
