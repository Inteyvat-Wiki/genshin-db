			},
			"dialogs": [
				{
					"id": 20050801,
					"content": "Dieses Mal haben wir uns wirklich übertroffen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050802
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050802,
					"content": "All diese Samurai-Häuser quellen über vor Zeug, haha! Da haben wir voll ins Schwarze getroffen, sieht man von dem einen ab ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050803
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050803,
					"content": "Das ist noch gar nichts! Wo das herkommt, gibt es noch viel mehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050804
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050804,
					"content": "Heute war erst der Anfang. Wir gehen auf einen grandiosen Plünderzug, der in die Geschichte der Schatzräuber eingehen wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050805
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050805,
					"content": "Du bist der Boss, Boss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050806
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050806,
					"content": "Das sind die Schatzräuber, hinter denen wir her sind. Erteilen wir ihnen eine Lektion!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
