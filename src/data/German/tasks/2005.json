	"talks": [
		{
			"id": 200501,
			"completionStepIds": [
				200501
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200501",
							"2"
						],
						"stepId": 200501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Oomori",
					"Yuuya",
					"Kurosawa Kyounosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050101,
					"content": "Die Tenryou-Verwaltung soll dem Shougun direkt unterstehen. Sie bewahren Recht und Ordnung in Inazuma. Sie setzen das Augenhatz-Dekret in die Tat um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050102,
					"content": "Doch warum sollten sie einen ihrer eigenen so behandeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050103,
					"content": "Paimon versteht das nicht ... Wie? Da drüben scheint es Ärger zu geben, sehen wir nach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050104,
					"content": "Ich frage noch einmal ... Verweigerst du uns die Notvorräte für diesen Monat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050105
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050105,
					"content": "Der gesamte Klan ist von diesen Vorräten abhängig. Wir fordern eine Erklärung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050106
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050106,
					"content": "Wie oft soll ich es noch sagen ... Ich weiß nichts von irgendwelchen Notvorräten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050107
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050107,
					"content": "Du wagst es uns zu täuschen! Diese Vorräte sind lebenswichtig, hörst du? Das sind nicht bloß irgendwelche Güter, die ein gieriger Samurai für sich einheimsen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050108
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050108,
					"content": "Ihr Samurai glaubt, ihr könnt tun und lassen, was ihr wollt! Die Tenryou-Verwaltung wird davon erfahren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050109
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050109,
					"content": "Notvorräte ... meinen sie damit Nahrung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050110
					]
				},
				{
					"id": 20050110,
					"content": "Wie? Und wer seid ihr? Ihr gehört doch bestimmt zu Kurosawas Gang, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050111
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050111,
					"content": "Was? Wir sind bloß zufällig vorbeigekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050112,
					"content": "Wir wollten bloß wissen, was hier los ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050113,
					"content": "Verstehe, da kommt ihr gerade zur rechten Zeit. Vielleicht könnt ihr uns helfen, diese Sache zu klären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050114
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050114,
					"content": "Das hier ist Kurosawa, als Samurai gehört er zu Armee des Shougun. Diese verteilt hier Notvorräte und er ist dafür verantwortlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050115
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050115,
					"content": "Früher fragten wir einfach nach Vorräten und alles wurde geliefert. Doch jetzt weigert er sich plötzlich, uns irgendetwas zu geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050116
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050116,
					"content": "Er behält die Vorräte für sich, ich weiß es! Ohne die werden wir verhungern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050117
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050117,
					"content": "Wir scheinen allen egal sein ... Früher war Kurosawa ein gütiger Mann, doch jetzt zeigt er sein wahres Gesicht. Er ist genau so wie alle anderen Samurai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050118
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050118,
					"content": "Kein Wunder, dass alle Göttlichen Augen konfisziert wurden. Der Shougun Raiden will ganz alleine über die Nation herrschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050119
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050119,
					"content": "Er muss einer der Leute sein, die laut Ayaka Hilfe benötigen. Doch warum will sie, dass wir jemandem wie ihm helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050120,
					"content": "Vielleicht werden wir schlauer, wenn wir mit Kurosawa reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200502,
			"completionStepIds": [
				200503
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200503",
							"2"
						],
						"stepId": 200503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ken",
					"Tadao",
					"Paimon",
					"Gou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050201,
					"content": "Argh, und da verabschieden sich alle Mora ... Die zu stehlen, war ganz schön schwer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050202
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050202,
					"content": "Komm schon, Boss, lass dir was einfallen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050203
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050203,
					"content": "Ähem ... Nicht übel ... Schon mal daran gedacht, den Schatzräubern beizutreten? Jemanden wie dich können wir gebrauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050204,
						20050205
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050204,
					"content": "Vergiss es. Erzähl uns alles über Kurosawa.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				},
				{
					"id": 20050206,
					"content": "Kurosawa? Oh ... ich erinnere mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050207
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050207,
					"content": "Hat er euch geschickt, um uns zu jagen? Pfft, so ein Pech ... Ich wusste doch, wir hätten dieses Haus verschonen sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050208
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050208,
					"content": "Und was war drinnen? Lauter Nahrungsvorräte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050209,
					"content": "Nahrungsvorräte? Soll das ein Witz sein? Es war ein komplettes Chaos ... Da war bloß eine seltsame Kiste, hoffentlich ist da was Wertvolles drin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050210
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050210,
					"content": "Ich wollte nicht, dass sie jemand anderes sieht, darum wollte ich sie erst hinterher öffnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050211
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050211,
					"content": "Doch da ihr uns erwischt habt, schlage ich einen Handel vor. Diese kleine Kiste gegen unsere Freiheit ... Was meint ihr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050212
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050212,
					"content": "Abgemacht. Jetzt zeig uns den Inhalt der Kiste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050213,
					"content": "Wie?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050214
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050214,
					"content": "Was zur ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050215
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050215,
					"content": "Da sind bloß Schuldscheine drin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050216
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050216,
					"content": "Ja, und zwar jede Menge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050217,
					"content": "Und alle sind auf die Inhaberin eines Gemischtwarenladens ausgestellt, eine Frau Aoi ... die sind viele Mora wert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050218,
					"content": "Reden wir mit dieser Aoi und gehen der Sache auf den Grund.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050219,
					"content": "Ihr könnt gehen. Aber betet, dass sich unsere Wege nie wieder kreuzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050220,
					"content": "In ... In Ordnung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050221
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050221,
					"content": "Wir haben uns für ein paar Schuldscheine freigekauft ... heißt das, wir sind aus dem Schneider?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050222
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050222,
					"content": "Still! Verschwinden wir einfach von hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050205,
					"content": "Eher nicht. Es heißt, ihr habt Kurosawas Haus geplündert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				}
			]
		},
		{
			"id": 200503,
			"completionStepIds": [
				200504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200504",
							"2"
						],
						"stepId": 200504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aoi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050301,
					"content": "Willkommen im Tsukumomono-Geschäft! Wir haben alles, was ihr braucht. Kann ich helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050302
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050302,
					"content": "Oder ... wollt ihr euch wegen etwas erkundigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050303
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050303,
					"content": "Wegen dieser Schuldscheine ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050304
					]
				},
				{
					"id": 20050304,
					"content": "Ah, ihr seid also Freunde von Kurosawa? Haha. Wollt ihr vielleicht seine Schulden bezahlen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050305
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050305,
					"content": "Oooh, immer mit der Ruhe ... Wir wollen bloß wissen, wo die alle herkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050306,
					"content": "Warum schuldet Kurosawa dir so viel Geld? Hat er irgendwas extrem Teures gekauft?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050307,
					"content": "Mal überlegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050308
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050308,
					"content": "Kurosawa kaufte regelmäßig große Menge an Nahrung bei mir. Er bezahlte immer persönlich dafür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050309
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050309,
					"content": "Doch in letzter Zeit schossen die Nahrungspreise in die Höhe, sodass sein Gehalt nicht mehr dafür ausreichte. Um die übliche Menge weiterkaufen zu können, begann er also diese Schuldscheine zu schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050310
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050310,
					"content": "Daher kommen also diese Notvorräte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050311,
					"content": "Doch warum kaufte er weiter die „übliche“ Menge? Hätte er nicht einfach weniger kaufen können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050312,
					"content": "Na ja, die Leute, denen er die Notvorräte brachte, wussten wahrscheinlich ganz genau, wie viel sie brauchen, um zu überleben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050313
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050313,
					"content": "Kurosawa wollte sie wohl nicht enttäuschen. Dies zumal sie genaue Berechnungen angestellt hatten, was die Menge betrifft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050314
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050314,
					"content": "Er nahm also lieber die Schulden auf sich, anstatt die Leute zu enttäuschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050315
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050315,
					"content": "Also erwarb Kurosawa all diese Notvorräte auf eigene Kosten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050316,
					"content": "... und keiner wusste das je zu schätzen ... Sie beklagten sich bloß und machten ihn verantwortlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050317,
					"content": "Die Menschen verhalten sich den Umständen entsprechend. In Zeiten der Not denkt keiner genau nach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050318
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050318,
					"content": "Wenn ihr mich fragt, hätte Kurosawa von Anfang an sagen sollen, dass die Vorräte von ihm kamen. Dann gäbe es jetzt nicht solch einen Aufstand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050319
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050319,
					"content": "Sicher hätten manche sich trotzdem aufgeregt. Er bewältigte eine undankbare Aufgabe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050320
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050320,
					"content": "Warum er sein eigenes Geld für Notvorräte ausgab, ohne je irgendwem davon zu erzählen ... weiß ich selbst nicht genau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050321
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050321,
					"content": "Warum fragt ihr ihn nicht einfach selbst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050322
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050322,
					"content": "Leider erinnert er sich nicht mehr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050323
					]
				},
				{
					"id": 20050323,
					"content": "Verstehe ... Da fällt mir ein ... Jüngst wurde ihm sein Göttliches Auge genommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050324
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050324,
					"content": "Wirklich bedauerlich ... Wenn er seine Schulden nicht begleicht, wird er wohl sein geliebtes Schwert versetzen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050325
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050325,
					"content": "Schwert? Welches Schwert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050326,
					"content": "Hat er das nicht gesagt? Er besitzt ein äußerst wertvolles Schwert ... Er führt es schon seit Jahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050327
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050327,
					"content": "Als ich ihn einmal danach fragte, meinte er, es sei ein Geschenk seines Vaters ... und zu kostbar, um es zu verkaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050328
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050328,
					"content": "Im Nachhinein bereue ich es, nie ein Angebot dafür gemacht zu haben ... Wenn ihr mich fragt, hat alles seinen Preis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050329
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050329,
					"content": "Warum fragt ihr ihn nicht selbst nach dem Schwert? Vielleicht gibt es euch ja sogar die Antworten, nach denen ihr sucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050330
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050330,
					"content": "Doch bevor ihr geht, begleicht bitte die heutige Rechnung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050331
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050331,
					"content": "Wie? Aber wir haben nichts gekauft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050332,
					"content": "Hehe, Informationen sind ebenfalls eine Ware, meint ihr nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050333
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050333,
					"content": "Keine Angst, für Informationen über Kurosawa verlange ich nicht viel. Nichts davon war sonderlich vertraulich. Mal überlegen ... 2.000 Mora sollten genug sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050334
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050334,
					"content": "Also gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050335
					]
				},
				{
					"id": 20050335,
					"content": "Zumindest wissen wir jetzt, woher die Notvorräte kamen. Und wir wissen, dass Kurosawa ein unschätzbar wertvolles Schwert besitzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050336,
					"content": "Reden wir noch mal mit Kurosawa, vielleicht erinnert er sich jetzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200504,
			"completionStepIds": [
				200505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200505",
							"2"
						],
						"stepId": 200505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Kurosawa Kyounosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050401,
					"content": "Wie, was machst du ganz alleine hier? Wo sind die beiden anderen hin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050402,
					"content": "Ich stellte sie vor die Wahl: Entweder sie gehen oder ich ziehe mein Schwert. Sie gingen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050403
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050403,
					"content": "Das hat mir viel Zeit gespart. Vielleicht sollte ich öfter zu diesem Mittel greifen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050404
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050404,
					"content": "Habt ihr die Schatzräuber gefunden? Alles, was ich sagte, hat gestimmt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050405
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050405,
					"content": "Also ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050406
					]
				},
				{
					"id": 20050406,
					"content": "Das wäre es in etwa. Du hast tatsächlich Notvorräte verteilt, doch du hast sie alle auf eigene Kosten erworben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050407,
					"content": "Seltsam ... War ich wirklich so ein Mensch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050408
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050408,
					"content": "Ich kann mich wirklich nicht entsinnen. Selbst nach all euren Erzählungen erinnere ich mich an nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050409
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050409,
					"content": "Warum kaufte ich Notvorräte für alle? Und warum stürzte ich mich in solche Unkosten? Ich verstehe es einfach nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050410
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050410,
					"content": "Doch als ich mein Schwert zog, verspürte ich, dass mein Körper sich dagegen sträubte. Daran besteht kein Zweifel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050411,
						20050412
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050411,
					"content": "Das Schwert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				},
				{
					"id": 20050413,
					"content": "Dieses Schwert führte einst mein Vater.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050414
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050414,
					"content": "Als ich noch jung war, wollte ich mich einmal hinausschleichen, um damit vor den Nachbarskindern zu prahlen. Mein Vater erwischte mich und schimpfte kräftig mit mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050415
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050415,
					"content": "Was sagte er noch ... Hmm. Daran erinnere ich mich auch nicht mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050416
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050416,
					"content": "Als man mir mein Göttliches Auge nahm, verlor ich viele wichtige Erinnerungen. So viele Erinnerungen sind für immer fort, wie sehr ich mich auch anstrenge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050417
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050417,
					"content": "Ich erinnere mich nur, dass mein Vater meinte, dieses Schwert berge sein Credo. Bevor er starb, legte er es in meine Hände ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050418
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050418,
					"content": "... und sagte zu mir: „Mit diesem Schwert sollst du ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050419
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050419,
					"content": "Oh ... Bei genauerer Betrachtung sind auf dem Griff einige Wörter eingraviert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050420,
					"content": "Wie lauten die Wörter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050421,
					"content": "Da steht: „Tugend und Gerechtigkeit.“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050422
					]
				},
				{
					"id": 20050422,
					"content": "„Tugend und Gerechtigkeit?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050423
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050423,
					"content": "Irgendwie scheinen die Wörter plötzlich alles zu erklären ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050424
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050424,
					"content": "Hohe Schulden aufzunehmen, um für andere sorgen zu können. Das war wohl mein größtes Streben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050425
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050425,
					"content": "Doch wozu sollen Tugend und Gerechtigkeit gut sein? Ich kaufte Vorräte für die Notleidenden, doch seht, was dabei herauskam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050426
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050426,
					"content": "Die Tenryou-Verwaltung nahm mir mein Göttliches Auge und ausgerechnet die, denen ich so verzweifelt helfen wollte, weigern sich mich zu verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050427
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050427,
					"content": "Und ironischerweise ... hatte ich trotzdem ein schlechtes Gewissen, als ich sie mit meiner Klinge bedrohte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050428
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050428,
					"content": "Ich kann einfach kein guter Mensch sein ... doch böse sein kann ich auch nicht. Was soll ich bloß machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050429
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050429,
					"content": "Eine weitere geplagte Seele ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050430,
					"content": "Wir sollten bei Gelegenheit mit Thoma über Kurosawas Schulden sprechen. Sicher wird die Yashiro-Verwaltung die Kosten decken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050431,
					"content": "Jedenfalls müssen wir verhindern, dass er sein Schwert verkauft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050432,
						20050433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050432,
					"content": "Ein Göttliches Auge zu verlieren ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050434,
					"content": "Ja, es muss schrecklich sein, sein Streben zu verlieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050435,
					"content": "Zum Glück hast du kein Göttliches Auge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050436,
					"content": "Suchen wir die nächste arme Seele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050433,
					"content": "... ist kein Zuckerschlecken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050412,
					"content": "Dürfen wir es uns mal ansehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				}
			]
		},
		{
			"id": 200505,
			"completionStepIds": [
				200506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200506",
							"2"
						],
						"stepId": 200506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kurosawa Kyounosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050501,
					"content": "Von diesen Notvorräten habe ich noch nie gehört!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050502
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050502,
					"content": "Keine Ahnung, ob es stimmt oder ob sie mich erpressen wollen, aber das ist einfach lächerlich. Ich bin ein armer Mann, wie soll ich da bitte Vorräte horten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050503
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050503,
					"content": "Meine eigene Familie kommt gerade so zurecht ... Also, wenn ihr mich entschuldigt, ich habe noch andere Probleme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050504
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050504,
					"content": "Wir hörten, dass du dein Göttliches Auge verloren hast.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050505
					]
				},
				{
					"id": 20050505,
					"content": "Endlich mal ein wahres Wort. Die Armee des Shougun meinte, ich würde bei der Arbeit faulenzen und sei darum meines Göttlichen Auges unwürdig. Anscheinend enttäuschte ich sogar den Shougun Raiden persönlich. Darum nahm man mir mein Göttliches Auge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050506
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050506,
					"content": "Seltsam, dabei hast du doch bei der Durchsetzung des Augenhatz-Dekrets geholfen. Warum solltest du also deines Göttlichen Auges unwürdig sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050507,
					"content": "Ganz ehrlich ... An die Details kann ich mich nicht erinnern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050508
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050508,
					"content": "Ich weiß nur, dass mir jeden Monat bestimmte Aufgaben zufielen, aber ich weiß nicht mehr, welche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050509
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050509,
					"content": "Und das ist nicht alles ... Mich beschleicht das unbehagliche Gefühl ... als ob mir jemand etwas schuldet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050510
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050510,
					"content": "Könnte das mit den fehlenden Notvorräten zu tun haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050511,
					"content": "Ich habe nichts gestohlen! Wie gesagt, wenn ich sie hätte, würde ich gerade nicht so schwere Zeiten durchmachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050512
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050512,
					"content": "Als wäre das nicht genug, wurde mein Haus von Schatzräubern geplündert ... nur darum bin ich hier. Ich war ihnen auf den Fersen, als diese beiden Typen mich aufhielten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050513
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050513,
					"content": "Wenn ihr mir nicht glaubt, dann fragt die Schatzräuber doch selbst! Wenn ich irgendwelche Notvorräte hätte, wären sie darauf gestoßen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050514
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050514,
					"content": "Hmm ... Er scheint die Wahrheit zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050515,
					"content": "Doch wir überprüfen das lieber. Knöpfen wir uns diese Schatzräuber vor. Mal sehen, was sie zu sagen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050516,
					"content": "Wir sollten ihre Spuren verfolgen können. Sie dürften nicht allzu weit gekommen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
