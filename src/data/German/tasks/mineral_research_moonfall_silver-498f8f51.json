			},
			"dialogs": [
				{
					"id": 761960301,
					"content": "Schau mal nach, es sollte nichts fehlen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960302,
					"content": "Mhm — kein Problem, es ist alles da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960303
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960303,
					"content": "Ich habe gesehen, dass du mit Mondsilber interessante Muster auf den Boden gelegt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960304
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960304,
					"content": "Ja! Ich habe mir wirklich viel Mühe gegeben. Ich denke, so werden die Leute das Mondsilber noch mehr mögen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960305
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960305,
					"content": "Apropos, ich habe gehört, dass es in den Volksmärchen von Natlan eine Geschichte gibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960306
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960306,
					"content": "Es heißt, ein junges Mädchen, das einst auf den Sternen lebte, fiel auf die Erde herab. Um wieder nach Hause in den Himmel zu gelangen, hinterließ sie riesige Graffiti auf der Erde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960307
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960307,
					"content": "Danach sah ihr Vater, die Sonne am Himmel, tatsächlich ihre Bitte und holte sie zurück in den Himmel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960308
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960308,
					"content": "Vielleicht kann er ja auch das Muster sehen, das Dorota gelegt hat, und wird ein Fan von Mondsilber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960309
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960309,
					"content": "Hahaha! Wenn das so ist, dann bin ich die tollste Mondsilber-Botschafterin überhaupt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960310
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960310,
					"content": "Aber darüber mache ich mir weniger Sorgen. Ich habe mehr Angst, dass die Vögel am Himmel aufmerksam werden. Du weißt doch, Krähen und solche Vögel mögen alles, was glänzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960311
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960311,
					"content": "Das stimmt wohl. Aber neben Krähen musst du auch auf dem Boden auf Schnüffelmaulwürfe, Schatzmarder und solche Tiere aufpassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960312
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960312,
					"content": "Und auf Lumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960313
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960313,
					"content": "Haha, stimmt! Auf Lumi auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960314
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960314,
					"content": "Jaho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960315
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761960315,
					"content": "Danke für deine Hilfe vorhin! Das ist zwar nur ein kleiner Teil meiner Sammlung, aber ich schenke ihn dir. Betrachte ihn einfach als Geschenk für Lumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960316
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960316,
					"content": "Lumi, heute ist wirklich ein schöner Tag!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960317
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960317,
					"content": "Ja-hoho!",
