			},
			"dialogs": [
				{
					"id": 761960201,
					"content": "Dorota! Was machst du denn hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960202
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960202,
					"content": "Linnea, du kommst genau richtig! Ich habe gerade allen erklärt, wie wunderbar Mondsilber ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960203
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960203,
					"content": "Mondsilber, oh Mondsilber! Gibt es in der Welt unter dem Mond einen perfekteren Edelstein als dich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960204
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960204,
					"content": "Sieh nur! Diese makellose Form, dieses glatte Gefühl! Und dazu dieses schillernde Weiß, diese unvergleichliche Elementarempfindlichkeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960205
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960205,
					"content": "In meinem Herzen kann sich nur der Mond am Himmel mit dir messen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960206
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960206,
					"content": "Mondsilber ist tatsächlich ein sehr schönes Erz, ich habe auch welches gesammelt, um daraus Proben zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960207
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960207,
					"content": "Stimmt’s? Ich wusste, du würdest mich verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960208
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960208,
					"content": "Aber niemand kennt das Mondsilber so gut wie ich! Auch wenn du die Beraterin der Gilde bist, werde ich dir diese erste Position nicht überlassen, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960209
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960209,
					"content": "Übrigens, normalerweise unterrichtest du ja die Abenteurer. Aber heute werde ich dich mal testen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960210
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960210,
					"content": "Ich habe hier drei Stück Mondsilber. Leider weisen zwei davon kleine Makel auf, doch das dritte ist mein Schatz, das Mondsilber unter den Mondsilbern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960211
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960211,
					"content": "Kannst du erkennen, welches das perfekte Mondsilber ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960212,
					"content": "Lass mich mal schauen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960213,
						761960220,
						761960225
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960213,
					"content": "Das hier links ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960214
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960214,
					"content": "(Nanu? Was macht Lumi denn da ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960215,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960215,
					"content": "Das nehme ich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960216
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960216,
					"content": "Auch Linnea irrt sich manchmal. Wenn man genau hinsieht, hat dieses hier an einer sehr unauffälligen Stelle einen winzig kleinen Makel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960217
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960217,
					"content": "Hm, ich gebe auf ... Aber nächstes Mal, nächstes Mal werde ich nicht so leicht verlieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960218
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960218,
					"content": "Nur zu, ich bin immer bereit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960232,
					"content": "Schließlich hast du an der großen Mondsilber-Veranstaltung von Dorota teilgenommen und eine schöne Zeit verbracht ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761960219
					]
				},
				{
					"id": 761960219,
					"content": "Ich hätte nicht gedacht, dass alle so begeistert sind, aber leider gehen schöne Momente wie dieser immer so schnell vorbei ... Es wird Zeit, die Sachen zusammenzupacken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960233
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960233,
					"content": "Ich werde dir helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960234
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960234,
					"content": "Großartig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960231,
					"content": "Lass mich noch etwas darüber nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960220,
					"content": "Das in der Mitte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960221
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960221,
					"content": "(Lumi scheint das wohl sehr zu mögen.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960222,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960222,
					"content": "Das nehme ich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960223
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960223,
					"content": "Ah, du fühlst es also auch, oder? Das unwiderstehliche Charisma eines perfekten Gegenstands ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960225,
					"content": "Das hier rechts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960226
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960226,
					"content": "(Nanu? Was macht Lumi denn da ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960227,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960227,
					"content": "Das nehme ich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960228
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960228,
					"content": "Auch Linnea irrt sich manchmal. Wenn man genau hinsieht, hat dieses hier an einer sehr unauffälligen Stelle einen winzig kleinen Makel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960229
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960229,
					"content": "Hm, ich gebe auf ... Aber nächstes Mal, nächstes Mal werde ich nicht so leicht verlieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960230
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960230,
					"content": "Nur zu, ich bin immer bereit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "Dorota"
				}
			]
		},
