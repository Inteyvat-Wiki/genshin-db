					"Inkanak"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150200501,
					"content": "Bist du bereit? Für Chasca sollte das leicht sein, aber sei bitte trotzdem vorsichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200502,
						150200504
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200502,
					"content": "Ich bin sicher, sie schafft das!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200503
					]
				},
				{
					"id": 150200503,
					"content": "Na dann, breite deine Flügel aus und flieg los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200504,
					"content": "Noch nicht, ich brauche noch ein bisschen Zeit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
