			},
			"dialogs": [
				{
					"id": 150200201,
					"content": "Hm ... Es sollte möglich sein, diese Öffnung mit <color=#00E1FFFF>ein paar gezielten, kräftigen Schlägen freizubekommen</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200202
					],
					"speakerTitle": "Vorsichtiger Ermittler"
				},
				{
					"id": 150200202,
					"content": "Aber hier gibt es seltsame Anzeichen von Leben ... Damit herumzuhantieren könnte gefährlich sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vorsichtiger Ermittler"
				}
			]
		},
		{
			"id": 1502003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
