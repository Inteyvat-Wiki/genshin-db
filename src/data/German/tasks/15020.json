							-1291.735,
							239.807,
							9667.271
						],
						"pointId": 9927
					}
				]
			},
			"dialogs": [
				{
					"id": 150200801,
					"content": "#Hm? Chasca, {NICKNAME}? Das überrascht mich jetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200802
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200802,
					"content": "Allpa? Hm? Also ... wo ist denn nun dieser aggressive Qucusaurier, von dem wir gehört haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200803,
					"content": "Der ist schon weggeflogen. Sieht so aus, als hätte er sich davongemacht, als er merkte, dass Verstärkung kommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200804
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200804,
					"content": "Warum, denkst du, hat er die Leute überhaupt angegriffen? War er hinter dem Essen her?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200805
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200805,
					"content": "Nein, diese Händler transportieren gar kein Essen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200806
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200806,
					"content": "Ah! Zum Glück! Die Phlogiston-Flügel sind intakt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200807
					],
					"speakerTitle": "Junger Händler"
				},
				{
					"id": 150200807,
					"content": "... Phlogiston-Flügel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200808
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200808,
					"content": "Aah, danke vielmals, dass ihr gekommen seid, um uns zu retten. Diese Phlogiston-Flügel sind unsere wertvollste Ware. Wäre ihnen etwas zugestoßen, wären wir ruiniert gewesen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200809
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200809,
					"content": "... Warte mal kurz, seid ihr die Händler, die mit uns zusammenarbeiten wollten? Warmi hat mir von euch erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200810
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200810,
					"content": "Ja, das sind wir! Ich nehme an ... du bist die Stammesälteste Allpa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200811
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200811,
					"content": "Das bin ich. Ihr seid bestimmt von der Reise erschöpft und aufgewühlt von dem Angriff. Kommt, ich bringe euch zurück zu unserem Stamm, damit ihr euch ausruhen könnt. Über Geschäfte reden wir, sobald ihr wieder bei Kräften seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200812
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200812,
					"content": "Aber Älteste Allpa, was ist mit dem Angriff des Qucusauriers?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200813
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200813,
					"content": "Nun, unsere Gäste hier wurden nicht ernsthaft verletzt und ihre Waren sind unversehrt ... Vielleicht hatte der Qucusaurier einfach einen schlechten Tag.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200814
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200814,
					"content": "Es gibt so viele von ihnen in dieser Gegend, da ist so ein Vorfall nicht ganz auszuschließen. Ich glaube, wir müssen das nicht weiterverfolgen ... Viel wichtiger, wie steht es um die Vorbereitungen für die Flugprüfungen? Ist in der Arena alles bereit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200815,
						150200816
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200815,
					"content": "Alles geht seinen vorgesehenen Weg.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				},
				{
					"id": 150200817,
					"content": "Hä? Hast du gerade Flugprüfungen gesagt? Was für ein Zufall! Das wäre doch die ideale Gelegenheit, unsere Phlogiston-Flügel zu testen! Du wirst beeindruckt sein, was die alles können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200818
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200818,
					"content": "Oh, echt? ... Jetzt bin ich aber neugierig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200819
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200819,
					"content": "Hehe, na gut, vergessen wir den Qucusaurier-Angriff erstmal ... Wir haben ernsthafte Geschäfte zu besprechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200820
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200820,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200821
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200821,
					"content": "Das war’s? Das lief ja reibungsloser als erwartet ... Na gut, dann wollen wir uns auf den Weg machen ... Hm? Chasca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200822,
					"content": "Was guckst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200823
					]
				},
				{
					"id": 150200823,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200824
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200824,
					"content": "Eine blutverschmierte Feder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200825
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200825,
					"content": "Der Vorfall ist vergessen und im Blumenfeder-Klan kehren wieder Ruhe und Frieden ein.\\nDie folgenden Tage verlaufen ereignislos ... abgesehen von den Vorbereitungen für die Flugprüfungen, die mit beschleunigtem Tempo fortgesetzt werden ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 150200816,
					"content": "Die Prüfungen können bald beginnen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				}
			]
		},
		{
			"id": 1502009,
