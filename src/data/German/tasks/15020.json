						],
						"pointId": 9921
					}
				]
			},
			"dialogs": [
				{
					"id": 150201001,
					"content": "Oh, seid ihr hier, um zu helfen? Welch Glück! Allein würde ich das niemals schaffen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201002
					],
					"speakerTitle": "Mutige Ermittlerin"
				},
				{
					"id": 150201002,
					"content": "Die Blockade hier muss mit einer Spezialbombe beseitigt werden, aber wenn man Sprengstoff den steilen Hang hinaufträgt, ist die Katastrophe vorprogrammiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201003
					],
					"speakerTitle": "Mutige Ermittlerin"
				},
				{
					"id": 150201003,
					"content": "Würde ich sie fallen lassen oder ausrutschen, würde es mich in die Luft jagen. Darum war mein Plan, die Bombe auf die andere Seite zu transportieren und sie dann mit einem Heißluftballon hinüberzuschicken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201004
					],
					"speakerTitle": "Mutige Ermittlerin"
				},
				{
					"id": 150201004,
					"content": "Jetzt muss nur noch jemand <color=#00E1FFFF>den Ballon im richtigen Moment treffen, damit die Ladung genau auf die Öffnung fällt</color> ... und schon ist das Problem gelöst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201005
					],
					"speakerTitle": "Mutige Ermittlerin"
				},
				{
					"id": 150201005,
					"content": "Was hältst du davon? Klingt doch machbar, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201006
					],
					"speakerTitle": "Mutige Ermittlerin"
				},
				{
					"id": 150201006,
					"content": "Ich denke, das krieg ich hin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201007
					]
				},
				{
					"id": 150201007,
					"content": "Gehört der Heißluftballon da oben auch dir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201008
					]
				},
				{
					"id": 150201008,
					"content": "Hä? Ach, DER da ... Nein, ich habe keine Ahnung, wem der gehört. Oder wie man ihn so weit hochgebracht hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201009
					],
					"speakerTitle": "Mutige Ermittlerin"
				},
				{
					"id": 150201009,
					"content": "Wie gern würde ich hinauffliegen, um zu sehen, welche Technik dafür verwendet wird ... Aber na ja, die Prüfungsarena wieder in Schuss zu bringen, ist gerade wichtiger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201010
					],
					"speakerTitle": "Mutige Ermittlerin"
				},
				{
					"id": 150201010,
					"content": "Ich gehe vor und richte alles her. Gebt mir Bescheid, wenn ihr soweit seid!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mutige Ermittlerin"
				}
			]
		},
