				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150201101,
					"content": "Hä? Warum folgt ihr mir denn hierher? Von hier aus werdet ihr keinen guten Blickwinkel haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201102
					],
					"speakerTitle": "Mutige Ermittlerin"
				},
				{
					"id": 150201102,
					"content": "Könntest du nochmal den Ablauf mit mir durchgehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201103
					]
				},
				{
					"id": 150201103,
					"content": "Natürlich. Also, ich werde den Sprengstoff per Heißluftballon zur Öffnung auf der anderen Seite schicken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201104
					],
					"speakerTitle": "Mutige Ermittlerin"
				},
				{
					"id": 150201104,
					"content": "Alles, was du tun musst, ist, <color=#00E1FFFF>den Ballon im richtigen Moment zu treffen, damit die Bombe direkt auf die Öffnung fällt</color> ... Ganz einfach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mutige Ermittlerin"
				}
			]
		},
