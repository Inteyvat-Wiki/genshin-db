					}
				]
			},
			"dialogs": [
				{
					"id": 150200101,
					"content": "Oh, hallo, Chasca. Hat dich die Älteste Allpa geschickt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200102
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200102,
					"content": "Ja, sie hat momentan andere Dinge am Hals. Wie sieht es hier aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200103
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200103,
					"content": "Hm, na ja, die Inspektion hat viele Hindernisse in der Prüfungsarena offenbart. Sie scheinen durch Störungen im Fluss der Elemente verursacht worden zu sein, die auf wiederholte Invasionen des Abgrunds zurückgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200104
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200104,
					"content": "Theoretisch müssen wir diese Blockaden nur entfernen, dann wird die Arena sich wieder mit gasförmigem Phlogiston füllen. Doch in der Praxis gestaltet sich das aus vielerlei Gründen schwierig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200105
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200105,
					"content": "Warum geht ihr nicht schon mal runter und schaut es euch selbst an? Bei Fragen könnt ihr jederzeit das Personal fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				}
			]
		},
		{
			"id": 1502002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
