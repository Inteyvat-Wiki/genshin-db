				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150200701,
					"content": "Wie seltsam ... Warum gibt es hier so viel festes Phlogiston?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200702
					],
					"speakerTitle": "Zweifelnde Ermittlerin"
				},
				{
					"id": 150200702,
					"content": "Könnte von den Kindern der Echos stammen ... Vielleicht wurde es hier durch die Störungen im Fluss der Elemente hingetragen. <color=#00E1FFFF>Und an der Klippe habe ich diese merkwürdigen Zeichen gesehen ...</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200703
					],
					"speakerTitle": "Verwirrter Ermittler"
				},
				{
					"id": 150200703,
					"content": "Uh, ich weiß nicht, wie wir das lösen können ... Wenn wir nicht direkt zu den Kindern der Echos gehen und uns einen <color=#00E1FFFF>Tepetlisaurier</color> ausleihen wollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zweifelnde Ermittlerin"
				}
			]
		},
		{
