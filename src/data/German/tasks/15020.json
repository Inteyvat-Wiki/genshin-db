						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vorsichtiger Ermittler"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150200301,
					"content": "Haha ... Ich dachte schon, das war’s für mich! Diese Öffnung sollte jetzt wieder in Ordnung sein ... Ich danke euch vielmals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
