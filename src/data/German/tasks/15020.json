				]
			},
			"dialogs": [
				{
					"id": 150200601,
					"content": "Das war unglaublich! Paimon konnte nicht mal mit den Augen blinzeln!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200602,
					"content": "Und, gibt es noch irgendwelche Probleme mit der Arena?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200603
					]
				},
				{
					"id": 150200603,
					"content": "Hm ... Nein, keine größeren. In ein paar Tagen sollten wir die Prüfungen abhalten können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200604
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200604,
					"content": "Hilfe ... Helft mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200605
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200605,
					"content": "... Ihr seid doch vom Blumenfeder-Klan, oder? Bitte, kommt schnell, ihr müsst uns unbedingt helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200606
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200606,
					"content": "Hol erstmal Luft. Was genau ist passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200607
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200607,
					"content": "W... Wir wurden ... Wir wurden angegriffen ... von einem Qucusaurier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200608
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200608,
					"content": "Meine Freunde stecken immer noch auf halbem Weg mit der Ware, die wir transportieren, fest ... Bitte, ich flehe euch an, rettet sie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200609
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200609,
					"content": "Hä? Sind Qucusaurier wirklich so aggressiv? Greifen sie Gruppen von Menschen einfach so an, ohne provoziert worden zu sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200610,
					"content": "Nicht, dass ich wüsste ... aber jede Regel hat ihre Ausnahme. Lass uns nachsehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				}
			]
		},
		{
