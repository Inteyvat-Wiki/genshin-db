					}
				]
			},
			"dialogs": [
				{
					"id": 150200401,
					"content": "Boah, du hast das alles in null Komma nix erledigt ... Unglaubliche Leistung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200402
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200402,
					"content": "Jetzt müssen wir nur noch warten, bis sich das gasförmige Phlogiston vollständig wieder aufgefüllt hat. Dann können wir mit den Prüfungen beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200403
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200403,
					"content": "Hm ... Ehrlich gesagt, Inkanak, würde ich gern erstmal einen Testflug machen, um sicherzugehen, dass wir nichts übersehen haben. Kannst du das für mich arrangieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200404
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200404,
					"content": "Hm? Aber ... ihr habt die Arena gerade erst fertiggestellt. Es könnten noch unbekannte Gefahren lauern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200405
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200405,
					"content": "Gerade deshalb sollte ich sie testen. Sieh es als eine zusätzliche Inspektion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200406
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200406,
					"content": "Hm ... Du hast wohl recht. Mit deinen Flugfähigkeiten wirst du nicht ernsthaft in Gefahr sein, selbst wenn wir etwas übersehen haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200407
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200407,
					"content": "Die Bedingungen hier sind ein bisschen instabil, aber nur ein Testflug kann die verbliebenen Schwierigkeiten aufdecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200408,
					"content": "Gut, ich werde alles für dich vorbereiten. Gib einfach Bescheid, wenn du startklar bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				}
			]
		},
		{
			"id": 1502005,
