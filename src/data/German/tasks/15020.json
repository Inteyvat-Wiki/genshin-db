				"points": []
			},
			"dialogs": [
				{
					"id": 150200901,
					"content": "Waah! Hast du das gesehen!? Ein Tepetlisaurier ist einfach so aufgetaucht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200902
					],
					"speakerTitle": "Zweifelnde Ermittlerin"
				},
				{
					"id": 150200902,
					"content": "Wie ist der hierhergekommen? Einfach auf der Durchreise, oder ...? Hm. Nun ja, man sollte bei Glück nicht nachfragen. Die Öffnung ist frei und das ist die Hauptsache ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verwirrter Ermittler"
				}
			]
		},
		{
