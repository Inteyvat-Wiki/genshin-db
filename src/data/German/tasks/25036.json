				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250360101,
					"content": "... Vielleicht war diese Frage doch zu einfach?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360102
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360102,
					"content": "Oh, Entschuldigung, ich war so in meine Gedanken vertieft, dass ich dich gar nicht bemerkt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360103
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360103,
					"content": "Wunderschönen guten Tag. Ich heiße Keita und bin Lehrling bei den „Meistern des Nachtwinds“. Ich kümmere mich hier um die Unterlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360104
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360104,
					"content": "Worüber hast du denn gerade nachgedacht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250360105
					]
				},
				{
					"id": 250360105,
					"content": "Ah ... es waren nur ein paar Gedanken über die Vergangenheit, Gegenwart und Zukunft von Natlan, nicht der Rede wert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360106
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360106,
					"content": "#Du siehst aus wie {F#eine Reisende}{M#ein Reisender} aus der Ferne. Man merkt dir an, dass du viele Leute getroffen und Erfahrungen gesammelt hast ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360107
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360107,
					"content": "Wenn du Lust hast, kannst du dich an ein paar der Fragen, die ich aufgezeichnet habe, versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360108
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360108,
					"content": "Die Antworten auf diese Fragen findest du auf deinen Reisen ... sei es in der Vergangenheit, der Gegenwart oder auch der Zukunft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Keita"
				}
			]
		},
