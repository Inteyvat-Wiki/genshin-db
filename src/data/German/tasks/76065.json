			},
			"dialogs": [
				{
					"id": 760650101,
					"content": "Da bist du ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650102
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650102,
					"content": "Columbina ... du bist auch da.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650103
					]
				},
				{
					"id": 760650103,
					"content": "Hmm, da du jetzt auch da bist, sind wir wohl zusammen hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650104
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650104,
					"content": "Du redest so, als hättest du gewusst, dass ich komme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650105
					]
				},
				{
					"id": 760650105,
					"content": "Ich weiß nicht, wann, aber am Ende kommst du immer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650106
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650106,
					"content": "Wie eine unsichtbare Bindung zwischen Mond und Teyvat ... du wirst mich immer finden. Nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650107
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650107,
					"content": "Komm, setz dich zu mir. Ich habe dir einen Platz freigehalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650108
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650108,
					"content": "Letztes Mal haben wir von deinem Raumschiff aus auf Teyvat geblickt. Schauen wir uns dieses Mal einfach den Sternenhimmel an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650109
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650109,
					"content": "Ninnin und ihre Vorgänger wurden von diesem Sternenhimmel angezogen. Dort muss es eine besondere Kraft geben ... ich kann sie spüren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650110
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650110,
					"content": "Ninnin und ihre Nachrichten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650111
					]
				},
				{
					"id": 760650111,
					"content": "Keine Sorge, sie ist nicht in Gefahr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650112
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650112,
					"content": "Sie ist in Sicherheit einen sehr weiten Weg gegangen ... so weit, dass ich die Kraft, die sie begleitet hat, nicht mehr wahrnehmen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650113
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650113,
					"content": "Aber ich bin neugierig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650114
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650114,
					"content": "Neugierig weshalb?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650115
					]
				},
				{
					"id": 760650115,
					"content": "Hm ... viele. Werden die Nachrichten des Mondbeobachters auch von anderen empfangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650116
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650116,
					"content": "Diejenigen, die sie empfangen haben, oder andere Wesen ... Wer mögen sie wohl sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650117
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650117,
					"content": "Was sie wohl denken? Ob sie auch Liebe und Hass im Herzen haben, genau wie wir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650118
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650118,
					"content": "Werden sie sich wie wir von diesem wunderschönen, geheimnisvollen Sternenhimmel anziehen lassen, selbst wenn der Abgrund sie umgibt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650119
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650119,
					"content": "Werden sie wie wir auch andere suchen, ihnen zuwinken und sagen: „Hallo, Freund. Schön, dich kennenzulernen“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650120
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650120,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650121
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650121,
					"content": "Gibt es tief in diesem Sternenhimmel noch Zivilisationen, die nicht von der Dunkelheit verschlungen wurden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650122
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650122,
					"content": "Ich glaube schon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650123
					]
				},
				{
					"id": 760650123,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650124
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650124,
					"content": "Unser Raumschiff hat einmal eine Nachricht empfangen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650125
					]
				},
				{
					"id": 760650125,
					"content": "Was für eine Nachricht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650126
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650126,
					"content": "Der verwertbare Inhalt fehlt fast vollständig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650127
					]
				},
				{
					"id": 760650127,
					"content": "Aber sie stammte sicher von einer intelligenten Zivilisation.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650128
					]
				},
				{
					"id": 760650128,
					"content": "Inhalt fehlt ... weil das Signal zu weit gereist ist ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650129
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650129,
					"content": "Aber das allein macht mich schon glücklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650130
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650130,
					"content": "#Ach ja, {NICKNAME} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650131
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650131,
					"content": "Hm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650132
					]
				},
				{
					"id": 760650132,
					"content": "Deine Heimat liegt wohl auch dort draußen ... tief im All.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650133
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650133,
					"content": "Wenn du eines Tages dorthin zurückkehren willst, von wo du einst aufgebrochen bist, um dort ein bisschen aufzuräumen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650134
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650134,
					"content": "... Helfe ich dir gern. So wie du mir damals mit dem Mond geholfen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650135
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650135,
					"content": "Dann lade ich dich auf jeden Fall ein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650136
					]
				},
				{
					"id": 760650136,
					"content": "Wieder eine Party?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650137
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650137,
					"content": "Wieder eine Party!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650138
					]
				},
				{
					"id": 760650138,
					"content": "Dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650139
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650139,
					"content": "Wie klingt „Nacht der Heimkehr“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650140
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650140,
					"content": "Aber vielleicht ist sie ja tagsüber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650141
					]
				},
				{
					"id": 760650141,
					"content": "Dann feiern wir eben vom Tag bis tief in die Nacht und laden all unsere Freunde ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650142
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 760650142,
					"content": "Klingt nach Laune.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650143
					]
				},
				{
					"id": 760650143,
					"content": "Möge diese Nacht bei gutem Wetter kommen ... und wenn alle Freunde wieder vereint sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		}
	]
}