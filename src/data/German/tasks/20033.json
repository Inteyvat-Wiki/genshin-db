	"talks": [
		{
			"id": 2003301,
			"completionStepIds": [
				2003301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003301",
							"2"
						],
						"stepId": 2003301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna",
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200330101,
					"content": "#{F#Reisende}{M#Reisender}! Schau, schau, schau, schau, schau. Wie sehe ich aus? Gefällt es dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330102,
					"content": "Diese Kleidung ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330103
					]
				},
				{
					"id": 200330103,
					"content": "Das ist richtig! Ich habe die Prüfungen der Abenteurergilde bestanden und bin jetzt offiziell eine Abenteurerin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330104,
						200330105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330104,
					"content": "Sehr cool!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				},
				{
					"id": 200330106,
					"content": "Hehehe, danke. Ich habe versucht, meinen Bruder dazu zu bringen, es auch zu probieren, aber er wollte es nicht, egal was ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330107,
					"content": "Ich bin nicht wirklich an Abenteuern interessiert ... Außerdem, wer soll sich um Mama und Papa kümmern, wenn wir beide Abenteurer sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330108,
					"content": "Dann nehmen wir Mama und Papa mit auf eine Reise um die Welt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330109,
					"content": "Ach, du ... Komm schon, jetzt, da du eine Abenteurerin geworden bist, mach einfach deine Arbeit und ich kümmere mich um das Haus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330110,
					"content": "Aber! Pass auf dich auf, verletze dich nicht und übermüde dich nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330111,
					"content": "Ja, ja, ja! Ich gehe auf eine Mission!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330112,
					"content": "#{F#Reisende}{M#Reisender}, möchtest du mit mir kommen? Ich würde dir gern noch viele weitere Fragen über Abenteurer stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330113,
						200330114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330113,
					"content": "Klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330115,
					"content": "Gut, mal sehen ... Diese Mission ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330116,
					"content": "Begleite den Transportballon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330114,
					"content": "Los geht’s!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330105,
					"content": "Gratuliere!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				}
			]
		},
		{
			"id": 2003302,
			"completionStepIds": [
				2003304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
