			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200330201,
					"content": "#Erledigt! Danke, {F#Reisende}{M#Reisender}, die Eskorte ist gut gelaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330202,
					"content": "Aber ist das die Art von Dingen, die Abenteurer normalerweise als Auftrag haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330203,
						200330205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330203,
					"content": "Es gibt auch andere Aufträge.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330204
					]
				},
				{
					"id": 200330204,
					"content": "Du klingst auch so hilflos ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200330207,
					"content": "Ist das so? ... Gut! Dann werde ich es weiter versuchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330208
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330208,
					"content": "Wenn ich genug Geld gespart habe, werde ich mit meinem Bruder und meinen Eltern eine Reise machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330209
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330209,
					"content": "Mein Bruder wollte schon früher eine Reise machen, aber ... er musste bleiben und sich um mich kümmern, weil ich krank war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330210
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330210,
					"content": "Jetzt habe ich mich von meiner Krankheit erholt und bin ein Abenteurer geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330211
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330211,
					"content": "Es ist an der Zeit, meinem Bruder zu helfen, sich einen Traum zu erfüllen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330205,
					"content": "Du wirst es mit der Zeit wissen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330206
					]
				},
				{
					"id": 200330206,
					"content": "He, schau nicht so müde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330207
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2003303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003301",
							"3"
						],
						"stepId": 2003301,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200330301,
					"content": "#{F#Reisende}{M#Reisender}, kümmere dich bitte um Anna, sie scheint in letzter Zeit überaktiv zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330302,
					"content": "Willst du nicht, dass sie eine Abenteurerin wird?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330303
					]
				},
				{
					"id": 200330303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330304,
					"content": "Ich respektiere den Traum meiner Schwester.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330305,
					"content": "Sie konnte sich von ihrer Krankheit erholen und hat die Möglichkeit, ihren Traum zu verwirklichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330306,
					"content": "Als ihr Bruder werde ich sie voll unterstützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330307,
					"content": "So sieht’s aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
	]
}