			"dialogs": [
				{
					"id": 740120501,
					"content": "Boah, ist der streng! Unter seinem Kommando möchte Paimon ganz sicher nicht arbeiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120502,
					"content": "Was soll das heißen, „Gruppenehre“ ... Wenn die Leute nicht einmal essen dürfen, dann hat er auch keine Ehre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120503,
						740120505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120503,
					"content": "Ganz unrecht hat er aber nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120504
					]
				},
				{
					"id": 740120505,
					"content": "Das ist wirklich eine seltsame Regel ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120506
					]
				},
				{
					"id": 740120504,
					"content": "Also Disziplin ist schon wichtig ... Aber so weit muss es doch auch nicht gehen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120506,
					"content": "Klar ist sie das! Je weniger jemand mit praktischen Problemen fertig wird, desto mehr steht er auf komische Statuten und Regeln ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120507,
					"content": "Oh? Wenn Paimon genau darüber nachdenkt, können wir Shumilov vielleicht auch herunterlocken, wenn wir an den Topf hämmern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120508,
					"content": "#Möglicherweise kommen wir so hoch ... {NICKNAME}, lass es uns gleich einmal versuchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
