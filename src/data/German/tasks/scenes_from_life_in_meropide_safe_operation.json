			"dialogs": [
				{
					"id": 740330101,
					"content": "Nachdem der Geoden-Tunnel verschlossen wurde, kommen kaum noch Menschen hierher. Die Geräte hier sind auch nicht geeignet, von Amateuren bedient zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330102
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330102,
					"content": "Aber dieses Mal hat jemand an dem Getriebeventil herumgespielt und dabei den eigenen Freund eingesperrt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330103
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330103,
					"content": "Nun, lasst uns zuerst das Getriebeventil bedienen und den Zugang zum <color=#00E1FFFF>Versorgungslager 1</color> öffnen. Falls er dich später auf ein Getränk einlädt, solltest du besser ablehnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330104
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330104,
					"content": "Wer wird uns Getränke anbieten? Warum sollen wir sie nicht trinken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330105,
					"content": "Bald wirst du es wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caterpillar"
				}
			]
		},
		{
			"id": 7403304,
			"completionStepIds": [
				7403304
			],
