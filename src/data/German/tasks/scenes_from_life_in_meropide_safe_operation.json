			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Caterpillar",
					"Mitul"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							4596.75,
							-46.38,
							4590.743
						],
						"pointId": 4614
					},
					{
						"sceneId": 3,
						"position": [
							4595.909,
							-46.38,
							4592.177
						],
						"pointId": 5582
					},
					{
						"sceneId": 3,
						"position": [
							4595.084,
							-46.38,
							4591.131
						],
						"pointId": 5768
					}
				]
			},
			"dialogs": [
				{
					"id": 740330401,
					"content": "Mitul, bist du in Ordnung? Du bist noch nicht allzu lange eingesperrt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330402
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330402,
					"content": "Meine Retter! Da seid ihr ja endlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330403
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330403,
					"content": "Wo ist Koblenz? Ist er nicht bei euch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330404
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330404,
					"content": "Er war es, der mich um Hilfe bat. Er sagte, du seist hier eingesperrt. Aber dann wurden wir von einer Wache unterbrochen und er ging zuerst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330405
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330405,
					"content": "Ich wusste schon, dass er kein verlässlicher Geschäftspartner ist! Er muss aus Angst und schlechtem Gewissen weggelaufen sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330406
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330406,
					"content": "Ihr wisst doch auch, dass man im Geschäft keinen Gewinn macht, wenn man kein Wagnis eingeht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330407
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330407,
					"content": "Er war viel zu tollpatschig und unentschlossen ... Ratet mal was, ganz zu schweigen von „Reines Wasser“, Fonta sind jetzt auch erhältlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330408
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330408,
					"content": "Jetzt, da Fonta auch auf dem Markt sind, können wir überhaupt noch überleben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330409
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330409,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330410,
					"content": "Was, trinkt ihr auch gern Fonta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330411,
						740330413
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330411,
					"content": "Wie, du magst sie nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330412
					]
				},
				{
					"id": 740330412,
					"content": "Natürlich trinke ich sie auch gern! Ich muss zugeben, Fonta ist ein ziemlich mächtiger Konkurrent ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330415,
					"content": "Na ja, genug geplaudert. Ich muss los, um mit Koblenz abzurechnen. Ach ja, er hat nicht bezahlt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330416
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330416,
					"content": "Tatsächlich nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330417
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330417,
					"content": "... Manchmal möchte man ihn einfach in eine Tonne stecken, damit er über sich selbst reflektiert. Bitte, nehmt diese Tauschscheine an euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330418
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330418,
					"content": "#{NICKNAME} und Paimon, nehmt es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330419
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330419,
					"content": "Echt? Alles für uns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330420,
					"content": "Natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330421
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330421,
					"content": "Hehe, na gut, wir nehmen es an! Bei Gelegenheit schauen wir im Knochenbrecherladen, ob es dort etwas Feines gibt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330422,
					"content": "Also, da ich euch so viel Umstände gemacht habe ... Als Entschädigung habe ich hier ein paar Flaschen frische Gesundheitsgetränke. Möchtet ihr nicht mal probieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330423
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330423,
					"content": "Frische ... Gesundheitsgetränke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330424,
					"content": "Ja! Viel gesünder als „Reines Wasser“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330425,
						740330428
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330425,
					"content": "Ich hätte gern eine Flasche.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330426
					]
				},
				{
					"id": 740330426,
					"content": "(He! Caterpillar sagte doch gerade, wir sollten nichts trinken ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330427,
					"content": "#Na ja, was {NICKNAME} gerade sagte, war nicht so gemeint! Wir haben gerade vorhin ... ähm, schon unheimlich viel getrunken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330431,
					"content": "Wirklich schade, solch gute Gesundheitsgetränke! Bei Gelegenheit sollten wir sie mal probieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330432,
					"content": "Oh, schlechter Zeitpunkt. Na gut. Kommt zu mir, wann immer ihr Zeit habt, ich werde euch bestimmt bestens bewirten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330433
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330433,
					"content": "Also, dann verabschiede ich mich erst einmal. Ich muss noch zu Koblenz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330434
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330434,
					"content": "Ich habe auch etwas zu tun und muss gehen. Macht euch keine Sorgen wegen der Tauschscheine. <color=#00E1FFFF>Wenn es Hinweise gibt, werde ich die an die Tafel heften</color>. Wir treffen uns später wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330435
					],
					"speakerTitle": "Caterpillar"
				},
				{
					"id": 740330435,
					"content": "Gut, bis dann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330428,
					"content": "Ich hätte gern eine Flasche Fonta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330429
					]
				},
				{
					"id": 740330429,
					"content": "Nun, ich habe auch welche ... Warte. Du verachtest meine Gesundheitsgetränke? Lass mich dir etwas verraten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330430
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330430,
					"content": "#{NICKNAME} meinte das nicht! Es ist nur so, dass wir unterwegs schon zu viele Getränke getrunken haben. Jetzt sind wir total satt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330413,
					"content": "Es geht so.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330414
					]
				},
				{
					"id": 740330414,
					"content": "Oh? Du scheinst einen guten Geschmack zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "Mitul"
				}
			]
		}
	]
}