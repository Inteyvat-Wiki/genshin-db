			"dialogs": [
				{
					"id": 191430101,
					"content": "Ist hier schon jemand vorbeigekommen? Entschuldigung, ich habe mich vorhin voll darauf konzentriert, das Zitronenwasser zu schmecken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430102
					],
					"speakerTitle": "Matsumoto"
				},
				{
					"id": 191430102,
					"content": "Wenn du etwas fragen willst, gehst du am besten zu den Leuten an der heißen Quelle über die Straße.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matsumoto"
