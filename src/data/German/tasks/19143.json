			"dialogs": [
				{
					"id": 191431101,
					"content": "Ihr bleibt erstmal hier. Bewegt euch nicht, verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431102
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 191431102,
					"content": "Alles klar. Wir sind wirklich ziemlich erschöpft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431103
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 191431103,
					"content": "Jetzt seid ihr erschöpft. Aber wenn ihr euch hier genug ausgeruht habt, werdet ihr bestimmt wieder weglaufen wollen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431104
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 191431104,
					"content": "Das würden wir nicht wagen! Das wird nie mehr passieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Genta"
				}
			]
		}
