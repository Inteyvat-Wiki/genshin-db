				"points": []
			},
			"dialogs": [
				{
					"id": 191431001,
					"content": "Was sollen wir machen? Dann können wir heute kein „Geniale Beschwörung“ mehr spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431002
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431002,
					"content": "Wollen wir den Ort wechseln? Aber gibt es außer diesem Platz unter der Brücke noch einen Ort, der für die Erwachsenen nicht leicht zu entdecken ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431003
					],
					"speakerTitle": "Eita"
				},
				{
					"id": 191431003,
					"content": "Also ... Lasst uns einfach Yoimiya besuchen und sie bitten, ein paar Feuerwerk zu zünden, um diesen Verbrecher zu vertreiben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431004
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431004,
					"content": "Ist das eine gute Idee? Aber es stimmt schon, dass er uns zuerst vertrieben hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431005
					],
					"speakerTitle": "Eita"
				},
				{
					"id": 191431005,
					"content": "Deswegen ist alles seine Schuld!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431006
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431006,
					"content": "Ich frage mich ... ob wir nicht nach Hause gehen und unsere Hausaufgaben machen sollten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431007
					],
					"speakerTitle": "Yuma"
				},
				{
					"id": 191431007,
					"content": "Wenn wir immer nur Karten spielen und nichts lernen, werden wir in Zukunft wahrscheinlich auch wie <color=#00E1FFFF>diese Person unter der Brücke</color> enden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuma"
				}
			]
		},
