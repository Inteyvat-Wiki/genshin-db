					"Aikawa Susumu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191430901,
					"content": "Als ich gerade dabei war, die Halle zu putzen, hörte ich von draußen plötzlich ein Geräusch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430902
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 191430902,
					"content": "Als ich rausging, sah ich plötzlich ... <color=#00E1FFFF>wie ein schwarzer Schatten auf den Baum sprang! </color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191430903
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 191430903,
					"content": "Das kann doch kein Dieb oder Räuber sein, oder? Dies ist doch eine belebte Straße ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aikawa Susumu"
				}
			]
		},
