				]
			},
			"dialogs": [
				{
					"id": 715350201,
					"content": "#Schön, dich hier zu sehen, {NICKNAME}! Du musst auch zum Laternenritual hier sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350202,
					"content": "Machst du da eine Glückwunschkarte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350203
					]
				},
				{
					"id": 715350203,
					"content": "Ja, ich versuche, eine für Candace zu basteln, aber ich bin noch nicht zufrieden mit dem Ergebnis. Ich war gerade dabei, wieder von vorn anzufangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350204
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350204,
					"content": "Ist Candace nicht mitgekommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350205
					]
				},
				{
					"id": 715350205,
					"content": "Leider noch nicht, aber sie hat vor zu kommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350206
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350206,
					"content": "Zuerst war sie nicht damit einverstanden, mit mir nach Liyue zu kommen. Sie sagte, sie müsse zurückbleiben, um das Dorf zu schützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350207
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350207,
					"content": "Ich habe ihr gesagt, dass sie sich bei dieser Gelegenheit mal richtig ausspannen sollte. Ich musste sowieso eine Karawane nach Liyue eskortieren, also konnte sie genauso gut mitkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350208
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350208,
					"content": "Ich habe ihr sogar angeboten, dass sich einige meiner Leute in der Zwischenzeit um ihr Dorf kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350209
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350209,
					"content": "Aber ich konnte sie nicht überzeugen. Am Ende änderte sie ihre Meinung nur, weil die Leute im Dorf sie drängten, eine Auszeit zu nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350210
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350210,
					"content": "Allerdings bestand sie darauf, noch einige Dinge zu erledigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350211
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350211,
					"content": "Aber die Karawane wartet ja nicht auf uns ... Also bin ich erst einmal selbst hergekommen und warte auf sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350212
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350212,
					"content": "Es war sooo schwer, ein Geschenk zu wählen. Hier gibt es einfach so viele schöne Sachen. Da weiß man gar nicht, was man aussuchen soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350213
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350213,
					"content": "Am Ende habe ich eine Halskette ausgewählt, und weil ich gehört hatte, dass die Einwohner von Liyue ihren Geschenken während des Laternenrituals eine besondere Glückwunschkarte beilegen, wollte ich selbst eine entwerfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350214,
					"content": "Und ... wie bereits erwähnt war das Ergebnis nicht gerade befriedigend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350215
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350215,
					"content": "#Du kennst dich sicher besser aus, {NICKNAME}. Kannst du mir ein paar Ratschläge geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350216
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350216,
					"content": "Kein Problem, ich seh mir das mal an ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
