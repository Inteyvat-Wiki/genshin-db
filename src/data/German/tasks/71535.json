			"dialogs": [
				{
					"id": 715350401,
					"content": "Ooh? Sieht aus, als hättest du ein echtes Händchen dafür. Diese Glückwunschkarte ist wunderschön, vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350402
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350402,
					"content": "Diese Glückwunschkarte ist wie ein Geschenk von dir. Ich habe jetzt nichts Wertvolles bei mir, also werde ich dir nach meiner Rückkehr nach Sumeru ein Geschenk zukommen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350403
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350403,
					"content": "Jetzt werde ich eine weitere Glückwunschkarte für Candace erstellen und ihr die Halskette zusammen mit der Karte überreiche. Sie wird sich bestimmt freuen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350404
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350404,
					"content": "Aber mal ehrlich, warum ist Candace noch nicht hergekommen ... Es ist schon eine ganze Weile her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				}
			]
		}
	]
