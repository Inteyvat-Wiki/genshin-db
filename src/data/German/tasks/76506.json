			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765060101,
					"content": "#Ach, sind das nicht {NICKNAME} und Paimon! Ich hätte nie gedacht, euch hier zu treffen. Das muss eine glückliche Fügung des Schicksals sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060102,
					"content": "Dori! Was machst du denn hier ganz alleine? Willst du hier etwa was an einem Stand verkaufen? Äh, aber Paimon sieht ja gar keine Waren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060103,
					"content": "Tut mir leid, aber heute hat die berühmte reisende Händlerin Dori fürs Erste frei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060104,
					"content": "Ich habe mir die Einheimischen hier in Nod-Krai zum Vorbild genommen und verbringe gerade einen ganz gewöhnlichen und unbeschwerten Tag an diesem „Elysium“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060105
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060105,
					"content": "Boah, wirklich? Eine Dori, die nicht mit Geschäften beschäftigt ist und Mora hinterherjagt, ist seltener als ein Regen in der Wüste!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060106,
					"content": "Haha, auch wenn ich mir mal eine seltene Auszeit gönne, meine Geschäfte und meine fleißigen und tüchtigen Angestellten verdienen trotzdem ununterbrochen weiter Mora für mich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060107
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060107,
					"content": "Solange die Zahlen auf meinem Konto weiter in die Höhe schnellen, gibt es nichts zu befürchten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060108
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060108,
					"content": "Wo wir gerade dabei sind: Habt ihr zwei etwa irgendwelche Schwierigkeiten? Auch wenn ich im Urlaub bin, würde ich ein Geschäft, das mir so offensiv angeboten wird, niemals ablehnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060109,
						765060110
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060109,
					"content": "Wir erkunden einfach nur die Umgebung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				},
				{
					"id": 765060111,
					"content": "Oh, ihr wollt also die einzigartige Landschaft Nod-Krais festhalten! Da seid ihr bei mir genau richtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060112
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060112,
					"content": "Ich bin vielleicht nicht so gut mit diesem Ort vertraut wie die lokalen Vermittler, aber ich kann euch trotzdem einige besondere Fotospots empfehlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060113,
					"content": "Da wir ja alte Bekannte sind, will ich euch meine Dienste als persönliche Reiseführerin anbieten, und das zu einem Freundschaftspreis von nur fünfhunderttausend Mora pro Tag! Na, wie klingt das für euch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060114,
					"content": "Uff ... Typisch Dori, nach drei Sätzen geht es schon wieder darum, uns Mora aus der Tasche zu ziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060115,
					"content": "Ach woher, ich tue das doch alles nur, damit meine wichtigsten Kunden, die glücklichsten und unvergesslichsten Erinnerungen aus Nod-Krai mitnehmen werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060116,
						765060117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060116,
					"content": "Da du dich so großzügig zeigst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060118,
					"content": "Hm? Fotos? Von mir? Klingt interessant. Aber diese Fotos dürfen nicht für kommerzielle Zwecke verwendet werden, meine Bildrechte ist unbezahlbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060119
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060119,
					"content": "Keine Sorge, wir wollen nur ein paar Fotos von einer alten Bekannten machen, als Erinnerung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060120,
					"content": "#Na gut, na gut. {NICKNAME}, für dich mache ich eine Ausnahme und werde für dich Modell stehen. Bitte achte darauf, dass ich würdevoll und außergewöhnlich elegant aussehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060121
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060121,
					"content": "Das Foto braucht auch einen ordentlichen Titel ... Lasst mich mal überlegen ... Wie wäre es mit „Dori Sangemah Bays elysischen Ferien“? Klingt das nicht toll?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060117,
					"content": "Darf ich Fotos von dir machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060110,
					"content": "Wir suchen einfach nur nach Motiven für unsere Aufnahmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				}
			]
		},
