			},
			"dialogs": [
				{
					"id": 80200501,
					"content": "Hier kommen wir wohl nicht weiter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200502,
					"content": "Nehmt euch in Acht. Ich spüre die Präsenz des Abgrunds!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200503
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200503,
					"content": "Das ist der Orden des Abgrunds! Sie sind hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
