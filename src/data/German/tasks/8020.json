				]
			},
			"dialogs": [
				{
					"id": 80200201,
					"content": "Äh, Dain? Hallooo ... Dain! Warum starrst du denn so ins Leere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200203
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200203,
					"content": "Ist etwas passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200204,
					"content": "Stimmt etwas nicht, Dain?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200205
					]
				},
				{
					"id": 80200205,
					"content": "Die gesuchte Person aus eurer Mission ... Könntet ihr sie beschreiben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200206
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200206,
					"content": "Oh, äh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200207,
					"content": "Junger Kerl, Anfang Zwanzig ... Im Ernst, Dain ... Was läuft hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200208,
					"content": "In meinem Gedächtnis scheint es Erinnerungen zu geben, die vorher nicht da waren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200209
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200209,
					"content": "Erinnerungen ... an ihn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200210
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200210,
					"content": "Hä? Vielleicht ... Vielleicht haben wir gestern einfach zu viel über ihn gesprochen und dann hattest du einen seltsamen Traum oder so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200211,
					"content": "Nein. Das war kein Traum. Es sind Erinnerungen ... Erinnerungen, die plötzlich in meinem Kopf auftauchten, nachdem ich aufgewacht war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200212
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200212,
					"content": "Und ich bin mir sicher, dass ich diese Person noch nie getroffen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200213
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200213,
					"content": "Also, woran genau „erinnerst“ du dich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200214
					]
				},
				{
					"id": 80200214,
					"content": "Ich erinnere mich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200215
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200215,
					"content": "... Daran, ihm das Auge des ersten Pflugs gegeben zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200216,
					"content": "!?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200217
					]
				},
				{
					"id": 80200217,
					"content": "Waaaaas!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200218,
					"content": "... Aha, dieser Vermisste hat also eindeutig etwas mit dem Orden des Abgrunds zu tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200219,
					"content": "Tatsächlich. Und er scheint die Fähigkeit zu besitzen, anderen Leuten Erinnerungen einpflanzen zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200220
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200220,
					"content": "Wie ist so etwas überhaupt möglich ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200221
					]
				},
				{
					"id": 80200221,
					"content": "Warte, dann ... Könnten all die Erinnerungen, die die Dorfbewohner an ihn haben ... etwa auch gefälscht sein? Vielleicht haben sie ihn überhaupt nie gekannt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200222,
					"content": "Aber warum würde er so etwas tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200223,
					"content": "Was auch immer der Orden des Abgrunds vorhat. Eine wichtige Wahrheit hat sich uns heute Vormittag offenbart ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200224
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200224,
					"content": "Was für eine Wahrheit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200225,
					"content": "Dass ihr Ziel immer noch darin besteht, das Auge des ersten Pflugs zu bekommen. Sie haben nicht aufgehört, danach zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200226
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200226,
					"content": "Ich bin die einzige Person, die weiß, wo es sich befindet. Vielleicht zielte die Implantation dieser speziellen Erinnerung darauf ab, auf meinen Geist einzuwirken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200227,
						80200228
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200227,
					"content": "Ist das Auge jetzt noch in Sicherheit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				},
				{
					"id": 80200229,
					"content": "Deine Sorgen sind nicht ganz unbegründet. Ich glaube aber nicht, dass der Orden des Abgrunds bereits über derartige Fähigkeiten zur Veränderung der Realität verfügt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200230
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200230,
					"content": "Wenn man aber bedenkt, wie gezielt sie hinter dem Auge her sind, würde ich sagen, ein vergleichbares Maß an Vorsicht ist ratsam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200231
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200231,
					"content": "Kommt mit mir. Wir müssen prüfen, ob das Auge sich noch in unserem Besitz befindet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200232
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200232,
					"content": "Oh, du willst uns also dahin bringen, wo du es versteckt hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200233,
					"content": "(... Aber was, wenn uns jemand folgt? Wenn wir direkt dort hingehen und uns jemand auf den Fersen ist, geben wir dann nicht seinen Aufenthaltsort Preis?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200234
					]
				},
				{
					"id": 80200234,
					"content": "(Vielleicht ist das der Grund, warum der Orden des Abgrunds diese Erinnerungen überhaupt erst implantiert hat ... Um Dain dazu zu zwingen, den Aufenthaltsort des Auges zu bestätigen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200235
					]
				},
				{
					"id": 80200235,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200236
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200236,
					"content": "(Nachdem, was wir über ihn wissen, nehme ich an, dass Dain diese Möglichkeit schon in Betracht gezogen hat ... Wahrscheinlich hat er bereits einen Plan ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200237,
						80200238
					]
				},
				{
					"id": 80200237,
					"content": "Gehen wir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200239,
					"content": "... Natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200238,
					"content": "Du gehst voran, Dain.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200239
					]
				},
				{
					"id": 80200228,
					"content": "Was, wenn diese Erinnerung „real“ ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200229
					]
				}
			]
		},
		{
