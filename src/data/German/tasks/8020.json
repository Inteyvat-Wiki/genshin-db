					},
					{
						"sceneId": 3,
						"position": [
							-1136.425,
							200.941,
							2686.6
						],
						"pointId": 330400545
					},
					{
						"sceneId": 3,
						"position": [
							-1136.996,
							201.048,
							2684.435
						],
						"pointId": 330400551
					}
				]
			},
			"dialogs": [
				{
					"id": 80200122,
					"content": "Gewappnet mit neuen Erkenntnissen kehrt ihr zurück ins Dorf Vimara, um weitergehende Erkundigungen anzustellen. Ihr befragt die Dorfbewohner bis zum Einbruch der Dunkelheit ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80200123
					]
				},
				{
					"id": 80200123,
					"content": "Ah, diese Mission hat euch also nach Vimara geführt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200124
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200124,
					"content": "„Jemand, der nur in den Erinnerungen anderer zu existieren scheint“ ... Ein faszinierendes Gedankenspiel. Ich stimme zu, dass ihr es wahrscheinlich nicht nur mit einem einfachen Vermisstenfall zu tun habt. Ob es allerdings eine Verbindung zum Orden des Abgrunds gibt, ist aber weiterhin unklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200125
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200125,
					"content": "Wie es scheint, ist unser einziger Hinweis eine erhöhte Hilichurl-Aktivität. Ein recht mageres Zwischenergebnis.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200126,
						80200127
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200126,
					"content": "Nun, dann ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				},
				{
					"id": 80200128,
					"content": "#Richtig! Diese mysteriöse Stimme, die {F#sie}{M#er} in den Erinnerungen {F#ihres Bruders}{M#seiner Schwester} gehört hat ... und der sich selbst „Sünder“ nannte ... Wer ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200129,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200130
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200130,
					"content": "#{NICKNAME}, ich möchte dich etwas fragen ... Glaubst du, dass dein Geschwister dich getäuscht hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200131,
						80200132
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200131,
					"content": "#Ich würde {M#ihr}{F#ihm} gern glauben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200133,
					"content": "Hmm ... Ich sehe ein Zögern in deinen Worten. Jedenfalls hast du noch nicht die ganze Wahrheit dessen, was geschehen ist, verstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200134
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200134,
					"content": "Es besteht noch Hoffnung, dass das frühere Band zwischen euch wiederhergestellt werden kann. Der Schaden ist nicht irreparabel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200135
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200135,
					"content": "Der Sünder, über den du Aufschluss begehrst ... Sein Schicksal ist anders gewoben. Er und seine Mitschuldigen haben mich und ihr Land schon seit Langem verraten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200136
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200136,
					"content": "Sein Name ist Vedrfolnir, „der Seher“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200137
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200137,
					"content": "Es widerstrebt mir, das zuzugeben, aber ... Er ist auch mein Blutsverwandter. Mein älterer Bruder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200138
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200138,
					"content": "Dein ... Bruder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200139,
						80200140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200139,
					"content": "Was ist denn zwischen euch vorgefallen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200141,
					"content": "Es gab fünf von ihnen ... Die fünf Sünder von Khaenri’ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200142
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200142,
					"content": "Hroptatyr der „Weise“, Vedrfolnir der „Seher“, Rheindottir die „Goldene“, Surtalogi der „Reiter des Bösen“ und Rerir der „Rächer von Solnari“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200143
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200143,
					"content": "Wie sehr meine Erinnerung auch schwinden mag, ihre Namen werde ich nie vergessen. Der Tag wird kommen ... an dem ich mich räche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200144
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200144,
					"content": "Warte! Ein paar von diesen Namen klingen sehr bekannt ... Rheindottir ist diejenige, die Albedo erschaffen hat und Surtalogi ist der Meister von Skirk ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200145,
					"content": "Und der, von dem wir gerade hörten ... Dains Bruder Vedrfolnir ... Wenn er die Stimme des Sünders war, dann war ... er es, der Chlothar inspirierte, den Orden des Abgrunds zu gründen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200146,
					"content": "In gewisser Weise hängt alles zusammen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200147
					]
				},
				{
					"id": 80200147,
					"content": "(Wenn das stimmt, dann waren die Steintafeln, die wir in jener Ruine in Fontaine gefunden haben ... die, die Fontaines Prophezeiung darlegten ... vielleicht auch Vedrfolnirs Werk.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200148
					]
				},
				{
					"id": 80200148,
					"content": "Sie waren einst Personen von hohem Ansehen in Khaenri’ah, auf ihren Schultern ruhte die Hoffnung des Landes. Sie waren Erste unter Gleichen und herausragend auf ihrem jeweiligen Gebiet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200149
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200149,
					"content": "Wir sechs, vereint ... hätten die große Katastrophe abwenden sollen, und den König der Finsternis daran hindern, das Weltgefüge weiter ins Wanken zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200150
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200150,
					"content": "Doch tief in ihrem Inneren hatten die fünf eine unersättliche Gier nach mehr. Sie konnten der Verlockung des Abgrunds nicht widerstehen und teilten unter sich eine Kraft, die die Welt zerstören konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200151
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200151,
					"content": "Sie wurden also zu Sündern, aber zugleich auch zu transzendenten Wesen. Jedes im Besitz einer weltzerstörenden Kraft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200152
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200152,
					"content": "Als dann die Katastrophe eintrat, erhob sich nicht einer zur Verteidigung seines Landes. Nicht einer trat hervor, um die Tragödie abzuwenden ... Und dafür werde ich ihnen niemals Vergebung gewähren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200153,
						80200154
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200153,
					"content": "Und dann ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200155,
					"content": "... Tatsächlich. Wenn sie nicht aufgehalten werden, wird unweigerlich der Tag kommen, an dem sie die ganze Welt verraten werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200156,
						80200157
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200156,
					"content": "Es muss dir schwerfallen, über all das zu sprechen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200158,
					"content": "Natürlich. Wie ich schon sagte, hegte ich nie Geheimnisse vor dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200159
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200159,
					"content": "Also, Dain, womit hast du dich die ganze Zeit beschäftigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200160,
					"content": "Ich habe weiterhin Fragen zum Webstuhl des Schicksals geprüft. Seit der „Webstuhl des Schicksals, Plan A“ in Kraft getreten ist, ist schon viel Zeit vergangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200161
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200161,
					"content": "Indem wir das Auge des weltweit ersten Pflugs zurückgeholt haben, konnten wir verhindern, dass ein Teil ihres Plans Wirklichkeit wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200162
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200162,
					"content": "Oh, Paimon erinnert sich! Wollten die das nicht nutzen, um Osial zu verderben und eine Art Gott zu erschaffen oder so ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200163,
					"content": "In der Tat ... Es war jedoch offenkundig, dass das lediglich eine Art technisches Experiment war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200164
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200164,
					"content": "Das Auge war ein zentraler Bestandteil ihres Plans, doch irgendwie haben sie, obwohl sie es sich nicht aneignen konnten, die experimentelle Phase übersprungen und einen anderen Weg gefunden, weiter voranzukommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200165
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200165,
					"content": "Es mehren sich die Zeichen, die dies belegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200166
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200166,
					"content": "Aber was machen wir denn jetzt? Es ist doch noch nicht zu spät, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200167,
					"content": "Unser drängendstes Anliegen ist es nun, zu klären, worin der Zweck des Webstuhls des Schicksals besteht. Auf dieser Basis werden wir die wahren Absichten des Ordens des Abgrunds ableiten können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200168
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200168,
					"content": "Nach den Informationen, die ich bislang zusammengetragen habe, gehe ich davon aus, dass der Webstuhl des Schicksals irgendwie mit dem Fluss der Elemente zusammenhängt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200169
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200169,
					"content": "Der Fluss der Elemente?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200170,
					"content": "#{NICKNAME}, du konntest beim letzten Mal die Erinnerungen deines Geschwisters beobachten, richtig? Ich vermute, der Grund dafür war, dass der Fluss der Elemente in dieser Gegend instabil war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200171
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200171,
					"content": "Meine jüngsten Untersuchungen haben gezeigt, dass Aktivitäten des Ordens des Abgrunds oft in einem besonderen Zusammenhang mit Auffälligkeiten im Fluss der Elemente stehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200172
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200172,
					"content": "Und eines der Dinge, die den Fluss der Elemente durchströmen ... sind Erinnerungen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200173
					]
				},
				{
					"id": 80200173,
					"content": "Warte, unsere Mission hier in Vimara ... Die Person, die nur in den Erinnerungen der Leute zu existieren scheint ... Könnte da eine Verbindung bestehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200174
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200174,
					"content": "(Erinnerungen ... der Fluss der Elemente ... der Webstuhl des Schicksals ... die vermisste Person, die nur scheinbar existiert ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200175
					]
				},
				{
					"id": 80200175,
					"content": "(Was ist die Verbindung zwischen all dem?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200176
					]
				},
				{
					"id": 80200176,
					"content": "Das ist ganz sicher möglich. Ich schließe mich morgen euren Ermittlungen an. Dieser Vermisstenfall könnte sich tatsächlich als der Schlüssel herausstellen, der diese Geheimnisse lüftet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200177
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200177,
					"content": "Na, wenn wir wieder mit Dain zusammenarbeiten, brauchen wir alle Energie, die wir kriegen können! Lasst uns morgen mal etwas weiter draußen nachforschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200401
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200401,
					"content": "*gähn* ... So müde ... Paimon hat gestern echt zu viel Hirnschmalz verbraucht. Alles nur wegen Dain und seinem komplizierten Geschwafel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200402,
						80200403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200402,
					"content": "Ich habe auch nicht gut geschlafen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200404,
					"content": "Also lass uns Dain suchen. Wir haben heute viel vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200403,
					"content": "Mein Kopf ist ganz durcheinander.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200157,
					"content": "Und doch danke ich dir, dass du mir das erzählst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200154,
					"content": "... kam mein Geschwister in Kontakt mit deinem Bruder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200140,
					"content": "Was ist wirklich damals in Khaenri’ah geschehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200132,
					"content": "In gewisser Weise, ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200127,
					"content": "Was ist mit den Informationen, die du mir versprochen hast?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				}
			]
		},
