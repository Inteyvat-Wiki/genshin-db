						],
						"pointId": 330201535
					}
				]
			},
			"dialogs": [
				{
					"id": 80200301,
					"content": "Oh, du hast es also hier versteckt! Wirklich ein Platz, an dem es nicht zu leicht zu finden ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200302,
					"content": "Also, gehen wir nachsehen, ob es noch da ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200303,
					"content": "#{NICKNAME}, warte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200304
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200304,
					"content": "Hm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200305
					]
				},
				{
					"id": 80200305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200306,
					"content": "... Verlieren wir keine Zeit, gehen wir rein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200307,
					"content": "(Was wollte Dain mir gerade sagen ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200308
					]
				},
				{
					"id": 80200308,
					"content": "He, wartet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 802004,
			"completionStepIds": [
				802009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"802009",
							"2"
						],
						"stepId": 802009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1138.109,
							201.003,
							2686.616
						],
