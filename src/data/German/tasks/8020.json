			"dialogs": [
				{
					"id": 80200101,
					"content": "Warte eine Sekunde ... Da ist doch ... Dainsleif!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200102,
					"content": "Ah, ihr zwei seid es ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200103
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200103,
					"content": "Oh, ein Freund von euch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200104
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80200104,
					"content": "Also, ich lass euch mal machen. Ich sollte sowieso zurück ins Dorf, um nach Dorfvorsteher Amadhiah und den anderen zu sehen. Bis später!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200105
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80200105,
					"content": "Jepp! Wir sehen uns später, Atossa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200106,
					"content": "Warum musst du immer wie aus dem Nichts auftauchen!? Ist es deine Lebensaufgabe, uns zu erschrecken oder was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200107,
					"content": "Das ist nichts Persönliches ... noch ist es gewollt. Solange wir beide dem Orden des Abgrunds auf der Spur sind, werden unsere Wege sich zwangsläufig kreuzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200108,
					"content": "Ah, also bist du hier, um den Orden des Abgrunds zu untersuchen! Das würde die Monster erklären, gegen die du gerade gekämpft hast ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200109,
					"content": "Natürlich. Wartet ... Seid ihr nicht aus dem gleichen Grund hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200110,
						80200111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200110,
					"content": "Wir sind ihnen auch auf den Fersen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				},
				{
					"id": 80200112,
					"content": "Hm, nun ja. Es mag eine Weile gedauert haben, bis du es begriffen hast, aber sicherlich ist dir mittlerweile auch aufgegangen ... Hier ist nicht alles, wie es scheint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200113
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200113,
					"content": "Der Orden des Abgrunds schmiedet zweifellos Pläne für diese Gegend ... oder noch schlimmer, ihr Plan könnte schon im Gange sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200114
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200114,
					"content": "Du glaubst also, dass der Orden des Abgrunds hinter den Hilichurl-Aktivitäten in der Gegend steckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200115,
					"content": "Wie die Dinge stehen, bezweifle ich sehr, dass das ihr hauptsächliches Motiv ist. Ich gehe davon aus, dass die erhöhten Hilichurl-Aktivitäten eher eine Nebenwirkung dessen sind, was sie eigentlich zu erreichen versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200116
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200116,
					"content": "Trotzdem, die Hilichurl-Aktivitäten machen den Leuten hier schwer zu schaffen. Wir sollten noch eine Weile bleiben und das Dorf schützen, findest du nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200117,
					"content": "Am besten schützen wir sie, indem wir aufdecken, was der Orden des Abgrunds wirklich im Schilde führt. Nur so können wir weiteres Unheil verhindern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200118,
						80200119
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200118,
					"content": "Nun, schauen wir mal, was wir noch von den Dorfbewohnern erfahren können.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200120,
					"content": "Und die sollt ihr bekommen. Ich war nie bestrebt, etwas vor euch zu verheimlichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200121
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200121,
					"content": "Keine Sorge ... Es wird noch ausreichend Zeit für Unterredungen geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200119,
					"content": "Und danach ... Du bist uns auch viele Antworten schuldig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200111,
					"content": "Aber, zugegeben, es war eher Zufall, dass wir auf sie gestoßen sind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				}
			]
		},
		{
