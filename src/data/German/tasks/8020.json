					}
				]
			},
			"dialogs": [
				{
					"id": 80200601,
					"content": "Genau wie ich erwartet habe ... Die falschen Erinnerungen waren eine Falle. Der Orden des Abgrunds wollte uns einfach nur hierher folgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200602
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200602,
					"content": "Jetzt, da sie in der Nähe sind, sollte es uns möglich sein, einen Blick auf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200603
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200603,
					"content": "Ach ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200604
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200604,
					"content": "Dain? Was ist los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200605,
					"content": "Spürt ihr das? Es gibt eine Turbulenz im Fluss der Elemente. Das muss das Werk des Abgrunds sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200606
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200606,
					"content": "Waah, du hast wohl sehr feine Antennen für diese Dinge. Paimon hat gar nichts gespürt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200607,
					"content": "Ihr zwei, macht, was ich sage ... Benutzt diese Vorrichtung da drüben und verschwindet von hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200608
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200608,
					"content": "Sollen wir dich hier allein lassen? Wirst du klarkommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200609
					]
				},
				{
					"id": 80200609,
					"content": "Der Orden des Abgrunds bringt irgendetwas ins Rollen. Ich vermute, wenn ihr ins Dorf Vimara zurückkehrt. Könntet ihr eine Gelegenheit haben, den vermissten Dorfbewohner ausfindig zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200610
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200610,
					"content": "... So wie das Sprichwort sagt: teile und herrsche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200611
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200611,
					"content": "In Ordnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200612
					]
				},
				{
					"id": 80200612,
					"content": "(Dain hat recht ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200613
					]
				},
				{
					"id": 80200613,
					"content": "(Irgendetwas stimmt trotzdem nicht ... Was ist mir entgangen ...?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200614
					]
				},
				{
					"id": 80200614,
					"content": "Hmpf ... Ich wusste, euch in euren Hinterhalt zu folgen, ist die einzige Möglichkeit, dich persönlich zu treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200615
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200615,
					"content": "Du hast also deine Sicherheit und die des Auges aufs Spiel gesetzt ...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200616
					]
				},
				{
					"id": 80200616,
					"content": "#Das ist wirklich riskant, Dainsleif ... Aber ich glaube, ich bin selbst {F#derjenige}{M#diejenige}, {F#der}{M#die} in die von dir, dem Schwert des Zwielichts, ausgelegte Falle tappt.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200617
					]
				},
				{
					"id": 80200617,
					"content": "Du bist also ganz allein hierhergekommen? Was ist mit deinen Anhängern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200618
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200618,
					"content": "Wenn das Schwert des Zwielichts bereit zum Kampf ist, würde jede Armee, die ich aussende, geradewegs in ihr Verderben marschieren ... Es ist besser, wenn ich dich selbst herausfordere.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200619
					]
				},
				{
					"id": 80200619,
					"content": "Ich weiß, es gibt viel, was du sagen möchtest ...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200620
					]
				},
				{
					"id": 80200620,
					"content": "... Aber wenn du eine Unterhaltung möchtest, dann musst du zuerst mich besiegen.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				}
			]
		},
