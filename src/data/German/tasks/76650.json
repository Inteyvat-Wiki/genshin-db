							10455.41
						],
						"pointId": 11806
					}
				]
			},
			"dialogs": [
				{
					"id": 766500201,
					"content": "Wir sind angekommen. Das, was ihr seht, ist der Mondspiegel, der die „Statue der Mondprophezeiung“ versiegelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500202
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500202,
					"content": "Das muss eine ziemlich wertvolle Statue sein, wenn sich jemand extra die Mühe gemacht hat, sie zu versiegeln ... Ob es da wohl Fallen gibt? Du weißt schon, die Art, bei der Pfeile herausfliegen, wenn man auf die falsche Stelle tritt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500203,
						766500204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500203,
					"content": "Ich bin bereit!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500205
					]
				},
				{
					"id": 766500205,
					"content": "Nur keine Sorge. Ich habe den Kleinen schon hineingeschickt, um sich das anzusehen. Da gibt es keine tödlichen Fallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500206
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500206,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500207
					],
					"speakerTitle": "Schatzmarder"
				},
				{
					"id": 766500207,
					"content": "Oh, toll! Gut zu wissen. Klingt perfekt geeignet für einen Schatzmarder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500208,
						766500209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500208,
					"content": "Aber der Schatzmarder wird doch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500210
					]
				},
				{
					"id": 766500210,
					"content": "Haha, ja, das stimmt. Jedes Mal, wenn ich ihn um Hilfe bitte, muss ich ihm eine Mora mehr als beim letzten Mal geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500211
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500211,
					"content": "Ha, was für ein diebischer kleiner Marder! Wie typisch für diese Art!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500212,
					"content": "Hmm, aber wenn man bedenkt, dass es dir hilft, die Statue der Mondprophezeiung zu bewachen, könnte er eine Namensänderung brauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500213,
					"content": "Wie wäre es mit ... „Wachmarder“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500214,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500215
					],
					"speakerTitle": "Schatzmarder"
				},
				{
					"id": 766500215,
					"content": "Hehe, niemand fängt Paimon! Paimon kann doch fliegen! Miehehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500216,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500217,
						766500218
					],
					"speakerTitle": "Schatzmarder"
				},
				{
					"id": 766500217,
					"content": "He, he, Klettere nicht auf mich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500219
					]
				},
				{
					"id": 766500219,
					"content": "Komm schon, sei nett zu unseren Gästen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500220
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500220,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500221,
						766500222
					],
					"speakerTitle": "Schatzmarder"
				},
				{
					"id": 766500221,
					"content": "Also, wie kann ich helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500223
					]
				},
				{
					"id": 766500223,
					"content": "Um die Statue der Mondprophezeiung zu bekommen, muss man die Vorrichtung gleichzeitig an zwei verschiedenen Orten bedienen. Da müssen also zwei Personen ran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500224
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500224,
					"content": "Geh bitte rüber und bediene die Vorrichtung auf der Seite dort. Ich werde mich um die Seite hier kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500225
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500225,
					"content": "Aber wie können wir sicherstellen, dass wir sie gleichzeitig aktivieren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500226
					]
				},
				{
					"id": 766500226,
					"content": "Das wird kein Problem sein. Ich habe Augen am Himmel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500227
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500227,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500228
					],
					"speakerTitle": "Ibis"
				},
				{
					"id": 766500228,
					"content": "So weiß ich immer, wo du bist und welche Vorrichtung vor dir steht. Keine Sorge, du musst nur meine Anweisungen befolgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500222,
					"content": "Wie aktivieren wir diese Vorrichtung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500223
					]
				},
				{
					"id": 766500218,
					"content": "Bitte nicht meine Haare, nicht meine Haare ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500219
					]
				},
				{
					"id": 766500209,
					"content": "Sicher nicht umsonst arbeiten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500210
					]
				},
				{
					"id": 766500204,
					"content": "Ich bin sowas gewohnt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500205
					]
				}
			]
		},
		{
			"id": 7665003,
