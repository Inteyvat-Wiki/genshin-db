			"dialogs": [
				{
					"id": 766500101,
					"content": "~♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500102
					],
					"speakerTitle": "Ibis"
				},
				{
					"id": 766500102,
					"content": "Ja, ich bin sicher, dass du sehr viele Freunde hast, aber das ist nicht das Problem. Selbst wenn du jeden Ibis auf der Insel Hiisi herbeirufen würdest, glaube ich nicht, dass du den Mondspiegel bewegen könntest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500103,
					"content": "Außerdem, selbst wenn man ihn bewegen würde, würde die „Statue der Mondprophezeiung“ darin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500104
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500104,
					"content": "!!!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500105
					],
					"speakerTitle": "Schatzmarder"
				},
				{
					"id": 766500105,
					"content": "... Ausgraben? Hmm, das könntest du, aber den Spiegel zu bewegen, wäre selbst für dich eine Herausforderung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500106,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500107
					],
					"speakerTitle": "Ibis"
				},
				{
					"id": 766500107,
					"content": "Hm? Du kannst wirklich alle Ibisse der Insel Hiisi herbeirufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500108,
					"content": "... Und du hingegen hältst diesen Plan für einen Witz, selbst wenn er seine gesamte Familie mit einbezieht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500109
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500109,
					"content": "!!!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500110
					],
					"speakerTitle": "Schatzmarder"
				},
				{
					"id": 766500110,
					"content": "Wah, hier ist aber viel los. Warum streiten sich ein Schatzmarder und ein Vogel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500111,
						766500112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500111,
					"content": "Hecken die etwa was zusammen aus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500113
					]
				},
				{
					"id": 766500113,
					"content": "Genau genommen ist es tatsächlich so, dass wir etwas „aushecken“. Außerdem müssen wir jetzt wohl über die „Details“ diskutieren, bevor wir loslegen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500114
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500114,
					"content": "Aber meine Komplizen sind sich ziemlich uneinig über den besten Ansatz und sie sind dabei nicht gerade diplomatisch. Gewisse Worte wurden bereits gesprochen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500115,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500116
					],
					"speakerTitle": "Ibis"
				},
				{
					"id": 766500116,
					"content": "Schon gut, schon gut, ich glaube dir ja. Ich bin sicher, du hast Freunde in hohen Positionen. Aber wo hast du gelernt, so zu sprechen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500117,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500118
					],
					"speakerTitle": "Ibis"
				},
				{
					"id": 766500118,
					"content": "... Von einem kleinen Mädchen mit einem eisernen Arm und einem Hut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500119,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500120
					],
					"speakerTitle": "Ibis"
				},
				{
					"id": 766500120,
					"content": "Oh, wenn es dich glücklich macht, so zu sprechen, ist das in Ordnung. Aber ... du brauchst nicht alles nachzuahmen, was sie tut, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500121
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500121,
					"content": "#Nun werde ich mit {NICKNAME} und Paimon über etwas Wichtiges sprechen. Also bitte erst mal etwas Ruhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500122
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500122,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500123
					],
					"speakerTitle": "Ibis"
				},
				{
					"id": 766500123,
					"content": "Ooh, er hat sich wirklich beruhigt. Es ist so toll, die Sprache der Tiere zu verstehen! Paimon wünschte, Paimon hätte diese Fähigkeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500124,
					"content": "Glaub mir, Paimon, du fändest diese Fähigkeit nicht so toll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500125,
						766500126
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500125,
					"content": "Das klingt ja beunruhigend ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500127
					]
				},
				{
					"id": 766500127,
					"content": "Oh, du hast mich missverstanden. Nichts Schlimmes würde passieren und es macht einen nicht verrückt oder so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500128
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500128,
					"content": "Obwohl das traurig ist, finde ich es manchmal ziemlich überwältigend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500129
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500129,
					"content": "Ich war überglücklich, als ich zum ersten Mal entdeckte, dass ich die Sprache der Tiere verstehen konnte, aber ich merkte schnell, dass es eine Kehrseite hatte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500130
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500130,
					"content": "Diese Fähigkeit ist immer aktiv und ich kann sie nicht kontrollieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500131
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500131,
					"content": "Oh ... Ja, das klingt doof. Und wenn du es nicht kontrollieren kannst, bedeutet das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500132,
						766500133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500132,
					"content": "Ob im Wald oder am Wasser ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500134
					]
				},
				{
					"id": 766500134,
					"content": "Ganz genau. Die Menschen sagen, dass sie beim Hören des Vogelgezwitschers tief im Wald ein tiefes Gefühl von Frieden und Ruhe empfinden, das ihre Stimmung hebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500135
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500135,
					"content": "Aber egal wohin ich gehe, finde ich niemals ein Gefühl von ... Frieden und Ruhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500136
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500136,
					"content": "Immer, wenn ich im Wald war, konnte ich das Geplapper von Wildkatzen, Kaninchen, Rauhorn-Hirschen, Poncho-Dachsen und Ibissen hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500137
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500137,
					"content": "Sie diskutierten lautstark darüber, wer wessen Nest zerstört hat und welche Bäume die besten Äste hätten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500138,
						766500139
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500138,
					"content": "Deswegen bekommen deine Ohren nie Ruhe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500140
					]
				},
				{
					"id": 766500140,
					"content": "Na guuut, so toll ist es wohl doch nicht, Tiere sprechen zu hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500141,
					"content": "Zu Vogelgezwitscher aufzuwachen, ist ja ganz nett, aber ... Ersetze das Zwitschern durch Gezänk und plötzlich ist das Ganze nicht mehr so schön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500142,
						766500143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500142,
					"content": "Wir wissen beide, dass es mehr als etwas Gezwitscher braucht, um dich aufzuwecken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500144
					]
				},
				{
					"id": 766500144,
					"content": "Was mich betrifft ... Ich habe so lange damit gelebt, dass ich mich daran gewöhnt habe. Es wäre wahrscheinlich eine ziemliche Umstellung, wenn ich eines Tages aufwachen würde und nicht hören könnte, wie die Finken darüber diskutieren, in welcher Tasse in welchem Haus man am besten baden könne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500145
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500145,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500146
					],
					"speakerTitle": "Schatzmarder"
				},
				{
					"id": 766500146,
					"content": "#Ja, Verschwörungen und Intrigen, danke, dass du mich daran erinnerst. Ich bin ein wenig abgelenkt. Obwohl jetzt, da {NICKNAME} hier ist, haben wir vielleicht die Lösung für unser Problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500147,
						766500148
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500147,
					"content": "Auch ich habe Freunde in hohen Positionen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500149
					]
				},
				{
					"id": 766500149,
					"content": "Nicht nötig, du reichst vollkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500150
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500150,
					"content": "Bei diesem Auftrag muss man in einen Lagerraum einbrechen, indem man das von einer früheren Mondkantorin mit dem Mondspiegel geschaffene Siegel bricht. Aber ich bin sicher, dass dies für jemanden mit deinen Talenten eine einfache Aufgabe ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500151,
						766500152
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500151,
					"content": "Von einer früheren Mondkantorin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500153
					]
				},
				{
					"id": 766500153,
					"content": "Keine Sorge, das sollte für dich nicht schwer sein. Komm, wir gehen zusammen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500152,
					"content": "Dafür brauch ich eine Einführung vor Ort!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500153
					]
				},
				{
					"id": 766500148,
					"content": "Ich brauch nur etwas Zeit, um die Leute zusammenzutrommeln.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500149
					]
				},
				{
					"id": 766500143,
					"content": "Wie oft musste ich dich schon wachrütteln?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500144
					]
				},
				{
					"id": 766500139,
					"content": "Ein ständiges Geplapper, egal wohin du gehst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500140
					]
				},
				{
					"id": 766500133,
					"content": "Überall, wo Tiere sind ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500134
					]
				},
				{
					"id": 766500126,
					"content": "Da läuft es mir ja kalt den Rücken runter ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500127
					]
				},
				{
					"id": 766500112,
					"content": "Vielleicht streiten sie sich über die Aufteilung der Beute.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500113
					]
				}
			]
		},
		{
			"id": 7665002,
			"completionStepIds": [
				7665002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
