						],
						"pointId": 13525
					}
				]
			},
			"dialogs": [
				{
					"id": 766500301,
					"content": "Wah, was für eine riesige Statue... Ja, keine Menge an Vögeln oder Mardern kann die bewegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500302,
					"content": "Wahrscheinlich konnten sie nicht einmal am Spiegel vorbeikommen ... Also Lauma, wie wertvoll ist diese Statue überhaupt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500303,
					"content": "In Mora? Nicht viel, vermute ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500304,
					"content": "Sie ist grob gearbeitet und die Art von Stein, aus dem sie gemeißelt ist, findet man überall in dieser Gegend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500305
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500305,
					"content": "Aber für die Mondkantorin jener Ära und die Nachkommen des Frostmonds von heute ist sie ein unbezahlbarer Schatz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500306,
					"content": "Zumindest habe ich jetzt einen konkreten Beweis für ihre Existenz. Das reicht aus, um die Zuverlässigkeit mehrerer Dokumente zu diesem Thema zu bestätigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500307
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500307,
					"content": "Das zeigt mir, dass wir unsere Reise nicht umsonst gemacht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500308
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500308,
					"content": "#Vielen Dank für deine Hilfe, {NICKNAME}. Ich wusste, dass ich dich richtig eingeschätzt hatte. Der Mondspiegel war kein Hindernis für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500309,
					"content": "Und unser kleiner Freund hier war sehr beeindruckt von deinen Fähigkeiten bei der Bedienung der Vorrichtung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500310,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500311
					],
					"speakerTitle": "Schatzmarder"
				},
				{
					"id": 766500311,
					"content": "Was sagt er, Lauma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500312,
					"content": "#Er sagt, dass {NICKNAME} {F#die}{M#der} beste Schatzsucher{F#in} ist, {F#die}{M#den} es je gesehen hat. Er möchte, wenn möglich, mit {F#ihr}{M#ihm} auf die Suche nach allen Schatztruhen der Welt gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500313,
						766500314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500313,
					"content": "Das klingt ja fast, als wäre ich ein Dieb ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500315
					]
				},
				{
					"id": 766500315,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500316
					],
					"speakerTitle": "Schatzmarder"
				},
				{
					"id": 766500316,
					"content": "„Wenn ich in Zukunft irgendeine Truhe nicht öffnen kann, werde ich dich um Hilfe bitten!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500317
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500317,
					"content": "Äh ... na gut, tschüs dann ... Er hat eh nicht wissen wollen, was wir davon halten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500318,
					"content": "Keine Sorgen. Er wird schon nicht jeden Tag mit einer Mora im Maul an eure Fenster klopfen und euch bitten, auf Truhenjagd zu gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500319
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500319,
					"content": "Und er wird sicherlich nicht mitten in der Nacht in euer Zimmer kommen und über Schlösser jammern, die er nicht knacken kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500320
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500320,
					"content": "#Oh oh, wir sollten besser darauf achten, alle Türen und Fenster zu verschließen, bevor wir heute Nacht schlafen gehen, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500321,
					"content": "Ganz ruhig. Der Marder ist noch jung, er meint es nicht böse. Er ist nur ... gesprächiger als die meisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500322
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500322,
					"content": "Na gut, lass uns zurückgehen. Es ist fast Zeit fürs Abendessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500323
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500323,
					"content": "Oh, und wie schaffen wir die Statue zurück in die Bibliothek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500324
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500324,
					"content": "Da muss ich wohl doch ein wenig Hilfe von meinen Freunden in Anspruch nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500314,
					"content": "Wobei es natürlich stimmt, dass ich schon viele Schatztruhen geöffnet habe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500315
					]
				}
			]
		},
