						],
						"stepId": 7665002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lauma"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1900.978,
