			"dialogs": [
				{
					"id": 766500401,
					"content": "Hier wird es schon passen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500402
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500402,
					"content": "Hö ... Das ging alles ohne großes Tamtam über die Bühne. Paimon hatte erwartet, dass etwas Aufregendes passieren würde, sobald wir sie abstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500403,
					"content": "Hehe, na ja, es ist nur eine einfache alte Statue, ein historisches Relikt. Sie hat keinerlei mystische Kräfte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500404
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500404,
					"content": "Ihr wahrer Wert liegt in den Geschichten, die sie birgt ... Meine Aufgabe ist es, diese Geschichten zu entdecken, zu überprüfen und allen mitzuteilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500405
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500405,
					"content": "Klasse! Gut, dass wir sie in einem Stück zurückbekommen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500406,
					"content": "Da hast du recht, und dafür möchte ich euch beiden danken. Bitte, nehmt dieses Obst und löscht euren Durst. Ich habe es von den Tieren im Wald sammeln lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500407
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500407,
					"content": "Und nach alldem ... Verzeiht mir, aber ich habe noch eine Bitte an euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500408
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500408,
					"content": "Klar. Worum geht es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500409
					]
				},
				{
					"id": 766500409,
					"content": "Tut mir leid, dass ich so direkt bin. Aber ich habe gehört, dass ihr beide eine Menge Leute kennt und viele versteckte Orte auf euren Reisen besucht habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500410
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500410,
					"content": "Wenn ihr in Zukunft Bücher über die Nachkommen des Frostmonds findet, dürfte ich sie ausleihen, um sie zu kopieren und die Bibliothek zu vervollständigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500411,
						766500412
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500411,
					"content": "Ja, gern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500413
					]
				},
				{
					"id": 766500413,
					"content": "Im Namen der Nachkommen des Frostmonds danke ich euch noch einmal für eure Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500414,
						766500415
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500414,
					"content": "Dann wende ich mich jetzt dem Obst zu ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500416
					]
				},
				{
					"id": 766500416,
					"content": "Huiii, das Obst war richtig lecker, ganz anders als das, was Paimon sonst so zu futtern kriegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500417,
					"content": "Hehe, die Tiere haben ihr ganzes Leben in diesem Wald verbracht. Natürlich wissen sie, wo es das beste Obst gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500418
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500418,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500419
					],
					"speakerTitle": "Papageientaucher"
				},
				{
					"id": 766500419,
					"content": "Pfft ... Das hier sagt: „Ihr könnt ruhig so viel essen, wie ihr wollt. Ich bin der beste Obstsucher im ganzen Wald und werde euch noch mehr bringen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500420
					],
					"speakerTitle": "Lauma"
