			"dialogs": [
				{
					"id": 760600101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600102
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600102,
					"content": "Hm? Ist das nicht Maalaus? War sie denn schon wieder draußen unterwegs, um Inspiration zu sammeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600103,
					"content": "Ja. Aber die Kleine ist schon so, seit sie zurückgekommen ist ... Als wäre sie in Gedanken versunken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600104
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760600104,
					"content": "Hm, vielleicht ist das Thema diesmal ja super tiefgreifend ... Ihr wisst schon, wie wenn ein großer Künstler sich plötzlich einer fundamentalen Wahrheit der Welt bewusst wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600105,
					"content": "Apropos, Maalaus hat uns eine ganze Reihe an Gemälden gegeben. Damit könnten wir eine ganze Ausstellung gestalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600106,
					"content": "Hehe, Paimon kann es gar nicht erwarten, allen vom Aufstieg unserer kleinen Malerin zum Kunststar zu berichten! Oh, aber zuerst müssen wir noch Columbina um Erlaubnis bitten, natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600107,
					"content": "Hm? Warum das denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600108
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760600108,
					"content": "Na ja, weil es fast ausschließlich Bilder von dir sind.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600109
					]
				},
				{
					"id": 760600109,
					"content": "Oh ... Das passt schon, stört mich nicht. Es klingt verlockend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600110
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760600110,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600111
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600111,
					"content": "Oh, Maalaus scheint sich entschieden zu haben, was sie malen will! Schnell, schauen wir mal nach, welche Farbe wir haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600112,
					"content": "Jetzt ... versuchen wir mal ein paar tiefe und ruhige Farben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7606002,
