			},
			"dialogs": [
				{
					"id": 760600301,
					"content": "Gut, mit denen sollte es gehen. Was meinst du, Maalaus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600302,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600303,
					"content": "Jup, sieht für Paimon ganz nach einer glücklichen Kuuhenki aus! Hehe, was für ein Gemälde wir wohl diesmal bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600305
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600305,
					"content": "Oh, ist es etwa schon fertig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600307
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600307,
					"content": "Maalaus wirkt ein bisschen traurig. Ist es wegen des Gemäldes? Schauen wir es uns mal an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600308,
					"content": "Gut, das ist also Columbina ... wie sie einen Spaziergang im Mondlicht macht und hinauf in den Sternenhimmel schaut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600309,
					"content": "Oh ... Und wahrscheinlich schaue ich den wahren Mond hinter dem trügerischen Himmel an. Ich habe früher ständig solche Mitternachtsspaziergänge gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600310
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760600310,
					"content": "Früher ...? Oh, stimmt ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600311,
					"content": "(Columbina ist jetzt quasi an diesen Garten gebunden ... obwohl sie ja in Nod-Krai geboren wurde ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600312
					]
				},
				{
					"id": 760600312,
					"content": "Ja, dann habe ich immer in den Himmel gestarrt und mich gefragt ... Was liegt eigentlich wirklich auf dem wahren Frostmond dort oben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600313
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760600313,
					"content": "Vielleicht ist es ja genau wie hier, voll von kleinen Tieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600314
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760600314,
					"content": "Oder vielleicht ... gibt es da ja auch rein gar nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600315
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760600315,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600316,
						760600319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600316,
					"content": "Du könntest doch immer einfach ein paar mit nach oben nehmen, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600317
					]
				},
				{
					"id": 760600317,
					"content": "Ha ... interessanter Gedanke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600318
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760600318,
					"content": "Aber ... Aber da der Mond hinter dem trügerischen Himmel liegt, würde ich sie lieber nicht mit auf dieses riskante Abenteuer nehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760600322,
					"content": "(Das eine ist ein „Zuhause“, wo sie sich nicht einmal frei bewegen kann, das andere ist ein „Zuhause“, über das sie nichts weiß ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600323
					]
				},
				{
					"id": 760600323,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600324
					]
				},
				{
					"id": 760600324,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600325
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600325,
					"content": "Maalaus und die anderen Kuuhenki werden dich sehr vermissen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600326,
					"content": "Und ich werde sie auch vermissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600327
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760600327,
					"content": "Aber am Ende ist das eine Reise, die nur ich antreten kann ... Und die Antwort am Ende von alldem kann nur ich allein suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600328
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760600328,
					"content": "Und, wer weiß? Wie auch immer die Antwort ausfallen wird ... Vielleicht wird es ja etwas Wunderschönes sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600329
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760600329,
					"content": "Al... Also ... Dann müssen wir dich einfach besuchen kommen! Mit Maalaus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600330,
					"content": "Gut. Diese Kunstausstellung könnten wir vielleicht auch auf dem Mond veranstalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600331
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760600331,
					"content": "Ja, großartige Idee! Dann ist es abgemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600332,
					"content": "Nun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600333
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760600333,
					"content": "Das hoffe ich, wirklich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760600319,
					"content": "Es könnte auch andere niedliche Kreaturen dort oben geben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600320
					]
				},
				{
					"id": 760600320,
					"content": "Mh, das hoffe ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600321
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760600321,
					"content": "Und ich hoffe ... falls dem so ist, dass diese Kreaturen die plötzliche und unerwartete Rückkehr ihrer „Göttin“ auch begrüßen würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "„Columbina“"
				}
			]
		},
