			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei",
					"Eula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401171401,
					"content": "Ich habe von Klee gehört, das es in ihrem Gebiet magische Fahrbahnen und einen „total aufregenden Tschu-Tschu-Express“ gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171402
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171402,
					"content": "Oh, du meinst den Wagen, der mit „unkontrollierbarer“ Geschwindigkeit über die „furchterregenden“ Fahrbahnen saust?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171403,
					"content": "Ja, das ist es. Ich habe gehört, dass der Wagen manchmal fast senkrecht in die Tiefe stürzt und dein Körper schwebt wie in der Schwerelosigkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171404
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171404,
					"content": "Echt? Und ich habe gehört, dass Klees Rucksack fast aus dem Wagen geflogen wäre. Hätte Kaeya nicht so schnell reagiert, wäre die Luft voller Bimm-Bamm-Bomben gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171405
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171405,
					"content": "Oh?! Das klingt ja ... richtig gefährlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171406
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171406,
					"content": "*seufz* ... Wenn du wirklich damit fahren willst, komme ich mit, falls ich Zeit habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171407
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171407,
					"content": "Äh? Eula, warum erwähnst du das plötzlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171408
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171408,
					"content": "Deine Gedanken sind auch leicht zu erraten ... Aber zuerst muss ich klarstellen, dass ich dir nicht helfen werde, deine Sachen einzusammeln. Denk also daran, deine persönlichen Sachen zuerst herauszunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171409,
					"content": "Ja, ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
		{
			"id": 4011715,
