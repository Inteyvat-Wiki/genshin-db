			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401171301,
					"content": "... Ach ja, Kaeya, du hast mir versprochen, die Geschichte vom Dschinn in der Flasche zu Ende zu erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171302
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171302,
					"content": "Ja, natürlich. Hm ... Bis wohin sind wir das letzte Mal gekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171303
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171303,
					"content": "Klee weiß es noch. Du hast erzählt, dass der Dschinn aus der Zauberflasche kam und den Hirtenjungen fressen wollte, der die Flasche geöffnet hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171304,
					"content": "Ach ja. Gerade als der böse Dschinn sein grässliches Maul aufriss, kam dem Hirtenjungen plötzlich eine Idee ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171305
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171305,
					"content": "Dem Dschinn eine Bimm-Bamm-Bombe ins Maul zu werfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171306
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171306,
					"content": "Haha, wenn der Hirtenjunge zu dieser Zeit eine Bimm-Bamm-Bombe gehabt hätte, hätte er das bestimmt getan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171307
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171307,
					"content": "Aber der Hirtenjunge hatte noch nie so etwas wie eine Bombe gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171314,
					"content": "Er konnte zu dem Dschinn nur sagen: „Warte, bist du mit diesem riesigen Körper wirklich aus der Flasche gekommen? Solange ich das nicht mit eigenen Augen gesehen habe, glaube ich das nicht!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171308
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171308,
					"content": "Der Dschinn war sehr wütend und sagte: „Brr, jämmerlicher Hirtenjunge, wie kannst du es wagen, an meiner Kraft zu zweifeln.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171309,
					"content": "Als er das ausgesprochen hatte, kroch er zurück in die Flasche. Geistesgegenwärtig verschloss der Hirtenjunge die Flasche wieder mit dem Korken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171310,
					"content": "Großartig, so kann der böse Dschinn nicht wieder rauskommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171311
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171311,
					"content": "Aber ... Wenn der böse Dschinn die ganze Zeit in so einer kleinen Flasche eingesperrt ist, kann er dann überhaupt richtig schlafen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171312
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171312,
					"content": "Na, er wurde ja gefangen und eingesperrt, weil er so böse Sachen gemacht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171313
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171313,
					"content": "Wenn du also etwas Böses tust und nicht eingesperrt werden willst, ist es entscheidend, dich nicht schnappen zu lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 4011714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
