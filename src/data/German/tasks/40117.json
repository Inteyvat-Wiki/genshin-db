			"dialogs": [
				{
					"id": 401171501,
					"content": "Erst habe ich es Frau Alice großspurig versprochen und dann bricht in der Mirage so ein Chaos aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171502
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 401171502,
					"content": "Aber, wie das Fräulein „Militärberaterin“ gesagt hat, solange wir die Mirage wiederherstellen können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				}
			]
		},
		{
