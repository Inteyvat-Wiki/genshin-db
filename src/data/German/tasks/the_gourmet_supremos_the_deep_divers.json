			},
			"dialogs": [
				{
					"id": 721700401,
					"content": "Müssen wir wirklich einen Weg finden, um einzutauchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700402
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700402,
					"content": "Können wir nicht einfach irgendwo anders Seegras pflücken? Warum muss es hier sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700403
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700403,
					"content": "Wieso ist die Vorrichtung wieder in einer Barriere ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
		{
