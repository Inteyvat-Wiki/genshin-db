			"dialogs": [
				{
					"id": 721700601,
					"content": "Nun, hier ist doch nicht noch eine Ruine oder so etwas drunter, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700602
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700602,
					"content": "R... Ruinen? Nun, es wäre sicherlich schön, wenn es sie wirklich gäbe ...",
