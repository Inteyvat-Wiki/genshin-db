			},
			"dialogs": [
				{
					"id": 721700701,
					"content": "Hier sieht es aus, als wäre es überflutet worden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700702
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700702,
					"content": "Du siehst, die Wasserspuren in der Umgebung sind noch deutlich zu sehen. Dieser Ort wurde tatsächlich vor nicht allzu langer Zeit überflutet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700703
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700703,
					"content": "Aber warum ist das ganze Wasser plötzlich zurückgegangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700704
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700704,
					"content": "Uff ... Es ist alles nass hier in der Umgebung, meine Schuhe werden feucht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700705
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700705,
					"content": "Vergiss das, beeil dich einfach, pflücke schnell ein wenig Seegras.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700706
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700706,
					"content": "Was macht ihr denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700707
					]
				},
				{
					"id": 721700707,
					"content": "#Hm? Ich kann nicht glauben, dass ich dich sogar hier getroffen habe. Das ist Bestimmung, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700708
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700708,
					"content": "Wir haben gerade unten etwas frisches Seegras besorgt, um ein Essen namens „Onigiri“ zu machen. Der Weg hinunter war einfach mies. Meine Schuhe sind jetzt pitschnass ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700709
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700709,
					"content": "#Genug davon für den Moment. Reisende{M#r}. Kannst du uns helfen, unten noch etwas Seegras zu sammeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700710
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700710,
					"content": "Es scheint vor nicht allzu langer Zeit überflutet worden zu sein. Obwohl das Wasser jetzt zurückgegangen ist, kommt es vielleicht bald wieder zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700711
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700711,
					"content": "Ich denke, wir sollen so schnell wie möglich noch etwas Seegras sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700712,
						721700715
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700712,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700713
					]
				},
				{
					"id": 721700713,
					"content": "#Dann zähle ich auf dich, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700714
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700714,
					"content": "Sobald du das Seegras bekommen hast, bringe es bitte so schnell wie möglich zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700715,
					"content": "Warum sammeln wir es nicht am Strand?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700716
					]
				},
				{
					"id": 721700716,
					"content": "Die Art vom Seegras am Strand ist nicht besonders frisch und ist beim Kochen weniger schmackhaft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700717
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700717,
					"content": "#Die Qualität vom Seegras an diesem Ort sollte einfach gut sein. Wie auch immer, das Seegraspflücken überlasse ich dir, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700718
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700718,
					"content": "Sobald du das Seegras bekommst, bringe es bitte so schnell wie möglich zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		}
	]
}