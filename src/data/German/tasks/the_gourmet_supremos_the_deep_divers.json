			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721700101,
					"content": "Wir können so nicht nach unten gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700103
					]
				},
				{
					"id": 721700103,
					"content": "#{F#Reisende}{M#Reisender}, hallo. Wir versuchen herauszufinden, wie man ... ins Wasser vor uns tauchen sollte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700104
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700104,
					"content": "Dann gehen wir hinein und holen etwas frisches Seegras, um ein Essen namens „Onigiri“ herzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700105,
						721700107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700105,
					"content": "Könntest du nicht etwas vom Strand besorgen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700106
					]
				},
				{
					"id": 721700106,
					"content": "Die Art von Seegras, die nicht so ganz frisch am Strand zu finden ist, ist immer weniger geschmackvoll beim Zubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700109,
					"content": "Ich habe mich in der Stadt umgehört und es gibt einige Seegras von sehr guter Qualität, die hier unten wächst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700110,
					"content": "Aber als ich heute ankam ... sah ich, dass der Ort komplett mit Wasser überflutet war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700111
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700111,
					"content": "Und wir alle drei ... können gar nicht tauchen und nur glotzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700112,
					"content": "Gibt es hier in der Umgebung irgendwelche Vorrichtungen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700113
					]
				},
				{
					"id": 721700113,
					"content": "Da drüben ist eine Vorrichtung! Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700114
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700114,
					"content": "Die Vorrichtung steckt wieder in einer Barriere. Wir kommen gar nicht heran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700115,
					"content": "Oh, lass uns hier noch ein bisschen darüber nachdenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700116
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700116,
					"content": "#{F#Reisende}{M#Reisender}, wenn du weißt, wie man das Problem lösen kann, komm bitte rüber und sag es uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700117
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700117,
					"content": "Natürlich wäre es schön, wenn du das Seegras einfach holen könntest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700118
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700118,
					"content": "Herr Xudong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700119
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700119,
					"content": "Ähem! Wenn du das Seegras mitbringen könntest, würdest du dafür bezahlt werden und ein Festmahl an Onigiri dazubekommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700120
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700120,
					"content": "Wie um alles in der Welt kann man ein Onigiri als „Festmahl“ bezeichnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700121
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700121,
					"content": "Puh, solange es genug von ihnen gibt ... ähem, lass uns einfach weiter überlegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700107,
					"content": "Müssen wir da eintauchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700108
					]
				},
				{
					"id": 721700108,
					"content": "Die Art von Seegras, die du direkt vom Strand pflücken kannst, ist nicht sehr frisch und fühlt sich beim Kochen immer weniger geschmackvoll an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7217002,
			"completionStepIds": [
				7217003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
