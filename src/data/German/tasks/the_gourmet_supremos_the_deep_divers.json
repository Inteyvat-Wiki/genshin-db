			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721700301,
					"content": "Seegras ... Fisch ... und Reis ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700302,
					"content": "Ich denke, es wird so gemacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700303
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700303,
					"content": "Und das war’s! Das ist jetzt der „Onigiri“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700304,
					"content": "Das ist hübsch ... schlicht und einfach ... Ich nehme das hier ... Ich habe das Gefühl, ich werde nicht alles essen können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700305
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700305,
					"content": "Solange es gut schmeckt, werde ich es nehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700306
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700306,
					"content": "#Hier ist etwas für dich, {F#Reisende}{M#Reisender}. Und diese „Onigiri“-Zubereitung habe ich auch für dich kopiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700307,
					"content": "Obwohl „Onigiri“ einfach aussehen, braucht es ein wenig Geschick, um sie schmackhaft zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700308,
					"content": "Ähem ... nun, genug des Geschwafels für den Moment, ich werde nach all der Arbeit ein wenig essen gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700309,
					"content": "He! Parvaneh, hast du nicht gesagt, dass du nicht alles essen kannst? Hebe etwas für mich auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
