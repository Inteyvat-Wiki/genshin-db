			"dialogs": [
				{
					"id": 721700501,
					"content": "Das Seegras hier ist nicht schlecht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700502
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700502,
					"content": "Na ja ... das fühlt sich eher wie „zupfen“ als „rupfen“ an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700503
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700503,
					"content": "Wenn du ein Messer verwendest, kannst du das Seegras in einem Zug pflücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
		{
			"id": 7217006,
