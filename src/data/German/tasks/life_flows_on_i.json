					"nextDialogs": [
						414211002
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414211002,
					"content": "Ui, auf einmal spricht sie fließend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414211003,
					"content": "Mein Wortschatz hat sich durch die Vereinigung mit Hydro-Mimentierchen vergrößert. Ich kann nun die Nachricht aus Quellingen verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211004
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414211004,
					"content": "„Der Strom des Lebens fließt immer weiter.“ Es ist doch ein wenig schwermütig. Ein kleines, aber rätselhaftes Gedicht. Ich verstehe es nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211005
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414211005,
					"content": "Vielleicht findest du es ja später heraus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414211006
					]
				},
				{
					"id": 414211006,
					"content": "Endora muss noch viel lernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414211007
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414211007,
					"content": "Rhodeia war in letzter Zeit völlig außer sich. Ich muss mich ihr stellen, vielleicht können wir so das Problem lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Endora"
				}
			]
		},
