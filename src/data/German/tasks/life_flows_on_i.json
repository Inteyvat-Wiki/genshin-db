			"dialogs": [
				{
					"id": 414210801,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210802
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210802,
					"content": "Sie sagte einige ... komische Dinge. Endora verstand nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210803
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210803,
					"content": "Der Strom ... hmm? Ich verstand nicht. Gefragt, keine Antwort erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210804
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210804,
					"content": "Ihr Wortschatz ist verbesserungswürdig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210805
					]
				},
				{
					"id": 414210805,
					"content": "Ich schätze, die Fee der Quelle hat ihre Gründe, warum sie uns nicht treffen will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210806,
					"content": "Ich verstehe ... nicht. Okeaniden halten gern zueinander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210807
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210807,
					"content": "Sie ist ... ein Geist. Ganz alleine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210808
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210808,
					"content": "Vielleicht weil andere Wesen nicht zu euch passen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210809,
					"content": "Oh? Warum nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210810
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210810,
					"content": "Na ja, wir würden sofort ertrinken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210811,
					"content": "Du bist einsam ... Wir lieben alle ... Wir lieben alle Menschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210812
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210812,
					"content": "Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210813
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210813,
					"content": "Äh? Was geht hier vor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210814,
					"content": "Rhodeias Auge ... in der Nähe des Steintors! Kleine Wassertiere. Ihre Späher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210815
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210815,
					"content": "Wassertiere? Wir haben hier einige Hydro-Mimentierchen gesehen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210816,
						414210817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210816,
					"content": "Ja, schätze schon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				},
				{
					"id": 414210818,
					"content": "Mächtiges Wasser ... verwandelt sich in Tiere. Sehr gefährlich. Aber wenn man sich mit ihnen verbindet, erfährt man neues Wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210819
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210819,
					"content": "Bring mich dorthin. Rhodeia ist beunruhigt. Rhodeia ... macht Wasser bitter. Endora lernt sprechen. Erklären es ihr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210820
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210820,
					"content": "Du willst uns also helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210821
					]
				},
				{
					"id": 414210821,
					"content": "Ja. Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414210822
					],
					"speakerTitle": "Endora"
				},
				{
					"id": 414210822,
					"content": "#Na ja, {NICKNAME}, es ist einen Versuch wert. Andere Spuren haben wir jedenfalls nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 414210817,
					"content": "Wirklich? Ich kann mich nicht erinnern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414210818
					]
				}
			]
		},
