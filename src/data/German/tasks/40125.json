			"dialogs": [
				{
					"id": 401251101,
					"content": "Fräulein Sangonomiya, möchtest du die Muschel nicht zurücknehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401251102,
					"content": "Ich denke, es wäre angemessener, wenn Idyia sie behalten würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401251103,
					"content": "Heute besitzt Watatsumi einen neuen „Schatz“ und die Wünsche von Leuten werden langsam erfüllt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251104
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401251104,
					"content": "Lass sie über die Träume der Reisenden wachen, die einst in dieser Mirage in der Flasche waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
			"id": 4012512,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
