			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei",
					"Eula",
					"Lessig",
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401251201,
					"content": "Wenn wir uns von Aaru-Dorf aus auf dem Weg machen ... können wir über Karawanen-Ribat und Pardis Dhyai reisen ... und einen Abstecher nach Sumeru machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251202
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251202,
					"content": "Ich verstehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251203
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251203,
					"content": "Wollt ihr unterwegs noch ein paar Souvenirs einkaufen? Ihr könnt euch auf den Kauf der Geschenke konzentrieren, ich trage die Taschen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251204
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401251204,
					"content": "Solange ich sie halten kann, ist es kein Problem, wie schwer sie sind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251205
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401251205,
					"content": "Ich habe nicht so viele Freunde, denen ich etwas schenken kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251206
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251206,
					"content": "Mama, Albedo, Jean, Razor ... und Diona, Mona ... und Fischl auch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251207
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251207,
					"content": "Warum guckst du mich so an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251208
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251208,
					"content": "N... Nichts, gar nichts!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251209
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251209,
					"content": "Welches Geschenk würde Klee gerne für alle auswählen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251210
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251210,
					"content": "Ähm ... Süßigkeiten mit Dämmerfrucht-Geschmack! Und große Hüte wie die der Pilzbestien, und ... und ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251211
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251211,
					"content": "... Und viele, viele Märchenbücher für alle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251212
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251212,
					"content": "Aber ich weiß immer noch nicht, was ich Mama schenken soll ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251213
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251213,
					"content": "Das ist in Ordnung, du kannst unterwegs nachdenken, und wir werden dir auch beim Denken helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251214,
					"content": "Danke dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		}
	]
}