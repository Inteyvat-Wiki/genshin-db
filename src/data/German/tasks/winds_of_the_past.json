			"dialogs": [
				{
					"id": 3061201,
					"content": "Die Leute in Mondstadt werden immer noch von dem Sturm umgehauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061202
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061202,
					"content": "Jede Sekunde, die verstreicht, bedeutet weniger Zeit für die Pflichterfüllung eines Ritters! Gehen wir sofort in den Tempel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		}
