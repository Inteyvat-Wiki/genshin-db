			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3061101,
					"content": "Da sind wir! Einer der <color=#00E1FFFF>Tempel der „Vier Winde“</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061102,
					"content": "Diese Tempel sind schon seit vielen Jahren verlassen. Die Bewohner von Mondstadt lassen sich hier so gut wie nie blicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061103,
					"content": "Wenn wir Pech haben, haben sich im Innern Monster eingenistet. Vielleicht ist dort sogar ein Hilichurl-Lager.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061104,
					"content": "Hach, selbst Sturmschrecken hat seinen eigenen Tempel verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061105,
						3061106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061105,
					"content": "Wieso Sturmschrecken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				},
				{
					"id": 3061107,
					"content": "Ganz genau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061108,
					"content": "Obwohl ich es selbst nicht wahrhaben will, ist Sturmschrecken eigentlich einer der Vier Winde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061109,
					"content": "Ist nicht wahr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3061110,
					"content": "Das ist jetzt nicht so wichtig. Hast du das eben auch gemerkt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061111,
					"content": "Diese Anemo-Kraft ... Hier stimmt etwas nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061112,
					"content": "#Wir sollten drinnen nachsehen, {NICKNAME}. Aber sei vorsichtig, die Stärke des Drachen ist auch hier zu spüren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061106,
					"content": "Für ihn hatte man einen Tempel errichtet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				}
			]
		},
