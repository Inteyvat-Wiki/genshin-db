			"dialogs": [
				{
					"id": 761410501,
					"content": "Ich verstehe es, wenn du noch eine Weile bleiben willst. Schließlich existiert diese Landschaft nur in meinen Erinnerungen – du wirst sie nirgendwo anders finden.",
					"roleType": "TALK_ROLE_NPC",
