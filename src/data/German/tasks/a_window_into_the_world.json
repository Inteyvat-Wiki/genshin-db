			},
			"dialogs": [
				{
					"id": 761410101,
					"content": "Willkommen zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410102,
					"content": "Aber es ist noch nicht an der Zeit für einen langen, tränenreichen und zutiefst emotionalen Abschied ... Schließlich habt ihr meine kleine Hütte noch nicht zu Ende besichtigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410103,
					"content": "Aber Paimon könnte schwören, dass wir schon in allen Zimmern waren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761410104,
					"content": "Nun, ich habe nie gesagt, dass es keine geheimen versteckten Räume gibt, oder? Wir Hexen lieben solche kleinen Spielereien, weißt du – du solltest dich inzwischen daran gewöhnt haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410105
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410105,
					"content": "Hier entlang, bitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7614102,
			"completionStepIds": [
				7614102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614102",
							"2"
						],
						"stepId": 7614102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nicole"
				],
				"points": [
					{
						"sceneId": 1156,
						"position": [
							17.908,
							6.364,
							76.402
						],
						"pointId": 15
					}
				]
			},
			"dialogs": [
				{
					"id": 761410201,
					"content": "Als einer der festen Beobachtungspunkte für Veränderungen in der Welt brauche ich eine ausgezeichnete Sicht. So wie ein Bildhauer einen Meißel braucht, braucht ein Schriftsteller Feder und Tinte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410202
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410202,
					"content": "Ob ich in diesen beiden Kunstrichtungen wirklich so talentiert bin, mag man anzweifeln. Aber was meine eigentliche Arbeit angeht, da nehme ich die Dinge sehr ernst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410203,
					"content": "#{NICKNAME}, du hast es sicher auch bemerkt, dass in letzter Zeit das „Schicksal“ von Teyvat immer öfter erschüttert wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410204,
					"content": "Manchmal kann ich nicht anders, als zu denken, dass ich – wenn ich noch meine frühere Gestalt, Kraft und die Fähigkeiten hätte – so viel mehr tun könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410205,
					"content": "Aber diese Gedanken schüttle ich schnell wieder ab. Wenn alles wie früher wäre, würde ich viel mehr Beschränkungen vom Himmel auferlegt bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410206,
					"content": "Der Gedanke daran, so viele Dinge zu haben, über die ich nicht mal reden kann, lässt das Ganze wie einen wirklich schlechten Handel erscheinen. Ich meine, wie soll ich Geschichten erzählen, wenn ich nicht die Freiheit habe zu sagen, was ich will?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410207,
					"content": "Deshalb habe ich den Preis, den ich gezahlt habe, oder meine Entscheidungen nie bereut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410208,
					"content": "Ich wollte ein Mensch werden, ein normales Leben führen ... aber so ein Leben ist Luxus. Ich kann nicht vergessen, dass ich ein Engel bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410209,
					"content": "Selbst wenn ich für immer ein stummer Engel bleiben müsste, würde ich meine Pflicht erfüllen – die Zivilisation verteidigen, das Leben verteidigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410210
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410210,
					"content": "Oje, rede ich schon wieder so ernst? Vielleicht liegt es daran, wo wir gerade sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410211,
					"content": "Ich bin eigentlich ziemlich glücklich mit meiner Engelsseite. Man könnte sogar sagen, ich bin stolz darauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410212
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410212,
					"content": "Das solltest du auch! Du mischst dich zwar nicht oft ein, aber wenn du es tust, wissen wir alle, dass wir in sicheren Händen sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761410213,
					"content": "Darauf kannst du stolz sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761410214
					]
				},
				{
					"id": 761410214,
					"content": "Meint ihr das ernst? Hehe, solange ihr mich als jemanden seht, auf den ihr euch verlassen könnt, weiß ich, dass ich einen guten Job mache!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410215,
					"content": "Es wird spät. Hier, nehmt meinen Segen und setzt euer Abenteuer fort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410216
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410216,
					"content": "Habt keine Angst davor, euch zu verlaufen, und vergesst nie, dass ein Engel über euch wacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
