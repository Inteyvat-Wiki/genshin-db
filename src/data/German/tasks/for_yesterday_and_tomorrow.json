			},
			"dialogs": [
				{
					"id": 741850301,
					"content": "Hehe, Os, das wird dein neues Zuhause sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850302,
					"content": "Miau, miau?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850303
					],
					"speakerTitle": "Os"
				},
				{
					"id": 741850303,
					"content": "Ist schon komisch, oder? Cassiodor müsste doch längst weg sein, richtig? Aber wer ist dann dieser „kleine Os“ jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850304,
					"content": "Ist es vielleicht die Katze, die nicht von Cassiodor besessen war? Oder der Herr Os, der mit uns all die Abenteuer erlebt hat? ... Hm, Paimon ist ganz durcheinander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850305,
						741850307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850305,
					"content": "Paimon, es ist wirklich unpassend für dich, über so etwas nachzudenken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850306
					]
				},
				{
					"id": 741850306,
					"content": "Paimon bekommt es überhaupt nicht auf die Kette ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850309,
					"content": "Jedenfalls haben wir jetzt ein neues Zuhause für Os gefunden. Wenn später Zeit ist, können wir ganz oft vorbeikommen und mit Os spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850310,
					"content": "Miau, miau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Os"
				},
				{
					"id": 741850307,
					"content": "Os ist und bleibt Os.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850308
					]
				},
				{
					"id": 741850308,
					"content": "Auch wenn Paimon es nicht versteht, hat es doch eine gewisse Logik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}