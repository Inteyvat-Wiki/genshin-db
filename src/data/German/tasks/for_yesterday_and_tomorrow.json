							4347.329
						],
						"pointId": 8198
					}
				]
			},
			"dialogs": [
				{
					"id": 741850101,
					"content": "Herr Este, wir sind zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850102,
					"content": "Oho, wenn das nicht ... Halt, nein. Wer seid ihr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850103
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850103,
					"content": "#Hä? Du wirst uns doch nicht vergessen haben! Wir sind {NICKNAME} und Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850104,
					"content": "#{NICKNAME} und Paimon ... Von den Namen habe ich schon gehört ... Aber das dürfte wohl in einem Traum gewesen sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850105
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850105,
					"content": "Ähm ... Aber damals warst du doch ganz klar bei Bewusstsein, Este! Außerdem sind wir uns in den Tiefen begegnet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850106,
					"content": "Ach, ich träumte, dass alle Bewohner des Ortes zu Steinstatuen erstarrt waren, während ich als Einziger hilflos in der Stadt zurückblieb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850107
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850107,
					"content": "Bis schließlich zwei mutige Helden in die Stadt kamen und die schwere Aufgabe auf sich nahmen, alle zu retten ... Kann es sein, dass all dies in Wirklichkeit gar kein Traum war?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850108,
						741850109
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850108,
					"content": "Vielleicht, vielleicht aber auch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				},
				{
					"id": 741850110,
					"content": "Stimmt. Schließlich sind die Leute jetzt alle wieder normal, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850111,
					"content": "Aber es scheint, als hätten alle einige merkwürdige Träume gehabt. Was mag wohl geschehen sein? Waren wir einer Massenhypnose ausgesetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850112
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850112,
					"content": "Das alles zu erklären, würde mehr als einen Tag und eine Nacht dauern ... Also besser kein Wort mehr über Hypnose!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850113,
					"content": "Oh? Apropos Hypnose, ihr habt da eine Katze dabei, die auf den ersten Blick recht intelligent wirkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850114,
						741850116
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850114,
					"content": "Sie ist sogar noch schlauer, als sie aussieht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850115
					]
				},
				{
					"id": 741850115,
					"content": "Und sie ist unser Gefährte! Aber leider können wir sie nicht mit auf Reisen nehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850118,
					"content": "Was für ein Zufall! Gerade gibt es in unserem Klub einen Wohnplatz für eine Katze. Seit eines unserer Mitglieder, ein Enthusiast der Hypnosekunst, mit seiner Fellnase auf Reisen gegangen ist, ist ein Platz frei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850119
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850119,
					"content": "Wenn ihr nichts dagegen habt, könnt ihr sie hier zur Pflege abgeben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850120
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850120,
					"content": "Ich kann es mir nicht genau erklären, aber wir scheinen durch das Schicksal verbunden zu sein. Ich werde mich für euch gut um sie kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850121
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850121,
					"content": "Das Katzendomizil ist auf der anderen Seite des Gebäudes. Geht hin, dann seht ihr es!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Este"
				},
				{
					"id": 741850116,
					"content": "Sie ist unser Gefährte!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850117
					]
				},
				{
					"id": 741850117,
					"content": "Das stimmt, aber leider können wir sie nicht mit auf Reisen nehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850109,
					"content": "Das ist nicht wichtig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				}
			]
		},
