			"dialogs": [
				{
					"id": 711630201,
					"content": "Zibai scheint nicht hier zu sein ... Und das, obwohl sie uns eingeladen hat! Wo kann sie nur hin sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630202,
					"content": "Huch! Dieser Schirm kommt Paimon bekannt vor ... Haben wir den nicht schon mal irgendwo gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630203,
					"content": "Vielleicht gehört er ihr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630204
					]
				},
				{
					"id": 711630204,
					"content": "Du hast wahrscheinlich recht ... Aber warum sollte sie ihren Schirm hier an der Tür lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630205,
					"content": "Sie hat anscheinend ein ziemlich schlechtes Gedächtnis ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630206
					]
				},
				{
					"id": 711630206,
					"content": "Und was sollen wir jetzt tun? So wie das läuft, macht Paimon sich Sorgen, dass sie beim Essen vergisst, wie man die Stäbchen hält ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630207,
					"content": "*seufz* Wir sollten sie suchen gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630208,
					"content": "Warte mal ... Ich bin mir nicht sicher, ob das wirklich ein Schirm ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630209
					]
				},
				{
					"id": 711630209,
					"content": "Hä? Was ist das dann? Hmm ... Lass Paimon mal genauer hinsehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630210,
					"content": "Wah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
