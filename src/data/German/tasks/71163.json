				]
			},
			"dialogs": [
				{
					"id": 711630301,
					"content": "Was ist hier los? Wie sind wir hierhergekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630302,
					"content": "Na, wie gefällt euch das kleine Schmuckstück, das ich für euch gemacht habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630303
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630303,
					"content": "Also hier steckst du, Zibai! Was ist das für ein Schirm? Er hat plötzlich „wusch“ gemacht und uns hierher gebracht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630304,
					"content": "Anscheinend bin ich nicht die Einzige, die sich schwertut, sich an Sachen zu erinnern. Hast du schon vergessen, dass du schon einmal mit mir darauf unterwegs warst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630305
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630305,
					"content": "Hilft das deinem Gedächtnis auf die Sprünge?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630306
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630306,
					"content": "Oh! Das ist ... Das ist der Mondstreitwagen! Kein Wunder, dass er Paimon so bekannt vorkam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630307,
					"content": "Haha, das ist nur eine Nachbildung aus meinen Erinnerungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630308
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630308,
					"content": "Und das alles nur dank des zerbrochenen Jadeabzeichens, das du mir zurückgegeben hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630309
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630309,
					"content": "Oh! Das ist also das kleine Schmuckstück, das du herstellen wolltest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630310,
					"content": "Genau. Dieser Jadeabzeichen-Wagen kann euch schnell an jeden beliebigen Ort bringen, was eure Reisen erleichtern sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630311
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630311,
					"content": "Nehmt ihn nur, meine pflichtbewussten Reiseführer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630312
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630312,
					"content": "Ooh, das ist ja unglaublich ... Paimon dachte, du sagst das mit dem „Herstellen eines Schmuckstücks“ nur, um nett zu sein. Paimon hätte nie gedacht, dass du es wirklich tust!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630313,
					"content": "Ich dachte, das würde eine Weile dauern, da das Abzeichen so stark beschädigt war – seine spirituelle Energie war vollständig verschwunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630314
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630314,
					"content": "Aber zum Glück sind wir ja im Chenyu-Tal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630315
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630315,
					"content": "Hä? Was ist so besonders daran?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630316,
					"content": "Weißt du, wo genau wir uns im Tal befinden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630317
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630317,
					"content": "Ähm ... Am Yilong-Pier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630318,
					"content": "Hehe, du hast noch viel über diesen Ort zu lernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630319
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630319,
					"content": "Der Boden unter unseren Füßen ist tatsächlich einer der wichtigsten Knotenpunkte des Flusses der Elemente von Liyue. Davon gibt es insgesamt acht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630320
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630320,
					"content": "Leben, Tod, Rast, Verhüllung, Initiation, Gelände, Schrecken und Leiden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630321
					]
				},
				{
					"id": 711630321,
					"content": "Du kennst dich hier besser aus, als ich dachte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630322
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630322,
					"content": "Oh! Paimon erinnert sich. Du sprichst von den acht Toren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630323,
					"content": "Korrekt. Der Ort, an dem wir gerade stehen, ist das Zentrum des verheißungsvollsten dieser Tore – des Tors des Lebens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630324
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630324,
					"content": "Das Tor des Lebens symbolisiert Wachstum, Wohlstand und Erneuerung. Daher konnte ich die spirituelle Energie des Jadeabzeichens so schnell wieder auffüllen und diesen Wagen erschaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630325
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630325,
					"content": "Ah, was für eine mächtige Position! Das Chenyu-Tal ist wirklich ein Land voller Wunder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630326,
					"content": "In der Tat ... Ihr tätet gut daran, euch hier in Frieden und Wohlstand niederzulassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630327
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630327,
					"content": "Hä? Was meinst du mit „ihr“ ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630328,
					"content": "Ach nichts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630329
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630329,
					"content": "Gut, ich habe alles erledigt, was ich tun wollte. Ihr könnt nun eurer Wege gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630330
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630330,
					"content": "Ich habe vor, oben auf dem Berg einen Spaziergang zu machen. Hier trennen sich unsere Wege.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630331
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630331,
					"content": "Danke, Zibai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630332
					]
				},
				{
					"id": 711630332,
					"content": "Kein Grund, mir zu danken. Du hast mich aus meinem Schlummer geweckt – ich bin es, die in deiner Schuld steht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630333
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630333,
					"content": "Eigentlich war das alles Zhonglis Verdienst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630334
					]
				},
				{
					"id": 711630334,
					"content": "Und ich habe ihm so ziemlich dasselbe erzählt wie dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630335
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630335,
					"content": "Er hat erwähnt, dass du auf einer langen Reise bist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630336
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630336,
					"content": "Ist dein nächstes Ziel zufällig ein fernes Land des Schnees?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630337
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630337,
					"content": "Ja, das Land heißt Snezhnaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630338
					]
				},
				{
					"id": 711630338,
					"content": "Snezhnaya ... Hm, obwohl ich nichts über diesen Ort weiß – keine Reise durch Eis und Schnee ist ungefährlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630339
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630339,
					"content": "Falls du Hilfe brauchst, weißt du ja, wo du mich finden kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630340
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630340,
					"content": "Das werde ich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630341
					]
				},
				{
					"id": 711630341,
					"content": "Pass auf dich auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zibai"
				}
			]
		}
	]
}