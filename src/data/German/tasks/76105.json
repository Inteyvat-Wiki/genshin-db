					"Malta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761050101,
					"content": "Hallo, hast du die Felsenkrebse gesehen? Es sieht aus, als würden sie ein geheimnisvolles Ritual durchführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050102
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050102,
					"content": "Das ist wohl einfach ihre natürliche Verhaltensweise.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050103
					]
				},
				{
					"id": 761050103,
					"content": "Ist das so? Oh ... ich glaube, ich verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050104
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050104,
					"content": "In Nasha gibt es auch viele Menschen, die wie diese Felsenkrebse sind. Manche laufen Arm in Arm zusammen, andere begrüßen sich mit Fäusten und Tritten und gehen dann wieder getrennte Wege.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050105
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050105,
					"content": "So ist eben die natürliche Verhaltensweise in Nasha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050106,
						761050107
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050106,
					"content": "So ist es. Du hast das schnell verstanden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				},
				{
					"id": 761050108,
					"content": "Also ... kannst du die Felsenkrebse alle in den kleinen Teich bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050109
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050109,
					"content": "Hmm ... So wie wenn man alle Schatzjäger zum „Flaggschiff“ ruft? Das könnte lustig werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761051501
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761051501,
					"content": "Ich würde zu gern sehen, was wohl passiert, wenn sich die Felsenkrebse alle versammeln ... Hast du jetzt Zeit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050107,
					"content": "Es scheint, als gebe es einen kleinen Unterschied, aber egal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				}
			]
		},
		{
