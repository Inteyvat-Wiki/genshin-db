			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kräuterkundler Gui",
					"Kleiner Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280201,
					"content": "Ihr seid hier, um ein pflanzliches Heilmittel zu besorgen, nehme ich an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280202
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 210280202,
					"content": "Kleiner Meng? Was machst du hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280203
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 210280203,
					"content": "Oh ... ich verstehe, du bist hier, um nach diesen Medikamenten zu fragen, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280204
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 210280204,
					"content": "Keine Sorge, ich habe im Grunde all diese Medikamente bereit und werde sie deinem Vater schubweise zukommen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280205
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 210280205,
					"content": "Die Menge an Medizin, die dein Vater benötigt, ist jedoch so groß, dass dem Laden einige der Kräuter ausgehen, die er vorrätig hat, sodass die Herstellung einiger Medikamente langsamer sein könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280206
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 210280206,
					"content": "Mal sehen ... na ja ... hauptsächlich ist nicht mehr viel Minze übrig, also kann ich kein Mittel gegen Hitzschlag machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280207
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 210280207,
					"content": "Schließlich müssen wir nicht nur die Bestellungen deines Vaters erledigen, sondern auch anderen Leuten helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280208
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 210280208,
					"content": "Also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280209,
						210280211
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280209,
					"content": "Ich bin an der Reihe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280210
					]
				},
				{
					"id": 210280210,
					"content": "#Hehe, danke, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280213,
					"content": "Dann zähle ich auf dich, was die Kräuter angeht. Ich bleibe hier und überprüfe die Medikamente. Das hat mir Papa gesagt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280214
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280214,
					"content": "Der Junge ist ziemlich genau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280215
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 210280215,
					"content": "Dann komm mit mir rein und ich zeige dir die Liste der Medikamente in dieser Ladung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280216
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 210280216,
					"content": "So viel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280217
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280217,
					"content": "Schau dir die zuerst an, ich bringe den anderen Stapel rüber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280218
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 210280218,
					"content": "Gibt es noch welche?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280211,
					"content": "Ich will bezahlt werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280212
					]
				},
				{
					"id": 210280212,
					"content": "Hehe, kein Problem! Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Kleiner Meng"
				}
			]
		},
