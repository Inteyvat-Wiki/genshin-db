			"dialogs": [
				{
					"id": 210280401,
					"content": "Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280402
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280402,
					"content": "Das sollte für mich reichen, um ein paar Medikamente herzustellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280403
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 210280403,
					"content": "Ich werde die Medikamente gegen den Hitzschlag mit der nächsten Medikamentenlieferung schicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280404
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 210280404,
					"content": "Danke für deine Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280405
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280405,
					"content": "Danke, das ist für dich. Lass uns zurückgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280406
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280406,
					"content": "Hehehe, Papa wird sich freuen, das zu hören ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280407
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280407,
					"content": "Kleiner Meng, warte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280408
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 210280408,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280409
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280409,
					"content": "Musst du die Medikamente nicht überprüfen? Du hast die Liste auf der Rückseite noch nicht zu Ende gelesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280410
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 210280410,
					"content": "Hm? Habe ich nicht gerade so lange nachgesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280411
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280411,
					"content": "Das war doch noch gar nichts. Komm, kleiner Meng, wir schauen weiter nach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280412
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 210280412,
					"content": "Wah ... na gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleiner Meng"
				}
			]
		},
