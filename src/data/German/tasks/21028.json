			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kleiner Meng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210280101,
					"content": "Du kommst gerade rechtzeitig, ich wollte dich schon suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280102,
						210280103
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280102,
					"content": "Was gibt es?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280105
					]
				},
				{
					"id": 210280105,
					"content": "Papa sagte, es sei eine lange Reise nach Sumeru und er müsse Medizin vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280106
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280106,
					"content": "Gegen Kopfschmerzen, zur Vorbeugung von Durchfall, zur Vorbeugung von Hitzschlag ... und um Alkohol abzubauen, um die Nahrungsaufnahme zu reduzieren ... die Liste lässt sich beliebig fortsetzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280107
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280107,
					"content": "Warum auch etwas gegen Alkohol ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280108,
					"content": "Für Geschäftliches ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280109
					]
				},
				{
					"id": 210280109,
					"content": "Was? Was haben das Reden über Geschäfte mit Alkohol zu tun? Wird man durch das Trinken von mehr Alkohol zu einem besseren Geschäftsmann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280110,
					"content": "Jedenfalls bat mich mein Vater, zur „Bubu-Hütte“ zu gehen und zu fragen, ob die Medizin schon zubereitet wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280111
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280111,
					"content": "#{NICKNAME}, wirst du mich begleiten? Ich möchte dich um einen Gefallen bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280112,
						210280113
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280112,
					"content": "Lass uns gehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280115
					]
				},
				{
					"id": 210280115,
					"content": "#Lass uns gehen, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280113,
					"content": "Kann ich bei irgendetwas helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280114
					]
				},
				{
					"id": 210280114,
					"content": "Lass uns später drüber reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280115
					],
					"speakerTitle": "Kleiner Meng"
				},
				{
					"id": 210280103,
					"content": "Wie läuft die Reisevorbereitung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280104
					]
				},
				{
					"id": 210280104,
					"content": "Die meisten Vorbereitungen wurden von meinem Vater und den Männern getroffen ... Aber er gab mir auch einige Aufgaben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280105
					],
					"speakerTitle": "Kleiner Meng"
				}
			]
		},
		{
			"id": 2102802,
