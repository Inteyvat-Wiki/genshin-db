			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lauma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765010101,
					"content": "#Ah, {NICKNAME} und Paimon, ihr seid es. Die Vögel des Waldes haben bereits von eurer Ankunft geflüstert. Führt euch heute ein besonderes Anliegen hierher, oder ... benötigt ihr meine Führung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010102,
						765010103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010102,
					"content": "Wir erkunden einfach nur die Umgebung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				},
				{
					"id": 765010104,
					"content": "Dieser Ort ist vom Mondlicht durchdrungen. Sowohl die Flora als auch die hier lebenden Geschöpfe unterscheiden sich von allem, was ihr andernorts finden werdet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010105
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010105,
					"content": "Es ist in der Tat ein Ort, der viele wertvolle Fotos verspricht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010106,
					"content": "Fühlt euch frei, umherzuwandern. Solltet ihr Fragen haben, werde ich mein Bestes tun, sie euch zu beantworten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010107,
						765010108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010107,
					"content": "Die Atmosphäre hier ist so friedvoll.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010109,
					"content": "Ja, dies ist mein Ort der Meditation, wo ich mit allen Wesen in Kommunikation trete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010110,
					"content": "Allein hier zu verweilen, schenkt dem Geist Ruhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010111,
					"content": "Oh, das klingt so poetisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010112,
						765010113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765010112,
					"content": "Ich hätte da eine kleine Bitte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010114,
					"content": "Fräulein Lauma, du fügst dich perfekt in diese Landschaft ein, wie gemalt! Das würde ein atemberaubendes Foto ergeben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765010115,
					"content": "Mich ... fotografieren? Das wäre in der Tat eine ungewöhnliche Erfahrung. Wenn ihr der Meinung seid, dass die Ruhe dieses Augenblicks und meine Gestalt es wert sind, von eurem Fotoapparat festgehalten zu werden, dann bin ich gern bereit dazu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010116,
					"content": "Ich fühle mich geehrt, Teil eurer wundervollen Reiseerinnerungen zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010117,
					"content": "Wie soll ich mich verhalten? Soll ich in eine bestimmte Richtung blicken oder einfach nur eine natürliche Pose einnehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010118,
						765010119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010118,
					"content": "Ganz, wie du dich gewöhnlich verhältst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010120,
					"content": "Gut, dann überlasse ich das dir. Auf dass du diesen flüchtigen Moment der Inspiration einfängst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010119,
					"content": "Ich werde versuchen, den perfekten Moment einzufangen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010113,
					"content": "Wir möchten ein Foto von dir machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010108,
					"content": "Hältst du dich gewöhnlich in dieser Gegend auf, Lauma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010103,
					"content": "Wir suchen einfach nur nach Motiven für unsere Aufnahmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				}
			]
		},
