				"points": []
			},
			"dialogs": [
				{
					"id": 191320401,
					"content": "Hallo, gibt es etwas, womit ich dir helfen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320402
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320402,
					"content": "Hallo, ich hole die Klamotten von Ningguang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320403
					]
				},
				{
					"id": 191320403,
					"content": "Ich hatte davon gehört. Warte einen Moment, ich werde alles vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320404
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320404,
					"content": "Nach langem Warten kehrte Lanyang schließlich zurück.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						191320405
					]
				},
				{
					"id": 191320405,
					"content": "Das ist es. Bitte gib das Ningguang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320406
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320406,
					"content": "Du scheinst dir ziemlich viel Zeit gelassen zu haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320407
					]
				},
				{
					"id": 191320407,
					"content": "Nun, dieser Raum war mit vielen Sammlungen von Ningguang gefüllt, nicht nur mit Kleidung, sondern auch mit allen Arten von Artefakten, Jade ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320408
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320408,
					"content": "Die Einrichtung wird derzeit an die Wünsche von Ningguang angepasst, sodass die Räume ziemlich unübersichtlich und nicht immer leicht zugänglich sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320409,
						191320410
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320409,
					"content": "(Das klingt nach einer großen Sammlung ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				},
				{
					"id": 191320411,
					"content": "Jedenfalls danke ich dir und überlasse dir die Kleidung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320410,
					"content": "(Das ist das Problem, wenn man reich ist, nicht wahr?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				}
			]
		},
