				{
					"id": 206030401,
					"content": "Vom Wind weggewehte Schilder ... Vom Wind weggeblasene Blumen ... Weggelaufene Katzen streunen umher ... Leider ... genau wie ich es erwartet hatte ...",
					"roleType": "TALK_ROLE_NPC",
