			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 206030501,
					"content": "So schnell zurück? Na ja dann gehe ich davon aus, dass nichts Ernsthaftes passiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030502
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030502,
					"content": "Nein, es gibt immer noch sehr viel Monsteraktivität.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206030503
					]
				},
				{
					"id": 206030503,
					"content": "Was? Es wandern immer noch Monster herum? Und es sind sogar mehr als vorher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030504
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030504,
					"content": "Das ist ungewöhnlich. Wurde die große Streitkraft, die Mondstadt zuvor angegriffen hatte, nicht zuvor besiegt? Warum schleichen sie noch immer in diesem Gebiet herum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030505
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030505,
					"content": "Haben sie vielleicht andere Pläne? ... Ich muss die Abenteurer zusammenbringen und unsere Aufträge neu verteilen. Wir dürfen diese Monster nicht auf die leichte Schulter nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030506
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030506,
					"content": "Sorgfältige Untersuchungen zu Monsteraktivitäten in der Wildnis durchzuführen fällt in den Bereich der Abenteurergilde. Es ist an der Zeit, jedem zu zeigen, aus welchem Holz wir geschnitzt sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030507
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030507,
					"content": "Ah, ja. Bitte nimm das für deine Anstrengungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		}
	]
