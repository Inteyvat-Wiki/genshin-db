			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4260101,
					"content": "Setzen wir uns mal kurz hin und ruhen uns aus. Was ist unser Plan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260102,
					"content": "Ich hätte gern einen Auftrag.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260103
					]
				},
				{
					"id": 4260103,
					"content": "Das ist einfach! Wähle einfach das Ausrufezeichen oben links, um zu sehen, welche Aufträge du schon angenommen hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260104,
					"content": "Einige Aufträge sind richtig schwierig. Solange du nicht die richtige Stufe erreicht hast, sind sie nicht zu schaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260117,
					"content": "Möchtest du noch etwas anderes wissen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260102,
						4260105,
						4260110,
						4260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260105,
					"content": "Ich würde gern durch die Gegend spazieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260106
					]
				},
				{
					"id": 4260106,
					"content": "Verschiedene Gebiete sind unterschiedlich gefährlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260107,
					"content": "Du solltest dich nur dort herumtreiben, wo es nicht zu gefährlich ist, um langsam besser zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260108,
					"content": "Alfry von der Abenteurergilde kennt Teyvat wie ihre Westentasche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260109,
					"content": "Du kannst sie auf der Einkaufsstraße hinter den Toren Mondstadts finden und fragen, welche Gebiete zu dir passen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260110,
					"content": "Ich möchte stärker werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260111
					]
				},
				{
					"id": 4260111,
					"content": "Hm, das geht wohl nicht ohne ein paar praktische Waffen oder wertvolle Artefakte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260112,
					"content": "In den Dungeons soll es viele tolle Dinge zu finden geben. Es könnte nur etwas gefährlich werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260113,
					"content": "Wenn du das nötige Kleingeld hast, kannst du sie natürlich auch auf der Einkaufsstraße in Mondstadt kaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260114,
					"content": "Waffen und Artefakte kannst du außerdem noch verstärken und aufsteigen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260115,
					"content": "Das kannst du dir jederzeit selbst genauer ansehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260116,
					"content": "Ach genau, deine eigene Stufe ist natürlich auch wichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4260117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4260118,
					"content": "Im Moment gibt es nichts weiter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4260119
					]
				},
				{
					"id": 4260119,
					"content": "Dann ist gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}