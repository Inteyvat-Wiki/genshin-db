			},
			"dialogs": [
				{
					"id": 200011001,
					"content": "#Danke dir, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011002
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011002,
					"content": "Ich wollte einfach nur etwas Obst pflücken und es dann in der Stadt verkaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011003
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011003,
					"content": "Ich konnte ja nicht ahnen, dass die Straße gesperrt ist. Und dann kamen auch noch diese Kerle dort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011004
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011004,
					"content": "Dann gehe ich jetzt wieder nach Mondstadt. Komm gern vorbei, wenn du mal in der Nähe bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011005
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200011005,
					"content": "Nimm die hier als kleines Dankeschön! Mein Obst ist immer so frisch ... Beatrice kommt oft vorbei und kauft mir alles weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
		}
