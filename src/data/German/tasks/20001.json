			},
			"dialogs": [
				{
					"id": 200010901,
					"content": "#{F#Reisende}{M#Reisender}, danke, dass du diese Kerle verscheucht hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010902
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010902,
					"content": "Was für ein Glück, dass du da bist! Aber mit dieser Straßensperre hier, tja, da komme ich nicht voran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010903
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010903,
					"content": "Wenn das so weitergeht, kann ich die Früchte, die ich so eifrig gesammelt habe, wegwerfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010904
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010904,
					"content": "Kannst du mir helfen, diese Straßensperre zu beseitigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010905,
						200010906
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010905,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010907
					]
				},
				{
					"id": 200010907,
					"content": "Prima! Vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010906,
					"content": "Ich habe noch zu tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010908
					]
				},
				{
					"id": 200010908,
					"content": "Oh? Ach so ... Ich dachte, wenn mir jemand helfen könnte, dann wärst du es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
		},
		{
