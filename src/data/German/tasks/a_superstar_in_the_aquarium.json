			},
			"dialogs": [
				{
					"id": 747060101,
					"content": "... Was ist mit dem hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060102
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 747060102,
					"content": "Ich habe immer noch das Gefühl, dass da etwas fehlt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060103,
					"content": "Columbina? Furina? Was macht ihr da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060104,
					"content": "Regisseurin Furina und ich machen ... ein „Casting“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060105
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 747060105,
					"content": "Was für eine wunderbare Art, das zu sagen! Aber die „Schauspieler“, die wir suchen ... Sind rein zufällig Fische!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060106
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060106,
					"content": "... Fische können „Schauspieler“ sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060107,
					"content": "Tierische Schauspieler sind heutzutage echt keine Seltenheit mehr. Wir suchen ein kleines, charismatisches Fischlein mit der perfekten Einstellung, um ein paar Szenen für Schnittbilder zu drehen ... Das ist nämlich super wichtig für die richtige Stimmung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060108,
					"content": "Aber ich habe das Gefühl, dass wir schon jeden Fisch im ganzen Aquarium gesehen haben und keiner davon so richtig passt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060109
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060109,
					"content": "#Sollen wir {NICKNAME} und Paimon um Hilfe bitten? Sie können viele Probleme lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060110
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 747060110,
					"content": "Paimon freut sich, dass du so viel Vertrauen in uns hast ... aber wenn es darum geht, Fische zu fangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060111,
						747060112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060111,
					"content": "Wir könnten versuchen, noch ein paar „Kandidaten“ aufzutreiben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				},
				{
					"id": 747060113,
					"content": "Tolle Idee! Ihr seid schließlich diejenigen, die Erfahrung mit der Verwaltung von Aquarien haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060114,
					"content": "Du meinst also, wir sollten nach Talenten Ausschau halten, wann immer wir schwimmen gehen? Paimon findet, da spricht nichts dagegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060115,
					"content": "Dann ist es abgemacht! Ich erkläre euch später, nach welcher Einstellung wir suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060116,
					"content": "Ich schätze, das macht euch zu „Talentsuchern“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060117
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 747060117,
					"content": "Du hast dir wirklich richtig das Showbiz-Vokabular angeeignet, seit du mit Furina abhängst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060112,
					"content": "Oder sogar direkt vor Ort die Angel auswerfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				}
			]
		}
	]
}