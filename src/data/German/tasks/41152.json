					"nextDialogs": [
						411520303
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411520303,
					"content": "Dieser Kartoffelpuffer ist besonders empfindlich. Wenn du ihn zu viel schüttelst, fällt er auseinander. <color=#00E1FFFF>Bitte liefere ihn rechtzeitig,</color> damit er schön mürbe bleibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411520304
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411520304,
					"content": "Falls da draußen etwas passiert, bring mir die Portion zurück. Ich werde dir eine neue geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
