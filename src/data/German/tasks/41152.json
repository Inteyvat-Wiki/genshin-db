					"nextDialogs": [
						411520302
					]
				},
				{
					"id": 411520302,
					"content": "Also, es ist so. Silio hat eine Portion Kartoffelpuffer nach Mondstadt-Art bestellt. Jetzt möchte er, dass sie geliefert wird.",
