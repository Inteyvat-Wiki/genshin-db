			"dialogs": [
				{
					"id": 721160401,
					"content": "Danke, wirklich! Diese sollen die Grundstruktur unseres Gerätes bilden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160402,
					"content": "Jetzt müssen wir nur noch warten, bis unsere Baken genügend Daten gesammelt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160403,
					"content": "Sobald wir diese Daten zur Hand haben, werde ich einige entsprechende Anpassungen an diesem Gerät vornehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160404
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160404,
					"content": "Sobald alles fertig ist, wollen wir diesem Vorfall ein entscheidendes Ende bereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
