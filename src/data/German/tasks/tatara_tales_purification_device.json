			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721160101,
					"content": "Es wird noch eine Weile dauern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160102,
					"content": "Hast du alle notwendigen Daten gesammelt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160103
					]
				},
				{
					"id": 721160103,
					"content": "Ah, du bist es! Wunderbar. Wir haben noch nicht ganz alle Daten gesammelt, die wir brauchen. Ich glaube, es wird noch ein wenig dauern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160104,
					"content": "Das heißt, ich habe die Gelegenheit genutzt, um über die Struktur des Notfallreinigers nachzudenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160105,
						721160107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160105,
					"content": "Und was sollte das sein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160106
					]
				},
				{
					"id": 721160106,
					"content": "Nur ein paar Behelfsmaßnahmen, die ich angewandt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160109,
					"content": "Nach unseren bisherigen Diskussionen müssen wir uns mit einem zweigleisigen Problem auseinandersetzen: den Fatui und den Tatarigami im Inneren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160110,
					"content": "Ich glaube, dass du in der Lage sein wirst, mit diesen Fatui umzugehen. Mein Part dabei ist also, mit den Tatarigami umzugehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160111,
					"content": "Dieser Notfallreiniger ist ein Gerät, das ich speziell für diese Aufgabe gebaut habe. Seine Fertigstellung wird jedoch noch deine Hilfe erfordern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160112,
						721160113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160112,
					"content": "In welcher Weise?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160117
					]
				},
				{
					"id": 721160117,
					"content": "Wir werden einige spezielle Materialien benötigen, um die reibungslose Funktion dieses Apparats im Mikage-Hochofen zu gewährleisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160118,
					"content": "Kristallmark, das eine reaktionsträge Form dieser Energien enthält, wäre für diese Aufgabe am besten geeignet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160119
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160119,
					"content": "In Wahrheit liegt das Geheimnis des berühmten Jadestahls darin, dass ihm genau dieses Material während des Schmiedeprozesses zugesetzt wird, um die Festigkeit der Metalle zu erhöhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160120,
					"content": "Natürlich muss diese „spezielle Methode“ ein Geschäftsgeheimnis bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160121,
					"content": "Wenn ich mich recht erinnere, können diese kristallinen Erze in der Nähe gefunden werden. Bitte hilf mir, drei davon zu beschaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160122
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160122,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160123
					]
				},
				{
					"id": 721160123,
					"content": "Nun denn, du hast meinen Dank. Denke daran, es sind drei Portionen Kristallmark. Bringe sie zurück, sobald du sie hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160113,
					"content": "Und ich dachte, du hättest einen offizielleren Namen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160114
					]
				},
				{
					"id": 721160114,
					"content": "Das ist ja auch sein offizieller Name, der „Notfallreiniger“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160115,
					"content": "Es sei denn ... Sprichst du von seiner offiziellen Produktnummer und dem Herstellungsdatum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160116,
					"content": "Nun, da dies ein reines Notfallgerät ist, brauchen wir solche Dinge nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160107,
					"content": "Zählen die auch als „Notfallmaßnahmen“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721160108
					]
				},
				{
					"id": 721160108,
					"content": "Ich nehme an ja, obwohl ich zögern würde, diese Art von Hilfe während des normalen Kundendienstes zu leisten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160109
					],
					"speakerTitle": "Xavier"
				}
			]
		},
