				"objectNames": [
					"Harry"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220601,
					"content": "Hallo. Kann ich dir bei etwas helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220602
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220602,
					"content": "Wirf einen Blick in diese Befehlschrift ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220603
					]
				},
				{
					"id": 411220603,
					"content": "Eine Befehlschrift? Lass mich sehen ... Wir sollen also in die Stadt zurückkehren, wie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220604
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220604,
					"content": "Verzeihung, aber dieser Pflicht muss ich später nachkommen, da ich aktuell noch eine dringende Aufgabe habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220605
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220605,
					"content": "Die Monster in dieser Gegend stehen unter dem Einfluss der gefallener Sterne. Sie sind viel aggressiver geworden und extrem gefährlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220606
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220606,
					"content": "Ich muss sie beseitigen, sonst ist dieses Gebiet nicht sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220607
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220607,
					"content": "Aber es ist keiner hier, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220608
					]
				},
				{
					"id": 411220608,
					"content": "Genau darum kann ich diese Monster jetzt beseitigen, weil ich ungestört bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220609
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220609,
					"content": "Dies ist von großer Wichtigkeit. Ich kann erst gehen, wenn es erledigt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220610,
						411220611
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220610,
					"content": "Ich helfe dir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				},
				{
					"id": 411220612,
					"content": "Super, vielen Dank. In diesem Gebiet gibt es nämlich gleich mehrere Gruppen von Monstern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220613
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220613,
					"content": "Teilen wir uns auf. Jeder beseitig die Monster in seinem eigenen Bereich. Hinterher treffen wir uns wieder hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220611,
					"content": "Erledigen wir das gemeinsam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				}
			]
		},
