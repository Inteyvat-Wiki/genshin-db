					"Will"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220401,
					"content": "Hmm? Hallo, was gibt es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220402
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220402,
					"content": "Nun, die Sache ist die ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220403
					]
				},
				{
					"id": 411220403,
					"content": "Ich weiß, darum sind wir hier draußen – um die gefallenen Sterne zu beobachten. Keine Sorge, sobald wir sie gesehen haben, gehen wir zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220404
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220404,
					"content": "Von der Stadt aus kann man sie ebenfalls sehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220405
					]
				},
				{
					"id": 411220405,
					"content": "Aber dafür müssten wir an einen wirklich hohen Ort. Die Wachen haben mich immer davon abgehalten und mich ausgeschimpft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220406
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220406,
					"content": "Darum habe ich Jill hierhergebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220407
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220407,
					"content": "Dieser freundliche Wächter da drüben wird uns helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220408
					]
				},
				{
					"id": 411220408,
					"content": "Uns helfen? Also kann er uns an einen hohen Ort in der Stadt bringen, um die gefallenen Sterne zu beobachten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220409
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220409,
					"content": "Aber er wirkt so seltsam und wütend ... stimmt das wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220410
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220410,
					"content": "Ich habe eine Befehlschrift dabei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220411
					]
				},
				{
					"id": 411220411,
					"content": "Wirklich? Zeig her! Ooh ... das ist wirklich eine von diesen Befehlschriften!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220412
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220412,
					"content": "Damit kann der Mann uns an einen hohen Ort bringen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220413
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220413,
					"content": "Hehe ... Die gefallenen Sterne von der Stadt aus zu beobachten, wäre großartig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220414
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220414,
					"content": "Nun, du kannst ja mit ihm reden. Ich gehe zu Jill.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220415
					],
					"speakerTitle": "Will"
				},
				{
					"id": 411220415,
					"content": "Ah, ich kann es kaum abwarten ... Ich will die fallenden Sterne sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Will"
				}
			]
		},
		{
			"id": 4112205,
