				"objectNames": [
					"Jill"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220301,
					"content": "Hmm? Was ist denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220302
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220302,
					"content": "Nun, die Sache ist die ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220303
					]
				},
				{
					"id": 411220303,
					"content": "Oh, ich weiß von den gefallenen Sternen. Allerdings ... wissen wir nicht, wie sie aussehen, wenn sie vom Himmel fallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220304
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220304,
					"content": "Will meinte, er kennt einen guten Platz, um sie zu beobachten. Darum sind wir hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220305
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220305,
					"content": "Von der Stadt aus kann man sie ebenfalls sehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220306
					]
				},
				{
					"id": 411220306,
					"content": "Aber in der Stadt würden wir sie nur von einem sehr hohen Ort aus sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220307
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220307,
					"content": "Die Wächter würden nicht zulassen, dass wir so hoch klettern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220308
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220308,
					"content": "Dieser nette Mann da drüben würde euch helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220309
					]
				},
				{
					"id": 411220309,
					"content": "Wie? Du meinst diesen seltsamen Alten? Beim letzten Mal war er echt gruselig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220310
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220310,
					"content": "Er wollte nur, dass wir zurückkehren. Mehr hat er nicht gesagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220311
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220311,
					"content": "Aber wenn er uns an einen wirklich hohen Ort bringt, ist es in Ordnung ... wenn wir zurückgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220312
					],
					"speakerTitle": "Jill"
				},
				{
					"id": 411220312,
					"content": "Rede aber am besten mit Will. Schließlich war das hier seine Idee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jill"
				}
			]
		},
