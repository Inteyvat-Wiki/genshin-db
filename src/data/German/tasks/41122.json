				"points": []
			},
			"dialogs": [
				{
					"id": 411220501,
					"content": "Wie ist es gelaufen? Konntest du sie überzeugen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220502
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220502,
					"content": "Sieht so aus ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220503
					]
				},
				{
					"id": 411220503,
					"content": "Wirklich! Fantastisch! Vielen Dank – Moment ... Was meinst du mit „sieht so aus“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220504
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220504,
					"content": "Du musst bloß mitspielen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220505
					]
				},
				{
					"id": 411220505,
					"content": "Mitspielen? Was soll das bedeuten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220506
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220506,
					"content": "Wie? Ich soll sie an den höchsten Punkt von Mondstadt bringen, damit sie die fallenden Sterne beobachten können? Das ... klingt gefährlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220507
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220507,
					"content": "Und die beiden sind noch Kindern. Ich muss das zuerst dem Hauptquartier melden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220508
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220508,
					"content": "Ich habe eine Befehlschrift dabei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220509
					]
				},
				{
					"id": 411220509,
					"content": "Das ... Für so etwas ist das eigentlich nicht gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220510
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220510,
					"content": "Sei es drum. Solange die Kinder zurück in die Stadt gehen. Ich ... Ich lasse mir etwas einfallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220511
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220511,
					"content": "Wirklich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220512
					]
				},
				{
					"id": 411220512,
					"content": "Natürlich, ich schwöre es bei meiner Ehre als Ritter und als Erwachsener.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220513
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220513,
					"content": "Unser Wort ist so viel wert wie eine Bürgschaft, das gilt für uns alle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220514
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220514,
					"content": "Danke für deine Hilfe. Überlass den Rest mir – ich werde sie in die Stadt zurückbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220515
					],
					"speakerTitle": "Mack"
				},
				{
					"id": 411220515,
					"content": "Ich kümmere mich später darum, wie wir an den höchsten Punkt von Mondstadt gelangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mack"
				}
			]
		},
		{
			"id": 4112206,
			"completionStepIds": [
				4112206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
