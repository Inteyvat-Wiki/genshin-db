			"dialogs": [
				{
					"id": 411220801,
					"content": "Diese Monster waren ein echter Brocken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220802
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220802,
					"content": "Ich habe sie alle erledigt. Wie läuft es bei dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220803
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220803,
					"content": "Wir sind ebenfalls fertig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220804
					]
				},
				{
					"id": 411220804,
					"content": "Haha, du kannst gut kämpfen, oder? Vielen Dank für deine Hilfe. Ich glaube, dieses Gebiet wird für eine Weile sicher sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220805
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220805,
					"content": "Noch kann ich jedoch nicht zurück. In den Windblickbergen streifen noch weitere Monster herum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220806
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220806,
					"content": "Ich will die Lage weiter sondieren. Und falls jemand in der Nähe bedroht wird, kann ich zur Rettung eilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220807
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220807,
					"content": "Schließlich weiß nicht jeder von dem Aufruf, Schutz zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220808
					],
					"speakerTitle": "Harry"
				},
				{
					"id": 411220808,
					"content": "Also gut. Bitte übermittle meine Absicht Huffman. Er wird es sicher verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harry"
				}
			]
		},
