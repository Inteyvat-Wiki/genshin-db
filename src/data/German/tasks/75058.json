			"dialogs": [
				{
					"id": 750013301,
					"content": "Seltsam ... Die goldenen Muster flogen genau wie vorher hinüber, aber die Inschrift ist nicht unter dieser Säule erschienen ... Woran liegt das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013302,
					"content": "Hier wurde die „Schillernde Inschrift“ nicht nur herausgepresst, sondern auch noch fragmentiert ... Das wird noch schwieriger, wir müssen alle verstreuten Teile finden, und zwar schnell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013303
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013303,
					"content": "Und wo finden wir sie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013304,
					"content": "... Das weiß ich auch nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013305
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013305,
					"content": "Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013306,
					"content": "Sie mögen verstreut sein, aber sie sind trotzdem noch an die Kraft gebunden. Daher sollten sie nicht weit sein, vielleicht müssen wir nur richtig suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013307
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013307,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013308,
					"content": "#Was hast du, willst du dahin? {NICKNAME} und Paimon haben jetzt Wichtigeres zu tun, wir können später mit dir spielen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013309,
					"content": "*brüll* ... *brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013310
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013310,
					"content": "Du meinst, die Inschrift ist dort drüben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013311
					]
				},
				{
					"id": 750013311,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013312
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013312,
					"content": "Ach, ich habe schon davon gehört, dass es auch jetzt noch Saurier geben soll, die „Schillernde Inschriften“ aufspüren können, aber bisher dachte ich, das wäre nur eine Legende. Sollte da etwa doch etwas dran sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013313
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013313,
					"content": "#Ich nehme an, du bist wirklich kein gewöhnlicher Tepetlisaurier, {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013314
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013314,
					"content": "Du besitzt also auch diese Fähigkeit. Aber an die Führungsqualitäten von Paimon kommst du noch lange nicht ran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013315,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013316,
						750013318
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013316,
					"content": "Paimon ist nur neidisch auf dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013317
					]
				},
				{
					"id": 750013317,
					"content": "Aber wo denkst du hin, Paimon ist längst nicht so engstirnig! Das ist nur Paimons Art, ein Lob auszusprechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013320,
					"content": "*brüll* ... *brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013321,
					"content": "Ach, der Kleine versteht überhaupt nichts. Wirklich, wenn er doch nur ein bisschen schlauer wäre ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013322,
					"content": "Es wird der Moment kommen, in dem er verstehen wird ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013323
					]
				},
				{
					"id": 750013323,
					"content": "Richtig, auch die Stammesleute, die sich um die Saurier kümmern, sagen, dass es sehr viel Zeit braucht, um eine emotionale Verbindung mit einem Saurier aufzubauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013324
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013324,
					"content": "Das Geheimnis für den Umgang mit Sauriern besteht darin, Geduld zu haben und ständig mit ihnen zu kommunizieren. Egal, ob ein Mensch einen Saurier verstehen will oder ein Saurier einen Menschen, es braucht immer ... eine sehr lange Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013325
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013325,
					"content": "#Ach so ... So wie Paimon gerade nicht nachvollziehen konnte, was uns {REALNAME[ID(2)|SHOWHOST(true)]} mitteilen wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013326,
					"content": "#Entschuldige, {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013327,
					"content": "*brüll* ... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013328
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013328,
					"content": "Deine Antwort kam echt schnell!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013329,
					"content": "Gut, gehen wir in die Richtung, die du angedeutet hast, und schauen wir, ob wir irgendwelche goldenen Muster finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013318,
					"content": "Paimon hat dich gelobt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013319
					]
				},
				{
					"id": 750013319,
					"content": "Ja, das war ein Lob, aber du darfst deswegen nicht überheblich werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013320
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}