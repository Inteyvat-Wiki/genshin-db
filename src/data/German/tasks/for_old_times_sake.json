				"points": []
			},
			"dialogs": [
				{
					"id": 221150101,
					"content": "Hmpf, dieser kleine Chang ... wieso ist er denn immer noch nicht zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150102
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 221150102,
					"content": "Der kleine Chang ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150103
					]
				},
				{
					"id": 221150103,
					"content": "Der kleine Chang, ah, ihr nennt ihn Chang IX.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150104
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 221150104,
					"content": "Ich habe mich so daran gewöhnt, ihn den kleinen Chang zu nennen, so rufe ich ihn seit jeher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150105
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 221150105,
					"content": "Letzte Nacht wollte er noch einmal rausgehen, um die Zeichnungen für sein Buch zu vervollständigen. Ich habe mir nicht viel dabei gedacht und nur gesagt, er sollte bald zurückkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150106
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 221150106,
					"content": "Das Ergebnis ist, er ist bis jetzt noch nicht zurück. Ich mache mir wirklich Sorgen, ob ihm etwas zugestoßen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150107
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 221150107,
					"content": "Leider bin ich bereits zu alt und gebrechlich, um draußen nach ihm zu suchen. Könnte ich euch bitten mir bei der Suche zu helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150108,
						221150110
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 221150108,
					"content": "Überlass das nur uns.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150109
					]
				},
				{
					"id": 221150109,
					"content": "Das ist ja toll, danke für eure Mühe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 221150110,
					"content": "Weißt du, wo er hingegangen ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150111
					]
				},
				{
					"id": 221150111,
					"content": "Wo soll er schon sein? Er kann doch nur am nördlichen Wuwang-Hang sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150112
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 221150112,
					"content": "Bitte geht dorthin und seht nach. Er ist schon so lange weg. Nicht, dass etwas passiert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oma Ruoxin"
				}
			]
		},
		{
			"id": 2211502,
			"completionStepIds": [
				2211504
			],
