			"dialogs": [
				{
					"id": 221150601,
					"content": "Dieser kleine Chang ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150602
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 221150602,
					"content": "Chang IX. ist wieder zurück.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150603
					]
				},
				{
					"id": 221150603,
					"content": "Ja, ich habe ihn schon gesehen, danke für eure Mühen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150604
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 221150604,
					"content": "Er ist noch genau wie früher, stiftet immer Unruhe, der wird wohl nie erwachsen werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150605
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 221150605,
					"content": "Aber genug davon, ihr braucht euch nicht zu sorgen. Das ist Changs eigenes Problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150606
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 221150606,
					"content": "Danke, dass ihr ihn für mich gesucht habt. Nehmt dies als Zeichen meiner Dankbarkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150607
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 221150607,
					"content": "Ihr habt bestimmt noch eigene Angelegenheiten zu erledigen, ich will euch nicht aufhalten. Kümmert euch nicht zu sehr darum, was andere sagen oder von euch halten. Sonst verpasst ihr oft die Chance, euch selbst zu erkennen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150608
					],
					"speakerTitle": "Oma Ruoxin"
				},
				{
					"id": 221150608,
					"content": "Wir Sterblichen sind nun einmal keine Adepten, das Leben der Sterblichen ist nur eine Qual vor der Erlösung durch den Tod ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oma Ruoxin"
				}
			]
		},
