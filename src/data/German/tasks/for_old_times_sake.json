					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150301,
					"content": "So schnell kann man sich verlaufen ... Wir gehen besser auch schnell zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221150302,
					"content": "Hmm? Da liegt doch etwas auf dem Boden ... Ob Chang IX. das verloren hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221150303,
					"content": "Heb es auf und wir sehen es uns erstmal an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2211505,
			"completionStepIds": [
				2211507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211507",
							"2"
						],
						"stepId": 2211507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chang IX."
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150501,
					"content": "Was man nicht alles für ein gutes Buch tut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150502
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221150502,
					"content": "Hast du das hier verloren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150503
					]
				},
				{
					"id": 221150503,
					"content": "Was? Ach ... Ja, das ist tatsächlich von mir, ein Stapel unnützer Manuskripte. Ich hab sie in den Fluss geworfen, um sie zu zerstören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150504
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221150504,
					"content": "Ihr habt sie zurückgebracht ... Aber die Inschrift darauf ist schon ganz verblasst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150505
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221150505,
					"content": "Was steht denn darauf geschrieben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150506
					]
				},
				{
					"id": 221150506,
					"content": "Es ist eine Geschichte, die ich einst einem Mädchen geschrieben habe, jedoch sind dies alles Kapitel, die es nicht in die Geschichte geschafft haben. Als wir noch klein waren, hat mich diese kleine Kröte jeden Tag genervt, ihr eine Geschichte zu erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150507
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221150507,
					"content": "Es ist so schade, dass ich früher nicht mehr Zeit zum Schreiben hatte. Ich konnte nur den Anfang niederschreiben, damit sie schon mal etwas zu lesen hatte. Später wollte ich dann den Rest für sie schreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150508
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221150508,
					"content": "Eines Tages verschwand sie jedoch plötzlich. Egal wo ich auch suchte, ich konnte sie nicht finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150509
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221150509,
					"content": "Ich vermute, ihre Familie mochte mich nicht besonders und sie wollten nicht, dass ihre Tochter mehr Zeit mit mir verbringt. Als sie die Chance hatten, sind sie klammheimlich davongezogen, weg vom Qingce-Dorf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150510
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221150510,
					"content": "Die werden noch Augen machen! Wartet nur, bis ich reich bin, dann werden sie schon sehen. Dann werde ich das Buch, das ich für sie geschrieben hab, auf der ganzen Welt veröffentlichen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150511
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221150511,
					"content": "Egal wo sie sich befinden, so werden sie von mir erfahren und sehen, dass ich es zu etwas gebracht habe und nicht mehr der Alte bin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150512
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221150512,
					"content": "Und dann ... Dann muss ich sie unbedingt wiedersehen ... Obwohl ich erst mein Buch zu Ende schreiben muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150513
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221150513,
					"content": "Es tut mir leid, ich rede mich immer so in Rage. Ich muss nochmal gut nachdenken und dann mein Buch zu Ende schreiben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang IX."
				}
			]
		},
		{
