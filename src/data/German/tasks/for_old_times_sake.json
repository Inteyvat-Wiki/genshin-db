					"Chang IX."
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150201,
					"content": "He ... Diese Gruppe von Monstern ist aber echt lästig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150202
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221150202,
					"content": "Ich kam hierher, um noch Stoff für mein Buch zu sammeln, stattdessen bin ich diesen Monstern begegnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150203
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221150203,
					"content": "Habt vielen Dank! Wärt ihr nicht gewesen, hätten die mich bestimmt einen Kopf kürzer gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150204
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221150204,
					"content": "Oma Ruoxin hat sich große Sorgen um dich gemacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150205
					]
				},
				{
					"id": 221150205,
					"content": "Sorgen um mich? Worum muss man sich denn bei mir sorgen? Ich bin doch schon so groß und weiß, wie man auf sich aufpasst. Herrje, der kleine Aussetzer, das kann ich auch noch selbst lösen, man muss sich nur etwas anstrengen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150206
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 221150206,
					"content": "Nochmals vielen Dank, ich geh besser schnell nach Hause, sonst meckert sie mich wieder an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang IX."
				}
			]
		},
		{
			"id": 2211503,
			"completionStepIds": [
				2211505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
