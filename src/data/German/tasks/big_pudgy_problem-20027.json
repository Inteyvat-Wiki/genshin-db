				"points": []
			},
			"dialogs": [
				{
					"id": 200270101,
					"content": "#Vielen, vielen Dank, {NICKNAME} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270102
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270102,
					"content": "Ich wollte eigentlich nach den Weinstöcken sehen. Aber dann ist mir das hier passiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270103
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270103,
					"content": "Ach, bitte sag meinem Sohn nichts davon. Er ist Ritter des Ordo Favonius. Damit hat er sicher schon genug zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270104
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270104,
					"content": "Er muss sich nicht erst Sorgen machen, nur weil sein alter Vater ein paar Problemchen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270105
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270105,
					"content": "Aber in der letzten Zeit tauchen immer wieder Schleime in der Nähe des Weinguts auf. Jeden Tag muss ich Angst haben, dass die Reben von den Schleimen zerstört werden. Ich komme kaum noch zum Schlafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270106
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270106,
					"content": "Wenn du einem alten Mann einen Gefallen tun könntest, würde ich dich bitten, die Schleime in der Umgebung loszuwerden, damit sie nicht weiter Unheil anrichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270107,
						200270108
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270107,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270109
					]
				},
				{
					"id": 200270109,
					"content": "Wunderbar! Dann kann ich mich endlich etwas ausruhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270108,
					"content": "Ich habe noch zu tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270110
					]
				},
				{
					"id": 200270110,
					"content": "Herrje, ich selbst schaffe das doch nicht ... So sehr ich mich auch bemühe, nur du kannst mir jetzt noch helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		}
	]
