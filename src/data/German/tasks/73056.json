			},
			"dialogs": [
				{
					"id": 730560701,
					"content": "Was macht ihr hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560702
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560702,
					"content": "Aaah! Du hast Paimon einen Schrecken eingejagt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560703,
					"content": "Sogar meinen Namen kennt ihr. Aber euch noch nie zuvor gesehen hat Aranaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560704
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560704,
					"content": "Also ... was macht ihr hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560705,
						730560708
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560705,
					"content": "Die Frage ist nicht so leicht zu beantworten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560706
					]
				},
				{
					"id": 730560706,
					"content": "Du erinnerst dich an viele Dinge nicht mehr, aber wir meinen es gut! Wir stehen auf eurer Seite! Wir werden „Mawtiyima“ immer unterstützen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560707,
					"content": "... „Mawtiyima“ kennt ihr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560710
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560710,
					"content": "Hmpf ... Nicht wie Bösewichte wirkt ihr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560711
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560711,
					"content": "Aber bitte nicht bleibt. Schnell geht ihr. Noch am Genesen ist der Wald ... Deshalb nicht bleiben sollen neue Gäste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560712
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560712,
					"content": "He, warte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560713,
					"content": "Wir haben etwas für dich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560714
					]
				},
				{
					"id": 730560714,
					"content": "Etwas für mich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560715
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560715,
					"content": "Gebt es mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560716
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560716,
					"content": "Hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560717
					]
				},
				{
					"id": 730560717,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560718
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560718,
					"content": "Erinnerst du dich? Du hast auch uns gleiche Blumen gegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560719,
					"content": "Stimmt ... Meine Freunde seid ihr? Die Blume ist sehr wichtig, was macht sie bei euch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560720,
						730560721
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560720,
					"content": "Also ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560722
					]
				},
				{
					"id": 730560722,
					"content": "Ihr beschreibt Aranaga euer gesamtes Abenteuer, selbst wie ihr „Mawtiyima“ aus der Verwelkung befreit habt.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730560723
					]
				},
				{
					"id": 730560723,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560724
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560724,
					"content": "Und, hast du dich an etwas erinnert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560725,
					"content": "Nein, keine Ahnung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560726
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560726,
					"content": "Ach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560727,
						730560728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560727,
					"content": "*seufz* ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560729
					]
				},
				{
					"id": 730560729,
					"content": "Aber danke. Wenn an meinen Garten erinnert ihr euch noch, dann kommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560730
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560730,
					"content": "Wichtige Blume, wird sie einpflanzen, Aranaga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560731
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560731,
					"content": "Aranaga ist mit der Blume gegangen.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730560732
					]
				},
				{
					"id": 730560732,
					"content": "Gegangen ... ist er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560733,
						730560735
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560733,
					"content": "Er ist gegangen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560734
					]
				},
				{
					"id": 730560734,
					"content": "Aber er hat uns zu seinem Garten eingeladen ... Das heißt, er ist nicht abgeneigt, Freundschaft mit uns zu schließen, oder? Wir sollten vorbeischauen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560735,
					"content": "Aber er hat uns eingeladen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560736
					]
				},
				{
					"id": 730560736,
					"content": "Hmm ... Ja. Dann sollten wir Aranaga besuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560728,
					"content": "Das war abzusehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560729
					]
				},
				{
					"id": 730560721,
					"content": "Nun, das ist eine lange Geschichte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560722
					]
				},
				{
					"id": 730560708,
					"content": "Wir sind Freunde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560709
					]
				},
				{
					"id": 730560709,
					"content": "Freunde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560710
					],
					"speakerTitle": "Aranaga"
				}
			]
