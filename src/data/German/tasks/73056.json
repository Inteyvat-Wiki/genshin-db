	"talks": [
		{
			"id": 7305601,
			"completionStepIds": [
				7305601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
