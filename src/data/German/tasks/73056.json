				},
				{
					"id": 730560502,
					"content": "Haha, „Mawtiyima“, „Mawtiyima“ ... Mein alter Freund! Immer noch am Werk, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
