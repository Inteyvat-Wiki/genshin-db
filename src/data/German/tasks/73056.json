			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560401,
					"content": "Ha! Sieh nur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560402
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560402,
					"content": "Ähm? Ist das eine neue Pflanze? Warum bist du plötzlich so aufgeregt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560403,
					"content": "Nein, keine neue Pflanze, etwas viel Besseres! ... Seht nur, unser „Geheimschloss“! Es ist völlig zerfallen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560404
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560404,
					"content": "Wie? ... Ein „Geheimschloss“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560405,
					"content": "Haha! Der Gelehrte Omar ist wieder da! Er hat die himmlischen Geheimnisse mitgebracht! Irfan, Siman, wo seid ihr? Wollt ihr mich nicht willkommen heißen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560406
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560406,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560407,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560408
					]
				},
				{
					"id": 730560408,
					"content": "*hust* Tut mir leid, Kinder. Ich ... habe mich hinreißen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560409
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560409,
					"content": "Das Alter macht das mit mir, die Gegenwart wird schleierhaft und Ereignisse aus der Kindheit werden hervorgerufen ... Hehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560410
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560410,
					"content": "Irfan und Siman waren meine Freunde. Zusammen haben wir das „Schloss“ gebaut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560411
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560411,
					"content": "Damals war Irfan ein großer Musiker und Siman eine Marschallin. Ich war ein Astrologe. Wir tauschten manchmal unsere Rollen, wir waren schließlich Kinder ... Kinder wechseln das Spiel, wenn sie genug haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560412
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560412,
					"content": "Irfan war sehr talentiert. Siman war groß und stark, einfach unbesiegbar. Und ich? Haha, ich war ein Bücherwurm aus einer Familie mit ein bisschen mehr Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560413,
						730560415
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560413,
					"content": "Du hast hier in deiner Kindheit gespielt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560414
					]
				},
				{
					"id": 730560414,
					"content": "Nein, hier war unser Geheimreich und ich nahm die Sache sehr ernst. Wir hatten einander versprochen, dass wir sie nicht vergessen würden. Als Erwachsene würden wir die „Rückeroberungsarmee“ leiten und das Schloss zurücknehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560418,
					"content": "Hehe, zwanzig Jahre ist es her. Vielleicht haben sie es längst vergessen ... Aber hier habe ich meinen kleinen Forschungsstützpunkt im Wald angelegt, der bis vor dreißig Jahren in Betrieb war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560419
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560419,
					"content": "Auch „Marana“ kam später, aber von der „Rückeroberungsarmee“ war noch nichts zu sehen. Hehe, jawohl ... Wie soll sich ein Versprechen aus der Kindheit gegen den Tod behaupten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560420
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560420,
					"content": "Aber ... wenn du dich an sie erinnerst, erinnern sie sich bestimmt auch an dich! Nur nicht Trübsal blasen, Herr Khayyam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560421,
					"content": "Trübsal blasen? Keineswegs. Kindheitserinnerungen, gemeinsame „imaginäre Freunde“, eine Welt, die den Erwachsenen verschlossen bleibt. Vielleicht ein kleiner Jammer, aber ... die Zeit lässt sich nicht umdrehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560422
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560422,
					"content": "Mit den „imaginären Freunden“ ... Meinst du die Aranara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560423,
						730560424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560423,
					"content": "Paimon! Bleib ruhig!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560425,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560426
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560426,
					"content": "Haha ... Beinahe hätte ich vergessen, dass ich euch nicht zum Plaudern eingeladen habe, sondern zur Sammlung von neuen Pflanzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560427
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560427,
					"content": "Bitte verzeiht mir meine langweilige alte Geschichte. Lasst uns keine Zeit mehr verschwenden und weitermachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560424,
					"content": "Du plapperst zu viel, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560415,
					"content": "Du und deine Freunde haben all das gebaut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560416
					]
				},
				{
					"id": 730560416,
					"content": "Nicht ganz. Am Anfang hatten wir uns versprochen, dass wir die „Rückeroberungsarmee“ leiten und das Schloss zurücknehmen würden, wenn wir Erwachsene würden ... haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560417
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560417,
					"content": "Später wurde ich botanischer Forscher an der Akademie und kehrte zufällig auf einer Forschungsreise hierher zurück. Ich beschloss, diesen Ort wieder aufzubauen, und kehrte später mehrmals zurück, wobei ich alle Arten von Müll hinein- und herausbrachte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Khayyam"
				}
			]
		},
