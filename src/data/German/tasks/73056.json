					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560503,
					"content": "Oh, Herr Khayyam wirkt plötzlich jünger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560504,
						730560506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560504,
					"content": "Paimon kann auch plötzlich sprechen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560505
					]
				},
				{
					"id": 730560505,
					"content": "He! Was soll das denn heißen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560508,
					"content": "Hmm ... Das sollte reichen. Danke, dass ihr mit gekommen seid. Wenn nichts Weiteres ist, sollten wir gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560509
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560509,
					"content": "Haha, wie schön ... Mit den Proben können wir die Geheimnisse und Schwächen der „Verwelkung“ besser erforschen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560510
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560510,
					"content": "Ich danke euch beiden. Nehmen wir denselben Weg zurück ... Hier ist noch etwas für euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560511
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560511,
					"content": "Hurra, ein Dankeschön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560512,
					"content": "Hehe, wenn du meinst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560506,
					"content": "Super!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560507
					]
				},
				{
					"id": 730560507,
					"content": "Paimon weiß nicht warum, aber super!",
					"roleType": "TALK_ROLE_NPC",
