			},
			"dialogs": [
				{
					"id": 730560601,
					"content": "Danke, „Javans“. Danke, dass ihr mich begleitet habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560602
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560602,
					"content": "Ach ja, wenn es euch nichts ausmacht ... Es ist nicht besonders wertvoll, aber nehmt es als Andenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560603
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560603,
					"content": "Ooh ... Was ist das? Was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560604,
					"content": "Ihr solltet diese kleine, getrocknete Blume schon mal gesehen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560605
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560605,
					"content": "Ooh?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560606,
						730560607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560606,
					"content": "Das ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560608
					]
				},
				{
					"id": 730560608,
					"content": "Genau. Wenn ich nicht falsch liege ... sollten sie dir ein gleiches Geschenk bereitet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560609
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560609,
					"content": "Hehe ... Ich wusste doch, dass unsere Begegnung kein Zufall ist ... Ich glaube nicht an Zufälle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560610
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560610,
					"content": "Die Blume überlasse ich in deiner Obhut. Bitte übergib sie an unsere gemeinsamen Freunde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560611
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560611,
					"content": "Ja, das ist kein Problem, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560612,
						730560614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560612,
					"content": "Vielleicht haben sie mich vergessen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560613
					]
				},
				{
					"id": 730560613,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560615
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560615,
					"content": "Ich kann sie auch nicht mehr sehen ... Ich habe fast den Glauben an sie aufgegeben ... Besser gesagt, ich dachte, sie waren nur eine Fantasie aus meiner Kindheit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560616
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560616,
					"content": "Aber ich gebe nicht auf. Kinder, bringt die Blume zu ihnen ... Solange ihr sie noch zu Gesicht bekommt, können Wunder geschehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560614,
					"content": "Vielleicht haben sie dich vergessen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560615
					]
				},
				{
					"id": 730560607,
					"content": "Die Aranara ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560608
					]
				}
			]
		},
