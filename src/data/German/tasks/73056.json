				{
					"id": 730560801,
					"content": "Die Pflanzen gedeihen hier wirklich gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560802,
						730560804
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560802,
					"content": "Über die Pflanzen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560803
					]
				},
				{
					"id": 730560803,
					"content": "Ich hätte niemals gedacht, dass die Erde, die durch „Marana“ verwüstet wurde, jemals wieder Nährstoffe für so üppiges Pflanzenwachstum hergeben könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560804,
					"content": "Über die „imaginären Freunde“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560805
					]
				},
				{
					"id": 730560805,
					"content": "Die seltsamen Lebewesen, die von den Kindern „Aranara“ genannt werden, als „imaginäre Freunde“ zu bezeichnen ... Ist zweifellos nicht richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560806
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560806,
					"content": "Da die Detektoren der Akademie auch nicht auf sie ansprechen, können nur die Kinder ihre Existenz beweisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560807
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560807,
					"content": "Deshalb bezeichnet die Lebenskunde sie als „unbekannte Lebensformen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				}
			]
