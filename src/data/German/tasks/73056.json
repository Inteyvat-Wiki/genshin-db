			"dialogs": [
				{
					"id": 730560501,
					"content": "Seht nur ... Die Pflanzen gedeihen prächtig! Selbst Erde, die von „Marana“ verseucht wurde, kann neues Leben hervorrufen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
