			"dialogs": [
				{
					"id": 730560301,
					"content": "Wie interessant ... Die Pflanzen hier ... erwecken zu neuem Leben. „Mawtiyima“ zeigt wieder ihre Wirkung ... wie interessant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560302
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560302,
					"content": "Ähm ... Herr Khayyam, du hast auch von „Mawtiyima“ gehört? Paimon dachte, nur die Aranara wüssten davon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560303,
						730560304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560303,
					"content": "Paimon, bleib still!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				},
				{
					"id": 730560305,
					"content": "Die „Aranara“? Ihr habt sie also auch gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560306
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560306,
					"content": "Huch ...? Ähm ... J... ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560307,
						730560308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560307,
					"content": "Und, Herr Khayyam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560309,
					"content": "„Iram ist im Rosenbusch verblasst. Oh Gral des fremden Königs, wo bist du nur ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560310
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560310,
					"content": "Gehen wir zur nächsten Stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560308,
					"content": "Hast du sie auch gesehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560309
					]
				},
				{
					"id": 730560304,
					"content": "Paimon ...!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560305
					]
				}
			]
		},
		{
			"id": 7305604,
			"completionStepIds": [
				7305610
