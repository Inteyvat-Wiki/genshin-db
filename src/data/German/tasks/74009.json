			},
			"dialogs": [
				{
					"id": 740090401,
					"content": "Lieber Virgil ... Du bist eine echte Nervensäge ... Was sollen wir nur mit dir machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090402
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090402,
					"content": "E... Entschuldige bitte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090403
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090403,
					"content": "Oh, nein, das solltest du jetzt nicht sagen. Wie du weißt, fliegt die Zeit, und das Zeitfenster zum Umkehren ist längst vorbei. Unter uns, wir haben auch unsere Redlichkeit. Es gibt bestimmte Geschäfte, die nicht angetastet werden dürfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090404
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090404,
					"content": "A... Aber, Herr Sonny, hör mir zu, die Gewinne, die das bringen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090405
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090405,
					"content": "Ach. Geld, Geld, Geld ... Ist das alles, woran du denkst? Was ist mit deinem Stolz als Teil Fontaines? Bist du glücklich, dabei zuzusehen, wie dieses Getränk unsere Mitbürger vergiftet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090406
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090406,
					"content": "Pfui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090407
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090407,
					"content": "Oh? Wie selten, dass Luca dir zuliebe eine solche Fülle von Emotionen zeigt. Siehst du, mein lieber Virgil, du bist wirklich etwas, beachtlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090408
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090408,
					"content": "Herr Sonny, also ... bitte glaub mir, es ist alles wegen dieser Schurken, sie haben mich angelogen und ich, ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090409
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090409,
					"content": "Unsinn! Halte den Mund!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090410
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090410,
					"content": "Waaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090411
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090411,
					"content": "Ich verabscheue Abschaum wie dich. Du bist so weit gekommen und denkst immer noch, du kannst mich hereinlegen? Was soll das? Ist dein Gehirn verschimmelt, oder denkst du, mein Gehirn funktioniert nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090412
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090412,
					"content": "#Und du hast sogar versucht, {NICKNAME} zu töten, hast du denn gar kein Augenmaß? Sind Dummköpfe wie du das Ergebnis seiner Ausbildung? Hach ... Ich werde nachher mit ihm reden müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090413
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090413,
					"content": "... Aber darum brauchst du dich nicht zu kümmern, lieber Virgil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				}
			]
		}
	]
