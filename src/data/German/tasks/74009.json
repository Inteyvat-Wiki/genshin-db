			"dialogs": [
				{
					"id": 740090201,
					"content": "#{M#Geehrter Herr}{F#Liebe Dame}, liebe Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090202
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090202,
					"content": "Schaut mal, das ist der Stützpunkt, den Virgil in letzter Zeit benutzt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090203
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090203,
					"content": "Ach, warum ist Virgil noch nicht zurück ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090204
					],
					"speakerTitle": "Böse aussehende Person"
				},
				{
					"id": 740090204,
					"content": "Wenn er noch nicht zurückkommt, werde ich nicht widerstehen können ... nicht widerstehen können, diese Sinth zu trinken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090205
					],
					"speakerTitle": "Gefährlich aussehende Person"
				},
				{
					"id": 740090205,
					"content": "He, hört auf damit! Es hat uns große Mühe gekostet, diese Ladung zu beschaffen. Wenn du damit Ärger machst, wird Virgil das nicht auf die leichte Schulter nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090206
					],
					"speakerTitle": "Nicht anständig aussehende Person"
				},
				{
					"id": 740090206,
					"content": "Schade. Der liebe Virgil scheint noch nicht zurück zu sein. Aber wir können vorher mit ihnen „reden“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090207
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090207,
					"content": "Nun, sie scheinen nicht die Typen zu sein, mit denen man reden kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090208,
					"content": "Das muss nicht unbedingt stimmen, meinst du nicht, lieber Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090209
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090209,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090210
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090210,
					"content": "He! Gibt es wirklich kein Problem? Paimon hat immer das Gefühl, die werden uns gleich angreifen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090211,
					"content": "Herrje! Du bist sehr aufmerksam, Paimon. Es wäre bedauerlich, wenn so etwas passieren würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090212
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090212,
					"content": "... Für sie, natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				}
			]
		},
