			"dialogs": [
				{
					"id": 740090301,
					"content": "Bitte lasst mich erklären ... es war alles ein Missverständnis ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090302
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090302,
					"content": "Herr Sonny ... wir dachten einfach, es wäre ein profitables Geschäft, auch wenn wir nicht die Zustimmung unserer Vorgesetzten hatten, aber wir glaubten ... wir dachten, wir würden einen Gewinn machen und ihn der Organisation geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090303
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090303,
					"content": "Argh, Paimon wird einfach ignoriert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090304,
					"content": "Ich habe keine Wut auf die Organisation ... Ich wurde von den bösen Menschen getäuscht und dazu gebracht, eine solche Dummheit zu begehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090305
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090305,
					"content": "#Das ist wirklich großartig. {NICKNAME}, du wirst deinem Ruf gerecht. Meinst du nicht auch, lieber Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090306
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090306,
					"content": "Erstaunlich. Hat wirklich gut gekämpft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090307
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090307,
					"content": "Bitte, wenn ihr euch noch an etwas von der vergangenen Zeit erinnert ... Herr Sonny ... Herr Luca ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090308
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090309
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090309,
					"content": "Waah! Nein, nein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090310
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090310,
					"content": "Luca, die Gäste sind noch hier. Wir können nichts Unhöfliches tun und sie verärgern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090311
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090311,
					"content": "Klar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090312
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090312,
					"content": "Hmpf, Virgil, weißt du jetzt, was du falsch getan hast!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090313,
					"content": "Ah! Ja! Ich habe falsch gehandelt, ich habe falsch gehandelt ... Bitte verzeih mir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090314
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090314,
					"content": "Na gut, zumindest hast du zugegeben, dass du etwas falsch gemacht hast. Tu es nie wieder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090315,
					"content": "#Der liebe Virgil wird es nie wieder tun, Paimon, {NICKNAME}. Ich verpflichte mich, bei der Ehre des „Weißen Handschuhs“ Sonny, und bei der Ehre meines Vaters und meines Sohnes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090316,
						740090317
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090316,
					"content": "Wir sollten gehen, Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090320
					]
				},
				{
					"id": 740090320,
					"content": "Na! Vielen Dank, Sonny und Luca. Es scheint, dass es in Fontaine immer noch mehr gute als schlechte Menschen gibt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090321,
					"content": "#Auf Wiedersehen, und ich hoffe, wir bekommen eine weitere Chance, zusammenzuarbeiten, liebe Paimon, {M#geehrter Herr}{F#liebe Dame}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090322
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090322,
					"content": "Nein ... nein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090317,
					"content": "Was habt ihr vor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090318
					]
				},
				{
					"id": 740090318,
					"content": "#In dieser Welt ist es ein bisschen langweilig, wenn man zu viel verstehen kann, nicht wahr, {M#geehrter Herr}{F#liebe Dame}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090319
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090319,
					"content": "Wenn du wirklich neugierig bist, werden wir uns die Zeit nehmen und zuerst mit ihm ... reden. Also, wir werden eure wertvolle Zeit nicht noch weiter in Anspruch nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090320
					],
					"speakerTitle": "Sonny"
				}
			]
		},
