					}
				]
			},
			"dialogs": [
				{
					"id": 740090101,
					"content": "Das ist ein ziemlicher Zufall, wirklich. Findest du nicht auch, lieber Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090102
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090103
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090103,
					"content": "Wer seid ihr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090104,
					"content": "Ach, wie unhöflich von mir. Ich bin Sonny. Meine Freunde nennen mich manchmal „Weißen Handschuh“. Er ist Luca, der „Fischer“, ist bei einer bestimmten Gruppe von Leuten bekannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090105
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090105,
					"content": "Oh, hallo, wir sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090106,
					"content": "#Ich weiß, ich weiß, du bist Paimon, und {M#dieser blonde Herr}{F#diese blonde Frau} ist {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090107
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090107,
					"content": "Hä? Kennst du uns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090108,
					"content": "#Natürlich kenne ich euch! Ich kannte dich und {NICKNAME} bereits, so wie ich Herrn Neuvillette kannte, wenn auch nicht persönlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090109
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090109,
					"content": "Angesichts eures Ruhms ist es nur natürlich, dass uns ein kleines Vögelchen diese Neuigkeit zwitschert, sobald ihr Fontaine betretet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090110
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090110,
					"content": "Sind wir so berühmt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090111
					]
				},
				{
					"id": 740090111,
					"content": "Haha, wie bescheiden du bist! Eure Anwesenheit in Fontaine ist für manche wie eine Explosion auf der Bühne der Opéra Épiclèse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090112
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090112,
					"content": "... Natürlich, auf eine gute Weise! Oder, lieber Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090113
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090113,
					"content": "Äh, wie kann eine Explosion auf der Bühne eine gute Sache sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090114,
					"content": "Na ja ... ich bin nicht sehr wortgewandt. Wie würdest du es ausdrücken, lieber Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090115
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090115,
					"content": "Lyneys und Lynettes Zauberschau. Bombe, Fluchtvorführung. Explosive Nachrichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090116
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090116,
					"content": "Wie scharfsinnig! Mir fällt einfach kein Weg ein, das zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090117
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090117,
					"content": "A... Ach so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090118,
					"content": "Aber warum nennt man dich „Weißen Handschuh“? Du trägst doch keine Handschuhe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090119,
					"content": "Oh, das ist eine schwierige Frage. Wie kann ich es dir erklären?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090120
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090120,
					"content": "Stell dir vor, dass du weiße Handschuhe trägst. Wenn du etwas Schmutziges anfasst, hinterlässt es einen Fleck auf deinen Handschuhen, richtig? Meine Aufgabe ist es also, Schmutz zu finden und zu entfernen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090121
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090121,
					"content": "Ach ja ... das heißt, du bist derjenige, der für die Reinigung zuständig ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090122,
					"content": "Gut gesagt, liebe Paimon! Ich könnte das Wesen meiner Arbeit nicht so präzise und prägnant zusammenfassen wie du.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090123
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090123,
					"content": "Es ist also Leuten wie Sonny zu verdanken, dass die Straßen im Hof von Fontaine so aufgeräumt sind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090124,
					"content": "Haha, du bist sehr nett! So kann man es auffassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090125
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090125,
					"content": "Ja ... aber brauchen Reinigungskräfte Messer dabei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090126,
					"content": "Nun, nimm es einfach als ein kleines Hilfsmittel, das beim Aufräumen von hartnäckigem Müll sehr nützlich ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090127
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090127,
					"content": "Ach so, Paimon versteht! Und heißt Luca dann „Fischer“, weil er gut im Angeln ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090128,
					"content": "Hm ... das stimmt nicht ganz. Du weißt doch, in Fontaine haben wir alle Arten von Fischen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090129
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090129,
					"content": "Und seine Spezialität ist es, den Menschen beizubringen, wie sie glücklich und gelassen mit bunten Fischschwärmen leben können. Habe ich recht, lieber Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090130
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090130,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090131
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090131,
					"content": "Hm? Paimon versteht das nicht ... Wenn das so ist, dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090132,
					"content": "Oha, liebe Paimon, du weißt wirklich, wie man Fragen stellt. Die Fragen, die du stellst, sind sehr knifflig und raffiniert. Ich wünschte, ich könnte öfter mit dir reden und deine Fragen ausführlich beantworten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090133,
						740090135
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090133,
					"content": "Paimon, lass die Fragen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090134
					]
				},
				{
					"id": 740090134,
					"content": "Hm? Also gut ... Sonny, Luca, was habt ihr vor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090136,
					"content": "Nun, wir sind sehr am „Tauchen“ interessiert. Unser Fontaine ist gefüllt mit Reichtümern der Natur und der früheren Generationen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090137
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090137,
					"content": "Ich habe gehört, dass du kürzlich einen guten Freund hier getroffen hast und mit ihm ins Wasser gegangen bist. Du bist so gut darin, dass du nicht einmal eine Tauchausrüstung brauchst. Stimmt das, mein lieber Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090138
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090138,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090139
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090139,
					"content": "Ihr wolltet nach Virgil fragen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090140
					]
				},
				{
					"id": 740090140,
					"content": "Ja, das ist richtig. Wir möchten nach Virgil fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090141
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090141,
					"content": "Virgil ... der Bösewicht! Argh, der nervt Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090142,
					"content": "Ihr erzählt „Weißem Handschuh“ Sonny und „Fischer“ Luca alle Dinge, die euch widerfahren sind.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740090143
					]
				},
				{
					"id": 740090143,
					"content": "Ah, so ist das also. Ich danke euch vielmals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090144
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090144,
					"content": "Gern geschehen! Hmpf, Paimon hat nicht eine einzige Sache an diesem Kerl vergessen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090145,
					"content": "#... Natürlich sind wir dankbar dafür, dass ihr ehrlich gesagt habt, was mit Virgil geschah. Aber ich bin noch dankbarer, dass ihr nicht seine {F#Freundinnen}{M#Freunde} seid. Sonst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090146
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090146,
					"content": "Lass es mich so ausdrücken: Sonst wäre es für euch und uns mehr oder weniger unangenehm gewesen. Meinst du nicht auch, lieber Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090147
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090147,
					"content": "Das könnte die Sache erschweren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090148
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090148,
					"content": "Ja, ja, stimmt. Vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090149
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090149,
					"content": "Wovon redest du da ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090150,
					"content": "Sie sind Virgils Gegner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090151
					]
				},
				{
					"id": 740090151,
					"content": "Oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090152,
					"content": "#Was du sagst, stimmt mich traurig, {M#geehrter Herr}{F#liebe Dame}. Ich habe keine Gegner, nur viele Freunde, und Virgil ist einer davon. Allerdings, der liebe Virgil ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090153
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090153,
					"content": "#Wir müssen ein gutes „Gespräch“ mit ihm führen. Das verstehst du doch, {M#lieber}{F#liebe} {NICKNAME}, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090154
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090154,
					"content": "Natürlich geht es auch darum, von ihm eine Erklärung für das zu verlangen, was er dir und Paimon angetan hat. Er muss etwas tun, um sein unhöfliches Verhalten wiedergutzumachen ... Meint ihr nicht auch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090155
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090155,
					"content": "Das hat Paimon nicht verstanden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090156,
						740090158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090156,
					"content": "Er ist der „Weiße Handschuh“. Das ist alles, was wir wissen sollen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090157
					]
				},
				{
					"id": 740090157,
					"content": "Hmm, wieso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090160,
					"content": "Wir haben den Stützpunkt von Virgil und seinen Freunden gefunden. Wir könnten uns auch auf dem Stützpunkt treffen, was meint ihr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090161,
						740090165
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090161,
					"content": "Warum sollten wir zusammen kommen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090162
					]
				},
				{
					"id": 740090162,
					"content": "#{M#Geehrter Herr}{F#Liebe Dame}! Virgil hat euch so etwas Anstößiges angetan, dass es unhöflich von mir und Luca wäre, mit ihm zu ... reden, ohne es euch zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090163
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090163,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090164
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090164,
					"content": "Schaut, Luca ist auch der Meinung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090166
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090166,
					"content": "Hmpf! Paimon möchte auch mit Virgil sprechen! Er soll sich bei uns entschuldigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090167,
					"content": "Haha, das ist sehr nett von dir. Dann treffen wir uns am Zielort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090165,
					"content": "Na gut. Gehen wir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090166
					]
				},
				{
					"id": 740090158,
					"content": "Man muss diese Dinge nicht verstehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090159
					]
				},
				{
					"id": 740090159,
					"content": "#In dieser Welt ist es ein bisschen langweilig, wenn man zu viel verstehen kann, nicht wahr, {M#geehrter Herr}{F#liebe Dame}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090135,
					"content": "Was wollt ihr von uns?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090136
					]
				}
			]
		},
