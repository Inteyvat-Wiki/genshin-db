				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201031201,
					"content": "Und? Hast du den Hilichurlen meine Gedichte vorgelesen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031202
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031202,
					"content": "Ja, das habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031203
					]
				},
				{
					"id": 201031203,
					"content": "Und wie haben sie reagiert? Deiner düsteren Miene nach zu urteilen, scheint es nicht so gut gelaufen zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031204
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031204,
					"content": "Es gab einen Vorfall ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031205
					]
				},
				{
					"id": 201031205,
					"content": "Hast du nicht auf meine Markierungen geachtet? Oder habe ich dabei einen Fehler gemacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031206
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031206,
					"content": "Tut mir leid, ich muss mich wohl weiter anstrengen. Trotzdem möchte ich dir danken. Hier, bitteschön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031207
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031207,
					"content": "Ich muss mich am Riemen reißen. Sonst werde ich dem Ruf des Namens Musk nie gerecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
