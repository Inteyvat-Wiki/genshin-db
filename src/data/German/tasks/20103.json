					"id": 201031102,
					"content": "Ja, das habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031103
					]
				},
				{
					"id": 201031103,
					"content": "Und wie haben sie reagiert? Deinem Grinsen nach zu urteilen, scheint es gut ausgegangen zu sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031104,
					"content": "Sie haben ganz positiv reagiert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031105
					]
				},
				{
					"id": 201031105,
					"content": "Ich habe also keine Fehler beim Vokabular gemacht, prima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031106
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031106,
					"content": "Das bringt mich einen großen Schritt weiter in der Hilichurlisch-Forschung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031107,
					"content": "Eines Tages werde ich mich problemlos mit den Hilichurlen austauschen können. Dann werden wir alle Geheimnisse der Hilichurle lüften können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031108,
					"content": "An jenem Tag werde ich endlich dem Ruf des Namens Musk gerecht werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031109
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031109,
					"content": "Ach, das wollte ich dir geben. Vielen Dank nochmal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
