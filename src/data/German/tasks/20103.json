				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201031501,
					"content": "Ich würde zu gern wissen, ob die Hilichurle meine Gedichte mögen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031502,
						201031509,
						201031515
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031502,
					"content": "Warum hast du die Gedichte auf Hilichurlisch geschrieben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031503
					]
				},
				{
					"id": 201031503,
					"content": "Also, ehrlich gesagt habe ich das Hilichurlische noch nicht vollständig durchschaut. Die Grammatik, die Syntax und die Wortverbindungen ... Da ist mir einiges noch ein Rätsel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031504
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031504,
					"content": "Ich habe mir zwar wirklich viel Mühe gegeben. Für die Hilichurle könnten meine Gedichte aber ziemlich unbeholfen klingen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031505
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031505,
					"content": "Außerdem braucht nur ein einziges Wort ausgetauscht zu werden, damit sich die Bedeutung eines ganzen Satzes verändert. Wenn ich meine Analysen nicht auf die Probe stelle, werde ich diese Feinheiten nicht erlernen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031506
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031506,
					"content": "Die meisten Menschen wollen mit Hilichurlisch oder den Hilichurlen selbst gar nicht in Berührung kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031507
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031507,
					"content": "Ich persönlich habe damit aber gar kein Problem. Ich nehme vieles in Kauf, um Hilichurlisch, ja die Gedanken der Hilichurle selbst zu verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031508
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031508,
					"content": "Außerdem denke ich mir, dass es sicher das beste wäre, wenn wir mit den Hilichurlen um Mondstadt Kontakt pflegen würden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031509,
					"content": "Was sind das für Markierungen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031510
					]
				},
				{
					"id": 201031510,
					"content": "Du meinst du Markierungen hinten? Sagen wir es mal so: Das Vokabular für die Gedichte habe ich Büchern entnommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031511
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031511,
					"content": "Zwar habe ich mich streng an die darin aufgeführten Regeln gehalten und Sätze daraus geformt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031512
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031512,
					"content": "Aber Sprachen sind nun einmal sehr komplex. Ein und dasselbe Wort kann in unterschiedlichem Kontext völlig anders wahrgenommen werden. Ganze Sätze können dadurch einen anderen Inhalt annehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031513
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031513,
					"content": "Was ich geschrieben habe, sind schon die Sätze, bei denen ich mir am sichersten war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031514
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031514,
					"content": "Ich habe sogar noch einige Verse, die komplett wirr zu sein scheinen. Die zeige ich dir gar nicht erst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031515,
					"content": "Wenn ich mir diese Markierungen so ansehe, scheinst du schon ziemlich gut Bescheid zu wissen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031516
					]
				},
				{
					"id": 201031516,
					"content": "Ja, aber auch nur „ziemlich“. Ich will ja, dass wir gut mit den Hilichurlen auskommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031517
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031517,
					"content": "Aber das geht nur, wenn wir keine Fehler machen. Ansonsten werden sie uns falsch verstehen und uns womöglich sogar angreifen. In dem Fall wäre ich total unvorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031518
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031518,
					"content": "Aber dennoch kein Grund zur Sorge! Du musst nur auf meine Markierungen achten. Dann wird schon nichts schiefgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031519
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031519,
					"content": "Ganz bestimmt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
