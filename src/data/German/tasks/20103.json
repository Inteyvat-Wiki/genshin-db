			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201030101,
					"content": "So sehen wir uns wieder. Erinnerst du dich noch? Zumindest an die freundschaftliche Konversation mit den Hilichurlen erinnerst du dich sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030102,
					"content": "Jetzt sieh mich nicht so an! Sprachliche Fähigkeiten muss man eben immer trainieren, um gut zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030103,
					"content": "Keine Sorge, deine Mühen waren nicht umsonst. Seit dem letzten Mal ist meine Aussprache viel besser geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030104,
					"content": "Sprechen kann ich jetzt schon ganz gut, beim Schreiben hänge ich aber ziemlich hinterher. Deshalb habe ich einige Untersuchungen angestellt und mir selbst ein paar Gedichte auf Hilichurlisch ausgedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030105,
					"content": "Es gibt allerdings noch ein paar Passagen, bei denen ich mir nicht sicher bin. Könntest du dich bitte vergewissern, dass sie in Ordnung sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030106,
						201030111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030106,
					"content": "Wie meinst du „vergewissern“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030107
					]
				},
				{
					"id": 201030107,
					"content": "Na, du sollst die Gedichte den Hilichurlen vortragen und sehen, wie sie reagieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030108,
					"content": "Mach dir keine Sorgen! Ich habe die Passagen, bei denen ich mir nicht sicher bin, <color=#00E1FFFF>markiert</color>. Theoretisch dürfte nicht allzu viel schiefgegangen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030109
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030109,
					"content": "Ich habe schon ein paar Opfer ausgewählt. Diese Hilichurle scheinen relativ ruhig zu sein. Du kannst ihnen die Gedichte vorlesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030110
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030110,
					"content": "Wenn du damit fertig bist, kannst du mir sagen, wie sie reagiert haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030111,
					"content": "Schon wieder? Muss das wirklich sein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030112
					]
				},
				{
					"id": 201030112,
					"content": "Ach, du bist doch mittlerweile Profi, was das angeht. Ich habe die Passagen, bei denen ich mir nicht sicher bin, <color=#00E1FFFF>markiert</color>. Theoretisch dürfte nicht allzu viel schiefgegangen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030113,
					"content": "Ich habe schon ein paar Opfer ausgewählt. Diese Hilichurle scheinen relativ ruhig zu sein. Du kannst ihnen die Gedichte vorlesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030114
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030114,
					"content": "Wenn du damit fertig bist, kannst du mir sagen, wie sie reagiert haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030115,
					"content": "Falls doch etwas Unerwartetes passieren sollte, bin ich davon überzeugt, dass ihr das schon ausdiskutieren werdet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
