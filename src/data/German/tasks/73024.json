			},
			"dialogs": [
				{
					"id": 730240101,
					"content": "Danke vielmals! Ihr wart eine große Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240102
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240102,
					"content": "Wie ihr sehen könnt, bin ich die Waldhütermeisterin für diese Gegend. Mein Name lautet Rana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240103,
						730240105
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240103,
					"content": "#Ich bin {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240104
					]
				},
				{
					"id": 730240104,
					"content": "Paimon ist Paimon! Wir kommen aus einem anderen Land.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240107,
					"content": "Verstehe. Hmm ... Nach eurem Aussehen zu schließen, seid ihr tatsächlich keine Einwohner des Walds ... und scheint auch nicht aus dem gelben Sand zu kommen. Eure Kleidung scheint eine hohe Atmungsaktivität aufzuweisen, was bei Reisen in Sumeru von großem Vorteil ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240108
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240108,
					"content": "Hm. Wenn Rana also eine Waldhütermeisterin ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240109,
						730240123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240109,
					"content": "Dann sollte sie Tighnari kennen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240110
					]
				},
				{
					"id": 730240110,
					"content": "#Oh! {NICKNAME}, du bist auch mit Tighnari bekannt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240111
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240111,
					"content": "Auch wenn Tighnari „unnahbar“ wirkt, ist er doch ein guter Mensch. Als ich noch in der Ausbildung war, hat er sich sehr um mich gekümmert. Außerdem sind seine Ohren sehr ansehnlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240112
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240112,
					"content": "Oh ja! Paimon würde sie auch gerne einmal berühren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240113,
						730240116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240113,
					"content": "Genau wie ich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240114
					]
				},
				{
					"id": 730240114,
					"content": "Hmm ... Wenn Paimon heimlich an sie heranfliegt, könnte Paimon sie dann wohl berühren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240115,
					"content": "Hahaha, wenn du das tust, ohne vorher zu fragen, könnte Tighnari wütend werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240118,
					"content": "Nicht wahr? Sie glänzen so schön und ich frage mich, wie sie sich anfühlen. Das Kind bei ihm ist sicher auch sehr daran interessiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240119
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240119,
					"content": "Äh? Rana, du meinst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240120,
					"content": "Ist es Collei?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240121
					]
				},
				{
					"id": 730240121,
					"content": "#Oh? {NICKNAME}, du kennst auch Collei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240122
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240122,
					"content": "Colleis Gesundheit scheint nicht besonders gut zu sein. Trotzdem scheut sie keine Mühen, um den Wald zu beschützen und die Verwelkung zu beseitigen. Alle machen sich große Sorgen um sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240141
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240141,
					"content": "Ähem! Wie dem auch sei, als Waldhütermeister ist es unsere Pflicht, den Wald zu schützen, Reisenden zu helfen und den Weg zu weisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240142
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240142,
					"content": "#Wie {NICKNAME} und Paimon ja gesehen haben, ist die Lage im Wald in letzter Zeit nicht gerade ideal. Sowohl die Pilzbestien als auch die Wildtiere sind überaus aggressiv. Und dann ist da noch die „Verwelkung“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240143
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240143,
					"content": "Es wäre vielleicht besser, wenn ich euch begleiten würde. Meine Waldpatrouille führt mich als Nächstes an Vimara vorbei. Von dort aus könnt ihr bequem auf dem Wasserweg nach Ormos oder Sumeru reisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240144,
						730240146
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240144,
					"content": "Einverstanden, lasst uns aufbrechen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240145
					]
				},
				{
					"id": 730240145,
					"content": "Gut! Mit mir wird euch beiden nichts zustoßen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240146,
					"content": "Gut. Aber es gibt etwas, das ich jetzt tun muss ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240147
					]
				},
				{
					"id": 730240147,
					"content": "Verstehe. Ich werde auf euch warten. Passt auf euch auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240116,
					"content": "Paimon könnte heimlich vorbeifliegen, um sie zu berühren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240117
					]
				},
				{
					"id": 730240117,
					"content": "So etwas könnte Tighnari wütend machen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240123,
					"content": "Dann sollte sie Collei kennen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240124
					]
				},
				{
					"id": 730240124,
					"content": "#Oh? {NICKNAME}, du kennst schon dieses Kind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240125
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240125,
					"content": "Colleis Gesundheit scheint nicht besonders gut zu sein. Trotzdem scheut sie keine Mühen, um den Wald zu beschützen und die Verwelkung zu beseitigen. Alle machen sich große Sorgen um sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240126
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240126,
					"content": "Aber da sie den Meister mit den „sich scheinbar sehr gut anfühlenden Ohren“ an ihrer Seite hat, sollte sie schon klar kommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240127
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240127,
					"content": "Oh? Ohren ... Du redest doch nicht etwa von ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240128,
						730240138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240128,
					"content": "Tighnari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240129
					]
				},
				{
					"id": 730240129,
