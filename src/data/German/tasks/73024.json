					]
				},
				{
					"id": 730240137,
					"content": "So etwas könnte Tighnari wütend machen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240138,
					"content": "Ist es Amber?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240139
					]
				},
				{
					"id": 730240139,
					"content": "„Los, Graf von Hoppel!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240140,
					"content": "... Es kann auf keinen Fall Amber sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240105,
					"content": "Wir kommen von einem weit entfernten Ort ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240106
					]
				},
				{
					"id": 730240106,
					"content": "#Ja! Der Name ist Paimon und das ist {NICKNAME}.",
