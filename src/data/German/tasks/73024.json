						730240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240402,
					"content": "Aah! Widerliche Pilze! Bleibt mir vom Leib!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240403
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240403,
					"content": "#Waaah, {NICKNAME}, sie scheint in Gefahr zu sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240404
					],
					"speakerTitle": "Paimon"
				},
				{
