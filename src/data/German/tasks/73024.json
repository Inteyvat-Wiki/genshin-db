				{
					"id": 730240502,
					"content": "Wie ihr sehen könnt, bin ich die Waldhütermeisterin für diese Gegend. Mein Name lautet Rana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240503,
						730240505
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240503,
					"content": "#Ich bin {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240504
					]
				},
				{
					"id": 730240504,
					"content": "Paimon ist Paimon! Wir kommen aus einem anderen Land.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730240507,
					"content": "Verstehe. Hmm ... Nach eurem Aussehen zu schließen, seid ihr tatsächlich keine Einwohner des Walds ... und scheint auch nicht aus dem gelben Sand zu kommen. Eure Kleidung scheint eine hohe Atmungsaktivität aufzuweisen, was bei Reisen in Sumeru von großem Vorteil ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240508
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240508,
					"content": "Ähem! Wie dem auch sei, als Waldhütermeister ist es unsere Pflicht, den Wald zu schützen, Reisenden zu helfen und den Weg zu weisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240509
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240509,
					"content": "#Wie {NICKNAME} und Paimon ja gesehen haben, ist die Lage im Wald in letzter Zeit nicht gerade ideal. Sowohl die Pilzbestien als auch die Wildtiere sind überaus aggressiv. Und dann ist da noch die „Verwelkung“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240510
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240510,
					"content": "Es wäre vielleicht besser, wenn ich euch begleiten würde. Meine Waldpatrouille führt mich als Nächstes an Vimara vorbei. Von dort aus könnt ihr bequem auf dem Wasserweg nach Ormos oder Sumeru reisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240511,
						730240513
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240511,
					"content": "Super, lasst uns aufbrechen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240512
					]
				},
				{
					"id": 730240512,
					"content": "Gut! Mit mir wird euch beiden nichts zustoßen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240513,
					"content": "Gut. Aber es gibt etwas, das ich jetzt tun muss ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240514
					]
				},
				{
					"id": 730240514,
					"content": "Verstehe. Ich werde hier auf euch warten. Passt auf euch auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730240505,
					"content": "Wir kommen von einem weit entfernten Ort ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730240506
					]
				},
				{
					"id": 730240506,
					"content": "#Ja! Der Name ist Paimon und das ist {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730240507
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}