			"dialogs": [
				{
					"id": 220070201,
					"content": "Wo hab ich sie nur verloren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070202
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220070202,
					"content": "Du darfst nur diese Schachtel verwenden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070203
					]
				},
				{
					"id": 220070203,
					"content": "Sieh mal genauer hin, ich habe einige Lagen Kleidung zum Einwickeln benutzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070204
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220070204,
					"content": "Natürlich bin ich eine sehr professionelle Gelehrte. Ich darf mir keine dummen Fehler erlauben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070205
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220070205,
					"content": "Nun gut, ich überlasse die Sache jetzt ganz dir. Ich vermag gegen diese Monster sowieso nichts auszurichten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao’er"
				}
			]
		},
