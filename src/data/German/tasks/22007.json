			"dialogs": [
				{
					"id": 220070401,
					"content": "Hast du das kulturelle Relikt gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070402
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220070402,
					"content": "Ja, habe ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070403
					]
				},
				{
					"id": 220070403,
					"content": "Ich seh mir das mal an ... In der Tat, das ist ja wirklich ein kulturelles Relikt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070404
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220070404,
					"content": "Es sieht so aus, als wäre dies nicht das Relikt, das ich verloren habe. Dennoch ist es sehr wertvoll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070405
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220070405,
					"content": "Dieses kulturelle Relikt könnt ihr einer Expertin wie mir zur sicheren Verwahrung ruhigen Gewissens anvertrauen. Macht euch keine Sorgen, hehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao’er"
				}
			]
		}
