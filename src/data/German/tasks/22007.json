			"dialogs": [
				{
					"id": 220070101,
					"content": "Wo hab ich sie nur verloren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070102
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220070102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070103
					]
				},
				{
					"id": 220070103,
					"content": "Das war so, ich erforschte gerade eine der Ruinen, als ich plötzlich von einem Monster angegriffen wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070104
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220070104,
					"content": "Ich rannte panisch davon, vergaß aber dabei leider auch die gerade ausgegrabenen Relikte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070105
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220070105,
					"content": "Als die Gruppe von Monstern wieder verschwunden war, hastete ich zu der Stelle zurück. Die Relikte jedoch waren längst verschwunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070106
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220070106,
					"content": "Den Rest des Tages durchsuchte ich die gesamte Umgebung, konnte aber nichts finden. Wer weiß, ob die Monster sie mitgenommen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070107
					],
					"speakerTitle": "Bao’er"
				},
				{
					"id": 220070107,
					"content": "Kannst du mir helfen, sie zu finden? Nutze diese Schachtel, um sie einzuwickeln, solltest du sie finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao’er"
				}
			]
		},
		{
			"id": 2200702,
