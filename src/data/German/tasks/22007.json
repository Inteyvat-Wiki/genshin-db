			"dialogs": [
				{
					"id": 220070301,
					"content": "Wo immer es nur ging, habe ich bereits gesucht ... aber ich konnte es immernoch nicht finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220070302,
					"content": "Willst du noch weiter suchen oder lieber zurückgehen und noch einmal Bao’er fragen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070303,
						220070304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220070303,
					"content": "Lass uns weitersuchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070305
					]
				},
				{
					"id": 220070305,
					"content": "Na gut, dann suchen wir noch einmal gründlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220070304,
					"content": "Dann gehen wir mal zurück ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070306
					]
				},
				{
					"id": 220070306,
					"content": "Gut, gehen wir zurück und fragen noch einmal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
