			"dialogs": [
				{
					"id": 701060401,
					"content": "Wegen des Fleischs des großen Schnee-Ebers, das du wolltest ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060402
					]
				},
				{
					"id": 701060402,
					"content": "Ah, du hast das Fleisch des großen Schnee-Ebers besorgt, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060403
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060403,
					"content": "Bitteschön.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060404
					]
				},
				{
					"id": 701060404,
					"content": "Nun, in diesem Fall ... hätten wir alle Zutaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060405
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060405,
					"content": "Während ich wartete, dass du mit den Zutaten zurückkehrst, habe ich das Rezept ausgefeilt. Eins ist sicher: Es ist auf jeden Fall weit entfernt von dem altertümlichen Rezept, mit dem ich begonnen habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060406
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060406,
					"content": "Aber solange es am Ende gut schmeckt, interessiert es mich nicht, wie ich es schaffe. Ich denke, ich werde dieses Gericht „Gulaschsuppe mit Gemüse“ nennen. Klingt exotisch, aber es ist sehr leicht zuzubereiten ... Warum versuchst du es nicht selbst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060407
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060407,
					"content": "Los, versuch’s mal. Wenn du es einmal gekocht hast, kannst du es ganz leicht merken, falls du es jemals wieder kochen willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				}
			]
		},
