						701060302
					]
				},
				{
					"id": 701060302,
					"content": "Ooh, dieses kalte Gourmetfleisch sieht ziemlich gut aus ... Jetzt muss ich nur noch eine weitere Zutat finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060303
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060303,
					"content": "Hast du schon mal vom großen Schnee-Eber gehört? Man sagt, dass er eine wilde Bestie sei, die tief in den Bergen lebt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060304
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060304,
					"content": "Und die Rezepte sagen, dass sich sein exquisites Fleisch für jede Art der Zubereitung gut eignet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060305
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060305,
					"content": "Hmm ... meinst du sowas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060306
					]
				},
				{
					"id": 701060306,
					"content": "Was? Moment mal ... Ja! Wie ... Wo? Ist das Zufall oder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060307
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060307,
					"content": "Na ja, wie auch immer ... Das heißt, ich habe jetzt alle Zutaten, die ich brauche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060308
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060308,
					"content": "Während ich wartete, dass du mit den Zutaten zurückkehrst, habe ich das Rezept ausgefeilt. Eins ist sicher: Es ist auf jeden Fall weit entfernt von dem altertümlichen Rezept, mit dem ich begonnen habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060309
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060309,
					"content": "Aber solange es am Ende gut schmeckt, interessiert es mich nicht, wie ich es schaffe. Ich denke, ich werde dieses Gericht „Gulaschsuppe mit Gemüse“ nennen. Klingt exotisch, aber es ist sehr leicht zuzubereiten ... Warum versuchst du es nicht selbst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060310
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060310,
					"content": "Keine Sorge, ich habe die Probleme berücksichtigt, wenn man versucht, in einer so unwirtlichen Umgebung wie hier zu kochen. Also habe ich die Garzeit auf ein Minimum reduziert und dafür gesorgt, dass die Zubereitungsart unkompliziert ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060311
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060311,
					"content": "Los, versuch’s mal. Wenn du es einmal gekocht hast, kannst du es dir ganz leicht merken, falls du es jemals wieder kochen willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				}
			]
		},
