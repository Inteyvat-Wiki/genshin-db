			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Harris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701060101,
					"content": "Nur noch ein paar mehr Zutaten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060102
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060102,
					"content": "Was passiert da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060103
					]
				},
				{
					"id": 701060103,
					"content": "#Hmm? Ah, {F#Reisende}{M#Reisender}. Ich verpasse gerade einem alten Rezept den letzten Schliff.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060104
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060104,
					"content": "Vor Kurzem begab sich ein Forschertrupp auf eine Expedition in die Berge. Einer von ihnen ist ein Freund von mir, ein Abenteurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060105
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060105,
					"content": "Aufgrund der schlechten Wetterlage kamen sie nicht sehr weit. Aber mein Freund hat mir erzählt, dass sie auf eine alte Ruine gestoßen sind, als sie Schutz vor dem Sturm suchten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060106
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060106,
					"content": "Sie war voll von Büchern und anderen Schriftstücken. Und sogar ... ein Rezept! Ich weiß nicht, wie es so lange intakt geblieben ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060107
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060107,
					"content": "Mein Abenteurerfreund hat mir das Rezept weitergegeben. Er hofft, dass ich den Geschmack der Vergangenheit wiederbeleben kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060108
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060108,
					"content": "Ich habe von einigen der Zutaten des Rezeptes noch nie etwas gehört. Sogar einige der Kochtechniken sind neu für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060109
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060109,
					"content": "Also, ich bereite eine abgewandelte Variante zu, die nur die wichtigsten Zutaten beinhaltet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060118
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060118,
					"content": "Wärst du bereit, mir dabei zu helfen, die ausgefallenen Zutaten aus dem Rezept zusammenzustellen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060110,
						701060112
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060110,
					"content": "Überlass das mir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060111
					]
				},
				{
					"id": 701060111,
					"content": "Freut mich zu sehen, dass du so begeistert davon bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060113
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060113,
					"content": "Ich habe gehört, dass sich ein paar Wildschweine in den Bergen verirrt haben und im Eis eingeschlossen wurden ... Ich bin gespannt, wie sich eine solche Qual auf den Geschmack des Fleisches auswirkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060114
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060114,
					"content": "Also könntest du mir vielleicht zehn Portionen kaltes Gourmetfleisch bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060115
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060115,
					"content": "Um sicherzugehen, du brauchst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060116
					]
				},
				{
					"id": 701060116,
					"content": "Also, das Fleisch dieser tiefgefrorenen Wildschweine. Wenn es in Eis eingeschlossen ist, bleibt es sicher ziemlich frisch, meinst du nicht? Wenn mir jemand von einem armen Wildschwein erzählt, das im Eis eingeschlossen ist, dann höre ich nur „kaltes Gourmetfleisch“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060117
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060117,
					"content": "Danke, dass du das für mich erledigst. Sobald du die Zutaten hast, komm zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060112,
					"content": "Welche Zutaten brauchst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060113
					]
				}
			]
		},
		{
