			},
			"dialogs": [
				{
					"id": 701060501,
					"content": "Lecker! Du bist echt ein Talent!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060502
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060502,
					"content": "Vielen Dank für deine Hilfe! Bitte nimm dies im Gegenzug an. Ich muss jetzt für ein paar andere Leute kochen gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060503
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060503,
					"content": "Oh, eine letzte Sache noch. Wenn du heute Abend noch einmal zu mir kommst, gebe ich dir noch eine Portion von diesem Essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060504
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060504,
					"content": "Wenn du in den Bergen auf Abenteuer gehst, solltest du darauf achten, richtig zu essen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				}
			]
		},
