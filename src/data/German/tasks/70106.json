			"dialogs": [
				{
					"id": 701060201,
					"content": "Hier ist dein kaltes Gourmetfleisch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060202
					]
				},
				{
					"id": 701060202,
					"content": "Ooh, dieses kalte Gourmetfleisch sieht ziemlich gut aus ... Jetzt muss ich nur noch eine weitere Zutat finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060203
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060203,
					"content": "Hast du schon mal vom großen Schnee-Eber gehört? Man sagt, dass er eine wilde Bestie sei, die tief in den Bergen lebt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060204
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060204,
					"content": "Und die Rezepte sagen, dass sich sein exquisites Fleisch für jede Art der Zubereitung gut eignet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060205
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060205,
					"content": "#{F#Reisende}{M#Reisender}, könntest du diesen Auftrag für mich erledigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060206
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060206,
					"content": "Dürfte ich mal ganz frech nachfragen, was für mich dabei herausspringt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060207
					]
				},
				{
					"id": 701060207,
					"content": "Keine Sorge, ich habe schon etwas zur Seite gelegt, wenn du zurückkehrst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				}
			]
		},
