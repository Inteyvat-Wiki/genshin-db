					"Typ in Grün"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3720101,
					"content": "Ah, ihr seid ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720102
					],
					"speakerTitle": "Typ in Grün"
				},
				{
					"id": 3720102,
					"content": "Stimmt. Ihr seid diejenigen, die Dvalin verscheucht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720103
					],
					"speakerTitle": "Typ in Grün"
				},
				{
					"id": 3720103,
					"content": "Dvalin? Wer ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720104,
						3720105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720104,
					"content": "Das ist der eigentliche Name von Sturmschrecken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				},
				{
					"id": 3720106,
					"content": "Ach so! Ich weiß wieder. Aber nennen ihn die meisten nicht Sturmschrecken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720107,
					"content": "Warum nennst du ihn dann Dvalin? Steht ihr euch nahe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720108,
					"content": "Was denkst du denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720109
					],
					"speakerTitle": "Typ in Grün"
				},
				{
					"id": 3720109,
					"content": "#He, {NICKNAME}. Ich finde, er ist irgendwie komisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720110,
						3720112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720110,
					"content": "Entschuldige bitte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720111
					]
				},
				{
					"id": 3720111,
					"content": "#Hallo, Fremde{M#r}. Wir sind uns zuvor begegnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720113
					],
					"speakerTitle": "Typ in Grün"
				},
				{
					"id": 3720113,
					"content": "Ich bin Venti der Barde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720114
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720114,
					"content": "Genauer gesagt bin ich drei Jahre in Folge der Gewinner von „Beliebtester Barde von Mondstadt“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720115
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720115,
					"content": "Wollt ihr etwas von mir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720116,
					"content": "Da du uns erkannt hast, brauchen wir sicher nicht weiter zu erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720117,
					"content": "Natürlich geht es um Sturmschrecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720118,
					"content": "Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720119
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720119,
					"content": "He! Tu nicht so, als wüsstest du nicht, wovon Paimon spricht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720120,
					"content": "#{NICKNAME}, kannst du ihm das Ding zeigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720121,
					"content": "Oh, das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720122,
					"content": "Hm? Der Kristall ist gereinigt worden? Wann ist das denn passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720123,
						3720124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720123,
					"content": "Komisch, er hat sich verändert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720125,
					"content": "Dvalin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720126
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720126,
					"content": "Der Schmerz, den er empfindet, hat ihn zu Tränen gebracht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720127,
					"content": "Eine Träne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720124,
					"content": "Letztes Mal war er noch voller Unreinheiten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720112,
					"content": "Wie heißt du nochmal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720113
					]
				},
				{
					"id": 3720105,
					"content": "Hast du schon vergessen, was Lisa gesagt hatte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				}
			]
		},
		{
			"id": 3720301,
			"completionStepIds": [
				37203
