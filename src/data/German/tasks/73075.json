			},
			"dialogs": [
				{
					"id": 730750101,
					"content": "#Nara {NICKNAME} und Paimon, ich danke euch. Die Baumschule von Vanarana ist nun voller Viparyas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750102
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750102,
					"content": "Die Viparyas hier sind sehr glücklich, also ist auch Arakara glücklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750103
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730750103,
					"content": "Das Utsava-Fest ist vorbei und bevor der goldene Nara Vana verlässt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750104,
					"content": "Du hast eine Viparyas erhalten.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730750105
					]
				},
				{
					"id": 730750105,
					"content": "#Ich schenke dem goldenen Nara eine glückliche Viparyas und hoffe, dass Nara {NICKNAME} und Paimon ebenfalls glücklich sein werden. Diese Viparyas kann zwar nicht verwelken, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750106
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750106,
					"content": "Denkt daran, hin und wieder mit ihr zu sprechen. Am besten wäre es, wenn ihr Musik für sie spielen würdet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750107
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730750107,
					"content": "#Die Erde und die Aranara werden das nicht vergessen. Ich hoffe, dass Nara {NICKNAME} und Paimon das ebenfalls nicht vergessen werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
