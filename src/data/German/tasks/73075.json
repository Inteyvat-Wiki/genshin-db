			"dialogs": [
				{
					"id": 730750201,
					"content": "#Mit Nara {NICKNAME} das Utsava-Fest zu feiern, erinnert mich an das Utsava-Fest, als Nara Varuna zusammen mit Aranara feierte. Ich war lange nicht mehr so glücklich. *schluchz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750202
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750202,
					"content": "Viparyas mögen keine „Tränen“, das Utsava-Fest ist ein Tag des Frohsinns. Aranakula soll ein fröhliches Lied für Viparyas spielen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakara"
