			"dialogs": [
				{
					"id": 401290101,
					"content": "Geht es deinem Kind schon besser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290102
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290102,
					"content": "Danke für deine Fürsorge, sein Zustand ist jetzt einigermaßen stabil. Unser Hausarzt hat gesagt, dass wir versuchen können, mit ihm draußen etwas zu entspannen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290103
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290103,
					"content": "Frau Zuria! Fréminet! Wir sind hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290104,
					"content": "Hehe, anscheinend sind alle da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290105
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290105,
					"content": "Aber fehlt nicht einer? Hehe, Paimon kann sich schon denken, wo er steckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290106,
					"content": "Hallo ... „Thelxie“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290107,
					"content": "-.. -... . -- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290108
					],
					"speakerTitle": "„Thelxie“"
				},
				{
					"id": 401290108,
					"content": "Ui! „Thelxie“ hat jetzt ein Schwert und einen Schild! Wie hübsch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290109,
					"content": "Mit Waffen sieht „Thelxie“ besonders beeindruckend aus. Herrn Fréminets Handwerkskünste sind echt beeindruckend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290110
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290110,
					"content": "Wir haben auch unseren Anteil daran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290111,
					"content": "#Ja, {NICKNAME} hat ein gutes Auge, die Materialien sind wirklich hochwertig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290112
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290112,
					"content": "#Ach ja, Frau Zuria hat mir gesagt, dass sie nach den überstandenen Gefahren gern eine Krönungszeremonie als Abschluss abhalten möchte. {NICKNAME}, deswegen möchte ich dich fragen ... Könntest du auch Material für die Krone beschaffen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290113
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290113,
					"content": "Halte einfach ein Auge offen, wenn du wieder unterwegs bist. Ich wollte mich eigentlich selbst darum kümmern, aber jetzt denke ich, dass du etwas Edleres finden kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290114
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290114,
					"content": "Das mach ich doch glatt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290115
					]
				},
				{
					"id": 401290115,
					"content": "Es scheint alles erledigt zu sein, wollen wir aufbrechen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290116,
					"content": "Bitte warte noch, ich dachte mir gerade, wir könnten vielleicht eine neue Seite im Bilderbuch anlegen, jetzt, da „Thelxie“ einen ganz neuen Stil hat. Was denkt ihr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290117
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290117,
					"content": "Wah! Da freut sich Paimon drauf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290118,
					"content": "Was sollen wir malen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290119
					]
				},
				{
					"id": 401290119,
					"content": "... Einfach das Original auf den neusten Stand bringen? Zumindest sollte das Bild nicht wieder so traurig aussehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290120
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290120,
					"content": "Die schlechten Teile entfernen und durch schönere ersetzen? Das hört sich doch gut an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290121,
					"content": "Dann lasst mich das machen, ich bin zwar keine sonderlich gute Malerin, aber ich habe während meiner Arbeit schon viele Kunstwerke bewundert. Was den Inhalt angeht, überlasse ich es euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290122
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290122,
					"content": "Mal überlegen ... Zuerst kannst du die Waffe und den Schild malen. Der Prinz hat das Schwert der Tapferkeit und den Schild der Entschlossenheit aufgenommen, was zeigt, dass er aus dem Abgrund emporgestiegen ist und beschlossen hat, gegen die Finsternis zu kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290123
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290123,
					"content": "Gut, dann male ich die Waffe und den Schild ... Was noch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290124
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290124,
					"content": "Paimon findet, die Gefährten sollten mit darauf! Dieses Mal hatte „Thelxie“ verlässliche Gefährten an seiner Seite und musste nicht alleine kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290125,
					"content": "Gut, dann male ich die Gefährten ... Was noch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290126
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290126,
					"content": "Farben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290127
					]
				},
				{
					"id": 401290127,
					"content": "Farben ... Farben, ja! Farben sind sehr wichtig, dann erscheint der weitere Weg nicht mehr so verzweifelt grau, sondern schön bunt und voller Hoffnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290128
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290128,
					"content": "Ich hätte nicht erwartet ... dass es so ein anspornendes Bild würde ... Großartig, ihr habt tolle Einfälle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290129
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290129,
					"content": "Wirklich toll, alle sehen so voller Tatendrang aus, ganz besonders „Thelxie“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290130,
					"content": "Mein Kind, hast du dir das angeschaut? Das ermutigt dich doch bestimmt auch, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290131
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290131,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290132
					],
					"speakerTitle": "„Thelxie“"
				},
				{
					"id": 401290132,
					"content": "Ganz bestimmt, Frau Zuria. Und das ist erst die erste Seite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290133
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290133,
					"content": "Ganz genau, Paimon kann es gar nicht mehr erwarten, das fertige Bilderbuch zu sehen. Wir müssen es schnellstmöglich und mit aufrichtigstem Herzen vollenden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290134,
					"content": "Genau! Ich freue mich auch schon darauf. Lasst uns keine Zeit mehr verlieren. Lasst uns loslegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290135
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290135,
					"content": "Jawoll! Lasst „Thelxies fantastische Abenteuer“ beginnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4012906,
			"completionStepIds": [
				4012906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
