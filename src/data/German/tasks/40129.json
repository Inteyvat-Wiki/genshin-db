			},
			"dialogs": [
				{
					"id": 401290901,
					"content": "Ist das die Unterwasserruine, die Fréminet entdeckt hat? Sie ist zwar schon einigermaßen spektakulär, aber doch anders, als Paimon sie sich vorgestellt hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290902,
					"content": "Das ist keine Unterwasserruine, das ist das Reich der Wasser-Unholde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290903
					]
				},
				{
					"id": 401290903,
					"content": "Klar, Paimon meint ... Paimon dachte, es gäbe eine Märchenwelt zu sehen, so mit bunten Monsterhäusern und einer Regenbogenbrücke ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290904,
					"content": "Tut mir leid ... Ich wollte sie tatsächlich dekorieren, aber aus Gründen der Arbeitskraft und der Zeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290905
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290905,
					"content": "Kein Problem, jetzt ist die Fantasie gefragt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290906
					]
				},
				{
					"id": 401290906,
					"content": "#Aber Hallo! {NICKNAME}, du steckst plötzlich so tief in dem Szenario.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290907,
					"content": "#Das zeigt, dass {NICKNAME} die Quintessenz erfasst hat. Du solltest auch dein Bestes geben, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290908
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290908,
					"content": "Hm, unterschätze Paimon nicht, Paimon wird euch das Spiel nicht verderben. Paimon tritt jetzt ... in den Paimon-Fantasie-Modus ein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290909,
					"content": "*räusper* ... Junge Krieger! Vor euch schwebt die Schutzgöttin dieses Ortes, was führt euch hierher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290910,
					"content": "Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290911
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290911,
					"content": "Große Göttin, wir sind die Gefährten von Prinz Thelxie. Wir sind hier, um ihm zu helfen, seine verlorene Pracht wiederzugewinnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290912
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290912,
					"content": "Oh ... Pracht wiedergewinnen! Die Göttin hat hier eine goldene Pracht, eine silberne Pracht und eine bronzene Pracht. Welche hat der Prinz denn verloren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290913,
					"content": "Hä?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290914
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290914,
					"content": "Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290915
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290915,
					"content": "Ist das eine Improvisation?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290916
					]
				},
				{
					"id": 401290916,
					"content": "Niemals! Das ist der Test der Göttin! Die Göttin hat euch bereits getestet und ihr tragt keinerlei Gier in euren Herzen, ihr seid wirklich respektable Krieger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290917,
					"content": "Nehmt daher bitte die Belohnungen der Göttin entgegen, es sind die goldene Pracht, die silberne Pracht und die bronzene Pracht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290918,
					"content": "Und für den Prinzen hat die Göttin zusätzlich eine farbenprächtige Pracht, möge dir eine strahlende Zukunft beschieden sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290919,
					"content": "-.. -... . -- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290920
					],
					"speakerTitle": "„Thelxie“"
				},
				{
					"id": 401290920,
					"content": "Vielen Dank für den Segen, große Göttin, ich spüre, wie mein ganzer Körper jetzt voller Kraft strotzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290921
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290921,
					"content": "Ich ... spüre es auch ... Oh ... Ist das etwa das legendäre Inspirationsmantra der Göttin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290922
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290922,
					"content": "Die Göttin Paimon ist wirklich großartig!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290923
					]
				},
				{
					"id": 401290923,
					"content": "Hihi, ihr Krieger, zieht jetzt los und besiegt die Monster, die das Königreich besetzt haben! Ihr werdet an diesem Ort ganz sicher finden, was ihr sucht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
