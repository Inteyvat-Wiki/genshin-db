			"dialogs": [
				{
					"id": 401290601,
					"content": "Puh ... Endlich geschafft. Können wir jetzt also sagen, dass wir die bösen Monster besiegt und bei dieser Gelegenheit das Reich der Wasser-Unholde zurückerobert haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290602,
					"content": "So ist es, jetzt sind wir hier. Eigentlich sollten wir ja hier die Krönungszeremonie für „Thelxie“ abhalten, nur ... Ich dachte, es sei unmöglich, in einem Ritt ins tiefste Innere vorstoßen zu können, aber es war einfacher als gedacht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290603
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290603,
					"content": "Das war meine Schuld, ich hätte Herrn Fréminet früher sagen sollen, dass wir noch eine Krone brauchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290604
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290604,
					"content": "#Das liegt alles daran, dass {NICKNAME} und die Göttin Paimon zu stark waren! Wir haben einfach alle Monster auf einen Schlag ausgerottet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290605,
					"content": "Schon gut, Frau Zuria. Wenn die Krone erst einmal fertig ist, kommen wir einfach wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290606
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290606,
					"content": "Ihr alle habt wirklich ganze Arbeit geleistet. Und „Thelxie“, mein Kind, du warst auch spitze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290607
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290607,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290608
					],
					"speakerTitle": "„Thelxie“"
				},
				{
					"id": 401290608,
					"content": "Wer hätte gedacht, dass „Thelxie“ auch so gut kämpfen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290609,
					"content": "Er ist fast ein echter Prinz, ich glaube ... Es gibt nichts, was ihn aufhalten könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290610
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290610,
					"content": "Herr Fréminet ... Ja! Daran glaube ich auch fest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290611
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290611,
					"content": "#Lasst uns erst einmal zurück zum Lager gehen. Ich habe früher {NICKNAME} gebeten, unterwegs nach Materialien zu suchen, weil ich die Krone so schnell wie möglich herstellen möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290612
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290612,
					"content": "Jetzt ist genau die richtige Zeit, um zurückzugehen und unsere Reise aufzumalen, wie wir das Reich der Wasser-Unholde zurückerobert haben. Und „Thelxies fantastische Abenteuer“ können wir auch auf den neuesten Stand bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4012908,
			"completionStepIds": [
				4012908
			],
