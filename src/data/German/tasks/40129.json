			},
			"dialogs": [
				{
					"id": 401290801,
					"content": "Frau Zuria, Fréminet, wollen wir zuerst malen? Paimon würde zuerst lieber die neuen Bilder sehen als die Krone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290802,
					"content": "Du willst nur sehen, wie jemand die Göttin Paimon zeichnet ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290803
					]
				},
				{
					"id": 401290803,
					"content": "Herrje! Es reicht ja, wenn du es weißt, das musst du doch nicht groß herausposaunen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290804,
					"content": "Haha, na gut, ich verstehe. Also, die heutige Geschichte sollte so gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290805
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290805,
					"content": "Nachdem der Prinz unzählige Widrigkeiten und Gefahren durchstanden hatte, erreichten er und seine Krieger schließlich den Eingang zum Reich der Wasser-Unholde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290806
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290806,
					"content": "In diesem Moment enthüllte die kleine Elfe Paimon ihren Kameraden ihre wahre Identität ... Eine heimliche Göttin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290807
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290807,
					"content": "Juhu! Die Göttin erschien! Die Göttin lobpries die Aufrichtigkeit der Krieger und spendete ihnen zur Belohnung ganz viel Segen. Und dann versprach sie dem Prinzen sogar, dass er sein Ziel erreichen wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290808,
					"content": "Erfüllt vom Glanz der Göttin, drangen der Prinz und seine Krieger in den Monsterhort ein, vertrieben die Monster und retteten die niedlichen Wasser-Unholde. Der Prinz hatte endlich sein Königreich wieder, aber die Krone ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290809
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290809,
					"content": "Oh nein, die Krone ist noch nicht fertig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290810,
					"content": "Nein ... Die Krone war dort. Die fliehenden Monster hatten sie unbemerkt mitgenommen. Das Böse hatte noch nicht aufgegeben. Aber der Prinz wird sich die Krone schon bald zurückholen und ein strahlender Regenbogen wird wieder über dem Königreich erstrahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290811
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290811,
					"content": "Hm ... Diese Erklärung ... wirkt sehr authentisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290812,
					"content": "Ui, das ist wundervoll ... Frau Zuria hat das sehr gut gemalt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290813,
					"content": "Danke. Damit ist die zweite Seite des Bilderbuchs auch fertig. Das Ende von „Thelxies“ Abenteuer rückt immer näher, bald wird er zum König gekrönt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290814
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290814,
					"content": "Und mein Kind ... Du wirst auch in der Lage sein, dich zu erheitern, wenn diese Zeit kommt, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290815
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290815,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290816
					],
					"speakerTitle": "„Thelxie“"
				},
				{
					"id": 401290816,
					"content": "Ganz bestimmt, Frau Zuria! Wer weiß, vielleicht hat der Arzt schon gute Nachrichten für dich, wenn du heute nach Hause kommst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290817,
					"content": "Danke für deine segensreichen Worte, große Göttin. Übrigens, Herr Fréminet, was ist mit der Krone ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290818
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290818,
					"content": "Ein Tag sollte reichen, mach dir keine Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290819
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290819,
					"content": "Ah, dann muss ich dir für deine harte Arbeit danken. Gut, dann treffen wir uns hier in zwei Tagen zu unserem letzten Abenteuer, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290820
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290820,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290821
					]
				},
				{
					"id": 401290821,
					"content": "Also sehen wir uns in zwei Tagen, meine lieben Freunde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290822
					],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290837,
					"content": "♪♫♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zuria Destrée"
				},
				{
					"id": 401290822,
					"content": "Gut, es wird auch Zeit, dass wir uns auf den Weg machen. Du hast noch einiges zu tun, nicht wahr, Fréminet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290823,
					"content": "Nun, ich werde in die Stadt gehen und ein paar Teile für die Basis der Krone kaufen. Ich möchte verschiedene Entwürfe erstellen und dann den geeignetsten auswählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290824,
						401290825
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290824,
					"content": "Fréminet nimmt das wirklich ernst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290826
					]
				},
				{
					"id": 401290825,
					"content": "Fréminet legt sich wirklich ins Zeug.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290826
					]
				},
				{
					"id": 401290826,
					"content": "Wirklich, Paimon wusste vorher nur, dass Fréminet keine Aufträge leichtfertig annimmt, und hätte nicht erwartet, dass du so eifrig sein würdest, wenn du doch einen annimmst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290827,
					"content": "... Vielleicht ... Weil ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290828
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290828,
					"content": "Was ist es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290829,
					"content": "Weil ... Ich hoffe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290830
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290830,
					"content": "He, warum denn so zögerlich, was machst du denn für ein Gesicht? Du wirst rot ... und es sieht so aus, als würdest du gleich weglaufen und deinen Helm wieder aufsetzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290831
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290831,
					"content": "Oh! Bin ich rot geworden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290832
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290832,
					"content": "Bring Fréminet doch nicht in Verlegenheit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290833
					]
				},
				{
					"id": 401290833,
					"content": "Hehe, na gut. Fréminet, dann wollen wir dich heute nicht mehr bei deiner Arbeit stören. Wir kommen in zwei Tagen wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290834
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290834,
					"content": "... Danke ... Gut ... Bis in zwei Tagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290835
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 401290835,
					"content": "Wir sehen uns in zwei Tagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290836
					]
				},
				{
					"id": 401290836,
					"content": "... Ich hoffe, dass alle Menschen, die in Schwierigkeiten geraten, etwas Schönes erleben werden, ein Wunder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fréminet"
				}
			]
		},
