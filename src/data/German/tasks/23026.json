			"dialogs": [
				{
					"id": 230260401,
					"content": "Schau mal nach oben. Kannst du den großen Baum sehen, der die Akademie trägt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260402
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260402,
					"content": "Meine nächste Fragen sind kinderleicht. Aber viele Leute scheinen das tatsächlich nicht zu wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260403
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260403,
					"content": "Also, hier ist die Frage. Wie lautet der Name des Baums, der die Akademie trägt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260404,
						230260406,
						230260408
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260404,
					"content": "Großer Baum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260405
					]
				},
				{
					"id": 230260405,
					"content": "Hahah, ein sehr prägnanter Name, aber leider ist die Antwort falsch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260406,
					"content": "Heiliger Baum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260407
					]
				},
				{
					"id": 230260407,
					"content": "Hahaha, sehr gut, sehr gut! Das ist korrekt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260408,
					"content": "Riesiger Baum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260409
					]
				},
				{
					"id": 230260409,
					"content": "Oha! Der Name klingt sehr eindrucksvoll, doch leider ist die Antwort falsch.",
