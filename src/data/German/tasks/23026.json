			"trigger": {
				"objectNames": [
					"Ziryab",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230260101,
					"content": "Sind diese Fragen etwa zu schwierig ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260102
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260102,
					"content": "#Oh! {F#Reisende}{M#Reisender}, bitte warte einen Moment.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260103
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260103,
					"content": "Hast du nach mir gerufen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260104
					]
				},
				{
					"id": 230260104,
					"content": "Ja! Hahaha, ich habe mir erlaubt, dich kurz anzuhalten, weil ich dich um einen Gefallen bitten will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260105,
						230260106,
						230260107
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260105,
					"content": "Hast du etwas verloren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260108,
					"content": "Äh? Du ... Du klingst ziemlich gewöhnt daran, diese Art von Fragen zu stellen. Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260109
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260109,
					"content": "Aber nein, ich habe nichts verloren und mir fehlt es auch nicht an Forschungsmaterialien. Was die Inspiration betrifft ... Davon habe ich auch ohne Hilfe schon ausreichend viel gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260110
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260110,
					"content": "Also, äh, es ist so, ich kompiliere derzeit ein Buch mit dem Titel „Fragen und Antworten“, um neuen Studenten dabei zu helfen, rasch die verschiedenen Fachbegriffe zu lernen, die in Sumeru in Umlauf sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260111
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260111,
					"content": "Vereinfacht ausgedrückt geht es dabei darum, komplizierte Fachausdrücke in einem Frage-und-Antwort-Format zu erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260112
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260112,
					"content": "Dadurch wird das Lernen nicht nur effizient, sondern auch interessant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260113
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260113,
					"content": "Allerdings bin ich mir über den Schwierigkeitsgrad dieser Fragen nicht sicher ... Deshalb dachte ich, ich könnte deine Hilfe gebrauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260114,
						230260116
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260114,
					"content": "Ich kenne mich mit der Akademie nicht allzu gut aus ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260115
					]
				},
				{
					"id": 230260115,
					"content": "Hahah, kein Problem. Nachdem du meine Fragen beantwortet hast, wirst du schon gleich etwas mehr über sie wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260119,
					"content": "Keine Sorge. Diese Fragen sind nicht allzu schwer. Es handelt sich einfach nur um ... Standardwissen, das jedem bekannt sein sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260120
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260120,
					"content": "Dann wollen wir gleich mal loslegen. Hier ist die Frage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260116,
					"content": "Wieso kommt es mir so vor, als hätte ich so etwas schon einmal gemacht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260117
					]
				},
				{
					"id": 230260117,
					"content": "Du meinst doch sicher die Fragen, die dir Swan damals in Mondstadt gestellt hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230260118,
					"content": "Doch damals hat uns Swan die Antworten im Voraus gegeben. Dieser Gelehrte ... scheint das wohl nicht vorzuhaben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230260106,
					"content": "Fehlt dir Material?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260107,
					"content": "Suchst du nach Inspiration?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				}
			]
		},
		{
