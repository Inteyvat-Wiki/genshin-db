				"points": []
			},
			"dialogs": [
				{
					"id": 230260301,
					"content": "Du bist möglicherweise bereits auf „reisende Gelehrte“ getroffen, die sich selbst „Driyosh“ genannt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260302
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260302,
					"content": "Tatsächlich ist es so, dass ein bestimmtes Institut der Akademie eine große Zahl von „Driyosh“ besitzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260303
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260303,
					"content": "Mit den Elementen als Kernstück ihrer Theorien untersucht dieses Institut verschiedene Arten von Phänomenen, die mit den Elementarkräften in engem Zusammenhang stehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260304
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260304,
					"content": "Und nun zu meiner Frage, wie lautet der Name dieses Instituts?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260305,
						230260307,
						230260309
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260305,
					"content": "Das Spantamad-Institut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260306
					]
				},
				{
					"id": 230260306,
					"content": "Richtig, es ist das Spantamad-Institut, dessen Gelehrten von der Schule der „Stoffkunde“ in den Sieben Elementen die Essenz aller Materie und allen Lebens sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260307,
					"content": "Das Haravatat-Institut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260308
					]
				},
				{
					"id": 230260308,
					"content": "Haha, du irrst dich. Die Gelehrten von der Schule der „Redelehre“ des „Haravatat-Instituts“ konzentrieren sich auf Linguistik, Semiotik und Logik ... Glaub mir, das Ganze ist äußerst kompliziert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260309,
					"content": "Das Rtawahist-Institut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260310
					]
				},
				{
					"id": 230260310,
					"content": "Oh, das ist leider falsch. Die Gelehrten von der Schule der „Himmelskunde“ des „Rtawahist-Instituts“ konzentrieren sich auf die Erforschung des Sternenhimmels ... Hehe, das klingt ziemlich interessant, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				}
			]
		},
		{
			"id": 2302604,
