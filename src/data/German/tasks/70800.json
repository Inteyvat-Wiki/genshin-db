				"objectNames": [
					"Brook"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708001501,
					"content": "Oh, du bist zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001502
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001502,
					"content": "Zurück mit dem Fleisch, ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001503
					]
				},
				{
					"id": 708001503,
					"content": "Oh, prima! Moment ... was ist mit Schuster? Steckt er etwa Gefahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001504
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001504,
					"content": "Nein, es geht ihm gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001505
					]
				},
				{
					"id": 708001505,
					"content": "Oh, gut, dass nichts Schlimmes passiert ist. Sobald dieses Gericht fertig ist, bringe ich ihm ebenfalls eine Portion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001506
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001506,
					"content": "Apropos, dieses kalte Gourmetfleisch unterscheidet sich stark von normalem. Das könnte meinem Gericht das gewisse Etwas verleihen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001507
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001507,
					"content": "Doch um den „Geschmack des Windes“ zu präsentieren, sind gleichwohl Löwenzahnsamen vonnöten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001508
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001508,
					"content": "Doch auch damit würde es sich kaum von einem gewöhnlichen Fleischgericht unterscheiden. Ein entscheidendes Gewürz fehlt noch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001509
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001509,
					"content": "Oh, richtig! Das ist es! Seit unserem Wettkampf bin ich Xiangling einige Male begegnet. Sie erwähnte ein Gericht namens Schleim-Pilzragout.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001510
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001510,
					"content": "So ungewöhnliche Zutaten habe ich noch nie verwendet ... Doch ein aufregendes Gericht erfordert aufregende Zutaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001511
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001511,
					"content": "#{F#Reisende}{M#Reisender}, dürfte ich dich wieder behelligen? Könntest du mir Schleimabsonderung und Löwenzahnsamen besorgen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001512
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001512,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001513
					]
				},
				{
					"id": 708001513,
					"content": "Super, ich zähle auf dich. Ich feile in der Zwischenzeit weiter an meinem Rezept.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
