				"objectNames": [
					"Brook"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708001001,
					"content": "Was ist los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001002
					]
				},
				{
					"id": 708001002,
					"content": "Du ... oh, ich kenne dich. Du hast Xiangling unterstützt, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001003
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001003,
					"content": "Unser kulinarisches Duell ist mir noch frisch in Erinnerung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001004
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001004,
					"content": "Beim letzten Mal habe ich gegen sie verloren, doch jetzt geht es mir um ein Gericht, das den „Geschmack des Windes“ präsentiert. Das wird als meine Revanche dienen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001005
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001005,
					"content": "Ich habe extra einen Abenteurer damit beauftragt, mir vom Drachengrat gefrorenes Fleisch zu besorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001006
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001006,
					"content": "Doch dieser Abenteurer – er heißt Schuster – ist noch nicht zurück ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001007
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001007,
					"content": "Der Drachengrat soll ein sehr gefährlicher Ort sein. Ob er wohl in Schwierigkeiten steckt ... Würdest du für mich nach ihm sehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001008
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708001008,
					"content": "Das kann ich tun, kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001009
					]
				},
				{
					"id": 708001009,
					"content": "Danke für deine Hilfsbereitschaft. Entzünde einige Feuer, um warm zu bleiben. Auf dem Drachengrat soll es äußerst kalt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
		{
