			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brook"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000201,
					"content": "Stimmt etwas nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000202
					]
				},
				{
					"id": 708000202,
					"content": "Ich kreiere ein zum Windblumenfest passendes Gericht, um den „Geschmack des Windes“ einzufangen. Momentan bereite ich die nötigen Zutaten vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000203
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000203,
					"content": "Ich habe Allan damit beauftragt, für mich in der Glanzkronschlucht zu jagen, um frisches Fleisch zu bekommen, doch er ist immer noch nicht zurück ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000204
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000204,
					"content": "Langsam verderben mir die Zutaten. Würdest du in die Glanzkronschlucht gehen, um zu sehen, wo er bleibt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000205
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000205,
					"content": "Werde ich machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000206
					]
				},
				{
					"id": 708000206,
					"content": "Danke! Sobald du zurückkehrst, kannst du mein neues Gericht probieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
		{
			"id": 7080006,
			"completionStepIds": [
				7080006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7080006",
							"2"
						],
						"stepId": 7080006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Allan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000601,
					"content": "Du ... hast mich gerettet. Vielen, vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000602,
					"content": "Ich hätte nie gedacht, dass die Jagd auf ein Waldschein so gefährlich wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000603,
					"content": "Wegen Brooks Zutaten ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000604
					]
				},
				{
					"id": 708000604,
					"content": "Oh, Brook schickt dich? Nun, ich habe das frische rohe Fleisch, nach dem sie sucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000605
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000605,
					"content": "Doch bei der Wildschweinjagd habe ich unachtsamerweise Monster aufgescheucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000606
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000606,
					"content": "Ich hatte, wonach ich suchte, doch dann umzingelten mich die Monster ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000607
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000607,
					"content": "#Würdest du Brook dieses Fleisch bringen, {F#Reisende}{M#Reisender}? Ich muss zurück in die Stadt, meine Wunden in der Kathedrale behandeln lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000608
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 708000608,
					"content": "*seufz* Ah, Draff wird mir wieder in den Ohren liegen, ich weiß es ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
		{
			"id": 7080007,
			"completionStepIds": [
				7080007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7080007",
							"2"
						],
						"stepId": 7080007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brook"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000701,
					"content": "Ah, du bist zurück. Hast du das rohe Fleisch dabei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000702
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000702,
					"content": "Ja, hier ist es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000703
					]
				},
				{
					"id": 708000703,
					"content": "Hmm, mal sehen ... Scheint tatsächlich frisch zu sein. Das sollte reichen. Dieses Fleisch ist meine Hauptzutat ... Nun fehlt nur noch ein Gewürz, das den „Geschmack des Windes“ zum Vorschein bringt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000704
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000704,
					"content": "Und damit ... können eigentlich nur „Löwenzahnsamen“ gemeint sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000705
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000705,
					"content": "#Würdest du mir Löwenzahnsamen bringen, {F#Reisende}{M#Reisender}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000706
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000706,
					"content": "Klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000707
					]
				},
				{
					"id": 708000707,
					"content": "Super! Ich zähle auf dich. In der Zwischenzeit bereite ich dieses Fleisch vor. Bring die Löwenzahnsamen sofort zu mir, sobald du sie hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
		{
			"id": 7080008,
