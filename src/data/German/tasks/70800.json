							"7080009",
							"2"
						],
						"stepId": 7080009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Brook"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000901,
					"content": "Danke. Jetzt ist alles bereit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000902
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000902,
					"content": "Ach ja, das hier ist für dich. Betrachte es als Dankeschön für deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000903
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000903,
					"content": "Doch wie sollen wir dieses Gericht zubereiten, damit es den „Geschmack des Windes“ präsentiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000904
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 708000904,
					"content": "Kochen, Braten ... Hmm, nein, vielleicht sollte das ursprüngliche Aroma der Zutaten im Vordergrund stehen, bevor ich das fertige Gericht mit den Löwenzahnsamen garniere ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Brook"
				}
			]
		},
		{
