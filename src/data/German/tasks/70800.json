				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708001101,
					"content": "K... Kalt ... Warum ist es s... so kalt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001102
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 708001102,
					"content": "K... Kann jemand ... Kann jemand Feuer machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ängstlicher Schuster"
				}
			]
		},
		{
			"id": 7080013,
			"completionStepIds": [
				7080013
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7080013",
							"2"
						],
						"stepId": 7080013,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ängstlicher Schuster"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708001301,
					"content": "I... Ich bin gerettet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001302
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 708001302,
					"content": "#H... Hast du das Feuer entzündet? D... Danke, {F#gütige Reisende}{M#gütiger Reisender} ... Vielen Dank ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001303
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 708001303,
					"content": "Ist alles in Ordnung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001304
					]
				},
				{
					"id": 708001304,
					"content": "Jetzt ist mir ein wenig wärmer. Das wird schon ... Ursprünglich hatte ich den Auftrag, kaltes Gourmetfleisch zu besorgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001305
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 708001305,
					"content": "Zuerst suchte ich an den Ausläufern des Drachengrats, doch dann verlor ich meinen Zunder. Wenig später verirrte ich mich auch noch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001306
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 708001306,
					"content": "Ohne dich wäre ich wohl verloren gewesen. Ich stehe in deiner Schuld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001307
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 708001307,
					"content": "Und wie sieht es mit Brooks Mission aus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001308
					]
				},
				{
					"id": 708001308,
					"content": "Ah, Brook hat dich also geschickt ... *seufz* Mittlerweile fragt sie sich bestimmt, wo ich geblieben bin. Doch mir fehlt die Kraft, um ihr dieses Fleisch zu überbringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001309
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 708001309,
					"content": "#Bitte verzeih mir, {F#Reisende}{M#Reisender}, aber würdest du ihr dieses Fleisch von mir geben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001310
					],
					"speakerTitle": "Ängstlicher Schuster"
				},
				{
					"id": 708001310,
					"content": "Du kannst auf mich zählen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001311
					]
				},
				{
					"id": 708001311,
					"content": "Herzlichen Dank. Ich werde hinab zum Lager im Vorgebirge steigen, um mir eine Schüssel heiße Suppe zu kochen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ängstlicher Schuster"
				}
			]
		},
		{
			"id": 7080015,
			"completionStepIds": [
				7080015
