					"Linyang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726640101,
					"content": "Hmm ... Ich muss noch mehr Schatztruhen aufstellen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640102
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640102,
					"content": "Habe ich da „Schatztruhen“ gehört?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640103
					]
				},
				{
					"id": 726640103,
					"content": "#Ha?! Oh ... du bist es, {F#Reisende}{M#Reisender}! Bist du hier, um am Vollmondtanz teilzunehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640104
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640104,
					"content": "Das kann man so sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640105
					]
				},
				{
					"id": 726640105,
					"content": "Dann bist du genau zur richtigen Zeit gekommen! Die Abenteurergilde ist gerade dabei, eine Veranstaltung zu organisieren, um das Fest zu ehren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640106
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640106,
					"content": "Würdest du gerne mehr darüber erfahren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640107,
						726640108
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640107,
					"content": "Über was für Aktivitäten sprechen wir hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640110
					]
				},
				{
					"id": 726640110,
					"content": "Während des Vollmondtanzes hat die Gilde an verschiedenen Orten Mondjagd-Amulette verteilt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640111
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640111,
					"content": "Wenn man diese Amulette findet und sie uns zurückbringt, kann man sie gegen Belohnungen eintauschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640112
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640112,
					"content": "Wir haben auch eine Truppe Abenteurer losgeschickt, um einen Haufen besonderer Schatzkisten in der Wildnis zu verteilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640113
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640113,
					"content": "In diesen Schatzkisten stecken alle möglichen tollen Sachen, die wir speziell für diesen Anlass vorbereitet haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640114
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640114,
					"content": "Ansonsten haben wir noch einige knallharte Herausforderungen für Elite-Abenteurer auf Lager!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640115
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640115,
					"content": "Was die Details dazu angeht ... Na ja, die Herausforderungen beinhalten das Einfallen in verschiedene Monsterlager ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640116,
						726640117
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640116,
					"content": "Und was hat das mit dem Tanz zu tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640118,
					"content": "Aha ... Ahahaha ... Ich meine, äh, du musst das ja nicht so formulieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640119
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640119,
					"content": "Für das Besiegen der Monster gibt es Preise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640120
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640120,
					"content": "Komm schon, das sind doch nichts anderes als ganz normale Missionen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640121
					]
				},
				{
					"id": 726640121,
					"content": "Bitte, hilf uns! Die meisten unserer Abenteurer amüsieren sich beim Tanz und viele Missionen sammeln hier Staub und niemand kümmert sich darum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640122
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640122,
					"content": "Geh uns doch zur Hand! Mit deinen Fähigkeiten ist das doch ein Kinderspiel, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640123,
						726640124
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640123,
					"content": "Na gut ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640125,
					"content": "#O... Oh, aber natürlich wirst du dafür entlohnt, {F#Reisende}{M#Reisender}, keine Sorge!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640126
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640126,
					"content": "Ich werde während des Vollmondtanzes hier sein. Falls du Fragen hast, frag mich einfach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640127
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640127,
					"content": "#Wir zählen auf dich, {F#Reisende}{M#Reisender}. Nun denn ... genieße das Fest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640124,
					"content": "Ihr haltet besser meinen Lohn bereit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640117,
					"content": "Das hat überhaupt nichts mit dem Vollmondtanz zu tun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640108,
					"content": "Oh nein, nicht wieder diese Alltäglichen. Alles nur das nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640109
					]
				},
				{
					"id": 726640109,
					"content": "Nein, nein! Diese Aktivität ist total abenteuerlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640110
					],
					"speakerTitle": "Linyang"
				}
			]
		}
	]
}