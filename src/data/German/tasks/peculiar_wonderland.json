			"dialogs": [
				{
					"id": 706560101,
					"content": "Willkommen! Möchtest du dich in die vor dir liegende Sphäre wagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560102,
						706560103
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560102,
					"content": "Da kann ich schlecht ablehnen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				},
				{
					"id": 706560104,
					"content": "Dann bist du bei mir richtig. Ich bin Plauen von der Abenteurergilde, ich bewache den Eingang zu dieser Sphäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560105
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560105,
					"content": "Den Aufzeichnungen der Abenteurergilde zufolge erscheint sie nur zu bestimmten Zeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560106
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560106,
					"content": "Da gerade das Windblumenfest im Gang ist, haben wir ihr Inneres so angepasst, dass es eine besondere Herausforderung darstellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560107
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560107,
					"content": "Ist das nicht gefährlich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560108
					]
				},
				{
					"id": 706560108,
					"content": "Keine Sorge. Diese Aktivität gibt es nur im Rahmen des Festes. Gestandene Abenteurer begleiten jeden, der nicht erfahren genug ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560109
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560109,
					"content": "Als Veteran bist du auf diese Hilfe aber bestimmt nicht angewiesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560110
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560110,
					"content": "Du kannst diese Sphäre alleine erkunden oder Freunde dazu einladen. So oder so erwartet dich am Ende eine Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706560111,
						706560112
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560111,
					"content": "Wird gemacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560113,
					"content": "Dann halte ich dich nicht länger auf. Viel Spaß da drin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Plauen"
				},
				{
					"id": 706560112,
					"content": "Wird gemacht. Her mit der Belohnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560113
					]
				},
				{
					"id": 706560103,
					"content": "Scheint eine besondere Sphäre zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706560104
					]
				}
			]
		}
	]
