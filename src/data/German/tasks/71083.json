					"Muning"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710830201,
					"content": "Wie sieht es da unten aus? Bist du einer Gefahr begegnet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830202,
						710830210
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830202,
					"content": "(Ihr erzählt Muning davon.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830203
					]
				},
				{
					"id": 710830203,
					"content": "So sieht es also aus und es klingt ziemlich gefährlich. Jinwu und Zhiqiong, ich verlasse mich darauf, dass du dich um sie kümmerst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830204
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830204,
					"content": "Hättest du mich nicht aufhalten sollen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830205
					]
				},
				{
					"id": 710830205,
					"content": "Natürlich bin ich verpflichtet, dich aufzuhalten, aber du rennst zu schnell, als dass ich dich jedes Mal einholen könnte, also kann ich dich nicht aufhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830206
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830206,
					"content": "Ich bin nicht schnell gerannt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830207
					]
				},
				{
					"id": 710830207,
					"content": "Nein, du bist einfach schnell gerannt, so steht es im Wochenbericht, das ist die Wahrheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830208
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830208,
					"content": "Gut, ich bin schnell gerannt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830209
					]
				},
				{
					"id": 710830209,
					"content": "Also, seid bitte auch vorsichtig mit allem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830210,
					"content": "Alles läuft gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830211
					]
				},
				{
					"id": 710830211,
					"content": "Das ist gut, das ist gut. Solange alles gut läuft, haben die Qixing keinen Grund, mich zu hart zu bestrafen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				}
			]
		}
	]
