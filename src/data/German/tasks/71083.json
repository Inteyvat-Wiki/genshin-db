			"trigger": {
				"objectNames": [
					"Muning"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710830101,
					"content": "Ich wusste nicht, dass ihr die „Qixing-Formation“ gelöst habt. Dann muss ich sie wohl in meinen Wochenbericht aufnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830102,
					"content": "Schreib es etwas schöner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830103
					]
				},
				{
					"id": 710830103,
					"content": "Sei etwas ernsthafter, dies ist eine sehr ernste Angelegenheit. Die „Qixing“ werden über den genauen Grad der Schwere entscheiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830104
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830104,
					"content": "Das heißt, dass jemand der Qixing persönlich hierherkommen könnte, um dich aufzuhalten, sobald die Meldung nach oben geschickt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830105
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830105,
					"content": "Hm, dann kann nicht einmal ich dich mehr beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830106
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830106,
					"content": "(Die Andeutung ist auch zu offensichtlich ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830107
					]
				},
				{
					"id": 710830107,
					"content": "Hm ... Du bist verblüfft, nicht wahr? Na gut, es gibt Leute, die auf dich warten ... Verschwinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				}
			]
		},
		{
			"id": 7108302,
			"completionStepIds": [],
