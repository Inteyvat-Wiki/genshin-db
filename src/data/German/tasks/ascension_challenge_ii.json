				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Prinz“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706670201,
					"content": "#Miau! „Du bist wirklich {F#eine tolle Kartenbeschwörerin}{M#ein toller Kartenbeschwörer}! Herzlichen Glückwunsch zum Bestehen der Aufstiegsprüfung, jetzt bist du {F#eine richtige Kennerin}{M#ein richtiger Kenner}!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670202
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706670202,
					"content": "„Jetzt bist du qualifiziert, gegen noch mehr Kartenbeschwörer anzutreten ... Ach ja, auch wenn du das schon vorher konntest, möchte ich dich doch noch einmal daran erinnern, dass du an der Duell-Einladungstafel Herausforderungen veröffentlichen kannst ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670203
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706670203,
					"content": "Miau ... „So können Kartenbeschwörer, die sich mit dir messen wollen, einfach deine Herausforderung abreißen. Nun, es ist wirklich spannend, wenn man nicht weiß, mit wem man es zu tun bekommt ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670204
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706670204,
					"content": "„Außerdem kann man sich auch am Kartentisch näher kommen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680204
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706680204,
					"content": "#Miau! „Ah! Entschuldige, ich habe es ein wenig übertrieben ... Als {F#Kennerin}{M#Kenner} hast du, {F#liebe}{M#lieber} {NICKNAME}, das besondere Privileg, einige sehr hübsche Karten zu kaufen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670205
					],
					"speakerTitle": "„Prinz“"
				},
				{
					"id": 706670205,
					"content": "#„{NICKNAME}, vergiss niemals, weshalb du angefangen hast, dieses Spiel zu spielen. Ich hoffe, dass du die Freude, ‚Geniale Beschwörung‘ zu spielen, spüren kannst!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Prinz“"
				}
			]
		},
