			"dialogs": [
				{
					"id": 401930301,
					"content": "Boss! Das Mikawa-Blumenfest war ein riesiger Erfolg für uns! Wir hatten dreimal mehr Gäste als üblich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930302
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930302,
					"content": "Wenn ich ansehe, was wir bisher geleistet haben, glaube ich, wir werden ... das hier schaffen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930303
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930303,
					"content": "Das ist großartig! Vielleicht überholen wir diesen Monat sogar das Verlagshaus Yae ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930304
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930304,
					"content": "Oh? Ihr seht ja ganz begeistert aus ... Feiert ihr etwa ohne mich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930305
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930305,
					"content": "Oh, hehe ... aber nein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930306
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930306,
					"content": "Ich habe vergessen, euch die freudige Nachricht zu erzählen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930307
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930307,
					"content": "Dreißig Prozent der Erlöse aus dem Fest wurden an das Verlagshaus Yae überwiesen. Wir rechnen diesen Monat mit einem Rekordgewinn ... Meint ihr nicht, dass Glückwünsche angebracht sind?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930308
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930308,
					"content": "Was!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930309
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 401930309,
					"content": "A... Also, Boss ... Ich schätze, Glückwünsche sind wohl wirklich angebracht ... Wir haben uns zum dreihundertdreiunddreißigsten Mal mit dem Verlagshaus Yae gemessen und unser bisher bestes Ergebnis erzielt: den zweiten Platz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930310
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 401930310,
					"content": "Hehehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930311
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 401930311,
					"content": "... Möge diese Nacht allen süße Träume schenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				}
			]
		},
