				]
			},
			"dialogs": [
				{
					"id": 401930201,
					"content": "Auf Ittos beharrliches Drängen hin macht ihr euch alle erneut auf den Weg zum Badehaus Aisa ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930202
					]
				},
				{
					"id": 401930202,
					"content": "Hahaha! Das hier ist bestimmt die heißeste! Mal sehen, wer es am längsten aushält! Wer macht mit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930203
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930203,
					"content": "Hehe, bei so viel Enthusiasmus fällt es mir schwer, nein zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930204
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 401930204,
					"content": "Hört zu ... Das hier ist doch keine Sauna ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930205
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401930205,
					"content": "Aaah ... so schön warm ... *schnarch*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930206
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 401930206,
					"content": "He, schlaf nicht im Becken ein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401930207,
					"content": "Puh ... Mein Fell ist so schwer. Mir ist ein bisschen schwindlig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930208
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 401930208,
					"content": "Hahaha! Wenn du die Hitze nicht verträgst, Gorou, dann raus aus der ... Wanne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930209,
					"content": "He! Seid doch mal etwas leiser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401930210,
					"content": "Andererseits ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401930211
					]
				},
				{
					"id": 401930211,
					"content": "Hehe, Itto ist genauso energiegeladen wie immer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930212
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930212,
					"content": "Es ist unklug, sich während eines Spiels ablenken zu lassen, Bruder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930213
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401930213,
					"content": "#Boah! Die Spannung steigt! Was planst du als nächsten Schritt, {NICKNAME}? Was denkt ihr beide?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930214
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 401930214,
					"content": "Hm ... Ich würde besonnen bleiben und versuchen, meine Position zu festigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930215
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401930215,
					"content": "Du könntest aber auch aggressiv vorgehen ... Ein Risiko einzugehen, ist keine schlechte Idee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930216,
						401930217
					],
					"speakerTitle": "Shikanoin Heizou"
				},
				{
					"id": 401930216,
					"content": "(Ruhig und besonnen bleiben)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				},
				{
					"id": 401930218,
					"content": "#Oh? Ein schlauer Zug, {NICKNAME}! Eine eindeutige Niederlage ... Ich muss mich geschlagen geben! Laut unserer Auslosung ist der nächste Spieler ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930219
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930219,
					"content": "Ayaka! Habt viel Spaß, ihr zwei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930220
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401930220,
					"content": "#Oh, ähm ... In Ordnung! Nimm etwas Rücksicht auf mich, {NICKNAME} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930221
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 401930221,
					"content": "(Ayato muss absichtlich gegen mich verloren haben, um Ayaka mehr Spielzeit zu verschaffen ... Er führt wirklich immer etwas im Schilde ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 401930217,
					"content": "(Aggressiv vorgehen)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401930218
					]
				}
			]
		},
