				]
			},
			"dialogs": [
				{
					"id": 401930101,
					"content": "Ah, Kumpel! Ein Vögelchen hat mir gezwitschert, dass ihr gestern Abend im Badehaus Aisa wart!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930102
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930102,
					"content": "Ich trommle die Truppe zusammen und wir gehen dahin, um zu feiern! Kommst du mit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930103,
					"content": "Aber wir waren doch gerade erst da ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401930104,
					"content": "Ähm, ja ... Aber ich wette, es haben ein paar Leute gefehlt, oder? Wie Shinobu ... Gorou ... Ayato und so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401930105,
					"content": "Kurz gesagt, der Boss hat von der Reise erfahren und jetzt will er unbedingt mitkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401930106
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401930106,
					"content": "Wie auch immer! Wenn du fertig mit dem Durchsehen bist, komm vorbei und wir machen einen ordentlichen Aufguss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
