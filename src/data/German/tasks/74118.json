							4611.459
						],
						"pointId": 5739
					}
				]
			},
			"dialogs": [
				{
					"id": 741180601,
					"content": "... Vielen Dank, Frau Menthe, kaum warst du da, ist der Kerl aufgestanden und weggegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180602
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180602,
					"content": "Schon in Ordnung. Das gehört zu meinen Aufgaben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180603
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180603,
					"content": "Mein Herr, es sieht so aus, als müssten wir schnell von hier weg und zurück nach Petrichor gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180604
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180604,
					"content": "Ich glaube, diese Leute verlieren langsam die Geduld und könnten ... etwas Aggressives tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180605
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180605,
					"content": "Ich werde gleich darüber Bericht erstatten und wir werden in ein paar Tagen ein Ergebnis haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180606
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180606,
					"content": "Im besten Fall könnten wir ein paar Kollegen schicken, um euch zu beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180607
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180607,
					"content": "Aber wir haben nur eine begrenzte Anzahl von Mitarbeitern und in Anbetracht unserer Pflichten in der Stadt ... können wir euch nur ein kurzes Stück begleiten, aber nicht bis nach Petrichor ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180608
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180608,
					"content": "Und bis dahin solltet ihr euch besser an einem sicheren Ort aufhalten. Die Diskussion darüber kann noch eine Weile andauern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180609,
						741180610
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180609,
					"content": "Ich kann euch unterwegs beschützen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180611
					]
				},
				{
					"id": 741180611,
					"content": "Ich danke dir. Wenn du dabei bist, haben diese Leute sicherlich mehr Angst, Ärger zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180612
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180612,
					"content": "Aber arbeitet Fräulein Kaia nicht gerade bei der Theatertruppe? Wenn ihr nach Petrichor geht, dann ist sie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180613,
					"content": "Hm ... Ich werde mit ihnen zusammen hingehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180614
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180614,
					"content": "Was?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180615
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180615,
					"content": "Fräulein Kaia! Ich bitte dich aus tiefstem Herzen, du musst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180616
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180616,
					"content": "Lieber Lutong, versuch nicht, mich zu überreden. Wie dein Chef kann auch ich nicht von anderen überredet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180617
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180617,
					"content": "A... Aber wir wissen doch nicht, welchen Gefahren wir begegnen werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180618
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180618,
					"content": "Umso mehr Grund für mich, mit euch zu gehen. Willst du, dass ich wie beim letzten Mal mit nichts als einem unfertigen Musikstück abreise?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180619
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180619,
					"content": "Außerdem ist der Direktor meiner Truppe sehr an diesen „maschinell erstellten“ Partituren interessiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180620
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180620,
					"content": "Ich bin mir sicher, er wäre auch sehr dafür, dass ich mit euch reise ... Gut, ich bin fertig. Wohin gehen wir als Nächstes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180621
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180621,
					"content": "W... Wie schon in Sumeru hat Fräulein Kaia Herrn Garcia in der Debatte vollständig besiegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180622,
					"content": "Garcia wird niemals gewinnen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180623
					]
				},
				{
					"id": 741180623,
					"content": "Oder wollte Herr Garcia gar nicht gewinnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180624
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180624,
					"content": "Ähem! Lutong, wir müssen einen geeigneten Ort zum Übernachten finden! Am besten irgendwo, wo mehr Leute sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180625
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180625,
					"content": "Ein Ort mit vielen Leuten ... Wir könnten vielleicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180626
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180626,
					"content": "Wie wäre es, wenn wir in das Hotel gehen, in dem meine Truppe ist? Da sind viele Leute und jeder kennt jeden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180627
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180627,
					"content": "Wenn ein Fremder sich einmischen wollte, würde er sofort entdeckt werden. Außerdem wäre unser Direktor bestimmt daran interessiert, etwas über die Zahlenmaschine zu erfahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180628
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180628,
					"content": "Ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180629
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180629,
					"content": "Das wäre großartig, alle Probleme gelöst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180630
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180630,
					"content": "Alle Probleme?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180631
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180631,
					"content": "#Dann ist ja alles klar. {NICKNAME}, bitte nimm dieses Geld als Vorschuss für die Eskorte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180632
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180632,
					"content": "Auch wenn noch nicht feststeht, wann wir aufbrechen ... so zähle ich doch auf dich, wenn es so weit ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180633
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180633,
					"content": "Aber warum habe ich das Gefühl, dass es jetzt mehr Probleme gibt?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180610,
					"content": "Ich kann mich um die Eskorte kümmern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180611
					]
				}
			]
		},
