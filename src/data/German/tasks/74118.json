			},
			"dialogs": [
				{
					"id": 741185101,
					"content": "... Was ist los mit dir? Du siehst auf einmal so blass aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185102
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741185102,
					"content": "Ich ... Ich bin nur ... Nein, es ist nichts ... Vielleicht ist der Kaffee zu stark ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
