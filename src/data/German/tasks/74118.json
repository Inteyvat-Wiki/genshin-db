			"dialogs": [
				{
					"id": 741180401,
					"content": "... Wie erwartet haben sie immer noch Herrn Garcia verfolgt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180402
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180402,
					"content": "Schau dir den Mann an, der am Tisch an der Theke sitzt und einen Hut vor sich hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180403
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180403,
					"content": "Ich bin mir ziemlich sicher, dass er uns neulich verfolgt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180404,
						741180405
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180404,
					"content": "Ich rufe die Gendarmerie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180406
					]
				},
				{
					"id": 741180406,
					"content": "Eine weise Wahl ... und zufällig steht eine Gendarmin neben uns.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180407
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180407,
					"content": "Wir haben das schon einmal bei Frau Menthe gemeldet und sie weiß genau, in welcher Lage wir sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180408
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180408,
					"content": "Ich bin sicher, dass sie bereit ist, uns zu helfen. Mit einer Gendarmin in der Nähe sollten sie nicht wagen, etwas zu Aggressives zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180409
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180409,
					"content": "#{NICKNAME}, geh bitte zu Frau Menthe und erkläre ihr die Situation. Ich werde zu Herrn Garcia gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180410
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180410,
					"content": "In Ordnung, los geht’s.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180405,
					"content": "Ruf einfach die Gendarmerie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180406
					]
				}
			]
		},
		{
			"id": 7411805,
