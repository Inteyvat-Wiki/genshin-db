						"stepId": 7411803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3508.936,
							459.464,
							3665.876
						],
						"pointId": 5698
					}
				]
			},
			"dialogs": [
				{
					"id": 741180301,
					"content": "... Hier können wir reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180302
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180302,
					"content": "Lasst mich ganz am Anfang beginnen. Seit ihr uns geholfen habt, die Zahlenmaschine in Sumeru zu verbessern, ist die Leistung der Maschine sprunghaft angestiegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180303
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180303,
					"content": "Herr Garcia war sehr ermutigt und wollte die Maschine weiter verbessern. Aber wie er sagte, hat die traditionelle Antriebsstruktur ihre Grenzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180304
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180304,
					"content": "Die Leistung der Zahlenmaschine war nicht mehr zu überbieten, also wollten wir zurück nach Fontaine gehen, um andere Forschungsideen zu entwickeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180305
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180305,
					"content": "Doch als wir wieder in Fontaine ankamen, besuchte plötzlich ein fremder Mann Herrn Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180306,
					"content": "Dieser Mann erklärte Herrn Garcia, er könne seine Forschungen finanzieren und ihm sogar helfen, andere Mitarbeiter zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180307
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180307,
					"content": "Aber im Gegenzug musste Herr Garcia alle Entwurfsideen und Daten für die Zahlenmaschine mit ihm teilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180308,
						741180309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180308,
					"content": "Garcia wäre mit so etwas bestimmt nicht einverstanden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				},
				{
					"id": 741180310,
					"content": "Ja! Es ist doch wie ein Raub, wenn man die Forschung von anderen direkt übernehmen will, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180311,
					"content": "Ja. Deshalb wies Herr Garcia ihn entschieden zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180312
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180312,
					"content": "Aber danach hatte es ständig den Anschein, als würde jemand Herrn Garcia und mich verfolgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180313
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180313,
					"content": "Außerdem war jemand in unser Zimmer eingedrungen, während wir weg waren, und hatte nach etwas gestöbert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180314
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180314,
					"content": "Obwohl der Eindringling alles wieder an seinen Platz gestellt hatte, fand Herr Garcia die Spuren davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180315
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180315,
					"content": "So gruselig ... Wenn man ihm die Sachen nicht geben will, kommt er einfach und nimmt sie sich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180316,
					"content": "Nachdem wir herausgefunden haben, dass in den Raum eingebrochen wurde, haben wir beschlossen, rasch Geld aufzutreiben, um so schnell wie möglich nach Petrichor zurückzukehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180317
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180317,
					"content": "Sobald wir dort sind, werden wir mit den anderen Herren des Klubs der Visionäre Kontakt aufnehmen, um das Problem gemeinsam zu lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180318
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180318,
					"content": "Und die Stadt Petrichor ist sozusagen ... Hehe, sie ist sozusagen die Basis von Herrn Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180319
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180319,
					"content": "Es gibt keinen sichereren Ort für ihn als Petrichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180320
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180320,
					"content": "Heute ist eigentlich unser Abreisetag und wir bereiten uns auf die Abreise nach Petrichor vor. Deshalb wollten wir dich bitten, uns zu begleiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180321
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180321,
					"content": "Ich hatte nicht damit gerechnet, Fräulein Kaia hier zu treffen ... Zur Sicherheit musste ich Herrn Garcia bitten, Fräulein Kaia zuerst in die Stadt zurückzubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180322,
						741180323
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180322,
					"content": "Was kann ich tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180324,
					"content": "Es sieht so aus, als ob die Abreise verschoben werden muss. Bitte geh jetzt schnell zu Herrn Garcia. Wie ich schon sagte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180325
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180325,
					"content": "#Mit {F#einer so angesehenen Freundin}{M#einem so angesehenen Freund} wie dir an unserer Seite sollten wir viele unnötige Probleme vermeiden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180326,
						741180327
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180326,
					"content": "Ich gehe gleich los.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180330
					]
				},
				{
					"id": 741180330,
					"content": "Herr Garcia wird Fräulein Kaia alles darüber erzählen. Was danach zu tun ist ... soll das Fräulein selbst entscheiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180331
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180331,
					"content": "Lass uns jedenfalls schnell zurück in die Stadt gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180327,
					"content": "Sie werden sich nicht wirklich in Gefahr befinden, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180328
					]
				},
				{
					"id": 741180328,
					"content": "Nein. Herr Garcia ist immer noch am Hof von Fontaine, wo viele Garde-Mecha patrouillieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180329
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180329,
					"content": "Wenn sie Gewalt einsetzen wollen, wird die Maison Gardiennage die meisten Angelegenheiten für uns in Ordnung bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180330
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180323,
					"content": "Wie soll ich helfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180309,
					"content": "Das klingt einfach nicht nach einem guten Menschen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				}
			]
		},
		{
