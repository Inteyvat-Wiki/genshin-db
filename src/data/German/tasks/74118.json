				]
			},
			"mark": "TALK_MARK_HIDE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Garcia"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3535.805,
							430.426,
							4553.841
						],
						"pointId": 5693
					}
				]
			},
			"dialogs": [
				{
					"id": 741180101,
					"content": "... Mein Herr, vielleicht sollten wir zuerst in die Stadt Petrichor gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180102,
					"content": "Obwohl weder Herr Xavier noch Herr Félix hier sind, sollten Herr Mécantre und Herr Babisse noch in der Stadt sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180103,
					"content": "Vielleicht können sie dir einen Rat oder Anregungen geben, und selbst im schlimmsten Fall hast du zwei Menschen, bei denen du deine Sorgen ausschütten kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180104,
					"content": "Nein, lieber Lutong, nein ... Die Forschungen von Mécantre und Babisse sind in vollem Gange und erleben gerade eine Hochkonjunktur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180105,
					"content": "In ihrem letzten Brief schrieben sie mir, dass ein kluger Mensch des Forschungsinstituts Fontaine in Petrichor eingetroffen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180106,
					"content": "Ein gewisser Herr Bossuet ist sehr sachkundig und einfühlsam und hat ihnen bei der Lösung vieler Probleme geholfen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180107,
					"content": "Und ich ... *seufz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180108,
						741180109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180108,
					"content": "Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				},
				{
					"id": 741180110,
					"content": "#Ah, {NICKNAME}, schön, dich hier zu treffen. Ich hätte nie gedacht, dass ich dich mal in Fontaine sehen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180111,
					"content": "Und ... der Zeitpunkt deines Besuchs ist wirklich ... passend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180112,
					"content": "#Ja, wirklich aus heiterem Himmel ... Aber es ist dennoch schön, dich hier zu treffen, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180113,
					"content": "Oje, er sieht so müde aus und hat dicke, dunkle Ringe unter seinen Augen ... Er wirkt ziemlich lethargisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180114,
					"content": "Was ist mit dir los, Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180115
					]
				},
				{
					"id": 741180115,
					"content": "Unsere ... ähm, Herrn Garcias Forschung ist auf einige noch nie dagewesene Probleme gestoßen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180116
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180116,
					"content": "Aber das ist eine lange Geschichte ... Wir wollen gerade zur Opéra Épiclèse gehen, um die Abrechnung für sie zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180117,
					"content": "Wenn wir unsere Arbeit beendet haben, können wir uns ein ruhiges Plätzchen suchen und uns unterhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180118
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180118,
					"content": "Habt ihr noch andere Arbeit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180119
					]
				},
				{
					"id": 741180119,
					"content": "Arbeit kann man es nicht wirklich nennen. Wir werden nur angeheuert, um beim Rechnen zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180120,
					"content": "Die Opéra Épiclèse hat in letzter Zeit viele Ensembles beherbergt und es ist dringend notwendig, eine allgemeine Buchhaltung zu führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180121
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180121,
					"content": "Um das Geld für die Rückkehr nach Petrichor aufzutreiben, haben wir ... habe ich im Namen von Herrn Garcia diese Aufgabe übernommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180122
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180122,
					"content": "Welch eine anspruchslose Aufgabe für einen so fähigen Menschen! Die Berechnungen sind so einfach, dass ich sie an einem Nachmittag erledigen kann, ohne die Zahlenmaschine zu benutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180123
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180123,
					"content": "Es ist ein guter Weg, um Geld zu sammeln. Herr Garcia, wir müssen jetzt gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180124
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180124,
					"content": "#Übrigens, {NICKNAME}, darf ich dich bitten, mit uns zu kommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180125
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180125,
					"content": "#Mit {F#einer so angesehenen Freundin}{M#einem so angesehenen Freund} wie dir an unserer Seite sollten wir viele unnötige Probleme vermeiden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180126
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180126,
					"content": "Wir werden dich angemessen bezahlen, also mach dir keine Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180127,
						741180128
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180127,
					"content": "Gerne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180129,
					"content": "Da wäre ich mir nicht so sicher ... Hehe, wie auch immer, lasst uns loslegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180128,
					"content": "In der Stadt sollte nichts passieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180109,
					"content": "Du bist nach Fontaine zurückgekommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				}
			]
		},
		{
			"id": 7411802,
			"completionStepIds": [
				7411802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7411802",
							"2"
						],
						"stepId": 7411802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lutong",
					"Garcia",
					"Kaia"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3490.198,
							461.138,
							3643.4
						],
						"pointId": 5696
					}
				]
			},
			"dialogs": [
				{
					"id": 741180201,
					"content": "Ich muss sagen, das ist ein prächtiges Opernhaus, und es muss eine Menge Geld eingebracht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180202
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180202,
					"content": "Opernhaus ... Na ja, wir sollten uns besser zügig an die Arbeit machen. Und wenn wir hier fertig sind, gehen wir zurück nach Petrichor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180203
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180203,
					"content": "Dann eröffne ich eine Bäckerei in der Stadt und kümmere mich nie wieder um die Zahlenmaschine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180204
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180204,
					"content": "Äh ... mein Herr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180205
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180205,
					"content": "Lutong, was ist los mit dir? Dein Gesichtsausdruck ... Hast du einen Geist gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180206
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180206,
					"content": "Fast so ... wie ein Geist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180207
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180207,
					"content": "Garcia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180208
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180208,
					"content": "Fräulein Kaia?! Warum ist sie hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180209,
					"content": "Was für ein Zufall ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180210
					]
				},
				{
					"id": 741180210,
					"content": "Mein Herr, was du gerade gesagt hast, war ziemlich unangebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180211
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180211,
					"content": "Ach, sei still, Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180212
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180212,
					"content": "#Garcia, wie schön, dich hier zu treffen, und dich auch, {NICKNAME}. Ich nehme an, du bist hier, um dem Opernhaus bei der Abrechnung zu helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180213
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180213,
					"content": "Garcia wurde also wegen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180214
					]
				},
				{
					"id": 741180214,
					"content": "Nein, er ist nicht unseretwegen angestellt. Meine Theatertruppe ist nicht hier aufgetreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180215
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180215,
					"content": "Es ist einfach zu erraten. Soweit ich über Garcia weiß, gehört er nicht zu der Sorte Mensch, der in seiner Freizeit in die Oper geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180216
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180216,
					"content": "Der einzige Grund, warum er ins Opernhaus kam, war, dass er zum Arbeiten angestellt wurde, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180217
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180217,
					"content": "Ich bin wirklich der Meinung, dass du besser geeignet bist, mich an der Seite dieses Herrn zu ersetzen, junge Fräulein Kaia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180218
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180218,
					"content": "Jeder von uns ist unersetzlich, lieber Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180219
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180219,
					"content": "Ich ... äh ... Kaia, ich freue mich, dich zu treffen, ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180220
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180220,
					"content": "... Aber du siehst nicht sehr glücklich aus. Läuft es mit deiner Forschung denn nicht gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180221
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180221,
					"content": "Wie hast du das erraten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180222
					]
				},
				{
					"id": 741180222,
					"content": "Hm, zumindest wird er weder bedrückt sein, weil er mich gesehen hat, noch deinetwegen oder wegen Lutong ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180223
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180223,
					"content": "Das Einzige, was Garcia in seinem Leben so unglücklich machen könnte, ist diese „Zahlenmaschine“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180224
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180224,
					"content": "Warum kennst du Garcia so gut, Fräulein Kaia? Ihr habt euch so lange nicht mehr gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180225,
						741180226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180225,
					"content": "Vielleicht ist es ihre Intuition.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				},
				{
					"id": 741180227,
					"content": "Wir sollten wohl einmal in ein Café gehen, uns hinsetzen und darüber reden. Das kann man nicht mit ein paar Worten erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180228
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180228,
					"content": "Aber ich muss noch ... äh, nein, ich bin froh ... Aber wir haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180229
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180229,
					"content": "Keine Sorge, Herr Garcia. Diese Berechnungen sind ganz einfach und ich kann die ganze Arbeit selbst machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180230
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180230,
					"content": "... Du kannst Fräulein Kaia doch nicht einfach stehen lassen, bis unsere Arbeit erledigt ist, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180231
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180231,
					"content": "Das ist sehr rücksichtsvoll von dir, Lutong. Wir werden dir eine Tasse Kaffee mitbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180232
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180232,
					"content": "Vielen Dank, Fräulein Kaia. Ich wünsche euch eine schöne Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180233
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180233,
					"content": "Garcia und Kaia gehen zusammen los ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180234
					]
				},
				{
					"id": 741180234,
					"content": "Sie sind einfach Kaffee trinken gegangen ... Hm, Paimon findet, dass wir hier gar nichts verloren haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180235,
						741180236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180235,
					"content": "Ja, wir haben hier nichts zu tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180237,
					"content": "#Nein, {NICKNAME}. Unsere Arbeit hat gerade erst begonnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180238,
						741180239,
						741180240
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180238,
					"content": "Welche Zutat suchen wir also dieses Mal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180241,
					"content": "Du bist sehr witzig. Aber ich möchte auf keinen Fall deine Zeit verschwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180242
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180242,
					"content": "Herr Garcia und ich sind in der Tat gerade in Gefahr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180243
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180243,
					"content": "Wa... Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180244,
					"content": "Wir unterhalten uns am besten auf dem Weg darüber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180239,
					"content": "Welche Teile suchen wir also dieses Mal?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180240,
					"content": "Oder soll ich ein Foto von ihnen machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180241
					]
				},
				{
					"id": 741180236,
					"content": "Warum sind wir also immer noch hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180237
					]
				},
				{
					"id": 741180226,
					"content": "Vielleicht ist Garcia einfach wie ein offenes Buch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180227
					]
				}
			]
		},
		{
			"id": 7411803,
			"completionStepIds": [
				7411803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
