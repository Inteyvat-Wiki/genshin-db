			"dialogs": [
				{
					"id": 741180501,
					"content": "Hallo. Was kann ich für dich tun, bitte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180502
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180502,
					"content": "Über die aktuelle Situation ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180503
					]
				},
				{
					"id": 741180503,
					"content": "Du erzählst Menthe, was passiert ist ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180504
					]
				},
				{
					"id": 741180504,
					"content": "Es geht also um Herrn Garcia. Ich verstehe. Gehen wir zu ihm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180505
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180505,
					"content": "Aber zuerst müssen wir diese verdächtige Person loswerden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Menthe"
				}
			]
		},
