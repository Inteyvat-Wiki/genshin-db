			},
			"dialogs": [
				{
					"id": 741185001,
					"content": "#Ich stehe dir zu Diensten, {F#liebe}{M#lieber} {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185002,
						741185008,
						741185014
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185002,
					"content": "Was sind eure Pläne danach?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185003
					]
				},
				{
					"id": 741185003,
					"content": "Bis jetzt haben wir noch nicht herausgefunden, wer diese Gruppe von Leuten ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185004,
					"content": "Obwohl wir bereits Anzeige erstattet haben, gibt es jetzt keine Anhaltspunkte, und die Gendarmen wissen nicht, wo sie anfangen sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185005,
					"content": "Außerdem ist der Hof von Fontaine so groß, dass die Gendarmen uns nicht an allen Orten schützen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185006
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185006,
					"content": "Und jetzt ... ist auch Fräulein Kaia involviert, also wird es noch komplizierter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185007
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185007,
					"content": "Ich hoffe, dass Herr Garcia Fräulein Kaia überreden kann, Fontaine schnell zu verlassen. Auf diese Weise können wir den ursprünglichen Plan weiterverfolgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185008,
					"content": "Befindet sich Garcias Forschung nicht in einer Sackgasse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185009
					]
				},
				{
					"id": 741185009,
					"content": "Die „Sackgasse“ bedeutet, dass es nicht möglich ist, ihre Leistung weiter zu verbessern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185010
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185010,
					"content": "Aber die „Zahlenmaschine“ hat in Bezug auf die Anwendungsbereiche eine Menge zu bieten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185011
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185011,
					"content": "Aber Herr Garcia hat sich nie wirklich für die Anwendungen interessiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185012
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185012,
					"content": "Ich glaube, das ist einer der Gründe, warum er oft unter Qualen zu leiden hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185013
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185013,
					"content": "Aber gerade deshalb hat er die Figur des frustrierten Forschers sehr gut gespielt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185014,
					"content": "Tschüs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185015
					]
				},
				{
					"id": 741185015,
					"content": "Dann zähle ich auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
		{
			"id": 7411851,
			"completionStepIds": [],
