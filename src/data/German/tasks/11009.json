	"talks": [
		{
			"id": 1100901,
			"completionStepIds": [
				1100901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100901",
							"2"
						],
						"stepId": 1100901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090101,
					"content": "Ich habe euch heute alle zusammengerufen, um eine wichtige Ankündigung zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090102
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090102,
					"content": "Vielleicht hat jemand schon das Gerücht gehört, dass ich in nächster Zeit das Jadegemach neu errichten will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090103,
					"content": "Das Jadegemach neu errichten? Das ist eine Menge Arbeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090104
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090104,
					"content": "Die Gerüchte sind wahr. Kein Wunder, dass die Preise für Baumaterialien vor einiger Zeit in die Höhe geschossen sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090105
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090105,
					"content": "Das Jadegemach bedeutet Ningguang sehr viel, und wenn wir an dessen Wiederaufbau teilnehmen dürften ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090106
					],
					"speakerTitle": "Zhicheng"
				},
				{
					"id": 110090106,
					"content": "Können wir etwas für dich tun, Ningguang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090107
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090107,
					"content": "Es gibt keinen Grund, ängstlich zu sein. Nachdem sich die Nachricht vor ein paar Tagen verbreitet hatte, kontaktierten mich eine Reihe von Menschen über verschiedene Kanäle, um sich dem Projekt anzuschließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090108
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090108,
					"content": "Im Moment habe ich ein paar Dinge in der Hand, die ich euch gern anvertrauen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090109
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090109,
					"content": "Jetzt, da der Standort ausgewählt und die Baumaterialien bereit sind, müssen noch drei wichtige Dinge gefunden werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090110
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090110,
					"content": "Diese drei Gegenstände sind der „Dämmerplaustrit“, der „Wunderkern“ und der „Adeptentalisman“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090111
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090111,
					"content": "Verzeih mir, wenn ich anmaßend bin, aber von den letzten beiden habe ich noch nie etwas gehört, nur von dem Plaustrit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090112
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090112,
					"content": "Erst wenn der Plaustrit groß genug ist, kann er den Namen „Dämmerplaustrit“ erhalten, der dafür sorgt, dass sich das Jadegemach in die Luft erheben kann. Der Wunderkern hingegen ist das Herzstück der mechanischen Struktur des Jadegemachs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090113
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090113,
					"content": "Der Adeptentalisman ist ebenfalls unverzichtbar, um mechanische Geräte mit adeptischer Magie zu kombinieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090114
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090114,
					"content": "Obwohl es drei seltene Gegenstände sind, sollte es mit deinen Kontakten und Fähigkeiten nur eine Frage der Zeit sein, bis ihr sie alle findet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090115
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090115,
					"content": "Schnelligkeit ist alles, was zählt. Ich werde euch die Materialien, die ihr findet, zu einem guten Preis abkaufen. Außerdem bekommen die ersten drei Personen, die alle Materialien finden, die Chance, mir eine Frage zu stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090116
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090116,
					"content": "Was auch immer die Frage ist, ich werde sie beantworten. Ich bin sicher, dass ich euch im Gegenzug nicht enttäuschen werde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090117
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090117,
					"content": "Es ist schwer zu finden, aber es wäre schön, wenn ich nach den Plänen von Liyue für das nächste Jahr fragen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090118
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090118,
					"content": "Dies ist das teuerste Geschäft. Wer Informationen von Ningguang bekommt, bekommt die beste Chance ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090119
					],
					"speakerTitle": "Zhicheng"
				},
				{
					"id": 110090119,
					"content": "Haha, was für ein Zufall! Ich habe vor nicht allzu langer Zeit Gerüchte über den Plaustrit gehört. Verzeiht mir, ich muss euch verlassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090120
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090120,
					"content": "Verdammt ... Lasst uns auch loslegen, wir dürfen nicht zulassen, dass uns jemand zuvorkommt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090121
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090121,
					"content": "Die Wiederherstellung des Jadegemachs ... Eine so wichtige Angelegenheit, lass es uns mal sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090122,
					"content": "Ihr habt alle gehört, was ich vorhin gesagt habe, oder? Wie ist es? Bist du daran interessiert, dich an dieser Sache zu beteiligen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090123
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090123,
					"content": "Ist es wirklich möglich, alles zu fragen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090124
					]
				},
				{
					"id": 110090124,
					"content": "Was immer ich weiß, ich kann dir die Wahrheit sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090125
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090125,
					"content": "#Vielleicht kann ich etwas über {F#meinen Bruder}{M#meine Schwester} herausfinden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090126
					]
				},
				{
					"id": 110090126,
					"content": "Wirklich? Dann muss Paimon fragen, wie Ningguang ihr Geschäft betreibt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090127,
					"content": "Auf diese Weise gehen uns die Mora für zukünftige Reisen nie aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090128,
					"content": "Oh, natürlich kannst du das. Wie viel Einsicht vermittelt wird, hängt jedoch von euch beiden ab.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090129
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090129,
					"content": "Der Wiederaufbau des Jadegemachs erstreckt sich über ein großes Gebiet, also habe ich die Adresse in der verlassenen Mine vor der Goldstube vereinbart. Alle gesammelten Materialien sollten dorthin geschickt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090130
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090130,
					"content": "Ich habe andere Verpflichtungen und kann dich nicht zum Standort begleiten. Wenn du dort bist, wende dich einfach an meine Sekretärin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090131
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090131,
					"content": "Achte auf die Zeit. Das ist eine seltene Gelegenheit, also lass dir nicht von jemand anderem zuvorkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090132
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090132,
					"content": "Ningguang ist eine vielbeschäftigte Frau ... Lass uns auch loslegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090133,
					"content": "#Zuerst müssen wir durch die Yujing-Terrasse gehen ... Hä? {NICKNAME}, die Atmosphäre dort drüben scheint ein bisschen heikel zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090134,
					"content": "Fräulein, du siehst besonders anmutig und elegant aus. Auf den ersten Blick weiß ich, dass du die Führung bei der Restaurierung des Jadegemachs übernehmen wirst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090135
					],
					"speakerTitle": "Narbe Liu"
				},
				{
					"id": 110090135,
					"content": "Wir haben Informationen über diese Materialien hier. Komm, lass uns ein ruhiges Plätzchen zum Reden suchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090136
					],
					"speakerTitle": "Narbe Liu"
				},
				{
					"id": 110090136,
					"content": "Nicht nötig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090137
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090137,
					"content": "Sag das nicht. He, geh nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090138
					],
					"speakerTitle": "Narbe Liu"
				},
				{
					"id": 110090138,
					"content": "Worauf wartest du? Komm und folg ihr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090139
					],
					"speakerTitle": "Narbe Liu"
				},
				{
					"id": 110090139,
					"content": "Ja ... ja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiang der Starke"
				}
			]
		},
		{
			"id": 1100902,
			"completionStepIds": [
				1100902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100902",
							"2"
						],
						"stepId": 1100902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shenhe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090201,
					"content": "Hehe, Fräulein, jetzt kannst du endlich nicht mehr weglaufen, stimmt’s?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090202
					],
					"speakerTitle": "Narbe Liu"
				},
				{
					"id": 110090202,
					"content": "Keine Sorge, wir sind auch keine schlechten Menschen. Wir können wertvolle Informationen im Austausch gegen ein wenig Geld bekommen, sodass niemand etwas verliert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090203
					],
					"speakerTitle": "Narbe Liu"
				},
				{
					"id": 110090203,
					"content": "Chef, ich habe ein schlechtes Gefühl bei dieser Sache. Du kannst sehen, dass sie eine andere Aura hat als andere und dass ihr Haar weiß ist, nicht wie bei einem normalen Menschen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090204
					],
					"speakerTitle": "Qiang der Starke"
				},
				{
					"id": 110090204,
					"content": "Was soll’s? Wenn wir sie nicht ausschlachten, wie sollen wir dann unsere Spielschulden bezahlen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090205
					],
					"speakerTitle": "Narbe Liu"
				},
				{
					"id": 110090205,
					"content": "Wie ich schon sagte, ich brauche deine Informationen nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090206
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090206,
					"content": "Wenn du mich gerade nicht verstanden hast, wiederhole ich es ein letztes Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090207
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090207,
					"content": "Seufz ... Fräulein, wieso hast du denn überhaupt keinen gesunden Menschenverstand?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090208
					],
					"speakerTitle": "Narbe Liu"
				},
				{
					"id": 110090208,
					"content": "Es geht nicht darum, ob du es brauchst oder nicht, du musst nur brav sein und uns das Geld geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090209
					],
					"speakerTitle": "Narbe Liu"
				},
				{
					"id": 110090209,
					"content": "I... Ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090210
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090210,
					"content": "Sei nicht pingelig! Du hast Geld, das kann ich sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090211
					],
					"speakerTitle": "Narbe Liu"
				},
				{
					"id": 110090211,
					"content": "Du gingst zuerst zum Liuli-Pavillon und bestelltest einen Tisch voller Gerichte, die du aber nur ein bisschen probiertest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090212
					],
					"speakerTitle": "Narbe Liu"
				},
				{
					"id": 110090212,
					"content": "Dann gingst du zurück zum Lokal Xinyue und Restaurant Wanmin und bestelltest alle guten Gerichte, wobei du wieder nur einen Bissen von jedem Gericht zu dir nahmst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090213
					],
					"speakerTitle": "Narbe Liu"
				},
				{
					"id": 110090213,
					"content": "Wenn du kein reiches Mädchen bist, wie kannst du dann solche extravaganten Gewohnheiten haben? Wenn du so reich bist, was ist falsch daran, ein wenig mit uns zu teilen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090214
					],
					"speakerTitle": "Narbe Liu"
				},
				{
					"id": 110090214,
					"content": "Obwohl die Meisterin angeordnet hatte, nicht in Liyue gewalttätig zu werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090215
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090215,
					"content": "Vergiss es. Vielleicht ... ist es auch Schicksal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090216
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090216,
					"content": "Boss, irgendetwas scheint nicht zu stimmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090217
					],
					"speakerTitle": "Qiang der Starke"
				},
				{
					"id": 110090217,
					"content": "Wenn sie es wagt, werden wir sie verklagen, und sie wird ihr ganzes Geld verlieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090218,
						110090219
					],
					"speakerTitle": "Narbe Liu"
				},
				{
					"id": 110090218,
					"content": "Sie sind es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				},
				{
					"id": 110090220,
					"content": "Oh? Ihr seid es wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090221
					],
					"speakerTitle": "Zheng"
				},
				{
					"id": 110090221,
					"content": "Die Millelithen? Warum sind die Millelithen hier ... Hast du das getan? Kümmere dich um deinen eigenen Kram, ob du mir glaubst oder nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090222
					],
					"speakerTitle": "Narbe Liu"
				},
				{
					"id": 110090222,
					"content": "Halt die Klappe! Wie kannst du es wagen, anderen zu drohen? Komm mit uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090223
					],
					"speakerTitle": "Zheng"
				},
				{
					"id": 110090223,
					"content": "Oh ... Sei nicht böse, mein Herr, lass es mich dir langsam erklären ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090224
					],
					"speakerTitle": "Narbe Liu"
				},
				{
					"id": 110090224,
					"content": "Die Millelithen führten die Schurken ab, die das weißhaarige Mädchen belästigten.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090225
					]
				},
				{
					"id": 110090225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090226,
						110090227
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090226,
					"content": "Alles in Ordnung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090228,
					"content": "... Shenhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090229
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090229,
					"content": "Shenhe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090230,
					"content": "Mein Name.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090231
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090231,
					"content": "#Oh, oh, du heißt also Shenhe! Paimons Name ist Paimon und das ist {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090232,
					"content": "Ich habe schon von euch gehört. Wegen gerade eben, danke für eure Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090233
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090233,
					"content": "Ich hätte das aber auch selbst lösen können. Soweit ich das beurteilen kann, brauchst du nur den Kopf des Menschen zu packen und ihn dreimal auf den Boden zu schlagen, dann sollte er nachgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090234
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090234,
					"content": "Äh, hallo? Nein, diese Art von Gewalt kannst du nicht anwenden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090235,
					"content": "Dies ist Liyue und die Gesetze von Liyue müssen befolgt werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090236,
					"content": "Ge... Gesetze?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090237
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090237,
					"content": "Hast du nicht von den Gesetzen hier gehört, Shenhe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090238
					]
				},
				{
					"id": 110090238,
					"content": "Ich habe wirklich noch nie davon gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090239
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090239,
					"content": "Wirklich? Du hast also bisher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090241,
					"content": "Da scheint irgendein Geräusch zu sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090242
					]
				},
				{
					"id": 110090242,
					"content": "Das war mein Magen, der da rasselte. Weil ich nicht genug gegessen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090243
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090243,
					"content": "Du bist schon ziemlich direkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090244,
					"content": "Apropos, Paimon hat gerade gehört, wie die Leute gesagt haben, dass du in viele Restaurants gegangen bist, Essen bestellt hast und von jedem nur einen Bissen probiert hast ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090245,
					"content": "Paimon ist sich sicher, dass das nicht genug zum Essen ist! Gibt es etwas, das du gern essen möchtest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090246,
					"content": "Qingxin, Glaslilie, Glasglöckchen ... Das sind die Dinge, die ich normalerweise esse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090247
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090247,
					"content": "Das sind medizinische Kräuter ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090248
					]
				},
				{
					"id": 110090248,
					"content": "Medizinische Kräuter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090249
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090249,
					"content": "Das hat keinen Sinn ... Die Bubu-Hütte ist hier in der Nähe, also warum nehmen wir nicht Shenhe mit, um ein gutes Essen zu haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090250,
					"content": "Schließlich musst du essen, um zu arbeiten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090227,
					"content": "Keine Sorge, jetzt ist alles gut.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090219,
					"content": "Diese Typen kaufen und verkaufen mit Gewalt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				}
			]
		},
		{
			"id": 1100903,
			"completionStepIds": [
				1100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100903",
							"2"
						],
						"stepId": 1100903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kräuterkundler Gui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090301,
					"content": "Seid ihr hier, um Medizin zu besorgen? Oder ein Rezept?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090302
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 110090302,
					"content": "Qingxin, Glaslilie, Glasglöckchen ... jeweils ein halbes Pfund.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090303
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090303,
					"content": "Was ist das für ein Mittel? Das klingt, als würde jemand die Medizin als Essen zubereiten wollen ... Hier, das ist alles, was der Laden vorrätig hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090304
					],
					"speakerTitle": "Kräuterkundler Gui"
				},
				{
					"id": 110090304,
					"content": "Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090305
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090305,
					"content": "Ganz im Ernst, sie isst das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090306,
					"content": "Während alle noch staunend zusehen, verschlingt Shenhe schon alle Kräuter vor ihren Augen.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090307
					]
				},
				{
					"id": 110090307,
					"content": "Ich habe keinen Hunger mehr, danke für die Gastfreundschaft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090308,
						110090309
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090308,
					"content": "Wie hat es geschmeckt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				},
				{
					"id": 110090310,
					"content": "Es war nicht lecker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090311
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090311,
					"content": "Der Geschmack ist leicht erfrischend, aber wenn du zu viel davon isst, ist er nur noch bitter, sauer und herb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090312
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090312,
					"content": "Warum sollte Shenhe also lieber das essen als das Essen aus dem Restaurant?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090313,
					"content": "Wenn Paimon viel Geld hätte, würde Paimon in die besten Restaurants gehen und viel, viel gutes Essen bestellen und alles auf einmal essen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090314,
					"content": "Denn ich war mir nicht sicher, ob ich in Zukunft selbst hier bleiben würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090315
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090315,
					"content": "Menschliche Mahlzeiten sind köstlich, aber wenn ich in Zukunft in die Berge zurückkehre, würde die Erinnerung an das Essen eher ein Hindernis für meine Kultivierung werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090316
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090316,
					"content": "Es ist also gut, einfach eine Kostprobe zu nehmen und zu verstehen, wie es ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090317
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090317,
					"content": "#Zurück zu den Bergen ... {NICKNAME}, kein Zweifel, das ist definitiv eine Adeptin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090318,
					"content": "Abgesehen von meiner Angelegenheit, was sind deine nächsten Pläne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090319
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090319,
					"content": "Oh ja! Paimon hätte fast vergessen, dass wir hier sind, um am Jadegemach-Wiederaufbau-Wettkampf teilzunehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090320,
					"content": "Wenn du zu lange zögerst, kannst du die Dinge nicht erledigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090321,
					"content": "Das ist es also. Ich habe von dem Wettkampf gehört, als ich gerade vorbeikam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090322
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090322,
					"content": "He ... Wenn du gewinnst, kannst du schließlich verlangen, was du willst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090323,
					"content": "Shenhe, bist auch hier, um dich zu messen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090324,
					"content": "Ich bin zwar gekommen, um das Jadegemach neu zu gestalten, aber ich hatte vorher nicht daran gedacht, am Wettkampf teilzunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090325
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090325,
					"content": "Jetzt, da du dich um mich gekümmert hast, würde ich dir gern helfen. Keine Sorge, du brauchst dafür keine Gegenleistung zu erbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090326
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090326,
					"content": "Das können wir doch nicht annehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090327,
					"content": "Aber mit der Hilfe der Adepten sollte alles viel einfacher sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090328,
						110090329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090328,
					"content": "Dann nichts wie los.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090330,
					"content": "Dann habe ich sofort einen Schlachtplan für die unmittelbare Zukunft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090331
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090331,
					"content": "Toll! Das muss ein guter Vorschlag sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090332,
					"content": "Ich bin mir nicht sicher, ob es toll ist oder nicht, aber es sollte effektiv sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090333
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090333,
					"content": "Wenn wir alle Leute, die vor uns in der Rangliste stehen, herausnehmen, werden wir die Nummer eins sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090334
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090334,
					"content": "... Auf keinen Fall! Egal, wie, das geht nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090335,
					"content": "Ach? Aber ich habe gehört, dass es beim Wettbewerb um gegenseitige Rivalität und Austricksen geht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090336
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090336,
					"content": "Wir werden den ersten Platz belegen, und das mit ehrlichem Gemüt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090337,
					"content": "Dämmerplaustrit, Wunderkern und Adeptentalisman ... Machen wir es der Reihenfolge nach, zuerst Plaustrit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090338,
					"content": "Ich habe mich gefragt, warum ich einen Streit draußen vor dem Laden hören konnte, aber ihr wart ja hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090339
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090339,
					"content": "Baizhu! Was machst du denn hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090340,
					"content": "Ningguang muss eine Charge Wundmedizin kaufen und der Laden hat vielleicht nicht genug Kräuter, also bin ich gekommen, um sie selbst zuzubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090341
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090341,
					"content": "He, wozu braucht Ningguang so viel Wundmedizin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090342,
					"content": "Ich bin mir nicht sicher, aber ich habe gehört, dass sie das Jadegemach wieder aufbauen will. Vielleicht ist es für die Baustelle? Außerdem ist das die Privatsphäre eines Kunden, also darf ich nicht zu viel fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090343
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090343,
					"content": "Sie hat sich auch Qiqi von mir geliehen, also bin ich im Moment sehr knapp an Leuten. Wollt ihr helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090344
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090344,
					"content": "Nein, wir haben andere Dinge zu tun ... Apropos, Baizhu, du hast doch viel Wissen. Hast du schon mal vom „Dämmerplaustrit“ gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090345,
					"content": "Ist damit die Art gemeint, die im Jadegemach verwendet wird? Ich erinnere mich, dass in der „Enzyklopädie der sieben Berge“ erwähnt wird, dass der Dämmerplaustrit direkt in die Wolken aufsteigen kann, wenn er aktiviert wird, und sehr selten ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090346
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090346,
					"content": "Der Dämmerplaustrit, der explizit aufgezeichnet wurde, ist im Grunde genommen abgebaut worden und hat bereits Besitzer gefunden. Die Händlergilde Feiyun sollte mehr darüber wissen als ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090347
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090347,
					"content": "Verstehe, dann lass uns zur Händlergilde Feiyun gehen und fragen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090348,
					"content": "Danke, Baizhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090349,
					"content": "Gern geschehen und viel Glück für euch! Wenn du etwas brauchst, komm einfach zu mir in die Bubu-Hütte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090329,
					"content": "Du bist jederzeit willkommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090309,
					"content": "War es lecker?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				}
			]
		},
