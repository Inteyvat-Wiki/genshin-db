			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dodo-Kommunikationsgerät"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670201,
					"content": "... Ich hatte nicht damit gerechnet, ein so unglaubliches Ereignis an einem Ort mit einer so wunderbaren Landschaft zu behandeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670202
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670202,
					"content": "Wie fühlst du dich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670203
					]
				},
				{
					"id": 400670203,
					"content": "Gut. Noch besser wäre es, wenn du mir helfen könntest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670204,
					"content": "Was genau müssen wir also tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670205,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670206,
					"content": "Ähm ... ähm ... es scheint nichts zu sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670207,
					"content": "Du ... Du unterschätzt uns?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670208,
					"content": "Nein, mir ist gerade aufgefallen, dass du zwar nicht viel redest, aber immer alles perfekt erledigst und leise viel für alle tust.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670209,
					"content": "Du bist ein Gefährte, den jeder am meisten braucht. Solange du hier bist, scheinen wir alle viel beruhigter zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670210,
					"content": "Obwohl das Erwarten Druck auf die andere Partei ausüben kann, denke ich, dass Astrologen über gutes Beobachtungsvermögen verfügen müssen. Das Entdecken der Vorteile anderer ist auch eine Art von Beobachtung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670211,
					"content": "Du willst uns also nur ein Kompliment machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670212,
					"content": "Ich habe nur Fakten erzählt und wollten dir keine Komplimente machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670213
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670213,
					"content": "So ist das. Mona weigerte sich, es zuzugeben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670214
					]
				},
				{
					"id": 400670214,
					"content": "Dass sie anderen Komplimente macht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670215,
					"content": "Warum lachst du? Ich habe schon gesagt, dass es kein Kompliment, sondern eine objektive Bewertung ist! Ich habe dir kein Kompliment gemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670216
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670216,
					"content": "#In Zukunft werde ich weiter die Sterne beobachten. Bleiben wir in Kontakt, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
