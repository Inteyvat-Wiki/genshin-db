			"dialogs": [
				{
					"id": 400670401,
					"content": "Bist du Kaedehara? Steig ins Boot. Ich bringe dich weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670402
					],
					"speakerTitle": "Zuhören"
				},
				{
					"id": 400670402,
					"content": "Warum willst du mir helfen? Ich bin ein gesuchter Straftäter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670403
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670403,
					"content": "Ich wurde von Kamisato ... Quatsch! Jemand hat mich mit Vergütung gebeten, dich aus Inazuma zu schicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670404
					],
					"speakerTitle": "Zuhören"
				},
				{
					"id": 400670404,
					"content": "Was andere helfen können, ist jedoch sehr begrenzt. Du musst dich für den weiteren Weg auf sich selbst verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zuhören"
				}
			]
		},
		{
			"id": 4006705,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006712",
							"2"
						],
						"stepId": 4006712,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"4005914",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670501,
					"content": "In diesem Porzellanbecken sollte es eine tote Pflanze geben. Aber hier findet man kein Totholz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670502
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670502,
					"content": "... Ich habe mir viel Gedanken gemacht, als ihr weg wart. Nun habe ich es endlich kapiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670503
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670503,
					"content": "Das alles ist meine Illusion. In der Miniaturlandschaft findet man nichts. Das spiegelt meinen Geisteszustand wider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670504
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670504,
					"content": "Wenn das Herz „rein“ ist, wird alles in der Welt „rein“. Wenn das Herz „leer“ ist, wird alles in der Welt „leer“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670505
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670505,
					"content": "„Rein“ und „leer“ ... Das ist mein aktueller Geisteszustand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670506
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670506,
					"content": "Das ist aber nicht unbedingt kein Bedauern. Das Gefühl von Mangel im Herzen wird auch als „leer“ bezeichnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670507
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670507,
					"content": "Deswegen tauchte diese Miniaturlandschaft in meiner Illusion auf und gab mir die Möglichkeit, meinen Wunsch zu erfüllen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670508
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670508,
					"content": "Ich hätte nie gedacht, dass ich tief in meinem Herzen auch meine eigene Miniaturlandschaft machen möchte ... In diesem Fall wäre es ein wahres Erbe der Tradition vom Kaedehara-Klan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006706,
			"completionStepIds": [
				4006712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006712",
							"2"
						],
						"stepId": 4006712,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"4005914",
							"0"
						]
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"40067"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670601,
					"content": "Ist das, was du tun möchtest, jetzt erledigt, Kazuha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670602,
					"content": "Ja, das kann man sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670603
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670603,
					"content": "Ihr habt mein altes Ich gesehen und ihm Lebewohl gesagt. Wenn ihr alles, was mir gehört, mit eigenen Augen gesehen habt, wird es wirklich Geschichte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670604
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670604,
					"content": "Das Wichtigste im Leben ist nicht Selbstkritik, sondern die Zuneigung zu Anderen. Wer in der Vergangenheit stehen bleibt, hat keine Zukunft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670605
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400670605,
					"content": "Deswegen glaubt bitte, dass ich diesen Weg weitergehen werde. Ich freue mich auf eure Unterstützungen in Zukunft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006710,
			"completionStepIds": [
				4006715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006715",
							"2"
						],
						"stepId": 4006715,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zuhören"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671001,
					"content": "He, du! Alles klar bei dir? Willst du hochkommen und Zuflucht nehmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671002
					],
					"speakerTitle": "Zuhören"
				},
				{
					"id": 400671002,
					"content": "Piraten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671003
					],
					"speakerTitle": "Zuhören"
				},
				{
					"id": 400671003,
					"content": "Ja, Piraten! Sag ruhig, ob du mitkommen willst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zuhören"
				}
			]
		},
		{
			"id": 4006712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006712",
							"2"
						],
						"stepId": 4006712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Mona",
					"Fischl",
					"Oz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671201,
					"content": "Wir haben dich endlich gefunden, Kazuha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671202,
					"content": "Ihr seid gerade rechtzeitig gekommen. Die Zeit reicht mir gerade aus, um über mein bisheriges Leben nachzudenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671203
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671203,
					"content": "Was hältst du von der Miniaturlandschaft der Kaedeharas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671204,
						400671207
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671204,
					"content": "Antik und voller Kultur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671205
					]
				},
				{
					"id": 400671205,
					"content": "Alte Dinge werden oft von Reue begleitet. Bei den Kaedeharas ist es das gleiche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671206,
					"content": "Macht aber nichts. Die Trennung ist eine neue Zusammenkunft. Wenn man nicht hier ist, ist man in einem anderen Land.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671209,
					"content": "Die Sphäre ist interessant. Wie in einem Theaterstück ist jede Episode spektakulärer und ergreifender als die letzte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671210,
					"content": "Astrologen sind gut informierte Menschen. Mit solcher Beurteilung von dir existiert diese Illusion nicht umsonst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671211
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671211,
					"content": "He, du ... wie fühlst du dich jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671212
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671212,
					"content": "Das Fräulein möchte dich trösten und hofft, dass du dich nicht zu niedergeschlagen fühlst, Kazuha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671213
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671213,
					"content": "Es ist unmöglich, sich glücklich an ein solches Erlebnis zu erinnern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671214,
					"content": "Haha, stimmt. Danke für euer Besorgnis. Zum Glück gehören diese Dinge für mich der Vergangenheit an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671215
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671215,
					"content": "Als ich die Miniaturlandschaft zum ersten Mal sah, dachte ich schon an diese Möglichkeit ... Vielleicht wurde ich deshalb allein an der Ziellinie gelassen, weil ich auf euch wartete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671207,
					"content": "Sie ist nicht perfekt, aber du bist ihr nichts schuldig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671208
					]
				},
				{
					"id": 400671208,
					"content": "Genau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671209
					],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
		{
			"id": 4006713,
			"completionStepIds": [
				4006713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006713",
							"2"
						],
						"stepId": 4006713,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Fischl",
					"Mona",
					"Oz",
					"Kaedehara Kazuha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671301,
					"content": "*gähn* Paimon ist viel gelaufen und ist etwas müde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671302,
					"content": "Alle haben hart gearbeitet. Warum ruhen wir uns heute nicht früh aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671304
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671304,
					"content": "Was ist los? Du siehst blass aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671305
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671305,
					"content": "Nichts. Ich bin wahrscheinlich deswegen müde, weil wir den ganzen Tag unterwegs waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671306
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671307
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671307,
					"content": "Geht’s Euch noch gut, mein Fräulein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671308
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671308,
					"content": "Sei nicht vorwitzig, Oz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671309
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400671309,
					"content": "Alles klar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671310
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400671310,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671311
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671311,
					"content": "Ich suche etwas zu essen. Wenn ihr müde seid, setzt euch einfach eine Weile hin. Wenn jemand von euch noch Energie hat, kann er mir helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671312
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671312,
					"content": "Ich kann dir helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671313
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671313,
					"content": "Ich auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671314
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671314,
					"content": "Alle anderen helfen so freiwillig. Lass uns auch gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671315,
					"content": "Paimon und ich kommen auch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671316
					]
				},
				{
					"id": 400671316,
					"content": "So viele Leute brauche ich nicht. Außerdem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671317
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671317,
					"content": "Die Prinzessin ist ein bisschen melancholisch. Mona, du kennst sie besser. Warum gehst du nicht mit ihr spazieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671318
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671318,
					"content": "Du hast es also auch gesehen. Ich hatte vor, euch das beim Sammeln von Essen zu sagen. Dann überlass es mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671319
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671319,
					"content": "Gut, lasst uns das Essen vorbereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671320
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671320,
					"content": "Mona zwinkerte uns zu und rannte los, um Fischl zu begleiten. Die restlichen Leute fanden zusammen einige Zutaten, um daraus köstliche Gerichte zuzubereiten ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400671321
					]
				},
				{
					"id": 400671321,
					"content": "Ja, das reicht. Grillen wir sie später. Wenn wir nächstes Mal an diesem Lager vorbeigehen, können wir sehen, ob ein Kochtopf dort irgendwo liegt. Den könnten wir gut gebrauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671322
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671322,
					"content": "Das ist sehr aufmerksam von dir, obwohl du kein Koch bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671323,
					"content": "Hehe, das ist nur eine Kleinigkeit und dein Lob nicht wert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671324
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671324,
					"content": "Xinyan ist eine gute Gefährtin, die sogar von den Kameraden der „Alcor“ anerkannt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671325
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671325,
					"content": "Ja! In unseren Augen ist Kazuha auch eine so zuverlässige Person!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671326,
					"content": "Haha, gut gesagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671327
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671327,
					"content": "Ähm ... Da ihr mich als verlässliche Person betrachtet, habe ich einfach mal was zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671328,
					"content": "Nach dem, was ihr gesagt habt, wurde diese unglaubliche Illusion auf der Grundlage des bisherigen Lebens von „Kaedehara Kazuha“ geschaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671329
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671329,
					"content": "... Wie ein Traum von mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671330
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671330,
					"content": "Vielleicht ist es wirklich eine Darstellung des „Traums“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671331
					]
				},
				{
					"id": 400671331,
					"content": "Kazuha, kann es sein ... dass du schon immer deine eigene „Miniaturlandschaft“ erschaffen wolltest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671332
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671332,
					"content": "Ja ... Am Ende ist mein Wunsch tatsächlich in Erfüllung gegangen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671333
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671333,
					"content": "Bedeutet das, dass nicht nur ich, sondern auch alle von uns auf diese Situation stoßen könnten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671334
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400671334,
					"content": "Das finde ich auch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671335
					]
				},
				{
					"id": 400671335,
					"content": "Ebenso. Ich weiß bloß nicht, mit wessen Illusion die nächste ähnliche Sphäre zu tun haben wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671336
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671336,
					"content": "Wie toll wäre es, wenn ich auch so einen schönen Traum haben könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671337
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671337,
					"content": "Willst du so etwas wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671338,
					"content": "Wenn ich ein solches Gebiet haben könnte, wäre es etwas, das mit Musik zu tun hat. Ja, dann werde ich mein ganzes Können zeigen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671339
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671339,
					"content": "Sag Paimon nicht, dass es eine plötzliche Musikschau sein wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671340,
					"content": "Das ist doch ganz normal, oder? Jeder, der Musik macht, kommt auf diesen Archipel mit einer so schönen Landschaft, wird bestimmt leidenschaftlich Musik spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671341
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400671341,
					"content": "So ein starker Verstand, so ein optimistischer Geist. Paimon bewundert sie ein wenig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671342,
					"content": "#Ach ja! {NICKNAME}, Paimon möchte die Früchte an der Klippe probieren. Kannst du Paimon begleiten, um sie zu pflücken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671343,
					"content": "(Äh? Vielleicht ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671344
					]
				},
				{
					"id": 400671344,
					"content": "Viel Spaß, ich werde mit Paimon eine Weile weggehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4006714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4006714",
							"2"
						],
						"stepId": 4006714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dodo-Kommunikationsgerät"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400671401,
					"content": "Die seltsamen Häuser und die fantasieähnliche ... äh ... Miniaturlandschaft? Wie auch immer, das ist ein Haufen seltsamer Sachen! Paimon denkt, wir sollen Venti darüber erzählen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671402,
						400671403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671402,
					"content": "Ich wusste es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671404
					]
				},
				{
					"id": 400671404,
					"content": "Dodoco ... Dodoco ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671405
					],
					"speakerTitle": "Dodo-Kommunikationsgerät"
				},
				{
					"id": 400671405,
					"content": "Dodoco ... Dodoco ... Dodoco ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671406
					],
					"speakerTitle": "Dodo-Kommunikationsgerät"
				},
				{
					"id": 400671406,
					"content": "Keine Antwort ... Komisch. Warum reagiert er nicht auf unseren Anruf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671407,
					"content": "Das ist echt seltsam ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671408
					]
				},
				{
					"id": 400671408,
					"content": "Könnte es sein, dass Venti gerade wieder abgelenkt ist? Oder hat er vielleicht die Bombe während der Darstellung nicht mitgebracht? Oder vielleicht ist er betrunken und döst unter einem großen Baum ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671409,
					"content": "Hm ... kurios. Versuchen wir morgen noch einmal, ihn zu erreichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671410,
					"content": "#{F#Reisende}{M#Reisender}, Paimon, ihr seid hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671411
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671411,
					"content": "Hallo, Mona! Hast du dich mit Fischl unterhalten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671412,
					"content": "Na ja ... Sie ist ein bisschen düster, denke ich ... Vielleicht hängt es mit der Illusion zusammen, der wir heute begegnet sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671413
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671413,
					"content": "Fischl war sehr begeistert von dieser Reise. Aber ich habe das Gefühl, dass sie ihre eigene Illusion nicht sehen will ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671414
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671414,
					"content": "Wieso denn? Sollte sie sich nicht am meisten nach diesen Dingen sehnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671415,
					"content": "... Man kann noch keine Schlüsse ziehen. Aber ich werde die Augen offen halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671416,
					"content": "Ich wollte euch etwas anderes sagen. Gerade eben habe ich eine weitere Wahrsagung am Meer gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671417
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671417,
					"content": "Der Wasserspiegel war immer noch trüb, aber mit dem Unterschied, dass eine gewisse Kraft vage zu spüren war. Ich kann zwar nicht sehen, wo diese Kraft war, aber ich konnte fühlen, wie es sich veränderte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671418,
					"content": "Wie konntest du etwas spüren, das du nicht sehen konntest ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671419,
					"content": "Wie erklärt man es einem Laien ... ah! Du kannst das als einen Riss an der Wand eines Hauses verstehen. Wir wissen nicht, wo er ist. Aber Wind dringt ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671420
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671420,
					"content": "Außerdem sinkt die Temperatur im Hause kontinuierlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671421
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671421,
					"content": "Ach so! Jetzt versteht Paimon es wahrscheinlich. Du willst herausfinden, wo der Riss ist, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400671422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400671422,
					"content": "Das kann man sagen. Ich muss den Riss zuerst finden. Dann weiß ich, was ich machen muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400671403,
					"content": "Dann rufen wir ihn mal an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400671404
					]
				}
			]
		}
	]
}