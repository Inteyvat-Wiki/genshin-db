			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dodo-Kommunikationsgerät"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670101,
					"content": "... Es scheint jedes Mal der Fall zu sein, wenn ich dich treffe. Wahrsagen, interpretieren, Zielerfassung und dann Problem lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670102
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670102,
					"content": "Es ist unglaublich, dass du von allen möglichen Freunden, Geheimnissen und Schicksalen umgeben bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670103,
					"content": "Du bist auch unglaublich! Der Leonard-Vorfall kann nicht ohne dich und Fischl gelöst werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670104,
					"content": "Gut für Astrologen, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400670105
					]
				},
				{
					"id": 400670105,
					"content": "Kaum. Ich hoffe, dass wir dieses Mal unsere Kräfte bündeln können, um das Problem so schnell wie möglich zu lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670106,
					"content": "Kräfte bündeln ... Meinst du euch beide oder uns drei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670107,
					"content": "Puff ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670108,
					"content": "Schon gut. Wir werden dich nicht rausstoßen. Manchmal verfügt Paimon über ein scharfes Auge, was mir sehr hilft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670109,
					"content": "Echt? Paimon fängt an, dich ein wenig zu schätzen, Genie Mona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670110,
					"content": "Ganz genial, oder? Eine so kluge und charmante Astrologin wie ich ist kaum noch auf der Welt zu finden. Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670111,
					"content": "Du bist perfekt, aber kannst du ... bitte nicht lachen wie Fischl ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670112,
					"content": "Ach ja! Es tut mir leid ... Ich bin seit Langem mit ihr befreundet und es ist unvermeidlich, dass ich betroffen sein werde ... Haha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670113,
					"content": "#In Zukunft werde ich weiter die Sterne beobachten. Bleiben wir in Kontakt, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4006702,
			"completionStepIds": [
				4006714
