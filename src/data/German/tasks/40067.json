				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400670301,
					"content": "Was ist hier los? Alles kaputt hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400670302,
					"content": "... Sieht das Haus der Mächtigen im Niedergang so aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670303
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400670303,
					"content": "Ruinenartig und leergefegt. Die Familie scheint nicht mehr zu existieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400670304
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400670304,
					"content": "Lasst uns gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xinyan"
				}
			]
		},
		{
