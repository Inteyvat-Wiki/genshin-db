					"Anthony"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205150101,
					"content": "Wo ist Anna denn jetzt schon wieder hin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150102,
					"content": "Anna ist schon wieder verschwunden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150103
					]
				},
				{
					"id": 205150103,
					"content": "Ganz genau, ich muss die gesamte Stadt auf den Kopf stellen, ich finde sie einfach nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150104,
					"content": "Bitte hilf mir auch bei der Suche, ich bin schon völlig erschöpft und kann mich nicht mehr regen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150105,
						205150107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150105,
					"content": "Geht klar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150106
					]
				},
				{
					"id": 205150106,
					"content": "Dann bitte ich dich, mir zu helfen. Dieses Mädchen, ihre Krankheit ist fast geheilt. Wenn sie wieder rückfällig wird, werde ich auch ganz krank ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150111,
					"content": "Übrigens ... Anna erwähnte mal, dass sie schon immer zur Kathedrale wollte, um den Ordensschwestern zu danken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150112
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150112,
					"content": "Es ist vielleicht besser, erst einmal in der Nähe der Kathedrale zu suchen, und du fragst am besten Albert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150113,
					"content": "Er hält sich ständig in der Nähe der Kathedrale auf ... wandert dort herum, vielleicht hat er ja etwas bemerkt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150107,
					"content": "Wer weiß, vielleicht ist sie ja schon ein Abenteurer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150108
					]
				},
				{
					"id": 205150108,
					"content": "Das kann nicht sein, das darf nicht sein! Wie kann das nur sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150109,
					"content": "Warum sagst du denn auf einmal nichts mehr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "Anthony"
				}
			]
		},
		{
			"id": 2051502,
			"completionStepIds": [
				2051502
