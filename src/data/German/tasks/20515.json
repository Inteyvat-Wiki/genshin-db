				},
				{
					"id": 205150506,
					"content": "Ich weiß zwar nicht, was er dort treibt, aber er ist bestimmt kein schlechter Mensch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150507
