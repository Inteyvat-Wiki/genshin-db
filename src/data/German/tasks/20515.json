					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205150201,
					"content": "Oha, die Ordensschwestern sind sehr aufmerksam. Um ein Haar wären wir entdeckt worden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205150202,
					"content": "Du bist sehr talentiert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150203
					]
				},
				{
					"id": 205150203,
					"content": "Ooh! Woher wusstest du, dass ich hier bin? Nicht einmal die Ordensschwestern haben mich bemerkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205150204,
					"content": "Na gut, jetzt, da du mich gefunden hast, werde ich schleunigst zurück nach Hause gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205150205,
					"content": "Ich bin nur hierhergekommen, um mir die Landschaft anzusehen, nichts weiter, keine Sorge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
