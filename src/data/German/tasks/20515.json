			"dialogs": [
				{
					"id": 205150401,
					"content": "Dieses Kind hat wirklich Talent ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150402
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 205150402,
					"content": "Entschuldigung, hast du zufällig ein Mädchen gesehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150403
					]
				},
				{
					"id": 205150403,
					"content": "Du meinst wohl Anna, ja, habe ich. Sie ist an mir vorbeigerannt, ist vorn um die Kurve und dann war sie aus meinem Sichtfeld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150404
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 205150404,
					"content": "Obwohl ich mich erinnere, Anna war immer sehr krank und ging öfter zur Kathedrale, um sich heilen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150405
					],
					"speakerTitle": "Albert"
				},
				{
					"id": 205150405,
					"content": "Sie sah aber gar nicht krank aus, sie hatte noch mehr Energie als ich. Was ist denn nur passiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albert"
				}
			]
		},
