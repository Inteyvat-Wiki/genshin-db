			"dialogs": [
				{
					"id": 205150301,
					"content": "Hast du Anna gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150302,
					"content": "Sie ist an der Spitze der Kathedrale.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150303
					]
				},
				{
					"id": 205150303,
					"content": "Spitze der Kathedrale? Dort sind so viele Ordensschwestern und keine hat sie bemerkt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150304,
					"content": "Wie hat dieses Kind das nur angestellt? Wer weiß, vielleicht hat sie ja wirklich das Zeug zur Abenteurerin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150305,
					"content": "Ich versuche, sie dort herunterzuholen, ohne die Ordensschwestern zu stören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150306,
					"content": "Danke für deine Mühe, dieses Geschenk ist für dich, nimm es bitte an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
