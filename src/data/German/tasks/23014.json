			"trigger": {
				"objectNames": [
					"Lutong",
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230140101,
					"content": "Herr, diesmal kommt meine Empfehlung von ganzem Herzen. Wir sollten eine Möglichkeit zum Bezahlen finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140102,
					"content": "Diese Händler sind Banditen! Warum verkaufen sie die Abzeichen für so viel Geld?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140103
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140103,
					"content": "Vielleicht weil sie gesehen haben, wie deine Augen beim Anblick dieser Abzeichen gefunkelt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140104,
					"content": "Wozu willst du diese Abzeichen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140105
					]
				},
				{
					"id": 230140105,
					"content": "#{F#Reisende}{M#Reisender}! Du kommst stets zur rechten Zeit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140106,
					"content": "Dank deiner Hilfe beim letzten Mal konnte ich ein akzeptables Schmiermittel entwickeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140107,
					"content": "Aber ich bin sofort auf ein neues Problem gestoßen. Ich habe ein paar Teile neu gebaut. Dabei habe ich gemerkt ... Wenn sie aus zu festem Material bestehen, beschädigen sie die anderen Teile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140108,
					"content": "Außerdem zerbrechen die zu harten Teile bei dem kleinsten Aufprall ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140109,
					"content": "Deshalb bin ich jetzt auf der Suche nach einem Material mit einer bestimmten Härte und Nachgiebigkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140110,
					"content": "Nach einer unermüdlichen Recherche ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140111,
					"content": "... Und nachdem ich Herrn Ahangar unablässig auf die Pelle gerückt bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140112,
					"content": "Ich habe den Eindruck, dass die von Schatzräubern getragenen Abzeichen das von mir gesuchte Material enthalten könnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140113,
					"content": "Aber ... Aber diese Händler haben mich förmlich wie Schatzräuber ausgeraubt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140114,
						230140115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140114,
					"content": "Jetzt bin ich zur Stelle!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				},
				{
					"id": 230140116,
					"content": "Ich sollte deinen Namen in das Hauptlager meiner „Zahlenmaschine“ eingravieren! Ich kann dir nicht genug danken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140115,
					"content": "Ich finde welche für dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				}
			]
		},
