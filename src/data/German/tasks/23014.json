				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230145501,
					"content": "Ach ... Lutong, bitte stütze mich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145502
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145502,
					"content": "Du solltest am besten zurückgehen und ein Nickerchen einlegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145503
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145503,
					"content": "#{F#Reisende}{M#Reisender}, du kommst gerade richtig! Schnell, ich möchte dich um einen Gefallen bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145504
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145504,
					"content": "Was ist mit ihm los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145505
					]
				},
				{
					"id": 230145505,
					"content": "Kurz gesagt ... Herr Garcia hat zu viel Kaffee getrunken und kann nicht schlafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145506
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145506,
					"content": "Aber zum Glück ist es nur Kaffee, kein Wein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145507
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145507,
					"content": "Lutong, äh ... wir brauchen noch einige Abzeichen, die die Schatzräuber bei sich tragen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145508
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145508,
					"content": "#{F#Reisende}{M#Reisender}! Was machst du denn hier? Entschuldige, ich habe dich gerade nicht bemerkt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145509
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145509,
					"content": "Kannst du einige dieser Abzeichen für mich bringen? Ein paar davon sollten schon reichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145510,
						230145512
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145510,
					"content": "Du solltest eine Pause einlegen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145511
					]
				},
				{
					"id": 230145511,
					"content": "Alles gut, mir geht es gut. Mein Kopf ist klar ... nur meine Hände hören mir nicht zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145514,
					"content": "Jedenfalls wäre es schön, wenn du einige Abzeichen bringen könntest. Ich halte deine Bezahlung bereit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145515
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145515,
					"content": "Du kannst sie dir ... mir direkt bringen. Ich muss sie unter die Lupe nehmen, denn die Auflagerung muss diesmal perfekt sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145512,
					"content": "Kaffee allein kann das anrichten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145513
					]
				},
				{
					"id": 230145513,
					"content": "Es liegt nicht am Kaffee. Herr Garcia weigert sich zu schlafen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "Lutong"
				}
			]
		},
