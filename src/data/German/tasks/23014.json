			},
			"dialogs": [
				{
					"id": 230145001,
					"content": "Überlegen wir uns schnell ein Mittel zum Geldverdienen, Herr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145002,
					"content": "Ich habe von einem Theater in Sumeru gehört, in dem viele Theatergruppen jemanden für die Buchhaltung brauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145003
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145003,
					"content": "Außerdem verdient die Bühnenbesetzung ... du weißt schon, sie verdient nicht schlecht, können aber nicht ihre eigenen Konten verwalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145004,
					"content": "Das ist unsere Gelegenheit, Herr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145005,
					"content": "Mein lieber Lutong, dein Sinn für Buchhaltung und Geschäfte ist außergewöhnlich ausgeprägt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145006,
					"content": "Ich brauche etwas Zeit. Lass mich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
