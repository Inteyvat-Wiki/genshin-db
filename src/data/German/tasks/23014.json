			},
			"dialogs": [
				{
					"id": 230140301,
					"content": "#Ich danke dir, {F#Reisende}{M#Reisender}! Diese Abzeichen reichen mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140302,
					"content": "Ich muss die Zahnräder zuerst neu bauen ... Hm, nein, vielleicht sollte ich zuerst die Sache mit den Achslagern klären ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140303,
					"content": "#Hier ist deine Bezahlung, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140304
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140304,
					"content": "Der jetzigen Sachlage nach zu urteilen, schätze ich, dass unsere Zusammenarbeit noch lange andauern wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140305
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140305,
					"content": "Ach, Herrn Garcias Geschäftsbücher zu führen ... bereitet mir so große Kopfschmerzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
