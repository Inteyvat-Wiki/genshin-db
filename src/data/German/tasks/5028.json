			"dialogs": [
				{
					"id": 50280501,
					"content": "Das Leben der Ankömmlinge ist weitaus wertvoller, als du dir vorstellen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280502
					],
					"speakerTitle": "Xbalanque"
				},
				{
					"id": 50280502,
					"content": "Mit deinen eigenen Händen hast du die Hoffnung dieser Welt zerstört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280503
					],
					"speakerTitle": "Xbalanque"
				},
				{
					"id": 50280503,
					"content": "Wenn es mir doch vorherbestimmt war, zu scheitern, warum hast du dann solche Angst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280504
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280504,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280505
					],
					"speakerTitle": "Xbalanque"
				},
				{
					"id": 50280505,
					"content": "(Eine innere Sehnsucht, die uns antrieb, eine Pilgerreise zu unternehmen.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280506
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280506,
					"content": "(Wir taten uns zusammen und kämpften um die Chance, den Titel der Stärksten tragen zu dürfen.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280507
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280507,
					"content": "(Um unserer Träume willen brannten wir lichterloh, bis wir dann nicht mehr brannten ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50280508
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 50280508,
					"content": "(Und so setzt sich dieser Kreislauf fort, immer und immer wieder ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mavuika"
				}
			]
		},
