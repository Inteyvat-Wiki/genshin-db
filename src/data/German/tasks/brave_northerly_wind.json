					}
				]
			},
			"dialogs": [
				{
					"id": 790740101,
					"content": "#Ah, zwei weitere tapfere Krieger{F#innen} treten auf den Plan! Seid ihr hier, um „Boreale Böen“ zu spielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740102
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740102,
					"content": "Dann kommt, hier entlang! Ich freue mich, Zeuge eurer unvergleichlichen Flugkünste zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740103,
						790740104
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740103,
					"content": "He, beruhig dich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				},
				{
					"id": 790740105,
					"content": "Man braucht keinen kühlen Kopf, um zu fliegen, lieber Gast, ganz und gar nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740106
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740106,
					"content": "Ein kühler Kopf stumpft nur den Sinn für den Wind ab. Nur wer sich dem stürmischen Wind völlig unvorbereitet stellt, kann sein wahres Potenzial entdecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740107
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740107,
					"content": "Die Flughörnchen von heute sind viel zu ängstlich! Sie haben die Lektionen, die der „Mutige Nordwind“ ihnen erteilt hat, völlig vergessen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740108
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740108,
					"content": "Sie verharren nur sicher am Rand und bewundern, wie mutig die Blätter mit dem Wind tanzen, trauen sich aber selbst nicht, ins Getümmel zu springen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740109
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740109,
					"content": "Wie können wir das Königreich an der Seite der Prinzessin schützen, wenn die Dinge so weitergehen? Lächerlich! Lächerlich, sage ich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740110
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740110,
					"content": "Mensch, dieses Flughörnchen ist wirklich ein energiegeladenes Kerlchen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790740111,
					"content": "Er scheint das Fliegen wirklich zu lieben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740112
					]
				},
				{
					"id": 790740112,
					"content": "Und deshalb habe ich mir einige Passagen mit besonders starken Windpfaden ausgesucht und dort alle möglichen Vorrichtungen aufgestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740113
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740113,
					"content": "Nur der tapferste, der kühnste und der kämpferischste Flieger schafft es durch diesen Windpfad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740114
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740114,
					"content": "Na, ihr beiden, habt ihr den Mut dazu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740115,
						790740117
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740115,
					"content": "Ich möchte es mal ausprobieren!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740116
					]
				},
				{
					"id": 790740116,
					"content": "Ausgezeichnet! Dann folge mir! Die Windpfade sind nicht weit von hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740117,
					"content": "Ich habe noch etwas zu tun ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740118
					]
				},
				{
					"id": 790740118,
					"content": "Oh? Du brauchst also noch etwas Zeit, um dich vorzubereiten? Keine Sorge, ich werde hier warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740119
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740119,
					"content": "Kommt wieder, wann immer ihr diesen Windpfad bezwingen wollt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740104,
					"content": "Ich habe noch gar nichts gesagt!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				}
			]
		}
	]
}