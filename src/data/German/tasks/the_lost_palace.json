					}
				]
			},
			"dialogs": [
				{
					"id": 762040201,
					"content": "Nicole ... Seltsam, hier ist auch niemand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040202,
					"content": "Seid ihr schon in meinem Atelier? Ist euch meine Blumensammlung aufgefallen? Ich züchte Proben, die ich in der ganzen Welt gesammelt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040203,
					"content": "*seufz* Ich fürchte, ich kann mich gerade nicht losreißen. Ich habe einen Stand in Fontaine eröffnet, an dem ich Skulpturen verkaufe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040204,
					"content": "Ähm .. Brauchst du unsere Hilfe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762040205
					]
				},
				{
					"id": 762040205,
					"content": "Nein, danke. Das ist meine einzige Möglichkeit, etwas zu Papier zu bringen, auch wenn ich meistens nur Zahlen aufschreibe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040206,
					"content": "Aber ich weiß, dass ihr nicht oft Zeit habt, vorbeizukommen, also fangt ruhig ohne mich an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040207,
					"content": "Übrigens hab ich euch eine Schriftrolle dagelassen. Ich glaube, ich habe sie neben eine Finkenstatue an der westlichen Wand gelegt. Warum versucht ihr nicht, sie zu finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040208,
					"content": "Gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040209,
					"content": "Dann lasst meinen stillen Begleiter euch auf eurem Weg helfen ... Viel Glück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620403,
			"completionStepIds": [
				7620403
