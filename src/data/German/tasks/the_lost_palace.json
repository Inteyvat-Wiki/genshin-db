						"position": [
							30.993,
							8.153,
							-53.597
						],
						"pointId": 38
					},
					{
						"sceneId": 1156,
						"position": [
							32.188,
							8.153,
							-53.602
						],
						"pointId": 39
					}
				]
			},
			"dialogs": [
				{
					"id": 762040301,
					"content": "Glückwunsch! Jetzt lasst mich mal schauen ... Mhm, gute Arbeit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040302
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040302,
					"content": "Anders als der jetzige Garten der Hexe war ich in diesem Schrein, als ich noch ein Engel war. Das war eine ganze Weile mein Zuhause.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040303
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040303,
					"content": "So viele Engel! Sieht so aus, als wärst du sehr beliebt gewesen, Nicole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040304,
					"content": "Ich will ja nicht angeben, aber früher haben alle gern meinen Geschichten gelauscht – besonders denen über mein Leben unter den Menschen, wie ich ihnen Zeichen schickte und sie beim Aufbau großer Zivilisationen leitete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040305,
					"content": "Immer wenn ich zu einer spannenden Stelle kam, hielten die anderen Engel den Atem an und hingen an meinen Lippen. Man konnte nicht mal das Zittern einer Harfensaite hören oder das Kratzen eines Pinsels auf einer Leinwand ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040306
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040306,
					"content": "Und dann blühten die ineinander verwobenen Farben und Töne. Es gab Musik und Licht, die alles in ihrer goldenen Pracht erhellten – eine Verzückung voller Jubel und Freude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040307,
					"content": "Das klingt wunderbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040308,
					"content": "Oh, das war es, Paimon ... das war es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040309,
					"content": "Auch wenn diese wunderbaren Tage vorbei sind, bleibt das Leben voller schöner Überraschungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040310,
					"content": "Moment ... Jemand hat tatsächlich die Frechheit besessen, meine Skulpturen zu stehlen, während ich meine Zeitung gelesen habe? Oh, das war’s für dich, mein dummer kleiner Freund! Ich werde dich höchstpersönlich bis nach Fort Méropide bringen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040311,
					"content": "Da sieht dieses Kerlchen mich Zeitung lesen und will meine Skulptur klauen?",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040312
					]
				},
				{
					"id": 762040312,
					"content": "Der ist geliefert!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040313
					]
				},
				{
					"id": 762040313,
					"content": "Ich werde ihm heute den Weg nach Fort Méropide zeigen!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		}
	]
}