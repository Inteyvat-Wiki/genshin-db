				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443601,
					"content": "(Ein Liebesroman von Dorothy Leeckson. Auf dem verblichenen Umschlag liegt eine Frau auf einem Bett, umgeben von Blumen).",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443602
					],
					"speakerTitle": "„Lavendelblüte“"
				},
				{
					"id": 750443602,
					"content": "(Nach dem Überfliegen des Buches fühlst du dich warm und zufrieden, aber du hast nichts Nützliches gelernt).",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443603
					],
					"speakerTitle": "„Lavendelblüte“"
				},
				{
					"id": 750443603,
					"content": "Also ... War es der Gärtner der Familie oder der Schwager der Cousine der besten Freundin? Ach, Paimons Kopf tut weh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7504437,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": []
			},
