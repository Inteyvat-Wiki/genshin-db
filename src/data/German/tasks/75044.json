			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750444701,
					"content": "(In kindischer und krakeliger Schrift geschrieben:)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444702
					],
					"speakerTitle": "Aufzeichnungen eines Kindes"
				},
				{
					"id": 750444702,
					"content": "Das Spiel heißt „Bing Bong Ding Dong“, und hier sind die Regeln:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444703
					],
					"speakerTitle": "Aufzeichnungen eines Kindes"
				},
				{
					"id": 750444703,
					"content": "1. Wenn der Bing-Bong-Monetoo nicht „Bamm!“ macht, reite auf dem Rücken der Saurier-Statue, damit sie sich vorwärts bewegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444704
					],
					"speakerTitle": "Aufzeichnungen eines Kindes"
				},
				{
					"id": 750444704,
					"content": "2. Steige von der Saurier-Statue ab, bevor der Bing-Bong-Monetoo bis „Bamm!“ zählt, sonst hast du verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444705
					],
					"speakerTitle": "Aufzeichnungen eines Kindes"
				},
				{
					"id": 750444705,
					"content": "3. Wer zuerst beim Bing-Bong-Monetoo angekommen ist, hat gewonnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444706
					],
					"speakerTitle": "Aufzeichnungen eines Kindes"
				},
				{
					"id": 750444706,
					"content": "Und sag mir nicht, dass es einfach „Ochs am Berg“ sei! Regeln sind wichtig, und gerade weil man sich nicht an die Regeln hält, kann man nicht gewinnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aufzeichnungen eines Kindes"
				}
			]
		}
	]
