						750444402
					],
					"speakerTitle": "Monetoo"
				},
				{
					"id": 750444402,
					"content": "Wenn man genau hinschaut, ist es wirklich seltsam, dass der einzige leere Krug derjenige vor diesem Monetoo ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444403,
					"content": "Kann es sein, dass die anderen Monetoo gefunden haben, was sie suchten, aber nicht dieser?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444404,
					"content": "#Armer Kerl ... Komm, {NICKNAME}, lass uns ihm helfen, die Dinge zu finden, die in diesem Krug sein sollten ... Hmm ... Was sollte aber da drin sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444405,
					"content": "(Platzieren)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
