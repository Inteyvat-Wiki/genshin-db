					"nextDialogs": [
						750444602
					],
					"speakerTitle": "Monetoo"
				},
				{
					"id": 750444602,
					"content": "Oh, das ist es also, wonach er sucht! Etwas mit roter Farbe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444603,
					"content": "Moment mal ... Hm? Die Sachen, die wir reingeworfen haben, sind verschwunden ... Wir haben doch was hineingeworfen, oder? Irgendwas stimmt nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444604,
					"content": "Befindet sich noch etwas anderes im Krug?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444605,
					"content": "(An den Krug klopfen)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7504447,
