				{
					"id": 750442402,
					"content": "„... die Handwerker Mahutzintl, Tlanalco und ... die für den Bau der Wasserpumpe verantwortlich waren ... verlangsamten sich absichtlich, was zu Verzögerungen führte ... Der Gütigste ... verhängte keine Strafe ... nur die Rationen für drei Wochen ausgesetzt ...“",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442403
					]
				},
				{
					"id": 750442403,
					"content": "„... Der <color=#00E1FFFF>Steinschlüssel</color> der <color=#00E1FFFF>Wasserpumpe</color> befindet sich ... Niemand darf ihn ohne Erlaubnis benutzen ... bis andere Handwerker beauftragt werden ...“",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
