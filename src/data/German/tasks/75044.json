			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442001,
					"content": "„... Landsleute, Familienmitglieder, Brüder und Schwestern, die sich dem unaufhaltsamen Triumph des Bündnisses verschrieben haben ...“.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442002
					]
				},
				{
					"id": 750442002,
					"content": "„... Der gütigste ... hat eine Reihe von neuen (...) Mechanismen zur Unterstützung des Transports, (...) und der <color=#00E1FFFF>Unterwasserbergung</color> bereitgestellt ...“.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442003
					]
				},
				{
					"id": 750442003,
					"content": "„Vorwärts! Vorwärts! Vorwärts, um jeden Preis ... Für die glorreiche Zukunft des Bündnisses, für unsere Freiheit und unseren Ruhm, für eine Heimat frei von den bösen Drachen.“",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442004
					]
				},
				{
					"id": 750442004,
					"content": "„... Ohne Erlaubnis ... ist es verboten, den <color=#00E1FFFF>Hebel</color> zu betätigen ... Unbeabsichtigte Stürze ... haben bereits den Tod von drei Arbeitern verursacht ...“",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504421,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442101,
					"content": "„... Hinter der nördlichen Steinmauer schlängelt sich ein kleiner Pfad nach oben. Anscheinend kann er als <color=#00E1FFFF>Lagerraum</color> verwendet werden ...“",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442102
					]
				},
				{
					"id": 750442102,
					"content": "„... Ich habe ein paar Markierungen hinterlassen, falls ich den Weg später vergesse ...“",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442103
					]
				},
				{
					"id": 750442103,
					"content": "„Sayanis Verletzungen sind schlimmer geworden. Das liegt an der Feuchtigkeit ... Ich habe ihr gesagt, sie solle sich ausruhen, aber sie hat nur gelacht ... Sie sagte, sie würde den Zug verlangsamen, was dazu führen würde, dass alle ihre zusätzlichen Getreidevorräte verlieren.“",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442104
					]
				},
				{
					"id": 750442104,
					"content": "„... Nachts, wenn niemand etwas bemerkt, bringe ihr eine Fackel, um ihre Wunden zu auszubrennen, sonst werden ihre Glieder abfaulen ...“.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
