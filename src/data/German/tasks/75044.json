			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440701,
					"content": "Die Saurierplattform auf der oberen Ebene ist den ganzen Tag geöffnet. Wenn du, egal ob Mensch oder Saurier, an Matahgas Spezialtraining teilnehmen möchtest, dann begib dich einfach zur Plattform und heb ab. Hinweis:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440702
					],
					"speakerTitle": "Auffälliger Slogan"
				},
				{
					"id": 750440702,
					"content": "Nur ein ernsthaftes, aktives Training ist ehrenvoll. Faulheit und Nachlässigkeit dagegen sind eine Schande!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440703
					],
					"speakerTitle": "Auffälliger Slogan"
				},
				{
					"id": 750440703,
					"content": "Wer heut nicht hart trainieren will, der wirft sein Leben in den Müll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440704
					],
					"speakerTitle": "Auffälliger Slogan"
				},
				{
					"id": 750440704,
					"content": "Mutig, fleißig, immer weiter, aus dir wird mal ein Saurierreiter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auffälliger Slogan"
				}
			]
		},
		{
			"id": 7504408,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440801,
					"content": "Die Reihenfolge ist: Blase erst ins linke Horn, dann ins Rechte, danach noch einmal ins Linke und ins Rechte. Ja nicht durcheinanderkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440802
					],
					"speakerTitle": "Matahga! Erinnern!!"
				},
				{
					"id": 750440802,
					"content": "Und füttere die Saurier besser mit Geflügelfleisch, damit sie dich nicht aus schlechter Laune heraus beißen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440803
					],
					"speakerTitle": "Matahga! Erinnern!!"
				},
				{
					"id": 750440803,
					"content": "(Scheint eine Art Erinnerungsnotiz von einem gewissen Matahga für sich selbst zu sein. Allein durch diese wenigen Zeilen kann man seine intensive Emotionalität spüren.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440804
					],
					"speakerTitle": "Matahga! Erinnern!!"
				},
				{
					"id": 750440804,
					"content": "(Wobei, hinter jede Zeile einer Erinnerungsnotiz ein Ausrufezeichen zu setzen ist genauso gut, wie wenn man es einfach lässt, oder?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga! Erinnern!!"
				}
			]
		},
		{
			"id": 7504417,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441701,
					"content": "„... Auf Befehl des Hüters des hei{RUBY#[D]Yajaw K’ahk’}ligen Feuers und des barmherzigen und ruhmreichen hei{RUBY#[D]Ti’sakhuun}ligen Herrschers, Seiner Ma{RUBY#[D]Kalomte}jestät, werden nun aus allen Stämmen Arbeiter für den Bau der Wasserschutzinfrastruktur rekrutiert ...“",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441702
					]
				},
				{
					"id": 750441702,
					"content": "„... Keine festen Quoten, alles basiert auf freiwilliger Teilnahme ... Aufbau des Bündnisses ... Wir hoffen, dass alle Stämme aktiv ...“",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504418,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441801,
					"content": "„... Auf Befehl des Hüters des he{RUBY#[D]Yajaw K’ahk’}iligen Feuers und des barmherzigen und ruhmrei{RUBY#[D]Ti’sakhuun}chen heiligen Herrschers, Seiner Ma{RUBY#[D]Kalomte}jestät, wird das verfluchte Land hiermit mit sofortiger Wirkung abgeriegelt. Allen Mitgliedern des Bündnisses ist der Zutritt strengstens untersagt.“",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441802
					]
				},
				{
					"id": 750441802,
					"content": "„Diejenigen, die ohne Genehmigung einreisen, werden offiziell als Feinde des Bündnisses anerkannt. Dies ist die gemeinsame Erklärung von (...) Nanatzcayan, Meztli, Huitztlan und Teteocan.“",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504419,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441901,
					"content": "„Ehre für immer dem Hüter des he{RUBY#[D]Yajaw K’ahk’}iligen Feuers, dem Großen Frie{RUBY#[D]Q’atal Tzij}densstifter, dem gütigsten Heiligen Herr{RUBY#[D]Ti’sakhuun}scher Och-Kan.“",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441902
					]
				},
				{
					"id": 750441902,
					"content": "„Da die Entwässerungsarbeiten in diesem Gebiet insgesamt nur langsam vorangehen, möchten wir gern kleinere Anpassungen am Rotationssystem vornehmen, um den unaufhaltsamen Siegeszug des Bündnisses zu gewährleisten.“",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441903
					]
				},
				{
					"id": 750441903,
					"content": "„Die Arbeitskräfte werden in drei Gruppen aufgeteilt, wobei jede Gruppe jeweils sechzehn Stunden arbeitet und alle zwei Tage wechselt. Gruppen, die sich durch besondere Leistungen auszeichnen, erhalten zusätzliche Getreidevorräte.“",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441904
					]
				},
				{
					"id": 750441904,
					"content": "„Der triumphale Sieg der <color=#00E1FFFF>Ableitung des aufgestauten Wassers</color> ist nur noch einen Schritt entfernt. Sobald die Kanäle fertig sind, wird die <color=#00E1FFFF>Wasserpumpe</color> wieder normal funktionieren. Nur Mut, strengt euch an!“",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504420,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
