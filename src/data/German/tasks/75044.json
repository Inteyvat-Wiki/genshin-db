			},
			"dialogs": [
				{
					"id": 750443801,
					"content": "(Das Buch von Jean Brooklyn, dem Dramatiker von Fontaine, ist so dick, dass kleine Menschen es als Schemel benutzen können.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Die Geschichte Teyvats – Teil I“"
				}
			]
