			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443701,
					"content": "(Biografie von Frank Drebin, pensionierter Inspektor der Sonderpolizei des Maréchaussée-Phantoms in Fontaine. Ja, der Inspektor ist eine kräftige weiße Katze).",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443702
					],
					"speakerTitle": "„Detektiv Schneepfote“"
				},
				{
					"id": 750443702,
					"content": "(Auf dem Umschlag dieses Buches ist ein großer Katzenpfotenabdruck abgebildet, vielleicht ein besonderes Andenken des Inspektors an seine Untergebenen).",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443703
					],
					"speakerTitle": "„Detektiv Schneepfote“"
				},
				{
					"id": 750443703,
					"content": "Ganz im Ernst ... man könnte sogar ein Buch über Paimon schreiben, mit dem Titel: „Die weißhaarige Detektivin!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7504438,
