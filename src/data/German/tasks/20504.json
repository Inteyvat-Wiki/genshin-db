				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Marjorie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205040101,
					"content": "Herzlich willkommen! Hier wirst du einzigartige Schätze finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040102
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040102,
					"content": "Da ist wirklich viel dabei, was ich noch nie gesehen habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040103,
					"content": "Hahaha! Natürlich sind das alles seltene Schätze, die von Abenteurern überall auf der Welt gefunden worden sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040104,
					"content": "Und? Interessierst du dich für ein Teil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040105,
						205040106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040105,
					"content": "Sieht alles sehr extravagant aus ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				},
				{
					"id": 205040107,
					"content": "Ach, ich habe ja vergessen dir zu sagen, dass wir hier Waren gegen Waren tauschen. Wir handeln nicht mit Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040108
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040108,
					"content": "Ich würde den Laden gern ausschmücken, wofür ich sehr viele <color=#00E1FFFF>„Anemo-Siegel“</color> brauche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040109
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040109,
					"content": "Habt ihr zufälligerweise <color=#00E1FFFF>„Anemo-Siegel“</color> dabei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040110,
						205040112
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040110,
					"content": "Wir haben da ein paar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040111
					]
				},
				{
					"id": 205040111,
					"content": "Haha! Dann scheint der Windgott eure Abenteuer wohl gutzuheißen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040114,
					"content": "Jedenfalls kannst du mir jederzeit diese <color=#00E1FFFF>„Anemo-Siegel“</color> bringen und gegen alle möglichen Dinge, die du im Laden findest, eintauschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040115
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040115,
					"content": "Waren aussuchen",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205040112,
					"content": "Was ist das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040113
					]
				},
				{
					"id": 205040113,
					"content": "Das ist eine Art Siegel, die der Windgott den Abenteurern verleiht, die er für würdig hält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040106,
					"content": "Ich wage es kaum, nach dem Preis zu fragen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				}
			]
		},
		{
			"id": 2050403,
			"completionStepIds": [
				2050403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2050403",
							"2"
						],
						"stepId": 2050403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Marjorie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205040301,
					"content": "<color=#00E1FFFF>„Anemo-Siegel“</color> können überall in und um Mondstadt herum auftauchen. Wenn du nicht genügend hast, kannst du dich auf die Suche machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040302
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040302,
					"content": "Du brauchst die Siegel wirklich nur als Schmuck?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040303
					]
				},
				{
					"id": 205040303,
					"content": "Ja klar, schließlich sind sie ein Geschenk des Windgottes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040304,
					"content": "Haha, scharfsinnig seid ihr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040305
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040305,
					"content": "Eigentlich steckt ein wenig mehr dahinter. Das den Leuten zu erklären, ist aber immer etwas schwierig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040306
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040306,
					"content": "Ich brauche die <color=#00E1FFFF>Anemo-Siegel</color>, weil sie ganz besondere Eigenschaften haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040307,
						205040309
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040307,
					"content": "Sag Bescheid, wenn du damit fertig bist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040308
					]
				},
				{
					"id": 205040308,
					"content": "Haha, auf jeden Fall! Du wirst überrascht sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040312,
					"content": "Ich seid jederzeit herzlich willkommen! Bringt bei Gelegenheit so viele <color=#00E1FFFF>Anemo-Siegel</color> mit, wie ihr finden könnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040313
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040313,
					"content": "Wenn ihr andere tolle Schätze findet, könnt ihr auch gern vorbeischauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040309,
					"content": "Meinst du nicht, dass du da etwas übertreibst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040310
					]
				},
				{
					"id": 205040310,
					"content": "Neugierig bin ich aber schon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040311,
					"content": "Haha! Verraten werde ich noch nichts. Sonst geht die ganze Vorfreude verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "Marjorie"
				}
			]
		}
	]
}