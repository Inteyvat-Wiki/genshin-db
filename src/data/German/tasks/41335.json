							"4133507"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350701,
					"content": "Und, konntest du den Vaniloqua-Nektar besorgen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350702
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350702,
					"content": "Hier ist er.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350703
					]
				},
				{
					"id": 413350703,
					"content": "Wie sieht es aus? Oh, na bitte ... Ja, das sollte genügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350704
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350704,
					"content": "Sobald die Farbe fertig ist, brauchen wir bloß noch eine passende Landschaft. Dann kann ich malen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350705
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350705,
					"content": "Hmph, dieser Poet soll nur abwarten, bis er mein Gemälde sieht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350706
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350706,
					"content": "Ah, jetzt erinnere ich mich! In Liyue ist es Tradition, während des Laternenrituals Laternen steigen zu lassen. Man schreibt sogar Wünsche darauf, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350707
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350707,
					"content": "Hehehe, nun, ich habe eine Laterne hier, und was den Wunsch betrifft ... Nun, den verrate ich dir nicht, sonst erfüllt er sich nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350708
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350708,
					"content": "Oh, fast hätte ich es vergessen, das ist für dich. Sieh es als Belohnung. Danke für die Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350709
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350709,
					"content": "Ich kann es kaum erwarten, das Gesicht dieses Poeten zu sehen, wenn er mein Bild sieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
