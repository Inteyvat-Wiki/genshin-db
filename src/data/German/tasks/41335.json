			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350101,
					"content": "So stimmt es nicht, so aber auch nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350103
					]
				},
				{
					"id": 413350103,
					"content": "Oh, hallo. Ich sammle bloß einige Materialien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350104,
					"content": "Da das Laternenritual in vollem Gang ist, wollte ich ein Gemälde malen, das den Hafen von Liyue während des Fests zeigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350105,
					"content": "*seufz* Vielleicht liegt es an meiner Maltechnik oder so. Aber was ich auch tue, das Bild fühlt sich einfach nicht richtig an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350106,
					"content": "Ein Ortswechsel könnte mir guttun, doch mir fällt kein besserer Ort ein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350107
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350107,
					"content": "#{F#Reisende}{M#Reisender}, kennst du vielleicht ein paar hübsche Plätze, an denen sich gut malen lässt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350108,
					"content": "Wir werden uns mal umsehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350109
					]
				},
				{
					"id": 413350109,
					"content": "Oh, gut. Dann sehen wir uns doch gemeinsam um. Vielleicht finden wir ein hübsches Plätzchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
		{
			"id": 4133503,
			"completionStepIds": [
				4133503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4133503",
							"2"
						],
						"stepId": 4133503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413350301,
					"content": "Hier hat man einen guten Blick auf die Landschaft ... Oh, wer ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350302
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350302,
					"content": "Ich bin Qingzhou und ich bin so kühn, mich als Poet zu bezeichnen. Und du bist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350303
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350303,
					"content": "Ah, du bist also ein Poet. Haha. Tja, ich bin ein Maler auf der Suche nach ein paar inspirierenden Motiven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350304
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350304,
					"content": "Inspiration, sagst du? So ein Zufall. Ich selbst strebe ebenfalls nach der Muse. Dürfte ich so kühn sein, zu fragen, aus welchem Grund du nach Inspiration strebst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350305,
					"content": "#Sicher, ich möchte den Hafen von Liyue während des Laternenrituals malen. {F#Diese Reisende}{M#Dieser Reisende} hier hilft mir bei der Suche nach dem passenden Ort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350306
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350306,
					"content": "Und dürfte ich fragen, aus welchem Grund du nach Inspiration strebst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350307
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350307,
					"content": "Ja, wahrhaftig ein Zufall. Ich möchte ebenfalls ein Gedicht über den Hafen von Liyue während des Laternenrituals verfassen und suche dafür nach Inspiration wie du.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350308
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350308,
					"content": "Verstehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350309
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350309,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350310
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350310,
					"content": "Ist ein Gedicht dafür nicht zu simpel? Wie könnten ein aufregendes Fest wie das Laternenritual und der Hafen von Liyue in ein paar wenige Zeilen passen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350311
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350311,
					"content": "Ha, wenn du mich fragst, kann nur ein großes Gemälde das Wesen des Fests einfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350312
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350312,
					"content": "Ein großartiges Gemälde? Hehe, an so einem Werk wären Farbe und Pinsel bloß vergeudet. Ein Gemälde könnte nie den feinen Geist des Laternenrituals und den von Liyue einfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350313,
					"content": "Und wie soll ein Gemälde die erhabene Größe eines Landes wie Liyue porträtieren können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350314
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350314,
					"content": "Haha, ich glaube, ein Gemälde würde besser passen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350315
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350315,
					"content": "Hehe, und ich glaube, ein Gedicht würde besser passen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350316
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350316,
					"content": "Oha, beruhigt euch, ihr beiden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350317
					]
				},
				{
					"id": 413350317,
					"content": "So ein Streit führt zu nichts. Ich schlage vor, wir beide erschaffen ein Werk, das den Hafen von Liyue während des Laternenrituals behandelt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350318
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350318,
					"content": "Sind beide abgeschlossen, können wir sie ausstellen und jemanden zur Beurteilung einladen. Was meinst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350319
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350319,
					"content": "Ich nehme deinen Vorschlag an. Ich erwarte dich nach Abschluss deines ... Gemäldes beim Gasthaus Wangshu. Dann werden wir einen unabhängigen Kunstrichter darum ersuchen, unser Werk zu kritisieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350320
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350320,
					"content": "Gut, wir sind uns einig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350321
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350321,
					"content": "Abgemacht. Wenn du mich entschuldigst, ich werde aufbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350322
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 413350322,
					"content": "Für einen Poeten ist er ziemlich vorlaut. Er glaubt tatsächlich, das Laternenritual und der Hafen von Liyue lassen sich in so kleiner Form einfangen, ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350323
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350323,
					"content": "Dem werd ich’s zeigen! Gegen mein fertiges Gemälde hat er keine Chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350324
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350324,
					"content": "All meine Kreativität wird hinein fließen. Für dieses eine Werk werde ich sogar ein paar spezielle Farben und Pinsel verwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350325
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350325,
					"content": "#{F#Reisende}{M#Reisender}, dürfte ich dich damit behelligen, ein paar spezielle Materialien für mich zu besorgen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350326,
						413350328
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350326,
					"content": "Überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350327
					]
				},
				{
					"id": 413350327,
					"content": "Gut, ich zähle auf dich. Jetzt lass mich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350329
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350329,
					"content": "Oh, ich benötige Vaniloqua-Nektar von einer Pyro-Vaniloqua.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413350330
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350330,
					"content": "Damit kann ich eine besondere Farbe anmischen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 413350328,
					"content": "Was für Materialien brauchst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413350329
					]
				}
			]
		},
		{
