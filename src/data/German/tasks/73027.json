			"dialogs": [
				{
					"id": 730270101,
					"content": "Wer das auch sein mag, die Tore der Akademie stehen ihm weit offen, solange er ein suchendes Herz pflegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270102
					],
