				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270301,
					"content": "Der leuchtende Gegenstand sollte das Chaos-Getriebe des Ruinenriesen sein, von dem Jazari gesprochen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270302,
					"content": "Es wird zwar von Zweigen und Reben versiegelt, aber etwas scheint herauszufließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270303,
					"content": "*schluchz* Schmutz! Ararycan spürt, dass er die Ursache für die Krankheit des Waldes ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270304
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270304,
					"content": "Was treiben die Abgrundmagier neben den großen Ästen dort? Bestimmt führen sie nichts Gutes im Schilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270305,
					"content": "Paimon erinnert sich, wie Jazari erwähnt hat, dass das Siegel des Kerns beschädigt wurde. Sind die Abgrundmagier daran Schuld?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270306,
					"content": "Wie auch immer, Ararycan sollte ein Versteck suchen gehen. Wir werden uns um sie kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302704,
			"completionStepIds": [
				7302714
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
