			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ararycan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730270401,
					"content": "Das war’s dann also.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270402,
					"content": "Ehrlich gesagt, ein langes Abenteuer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270403,
						730270406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270403,
					"content": "Wenn wir Jazari davon erzählen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270404
					]
				},
				{
					"id": 730270404,
					"content": "Stimmt. Wenn er über den Kern Bescheid weiß, kann er uns bei den Fördermitteln behilflich sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270405,
					"content": "#Paimon möchte der Akadamie aber nicht beitreten. Du auch nicht, {NICKNAME}, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270409,
					"content": "Wir wissen zwar nicht, in welcher Beziehung die „Inkarnation von Marana“ zum Orden des Abgrunds steht, aber trotzdem haben wir eine Wohltat vollbracht, indem wir den Wald von seiner „Krankheit“ befreit haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270410,
					"content": "*schluchz* Ararycan ist euch zu großem Dank verpflichtet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270411
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270411,
					"content": "Nichts zu danken, Ararycan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270412
					]
				},
				{
					"id": 730270412,
					"content": "Was hast du als Nächstes vor, Ararycan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270413,
					"content": "Ararycan wird am Utsava-Fest teilnehmen, aber ich mache mir große Sorgen über die „Krankheit“ des Waldes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270414
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270414,
					"content": "Vielleicht kommen die Bösewichte wieder zurück, die den Wald krank machen möchten. Ararycan muss den Wald beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270415
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270415,
					"content": "Also wird Ararycan nach dem Utsava-Fest hierher zurückkehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270416
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270416,
					"content": "Auch die Aranara haben eine schwere Verantwortung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270417
					]
				},
				{
					"id": 730270417,
					"content": "Falls du Hilfe brauchst, Ararycan, komm unbedingt zu uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270418,
					"content": "Ja, Ararycan weiß Bescheid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270419
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270419,
					"content": "Hehe, pass gut auf dich auf. Wir werden uns bestimmt wieder begegnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270406,
					"content": "Wenn wir Royinjan davon erzählen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270407
					]
				},
				{
					"id": 730270407,
					"content": "Oh! Royinjan sagt bestimmt: „Eine aufregende Geschichte.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270408,
					"content": "Wer hätte gedacht, dass wir tatsächlich den Wald gerettet haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}