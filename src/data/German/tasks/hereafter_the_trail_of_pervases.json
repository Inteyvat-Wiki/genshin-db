					"Wang Ping’an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350201,
					"content": "Hm? Was machst du denn hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350202
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350202,
					"content": "Bist du auch hier, um Pervases zu sehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350203
					]
				},
				{
					"id": 710350203,
					"content": "Ich bin nur vorbeigekommen und habe einen Moment angehalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350204
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350204,
					"content": "Weshalb seid ihr gekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350205
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350205,
					"content": "Wir sind hier, um Pervases zu sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350206,
					"content": "Trotzdem ist es hier das gleiche Chaos wie beim letzten Mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350207,
					"content": "Offensichtlich wurden ein Tempel gebaut und eine Statue angefertigt ... Warum ist nicht jemand gekommen und hat sie instand gehalten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350208,
					"content": "Vielleicht vergessen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350209
					]
				},
				{
					"id": 710350209,
					"content": "Kann man das vergessen? Ein Yaksha war schließlich ein großer Held, der Liyue beschützt hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350211
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350211,
					"content": "Xiao, bist du böse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350212,
					"content": "Nein. Die Mission der Yaksha ist es, zu beschützen, nicht, dass man sich ihrer erinnert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350213
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350213,
					"content": "Genug davon, kommen wir schnell zu den gegrillten Tigerfischen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350214,
					"content": "Nun ... wenn du auch essen willst, Xiao, können wir jeweils die Hälfte des gegrillten Tigerfisches für dich abschneiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350215,
					"content": "Nicht nötig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350216
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350216,
					"content": "Hilfe! Ich brauche Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350217
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350217,
					"content": "Was war das für ein Geräusch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350218,
					"content": "Es hörte sich an, als würde jemand um Hilfe rufen. Dort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350219
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350219,
					"content": "Los!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350220
					]
				},
				{
					"id": 710350220,
					"content": "Was? Packt den gegrillten Tigerfisch ein! Paimon hat ihn noch nicht gegessen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
