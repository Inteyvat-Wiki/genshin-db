			"dialogs": [
				{
					"id": 710350301,
					"content": "Danke, Meister, danke, Held ... Was für ein Zufall, dich wieder zu treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350302
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350302,
					"content": "Kennst du uns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350303,
					"content": "Wie könnte ich das vergessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350304
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350304,
					"content": "Wer bist du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350305
					]
				},
				{
					"id": 710350305,
					"content": "Mein Name ist Wang Ping’an! Erinnerst du dich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350306,
						710350308
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350306,
					"content": "„Nach den Sternen greifender Himmelsfürst“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350307
					]
				},
				{
					"id": 710350307,
					"content": "Was? Nein, nein, nenn mich bitte nicht so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350310,
					"content": "Ich wollte gerade einen Tempel in den Bergen besuchen, der dem Yaksha „Pervases“ gewidmet ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350311
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350311,
					"content": "Doch kurz nachdem ich den Berg betreten hatte, geriet ich ins Visier dieser Gruppe von Schatzräubern ... Danke an den Meister, der mich rettete.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350312
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350312,
					"content": "Moment mal, was machst du in Pervases’ Tempel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350313,
					"content": "Willst du seiner Statue etwas Böses antun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350314,
					"content": "Nein! An so etwas würde ich nie denken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350315
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350315,
					"content": "Was hast du denn vor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350316
					]
				},
				{
					"id": 710350316,
					"content": "Ich wollte... diesen Tempel neu gestalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350317
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350317,
					"content": "Ich bin heute vorbeigekommen, weil ich mir diesen Tempel noch einmal genauer ansehen wollte, um die Materialien zu besorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350318
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350318,
					"content": "Unerwartet wurde ich auf halbem Weg von einer Gruppe von Schatzräubern angegriffen und musste fliehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350319
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350319,
					"content": "Aber ich rannte und rannte und ... verirrte mich. Du weißt, was danach geschah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350320
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350320,
					"content": "Gehen wir rüber zum Tempel, erzähl uns mehr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350321
					]
				},
				{
					"id": 710350321,
					"content": "Ja, das ist nicht der richtige Ort zum Reden, lass uns erst zum Tempel gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350322
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350322,
					"content": "Wenn du etwas zu sagen hast, lass uns dort drüben darüber reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350323
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350323,
					"content": "Geht ihr nur, ich habe zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350324
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350324,
					"content": "Ooh, du willst schon gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350325,
					"content": "Und schon ... ist er weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350308,
					"content": "Ich erinnere mich an dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350309
					]
				},
				{
					"id": 710350309,
					"content": "Das ist gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "Wang Ping’an"
				}
			]
		},
		{
			"id": 7103504,
			"completionStepIds": [
				7103508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103508",
							"2"
						],
						"stepId": 7103508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang Ping’an",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350401,
					"content": "Der Tempel ist immer noch so baufällig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350402
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350402,
					"content": "Warum willst du plötzlich den Tempel reparieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350403,
					"content": "Ja, es ist eine lange Geschichte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350404
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350404,
					"content": "Ich habe schon eine Menge Informationen gesammelt, um mich als Adept auszugeben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350405
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350405,
					"content": "Habe ich nicht ein Gelübde des Gehorsams gegenüber dem Guten abgelegt, nachdem ich bei dieser Gelegenheit vom Meister unterrichtet wurde? Als ich zurückkam, wollte ich all diese Informationen vernichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350406
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350406,
					"content": "Aber dann dachte ich, anstatt diese Informationen zu vernichten, würde ich sie und die Taktiken, die ich bei meiner Täuschung angewandt habe, zusammenstellen und sie an andere weitergeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350407
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350407,
					"content": "Dies kann helfen, einige Betrüger zu erkennen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350408
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350408,
					"content": "Ich hatte nicht erwartet, dass die von mir erstellte Broschüre wirklich vielen Menschen bei der Betrugsbekämpfung helfen würde, und selbst die Mitarbeiter des Rats für Allgemeine Angelegenheiten sagten, dass meine Broschüre sehr nützlich sei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350409
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350409,
					"content": "Zusätzlich zu dem Teil, den ich selbst geschrieben habe, bat man mich, weitere Inhalte zur Betrugsprävention aufzunehmen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350410
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350410,
					"content": "Der Rat für Allgemeine Angelegenheiten hat mir dafür viel Geld gezahlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350411
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350411,
					"content": "Zusätzlich zu dieser Broschüre arbeite ich an einem weiteren Buch über den „Schützenden Yaksha“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350412
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350412,
					"content": "Ich möchte dieses Buch nutzen, um allen die Geschichte des „Schützenden Yaksha“ nahezubringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350413
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350413,
					"content": "Dabei konnte ich mein ganzes Wissen anwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350414
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350414,
					"content": "Dieser Tempel des „Pervases“ wurde ebenfalls entdeckt, als ich mein Buch über den „Schützenden Yaksha“ schrieb.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350415
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350415,
					"content": "Es heißt, dass der Tempel ursprünglich von den Vorfahren zum Gedenken an Pervases, einen Yaksha, errichtet wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350416
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350416,
					"content": "Aber als ich diesen Tempel fand, hatte ich wirklich nicht erwartet, dass er in einem derartigen Zustand sein würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350417
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350417,
					"content": "Als ich zurückkam, dachte ich darüber nach und beschloss schließlich, die Kosten selbst zu tragen und den Tempel wieder aufbauen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350418
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350418,
					"content": "Schließlich habe ich es den Lehren des Meisters zu verdanken, dass ich auf den richtigen Weg zurückkehren konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350419
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350419,
					"content": "Die Wiederherstellung dieses Tempels ist ein Weg, um für all die Fehler zu büßen, die ich zuvor begangen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350420
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350420,
					"content": "Nun ... das klingt nicht nach etwas Erfundenem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350421,
					"content": "#{NICKNAME}, was denkst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350422,
						710350424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350422,
					"content": "Es klingt echt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350423
					]
				},
				{
					"id": 710350423,
					"content": "Was soll das heißen, es klingt echt? Es ist echt, es ist wahr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350426,
					"content": "Vergiss es, du kannst denken, was du willst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350427
					],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350427,
					"content": "Wenn du mir wirklich nicht glaubst, komm nach dem offiziellen Baubeginn und überzeug dich selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping’an"
				},
				{
					"id": 710350424,
					"content": "Du warst schon vorher ein Betrüger ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350425
					]
				},
				{
					"id": 710350425,
					"content": "Das bin ich jetzt nicht mehr! Ich bin jetzt ein anständiger Mensch, habe ich nicht vor dem Meister ein Gelübde abgelegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "Wang Ping’an"
				}
			]
		},
