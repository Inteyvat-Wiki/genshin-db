			"dialogs": [
				{
					"id": 710350101,
					"content": "Was darf ich euch bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350102
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 710350102,
					"content": "Gegrillten Tigerfisch. Dreimal zum Mitnehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350103
					]
				},
				{
					"id": 710350103,
					"content": "Gut! Du kannst hier einen Moment warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350104
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 710350104,
					"content": "Drei Portionen? Eine für dich, eine für Paimon ... und eine für ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350105,
						710350106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350105,
					"content": "Ich möchte nach Pervases sehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				},
				{
					"id": 710350107,
					"content": "Meinst du den, der uns die Sieben-Sterne-Lampe und das Räuchergefäß geschenkt hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350108,
					"content": "Ach ja, Paimon erinnert sich, dass Pervases sagte, er vermisse es, Tigerfisch zu grillen und zu essen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350109,
					"content": "Aber Pervases sollte jetzt schon weg sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350110,
					"content": "Aber sehen wir mal nach.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350111
					]
				},
				{
					"id": 710350111,
					"content": "Lass uns gemeinsam hingehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350112,
					"content": "Als Paimon Pervases vorher dort gesehen hatte, war der Tempel schäbig und alt, außerdem schienen daneben Spuren einer Schatzräubergruppe zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350113,
					"content": "Hoffentlich wird die Statue von Pervases nicht beschädigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350114,
					"content": "Bitte sehr: Deine drei Bestellungen von gegrilltem Tigerfisch sind verpackt und stehen für dich bereit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350115
					],
					"speakerTitle": "Koch Mao"
				},
				{
					"id": 710350115,
					"content": "#Es riecht so gut! {NICKNAME}, also lass uns aufbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350106,
					"content": "Pervases mag gegrillten Tigerfisch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				}
			]
		},
