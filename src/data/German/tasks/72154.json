	"talks": [
		{
			"id": 7215401,
			"completionStepIds": [
				7215401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215401",
							"2"
						],
						"stepId": 7215401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540101,
					"content": "Warte! Herr Soldat, die Worte, die du gerade gelesen hast, sind nicht in der richtigen Stimmung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540102,
					"content": "„Samurai, wie ein klarer Wind, der über die Erde fegt.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540103
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540103,
					"content": "Du erinnerst dich daran, was ich dir vorher erzählt habe, oder? Einen Sinn für Spontanität und Unbeständigkeit. Spontanität, verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540104,
					"content": "Diese Zeile ist der Kern des ganzen Stücks. Du musst die Emotion komplett, vollständig und perfekt ausdrücken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540105,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540106
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540106,
					"content": "Und wenn du dein Schwert schwingst, sei nicht so schnell. Achte darauf, dass du immer im Bild bist, sonst kann die „Filmkamera“ dich nicht einfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540107,
					"content": "Erst die Haltung einnehmen, dann pausieren, verstanden? Pause. Dann hacke hart nach unten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540108,
					"content": "Aber du kannst dein Schwert nicht so schwingen, wenn du gegen jemanden kämpfst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540109
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540109,
					"content": "Es ist für die Handlung und die Produktion ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540110,
					"content": "Mach dich wieder bereit, lass uns es noch einmal machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540111,
						721540112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540111,
					"content": "Was macht ihr da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540114
					]
				},
				{
					"id": 721540114,
					"content": "#Oh, da bist du ja! Liebe{F# Reisende}{M#r Reisender}, eine gute Brise muss dich hierher geschickt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540115,
					"content": "Wie du sehen kannst, drehe ich mit diesem Soldaten einen „Schwertfilm“ mit dem Titel „Der siebte Samurai“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540116,
					"content": "Übrigens, „Schwertfilm“ ist der allgemeine Name für diese Art der „Filme“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540117,
					"content": "Ein „Film“, der Schwertkämpfe aufnimmt und dem Betrachter das Gefühl gibt, durch einen Schwertkampf zu gehen ... Das bedeutet es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540118,
						721540121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540118,
					"content": "Herr Toranosuke hat also Zeit ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540119
					]
				},
				{
					"id": 721540119,
					"content": "Laut der Verwaltung ist dies eine Handlung, die die übergeordneten Verwaltungen erlaubt haben. Es hilft auch, das Prestige der Bakufu-Samurai zu erhöhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540120
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540120,
					"content": "Obwohl, ich weiß nicht, wie Herr Xavier die übergeordneten Verwaltungen überzeugt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540123,
					"content": "Aber ehrlich gesagt, der Herr Genjirou ist wirklich ein ... sehr ernster, aber gleichzeitig sehr verständnisvoller Mann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540124,
					"content": "Nachdem ich ernsthaft mit ihm gesprochen hatte, stimmte er sehr gern meiner Bitte zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540125
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540125,
					"content": "Aber ... im Gegenzug musste ich zuerst einen „Film“ mit Bezug zum Bakufu produzieren, vorzugsweise mit einem Samurai als Hauptfigur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540126
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540126,
					"content": "Ich war schon an dieser Art von Themen interessiert, also habe ich natürlich zugestimmt, und das hat Herr Genjirou gefreut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540127
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540127,
					"content": "Herr Genjirou wies mir ein paar gute Soldaten zu, zusätzlich zu dem, der mit mir reisen sollte, und dann sagte er ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540128
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540128,
					"content": "„Das Prestige der Samurai und des Bakufu muss durch das Spektakel des Schwertkampfes demonstriert werden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540129
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540129,
					"content": "Ich muss sagen, Herr Genjirou hat wirklich eine ziemlich langfristige Vision, wenn er daran denkt, „Filme“ als Propagandamittel zu nutzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540130
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540130,
					"content": "Aber für mich gilt: Alles, was mir hilft, „Filme“ zu machen, werde ich nicht ablehnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540131,
						721540135
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540131,
					"content": "Läuft deine Produktion gut?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540132
					]
				},
				{
					"id": 721540132,
					"content": "Ehrlich gesagt ... nicht so sehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540133
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540133,
					"content": "Obwohl diese Soldaten alle hochqualifiziert in den Kampfkünsten waren, waren sie nicht an diesen „schauspielerischen Stil“ des Kampfes gewöhnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540134
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540134,
					"content": "Nicht nur, dass sie ihre Schwerter so schnell schwangen, dass die „Filmkamera“ sie nicht aufzeichnen konnte, sondern sie liefen manchmal auch aus dem Bild ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540140,
					"content": "#{F#Reisende}{M#Reisender}, wenn du Zeit hast, könntest du vor die Kamera gehen und es den Herren Soldaten vorspielen, nach dem Skript, das ich geschrieben habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540141,
					"content": "Ich bin sicher, dass du mit deiner Stärke und deinem Verständnis in der Lage sein wirst, mit Leichtigkeit vor die Kamera zu treten, wenn du schauspielerst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540142
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540142,
					"content": "Nachdem sie die Darbietung aus der Sicht eines Zuschauers gesehen haben, müssen sie das Stück besser verstanden haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540143
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540143,
					"content": "Komm schon, komm schon, lies zuerst das Drehbuch. Lies einfach den Text. Dieser Teil ist hauptsächlich eine Kampfszene ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540144,
						721540145,
						721540146,
						721540156
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540144,
					"content": "„Auch diese Schlacht gilt als verloren.“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540147,
					"content": "Ah, das sind Zeilen aus einer anderen Szene ... Diese hier ist hauptsächlich eine Kampfszene, nicht viel Text.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540148
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540148,
					"content": "Lass mich das Skript sehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540149
					]
				},
				{
					"id": 721540149,
					"content": "Ach ja, die Figur, die du spielst, heißt „Juusaburou“ und er wird zusammen mit ein paar Gefährten von den Bewohnern eines Dorfes angeheuert, um das Dorf zu beschützen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540150
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540150,
					"content": "Äh, es gibt noch einen Begleiter namens „Kyuuzou“, der in dieser Szene Zeilen hat ... Ich sage einfach diese Zeile und gehe erst einmal durch den Verlauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540151
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540151,
					"content": "Du musst diese Figur verstehen! Stell dir vor, du bist „Juusaburou“, verstanden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540152,
						721540153
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540152,
					"content": "Hmm, verstanden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540154,
					"content": "Das ist gut. Das ist sehr gut. Das ist großartig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540155
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540155,
					"content": "Sag mir Bescheid, wenn du bereit bist. Ich muss die Kameraposition einstellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540153,
					"content": "Ich bin „Juusaburou“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540145,
					"content": "„Ein Samurai ist immer noch ein Samurai, auch wenn er in Schwierigkeiten ist.“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540146,
					"content": "„Ihr seid alle qualifizierte Vogelscheuchen ...“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540156,
					"content": "„... aber der Feind ist kein Fink.“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540135,
					"content": "Kann ich eine Rolle spielen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540136
					]
				},
				{
					"id": 721540136,
					"content": "#Aber natürlich! Aber natürlich! Du bist für immer {F#die Heldin}{M#der Held} meines Herzens!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540137
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540137,
					"content": "Ich habe mich immer an diese „Tatara-Geschichten“ erinnert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540138
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540138,
					"content": "Und ... obwohl die Kampfkünste dieser Soldaten alle sehr stark waren, waren sie nicht ganz an diesen „schauspielerischen Stil“ des Kämpfens gewöhnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540139
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540139,
					"content": "Nicht nur, dass sie ihre Schwerter so schnell schwangen, dass die „Filmkamera“ sie nicht aufzeichnen konnte, sondern sie liefen manchmal auch aus dem Bild ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540121,
					"content": "Wie hast du ihn überzeugt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540122
					]
				},
				{
					"id": 721540122,
					"content": "Der Herr Soldat hat mich schon vor langer Zeit verstanden. Meine Hauptaufgabe war immer noch, diesen Herrn Mikoshi Genjirou zu überzeugen und ihn zu bitten, mir zu erlauben, „Filme“ in Inazuma zu drehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540112,
					"content": "„Samurai, wie ein klarer Wind, der über die Erde fegt.“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540113
					]
				},
				{
					"id": 721540113,
					"content": "Deine Worte sind zu gefühlsbetont. Sie sollten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540114
					],
					"speakerTitle": "Xavier"
				}
			]
		},
