			},
			"dialogs": [
				{
					"id": 721540401,
					"content": "„Schwertfilm“ ... Was für ein einzigartiger Name, den sich Herr Xavier ausgedacht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540402,
						721540407
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540402,
					"content": "Was hältst du von diesem „Film“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540403
					]
				},
				{
					"id": 721540403,
					"content": "Die Verwaltung glaubt, dass dieser „Film“ dazu beitragen würde, das Prestige der Bakufu-Samurai zu verbreiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540404
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540404,
					"content": "Vielleicht bin ich in dieser Hinsicht einfach nur ein bisschen stumpfsinnig ... Ich empfinde das wirklich nicht so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540405
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540405,
					"content": "Außerdem reden die Samurai in diesem Skript nur langweiliges Zeug und haben überhaupt keine Samurai-Würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540406
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540406,
					"content": "Ich frage mich, warum die Verwaltung da oben zugestimmt hat, runterzukommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540407,
					"content": "Wie geht es dem „Mikage-Hochofen“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540408
					]
				},
				{
					"id": 721540408,
					"content": "Seit der „Beförderung“ von Herrn Hanbei heißt der Verantwortliche dort drüben nun Yousuke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540409
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540409,
					"content": "Er war Handwerker von Beruf, sehr bodenständig und zuverlässig, und sehr gut in praktischen Dingen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540410
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540410,
					"content": "Er wird für den „Mikage-Hochofen“ verantwortlich sein, also sollte es keine weiteren Probleme geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				}
			]
		},
