			"dialogs": [
				{
					"id": 721540801,
					"content": "Worum genau geht es in dem „Film“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540802
					]
				},
				{
					"id": 721540802,
					"content": "Ah! Gute Frage, eine sehr gute Frage. Aber um ehrlich zu sein, habe ich auch nicht darüber nachgedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540803
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540803,
					"content": "Für mich kann ein „Film“ alles aufnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540804
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540804,
					"content": "Liebe, Spannung, Kämpfe und sogar gewisse nebulöse Legenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540805
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540805,
					"content": "Aber ich hatte schon immer das Gefühl, dass so etwas wie ein „Film“ einen gewissen Charme hat, den ich noch nicht ganz begreifen konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540806
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540806,
					"content": "Ich denke jedoch, dass ich eher eine Antwort erhalten kann, wenn ich mehr „Filme“ drehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
