				{
					"id": 721540301,
					"content": "#Perfekt! Wie von {F#der ewigen Heldin}{M#dem ewigen Helden} meines Herzens erwartet! Perfekte Darbietung! Du bist die Nummer eins!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540302,
						721540304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540302,
					"content": "Was ... welche Nummer eins?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540303
					]
				},
				{
					"id": 721540303,
					"content": "Die Nummer eins der Schauspieler ist der wichtigste Schauspieler im „Film“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540306,
					"content": "#Herr Soldat, hast du einen guten Blick auf das Spiel, das {F#die Reisende}{M#der Reisende} gerade gegeben hat, werfen können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540307,
					"content": "Ich verstehe es im Allgemeinen. Wenn ich ein Schwert schwinge, muss ich nicht die „Bewegung“ des Schwertschwingens betonen, sondern die „Haltung“ des Schwertschwingens, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540308
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540308,
					"content": "Wenn es nur um die „Stellung“ geht ... habe ich ein paar Ideen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540309
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540309,
					"content": "Oh? Das ist toll. Bitte geh und sprich mit dem Rest der Soldaten und wir machen es später noch einmal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540310
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540310,
					"content": "#{F#Reisende}{M#Reisender}, vielen Dank. Bitte nimm dies hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540311,
					"content": "Wie lautet der Titel des nächsten „Films“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540312
					]
				},
				{
					"id": 721540312,
					"content": "Ich bin eigentlich sehr zögerlich, es gibt so viele Themen für den nächsten „Film“ auszuprobieren ... nun ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540313,
					"content": "Zum Beispiel gibt es verschiedene Traditionen im Großen Narukami-Schrein und die Legende vom Tanuki und dem Fuchs, die von Inazuma überliefert wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540314,
					"content": "Es gibt so viele Inseln in Inazuma, es gibt einfach so viele Geschichten, die man sich ausdenken kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540315
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540315,
					"content": "Aber ich muss diesen „Siebten Samurai“ sowieso zuerst produzieren lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540316
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540316,
					"content": "Wenn ich die Herrschaften zufriedenstellen kann, wird es mir danach sicher viel leichter fallen, „Filme“ in Inazuma zu drehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540304,
					"content": "Nächstes Mal würde ich gern eine neue Rolle bekommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540305
					]
				},
				{
					"id": 721540305,
					"content": "Kein Problem! Sobald ich mit diesem „Film“ hier fertig bin, ist es Zeit für mich, meinen nächsten brandneuen „Film“ zu planen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
