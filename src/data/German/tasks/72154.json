					"content": "Ich bin bereit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540602
					]
				},
				{
					"id": 721540602,
					"content": "Gut, dann fangen wir mal an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540603
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540603,
					"content": "Ich stelle die „Kamera“ ein und sage den Soldaten, die sich draußen aufwärmen, dass sie alle zurückkommen sollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
