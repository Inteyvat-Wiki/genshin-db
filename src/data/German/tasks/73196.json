			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960901,
					"content": "Authentischer Wüstengrill! Mit dem geheimen Rezept der Soße von König Deshret und geröstet mit lokaler Harra-Würze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960902
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731960902,
					"content": "Leckeres Essen und leckere Getränke für jedermann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319610,
			"completionStepIds": [
				7319610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319610",
							"2"
						],
						"stepId": 7319610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961001,
					"content": "„Ich besaß einst endlosen Reichtum, aber kein Geld der Welt konnte meinem Herzen Frieden verschaffen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961002
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961002,
					"content": "„Nach dieser Reise besitze ich keine einzige Mora mehr, aber endlich fühle ich mich im Reinen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961003
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961003,
					"content": "„Wenn du dir meine Geschichte anhören möchtest, komme zu meinem Gemüseladen. Natürlich wäre es schön, wenn du ein bisschen Gemüse kaufst.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
