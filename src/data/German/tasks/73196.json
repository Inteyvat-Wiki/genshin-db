			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961401,
					"content": "Über die Inhaberschaft des Puspa-Kaffeehauses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961402
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961402,
					"content": "Der ursprüngliche Inhaber wurde während einer Wüstenexpedition vor drei Jahren vermisst gemeldet. In Übereinstimmung mit den Vorschriften wird die Verwaltung des Kaffeehauses an das Vahumana-Institut übertragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961403
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961403,
					"content": "Entschluss: Aufgrund des Widerrufs des Antragstellers wurde der Fall auf unbestimmte Zeit vertagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319615,
			"completionStepIds": [
				7319615
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319615",
