				}
			]
		},
		{
			"id": 7319602,
			"completionStepIds": [
				7319602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319602",
							"2"
						],
						"stepId": 7319602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960201,
					"content": "Die Börse stellt die Genauigkeit und Zuverlässigkeit aller bereitgestellten Informationen nach ihrem besten Vermögen sicher, kann jedoch nicht für deren Genauigkeit und Integrität in irgendeiner Form gewährleisten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960202
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731960202,
					"content": "Kunden können keine Ansprüche auf Verluste, die sich aus der vollständigen oder teilweisen Verwendung von Marktinformationen, die auf dieser Ankündigungstafel veröffentlicht werden, ergeben, geltend machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319603,
			"completionStepIds": [
				7319603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319603",
							"2"
						],
						"stepId": 7319603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960301,
					"content": "Hast du schon mal von der Schwebetechnik gehört? Hast du schon mal jemanden fliegen sehen? Möchtest du die Geheimnisse der fliegenden Packtiere entdecken? Dann verpasse nicht den ersten Auftritt der Künstlergruppe „Fontaine-Flieger“ in Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960302
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731960302,
					"content": "Herzlich Willkommen! Die Vorstellung läuft! Für nur fünf Mora kannst du dieser einzigartigen Kunstform beiwohnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960303
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731960303,
					"content": "Aufgrund von mehreren Meldungen der örtlichen Anwohner haben wir festgestellt, dass diese Aufführung nicht von der Akademie genehmigt wurde. Die Werbung wird sofort heruntergenommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319604,
			"completionStepIds": [
				7319604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319604",
							"2"
						],
						"stepId": 7319604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960401,
					"content": "Wir eröffnen eine Filiale in Sumeru! Vorfreude ist die größte Freude, verehrte künftige Kunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960402
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731960402,
					"content": "Solltest du etwas zu erledigen haben, wende dich bitte an Viktor, um es in unserer Liyue-Filiale erledigen zu lassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960403
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731960403,
					"content": "Wenn du einen Kredit in Erwägung ziehst, lass dich noch heute von einem Schuldeneintreiber beraten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319605,
			"completionStepIds": [
				7319605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319605",
							"2"
						],
						"stepId": 7319605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960501,
					"content": "Handgefertigte Teppiche, ein Meisterwerk aus Sumeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960502
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731960502,
					"content": "Jeder Anwohner von Sumeru sollte einen solchen Teppich im Leben besitzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960503
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731960503,
					"content": "Teppiche haben ihren Preis, aber die Kunst ist unbezahlbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319606,
			"completionStepIds": [
				7319606
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319606",
