			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961701,
					"content": "„Jeder von euch hat von Herrn Sangemah Bay gehört, also bedarf er keiner großen Vorstellung mehr.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961702
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961702,
					"content": "„Jedenfalls ist eine neue Teppichladung eingetroffen. Keine fliegenden Teppiche, aber besser als die von Sulaykha. Greift zu! Ihr wisst ja, wie’s läuft. Hehe!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961703
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961703,
					"content": "„He! Dori, du bist unverschämt!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		}
	]
