				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961301,
					"content": "Aufgrund von Beschwerden wurde Anis Färbewerkstatt wegen Verdacht auf Kleiderdiebstahl geschlossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961302
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961302,
					"content": "Ains Färbewerkstatt wurde leer vorgefunden. Wir arbeiten zurzeit daran, das gestohlene Eigentum der Verbraucher wiederzufinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319614,
			"completionStepIds": [
				7319614
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
