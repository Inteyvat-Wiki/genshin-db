						"stepId": 7319615,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961501,
					"content": "„Was den Großen Basar angeht, darf man das Theater Zubayr auf keinen Fall verpassen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961502
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961502,
					"content": "„Du sollst dich auf jeden Fall Nilous Tanzaufführung im Theater ansehen!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961503
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961503,
					"content": "„Wer Nilous Sabzeruz-Tanz versäumt, ist umsonst nach Sumeru gekommen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319616,
			"completionStepIds": [
				7319616
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319616",
							"2"
						],
						"stepId": 7319616,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961601,
					"content": "Strebe nach deinem Glück! Verlasse dein Zuhause und stich in See, um die Welt zu entdecken! Tritt jetzt der „Abensteuergilde“ bei und bezahle nur fünf Mora für den ersten Monat deiner Mitgliedschaft!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961602
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961602,
					"content": "Wahres Wissen ist nur durch Praxis erhältlich. Sein Leben auf einer beschwerlichen Reise zu verlieren, ist sinnvoller, als das ganze Leben auf der faulen Haut zu liegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961603
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961603,
					"content": "„Seht genau her! Das ist nicht die Abenteurergilde.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961604
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961604,
					"content": "„Was?! Ich habe für ein ganzes Mitgliedschaftsjahr bezahlt! Kann ich mein Geld zurückbekommen?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319617,
			"completionStepIds": [
				7319617
			],
			"beginWay": "TALK_BEGIN_MANUAL",
