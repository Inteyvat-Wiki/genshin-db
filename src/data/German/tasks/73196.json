				{
					"id": 731961101,
					"content": "Anis Färbewerkstatt! Exquisite Technik, um deiner Kleidung neuen Glanz zu verleihen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961102
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961102,
					"content": "„Hallo, wann bekomme ich meine Kleidung wieder, die ich letzten Monat zum Färben abgegeben habe?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961103
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961103,
					"content": "„Es tut mir so leid! Meine Frau hat gestern unser Kind zur Welt gebracht, ich hatte keine Zeit zum Arbeiten. Bitte komme morgen wieder, deine Kleidung wird pünktlich bereitstehen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961104
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961104,
					"content": "„Es ist schon drei Monate her. Ich möchte meine Kleidung nicht mehr färben, bitte gib sie mir einfach wieder.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961105
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961105,
					"content": "„Es tut mir so Leid! Deine Kleidung war schon fertig, aber sie wurde beim Trocknen gestohlen! Wenn du sie wiederhaben möchtest, solltest du nach dem Dieb fahnden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319612,
			"completionStepIds": [
				7319612
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319612",
							"2"
						],
						"stepId": 7319612,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731961201,
					"content": "Unser Unternehmen spezialisiert sich auf den Überseehandel und arbeitet langfristig mit leistungsstarken Flotten wie der „Crux-Flotte“ zusammen, um deine Waren sicher zu eskortieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961202
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961202,
					"content": "Diesen Sommer haben wir vier neue Routen für Rohstoffe wie Seide, Gewürze und Erz eröffnet. Unsere neuen Schiffe verfügen über große Frachtkapazitäten. Wir heißen alle Unternehmer willkommen, mit uns zusammenzuarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961203
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731961203,
					"content": "Bitte wende dich an unsere Inhaberin Farzaneh, wenn du eine ganze Route buchen möchtest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319613,
			"completionStepIds": [
				7319613
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319613",
							"2"
						],
						"stepId": 7319613,
						"stateName": "QUEST_STATE_UNFINISHED"
