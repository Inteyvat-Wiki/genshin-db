			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960601,
					"content": "Herausragende Qualität und niedrige Preise. Juts Gewürzladen ist stets zur Stelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960602
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731960602,
					"content": "Kaufe jetzt und erhalte ein gratis Geschenk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319607,
			"completionStepIds": [
				7319607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319607",
							"2"
						],
						"stepId": 7319607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960701,
					"content": "Wir führen ein großes Sortiment von Alltagsartikeln. Die Qualität unserer Waren wurde von unserem Inhaber persönlich geprüft, ein Qualitätssiegel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960702
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731960702,
					"content": "„Papa, kannst du mir mehr Mora leihen? Ich habe gehört, dass der Preis für Datteln bald in die Höhe schießen wird. Diesmal werden wir reich!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319608,
			"completionStepIds": [
				7319608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319608",
