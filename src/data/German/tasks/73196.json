			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960801,
					"content": "Wir suchen „Kazenis verlorene Goldstatuen“. Preis verhandelbar. Bitte wende dich direkt an unseren Ladeninhaber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960802
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 731960802,
					"content": "Solltest du Informationen haben, dann wende dich bitte an Khalid in Menakeris Boutique. Du wirst reichlich für deinen Aufwand entschädigt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7319609,
			"completionStepIds": [
				7319609
			],
