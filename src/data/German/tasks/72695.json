			"dialogs": [
				{
					"id": 726950201,
					"content": "Hm ... Die Elemente im Materialsammelgerät müssen nach jeder Sammlung in die Große Maschine übertragen werden, sodass ein Produktionszyklus drei Sammelfahrten erfordert ... Das scheint mir ein bisschen zu viel Arbeit zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950202
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950202,
					"content": "Ich muss einen Weg finden, das zu optimieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				}
			]
		},
		{
			"id": 7269503,
			"completionStepIds": [
				7269503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269503",
							"2"
						],
						"stepId": 7269503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950301,
					"content": "Wie läuft es mit dem Materialsammelgerät? Der Betrieb läuft reibungslos, hoffe ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950302
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950302,
					"content": "Ziemlich reibungslos.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950303
					]
				},
				{
					"id": 726950303,
					"content": "Auch das Materialsammelgerät ist mein ganzer Stolz. Ob es nun um das Sammeln von Materialien geht, wie wir es zuvor gemacht haben, oder um die Speicherung von elementaren Energien wie jetzt, es kann alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950304
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950304,
					"content": "Eigentlich habe ich mir überlegt, den Namen des Materialsammelgeräts zu ändern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950305
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950305,
					"content": "„Materialsammelgerät“ klingt gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950306,
						726950307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950306,
					"content": "Stimmt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				},
				{
					"id": 726950308,
					"content": "Wirklich? Ich dachte, dass dieser Name zu wenig Definition enthält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950309
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950309,
					"content": "Wie auch immer, gib mir das Materialsammelgerät. Der Probeproduktionslauf erfordert noch Beobachtungen, insbesondere wenn es um elementare Energie geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950310
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950310,
					"content": "Wir werden höchstwahrscheinlich erst weitermachen können, wenn sich die Elementarreaktionen innerhalb der Großen Maschine stabilisiert haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950311
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950311,
					"content": "Dann zähle ich auf euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950307,
					"content": "Sehr passend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950308
					]
				}
			]
		}
	]
}