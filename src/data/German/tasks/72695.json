			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bertrand"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726950101,
					"content": "Bertrand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950102,
					"content": "#Ihr seid es. {NICKNAME} und Paimon, ihr seid zum perfekten Zeitpunkt gekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950103
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950103,
					"content": "Meine einzigartige Große Maschine hat die Verarbeitung der von euch gesammelten Materialien abgeschlossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950104
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950104,
					"content": "Wie ist das gelaufen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950105
					]
				},
				{
					"id": 726950105,
					"content": "Schließlich ist dies eine Maschine, die ich geschaffen habe! Natürlich gab es überhaupt keine Probleme! Meine Techniken wurden in Fontaine ausgebildet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950106
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950106,
					"content": "Und natürlich kennt niemand die Funktionen und die Abläufe solcher Geräte besser als wir, das Volk von Fontaine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950107
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950107,
					"content": "Ich mache die übereilte Vorbereitung und fehlende Hilfe bei der Beschaffung der notwendigen Materialien für den Explosionsvorfall bei den bisher produzierten Spielzeugen verantwortlich. Diesmal wird es anders sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950108
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950108,
					"content": "Also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950109,
					"content": "Wenn es dieses Mal eine Explosion gibt ... Dann muss das, was explodiert ist, meine letzte Einlage und der Rest meines Lebens sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950110
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950110,
					"content": "Auch wenn ihr nicht an mich glaubt, könnt ihr an meine Entschlossenheit glauben, mein ganzes Leben dafür aufs Spiel zu setzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950111
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950111,
					"content": "Paimon hätte nie gedacht, dass die Spielzeugherstellung so viel Entschlossenheit erfordern würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950112,
					"content": "Wie dem auch sei, wir müssen mit dem nächsten Schritt unserer Arbeit beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950113
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950113,
					"content": "Sicherheitshalber möchte ich euch zuerst Folgendes fragen: Von den drei Prozessen haben wir den Prozess „Sammlung von Rohmaterial“ abgeschlossen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950114
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950114,
					"content": "Ist der nächste Schritt nun „Sammlung des Kerns“ oder „Sammlung der Energie“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950115,
						726950118
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950115,
					"content": "„Sammlung des Kerns“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950116
					]
				},
				{
					"id": 726950116,
					"content": "Wunderbar! Dass du mir sagst, du wüsstest es nicht! Wenn du wirklich gehst und tust, was du gesagt hast, wirst du später mein zerbrochenes Leben sammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950117
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950117,
					"content": "Die richtige Antwort lautet „Aufladung“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950121,
					"content": "Nun, alles in allem ... Diese Aufladung bedeutet, dass man beim Tragen des Materialsammelgeräts eine Zeit lang unter der Wirkung der Elemente bleibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950122
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950122,
					"content": "Wenn ich zum Beispiel die Hydro-Energie sammeln will, trage ich das Materialsammelgerät und stelle mich in einen Fluss. Und wenn ich Elektro...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950123
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950123,
					"content": "Muss man dafür vom Blitz getroffen werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950124,
					"content": "Oje, ich weiß nicht, also, ihr seid die Abenteurer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950125
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950125,
					"content": "Ich glaube, dass ihr stark genug seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950126
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950126,
					"content": "Stark genug ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950127
					]
				},
				{
					"id": 726950127,
					"content": "Eigentlich ist die Interaktion mit den elementaren Lebewesen wahrscheinlich der beste Weg. Während meiner früheren Reisen in Inazuma habe ich drei verschiedene Orte markiert, die von Elementarwesen häufig besucht werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950128
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950128,
					"content": "Eigentlich wollte ich mich mit dem Boot dorthin schleichen und selbst Kontakt zu diesen Kreaturen aufnehmen, wenn keine Hilfe käme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950129
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950129,
					"content": "Das ist zu gefährlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726950130,
					"content": "Aber jetzt habe ich euch! Geht und seht nach, ob es dort irgendwelche Elementarkreaturen gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950131
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950131,
					"content": "Ich zähle auf euch wegen der Aufladung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950118,
					"content": "„Sammlung der Energie“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726950119
					]
				},
				{
					"id": 726950119,
					"content": "Nun, richtig und falsch. Die richtige Antwort lautet nicht „Sammlung der Energie“, sondern „Aufladung“. Du hast doch nicht erwartet, dass ich dir zwei falsche Antworten gebe, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950120
					],
					"speakerTitle": "Bertrand"
				},
				{
					"id": 726950120,
					"content": "Das Lachen dieses Typen ist ziemlich nervig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726950121
					],
					"speakerTitle": "Paimon"
				}
			]
		},
