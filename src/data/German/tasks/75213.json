			"dialogs": [
				{
					"id": 752130201,
					"content": "Brauchst du Hilfe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130202
					]
				},
				{
					"id": 752130202,
					"content": "Echt? Das wäre super! Alle unsere Leute sind schon unterwegs, und jetzt haben wir auch noch eine Eilbestellung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130203
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130203,
					"content": "Hier in der Bestellung steht: „Für den <color=#00E1FFFF>Gast mit blauer Hose am Strand</color>“. Wichtig ist nur, dass es pünktlich ankommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130204
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130204,
					"content": "Vielen lieben Dank! Abgesehen von der Liefergebühr bekommst du auch das Rezept für unser Getränk dazu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hayaq"
				}
			]
		},
