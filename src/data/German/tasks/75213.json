				},
				{
					"id": 752130502,
					"content": "Hallo, hier ist dein Getränk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130503
					]
				},
				{
					"id": 752130503,
					"content": "Das ist für mich? Oh Mann! Hat der Himmel mein Gebet erhört?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130504
