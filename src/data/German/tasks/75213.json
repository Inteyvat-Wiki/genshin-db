			},
			"dialogs": [
				{
					"id": 752130601,
					"content": "Hallo, hier ist dein Getränk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130607
					]
				},
				{
					"id": 752130607,
					"content": "Achso! Ihr seid die mit dem Getränk! Ich habe mich schon gewundert, warum es so lange dauert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130608
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130608,
					"content": "Alles deine Schuld! In der Bestellung stand nämlich „für den Gast mit blauer Hose am Strand“, und du hast dich einfach im Sand vergraben ... wir haben ewig nach dir gesucht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130609,
					"content": "Du sollst uns doppelt so viel Liefergebühr bezahlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130610,
					"content": "Oh, tut mir echt leid! Ich habe das mit den Hosen ganz vergessen. Ich hätte die Hose einfach hinlegen sollen, dann hättet ihr mich leichter gefunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130611
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130611,
					"content": "Warum hast du dich überhaupt im Sand vergraben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130612
					]
				},
				{
					"id": 752130612,
					"content": "Na, weil’s Spaß macht! Ich habe gehört, viele machen das im Urlaub, also wollte ich’s mal ausprobieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130613
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130613,
					"content": "Aber deine Haltung war irgendwie seltsam. Du sahst aus wie ein Karottchen, das man in die Erde gesteckt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130614,
					"content": "Echt? Ist das schlimm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130615
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130615,
					"content": "Klar, so stolpern andere über dich und du selbst kannst dich auch verletzen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130617
					]
				},
				{
					"id": 752130617,
					"content": "Verstanden! Ich denke drüber nach. Oh, und hier ist eure doppelte Liefergebühr, danke euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aqo"
				}
			]
		},
