					"speakerTitle": "Blau gekleideter Besucher"
				},
				{
					"id": 752130402,
					"content": "Hallo, hier ist dein Getränk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130403
					]
				},
				{
					"id": 752130403,
					"content": "Mein Getränk? Ich habe doch gar keins bestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130404
					],
					"speakerTitle": "Blau gekleideter Besucher"
				},
				{
