			"dialogs": [
				{
					"id": 722480601,
					"content": "Nein, es müssen noch einige Vorbereitungen getroffen werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480602
					]
				},
				{
					"id": 722480602,
					"content": "Ich werde also hier sein und darauf warten, von dir zu hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				}
			]
		}
