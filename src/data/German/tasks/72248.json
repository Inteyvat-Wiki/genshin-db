					"content": "Ich bin bereit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480502
					]
				},
				{
					"id": 722480502,
					"content": "Dann wünsche ich dir ... viel Glück bei deinen Bemühungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				}
			]
		},
