			},
			"dialogs": [
				{
					"id": 762130201,
					"content": "Träume und Illusionen – warum sich die Mühe machen, sie zu fangen? Selbst wenn du tausend Jahre lang nach Antworten suchst, ohne die richtige Einsicht wirst du es nie verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130202,
						762130212
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130202,
					"content": "Also ... suchst du ein Buch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130203
					]
				},
				{
					"id": 762130203,
					"content": "Warst du schon mal hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130204,
						762130205,
						762130206
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130204,
					"content": "Hä?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130207,
					"content": "Dann verstehst du es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130208,
						762130209
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130208,
					"content": "Verstehen ... was denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130210,
					"content": "Wenn du schlafen willst, dann schlaf. Wenn du verstehen willst, dann verstehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130211
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130211,
					"content": "Geh erst mal zurück. Wenn die Welt untergeht, dann geh einfach mit ihr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130209,
					"content": "Und wie könnte ich es verstehen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130210
					]
				},
				{
					"id": 762130205,
					"content": "War ich schon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130206,
					"content": "War ich noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130207
					]
				},
				{
					"id": 762130212,
					"content": "Ich versteh nur Bahnhof. Ich bin dann mal weg.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130213
					]
				},
				{
					"id": 762130213,
					"content": "Geh geradeaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
				}
			]
		}
	]
