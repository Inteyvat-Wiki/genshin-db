			"dialogs": [
				{
					"id": 762130101,
					"content": "Nanu? Dieser Raum hier scheint mit Büchern vollgestopft zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762130102,
					"content": "Suchst du nach einem Buch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130103
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130103,
					"content": "Ähm ... eigentlich nicht. Paimon ist nur ein kleines bisschen neugierig, was da drinnen wohl ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762130104,
					"content": "Vielleicht kommen wir von der Seite rein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130105
					]
				},
				{
					"id": 762130105,
					"content": "Das funktioniert nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130106
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130106,
					"content": "Bücher verschieben, Bücher verschieben. Geschieht dies nicht, so ist man nie dort gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130107,
						762130109
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130107,
					"content": "Verstehe ich nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130108
					]
				},
				{
					"id": 762130108,
					"content": "Ich verschiebe Bücher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130109,
					"content": "Was meinst du mit Büchern verschieben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130110
					]
				},
				{
					"id": 762130110,
					"content": "Wenn das Buch nicht da ist, wurde es bewegt. Ich schaue einfach nur zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130111
					],
					"speakerTitle": "Congshen"
				},
				{
					"id": 762130111,
					"content": "Dann versuche ich es mal mit Dex.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130112
					]
				},
				{
					"id": 762130112,
					"content": "Geh geradeaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congshen"
				}
			]
		},
		{
