			},
			"dialogs": [
				{
					"id": 220340203,
					"content": "Diese Menschen sind ziemlich schnell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340204
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340204,
					"content": "Sie sind wahrscheinlich zurückgegangen, um über uns zu berichten. In diesem Fall haben wir unser Ziel erreicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340205,
					"content": "#Danke für deine harte Arbeit, {F#Reisende}{M#Reisender}. Bitte nimm dies als Dankeschön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340206,
					"content": "Ich werde auch zurückkehren und Sango darüber berichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340207,
					"content": "Ich frage mich, ob sie schon etwas herausgefunden hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
