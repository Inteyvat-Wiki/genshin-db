	"talks": [
		{
			"id": 2203401,
			"completionStepIds": [
				2203401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203401",
							"2"
						],
						"stepId": 2203401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220340101,
					"content": "#{F#Reisende}{M#Reisender}, bitte warte. Sango bittet um deine Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340102,
					"content": "Machst du Fortschritte in dem Fall?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340103
					]
				},
				{
					"id": 220340103,
					"content": "Das hat sie mir nicht gesagt. Sie sagte nur, dass sie noch ein paar Vorbereitungen treffen muss.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340104,
					"content": "Sie sagte auch, ich solle auf dich warten und fragen, ob du mit mir zusammen eine Suche in der Wildnis durchführen würdest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340105,
						220340107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340105,
					"content": "Was beabsichtigt sie zu erreichen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340106
					]
				},
				{
					"id": 220340106,
					"content": "Nun ... um ehrlich zu sein, habe ich auch keine Ahnung. Aber wenn wir das tun, was Sango uns sagt, können wir den Fall meistens lösen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340112,
					"content": "Nun ja. In diesem Sinne, lass uns über das Geschäftliche reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340113,
					"content": "Laut Sango wurde die Patrouille in der Stadt tatsächlich verstärkt, seit Amano und Andou diesen Vorfall gemeldet haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340114,
					"content": "Aber seltsamerweise werden die Händler in der Stadt immer noch Opfer von Diebstählen. Und die Absicht der Täter ist ganz klar. Sie sind an nichts anderem interessiert, als an einigen gezielten Gegenständen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340115,
					"content": "Hier ist die Situation. Sango glaubt, dass die Wahrscheinlichkeit, dass sich die Schatzräuber in die Stadt schleichen, um diese Verbrechen auszuführen, sehr gering ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340116
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340116,
					"content": "Der Verdächtige ... oder die Verdächtigen haben ein klares Ziel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340117
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340117,
					"content": "Es ist sehr wahrscheinlich, dass es die ganze Zeit über einen Maulwurf in der Stadt gab, der Informationen an Leute außerhalb der Stadt weitergegeben hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340118,
					"content": "Bedeutet das nicht, dass die Aktionen der Doushins sinnlos sind?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340119
					]
				},
				{
					"id": 220340119,
					"content": "Ganz und gar nicht. Es ist genau das, was wir wollen. Weil unser Täter scheinbar erkannt hat, dass er noch nicht das Ziel der Doushins ist, wird er weiterhin Verbrechen begehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340120
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340120,
					"content": "Je mehr Verbrechen er begeht, desto einfacher ist es für ihn, sich zu verraten und desto größer ist die Chance für Sango, herauszufinden, wer er wirklich ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340121,
					"content": "Deshalb müssen wir immer noch eine Show abziehen, damit unser Dieb seine Deckung fallen lässt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340122
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340122,
					"content": "#{F#Reisende}{M#Reisender}, deshalb bin ich hier und bitte dich, mit mir zu kommen und mit diesen Schatzräubern fertigzuwerden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340123
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340123,
					"content": "Natürlich wird es eine Bezahlung geben. Außerdem ... wenn dieser Fall vorbei ist, wird es ein zusätzliches Geschenk für dich geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340124,
					"content": "Hat Sango dich auch darum gebeten, dieses Zeug zu sagen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340125
					]
				},
				{
					"id": 220340125,
					"content": "Hmm ... du hast das gespürt? Du hast eine ziemlich scharfe Wahrnehmung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340126
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340126,
					"content": "Es war in der Tat Sango, die mir sagte, ich solle dich mit diesen Worten überreden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340127
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340127,
					"content": "Aber bitte glaube mir, wenn ich sage, dass ich nicht lüge. Immerhin trage ich deine Bezahlung mit mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340128
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340128,
					"content": "#Deshalb hilf uns bitte weiter, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340129
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340129,
					"content": "Was genau soll ich tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340130
					]
				},
				{
					"id": 220340130,
					"content": "Es ist ganz einfach. Wir müssen uns nur ... mit diesen Schatzräubern in der Wildnis anlegen. Je größer der Aufruhr, desto besser.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340131
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340131,
					"content": "Sango hat bereits die Standorte einiger Schatzräuber-Lager markiert. Ich habe sie auch auf der Karte für dich markiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340132
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340132,
					"content": "In Ordnung, wir treffen uns nachher an diesem Ort. Lass uns jetzt loslegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340107,
					"content": "Warum ist sie nicht mitgekommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340108
					]
				},
				{
					"id": 220340108,
					"content": "Es ist ihre Angewohnheit, wirklich. Sie sagte, dass sie ... „gut im Denken ist, aber weniger gut im Handeln.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340109
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340109,
					"content": "Vor einiger Zeit kam ein Romanautor zu ihr, der ihre Geschichte in einen Roman verwandeln wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340110,
					"content": "Er hat Sango sogar als „Sessel-Detektiv“ bezeichnet. Sie scheint Gefallen an diesem Spitznamen gefunden zu haben und denkt seitdem über den Kauf eines Sessels nach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340111,
					"content": "Aber aufgrund von Finanzierungsproblemen können wir noch nicht wirklich einen Sessel bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
