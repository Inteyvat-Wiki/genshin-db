			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210220501,
					"content": "Da seid ihr ja wieder, ich habe es kaum noch ausgehalten. Habt ihr denn was gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229601
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229601,
					"content": "Wir haben noch zwei weitere Steintafeln gefunden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229602
					]
				},
				{
					"id": 210229602,
					"content": "Schnell, lasst mich sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229603
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229603,
					"content": "„Krieg herrschte in der Guili-Ebene ... Schwarzer Staub verdunkelte den Himmel und Felsen zerbarsten in tausend Stücke ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229604
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229604,
					"content": "Ah, so muss das gewesen sein! Ein enormer Kampf hat in der Guili-Ebene stattgefunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229605
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229605,
					"content": "Die „Guili-Stätte“ wurde wahrscheinlich in genau jenem Krieg verwüstet. Die andere Passage jedoch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229606
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229606,
					"content": "Diese scheint von jemandem zu stammen, der nicht fliehen wollte, der geblieben ist und außerdem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229607
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229607,
					"content": "Und außerdem noch einen Schatz hütet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210220502
					]
				},
				{
					"id": 210220502,
					"content": "Du bist ja ganz schön sensibel bei dem Thema, wobei man es schon wörtlich nehmen kann. In der Guili-Ebene gibt es wirklich einen Schatz zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220503
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220503,
					"content": "Aber oben steht auch geschrieben „folgt den Guizhong-Mahnungen ...“ und dann noch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220504
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220504,
					"content": "„Lehre Weisheit, gebunden an Moral, mit starken Muskeln und vereint im Herzen. All dies fließt in der Guili-Stätte zusammen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220505
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220505,
					"content": "Da weiß man doch gar nicht, wo man anfangen soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220506
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220506,
					"content": "Lasst uns erst zum Gasthaus Wangshu zurückgehen. Nach einer kurzen Rast können wir uns dann wieder den Guizhong-Mahnungen widmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
