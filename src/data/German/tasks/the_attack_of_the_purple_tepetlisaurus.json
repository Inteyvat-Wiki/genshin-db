				"points": []
			},
			"dialogs": [
				{
					"id": 751791101,
					"content": "Was soll ich nur tun?! Mich erwartet sicher eine Tracht Prügel, wenn ich zurückkomme ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791102,
						751791106
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791102,
					"content": "Was ist passiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791103
					]
				},
				{
					"id": 751791103,
					"content": "*seufz* ... Wir waren mit unserer Handelskarawane unterwegs und eigentlich lief alles wie am Schnürchen, als uns plötzlich der Vulkanausbruch überraschte und mehrere lila Tepetlisaurier aus dem Boden hervorgesprungen kamen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791104
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791104,
					"content": "Ich war unvorsichtig, mein Sauriergefährte geriet in Panik und hat sich von der Gruppe getrennt. Als ich mich dann umdrehte, stellte ich fest, dass die Straße blockiert war und ich nicht mehr zu den anderen aufschließen konnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791105
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791105,
					"content": "*seufz* ... Keine Ahnung, wie es den anderen geht. Meine Chefin kocht sicher vor Wut, dass ich die Gruppe ohne Erlaubnis verlassen habe. Ich bin erledigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791106,
					"content": "Ich an deiner Stelle würde mich aus dem Staub machen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791107
					]
				},
				{
					"id": 751791107,
					"content": "Aus dem Staub machen? Nein, niemals, meine Chefin ist wie das Königreich der Nacht, sie ist überall. Egal, wohin ich fliehe, sie würde mich überall finden und an den Haaren zurückschleifen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791108
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791108,
					"content": "Ich muss zurück und mich entschuldigen. Aber wie soll ich das anstellen ... Alle Wege sind blockiert ... *seufz* Dieses Mal bin ich echt erledigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				}
			]
		},
