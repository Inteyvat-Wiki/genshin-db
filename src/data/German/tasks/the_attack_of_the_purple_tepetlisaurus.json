			"dialogs": [
				{
					"id": 751790701,
					"content": "Also, dank der Hilfe dieser Drei bist du gesund und munter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790702
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790702,
					"content": "Haha, stimmt genau! Du hättest sehen sollen, wie stark sie sind. Sie haben diese Monster im Nullkommanichts erledigt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790703
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790703,
					"content": "Ihr habt unsere Truppenführerin gerettet, ich kann mich gar nicht genug bei euch bedanken. Seht dieses kleine Geschenk als Zeichen meiner Dankbarkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790704
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790704,
					"content": "Tizlo, du bist immer so knauserig! Sie haben mir das Leben gerettet, und das ist alles, was du als Dank anzubieten hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
				}
			]
		},
