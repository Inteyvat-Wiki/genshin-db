			"dialogs": [
				{
					"id": 751791301,
					"content": "He, Dickerchen! Ist es nicht deine Aufgabe, für die Sicherheit der Karawane zu sorgen? Was sagst du dazu, dass du alle anderen deine Arbeit für dich machen lässt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791302
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751791302,
					"content": "Ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791303
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791303,
					"content": "Mach jetzt kein Theater! Wenn du nicht in Panik geraten wärst, wäre ich nicht von ein paar mickrigen Monstern überwältigt worden! Als Dank kannst du dir schön einen Teil deiner Belohnung abschminken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791304
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751791304,
					"content": "V... Verstanden, Chefin ...",
