			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tizlo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751790401,
					"content": "He! Du, ja, du, es ist gefährlich draußen, komm schnell rein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790402
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790402,
					"content": "Oje, hast du denn die Verwüstung auf dem Weg nicht gesehen? Es gab schon wieder einen Vulkanausbruch und Monster blockieren die Straße. Ich wage mich keinen Schritt weiter vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790403
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790403,
					"content": "Hör auf meinen Rat. Bleib noch eine Weile hier und schließ dich dann unserer Karawane an. So bist du in guten Händen. Allein zu reisen ist gefährlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790404,
						751790408
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790404,
					"content": "Monster?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790405
					]
				},
				{
					"id": 751790405,
					"content": "Es ist eine Gruppe lila Tepetlisaurier! Eindeutig vom Abgrund korrumpiert! Ihre Zerstörungskraft ist gewaltig. Ehrlich gesagt, ich habe noch nie so schreckliche Tepetlisaurier gesehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790406
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790406,
					"content": "Ich sage dir, die haben einmal ihren Schwanz geschwungen und unser Wagen war Geschichte. Sie sind sogar stärker als ein Tatankasaurier, und mit denen ist schon nicht gut Kirschen essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790407
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790407,
					"content": "Nimm dir also meinen Rat zu Herzen: Sei kein Hitzkopf und leg dich nicht mit denen an. Besser wäre es, ihnen gleich ganz aus dem Weg zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790408,
					"content": "Schon in Ordnung, ich schaffe das schon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790409
					]
				},
				{
					"id": 751790409,
					"content": "Du ... *seufz* ... Na gut, pass auf dich auf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tizlo"
				}
			]
		},
