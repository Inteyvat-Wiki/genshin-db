						],
						"pointId": 10984
					}
				]
			},
			"dialogs": [
				{
					"id": 751790301,
					"content": "Ach ja, natürlich. Das hier ist zwar sicher kein angemessenes Geschenk, um jemandem dafür zu danken, dass er einem das Leben gerettet hat, aber nimm es bitte trotzdem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790302,
						751790303
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790302,
					"content": "Stimmt, etwas wenig ist es schon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790304
					]
				},
				{
					"id": 751790304,
					"content": "Hahaha, du hast recht. Ich mag Leute wie dich. Immer frei von der Leber weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790306,
					"content": "*hust* Wie auch immer, ich habe noch etwas für dich aus meiner eigenen Tasche, nimm es mit. Kaufe mehr Leckerlis für den kleinen Tepetlisaurier da. Nur keine falsche Scheu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790307
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790307,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751790308,
					"content": "Gut, wir müssen noch alles einsammeln, was wir unterwegs verloren haben, also los, Bewegung! Bis dann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790303,
					"content": "Ach nein, das reicht schon aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790305
					]
				},
				{
					"id": 751790305,
					"content": "Tja, also gehörst du nicht zu den geradlinigen Leuten, wie ich sehe. Jetzt nimm schon, sonst heißt es nachher noch, ich sei geizig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				}
			]
		},
