			},
			"dialogs": [
				{
					"id": 751790901,
					"content": "It... Itsaho! E... Es gibt noch so viele Dinge auf der Liste, die fehlen! Hilf ... Hilf mir, sie zu finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790902
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790902,
					"content": "*seufz* ... Lass gut sein, ich habe die Liste bereits gelesen. Das war alles zerbrechlicher Kram. Du glaubst doch nicht wirklich, dass irgendwas davon den Vulkanausbruch und das Umkippen des Wagens überlebt hat, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790903
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790903,
					"content": "Schone ein bisschen deine Kräfte und mach eine Pause. Warten wir lieber, bis die anderen zurück sind. Vor uns liegt noch ein weiter Weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790904
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790904,
					"content": "N... Nein! E... Egal. Wenn du nicht gehst, dann gehe halt ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masose"
				}
			]
		},
