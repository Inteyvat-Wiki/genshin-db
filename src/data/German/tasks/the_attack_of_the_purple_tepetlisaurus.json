					"Paimon"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2893.348,
							257.691,
							9926.251
						],
						"pointId": 10703
					},
					{
						"sceneId": 3,
						"position": [
							-2892.566,
							257.855,
							9924.833
						],
						"pointId": 10710
					},
					{
						"sceneId": 3,
						"position": [
							-2892.844,
							257.694,
							9921.14
						],
						"pointId": 10983
					}
				]
			},
			"dialogs": [
				{
					"id": 751790101,
					"content": "He, du da, stehen bleiben! Das gehört uns! Keinen Schritt weiter! I... Ich war beim Krieg der Nachtwächter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790102
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790102,
					"content": "W... Wenn du es wagst, uns zu beklauen, dann wirst du schon sehen, was du davon hast!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790103
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790103,
					"content": "*seufz* ... Was ist heute nur los? Erst der Vulkanausbruch, dann die lila Tepetlisaurier ... und jetzt auch noch dieses verbrecherische Gesindel. Wir haben heute auch nur Pech ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790104
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790104,
					"content": "#Masose, {M#er}{F#sie} sieht echt stark aus, mit {M#dem}{F#der} sollten wir uns lieber nicht anlegen. Lass es gut sein ... Außerdem haben wir den Wettkampf nur angeschaut, wir haben nicht wirklich teilgenommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790105
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790105,
					"content": "#Itsaho, d... du Idiot! Was soll das, das Zeug gehört allen! A... Außerdem steht es zwei gegen {M#einen}{F#eine}, mit {M#dem}{F#der} werden wir doch fertig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790106
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790106,
					"content": "#Was soll das heißen, zwei gegen {M#einen}{F#eine}? Zähl mich nicht mit dazu. Wenn du kämpfen willst, dann tu es selbst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790107
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790107,
					"content": "He du, wir wollen das Zeug gar nicht mehr. Greif gern zu. Wir wollen nur keinen Streit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790108,
						751790109
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790108,
					"content": "Da liegt wohl ein Missverständnis vor ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790111
					]
				},
				{
					"id": 751790111,
					"content": "#Ihr habt da wohl was falsch verstanden! Wir sind hilfsbereite Abenteurer{F#innen} und nicht irgendein Gesindel, das grundlos Böses tut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751790112,
					"content": "W... Warum sollte ich euch glauben? Aua, das tut weh! Itsaho, warum haust du mich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790113
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790113,
					"content": "Wenn sie wirklich vorhätten, dich auszurauben, hätten sie dich schon längst verprügelt, anstatt sich dir zu erklären!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790114
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790114,
					"content": "#He ihr zwei, um ehrlich zu sein, wurde unsere Karawane gerade versprengt. Da ihr ja Abenteurer{F#innen} seid, frage ich mich, ob ihr uns vielleicht helfen könntet, unsere Chefin zu benachrichtigen, dass wir hier auf sie warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790115
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790115,
					"content": "Betrachtet die Sachen in der Kiste als unser Dankeschön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790116
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790116,
					"content": "Nichts leichter als das, wir kümmern uns drum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751790109,
					"content": "Du scheinst zu wissen, wie es läuft ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790110
					]
				},
				{
					"id": 751790110,
					"content": "Bitte? Pass mal auf, was du sagst! Du lässt uns wie diese Bösewichte klingen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
