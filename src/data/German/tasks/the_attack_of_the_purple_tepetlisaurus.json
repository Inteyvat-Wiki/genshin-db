			"dialogs": [
				{
					"id": 751790201,
					"content": "*schnauf* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790202,
						751790204
					],
					"speakerTitle": "Zashari"
				},
				{
					"id": 751790202,
					"content": "Alles in Ordnung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790203
					]
				},
				{
					"id": 751790203,
					"content": "Alles gut, hab mich beim Rennen gerade nur etwas verausgabt, bin wohl etwas in Panik geraten. Gib mir einen Moment, es geht gleich wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zashari"
				},
				{
					"id": 751790204,
					"content": "Hol erstmal tief Luft.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790205
					]
				},
				{
					"id": 751790205,
					"content": "Ja, vie... vielen Dank für deine Fürsorge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zashari"
				}
			]
		},
