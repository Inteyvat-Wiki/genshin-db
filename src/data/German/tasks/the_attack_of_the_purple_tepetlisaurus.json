			"dialogs": [
				{
					"id": 751790601,
					"content": "Puh ... Das war knapp. Argh, fast wäre ich von ein paar Tepetlisauriern zu Boden geworfen worden. So ein Mist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790602
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790602,
					"content": "Ihr liegt da falsch. Die wurden eindeutig vom Abgrund in Monster verwandelt! Sie sind weitaus gefährlicher als einfache Tepetlisaurier. Kein Wunder, dass ihr so aufgemischt wurdet!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790603
					]
				},
				{
					"id": 751790603,
					"content": "Haha, so ist das also? Kein Wunder. Ich muss mich dieses Mal wirklich bei euch bedanken, denn ohne euch wäre ich dieses Mal definitiv geliefert gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790604
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790604,
					"content": "Aber wie dem auch sei, du musst erst einmal hier warten. Zuallererst muss ich diese Taugenichtse zurückholen, um sicherzugehen, dass es ihnen gut geht. Anschließend werde ich mich gern bei dir revanchieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790605
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790605,
					"content": "Mit deiner Hilfe haben sich die Mitglieder der Karawane einer nach dem anderen versammelt.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
