			"dialogs": [
				{
					"id": 120220601,
					"content": "#{NICKNAME}, ich glaube, das ist es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220602,
					"content": "Sieh, hier ist sogar ein Lesezeichen. Keins der anderen Bücher hat eins, also muss Kokomi die bereits gelesen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220603,
					"content": "Puh, das ist ziemlich mühsam. Paimon versteht gar nichts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220604
					],
					"speakerTitle": "Paimon"
				},
