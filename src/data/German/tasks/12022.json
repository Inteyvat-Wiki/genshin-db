			"dialogs": [
				{
					"id": 120220701,
					"content": "Sucht ihr nach Ihrer Exzellenz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220702,
					"content": "Ich fürchte, sie ist gerade nicht hier. Ich weiß nicht, wo sie hin ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220703
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220703,
					"content": "Merkwürdig ... Schätze, wir sollten es dann verschieben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220704,
					"content": "Nicht unbedingt. Wenn ich mich recht entsinne, hat Ihre Exzellenz in ihren Allgemeinen Betriebsanweisungen spezielle Vorkehrungen für ein solches Szenario getroffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220705,
					"content": "Lass mich nachdenken. Nummer 98 ...<color=#00E1FFFF>„Ein Gast ist von weit her gekommen, der mich sucht und nicht findet; er mag nach Süden kommen, vor den lilablättrigen Baum“</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220706,
					"content": "Die Fußnote besagt, dass dies nur gilt, wenn Ihre Exzellenz vor ihrem Verschwinden keine Mitteilung über ihren Aufenthaltsort gemacht hat, und auch dann nur, wenn der betreffende Besucher Prioritätsstatus hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220707
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220707,
					"content": "Meiner Meinung nach erfüllt ihr beide Bedingungen. Ich habe diese Anweisung immer bei mir. Ich bin sicher, das ist die richtige Vorgehensweise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220708
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220708,
					"content": "Kokomi bedenkt wirklich alles! Na gut, finden wir den Ort, den sie notiert hat und schauen uns um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
