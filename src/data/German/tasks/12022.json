			"dialogs": [
				{
					"id": 120220501,
					"content": "Oho ... Sieh dir all diese Anträge an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220502,
					"content": "Nimmt sich Kokomi Zeit, damit umzugehen, auch wenn sie sich ausruht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220503,
					"content": "„Stellungnahme zum Geldfluss der Sangonomiya-Geschehnisse“, „Konsolidierter Jahresbericht über die Fischereiproduktion“, „Aufschlüsselung der monatlichen Wartungskosten von Watatsumi“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220504,
					"content": "Das ist eine Menge Arbeit für eine einzelne Person. Und das zusätzlich zu all den Anweisungen, die sie schreiben muss und all den Leuten, die sie täglich treffen muss. Kein Wunder, dass sie von Zeit zu Zeit so ausgebrannt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220505,
					"content": "Lass uns dieses Buch suchen und ihr helfen, sich wieder ganz wie sie selbst zu fühlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
