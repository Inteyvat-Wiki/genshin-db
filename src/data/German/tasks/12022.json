			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220101,
					"content": "Hä? Kokomi ist noch nicht hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220102,
					"content": "Das ist komisch. Sie wirkt nicht wie die Art Person, die sich verspätet ... Äh, warten wir ein wenig länger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220103,
					"content": "Warum ist sie immer noch nicht da? Denkst du, sie könnte in Schwierigkeiten stecken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220104,
					"content": "Lass uns den Soldaten da drüben fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220701,
					"content": "Sucht ihr nach Ihrer Exzellenz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220702,
					"content": "Ich fürchte, sie ist gerade nicht hier. Ich weiß nicht, wo sie hin ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220703
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220703,
					"content": "Merkwürdig ... Schätze, wir sollten es dann verschieben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220704,
					"content": "Nicht unbedingt. Wenn ich mich recht entsinne, hat Ihre Exzellenz in ihren Allgemeinen Betriebsanweisungen spezielle Vorkehrungen für ein solches Szenario getroffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220705,
					"content": "Lass mich nachdenken. Nummer 98 ...<color=#00E1FFFF>„Ein Gast ist von weit her gekommen, der mich sucht und nicht findet; er mag nach Süden kommen, vor den lilablättrigen Baum“</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220706,
					"content": "Die Fußnote besagt, dass dies nur gilt, wenn Ihre Exzellenz vor ihrem Verschwinden keine Mitteilung über ihren Aufenthaltsort gemacht hat, und auch dann nur, wenn der betreffende Besucher Prioritätsstatus hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220707
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220707,
					"content": "Meiner Meinung nach erfüllt ihr beide Bedingungen. Ich habe diese Anweisung immer bei mir. Ich bin sicher, das ist die richtige Vorgehensweise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220708
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220708,
					"content": "Kokomi bedenkt wirklich alles! Na gut, finden wir den Ort, den sie notiert hat und schauen uns um.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202202,
			"completionStepIds": [
				1202208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202208",
							"2"
						],
						"stepId": 1202208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220204,
					"content": "Kokomi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220205,
					"content": "Hier versteckst du dich also! Wir wollten uns heute treffen und alles für das Siegesfest vorbereiten. Was ist passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220206,
					"content": "Oh ... Ihr seid es ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220207
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220207,
					"content": "I... Ich muss mich entschuldigen ... Ich fühle mich heute nicht ganz wohl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220208
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220208,
					"content": "Krank? Lass uns sofort zum Arzt gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220209,
					"content": "Nein, nein, es ist nichts derart ... Es ist nur, meine Energie ist komplett verbraucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220210
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220210,
					"content": "Du verbrauchst Energie? *keuch* Du meinst ... du bist wie ein Ruinenwächter!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220211,
					"content": "Nein, es ist nur eine Redewendung. *seufz* Ich schäme mich, es zuzugeben, aber ich kann nicht immer die unendlich fähige Person sein, als die ich mich präsentiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220212,
						120220213
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220212,
					"content": "Alle haben dir gestern viel abverlangt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				},
				{
					"id": 120220214,
					"content": "Oh ... Du hast es bemerkt? Ich fürchte, ich habe es noch nicht ganz gemeistert, zu verbergen, wie ich mich fühle. Ich werde weiter daran arbeiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220215
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220215,
					"content": "Um ehrlich zu sein, bin ich nicht wirklich dafür gemacht, eine Anführerin zu sein. Ursprünglich war es mein Traum, mir militärische Strategien anzulesen und vielleicht eine Beraterin zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220216
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220216,
					"content": "Immer mit Leuten kommunizieren, versuchen, die Moral aufrechtzuerhalten, zwischen den Zeilen lesen, sicherstellen, dass alle die Anerkennung erhalten, die sie verdienen ... Es ist so harte Arbeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220217
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220217,
					"content": "Man soll es irgendwie schaffen, Leute durch bloße Anwesenheit zu inspirieren und gleichzeitig ihren Respekt verlangen ... Das liegt nicht in meiner Natur. Um ehrlich zu sein, ist es etwas, was ich selbst nie wollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220218
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220218,
					"content": "Doch aufgrund meiner Blutlinie war es mir vorherbestimmt, früher oder später die göttliche Priesterin zu werden. Ob es mir gefällt oder nicht, so läuft es nun mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220219
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220219,
					"content": "Also komme ich hierher, wann immer ich mich überwältigt fühle und verliere mich in einem Buch und entspanne für eine Weile ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220220
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220220,
					"content": "Keine Sorge, es beeinträchtigt meine Arbeit nicht. Ich habe die Vorbereitung des Siegesfests an jemand anderen übertragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220221
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220221,
					"content": "Ich muss heute Nacht eine Rede halten und ich darf den Truppen keinen Grund zur Annahme geben, dass etwas falsch sein könnte. Dieser Frieden wurde hart erkämpft und ich möchte, dass sie sich wohlfühlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220222
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220222,
					"content": "Können wir etwas tun, um zu helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220223,
					"content": "In der Tat, würde ich es in Ruhe lassen, würde meine Energie langsam zurückkehren. Aber vielleicht könnte ich mich schneller erholen, wenn ich ein Buch über die Soldaten hören würde, das mich interessiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220224
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220224,
					"content": "Als ich das letzte Mal hier war, habe ich ein Buch gelesen, aber ich bin nur halb durch gekommen. Wo habe ich es hingetan ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220225
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220225,
					"content": "Wir werden es finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220226,
					"content": "Und dann werden wir es dir vorlesen, um dir beim Erholen zu helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220227,
					"content": "Das würdet ihr für mich tun? Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220228
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220228,
					"content": "Hehe ... Ich habe echt Glück, dass ihr zurück auf Watatsumi gekommen seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220213,
					"content": "Ich konnte spüren, wie es dich mitnahm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				}
			]
		},
		{
			"id": 1202203,
			"completionStepIds": [
				1202217
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202217",
							"2"
						],
						"stepId": 1202217,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220301,
					"content": "Schau, ist das das Buch, das du jetzt suchst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220302,
					"content": "„Der Kapitän von Schwertfisch II kehrte heute zurück. Energiewert +4 ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220303,
					"content": "Ah, das ist ... das ist nur, ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220304,
						120220305
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220304,
					"content": "Wir haben nichts gesehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220306
					]
				},
				{
					"id": 120220306,
					"content": "Gib ... es ... her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220307
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220307,
					"content": "Äh, schätze, das war das falsche ... Suchen wir weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220305,
					"content": "(Und wenn, war es alles Paimons Schuld.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220306
					]
				}
			]
		},
		{
