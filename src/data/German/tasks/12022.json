			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220401,
					"content": "Kokomi, ist das das Buch, das du willst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220402,
					"content": "Hmm, ich bin nicht sicher ... Könntest du ein wenig daraus vorlesen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220403,
						120220404
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220403,
					"content": "„Handle nach dem Plan und plane nach der Lage“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220405
					]
				},
				{
					"id": 120220405,
					"content": "Ah, ja, das ist es! Danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220406,
					"content": "Kokomi? Kokomi ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220407,
					"content": "#Was sollen wir tun, {NICKNAME}? Sie schläft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220408,
					"content": "Heute Nacht ist die Siegesfeier! Ganz zu schweigen davon, dass die Friedensgespräche vor der Tür stehen. Sie hat so viel zu tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220409,
						120220421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220409,
					"content": "Lassen wir sie eine Weile ruhen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220410
					]
				},
				{
					"id": 120220410,
					"content": "Bist du sicher, dass das eine gute Idee ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220411,
					"content": "Hmm, sie sieht ziemlich erschöpft aus. Denke, es ist auch noch etwas Zeit. Nun gut, lass uns ihr Gesellschaft leisten, während sie sich ausruht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220412,
					"content": "Katastrophen verhindern ... Frieden um jeden Preis schützen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220413
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220413,
					"content": "Der Krieg ist vorbei ... Die Dinge bessern sich langsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220414,
					"content": "Hast du das gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220415
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220415,
					"content": "Uuuh ... Hä? Wie spät ist es? Bin ich eingeschlafen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220416,
					"content": "Ja, fast für eine Ewigkeit! Es ist beinahe Zeit für das Fest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220417,
					"content": "Ich kann nicht glauben, dass es schon so spät ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220418
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220418,
					"content": "*seufz* Ich habe lange nicht so friedlich geschlafen. Das müssen drei volle Energiepunkte gewesen sein. Sollte genug sein, um mich durch die Friedensverhandlungen zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220419
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220419,
					"content": "#Vielen Dank, {NICKNAME}. Kommt, lasst uns zusammen zum Lagerfeuer gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220420
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220420,
					"content": "Wuhu, Kokomi ist zurück und voller Energie! Gut, dich wiederzuhaben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220421,
					"content": "Wecken wir sie auf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220422
					]
				},
				{
					"id": 120220422,
					"content": "Sollten wir vermutlich, immerhin hat Kokomi gesagt, sie wolle alles fertig kriegen, bevor das Fest beginnt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220423,
					"content": "Kokomi, aufwachen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220424,
					"content": "Hmmmm ...? Habe ich geschlafen? ... Wie spät ist es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220425
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220425,
					"content": "Zeit, dass wir aufbrechen! Es ist beinahe Zeit für das Fest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220426,
					"content": "Wirklich? So spät schon? Uff ... Ich fühle mich noch immer nicht voll erholt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220427
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220427,
					"content": "Ich kaufe dir ein neues Buch über Militärstrategie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220428
					]
				},
				{
					"id": 120220428,
					"content": "Wirklich? Ja! Ich möchte den neuesten Band über die „Kunst des Krieges von Teyvat“!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220429
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220429,
					"content": "Der Verlagshaus Yae hat es letzten Monat veröffentlicht, aber ich hatte noch keine Gelegenheit, es in die Finger zu bekommen ... Jetzt gibt es keinen Rückzieher, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220430
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220430,
					"content": "Oh, das hat Kokomi wirklich munter gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220431,
					"content": "Alles klar, lasst uns zum Fest gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220404,
					"content": "„Attackiere, wo der Feind schwach ist, erscheine, wo der Feind blind ist“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220405
					]
				}
			]
		},
