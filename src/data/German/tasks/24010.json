			"dialogs": [
				{
					"id": 240100301,
					"content": "Ich kann mich nicht von bestimmten Formen beeinflussen lassen ... Ich muss die Schönheit extrahieren und die Symbolik nutzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100302
