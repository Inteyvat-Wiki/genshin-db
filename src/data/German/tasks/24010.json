			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100101,
					"content": "Die Idee ist nicht schlecht, aber ... kann man das wirklich so machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100102,
					"content": "Wie läuft es mit dem Gemälde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100103
					]
				},
				{
					"id": 240100103,
					"content": "Ach, du bist es. Danke für deine Fotos. Die Szenen darauf haben mich sehr inspiriert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100104
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100104,
					"content": "Ich habe eine grobe Idee und einige Skizzen. Aber ... wie soll ich es sagen, nichts passt so richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100105
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100105,
					"content": "Versteh mich nicht falsch. Ich sage ja nicht, dass ich ästhetisch unschönen Müll gemalt habe, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100106
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100106,
					"content": "Diesen Gemälden fehlt etwas „Besonderes“, das sie von gewöhnlichen Gemälden abhebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100107
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100107,
					"content": "Und die Bilder, die ich mir ausgedacht habe, sind zu ... bildlich. Wenn ich sie so gemalt hätte, wäre die Schönheit, die ich vermitteln wollte, beeinträchtigt worden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100108,
					"content": "Leider ist das ein Problem, mit dem jeder Maler zu kämpfen hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100109,
						240100119
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100109,
					"content": "Versuch doch, etwas anderes zu malen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100110
					]
				},
				{
					"id": 240100110,
					"content": "Ich danke dir für deine Anregung. Aber dieses Problem lässt sich nicht einfach dadurch lösen, das Motiv zu ändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100111
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100111,
					"content": "Ob ich nun Landschaften, Tiere oder das irdische Leben male, dieses Problem ist immer präsent ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100112
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100112,
					"content": "Um es zu lösen, haben einige meiner Kollegen die konkreten Szenen entsprechend ihren eigenen Emotionen zerlegt und umgestaltet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100113
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100113,
					"content": "Der Schwerpunkt dieser Gemälde liegt auf den Emotionen, die man in sich trägt. Auf ihren Gemälden ... wie soll ich das ausdrücken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100114,
					"content": "Nun, auf ihren Gemälden haben sowohl die Figuren als auch die Szenerie, sogar das Licht, eher einen Sinn für das Groteske als für eine traditionelle Art von Schönheit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100115,
					"content": "Wenn man das Gemälde oberflächlich betrachtet, würden die meisten Leute entweder denken, dass derjenige, der es gemalt hat, jemand Ungehobeltes war, der keine Kenntnisse von der Malerei hatte, oder dass der Maler schlicht und ergreifend verrückt war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100116,
					"content": "Aber wenn du deinen Geist zur Ruhe bringst und dem Gemälde mit deinem Herzen und deiner Seele zuhörst, kannst du den inneren Schrei des Malers hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100117,
					"content": "Der Schrei kommt aus der Seele des Malers, der seinen verschiedenen Emotionen freien Lauf lässt ... und die meisten davon sind intensiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100118
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100118,
					"content": "Dieses Geräusch ist nicht mit den Ohren hörbar, es muss mit der Seele wahrgenommen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100124,
					"content": "Und was mich betrifft ... Ich will immer noch nicht auf eine konkrete Szenerie verzichten, also habe ich mir einen anderen Versuch ausgedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100125
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100125,
					"content": "Ich habe entschieden, mich auf die Farbe zu konzentrieren. Ich will einen stärkeren Farbsinn, eine prägnantere und kraftvollere Pinselführung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100126
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100126,
					"content": "Gleichzeitig muss ich Licht und Schatten und die Formen der Landschaft im traditionellen Sinne abschwächen ... Diese Dinge stören meinen künstlerischen Ausdruck, also muss ich sie für eine Weile aus dem Gemälde entfernen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100127
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100127,
					"content": "Aber das Problem ist ... um ein starkes Farbgefühl zu erzeugen, muss ich viel Farbe verwenden und gegebenenfalls die Farbe direkt auf die Leinwand pressen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100128
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100128,
					"content": "Also ... meine Farben ... sind jetzt alle verbraucht. Aber ich kann die Staffelei jetzt nicht wegtragen, sonst wird meine Arbeit beeinträchtigt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100129
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100129,
					"content": "#{F#Reisende}{M#Reisender}, könntest du für mich zu Boucicaut in die Stadt gehen? Ich habe ihn gebeten, einen Satz guter Farbstoffe zu kaufen, sie müssten schon so weit sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100130
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100130,
					"content": "Oder ... vielleicht kannst du mir etwas Vaniloqua-Nektar mitbringen, damit ich meine eigenen Farben herstellen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100131,
						240100134
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100131,
					"content": "Man kann aus Nektar auch Farben herstellen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100132
					]
				},
				{
					"id": 240100132,
					"content": "Hahaha, natürlich. Einige meiner Kollegen verwenden sogar Vogeleier als Farbe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100133
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100133,
					"content": "Es heißt, dass die daraus entstehende Farbe eine feine Färbung und einen reichhaltigen Schichteffekt hat, was sie perfekt für das Malen prächtiger Szenen macht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100136,
					"content": "Du bist ein warmherziger Mensch und würdest einem Künstler seine Anfrage nicht abschlagen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100137,
						240100138
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100137,
					"content": "Ich verstehe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100139,
					"content": "Wunderbar! Vielen Dank. Dann warte ich einfach hier, und sobald du alles hast, bringst du es direkt zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100138,
					"content": "Na gut, überlass das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100134,
					"content": "Du kannst also deine Farben noch selbst herstellen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100135
					]
				},
				{
					"id": 240100135,
					"content": "Hahaha, natürlich. Die erste Lektion, die man als Maler lernen muss, ist die Herstellung der eigenen Farben, damit man das Gemälde besser kontrollieren kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100119,
					"content": "Versuch mal, mit einer anderen Methode zu malen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100120
					]
				},
				{
					"id": 240100120,
					"content": "Du hast recht. Einige meiner Kollegen denken das auch und versuchen deshalb, mit „gegenstandslosen“ Methoden etwas „Abstraktes“ in ihren Gemälden auszudrücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100121
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100121,
					"content": "Einige der radikalsten von ihnen wollen sogar auf die Deskription eines konkreten Objekts verzichten und es in einfachen Farbblöcken malen ... Sie nennen sich selbst „Neodeskriptivisten“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100122,
					"content": "Aber ich muss sagen, dass sogar ich ihre Kunst nicht wirklich verstehen kann. Ich kann nur die rhythmische Schönheit in den Farbblöcken und Linien spüren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100123
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100123,
					"content": "Ich kann nur den beteiligten Maler bitten, mir zu sagen ... was das Gemälde ausdrücken will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
