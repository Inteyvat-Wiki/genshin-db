			},
			"dialogs": [
				{
					"id": 240100201,
					"content": "Hallo. Was möchtest du kaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100202
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100202,
					"content": "Ich bin wegen Depierris’ Farben hier ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100203
					]
				},
				{
					"id": 240100203,
					"content": "Ah, bist du hier, um seine Farben zu holen? Hier sind sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100204
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100204,
					"content": "Er verbraucht seine Farben so schnell, dass es den Anschein erweckt, als würde er die gekauften Farben direkt ins Wasser kippen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100205
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100205,
					"content": "Nun, hier sind alle Farben, die er gekauft hat. Bitte bring sie ihm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Boucicaut"
				}
			]
		},
