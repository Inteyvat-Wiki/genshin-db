			},
			"dialogs": [
				{
					"id": 240100401,
					"content": "#{F#Reisende}{M#Reisender}, hast du mir etwas mitgebracht? Haha, hast du mir die Farben mitgebracht, oder den Vaniloqua-Nektar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2401005,
			"completionStepIds": [
				2401006
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401006",
							"2"
						],
						"stepId": 2401006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100501,
					"content": "Sehr gut! Diese Farben sollten eine ganze Weile reichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100502
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100502,
					"content": "Du willst doch die Farben nicht ins Wasser kippen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100503
					]
				},
				{
					"id": 240100503,
					"content": "Ins Wasser kippen? Hahaha, ich male ziemlich genau so, wie du sagst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100504
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100504,
					"content": "Aber ich drücke die Farben aus, kippe sie direkt auf die Leinwand und male mit einem Rakel und Spachtel, damit ich eine eindrucksvolle Pinselführung kreieren kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100505
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100505,
					"content": "Vielen Dank für deine Hilfe. Mit diesen Farben werde ich weiter malen können. Komm öfters vorbei, wenn du Zeit hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100506
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100506,
					"content": "Dank dir konnte ich erst mit meinem Kunstwerk beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100507
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100507,
					"content": "#Wenn das Gemälde fertig ist, hoffe ich, dass du {F#die}{M#der} Erste bist, {F#die}{M#der} es bewundern kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
