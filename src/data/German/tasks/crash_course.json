			},
			"dialogs": [
				{
					"id": 3071401,
					"content": "Gleich werde ich das erste Mal Gelegenheit haben, an deiner Seite zu kämpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071402
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071402,
					"content": "Glaubst du, wir arbeiten gut zusammen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 30715,
