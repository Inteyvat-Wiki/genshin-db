			"dialogs": [
				{
					"id": 730280101,
					"content": "Hier scheinen auch Teile des großen Roboters zu liegen und wenn Jazari sie zu Gesicht bekommt, dann wird er wohl wieder seinen Fotoapparat zücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280102,
					"content": "Wo wir grade davon sprechen, Ararycan hat gesagt, dass er das große Teil in die Geheimbasis gebracht hat. Das kann doch nicht wahr sein, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280103,
					"content": "Natürlich ist das wahr. Ararycan würde Nara nicht belügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280104,
						730280105
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730280104,
					"content": "Wie erwartet ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280106
					]
				},
				{
					"id": 730280106,
					"content": "Ararycan war der Aranara, der damals in der Geheimbasis mit den Kindern gespielt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280107,
					"content": "Doch Ararycan kann sich an nichts erinnern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280108,
						730280109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280108,
					"content": "Vielleicht hat es etwas mit der getrockneten Blume im Notizbuch zu tun ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280110
					]
				},
				{
					"id": 730280110,
					"content": "Ja. Der Aranara im Mawtiyima-Dickicht hatte auch alles vergessen, nachdem er uns die Blume gegeben hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280111,
					"content": "Vielleicht haben die drei ja dieselben Abenteuer erlebt wie wir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280112,
					"content": "Ararycan weiß nicht, wovon ihr redet, und erinnert sich auch an nichts. Aber mit den kleinen Nara zu spielen, macht viel Spaß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730280113
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730280113,
					"content": "Wir hoffen, du wirst immer viel Spaß haben, Ararycan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730280109,
					"content": "So etwas ist uns früher schon einmal untergekommen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280110
					]
				},
				{
					"id": 730280105,
					"content": "Wenn ich mich nicht irre ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730280106
					]
				}
			]
		},
