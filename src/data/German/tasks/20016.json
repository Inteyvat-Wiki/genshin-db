					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160205
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160205,
					"content": "Dieser <color=#00E1FFFF>geschmorte Schinken mit Krebsgemüse</color> ist für dich. Er ist gerade fertig geworden und ist noch heiß.",
					"roleType": "TALK_ROLE_NPC",
