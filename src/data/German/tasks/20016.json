			"dialogs": [
				{
					"id": 200160101,
					"content": "Bestellung außer Haus",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160102,
					"content": "#{F#Reisende}{M#Reisender}! Du kommst genau richtig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160103,
					"content": "Entschuldige, du musst hungrig sein. Aber könntest du mir einen Gefallen tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160104,
					"content": "In letzter Zeit bestellen immer mehr Leute außer Haus. Als Erstes teile ich die Bestellungen normalerweise nach der Region auf und versehe sie dann mit dem Namen der bestellenden Person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160105,
					"content": "Der Name für diese <color=#00E1FFFF>Meeresfrüchtesuppe mit Wasserlilie</color> ist verlorengegangen. Ich weiß nur, dass die Bestellung nach Quellingen geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160106
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160106,
					"content": "Kannst du die <color=#00E1FFFF>Meeresfrüchtesuppe mit Wasserlilie</color> nach Quellingen bringen und herausfinden, wer sie bestellt hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160107,
						200160110
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160107,
					"content": "Gern, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160108
					]
				},
				{
					"id": 200160108,
					"content": "Wenn du zurück bist, wird hier eine tolle Mahlzeit auf dich warten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160109,
					"content": "Ich zähle auf dich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160110,
					"content": "Ich bin so hungrig! Ich wollte eigentlich nur etwas essen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160111
					]
				},
				{
					"id": 200160111,
					"content": "Wenn du damit fertig bist, werde ich dich, ja, auf ein Spezialgericht beim Hirschjäger einladen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
