			},
			"dialogs": [
				{
					"id": 240190301,
					"content": "Was sagst du? Ich finde, die Veilchengold-Anglermöwen hier sind richtige Gentlemöwen, ganz anders als die ungehobelte Bande beim Palais Mermonia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190302,
					"content": "Sie sind wirklich sehr freundlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190303
					]
				},
				{
					"id": 240190303,
					"content": "Nicht wahr? Wenn ich einfach dasitze, kann ich spüren, wie entspannt ich bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190304
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190304,
					"content": "Stell dir vor, du wärst eine Veilchengold-Anglermöwe und es würden extra Leute kommen, um dich zu füttern. Du könntest einfach in der Sonne baden und über den Sinn des Lebens nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190305,
					"content": "Ach, warum bin ich ein Gestionär und keine Veilchengold-Anglermöwe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
