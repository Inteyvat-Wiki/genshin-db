			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190101,
					"content": "Damit sollten fast alle Futter bekommen haben. Hoffentlich werden alle satt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190102,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190103
					]
				},
				{
					"id": 240190103,
					"content": "Ich füttere gerade die Veilchengold-Anglermöwen. Schaut, sie sind fast alle satt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190104
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190104,
					"content": "Oha ... Wie kommt es, dass du dich plötzlich so gut mit den Veilchengold-Anglermöwen verstehst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190105,
					"content": "Haben sie dir nicht deine Pommes weggefressen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190106
					]
				},
				{
					"id": 240190106,
					"content": "Nein. Es kommen oft Leute zum Füttern her, deshalb interessieren sich die Veilchengold-Anglermöwen auch nicht für meine Pommes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190107,
					"content": "Aber sagtest du nicht, dass du Arbeit verpassen würdest, wenn du zu weit weggingest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190108,
					"content": "Hahaha, kein Problem, heute ist einer meiner seltenen freien Tage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190109,
					"content": "Hier gibt es keine Kollegen, die über die Arbeit sprechen wollen. Und es gibt auch keine Leute oder Tiere, die mir meine Pommes klauen wollen ... Wirklich der perfekte Ort zum Entspannen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190110,
					"content": "Außerdem sind die Veilchengold-Anglermöwen hier ganz lieb, sie stibitzen meine Pommes nicht und kommen mir auch sonst nicht ins Gehege.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190111,
					"content": "Seit ich sie selbst einige Male gefüttert habe, scheinen mich die Veilchengold-Anglermöwen zu kennen. Sie lassen mich sogar ihre Federn tätscheln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190112,
					"content": "Im Vergleich zu den Veilchengold-Anglermöwen am Palais Mermonia kann man diese hier durchaus als Gentlemöwen bezeichnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190113,
					"content": "Wenn sie lernen würden, mit ihren Krallen auf einer Schreibmaschine zu tippen, könnten sie fast schon unsere Arbeit übernehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190114,
						240190116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190114,
					"content": "Veilchengold-Anglermöwen können doch nicht die Arbeit der Menschen machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190115
					]
				},
				{
					"id": 240190115,
					"content": "Zumindest machen die Veilchengold-Anglermöwen es nicht noch schlimmer. Und jeder weiß, dass einige Arbeiten für die Veilchengold-Anglermöwen zu schwierig sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190118,
					"content": "Reden wir jetzt nicht darüber. Möchtest du versuchen, dich mit diesen Gentlemöwen anzufreunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190119,
					"content": "Jetzt nennst du sie schon Gentlemöwen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190120,
						240190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190120,
					"content": "Ist es nicht zu forsch, wenn ich einfach zu ihnen gehe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190121
					]
				},
				{
					"id": 240190121,
					"content": "Nein, diese sind sehr tolerant, solange man nicht versucht, ihnen die Federn zu ziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190124,
					"content": "Komm, diesen Fisch habe ich extra vorbereitet, du kannst ihn direkt ins Becken werfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190125
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190125,
					"content": "Entspann dich. Die Veilchengold-Anglermöwen sind sehr tolerant, füttere sie einfach, sie werden dir dankbar sein. Sie stellen keine Fragen darüber, woher der Fisch stammt oder wie er hergestellt wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190122,
					"content": "Muss ich etwas beachten, wenn ich mich mit den Veilchengold-Anglermöwen anfreunden möchte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190123
					]
				},
				{
					"id": 240190123,
					"content": "Eigentlich nichts Besonderes. Zieh ihnen nur nicht an den Federn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190116,
					"content": "Aber Veilchengold-Anglermöwen verstehen doch die menschliche Sprache nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190117
					]
				},
				{
					"id": 240190117,
					"content": "Sei dir mal nicht so sicher. Vielleicht geben sie ja nur vor, unsere Sprache nicht zu verstehen, um ihr Leben nicht unnötig kompliziert zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				}
			]
		},
