					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190801,
					"content": "Wie ... Wie kannst du so etwas tun! Sie sind doch nicht wie diese Bande von Störenfrieden am Palais Mermonia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190802
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190802,
					"content": "Tut mir leid, ich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190803
					]
				},
				{
					"id": 240190803,
					"content": "He, ich konnte dich gar nicht aufhalten. Ich habe keine Ahnung, warum du das machst ... Hat dich vielleicht eine Veilchengold-Anglermöwe angegriffen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190804
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190804,
					"content": "Jetzt ist es zu spät, die Veilchengold-Anglermöwen haben sich verzogen. Da kann man nichts machen. Ich werde ihnen in ein paar Tagen wieder etwas mitbringen und mich bei ihnen entschuldigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
