				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20080301,
					"content": "Wie seltsam ... Hier ist es nie so still.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080302,
					"content": "Wuff, wuff ... Wuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080303
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080303,
					"content": "Spielt Thoma wieder Bauchredner?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080304,
					"content": "Thoma ... Thoma ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080305,
					"content": "Wuff! Wuff! ... Wuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080306
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080306,
					"content": "He, du kannst jetzt rauskommen ... Paimon hat dich schon gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080307,
					"content": "Hm, keine Spur ... Hmpf, wo zum Geier ist er dann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080308,
					"content": "Wuff, wuff, wuff! Wuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080309
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080309,
					"content": "Hm? Was hat Taroumaru heute so aufgebracht? Sonst ist er immer so ein braver Hund ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080310,
					"content": "Hallo, habt ihr Thoma gesehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080311
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080311,
					"content": "Nein, wir dachten, er wäre bei dir! Warum ... ist was passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080312,
					"content": "Dann sind meine Befürchtungen also wahr. Auf dem Weg hierher hab ich gehört, dass Thoma von der Tenryou-Verwaltung mitgenommen wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080313
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080313,
					"content": "Ich wusste nicht, ob das wahr ist, deshalb bin ich direkt hierhergekommen. Wir hätten uns hier treffen sollen und er ist nicht da, deshalb stimmen die Gerüchte wohl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080314
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080314,
					"content": "Shougun Raiden hält eine Augenhatzzeremonie bei der Statue des Allgegenwärtigen ab, um das hundertste im Rahmen des Dekrets beschlagnahmte Göttliche Auge zu feiern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080315
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080315,
					"content": "Und der hundertste Träger des Göttlichen Auges ... dessen Göttliches Auge heute beschlagnahmt wird ist ... Thoma, fürchte ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080316
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080316,
					"content": "Moment mal ... Diese Zeremonie, die die Tenryou-Verwaltung laut Thoma so beschäftigt hat, das war diese Augenhatzzeremonie? Und er war die ganze Zeit über das Ziel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080317,
					"content": "Ich fürchte, so ist es. Der Shougun und die Tenryou-Verwaltung betrachten die Zeremonie als einen Meilenstein. Mit dem hundertsten Göttlichen Auge wollen sie den bisherigen Erfolg des Augenhatz-Dekrets feiern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080318
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080318,
					"content": "Das darf nicht sein. Ich muss ihn retten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080319
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080319,
					"content": "Wuff, wuff! Wuff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080320
					],
					"speakerTitle": "Taroumaru"
				},
				{
					"id": 20080320,
					"content": "Beruhige dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080321
					]
				},
				{
					"id": 20080321,
					"content": "Aber du bist die Shirasagi Himegimi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080322
					]
				},
				{
					"id": 20080322,
					"content": "Ja! Ob es dir gefällt oder nicht. Du repräsentierst die ganze Yashiro-Verwaltung. Wenn du also so etwas abziehst, erklärst du Shougun Raiden praktisch den Krieg, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080323,
					"content": "Und wenn du das öffentlich machst, ziehst du viele andere Mitglieder der Yashiro-Verwaltung mit rein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20080324,
					"content": "Ich habe keine Wahl ... Ich muss schnell handeln ... Die Zeremonie beginnt gleich und ich werde Thoma nicht im Stich lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080325
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080325,
					"content": "Er ist mein Freund! Wenn ich nur daran denke, dass wir ... noch vor Kurzem alle zusammen um den Feuertopf saßen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080326
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080326,
					"content": "Er ist auch mein Freund. Ich werde ihn retten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080327
					]
				},
				{
					"id": 20080327,
					"content": "Aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080328
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080328,
					"content": "Du hast es selbst gesagt. Wir haben keine Zeit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20080329
					]
				},
				{
					"id": 20080329,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080330
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080330,
					"content": "Gut, ich ... warte hier auf eure Rückkehr. Seid vorsichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20080331
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20080331,
					"content": "Keine Sorge, Ayaka. Es geht um das Leben eines Freundes ... Das werden wir nicht vermasseln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
