			"dialogs": [
				{
					"id": 220320201,
					"content": "So schnell zurück? Du bist doch kein heimlicher Koch, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320202
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320202,
					"content": "Hmmm ... Ich kann es nicht abwarten, bitte lass es mich ausprobieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320203,
						220320204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320203,
					"content": "Bitte genieße es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220320204,
					"content": "Schauen wir mal ... Über welche Gerichte haben wir gerade gesprochen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320205
					]
				},
				{
					"id": 220320205,
					"content": "Oh ja ... Eichhörnchenfisch, Gekochter Schwarzrückenbarsch-Eintopf und gegrillter Fischspieß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320206,
					"content": "Entscheide dich und gib es Tang Wen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2203203,
			"completionStepIds": [
				2203203
			],
