					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320601,
					"content": "Hmm? Warum schmeckt dieses Gericht ... so ... so interessant?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320602
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320602,
					"content": "Vielleicht sollte ich nicht interessant sagen ... Äh, vielleicht eher ... einzigartig oder so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320603
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320603,
					"content": "Wie bist du auf so ein Gericht gekommen? Deine Kochkünste sind wirklich ... nicht von dieser Welt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320604
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320604,
					"content": "#Danke für deine harte Arbeit! {F#Reisende}{M#Reisender}, bitte nimm das. Ich, ähm, genieße dieses Gericht später ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
