			"dialogs": [
				{
					"id": 220320701,
					"content": "Also, welches Gericht sollten wir zubereiten, das mit Fisch gekocht wird? Wie wäre es, wenn wir eines für sie auswählen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320702,
					"content": "Schauen wir mal ... Meine Lieblingsfischgerichte in letzter Zeit sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320703,
					"content": "Würziger gekochter Schwarzrückenbarsch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320704,
					"content": "Süßsaurer Eichhörnchenfisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320705,
					"content": "Und der allmächtige gegrillte Fischspieß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320706,
					"content": "Das alles isst du gern, nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320707
					]
				},
				{
					"id": 220320707,
					"content": "Hehe, vertraue einfach auf Paimons Geschmack! Beeil dich und wähle eins aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320708,
						220320710,
						220320712,
						220320714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320708,
					"content": "Gekochter Schwarzrückenbarsch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320709
					]
				},
				{
					"id": 220320709,
					"content": "Klingt toll! Lass uns schnell gekochten Schwarzrückenbarsch für Fräulein Tang Wen machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320710,
					"content": "Eichhörnchenfisch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320711
					]
				},
				{
					"id": 220320711,
					"content": "Juhu! Lass uns schnell Eichhörnchenfisch für Frau Tang Wen machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320712,
					"content": "Gegrillter Fischspieß.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320713
					]
				},
				{
					"id": 220320713,
					"content": "Juhu! Lass uns schnell einen gegrillten Fischspieß für Frau Tang Wen machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320714,
					"content": "Lass mich überlegen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320715
					]
				},
				{
					"id": 220320715,
					"content": "Hmm, lass uns das Gericht für Tang Wen zubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2203208,
			"completionStepIds": [
				2203201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203201",
							"2"
						],
						"stepId": 2203201,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"12042",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320801,
					"content": "Aah, es wäre schön, Gerichte aus Liyue zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320802
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320802,
					"content": "Was ist denn los?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320803
					]
				},
				{
					"id": 220320803,
					"content": "#Wer bist du? Mit dieser Aufmachung ... Du bist {F#die}{M#der} Reisende, richtig? Tut mir leid, ich habe nur ein bisschen Heimweh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320804,
						220320805
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320804,
					"content": "Hast du gerade gesagt, dass du Gerichte aus Liyue haben willst?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				},
				{
					"id": 220320818,
					"content": "Hm? Du weißt, wie man die Gerichte aus Liyue macht? Das ist großartig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320819
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320819,
					"content": "Dann hilf mir bitte! Bitte mach mir ein paar authentische Liyue-Gerichte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320820
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320820,
					"content": "Lass mich nachdenken ... Was ich jetzt wirklich essen möchte, ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320821
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320821,
					"content": "Hmm ... Ich möchte Fisch essen! Ich vermisse den Fisch, den meine Mutter gemacht hat, als ich ein Kind war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320822
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320822,
					"content": "Den Fisch waschen, auf beiden Seiten einschneiden, mit Gewürzen und reifem Wein füllen und leicht marinieren, in einer Pfanne goldbraun braten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320823
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320823,
					"content": "Dann mit heißem Wasser aufgießen und die Soße köcheln lassen, schließlich bei großer Hitze abschmecken, die Soße andicken, auf den Teller geben und servieren ... Ah! Das ist das einzig Wahre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320824
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320824,
					"content": "Mein jüngerer Bruder schnüffelte an der Seite herum, während er sprang und jubelte „Sehr gut!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320825
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320825,
					"content": "*schluchz* Meine Mutter kann wirklich gut Fisch kochen, aber wann kann ich ihn wieder essen gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320805,
					"content": "Brauchst du Hilfe bei irgendetwas?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320806
					]
				},
				{
					"id": 220320806,
					"content": "Ich möchte mich vorstellen. Ich bin Tang Wen, eine Historikerin aus Liyue. Ich habe zuvor eine Feldforschung über die einzigartigen Bräuche und die Folklore von Inazuma gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320807
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320807,
					"content": "Ich hatte eigentlich alles Material, das ich brauchte, gesammelt und wollte mich auf den Weg zurück nach Liyue machen. Aber in Inazuma ist in letzter Zeit so viel Großes passiert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320808
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320808,
					"content": "Ich habe das Gefühl, dass ich hier in historischen Zeiten lebe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320809
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320809,
					"content": "Die Geschehnisse dieser Zeit werden sicherlich einen starken Eindruck in den Annalen der Geschichte Teyvats hinterlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320810
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320810,
					"content": "Eine solche Geschichte mit eigenen Augen mitzuerleben und dann alles wahrheitsgetreu, vollständig und klar für die Nachwelt festzuhalten, ist das, was ein Historiker tun sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320811
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320811,
					"content": "Aber ... so aufregend diese Sache für mich auch ist, meinen Magen wird es nicht zufriedenstellen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320812
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320812,
					"content": "Bekommst du Hunger?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320813
					]
				},
				{
					"id": 220320813,
					"content": "Ich kann es nicht sagen ... Ja, es liegt daran, dass ich hungrig bin ... Hahaha, das Essen in Inazuma ist auch ziemlich lecker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320814
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320814,
					"content": "Ich mag das Tempura hier wirklich, obwohl es sich anfühlt, als ob alles mit Teig überzogen und dann frittiert wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320815
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320815,
					"content": "Aber nachdem ich lange Zeit die Gerichte aus Inazuma gegessen hatte, begann ich, die aus Liyue zu vermissen. Leider konnte ich kein Restaurant finden, das authentische Liyue-Küche zubereiten konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320816
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320816,
					"content": "Ich habe mich vor ein paar Tagen dazu entschlossen, eine Mission für Gerichte bei der Abenteurergilde auszuhängen, aber es gab noch keine Reaktion ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320817
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320817,
					"content": "Kann ich es versuchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				}
			]
		}
	]
}