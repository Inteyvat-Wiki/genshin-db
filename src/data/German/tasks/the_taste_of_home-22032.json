					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320401,
					"content": "Hmm, dieser Geschmack ... Na ja, es scheint nicht wie ein Liyue- oder Inazuma-Gericht zu schmecken. Der Geschmack ist wirklich neu für mich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320402
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320402,
					"content": "Obwohl es nicht die Küche ist, die ich wollte, bin ich schon zufrieden, so ein neuartiges Gericht probieren zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320403
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320403,
					"content": "#Danke, {F#Reisende}{M#Reisender}. Bitte nimm das an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203205,
			"completionStepIds": [
				2203205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2203205",
							"2"
						],
						"stepId": 2203205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tang Wen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320501,
					"content": "Hm? Ich glaube, das ist immer noch ein Inazuma-Gericht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320502
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320502,
					"content": "Ich glaube nicht, dass dies das Gericht ist, nach dem ich gefragt habe ... Na ja, egal, dieses Gericht ist auch sättigend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320503
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320503,
					"content": "#Trotzdem danke, {F#Reisende}{M#Reisender}. Bitte nimm das hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
			"id": 2203206,
			"completionStepIds": [
				2203206
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
