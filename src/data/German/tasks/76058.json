			"dialogs": [
				{
					"id": 760580101,
					"content": "Ich habe noch nie zuvor einen derart weißen Schatzmarder gesehen. Ob er wohl krank ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580102
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580102,
					"content": "Schau nur, wie er herumtollt! Gerade noch wollte er Jurva das Essen stehlen. Nein, der ist ganz bestimmt nicht krank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580103
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580103,
					"content": "Vielleicht ist es eine seltene Art? Linnea könnte das vielleicht wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580104
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580104,
					"content": "Was?! Das ist der Mora-Dieb, der Paimons gesamte Ersparnisse gestohlen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760580105,
					"content": "Der Schatzmarder versucht zu fliehen, wird aber von drei flinken Kindern festgehalten. Nach einem kurzen Kampf gibt er jedoch auf. Du nutzt die Gelegenheit, um den Kindern zu erzählen, was sich zuvor ereignet hat ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760580106
					]
				},
				{
					"id": 760580106,
					"content": "Also ein Wiederholungstäter. Wir müssen ihm eine Lektion erteilen. Denn wer etwas Böses tut, muss dafür bestraft werden – so gehört sich das!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580107
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580107,
					"content": "Aber ... Aber er ist doch nur ein kleines Tier, es versteht das alles doch gar nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580108,
						760580109
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580108,
					"content": "Es reicht, wenn du Paimon ihre Mora zurückgibst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				},
				{
					"id": 760580110,
					"content": "Wie auch immer, lass uns erst mal die Mora, die er bei sich hatte, an Paimon zurückgeben. Da er die Mora sowieso nirgendwo ausgeben konnte, ist noch alles da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580111
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580111,
					"content": "Großartig! Hehe, jetzt ist Paimons kleine Schatzkammer wieder prall gefüllt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760580112,
					"content": "Es wäre toll, wenn ich ihn behalten könnte. Dann könnte ich Helka diesen seltenen Schatzmarder zeigen, wenn sie zurückkommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580113
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580113,
					"content": "Hm? Aber er ist ja für keine Arbeit zu gebrauchen ... Klauen zählt nicht als Arbeit, und wer nicht arbeitet, der hat auch kein Recht auf kostenloses Essen und Trinken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580114
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580114,
					"content": "Na gut, na gut, was sollen wir dann mit ihm machen ... Am besten, wir besprechen das nachher mit Katya und entscheiden dann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580109,
					"content": "Auch kleine Tiere sollten wissen, wie grausam diese Welt ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				}
			]
		}
	]
}