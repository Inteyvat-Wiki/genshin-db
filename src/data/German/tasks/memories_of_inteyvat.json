			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 80062001,
					"content": "Wie bei den normalen Hilichurlen gibt es auch hier Lagerfeuer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062002,
					"content": "Aber Dain sagt eindeutig, dass die Hilichurle am Ende ihres Lebens lichtscheu werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062003,
					"content": "Könnte es sein, dass sie am Ende des Tages immer noch das Licht und die Wärme spüren wollen? Ah, das ist nur eine Vermutung ... es könnte auch etwas anderes sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 800621,
			"completionStepIds": [
				800610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
