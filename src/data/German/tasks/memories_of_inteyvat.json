				"points": []
			},
			"dialogs": [
				{
					"id": 80060801,
					"content": "Puh! Der Abgrundbote, den du so lange gejagt hast, ist endlich ausgeschaltet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060802,
					"content": "Es ist keine Zeit für müßiges Geschwätz. Es scheint, dass die Vorrichtung vom Orden des Abgrunds aktiviert wird und es noch nicht zu spät ist, sie zu zerstören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060803
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060803,
					"content": "Ja! Lasst uns hingehen und es uns ansehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 800620,
			"completionStepIds": [
				800609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
