			},
			"dialogs": [
				{
					"id": 80060601,
					"content": "Von hier aus kann man auch die auf dem Kopf stehende Stadt sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060602,
					"content": "Achtung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060603
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060603,
					"content": "Waaaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060604,
					"content": "Was? Was ist hier los? Ist es das Licht aus dem Raum in der Mitte vorher? Paimons Augen tun weh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060605,
					"content": "Die Veränderung geht weiter. Hat der Abgrund angefangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060606
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060606,
					"content": "#Dainsleif ... Wie ich sehe, mischst du dich weiter ein und hast dich wieder einmal mit {F#der Schwester}{M#dem Bruder} unserer Hoheit verbündet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060607
					],
					"speakerTitle": "Abgrundbote"
				},
				{
					"id": 80060607,
					"content": "Ich hatte keine Zeit, das Teleportationsnetz zu überprüfen, und habe dich aus Versehen hierher teleportiert ... Was für ein fataler Fehler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060608
					],
					"speakerTitle": "Abgrundbote"
				},
				{
					"id": 80060608,
					"content": "Ha! Feigling, der nur weglaufen kann, wer hat dir den Mut gegeben, mir gegenüberzutreten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060609
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060609,
					"content": "Der Wille unserer Hoheit muss erfüllt werden. Alle Störungen müssen beseitigt werden ... egal, wie hoch der Preis dafür ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060610
					],
					"speakerTitle": "Abgrundbote"
				},
				{
					"id": 80060610,
					"content": "Diesmal muss es ein für alle Mal geschehen ... Der Fluch, der die Menschen quält, muss beseitigt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060611
					],
					"speakerTitle": "Abgrundbote"
				},
				{
					"id": 80060611,
					"content": "Ihr seid es, die sie quälen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060612
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060612,
					"content": "Von diesen Hilichurlen ist nichts mehr als der Fluch übrig geblieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060613
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060613,
					"content": "Ich werde nicht weglaufen. Komm schon, Dainsleif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060614
					],
					"speakerTitle": "Abgrundbote"
				},
				{
					"id": 80060614,
					"content": "Ist es ein solch lächerlicher Wille wert, mit seinem Leben zu warten? Wenn du durchhalten willst, dann soll es so sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800608,
			"completionStepIds": [
				800608
			],
