			},
			"dialogs": [
				{
					"id": 80062201,
					"content": "Diese Hilichurle ... sind völlig leblos, kurz davor, mit der Dunkelheit eins zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062202,
					"content": "Es ist erstaunlich, dass die stets lärmenden Hilichurle auf diese Weise alt geworden sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062203,
					"content": "Auch wenn es nicht viele gute Erinnerungen an die Hilichurle gibt, hoffen wir, dass sie in ihren letzten Momenten Frieden gefunden haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
