			},
			"dialogs": [
				{
					"id": 80062101,
					"content": "In diesen Kisten lagern die Hilichurle im Allgemeinen ihre Lebensmittel, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062102,
					"content": "Es scheinen ... alle leer zu sein. Brauchen die Hilichurle am Ende ihres Lebens nichts mehr zu essen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80062103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80062103,
					"content": "Wenn es nach mir ginge, würde ich sicher immer noch den Geschmack des Essens vermissen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 800622,
			"completionStepIds": [
				800611
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
