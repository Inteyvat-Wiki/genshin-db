			"dialogs": [
				{
					"id": 80060501,
					"content": "Wie konnte eine solche Blume so tief in der Erde gefunden werden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060502,
					"content": "Ist sie diesen toten Hilichurlen gewidmet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060503,
						80060504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060503,
					"content": "Ich weiß, was das für eine Blume ist ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060505
					]
				},
				{
					"id": 80060505,
					"content": "He, wenn du das sagst, kommt mir das auch etwas bekannt vor ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060506,
					"content": "Sie ist die Nationalblume von Khaenri’ah, die Inteyvat. Sie ist einst in jedem Winkel des Landes Khaenri’ah aufgeblüht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060507
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060507,
					"content": "Die Blütezeit dauert ursprünglich nur zwei Wochen. Wenn sie jedoch zerbrochen und aus dem Land von Khaenri’ah entfernt werden, hören die Blütenblätter auf zu wachsen und werden sehr solide.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060508
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060508,
					"content": "Erst bei der Rückkehr in den heimischen Boden werden die Blütenblätter wieder weich und sterben schließlich im Staub ab ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060509
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060509,
					"content": "So symbolisiert die Inteyvat auch den „Wanderer“ und steht für die „Zärtlichkeit der Heimat“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060510
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060510,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_Twins2Male|INFO_FEMALE_PRONOUN_Twins2Female]}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060511
					]
				},
				{
					"id": 80060511,
					"content": "Ah! Diese Blume ist hier, was bedeutet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060512,
					"content": "Eure Hoheit ... der Vorschlag hat also endlich Euren Segen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060513
					],
					"speakerTitle": "Abgrundbote"
				},
				{
					"id": 80060513,
					"content": "Wir waren so sehr in den Kampf gegen die „himmlische Ordnung“ vertieft, dass wir die Mission der „Wiederherstellung des Reichs“ vergaßen.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060514
					]
				},
				{
					"id": 80060514,
					"content": "Ich hätte in der Tat nicht so unentschlossen sein dürfen.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060515
					]
				},
				{
					"id": 80060515,
					"content": "Der „Apparat“ ist fast bereit. Wir warten auf Euren Befehl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060516
					],
					"speakerTitle": "Abgrundbote"
				},
				{
					"id": 80060516,
					"content": "Wie sicher?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060517
					]
				},
				{
					"id": 80060517,
					"content": "Theoretisch, wahrscheinlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060518
					],
					"speakerTitle": "Abgrundbote"
				},
				{
					"id": 80060518,
					"content": "Vergiss es, auch wenn es nur eine einprozentige Chance ist ...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060519
					]
				},
				{
					"id": 80060519,
					"content": "Sitzen wir nicht alle im selben Boot, da wir schon zu lange am Abgrund verweilen?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060520
					]
				},
				{
					"id": 80060520,
					"content": "Für sie ist es besser, in den „Kreislauf“ zurückzukehren, als ein Leben ohne Würde zu führen.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060521
					]
				},
				{
					"id": 80060521,
					"content": "Lasst nicht zu, dass „sie“ diese ungerechtfertigten Sünden weiter tragen.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060522
					]
				},
				{
					"id": 80060522,
					"content": "Es ist ein Segen für den Orden, dass Eure Hoheit diese Entscheidung getroffen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060523
					],
					"speakerTitle": "Abgrundbote"
				},
				{
					"id": 80060523,
					"content": "#{F#Bruder}{M#Schwester} ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060524
					]
				},
				{
					"id": 80060524,
					"content": "Du scheinst etwas gesehen zu haben. Kannst du mir das erklären?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060525
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060525,
					"content": "Ja, du scheinst schon lange erstarrt zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060526,
					"content": "Du erzählt Dainsleif, was du gerade gesehen hast ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80060527
					]
				},
				{
					"id": 80060527,
					"content": "Ist dies eine erstaunliche Verbindung, die nur den „Zwillingen“ gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060528
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060528,
					"content": "Es klingt so, als hätten sie versucht, den Fluch mit einem Gerät zu reinigen, möglicherweise mit demselben Gegenstand, den wir zuvor gesehen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060529
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060529,
					"content": "#Und ... {F#Er}{M#Sie} hat die „Wiederherstellung des Reichs“ auch erwähnt, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060530,
						80060531
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060530,
					"content": "Genau.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060532,
					"content": "Dieser hartnäckige Kerl hat tatsächlich noch nicht aufgegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060533
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060533,
					"content": "Offenbar plante der Orden, diesen Ort zu nutzen, um den Fluch von den Hilichurlen zu nehmen und sie wiederherzustellen ... und so als Grundlage für die Wiederherstellung von Khaenri’ah zu dienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060534
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060534,
					"content": "Schließlich kann es kein „Land“ ohne „Volk“ geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060535,
						80060536
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060535,
					"content": "Wie siehst du das?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060537,
					"content": "Das ist Dummheit in Reinkultur. Die Wahrscheinlichkeit dafür liegt bei nicht einmal einem Prozent.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060538
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060538,
					"content": "Ich sagte doch, als jemand, der fünfhundert Jahre lang mit dem Fluch gelebt hat, versteht niemand besser als ich, dass es niemals eine Erlösung gibt. Der Fluch ist unumkehrbar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060539
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060539,
					"content": "Wenn der Fluch gewaltsam gebrochen wird, bringt das nichts als Schmerz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060540
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060540,
					"content": "Also bleibt wach und sagt euch immer wieder: Sie sind keine Menschen mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060541
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060541,
					"content": "Sich daran zu klammern, zu viele Gnaden zu spenden, bedeutet nur, tiefer und tiefer zu sinken ... und schließlich, wie sie, in den Schlamm namens Heuchelei zu fallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060542
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060542,
					"content": "Es ist besser, sich auf etwas zu konzentrieren, das mehr wert ist, gerettet zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060543
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060543,
					"content": "Warum sollte ich dir vertrauen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060544
					]
				},
				{
					"id": 80060544,
					"content": "Hm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060545
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060545,
					"content": "#Haha ... stimmt auch wieder. Wir haben nichts weiter als ein Arbeitsverhältnis und {F#er}{M#sie} ist blutsverwandt mit dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060546
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060546,
					"content": "#Dass du {F#ihm}{M#ihr} mehr vertraust, ist kein Problem und verständlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060547
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060547,
					"content": "Wie auch immer du dich entscheidest, es wird mein Herz nicht erschüttern. Den Abgrund aufzuhalten ist der Weg, für den ich mich entschieden habe, und wenn wir uns nicht darauf einigen können, dann sollten wir einfach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060548
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060548,
					"content": "Diesmal möchte ich dir vertrauen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060549,
						80060550
					]
				},
				{
					"id": 80060549,
					"content": "Das heißt aber nicht, dass ich dir völlig vertraue.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060551,
					"content": "Ach so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060552,
						80060553
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060552,
					"content": "Die Chance, gerettet zu werden, steht eins zu hundert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060554,
					"content": "Niemand kann sich erlauben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060556,
					"content": "Und diese Hilichurle ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060558,
					"content": "Es scheint, dass die drei Fragen, die ich dir ursprünglich gestellt habe, nicht sinnlos waren. Du hast eine Sichtweise auf diese Welt gefunden, die nur dir eigen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060559
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060559,
					"content": "Jetzt, da du uns verraten hast, was du wirklich denkst, werde ich es nicht länger verheimlichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060560
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060560,
					"content": "Im Moment geht es mir nicht nur darum, den Abgrund aufzuhalten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060561
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060561,
					"content": "Ich darf auf keinen Fall zulassen, dass der „Wille“ von Halfdan und der anderen mit Füßen getreten wird, indem sich der Abgrund alles unter den Nagel reißt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060562,
						80060563
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060562,
					"content": "Verstehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060564,
					"content": "Der Abgrund kann jeden Moment auftauchen, bleib wachsam. Gehen wir weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060563,
					"content": "Schließen wir uns weiter zusammen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060557,
					"content": "hatten schon ihren Rückzugsort gefunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060555,
					"content": "diese Entscheidung für andere zu treffen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060553,
					"content": "Eine Chance von neunundneunzig Prozent auf einen schmerzhaften Tod.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060550,
					"content": "#Es ist nur, dass ich {F#ihm}{M#ihr} nicht zustimme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060536,
					"content": "Besteht die Möglichkeit, dass dies geschieht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060531,
					"content": "#Nun, {F#er}{M#sie} sagte, dass das Schicksal sei ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060504,
					"content": "Ich habe diese Blume schon einmal gesehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060505
					]
				}
			]
		}
	]
}