			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100101,
					"content": "P... Paimon kann sich an alles erinnern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100102,
					"content": "... Sehr gut, dieses Mal habt ihr euch sehr schnell daran gewöhnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100103
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100103,
					"content": "Am Ende der letzten Nacht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100104
					]
				},
				{
					"id": 30100104,
					"content": "Genau, gestern Nacht haben wir die Akasha-Kontrollgeräte ganz klar abgelegt und trotzdem weiterhin dessen Geräusch gehört. Wie kann das sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100105,
						30100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100105,
					"content": "Wurde uns eine andere Form vom Akasha-Kontrollgerät eingepflanzt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				},
				{
					"id": 30100107,
					"content": "Aber jetzt können wir zumindest feststellen, dass unsere Gefangenschaft in diesem Zyklus etwas mit Akasha zu tun hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100108,
					"content": "Falls Akasha die Weisheit Aller „stehlen“ muss, warum sollte es dann so eine Situation herbeiführen? Paimon kann das nicht verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100109,
					"content": "Für die Laborratte auf dem Experimentiertisch ist es wirklich schwer herauszufinden, warum sie so behandelt wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100110
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100110,
					"content": "Vergleichst du uns beide mit Laborratten? Was bist du dann, Nahida? Du hast uns nie etwas über dich erzählt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100111,
					"content": "Hmm ... Ich bin der „Mond“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100112
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100112,
					"content": "Der Mond? War das nicht das Ergebnis unserer Weissagung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100113,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100114
					]
				},
				{
					"id": 30100114,
					"content": "Zu wissen, wer ich bin, wird euch nicht näher an die Wahrheit bringen. Konzentriert euch besser auf etwas anderes und passt auf, keine wichtigen Hinweise zu übersehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100115
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100115,
					"content": "Na gut ... Da Dehya uns gestern sehr viel geholfen hat, sollten wir zuerst zu ihr gehen. Zu dieser Zeit sollten gerade diese Entführer auftauchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100106,
					"content": "Haben wir nur geglaubt, wir hätten das Akasha-Kontrollgerät abgelegt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				}
			]
		},
		{
			"id": 301002,
			"completionStepIds": [
				301002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301002",
							"2"
						],
						"stepId": 301002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100201,
					"content": "Hier seid ihr also. Ich habe mich schon um diese Entführer gekümmert. Geht es dem Fräulein gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100202,
					"content": "Warte kurz, irgendwas stimmt hier nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100203
					]
				},
				{
					"id": 30100203,
					"content": "Oh ... Dehya ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100204,
					"content": "Was ist los? Warum starrt ihr mich so an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100205
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100205,
					"content": "Wa... Warum bist du dieses Mal unverletzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100206,
					"content": "Äh? Was soll das heißen „dieses Mal“? Und weshalb sollte ich verletzt sein? Das waren doch nur ein paar Feld-Wald-und-Wiesen-Entführer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100207,
						30100208
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100207,
					"content": "Hast du dich denn schon an dein Großschwert gewöhnt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				},
				{
					"id": 30100209,
					"content": "Pst! Woher wisst ihr von der Sache mit meinem Großschwert? Das habe ich doch niemandem erzählt. Sagt dem Fräulein nichts davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100210
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100210,
					"content": "Dehya hat ihre Erinnerungen also doch verloren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100211,
						30100212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100211,
					"content": "Beim diesmaligen Kampf ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100213,
					"content": "Irgendwie seltsam ... Na ja, wie ihr bereits wisst, habe ich ein neues Großschwert. Aber irgendwie kommt es mir sehr vertraut vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100214,
					"content": "Als ob ... Als ob ich mit ihm schon ganz viele Schlachten geschlagen hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100215
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100215,
					"content": "Du meinst, obwohl du dich nicht erinnern kannst, mit dem Schwert gekämpft zu haben, ist es dein Körper ... bereits gewohnt, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100216,
					"content": "Richtig. Für Söldner und Krieger ist das „Körpergedächtnis“ sehr wichtig. Die genaue Erinnerung mit dem Gehirn zählt da nur wenig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100217
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100217,
					"content": "#{NICKNAME}, was hältst du davon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100218,
						30100219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100218,
					"content": "Liegt das daran, dass wir die Akasha-Kontrollgeräte gestern abgelegt haben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100220,
					"content": "Genau, Paimon hat jetzt ein wenig Hoffnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100221,
					"content": "Kann es sein ... dass wir uns schon befreit haben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100222
					]
				},
				{
					"id": 30100222,
					"content": "Oh ja, in den bisherigen „Samsara des Sabzeruz-Fests“, hätte so etwas nicht passieren können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100223,
					"content": "Wenn der Tag vorbei ist, wissen wir es.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100224
					]
				},
				{
					"id": 30100224,
					"content": "Auch wenn ich nicht ganz verstehe, wovon ihr redet, ist die Gefahr immer noch nicht gebannt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100225
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100225,
					"content": "Du meinst, solange die Gefahr nicht gebannt ist, sollten wir zuerst Dunyarzad an einen Ort zum Ausruhen bringen, und du wirst noch kurz überprüfen müssen, ob die Entführer noch Komplizen haben, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100226,
					"content": "Woher wusstest du, dass ich das denke ... Kannst du Gedanken lesen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100227
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100227,
					"content": "Also los!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100219,
					"content": "Das wäre das erste Mal, das so eine Veränderung auftritt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100212,
					"content": "Hast du dich irgendwie seltsam gefühlt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100208,
					"content": "Sonst hättest du bestimmt Kratzer abbekommen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				}
			]
		},
		{
			"id": 301003,
			"completionStepIds": [
				301003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301003",
							"2"
						],
						"stepId": 301003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100301,
					"content": "... Puh, endlich ist es Nacht. Abgesehen von dieser einen Sache scheint sich heute nichts geändert zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100302,
					"content": "Hör zu, Nahida. Heute haben wir festgestellt, dass Dehya heute, anders als bei jedem früheren Kampf gegen die Entführer, unverletzt geblieben ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100303,
					"content": "Kann das bedeuten, dass das „Samsara des Sabzeruz-Fests“ schon beendet ist? Haben wir Dunyarzad gerettet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100304,
					"content": "Oh? Das klingt nach einem großen Fortschritt. Dann solltet ihr euch heute gut ausruhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100305
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100305,
					"content": "Was ist denn das für eine Antwort?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100306,
					"content": "Jeder weiß, dass ein „Morgen“ kommt. Aber ob das wirklich so sein wird, das können wir erst wissen, wenn „Morgen“ da ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100307
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100307,
					"content": "Wie viele Male haben wir das „Heute“ schon erlebt? Kann es sein, dass auf Heute Gestern folgen wird? Ist das „Morgen“ vielleicht nur ein künstliches Konzept?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100308
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100308,
					"content": "Vielleicht ist selbst die ganze Welt nicht echt und die Geschichte dieses Kontinents ist nichts als ein ewiges „Sabzeruz-Fest“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100309
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100309,
					"content": "Rede bitte nicht weiter. Paimon ist schon ganz verwirrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100310,
					"content": "Hehe ... Deshalb muss man sich heute gar nicht damit auseinandersetzen, was morgen sowieso passieren wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100311
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100311,
					"content": "Ruht euch gut aus, macht zum Beispiel einen erlösenden Toilettengang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100312
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100312,
					"content": "Äh? Einen Moment, was hast du eben gesagt? Paimon hat sich doch wohl verhört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100313,
					"content": "Hmm? Die Menschen sagen doch immer, dass sie sich nach dem Toilettengang wie ein neuer Mensch fühlen. Deshalb rate ich euch, das auch zu machen. Ist das denn so merkwürdig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100314
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100314,
					"content": "Äh ... Das ist so merkwürdig und so gegen den gewöhnlichen Menschenverstand, dass Paimon die Worte fehlen ... Du hast eben doch noch irgendwelche großen Wahrheiten verkündet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100315,
					"content": "Dann ruhen wir uns erstmal aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100316
					]
				},
				{
					"id": 30100316,
					"content": "Ja ... Auch wenn es Spaß macht, jeden Tag so ein lebhaftes Fest zu feiern, scheint es doch, als hätten wir uns lange nicht ausgeruht. Komm, gehen wir schlafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100317,
					"content": "*tick* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100318,
					"content": "Fahrt mit der „Ernte“ fort. Verglichen mit dem, was wir erhalten werden, ist das doch nur ein winziger Preis.",
					"roleType": "TALK_ROLE_NPC",
