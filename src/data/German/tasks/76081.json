				]
			},
			"dialogs": [
				{
					"id": 760810401,
					"content": "Es war mir eine Ehre, Herr Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810402,
					"content": "Sei unbesorgt, nach eurem Opfer wurde mein Vater Nikita zum neuen Starshyna ernannt. Er führte die Menschen, die ihr gerettet habt, und baute die Legion der Lichthüter wieder auf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810403,
					"content": "Und heute ist unsere Stärke groß genug, um dieses reine Land vor dem Schatten der Wilden Jagd zu beschützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810404
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810404,
					"content": "Eure Aufopferung war nicht vergebens. Eure Taten und euer Wille wurden – und werden – niemals vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810405
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810405,
					"content": "Auf Wiedersehen, Herr Sigurd. Ich werde dich noch öfter besuchen, mögest du in Frieden ruhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
		{
			"id": 7608199,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 760819901,
					"content": "Diese Weise, um Monster zu unterdrücken ... Nein, diese legendäre Figur sollte bereits gestorben sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819902
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819902,
					"content": "Wurde er auf irgendeine Weise wiederbelebt? Ich muss mich mal an den Strand im Nordosten der Moosbedeckten Ödnis begeben. Dort befindet sich seine Grabstätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819903
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819903,
					"content": "Ich habe vom Alten oft von den Taten des legendären Starshyna Sigurd gehört, mit dem er einst Seite an Seite gekämpft hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819904
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819904,
					"content": "Das lila Leuchten des Schwertes, die goldenen Haare ... Genau wie in der Legende. Könnte die Person, der ich in letzter Zeit begegnet bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819905
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819905,
					"content": "Der Strand im Nordosten der Moosbedeckten Ödnis ist sein Grabplatz. Wenn ich Zeit habe, soll ich dort mal vorbeischauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
}