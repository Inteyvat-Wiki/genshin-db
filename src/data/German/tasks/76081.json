					}
				]
			},
			"dialogs": [
				{
					"id": 760810201,
					"content": "Es war ein spannender Kampf, Herr Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810202,
					"content": "Das Ende des Helden, wirklich bedauerlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810203,
					"content": "Einsam wanderst du nun durch das Land, dem du einst dein Leben gewidmet hast ... Als du damals den Eid der Lichthüter geleistet hast, hast du da mit dem heutigen Tag gerechnet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810204,
					"content": "Selbst wenn ja, hättest du wahrscheinlich auch nicht gezögert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810205,
					"content": "Ich werde dich in Zukunft wieder besuchen. Auf Wiedersehen, Herr Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7608103,
			"completionStepIds": [
				7608102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
