						"pointId": 13644
					},
					{
						"sceneId": 3,
						"position": [
							1963.909,
							200.31,
							9077.054
						],
						"pointId": 13645
					}
				]
			},
			"dialogs": [
				{
					"id": 760810301,
					"content": "Herr Sigurd, du bist mein Lebensretter. Wärst du damals nicht mit den Lichthütern gen Süden gezogen, um den Feind abzuwehren, hätte ich wohl ahnungslos mein Leben verloren – und niemand wüsste heute, wo meine Gebeine liegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810302
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810302,
					"content": "Aber warum findet deine Seele keine Ruhe und streift weiterhin umher, immer noch unermüdlich im Kampf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810303
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810303,
					"content": "Von der Verderbnis der Wilden Jagd durchdrungen, ist sogar deine Gestalt in Stücke zerfallen ... Du hast dieses Schlachtfeld nie wirklich verlassen, oder? Für dich ist der Krieg noch immer nicht vorbei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810304
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810304,
					"content": "In dieser Hinsicht bin ich dir vielleicht ähnlich. Wahren Frieden werden wir wohl erst finden, wenn die Wilde Jagd endgültig verschwunden ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810305
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810305,
					"content": "Es ist mir eine Ehre, dich zu treffen, Herr Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810306
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810306,
					"content": "Ich verstehe, für einen Lichthüter ist die beste Art der Kommunikation ein Kräftemessen mit dem Schwert in der Hand.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810307
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810307,
					"content": "Dann lass mich dir zeigen, was die neue Generation der Lichthüter zu bieten hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
