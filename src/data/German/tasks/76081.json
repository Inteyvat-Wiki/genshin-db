			"dialogs": [
				{
					"id": 760810101,
					"content": "Ich habe gehört, dass der legendäre Starshyna Sigurd, der im Kampf starb, ein Langschwert benutzte, und seine Technik zur Unterdrückung von Monstern war absolut einzigartig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810102,
					"content": "Nach der großen Schlacht konnte das Hauptquartier seine Überreste nicht finden, also wurde dieser leere Grabstein für ihn errichtet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810103,
					"content": "Der violette Schwertglanz, blondes Haar ... Er muss der Krieger sein, der überall umherstreift und sich der Wilden Jagd entgegenstellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810104,
					"content": "Anscheinend fand seine Seele keinen Frieden, genau wie die vielen Geister, die auf dem Friedhof der letzten Nacht umherwandern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810105,
					"content": "Der Held, der sein Schwert gegen die Wilde Jagd erhob, kämpfte weiterhin gegen sie, selbst nach seinem Tod.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810106,
					"content": "Du hast meine Hochachtung, Herr Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810107
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810107,
					"content": "Aber für einen Krieger, der nur aus Hass und Pflicht kämpft, ist die Einsamkeit zu grausam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810108,
					"content": "Erinnerst du dich an die Tage, als du Seite an Seite mit anderen gekämpft hast? Gibt es einen anderen Grund, weshalb du dein Schwert schwingen willst, als um Feinde zu töten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810109
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810109,
					"content": "Wenn ja, dann zeige dich mir. Warum kämpfst du nicht gegen mich? Wie die Kräftemessen, die Lichthüter oft miteinander veranstalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7608102,
