			"dialogs": [
				{
					"id": 223020401,
					"content": "Dieses Mal werde ich es sicher schaffen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020402
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 223020402,
					"content": "Wenn es klappt, wird man das Buch auf der ganzen Welt lesen können. Dann wird sie es auch lesen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020403
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 223020403,
					"content": "Was machst du denn noch hier? Bring das Buch zur <color=#00E1FFFF>Händlergilde Feiyun</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang IX."
				}
			]
		},
