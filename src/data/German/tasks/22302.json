			},
			"dialogs": [
				{
					"id": 223020201,
					"content": "Das dort sollte die <color=#00E1FFFF>Händlergilde Feiyun</color> sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020202,
					"content": "Es reicht doch sicher, dem <color=#00E1FFFF>Herrn am Eingang</color> das Buch zu geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020203,
					"content": "Aber ... Paimon würde es schon interessieren, was denn Tolles in diesem Roman steht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020204,
					"content": "Was denkst du? Sollten wir einen kleinen Blick reinwerfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
