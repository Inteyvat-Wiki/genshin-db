				"objectNames": [
					"Chang IX."
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223020101,
					"content": "Diesmal klappt es sicher!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020102
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 223020102,
					"content": "Was wird klappen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020103
					]
				},
				{
					"id": 223020103,
					"content": "Hast du davon gehört, dass man in Inazuma des Öfteren einen Schreibwettbewerb abhält?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020104
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 223020104,
					"content": "Er heißt, glaub ich, „Das ist ein Wahnsinnsroman!“ und wird vom Verlagshaus Yae veranstaltet. Das ist ein bekannter Herausgeber in Inazuma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020105
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 223020105,
					"content": "Auf diesen Wettbewerb habe ich mich nun schon so lange vorbereitet und auch viele Romane gelesen, die die Leute aus Inazuma mögen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020106
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 223020106,
					"content": "Ich habe all die Bücher, die ich gesammelt habe, gelesen und alles aus Liyue und Inazuma in meinen Roman gesteckt. Damit muss ich einfach den ersten Platz machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020107
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 223020107,
					"content": "Ich habe schon mit der Händlergilde Feiyun gesprochen. Dort wird man mir helfen, meinen Roman zum Wettbewerb zu bringen. Derjenige, der das Buch abholen sollte, lässt sich aber einfach nicht blicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020108
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 223020108,
					"content": "Könntest du der <color=#00E1FFFF>Händlergilde Feiyun</color> bitte mein Manuskript bringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020109,
						223020111
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 223020109,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020110
					]
				},
				{
					"id": 223020110,
					"content": "Dankeschön! Dieses Mal klappt es bestimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 223020111,
					"content": "Worum geht es denn in dem Roman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020112
					]
				},
				{
					"id": 223020112,
					"content": "Das kann ich noch nicht sagen. Das muss bis zum Wettbewerb warten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020113
					],
					"speakerTitle": "Chang IX."
				},
				{
					"id": 223020113,
					"content": "Wenn es dieses Mal klappt, wird alles gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chang IX."
				}
			]
		},
