					"Xu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223020301,
					"content": "Wohin ist er gegangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020302
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020302,
					"content": "Ich habe hier ein Buch von Chang IX.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020303
					]
				},
				{
					"id": 223020303,
					"content": "Was? Er schreibt immer noch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020304
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020304,
					"content": "Ach, stimmt ja. Letztes Mal hatte er erwähnt, dass er wieder einen Roman schreiben wollte, um an dem Wettbewerb in Inazuma teilzunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020305
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020305,
					"content": "Worum geht es denn diesmal? Das letzte Mal waren es die Qixing. Er wollte unbedingt, dass wir ihm beim Verlegen helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020306
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020306,
					"content": "Es ist aber nie dazu gekommen. Fast hätte es Ärger mit den Millelithen gegeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020307
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020307,
					"content": "Dieses Mal will er sogar zum Wettbewerb nach Inazuma. Damit sollten wir eigentlich aus dem Schneider sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020308
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020308,
					"content": "Gib mir das Buch. Ich werde es jemandem von der Händlergilde geben, der es auf einem Schiff mit nach Inazuma nehmen wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020309
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020309,
					"content": "Chang IX. wird dieses Mal aber auch kein Glück haben. Ich habe nämlich gehört, dass in Inazuma ein Buch mit dem Namen „Vom Schwert gefunden im Herbst“ gerade total beliebt sein soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020310
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020310,
					"content": "Das ist auch von einem aus Liyue. Ich weiß nur nicht, von wem genau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020311
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020311,
					"content": "Danke, dass du das Buch geholt hast. Chang IX. hatte eigentlich jemanden beauftragt und dafür bezahlt. Das Geld gebe ich dir für deine Mühen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu"
				}
			]
		},
