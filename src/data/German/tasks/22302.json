			"dialogs": [
				{
					"id": 223020501,
					"content": "Aber wirklich nur ganz kurz ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020502
					]
				},
				{
					"id": 223020502,
					"content": "Versprochen! Nur ganz kurz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020503,
					"content": "Also dieser Junge ... Ob das Chang IX. selbst sein soll?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020504,
					"content": "Seine Einstellung ist schon die eines jungen Erwachsenen, obwohl er aussieht wie ein alter Miesepeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020505,
					"content": "Wir sollten das Buch lieber schnell der <color=#00E1FFFF>Händlergilde Feiyun</color> geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
