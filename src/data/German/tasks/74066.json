				]
			},
			"dialogs": [
				{
					"id": 740660301,
					"content": "Die Rezeption ... Das ist genau hier! Versuchen wir unser Glück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660302,
					"content": "Fräulein Monglane, hallo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660304
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660304,
					"content": "(Oha, es scheint, als wäre es schwierig, mit ihr zu verhandeln.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660305,
					"content": "(Versuchen wir es doch mit der „Kunst der Verhandlung“.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660306
					]
				},
				{
					"id": 740660306,
					"content": "(Stimmt, das haben wir noch! Paimon hätte nicht gedacht, dass dieses Buch nützlich sein könnte.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660307,
					"content": "Paimon schaut mal ... gefunden! „Wenn man bereits im Voraus auf dem Gebiet der Aura die Oberhand über sein Gegenüber errungen hat ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660308,
					"content": "Genau das ist es! Die Oberhand über sein Gegenüber errungen! Paimon hat verstanden! Man muss also mit etwas größerer Lautstärke sprechen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660309,
					"content": "He! Fräulein Monglane! Hallo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660310,
					"content": "... Ich habe dich gehört. Brauchst du Hilfe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660311
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660311,
					"content": "Hä? Es funktioniert also wirklich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660312,
					"content": "#Hehe, Fräulein Monglane, wir sind hier, um an der Kundenzufriedenheitsstudie teilzunehmen! Oh, genauer gesagt, Paimon begleitet {M#ihn}{F#sie} nur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660313,
					"content": "#(Keine Sorge, {NICKNAME}, wir haben ja dieses Buch. Paimon wird heimlich im Buch nachschauen und dir zuflüstern! Du wirst alles erklärt bekommen, hör einfach zu.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660314,
					"content": "Wieder jemand, der die Mitteilung im Buch gelesen hat und hierherkommt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660315
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660315,
					"content": "Ja! Genau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660316,
					"content": "Wie viele wurden denn dort hineingesteckt ... eigentlich ... Ach, auch nicht wichtig, egal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660317
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660317,
					"content": "Ähem ... Bitte warte kurz ... Ich erkläre erst einmal die Regeln. Dieses Mal hat die Umfrage fünf Fragen. Bitte beantworte sie rasch und aus dem Bauch heraus. Denk daran, schnell antworten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660318
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660318,
					"content": "Verstanden? Wir fangen an, wenn du bereit bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monglane"
				}
			]
		},
