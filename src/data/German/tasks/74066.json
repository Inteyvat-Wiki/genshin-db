					}
				]
			},
			"dialogs": [
				{
					"id": 740660901,
					"content": "(Paimon ist schon startklar! Fangen wir an!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660902,
					"content": "Erste Frage: Findest du es angemessen, die Preise in der Tauschscheinkantine auf dem jetzigen günstigen Niveau zu halten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660903
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660903,
					"content": "(Hm ... Wie sollen wir das nur beantworten? Paimon sucht und sucht ... und gefunden! Versuchen wir diese Allzweckphrase!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660904,
					"content": "(Im Buch steht „Ich stimme deiner Sichtweise zu, aber ...“ kann man in jeder Situation benutzen. Sogar ein Abgrundmagier wird anständig mit dir verhandeln, und es schindet einen gewaltigen Eindruck.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660905,
						740660909,
						740660914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660905,
					"content": "Ja, ich finde es angemessen und das gefällt Paimon auch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660906
					]
				},
				{
					"id": 740660906,
					"content": "Hm ...? Wenn etwas nicht gut schmeckt, würde Paimon es nicht essen, auch wenn es umsonst ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660907,
					"content": "Aber wenn wir uns keine Nahrung mehr leisten können ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660908
					]
				},
				{
					"id": 740660908,
					"content": "Hm ... wenn du so etwas sagst ... Nein, unmöglich! Paimon würde lieber hungern, als so etwas zu essen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660918,
					"content": "*räusper* Darf ich einmal unterbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660919
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660919,
					"content": "Äh?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660920,
					"content": "Der Regel zufolge sollen die Antworten dieser Umfrage schnell gegeben werden, also lass uns mit der nächsten Frage weitermachen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660921
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660921,
					"content": "Gut, na gut ... Wenn es diese Regel gibt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660922,
					"content": "Zweite Frage: Werden in der Tauschscheinkantine während den Essenszeiten ausreichend Lebensmittel angeboten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660923
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660923,
					"content": "Wenn man etwas kaufen will, bekommt man es ... Aber es schmeckt einfach nicht besonders!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660924,
						740660929,
						740660932
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660924,
					"content": "Ja, mehr Lebensmittel als die Minze in Teyvat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660925
					]
				},
				{
					"id": 740660925,
					"content": "Argh ... Aber Paimon will lieber Minze essen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660926,
					"content": "Wirklich? Dann gibt es heute Minze-Salat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660927
					]
				},
				{
					"id": 740660927,
					"content": "Bitte nicht! Paimon will weder Minze noch Minze-Salat! *wimmer* Paimon will Süß mariniertes Hühnchen essen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660928,
					"content": "Nun ... Zurück zu den Fragen? Ich schreibe hier „Ja“ hinein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660935,
					"content": "*seufz* ... Wie anstrengend. Fahren wir fort mit den Fragen, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660936
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660936,
					"content": "Für die dritte Frage, möchte ich nochmals daran erinnern, dass die Antworten dieser Umfrage schnell gegeben werden sollen, also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660937
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660937,
					"content": "Also, die dritte Frage: Ist das derzeitige System zufälliger Auswahl an Speisen interessant genug und abwechslungsreich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660938
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660938,
					"content": "Es soll mehr Aufmerksamkeit auf den Geschmack gelegt werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660939
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660939,
					"content": "Ich stimme deiner Sichtweise zu, aber ... würde eine zufällige Auswahl an Speisen nicht die Überraschung bedeuten, dass man überhaupt nicht weiß, was man als Nächstes zu essen bekommt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660940
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660940,
					"content": "Stimmt auch ... Das hört sich eigentlich ganz interessant an!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660941
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660941,
					"content": "Paimon ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660942
					]
				},
				{
					"id": 740660942,
					"content": "Was ist denn? Fräulein Monglane hat ganz recht, und es scheint schwer, ihr zu widersprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660943
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660943,
					"content": "*räusper* Bitte schnell antworten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660944,
						740660949,
						740660951
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660944,
					"content": "Interessant, auch die Orakelzettel sind sehr interessant.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660945
					]
				},
				{
					"id": 740660945,
					"content": "Genau! Jedes Mal gibt es da einen Orakelzettel, als würde man ein Los ziehen, wirklich nicht schlecht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660946
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660946,
					"content": "„Erfolg kommt nur durch harte Arbeit!“ Das klingt großartig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660947
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660947,
					"content": "Die Arbeit einer Reiseführerin ist wirklich anstrengend.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660948
					]
				},
				{
					"id": 740660948,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660957,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660958
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660958,
					"content": "Vierte Frage: Hältst du es für vernünftig, wenn die Tauschscheinkantine Genussmittel zum Verkauf anbietet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660959
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660959,
					"content": "(Hä? Was? Warum redet sie auf einmal so schnell?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660960
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660960,
					"content": "(„Die Oberhand gewinnen“? „Gesprächsthemen lenken“? Nein, nein, das passt alles nicht. Vielleicht einfach ... weiter mit der Allzweckphrase!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660961,
						740660962
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660961,
					"content": "(Diese Fragen ... haben etwas Seltsames an sich ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660963,
					"content": "*räusper* Bitte nicht zu viel überlegen. Und außerdem nicht schwätzen. Wie ich bereits sagte, folge deiner Intuition und antworte zügig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660964,
						740660965,
						740660966
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660964,
					"content": "Das ist nur vernünftig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660967,
					"content": "Gut, danke für deine Antwort. Und nun die letzte Frage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660968
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660968,
					"content": "Wir werden ignoriert! Sind unsere Antworten überhaupt von Bedeutung?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660969
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660969,
					"content": "Basieren auf den Antworten zu den früheren Fragen: Bist du mit der jetzigen Tauschscheinkantine zufrieden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660970
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660970,
					"content": "Was waren nochmal die früheren Fragen? Paimon erinnert sich nicht mehr genau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660971
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660971,
					"content": "Schon gut, dann schreibe ich einfach, dass ihr zufrieden seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660972
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660972,
					"content": "Na gut ... Aber Paimon findet, irgendetwas stimmt nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660973
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660973,
					"content": "Apropos, wenn man „Nein“ antwortet, dann bekommt man auch keine Tauschscheine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660974
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660974,
					"content": "Wie? Das ist nicht fair!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660975
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660975,
					"content": "#Und was ist mit {M#diesem Herrn}{F#dieser Frau}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660976
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660976,
					"content": "Ignoriere Paimon nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660977,
						740660978,
						740660981
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660977,
					"content": "Ja, sehr zufrieden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660982,
					"content": "Sehr gut. Herzlichen Dank für eure Mitarbeit. Eure Unterstützung ist der Antrieb für unseren Fortschritt. Bitte unterschreibe hier und nimm die Tauschscheine entgegen. Der intelligente fliegende Mecha kann auch mit unterschreiben und Tauschscheine bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660983
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660983,
					"content": "Hä? Für Paimon gibt es auch Tauschscheine? Paimon hat doch noch gar nicht teilgenommen. Geht das wirklich? Warte mal, hier ist Paimon! Nicht irgendein intelligenter fliegender Mecha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660984
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660984,
					"content": "Gut. Laut unseren Grundsätzen berücksichtigen wir jederlei Rückmeldungen, also können alle Leute ... äh ... alle Menschen und Maschinen teilnehmen und Belohnungen kriegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660985
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660985,
					"content": "Wie gesagt, Paimon ist kein fliegender Mecha! Hier ist Paimon! Ignoriere Paimon nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660986
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660986,
					"content": "Verstehe ... Jedenfalls, um deine wertvolle Zeit zu sparen, kann ich den Fragebogen für dich ausfüllen. Keine Sorge, die Anzahl der Tauschscheine wird dieselbe sein, es macht keinen Unterschied.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660987
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660987,
					"content": "Ich gehe davon aus, dass all deine Antworten „zufrieden“ lauten, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660988
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660988,
					"content": "Ja! Tauschscheine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660989
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660989,
					"content": "Dann musst du nur noch hier unterschreiben. Den Rest erledige ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660990
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660990,
					"content": "Prima! Paimon kann die Tauschscheine bekommen und spart sich die Mühe. Danke für die Bemühungen, Fräulein Monglane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660991
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660991,
					"content": "Vielen Dank für deine Unterstützung. Bitte nimm deine Tauschscheine und wir sehen uns bei der nächsten Umfrage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660992
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660992,
					"content": "Nachdem ihr eure Tauschscheine entgegengenommen habt, verabschiedet ihr euch von Fräulein Monglane.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740660993
					]
				},
				{
					"id": 740660993,
					"content": "#{NICKNAME}, wenn Paimon jetzt zurückdenkt, scheint es Fräulein Monglane egal gewesen zu sein, was wir geantwortet haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660994
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660994,
					"content": "Es lag daran, wie die Fragen gestaltet waren, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660995
					]
				},
				{
					"id": 740660995,
					"content": "Hm, ja. Dieser Fragebogen war wirklich seltsam. Außerdem schien es ... als wäre Fräulein Monglane ziemlich müde gewesen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660996
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660996,
					"content": "„Die Kunst der Verhandlung“ ist gescheitert, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660997
					]
				},
				{
					"id": 740660997,
					"content": "Was soll das für eine „Kunst der Verhandlung“ sein? Solche Bücher sind völlig nutzlos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660998,
						740661000,
						740661002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660998,
					"content": "Richtig, das Problem lag am Buch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660999
					]
				},
				{
					"id": 740660999,
					"content": "Stimmt doch, oder? Du denkst auch, dass dieses Buch nichts bringt, oder? Aber da sie uns Tauschscheine verschenkt haben, ist es ja egal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740661000,
					"content": "Nein, das Problem lag bei Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661001
					]
				},
				{
					"id": 740661001,
					"content": "Hä? Aber Paimon hat es genau so gemacht, wie es in diesem Buch stand. Schau mal, „Daher muss ich laut sprechen ...“ Der Fehler liegt doch im Buch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740661002,
					"content": "Ich stimme deiner Sichtweise zu, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661003
					]
				},
				{
					"id": 740661003,
					"content": "He! Schluss damit! Von wegen „Kunst der Verhandlung“! Völlig nutzlos!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660978,
					"content": "Nein, gar nicht zufrieden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660979
					]
				},
				{
					"id": 740660979,
					"content": "Nein, nein, nein, lass uns einfach „zufrieden“ eintragen, nur für die Tauschscheine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660980
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660980,
					"content": "Zufrieden, ja? Alles klar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660982
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660981,
					"content": "Schon zufrieden, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660965,
					"content": "Das ist nicht vernünftig, es sollte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660966,
					"content": "Ich stimme deiner Sichtweise zu, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660962,
					"content": "(Ist das ... „Gesprächsthemen lenken“?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660949,
					"content": "Nicht besonders interessant. Weil man nicht das zu essen bekommt, was man möchte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660950
					]
				},
				{
					"id": 740660950,
					"content": "... Es schmeckt immer komisch. Wo bleibt denn da die Überraschung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660951,
					"content": "Ich stimme deiner Sichtweise zu, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660952
					]
				},
				{
					"id": 740660952,
					"content": "Es wäre doch schön, wenn man für jede achtzehnte Mahlzeit eine mit leckerem Essen geschenkt bekommen würde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660953
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660953,
					"content": "Warum achtzehn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660954
					]
				},
				{
					"id": 740660954,
					"content": "Das hat Paimon von jemand anderem gehört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660955
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660955,
					"content": "So ist es wohl ... hmm ... Weil es an einem Tag drei Mahlzeiten gibt. Bis zum Sonntag vergehen also genau sechs Tage und das sind genau achtzehn Mahlzeiten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660956
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660956,
					"content": "Und am siebten Tag kann man dann endlich etwas Leckeres essen! So bleibt man jede Woche gut gelaunt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660929,
					"content": "Nicht ausreichend, sogar Herr Wolsey bekommt nicht genug zu essen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660930
					]
				},
				{
					"id": 740660930,
					"content": "Er will doch von sich aus nicht essen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660931,
					"content": "Verstehe, also nicht ausreichend, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660932,
					"content": "Ich stimme deiner Sichtweise zu, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660933
					]
				},
				{
					"id": 740660933,
					"content": "Wir wollen es überhaupt nicht essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660934,
					"content": "*seufz* ... Ich weiß schon, ihr habt dieses Buch gelesen ... Jedenfalls, schreibe ich einfach „Ja“ hier hinein, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660909,
					"content": "Nicht angemessen. Ich verlange eine Preissteigerung!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660910
					]
				},
				{
					"id": 740660910,
					"content": "Hä?! Wieso das denn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660911,
					"content": "Ich möchte nicht das Beste, sondern das Teuerste!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660912
					]
				},
				{
					"id": 740660912,
					"content": "Was ist das denn für eine seltsame Denkweise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660913,
					"content": "Ist ... bei dir alles in Ordnung? Du scheinst etwas danebenzuliegen. Du hast doch nicht etwa eine Lebensmittelvergiftung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660914,
					"content": "Ich stimme deiner Sichtweise zu, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660915
					]
				},
				{
					"id": 740660915,
					"content": "Aber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660916
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660916,
					"content": "#Aber es gibt noch Spielraum zur Verbesserung! Wenn es dafür etwas besser schmeckt, nicht wahr, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660917,
					"content": "Oder ... Falls es süß mariniertes Hühnchen zu kaufen gibt, wäre das gut. Richtig! In diesem Fall würde Paimon jeden Tag essen, was hier verkauft wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}