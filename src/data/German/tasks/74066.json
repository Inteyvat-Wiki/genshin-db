			"dialogs": [
				{
					"id": 740660201,
					"content": "„Die Kunst der Verhandlung“ ...? Hmpf, der Buchtitel klingt schon sehr langweilig! Das interessiert Paimon überhaupt nicht ... Hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660202,
					"content": "Aah? Hier wurde noch eine Mitteilung hineingesteckt. Oh ... „Geh zur Rezeption und nimm an der Kundenzufriedenheitsstudie der Tauschscheinkantine teil. Es gibt auch die Möglichkeit, Tauschscheine zu erhalten ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660203,
					"content": "„Tauschscheine“ ... Woah! Hast du das gesehen? Man kann dort Tauschscheine kriegen! Wer hätte gedacht, dass es noch unerwartete Belohnungen gibt. Lass uns schnell hingehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7406603,
			"completionStepIds": [],
