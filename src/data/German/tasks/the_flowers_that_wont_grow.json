			},
			"dialogs": [
				{
					"id": 230230201,
					"content": "Wir brauchen sehr viel von dem Spezialdünger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230202
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230202,
					"content": "Wir haben noch Vorräte für die anderen Rohstoffe für diesen Spezialdünger, aber die „Harra-Früchte“ sind schon aufgebraucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230203
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230203,
					"content": "#{F#Reisende}{M#Reisender}, könntest du mir bitte ein paar „Harra-Früchte“ holen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
		{
			"id": 2302303,
			"completionStepIds": [
				2302303
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2302303",
							"2"
						],
						"stepId": 2302303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vardan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230301,
					"content": "#Diese hier sollten genug sein, ganz herzlichen Dank, {M#Reisender}{F#Reisende}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230302
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230302,
					"content": "Mit diesem Spezialdünger sollte der Boden fruchtbar genug sein. Die Rose wird sicher gut wachsen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230303
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230303,
					"content": "Ich hoffe, es wird nicht so wie bei denen zuvor, die überhaupt nicht funktionierten, wenn sie verstreut wurden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230304
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230304,
					"content": "Habt ihr früher schon mal Dünger verwendet?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230305
					]
				},
				{
					"id": 230230305,
					"content": "Wir haben einige normale benutzt. Sie haben nicht gut funktioniert. Eigentlich haben sie gar nicht funktioniert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230306
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230306,
					"content": "Aber diese Dünger haben auf anderen Feldern hervorragend funktioniert, ich verstehe auch nicht, was hier eigentlich los ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230307
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230307,
					"content": "#Genug davon fürs Erste. Hier sind ein paar Dankeschön-Geschenke, bitte nimm sie an, {M#Reisender}{F#Reisende}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
		{
			"id": 2302304,
			"completionStepIds": [
				2302304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2302304",
							"2"
						],
						"stepId": 2302304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vardan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230401,
					"content": "Neben der Fruchtbarkeit des Bodens ist vielleicht auch das „Wasser“ ein Problem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230402
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230402,
					"content": "Vielleicht haben wir die Rose zu tief eingegraben, sodass sie nicht genug Wasser bekommen kann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230403
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230403,
					"content": "#{M#Reisender}{F#Reisende}, bitte hilf uns, die Rose zu gießen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
		{
			"id": 2302306,
			"completionStepIds": [
				2302306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2302306",
							"2"
						],
						"stepId": 2302306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vardan",
					"Gurgen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230601,
					"content": "Puh ... Das dürfte reichen, der Boden sollte jetzt genug Feuchtigkeit haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230602
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230602,
					"content": "#Danke dir, {M#Reisender}{F#Reisende}. Ohne deine Hilfe wären wir erledigt gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230603
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230603,
					"content": "Echt merkwürdig ... Dass der Boden dieses Mal so stark gegossen werden musste, um überhaupt durchnässt zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230604
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230604,
					"content": "Ich glaube, die Menge an Wasser, die wir diesmal gegossen haben, ist mindestens das Zweifache der üblichen Menge.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230605
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230605,
					"content": "Du täuschst dich, bestimmt weil du zu müde bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230606
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230606,
					"content": "Wenn du doppelt so viel gegossen hättest, würde der ganze Boden unter Wasser stehen. Jetzt ist die Feuchtigkeit des Bodens aber ganz normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230607
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230607,
					"content": "Sollte man meinen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230608
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230608,
					"content": "Ich hoffe, die Rosen werden gut wachsen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230609
					]
				},
				{
					"id": 230230609,
					"content": "Sei unbesorgt. Wir werden uns um die Rose kümmern, zum Wohle der Patienten und Ärzte vom „Bimarstan“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230610
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230610,
					"content": "#Hier sind ein paar Dankeschön-Geschenke, bitte nimm sie an, {M#Reisender}{F#Reisende}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230611
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230611,
					"content": "Ach, aber ich glaube, dieses Mal habe ich wirklich zu viel Wasser gegossen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
		{
			"id": 2302307,
			"completionStepIds": [],
