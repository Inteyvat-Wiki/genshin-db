			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gurgen",
					"Vardan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230101,
					"content": "So kann das nicht weitergehen, Papa, die Rose wächst ja überhaupt nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230102
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230102,
					"content": "Wir müssen etwas tun, sonst schaffen wir es dieses Jahr nicht, alle Heilkräuter rechtzeitig zu liefern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230103
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230103,
					"content": "Mit dem Boden ist alles in Ordnung, das Unkraut und die Schädlinge sind auch beseitigt, was kann das nur sein ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230104
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230104,
					"content": "Worüber macht ihr euch denn solche Sorgen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230105
					]
				},
				{
					"id": 230230105,
					"content": "Oh? Du bist hier, um Heilkräuter zu kaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230106
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230106,
					"content": "Die Sache ist die, dass wir die Ärzte im „Bimarstan“ regelmäßig mit Heilkräutern beliefern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230107
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230107,
					"content": "Das Wichtigste von ihnen ist diese außergewöhnliche „Sumeru-Rose“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230108
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230108,
					"content": "Also kann man Rosen auch als Medizin verwenden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230109
					]
				},
				{
					"id": 230230109,
					"content": "Das sollte man die Ärzte im „Bimarstan“ fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230110
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230110,
					"content": "Jedenfalls meinen sie, dass diese Art von Rosen in Kombination mit anderen Medikamenten den Hitzschlag heilen kann, dass sie außerdem Magenprobleme lindern kann, und so weiter ... Ich erinnere mich nicht mehr an alle Details ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230111,
						230230113
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230111,
					"content": "Wenn das so ist, kann ich helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230112
					]
				},
				{
					"id": 230230112,
					"content": "Ich bin dir sehr dankbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230113,
					"content": "Was stimmt nicht mit dieser Rose?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230114
					]
				},
				{
					"id": 230230114,
					"content": "Ich weiß nicht, warum die Rose so langsam wächst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230115
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230115,
					"content": "Unserer Erfahrung nach stimmt in einem solchen Fall entweder etwas mit dem Boden nicht oder es gibt einen Schädlingsbefall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230116
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230116,
					"content": "Wir haben in dieser Erde vorher auch Heilkräuter angepflanzt und die sind recht gut gewachsen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230117
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230117,
					"content": "Wir vernichten täglich die Insekten. Von einem Schädlingsbefall kann gar keine Rede sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230118
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230118,
					"content": "Ach, wir können uns jetzt nicht mit solchen Problemen befassen. Wenn wir noch mehr Zeit verstreichen lassen, kann diese Rose nicht rechtzeitig ins „Bimarstan“ geliefert werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230119
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230119,
					"content": "Deshalb haben wir vor, den Boden auf jeden Fall zuerst mit einem Spezialdünger zu düngen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230120
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230120,
					"content": "Aber wir beide müssen uns auch noch um andere Heilkräuterfelder kümmern, also haben wir gar keine Zeit, die Materialien zu sammeln, die zur Herstellung des Düngers benötigt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230121
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230121,
					"content": "#{M#Reisender}{F#Reisende}, auch wenn es im Namen der Kranken im „Bimarstan“ ist ... können wir dich in dieser Sache um Hilfe bitten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230122
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230122,
					"content": "Ich werde helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230123
					]
				},
				{
					"id": 230230123,
					"content": "Ich bin dir sehr dankbar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230124
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230124,
					"content": "Lass mich einmal sehen, wie es jetzt aussieht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
		{
