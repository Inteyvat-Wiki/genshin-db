			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vardan",
					"Gurgen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230701,
					"content": "#{M#Reisender}{F#Reisende}, bitte hilf uns und gieße mit uns zusammen die Rosen in der Nähe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230702
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230702,
					"content": "Solange die Rose nur genug Wasser bekommt, wird sie ganz bestimmt wieder anfangen zu wachsen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gurgen"
				}
			]
		}
	]
