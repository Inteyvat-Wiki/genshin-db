			"dialogs": [
				{
					"id": 751350201,
					"content": "Boah! Bona! Du fliegst zu schnell! Wir können nicht mithalten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350202,
					"content": "Hehe, Entschuldigung ... Ich konnte einfach nicht anders, als ich den Altar des Urfeuers direkt vor uns sah ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350203
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350203,
					"content": "Wir müssen also nur diesen Altar benutzen, und schon können wir zur Tonatiuh gelangen, richtig? Aber wie? Würde uns ein riesiger Windstoß in den Himmel blasen? Aber wie lange müssen wir dann wieder fliegen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350204,
					"content": "Ach, allein der Gedanke daran macht Paimon Sorgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350205,
						751350207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350205,
					"content": "Hab keine Angst, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350206
					]
				},
				{
					"id": 751350206,
					"content": "Na gut, wenn du meinst. Aber bleib bitte in der Nähe von Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350209,
					"content": "Wie auch immer, wir müssen also die Pyrophosphorite auf dem Altar opfern, richtig? Aber wir haben zwei davon ... dann legen wir sie beide auf den Altar, um sicherzugehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350207,
					"content": "Wie aufregend!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350208
					]
				},
				{
					"id": 751350208,
					"content": "Oder? Paimon ist auch schon ganz aufgeregt. Kein echter Abenteurer würde sich so eine Herausforderung entgehen lassen wollen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "Bona"
				}
			]
		}
	]
