			"dialogs": [
				{
					"id": 751350101,
					"content": "Ist das der Altar des Urfeuers? Scheint aber schwer zu erreichen zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350102,
					"content": "#Und was nun? Wir können hinfliegen, aber was sollen Bona und {REALNAME[ID(2)|SHOWHOST(true)]} tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350103,
					"content": "Paimon, stellst du meine Fähigkeiten als Abenteurerin des Blumenfeder-Klans infrage? Ich habe viel Erfahrung im Fliegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350104
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350104,
					"content": "#Ich kann sogar {REALNAME[ID(2)|SHOWHOST(true)]} beim Fliegen mitnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350105
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350105,
					"content": "Ich habe auch einen Flugschein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350106
					]
				},
				{
					"id": 751350106,
					"content": "Dann ist das Problem gelöst. Ich werde vorausfliegen, ihr müsst nur mir folgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350107
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350107,
					"content": "Also ein Wettfliegen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350108
					]
				},
				{
					"id": 751350108,
					"content": "Nein, das ist kein Wettbewerb! Also, ich werde vorausfliegen, ihr müsst nur mir folgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350109
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350109,
					"content": "#Es sieht hier gefährlich aus ... und wir wissen nicht, was passieren könnte, also {REALNAME[ID(2)|SHOWHOST(true)]}, halte dich gut fest!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350110,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
