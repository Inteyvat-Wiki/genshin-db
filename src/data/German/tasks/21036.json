					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360501,
					"content": "*keuch* Wie kannst du so schnell rennen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360502,
						210360504
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360502,
					"content": "Du bist es, der zu langsam ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360503
					]
				},
				{
					"id": 210360503,
					"content": "Ich gebe auf ... Ich gebe auf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360506,
					"content": "Vielen Dank, dass du mir gezeigt hast, wie es geht. Hier ist deine Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360507,
						210360510
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360507,
					"content": "Über Que’er ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360508
					]
				},
				{
					"id": 210360508,
					"content": "Also, Que’er ... Sie will immer noch nichts von mir wissen. Wie kann ich sie bloß überzeugen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360509
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360509,
					"content": "Ach ... Warum ist die Situation so schwierig geworden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360510,
					"content": "Über diese Abenteurerin ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360511
					]
				},
				{
					"id": 210360511,
					"content": "Die? Äh ... Ich bin ihr bei der Abenteurergilde begegnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360512
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360512,
					"content": "Sie sagte, sie habe eine Mission der Gilde angenommen und sei auf dem Weg zur Großen Kluft. Als sie hörte, dass ich auch hierher kommen wollte, bot sie mir an, mich mitzunehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360513
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360513,
					"content": "Aber im Gegenzug musste ich ihr helfen, die Mission auszuführen. Der größte Teil davon war es aber, Gegenstände zu suchen, also nicht zu schwer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360514
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360514,
					"content": "Aber sie ... Sie liebt es zu reden, damit kann ich einfach nicht gut umgehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360504,
					"content": "Du musst noch viel üben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360505
					]
				},
				{
					"id": 210360505,
					"content": "Du ... Du hast recht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
