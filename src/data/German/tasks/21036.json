			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360201,
					"content": "„Gegner bekämpfen“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360202
					]
				},
				{
					"id": 210360202,
					"content": "Sehr gut! Ich wollte schon lange meine Schwertübungen in der Praxis testen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360203,
					"content": "Ich fürchte nur, dass du meine Bewegungen nicht klar sehen kannst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360204
					]
				},
				{
					"id": 210360204,
					"content": "Oh ... Bist du so gut im Kämpfen? Hahaha, dann kann ich dich nur untertänigst bitten, deine Bewegungen etwas langsamer auszuführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360205,
					"content": "Lass mich überlegen ... Hier in der Nähe gibt es einen Ort, an dem sich Monster sammeln, lass uns erstmal dahin gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2103603,
			"completionStepIds": [
				2103601,
				2103606
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
