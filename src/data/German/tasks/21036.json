				{
					"id": 210360602,
					"content": "Trainierst du immer noch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360603
					]
				},
				{
					"id": 210360603,
					"content": "Ja, aber ... Es fällt mir etwas schwer. Ich weiß nicht, ob ich wirklich so schwach bin oder ob ich einfach die falschen Methoden verwende ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360608
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360608,
					"content": "Reden wir erstmal über etwas anderes. Als wir das letzte Mal zusammen trainierten, haben mich deine Bewegungen sehr inspiriert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360609
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360609,
					"content": "#{F#Reisende}{M#Reisender}, bitte hilf mir wieder mit meinem Training.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360610,
						210360611
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360610,
					"content": "Hast du hier früher schon trainiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360613
					]
				},
				{
					"id": 210360613,
					"content": "Ich bin auch noch zufällig auf eine wohlwollende Abenteurerin getroffen, die bereit war, mir zu helfen und mich unter dem Vorwand der Zusammenarbeit bei Missionen der Gilde hierher gebracht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360614
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360614,
					"content": "Sie hat mir auch geholfen, einen Trainingsplan zu entwickeln und mir viele Empfehlungen gegeben ... Aber gleichzeitig musste ich mich auch mit ihr zusammen um Missionen der Abenteurergilde kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360615
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360615,
					"content": "#*hust* ... Lass uns zur Sache kommen, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360616
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360616,
					"content": "Es ist so: Ich habe einen Trainingsplan für mich entworfen, der die Themen „Gegner bekämpfen“ und „Wildnis durchqueren“ beinhaltet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360617
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360617,
					"content": "#{F#Reisende}{M#Reisender}, welches der beiden Themen möchtest du mit mir üben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360611,
					"content": "Hier trainierst du also ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360612
					]
				},
				{
					"id": 210360612,
					"content": "*seufz* Es ist mir ein bisschen peinlich, das zu sagen ... Ich habe gehört, dass das Gelände hier ziemlich kompliziert ist und sich hier viele Monster herumtreiben, also dachte ich, es sei sehr gut fürs Training. Ich hätte mir aber nicht vorstellen können, dass es so schwer sein könnte hierherzukommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360613
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360604,
					"content": "Geht dir Que’er immer noch aus dem Weg?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360605
					]
				},
				{
					"id": 210360605,
					"content": "Ähem! Ähm ... Que’er ... Sie sagt in letzter Zeit immer, sie hätte etwas in der Stadt zu tun und kommt nie zurück ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360606
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360606,
					"content": "Ich habe sie mehrere Male besucht, aber sie lässt nur Zhiruo rauskommen, um mich davon zuschicken und weigert sich, mich zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360607
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360607,
					"content": "*seufz* ... Ich weiß auch nicht, was ich zu ihr sagen soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360615
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
