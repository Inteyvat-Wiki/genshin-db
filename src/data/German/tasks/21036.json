				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360301,
					"content": "„Wildnis durchqueren“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360302
					]
				},
				{
					"id": 210360302,
					"content": "Sehr gut, diese Abenteurerin hat mir schon geholfen, eine Route zu planen ... Ach, dass ich hier trainieren kann, ist auch ihr zu verdanken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360303
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360303,
					"content": "Sie sagte, ich müsse einfach möglichst schnell ans Ziel kommen ... Aber ich brauche jedes Mal länger als geplant ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360304
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360304,
					"content": "Deshalb möchte ich dich bitten, mir zu zeigen, wie man sich in der Wildnis so schnell wie möglich bewegen kann. Ich werde mein Bestes tun, um dir zu folgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360305,
						210360306
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360305,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360308
					]
				},
				{
					"id": 210360308,
					"content": "Also, lass uns zunächst zum Ausgangspunkt gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360306,
					"content": "Lass dich nicht abschütteln.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360307
					]
				},
				{
					"id": 210360307,
					"content": "Also ... Ich werde mein Bestes geben. Aber ehrlich gesagt bin ich kein guter Läufer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360308
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
			"id": 2103604,
			"completionStepIds": [
				2103604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
