				{
					"id": 210360801,
					"content": "*keuch* Wie kannst du so schnell rennen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360802,
						210360804
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360802,
					"content": "Du bist es, der zu langsam ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360803
					]
				},
				{
					"id": 210360803,
					"content": "Ich gebe auf ... Ich gebe auf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360806
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360806,
					"content": "Puh ... Endlich habe ich meinen Atem zurück. Kaum zu glauben, dass es so anstrengend ist, sich in der Wildnis zu bewegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360807
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360807,
					"content": "Vielen Dank, dass du mir gezeigt hast, wie es geht. Hier ist deine Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360804,
					"content": "Du musst noch viel üben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360805
					]
				},
				{
					"id": 210360805,
					"content": "Du ... Du hast recht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360806
