			"dialogs": [
				{
					"id": 210360701,
					"content": "Puh ... Das war hart ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360702
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360702,
					"content": "Es tut mir leid, dich enttäuscht zu haben. Ich hätte nicht erwartet, so nervös zu sein, wenn ich auf richtige Gegner treffe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360703
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360703,
					"content": "Ich muss jedenfalls noch viel üben ... Vielen Dank, hier ist deine Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360704
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360704,
					"content": "Möchtest du Liyue wirklich verlassen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360705
					]
				},
				{
					"id": 210360705,
					"content": "Ich habe mich noch nicht ganz entschieden, ich muss noch ein wenig nachdenken und noch einmal versuchen, Que’er zu überzeugen, mit mir zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
