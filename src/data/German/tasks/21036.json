				{
					"id": 210360901,
					"content": "„Wildnis durchqueren“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360902
					]
				},
				{
					"id": 210360902,
					"content": "Sehr gut, dann lass uns die bisherige Route nehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360903
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360903,
					"content": "Diese Abenteurerin sagte, ich müsse einfach möglichst schnell ans Ziel kommen ... Aber ich brauche jedes Mal länger als geplant ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360904
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360904,
					"content": "Deshalb möchte ich dich bitten, mir zu zeigen, wie man sich in der Wildnis so schnell wie möglich bewegen kann. Ich werde mein Bestes tun, um dir zu folgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360905,
						210360906
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360905,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360908
					]
				},
				{
					"id": 210360908,
					"content": "Also, lass uns zunächst zum Ausgangspunkt gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360906,
					"content": "Lass dich nicht abschütteln.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360907
					]
				},
				{
					"id": 210360907,
					"content": "Also ... Ich werde mein Bestes geben. Aber ehrlich gesagt bin ich kein guter Läufer ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360908
					],
					"speakerTitle": "Sun Yu"
