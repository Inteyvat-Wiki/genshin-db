					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360101,
					"content": "#{F#Reisende}{M#Reisender}, wir treffen uns wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360102,
						210360104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360102,
					"content": "Trainierst du immer noch?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360103
					]
				},
				{
					"id": 210360103,
					"content": "Ja, aber ... Es fällt mir etwas schwer. Ich weiß nicht, ob ich wirklich so schwach bin oder ob ich einfach die falschen Methoden verwende ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360108,
					"content": "Reden wir erstmal über etwas anderes. Als wir das letzte Mal zusammen trainierten, haben mich deine Bewegungen sehr inspiriert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360109,
					"content": "#{F#Reisende}{M#Reisender}, bitte hilf mir wieder mit meinem Training.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360110,
					"content": "So wie beim letzten Mal, die zwei Themen „Gegner bekämpfen“ oder „Wildnis durchqueren“. Welches der zwei Themen würdest du gern mit mir trainieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360104,
					"content": "Geht dir Que’er immer noch aus dem Weg?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360105
					]
				},
				{
					"id": 210360105,
					"content": "Ähem! Ähm ... Que’er ... Sie sagt in letzter Zeit immer, sie hätte etwas in der Stadt zu tun und kommt nie zurück ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360106
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360106,
					"content": "Ich habe sie mehrere Male besucht, aber sie lässt nur Zhiruo rauskommen, um mich davon zuschicken und weigert sich, mich zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360107,
					"content": "*seufz* ... Ich weiß auch nicht, was ich zu ihr sagen soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
