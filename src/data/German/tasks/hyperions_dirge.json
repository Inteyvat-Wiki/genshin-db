			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410601,
					"content": "Ich bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410602
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410602,
					"content": "Ich bin der Erbauer des Helios, Aberaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410603
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410603,
					"content": "Paimon ... ist Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410604,
						722410609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410604,
					"content": "Stellst du dich hier vor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410605
					]
				},
				{
					"id": 722410605,
					"content": "Wenn die andere Person ihren Namen nennt, solltest du auch deinen Namen nennen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410606,
					"content": "Es soll derartige Rituale geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410607,
					"content": "Das macht nichts. Du hast einen langen Weg hinter dir und es wäre unhöflich von mir, dich in diesem traurigen Zustand nicht empfangen zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410608
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410608,
					"content": "#Das macht nichts, {NICKNAME} und Paimon macht es nichts aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410613,
					"content": "Aber warum bist du hier geblieben, Herr Geist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410614,
					"content": "Ich bin ... Ich bin der Erbauer von Helios und das ist ... wo ich untergegangen bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410615
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410615,
					"content": "An einem dunklen und kalten Ort werde ich nicht aus meinem Schlaf erwachen ... Wie kann ich so sterben? Ich bin doch der Erbauer von Helios!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410616
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410616,
					"content": "Der Erbauer von Helios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410617,
					"content": "Was ist Helios?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410618,
					"content": "Ah ... ja, Helios war nur der Name, den ich privat benutzt habe, als es gebaut wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410619
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410619,
					"content": "Obwohl ich nicht weiß, ob du es weißt, aber der Name, den das Volk von Byakuyakoku kennt, ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410620
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410620,
					"content": "Dainichi Mikoshi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410621
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410621,
					"content": "Helios ist Dainichi Mikoshi, der Wagen der Sonne, der Hype{RUBY#[S]Byakuya no Hikari}rion antreibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410622,
						722410623
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410622,
					"content": "Der Erbauer des Dainichi Mikoshi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410624,
					"content": "So ist es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410625
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410625,
					"content": "#O Reisende{M#r} aus einem fremden Land ... Obwohl ich Dainichi Mikoshi erbaut habe, war ich doch abgeschieden und auf dem Dainichi Mikoshi gefangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410626
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410626,
					"content": "Als ich starb, wurde meine Seele über Byakuyakoku verstreut, und selbst diese Erinnerungen gingen verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410627
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410627,
					"content": "Ich erinnere mich an etwas sehr Wichtiges ... etwas sehr Wichtiges im Dainichi Mikoshi ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410628
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410628,
					"content": "#Aber ich habe es vergessen, o Reisende{M#r} aus einem fremden Land, und bitte dich, ... meine Kleider, meine Krone und meine Gebeine zurückzuholen, die an drei Orten geweiht worden sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410629
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410629,
					"content": "In der Schmalen Schlucht, vor dem Tempel der Ewigen Nacht und bei Schlangenherzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410630
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410630,
					"content": "Du wirst sie den drei Altären opfern ... damit meine Seele eins wird und der Weg zum Dainichi Mikoshi geöffnet wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410631
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410631,
					"content": "Der Zugang zu Dainichi Mikoshi liegt in der Abgeschiedenheit des Vorhangs der Ewigen Nacht verborgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410623,
					"content": "Bist du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410609,
					"content": "Ich bin ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410610
					]
				},
				{
					"id": 722410610,
					"content": "#... Es ist doch ein{F#e} Reisende{M#r} aus einem fremden Land.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410611
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410611,
					"content": "Du hast einen langen Weg hinter dir und es wäre unhöflich von mir, dich in diesem traurigen Zustand nicht empfangen zu können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410612
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410612,
					"content": "Macht doch nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224107,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224112",
							"2"
						],
						"stepId": 7224112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410701,
					"content": "Ah ... ich bitte dich, zur Achmalen Schlucht, vor dem Tempel der Ewigen Nacht und zu den Schlangenherzen zu gehen, damit meine Seele eins wird und sich der Weg zum Dainichi Mikoshi öffnet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				}
			]
		},
		{
			"id": 7224108,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410801,
					"content": "#Aah ... Reisende{M#r} aus einem fremden Land, du bist es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410802
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410802,
					"content": "Dank dir ist meine Seele jetzt vollständig und ich habe mich an alles erinnert, was wirklich unglaublich ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410803
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410803,
					"content": "Wie du vielleicht weißt, herrschte vor langer Zeit nur Dunkelheit in Byakuyakoku und die Menschen, die hier lebten, litten unter der Plage des Drachenerben der Tiefe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410804
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410804,
					"content": "Damals baute ich das Dainichi Mikoshi und von da an erhielt Byakuyakoku den Namen „Helle Nacht“ und den Wechsel von Tag und Nacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410805
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410805,
					"content": "Das Gleichnis: „Seit dem Bau des Dainichi Mikoshi kann auch, wenn dieser Ort nur eine normale Nacht ist, in Hell und Dunkel unterteilt werden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410806
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410806,
					"content": "Es ist eine Schande, dass die Seele, bevor sie an ihren Platz zurückkehrte, den Tag vergessen hatte, an dem Dainichi Mikoshi gebaut wurde und die Menschenmassen sich versammelten, um ihm zu folgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410807
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410807,
					"content": "Traurigerweise hätte ich mir diesen Anblick merken müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410808
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410808,
					"content": "Nur schade, dass ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410809
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410809,
					"content": "Schade?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410810,
					"content": "Als das Dainichi Mikoshi vollendet war, wurde der Drachenerbe, der das Licht nicht kannte, sofort vertrieben, und das Volk von Byakuyakoku konnte endlich in Frieden ruhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410811
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410811,
					"content": "Aber wenn man sich erst einmal niedergelassen hat ... ist es schwer, die Herzen der Menschen zu ermessen, und niemand weiß, welche hässlichen Gedanken andere haben könnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410812
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410812,
					"content": "#O Reisende{M#r} aus einem fremden Land, ein gieriger Schurke wird immer, wenn er die Gelegenheit hat, mehr zu nehmen, als ihm zusteht, nach Reichtum und Macht streben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410813
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410813,
					"content": "Diese Leute nutzten die Menschen aus und begannen, den Kult von Dainichi Mikoshi zu fördern. Es war bereits eine Torheit, das Herz des Volkes in falsche und tote Dinge zu stecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410814
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410814,
					"content": "Am Ende des Tages wählten sie sogar die „Sonnenk{RUBY#[S]Phaethonen}inder“ zur Herrschaft über das Land von Byakuyakoku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410815
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410815,
					"content": "Sonnenkinder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410816
					]
				},
				{
					"id": 722410816,
					"content": "Jede Legislatur wird ein Kind als Sonnenkind ausgewählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410817
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410817,
					"content": "Es liegt auf der Hand, dass diese Kinder noch zu unwissend sind, um als Könige eines Landes zu dienen und sich so zu verhalten, wie es sich gehört, sondern nichts weiter als Marionetten sind, die den Meinungen der bösen Leute hinter ihnen gehorchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410818
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410818,
					"content": "Ich habe versucht, mich dagegen zu wehren, aber ich wurde von den Sonnenkinder zu lebenslanger Haft wegen Hochverrats verurteilt, und sie haben mich angewiesen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410819
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410819,
					"content": "Ah, Sonnenkinder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410820,
					"content": "Würde das nicht bedeuten, dass er eines Tages merken würde, dass er manipuliert wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410821,
					"content": "Die Sonnenkinder können nicht aufwachsen. Wenn sie erst einmal erwachsen sind, lassen sie sich nicht mehr so leicht von den bösen Leuten manipulieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410822
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410822,
					"content": "„Das Sonnenkind, der königliche Segen zur Geburt der Sonne, soll auf dem himmlischen Pferd zum Fest der flammenden Sonne reiten ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410823,
						722410824
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410823,
					"content": "Soll das heißen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410825
					]
				},
				{
					"id": 722410825,
					"content": "Nun, sie wurden alle in das Dainichi Mikoshi geschickt, zum Geburtsritual, herausgeputzt und in Hochstimmung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410826
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410826,
					"content": "... Die hier versteckten Objekte sind mit ihnen verbunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410827
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410827,
					"content": "Dies ist das Zaumzeug, das beweist, dass das Sonnenkind recht hat, und ich habe es hier versteckt, weil ich dachte, ich würde es später verteilen, um die Welt zu warnen, aber jetzt ist es bedeutungslos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410828
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410828,
					"content": "#O Reisende{M#r} aus einem fremden Land, diese Kinder, dieses Land kann ich nicht vollständig schützen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410829
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410829,
					"content": "Ich bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410830
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410830,
					"content": "Ich bin der Erbauer des Helios, Aberaku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410831
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410831,
					"content": "Ich habe den Bau des Dainichi Mikoshi geleitet und mich von der Helligkeit des Spiegels beschenkt gefühlt, der mitten in der Ewigen Nacht hoch hängt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410832
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410832,
					"content": "Ich habe so viel Talent, so viel Talent!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410833
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410833,
					"content": "Ich dachte, ich könnte das Dainichi Mikoshi nutzen, um die Dunkelheit zu vertreiben. Aber wer hätte gedacht, dass über dem Dainichi Mikoshi die unersättliche Gier des menschlichen Herzens ausreichen würde, um die ganze Finsternis der ewigen Nacht zu beschwören?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410834
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410834,
					"content": "#Reisende{M#r} aus einem fremden Land, ich lege nun dieses Zaumzeug in deine Hände.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410835
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410835,
					"content": "Dieses Göttliche Zaumzeug ist ein Zeugnis für diese lächerliche und absurde Geschichte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410836
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410836,
					"content": "Behalte sie auf jeden Fall ... nein, mach damit, was du willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410837
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410837,
					"content": "Das ist zu wertvoll ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410838
					]
				},
				{
					"id": 722410838,
					"content": "Dieser Gegenstand war bereits bedeutungslos, sodass ich ihn heute als ein Andenken übergeben kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410839
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410839,
					"content": "So viel Talent ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410824,
					"content": "An einem Geburtstag ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410825
					]
				}
			]
