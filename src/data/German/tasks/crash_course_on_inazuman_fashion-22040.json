					"Ogura Mio"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220400101,
					"content": "Das ist kein Weg, um lange Geschäfte zu machen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400102
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400103
					]
				},
				{
					"id": 220400103,
					"content": "Ah, es tut mir leid. Ich war nur ein wenig in meinen eigenen Gedanken verloren. Willst du ein paar Klamotten kaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400104
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400104,
					"content": "Die hochwertigen Seiden aus Liyue sind weiterhin nicht auf Lager, aber wir haben noch die neuesten Kimonos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400105
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400105,
					"content": "Du hast früher Material von Liyue importiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400106
					]
				},
				{
					"id": 220400106,
					"content": "Ja. Früher konnten wir uns oft hochwertige Seide aus Liyue sichern, wie die, die die Händlergilde Feiyun aus Seidenblumen herstellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400107
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400107,
					"content": "Aber mit der aktuellen Situation hier, können wir schon seit einer Weile keine Seide mehr importieren. Wir müssen uns auf unseren Bestand verlassen, um den Betrieb aufrechtzuerhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400108
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400108,
					"content": "Jede Fuhre Seide, die wir hier verwenden, ist eine, die wir nicht zurückbekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400109
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400109,
					"content": "Ursprünglich hatte ich vor, selbst ein paar neue Kimono-Muster zu entwerfen oder einige neue Färbemittel zu verwenden, um neue Stoffe herzustellen und Kunden anzulocken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400110
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400110,
					"content": "Aber mir fällt nichts ein, was als neues Muster angesehen werden könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400111
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400111,
					"content": "#Reisende{M#r}, du hast sicher viel gesehen. Sind dir Muster begegnet, die du als neuartig bezeichnen würdest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400112
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400112,
					"content": "Ich glaube nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400113
					]
				},
				{
					"id": 220400113,
					"content": "Ah, ich verstehe. Ähm, das ist vielleicht ziemlich anmaßend von mir, aber ... Könntest du mir helfen, andere Fremde nach Mustern zu fragen, die wir verwenden könnten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400114
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400114,
					"content": "Ich bin die Einzige, die im Moment Ogura-Textilien betreibt, also kann ich den Laden nicht verlassen. Wenn ich Informationen sammeln möchte, kann ich nur andere bitten, dies für mich zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400115
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400115,
					"content": "Ich mach das schon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400116
					]
				},
				{
					"id": 220400116,
					"content": "Toll, lass mich nachdenken ... Du solltest Tang Wen und  Ramsay fragen. Vielleicht haben sie ein paar neue Ideen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
		},
