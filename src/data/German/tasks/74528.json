			"dialogs": [
				{
					"id": 745280401,
					"content": "Du bist es. Unsere Wege kreuzen sich also wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280402,
						745280403
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280402,
					"content": "Skirk, lange nicht gesehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				},
				{
					"id": 745280404,
					"content": "Ich beobachte die „Narben“, die diese Welt hinterlassen hat. Die Explosion hatte diesen Ort in Ruinen verwandelt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280405
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280405,
					"content": "Doch heute haben die Menschen schon wieder etwas Neues auf den Ruinen errichtet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280406
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280406,
					"content": "Alles hat ein Ende, doch nach dem Verfall entsteht stets die Möglichkeit für etwas Neues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280407
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280407,
					"content": "Deine Kraft ist seit unserem letzten Treffen gewachsen. Ich sehe, dass du dein Training nicht vernachlässigt hast. Sehr gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280408,
						745280409
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280408,
					"content": "Ich hätte da eine kleine Bitte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280410,
					"content": "Ein Foto? Für diese Welt bin ich nur ein flüchtiger Schatten. Wozu also eine Spur meiner Existenz hinterlassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280411,
						745280412
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280411,
					"content": "Aber für mich bist du kein flüchtiger Schatten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280413,
					"content": "... Wenn es das ist, was du tun möchtest, dann tu es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280414
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280414,
					"content": "Ich bin hier. Wir können jederzeit beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280412,
					"content": "Jedes Wiedersehen ist es wert, in Erinnerung zu bleiben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280409,
					"content": "Ich möchte ein Foto von dir machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280403,
					"content": "Was machst du hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				}
			]
		}
	]
