			"dialogs": [
				{
					"id": 200480601,
					"content": "Warum hast du das gemacht? Ich hab’s genau gesehen! Die armen Enten!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480602
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480602,
					"content": "Na, wegen der Tauben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480603
					]
				},
				{
					"id": 200480603,
					"content": "Hau ab! Ich will dich nicht mehr sehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480604
					],
					"speakerTitle": "Timmie"
				},
				{
