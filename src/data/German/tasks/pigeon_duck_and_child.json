					"nextDialogs": [
						200480203
					]
				},
				{
					"id": 200480203,
					"content": "Das müsste genug sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480204
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480204,
					"content": "Bring das den Enten am See.",
