					"Timmie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200480101,
					"content": "Oh nein, nicht du schon wieder! Jetzt sind die Tauben wieder alle weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480102
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480102,
					"content": "Ich war doch dabei, sie zu füttern. Was machst du nur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480103
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480103,
					"content": "Tut mir leid.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480104
					]
				},
				{
					"id": 200480104,
					"content": "Mama sagt, dass man mit Taten zeigen soll, dass man eine Entschuldigung ernst meint.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480105
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480105,
					"content": "Die Tauben auf der Brücke sind meine Freunde. Ich füttere sie immer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480106
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480106,
					"content": "In letzter Zeit kommen aber immer wieder Enten, die ihnen das Futter vor der Nase wegschnappen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480107
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480107,
					"content": "Ich möchte, dass du drei Ähren Weizen sammelst und die Enten damit fütterst. Dann werden auch die Tauben auf der Brücke satt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480108
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480108,
					"content": "Sobald alle satt sind, werden sie sicher gute Freunde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480109,
						200480110
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480109,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480111
					]
				},
				{
					"id": 200480111,
					"content": "Danke sehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480112
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480112,
					"content": "Wenn du Tiere gut behandelst, könnt ihr euch wirklich anfreunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480110,
					"content": "Ich bin nicht so wild darauf, mich mit Tauben anzufreunden ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480113
					]
				},
				{
					"id": 200480113,
					"content": "Ob du nun mit ihnen befreundet sein willst oder nicht, du musst dich trotzdem erst bei ihnen entschuldigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480114
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480114,
					"content": "Also besorge den Weizen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
