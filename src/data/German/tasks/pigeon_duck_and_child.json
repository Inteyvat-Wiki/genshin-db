			"dialogs": [
				{
					"id": 200480301,
					"content": "Sobald sie satt sind, werden sie alle besser miteinander auskommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480302
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480302,
					"content": "Wenn du das nächste Mal an ihnen vorbeigehst, erschrick die Tauben bitte nicht. Es dauert sonst wieder ewig, bis sie wiederkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480303
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480303,
					"content": "Ich werde vorsichtiger sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480304
					]
				},
				{
					"id": 200480304,
					"content": "Ist schon gut, ich verzeihe dir. Hier, nimm einen von den Kartoffelpuffern nach Mondstadt-Art. Die mag ich besonders!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480305
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480305,
					"content": "Man soll immer nett zu anderen sein. Das hat mir Mama beigebracht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
