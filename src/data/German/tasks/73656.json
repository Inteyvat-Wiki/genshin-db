					"id": 736560101,
					"content": "Über die Harra-Früchte ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736560102
					]
				},
				{
					"id": 736560102,
					"content": "Ah, du hast die Mission gesehen, die ich bei Herrn Effendi ausgehängt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736560103
					],
					"speakerTitle": "Housein"
				},
				{
					"id": 736560103,
					"content": "Herr Effendi ist ein zuverlässiger Mann. Wer dort Missionen aushängt, wird wirklich jemanden finden, der sie übernehmen will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736560104
					],
					"speakerTitle": "Housein"
				},
				{
					"id": 736560104,
					"content": "Wie sieht es aus? Hast du zehn Harra-Früchte gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736560108,
						736560105
					],
					"speakerTitle": "Housein"
				},
				{
					"id": 736560108,
					"content": "Hier sind sie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 736560105,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736560106
					]
				},
				{
					"id": 736560106,
					"content": "Mann, ich meine es ernst mit meinem Geschäft, weißt du? Und zehn ist keine große Zahl für einen Anbieter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736560107
					],
					"speakerTitle": "Housein"
				},
				{
					"id": 736560107,
					"content": "Wenn du wirklich mein Zulieferer werden willst, dann solltest du mindestens zehn Harra-Früchte liefern können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Housein"
				}
