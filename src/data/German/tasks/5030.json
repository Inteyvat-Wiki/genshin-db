			"dialogs": [
				{
					"id": 50300501,
					"content": "Wie ist der Stand der Dinge? Haben wir noch genügend medizinische Vorräte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300502
