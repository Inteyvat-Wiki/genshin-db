			"dialogs": [
				{
					"id": 50301001,
					"content": "Ah, du bist wieder da. Danke, dass du mich gerettet hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301002
					],
					"speakerTitle": "Raman"
				},
				{
					"id": 50301002,
					"content": "Wir sind nur froh, dass es dir gut geht. He, wo sind die Saurier hin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301003,
					"content": "Oh, sie sind wieder im Einsatz und helfen den verbleibenden Boten bei der Auskundschaftung und der Übermittlung von Informationen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301004
					],
					"speakerTitle": "Raman"
				},
				{
					"id": 50301004,
					"content": "Es macht mich fertig, dass ich nicht in der Lage bin, meinen Teil zu tun. Vor allem, weil ich weiß, wie schlimm die Dinge da draußen geworden sind. Aber ich denke, man muss seine Grenzen kennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raman"
				}
			]
		},
