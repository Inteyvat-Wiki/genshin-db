			},
			"dialogs": [
				{
					"id": 50300601,
					"content": "Ich bin so dankbar, dass Mayahuel hier ist. Dank ihrer Erfahrung konnten wir viel mehr Menschen behandeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300602
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300602,
					"content": "Aber ich mache mir Sorgen, dass sie sich überanstrengt. Sie hat nicht eine Pause gemacht. Ich muss jemand anderen finden, der einspringt, damit ich sie überreden kann, mal auszuruhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qhispe"
				}
			]
		},
