			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qhispe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300101,
					"content": "O Archonten, ich bin überfordert ... Wir sind unterbesetzt und unterversorgt und ich kann nicht mal die Hälfte der Wunden behandeln, die ich sehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300102
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300102,
					"content": "Ich wünschte nur, ich hätte jemanden mit mehr Fachwissen, an den ich mich wenden könnte ... Ach, nein, so darf ich nicht denken. Ich muss mich der Herausforderung stellen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qhispe"
				}
			]
		},
		{
			"id": 503002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"503002",
							"2"
						],
						"stepId": 503002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Awhina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300201,
					"content": "Ich habe gesehen, dass du Chuychu zurückgebracht hast ... Es ist so eine große Tragödie. Chuychu war die vielversprechendste Ärztin, die ich je kennenlernen durfte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300202
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300202,
					"content": "Wir waren enge Geschäftspartner. Sie hatte die höchsten Ansprüche an die medizinische Versorgung und griff oft in die eigene Tasche, um ihre Patienten zu behandeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300203
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300203,
					"content": "Sie hat mir immer gesagt, dass sie das Erlebnis mehr schätzte als das Geld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300204
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300204,
					"content": "Sie sagte, sie müsse ihre Fähigkeiten vervollkommnen, damit sie mehr Menschen retten könnte, vor allem die eine Person, die sie am meisten retten wollte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300205
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300205,
					"content": "Leider war die einzige Person, die sie nicht retten konnte, am Ende sie selbst. Und nun hat Natlan eines der größten Talente einer ganzen Generation verloren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Awhina"
				}
			]
		},
