			"dialogs": [
				{
					"id": 50301401,
					"content": "Ich freue mich, dass ihr gesund und munter zurückgekommen seid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301402
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301402,
					"content": "Wir halten nur unser Wort! Wir haben gesagt, dass wir uns in der wieder sehen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301403,
					"content": "Hehe ... Weißt du, das war das erste Mal in meinem Leben, dass ich ein Angrundmonster erschlagen habe, und in dem Moment wurde mir klar, dass sie gar nicht so schlimm sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301404
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301404,
					"content": "Ich habe meine Angst zu lange gewinnen lassen ... Ich frage mich, wie viele Menschen ich hätte retten können, wenn ich nur den Mut gehabt hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301405
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301405,
					"content": "Sei nicht so streng zu dir selbst. Im Moment ist das Wichtigste, was du tun kannst, am Leben zu bleiben. Wir müssen weiterleben, damit ihre Geschichten erzählt werden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301406
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301406,
					"content": "Sie werden für immer in unseren Herzen weiterleben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Libiac"
				}
			]
		},
