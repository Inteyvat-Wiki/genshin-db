			"dialogs": [
				{
					"id": 50301201,
					"content": "Die Saurier, mit denen ich zurückkam, waren fest entschlossen, den anderen Kriegern in die Schlacht zu folgen. Ich konnte einfach nichts tun, um sie aufzuhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301202
					],
					"speakerTitle": "Haronga"
				},
				{
					"id": 50301202,
					"content": "Damit bin ich offiziell das nutzloseste Mitglied der Einheit ... *seufz* Aber wenigstens weiß ich genug über Sauriermedizin, um bei der Behandlung ihrer Verletzungen zu helfen.",
					"roleType": "TALK_ROLE_NPC",
