					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300503,
					"content": "Ich weiß, ich weiß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300504
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300504,
					"content": "Na gut, dann gib mir wenigstens meinen Anteil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300505
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50301601,
					"content": "Ah, ihr seid es. Freut mich, dass es euch beiden gut geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300506,
					"content": "Wie geht es deinem Sohn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50300507
					]
				},
				{
					"id": 50300507,
					"content": "Keine Ahnung. Die Kommunikation ist zum Erliegen gekommen und es gibt zu viele Verwundete, um die ich mich kümmern muss. Im Moment konzentriere ich mich auf sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300508
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300508,
					"content": "Aber ich vertraue ihm. Ich weiß, dass er die richtige Entscheidung treffen wird, auch wenn es Schwierigkeiten gibt. Er ist mein Sohn und ich werde immer stolz auf ihn sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayahuel"
				}
			]
		},
		{
			"id": 503006,
