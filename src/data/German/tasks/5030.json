			},
			"dialogs": [
				{
					"id": 50301101,
					"content": "Oh, hallo, Leute. Danke noch mal, dass ihr uns gerettet habt. Osawe, sieh mal, wer da ist! Sag danke zu diesen Helden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301102
					],
					"speakerTitle": "Iyoba"
				},
				{
					"id": 50301102,
					"content": "Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301103
					],
					"speakerTitle": "Osawe"
				},
				{
					"id": 50301103,
					"content": "Oh, nicht der Rede wert. Paimon ist nur froh, dass es euch gut geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301104,
					"content": "Ich muss mich auch bei den anderen Leuten bedanken, die uns geholfen haben. Wie hießen die nochmal? Fett... uiuiui...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301105
					],
					"speakerTitle": "Osawe"
				},
				{
					"id": 50301105,
					"content": "Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301106,
					"content": "Ja, das war’s, die Fatui! Sie waren auch erstaunlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301107
					],
					"speakerTitle": "Osawe"
				},
				{
					"id": 50301107,
					"content": "Ja. In der Vergangenheit war mein Eindruck von den Fatui nicht gerade positiv, aber das hat meine Sichtweise wirklich verändert. Gute Leute gibt es in jeder Organisation.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iyoba"
				}
			]
		},
