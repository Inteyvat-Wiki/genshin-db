				"points": []
			},
			"dialogs": [
				{
					"id": 50301501,
					"content": "Es geht euch gut! Zum Glück, wir haben uns große Sorgen um euch gemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301502
					],
					"speakerTitle": "Achiyaku"
				},
				{
					"id": 50301502,
					"content": "Du hast es also in Sicherheit geschafft? War die Reise in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301503,
					"content": "Äh ... nicht ganz. Wir sind auf einen Haufen Abgrundmonster gestoßen und mussten um unser Leben kämpfen. Aber eins muss ich diesen Leuten lassen, sie haben sich wirklich der Situation gestellt. Sie haben genauso gut gekämpft wie ausgebildete Krieger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301504
					],
					"speakerTitle": "Achiyaku"
				},
				{
					"id": 50301504,
					"content": "Hehe, die Bewegungen hab ich also immer noch drauf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301505
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301505,
					"content": "Ich habe großes Glück, dass ich noch am Leben bin. Wir müssen weiter überleben, damit wir uns zurückholen können, was wir verloren haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301506
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301506,
					"content": "Ihr solltet sicherstellen, dass ihr auch überlebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kunak"
				}
			]
		},
