			"dialogs": [
				{
					"id": 50300301,
					"content": "Wie ist der Stand der Dinge? Haben wir noch genügend medizinische Vorräte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300302
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300302,
					"content": "Wir haben fast nichts mehr. Es gibt noch die Notvorräte, aber die sind für die Ärzte und Soldaten reserviert. Die können wir nicht anrühren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300303
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300303,
					"content": "Ich weiß, ich weiß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300304
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300304,
					"content": "Na gut, dann gib mir wenigstens meinen Anteil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayahuel"
				}
			]
		},
