				"points": []
			},
			"dialogs": [
				{
					"id": 50300901,
					"content": "Oh, ihr zwei seid es. Ich dachte, wir würden uns nie wieder sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300902
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300902,
					"content": "Ich habe gut gekämpft und wir haben gewonnen, auch wenn es uns teuer zu stehen kam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300903
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300903,
					"content": "Werdet ihr weiterkämpfen? Wenn ja, seid bitte vorsichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300904
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300904,
					"content": "Der Kampf gegen den Abgrund ist eine große Ehre, aber der Weg zum Sieg führt nicht über Ehre und Ruhm, sondern über das Überleben bis zum nächsten Tag.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uturunku"
				}
			]
		},
