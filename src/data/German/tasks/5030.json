			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uturunku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300801,
					"content": "Ihr beiden! Fantastisch! Ich bin so dankbar für all eure Aufmunterung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300802
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300802,
					"content": "Viele Menschen in Natlan sehen es als eine Ehre an, gegen den Abgrund zu kämpfen, aber dann lassen sie sich die Aufregung zu Kopf steigen und begeben sich in große Gefahr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300803
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300803,
					"content": "Du hattest recht: Es ist wichtig, zu kämpfen, aber es ist auch wichtig, am Leben zu bleiben. Wir kämpfen für die Menschen, die wir lieben, und auch für die Chance, sie wiederzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300804
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300804,
					"content": "Ich habe eure Gedanken mit meinen Kameraden geteilt und auch sie waren begeistert. Jetzt kämpft jeder mit mehr Entschlossenheit und wir wenden das Blatt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300805
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300805,
					"content": "Also noch einmal ... vielen Dank von ganzem Herzen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uturunku"
				}
			]
		},
		{
			"id": 503009,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
