				]
			},
			"dialogs": [
				{
					"id": 790640801,
					"content": "Das ist das Hauptquartier der Wachen. Wenn wir die Situation erklären können, wird der riesige Wächter uns sicher weniger feindselig gegenüberstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640802
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Blauer Überwacher"
				},
				{
					"id": 790640802,
					"content": "Hallo ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790640803
					]
				},
				{
					"id": 790640803,
					"content": "Was hast du vor? Ich schwelge in Erinnerungen an alte Zeiten mit einem Foto meines Freundes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640804
					],
					"speakerTitle": "An die Tür klopfen"
				},
				{
					"id": 790640804,
					"content": "Ich kenne diese Stimme. Ist das Winston?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640805
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Blauer Überwacher"
				},
				{
					"id": 790640805,
					"content": "Hahaha, du kommst also zurückgekrochen ... Ich habe dir doch gesagt, dass ich dein einziger Freund auf dieser Welt bin. Was hast du dir dabei gedacht, mit zwei völlig Fremden auf eine Mission zu gehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640806
					],
					"speakerTitle": "An die Tür klopfen"
				},
				{
					"id": 790640806,
					"content": "Du warst so naiv. „Oh, ich werde mich mit ihnen anfreunden, ich weiß, dass ich das tun werde!“ Aber am Ende warte ich allein auf dich. Ich allein bin dein Freund.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640807
					],
					"speakerTitle": "An die Tür klopfen"
				},
				{
					"id": 790640807,
					"content": "#Das ist nicht wahr ... Es sind nicht nur diese beiden. Es gibt auch {F#Gräfin}{M#Graf} {NICKNAME} und {F#ihre}{M#seine} Gefährten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640808
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Blauer Überwacher"
				},
				{
					"id": 790640808,
					"content": "... Du hast hinter meinem Rücken andere Freunde gefunden!? Sieh dich nur an, Albizzi, ganz erwachsen ... Jetzt reicht’s mir aber. Raus mit dir! Ich will dein Gesicht nie wieder sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640809
					],
					"speakerTitle": "An die Tür klopfen"
				},
				{
					"id": 790640809,
					"content": "Ehrlich gesagt, nein. Warum hebst du nicht für eine Sekunde die Notmaßnahmen auf und lässt mich rein? Ich habe einen VIP bei mir und wir sind kurz davor, das Geheimnis unserer heiligen Stätte zu lüften.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640810
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Blauer Überwacher"
				},
				{
					"id": 790640810,
					"content": "Ich sagte: „Raus!!!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640811
					],
					"speakerTitle": "An die Tür klopfen"
				},
				{
					"id": 790640811,
