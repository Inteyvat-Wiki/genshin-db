			"dialogs": [
				{
					"id": 790640301,
					"content": "#Leute, ich bin zurückgekehrt. Ich komme mit {F#der}{M#dem} lang erwarteten {F#Gräfin}{M#Grafen} und {F#ihren}{M#seinen} Anhängern, um nach den verlorenen Ursprüngen unseres Klans zu suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640302
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Blauer Überwacher"
				},
				{
					"id": 790640302,
					"content": "Tja, davon hat man uns heute Morgen nichts gesagt. Verschwindet von hier. Lasst uns in Ruhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640303
					],
					"speakerTitle": "Riesige Wache"
				},
				{
					"id": 790640303,
					"content": "Der riesige Wachmann packt euch alle und wirft euch nach draußen.\\nKeiner kann sich wehren.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
