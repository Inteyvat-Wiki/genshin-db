			"dialogs": [
				{
					"id": 790640601,
					"content": "Verdächtige Personen entdeckt! Ich weiß nicht, gegen welches Gesetz ihr verstoßen habt, aber wir haben derzeit die höchste Alarmstufe. Kommt mit uns, stellt euch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640602
					],
					"speakerTitle": "Riesige Wache"
				},
				{
					"id": 790640602,
					"content": "Alle zerstreuen sich. Ihr hört Cappets Stimme, die ruft: „Jeder ist auf sich allein gestellt!“\\nNachdem die Wachen verschwunden sind, versammelt ihr euch wieder am selben Ort. Es sieht so aus, als wäre niemand erwischt worden ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						790640603
					]
				},
				{
					"id": 790640603,
					"content": "Versuchen wir das noch einmal, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Detektiv"
				}
			]
		},
