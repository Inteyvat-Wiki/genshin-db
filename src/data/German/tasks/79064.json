			"dialogs": [
				{
					"id": 790640101,
					"content": "Danke, dass du ehrlich warst und dich bereitwillig ergeben hast. Wir werden dich jetzt höflich aus dem Sperrgebiet hinausbegleiten.",
					"roleType": "TALK_ROLE_NPC",
