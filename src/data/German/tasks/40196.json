			},
			"dialogs": [
				{
					"id": 401960301,
					"content": "#Juhu, {NICKNAME}, Kinich, ihr seid zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960302,
					"content": "Wir haben gerade gesehen, wie Chevreuse den Verbrecher abgeführt hat. Sie sah ziemlich zufrieden mit sich selbst aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960303,
						401960304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960303,
					"content": "Na, das lief ja geschmeidiger als erwartet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960305
					]
				},
				{
					"id": 401960305,
					"content": "Hehe, nach all dem Herumgerenne stellt sich heraus, dass Kämpfen ihm nicht so liegt, hm? Weglaufen war wohl sein einziger Trick!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960306,
					"content": "Ach ja, Wriothesley lässt ausrichten, dass er schon los ist. Er ist zum Palais Mermonia zurückgekehrt, um Bericht zu erstatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960307,
					"content": "Anscheinend bereitet das Maréchaussée-Phantom eine gründliche Untersuchung der illegalen Glücksspielaktivitäten vor. Klingt, als hätten sie alle Hände voll zu tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960308,
					"content": "Aber egal, sollen die sich im Palais darum kümmern. Nicht unsere Baustelle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960309,
					"content": "So fix wie der Herzog abgeflitzt ist, würde ich meinen, er wollte meiner Kamera aus dem Weg gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960310
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960310,
					"content": "*seufz* Aber ich bin das wohl inzwischen schon gewöhnt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960311
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960311,
					"content": "He, so leicht gibst du doch sonst nicht auf, Charlotte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960312,
					"content": "Hehe, schon in Ordnung – ich habe da hinten genügend tolle Aufnahmen gemacht. Mehr als genug für die Titelseite!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960313
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960313,
					"content": "Und da muss die beschäftigte Reporterin auch schon los. Die Fotos entwickeln sich schließlich nicht von selbst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960314
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401960314,
					"content": "Vergiss nicht, die besten Schnappschüsse von Paimon rauszusuchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960315,
					"content": "Oh, schon weg ... Hoffentlich hat sie das noch gehört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960316,
					"content": "Du kannst ihr vertrauen, Paimon. Sie ist eine professionelle Fotografin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960317
					]
				},
				{
					"id": 401960317,
					"content": "Jap, da hast du recht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960318,
					"content": "Aber warum hat es so lange gedauert, bis ihr hier wart? Ist etwas passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960319,
						401960324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960319,
					"content": "Ajaw hat sich den Kopf gestoßen und fing an zu flennen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960320
					]
				},
				{
					"id": 401960320,
					"content": "Wie bitte?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960321
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960321,
					"content": "Gerüchte und Verleumdungen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960322
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960322,
					"content": "Wann habe ich, der allmächtige Drachenfürst, K’uhul Ajaw, mich jemals zu so einem Gewimmer herabgelassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960323
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960323,
					"content": "Eigentlich ziemlich oft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960329
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960329,
					"content": "Also ... Wie geht es weiter?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960330
					]
				},
				{
					"id": 401960330,
					"content": "Hmm ... Ehrlich gesagt, habe ich mich noch nicht entschieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960331
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960331,
					"content": "Gerade habe ich nichts Dringendes vor. Und vielleicht braucht mich das Gericht nochmal als Zeugen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960332
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960332,
					"content": "Außerdem ist die Waffe nach wie vor ein wichtiges Beweisstück. Ich muss also wohl bis zum Abschluss des Falls warten, bevor ich sie nach Natlan zurückbringen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960333
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960333,
					"content": "Dann bleib ich halt noch ein bisschen hier und genieße den Strand und das Meer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960324,
					"content": "Kinich hat sich den Kopf gestoßen und fing an zu weinen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960325
					]
				},
				{
					"id": 401960325,
					"content": "Wenn du meinst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960326
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960326,
					"content": "Hahaha! Armer kleiner Kinich! Keiner da, der ihm übers Köpfchen streichelt, also heult er halt allein vor sich hin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960327
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960327,
					"content": "Dein Ernst jetzt? Dass Ajaw geweint hat, klingt wesentlich wahrscheinlicher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960328,
					"content": "He! Du kleine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960329
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960304,
					"content": "Unser Gegner war ziemlich schwach.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960305
					]
				}
			]
		}
	]
}