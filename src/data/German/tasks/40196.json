			"dialogs": [
				{
					"id": 401960201,
					"content": "Dieser Strand wird mit jedem Tag lebendiger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960202,
					"content": "(Sicherlich auch dank der verdeckten Ermittler unter den Besuchern.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960203
					]
				},
				{
					"id": 401960203,
					"content": "#{NICKNAME}, ähm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960204,
					"content": "Ähem! Paimon kriegt langsam Hunger ... Schauen wir mal in die Speisekarte, was meinst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960205,
					"content": "(Der mit dem Koffer ... das muss er sein.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960206
					]
				},
				{
					"id": 401960206,
					"content": "(Also, jetzt wird’s ernst.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960207
					]
				},
				{
					"id": 401960207,
					"content": "Unglaublich! Man kann doch nicht einfach Leute so herumzerren! So was von menschenverachtend ... Ich werde dich verklagen, darauf kannst du Gift nehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960208
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960208,
					"content": "Ist das so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960209
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960209,
					"content": "Ich denke, ich habe dir einen Gefallen getan, als ich dich von deinem „Publikum“ wegholte. Das hat dir zumindest einen Hauch Würde bewahrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960210
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960210,
					"content": "Ob du dabei mit dem Gesicht nach oben oder unten lagst ... Tja, das war ja wohl deine eigene Entscheidung, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960211
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960211,
					"content": "Du ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960212
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960213
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960213,
					"content": "Na gut, na gut, ich gebe zu, ich hatte Unrecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960214
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960214,
					"content": "*seufz* Natürlich weiß ich, was richtig und falsch ist. Aber ich hatte keine andere Wahl ... Ich brauchte das Geld so dringend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960215
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960215,
					"content": "Ich war ein Experte für antike Relikte ... Ich hatte nicht nur eine erfolgreiche Karriere, sondern auch eine glückliche Familie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960216
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960216,
					"content": "Aber mein Sohn ... Ich hätte nie gedacht, dass er mal so werden würde. Hat sich mit den falschen Leuten eingelassen und steckte dann bis zum Hals in Spielschulden ... Wir hatten ein paar Ersparnisse, aber die hat er quasi zum Fenster rausgeworfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960217
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960217,
					"content": "Sobald er in Schulden geraten war, kamen regelmäßig Gläubiger vorbei, um ihn zu bedrohen und einzuschüchtern ... Ich bin sein Vater. Wie könnte ich da einfach zusehen und ihn so leiden lassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960218
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960218,
					"content": "*seufz* Mein Sohn ist ungefähr in deinem Alter! Wenn er doch nur mehr wie du geworden wäre ... Das war der einzige Grund, warum ich das Geld brauchte, glaub mir doch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960219
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960220
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960220,
					"content": "Du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960221
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960221,
					"content": "Bitte, junger Mann, ich flehe dich an, hilf mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960222
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960222,
					"content": "Wie ich sehe, stammst du auch aus Natlan ... Das macht uns zu Brüdern! Also bitte, hab Gnade!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960223
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960223,
					"content": "Ich habe immer noch eine Chance, meinem Sohn zu helfen, auf den rechten Weg zu kommen – aber nur, wenn ich zurückgehe. Wenn ich jetzt ins Gefängnis komme, dann ist er verloren, sage ich euch, verloren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960224
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960224,
					"content": "Zusammenhalten und für eine bessere Zukunft kämpfen, ist es nicht genau das, was Familie ausmacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960225
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960225,
					"content": "Unser Schicksal liegt in deinen Händen, junger Mann. Bitte, hab doch ein Herz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960226
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960227
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960227,
					"content": "Haha, was ist los, Kinich? Bist wohl weich geworden, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960228
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960228,
					"content": "Hmpf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960229
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960229,
					"content": "Ich glaube dir kein einziges Wort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960230
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960230,
					"content": "Wriothesley hat dich durchschaut. Du bist ein Zocker, und zwar durch und durch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960231
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960231,
					"content": "Ein Zocker? Ich? Unsinn! Ich sagte dir doch, es ist mein Sohn ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960232
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960232,
					"content": "Erstens, kommst du überhaupt wirklich aus Natlan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960233
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960233,
					"content": "Du hast die ganze Zeit über den Standort der Waffe im Blick gehabt – du hättest inzwischen wenigstens ein vertrautes Gesicht erkennen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960234
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960234,
					"content": "Und außerdem, wie du mir da eben mit einer Anzeige gedroht hast! Das klang ja wie ein echter Fontainer, wenn du mich fragst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960235
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960235,
					"content": "Hä? Was ist denn das für eine Logik ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960236
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960236,
					"content": "I... Ich kann das erklären! Ich ... bin eigentlich aufgewachsen in ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960237
					],
					"speakerTitle": "Angoulvant"
				},
				{
					"id": 401960237,
					"content": "Tss. Ich will kein Wort mehr hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960238
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960238,
					"content": "Ajaw, hier ist deine Gelegenheit. Diesmal darfst du jemand anderen zum Schweigen bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960239
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960239,
					"content": "Hahaha, der Moment, auf den ich gewartet habe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960240
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960240,
					"content": "Friss das, Abschaum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960241
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960241,
					"content": "Zwanghaftes Lügen ist eines der Hauptmerkmale von eingefleischten Glücksspielern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960242
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960242,
					"content": "Ich wette, du bist einfach jemand aus Fontaine, der vorgibt, aus Natlan zu sein. Selbst wenn du noch Freunde oder Familie hast, haben sie vermutlich schon längst alle Verbindungen zu dir abgebrochen – deiner verdorbenen Lebensweise sei Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960243
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960243,
					"content": "Natürlich könnte ich mich auch irren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960244
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960244,
					"content": "Aber wen juckt das schon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960245
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960245,
					"content": "Ich bin hier, um dich zu verhaften. Wenn du einen Anwalt oder eine Schulter zum Heulen suchst, hast du leider Pech.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960246
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960246,
					"content": "Und außerdem, die Wahrheit aus dir herauszupressen, dafür sind doch deine verehrten Gerichte da. Nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960247
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960247,
					"content": "Ja, das stimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960248
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960248,
					"content": "Lange nicht gesehen, Herr Kinich. Die Sonderpatrouille wird dir diesen Kriminellen jetzt abnehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960249
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960249,
					"content": "Vielen Dank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960250
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960250,
					"content": "Ach, bitte. Ich bin es, der sich bei dir für all deine Hilfe bedanken sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960251
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960251,
					"content": "Und ich? Hm, hmm? Was ist mit mir? Hmpf, wie unhöflich! Du solltest dich voller Dankbarkeit vor dem allmächtigen Drachenfürsten verbeugen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960252
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960252,
					"content": "Wie du wünschst! Dir und auch Herrn Cacucu gilt mein Dank für eure atemberaubenden Vorstellungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960253
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401960253,
					"content": "He, was soll das heißen?! Jetzt warte mal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960254
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960254,
					"content": "Alles gut, Kinich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960255
					]
				},
				{
					"id": 401960255,
					"content": "Keine Sorge, mir geht’s gut. Ich war ja nicht derjenige, der den ganzen Weg hierher geschleift wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960256
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960256,
					"content": "Sah gerade so aus, als wärst du ein bisschen aufgewühlt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960257
					]
				},
				{
					"id": 401960257,
					"content": "Pff ... Kleiner Kinich, denkst wohl grade an die Zeiten zurück, als du noch ein klitzekleines Kinichlein warst, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960258
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960258,
					"content": "Hach, fang jetzt nicht zu heulen an wie ein Baby! Ich bin der allmächtige Drachenfürst! Kein Knecht von mir wird in der Öffentlichkeit so schwach und erbärmlich auftreten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960259
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 401960259,
					"content": "Was laberst du da eigentlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960260
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960260,
					"content": "Böser Ajaw, böser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960261
					]
				},
				{
					"id": 401960261,
					"content": "Dennoch, ich nehme an, es hat keinen Sinn, es vor dir zu verbergen. Um es ganz direkt zu sagen: Ich kann Glücksspieler nicht ausstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960262
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960262,
					"content": "Sie sind die verantwortungslosesten Menschen weit und breit ... Sie haben keinerlei Respekt vor dem Prinzip, dass man geben muss, um etwas zu bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960263
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960263,
					"content": "Die erzählen dir tausend Lügen für eine schäbige Münze und machen sich vor, dass sie damit beim Glücksspiel ein Vermögen gewinnen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960264
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960264,
					"content": "Aber wir alle wissen doch, dass es immer einen versteckten Preis gibt, selbst, wenn man scheinbar etwas für umsonst bekommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960265
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960265,
					"content": "Früher habe ich selbst schon die Zeche gezahlt für die Spielsucht meines Vaters. Ich möchte nicht, dass jemand anderes in eine ähnliche Situation gerät, wenn ich es verhindern kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960266
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960266,
					"content": "Kinich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960267
					]
				},
				{
					"id": 401960267,
					"content": "Du musst mich nicht bemitleiden. Ich empfinde definitiv kein Selbstmitleid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960268
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960268,
					"content": "Man sagt, dass die Vergangenheit uns prägt. Und da ich es bis hierher geschafft habe ... muss ich wohl vieles richtig gemacht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960269
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960269,
					"content": "Wir sollten uns nicht für die Fehler anderer bestrafen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960270
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960270,
					"content": "Stattdessen denke ich lieber an die Momente, die mich stärker gemacht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960271
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960271,
					"content": "Zum Beispiel, als ich zum ersten Mal lernte, wie man ein Kletterseil benutzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960272
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960272,
					"content": "Oder als ich zum ersten Mal Wissensdurst spürte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960273
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960273,
					"content": "Ich verstehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960274
					]
				},
				{
					"id": 401960274,
					"content": "Ja, das glaube ich dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960275
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960275,
					"content": "Gehen wir. Wenn wir nicht bald zurück sind, wird man sich nur noch mehr Sorgen machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinich"
				}
			]
		},
