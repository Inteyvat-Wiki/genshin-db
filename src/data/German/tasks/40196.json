			"dialogs": [
				{
					"id": 401960101,
					"content": "He, Leute! Wir sind doch wohl nicht zu spät, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960102,
					"content": "Nein, ihr seid genau rechtzeitig. Gut ausgeschlafen, hoffe ich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960103
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960103,
					"content": "Wer rastet, der rostet nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960104
					]
				},
				{
					"id": 401960104,
					"content": "Absolut! So bleibt man in Schwung und spritzig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960105
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960105,
					"content": "Habt ihr schon mit den Vorbereitungen begonnen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960106
					]
				},
				{
					"id": 401960106,
					"content": "Wir haben gestern eine Nachricht von Herrn Argenteau erhalten, in der er Zeit und Ort der Transaktion bestätigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960107
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960107,
					"content": "Es wird heute Nachmittag stattfinden. Und wie sich herausstellt, an einem Ort, den wir alle ziemlich gut kennen: das Restaurant des Filmtasielands.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960108
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960108,
					"content": "Oh, wirklich? Hm, er liebt diesen Ort echt sehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960109,
					"content": "Aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960110
					]
				},
				{
					"id": 401960110,
					"content": "#Anscheinend teilst du unsere Bedenken, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960111
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960111,
					"content": "Stimmt. Es wird viel schwieriger sein, jemanden auf einem überfüllten Veranstaltungsgelände zu fangen als auf einem leeren Feld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960112
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960112,
					"content": "Der Verbrecher könnte versuchen, in der Menge unterzutauchen oder sogar mit Geiseln zu fliehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960113
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960113,
					"content": "Angesichts dessen mussten wir zusätzliche Vorbereitungen treffen. Sobald wir gestern die Nachricht erhielten, haben wir begonnen, uns mit dem Maréchaussée-Phantom und der Sonderpatrouille für Sicherheit und Überwachung zu koordinieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960114
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960114,
					"content": "Mhm. Wir werden viele verdeckte Ermittler vor Ort einsetzen. Falls etwas schiefgeht, ist die Sicherheit der Zivilisten unsere oberste Priorität.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960115
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960115,
					"content": "Klar drücken wir die Daumen, dass alles glattläuft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960116
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960116,
					"content": "Ich habe viele bekannte Gesichter vom letzten Fall gesehen, wie zum Beispiel Truppenführerin Chevreuse von der Sonderpatrouille. Das macht mir Hoffnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960117
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960117,
					"content": "Dann vertrauen wir auf dein Bauchgefühl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960118
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960118,
					"content": "Ach ja, übrigens stehen wir auch in Kontakt mit Fräulein Lépine-Pauline und Fräulein Navia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960119
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960119,
					"content": "Die Spina di Rosula wird in einem bestimmten Rahmen Unterstützung leisten, also mach dir keine Sorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960120
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960120,
					"content": "Das einzige potenzielle Problem ... liegt bei Fräulein Escoffier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960121,
						401960123
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960121,
					"content": "Sie will keinen Verbrecher bedienen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960122
					]
				},
				{
					"id": 401960123,
					"content": "Sie will ihn mit ihrem Schneidebrett bekannt machen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960124
					]
				},
				{
					"id": 401960122,
					"content": "Ha, wenn es so einfach wäre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960124,
					"content": "Weißt du was, das ist vielleicht gar keine schlechte Idee ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960125,
					"content": "Ähem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960126
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960126,
					"content": "Gut, Schluss mit den Scherzen. Fräulein Escoffier hat klipp und klar gesagt, dass ihr Restaurant keinen Schaden durch diese Aktion nehmen soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960127
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960127,
					"content": "Aber, äh ... Haha, na ja, ich habe so ein Gefühl, dass die Sache nicht ganz so glattlaufen wird, wie sie hofft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960128
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960128,
					"content": "Kann ich irgendwas tun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960129
					]
				},
				{
					"id": 401960129,
					"content": "Ehrlich gesagt, hätten wir dich gar nicht erst in die Sache hineinziehen sollen, das hat dir schon genug Ärger eingebrockt. Die Behörden von Fontaine sollten ab jetzt mit dem Rest klarkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960130
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960130,
					"content": "Aber ich vermute trotzdem, du willst bestimmt wissen, wie das Ganze ausgeht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960131
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960131,
					"content": "Auf jeden Fall.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960132
					]
				},
				{
					"id": 401960132,
					"content": "Na dann, ab zum Tatort! Aber schön die Augen offen halten und spontan reagieren. Vielleicht musst du gar nichts tun. Es sei denn, es läuft völlig aus dem Ruder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960133
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960133,
					"content": "Ich werde mein Bestes geben, dass es erst gar nicht so weit kommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960134
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960134,
					"content": "Du mischst dich jetzt auch ein, Kinich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960135
					]
				},
				{
					"id": 401960135,
					"content": "Selbstverständlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960136
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960136,
					"content": "Es gibt noch viele unbeantwortete Fragen, aber unsere bisherigen Informationen deuten darauf hin, dass der Täter aus Natlan stammt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960137
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960137,
					"content": "Und ich bin ja auch Zeuge in diesem Fall. Da kann ich genauso gut die Sache bis zum Ende durchziehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960138
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960138,
					"content": "Hehe, das ist genau der Kinich, den wir kennen und lieben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960139,
					"content": "Die Gruppe bespricht dann die Einzelheiten der Operation und worauf man achten muss.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401960140
					]
				},
				{
					"id": 401960142,
					"content": "Nun, genug geplaudert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960143
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960143,
					"content": "Die Operation ist für den Nachmittag geplant. Wenn wir uns beeilen, haben wir sogar noch Zeit für ein paar Tassen Tee, bevor wir aufbrechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960144
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960144,
					"content": "#Ach ja, lass uns auch etwas essen gehen, {NICKNAME}! Mit leerem Bauch kann man doch nicht arbeiten, weißt du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960145,
					"content": "Aber du schaust doch sowieso nur zu, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960146
					]
				},
				{
					"id": 401960146,
					"content": "Und dir die Daumen drücken! Eine sehr wichtige Aufgabe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960147,
					"content": "Gut, ich gehe jetzt zum Veranstaltungsort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960148
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960148,
					"content": "Ajaw jammert schon seit Tagen, dass er das limitierte Aktionsmenü probieren will. Also bring ich’s lieber hinter mich, bevor er mir weiter in den Ohren liegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960149
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960149,
					"content": "Bis gleich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960150
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960150,
					"content": "Ich freue mich darauf zu hören, wie es läuft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		},
