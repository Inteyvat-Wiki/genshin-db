			"dialogs": [
				{
					"id": 150250101,
					"content": "Ihr seid also die, die der Älteste Tlapo auserwählt hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250102
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250102,
					"content": "Jepp! Und wer bist du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250103,
					"content": "Ihr könnt mich Toltec nennen. Der Häuptling bat mich, heute euer Begleiter zu sein. Seine Boten haben mich schon über alles informiert. Folgt mir einfach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toltec"
				}
			]
		},
		{
			"id": 1502502,
			"completionStepIds": [
				1502503
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1502503",
							"2"
						],
						"stepId": 1502503,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"15025"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Toltec"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 150250201,
					"content": "Waren wir hier nicht schon mal drin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250202,
					"content": "Ja, aber vergiss nicht, wir sind die Auserwählten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250203
					]
				},
				{
					"id": 150250203,
					"content": "Das Seltsame ist, dass unsere Ahnen das Siegel nicht entfernten, selbst nachdem sie das Graffiti vollendet hatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250204
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250204,
					"content": "Seit es versiegelt wurde, hat nur die große Schamanin Huitzilin diesen Ort betreten. Das war vor zweihundert Jahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250205
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250205,
					"content": "Ihr zufolge erzählt dieses Kunstwerk die Geschichte eines Helden mit dem Namen Kuntur ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250206
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250206,
					"content": "... Aber ich schweife ab. Verzeihung, ich bin ein großer Bewunderer von Graffiti-Kunst, und wenn ich einmal anfange, könnte ich stundenlang reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250207
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250207,
					"content": "Bist du sicher, dass du nicht mit uns kommen willst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250208,
					"content": "Ich habe einmal versucht hineinzukommen, aber das Siegel hat mich aufgehalten. Selbst der Versuch, meinen Iktomisaurier es mit seinen Kräften durchbrechen zu lassen, funktionierte nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250209
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250209,
					"content": "Es scheint, als sei dies eine Prüfung, die unsere Ahnen hinterlassen haben. Wer die Prüfung nicht besteht, ist nicht würdig, ihre Kunstwerke zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250210
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250210,
					"content": "Ooch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250211,
					"content": "Macht euch keine Sorgen um mich. Selbst wenn es mir möglich wäre, einzutreten, würde ich dieses Mal nicht mit euch gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250212
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250212,
					"content": "Anders als unserem Häuptling fehlt mir der Mut, unsere Traditionen infrage zu stellen. Diese Aufgabe wird vom Iktomisaurier-Ältesten speziell jemandem zugeteilt. Wer weiß, welches Unheil geschehen könnte, wenn ich mich einmische?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250213
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250213,
					"content": "Schon gut. Wir werden versuchen, nicht allzu lang zu brauchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
