			"dialogs": [
				{
					"id": 150251001,
					"content": "Schaut euch diese Aussicht an. Was sagt ihr dazu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251002
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150251002,
					"content": "Wunderschön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251003,
					"content": "Jetzt schaut mal ein Stück weiter in die Ferne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251004
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150251004,
					"content": "Waah ... Dieses Graffiti ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251005,
					"content": "In all den Jahren seit den Tagen der Gründung unseres Stammes haben uns diese Farben auf unseren Wegen begleitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251006
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150251006,
					"content": "Es stimmt, dass ich diesem alten Stamm durch Veränderungen und Reformen neues Leben einhauchen will. Aber ich weiß auch, dass es fundamentale Elemente gibt, die wir keinesfalls über Bord werfen dürfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251007
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150251007,
					"content": "Das Wichtigste darunter ist die Methode, wie wir unsere Geschichte aufzeichnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251008
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150251008,
					"content": "Das macht Sinn ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251009,
					"content": "Seit jeher hat unser Stamm danach gestrebt, der Geschichte Farbe zu verleihen, und ich bin fest davon überzeugt, dass dieser Teil unseres Erbes unverzichtbar ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251010
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150251010,
					"content": "Also muss ich, koste es, was es wolle, einen Weg finden, damit wir die Herstellung unserer traditionellen Geweberollen fortsetzen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251011
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150251011,
					"content": "Du hast absolut recht. Paimon entschuldigt sich für die Worte von vorhin. Das war daneben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251012,
					"content": "Schon gut. Ich bin einfach nur dankbar, dass ihr meine Sichtweise nachvollziehen könnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251013
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150251013,
					"content": "Wir sind fest entschlossen, dir bei der Lösung zu helfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251014
					]
				},
				{
					"id": 150251014,
					"content": "Dann hoffen wir, dass wir bei unserem nächsten Treffen Erfolg haben, diese Tradition wieder aufleben zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				}
			]
