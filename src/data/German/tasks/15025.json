				]
			},
			"dialogs": [
				{
					"id": 150250801,
					"content": "Wir sind wieder da! Und wir haben die Zutaten für den Farbstoff gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250802,
					"content": "Sieht so aus, als hättet ihr das Siegel überwunden! Unser Iktomisaurier-Ältester hat sich nicht in euch getäuscht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250803
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250803,
					"content": "Es wird spät. Folgt mir, ich bringe euch zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toltec"
				}
			]
		},
