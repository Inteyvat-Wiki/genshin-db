			"dialogs": [
				{
					"id": 150250401,
					"content": "Das sollte der richtige Ort sein! Die Frucht, von der Toltec redete, müsste da an der Wand sein, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250402,
					"content": "Paimon hat sie letztes Mal nicht bemerkt, als wir hier waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250403,
					"content": "Jetzt bleibt nur die Frage, welche wir pflücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250404,
					"content": "Hier kommt wahrscheinlich meine spezielle Fähigkeit ins Spiel, die der Häuptling erwähnt hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250405
					]
				},
				{
					"id": 150250405,
					"content": "Na los, probier’s aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
