			"dialogs": [
				{
					"id": 150251801,
					"content": "Die Vorfahren dieser Leute haben hier wahre Kunstwerke hinterlassen. Doch nach dem, was wir bisher gesehen haben, scheint noch mehr an der Sache dran zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251802,
					"content": "Glaubst du, dass es weiter drinnen noch mehr Kunstwerke gibt? Das ist irgendwie seltsam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251803,
						150251805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251803,
					"content": "Wir können reingehen und nachsehen, wenn du willst.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251804
					]
				},
				{
					"id": 150251804,
					"content": "Oh, nicht nötig ... Paimon hat nur laut gedacht. Toltec erwartet uns und wir haben noch eine Aufgabe zu erledigen. Vielleicht sollten wir uns besser auf den Weg machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251807,
					"content": "Gehen wir zurück, um Toltec zu treffen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251805,
					"content": "Vielleicht ... aber wir haben eine Aufgabe zu erledigen. Darauf sollten wir uns jetzt konzentrieren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251806
					]
				},
				{
					"id": 150251806,
					"content": "Stimmt, du hast recht. Es gibt immer ein nächstes Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251807
					],
					"speakerTitle": "Paimon"
