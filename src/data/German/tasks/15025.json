						],
						"pointId": 3
					},
					{
						"sceneId": 1200,
						"position": [
							408.885,
							104.539,
							378.134
						],
						"pointId": 5
					}
				]
			},
			"dialogs": [
				{
					"id": 150250701,
					"content": "Sieh dir das an ... Eine Geweberolle, gefertigt von einem unserer Ahnen. So etwas in der Art wollen wir herstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250702
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150250702,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250703,
					"content": "Abgebildet ist hier die legendäre Schamanin Huitzilin. Sie lebte vor zweihundert Jahren und wurde wie ihr einst vom Iktomisaurier-Ältesten ernannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250704
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150250704,
					"content": "Sie war äußerst begabt in der Kunst der Farbmanipulation und hat ihre Aufgabe natürlich mit Bravour gemeistert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250705
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150250705,
					"content": "Diese Geweberolle enthält eine Aufzeichnung ihrer Taten und stammt höchstwahrscheinlich aus ihrer eigenen Hand. Die Qualität ist schier atemberaubend, sogar im Vergleich zu anderen Rollen dieser Art.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250706
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150250706,
					"content": "Bedauerlicherweise mussten alle, die nach ihrem Tod vom Iktomisaurier-Ältesten bestimmt wurden, auf das „Geschenk der Geister“ zurückgreifen, um ihre Arbeit zu vollenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250707
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150250707,
					"content": "Aber jetzt stehst du kurz davor, eine alte Tradition zu neuem Leben zu erwecken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250708
					]
				},
				{
					"id": 150250708,
					"content": "Treffend formuliert. Meine einzige Anmerkung wäre: Es betrifft nicht nur mich, sondern „uns“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250709
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150250709,
					"content": "Oooh! Jetzt ist Paimon gespannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250710,
					"content": "Holt die Proben heraus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250711
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150250711,
					"content": "Ein Assistent bringt die Proben für den Färbetest.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150250712
					]
				},
				{
					"id": 150250712,
					"content": "Wie ich schon sagte, ist der Färbeprozess etwas kompliziert, aber ich bin sicher, ihr kriegt das hin. Befolgt einfach genau meine Anweisungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250713
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150250713,
					"content": "Machen wir. Lasst uns beginnen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250714
					]
				},
				{
					"id": 150250714,
					"content": "Das Muster ist schon auf dem Probestück skizziert, ihr müsst also nur jeden Block mit der richtigen Farbe einfärben. Zwischen den Schritten müsst ihr warten, bis die Farbe vollständig eingezogen ist, damit sie nicht verläuft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250715
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150250715,
					"content": "(Den Stoff nach Anweisung färben.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250716
					]
				},
				{
					"id": 150250716,
					"content": "Gut. Die Farbe ist eingezogen und das Muster ist klar und deutlich. Jetzt die restliche Farbe auftragen, dann sollte die besondere Farbe zum Vorschein kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250717
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150250717,
					"content": "Gut, der letzte Schritt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250718,
					"content": "(Die restliche Farbe auftragen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250719
					]
				},
				{
					"id": 150250719,
					"content": "Äh ... Hat es geklappt? Paimon sieht nichts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250720,
					"content": "Die Farbe erscheint nicht ... Das Färben ist misslungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250721
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150250721,
					"content": "Hab ich irgendwas falsch gemacht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250722
					]
				},
				{
					"id": 150250722,
					"content": "Nein, deine Technik war tadellos. Du hast alles genau nach Anleitung ausgeführt. Es hätte keinen Unterschied gemacht, wenn ich es selbst getan hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250723
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150250723,
					"content": "Was ist dann schiefgegangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250724,
					"content": "Vielleicht liegt es an der Webtechnik oder die Farbe muss anders aufgetragen werden ... Wie dem auch sei, es sieht so aus, als hätte ich das Geheimnis nicht gelöst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250725
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150250725,
					"content": "Wie schade ... Paimon wünschte, wir könnten mehr helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250726,
					"content": "Ich bin derjenige, der sich entschuldigen muss. Ich habe euch so viel Mühe gemacht und jetzt war alles vergebens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250727
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150250727,
					"content": "Selbstverständlich werde ich meiner Verpflichtung nachkommen und euch für eure Mühen entlohnen. Doch ich hoffe, dass ihr diese Aufgabe nicht aufgebt. Ich werde weiterforschen und euch auf dem Laufenden halten, wenn es Fortschritte gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250728
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150250728,
					"content": "Keine Sorge, wir geben nicht so leicht auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250729,
					"content": "Paimon hat aber eine Frage ... Ähm, dieser ganze Prozess, Geschichte auf Geweberollen festzuhalten, ist ganz schön kompliziert. Warum schreibt ihr es denn nicht einfach normal auf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250730,
					"content": "Du hast doch selbst gesagt, dass du auf Wandel und Reformen setzt. Wäre das hier nicht ein guter Anfang? Dinge aufzuschreiben wäre für alle leichter und Aufzeichnungen sind sowieso viel genauer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250731,
					"content": "... Ich fürchte, du hast meine Philosophie falsch verstanden, aber das ist nicht schlimm. Ich kann deine Frage beantworten, doch zunächst gibt es einen Ort, den ich dir zeigen möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250732
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Häuptling der Meister des Nachtwinds"
				},
				{
					"id": 150250732,
					"content": "Oh ... klar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
