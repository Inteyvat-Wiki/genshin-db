			"dialogs": [
				{
					"id": 150251201,
					"content": "Erinnerst du dich, als wir das letzte Mal hier waren? Wir haben all die Kunstwerke in der Höhle entdeckt. Die Vorfahren dieser Leute haben ein wahres Meisterwerk geschaffen!",
					"roleType": "TALK_ROLE_NPC",
