			"dialogs": [
				{
					"id": 711190101,
					"content": "„... Biete die Jade am Morgen dar, und glorreiche Hallen am Abend; die befriedeten Geister steigen herab, in ewigem Glück und Segen ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711190102
					],
					"speakerTitle": "Inschrift auf dem Weihrauchbrenner"
				},
				{
					"id": 711190102,
					"content": "„... Der Duft von Orchideen und Blumen, der Kessel aus Jade und der Kelch aus Gold; der Blumenduft weht nach <color=#00E1FFFF>Osten</color>, der Weihrauch weht nach <color=#00E1FFFF>Westen</color> ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711190103
					],
					"speakerTitle": "Inschrift auf dem Weihrauchbrenner"
				},
				{
					"id": 711190103,
					"content": "„... <color=#00E1FFFF>Errichte einen Altar</color> für Opfer, schenke süßen Wein ein als Trankopfer; strahlend durch die Jahrtausende, alle Richtungen erleuchtend ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inschrift auf dem Weihrauchbrenner"
				}
			]
