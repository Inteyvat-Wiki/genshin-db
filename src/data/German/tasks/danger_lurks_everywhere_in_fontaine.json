					"nextDialogs": [
						748000519
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000519,
					"content": "Wenn wir dann am nächsten Tag rausgehen und aus unseren Wasserflaschen trinken, werden die beiden Substanzen miteinander reagieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000520
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000520,
					"content": "Dann werden wir ...",
