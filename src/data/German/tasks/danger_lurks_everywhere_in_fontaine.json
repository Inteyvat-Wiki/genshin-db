				{
					"id": 748000801,
					"content": "... Ähm, warum kauerst du die ganze Zeit auf dem Boden und versteckst deinen Kopf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000802,
					"content": "Hast du etwa Angst, dass du etwas auf den Kopf kriegst? Aber hier gibt es ja nicht einmal ein Dach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000803,
					"content": "Psst, legt euch schnell mit mir hin! Es ist gefährlich hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000804
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000804,
					"content": "Jetzt fängt sie schon wieder an ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000805,
					"content": "Genau! An Deck dieses Aquabusses gibt es keine Aufbauten. Wenn zu beiden Seiten eine Stange aufgestellt und dazwischen eine Angelschnur gespannt wird ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000806
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000806,
					"content": "Der Aquabus braucht nur zwischen den Stangen hindurchzufahren und die Angelschnur schneidet sofort durch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000807
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000807,
					"content": "Waah! Hör auf damit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000808,
					"content": "Oh, nein, es müssen nicht einmal zwei Stangen sein, es reicht schon eine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000809
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000809,
					"content": "Es braucht nur eine Angelschnur mit einem Haken, der dort hängt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000810
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000810,
					"content": "Die Menschen an Bord werden einfach an den Haken genommen und dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000811
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000811,
					"content": "Paimon hört nicht zu, la la la ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000812,
					"content": "Die ganze Zeit ihr Gerede zu hören, da hat sogar Paimon es ein bisschen mit der Angst bekommen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000813,
					"content": "Lasst uns schnell von Bord gehen, sobald wir die Station erreicht haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
