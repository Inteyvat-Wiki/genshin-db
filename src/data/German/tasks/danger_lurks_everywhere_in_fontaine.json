			"dialogs": [
				{
					"id": 748000501,
					"content": "Ja, stimmt ... Wenn das so ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000502,
						748000503
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000502,
					"content": "Dein Kaffee wird kalt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000503,
					"content": "Ich habe schon ausgetrunken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000504,
					"content": "#Na gut, danke, {NICKNAME}. Danke, dass du mir Begleitschutz gegeben hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000505
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000505,
					"content": "Begleitschutz ... Eigentlich sind wir nur eine Weile mit dir spazieren gegangen und haben nichts Besonderes getan ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000506,
						748000507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000506,
					"content": "Es ist nichts Schlimmes passiert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000507,
					"content": "Du warst überhaupt nicht in Gefahr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000508,
					"content": "Stimmt. Ich habe mir wohl wirklich zu viele Gedanken gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000509
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000509,
					"content": "Der Kaffee ist echt nicht schlecht, haha ... Ha ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000510,
					"content": "... Sag, könnte da nicht jemand Gift reingetan haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000511,
						748000512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000511,
					"content": "*räusper* ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000512,
					"content": "Sei still, wenn du sonst nichts zu sagen hast.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000513,
					"content": "Quatsch, wir haben alle ausgetrunken, und es ist nichts passiert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000514,
					"content": "Nein, oh nein, vielleicht ist es ja ... ein spezielles Gift.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000515
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000515,
					"content": "Zuerst hat uns der Giftmischer die erste Substanz in den Kaffee getan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000516
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000516,
					"content": "Diese Substanz allein hat keine Auswirkungen auf den Konsumenten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000517
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000517,
					"content": "Wenn wir alle die Substanz eingenommen haben und nach Hause gehen, folgt uns der Giftmischer heimlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000518
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000518,
					"content": "Und wenn alle eingeschlafen sind, schleicht er sich ins Haus und gibt die zweite Substanz in unsere Wasserflaschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000519
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000519,
					"content": "Wenn wir dann am nächsten Tag rausgehen und aus unseren Wasserflaschen trinken, werden die beiden Substanzen miteinander reagieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000520
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000520,
					"content": "Dann werden wir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000521
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000599,
					"content": "Das Geräusch eiliger Schritt nähert sich plötzlich an ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 748000521,
					"content": "He, du da, was redest du denn da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000522
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000522,
					"content": "Kaffee? Vergiftet? Hör bitte auf, in meinem Laden solchen Unsinn zu reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000523
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000523,
					"content": "Wenn du damit meine anderen Gäste erschreckst, schmeiß ich dich raus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000524,
						748000525
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000524,
					"content": "Arouet, lass mich erklären ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000525,
					"content": "Sie ist meine Freundin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000526,
					"content": "Arouet ging sprachlos in den Laden zurück, nachdem er von Guijarros Situation erfahren hatte ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000527
					]
				},
				{
					"id": 748000527,
					"content": "Um sich zu entschuldigen, bestellt Guijarro noch drei Tassen Kaffee ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000528
					]
				},
				{
					"id": 748000528,
					"content": "Dieses Mal kannst du zuschauen, wie der Inhaber den Kaffee macht, damit auch ja alles in Ordnung ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000529,
					"content": "Hör auf, dir etwas einzubilden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000530
					]
				},
				{
					"id": 748000530,
