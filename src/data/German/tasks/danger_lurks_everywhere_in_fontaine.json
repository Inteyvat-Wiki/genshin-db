			"dialogs": [
				{
					"id": 748000401,
					"content": "Wieso versteckst du dich schon wieder, gibt es hier etwas Bedrohliches?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000402,
					"content": "Hast du diesen Garde-Mecha nicht gesehen? Gleich vor uns!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000403,
						748000404
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000403,
					"content": "Was ... ist mit damit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				},
				{
					"id": 748000405,
					"content": "Psst, schnell da rüber. Was ist, wenn der Garde-Mecha die Kontrolle verliert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000406
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000406,
					"content": "Oder was ist ... wenn sein Energiekern plötzlich explodiert, oder er uns von jemandem ferngesteuert angreift!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000407
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000407,
					"content": "Aber er ist doch ganz normal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000408
					]
				},
				{
					"id": 748000408,
					"content": "Genau das macht mir ja Angst. Ein ganz normaler Garde-Mecha verliert plötzlich die Kontrolle und irgendein Pechvogel verliert sein Leben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000409
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000409,
					"content": "Niemand wäre dafür verantwortlich und der schuldige Strippenzieher wäre wahrscheinlich nirgends zu finden ... Das ist viel zu gefährlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000410
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000410,
					"content": "Er ist schon wieder weg, du kannst rauskommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000411,
					"content": "Puh, er ist wirklich nicht außer Kontrolle geraten, das ist eine Überraschung. Und wieder wurde ein Leben gerettet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000412,
						748000413
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000412,
					"content": "Es ist wirklich unmöglich, dass so etwas passiert.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000414,
					"content": "Das ist es, was mir vorschwebte, ein „absichtlicher Unfall“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000415
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000415,
					"content": "Warte mal. Ein Verbrechen, für das es keinen Strippenzieher gibt, für das niemand persönlich verantwortlich gemacht werden kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000416
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000416,
					"content": "Genau! Ich habe eine Eingebung! Schnell ins Café! Ich muss das sofort aufschreiben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000417
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000417,
					"content": "He! Renn nicht so schnell, hast du keine Angst, dass dir jemand plötzlich einen Stein in den Weg legen könnte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000413,
					"content": "Er wäre niemals außer Kontrolle geraten, verstehst du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000404,
					"content": "Hä ... Und?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				}
			]
		},
