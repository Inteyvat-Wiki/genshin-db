						748000513
					]
				},
				{
					"id": 748000512,
					"content": "Sei still, wenn du sonst nichts zu sagen hast.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000513,
					"content": "Quatsch, wir haben alle ausgetrunken, und es ist nichts passiert!",
