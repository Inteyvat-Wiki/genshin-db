					"nextDialogs": [
						748000521
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000699,
					"content": "Das Geräusch eiliger Schritt nähert sich plötzlich an ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 748000521,
					"content": "He, du da, was redest du denn da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000522
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000522,
					"content": "Kaffee? Vergiftet? Hör bitte auf, in meinem Laden solchen Unsinn zu reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000523
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000523,
					"content": "Wenn du damit meine anderen Gäste erschreckst, schmeiß ich dich raus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000524,
						748000525
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000624,
					"content": "Guijarro entschuldigt sich hastig bei Arouet und erklärt, warum sie das gesagt hat ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000625
					]
				},
				{
					"id": 748000527,
					"content": "Um sich zu entschuldigen, bestellt Guijarro noch drei Tassen Kaffee ...",
