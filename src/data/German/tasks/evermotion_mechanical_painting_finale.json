			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705150101,
					"content": "Ah, bravo! Alle sechs Teile des mechanischen Perpetuum-Mobile-Puzzles sind jetzt wieder da! Jetzt müssen wir sie nur noch wieder zusammenfügen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150102,
					"content": "Alle ... von ihnen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150103
					]
				},
				{
					"id": 705150103,
					"content": "Ja, natürlich! All diese sechs kleineren Teile können wieder zu einem einzigen zusammengefügt werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150104
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150104,
					"content": "Zusammen bilden sie ein gigantisches und wunderschönes mechanisches Perpetuum-Mobile-Puzzle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150105,
					"content": "Komm, komm, jetzt müssen wir sie nur noch vereinen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150106,
						705150107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150106,
					"content": "Brauchst du etwas Brennen und Schmelzen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150108
					]
				},
				{
					"id": 705150108,
					"content": "Nein, nein, auf keinen Fall. Meine Maschine ist nicht eine von diesen zusammengestückelten Metallschrott-Dingern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150109,
					"content": "Jede der Komponenten, klar und geschickt zusammengesetzt, ist wie ... äh... wie ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150110
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150110,
					"content": "Ah macht nichts, Metaphern waren noch nie meine Stärke. Xavier hat mir meine ganze Inspiration genommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150111
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150111,
					"content": "Egal, komm und probier es aus. Vertrau mir, es wird Spaß machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150107,
					"content": "Brauchst du etwas zusätzliches Handwerk?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150108
					]
				}
			]
		},
		{
			"id": 7051502,
			"completionStepIds": [
				7051503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7051503",
							"2"
						],
						"stepId": 7051503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Félix Yogue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705150201,
					"content": "Perfekt! Das ist wunderschön! Du bist sowohl im Kopf als auch in der Hand geschickt, und zwar mehr, als ich erwartet hätte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150202
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150202,
					"content": "Ha, ich erinnere mich, in ein paar Artikeln des „Dampfvogels“ wurdest du beschrieben als ... als ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150203,
						705150204
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150203,
					"content": "Einer ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				},
				{
					"id": 705150205,
					"content": "#Ha ... haha ... als {M#ein Mann}{F#eine Frau} bezeichnet, {M#der}{F#die} die Leute gern mit {M#seinem}{F#ihrem} Schwert überzeugt ... Geradlinig und mutig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150206
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150206,
					"content": "Ach, wie lächerlich und töricht diese Journalisten waren! Wie viel Aufhebens sie um so wenig machten! Wer bist du denn, wenn nicht ein scharfsinniger, kluger, bescheidener ... und nun ja, freimütiger Recke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150207
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150207,
					"content": "Wenn ich Zeit habe, werde ich einen Brief schreiben, um sie zu widerlegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150208
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150208,
					"content": "Ach ja, nimm bitte diese Vorrichtung. Wann immer du dich langweilst, kannst du dir damit die Zeit vertreiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705150209
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150209,
					"content": "Was mich betrifft ... nun ... Ich werde anfangen müssen, Geld für meine Reise nach Liyue zusammenzukratzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705150204,
					"content": "Sprich nur weiter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705150205
					]
				}
			]
		},
