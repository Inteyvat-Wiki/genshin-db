			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970101,
					"content": "Hä? Die Statue der Sieben von Natlan sieht irgendwie echt komisch aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970102,
					"content": "Wenn man eine Statue zum ersten Mal berührt, sollte man doch eigentlich eine stärkere Reaktion spüren, oder? So ein „Brummen“ oder sowas ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970103,
						750970105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970103,
					"content": "Das scheint mir völlig normal zu sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970104
					]
				},
				{
					"id": 750970104,
					"content": "Aber es ist echt ein bisschen seltsam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970108,
					"content": "Hm, Paimon überlegt gerade, wie Paimon das sagen soll. Früher, als Paimon andere Statuen berührt hat, hatte Paimon das Gefühl, dass Paimon eine stärkere Verbindung aufbauen konnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970109,
					"content": "Dieses Mal fühlt es sich so an, als hätte Paimon einen Schalter gefunden, erst durch Berühren wird etwas aktiviert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970110,
					"content": "Übrigens, früher hast du die Kraft des Elements gespürt, wenn du die Statue berührt hast. Wie ist es diesmal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970111,
					"content": "Hast du dieses Mal den Pyro gespürt? Also, dieses lebendige und heiße Gefühl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970112,
						750970113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970112,
					"content": "(Spüre vorsichtig in deinen Körper hinein ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970114,
					"content": "Hm, gar nichts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970115,
					"content": "Es ist irgendwie seltsam, egal wie man es betrachtet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970113,
					"content": "(Kein erwartetes glühendes Hitzegefühl ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970105,
					"content": "#Eigentlich war es früher immer ich, {F#die}{M#der} dieses „Brummen“ gemacht hat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970106
					]
				},
				{
					"id": 750970106,
					"content": "Ach so, du hast diesmal das „Brummen“ vergessen? Nächstes Mal musst du das auf jeden Fall beachten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970107,
					"content": "Ach, Quatsch! Du solltest dir lieber jedes Mal ein „Brummen“ selbst machen, wenn du die Statue der Sieben anfasst! Sonst klappt das nie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7509702,
			"completionStepIds": [
				7509706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
