			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970301,
					"content": "Ah, jetzt fühlt es sich wieder richtig an ... die stabile Verbindung mit der Statue der Sieben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970302,
					"content": "Also lag die Unregelmäßigkeit der Statue der Sieben tatsächlich an dem Bösewicht im Königreich der Nacht! Die Statue hat es wohl nicht leicht gehabt ... Du hast tapfer durchgehalten, Statue der Sieben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970303,
					"content": "Auch wenn die Kraft zum Einklang der Pyro-Kraft nicht von dir stammt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970304,
					"content": "Ja, als ich gemeinsam mit dem Pyro-Archon gekämpft habe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970305
					]
				},
				{
					"id": 750970305,
					"content": "#Oh ja, da hatte Paimon große Sorgen ... aber {NICKNAME} ist doch immer noch stärker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970306,
					"content": "Die Monster aus dem Abgrund sind besiegt, und die Statue der Sieben ist wieder normal. Das ist einfach super!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
