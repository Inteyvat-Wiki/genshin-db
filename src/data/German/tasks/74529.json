			},
			"dialogs": [
				{
					"id": 745290401,
					"content": "#He, {NICKNAME}, da bist du ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290402,
						745290403
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290402,
					"content": "Citlali, lange nicht gesehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				},
				{
					"id": 745290404,
					"content": "Ach was, auch ich gehe ab und zu mal spazieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290405
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290405,
					"content": "Außerdem habe ich gestern Abend mein Horoskop gedeutet und vorhergesehen, dass mir heute etwas Gutes passieren wird, wenn ich nach draußen gehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290406
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290406,
					"content": "Und tatsächlich, kaum bin ich aus dem Haus gegangen, kommt schon das Glück zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290407,
						745290408
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290407,
					"content": "Dann lass uns das Glück verdoppeln!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290409,
					"content": "Das können wir schon machen ... Aber vor ein paar Tagen bin ich die ganze Nacht wach geblieben, um die neueste kurze Erzählung zu Ende zu lesen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290410
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290410,
					"content": "Schau doch bitte mal, wie ich jetzt aussehe! Meine Augenringe sind hoffentlich weg, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290411,
						745290412
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290411,
					"content": "Du siehst so munter aus wie eh und je.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290413,
					"content": "Wirklich? Mach mir ja nichts vor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290414
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290414,
					"content": "Lass uns eins klarstellen: Wenn die Fotos nicht gut werden, gehören sie mir ... Und wenn du welche behalten möchtest, dann nur das allerschönste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 745290412,
					"content": "Du strahlst ja richtig!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290408,
					"content": "Lass mich ein Foto von dir machen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290403,
					"content": "Dass du mal nicht zu Hause ausschläfst, ist echt selten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				}
			]
		}
	]
