			"dialogs": [
				{
					"id": 790580101,
					"content": "Diese verlassene Szene war ursprünglich für das Stück „Die Verzweifelten“ geplant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580102
					],
					"speakerTitle": "Notizen zur Szene"
				},
				{
					"id": 790580102,
					"content": "Ursprünglich sollte sich die Geschichte um einen in einer geheimnisvollen Höhle gefangenen Wassergeist drehen, der sich nur mit Hilfe eines in einem Buch versteckten Grabungswerkzeugs einen Weg ins Freie bahnen konnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580103
					],
					"speakerTitle": "Notizen zur Szene"
				},
				{
					"id": 790580103,
					"content": "Aber Idyia war gegen diese Idee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580104
					],
					"speakerTitle": "Notizen zur Szene"
				},
				{
					"id": 790580104,
					"content": "Aber sie hatte recht. Wassergeister würden keine Werkzeuge brauchen, um aus einer Höhle zu fliehen ... sie können sich einfach durchquetschen. Und die Idee mit dem Grabungswerkzeug in einem Buch war doch schon sehr merkwürdig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580105
					],
					"speakerTitle": "Notizen zur Szene"
				},
				{
					"id": 790580105,
					"content": "A... Aber es ist auf jeden Fall eine großartige Idee, die noch Anklang finden könnte. Nun, wenn ich einen Weg finde, Idyia diese Szene zu zeigen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580106
					],
					"speakerTitle": "Notizen zur Szene"
				},
				{
					"id": 790580106,
					"content": "*seufz* Aber es sieht so aus, als müsste ich zuallererst die <color=#00E1FFFF>Buchrequisite zurückholen, das von Hilichurlen aus der Nähe</color> geklaut wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580107
					],
					"speakerTitle": "Notizen zur Szene"
				},
				{
					"id": 790580107,
					"content": "... Der „Regisseur“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Notizen zur Szene"
				}
			]
		},
