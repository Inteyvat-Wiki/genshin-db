			"dialogs": [
				{
					"id": 223011701,
					"content": "Warum muss denn immer so viel zu tun sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011702
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011702,
					"content": "Hallo, hast du Liu Su beim Erzählen zugehört?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223011703
					]
				},
				{
					"id": 223011703,
					"content": "Liu Su? Beim Erzählen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011704
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011704,
					"content": "Oh, ich weiß. Als ich das letzte Mal hier war, habe ich ein paar Minuten lang zugehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011705
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011705,
					"content": "Ich weiß aber nicht mehr genau, worum es ging. Das Buch hieß wohl <color=#00E1FFFF>„Schnitte im rauschenden Regen“</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011706
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011706,
					"content": "Der Guhua-Schule soll es wohl ziemlich schlecht gegangen sein. Dann ist ein starker Herausforderer aufgetaucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011707
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011707,
					"content": "Ich bin aber erst sehr spät hinzugestoßen. Da war ein großer Teil der Geschichte schon vorbei. Gegen Ende hin ging es wohl um ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011708
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011708,
					"content": "Ja, genau, der Protagonist war gerade dabei zu gewinnen, als plötzlich jemand aus dem Hinterhalt angriff und ihn überwältigte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011709
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011709,
					"content": "Dann wurde ich aber wieder zur Arbeit gerufen. Ich hätte schon gern gewusst, wie es weiterging.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangzhou"
				}
			]
		},
