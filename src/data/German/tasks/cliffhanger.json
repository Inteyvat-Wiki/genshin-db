			},
			"dialogs": [
				{
					"id": 223010401,
					"content": "Du bist ja noch hier, hahaha! Was hältst du von dem Buch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010402,
						223010405
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010402,
					"content": "Gibt es noch mehr?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010403
					]
				},
				{
					"id": 223010403,
					"content": "Du musst wissen, „Schnitte im rauschenden Regen“ und „Haishans Zorn“ sind zwei richtig dicke Wälzer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010404
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010404,
					"content": "Mit ein paar einfachen Schilderungen kann man den Inhalt dieser Bücher nicht abdecken. Wenn du mehr darüber erfahren willst, kannst du jederzeit zu einer der Sitzungen kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010407,
					"content": "Vielen Dank für deine Hilfe! Hier, nimm das. Komm bitte öfter mal vorbei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010405,
					"content": "Ich weiß nur noch, dass die Geschichte beim nächsten Mal weitergeht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010406
					]
				},
				{
					"id": 223010406,
					"content": "Hahaha! Dann musst du einfach öfter herkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "Teekenner Liu Su"
				}
			]
		},
