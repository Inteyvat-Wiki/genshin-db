						223011102
					],
					"speakerTitle": "Fan Erye"
				},
				{
					"id": 223011102,
					"content": "Hallo, hast du Liu Su beim Erzählen zugehört?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223011103
					]
				},
				{
					"id": 223011103,
					"content": "Liu Su? Das Buch, von dem er erzählt hat, klingt wirklich interessant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011104
					],
					"speakerTitle": "Fan Erye"
				},
				{
					"id": 223011104,
					"content": "Letztens habe ich ihm bei seinen Ausführungen über <color=#00E1FFFF>„Haishans Zorn“</color> zugehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011105
					],
					"speakerTitle": "Fan Erye"
				},
				{
					"id": 223011105,
					"content": "Gleich am Anfang ging es um stürmische Wellen und heftige Gewitter. Die Crux ist aber trotzdem weitergefahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011106
					],
					"speakerTitle": "Fan Erye"
				},
				{
					"id": 223011106,
					"content": "Am Bug des Flaggschiffs stand jemand mit einem Schwert in den Händen. Es war der Kapitän der Crux.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011107
					],
					"speakerTitle": "Fan Erye"
				},
				{
					"id": 223011107,
					"content": "Vorn erhoben sich schwarze Wellen wie ein Gebirge in der Nacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011108
					],
					"speakerTitle": "Fan Erye"
				},
				{
					"id": 223011108,
					"content": "Dann hat Liu Su nicht mehr weitererzählt und meinte nur, das nächste Mal gehe es weiter, hahaha! Das ist jetzt schon Tage her und es ging nicht weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fan Erye"
				}
