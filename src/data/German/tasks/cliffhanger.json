			},
			"dialogs": [
				{
					"id": 223010201,
					"content": "Oh, du bist ja schon zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010202
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010202,
					"content": "Je mehr ich erzähle, desto mehr vergesse ich auch. Ich krieg das einfach nicht mehr gebacken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010203
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010203,
					"content": "Hast du erfahren, an welcher Stelle ich war?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teekenner Liu Su"
				}
			]
		},
