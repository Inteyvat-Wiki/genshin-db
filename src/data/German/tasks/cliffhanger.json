				"objectNames": [
					"Teekenner Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223015101,
					"content": "Der Jüngling der Guhua-Schule schwang sein Schwert schneller als jeder Wind auf der Höhe des Berges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015102
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223015102,
					"content": "Dem verdutzten Kämpfer gegenüber schlug er das Schwert aus der Hand. Doch so leicht wollte er sich nicht geschlagen geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015103
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223015103,
					"content": "Während sich der Jüngling noch von seinem Schlag erholte, nutzte der Herausforderer den Moment, um ein Gerät in seiner Hand dazu zu bringen, grün zu leuchten. Mit einer Handbewegung schickte er drei eiskalte Strahlen auf den Jüngling zu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015104
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223015104,
					"content": "Warum der Herausforderer zu solchen Mitteln griff, wie es dem Jüngling ergangen war und was mit der Guhua-Schule passierte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teekenner Liu Su"
				}
			]
		},
		{
			"id": 2230152,
			"completionStepIds": [
				2230152
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230104",
							"2"
						],
						"stepId": 2230104,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"223010305",
							"22301"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teekenner Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223015201,
					"content": "Der junge Schwertkämpfer hatte erstaunliche Fähigkeiten. Sein Angriff wurde zwar abgewehrt, aber er hielt sein Schwert fest im Griff und trat einen Schritt nach hinten. Obwohl er Schwierigkeiten hatte, das Gleichgewicht zu halten, konnte er drei Schüsse mit seiner versteckten Waffe abfeuern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015202
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223015202,
					"content": "Als er aufatmen wollte, erhob sich sein Gegenüber, dessen Schert längst davongeschleudert worden war, zu voller Größe. Dieser griff an seine Hüfte und zog unerwarteterweise mit einer geschickten Bewegung seines Handgelenks ein bewegliches Schwert hervor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015203
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223015203,
					"content": "Mit einem bedrohlichen Grinsen entgegnete er dem Wanken des jungen Schwertkämpfers. Ohne auch nur zögern, griff er an und gewann die Oberhand, da der Schüler völlig unvorbereitet war und nicht wusste, was er diesem Übel entgegenstellen sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015204
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223015204,
					"content": "Die Schwerter klirrten jedes Mal, als ihre Klingen aufeinanderprallten, und der junge Schwertkämpfer ermüdete allmählich. Schritt um Schritt wich er nach hinten, als plötzlich ein Knall ertönte, da ihm sein Schwert aus der Hand fiel. Bevor er wusste, wie ihm geschah, traf ihn auch schon ein harter Schlag mitten auf der Brust.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015205
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223015205,
					"content": "Erneut wich der junge Schwertkämpfer zurück, während sein Schwert auf dem Boden klirrte. Ein gemeines Lachen seines Gegners, der nun sein Schwert hoch in die Luft hielt, war die Antwort darauf. Dessen Absicht war offensichtlich: Es sollte ein Kampf auf Leben und Tod werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015206
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223015206,
					"content": "Doch plötzlich blickte der junge Schwertkämpfer auf und fing an zu lachen. „Der war gut! Aber jetzt reicht es langsam.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teekenner Liu Su"
				}
			]
		},
