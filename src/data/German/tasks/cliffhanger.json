			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teekenner Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010101,
					"content": "Ähm, bis wohin habe ich gelesen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010102
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010102,
					"content": "Gelesen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010103
					]
				},
				{
					"id": 223010103,
					"content": "Hallo, möchtest du mir beim Erzählen zuhören oder lieber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010104
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010104,
					"content": "Ach, ich erzähle Geschichten aus Büchern und verdiene mir damit ein wenig Taschengeld.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010105
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010105,
					"content": "Ich habe nur so viele Bücher gelesen, dass ich manchmal ein paar Inhalte durcheinanderbringe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010106
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010106,
					"content": "Vor einigen Tagen wollten ein paar Gäste „Haishans Zorn“ über die Crux hören. Die anderen wollten aber „Schnitte im rauschenden Regen“ hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010107
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010107,
					"content": "Um bei beiden Gruppen zu verdienen, habe ich aus jedem Buch einige Passagen ausgesucht und davon erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010108
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010108,
					"content": "Ich konnte ja nicht ahnen, dass es den Zuhörern so gefallen würde, dass sie mehr hören wollten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010109
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010109,
					"content": "Die beiden Bücher benutze ich schon seit Jahren. Ich bin also nach Hause gegangen und habe im Schrank herumgewühlt, bis ich sie gefunden habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010110
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010110,
					"content": "Danach habe ich sie mir erneut durchgelesen, beim Erzählen aber vergessen, bis wohin ich gekommen war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010111
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010111,
					"content": "Könntest du die Leute draußen fragen, bis wohin ich erzählt habe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010112,
						223010114
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010112,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010113
					]
				},
				{
					"id": 223010113,
					"content": "Super! Wenn ich selbst gehen würde, wüssten die Leute sicher nicht, was sie von mir denken sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010118,
					"content": "Es gibt drei Leute, die du fragen könntest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010119
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010119,
					"content": "Der eine ist <color=#00E1FFFF>Fürst Maocai</color>, er war bei jeder Sitzung dabei. Der andere ist <color=#00E1FFFF>Fan Erye</color>, der Besitzer der Teestube.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010120
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010120,
					"content": "Dann kannst du aber auch noch <color=#00E1FFFF>Jiangzhou</color> fragen. Sie hat beim letzten Mal kurz mitgehört. Dann ist sie aber auch schon wieder gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010114,
					"content": "Erzähl doch wieder von vorn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010115
					]
				},
				{
					"id": 223010115,
					"content": "Das würde ich gern. Dann könnte ich noch etwas mehr verdienen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010116
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010116,
					"content": "Fan Erye würde mich aber sofort rausschmeißen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010117
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223010117,
					"content": "Also frag doch bitte die Gäste und sag mir, bis wohin ich gekommen war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "Teekenner Liu Su"
				}
			]
		},
