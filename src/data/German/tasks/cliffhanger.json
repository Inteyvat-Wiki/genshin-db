			"dialogs": [
				{
					"id": 223011401,
					"content": "Wie lange lässt dieser Liu Su noch auf sich warten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011402
					],
					"speakerTitle": "Fürst Maocai"
				},
				{
					"id": 223011402,
					"content": "Hallo, hast du Liu Su beim Erzählen zugehört?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223011403
					]
				},
				{
					"id": 223011403,
					"content": "Aber sicher doch. Leider bringt er mich zur Verzweiflung. Beim letzten Mal hat er im Teehaus Heyu von <color=#00E1FFFF>Schnitte im rauschenden Regen</color> erzählt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011404
					],
					"speakerTitle": "Fürst Maocai"
				},
				{
					"id": 223011404,
					"content": "Eben hat er noch von der Verarmung der Guhua-Schule erzählt, die von vielen Herausforderern auf Trab gehalten wurde, aber viele ihrer eigenen Schüler verlor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011405
					],
					"speakerTitle": "Fürst Maocai"
				},
				{
					"id": 223011405,
					"content": "Die verbliebenen Schüler beschützen ihr Schule mit allem, was sie hatten, konnten den Lauf der Dinge aber nicht mehr wenden. Sogar das Namensschild der Schule wurde zerschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011406
					],
					"speakerTitle": "Fürst Maocai"
				},
				{
					"id": 223011406,
					"content": "Als die wenigen Schüler sich gerade in Enttäuschung zurückziehen wollten, näherte sich ein Jüngling mit erstaunlichen Schwertkünsten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011407
					],
					"speakerTitle": "Fürst Maocai"
				},
				{
					"id": 223011407,
					"content": "Und dann hat er aufgehört zu erzählen! Das nächste Mal sollte es weitergehen, meinte er. Ich habe jetzt schon tagelang gewartet und nichts ist passiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011408
					],
					"speakerTitle": "Fürst Maocai"
				},
				{
					"id": 223011408,
					"content": "Wenn ich ihn das nächste Mal sehe, ist er mir einen Grund schuldig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fürst Maocai"
				}
			]
		},
