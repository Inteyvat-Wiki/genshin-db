					"Teekenner Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223015401,
					"content": "Die Wellen türmten sich jedoch auf und der Himmel verfinsterte sich. Die Matrosen der Crux waren allesamt gut ausgebildet und auch die Schiffe waren die besten ihrer Klasse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015402
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223015402,
					"content": "Doch bei dieser vom Himmel geschickten Katastrophe konnte kein Schiff, so gut es auch war, den Wellen widerstehen, die gegen die Wände der Schiffe schlugen und diese umkippen ließen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015403
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223015403,
					"content": "Aus der enormen, aufgewühlten Wasseroberfläche erhob sich ein riesiges Ungetüm mit glühenden Augen. Die letzten Matrosen baten den Herrscher über die Felsen um Hilfe und wagten es nicht, das Ungetüm anzublicken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015404
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223015404,
					"content": "Auf dem Schiff ganz vorn am Bug stand aber immer noch ein Mann aufrecht und stolz. Er blickte dem Wesen, so groß wie ein Berg, direkt in die Augen und sprach lachend, „Ha, nun habe ich dich endlich gefunden!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015405
					],
					"speakerTitle": "Teekenner Liu Su"
				},
				{
					"id": 223015405,
					"content": "Wer dieser Held war, woher das Ungetüm kam und was sie miteinander zu tun hatten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teekenner Liu Su"
				}
			]
		},
