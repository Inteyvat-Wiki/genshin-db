				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vahid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370101,
					"content": "Oh nein ... wie konnte das passieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370102
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370103
					]
				},
				{
					"id": 220370103,
					"content": "#{F#Reisende}{M#Reisender}, ich habe gerade nach dir gesucht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370104
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370104,
					"content": "Erinnerst du dich noch an Konda Densuke? Er kam vor einigen Tagen in den Laden und fragte nach den Düngemitteln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370105
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370105,
					"content": "Ist er mit den Düngemitteln zufrieden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370106
					]
				},
				{
					"id": 220370106,
					"content": "So würde ich es nicht ausdrücken. Streng genommen denke ich, dass Herr Konda Densuke sich verloren fühlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370107
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370107,
					"content": "Verloren?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370108
					]
				},
				{
					"id": 220370108,
					"content": "Nun, hier ist die Sache. Nach deiner vorherigen Beförderung hat Herr Densuke unseren Dünger nach deinen Anweisungen verwendet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370109
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370109,
					"content": "Doch obwohl die Ernte gut wuchs, kamen zur gleichen Zeit ... eine Menge Pilze aus dem Nichts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370110
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370110,
					"content": "Um ehrlich zu sein, nachdem Herr Konda mir davon erzählt hat, fühle ich mich auch ein bisschen verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370111
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370111,
					"content": "Aber wie auch immer, es hat definitiv etwas mit dem Dünger zu tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370112
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370112,
					"content": "#{F#Reisende}{M#Reisender}, könntest du bitte zum Dorf Konda gehen und Herrn Konda helfen, die Pilze von seinen Feldern zu entfernen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370113,
						220370116
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370113,
					"content": "Ich werde das übernehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370114
					]
				},
				{
					"id": 220370114,
					"content": "Das werde ich. Ich werde im Laden ein wenig recherchieren, was genau die Ursache dafür ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370115
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370115,
					"content": "*seufz* Wenn nur Alrani hier wäre. Sie hätte die Ursache bestimmt schon gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370116,
					"content": "Wie wäre es, wenn wir Alrani bitten, an diesem Thema zu arbeiten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370117
					]
				},
				{
					"id": 220370117,
					"content": "Wenn sie hier wäre, hätten wir es ziemlich schnell herausgefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370118
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370118,
					"content": "Aber sie ist noch nicht zurückgekehrt und ich habe keine Ahnung, wohin sie gegangen ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370119
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370119,
					"content": "#Ich kann mich nur auf dich verlassen, {F#Reisende}{M#Reisender}. Ich werde im Laden ein wenig recherchieren, was genau die Ursache dafür ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
		{
			"id": 2203702,
			"completionStepIds": [
				2203702
