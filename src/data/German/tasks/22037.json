			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370301,
					"content": "Hast du sie alle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370302
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370302,
					"content": "Alle Pilze sind hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370303
					]
				},
				{
					"id": 220370303,
					"content": "Ist das alles? Ich erinnere mich, dass da noch viel mehr war. Hast du sie wirklich alle ausgeräumt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370304
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370304,
					"content": "Wie auch immer, du hast meine Wertschätzung. Nimm dies als Bezahlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370305
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370305,
					"content": "Ich muss sagen, dass diese Dünger ganz erstaunlich sind. Die Pilze sind so schnell gewachsen. Wenn sie nur auch den Pflanzen helfen könnten, so schnell zu wachsen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370306
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370306,
					"content": "Wenn ich die Zeit habe, werde ich mir sicher noch ein paar kaufen und ausprobieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
