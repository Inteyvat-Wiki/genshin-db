						220370404
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370404,
					"content": "Alle Pilze sind hier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370405
					]
				},
				{
					"id": 220370405,
					"content": "Es waren so viele Pilze, aber es sieht so aus, als hättest du sie alle bekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370406
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370406,
					"content": "Danke. Ich wüsste wirklich nicht, was ich ohne deine Hilfe tun würde. Nimm dies als ein Zeichen meiner Dankbarkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370407
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370407,
					"content": "Ich muss sagen, dass diese Dünger ganz erstaunlich sind. Die Pilze sind so schnell gewachsen. Wenn sie nur auch den Pflanzen helfen könnten, so schnell zu wachsen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370408
					],
					"speakerTitle": "Konda Densuke"
				},
				{
