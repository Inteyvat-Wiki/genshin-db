					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370201,
					"content": "Was ist nur los mit diesen Pilzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370202,
						220370203
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370202,
					"content": "Ich bin hier, um die Pilze zu beseitigen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370205
					]
				},
				{
					"id": 220370205,
					"content": "Wurdest du von Vahid geschickt, um mir zu helfen, sie wegzuräumen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370206
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370206,
					"content": "Hmm, dann gehören sie alle dir. Es sind viel zu viele Pilze auf dem Feld. Das ist keine Aufgabe für einen Alten wie mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370207
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370207,
					"content": "Wie konnten diese Pilze nur so schnell wachsen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370203,
					"content": "Entschuldigung für den Ärger!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370204
					]
				},
				{
					"id": 220370204,
					"content": "Oh, die Pilze? Nun, auf meinem Esstisch gibt es keinen Mangel an ihnen, das ist sicher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370205
					],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
		{
			"id": 2203703,
			"completionStepIds": [
				2203703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
