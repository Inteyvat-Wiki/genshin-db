			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Untersuchen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3926.022,
							443.657,
							4548.217
						],
						"pointId": 340100651
					}
				]
			},
			"dialogs": [
				{
					"id": 191851101,
					"content": "Das Material, aus dem diese Säcke gemacht sind ... Es ist ziemlich selten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851102
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851102,
					"content": "[Wissen] (Lyney dabei helfen, das Material zu begutachten ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851103
					]
				},
				{
					"id": 191851103,
					"content": "Sieht das nicht aus, wie das Material, aus dem deine Zaubertaschen sind?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851104
					]
				},
				{
					"id": 191851104,
					"content": "... Es ist tatsächlich dieselbe Faser aus Romaritime-Blumen. Aber die Beschaffenheit dieser Säcke ist etwas speziell. Bei genauerer Betrachtung scheinen sie nicht nur wasserfest, sondern auch rostfrei und auslaufsicher zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851105
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851105,
					"content": "Selbst die Schnüre sind speziell so entworfen, dass die Säcke richtig dicht verschlossen bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851106
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851106,
					"content": "Gerade bin ich auf ein paar Säcke aus demselben Material gestoßen, aber die waren viel kleiner und dünner. Vom Aussehen her schienen sie auch viel weniger robust zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851107
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851107,
					"content": "Also ... ein bisschen wie die kleinen versiegelten Beutel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851108
					]
				},
				{
					"id": 191851108,
					"content": "... Tatsächlich sehr ähnlich. Normalerweise wäre es für einen Wach-Pudel ein Kinderspiel, gefälschtes Sinth aufzuspüren, aber wenn es in einem solchen Beutel versiegelt wäre, könnte es eine Weile unentdeckt bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851109
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851109,
					"content": "Aber wofür könnten diese großen Säcke dann sein? Um gefälschtes Sinth verborgen und versiegelt zu halten, scheinen diese Säcke doch ein bisschen zu auffällig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyney"
				}
			]
		},
		{
