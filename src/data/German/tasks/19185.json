			"dialogs": [
				{
					"id": 191854701,
					"content": "Warum würde er uns eine solche offensichtliche Fährte hinterlassen, wenn er doch peinlich genau darauf geachtet hat, dass von dem gefälschten Sinth keine Spur in seiner Wohnung zu finden ist?",
					"roleType": "TALK_ROLE_NPC",
