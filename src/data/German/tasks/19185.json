				"points": []
			},
			"dialogs": [
				{
					"id": 191855101,
					"content": "Ja, Bernard zufolge stammten alle Waren von Pierre ... Aber wenn die Daten des Maréchaussée-Phantoms korrekt sind, sollte Pierre längst keinen Zugang mehr zu den für gefälschtes Sinth erforderlichen Materialien gehabt haben, und vom Institut wurde auch kein Diebstahl ihrer Vorräte verzeichnet.",
					"roleType": "TALK_ROLE_NPC",
