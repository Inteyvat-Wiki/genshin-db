					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191854104,
					"content": "Wir haben so rasch ermittelt, dass vielleicht das ein oder andere übersehen wurde. Lass mich den Deduktionsmodus aktivieren und alles noch einmal von vorn durchdenken. Vielleicht finden wir etwas Neues.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191854105
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191854105,
					"content": "... Sind da noch Ungereimtheiten oder Merkwürdiges, das wir bedenken sollten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
