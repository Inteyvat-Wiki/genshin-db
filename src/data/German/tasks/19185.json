							4545.01
						],
						"pointId": 340100652
					}
				]
			},
			"dialogs": [
				{
					"id": 191851001,
					"content": "... Als das Maréchaussée-Phantom Pierres Haus durchsuchte, war keine Spur von diesen Fässern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851002
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191851002,
					"content": "Er muss sie transportiert haben. Aber sie den ganzen Weg hier rauszutragen, hätte zu viel Aufmerksamkeit erregt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851003
					]
				},
				{
					"id": 191851003,
					"content": "Du hast recht. Das erinnert nicht an seinen Handlungsmodus ... Wie hat er sie dann hierher bekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851004
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191851004,
					"content": "(Die Fässer genau untersuchen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851005
					]
				},
				{
					"id": 191851005,
					"content": "(Die Fässer zeigen Spuren von Wasserschäden. Rings um die Fässer kann man getrocknete Wasserflecken erkennen ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851006
					],
					"speakerTitle": "Untersuchen"
				},
				{
					"id": 191851006,
					"content": "(Es scheint ein Muster bei der Anordnung der Wasserflecken zu geben. Aus irgendeinem Grund beschränken sie sich auf die untere Hälfte der Fässer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851007
					],
					"speakerTitle": "Untersuchen"
				},
				{
					"id": 191851007,
					"content": "(Die Deckel sitzen anscheinend nicht sehr fest, wodurch sich beträchtliche Lücken am Rand bilden. Allerdings gibt es offenbar keine Wasserspuren im Inneren der Fässer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851008
					],
					"speakerTitle": "Untersuchen"
				},
				{
					"id": 191851008,
					"content": "Nur die unteren Hälften der Fässer scheinen im Wasser gelegen zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		},
		{
			"id": 1918511,
			"completionStepIds": [
				1918511
			],
			"beginWay": "TALK_BEGIN_MANUAL",
