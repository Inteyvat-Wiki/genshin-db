						],
						"pointId": 340100650
					}
				]
			},
			"dialogs": [
				{
					"id": 191851201,
					"content": "Aha, genau wie wir dachten ... Hier wurde das gefälschte Sinth hergestellt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851202
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851202,
					"content": "[Pharmazie] (Chevreuse helfen, die Drogen zu identifizieren ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851203
					]
				},
				{
					"id": 191851203,
					"content": "Diese Flaschen und Krüge ... Ist das alles gefälschtes Sinth?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851204
					]
				},
				{
					"id": 191851204,
					"content": "... Sieht so aus, als hätte er hier mehr als nur gefälschtes Sinth gebunkert ... Neben den Rohstoffen für die Synthese der Substanz selbst, gibt es große Mengen an Reinigungsmitteln und ein paar Medikamente, die ich noch nicht identifizieren konnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851205
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851205,
					"content": "Die Reinigungsmittel wurden wahrscheinlich verwendet, um Spuren der Substanz zu beseitigen ... wie deren Geruch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851206
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851206,
					"content": "Die Sonderpatrouille hat einiges über gefälschtes Sinth in Erfahrung gebracht. Unsere Aufzeichnungen deuten darauf hin, dass es für normale Leute schwierig ist, die Spuren von dem Zeug zu entdecken. Das war sicherlich auch bei Pierre der Fall.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851207
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851207,
					"content": "Es muss einiges an Zeit und Können erfordert haben, um all diese Spuren sicher wegzuwaschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851208
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851208,
					"content": "Aber wofür sind diese anderen Medikamente ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		},
