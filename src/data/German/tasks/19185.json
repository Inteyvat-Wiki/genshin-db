				"objectNames": [
					"Lynette"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191854901,
					"content": "Wenn Bonnie gefälschtes Sinth in sich hatte, dann war sie eine tickende Zeitbombe, die um jeden Preis entschärft werden musste. Wenn aber nichts bei ihr war, dann wäre es eine Botschaft gewesen, um Bernard zu beruhigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191854902
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191854902,
					"content": "Genau betrachtet, hat Bernard unsere Aufmerksamkeit eigentlich nur auf sich gezogen, weil er auf der Suche nach Bonnie war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191854903
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191854903,
					"content": "Könnte es sein, dass der Autor des Briefes auch im Dunkeln tappte bezüglich Bonnies Situation ... oder verfolgte eine komplett andere Agenda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		},
