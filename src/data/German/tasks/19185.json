					"nextDialogs": [
						191854802
					]
				},
				{
					"id": 191854802,
					"content": "Bernard gibt an, er hätte gestern Nacht einen Brief von Pierre bekommen. Darin stand, dass er untergetaucht sei. Ist da etwas faul an dem Brief ...?",
					"roleType": "TALK_ROLE_NPC",
