				{
					"id": 4670303,
					"content": "Also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670304
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670304,
					"content": "*knabber*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670305
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670305,
					"content": "Hmm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670306
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670306,
					"content": "*schluck*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670307,
					"content": "Hmm ... schwer zu beschreiben. Nicht gerade ein Genuss, aber es geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670308
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670308,
					"content": "#Was? {NICKNAME} kann das bestimmt besser. Das gilt nicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670309,
					"content": "Ja, mit etwas Übung kannst du dein Talent entfalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670310
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670310,
					"content": "Ich habe noch einige Zutaten in meiner Tasche, die ich dir geben kann. Sieh sie als Geschenk für die Spieß an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670311
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670311,
					"content": "Das geht doch nicht. Womit sollst du denn dann kochen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670312,
					"content": "Ach, das ist schon in Ordnung. Wenn man <color=#00E1FFFF>draußen im Freien</color> die Augen offen hält, findet man viele Zutaten für alle möglichen Gerichte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670313
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670313,
					"content": "Beim <color=#00E1FFFF>„Hirschjäger“</color> findest du auch viele Zutaten und Gerichte. Bei Gelegenheit kannst du ja mal vorbeischauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670314
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670314,
					"content": "Hehe, vielen Dank für deine ... He! Lass mir etwas von dem Spieß mit Pilzen und Hühnchen übrig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
