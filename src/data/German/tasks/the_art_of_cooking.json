			},
			"dialogs": [
				{
					"id": 4671201,
					"content": "Bist du schon fertig? Mmh, das riecht aber köstlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671202
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671202,
					"content": "Dann probiere ich mal ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671203
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671203,
					"content": "Also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671204
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671204,
					"content": "*knabber*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671205
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671205,
					"content": "Tja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671206
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671206,
					"content": "*schluck*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4671207,
					"content": "Ooh! Das übertrifft meine Erwartungen bei Weitem! Du hast wirklich Talent!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671208
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671208,
					"content": "Ihihi, Paimon hatte also recht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4671209,
					"content": "Mit deinem Talent kannst du sicher etwas Schwierigeres ausprobieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671210
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671210,
					"content": "Ich habe noch einige Zutaten in meiner Tasche, die ich dir geben kann. Sieh sie als Geschenk für die Spieß an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671211
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671211,
					"content": "Das geht doch nicht. Womit sollst du denn dann kochen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4671212,
					"content": "Ach, das ist schon in Ordnung. Wenn man <color=#00E1FFFF>draußen im Freien</color> die Augen offen hält, findet man viele Zutaten für alle möglichen Gerichte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671213
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671213,
					"content": "Beim <color=#00E1FFFF>„Hirschjäger“</color> findest du auch viele Zutaten und Gerichte. Bei Gelegenheit kannst du ja mal vorbeischauen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671214
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671214,
					"content": "Hehe, vielen Dank für deine ... He! Lass mir etwas von dem Spieß mit Pilzen und Hühnchen übrig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
