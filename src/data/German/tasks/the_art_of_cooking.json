			"dialogs": [
				{
					"id": 4670201,
					"content": "Hast du alle Zutaten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670202
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670202,
					"content": "Nimm den <color=#00E1FFFF>Topf</color> da. Benutze ihn, so viel du willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynn"
				}
			]
		},
