					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150101,
					"content": "Dieses Achslager ist zu groß und passt nicht zu den anderen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230150102,
					"content": "Letztes Mal zu klein, dieses Mal zu groß! Du wirst noch meine gesamten Eisenbrocken aufbrauchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150103
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150103,
					"content": "In Wahrheit läuft uns das Geld auch aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150104,
					"content": "Worüber streitet ihr euch denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150105
					]
				},
				{
					"id": 230150105,
					"content": "Dieser Kerl hat sehr viele Eisenrohre und Zahnräder bei mir in Auftrag gegeben, mit unterschiedlichen Spezifikationen für jedes Eisenrohr und Zahnrad.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150106
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150106,
					"content": "Um diese Dinge für ihn zu schmieden, werde ich sämtliche Eisenbrocken aufbrauchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150107
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150107,
					"content": "Aber ihm reicht das alles nicht, er braucht sogar noch mehr Zahnräder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150108
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150108,
					"content": "Bitte, ich würde dir gerne meine Arbeit erneut erklären. Danach verstehst du mich bestimmt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230150109,
					"content": "Was treibt ihr da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150110
					]
				},
				{
					"id": 230150110,
					"content": "Herr Garcia soll Herrn Ahangar die Sache erläutern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150111,
					"content": "#{F#Reisende}{M#Reisender}, ich ... ähm, Herr Garcia benötigt deine Hilfe. Könntest du vielleicht einige Eisenbrocken für ihn sammeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150112,
						230150113
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150112,
					"content": "Ich habe Zeit, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				},
				{
					"id": 230150114,
					"content": "Was die Konstruktion der Maschine angeht ... sind wir auf einige Hindernisse gestoßen, die zu erwarten waren. Herr Garcia sucht derzeit nach einer Lösung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150115
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150115,
					"content": "Falls du Interesse hast, kannst du Herrn Garcia selbst fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150116
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150116,
					"content": "Ich denke ... außer ihm kann niemand die Funktionalitäten der Maschine erklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150117,
					"content": "Unterdessen möchte ich dich darum bitten, einige Eisenbrocken zu beschaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150113,
					"content": "Wie läuft es mit der Rekonstruktion seiner Maschine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				}
			]
		},
		{
			"id": 2301502,
