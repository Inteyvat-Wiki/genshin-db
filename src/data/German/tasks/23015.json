						"rawParams": [
							"2301503",
							"2"
						],
						"stepId": 2301503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong",
					"Ahangar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150301,
					"content": "Ja, ja! Ich habe verstanden! Ich schmiede ja schon deine Zahnräder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150302
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150302,
					"content": "Aber ich habe dir noch nicht alles über meine Maschine erzählt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230150303,
					"content": "Da wir nun die Eisenbrocken haben, werde ich mich gleich an die Arbeit machen. Halte besser etwas Abstand!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150304
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150304,
					"content": "Ahangar schwingt seinen Eisenhammer so heftig, dass Garcia vor ihm zurückweichen muss ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230150305
					]
				},
				{
					"id": 230150305,
					"content": "Lassen wir Herrn Ahangar seine Arbeit machen. Hier ist deine Bezahlung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150306,
					"content": "Ich wünsche euch viel Erfolg.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150307
					]
				},
				{
					"id": 230150307,
					"content": "#Das bedeutet mir viel, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150308
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150308,
					"content": "Ich bin dieser Sache gegenüber ... verhalten pessimistisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150309,
					"content": "Herr Garcia ist ein Genie in der Mechanik. Daran besteht kein Zweifel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150310
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150310,
					"content": "Aber ich bin der Auffassung, dass für seine ideale Maschine ... das „Genie“ von Herrn Garcia vielleicht nicht ausreicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
		{
			"id": 2301550,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
