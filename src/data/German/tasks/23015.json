			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ahangar",
					"Garcia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230155001,
					"content": "Wofür brauchst du so viele Zahnräder und Rohre? Möchtest du eine Eisenhütte bauen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155002
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230155002,
					"content": "Ganz genau, Herr! Ich werde eine Hütte bauen, eine Hütte voller Zahnräder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155003
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155003,
					"content": "Den Bereich, in dem ein Teil der Zahnräder aufbewahrt werden, nenne ich „Ablage“, während die restlichen Zahnräder und Achslager die „Berechnungszentrale“ bilden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155004
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155004,
					"content": "Die Zahnräder in der „Ablage“ protokollieren und speichern Zahlen, die von den Zahnrädern in der „Berechnungszentrale“ zur Berechnung verwendet werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155005
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155005,
					"content": "Ich male ein kleines Schema auf, dann ist alles besser verständlich. Hast du vielleicht Papier? Nein? Kein Problem, ich male es auf meiner Kleidung auf. Das klärt die Sache auf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155006,
					"content": "Kannst du mir die Kohle reichen? Danke, schau ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		}
	]
}