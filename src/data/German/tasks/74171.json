			"dialogs": [
				{
					"id": 741710101,
					"content": "#Das Ergebnis des „Pankration“-Unterhaltungsturniers im Überblick: Herzlichen Glückwunsch an die Forscherin und ihren Assistenten zum Sieg dieses Unterhaltungsturniers! Und herzlichen Glückwunsch auch an {F#die Trainerin} {M#den Trainer}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741710102
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 741710102,
					"content": "„Die Regel des temporären Verlängerungsspiels sollte deutlich in der Wettkampfordnung vermerkt werden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741710103
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 741710103,
					"content": "„Dieser Wettkampf ist so langweilig, gibt es etwas Aufregenderes?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741710104
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 741710104,
					"content": "„Betritt den Ring und erlebe es selbst mal! Zur Anmeldung bitte mit Roussimoff in Kontakt treten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
