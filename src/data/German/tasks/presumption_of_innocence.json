			"dialogs": [
				{
					"id": 200230901,
					"content": "Wie steht es um Nimrod?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230902
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230902,
					"content": "Nimrod hat dem Alkohol abgeschworen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230903
					]
				},
				{
					"id": 200230903,
					"content": "Dem Alkohol abgeschworen, sagst du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230904
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230904,
					"content": "Wir haben aber keine Beweise.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230905
					]
				},
				{
					"id": 200230905,
					"content": "Das macht nichts. Solange du nichts gefunden hast, was darauf hinweist, dass er trinkt, kann ich davon ausgehen, dass es stimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230906
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230906,
					"content": "Solange es keine Beweise für die Schuld eines Menschen gibt, gehe ich immer von seiner Unschuld aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230907
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230907,
					"content": "Leider gibt es immer wieder besagte Beweise für alle möglichen Sünden. Schon lustig manchmal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230908
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230908,
					"content": "Nehmt dies als Dank für eure Hilfe. Hoffentlich wirst du auch in Zukunft nichts tun, wofür du um Vergebung bitten musst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		}
	]
