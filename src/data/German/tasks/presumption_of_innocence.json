			},
			"dialogs": [
				{
					"id": 200230301,
					"content": "Oh, was ist los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230302
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230302,
					"content": "Es geht um Nimrod.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230303
					]
				},
				{
					"id": 200230303,
					"content": "Er schüttet sich jetzt schon eine ganze Weile so zu. Sieh mal, das ist seine Rechnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230304
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230304,
					"content": "Wenn das so weitergeht, müssen wir Eury herbitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230305
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 200230305,
					"content": "Ihr wollt sie haben? Das sollte zwar gehen ... aber was wollt ihr damit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
				}
			]
		},
		{
