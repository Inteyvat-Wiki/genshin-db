			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Victoria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200230101,
					"content": "Ob er es wohl Buße tun will?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230102
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230102,
					"content": "Buße? Wofür?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230103
					]
				},
				{
					"id": 200230103,
					"content": "Jeden Tag kommen sehr viele Menschen her und beichten ihre Sünden, um um Vergebung zu bitten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230104
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230104,
					"content": "Wenn man aber nur daherkommt und redet, aber nichts tut, ist das alles verschwendete Zeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230105
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230105,
					"content": "Nehmen wir Nimrod zum Beispiel. Er hat schon unzählige Male ob seines Alkoholproblems gebeichtet, aber nichts an seinem Verhalten geändert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230106
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230106,
					"content": "Wenn du Zeit hast, könntest du vielleicht einmal nach ihm sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230107,
						200230110
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230107,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230108
					]
				},
				{
					"id": 200230108,
					"content": "Ach, und wenn er wieder trinkt, könntest du ein paar Beweise sammeln und herbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230109
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230109,
					"content": "Wer sich partout nicht ändern will, braucht mehr als nur Nachhilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230110,
					"content": "Ist es eine Sünde zu trinken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230111
					]
				},
				{
					"id": 200230111,
					"content": "Das Trinken allein ist noch keine Sünde. Anderen aufgrund des Trinkens zu schaden, ist allerdings eine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230112
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230112,
					"content": "Wenn keiner hier in Mondstadt auf seine Mitmenschen achten würde, gäbe es am laufenden Bande Ärger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230113
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230113,
					"content": "Deshalb müssen wir dafür sorgen, dass ein solcher Sündenfall gar nicht erst entsteht. Schau doch bitte nach Nimrod, damit ihm und anderen nichts geschieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
		{
			"id": 2002302,
			"completionStepIds": [
				2002302
