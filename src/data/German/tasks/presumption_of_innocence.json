			},
			"dialogs": [
				{
					"id": 200230401,
					"content": "Wie steht es um Nimrod?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230402
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230402,
					"content": "Das hier ist seine Rechnung fürs Trinken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230403
					]
				},
				{
					"id": 200230403,
					"content": "Hach, habe ich es mir doch gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230404
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230404,
					"content": "Solange die Menschen nicht wirklich gelitten haben, vergessen sie ihre Vergangenheit sehr schnell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230405
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230405,
					"content": "Nun gut, nehmt das hier für eure Mühen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230406
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230406,
					"content": "Was ich mit Nimrod machen sollte, werde ich mir noch überlegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
