			"trigger": {
				"objectNames": [
					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200230201,
					"content": "Hahaha, das ist der Höhepunkt meines Tages ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230202
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230202,
					"content": "Wolltest du nicht aufhören zu trinken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230203
					]
				},
				{
					"id": 200230203,
					"content": "Was?! Hast du mich erschreckt ... Ich dachte schon, du wärst meine Frau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230204
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230204,
					"content": "Hin und wieder ein Gläschen zu trinken, ist doch kein Verbrechen. Schließlich habe ich den ganzen Tag lang geschuftet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230205
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230205,
					"content": "Aber schon gut, ich trinke nur noch aus ... Eury ist auch sicher gleich mit ihrem Einkauf zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
		{
			"id": 2002303,
			"completionStepIds": [
				2002304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
