				"points": []
			},
			"dialogs": [
				{
					"id": 200080101,
					"content": "Danke, ich danke dir! Du hast mich gerettet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080102
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080102,
					"content": "Diese Schleime waren plötzlich da, ich habe sie überhaupt nicht erwartet. Bevor ich weglaufen konnte, hatten sie mich schon umzingelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080103
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080103,
					"content": "Erzählt das bloß nicht meinem Vater. Er will mich schon kaum aus dem Haus lassen. Er meint, dass die Schleime in letzter Zeit sehr häufig angreifen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080104
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080104,
					"content": "Überall in der Nähe von Mondstadt sind jetzt diese Schleime und ich komme kaum noch nach draußen. Heute habe ich es heimlich geschafft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080105
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080105,
					"content": "Könntet ihr nachsehen, ob noch Schleime da sind, wenn es euch keine Probleme bereitet, und sie dann gleich beseitigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080106,
						200080107
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080106,
					"content": "Kein Problem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080108
					]
				},
				{
					"id": 200080108,
					"content": "Klasse! Jetzt kann ich spielen, ohne Angst zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080107,
					"content": "Eine dringende Angelegenheit wartet auf mich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080109
					]
				},
				{
					"id": 200080109,
					"content": "#Aber ... Ich kann doch nicht meinen Vater fragen! Du bist doch {F#die einzige, die}{M#der einzige, der} mir jetzt helfen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arthur"
				}
			]
		}
	]
