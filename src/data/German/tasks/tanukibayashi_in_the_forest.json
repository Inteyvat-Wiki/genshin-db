				"points": []
			},
			"dialogs": [
				{
					"id": 721080931,
					"content": "Was? Mir war nicht klar, dass das so wichtig ist. Das hättest du früher sagen sollen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080932
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080932,
					"content": "Ach, ich wurde einfach deswegen versiegelt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080933,
						721080934,
						721080935
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080933,
					"content": "Einhundert Jahre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080936,
					"content": "Hmm! Hör auf, so leichtfertig über mein Unglück zu sprechen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080937
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080937,
					"content": "Macht nichts. Das ist jetzt alles Schnee von gestern. Ich habe auch eine Ahnung von der Barriere in der Nähe des Waldes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080938
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080938,
					"content": "Damals, als ich gegen diese hinterhältige Kitsune kämpfte, habe ich sie einmal an der östlichen Meeresküste gesehen. Es sieht aus, als hätte jemand eine Donner-Sakura mit einem Torii-Tor zusammengebaut, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080939
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080939,
					"content": "Damals, als dieser Kerl gegen die Dämonen kämpfte, war ich besorgt, dass einige von ihnen herauskommen könnten, um uns zu verletzen. Also habe ich mit Magie ein Siegel auf diesen Ort gelegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080940
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080940,
					"content": "Lass mich mal sehen. Versiegelt unter der Felswand im Osten, sagst du ... Kichiboushi, bring sie hin und entferne das Siegel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080941
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080941,
					"content": "Danke, Ioroi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080942
					]
				},
				{
					"id": 721080942,
					"content": "Na gut, na gut. Genug geredet. Geh jetzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080943
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080943,
					"content": "Wenn du diese hinterhältige Kitsune triffst, vergiss nicht, sie von mir zu grüßen. Sag einfach ... lass mich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080944
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080944,
					"content": "„Diesmal hast du mich richtig verärgert, du Trottel. Komm zurück und kämpfe gegen mich! Unser Wettkampf ist noch nicht vorbei! Und hilf mir, dieses Siegel zu brechen, wenn du schon dabei bist, ja? Es ist nicht so, dass ich es nicht selbst tun könnte oder so, aber du schuldest mir trotzdem einen Gefallen! Außerdem sagt Gyoubu Koban, dass er dich vermisst!!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080945
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080945,
					"content": "Boaaaah, das ist eine Menge, die man sich merken muss!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080934,
					"content": "Eintausend Jahre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080935,
					"content": "Eine Million Jahre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				}
			]
		}
