			"dialogs": [
				{
					"id": 721080101,
					"content": "Wir sind endlich da! Das muss der Chinju-Wald sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080102,
					"content": "Fräulein mMaskierte Jungfer sagte, dass ein alter Freund von ihr im Chinju-Wald ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080103,
					"content": "Also, auf geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7210804,
			"completionStepIds": [
				7210816
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210816",
							"2"
						],
						"stepId": 7210816,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210810",
							"3"
						],
						"stepId": 7210810,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080401,
					"content": "Die Statue des Himmelsfuchses, die die Omamori beschützen sollte ... Sie ist innen leer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080402,
					"content": "Vielleicht wurde es von Fräulein Maskes alten Freund versteckt. Lasst es uns herausfinden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080403,
					"content": "Fräulein ... Maske?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080404
					]
				},
				{
					"id": 721080404,
					"content": "Paimon hat sich diesen Spitznamen einfach ausgedacht. Wie ist er? Leichter zu merken, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080405,
						721080406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080405,
					"content": "Nicht wirklich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080407
					]
				},
				{
					"id": 721080407,
					"content": "Nun, dann vergiss es ... Wie auch immer, lass uns zuerst ein paar Hinweise finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080406,
					"content": "Er hat keinen Sinn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080407
					]
				}
			]
		},
		{
			"id": 7210807,
			"completionStepIds": [
				7210814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210814",
							"2"
						],
						"stepId": 7210814,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080701,
					"content": "Ich ... Ich bin Ioroi. Mach was du willst! Töte mich, wenn du musst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080702
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080702,
					"content": "Oooh, die Statue spricht! Und sie ist so verängstigt, dass sie kaum einen Satz zusammensetzen kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080703,
					"content": "Ich bin keine Statue! Ich sehe nur so aus, weil ich vorübergehend von jemandem versiegelt worden bin. Ich bin der weltberühmte Bakedanuki Ioroi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080704,
						721080705
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080704,
					"content": "Ioroi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080706
					]
				},
				{
					"id": 721080706,
					"content": "Was? Willst du mir sagen, dass die Leute heutzutage noch nichts von Ioroi gehört haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080707
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080707,
					"content": "Die „Tanuki-Gyouen-Schriftrolle“, „Iorois Teekanne“, „Kakushigami Oobayashi“, „Yougou Tanuki Gassen“ ... Hast du noch nie von diesen Geschichten gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080708
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080708,
					"content": "Wie lange bin ich schon hier drin versiegelt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080709,
						721080711
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080709,
					"content": "Ich meine es nicht böse ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080710
					]
				},
				{
					"id": 721080710,
					"content": "Was? Du bist nicht hier, um mich zu zerstören? Warum hast du das dann nicht früher gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080719
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080719,
					"content": "*hust* Ähem. Nun denn, sprich! Warum seid ihr auf der Suche nach mir, dem Herrn der Bakedanuki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080720,
						721080722
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080720,
					"content": "Hier geht es um das heilige Sakura-Reinigungsritual ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080721
					]
				},
				{
					"id": 721080721,
					"content": "Das Heilige Säkulare was nun? Was ist das? Eine Art Oni-Schatz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080726
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080726,
					"content": "Dieser Typ ist unglaublich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080727
					]
				},
				{
					"id": 721080727,
					"content": "*seufz* Ist er wirklich Fräulein Maskierte Jungfers alter Freund?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080728,
					"content": "Wie auch immer, wir suchen nach etwas, das in einer Kitsune-Statue versteckt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080729,
					"content": "Äh, warum suchst du das, wenn ich fragen darf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080730,
						721080731
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080730,
					"content": "Ah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080732
					]
				},
				{
					"id": 721080732,
					"content": "Hmm, es geht um diesen Kamm, für den ich hier versiegelt wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080733
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080733,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080734,
						721080735,
						721080736
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080734,
					"content": "Einhundert Jahre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080737,
					"content": "Ich weiß nicht, wie lange es her ist! Das Sonnenlicht kommt nicht durch den Chinju-Wald. Es gibt keine Möglichkeit, die Zeit zu bestimmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080738
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080738,
					"content": "Damals habe ich überall Verwüstung angerichtet, um diese hinterhältige Kitsune herauszulocken, aber es war alles vergebens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080739
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080739,
					"content": "Schließlich beschloss ich, meinem Ärger Luft zu machen, indem ich eine dieser Kitsune-Statuen zerlegte, und ich fand einen Kamm darin ... Das brachte mich auf eine Idee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080740
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080740,
					"content": "Der Kamm war im Inneren der Kitsune-Statue versteckt und hatte sogar das Hakushin-Symbol darauf, was mich an ihr weißes Fell erinnerte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080741
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080741,
					"content": "Daraus schloss ich sofort, dass es sehr wichtig sein musste. In diesem Fall brauchte ich nur den Kamm zu verstecken, und dieser hinterhältige Kitsune würde sicher herauskommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080742
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080742,
					"content": "Ja, der Schatz ist sicher ein guter Weg, um Leute herauszulocken! Was ist dann passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080743
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080743,
					"content": "Dann kam einer vom Yougou-Trio. Er besiegte meinen Stamm und mich und verwandelte uns alle in Stein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080744
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080744,
					"content": "Das ist also der Grund, warum Ioroi Angst vor Menschen hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080745
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080745,
					"content": "Hmpf! Die Menschen. Sie sind so kurzlebig und können sich nicht einmal verwandeln ... Ich verstehe nicht, warum die Kitsune sie so sehr mag.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080746
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080746,
					"content": "Der Typ, der mich versiegelt hat, war besonders ärgerlich. Er sagte mir sogar, ich sollte „eine schöne Pose einnehmen, damit ich eine schöne Kulisse werde“. Warum, dieser kleine ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080747
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080747,
					"content": "Nun, du gibst eine schöne Kulisse ab ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080748
					]
				},
				{
					"id": 721080748,
					"content": "Äh? Du ... Wie konntest du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080749
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080749,
					"content": "#(He, {NICKNAME}, verärgere ihn nicht, sonst bekommen wir das Omamori nie ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080750,
						721080751
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080750,
					"content": "Ich will damit sagen, dass du wirklich mutig und stämmig aussiehst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080752
					]
				},
				{
					"id": 721080752,
					"content": "Das ist richtig! Du lässt diesen dunklen Wald so viel bunter aussehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080753
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080753,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080754
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080754,
					"content": "Und weiter?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080755,
						721080756
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080755,
					"content": "Wie die Statue eines Archons ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080757
					]
				},
				{
					"id": 721080757,
					"content": "Also ist es doch gar nicht so schlecht, versiegelt zu sein, oder? Siehst du, die Menschen meinen es nicht böse mit dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080758
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080758,
					"content": "Ich kann die Argumentation verstehen, aber zur gleichen Zeit ... stimmt es auch nicht ganz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080759
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080759,
					"content": "Können wir uns den Kamm ausleihen, von dem du gesprochen hast?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080760
					]
				},
				{
					"id": 721080760,
					"content": "Nun, das kannst du sicherlich ... Aber nur, wenn du zuerst mit den Kindern spielst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080761
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080761,
					"content": "#Klar, das ist einfach. {NICKNAME} kann gut mit Kindern umgehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080762,
						721080763
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080762,
					"content": "Um ehrlich zu sein, hab ich es nicht so mit Kindern ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080765
					]
				},
				{
					"id": 721080765,
					"content": "Shousei, Gyoubu Koban, und Kichiboushi. Geh und finde diese <color=#00E1FFFF>drei kleinen Tanuki</color> und spiele mit ihnen. Ich würde es tun, aber wie ihr seht, kann ich mich nicht wirklich bewegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080766
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080766,
					"content": "Dieser verflixte Kerl war ein bisschen schlampig, als er sie versiegelt hat. Deshalb konnten einige von ihnen früher entkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080767
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080767,
					"content": "... Warte, das ist nicht korrekt! Wir sollten eher sagen, dass wir Bakedanuki in der Tat ziemlich mächtig sind. Es ist also nur normal, dass wir uns von einem menschlichen Siegel befreien können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080768,
						721080770
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080768,
					"content": "Was ist mit dir ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080769
					]
				},
				{
					"id": 721080769,
					"content": "Ähem! Ioroi der Mächtige!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080771
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080771,
					"content": "Obwohl ihre Kraft nicht wirklich mit meiner vergleichbar ist, können sie sie dennoch nutzen, um sich zu verstecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080772
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080772,
					"content": "Na gut, dann los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080770,
					"content": "In der Tat, sehr mächtig!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080771
					]
				},
				{
					"id": 721080763,
					"content": "Das stimmt, ich spiele die ganze Zeit mit Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080764
					]
				},
				{
					"id": 721080764,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080765
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080756,
					"content": "Selbst die Statuen der Sieben verblassen im Vergleich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080757
					]
				},
				{
					"id": 721080751,
					"content": "Ich meine, dass du wirklich gutaussehend bist und wirklich ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080752
					]
				},
				{
					"id": 721080735,
					"content": "Eintausend Jahre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080736,
					"content": "Eine Million Jahre?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080731,
					"content": "Jetzt kommen wir weiter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080732
					]
				},
				{
					"id": 721080722,
					"content": "Ich bin hier auf der Suche nach Omamori ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080723
					]
				},
				{
					"id": 721080723,
					"content": "O Mamma mia? Hat eure Mama euch kein Essen gemacht? Wir Bakedanuki wissen eine ganze Menge über das Kochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080724
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080724,
					"content": "Nein, es ist das Reinigungsritual für die heilige Sakura!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080725,
					"content": "Sakura? Habe ich lange nicht mehr gegessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080726
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080711,
					"content": "Ich bin hier, um Schulden einzutreiben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080712
					]
				},
				{
					"id": 721080712,
					"content": "Äh, Schulden? Wo? Wann war das? Lass mich nachdenken, lass mich nachdenken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080713
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080713,
					"content": "Du, äh ... Was schulde ich dir nochmal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080714
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080714,
					"content": "Er denkt wirklich angestrengt nach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080715,
					"content": "Du solltest diese Art von Witzen wahrscheinlich nicht vor Fremden erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080716,
					"content": "Das ist richtig, mach nicht solche Witze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080717
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080717,
					"content": "Hm, es ist alles gut, es ist alles gut ... Bin ich euch wirklich nichts schuldig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080718
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080718,
					"content": "... Hast du wirklich so viele Schulden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080705,
					"content": "Weltberühmt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080706
					]
				}
			]
		},
		{
			"id": 7210808,
			"completionStepIds": [],
