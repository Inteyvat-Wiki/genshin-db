						],
						"stepId": 7210803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080801,
					"content": "Ooh ... Ich möchte mich so gerne am Bauch kratzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080802
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080802,
					"content": "Hm? Du bist schon wieder da? Los, hilf mir, Shousei, Gyoubu Koban und Kichiboushi zu finden, und geh <color=#00E1FFFF>mit ihnen spielen.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080803
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080803,
					"content": "Na gut, dann los.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ioroi"
				}
			]
		},
		{
			"id": 7210809,
			"completionStepIds": [
				7210807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210807",
							"2"
						],
						"stepId": 7210807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ioroi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080901,
					"content": "Hehe, gut gemacht! Sie scheinen ziemlich glücklich zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080902
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080902,
					"content": "... Hm? Oh, kein Problem. Lass mich sie für dich fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080903
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080903,
					"content": "Gyoubu Koban fragte: „Wenn ihr Menschen seid, warum riecht ihr dann wie Tanuki?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080904
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080904,
					"content": "... Stimmt! Gib mir eine Erklärung! Warum riechst du wie ein Tanuki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080905
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080905,
					"content": "Äh? Du fragst das erst jetzt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080906,
						721080907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080906,
					"content": "Es war die maskierte Jungfer ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080908
					]
				},
				{
					"id": 721080908,
					"content": "Genau! Das ist passiert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080909,
					"content": "Fräulein maskierte Jungfer hat uns vorhin ein sehr üppiges Mahl gekocht, und sie sagte, dass sie dafür Magie benutzt hat, die sie heimlich von den Bakedanuki gelernt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080910,
					"content": "Was? Sie hat heimlich unsere Magie gelernt? Wie kann sie es wagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080911
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080911,
					"content": "Hmm ... Vielleicht, nur vielleicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080912
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080912,
					"content": "Oh, komm schon. Diese hinterhältige Kitsune! Wenn sie noch am Leben wäre, hätte sie doch wenigstens vorbeikommen können, um Hallo zu sagen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080913
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080913,
					"content": "Sie ist eine Schreinjungfer mit einer Maske. Sie hat dich einen „alten Freund“ genannt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080914,
					"content": "Maske? Ich kenne niemanden mit einer Maske. Ich kenne auch keine Schreinjungfern. Aber ich kenne eine Kitsune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080915
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080915,
					"content": "... Abgesehen davon ist diese hinterhältige Kitsune schon einmal in Form einer Schreinjungfer erschienen. Wie sieht die Schreinjungfer, von der du sprichst, aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080916
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080916,
					"content": "Sie trägt eine weiße Fuchsmaske ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080917,
					"content": "Sonst noch etwas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080918,
						721080920
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080918,
					"content": "Sie hatte kurze schwarze Haare.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080919
					]
				},
				{
					"id": 721080919,
					"content": "Und sie trug Schreinjungfern-Kleidung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080922,
					"content": "Hmm ... Kenne sie nicht. Habe noch nie jemanden wie sie gesehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080923
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080923,
					"content": "Ist das so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080924,
					"content": "... Hm? Ja, klar, überlass das mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080925
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080925,
					"content": "Shousei sagte: „Es hat Spaß gemacht, mit dir zu spielen. Danke!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080926
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080926,
					"content": "Paimon hatte auch eine Menge Spaß!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080927,
					"content": "Also, wegen dem Kamm ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080928
					]
				},
				{
					"id": 721080928,
					"content": "Nun, nun ... Ich bin der weltberühmte Bakedanuki Ioroi und ich werde sicherlich mein Wort halten. Du kannst den Kamm haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080929
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080929,
					"content": "Aber was willst du eigentlich mit dem Kamm machen? Wahrscheinlich riecht er immer noch nach Kitsune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080930
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080930,
					"content": "Also, es ist so ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080920,
					"content": "Und sie trug Schreinjungfern-Kleidung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080921
					]
				},
				{
