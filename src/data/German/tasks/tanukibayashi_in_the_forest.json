			},
			"dialogs": [
				{
					"id": 721081101,
					"content": "Das ist es? Es ist nur ein Haufen nackter Steine ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721081102,
					"content": "Ja? Er scheint eine Art Magie zu benutzen, um ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721081103,
					"content": "Puh! Die Steine sind verschwunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081104,
						721081105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721081104,
					"content": "Das ist erstaunlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721081106
					]
				},
				{
					"id": 721081106,
					"content": "Das ist also Bakedanuki-Magie? Scheint irgendwie Spaß zu machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721081107,
					"content": "Vielen Dank, Kichiboushi! Lass uns das nächste Mal Verstecken spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721081108,
					"content": "He!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Kichiboushi“"
				},
				{
					"id": 721081105,
					"content": "Das ist schon irgendwie gruselig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721081106
					]
				}
			]
		},
		{
			"id": 7210821,
			"completionStepIds": [
				7210815
