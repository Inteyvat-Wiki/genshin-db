			"dialogs": [
				{
					"id": 711290101,
					"content": "„... Es ist schwer, dem Weg des Himmels zu vertrauen und nur wenige können ihm gerecht werden. Das Schicksal folgt nicht dem geraden Weg und nur wenige prosperieren, ohne zu scheitern. Wem der Himmel Augen zum Sehen gab, der sieht oft den Weg nicht. Was ist erst mit dem, der nicht von der Warte des Himmels aus sieht ...?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711290102
					],
					"speakerTitle": "Inschrift auf der Stele"
				},
				{
					"id": 711290102,
					"content": "„... Diese Andachtsstele wurde hinterlassen, um die Künftigen zu fragen: Wohin soll man sich wenden, wenn man auf verlorenem Posten steht?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711290103
					],
					"speakerTitle": "Inschrift auf der Stele"
				},
				{
					"id": 711290103,
					"content": "(Fortgehen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
