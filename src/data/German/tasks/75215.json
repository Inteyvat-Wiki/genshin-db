				"points": []
			},
			"dialogs": [
				{
					"id": 752150301,
					"content": "Neue Leute zu gewinnen ist eigentlich nicht schwer. Das Problem ist nur, dass viele nach einer gewissen Zeit des Trainings Ausreden finden, um sich freizunehmen oder sie kommen einfach nicht mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150302
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150302,
					"content": "Der Trainer hat sich einiges einfallen lassen, um die Motivation zu steigern, und die Herausforderung mit dem Block ist eine davon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150303
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150303,
					"content": "Aber am Ende haben einige versucht, ihre Punktzahl zu erhöhen, indem sie in den besagten Block gekracht sind, was ihnen meist nichts weiter als blaue Flecken und Prellungen eingebracht hat. Das hat die Zahl derer, die nicht mehr kommen wollten, nur noch erhöht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				}
			]
		},
