			"trigger": {
				"objectNames": [
					"Kerih"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150101,
					"content": "Wie sieht’s aus? Interessierst du dich auch für das Training?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150102
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150102,
					"content": "Du kannst gerne das Equipment benutzen, aber pass bei deinen dürren Ärmchen und Beinchen auf, dass du dich nicht verletzt, klar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150103,
						752150104
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150103,
					"content": "Hör mal, ich mache jeden Tag mein Training.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				},
				{
					"id": 752150105,
					"content": "Wirklich? Dann zeig mir doch erstmal an dem großen Block dort, was du so draufhast, bevor du hier große Töne spukst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150106
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150106,
					"content": "<color=#00E1FFFF>Greif den Block an</color> oder <color=#00E1FFFF>prall gegen ihn</color> und du erhältst Punkte entsprechend der Stärke deiner Kraft. Jetzt wollen wir doch mal sehen, wie viel du drauf hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150104,
					"content": "Ich kann einen Hilichurl mit einem Faustschlag umhauen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				}
			]
		},
		{
			"id": 7521502,
			"completionStepIds": [
				7521502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7521502",
							"2"
						],
						"stepId": 7521502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kerih"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150201,
					"content": "Was ...? Du hast echt eine Ecke abgebrochen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150202
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150202,
					"content": "Die letzte Person, die so viel Kraft hatte, war Varesa ... Anscheinend seid ihr beide echte Naturtalente!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150203,
						752150204
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150203,
					"content": "Nun, ich muss sagen, es war nicht so leicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				},
				{
					"id": 752150205,
					"content": "#Es stimmt wohl, dass man ein Buch nicht nach seinem Einband beurteilen sollte. Ich würde dich glatt als Trainer{F#in} engagieren, wenn ich die Chance dazu hätte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150206
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150206,
					"content": "Ah, ja. Probier mal was von diesem „Saft der Fülle“. Unsere Teilnehmer schwören drauf. Es heißt, er soll angeblich die sportliche Leistung steigern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150204,
					"content": "Tja, für mich war das nur ein Kinderspiel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				}
			]
		},
		{
			"id": 7521503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
