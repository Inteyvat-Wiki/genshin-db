						701120202
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120202,
					"content": "Moment mal. An wen genau ging jetzt gerade das Lob?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701120203,
					"content": "Nun, der nächste Schritt wäre, zu überlegen, wie sich die Dinge gegenseitig beeinflussen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120204
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120204,
					"content": "Beobachte die Elementarreaktionen, die Langstrecken- und die Kurzstreckenkräfte. Und denk daran, unnötige Störungen zu vermeiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120205
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120205,
					"content": "Ähm, was redest du denn da?",
