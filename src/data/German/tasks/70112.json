			"dialogs": [
				{
					"id": 701120101,
					"content": "Na gut, Dexter. Die Zeiten ändern sich. Du solltest deine Kindheit auch hinter dir lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120102
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120102,
					"content": "Auch du musst dich der Taufe unterziehen, die wir Erwachsenwerden nennen, und Dinge lernen, die nur Erwachsene wissen. Pass jetzt gut auf, Dex. Ich werde es nur einmal vorführen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120103
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120103,
					"content": "Warum klang das jetzt wie die letzten Worte von jemandem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701120104,
					"content": "Die letzte Lektion, lies mir nach: „Klassifizierung der Elemente“. Los, probier es aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Josephus"
				}
			]
		},
