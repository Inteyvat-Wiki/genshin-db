			"trigger": {
				"objectNames": [
					"Etsu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570701,
					"content": "Es tut mir so leid, was ich zu dir gesagt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570702
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570702,
					"content": "Du meinst Herrn Heizou? Er muss eigentlich einen Mensch wie mich sehr hassen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570703
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570703,
					"content": "Obwohl er sehr zurückhaltend ist und seine Worte höflich und freundlich sind, kann ich jedoch erkennen, dass seine Einstellung gegenüber Betrügern anders ist als bei anderen Gefangenen ... Er scheint Betrüger sehr zu hassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570704
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570704,
					"content": "Könnte es sein, dass er auch schon mal betrogen wurde? Das wäre eigentlich unglaublich. Denn wer könnte es schaffen, Herrn Heizou zu betrügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsu"
				}
			]
		},
		{
			"id": 1905708,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1905702",
							"2"
						],
						"stepId": 1905702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kano Nana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570801,
					"content": "#Hallo, {F#Reisende}{M#Reisender}. Mein Cousin hat dir bestimmt viel Ärger bereitet, stimmt das? Er ist einfach zu individualistisch und hat eigentlich niemals böse Absichten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570802
					],
					"speakerTitle": "Kano Nana"
				},
				{
					"id": 190570802,
					"content": "Wenn er dich irgendwie beleidigt hat, zögerst du bitte nicht, ihm eine Lektion zu erteilen. Wenn er es wagt, sich dir zu widersetzen, kannst du ihm ruhig sagen, dass ich damit einverstanden bin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kano Nana"
				}
			]
		},
		{
			"id": 1905709,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1905703",
							"2"
						],
						"stepId": 1905703,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1905708",
							"2"
						],
						"stepId": 1905708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iba"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190570901,
					"content": "Du wirst dich nicht mit ihm anlegen wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570902
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570902,
					"content": "Äh? Wollt ihr beide wissen, was passiert ist? Da gibt es eigentlich nicht viel zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570903
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570903,
					"content": "Als ich hörte, dass Heizou an dem Fall dran war, wusste ich, dass es zu Ende war. Ich habe den einfachen Weg gewählt und alles gestanden. Was kann man denn sonst tun, wenn ein „Sturm“ auf einen zukommt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570904
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570904,
					"content": "Ein „Sturm“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190570905
					]
				},
				{
					"id": 190570905,
					"content": "Das ist der Spitzname von Heizou. Hast du noch nie davon gehört? So nennen ihn die Gefangenen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570906
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570906,
					"content": "Kein Ort zum Verstecken, kein Platz zum Weglaufen. Heizou ist für die Kriminellen wie eine Naturkatastrophe, wie ein „Sturm“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570907
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570907,
					"content": "*seufz* Hätte ich das nur gewusst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iba"
				}
			]
		}
	]
