	"talks": [
		{
			"id": 303201,
			"completionStepIds": [
				303201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"303201",
							"2"
						],
						"stepId": 303201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320101,
					"content": "#Willkommen zurück, {NICKNAME}, Paimon und Scaramouche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320102,
					"content": "Puh! Paimon ist völlig erschöpft ... Als wären wir auf einer endlos langen Reise gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320104
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320104,
					"content": "Gefällt dir der Name etwa nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320105,
					"content": "Das ist es nicht. Ich dachte nur, ich sollte meinen Namen ändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320106
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320106,
					"content": "Du willst nicht mehr „Scaramouche“ genannt werden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320107
					]
				},
				{
					"id": 30320107,
					"content": "Jetzt, da ich weiß, was dieser „Il Dottore“ alles getan hat, wie könnte ich da noch einen Namen tragen, der mit ihm zu tun hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320108
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320108,
					"content": "Ich will nicht zurück zu den Fatui, ich könnte es auch gar nicht. Unzählige Menschen wurden durch die Ereignisse beeinflusst, wer soll sich da noch an den Sechsten der Fatui erinnern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320109
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320109,
					"content": "Heißt das, du willst dich von deiner Organisation lossagen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320110,
					"content": "Das wäre wie eine heimliche Flucht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320111
					]
				},
				{
					"id": 30320111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320112
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320112,
					"content": "Wie du gesagt hast, Niedere Herrin Kusanali, es scheint sinnlos zu sein, aber das ist es nicht ganz. Zumindest haben die meisten Menschen mich vergessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320113
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320113,
					"content": "Aber das heißt nicht, dass deine Vergangenheit ausgelöscht wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320114
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320114,
					"content": "Das ist mir klar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320115
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320115,
					"content": "Außerdem solltest du bedenken, dass du dein eigentliches Ziel, das du so verbissen verfolgt hast ... nicht erreicht hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320116
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320116,
					"content": "Die Welt zu verändern, die Vergangenheit zu verändern ... das Schicksal anderer zu verändern ist kein leichtes Unterfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320117
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320117,
					"content": "Die Antwort, nach der du dich so sehr gesehnt hast, ist die totale Vernichtung ... Vollkommen wider die Natur. Selbst wenn es keinen „Scaramouche“ mehr gibt, wird die Welt sich deinem Willen nicht beugen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320118
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320118,
					"content": "... Richtig. Haha, wirklich komisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320119
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320119,
					"content": "Bereust du nicht, so weit gegangen zu sein ... für ein solches Resultat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320120,
					"content": "Auch wenn ich selbst wertlos bin, auf der Welt gibt es nichts, das es zu bereuen lohnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320121
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320121,
					"content": "Niedere Herrin Kusanali, die Informationen hast du doch absichtlich in Irminsul hinterlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320122
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320122,
					"content": "Ich hatte mir auch viel Mühe gegeben, dass du diese Informationen so natürlich wie möglich erlangen konntest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320123
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320123,
					"content": "Warum hast du dir einen solchen Aufwand gemacht? Willst du mich etwa auch bekehren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320124
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320124,
					"content": "Ehrlich gesagt hat deine Vergangenheit dich zu einem nützlichen Individuum für mich und Sumeru gemacht. Dich zu bekehren war wirklich ein Teil meines Plans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320125
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320125,
					"content": "Aber vorher wollte ich dir die ganze Wahrheit sagen. Wenn ich dich einfach benutzt hätte, wäre ich keinen Deut besser als „Il Dottore“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320126
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320126,
					"content": "... Du bist wirklich scharfsinnig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320127
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320127,
					"content": "Das ist eine Tugend, die man von mir wohl erwarten darf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320128
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320128,
					"content": "Anderen Menschen dienlich zu sein, gibt mir einen Wert. Deshalb habe ich selbst als Sünder einen Grund, mich weiter benutzen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320129
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320129,
					"content": "So denkt Nahida nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320130
					]
				},
				{
					"id": 30320130,
					"content": "Oh ja, ich hatte fast vergessen ... Ihr steht auf der Seite der „Gerechtigkeit“, nicht so wie ich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320131
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320131,
					"content": "Tut mir leid, aber ich sehe die Dinge aus einer etwas anderen Perspektive. Aber ich würde dich nicht berechnend nennen, weil es deine Weisheit mit sich bringt, bessere Handlanger zu haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320132
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320132,
					"content": "Ich bin froh, dass du so denkst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320133
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320133,
					"content": "#{NICKNAME}, ich werde auch weiterhin die Geheimnisse in Irminsul erforschen und studieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320134
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320134,
					"content": "#Darunter auch den Verlauf {M#deiner Schwester}{F#deines Bruders}. Was verbirgt sich dahinter ... Das möchte ich selbst auch wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320135
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320135,
					"content": "Dann hilf mir bitte, es herauszufinden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320136
					]
				},
				{
					"id": 30320136,
					"content": "Gern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320137
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320137,
					"content": "#{NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320138
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320138,
					"content": "Hm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320139
					]
				},
				{
					"id": 30320139,
					"content": "Warum bist du nach Inazuma gegangen, nachdem ich mich in die Informationsflut in Irminsul gestürzt hatte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320140
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320140,
					"content": "Weil ich wissen wollte, was du verändert hast.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320141
					]
				},
				{
					"id": 30320141,
					"content": "... So hast du also erfahren, wie sich das Schicksal dieser Leute verändert hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320142
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320142,
					"content": "Egal, du hast mir jedenfalls geholfen, also werde ich alles tun, um meine Schuld zu begleichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320143,
						30320144
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320143,
					"content": "... Ich habe das nicht getan, um dafür belohnt zu werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				},
				{
					"id": 30320145,
					"content": "Zwischen zwei Personen gibt es keine andere Beziehung als „Leihen“ und „Zurückzahlen“. Früher oder später werden wir quitt sein, du brauchst dir darum keinen Kopf zu machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320146
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320146,
					"content": "Das ist nicht wahr. Die Beziehung zwischen Menschen ist kein weißes Blatt, das man so einfach unbeschrieben machen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320147
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320147,
					"content": "Das musst du auch gespürt haben. Die Menschen, die in dein Leben getreten sind, werden nicht einfach verdampfen wie Wassertropfen. In der realen Welt gibt es kein echtes „quitt sein“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320148
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320148,
					"content": "Und weil manche Dinge einfach nicht rückgängig gemacht oder geändert werden können, gibt es überhaupt so etwas wie Gefühle zwischen den Menschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320149
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320149,
					"content": "Alles, was du fühlst, ist real und die Schuld, die du begehst, kann nicht getilgt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320150
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320150,
					"content": "Mängel liegen in der Natur des Menschen. Du kannst selbst entscheiden, ob du ein Mensch sein willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320151
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320151,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320152
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320152,
					"content": "Es gibt keinen Menschen ohne ein Herz. Außerdem will ich schon lange kein Mensch mehr sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320153
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320153,
					"content": "Du spürst den Schmerz auch ohne Herz, aber du unterdrückst deine Gefühle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320154
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320154,
					"content": "Du kannst die Vergangenheit nicht erschüttern, aber du kannst deinen Weg fortsetzen. Die Zukunft muss nur lang genug voranschreiten, dann wird deine „Vergangenheit“ irgendwann nur noch ein kurzer Abschnitt auf dem Zeitstrahl sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320155
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320155,
					"content": "Anscheinend hast du schon über meinen weiteren Weg entschieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320156
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320156,
					"content": "Ich hoffe, du wirst dich mit Nahida zusammentun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320157
					]
				},
				{
					"id": 30320157,
					"content": "Es ist alles miteinander verwoben und die Grenzen sind unklar. Aber für uns wäre es wichtig, wenn du Nahida folgen würdest. Dafür haben wir das alles getan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320158,
					"content": "... Dann lasst mich euer Helfer hinter den Kulissen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320159
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320159,
					"content": "Ich bin froh, dass du unseren Vorschlag annimmst. Warum wählst du nicht selbst einen Namen, um das zu feiern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320160
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320160,
					"content": "Beeil dich, Paimon muss dir auch einen hässlichen Spitznamen geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320161,
					"content": "Warum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320162
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320162,
					"content": "Weil ... Na weil Paimon dich immer noch nicht leiden kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320163,
					"content": "Tja. Dann sollten wir uns in Zukunft besser nicht zu oft begegnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320164
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320164,
					"content": "„Der Name ist das erste Geschenk des Lebens“ ... Das hast du zwar nicht so direkt gesagt, aber ich weiß, dass du so denkst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320165
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320165,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320166
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320166,
					"content": "#{NICKNAME} und Paimon waren dir bei dieser Sache eine große Hilfe. Wenn du dich nicht für einen Namen entscheiden kannst, kannst du sie um Rat fragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320167
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320167,
					"content": "Was? Wir sollen das entscheiden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320168
					]
				},
				{
					"id": 30320168,
					"content": "Das geht nicht, Paimon kann nur Spitznamen vergeben, keine richtigen ... Mach du das!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320144,
					"content": "Bitte sprich nicht, als würde ich etwas von dir verlangen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				}
			]
		},
		{
			"id": 303203,
			"completionStepIds": [
				303203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"303203",
							"2"
						],
						"stepId": 303203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sawada",
					"Aqaba",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320301,
					"content": "Ich hab’s! Das Finale des Romans handelt von Mikoshi Nagamasa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320302
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320302,
					"content": "Du meinst, die anderen Figuren aus der Geschichte werden nicht mehr auftauchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320303
					],
					"speakerTitle": "Aqaba"
				},
				{
					"id": 30320303,
					"content": "Genau, ich habe gehört, dass Mikoshi Nagamasa bis ins hohe Alter gelebt hat. Er ist bestens als Erzähler für das Finale geeignet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320304
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320304,
					"content": "„Die bedrohliche Atmosphäre hatte sich aufgelöst, aber die Ereignisse sollten noch für die nächsten Jahrzehnte die Gedanken Mikoshi Nagamasas wie dunkle Wolken einhüllen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320305
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320305,
					"content": "„Im hohen Alter hatte er einen Traum. In der Nacht als das Schwert mit dem Namen ‚Daitatara Nagamasa‘ geschmiedet wurde, lachten, tanzten, malten und tranken die Leute.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320306
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320306,
					"content": "„... All die Freude schmolz im Feuer dahin und verwandelte sich in rote Wolken, die den letzten Sonnenaufgang umrahmten, den Mikoshi Nagamasa in seinem ganzen Leben sah.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320307
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320307,
					"content": "„Es war ein langer Weg, alle Sehnsüchte waren längst vergessen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320308
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320308,
					"content": "... Pah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
		{
			"id": 303204,
			"completionStepIds": [
				303204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"303204",
							"2"
						],
						"stepId": 303204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320401,
					"content": "Damit hast du auch einen Namen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320402
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320402,
					"content": "Und der Spitzname? Hast du dir einen überlegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320403
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320403,
					"content": "Äh ... Ähm, Paimon überlegt noch ... Drängle nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320404,
					"content": "Lass dir Zeit. Solange du noch darüber nachdenkst, brauchen wir uns wenigstens nicht zu treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320405
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320405,
					"content": "Was hast du vor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320406
					]
				},
				{
					"id": 30320406,
					"content": "Diejenigen, die mich hintergangen und ins Unglück gestürzt haben, werden früher oder später den Preis dafür bezahlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320407
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320407,
					"content": "Redest du von den Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320408,
					"content": "Zumindest „Il Dottore“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320409
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320409,
					"content": "Du hast die Seite gewechselt, ich denke, dein zukünftiger Weg wird sich nun auch ändern. Aber es ist noch zu früh ... Du brauchst noch etwas Zeit, um mit dir selbst ins Reine zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320410
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320410,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320411
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320411,
					"content": "Es gibt da noch eine Sache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320412
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320412,
					"content": "In Inazuma gibt es noch Nachfahren der Raiden Gokaden. Einige von ihnen wissen ... besser gesagt, wussten von meiner Verbindung zu den Raiden Gokaden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320413
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320413,
					"content": "Ich habe nicht vor, Sumeru in nächster Zeit zu verlassen. Wenn du ihnen in Inazuma begegnest, kannst du ihnen sagen, dass ich der Mörder war, der die Raiden Gokaden zu Fall gebracht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320414
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320414,
					"content": "... Auch wenn diese Geschichte aus der Welt entfernt wurde, sollten sie die Wahrheit erfahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320415
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320415,
					"content": "Wie du willst ... Es ist deine Entscheidung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320416
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320416,
					"content": "Was? Aber dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320417,
					"content": "Schon gut, sie können mir ein Messer in die Brust stoßen, wenn sie das wollen ... Vielleicht hätte es sowieso so kommen sollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320418,
						30320422
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320418,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320419
					]
				},
				{
					"id": 30320419,
					"content": "Was guckst du so? Zieh nicht so ein Gesicht, ich weiß, was ich tue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320420
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320420,
					"content": "... Einmal wird der Tag kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320421
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320421,
					"content": "Also gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320425
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320425,
					"content": "Bis bald, die weise Göttin und ihr zwei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320426
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320426,
					"content": "Und weg ist er ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320427,
					"content": "Für ihn müssen die jüngsten Ereignisse so wirken, als hätte er plötzlich ein völlig anderes Leben durchlebt. Jeder würde Zeit brauchen, um mit sich ins Reine zu kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320428
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320428,
					"content": "Hm, stimmt. Er ist zwar immer noch der alte, aber sein Ton ist sanfter geworden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320429,
					"content": "Jedenfalls ist es jetzt vorbei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320430
					]
				},
				{
					"id": 30320430,
					"content": "Können wir dann jetzt endlich essen gehen? Paimon ist am Verhungern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320431,
					"content": "Ihr habt viel durchgemacht, sucht euch ein ruhiges Plätzchen und ruht euch gründlich aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320422,
					"content": "Ich verstehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320423
					]
				},
				{
					"id": 30320423,
					"content": "Du bist sehr direkt, das gefällt mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320424
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320424,
					"content": "... Gut, belassen wir es dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320425
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
		{
			"id": 303205,
			"completionStepIds": [
				303205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"303205",
							"2"
						],
						"stepId": 303205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amane",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320501,
					"content": "Puh! ... Endlich Zeit für eine Pause!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320502,
					"content": "Jetzt wo wir einmal Ruhe haben, fühlt sich Paimon plötzlich hungrig und erschöpft ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320503,
						30320504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320503,
					"content": "Paimon, ruh dich ordentlich aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				},
				{
					"id": 30320505,
					"content": "Juhu! Großartig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320506,
					"content": "... Hä? Diese Flasche ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320507,
					"content": "... Was ist?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320508
					]
				},
				{
					"id": 30320508,
					"content": "Hat die jemand beim Saubermachen zerbrochen? Aber Paimon hat niemanden hereinkommen gehört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320509,
					"content": "(In jener Nacht war Paimon wegen der Sache mit Scaramouche verängstigt und ist aus Versehen an den Tisch gestoßen und hat die Flasche zerbrochen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320510
					]
				},
				{
					"id": 30320510,
					"content": "(Aber gleich danach hat Scaramouche seine eigene Existenz ausgelöscht. Hat er die Welt nicht schon verändert? Warum ist diese Flasche dann immer noch zerbrochen ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320511
					]
				},
				{
					"id": 30320511,
					"content": "Du klingst verwirrt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320512
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320512,
					"content": "... Wer ist da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320513
					]
				},
				{
					"id": 30320513,
					"content": "Ich verstehe deine Unsicherheit. Jedem, der weiß, was du weißt, würde dabei schwindlig werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320514
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320514,
					"content": "Huch? Spricht uns da jemand ins Ohr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320515,
					"content": "Aber leider ist das Schicksal von Teyvat zu leicht zu erschüttern. Für Götter gibt es noch eine kleine Chance, aber für die Sterblichen ... ist das schwer zu sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320516
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320516,
					"content": "Wenn ein kleines Tier gegen einen Baumstamm knallt, schwankt es. Aber eine Krümmung ist keine Verschiebung. Mit dem Schicksal ist es genauso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320517
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320517,
					"content": "Es ist wie mit einer Flasche, die auf den Boden fällt. Sie zerbricht, egal ob sie von einem Kätzchen oder einem Vogel heruntergestoßen wurde, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320518
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320518,
					"content": "Wer ... Wer bist du? Woher weißt du davon ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320519,
					"content": "Die Vergangenheit ist nicht leicht zu verändern, aber die Herzen der Menschen schon. Vertraut euren eigenen Augen. Was ihr seht, ist real, was ihr nicht seht, ist Illusion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320520
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320520,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320521
					]
				},
				{
					"id": 30320521,
					"content": "Ist die Stimme verschwunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320522,
					"content": "Wer war das gerade! Warum taucht sie plötzlich auf und erschreckt uns mit ihrem Gerede ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320523
					],
					"speakerTitle": "Paimon"
				},
				{
