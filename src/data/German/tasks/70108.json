			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701080401,
					"content": "Hallo, kann ich etwas für dich tun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080402,
					"content": "Ich habe einen Brief für dich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080403
					]
				},
				{
					"id": 701080403,
					"content": "Einen Brief? ... Oh, er ist von ihr. Ich möchte wetten, sie fragt wieder nach dem nächsten Forschungstrupp ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080404,
					"content": "*seufz* Ich weiß gar nicht, was ich tun soll, man kann heutzutage selten ein Team finden, das bereit ist, den Berg zu bezwingen, es ist einfach zu gefährlich da oben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080405,
					"content": "Ich werde ihr bald einen Brief schreiben, in dem ich ihr die Lage erkläre. Danke, dass du die Reise gemacht hast, um diesen Brief zu überbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080406,
					"content": "Da wir gerade von Briefen sprechen, sie hatte kürzlich einen weiteren geschickt, in dem sie mich bat, dir eine Belohnung zukommen zu lassen. Hier, bitte nimm sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080407,
					"content": "Eine letzte Sache ... Ich sehe, dass du ziemlich kräftig bist, aber trotzdem bitte ich dich dringend, in den Bergen vorsichtig zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080410
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080410,
					"content": "Ah, der Drachengrat ... Wenn sich die Gelegenheit ergeben würde, einen Forschertrupp persönlich dorthin zu führen, würde ich sie sicher ergreifen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
