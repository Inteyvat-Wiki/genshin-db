			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Esther"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701080301,
					"content": "Hast du die Bake platziert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080302
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080302,
					"content": "Jupp.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080303
					]
				},
				{
					"id": 701080303,
					"content": "Wundervoll! Danke, jetzt bekomme ich endlich eine zuverlässige Messung der Höhe des Berges.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080304
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080304,
					"content": "Oh, und was die Vergütung angeht, ich habe Cyrus gebeten, etwas zusammenzustellen. Frage ihn danach, wenn du das nächste Mal in der Stadt bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080305
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080305,
					"content": "Und weil du ihn vor mir triffst, könntest du ihm auch diesen Brief geben? Er hat mir versprochen, mich über den zweiten Erkundungstrupp zu informieren, der sich auf den Weg in die Berge macht, aber ich habe immer noch nichts von ihm gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080306
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080306,
					"content": "Wenn der Rest meiner Baken repariert ist, werde ich wieder hochgehen und sie alle aufstellen müssen. Es gibt noch viele Dinge, die auf diesem Berg vermessen werden müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				}
			]
		},
		{
			"id": 7010804,
			"completionStepIds": [
				7010805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
