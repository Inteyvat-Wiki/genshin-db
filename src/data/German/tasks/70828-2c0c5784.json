							"7082805",
							"2"
						],
						"stepId": 7082805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280501,
					"content": "#Haha, ich danke dir, goldhaarige{M#r} Abenteurer{F#in}! Du bist wiklich mein{F#e} große{M#r} Held{F#in}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280502
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280502,
					"content": "Ich spüre bereits, wie die Inspiration in meinem Kopf zunimmt, so wie der Wind in Dvalins Ruinen, das Miasma im Chenyu-Tal und der Donner über der Insel Seirai – sie steht kurz davor, herauszubrechen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280503
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280503,
					"content": "Das klingt ziemlich gefährlich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280504
					]
				},
				{
					"id": 708280504,
					"content": "Hehe, wartet nur ab! Just in diesem Moment schreibe ich all diese Ideen auf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280505
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280505,
					"content": "Linus’ prätentiöse Verse werden dagegen abstinken! Sobald mein Meisterwerk vollendet ist, wird mein Name in allen Tavernen von Teyvat in aller Munde sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082806,
