					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280201,
					"content": "(„Das Lied von Ay-Khanoum“ überreichen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280202
					]
				},
				{
					"id": 708280202,
					"content": "Waah, was für ein wunderschönes Buch! Na gut, wollen wir doch mal schauen, was drinsteht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280203
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280203,
					"content": "„... Kein Thron steht, ohne Schlangen, die zu seinen Füßen kreuchen, keine Rose blüht, ohne Dornen, die an ihren Stengeln krallen. Trink die Bitterkeit, bis letzter Tropfen auch verschwunden, Ferigees, mit deinen süßen Augen, so versprich mir ... versprich mir ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280204
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280204,
					"content": "Ähm ... Moment, wie spricht man das noch mal aus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280205
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280205,
					"content": "#Ja, das ist mir definitiv zu tiefgründig! Ich hab ja schon ’nen Knoten in der Zunge! Ich nehme es einfach mit nach Hause und lese es später in Ruhe ... Ich danke dir, goldhaarige{M#r} Abenteurer{F#in}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082803,
			"completionStepIds": [
				7082803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082803",
							"2"
						],
						"stepId": 7082803,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_NUM_GREATER",
						"rawParams": [
							"121563",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280301,
					"content": "(„Offenbarung der heiligen Liebe“ überreichen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280302
					]
				},
				{
					"id": 708280302,
					"content": "Oh! Davon hab ich schon mal gehört. Das ist doch eine Gedichtsammlung von der Favonius-Kathedrale, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280303
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280303,
					"content": "Lass mal sehen ... „Ihre Seele, ein loderndes Feld, ein feuriges Lied, gesungen im Winde. Zwischen Sternen, Mond und der Sonne Strahlen, verbannt wird sogar mein eigen Lichte Glanz ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280304
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280304,
					"content": "Was soll denn das für ein Gedicht sein? Irgendwie ... beunruhigend. Die Favonius-Kathedrale versteht offensichtlich nicht viel von Poesie. Ich meine, Sterne, Mond und Sonne, alle zusammen? Ja klar, als ob das möglich wäre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280305
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280305,
					"content": "Nun, damit ist die Sache klar! Mein Selbstvertrauen ist zurück. Bei dem Niveau der Gedichte in diesem Buch ... das krieg ich allemal besser hin. Ich werde es kaufen. Vielen Dank!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082804,
			"completionStepIds": [
				7082804
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
