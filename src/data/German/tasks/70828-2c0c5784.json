				{
					"id": 708280601,
					"content": "#Oh! Goldhaarige{M#r} Abenteurer{F#in}! Hast du irgendwelche Liebesgedichte dabei, die es würdig sind, einem Genie wie mir Inspiration zu schenken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082807,
