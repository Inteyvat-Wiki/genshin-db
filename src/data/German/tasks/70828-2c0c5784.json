	"talks": [
		{
			"id": 7082801,
			"completionStepIds": [
				7082801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082801",
							"2"
						],
						"stepId": 7082801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280101,
					"content": "#Ah! Entschuldigung! Goldhaarige{M#r} Abenteurer{F#in}! Bitte warte mal einen Moment!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280103,
						708280104
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280103,
					"content": "Brauchst du Hilfe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280102
					]
				},
				{
					"id": 708280102,
					"content": "Oh nein, bitte versteh mich nicht falsch! Ich wollte nur fragen, ob du zufällig eine Sammlung von Liebesgedichten hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280107,
					"content": "Schau mal, ich bin eine begnadete Bardin – vielleicht sogar die begnadetste in ganz Mondstadt, gleich nach Barbatos selbst! Im Ernst, ich bin fantastisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280108
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280108,
					"content": "Aber da ist Linus ... dieser Möchtegern-Poet will einfach nicht zugeben, dass ich besser bin! Er taucht ständig auf und rezitiert mir ununterbrochen Gedichte vor! Wie man es auch dreht und wendet, er versucht ganz offensichtlich, mich zu übertrumpfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280109
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280109,
					"content": "Und das Schlimmste daran? Jedes einzelne Gedicht handelt von Liebe und Romantik ... Dinge, mit denen ich noch nie zu tun hatte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280110
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280110,
					"content": "Also werde ich die Sache selbst in die Hand nehmen. Ich werde ein Liebesgedicht schreiben, so episch, dass Mondstadt es niemals vergessen wird! Dann wird er schon sehen, was echtes Talent ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280111
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280111,
					"content": "Und da ich natürlich meine gesamte Zeit dem Streben nach wahrhaft großer Kunst gewidmet habe, hatte ich selbst noch keine Gelegenheit, die Liebe zu erfahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280112
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280112,
					"content": "Solltest du also zufällig eine Gedichtsammlung über die Liebe besitzen, würdest du sie mir dann bitte verkaufen? Ich würde sie nur kurz durchblättern. Sobald ich das getan habe, wird mich die Inspiration überkommen. Bei meinem Talent ist das praktisch unvermeidlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280104,
					"content": "Ich fürchte, da kann ich nicht helfen. Ich habe noch andere Dinge zu erledigen. Auf Wiedersehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280105
					]
				},
				{
					"id": 708280105,
					"content": "Nein, nein! Um Hilfe geht es nicht. Denn wenn jeder jedes Mal, wenn etwas schiefgeht, einen Fremden um Hilfe bittet, würde sich wohl niemand mehr trauen, zu reisen. Hab ich recht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280106
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280106,
					"content": "*räusper* Ich wollte nur fragen, ob du zufällig ein Buch mit Liebesgedichten hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082802,
			"completionStepIds": [
				7082802
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
