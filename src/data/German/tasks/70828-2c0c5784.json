				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280701,
					"content": "(„Waldluft“ überreichen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280702
					]
				},
				{
					"id": 708280702,
					"content": "Haha, „Waldluft“? Komm schon, ist das dein Ernst? Ich bin eine begnadete Bardin. Glaubst du etwa, das würde ich nicht kennen? Ich habe es unzählige Male von vorne bis hinten gelesen! Hast du denn nichts Neues?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
