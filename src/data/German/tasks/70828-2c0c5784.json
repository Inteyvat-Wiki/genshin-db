			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280401,
					"content": "(„Der Traum von Rhonabouillet“ überreichen.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280402
					]
				},
				{
					"id": 708280402,
					"content": "Oh, eine Gedichtsammlung aus Fontaine! Mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280403
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280403,
					"content": "Eine Reise in die Vergangenheit ... der Hof der Okeanidenritter ... und er verliebt sich auf den ersten Blick in ein Dienstmädchen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280404
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280404,
					"content": "Pah! Das ist ja zum Totlachen! Du hast die Möglichkeit, in die Vergangenheit zu reisen, und das Einzige, was dich interessiert, ist eine Romanze mit jemandem, der so alt ist wie deine Vorfahren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280405
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280405,
					"content": "Ach, darum geht es also. Es ist ein Liebesgedicht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280406
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280406,
					"content": "#Ha, jetzt verstehe ich. Liebe lässt die Menschen also wirklich ihren Verstand verlieren. Wie auch immer, ich werde es kaufen und später in Ruhe lesen. Ich danke dir, goldhaarige{M#r} Abenteurer{F#in}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082805,
			"completionStepIds": [
				7082805
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
