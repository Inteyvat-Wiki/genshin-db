				"points": []
			},
			"dialogs": [
				{
					"id": 751210101,
					"content": "Jemand hat mich geschickt, um nach ein paar Büchern zu suchen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210102
					]
				},
				{
					"id": 751210102,
					"content": "Du beschreibst Kuroda die vergriffenen Bücher, die Citlali haben möchte ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751210103
					]
				},
				{
					"id": 751210103,
					"content": "Die erste Ausgabe von „Wiedergeboren als Shougun Raiden mit unbegrenzter Macht“ und die limitierte Sonderausgabe von „Bitte an die Kitsune Guuji“ ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210104
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210104,
					"content": "Ich muss sagen, diese Freundin von dir ist ziemlich professionell auf diesem Gebiet. Was den Wert der Sammlung angeht, so kann nichts, was das Verlagshaus Yae derzeit herausbringt, mit den Büchern konkurrieren, die du suchst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210105
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210105,
					"content": "Es ist wirklich bedauerlich, dass ich eine solche Leserin nicht persönlich kenne ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210106
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210106,
					"content": "Sind sie noch erhältlich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210107
					]
				},
				{
					"id": 751210107,
					"content": "Nicht auf dem freien Markt, soweit ich weiß. Ich glaube nicht, dass es noch ein Geschäft gibt, das diese Bücher vorrätig hat. Sie müssen schon vor langer Zeit ausverkauft gewesen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210108
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210108,
					"content": "Allerdings habe ich zufällig ein Exemplar von jedem von ihnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210109
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210109,
					"content": "Nenn mir bitte einen Preis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210110
					]
				},
				{
					"id": 751210110,
					"content": "Nein, nein. Diese Bücher würden im Besitz deiner Freundin mehr Wert haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210111
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210111,
					"content": "Also lass mich sie dir bitte schenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuroda"
				}
			]
		}
	]
}