			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cosanzeana"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2454.509,
							245.636,
							4866.675
						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490301,
					"content": "#Du bist großartig, {NICKNAME}! Du hast diese hässliche Maschine mit nur einem „Bumm“ in wunderschöne Komponenten verwandelt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490302
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490302,
					"content": "Nun, sie werden deinen Blumengarten nicht noch einmal anrühren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490303
					]
				},
				{
					"id": 740490303,
					"content": "Einige der Blumen sind beschädigt, aber die restlichen sehen tipptopp aus. Die Rissprimusse werden deinen Blumengarten nie wieder belästigen, sodass deine Blumen wieder kräftig und gesund wachsen können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490304,
					"content": "Ausgezeichnet ... Trotzdem habe ich meine Lektion gelernt. Von nun an muss ich mich besser um meine kostbaren Blumen kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490305
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490305,
					"content": "#{NICKNAME}, Paimon ... Ihr habt mir nicht nur Blumen aus der Ferne gebracht, sondern mir auch dabei geholfen, meinen Blumengarten zu beschützen. Wie kann ich mich jemals bei euch revanchieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490306
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490306,
					"content": "Hehe, nicht der Rede wert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490307,
					"content": "Oh, mir ist da etwas eingefallen! Das sind einige meiner kostbarsten Blumen, die ich selbst gepflückt habe! Ich möchte sie euch geben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490308
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490308,
					"content": "#Ah, danke! Wenn diese Blumen wirklich so wertvoll sind, sollte {NICKNAME} vielleicht auch einen eigenen Blumengarten anlegen, um sie einzupflanzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490309,
					"content": "Apropos, sind das nicht Gezeitenalgen? Zählen sie wirklich als Blumen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490310,
					"content": "Gezeitenalgen sind Pflanzen und sind sehr schön, natürlich sind sie Blumen. Das nennen die Menschen „Biologie“. Ich habe mich ein wenig damit auseinandergesetzt, um in Zukunft eine hervorragende Blumengärtnerin zu werden. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490311
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490311,
					"content": "Paimon hat das Gefühl, dass daran etwas nicht stimmt, aber Paimon versteht auch nicht viel von Taxonomie der Pflanzen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490312,
					"content": "Auf dieses Ziel werde ich weiter fleißig hinarbeiten. Ich habe Menschen sagen hören, dass hervorragende Blumengärtner in der Lage sind, neue Blumenarten zu züchten, die sie dann zu einer „Gartenmesse“ mitbringen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490313
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490313,
					"content": "Ich möchte auch neue Blumenarten züchten und auf einer „Gartenmesse“ „Auszeichnungen“ gewinnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490314
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490314,
					"content": "Deine Motivation ist wirklich sehr lobenswert. Aber Paimon hat das Gefühl, dass es hier immer noch einige Missverständnisse gibt, die schwer zu erklären sind ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490315,
					"content": "Der Zweck der Teilnahme an einer Gartenmesse besteht darin, die neuen Blumenarten, die man gezüchtet hat, zu präsentieren und sie von Menschen bewerten zu lassen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490316,
					"content": "Aber Cosanzeanas Sinne und Ästhetik könnten sich ein wenig zu sehr von denen der Menschen unterscheiden ... Meinst du, dass Menschen ihre neu gezüchteten Blumenarten vielleicht seltsam finden würden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490317,
					"content": "Wie ich sehe, bist du sehr über ihre Karriere als Blumengärtnerin besorgt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490318
					]
				},
				{
					"id": 740490318,
					"content": "Na klar! Schließlich ist Paimon Cosanzeanas Lehrerin. Wenn sie Auszeichnungen gewinnt, lässt das Paimon auch in einem guten Licht dastehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490319,
						740490323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490319,
					"content": "Konzentriere dich nicht zu sehr auf die Auszeichnungen. Das Wichtigste ist, Spaß zu haben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490320
					]
				},
				{
					"id": 740490320,
					"content": "Ganz genau! Die einzige Person, die ihre gezüchteten Blumen schön finden muss, bist du selbst! Du brauchst dir nicht zu viele Gedanken darüber machen, was andere Leute denken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490321,
					"content": "Du musst nur gut auf deinen Blumengarten acht geben, deine schönen Blumen betrachten und immer glücklich bleiben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490322,
					"content": "Mhm! Ich werde dafür sorgen, dass sie kräftig und gesund wachsen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490323,
					"content": "Zumindest hast du den ersten Schritt zum Erfolg gemacht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490324
					]
				},
				{
					"id": 740490324,
					"content": "Ja, die neuen Sorten, die sie züchten wird, werden ziemlich einzigartig sein. Vielleicht gefallen diese sogar manchen Menschen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490325,
					"content": "Cosanzeana, wenn du mit der Züchtung deiner einzigartigen Sorten fertig bist, teil uns es unbedingt zuerst mit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490326,
					"content": "Natürlich! Schließlich habt ihr mir so viel geholfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				}
			]
		},
