			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cosanzeana"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2454.509,
							245.636,
							4866.675
						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490201,
					"content": "*schluchz* Meine kostbaren Blumen ... Sie sind ruiniert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490202
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490202,
					"content": "Oh nein, wie schade ... Deine Blumen konnten also aufgrund der Schäden, die der Rissprimus angerichtet hat, nicht wachsen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490203,
					"content": "Ich ... Ich werde von nun an neben meinen Blumen Wache halten und niemals von ihnen weichen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490204
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490204,
					"content": "Beruhige dich, Cosanzeana. Lasst uns gemeinsam über eine andere Lösung nachdenken. Apropos, warum hat der Rissprimus überhaupt Schäden an deinem Blumengarten verursacht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490205,
						740490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490205,
					"content": "Als du vorher andere Blumen mitgebracht hast ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				},
				{
					"id": 740490207,
					"content": "Nein, niemals! Hmpf, diese Blödmänner wagen so etwas nur hinter meinem Rücken. Oh, jetzt bin ich richtig wütend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490208
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490208,
					"content": "Waah, Paimon hätte nicht erwartet, dass Cosanzeana auch wütend werden könnte. Ihr liegen diese Blumen wirklich sehr am Herzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490209,
					"content": "Aber wenn Paimon jetzt so zurückdenkt, war es nicht so, dass der Rissprimus weggelaufen ist, als Cosanzeana ihnen näher kam ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490210,
					"content": "Vielleicht sind es nicht die Blumen, die Rissprimusse anziehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490211
					]
				},
				{
					"id": 740490211,
					"content": "Ja, das könnte gut sein. Lasst uns mal die Umgebung des Blumengartens absuchen und sehen, was wir finden können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490206,
					"content": "... hat irgendein Rissprimus Ärger verursacht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				}
			]
		},
		{
			"id": 7404903,
			"completionStepIds": [
				7404908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
