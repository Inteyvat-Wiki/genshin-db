			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Cosanzeana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740490101,
					"content": "#Ah, {NICKNAME} und Paimon, die Bringer der Blumen aus der Ferne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490102
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490102,
					"content": "Hallo, Cosanzeana. Wachsen die Blumen, die wir mitgebracht haben, gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490103,
					"content": "Ähm, was das angeht ... Ich war den ganzen Tag nicht in meinem Blumengarten, um mich um sie zu kümmern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490104
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490104,
					"content": "Hä? Haben dir die Blumen nicht gefallen? Warum kümmerst du dich nicht um sie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490105,
					"content": "Es war so schwer für mich, Blumen aus der Ferne zu bekommen, deshalb möchte ich mich so sehr darum kümmern. Aber als ich daran dachte, dass sie vor meinen Augen verdorren könnten, hatte ich nicht den Mut, zu gehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490106
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490106,
					"content": "Oh, du machst dir wirklich große Sorgen ... Lasst uns gemeinsam einen Blick auf die Blumen werfen! Wenn etwas Schlimmes passiert, helfen wir dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490107,
					"content": "Es gibt keinen Grund, sich zu viele Sorgen zu machen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490108
					]
				},
				{
					"id": 740490108,
					"content": "... Ihr habt recht. Dann gehen wir zusammen! Mit eurer Hilfe habe ich das Gefühl, dass wir es schaffen werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				}
			]
		},
		{
			"id": 7404902,
			"completionStepIds": [
				7404905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
