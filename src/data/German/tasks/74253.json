				"objectNames": [
					"Mary-Ann"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742530201,
					"content": "Das Leben ist am schönsten, wenn alles friedlich und ruhig ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530202,
						742530203
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530202,
					"content": "(Lass uns noch ein Weilchen so sitzen bleiben.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530204,
					"content": "Ist es schon so spät? Haha. Wir sollten uns öfter treffen, Fräulein Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530203,
					"content": "Ich glaube, es wird Zeit, dass ich mit dem Aufräumen anfange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
}