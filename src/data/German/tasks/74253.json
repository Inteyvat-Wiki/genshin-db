			"dialogs": [
				{
					"id": 742530101,
					"content": "Ehrlich gesagt stehe ich immer noch unter Schock.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530102,
					"content": "Weißt du, Alain und ich dachten damals beide, dass du diese Welt schon verlassen hättest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530103
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530103,
					"content": "Hmm ... Wenn wir früher aufgewacht wären, hätten wir dich und Alain vielleicht besuchen können. Aber ich schätze, das ist Schicksal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530104
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530104,
					"content": "Fräulein Mary-Ann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530105
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530105,
					"content": "Das Schicksal geht seltsame Wege. Wer hätte gedacht, dass Ann und ich auf unseren Reisen ein Filmposter mit deinem Porträt sehen würden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530106
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530106,
					"content": "Das hat euch also auf die Idee gebracht, mich zu kontaktieren?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530107,
					"content": "Exakt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530108
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530108,
					"content": "Ah ... Der Duft von Kaffee. Das weckt wirklich Erinnerungen ... Hehe, danke, dass du uns zu deiner Teegesellschaft eingeladen hast, Fräulein Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530109
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530109,
					"content": "Dein Garten ist so elegant gestaltet. Er ist perfekt für eine Dame von solcher Anmut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530110
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530110,
					"content": "Das ist das Zuhause, in dem Alain und ich einst zusammengelebt haben. Ich finde es nur richtig, dass ich seine Schönheit bewahre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530111,
					"content": "Siehst du? Du bist darin schon viel besser als mein Bruder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530112
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530112,
					"content": "Alain hat sein Zimmer nicht einmal dekoriert. Er konnte mit hübschen Dingen nichts anfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530113
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530113,
					"content": "Das stimmt, und René war da nicht anders. Jakob und ich waren die Einzigen, die ein Zimmer richtig dekorieren und eine Teegesellschaft vorbereiten konnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530114
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530114,
					"content": "Er war also schon als Kind so? Ich dachte immer, das liegt an seinem Alter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530115,
					"content": "Er war schon immer so. Er war zwar sehr schlau, aber in anderen Dingen ein bisschen ungeschickt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530116
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530116,
					"content": "Vielleicht war er deshalb der Einzige von uns, der sich für die schmerzhafte Realität statt für die Illusion eines süßen Traums entschieden hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530117
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530117,
					"content": "Ich glaube nicht, dass er diese Entscheidung bereut hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530118,
					"content": "Nein, denn das war sein Wunsch als Held.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530119
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530119,
					"content": "Das Bedauern liegt bei uns. Sein Wunsch hätte niemals allein dastehen dürfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530120
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530120,
					"content": "Was ist mit dir, Fräulein Sandrone? Gibt es etwas, das du dir wünschst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530121
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530121,
					"content": "Alain hat mir einmal genau dieselbe Frage gestellt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530122
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530122,
					"content": "Hmm? Das hat er dich also auch gefragt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530123
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530123,
					"content": "Mein Bruder muss viel reifer geworden sein. Als ich ihn noch kannte, hätte er so etwas nie gefragt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530124
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530124,
					"content": "„Wünschen“ ist so ein leeres Wort. Kann man jemals alles haben, was man will? Ha, wenn das so wäre, gäbe es nichts Böses auf der Welt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530125
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530125,
					"content": "Ich tue, was ich tun möchte und was ich für richtig halte. Ich weiß nicht, ob das als Wunsch zählt, aber es macht mich glücklich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530126
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530126,
					"content": "Hmm, das ist wirklich eine wunderbare Sache. Ich beneide dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530127
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530127,
					"content": "Nimmst du es Alain dann ... übel? Weil er dich ... nach Mary-Anns Vorbild erschaffen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530128
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530128,
					"content": "Niemals. Er hat immer klargemacht, dass ich eine eigenständige Person bin, einzigartig und unverwechselbar, und dass ich über mein eigenes Leben entscheiden soll. Also habe ich genau das getan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530129
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742530129,
					"content": "Haha, egal ob es um Geschichten oder Essen geht, solange du mit deinen Entscheidungen glücklich bist, sind es die richtigen Entscheidungen für dich, Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530130
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530130,
					"content": "Genau. Also lass uns jetzt einfach in Ruhe das Essen genießen, das du so sorgfältig für uns zubereitet hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				}
			]
		},
