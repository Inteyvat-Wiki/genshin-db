					}
				]
			},
			"dialogs": [
				{
					"id": 747000101,
					"content": "Hehe, Paimon hat einen Riesenspaß dabei, dieses Aquarium zu füllen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000102,
					"content": "Da Sandrone nichts dagegen hat, sollten wir unbedingt noch ein paar Fischlein fangen und es hier richtig hübsch machen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000103,
					"content": "He, ihr zwei. Kommt mal her.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000104
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000104,
					"content": "Hä? Ist alles in Ordnung ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000105,
					"content": "Hier, das ist für dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000106
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000106,
					"content": "... Was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000107,
					"content": "Das ist ein Gerät zur Fortbewegung unter Wasser, an dem ich gearbeitet habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000108
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000108,
					"content": "Was?! Oooh, das ist echt nett von dir, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000109,
					"content": "Das ist nur ein einfaches mechanisches Gerät. Ich habe gesehen, wie du Fische fängst, und, wie soll ich das sagen ... Es hatte etwas ... Unbeholfenes. Um ganz ehrlich zu sein, fiel es mir ziemlich schwer, dabei zuzusehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000110,
					"content": "W... War es wirklich so schlimm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000111,
					"content": "Es war ineffizient, ungeschickt und völlig und absolut unelegant.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000112,
					"content": "Es tut mir leid, dass wir dir das zugemutet haben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000113
					]
				},
				{
					"id": 747000113,
					"content": "Ihr müsst euch nicht entschuldigen. Jeder macht die Dinge auf seine eigene Art. Aber da ihr vorhabt, das Aquarium noch weiter zu füllen, solltet ihr am besten dieses Gerät benutzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000114
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000114,
					"content": "In den Gewässern von Fontaine leben nicht nur harmlose Zierfische. Es gibt dort auch viele Raubtiere, die euch ernsthaft verletzen könnten. Dieses Gerät hilft euch nicht nur beim Fischen, sondern auch beim Fliehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000115,
						747000116
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000115,
					"content": "Vielen Dank.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				},
				{
					"id": 747000117,
					"content": "Alles klar. Wenn du schwimmen gehen willst, geh am besten jetzt. Und vergiss nicht, mir zu sagen, was du von dem Gerät hältst. Ich kann jederzeit noch Anpassungen vornehmen, falls du Verbesserungsvorschläge hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747000116,
					"content": "Ich bin mir sicher, dass es sehr hilfreich sein wird.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				}
			]
		}
	]
}