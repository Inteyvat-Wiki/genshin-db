				"points": []
			},
			"dialogs": [
				{
					"id": 200620201,
					"content": "Hast du die Holzpfähle gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620202
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620202,
					"content": "Ja, ich habe sie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620203
					]
				},
				{
					"id": 200620203,
					"content": "Oh, haha! Wie toll, die sehen richtig stabil aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620204
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620204,
					"content": "Wenn diese Holzpfähle es aushalten, von Hilichurlen bearbeitet zu werden, werden sie auch für Ellin ausreichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620205
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620205,
					"content": "Danke! Ach, stimmt ja. Hier hast du deine Belohnung. Ich kenne doch die Regeln der Abenteurer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
		{
			"id": 2006203,
			"completionStepIds": [
				2006207
