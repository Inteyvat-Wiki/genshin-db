			},
			"dialogs": [
				{
					"id": 200620601,
					"content": "Diese Holzpfähle sind gar nicht übel. Das erleichtert mein Training ganz bestimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620602
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620602,
					"content": "Aber woher hat Papa solche stabilen Holzpfähle herbekommen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620603
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620603,
					"content": "Die hat er doch hoffentlich nicht gekauft! Das kostet sicher ein Vermögen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
