			"dialogs": [
				{
					"id": 200620401,
					"content": "Hast du die Holzpfähle gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620402
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620402,
					"content": "Noch nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620403
					]
				},
				{
					"id": 200620403,
					"content": "Ellin ist fleißig am Trainieren. Ich kann leider nicht mehr für sie tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620404
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620404,
					"content": "Wenn ich noch ein Abenteurer wäre, könnte ich die Pfähle selbst besorgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620405
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620405,
					"content": "Und wenn ich mir so die Abenteurergilde von Mondstadt ansehe ... Meine alten Bekannten dort sind schon lange nicht mehr in dem Geschäft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620406
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620406,
					"content": "Da kann man nichts machen. In einer Stadt mit einer Organisation wie dem Ordo Favonius wollen alle jungen Leute natürlich Ritter werden. Leute, die allein auf Abenteuer gehen, gibt es da selten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620407
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620407,
					"content": "Kaum einer hat mehr Lust auf sowas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
		{
