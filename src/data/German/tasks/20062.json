			"dialogs": [
				{
					"id": 200620301,
					"content": "Hast du die Holzpfähle gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620302
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620302,
					"content": "Schon, aber ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620303
					]
				},
				{
					"id": 200620303,
					"content": "Ha! Du bist wohl etwas zu stürmisch an die Sache gegangen. Selbst so stabile Holzpfähle hast du zermörsert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620304
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620304,
					"content": "Während eines Kampfes ist es natürlich schwierig, auf einen Holzpfahl aufzupassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620305
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620305,
					"content": "So können wir das Ellin zwar nicht geben ... Aber wenigstens haben wir die Materialien da. Ich werde sie erst bearbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620306
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620306,
					"content": "Hier, das müsste doch gehen ... Na ja, etwas dürftig vielleicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620307
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620307,
					"content": "Danke jedenfalls. Hier ist deine Belohnung. Du sollst das ja nicht alles umsonst gemacht haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620308
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620308,
					"content": "Ich bin zwar kein Abenteurer mehr, aber ich kenne immer noch die Regeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
		{
