			"trigger": {
				"objectNames": [
					"Herman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200620101,
					"content": "Was soll ich nur tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620102
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620103
					]
				},
				{
					"id": 200620103,
					"content": "Es ist nur, dass meine Tochter Ellin dem Ordo Favonius beitreten will und sich gerade auf die Ritterauswahl vorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620104
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620104,
					"content": "Ich wollte ihr eigentlich selbst helfen. Sie will aber einfach nicht glauben, dass ich in jungen Jahren auch mal Abenteurer gewesen bin, und will allein trainieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620105
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620105,
					"content": "Ich kann es ihr ja auch nicht mehr beweisen ... Mit Frau und Kind habe ich schließlich keine Gelegenheit mehr, überall auf Abenteuer zu gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620106
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620106,
					"content": "Meine Pflicht ist es nicht, meine Abenteuerlust zu befriedigen, sondern ordentlich auf meine Familie aufzupassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620107
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620107,
					"content": "Haha! Dieser Abenteurer hier hat aber sicher noch das Ein oder Andere drauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620108
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620108,
					"content": "Mir sind damals die Holzpfähle aufgefallen, mit denen die Hilichurle trainiert haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620109
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620109,
					"content": "Sie scheinen ziemlich stabil zu sein und eignen sich bestimmt gut für Ellins Training.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620110
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620110,
					"content": "Bring mir einfach ein paar Holzpfähle, wie sie die Hilichurle für ihre Übungen benutzen. Wie es die Regeln für Abenteurer vorschreiben, werde ich dich natürlich dafür entlohnen. Was hältst du davon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620111,
						200620112
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620111,
					"content": "Ja, sicher doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620113
					]
				},
				{
					"id": 200620113,
					"content": "Ach, ich mag Menschen wie dich. Erfrischend! Du erinnerst mich an mich, als ich noch jung war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620114
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620114,
					"content": "Ha, ich mach doch nur Spaß. Nun geh schon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620112,
					"content": "Wenn es um Hilichurle geht, kannst du doch sicher auch selbst ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620115
					]
				},
				{
					"id": 200620115,
					"content": "Nein, das geht wirklich nicht. Auch ein Abenteurer hat seine Grenzen und kann sich nicht gleichzeitig um so viele Dinge kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620116
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620116,
					"content": "Die Ehe ist ein Abenteuer für sich ... Selbst die größten Abenteurer müssen dort ihr Bestes geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620117
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620117,
					"content": "Deswegen hoffe ich, dass du die Holzpfähle besorgen kannst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
		{
			"id": 2006202,
			"completionStepIds": [
				2006204
