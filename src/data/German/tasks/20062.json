					"Ellin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200620501,
					"content": "Wie sollte ich am besten trainieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620502
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620502,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620503
					]
				},
				{
					"id": 200620503,
					"content": "Oh, ich trainiere gerade für die Ritterauswahl. Ich habe aber noch nicht so richtig das Gefühl, dass es etwas bringt. Ich denke, ich brauche jemanden, der mir hilft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620504
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620504,
					"content": "Mein Vater sagt zwar, dass er mal Abenteurer gewesen wäre und mir deswegen helfen könnte. Das heißt aber nicht, dass ich ihm das auch abkaufe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620505
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620505,
					"content": "Wie soll er mir denn in seiner Verfassung helfen, mich für die Ritterauswahl vorzubereiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620506
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620506,
					"content": "Außerdem wollte er mir noch Trainingsmaterial zur Verfügung stellen. Ich weiß überhaupt nicht, wovon er da geredet hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
		{
			"id": 2006206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
