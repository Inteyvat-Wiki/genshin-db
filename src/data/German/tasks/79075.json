				"points": []
			},
			"dialogs": [
				{
					"id": 790750201,
					"content": "Ich muss hier Ordnung machen und für Chauvigne den besten Platz für ein Sonnenbad suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750202
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750202,
					"content": "Ich vertraue euch die Aufgabe an, Chauvigne zu überzeugen, liebe Gäste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750203
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750203,
					"content": "Wenn ich zu ihm gehe, könnte er mich für allzu betulich halten und würde gleich wieder missmutig werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				}
			]
		},
