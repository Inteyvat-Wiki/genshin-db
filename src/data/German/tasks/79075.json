			"dialogs": [
				{
					"id": 790750401,
					"content": "Chauvigne! Du ... Du bist hier. Hör zu, ich war nie wütend auf dich und will auch nicht weg von dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750402
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750402,
					"content": "Ich hatte nur Angst, dass du nicht mehr mein Freund sein wolltest. Einige Abenteurer verändern sich, und ich fürchte, dass es bei dir auch so sein könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750403
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750403,
					"content": "Ich wandte mich mit dem Wunsch an die Göttin, aber ... ich fand kein gutes Geschenk, also schenkte sie mir keine Beachtung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750404
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750404,
					"content": "Nein! Panuelle, das wird niemals passieren. Ich werde immer dein Freund sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750405
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750405,
					"content": "Ich möchte mich bei dir entschuldigen. Ich war so in meine eigenen Gedanken vertieft, dass ich vergessen habe, dir zuzuhören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750406
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750406,
					"content": "Ich glaubte ... Ich glaubte, du könntest mich in diesem Zustand nicht mehr ertragen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750407
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750407,
					"content": "Na dann hätten wir das Missverständnis ja aufgeklärt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750408
					]
				},
				{
					"id": 790750408,
					"content": "Ja, Paimon dachte, ihr hättet riesigen Krach gehabt und wärt total wütend aufeinander, sodass ihr nichts mehr miteinander zu tun haben wolltet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750409,
						790750410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750409,
					"content": "Solche Konflikte sind zwar schwer zu überwinden,",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750411
					]
				},
				{
					"id": 790750411,
					"content": "Ich danke euch beiden, meine lieben Gäste. Wärt ihr nicht gewesen, würde ich mich wohl immer noch verkriechen und nicht herauskommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750412
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750412,
					"content": "Jetzt kann ich Panuelle endlich alles sagen, was mir auf dem Herzen liegt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750413
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750413,
					"content": "Ich habe jederzeit ein Ohr für dich, Chauvigne. Ob es um Reisen geht oder um Blumentöpfe ... ich höre alles gern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750414
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750414,
					"content": "Ach ja, ihr zwei. Nehmt die hier bitte an, ich habe sie extra für euch gesammelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750415
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750415,
					"content": "Möge die Göttin euch schützen, damit ihr nie Streit mit euren Freunden habt und immer jemand da ist, mit dem ihr eure Gedanken teilen könnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750410,
					"content": "doch umso schönes ist es, eine Lösung dafür zu finden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750411
					]
				}
			]
		}
	]
