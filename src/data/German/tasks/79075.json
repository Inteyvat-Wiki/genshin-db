					}
				]
			},
			"dialogs": [
				{
					"id": 790750301,
					"content": "Puh ... Endlich hat der Wind aufgehört ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750302,
						790750303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750302,
					"content": "Bitte, hör uns zu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750304
					]
				},
				{
					"id": 790750304,
					"content": "Na gut, ich werde euch zuhören. Aber vorher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750305
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750305,
					"content": "Die Überraschung steht euch ins Gesicht geschrieben. Ihr wollt mich bestimmt fragen: „Wie kann es sein, dass eine Blume sprechen kann?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750306
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750306,
					"content": "Oder vielleicht: „Warum hast du dich in eine Blume verwandelt?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750307
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750307,
					"content": "Bekommst du die Frage denn oft?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750308
					]
				},
				{
					"id": 790750308,
					"content": "Ja, draußen werde ich das oft gefragt. Zu Hause aber ... bisher nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750309
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750309,
					"content": "Mit „draußen“ meinst du außerhalb dieser Welt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750310,
					"content": "Ich hörte, dass du erst nach deiner Reise so geworden bist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750311
					]
				},
				{
					"id": 790750311,
					"content": "Du bist ja bestens informiert. Das hat dir bestimmt Panuelle erzählt, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750312
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750312,
					"content": "Richtig, ich bin auf meinen Reisen so geworden. Hehe, wie Rozel zu sagen pflegt ... das war meine selbst gewählte „Veränderung“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750313
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750313,
					"content": "Veränderung kann man ja verstehen, aber warum sich in eine Topfblume verwandeln?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750314,
						790750315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750314,
					"content": "Doch nicht, weil du so vernarrt in Pflanzen bist, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750316,
					"content": "Nein, ich wollte einfach nur meinen „Platz“ finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750317
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750317,
					"content": "Ich habe viele Menschen außerhalb dieser Welt getroffen. Einige waren Köche, andere Floristen, wieder andere Lehrer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750318
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750318,
					"content": "Fast alle hatten einen „Platz“ gefunden, an dem sie sich wohlfühlten. Das ist notwendig, um im Leben Fuß zu fassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750319
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750319,
					"content": "Und ich? Ich bin nur gut darin, herumzureisen, und habe nie daran gedacht, mir einen festen „Platz“ zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750320
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750320,
					"content": "Dieser Blumentopf ist also dein „Platz“.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750321
					]
				},
				{
					"id": 790750321,
					"content": "So ist es. Du hast das schnell verstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750322
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750322,
					"content": "Als Blume im Blumentopf habe ich immer einen „Platz“, der mir Geborgenheit bietet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750323
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750323,
					"content": "Aber ... *seufz* Wenn ich nun schon einen Topf und meinen festen „Platz“ habe, warum sollte ich dann noch in die Ferne schweifen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750324
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750324,
					"content": "Dennoch bin ich ein Abenteurer. Ohne das Reisen, was bliebe mir dann noch von Bedeutung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750325
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750325,
					"content": "Ich begreife es nicht. Je mehr ich von der Welt da draußen sehe, umso weniger verstehe ich ... Was ist wichtiger, ein fester „Platz“ oder das Reisen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750326
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750326,
					"content": "Je mehr ich darüber nachdenke, umso mehr schmerzt mein Kopf ... Wenn Panuelle mit mir plaudert, gehe ich auch nie auf seine Fragen ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750327
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750327,
					"content": "Ich habe Angst, Panuelle in die Irre zu führen. Was ist, wenn er früher gerne gereist ist, dann aber die Lust am Reisen verloren hat, weil er mich in dieser Gestalt gesehen hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750328
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750328,
					"content": "Aber Panuelle ist mein Freund, und wird es immer bleiben. Ich muss ehrlich zu ihm sein. Alle Fragen, die er mir gestellt hat, habe ich beantwortet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750329
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750329,
					"content": "Dazu gehört auch, dass der Grund, weshalb ich eine Pflanze geworden bin, ist, weil ich einen sicheren „Platz“ suchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750330
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750330,
					"content": "Vielleicht war es ja diese Antwort, die Panuelle so sehr verletzte ... oder vielleicht gefiel ihm einfach mein jetziger Anblick nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750331
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750331,
					"content": "Wir haben uns mit der Zeit auseinandergelebt, und ich als Topfblume bin allein nicht in der Lage, dort hinaufzukommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750332
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750332,
					"content": "Aber so ist es auch gut. Panuelle will mich eben nicht sehen, er wird wohl wütend auf mich sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750333
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750333,
					"content": "Oh ... So ist das also. Ihr denkt beide: „Er ist sauer auf mich.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750334,
					"content": "Und genau deshalb wollen sie sich nicht sehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750335
					]
				},
				{
					"id": 790750335,
					"content": "Was? Du ... Du meinst, Panuelle ist mir gar nicht böse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750336,
						790750337
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750336,
					"content": "Ihr beide hegt genau die gleichen Gedanken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750338,
					"content": "Ihr erzählt Chauvigne alles über Panuelles Gedanken ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790750339
					]
				},
				{
					"id": 790750339,
					"content": "Meine Güte, wie konnte ich nur so denken? Ich wollte doch nie sehen, dass er traurig ist. Selbst wenn sich nur seine Mundwinkel senken, bricht es mir das Herz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750340
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750340,
					"content": "Bitte! Bitte bringt mich nach oben. Ich flehe euch an! Ich muss so schnell wie möglich zu Panuelle, ich halte es keine Sekunde länger aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750341
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750341,
					"content": "Ich habe darauf gewartet, dass du das sagst, mein getöpferter Freund.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750342
					]
				},
				{
					"id": 790750342,
					"content": "#Hehe, das wollten wir hören! Gehen wir los, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750337,
					"content": "Er denkt nämlich, dass du wütend auf ihn bist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750315,
					"content": "Träumst du davon, ein Botaniker zu werden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750303,
					"content": "Panuelle möchte dir etwas sagen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750304
					]
				}
			]
		},
		{
