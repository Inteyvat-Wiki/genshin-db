				]
			},
			"dialogs": [
				{
					"id": 790750101,
					"content": "Was denkt sich Chauvigne eigentlich? *seufz* Er will einfach nicht mit mir reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750102
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750102,
					"content": "Über Chauvigne ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750103
					]
				},
				{
					"id": 790750103,
					"content": "Hallo, ihr zwei. Es tut mir leid ... Chauvigne ist bestimmt immer noch böse auf mich und will deshalb nicht mit mir sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750104
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750104,
					"content": "Ach, dort unten erreichen ihn weder Wind noch Sonne. Was, wenn er verwelkt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750105
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750105,
					"content": "Ähm ... Wenn er eine Topfpflanze ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750106,
					"content": "Wir können ihn einfach hierhernehmen, oder?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750107
					]
				},
				{
					"id": 790750107,
					"content": "Das habe ich schon versucht. Aber Chauvigne war ständig wütend. Ich konnte mich ihm nicht einmal nähern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750108
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750108,
					"content": "Er war so aufbrausend, dass ich beinahe weggeweht wurde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750109
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750109,
					"content": "Moment mal, wie kann man jemanden wegblasen, nur weil man wütend ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750110,
						790750111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750110,
					"content": "Wütend wie ein Sturm, ich verstehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				},
				{
					"id": 790750112,
					"content": "Vielleicht ist Chauvigne so wütend auf mich, weil ich mich weigerte, mit ihm reisen zu gehen. Das hat ihn geärgert ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750113
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750113,
					"content": "Darf ich euch bitten, Chauvigne einen Besuch abzustatten? Wer weiß, vielleicht könnt ihr ihn überreden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750114
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750114,
					"content": "Kein Problem, wir versuchen es einfach.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750115
					]
				},
				{
					"id": 790750115,
					"content": "Ja! Wir sind schon an so viele Orte gereist und haben viele Leute gesehen, bestimmt ... vielleicht können wir ihn überzeugen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750116,
					"content": "Das wäre wunderbar! Chauvigne ist in der Höhe unterhalb dieser Insel. Bitte geht hin und redet mit ihm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750117
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750117,
					"content": "Ich muss hier Ordnung machen und für Chauvigne den besten Platz für ein Sonnenbad suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750111,
					"content": "So ist es wirklich schwierig, sich zu nähern ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				}
			]
		},
