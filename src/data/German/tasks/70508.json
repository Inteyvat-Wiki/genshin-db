				"points": []
			},
			"dialogs": [
				{
					"id": 705080201,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080203,
					"content": "Sagt was! Das macht Paimon nervös!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080204,
					"content": "Hmmm ... Was für ein Geschmack der Erinnerung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080205
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080205,
					"content": "Der Geschmack, aus nichts alles zu machen? Was für ein Geschmack muss das sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080206
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080206,
					"content": "Hehe ... Es ist hauptsächlich sauer mit einem Hauch von Süße und einem lang anhaltenden Nachgeschmack.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080207,
					"content": "Interessant ... Schmeckt das so, wie wenn man ein kleines Unternehmen gründet und dann feststellt, dass der Verkauf von Obst nicht sehr lukrativ ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080208
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080208,
					"content": "Wir brauchen nicht ins Detail zu gehen. Lass die Vergangenheit ruhen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080209
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080209,
					"content": "Haha, wer hätte gedacht, dass der würdevolle Tianquan einmal eine Obstverkäuferin auf der Straße war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080210
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080210,
					"content": "Andererseits können wohl nur wenige erkennen, dass ich aus einem gewöhnlichen Fischerdorf komme, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080211
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080211,
					"content": "Nicht unbedingt. Wenn du mich fragst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080212
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080212,
					"content": "Kapitän Beidous Augen, die durch das Meer sehen, und ihr Eifer, auf den Wellen zu reiten, waren immer wie die eines Menschen, der am Meer lebt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080213
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080213,
					"content": "He, du machst dich doch nicht über mich lustig, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080214
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080214,
					"content": "Komm schon, es bringt mir nichts, sarkastisch zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080215
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080215,
					"content": "Ich weiß, wie heftig du mit Worten umgehen kannst. Heute geht das alles hier auf mich, also hab Nachsicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080216
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080216,
					"content": "Gut, dann will ich ein paar Becher mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080217,
						705080218
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080217,
					"content": "Mehr?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080218,
					"content": "Jawohl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080219
					]
				},
				{
					"id": 705080219,
					"content": "Nun, du hast die gute Dame gehört, noch ein paar Becher mehr bitte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080220,
					"content": "Ich werde auch noch einen nehmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080221
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080234,
					"content": "Du füllst die Becher für beide sofort nach ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 705080221,
					"content": "Die Säfte von Mondstadt sind so gut, dass man sie am liebsten jeden Tag trinken würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080222
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080222,
					"content": "Hm? Machst du Witze? Erzähl mir nicht, dass du eine spezielle Dämmerfrucht-Handelsroute eröffnen willst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080223
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080223,
					"content": "Hmm, ein interessanter Vorschlag.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080224
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080224,
					"content": "Oh? Wirklich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080225
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080225,
					"content": "Das ist nur ein Scherz. Der betreffende Handel wird schon seit Langem in einem bestimmten Umfang betrieben, ohne dass ich dazu beigetragen habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080226
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080226,
					"content": "#Danke für die Getränke heute, {NICKNAME}. Wenn du jemals eine bequeme Arbeit haben möchtest, würde ich dich gern als {F#meine persönliche Wirtin}{M#meinen persönlichen Wirt} haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080227
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080227,
					"content": "Oder du kannst an Bord der Alcor kommen. Wir trinken alle gern, und wenn du vorbeikommst, kannst du gemeinsam trinken und essen, das wird uns garantiert viel Spaß machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080228
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080228,
					"content": "#Konkurriert Kapitän Beidou etwa mit mir um Talente? Warum tust du das? Wenn du ein Getränk trinken willst, das {F#die}{M#der} Reisende selbst gemacht hat, komm einfach zum Jadegemach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080229
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080229,
					"content": "(Ich bin beliebt!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080230
					]
				},
				{
					"id": 705080230,
					"content": "Sie scheinen darüber zu streiten, zu wem du gehen wirst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080231,
						705080232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080231,
					"content": "Wenn die Gelegenheit besteht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705080232,
					"content": "Besuchen wir euch beides, beides ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}