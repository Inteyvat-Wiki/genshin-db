			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705080101,
					"content": "#Oh! Nun, wenn das nicht {NICKNAME} ist! Du kommst gerade richtig. Warum setzt du dich nicht und trinkst etwas?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080102
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080102,
					"content": "Es ist eine Freude, dich hier zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080103,
					"content": "Was macht ihr hier?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080104
					]
				},
				{
					"id": 705080104,
					"content": "Moment, ihr seid doch nicht zusammen hier, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080105,
					"content": "Ihre Exzellenz hier entschied sich aus einer Laune heraus für einen Besuch in der Region, als sie sagte, sie wolle einen wohlverdienten Urlaub machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080106,
					"content": "Aber wir scheinen nicht das gleiche Verständnis von Reisen zu haben. Wir haben noch nicht einmal ein paar Berge bestiegen und sind hierhergekommen, um uns auszuruhen ... Eine wahre Krankheit der Reichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080107
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080107,
					"content": "Das ist eine traurige Feststellung. Ich setze mich für dich ein und suche mir Orte aus, an denen man trinken kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080108
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080108,
					"content": "Es ist schade, dass der Kapitän so viel gesehen hat und so viel über diese Taverne zu meckern hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080109
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080109,
					"content": "Gut, die Runde geht auf mich, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080110
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080110,
					"content": "Beidou lädt ein? Sind wir dabei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080111,
					"content": "Paimon, wir sind die Wirte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080112
					]
				},
				{
					"id": 705080112,
					"content": "Oh, stimmt, alte Gewohnheit ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705080113,
					"content": "Was darf ich euch bringen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705080114
					]
				},
				{
					"id": 705080114,
					"content": "Gib mir einen kleinen Becher Birke. Es sollte besser säuerlich sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080115
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 705080115,
					"content": "Einen großen Becher Abenddämmerung, danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705080116
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 705080116,
					"content": "Alles klar, einen Moment.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7050802,
