				"points": []
			},
			"dialogs": [
				{
					"id": 710960101,
					"content": "Habt ihr einen „Altstein“ gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960102,
					"content": "Hier sind sie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109602,
			"completionStepIds": [
				7109602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109602",
							"2"
						],
						"stepId": 7109602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710960201,
					"content": "Drei weitere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960202
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960202,
					"content": "Ich werde die „Altsteine“ nehmen, die von euch beiden „begeisterten Bürgern“ eingereicht wurden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960203
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960203,
					"content": "Ich hatte nicht erwartet, dass ich so schnell drei finden würde, und sie waren von viel höherer Qualität als die, die ich zuvor gesehen hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960204
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960204,
					"content": "Haha ... Das erinnert mich an den, den ich mal hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960205
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960205,
					"content": "Den du mal hattest?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960206,
						710960207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710960206,
					"content": "Du hast einen und lässt uns dennoch suchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				},
				{
					"id": 710960208,
					"content": "Es ist der, den ich vorher hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960209
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960209,
					"content": "Mein Vater war in der Shenglu-Kammer und der „Altstein“ war ein kleines Stück Überbleibsel, das in seine Hände kam und sich in keinem guten Zustand befand, also gab er ihn mir als Spielzeug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960210
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960210,
					"content": "Ich hatte jeden Tag Streit mit ihm. Ohne eine Anstellung lungerte ich die meiste Zeit in der Teestube Yanshang herum, schuldete eine Menge Geld und war verzweifelt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960211
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960211,
					"content": "Ah ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710960212,
					"content": "Das ist schlimm ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960213
					]
				},
				{
					"id": 710960213,
					"content": "Nun, jeder war mal jung, aber als ich verzweifelt war ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960214,
					"content": "Da lernte ich jemanden kennen, der bereit war, Geld für den „Altstein“ zu bezahlen. Es war doch nur ein Stein. Was sollte es schon machen, wenn ich ihn verkaufte? Ein bisschen Mora könnten die Sorgen lindern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960215
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960215,
					"content": "Das Ergebnis ist jedoch, dass mein Vater vor einigen Tagen gefragt hat, wo denn der Stein, mit dem ich immer gespielt hatte, sei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960216
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960216,
					"content": "Ich sagte nur „Es war doch nur ein kleiner Stein. Wieso sollte ich ihn nach so langer Zeit noch haben?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960217
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960217,
					"content": "Das sagte ich, aber in meinem Herzen dachte ich, wenn ich den Stein nicht verkauft hätte, hätte ich ihm den Stein gezeigt, als er darüber sprach ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960218
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960218,
					"content": "... Egal. Darüber nachzudenken, bringt ja auch nichts.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960219
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960219,
					"content": "Es geht doch, wenn du dich jetzt ändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710960220,
					"content": "Du hast recht ... Nur muss das Geld, das ich früher geschuldet habe, immer noch Schritt für Schritt zurückgezahlt werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960221
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960221,
					"content": "Ich bin abgeschweift. Wenn du noch mehr findest, bring sie bitte zu mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960222,
						710960223
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960222,
					"content": "Ist das noch nicht genug?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960224,
					"content": "Bring mir noch drei. Drei weitere wären genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960225
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960225,
					"content": "Altsteine sind ein seltenes Mineral. Sollte die Huishan-Kammer mehr davon wünschen, ist es allerdings unwahrscheinlich, dass in der Großen Kluft noch weitere gefunden werden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				},
				{
					"id": 710960223,
					"content": "Wie viel brauchst du wirklich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960224
					]
				},
				{
					"id": 710960207,
					"content": "Komm, zeig deinen eigenen erst einmal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710960208
					]
				}
			]
		}
	]
}