			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Marionette"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762180101,
					"content": "Oh? Da seid ihr ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180102
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180102,
					"content": "Hallo, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180103,
						762180104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180103,
					"content": "Danke für die Einladung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				},
				{
					"id": 762180105,
					"content": "Hä? Stand in deinem Brief nicht, dass wir eine Teegesellschaft veranstalten? Warum ist hier denn gar nichts? Sag Paimon bloß nicht, dass das hier ein Treffen ohne Snacks ist?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180106,
					"content": "Ha, ich wette, das würde dir gefallen, Paimon? Glaubst du wirklich, ich würde das Essen vergessen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180107
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180107,
					"content": "Waah! Ist ... Ist dieser Tisch gerade aus dem Nichts aufgetaucht?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180108,
					"content": "Hehe, beeindruckend, oder? Das ist mein neu entwickelter, tragbarer Teetisch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180109
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180109,
					"content": "Er ist leicht zu tragen und zu verstauen und sogar mit einer Schwebevorrichtung ausgestattet, genau wie Fagio.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180110
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180110,
					"content": "Was noch beeindruckender ist ... Ähm, egal, ich will nicht angeben und das hier wie ein Verkaufsgespräch klingen lassen. Schaut es euch einfach selbst an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180111
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180111,
					"content": "Hier, ich habe etwas Tee und Snacks vorbereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180112
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180112,
					"content": "Dann greif ich mal zu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180113
					]
				},
				{
					"id": 762180113,
					"content": "Mhmm ...! Die sind so lecker! Du hast es wirklich drauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180114,
					"content": "Natürlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180115
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180115,
					"content": "Aber was hat dich dazu inspiriert, so etwas zu machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180116,
					"content": "Ich wollte natürlich mit Freunden gemütliche Teegesellschaften genießen können, egal, wo sie gerade sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180117
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180117,
					"content": "Ich habe das schon einmal gesagt. An dem festzuhalten, was man bereits hat, ist nicht der einzige Weg, Wertvolles zu bewahren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180118
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180118,
					"content": "In letzter Zeit merke ich, dass ich öfter spazieren gehen und meine Freunde besuchen möchte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180119
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180119,
					"content": "Aber mich selbst bei anderen einzuladen und zu erwarten, dass sie Tee und Leckereien vorbereiten, und sie danach den Tisch abräumen zu lassen ... Das ist wohl kaum die richtige Etikette für eine Dame.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180120
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180120,
					"content": "Hehe, Paimon glaubt nicht, dass es deinen Freunden etwas ausmachen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180121,
					"content": "Mich stört es aber. Außerdem ist so eine einfache Erfindung für mich überhaupt kein Problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180122
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180122,
					"content": "Ich sehe, dass er euch gefällt. Keine Sorge, ich kann euch auch einen machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180123
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180123,
					"content": "Häh?! Bist du sicher, dass das in Ordnung ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180124,
					"content": "Das ist vollkommen in Ordnung. Wie ich euch schon gesagt habe, ist sowas für mich eine Kleinigkeit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180125
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180125,
					"content": "Na dann, vielen Dank dir ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180126
					]
				},
				{
					"id": 762180126,
					"content": "Nichts zu danken. Ihr habt mir während der Fontainale sehr geholfen. Seht dies als ein Dankeschön an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				},
				{
					"id": 762180104,
					"content": "Ich hoffe, wir haben dich nicht warten lassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				}
			]
		}
	]
}