				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730980401,
					"content": "Hm ... Lass Paimon einmal sehen ... Da scheint eine neue Schatzkarte aufgetaucht zu sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980402,
					"content": "Meinst du nicht eher, wir helfen dem „gefangenen Aranara“?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980403
					]
				},
				{
					"id": 730980403,
					"content": "#Ähem! Ja, wir haben den Besitzer des Hauses wieder nicht vorgefunden. Das macht uns Sorgen! Also, {NICKNAME}, glaubt Paimon, dass wir zu dem Ort auf dem Bild gehen und nachschauen sollen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980404,
					"content": "Wenn wir dort sind, dann können wir den gezeigten Positionen folgen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980405,
						730980407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980405,
					"content": "Um mehr Schätze zu finden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980406
					]
				},
				{
					"id": 730980406,
					"content": "Ja! Äh, nein! Um Aranara zu finden, die Hilfe brauchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980409,
					"content": "Hm ... Paimon denkt, dieser „Briefkasten“ ist richtig magisch. Vielleicht stecken da später noch mehr Bilder drin. Lass uns nachher wieder zurückkommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980407,
					"content": "Um den „gefangenen Aranara“ zu finden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980408
					]
				},
				{
					"id": 730980408,
					"content": "Ja! Aber vielleicht bekommen wir auch einen Schatz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}