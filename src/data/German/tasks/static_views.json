			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730980301,
					"content": "Lass Paimon auch mal sehen! ... Hä? Ist das ein Bild von Aranara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980302,
					"content": "Man durchwühlt die Sachen anderer Leute nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980303
					]
				},
				{
					"id": 730980303,
					"content": "So? Unterwegs haben wir doch ganz viele Abenteurer-Lager, antike Truhen und anderes Zeug durchstöbert!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980304,
					"content": "Hm ... Sehen wir es doch so, in der Umgebung dieses Hauses gibt es keinen Aranara, also sind wir besorgt und wollen schauen, ob wir einen Hinweis finden können. Vielleicht können wir ja einem gefangenen Aranara helfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980305,
						730980306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980305,
					"content": "Du hast recht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				},
				{
					"id": 730980307,
					"content": "Hehe, na klar! Jedenfalls scheint dieses Bild ... die Landschaft an einem Ort in der Nähe darzustellen, oder? Aha, vielleicht ist es eine Schatzkarte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980308,
					"content": "#{NICKNAME}, lass uns den Ort, der auf dem Bild zu sehen ist, anschauen! Vielleicht hat ein Aranara dort wirklich einen Schatz hinterlassen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980306,
					"content": "Oh. Na das klingt doch vernünftig!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				}
			]
		},
		{
			"id": 7309804,
			"completionStepIds": [
				7309803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7309803",
							"2"
						],
						"stepId": 7309803,
						"stateName": "QUEST_STATE_UNFINISHED"
