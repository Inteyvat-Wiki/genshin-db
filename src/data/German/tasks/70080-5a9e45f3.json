			"dialogs": [
				{
					"id": 700800101,
					"content": "Nachdem ich auf dem schmalen Grat zwischen Leben und Tod gegangen bin, vermisse ich den Geschmack von Bier am meisten. Ja, unglaublich! Erst danach kommen der Meister und König Deshret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800102
					],
					"speakerTitle": "Venipi"
				},
				{
					"id": 700800102,
					"content": "Ah, ich wusste gar nicht, dass du gerne Alkohol trinkst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800103
					],
					"speakerTitle": "Kshama"
				},
				{
					"id": 700800103,
					"content": "Früher, als ich Ziegel für das Mausoleum von König Deshret geliefert habe, gab es jeden Tag zwei große Becher Bier, kostenlos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800104
					],
					"speakerTitle": "Venipi"
				},
				{
					"id": 700800104,
					"content": "Sag mal, ist Maukie unter den Leuten, die wiederhergestellt wurden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800105
					],
					"speakerTitle": "Venipi"
				},
				{
					"id": 700800105,
					"content": "Nein. Ich habe das Gefühl, dass die da oben ihn entgegen der Vorschriften loswerden wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700800106
					],
					"speakerTitle": "Vitruvius"
				},
				{
					"id": 700800106,
					"content": "Ich frage mich, ob der Zettel, den ich ihm heimlich mitgegeben habe, nützlich war.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vitruvius"
				}
			]
		}
	]
