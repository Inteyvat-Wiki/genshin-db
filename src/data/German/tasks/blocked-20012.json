				"points": []
			},
			"dialogs": [
				{
					"id": 200120301,
					"content": "#Vielen Dank, {F#Reisende}{M#Reisender}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120302
					],
					"speakerTitle": "Panische Myrana"
				},
				{
					"id": 200120302,
					"content": "Erzähl aber bitte keinem, dass ich hier auf Ärger gestoßen bin. Sonst bekomm ich wieder eine Standpauke von meinem Mann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120303
					],
					"speakerTitle": "Panische Myrana"
				},
				{
					"id": 200120303,
					"content": "Du brauchst mich gar nicht so anzugucken. Warte nur, bis du verheiratet bist. Dann wird selbst ein Spaziergang zu einem Luxus. Deswegen zählt jede Sekunde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120304
					],
					"speakerTitle": "Panische Myrana"
				},
				{
					"id": 200120304,
					"content": "Hier, das ist für dich. Davon habe ich einige auf dem Weg gesammelt. Sich selbst etwas zu kochen, ist viel billiger, als es beim Hirschjäger zu kaufen. Man muss doch sehen, wo man bleibt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panische Myrana"
				}
			]
		}
