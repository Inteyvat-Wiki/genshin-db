			},
			"dialogs": [
				{
					"id": 200120201,
					"content": "#Danke, {F#Reisende}{M#Reisender}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120202
					],
					"speakerTitle": "Panische Myrana"
				},
				{
					"id": 200120202,
					"content": "Herrje, Monster und Straßensperren ... Zu Hause habe ich immer so viel zu tun. Wenn ich dann mal rauskomme, passiert gleich sowas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120203
					],
					"speakerTitle": "Panische Myrana"
				},
				{
					"id": 200120203,
					"content": "Tut mir leid, aber könntest du diese Straßensperre gleich mit beseitigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120204,
						200120205
					],
					"speakerTitle": "Panische Myrana"
				},
				{
					"id": 200120204,
					"content": "In Ordnung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200120206
					]
				},
				{
					"id": 200120206,
					"content": "Vielen Dank! Ich hoffe, dass meine beiden Kleinen einmal genauso gutherzig werden wie du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panische Myrana"
				},
				{
					"id": 200120205,
					"content": "Ich habe noch zu tun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200120207
					]
				},
				{
					"id": 200120207,
					"content": "Ach, bitte! Das geht doch ganz fix.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panische Myrana"
				}
			]
		},
