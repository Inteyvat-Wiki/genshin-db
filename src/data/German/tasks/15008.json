			"dialogs": [
				{
					"id": 150080201,
					"content": "Wah, hier gibt es eine Menge Koholasaurier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080202,
					"content": "Wie erwartet steht der erste Hinweis im Zusammenhang mit den Koholasauriern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080203
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080203,
					"content": "Wenn Menschen, die nicht zum Stamm gehören, eine Kopie der Karte erhalten, finden die meisten heraus, dass der erste Hinweis mit den Koholasauriern zu tun hat, aber sie suchen dann oft in der falschen Richtung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080204
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080204,
					"content": "Als der erste Häuptling die Karte erstellte, hinterließ er eine besondere Markierung für diesen Teil. Es ist ein Code, den der Stamm verwendet, um eine Herde von Koholasauriern anzuzeigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080205
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080205,
					"content": "Es wird also unmöglich sein, nur durch das Auffinden von ein oder zwei vereinzelten Koholasauriern irgendwelche Hinweise zu erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080206
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080206,
					"content": "Du bist ein echter Profi auf diesem Gebiet, Mualani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080207,
					"content": "Aber nach den Informationen, die ich gefunden habe, versammeln sich Koholasaurier nicht gern in Herden, es sei denn, sie wollen um die heißen Quellen konkurrieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080208
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080208,
					"content": "Lass mich dir also ein Geheimnis verraten, das nur ein Fremdenführer von den Menschen der Quellen kennen kann. Es kommt vor, dass sich wilde Koholasaurier regelmäßig im Tal vor uns versammeln.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080209
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080209,
					"content": "Es ist fast so, wie wenn sich unser Stamm zu Festen versammeln würde. Doch sobald die Jahreszeit wechselt, zerstreuen sich die Koholasaurier schnell wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080210
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080210,
					"content": "Wenn man nicht gerade ein Fremdenführer ist, der ständig in Natlan herumreist, erlebt man so etwas nur sehr selten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080211
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080211,
					"content": "Läuft das echt so ab!? Ich muss mir das sofort notieren und eine Erklärung als Teil meiner Diplomarbeit einfügen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080212
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080212,
					"content": "Nach dem, was ich aus der Karte herauslesen konnte, ist tief in diesem Tal ein Hinweis versteckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080213
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080213,
					"content": "Aber um dorthin zu gelangen, müssen wir nicht durch die Herde der Koholasaurier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080214,
					"content": "Hmm, wir müssen uns überlegen, wie wir uns vorbeischleichen, ohne sie zu erschrecken. Sie versammeln sich mit ihren Freunden und ich bin sicher, dass sie nicht gestört werden wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080215
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080215,
					"content": "Du meinst, wir müssen mitten durch die Koholasaurierherde laufen? Ist das nicht ein wenig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080216
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080216,
					"content": "Ähm ... Da wir vereinbart haben zusammenzuarbeiten, sollte jeder seinen Beitrag leisten. Allerdings ist Karya schon einmal von Koholasauriern angegriffen worden, daher ist dies kein idealer Plan für sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080217
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080217,
					"content": "Aber für mich sollte das überhaupt kein Problem sein! Lassen wir Karya hier warten, dann übernehme ich alle Aufgaben, die sie sonst erledigen sollte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080218
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080218,
					"content": "Hehe, keine Sorge. Es müssen ja nicht alle mitkommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080219
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080219,
					"content": "#Wir brauchen eigentlich jemanden, der bleibt und auf das Gepäck aufpasst, also überlassen wir das euch beiden. {NICKNAME}, Paimon, bitte kommt mit mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080220
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080220,
					"content": "Meinst du wirklich? Dann funktioniert das ja perfekt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080221
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080221,
					"content": "Und jetzt verstehe ich, wie sehr du dich um deine Kollegin sorgst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
		{
