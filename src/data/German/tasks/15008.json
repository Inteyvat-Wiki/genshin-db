			},
			"dialogs": [
				{
					"id": 150080501,
					"content": "Wir müssen ganz in der Nähe sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080502
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080502,
					"content": "Schau, ein paar versammeln sich um den Felsen. Was machen sie da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080503,
					"content": "Hmm, vielleicht versammeln sie sich, wenn es langweilig wird, und reden über etwas Lustiges? Schade, dass ich nicht verstehen kann, was sie sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080504
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080504,
					"content": "Hm? Aber Paimon dachte, dass die Fremdenführer von den Menschen der Quellen Koholasaurier verstehen könnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080505,
					"content": "Es klingt, als ob jemand versucht hat, dich auszutricksen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080506
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080506,
					"content": "Stimmt, jemand hat definitiv versucht, uns zu betrügen ... Hm? Siehst du das auf dem Stein? Es sieht aus wie eine Art ... Zeichnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080507,
					"content": "Ich habe gehört, dass es eine Moosart gibt, die ihre Farbe ändert, wenn sie auf die biologischen Signale reagiert, die von Koholasauriern abgegeben werden. Aber um so eine Reaktion auszulösen, bräuchte man eine große Anzahl von Koholasauriern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080508
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080508,
					"content": "Das muss der Hinweis sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080509
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080509,
					"content": "Sollen wir ein Foto machen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080510,
					"content": "Der Blitz könnte sie stören. Lass mich versuchen, es zu kopieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080511
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080511,
					"content": "Mualani zeichnet das moosbewachsene Bild ab und führt euch leise den Weg zurück, den ihr gekommen seid. Dann erzählt ihr Viramdra und Karya, die geduldig warten, alles, was ihr gesehen und gehört habt.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150080512
					]
				},
				{
					"id": 150080512,
					"content": "Wir haben also die erste Etappe der Reise hinter uns, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080513,
					"content": "Ich verstehe ... Hätten wir uns entschieden, die Koholasaurier zu vertreiben, wären wir nie auf diesen Hinweis gestoßen ... Es scheint, dass alles, was du sagtest, eine logische Grundlage hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080514
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080514,
					"content": "Ist er schon immer so gewesen, Karya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080515
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080515,
					"content": "Er ist einfach besessen von seiner Forschung, das ist alles ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080516
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080516,
					"content": "Zumindest hat dies gezeigt, dass mein Urteil richtig ist. Ich habe meine Vertrauenswürdigkeit bewiesen. Das nächste Mal sollten wir uns also nicht mehr streiten müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080517
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080517,
					"content": "Ja, ich verstehe ... und ich nehme an, das wird uns helfen, keine Zeit zu verschwenden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080518
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080518,
					"content": "Mualani weiß wirklich, wie man unsere Truppe führt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080519,
					"content": "Schließlich ist sie eine professionelle Fremdenführerin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150080520
					]
				},
				{
					"id": 150080520,
					"content": "Als Nächstes müssen wir den Hinweis, den wir gefunden haben, nutzen, um unser nächstes Ziel zu finden. Nun, was stellt dieses Muster dar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080521
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080521,
					"content": "Schwer zu sagen ... Paimon hat jedenfalls keine Ahnung, was das darstellen soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080522,
					"content": "Aha! Ich hab’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080523
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080523,
					"content": "Auch wenn die Linien etwas grob sind, kann ich doch erkennen, dass sie die Grenzen zwischen dem Wasser und dem Land bei der Jadekleidanhöhe darstellen. Damit können wir das Loch auf der Karte ausfüllen und ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080524
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080524,
					"content": "Unser nächstes Ziel gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080525
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080525,
					"content": "Wirklich? All das hast du nur von ein paar groben Linien?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
