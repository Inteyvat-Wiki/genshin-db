			"dialogs": [
				{
					"id": 150080401,
					"content": "Gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080402,
					"content": "Was ist das?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080403,
					"content": "Der Schlüssel, um uns einen Weg durch die Herde zu bahnen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080404,
					"content": "Wenn die Koholasaurier einen scharfen Geruchssinn haben, werden sie uns auch dann bemerken, wenn wir versuchen, uns zu verstecken, sobald wir nahe genug sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080405
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080405,
					"content": "Aber diese Pflanze kann uns helfen, dieses Problem zu lösen, denn ihr Duft ist dem eines Koholasauriers sehr ähnlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080406
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080406,
					"content": "Wir können den Extrakt der Pflanze auf unseren Körper auftragen und ihren Geruchssinn überlisten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080407
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080407,
					"content": "Also werden wir uns ... mit Pflanzensaft einreiben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080408,
					"content": "Mach dir keine Sorgen. Das ist auch gut für die Haut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080409,
					"content": "Mualani sammelt einen Teil des Extrakts der Pflanze und maskiert damit den Geruch ihrer Gefährten.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150080410
					]
				},
				{
					"id": 150080410,
					"content": "Oh, das fühlt sich ganz feucht und schleimig an ... aber riecht tatsächlich wie ein Koholasaurier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080411,
					"content": "Perfekt! Dann versuchen wir noch einmal, uns durchzuschlagen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
