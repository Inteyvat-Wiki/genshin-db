			"dialogs": [
				{
					"id": 150080101,
					"content": "#{NICKNAME}, Paimon, hier drüben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080102,
					"content": "Du bist ja hier, Mualani. Oh, und diese seltsamen Gelehrten sind auch hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080103,
					"content": "Guten Morgen, ihr beiden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080104
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080104,
					"content": "Morgen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080105,
					"content": "Wann reisen wir ab?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080106
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080106,
					"content": "Haha, du bist aufgeregt wie ein Kind vor dem Beginn unserer Reise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080107,
					"content": "Ich möchte nur so schnell wie möglich zur Sache kommen ... Du weißt, dass dies kein gemütlicher Frühlingsspaziergang wird, also hoffe ich, dass wir uns alle ein wenig professioneller verhalten könnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080108
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080108,
					"content": "Keine Sorge, ich bin eine sehr professionelle Fremdenführerin. Unsere Reise zu der geheimnisvollen Insel beginnt jetzt offiziell.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080109,
					"content": "Juhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080110,
					"content": "Zuallererst: Seht ihr die Statue hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080111,
					"content": "Mhm. Ist das ein wichtiger Hinweis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080112,
					"content": "Hm, nein. Es ist überhaupt kein Hinweis. Das hat der erste Häuptling der Menschen der Quellen, der von der geheimnisvollen Insel zurückkam, an diesem Ort errichtet. Es ist ein Denkmal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080113,
					"content": "Bevor wir uns auf den Weg machen, müssen wir als Erstes die Statue berühren und zu unseren Vorfahren beten. So wird unsere Reise zu der geheimnisvollen Insel reibungsloser verlaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080114
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080114,
					"content": "Gibt es eine theoretische Grundlage, um diese Behauptung zu stützen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080115
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080115,
					"content": "Theoretische Grundlage? Nein, aber mein Lehrer hat mir beigebracht, dass dies ein wichtiger Schritt ist, bevor ich mich auf die geheimnisvolle Insel begebe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080116
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080117
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080117,
					"content": "Sehr gut! Du hast nicht versucht, mit mir über etwas zu streiten, wovon du keine Ahnung hast. Das ist sehr professionell von dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080118
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080118,
					"content": "Sicher, aber da es für diese Praxis keine empirische Grundlage gibt, kann ich sie nicht in meine Abhandlung einbeziehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080119
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080119,
					"content": "Los geht’s, Leute!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080120
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080120,
					"content": "Grüße an meinen Vorfahren. Als Eure Nachkommin werde ich in Eure Fußstapfen treten und Zeuge Eurer Errungenschaften werden. Erlaubt mir, unter Eurem Blick loszureisen und unter Eurer schützenden Obhut zurückzukehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080121
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080121,
					"content": "Es fühlt sich wirklich so an, als ob wir auf ein großes Abenteuer gehen würden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080122,
					"content": "Macht euch bitte bereit. Wir werden nun nach dem ersten Hinweis suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
