			},
			"dialogs": [
				{
					"id": 150080301,
					"content": "Diese Koholasaurier scheinen sehr wachsam zu sein. Da kommen wir nie durch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080302,
					"content": "Da du bereits aus den Informationen auf der Karte geschlossen hast, dass sich der Hinweis in diesem Tal befindet, warum verjagst du sie nicht einfach? Du bist doch ziemlich stark, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080303
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080303,
					"content": "Zunächst einmal haben uns die Stammesältesten immer davor gewarnt, die Koholasaurier zu verletzen. Wenn wir das tun, bringt das mit ziemlicher Sicherheit Unglück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080304
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080304,
					"content": "Und dann kann man nicht einfach auftauchen und die Versammlungen anderer stören, geschweige denn sie zum Gehen zwingen! Das wäre einfach schrecklich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080305
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080305,
					"content": "Welche Theorie dient denn hier als ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080306
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080306,
					"content": "Na gut, können wir einen anderen Weg ins Tal finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080307
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080307,
					"content": "Hmm, es muss einen Weg geben, das Tal zu betreten, ohne sie zu erschrecken. Es würde eine Weile dauern, bis ich allein eine Lösung finden würde, also möchte ich alle bitten, mit mir gemeinsam über eine Lösung nachzudenken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080308
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080308,
					"content": "Lass Paimon nachdenken ... Gibt es einen Weg um sie herum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080309,
					"content": "Laut Karte befindet sich der Hinweis genau in der Mitte der Koholasaurierherde. Selbst wenn wir versuchen, uns von der anderen Seite zu nähern, stoßen wir auf das gleiche Problem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080310
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080310,
					"content": "Hmm, das ist knifflig ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080311,
					"content": "Karya, mir ist aufgefallen, dass du nur redest, wenn du versuchst, die Wogen zwischen Viramdra und den anderen zu glätten. Ich bin sicher, du hast eigene Ideen, also warum teilst du sie nicht mit uns?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080312
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080312,
					"content": "Ich? Na gut ... Als Viramdra beschloss, nach Hinweisen auf die Koholasaurier zu suchen, wollte ich helfen, und so habe ich auch einige Informationen über diese Kreaturen nachgeschlagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080313
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080313,
					"content": "Ich habe etwas sehr Interessantes entdeckt ... Wir dachten, die Koholasaurier verließen sich auf ihr Gehör, um ihre Beute aufzuspüren, aber sie besitzen tatsächlich einen sehr scharfen Geruchssinn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080314
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080314,
					"content": "Aber ich bin mir nicht sicher, wie nützlich diese Information ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080315
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080315,
					"content": "Oh ... Oh! Das war wirklich sehr nützlich, Fräulein Karya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080316
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080316,
					"content": "Sag bitte einfach Karya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080317
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080317,
					"content": "#In diesem Fall bleibt bitte hier und behaltet das Gepäck im Auge. {NICKNAME}, Paimon, kommt mit mir. Ich habe eine Idee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
		{
