			"dialogs": [
				{
					"id": 411490301,
					"content": "Ich habe gehört, es gibt eine Sonderbestellung?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411490302
					]
				},
				{
					"id": 411490302,
					"content": "#Genau. Du kommst gerade recht, {F#Reisende}{M#Reisender}! Wallit hat Landeierkuchen bestellt und auch bereits dafür bezahlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490303
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411490303,
					"content": "Es soll an einen Ort südlich der Glanzkronschlucht geliefert werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490304
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411490304,
					"content": "Aus irgendeinem Grund bekommen wir in letzter Zeit immer mehr Lieferbestellungen. Wir kommen kaum noch mit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411490305
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 411490305,
					"content": "Würdest du uns mit dieser Lieferung helfen, wenn du Zeit hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
