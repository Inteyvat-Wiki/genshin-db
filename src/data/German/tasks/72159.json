			"dialogs": [
				{
					"id": 721590501,
					"content": "Es scheint, dass du dein Training in den letzten Tagen vernachlässigt hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590502
					],
					"speakerTitle": "„Masanori“"
				},
				{
					"id": 721590502,
					"content": "Ein Kampfkünstler, der einen Tag lang ein wenig faul ist, hat zehn Tage Fleiß vergeudet. Du solltest das wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590503
					],
					"speakerTitle": "„Masanori“"
				},
				{
					"id": 721590503,
					"content": "Geh zurück und feile an deinen Fähigkeiten. Das ist nicht alles, wozu du in der Lage sein solltest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Masanori“"
				}
			]
		}
