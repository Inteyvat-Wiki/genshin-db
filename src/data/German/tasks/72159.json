					"„Masanori“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721590401,
					"content": "Oh, ich kann nicht glauben, dass ich immer noch nicht gegen dich gewinnen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590402
					],
					"speakerTitle": "„Masanori“"
				},
				{
					"id": 721590402,
					"content": "So sei es, deine kämpferischen Fähigkeiten werden immer noch verfeinert, aber ich kann die höheren Mysterien aufgrund der Beschränkungen meines Geistes nicht mehr begreifen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590403
					],
					"speakerTitle": "„Masanori“"
				},
				{
					"id": 721590403,
					"content": "Wenn du dir aber eine neue Fähigkeit angeeignet hast, freue ich mich trotzdem, sie zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590404
					],
					"speakerTitle": "„Masanori“"
				},
				{
					"id": 721590404,
					"content": "Also, bis zum nächsten Mal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Masanori“"
				}
			]
		},
