				"points": []
			},
			"dialogs": [
				{
					"id": 721590301,
					"content": "Ich wollte mit dir reden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721590302
					]
				},
				{
					"id": 721590302,
					"content": "Ich habe meine Vergangenheit aufgegeben und möchte der Welt in Zukunft nichts mehr erzählen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590303
					],
					"speakerTitle": "„Masanori“"
				},
				{
					"id": 721590303,
					"content": "Du solltest mich nicht ansprechen, wenn du nur mit jemandem reden willst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721590304
					],
					"speakerTitle": "„Masanori“"
				},
				{
					"id": 721590304,
					"content": "Geh nur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Masanori“"
				}
			]
		},
		{
			"id": 7215904,
			"completionStepIds": [
