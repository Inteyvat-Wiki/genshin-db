					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Onkel He",
					"Jinwu",
					"Paimon",
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710570601,
					"content": "Pilzfleisch ... hehe ... Leckeres Pilzfleisch gefuttert, kleine Pilze, Pilzmonster, große Pilze ... hehehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570602
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570602,
					"content": "Onkel He? Was hat es mit dem seltsamen Teint auf sich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570603
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570603,
					"content": "*seufz* ... Ich wusste, dass du noch lebst! Unglaublich, dass deine Familie mich sogar zum Totenmahl nach deiner Beerdigung einlud! Ich sagte ab und sagte ihnen, wie könntet ihr ein Totennmahl veranstalten, wenn der Tote nicht tot ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570604
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570604,
					"content": "Du musst in den Minen viel gelitten haben, aber es ist gut, dass du am Leben bist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570605
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570605,
					"content": "Am Leben zu sein, ist gut! Lebende Pilze sind köstlich ... hehehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570606
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570606,
					"content": "Onkel He?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570607
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570607,
					"content": "Er war schon so, als wir ihn fanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570608,
					"content": "Ein bisschen verrückt ... immer nach Pilzen schreiend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570609,
					"content": "Pilze ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570610
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570610,
					"content": "Der Große Kluft ist ein gefährlicher Ort für normale Menschen. Pflanzen und Pilze, die hier wachsen, können auch für den menschlichen Körper schädlich sein. Deshalb hat die Huishan-Kammer strenge Regeln aufgestellt, die es verbieten, hier unten etwas zu essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570611
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570611,
					"content": "Aber Onkel He war in den letzten Jahren im Bergwerk und er hatte keine andere Wahl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570612
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570612,
					"content": "Was soll ich seiner Familie sagen, so, wie er jetzt ist?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570613,
						710570614
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570613,
					"content": "Wenn es um Pilze geht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570615
					]
				},
				{
					"id": 710570615,
					"content": "In diesem Fall könnte Khedive etwas in petto haben. Schließlich ist er ein Gelehrter der Sumeru und muss Pilze studiert haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570616
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570616,
					"content": "Ihr wartet hier einen Moment, während ich Khedive hole, um zu sehen, wie es Onkel He geht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570617
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570617,
					"content": "Pilzfleisch ... Pilzfleisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570618
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570618,
					"content": "Ach, ich weiß wirklich nicht, ob sich Onkel He so noch erholen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570619,
					"content": "Wenn er so bleibt, wird seine Familie nicht glücklich sein, auch wenn er zurückkehrt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570620,
					"content": "Du kannst mich nicht einfach zwingen hierherzukommen, während ich mit meinem Bericht erst halb fertig bin. Jinwu, obwohl du der Leiter des Erkundungstrupps bist, ist es nicht in Ordnung, meine Forschung zu stören ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570621
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570621,
					"content": "Ich ziehe ernsthaft in Erwägung, deine Belohnung zu kürzen, wie sie es vorgeschlagen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570622
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570622,
					"content": "Die Belohnung ist egal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570623
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570623,
					"content": "Lass uns seine Situation ansehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570624
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570624,
					"content": "Meine Ohren jucken ... hehehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570625
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570625,
					"content": "Hm? Wer ist er? Was hat es mit diesem seltsamen Teint auf sich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570626
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570626,
					"content": "#{NICKNAME}, hast du ihn gefunden? Warum stolperst du immer über merkwürdige Ereignisse ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570627
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570627,
					"content": "Aber ... Wie war er so, als du ihn gefunden hast?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570628
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570628,
					"content": "Ihr erklärt Khedive, was im Zusammenhang mit Onkel He geschehen war ...\\nKhedive untersucht Onkel He sorgfältig.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570629
					]
				},
				{
					"id": 710570629,
					"content": "Zum Glück ist alles in Ordnung, nichts Ernstes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570630
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570630,
					"content": "Er hatte doch gesagt, dass seine Ohren juckten, und das wurde durch die Sporen dieses Pilzes verursacht, die in den Gehörgang gelangt waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570631
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570631,
					"content": "Obwohl der langfristige Verzehr dieser Art von Pilzen die geistige Gesundheit beeinträchtigt, schadet er dem Körper nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570632
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570632,
					"content": "Mit anderen Worten, er kann sich erholen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570633
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570633,
					"content": "Ich habe den Pilz aus seinem Körper entfernt und auch eine Medizin hergestellt, die die gestörten Nerven beruhigt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570634
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570634,
					"content": "Bei guter Erholung ist eine Genesung noch sehr wahrscheinlich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570635
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570635,
					"content": "Das Geld für die Herstellung der Medikamente ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570636
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570636,
					"content": "Keine der Zutaten ist teuer. Sie sind nur die Mahlzeiten eines Monats im Lokal Xinyue wert. Das ist nicht der Rede wert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570637
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570637,
					"content": "Nun ... Ich werde einen Weg finden, dich zu bezahlen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570638
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570638,
					"content": "Das ist ein kleiner Betrag, der gar nicht erst gezahlt werden muss, aber ich kann einen weiteren Eintrag zu meinem Bericht hinzufügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570639
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570639,
					"content": "Seit ich hier auf die besonderen Pilze gestoßen bin, bin ich neugierig auf die langfristigen Folgen ihres Verzehrs. Aber ich habe noch keinen willigen Assistenten gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570640,
						710570642
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570640,
					"content": "Assistenten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570641
					]
				},
				{
					"id": 710570641,
					"content": "Das sind die Menschen, die für den Verzehr der Pilze verantwortlich sind. Aber die Leute wenden sich von den Pilzen ab, und obwohl sie wissen, dass es nicht allzu schädlich ist, trauen sie sich nicht, es einfach zu versuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570644
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570644,
					"content": "Aber ... wenn man bedenkt, wie eigenartig die Große Kluft ist, könnte die Umgebung hier eine weitere Ursache für seine Symptome sein. Wie auch immer, lass ihn meine Medizin nehmen und sich ausruhen. Seine Chancen auf Besserung sind hoch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570645
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570645,
					"content": "Das ist gut, das ist gut ... Ich schicke Onkel He später hinauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570646
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570646,
					"content": "Wenn er sich erholt hat, bringen wir ihn nach Hause. Wir müssen es auch seinen Freunden sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570647
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570647,
					"content": "Er war ein erfahrener, flinker Bergmann. Er kümmerte sich sehr gut um die jungen Arbeiter, die neu in der Mine waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570648
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570648,
					"content": "Nachdem er damals verschwunden war, dachten alle, dass der Herrscher über die Felsen seine Augen geschlossen hätte, sodass es guten Menschen schlecht erging.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570649
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570649,
					"content": "Ich bin mir sicher, dass die Leute froh sind, dass er dieses Mal zurückkommt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570642,
					"content": "Du meinst Versuchskaninchen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570643
					]
				},
				{
					"id": 710570643,
					"content": "Das könnte man so sagen, aber dieser Pilz wurde bereits untersucht und verursacht keine irreversiblen Schäden am menschlichen Körper oder Geist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570644
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710570614,
					"content": "Studiert hier jemand Pilze?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570615
					]
				}
			]
		},
