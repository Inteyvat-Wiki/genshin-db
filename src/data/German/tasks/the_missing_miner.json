					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570416
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570416,
					"content": "Über Khedive ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570417
					]
				},
				{
					"id": 710570417,
					"content": "Er ist immer noch in dem Lager oben. Er sagte, er wolle seine Forschungsunterlagen ordnen und sie hierher bringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570418
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570418,
					"content": "Bis dahin musst du dich noch gedulden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570419
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570419,
					"content": "Paimon hofft, Onkel He kann sich erholen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570420,
					"content": "*seufz* Onkel He war ein erfahrener, flinker Bergmann. Er kümmerte sich sehr gut um die jungen Arbeiter, die neu in der Mine waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570421
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570421,
					"content": "Nachdem er damals verschwunden war, dachten alle, dass der Herrscher über die Felsen seine Augen geschlossen hätte, sodass es guten Menschen schlecht erging.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570422
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570422,
					"content": "Ich bin sicher, die Leute wären froh, wenn er sich erholen und sicher zurückkehren könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570423
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570423,
					"content": "#Vielen Dank, {NICKNAME}, ich werde ihn auf jeden Fall He nach oben bringen, nachdem Khedive seine Diagnose gemacht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570424
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710570424,
					"content": "Ohne dich wäre das alles nichts geworden. Ich stehe in deiner Schuld.",
