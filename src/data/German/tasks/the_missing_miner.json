			"dialogs": [
				{
					"id": 710570201,
					"content": "Alles erledigt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570202,
					"content": "Onkel He ist stark!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570203,
					"content": "Hehehe ... Pilzfleisch, Pilzfleisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570204
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570204,
					"content": "Seit ich Pilzfleisch esse, tut mein Rücken nicht mehr weh und meine Hände sind kräftiger, hehehehe, ich fühle mich ein paar Jahre jünger!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570205
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570205,
					"content": "Pilzfleisch-Monster sind besser als Pilzfleisch ... Je größer, desto besser ... hehehehehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570206
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570206,
					"content": "Könnte es sein, dass er so kräftig wurde, nachdem er dieses Pilzfleisch gegessen hatte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570207,
					"content": "#{NICKNAME}, da es uns mehr Kraft verleihen könnte, warum nehmen wir nicht auch ein paar Bissen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570208,
						710570210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570208,
					"content": "Du willst doch nur Pilzfleisch essen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570209
					]
				},
				{
					"id": 710570209,
					"content": "Paimon ist nur neugierig, wie sie schmecken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570212,
					"content": "Aber jetzt sollte er bereit sein, mit uns zurückzukommen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570213,
					"content": "Pilzfleisch ... Hehe, das schmeckt gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570214
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570214,
					"content": "Onkel He, komm mit uns zurück zum Lager!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570215,
					"content": "Hm? Ja, ihr könnt euch zu mir gesellen. Dieses Pilzfleisch, hehehe, das hält sich lange, wenn es getrocknet ist ... sehr lange ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570216
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570216,
					"content": "Komm mit uns zurück zum Lager!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570217,
					"content": "Was? Wer ist mager? Aber gut ... Hehehe ... Nachdem ich Pilzfleisch gegessen habe, kann ich alles.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570218
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570218,
					"content": "*seufz*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570219,
					"content": "#{NICKNAME}, lass uns Onkel He zurück nach Jinwu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570210,
					"content": "Iss es nicht einfach so!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570211
					]
				},
				{
					"id": 710570211,
					"content": "Ja, ja, Paimon weiß.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7105703,
