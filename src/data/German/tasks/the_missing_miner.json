			"dialogs": [
				{
					"id": 710571201,
					"content": "Meine Ohren jucken nicht mehr ... aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710571202
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710571202,
					"content": "Pilzfleisch, hach, wo kann ich mehr davon finden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Onkel He"
				}
			]
