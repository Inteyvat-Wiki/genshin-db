			"dialogs": [
				{
					"id": 710570133,
					"content": "Plötzlich hörst du ein Flüstern hinter dir:\\n„Hehehe ... Pilzfleisch ... Hehehe ...“",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570101
					]
				},
				{
					"id": 710570101,
					"content": "Leute, sagt mal, was ist hier los?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570102
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570102,
					"content": "Oha! Sein Gesicht sieht schrecklich aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570103,
					"content": "#Und er ist einfach aufgetaucht, ohne ein einziges Geräusch zu machen, {NICKNAME} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570104,
					"content": "Ist das nicht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570105,
					"content": "Denk ich nicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570106
					]
				},
				{
					"id": 710570106,
					"content": "Hehe ... Was macht ihr hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570107
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570107,
					"content": "Habt ihr auch schon alles aufgegessen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570108
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570108,
					"content": "Bist du Onkel He?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570109
					]
				},
				{
					"id": 710570109,
					"content": "#Ah ... Was? {F#Junge Frau}{M#Junger Mann}, wovon redest du? Ich kann dich nicht verstehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570110
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570110,
					"content": "Wir fragen, ob du Onkel He bist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570111,
					"content": "Ach so! Hehe, ja, der bin ich. Ich bin He.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570112
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570112,
					"content": "Bist du auch hier gefangen und hast nichts Essbares mehr in deiner Tasche? *seufz* ... Hach, du hast auch nicht viel Glück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570113
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570113,
					"content": "Hehe, aber es ist schon in Ordnung, ich habe Essen hier ... Du musst Hunger haben ... Hehehe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570114
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570114,
					"content": "Also Hunger hätte Paimon schon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570115,
						710570116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570115,
					"content": "Dieses Pilzfleisch kann man nicht einfach so essen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				},
				{
					"id": 710570117,
					"content": "Äh ... Du hast recht. Sein Verstand scheint ziemlich durcheinander zu sein. Und was hat es mit diesem seltsamen Teint auf sich? Paimon wettet, dass es etwas mit dem Essen von diesem Pilzfleisch zu tun hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570118,
					"content": "Pilzfleisch? Hehe, das schmeckt gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570119
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570119,
					"content": "Komm, ich gebe euch ein bisschen Pilzfleisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570120
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570120,
					"content": "Hehehe, Pilzfleisch ... Aber was ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570121
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570121,
					"content": "Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570122,
					"content": "Das Pilzfleisch ist weg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570123
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570123,
					"content": "Dann lasst uns das Pilzfleisch vergessen und alle zurück ins Lager gehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570124,
					"content": "Nein! Kein Pilzfleisch mehr da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570125
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570125,
					"content": "Ohne Pilzfleisch habe ich nicht die Kraft zu gehen und ich gehe nirgendwo hin ... Ohne Pilzfleisch ... gibt es hier nirgendwo etwas zu essen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570126
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570126,
					"content": "Wenn ich Pilzfleisch esse, kann ich überall hin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570127
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570127,
					"content": "Wo gibt es solches Pilzfleisch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570128,
					"content": "Pilzfleisch ... hehehe ... Ich weiß, wo es Pilzfleisch gibt, lasst uns ein bisschen Pilzfleisch essen, damit wir die Kraft haben weiterzumachen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570129
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570129,
					"content": "Hier in der Nähe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570130
					],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570130,
					"content": "#Es gibt keinen Ausweg, {NICKNAME}, lass uns erst einmal Pilzfleisch für ihn finden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570131,
					"content": "Scheint, als wäre das die einzige Möglichkeit.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570132
					]
				},
				{
					"id": 710570132,
					"content": "Pilzfleisch ... Hehehe ... Richtig großes Pilzfleisch ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Onkel He"
				},
				{
					"id": 710570116,
					"content": "Iss keine gefährlichen Dinge!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				}
			]
		},
