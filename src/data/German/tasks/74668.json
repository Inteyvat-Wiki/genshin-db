			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746680101,
					"content": "Hä? Ist die Statue der Sieben gerade plötzlich hell erstrahlt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680102,
					"content": "Seltsam, ist das vorher schon einmal passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680103,
						746680105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680103,
					"content": "Es ist doch normal, dass die Statue der Sieben strahlt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680107
					]
				},
				{
					"id": 746680107,
					"content": "#{NICKNAME}, fühlst du dich etwas komisch?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680108,
						746680110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680108,
					"content": "Igitt! Das Wasser ... Es spricht zu mir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680109
					]
				},
				{
					"id": 746680109,
					"content": "Jetzt kann es auch noch sprechen! Wenn du immer noch zum Scherzen aufgelegt bist, ist ja alles gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680112,
					"content": "Jedenfalls ist die Luft hier wirklich etwas schwül geworden, nachdem das Licht aufgeblitzt ist. Vielleicht liegt es ja an der hervorgetretenen Hydro-Kraft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680113,
					"content": "Hehe, Paimon hat gehört, dass man in Fontaine unbeschwert tauchen kann, wenn man die Elementarkraft gut beherrscht. Vielleicht kann man sogar untergegangene Schätze bergen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680114,
					"content": "Das Bergen der Schätze ist deine Aufgabe! Und Paimon ... Paimon hält dir vom Strand aus den Rücken frei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680115,
						746680116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680115,
					"content": "Allein im Wasser, das ist doch recht einsam ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680117,
					"content": "Ooh ... A... Aber es ist so unheimlich unter Wasser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680118,
					"content": "Man könnte aus Versehen von einer Strömung erfasst und durcheinandergewirbelt werden, ohne davonfliegen zu können!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680119,
					"content": "Genau wie damals, als Paimon dich in Mondstadt traf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680120,
					"content": "Dann angle ich dich wieder raus!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680121
					]
				},
				{
					"id": 746680121,
					"content": "... Wirklich? Na dann kann Paimon auch mit dir ins Wasser gehen. Ah, aber du musst dein Versprechen auch halten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680116,
					"content": "Du solltest wenigstens einmal etwas tun, Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680110,
					"content": "Oha, ich habe das Gefühl, ich kann durch Kiemen atmen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680111
					]
				},
				{
					"id": 746680111,
					"content": "Na schön, dann lass dir erst einmal ein Paar Kiemen wachsen. Hmpf, du scheinst ja in guter Verfassung zu sein, Paimon hatte sich schon für einen Augenblick Sorgen gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680105,
					"content": "Ist gerade Wasser aus der Statue gekommen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680106
					]
				},
				{
					"id": 746680106,
					"content": "Das ist schließlich das Reich des Hydro-Archons, vielleicht ist es hier normal, dass Wasser aus der Statue fließt ... Aber nein! Wirklich seltsam, dieses Licht gerade war keine normale Reaktion.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680107
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}