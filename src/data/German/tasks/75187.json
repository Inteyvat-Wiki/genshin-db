			"dialogs": [
				{
					"id": 751870101,
					"content": "#... Keine Flammenmuster auf den Hörnern ... das kann nicht {REALNAME[ID(2)|SHOWHOST(true)]} sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870102,
					"content": "Hm? Woher kommt dieses kleine Kerlchen denn jetzt wieder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870103,
					"content": "Ein Saurier-Ei aus Ochkanatlan ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751870104
					]
				},
				{
					"id": 751870104,
					"content": "... Oh, das ist ein Ei von damals!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870105,
					"content": "*brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870106
					],
					"speakerTitle": "Aguara"
				},
				{
					"id": 751870106,
					"content": "Wah, da steckt also wirklich ein Tepetlisaurier drin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870107,
					"content": "Hat derjenige, der dieses Ei beschützt hat ... ihm nicht den Namen „Aguara“ gegeben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870108,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870109
					],
					"speakerTitle": "Aguara"
				},
				{
					"id": 751870109,
					"content": "Oh, du kannst dich wohl an deinen Namen erinnern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870110,
					"content": "*brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870111
					],
					"speakerTitle": "Aguara"
				},
				{
					"id": 751870111,
					"content": "#Genau wie {REALNAME[ID(2)|SHOWHOST(true)]} hat auch dieses kleine Kerlchen kein Zuhause mehr ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870112,
					"content": "#Dann komm doch einfach mit uns! Hehe, {NICKNAME} und Paimon sind ja bestens darin, Freunde von Tepetlisauriern zu werden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870113,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870114
					],
					"speakerTitle": "Aguara"
				},
				{
					"id": 751870114,
					"content": "... Hehe, Paimon wusste doch, dass du ja sagst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870115,
					"content": "... Sanft bindest du ihm ein Seidentuch um, genau wie du es einst für einen alten Gefährten getan hast.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751870116
					]
				},
				{
					"id": 751870116,
					"content": "Oh ja, der letzte kleine Saurier mit einem Seidentuch ist schließlich zu einem wahrhaft großartigen Wesen herangewachsen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751870117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751870117,
					"content": "Aguara! Paimon hofft ... hofft wirklich, dass du genauso gesund und stark wirst wie er!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
