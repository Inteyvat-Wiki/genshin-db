			},
			"dialogs": [
				{
					"id": 2005910001,
					"content": "Das ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910002,
					"content": "Ein Kunde! Du hast einen guten Geschmack. Du kommst in den Laden und weißt sofort, wo die guten Sachen liegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910003
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910003,
					"content": "#Das hat diese{F# Reisende}{M#r Reisende} von einem Hilichurl-Häuptling erbeutet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910004
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910004,
					"content": "Wie lange dieser schlimme Hilichurl Mondstadt schon bedroht haben muss ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910005
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910005,
					"content": "#Auch für diese{F# Reisende}{M#n Reisenden} muss das ein schwieriger Kampf gewesen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910006
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910006,
					"content": "War das wirklich ein so schlimmer Hilichurl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910007
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910007,
					"content": "Wenn ich das Cyrus oder Stanley zeigen würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910008
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910008,
					"content": "würden sie vielleicht etwas anderes sagen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910009
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910009,
					"content": "Lieber Kunde, natürlich brauchst du keine Angst zu haben. Wir geben keine Informationen über unsere Kunden weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910010
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910010,
					"content": "Mach dir keine Gedanken, das ist 1A-Ware!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910011
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910011,
					"content": "#Ich denke mal darüber nach ... {F#Reisende}{M#Reisender}, stimmt das, was sie sagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 20059101,
