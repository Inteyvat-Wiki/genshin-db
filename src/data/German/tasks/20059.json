			"dialogs": [
				{
					"id": 2005902001,
					"content": "Hm, vielleicht kannst du dir auch nicht viel darunter vorstellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902002
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005902002,
					"content": "Du könntest mir beispielsweise etwas mitbringen, dass mit <color=#00E1FFFF>Hilichurlen</color> zu tun hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902003
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005902003,
					"content": "Abenteurer, die zeigen wollen, wozu sie fähig sind, könnten sich dafür interessieren.",
					"roleType": "TALK_ROLE_NPC",
