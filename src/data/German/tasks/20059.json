			"dialogs": [
				{
					"id": 2005910101,
					"content": "Ja, es stimmt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						2005910102
					]
				},
				{
					"id": 2005910102,
					"content": "Na, gut, dann nehm ich das.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910103
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910103,
					"content": "Du weißt wirklich, was gut ist. Ich habe die Ware schon verpackt und wünsche dir noch einen wunderschönen Tag!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
		},
