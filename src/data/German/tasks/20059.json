			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Marjorie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200590101,
					"content": "Das war’s dann wohl ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590102
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590102,
					"content": "Was ist denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590103
					]
				},
				{
					"id": 200590103,
					"content": "#{F#Reisende}{M#Reisender}! Genau dich brauche ich jetzt! Du weißt doch, dass ich in diesem Laden Andenken verkaufe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590104,
					"content": "Mein Vater hat immer die Beute von Abenteurern aufgekauft und dann hier im Laden angeboten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590105
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590105,
					"content": "Seit die Abenteurergilde ein paar Probleme mit ihren Mitgliederzahlen hat, bekomme ich kaum noch neue Waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590106,
					"content": "Davon abgesehen bekomme ich in letzter Zeit nur noch wertlose Gegenstände, die natürlich keiner haben will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590107
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590107,
					"content": "#{F#Reisende}{M#Reisender}, du reist doch viel durch die Gegend, nicht wahr? Könntest du vielleicht gut verkäufliche Waren mitbringen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590108,
						200590110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590108,
					"content": "Aber klar doch.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590109
					]
				},
				{
					"id": 200590109,
					"content": "Danke dir! Sobald du welche hast, werde ich sie natürlich auch zu einem anständigen Preis verkaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590110,
					"content": "Paimon könnte doch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590111
					]
				},
				{
					"id": 200590111,
					"content": "Oh, dafür wird sich keiner interessieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590112
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 200590112,
					"content": "Ich glaube, niemand will etwas kaufen, das von allein davonläuft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				}
			]
		},
