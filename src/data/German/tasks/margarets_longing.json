			"dialogs": [
				{
					"id": 4870101,
					"content": "Die Katze gehört also zu euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870102,
					"content": "Venti! Bist du auch hier, um zu helfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870103,
					"content": "Helfen? Wenn jemand Hilfe braucht, dann bin ich das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870104
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870104,
					"content": "Ach so, ich dachte, du würdest auch gerade nach Prinz, der Katze von Margaret, suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870105,
					"content": "Ah ja, Prinz heißt er also. Er hat die <color=#00E1FFFF>Sternsaiten</color>, die als Reserve gedacht waren, gemopst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870106
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870106,
					"content": "Es ist zwar schön mit anzusehen, wie froh und frei alle Kreaturen in Mondstadt leben ... Sie sollten aber nicht tun und lassen, wozu ihnen gerade zumute ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870107,
					"content": "Ahaha, Prinz ist also eine kleine freche Kreatur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870108
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870108,
					"content": "Die Worte von Eltern, die ihre Kinder zu sehr verwöhnen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4870109
					]
				},
				{
					"id": 4870109,
					"content": "Ganz wie Barbatos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870110,
					"content": "Hahaha! Wie passend! Tehehe ... Finden wir lieber erst einmal Prinz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870111
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870111,
					"content": "Ich muss heute Abend noch auftreten. Wenn ich meine Reservesaiten nicht habe, werde ich wohl mein Publikum enttäuschen müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870112,
					"content": "Warum sollte eine Katze Ventis Reservesaiten stehlen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870113,
					"content": "Katzen lieben es einfach, mit Fäden und Ähnlichem zu spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870114
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870114,
					"content": "Wie? Was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870115,
					"content": "In den Sternensaiten der Leier steckt die Anemo-Kraft. Sie sind widerstandsfähiger als normal, weswegen ich sie auch immer zusammenknäule.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870116,
					"content": "Das ist ein kleines Geheimnis eines wandernden Barden, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870117,
					"content": "Ach, die Saiten haben Anemo-Kraft?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870118,
					"content": "#Na, dann wissen wir Bescheid! {NICKNAME}, nutze deinen <color=#00E1FFFF>Elementarblick</color>, um nach ihnen zu suchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870119,
					"content": "Eigentlich müssten doch Anemo-Spuren zu finden sein ... Vielleicht gibt es ja Fußabdrücke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870122,
					"content": "Es kommt jetzt auf euch an. „Prinz“ muss irgendwo im Einkaufsgebiet in der Stadt sein. Vielleicht ist er auch irgendwo im Wohngebiet. Merkt euch, er ist ein komplett schwarzer Kater.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870121,
					"content": "Ach, hier noch ein Stück <color=#00E1FFFF>Fisch</color>, das unser kleiner Prinz so gern frisst. Vielleicht habt ihr ja Glück und er riecht es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		}
	]
