					"Margaret"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4870301,
					"content": "Prinz! Hier steckst du also! Endlich haben wir dich gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870302
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870302,
					"content": "Leicht zu finden war er jedenfalls nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870303,
					"content": "Ach, Prinz, wie konntest du mich nur verlassen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870304
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870304,
					"content": "Jetzt haben sie nur noch Augen füreinander.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870305,
					"content": "Hier sind noch deine Sternensaiten, Venti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870306,
					"content": "Ihr habt sie tatsächlich gefunden. Ich hatte schon die Hoffnung verloren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870307
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870307,
					"content": "Zum Dank werde ich euch eine kleine Sondervorführung gewähren ... Ha... Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870308
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870308,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870309,
					"content": "Hatschi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870310
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870310,
					"content": "Puh ... Tja, da bin ich Prinz wohl zu nahe gekommen. Meine Katzenhaarallergie ist nicht besser geworden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870311
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870311,
					"content": "Ach, deswegen hast du ihn nicht selbst gefangen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870312,
					"content": "Äh, ja, jedenfalls danke! Dann werd ich mal wieder ... Ha... Hatschi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
