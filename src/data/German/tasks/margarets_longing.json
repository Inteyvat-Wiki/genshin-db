			"dialogs": [
				{
					"id": 4871101,
					"content": "Wohin wart ihr eigentlich auf dem Weg?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4871102
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4871102,
					"content": "Prinz muss irgendwo im Einkaufsgebiet in der Stadt sein. Vielleicht ist er auch irgendwo im Wohngebiet. Er ist komplett schwarz.",
					"roleType": "TALK_ROLE_NPC",
