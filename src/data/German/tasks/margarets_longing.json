					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4870501,
					"content": "Prinz hat wirklich gute Sinne. Deswegen ist er gleich davongelaufen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870502,
					"content": "Versuche, dich ihm <color=#00E1FFFF>von hinten zu nähern</color>. Am besten duckst du dich und gehst auf Zehenspitzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870503,
					"content": "Wer fliegen kann, ist klar im Vorteil, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870504,
					"content": "Wenn du dir unsicher bist, kannst du den <color=#00E1FFFF>Fisch</color> nehmen, um seine Aufmerksamkeit zu erhalten. Katzen lieben doch Fisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870505,
					"content": "Wenn du keinen <color=#00E1FFFF>Fisch</color> mehr hast, kannst du an den See gehen und welche fangen. Viel Erfolg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
