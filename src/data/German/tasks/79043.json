			"dialogs": [
				{
					"id": 790430101,
					"content": "Liegen hier Tagebücher auf dem Boden? Wie ist das möglich ... War schon jemand anderes hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790430102
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790430102,
					"content": "Hm, dieser Maler scheint einen Sinneswandel zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790430103,
						790430104
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790430103,
					"content": "Er hat wahre Meister getroffen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790430105
					]
				},
				{
					"id": 790430105,
					"content": "Paimon hat gehört, dass man sich umso schlechter fühlt, je selbstsicherer man ist, wenn man einen schweren Rückschlag erleidet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790430106
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790430106,
					"content": "Paimon macht sich Sorgen um seinen Gemütszustand. Aber das alles ist schon sehr lange her. Wir werden ihm nicht helfen können ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790430107
					],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790430107,
					"content": "Paimon ist neugierig, was danach mit ihm passiert ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lesen"
				},
				{
					"id": 790430104,
					"content": "*wimmer* Sieht aus, als hätte sein Ego einen schweren Schlag erlitten!",
					"roleType": "TALK_ROLE_PLAYER",
