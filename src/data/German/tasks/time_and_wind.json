				"points": []
			},
			"dialogs": [
				{
					"id": 710122401,
					"content": "Wo kommt dieses Ding her? Vorher war es nicht hier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122402
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122402,
					"content": "Wie hast du es beschworen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122403
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122403,
					"content": "Also ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710122404
					]
				},
				{
					"id": 710122404,
					"content": "Ah, also das ist „Zeit und der Wind ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122405
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122405,
					"content": "Es gibt also noch eine weitere Sonnenuhr genau wie diese auf der Insel, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122406
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122406,
					"content": "Und ist die Methode zur Lösung des Rätsels dieselbe? Dann muss es eine Verbindung zwischen diesen beiden Sonnenuhren und den beiden Orten geben, wo sie sich befinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122407
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122407,
					"content": "Ich muss einen Weg finden, auf diese Insel zu kommen, und zwar schnell ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710122408
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710122408,
					"content": "Vielen Dank, Reisender. Nachdem ich einige Vorkehrungen getroffen habe, werde ich mich auf die Suche nach dir machen, und wir werden diese unbewohnte Insel gemeinsam besuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		}
	]
