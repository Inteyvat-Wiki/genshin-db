			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710120101,
					"content": "„Geschichten, die der Wind trägt, werden zu ihrer Zeit zu Legenden erblühen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120102
					],
					"speakerTitle": "Beschädigte Schrift"
				},
				{
					"id": 710120102,
					"content": "Was soll das überhaupt bedeuten? ... Paimon weiß es nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120103,
					"content": "Trotzdem sieht dieser Ort aus, als verberge er ein Geheimnis ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120104,
					"content": "Schauen wir uns diesen Bereich an. Vielleicht finden wir einige Hinweise!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7101202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101215",
							"3"
						],
						"stepId": 7101215,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710120201,
					"content": "„Geschichten, die der Wind trägt, werden zu ihrer Zeit zu Legenden erblühen“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120202
					],
					"speakerTitle": "Beschädigte Schrift"
				},
				{
					"id": 710120202,
					"content": "Das muss die Sonnenuhr sein, die im Notizbuch erwähnt wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120203,
					"content": "Paimon versteht allerdings nicht, was an dem Ganzen so besonders ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120204,
					"content": "Wir sollten dieses Notizbuch vielleicht etwas gründlicher lesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7101210,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101210",
							"2"
						],
						"stepId": 7101210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Henry Morton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710121001,
					"content": "Hmm? Hast du hier etwas zu erledigen, Reisender?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121002
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121002,
					"content": "Wegen des Auge des Sturms ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121003
					]
				},
				{
					"id": 710121003,
					"content": "Das Auge des Sturms? Ich war die ganze Zeit in diesem Gebiet, und so etwas habe ich noch nie gesehen, außer diesem plötzlichen gewaltigen Wind vorhin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121004
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121004,
					"content": "Aber ich bin mir sicher, dass es kein Auge des Sturms war. Ich würde das Ding sonst überall erkennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121005,
						710121007
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121005,
					"content": "Tja dann ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121006
					]
				},
				{
					"id": 710121006,
					"content": "Glaub mir, ich könnte so etwas nicht vergessen, wenn ich meine Forschungen unterbrechen müsste, selbst wenn ich es versuchen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121009
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121009,
					"content": "Um präzise zu sein, ich forsche zusammen mit einem Freund von mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121010
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121010,
					"content": "Er ist auch ein Gelehrter, und wir sind zusammen auf die Akademie von Sumeru gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121011
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121011,
					"content": "Er wurde später Archäologe, reiste um die Welt und führte Untersuchungen durch, während ich meine Studien in der Akademie fortsetzte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121012
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121012,
					"content": "Als er nach Mondstadt kam, erzählte er mir voller Begeisterung, dass er den Tempel der tausend Winde untersucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121013
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121013,
					"content": "Er sagte sogar so etwas wie „Wenn ich erst einmal die Geheimnisse deines Vaterlandes enthüllt habe, bist du der erste, dem ich davon erzählen werde.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121014
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121014,
					"content": "Ich hörte danach nichts mehr von ihm. Ich habe jemanden gebeten, Cyrus einen Brief zu schicken und die Abenteurergilde zu bitten, mir bei der Suche nach dem Verbleib meines Freundes zu helfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121015
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121015,
					"content": "Aber es kam keinerlei Nachricht von ihm, und so brach ich meine Studien ab und eilte hierher zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121016
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121016,
					"content": "Aber hier gibt es nichts außer einer Sonnenuhr, und es gibt sonst keine weiteren Hinweise ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121017
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121017,
					"content": "Also, es gibt eine Sonnenuhr auf dieser Insel ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121018
					]
				},
				{
					"id": 710121018,
					"content": "Was? Es gibt eine weitere Sonnenuhr, die mit dieser identisch ist, und sie befindet sich auf einer Insel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121019
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121019,
					"content": "Oh, ja! jetzt erinnere ich mich. Manchmal habe ich diese Insel sogar schon gesehen, wenn das Wetter gut ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121020
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121020,
					"content": "Augenblick mal ... Du hast gesagt, dass du ein Notizbuch neben der Sonnenuhr gefunden hast? Ist der Bursche dort hingegangen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121021
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121021,
					"content": "Vielen Dank. Wenn ich die Gelegenheit habe, mache ich mich auf den Weg zu dieser Insel, um mir das anzusehen. Vorerst muss ich diesen Ort jedoch noch erforschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121022
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121022,
					"content": "Ich muss meine Forschungen weiterführen. Wenn du Interesse daran hast, kannst du einen Blick auf meine Forschungsnotizen werfen. Ich habe sie dort drüben gelassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121023
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121023,
					"content": "Aber wer weiß? Vielleicht ist da etwas drin, das dir helfen könnte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121007,
					"content": "Wonach suchst du denn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121008
					]
				},
				{
					"id": 710121008,
					"content": "Ich? Ich betreibe ein wenig Forschung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121009
					],
					"speakerTitle": "Henry Morton"
				}
			]
		},
		{
