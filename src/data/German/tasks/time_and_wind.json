					"Henry Morton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710121101,
					"content": "Zeit und Wind ... Was hat der Bursche hier gefunden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121102,
						710121106
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121102,
					"content": "Zeit und Wind?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121103
					]
				},
				{
					"id": 710121103,
					"content": "Oh, mein Freund hat das in seinem letzten Brief erwähnt, den er mir geschickt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121104
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121104,
					"content": "Er sagte, dass „die Zeit und der Wind“ eines der Mysterien von Mondstadt verbergen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121105
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121105,
					"content": "Allerdings habe ich diesen Satz noch nie zuvor gehört, und ich komme von hier. Wer weiß, wo er das aufgeschnappt hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121106,
					"content": "Hast du in Sumeru studiert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121107
					]
				},
				{
					"id": 710121107,
					"content": "Das habe ich. Ich komme zwar aus Mondstadt, aber ich habe schon immer an der Akademie von Sumeru studiert. Vermutlich habe ich dort mehr Zeit verbracht als in Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121108
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121108,
					"content": "Willst du wissen, was dort passiert? Nun, es ist kein Geheimnis, also ... Hmm, wie soll ich es ausdrücken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121109
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121109,
					"content": "Sie sind ein Horde seltsamer Leute. Hmm, vielleicht ist das zu respektlos ... Ich vermute, man sagt, es sind „Leute, die einen ziemlichen Eindruck machen?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121110
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121110,
					"content": "Falls du jemals die Möglichkeit hast, dorthin zu gehen, wirst du verstehen, was ich meine. Aber wirf einfach nur einen Blick darauf. Du solltest nicht zu lange bleiben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		},
