			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Oz",
					"Fischl",
					"Mona",
					"Xinyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400740901,
					"content": "Die Umgebung hat sich verändert. Das ist nicht der Strand, an dem wir vor unserer Abreise waren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740902
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740902,
					"content": "Es sieht aus, als wären dies die Berge von Mondstadt. Bedeutet das, dass wir nach Mondstadt geschickt wurden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740903
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400740903,
					"content": "Dennoch ist sie vom grenzenlosen Meer umgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740904
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740904,
					"content": "Es sollte in der Gegend zugängliche Teiche geben, wie der, wie gerade eben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740905
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740905,
					"content": "Hier drüben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740906
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740906,
					"content": "... Hm? Kann nicht direkt eintreten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740907
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740907,
					"content": "Etwas scheint aus dem Wasser aufgetaucht zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400740908,
					"content": "Ist das ein Bild? Oder ist es ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740909
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740909,
					"content": "Es scheint ein Hinweis auf einen bestimmten Ort zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740910
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740910,
					"content": "Es bittet mich, uns alle dorthin zu bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740911
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740911,
					"content": "Warum führst du die Gruppe wieder ... Egal, wer auch immer führt, lasst uns trotzdem zuerst diesen Ort finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007411,
			"completionStepIds": [
				4007411
			],
