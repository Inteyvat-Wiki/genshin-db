			"dialogs": [
				{
					"id": 400741201,
					"content": "Megistus ... Das ist so traurig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741202
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741202,
					"content": "Ah, tröste mich nicht. Das wäre mir peinlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741203
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741203,
					"content": "Taten statt Worte. Möchtest du eine Umarmung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741204
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741204,
					"content": "Nein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741205
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741205,
					"content": "Das sind meine früheren Erkenntnisse, als ich mich gerade erst mit der Astrologie vertraut gemacht hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741206,
					"content": "Ich bin jetzt schon ein alter Hase und werde mich nicht mehr von sterblichen Meinungen beeinflussen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741207,
					"content": "Es ist überraschend, dass auch Hofmagierin Megistus, eine schwere Phase des Durchwurstelns hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741208
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400741208,
					"content": "Es muss schwer sein, ein Leben zu führen, in dem man missverstanden wird ... Es ist gut, dass du loslässt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741209,
					"content": "Es gibt tatsächlich Menschen, die die Astrologie aufgegeben haben, weil sie das alles nicht aushielten und den Schmerz nicht ertrugen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741210,
					"content": "Aber ich bin ein Genie, also bin ich sicher, dass ich Dinge tun kann, die andere nicht können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741211,
					"content": "Das ist eine besonders kühne Behauptung an einem so großartigen und schönen Ort!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741212,
						400741213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400741212,
					"content": "Mona ist erstaunlich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741214
					]
				},
				{
					"id": 400741214,
					"content": "Sehr gut, sehr gut, noch ein paar weitere Komplimente.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741215
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741215,
					"content": "Nun ... Ich will ja nicht stören, aber da drüben ist doch eine Tür, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741216
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741216,
					"content": "Also, ich gebe euch allen die Ehre, mir ein großes Kompliment zu machen, sobald wir dieses Gebiet geklärt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741213,
					"content": "Ich weiß, dass Mona ein absolutes Genie ist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741214
					]
				}
			]
		}
	]
