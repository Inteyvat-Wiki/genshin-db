				"points": []
			},
			"dialogs": [
				{
					"id": 400740301,
					"content": "Was für ein prächtiges Bauwerk ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740302
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740302,
					"content": "Ooh ... So einen Ort habe ich noch nie gesehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740303
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740303,
					"content": "He Mona, deine Illusion ist einfach super!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740304
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740304,
					"content": "Es ist immer noch etwas schäbig im Vergleich zum Immernachtreich, aber es ist nicht schlecht, Megistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740305
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740305,
					"content": "(Toll, zum Glück war es keine Lektion, in der ich von der Alte unterrichtet wurde ... Das erspart mir die Schande ...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740306
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740306,
					"content": "Die Illusion einer genialen Astrologin muss natürlich großartig sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740307
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740307,
					"content": "Jetzt kann die Suche beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
		{
			"id": 4007409,
			"completionStepIds": [
				4007409
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
