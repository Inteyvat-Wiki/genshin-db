			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xinyan",
					"Kaedehara Kazuha",
					"Fischl",
					"Oz",
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400741101,
					"content": "Hier entlang, alle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741102
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741102,
					"content": "Sind alle wach? Mona sagte gerade, dass es eine wichtige Mitteilung gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741103
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741103,
					"content": "Wenn die Morgendämmerung nach dem hochwohlgeborenen Besuch im Immernachtreich einsetzt, ist das für mich eine wahre Freude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741104
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400741104,
					"content": "Das Fräulein meint damit, dass sie bereit ist, sich den kommenden Herausforderungen zu stellen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741105
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741105,
					"content": "Wir haben auch genug geschlafen und gegessen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400741106,
					"content": "Gut. Dann sage ich es einfach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741107,
					"content": "Ich habe es mir gerade mit dem Wasserspiegel wahrgesagt, und es gibt eine neue Illusion, die auf der Insel dort drüben Gestalt angenommen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741108,
					"content": "Und ... wenn meine Instinkte richtig liegen, sollte es etwas mit mir zu tun haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741109,
					"content": "Diesmal ist es Mona. Mona hat uns bei den letzten Illusionen begleitet. Jetzt sind wir an der Reihe, deine zu besuchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741110
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741110,
					"content": "Äh ... Das gibt es nichts zu sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741111
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741111,
					"content": "Megistus, ist es dir peinlich?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741112
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400741112,
					"content": "Nein, nein, wie könnte es sein, ahaha ... Ich mache mir keine Sorgen, dass Leute zu schäbige Illusionen sehen und Vorurteile gegen mich haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741113,
					"content": "Alles ist gesagt ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741114,
					"content": "Eigentlich ... Denken die Leute im Allgemeinen, dass Astrologen ziemlich transzendent sind, oder? Ich bin besorgt, dass meine Illusion nicht so wirken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741115,
					"content": "Auf solche Dummheit freue ich mich nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741116
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400741116,
					"content": "Mir auch. Es ist nicht so, dass ich keine Erwartungen an dich hätte, aber ich denke, Mona, dass du ein freundlicher und guter Mensch bist und dich nicht verstellen musst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741117
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400741117,
					"content": "Wer ein gutes Herz hat, muss auch eine nette Illusion haben. Das ist doch eine schöne Sache.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741118
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400741118,
					"content": "Ja, und außerdem geht es bei unserem Besuch bei deiner Illusion um mehr als nur eine Besichtigungstour, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741119,
						400741120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400741119,
					"content": "Ja. Vielleicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741121
					]
				},
				{
					"id": 400741121,
					"content": "... Also, das ist doch gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400741122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741122,
					"content": "Solange ihr nicht zu viel erwartet, bin ich nicht nervös. Gut, dann lasst uns loslegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 400741120,
					"content": "Wir könnten dort die Wahrheit hinter den Illusionen finden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400741121
					]
				}
			]
		},
