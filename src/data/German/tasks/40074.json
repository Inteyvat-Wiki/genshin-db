				"points": []
			},
			"dialogs": [
				{
					"id": 400740201,
					"content": "Der Wasserspiegel zeigt, dass wir die Illusion schon erreicht haben. Nun, finden wir zunächst den Eingang ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740202
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740202,
					"content": "Könnte er das da drüben sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400740203,
					"content": "Das sieht ... wie ein Teich aus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740204
					],
					"speakerTitle": "Xinyan"
				},
				{
					"id": 400740204,
					"content": "Müssen wir drinnen schwimmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400740205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740206,
					"content": "Kann jemand von uns nicht schwimmen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740207,
					"content": "Das ist nicht das Problem ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740208
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 400740208,
					"content": "Aha, da hat wohl jemand Angst, oder? Na gut, dann gehe ich mal voran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740209,
					"content": "Schon wieder! Beim Schwimmen ist sie so selbstsicher, dass sie anfängt, damit anzugeben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740210
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740210,
					"content": "Ähem! Achtet bitte auf Eure Formulierungen, Fräulein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740211
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 400740211,
					"content": "Ah, oh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740212
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 400740212,
					"content": "Bis später!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400740213
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 400740213,
					"content": "Ah, Mona ist in den Teich gesprungen und verschwunden? Folgen wir ihr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
