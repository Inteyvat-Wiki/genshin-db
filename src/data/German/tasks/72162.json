			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Fujiwara Toshiko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721620101,
					"content": "D... Danke dir ... Puh, wenn ich bedenke, dass diese Typen mich unversehens fangen wollten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620102,
						721620103
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620102,
					"content": "Wer bist du?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				},
				{
					"id": 721620104,
					"content": "Ich bin Fujiwara Toshiko und ich bin hier, um ... Hm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620105
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620105,
					"content": "Schon gut. Nachdem du mich gerettet hast, kann ich es dir auch sagen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620106
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620106,
					"content": "Ich bin tatsächlich hier, um einen Schatz zu finden, den meine Vorfahren zurückgelassen haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620107
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620107,
					"content": "S... Schatz ...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721620108,
					"content": "Und du hast ihn gefunden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620109
					]
				},
				{
					"id": 721620109,
					"content": "Hahaha, natürlich habe ich das. Ich bin einigen Spuren zu dem Ort des Schatzes gefolgt und ich habe herausgefunden, wie ich hineinkomme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620110
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620110,
					"content": "Aber genau als ich den Schalter aktivieren und den Bereich mit dem Schatz betreten wollte, sind diese Monster gekommen und haben mich angegriffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620111
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620111,
					"content": "Du hast mein Leben damit gerettet, dass du diese Monster verjagt hast. Danke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620112
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620112,
					"content": "Äh, also, könnte ich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620113
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620113,
					"content": "Könnte ich dich darum bitten, mich noch ein bisschen länger zu beschützen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620114
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620114,
					"content": "Ich muss diesen Schatz noch finden, aber ich glaube nicht, dass ich all diese Monster alleine schaffen kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620115
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620115,
					"content": "Ich werde ... Ich werde sogar etwas von dem Schatz mit euch teilen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620116,
						721620117
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620116,
					"content": "Ist hier wirklich ein Schatz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620118,
					"content": "Ich bin mir sicher! Vertrau mir einfach!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620119
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620119,
					"content": "Ich habe sogar den Schalter gefunden, der es uns erlauben wird, den Ort zu betreten, an dem der Schatz versteckt ist. Er ist dort drüben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620120
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620120,
					"content": "Die Vorrichtung scheint sich jedoch nicht direkt öffnen zu lassen. Sie benötigt irgendeine spezielle Methode zur Aktivierung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620121
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620121,
					"content": "Ich habe eine Karte, mir überlassen von meinen Vorfahren, dabei und sie zeigt Hinweise, wie ich diese Vorrichtung verstehen könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620122
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620122,
					"content": "Aber ... Hehe, ich habe ihn noch immer nicht verstanden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620123
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620123,
					"content": "Hier, warum schaut ihr nicht selbst? Es kann ja gut sein, dass ihr etwas herausfindet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620124
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620124,
					"content": "*seufz* Aber wirklich, wie soll ich dieses Rätsel lösen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620117,
					"content": "Kannst du ihn wirklich finden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620103,
					"content": "Was machst du hier überhaupt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				}
			]
		},
