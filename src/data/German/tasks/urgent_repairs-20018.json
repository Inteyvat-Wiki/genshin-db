			"dialogs": [
				{
					"id": 200180201,
					"content": "In den Wäldern müsstest du <color=#00E1FFFF>stabile Bretter</color> finden. Komm zurück, wenn du eins hast.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ängstlicher Magar"
				}
			]
		},
		{
