					"Ängstlicher Magar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200180401,
					"content": "#Puh ... Danke, {F#Reisende}{M#Reisender}. Gut, dass du da bist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180402
					],
					"speakerTitle": "Ängstlicher Magar"
				},
				{
					"id": 200180402,
					"content": "Aber nach all dem Schlamassel weiß ich nicht, wie ich den Wagen jetzt noch reparieren kann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180403
					],
					"speakerTitle": "Ängstlicher Magar"
				},
				{
					"id": 200180403,
					"content": "Überall ist was kaputt ... Selbst wenn ich das alles repariere, wird es auf dem Weg auseinanderfallen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180404
					],
					"speakerTitle": "Ängstlicher Magar"
				},
				{
					"id": 200180404,
					"content": "Was soll’s ... Dann werde ich den Wagen zumindest in die Stadt bringen und mir dann etwas überlegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180405
					],
					"speakerTitle": "Ängstlicher Magar"
				},
				{
					"id": 200180405,
					"content": "Da muss doch ein Seil auf dem Wagen sein ... Das haben diese Kerle sicher mitgehen lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180406
					],
					"speakerTitle": "Ängstlicher Magar"
				},
				{
					"id": 200180406,
					"content": "#{F#Reisende}{M#Reisender}, könntest du für mich in die Wälder gehen und nach einem <color=#00E1FFFF>Seil</color> suchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ängstlicher Magar"
				}
			]
		},
