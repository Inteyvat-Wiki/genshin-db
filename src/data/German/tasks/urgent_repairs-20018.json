			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ängstlicher Magar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200180101,
					"content": "#Danke, {F#Reisende}{M#Reisender}. Hach, ich hab doch gewusst, dass ich das nicht hinkriegen würde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180102
					],
					"speakerTitle": "Ängstlicher Magar"
				},
				{
					"id": 200180102,
					"content": "Ich schaffe es ja noch nicht einmal, eine Ladung Wein zu befördern. Wozu soll ich denn dann noch gut sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180103
					],
					"speakerTitle": "Ängstlicher Magar"
				},
				{
					"id": 200180103,
					"content": "Ich werde bestimmt aus der Taverne geworfen. Connor wird bestimmt schon längst bemerkt haben, dass ich es nicht draufhabe. Elzer ist mit Sicherheit schon dabei, mein Kündigungsschreiben zu verfassen. Das war’s. Alles ist aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180104
					],
					"speakerTitle": "Ängstlicher Magar"
				},
				{
					"id": 200180104,
					"content": "Jetzt beruhige dich doch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200180105
					]
				},
				{
					"id": 200180105,
					"content": "Hach, es ist aussichtslos. Dennoch werde ich den Wein noch liefern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180106
					],
					"speakerTitle": "Ängstlicher Magar"
				},
				{
					"id": 200180106,
					"content": "#Der Wagen ist kaputt ... {F#Reisende}{M#Reisender}, könntest du mir einige Materialien zur Reparatur besorgen? Ein <color=#00E1FFFF>stabiles Brett</color> sollte genügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ängstlicher Magar"
				}
			]
		},
		{
			"id": 2001802,
