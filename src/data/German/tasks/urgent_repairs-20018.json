			},
			"dialogs": [
				{
					"id": 200180601,
					"content": "#Danke, {F#Reisende}{M#Reisender}. Du warst mir eine große Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180602
					],
					"speakerTitle": "Ängstlicher Magar"
				},
				{
					"id": 200180602,
					"content": "Damit komme ich sicher noch bis Quellingen. Sobald ich meine Waren abgeliefert habe, werde ich beim Weingut Bericht erstatten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180603
					],
					"speakerTitle": "Ängstlicher Magar"
				},
				{
					"id": 200180603,
					"content": "Dabei muss ich sagen, dass ich mir nicht sicher sein kann, dass mich Elzer nicht auf der Stelle feuert, sobald er den Wagen sieht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ängstlicher Magar"
				}
			]
		},
