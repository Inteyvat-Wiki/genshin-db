					"Ängstlicher Magar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200180301,
					"content": "Damit sollte es gehen. Ich denke, also ich vermute, dass ich den Wagen reparieren können müsste ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180302
					],
					"speakerTitle": "Ängstlicher Magar"
				},
				{
					"id": 200180302,
					"content": "#Die sind ja schon wieder da! {F#Reisende}{M#Reisender}, bitte hilf mir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ängstlicher Magar"
				}
			]
		},
		{
			"id": 2001804,
