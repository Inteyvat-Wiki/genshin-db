			"dialogs": [
				{
					"id": 766580101,
					"content": "Hallo, Ginette. Hast du die Roboter, die wir gefunden haben, schon neu justiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580102,
					"content": "Ja, alles dank euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580103
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580103,
					"content": "Da wir gerade davon sprechen: Wir haben tatsächlich etwas Neues entdeckt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580104,
					"content": "Wirklich? Erzählt mir bitte davon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580105
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580105,
					"content": "Du und Paimon erzählt Ginette, was ihr vor nicht allzu langer Zeit gesehen habt.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766580106
					]
				},
				{
					"id": 766580106,
					"content": "Diese Verhaltensweisen, die ihr beschreibt ... Die Roboter scheinen euch wirklich zu mögen und haben euch zum „gemeinsamen Spielen“ eingeladen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580107
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580107,
					"content": "Wirklich? Wie interessant!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580108,
					"content": "Ja ... Ich habe es doch gewusst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580109
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580109,
					"content": "Ginette, hast du wieder etwas entdeckt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580110,
					"content": "Jetzt bin ich mir sicher, dass meine Ideen durch die Interaktion zwischen Robotern verwirklicht werden müssen. Je mehr Roboter ich wiederfinde, desto näher werde ich meinem ursprünglichen Konzept kommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580111
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580111,
					"content": "Sie verfügen bereits über die Fertigkeit, mit anderen zu kommunizieren. Wenn ich jetzt noch die restlichen Roboter finden kann ... lassen sich meine Ideen doch noch verwirklichen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580112
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580112,
					"content": "Oh, wie spannend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580113,
					"content": "Ach, tut mir leid. Was das angeht, muss ich immer noch auf euch zählen. Das nächste Gebiet ist auch auf der Karte markiert.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580114
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580114,
					"content": "Lass uns so schnell wie möglich losgehen. Paimon ist schon neugierig, was diese Roboter am Ende machen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}