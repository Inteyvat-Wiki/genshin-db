				"points": []
			},
			"dialogs": [
				{
					"id": 230220101,
					"content": "Wenn wir hier die Stärke erhöhen, dann müssen wir ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220102,
					"content": "Wenn du diesen Entwurf übernimmst, dann macht das keinen großen Unterschied zu dem vorherigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220103
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230220103,
					"content": "Seid ihr immer noch dabei, den Entwurf des Boots zu erstellen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220104
					]
				},
				{
					"id": 230220104,
					"content": "#Ah, du bist es, {F#Reisende}{M#Reisender}. Ja, nach den letzten Testergebnissen haben Qishan und ich noch einmal über ein paar ... ähm ... Schlüsselfaktoren des Entwurfs gesprochen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220105,
					"content": "Wir haben uns ... umfassend ausgetauscht und sind dabei, einen neuen Entwurf auszuprobieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220106,
					"content": "Aber bezüglich der Materialwahl haben wir noch ein paar Differenzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220107,
					"content": "Aber dieses Mal habe ich Qishans Rat befolgt! Ich habe keine Kosten gescheut und gutes Material eingekauft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220108,
					"content": "#{F#Reisende}{M#Reisender}, schau! Alleine kann ich die Sachen nicht transportieren und Qishan ist auch nicht die Stärkste. Könntest du ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220109,
						230220110
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220109,
					"content": "Wir machen das zusammen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				},
				{
					"id": 230220111,
					"content": "Auf dich ist Verlass! Lass uns loslegen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220112,
					"content": "Dieses Mal hat Qishan die Materialien eigenhändig ausgewählt. Jetzt sollte es keine Probleme geben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220113,
					"content": "Dieses Mal habe ich auch eine größere Belohnung für dich. Ich bin dir für deine Hilfe wirklich dankbar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220110,
					"content": "Alles klar. Auf geht’s.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				}
			]
		},
