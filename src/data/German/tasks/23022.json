			"dialogs": [
				{
					"id": 230220501,
					"content": "Also gut! Diese Materialien sollten genügen. Hier ist deine Belohnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220502
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220502,
					"content": "Aber ... Diese Materialien sind irgendwie ziemlich leicht ... Sind die Materialien, die Qishan ausgewählt hat, wirklich zuverlässig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220503
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220503,
					"content": "Vertrau mir. Diese Materialien sind besser als die, die du vorher ausgewählt hattest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220504
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230220504,
					"content": "Dann hilf mir dieses Mal, die Rettungswesten vorzubereiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220505
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220505,
					"content": "Klar, du kannst dich auf mich verlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qishan"
				}
			]
