			},
			"dialogs": [
				{
					"id": 705030101,
					"content": "Kleine Tasse Schaumiges Riff ... danke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030102,
						705030103
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030102,
					"content": "Eula?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030104
					]
				},
				{
					"id": 705030104,
					"content": "Alles in Ordnung ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030105
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030105,
					"content": "Nun ... Irgendetwas stimmt nicht mit Eula ... Hat sie viel getrunken, bevor sie hierherkam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030106,
					"content": "Paimon erinnert sich, dass Schaumiges Riff mit Kaffee zubereitet wird. Wenn du nach dem Alkohol einen Kaffee trinkst, explodiert dein Magen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030107,
					"content": "Gib ihr ihrem Magen zuliebe etwas Wasser, bevor du das servierst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030103,
					"content": "Was ist mit dir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030104
					]
				}
			]
		},
		{
			"id": 7050302,
			"completionStepIds": [
				7050303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050303",
							"2"
						],
						"stepId": 7050303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705030238,
					"content": "Nach den Anweisungen von Paimon mischst du Wasser in den Kaffee ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 705030201,
					"content": "Es ist ... ziemlich gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030202
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030202,
					"content": "Oha, das ist eine Menge Wasser und sie hat es nicht einmal bemerkt, also hat Eula wirklich zu viel getrunken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030203,
					"content": "Wirt ... Warte, warum seid ihr es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030204,
						705030205
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030204,
					"content": "Wir probieren die Tätigkeit als Wirt aus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030206
					]
				},
				{
					"id": 705030205,
					"content": "Hast du das erst jetzt gemerkt?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030206
					]
				},
				{
					"id": 705030206,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030207
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030207,
					"content": "Entschuldigung. Ich komme gerade von Zum Katzenschwanz und habe vielleicht ein bisschen zu viel getrunken ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030208,
						705030209
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030208,
					"content": "Kann ich dir vielleicht weiterhelfen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030210
					]
				},
				{
					"id": 705030209,
					"content": "Lass uns etwas plaudern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030210
					]
				},
				{
					"id": 705030210,
					"content": "Ja. Es ist so einsam, allein zu trinken, es ist besser, darüber zu reden und sich zu amüsieren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030212
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030212,
					"content": "Tatsächlich trinkt nur eine Person.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030213
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030213,
					"content": "Solange ich in Mondstadt bin, werde ich in den Kneipen nicht willkommen sein. Ich habe mich heute eigentlich gut gefühlt und wollte etwas trinken, aber sie wollten mich nicht in Ruhe lassen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030214,
					"content": "#{NICKNAME}, woher hast du so viele Freunde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030215
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030215,
					"content": "Die Leute klingen immer so dankbar und lächeln, wenn sie über dich sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030216
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030216,
					"content": "Aber bei mir reicht schon die Erwähnung meines Familiennamens aus, um alle ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030217
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030217,
					"content": "Sag das nicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030218
					]
				},
				{
					"id": 705030218,
					"content": "Du hast es dir nicht ausgesucht, in den Lawrence-Klan hineingeboren zu werden, und so etwas interessiert uns nicht. Die Eula, die wir kennen, ist ein toller Mensch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030219,
					"content": "Aber du magst es nicht, direkt zu sein. Du tust immer so, als würdest du einen Groll hegen, und versuchst, deine Zärtlichkeit vor allen zu verbergen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030220,
					"content": "Wer sagt das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030221,
						705030222
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030221,
					"content": "Außer uns ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030223
					]
				},
				{
					"id": 705030222,
					"content": "... gibt es noch andere Leute, die Eula anerkennen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030223
					]
				},
				{
					"id": 705030223,
					"content": "Glaubst du das? Das kann ich mir nicht vorstellen, selbst wenn ich so betrunken bin ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030224
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030224,
					"content": "So lange, selbst nach dem Beitritt zu den Rittern des Ordo Favonius, war jeder ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030225
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030225,
					"content": "Die Windrichtung kann sich jederzeit ändern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030226
					]
				},
				{
					"id": 705030226,
					"content": "Oh! Auch der Straßenmusikant sagte etwas, das schon stimmt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030227,
					"content": "Mach einfach so weiter wie bisher, Eula.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030228,
					"content": "Früher oder später wirst du ändern, was die Leute über den Lawrence-Klan denken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030229,
					"content": "Du brauchst Geduld.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030230
					]
				},
				{
					"id": 705030230,
					"content": "Danke sehr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030231
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030231,
					"content": "Ich ... ähm! Ich sollte jetzt gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030232
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030232,
					"content": "Sollen wir dich begleiten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705030233
					]
				},
				{
					"id": 705030233,
					"content": "Das ist nicht nötig. Ich will mir merken, was du gesagt hast, und ich werde an nichts anderes denken können, bis ich alles aufgeschrieben habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030234
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 705030234,
					"content": "Die betrunkene Eula ist offener als sonst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030235,
					"content": "Aber wenn Paimon diesen ikonischen Satz nicht hört, hat Paimon immer das Gefühl, dass etwas fehlt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030236,
					"content": "Ah! Wenn sie wieder nüchtern ist, wird sie dann schnaufen und uns drohen, den heutigen Tag zu vergessen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705030237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705030237,
					"content": "Hmm, vielleicht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}