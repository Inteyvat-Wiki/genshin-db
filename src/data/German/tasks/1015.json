			"dialogs": [
				{
					"id": 10151101,
					"content": "Sehr schön, wir sind gut im Plan, die Aushilfsarbeiter sind angeheuert, den Duft der Unvergänglichkeit haben wir auch. Wir stehen kurz vor Abschluss der Vorbereitungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151102,
					"content": "Puh ... Endlich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10151103,
					"content": "#Und, {F#Reisende}{M#Reisender}, hast du bereits etwas auf unserer Reise lernen können?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151104
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151104,
					"content": "Es war eine sehr bizarre Reise bisher.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151105
					]
				},
				{
					"id": 10151105,
					"content": "Bizarr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151106,
						10151107
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151106,
					"content": "Ich bin nicht sicher, ob wir das Leben der Reichen und Mächtigen voll und ganz erlebt haben ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151108
					]
				},
				{
					"id": 10151108,
					"content": "Hahaha, nun, welches von beiden ist es? Solche Fragen, die während des Reisens aufkommen können, sind nie leicht zu beantworten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151109,
					"content": "Die Erfahrungen einer Reise muss der Reisende selbst langsam verarbeiten. Übrigens, als Dankeschön für die Hilfe bei der Vorbereitung des Adeptenabschieds habe ich beschlossen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151110,
					"content": "Euch einzuladen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151111,
						10151112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151111,
					"content": "Zhongli ... lädt uns ein?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151113
					]
				},
				{
					"id": 10151113,
					"content": "Hm? Ach so, seid beruhigt, dieses Mal werde ich meine Geldbörse mitbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151114
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151114,
					"content": "Heute Abend zeige ich euch einen in ganz Liyue bekannten Weinkeller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151115
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151115,
					"content": "Ein Weinkeller in Liyue? Kann man da wirklich Alkohol trinken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10151116,
					"content": "Genauso ist es. Wir treffen uns in der Nähe der Anlegestelle am „Dreibecherrausch“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151112,
					"content": "Du meine Güte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151113
					]
				},
				{
					"id": 10151107,
					"content": "Oder eher den täglichen Kampf ums Überleben der Armen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151108
					]
				}
			]
		},
