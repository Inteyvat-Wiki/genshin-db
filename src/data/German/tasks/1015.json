					"nextDialogs": [
						10151410
					]
				},
				{
					"id": 10151410,
					"content": "Vom Herumstehen finden wir auch keine Lösung. Lasst uns einfach zurück zu Qiqi gehen und ihr sagen, dass wir die Kokosziege nicht gefunden haben. Dann sehen wir weiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151411
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151411,
					"content": "Richtig, außerdem halten wir uns an das Sprichwort aus Liyue, „Gib dein Bestes.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10151408,
					"content": "Haben wir also das Guizhong-Geschütz ganz umsonst repariert?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151409
					]
				},
				{
					"id": 10151409,
					"content": "Wir haben getan, was wir konnten. Sag doch sowas nicht!",
