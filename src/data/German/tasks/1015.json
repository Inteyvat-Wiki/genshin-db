					"nextDialogs": [
						10151403
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151403,
					"content": "Wir haben zwar das erforderliche Guizhong-Geschütz gefunden, aber diese Kokosziege haben wir immer noch nicht erlegt.",
