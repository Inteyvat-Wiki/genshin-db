					"speakerTitle": "Paimon"
				},
				{
					"id": 10151404,
					"content": "Die Teleskopsuche mit dem Guizhong-Geschütz hat nichts Außergewöhnliches ergeben, außer ein paar gewöhnlicher Wildtiere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151405,
					"content": "Sollte es sich außerdem wirklich um eine göttliche Bestie handeln, sollte diese Vorrichtung der Adepten in der Lage sein sie aufzuspüren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151406
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151406,
					"content": "Also das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151407,
						10151408
					],
					"speakerTitle": "Paimon"
				},
