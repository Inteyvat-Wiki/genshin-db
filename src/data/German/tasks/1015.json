				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150301,
					"content": "Schwer vorzustellen, dass sie so groß ist. Nur die Adepten können solch eine Kreatur hinterlassen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150302,
					"content": "Aber wie benutzt man das nur? Was benötigt man für eine Kraft, um es zu bedienen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150303,
					"content": "Momentan ist es sowieso nicht bedienbar, weil es kaputt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150304,
					"content": "Also wirklich kaputt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150305,
					"content": "Nun, nach Tausenden von Jahren in Wind und Frost, dann noch aus adeptischem Hause, da ist es schwierig, es in gutem Zustand zu halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150306,
					"content": "Und was machen wir jetzt? Herr Zhongli, nutzt Euer Oberschichtenwissen und lasst Euch was einfallen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150307,
					"content": "Also, stell mich doch nicht so dar, als wüsste ich nur über Operetten und schicke Abendveranstaltungen Bescheid.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150308,
					"content": "Mal überlegen ... Als das Guizhong-Geschütz gebaut wurde, hat man Ersatzteile und Material beiseitegelegt, falls es einmal durch Gefechte beschädigt werden würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150309
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150309,
					"content": "Wenn ich mich nicht irre, sollte sich die Gerätekammer genau in der Mitte der alten Stadtmauer befinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150310,
					"content": "Wenn wir an das gelagerte Material in der Gerätekammer gelangen können, müssen wir nur noch herausfinden, wie man es verwendet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150311,
					"content": "Also ... Zhongli, wisst Ihr, wie man das Geschütz bedient?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150312,
					"content": "Ein kleines bisschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150313
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150313,
					"content": "Wir müssen nur <color=#00E1FFFF>genug Material</color> zusammensuchen, dann können wir es sofort ausprobieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 101506,
			"completionStepIds": [
				101515
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101506",
							"2"
						],
						"stepId": 101506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150601,
					"content": "Diese Reservematerialien sind auch bestimmt noch einsatzbereit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150602
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150602,
					"content": "Einen kleinen Moment bitte, ich versuche, das Geschütz zu reparieren ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150603
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150603,
					"content": "Fertig. Das „Guizhong-Geschütz“ ist noch raffinierter, als ich es in Erinnerung hatte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150604,
					"content": "Klasse! Und wie steuern wir das Ganze?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150605,
					"content": "Ganz einfach, man drückt einfach hier ... Seht, diese Vorrichtung der Adepten hat sogar noch ein Teleskop.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150617
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150617,
					"content": "Hier ist nichts, dort ist auch nichts ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150606,
					"content": "He! Was macht ihr denn da?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150607
					],
					"speakerTitle": "Sommersprossen-Huang"
				},
				{
					"id": 10150607,
					"content": "Diese große Armbrust, ihr habt sie repariert? Was pfuscht ihr denn hier herum?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150608
					],
					"speakerTitle": "Sommersprossen-Huang"
				},
				{
					"id": 10150608,
					"content": "Das ist keine Armbrust, das ist das Guizhong-Geschütz. Und noch etwas, stellt euch bitte erst einmal vor, bevor ihr hier Fragen stellt. Das nennt man Benehmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150609
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150609,
					"content": "Sieht man das denn nicht? Wir sind Mitglieder der Schatzräuber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150610
					],
					"speakerTitle": "Sommersprossen-Huang"
				},
				{
					"id": 10150610,
					"content": "Der Legende nach sind hier alle möglichen Schätze vergraben. Jetzt stellt sich auch noch heraus, dass diese Armbrust eigentlich ein Apparat ist, der anscheinend über diese ganze Gegend wacht, das ist nicht einfach.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150611
					],
					"speakerTitle": "Sommersprossen-Huang"
				},
				{
					"id": 10150611,
					"content": "Als wir das letzte Mal in die Berge gingen, wäre ein Kollege fast davon aufgespießt worden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150612
					],
					"speakerTitle": "Sommersprossen-Huang"
				},
				{
					"id": 10150612,
					"content": "Unter Einsatz unseres Lebens hatten wir es endlich geschafft, diesen Apparat zu beschädigen, dann kommt ihr einfach so daher und repariert ihn?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150613
					],
					"speakerTitle": "Sommersprossen-Huang"
				},
				{
					"id": 10150613,
					"content": "Heute werdet ihr dafür bezahlen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150614
					],
					"speakerTitle": "Sommersprossen-Huang"
				},
				{
					"id": 10150614,
					"content": "Hmm. Zu reinem Eigennutz das Erbe der Adepten zu schänden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150615
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150615,
					"content": "Ihr solltet eure Lektion doch gelernt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150616
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150616,
					"content": "#Das stimmt! {NICKNAME}, auf geht’s!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 101507,
			"completionStepIds": [
				101507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101507",
							"2"
						],
						"stepId": 101507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qiqi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150701,
					"content": "Verzeiht bitte, wir haben es nicht geschafft, die göttliche Bestie zu finden. Wir haben überall nach der legendären Kokosziege gesucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150702
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150702,
					"content": "Das ist enttäuschend. Es macht zwar nichts, aber es ist wirklich sehr enttäuschend.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150703
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150703,
					"content": "Paimon mag Qiqi gar nicht so sehen, Paimon hat auf einmal Schuldgefühle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150704,
						10150705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150704,
					"content": "Qiqi, kannst du uns noch irgendwelche weiteren Hinweise geben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				},
				{
					"id": 10150706,
					"content": "Die Milch von Kokosziegen schmeckt besser – viel besser als normale Milch. Daher müssen sie adeptischer Abstammung sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150707
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150707,
					"content": "Entschuldigt, mein Gedächtnis ist, nicht gut. Der Name der Milch, ich habe ihn, ihn aufgeschrieben ... ich, ich suche ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150708
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150708,
					"content": "Ah, genau, das war der Name ... „Kokosmilch“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150709
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150709,
					"content": "Wie?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150710,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150711
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150711,
					"content": "Entschuldigt bitte. Ich wollte nur einen gerechten Handel mit Qiqi eingehen. Ich hätte mich nicht so leicht darauf einlassen dürfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150712,
					"content": "Das macht nichts, Zhongli. Um es mit einem Sprichwort aus Liyue zu sagen „Die Welt ist unberechenbar, Freude und Sorge lassen sich schwer voraussagen“. Niemand konnte ahnen, dass die Sache so eine absurde Wendung nehmen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150713,
					"content": "Hat Qiqi etwa etwas Falsches gesagt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150714
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150714,
					"content": "#{NICKNAME}, Paimon überlässt es dir, die Illusionen eines Kindes zu zerstören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150715,
						10150716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150715,
					"content": "Kokosmilch, das kommt nicht von Kokosziegen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150717,
					"content": "Oh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150718
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150718,
					"content": "Qiqi scheint tief in Gedanken versunken zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150719,
						10150720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150719,
					"content": "Wir sollten sie nicht stören.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150721,
					"content": "Haha, das war eine Lektion für das Leben. Habt Dank, dass ihr auf meine Qiqi aufgepasst habt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150722
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150722,
					"content": "Mit wem haben wir die Ehre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150723
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150723,
					"content": "Verzeiht meine Manieren. Ich bin der Inhaber der Bubu-Hütte, mein Name ist „Baizhu“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150724
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150724,
					"content": "Also ist Qiqi gar nicht die Inhaberin hier, sondern dieser Typ mit der Medizin um seinen Hals?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150725,
					"content": "Sehr zu bemitleiden. Ich dachte schon Qiqi ist sehr einfältig, aber anscheinend gibt es noch einfältigere Opfer als sie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150726
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150726,
					"content": "Ah! Diese Zutaten ... Diese Schlange, sie sp-p-p-p-p-p-pricht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150727,
						10150728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150727,
					"content": "Die Schlange kann sprechen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150729,
					"content": "Normalerweise rede ich nicht. Aber bei unwissenden Fremden muss ich etwas sagen, sonst haltet ihr mich noch für eins der getrockneten Exemplare aus dem Medizinschrank.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150730
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150730,
					"content": "Hahaha, dies ist Changsheng, sie ist keinesfalls böswillig. Wenn ich fragen darf, außer der Spielerei mit Qiqi, wieso seid ihr hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150731
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150731,
					"content": "Wir sind hier, um uns nach dem „Duft der Unvergänglichkeit“ zu erkundigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150732,
					"content": "Ah ja, der „Duft der Unvergänglichkeit“, den habe ich da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150733
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150733,
					"content": "Puh, na dann ist ja gut, endlich mal etwas Positives.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150734,
					"content": "Drei Millionen Mora, Top-Qualität.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150735,
						10150737
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150735,
					"content": "Drei Millionen?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150736
					]
				},
				{
					"id": 10150736,
					"content": "Dann raub doch die Goldstube aus! Obwohl die Goldstube derweil auch von den Qixing eingespannt ist, das dürfte schwer werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150739,
					"content": "In der Tat. Drei Millionen hört sich zuerst nach nicht viel an, aber im Vergleich mit anderen Dingen könnte der Betrag doch schwierig zu beschaffen sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150740
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150740,
					"content": "So viele Mora! Wir können unter keinerlei Umständen so viel bezahlen! Und schon gar nicht Herr Zhongli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150741
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150741,
					"content": "So ist es.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150742
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150742,
					"content": "Direkt, aber wahr.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150743
					]
				},
				{
					"id": 10150743,
					"content": "Was sollen wir nur tun? Wir können nur den Grafen um Hilfe bitten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150744,
					"content": "Hahahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150745
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10150745,
					"content": "Eine Kokosziege, köstlich, ich habe mich schon lange nicht mehr so amüsiert! Jetzt könnt ihr es selbst nicht fassen, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150746
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10150746,
					"content": "Mach dich nicht über uns lustig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150747
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150747,
					"content": "Ich habe sogar schon Tränen in den Augen. Danke, dass ihr mich so aufgeheitert habt! Ich werde sämtliche Zahlungen einleiten und mich um alles kümmern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150748
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10150748,
					"content": "Verehrter Herr ... Baizhu, nicht wahr? Ich bin der Graf der Elf von den Fatui. Wenn es dir nichts ausmacht, können wir in Zukunft öfter kooperieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150749
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10150749,
					"content": "Falls die Bubu-Hütte Bedarf an Kokosmilch hat, können die Fatui den Bedarf schnell decken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150750
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10150750,
					"content": "Wie? Ich habe ja bereits gehört, dass die Fatui so versuchen, sich „Freunde“ zu machen. Aber die Bubu-Hütte mit Kokosmilch allein zu erkaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150751
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150751,
					"content": "Kokosmilch, Kokosmilch. Herr Bai, Kokosmilch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150752
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150752,
					"content": "Nun gut, nun gut ... Na dann danken wir mal dem werten Grafen und hoffen auf gute Zusammenarbeit. Für den Duft der Unvergänglichkeit gibt es auch einen Rabatt, jetzt nur noch zwei Millionen neunhundertneunzigtausend Mora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150753
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150753,
					"content": "Wo ist denn da der Rabatt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150754
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150754,
					"content": "Auf den ersten Blick klingt das nicht nach viel, aber immerhin ist es zehntausend Mora günstiger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150755
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150755,
					"content": "Sehr gut. Jetzt, da alles geregelt ist, können wir auch zur Yujing-Terrasse zurück. Herr Graf, Herr Baizhu, kleine Qiqi, auf Wiedersehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150756
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150756,
					"content": "Was für eine Truppe! Selten habe ich so gelacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150757
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10150757,
					"content": "Bevor ich hier ankam, habt ihr irgendwas gehört?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150758
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10150758,
					"content": "So ist es, Herr Graf. Sie haben von der Goldstube und den Qixing ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150759
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10150759,
					"content": "So ist das also. Ningguang und die Qixing wollen etwas in der Goldstube verstecken ... Außer dem Leichnam des Stammvaters der Adepten, was kann es sonst sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150760
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10150760,
					"content": "#Tut mir leid, {NICKNAME}. Aber hatte ich dir nicht schon einmal das alte Sprichwort gesagt? „Die Wände haben Ohren“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10150737,
					"content": "Dann raub doch die Goldstube aus!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150738
					]
				},
				{
					"id": 10150738,
					"content": "Allerdings ist die Goldstube derweil auch von den Qixing eingespannt, das dürfte schwer werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150728,
					"content": "Wir sind hier in Liyue, hier kann einen nichts mehr überraschen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150720,
					"content": "Solche Momente eignen sich für Kinder erwachsen zu werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150716,
					"content": "Kokosmilch kommt von Kokospalmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150705,
					"content": "Wofür braucht Qiqi denn diese Kokosziege?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				}
			]
		},
		{
			"id": 101509,
			"completionStepIds": [
				101509
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101509",
							"2"
						],
						"stepId": 101509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qiqi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150901,
					"content": "Ach, so ist das also, noch nicht einmal so groß wie der Tresen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150902,
						10150904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150902,
					"content": "Ist sie ... ein Zombie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150903
					]
				},
				{
					"id": 10150903,
					"content": "Ah, anscheinend wirklich! Sieh nur, auf ihrer Stirn klebt ein Beschwörungszauber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150908,
					"content": "Herzlich willkommen in der Bubu-Hütte, mein Name ist Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150909
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150909,
					"content": "Qiqi ist bereits einmal gestorben. Dann hat mich ein Adept gerettet und wiederbelebt. Also bin ich ein Zombie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150910,
						10150911
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150910,
					"content": "Sie sagt das, als wäre es die normalste Sache der Welt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150912,
					"content": "In Mondstadt wäre so etwas nicht vorstellbar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150913,
					"content": "Meine Herrschaften, fragt doch bitte mal im Laden nach, ob Duft der Unvergänglichkeit vorrätig ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150914
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150914,
					"content": "Entschuldigung, Rezept? Habt ihr ein ärztliches Rezept mitgebracht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150915
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150915,
					"content": "Um Duft der Unvergänglichkeit zu kaufen, braucht man doch kein Rezept, oder? Schließlich ist es ja nicht zur Heilung gedacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150916
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150916,
					"content": "Wenn ihr ein Rezept habt, kann Qiqi euch helfen. Das ist ein Befehl von Qiqi an Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150917,
						10150918
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150917,
					"content": "Befehl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150920
					]
				},
				{
					"id": 10150920,
					"content": "Damit Zombies etwas tun, brauchen sie Befehle. Ich verstehe nur nicht, warum dieses Mädchen sich selbst einen Befehl erteilt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150921
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150921,
					"content": "Meine liebe Qiqi, wir haben kein Rezept, aber wir hoffen, dass du uns helfen kannst den Duft der Unvergänglichkeit zu suchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150922,
					"content": "In Ordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150923
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150923,
					"content": "Äh? Warum geht es denn jetzt auf einmal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150924,
					"content": "Aber ihr müsst Qiqi auch einen Gefallen tun. Dann ist es gerecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150925
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150925,
					"content": "Ein Mitarbeiter hilft einem Kunden, sollte das nicht der Standard sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150926,
					"content": "Das macht doch nichts, wir müssen das nicht so eng sehen. In Liyue ist der Austausch von Gefälligkeiten eine hohe Kunstform.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150927
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150927,
					"content": "Dann bitte ich euch, zum Tianheng-Berg zu gehen. Nutzt das Guizhong-Geschütz und erlegt mir eine Kokosziege.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150928,
						10150930
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150928,
					"content": "Ich bin nicht sicher, ob ich das richtig verstanden habe ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150929
					]
				},
				{
					"id": 10150929,
					"content": "Guizhong-Geschütz ... Das hat sie doch eben gesagt, nicht wahr? Davon habe ich schon viel gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150932,
					"content": "Das Guizhong-Geschütz wurde in alten Zeiten von den Adepten am Tianheng-Berg errichtet. Es ist wie eine Art riesige Armbrust, eine mechanische Vorrichtung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150933,
					"content": "Es ist genau an der alten Tianheng-Stadtmauer positioniert und kann ideal Feinde aller Art und sogar größere Monster fernhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150934
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150934,
					"content": "Herr Zhongli weiß wirklich viel über Liyue.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150935
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150935,
					"content": "Anscheinend nicht genug. Denn von einer Kokosziege habe ich bisher noch nicht gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150936
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150936,
					"content": "Die Kokosziege ist eine legendäre göttliche Bestie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150937
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150937,
					"content": "Ach? Ist das alles?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150938,
					"content": "Ja. Die Kokosziege ist eine legendäre göttliche Bestie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150939
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150939,
					"content": "Wie sie aussieht, das weiß ich nicht. Wo man sie am besten antrifft, das weiß ich nicht. Woher sie kommt, das weiß ich auch nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150940,
						10150941
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150940,
					"content": "Wie kann jemand nur so ignorant sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150942,
					"content": "Kümmert euch nicht darum, geht erst zum <color=#00E1FFFF>Guizhong-Geschütz</color> und seht euch in der Gegend um. Vielleicht finden wir Hinweise vor Ort.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150943
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150943,
					"content": "„Kokosziege“ ... Was ist das nur für eine Art Kreatur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150941,
					"content": "Das wird aber schwierig ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150930,
					"content": "Sie macht doch wohl keine Witze ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150931
					]
				},
				{
					"id": 10150931,
					"content": "Natürlich nicht ... Was sie da gerade gesagt hat, davon habe ich schon viel gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150918,
					"content": "Das kann hier noch länger dauern ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150919
					]
				},
				{
					"id": 10150919,
					"content": "Nun ja, Befehlen muss man eben folgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150920
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150911,
					"content": "Macht dem Titel „Stadt der Götter“ alle Ehre ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150904,
					"content": "Also wenn es der Größe nach ginge, ist Paimon ja noch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150905
					]
				},
				{
					"id": 10150905,
					"content": "Hmpf! Paimon kann fliegen, daher ist Größe nicht wichtig!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150906,
					"content": "Wenn man sie so sieht, mit diesem Papier auf ihrer Stirn, das sieht schon komisch aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150907,
					"content": "Kann das denn sein ... ein Zombie?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "Paimon"
				}
			]
		},
