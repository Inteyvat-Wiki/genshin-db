					}
				]
			},
			"dialogs": [
				{
					"id": 130380201,
					"content": "Sethos, lass uns reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380202
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380202,
					"content": "Hast du es dir überlegt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380203
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380203,
					"content": "Dazu kommen wir gleich. Aber zuerst wusstest du, dass ich über einige medizinische Kenntnisse verfüge? Ich habe mich gefragt, ob ich mir deinen Großvater ansehen könnte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380204
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380204,
					"content": "Ich habe nichts dagegen, obschon wir hier unsere eigenen Ärzte haben. Ich bezweifle aber, dass du uns etwas sagen kannst, dass wir nicht schon wissen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380205
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380205,
					"content": "Es gibt nur einen Weg, das herauszufinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380206
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380206,
					"content": "Folgt mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380207
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380207,
					"content": "Sprecht etwas leiser. Wir wollen ihn nicht stören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380208
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380208,
					"content": "Tighnari packt seinen Arztkoffer aus und unterzieht Bamoun einer grundlegenden medizinischen Untersuchung.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380209
					]
				},
				{
					"id": 130380209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380210
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380210,
					"content": "Lass uns draußen reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380211
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380211,
					"content": "Bamoun liegt in einem tiefen Koma und die Prognose ist recht ernst. Zweifellos sind eure Ärzte zu derselben Einschätzung gelangt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380212
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380212,
					"content": "Er scheint in seiner Jugend eine ernsthafte Verletzung erlitten zu haben. Durch seine jahrelange schwere Arbeit scheint sich die noch verschlechtert zu haben. Und zuletzt, durch das hohe Alter ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380213
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380213,
					"content": "Leider muss ich euch mitteilen ... basierend auf dem, was ich von Patienten in ähnlicher Verfassung gesehen habe, dass er nicht mehr viel Zeit hat, höchstens ein paar Tage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380214
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380214,
					"content": "... Ja, ich habe es schon lange gewusst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380215
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380215,
					"content": "Du bist sein Erbe, nicht wahr? Du hast offensichtlich höchsten Respekt vor dem Mann. Aber du siehst die Dinge auch etwas anders. Du hast ein breiteres Spektrum an Anliegen und einen pragmatischeren Ansatz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380216
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380216,
					"content": "Also erzähl mir, wie wir das in deinem Sinne beenden können. Wir sollten einen Weg finden, das alles zu klären, solange Bamoun es noch erleben kann ... Das ist es, was dir echt am Herzen liegt, davon bin ich überzeugt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380217
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380217,
					"content": "Ja, wir haben keine Zeit zu verlieren. Du weißt das besser als irgendwer sonst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380218,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380219
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380219,
					"content": "Weißt du, ihr beide findet euch derzeit in einer sehr ähnlichen Lage. Ihr habt beide eine ganz andere Sichtweise als die Männer, die euch großgezogen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380220
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380220,
					"content": "Stimmt, und ihr habt diese Situation nicht herbeigeführt. Sie waren das. Aber aus irgendeinem Grund müsst ihr jetzt die schweren Entscheidungen treffen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380221,
					"content": "... Du hast recht. Unser Blick auf das Problem unterscheidet sich sehr von dem der Leute, von denen wir es geerbt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380222
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380222,
					"content": "Ich bin einverstanden, Cyno. Das Ganze hat wegen Hermanubis angefangen, also lass es uns mit einem Ritual beenden, das er selbst erschaffen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380223
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380223,
					"content": "Die Legende besagt, dass Hermanubis bei seiner Ankunft in Tulaytullah mit den Einwohnern der Stadt in den Wettstreit trat. Er und seine zwei Gefährten stellten ihre Tapferkeit unter Beweis, indem sie sich über mehrere Tage hinweg duellierten und so die Anerkennung zahlreicher ehrenhafter Menschen errangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380224
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380224,
					"content": "Jene Unterstützerschar zählte zu den ersten Mitgliedern des Tempels des Schweigens und jene Duelle wurden als einer unserer Gründungsriten verewigt ... Der Duellritus. Hier nahm alles seinen Anfang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380225
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380225,
					"content": "Das klingt sinnvoll. Ich bin dabei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380226
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380226,
					"content": "In deiner Eigenschaft als Träger Hermanubis’ bist du tief mit dem Tempel des Schweigens verwurzelt. Daher will ich dir die Teilnahme an diesem Ritus gewähren, in Begleitung deiner ausgewählten Gefährten ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380227
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380227,
					"content": "Drei gegen drei. Hört sich gut an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380228
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380228,
					"content": "Eine weitere Bedingung will ich aber hinzufügen. Als Herausforderer musst du alle drei Kämpfe gewinnen, um zu siegen. Und Cyno, wir machen unsere zwei Ba-Fragmente zum Einsatz. Der Gewinner soll sie beide erhalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380229
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380229,
					"content": "Es war ein Fehler, dass mein Großvater Cyrus aus Mitleid mit einem der Ba-Fragmente gehen ließ. Das ist ein langjähriges Dilemma, das angegangen werden muss, damit der Tempel des Schweigens vorankommen kann. Ich kann in dieser Sache keine Zugeständnisse machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380230
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380230,
					"content": "Nicht nötig, wir sind da ganz bei dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380231
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380231,
					"content": "Wenn ich gewinne, muss der Tempel des Schweigens Cyrus gehen lassen und den Disput als geklärt betrachten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380232
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380232,
					"content": "Wenn du gewinnst, werde ich dir meine Kraft zurückgeben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380233
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380233,
					"content": "Abgemacht, dann treffen wir uns morgen Abend um acht Uhr an der Zeremonienhalle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
		},
		{
