			},
			"dialogs": [
				{
					"id": 130380501,
					"content": "Hiermit endet die zweite Runde. Wir fahren nun mit der dritten Runde fort. Duellanten, bitte tretet vor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380502
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380502,
					"content": "Ich bin bereit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380503
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380503,
					"content": "Ich auch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380504
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380504,
					"content": "In dieser letzten Phase des Ritus erinnere ich euch beide daran, dass die Bedingungen, auf die ihr euch geeinigt habt, bindend sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380505
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380505,
					"content": "Wenn ihr bereit seid, könnt ihr beginnen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380506
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380506,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380507
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380507,
					"content": "Ich bin Sethos, Träger von Hermanubis, Enkel von Bamoun, dem Anführer des Tempels des Schweigens.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380508
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380508,
					"content": "Seit vielen Jahren haben wir unser Gelöbnis mit Hermanubis gewahrt, indem wir die Geheimnisse des Königs Deshret hüteten. Und auch in unserer dunkelsten Stunde, als wir keinen Ausweg mehr wussten, gaben wir nicht die Hoffnung auf, sondern nahmen ein kühnes neues Experiment in Angriff, auf dass wir bestehen mögen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380509
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380509,
					"content": "Mit Ernsthaftigkeit strebten wir nach der Weisheit und Kraft Hermanubis’, in dem Wunsch, seinen Geist und sein Licht auf uns herabkommen zu lassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380510
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380510,
					"content": "Nun werde ich darum kämpfen, der rechtmäßige Träger jener Kraft zu sein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380511
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380511,
					"content": "Ich bin Cyno, Mahamatra der Akademie, Schüler und Nachfolger von Cyrus, dem Gelehrten des Spantamad-Instituts. Ich kämpfe, um meine Kraft, meinen Professor und mein Reich zu verteidigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380512
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380512,
					"content": "Und du? Ich denke, du hast einige Dinge ungesagt gelassen. Dies ist ein heiliges Duell, und Hermanubis sieht zu. Also enthülle deine Seele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380513
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380513,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380514
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380514,
					"content": "(Jedermann, ob alt oder jung, gesund oder gebrechlich, sie sind alle gespannt darauf, zu sehen, wie dieses Duell enden wird.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380515
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380515,
					"content": "Mein Großvater ist ein weiser Anführer. Zudem ist er als Herrscher bekannt, der nicht zögert, Blut an seine Hände zu bekommen. Ich bin mit seinen Überzeugungen vertraut und kenne die Hoffnungen, die er in mich setzt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380516
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380516,
					"content": "Aber unser Glaube hat uns zu lange zurückgehalten. Als ich aufgewachsen war, ging ich einmal in den Regenwald und sah mit eigenen Augen die Menschen der Stadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380517
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380517,
					"content": "Die Zeiten haben sich gewandelt. Die Menschen Sumerus sind heute glücklicher und freier als in der Vergangenheit. So sann ich, als ich an einem der höchsten Punkte der Stadt stand, und hinabsah auf die Straßen unter mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380518
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380518,
					"content": "Dann kamst du mir in den Sinn, Cyno. Wir beide besitzen die gleiche Kraft. Aber die Leben, die wir führen, könnten unterschiedlicher kaum sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380519
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380519,
					"content": "Jedes Ba-Fragment von Hermanubis symbolisiert etwas anderes. Kraft, Ruhm oder eines der vielen anderen Geheimnisse, die noch darauf warten, enthüllt zu werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380520
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380520,
					"content": "Einst glaubte ich, dass die Natur unserer Fragmente das sei, was uns so unterschiedlich machte. Aber vielleicht rührt es vielmehr daher, dass du deine Antwort gefunden hast, während ich nach meiner noch suche.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380521
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380521,
					"content": "Ich bin mehr als nur ein Krieger. Ich bin ein Individuum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380522
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380522,
					"content": "... Genau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380523
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380523,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380524
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380524,
					"content": "Der Name Hermanubis hat uns beide geprägt und unsere Lebenswege beeinflusst. Wir sind seine Träger, aber wir sind noch so viel mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380525
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380525,
					"content": "Lass mich deine Antwort sehen, Cyno. Lass mich sehen, dass ich mehr sein kann als mein Glaube, mehr als die Kraft, über die ich verfüge. Zeig mir die Person, die ich werden kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380526
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380526,
					"content": "Komm schon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380527
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380527,
					"content": "Wie ist es? Fühlst du dich gut?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380528,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380529
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380529,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
		},
