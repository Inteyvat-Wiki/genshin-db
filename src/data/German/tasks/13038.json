					}
				]
			},
			"dialogs": [
				{
					"id": 130380101,
					"content": "Die Gruppe trifft sich zur vereinbarten Zeit wieder ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380102
					]
				},
				{
					"id": 130380102,
					"content": "Ich habe gründlich nachgedacht. So wie ich Professor Cyrus kenne, ist er mit dem Wissen in die Wüste gekommen, sehr wahrscheinlich nie wieder zurückzukehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380103
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380103,
					"content": "Er ist ein dickköpfiger Mann, der sich von niemandem etwas sagen lässt, wenn ihm eine Sache wichtig ist. Es ist aussichtslos, ihn von einer Flucht überzeugen zu wollen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380104
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380104,
					"content": "Ich stimme dir zu. Mein Meister, Naphis, sagt das Gleiche. Wenn Cyrus einmal einen Entschluss gefasst hat, ist er für vernünftige Argumente nicht mehr zugänglich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380105
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380105,
					"content": "Hm, das ist das eine. Ein paar andere Dinge fallen mir auch noch ein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380106
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380106,
					"content": "Ihr habt alles gehört, was ihr über den Tempel des Schweigens wissen müsst. Ich habe dem nichts hinzuzufügen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380107
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380107,
					"content": "Meine eigenen Erinnerungen an diesen Ort sind undeutlich. Vielleicht liegt es an der überwältigenden Präsenz des Ba-Fragments. Das könnte erklären, warum ich als Kind unter ständigen Kopfschmerzen und Fiebern litt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380108
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380108,
					"content": "Ich erinnere mich an kurze Momente intensiver Emotion, als undeutliche Bilder vor meinem inneren Auge aufblitzten. Doch ich weiß nicht mehr viel davon, lediglich einige wenige Bruchstücke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380109
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380109,
					"content": "Ich war damals noch jung und alles, was ich begriff, war, dass da dieser ungemein starke Wille in meinem Kopf existierte. Wenn ich jetzt darüber nachdenke, glaube ich, es war Hermanubis’ Art, mich zu ermutigen, selbst wenn wir nicht kommunizieren konnten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380110
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380110,
					"content": "Die Kraft, die meinen Geist zu bewohnen begann, war vielleicht eine tragende Säule ihres gesamten Glaubens. Wenn der Wille und die Kraft von Hermanubis real und fassbar existieren und sie die rechtmäßigen Gläubigen sind, dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380111
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380111,
					"content": "Du wirst ihren Forderungen nicht klein beigeben, oder? Es muss doch noch einen anderen Weg geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380112,
						130380113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380112,
					"content": "Zieh keine übereilten Schlüsse, Cyno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				},
				{
					"id": 130380114,
					"content": "Nein, ich habe nicht die Absicht, sie zurückzugeben. Ich brauche diese Kraft, um Sumeru zu beschützen. Aber der Tempel hat das Recht, die letzte Entscheidung über ihr Schicksal zu treffen, denn er gehört zu einer der sieben Säulen von König Deshret ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380115
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380115,
					"content": "Also werde ich sie direkt herausfordern und mir das Recht erkämpfen, diese Kraft selbst zu gebrauchen, ganz fair und mit offenem Visier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380116
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380116,
					"content": "Das erinnert mich an etwas, was Alhaitham zu mir sagte, kurz bevor wir aufbrachen. Er erzählte, dass der Tempel des Schweigens ursprünglich von der herrschenden Elite jener Zeit gegründet wurde. Traditionell sind solche Organisationen an einen strengen und alten Adelskodex gebunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380117
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380117,
					"content": "Kaveh machte auf seinen Dienstreisen dorthin ähnliche Beobachtungen bei den Wüstenbewohnern. Er sagt, viele von ihnen folgen ihren eigentümlichen Regeln. Sie betonen immer, wie wichtig es ist, ihre Stammesbindungen oder die von ihren Vorfahren festgelegten Regeln nie zu entehren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380118
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380118,
					"content": "Ich denke, das können wir zu unserem Vorteil nutzen. Wir gehen mit einem eigenen Vorschlag zu ihnen zurück.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380119
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380119,
					"content": "Wah ... Wir haben den Spieß einfach so umgedreht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380120,
					"content": "Wir hatten wohl die gleiche Idee.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380121
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380121,
					"content": "Solange wir noch können, machen wir ihnen ein Angebot, das sie nicht ablehnen können. Das ist unser Schlüssel zum Sieg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380122
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380122,
					"content": "Hört sich gut an, finde ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380123
					]
				},
				{
					"id": 130380123,
					"content": "Sehr gut. Und ich weiß schon, wie ich das Gespräch beginne. Lasst uns zu Sethos gehen. Wir sagen ihm, dass ich mich ein bisschen mit Medizin auskenne und gern mal seinen Großvater untersuchen würde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380113,
					"content": "Es muss noch einen anderen Weg geben!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				}
			]
		},
