					}
				]
			},
			"dialogs": [
				{
					"id": 130380601,
					"content": "Nun, so wie die Dinge stehen, gibt es jetzt kein Zurück mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380602
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380602,
					"content": "Das gab es nie. Schon seit der Professor sich davon gemacht hatte, um in die Wüste zu gehen, war Umkehr keine Option mehr für mich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380603
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380603,
					"content": "Du musst gewinnen! Du brauchst diese Kraft sowohl als Mahamatra, als auch für dich selbst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380604
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380604,
					"content": "Ja, das stimmt. Außerdem war diese Kraft schon bei dir, seit du ein kleines Kind warst. Das ist bestimmt ein Zeichen dafür, dass sie dich für den rechtmäßigen Besitzer hält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380605,
					"content": "... Sowohl als Mahamatra als auch für mich selbst ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380606
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380606,
					"content": "Na ja, wenn du es so sagst ... Ich musste echt einiges durchmachen, um diese Kraft zu bändigen und sie mir unter den Nagel zu reißen. Das hätte nicht jeder geschafft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380607
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380607,
					"content": "Genau!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380608,
						130380609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380608,
					"content": "Lass uns nicht abschweifen. Konzentrieren wir uns auf den Sieg!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				},
				{
					"id": 130380610,
					"content": "#{NICKNAME} und ich werden niemals verlieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380611
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380611,
					"content": "Und ich ebenso wenig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380612
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380612,
					"content": "Die Wüste war einst Heimat einer uralten, bedeutenden Zivilisation, die aus diversen Gründen in Konflikt mit der Zivilisation des Regenwaldes geriet. Es ist, wie Dehya sagte: Vorurteile trieben einen Keil zwischen die Menschen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380613
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380613,
					"content": "Aber da spielen sicher auch persönliche Beweggründe mit rein. Ich werde das Gefühl nicht los, dass Bamoun an viel mehr Dingen gelegen ist, als er zugeben will. Und ich finde nicht, dass Sethos so ein Bösewicht ist. Er tut einfach, was er für richtig hält.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380614
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380614,
					"content": "... Morgen wird sich alles aufklären.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380609,
					"content": "Wir helfen dir dabei, das durchzuziehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				}
			]
		},
