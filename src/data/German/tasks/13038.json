			},
			"dialogs": [
				{
					"id": 130380301,
					"content": "Wir versammeln uns an diesem Tage, um ein weiteres Mal den Duellritus mit dem größten aller Weisen Hermanubis als unserem Zeugen zu begehen, denn seine Macht und Autorität weilt in unserer Mitte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380302
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380302,
					"content": "Dies ist unsere heiligste Zeremonie und wir dulden keine Störungen aus dem Publikum. Es obliegt jedem Einzelnen, das Duell mit größtmöglicher Ehrerbietung und Andacht zu begleiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380303
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380303,
					"content": "Als Vertreter des Tempels des Schweigens: Die Verteidiger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380304
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380304,
					"content": "Großvater, du bist hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380305
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380305,
					"content": "*hust* ... Ein Duellritus, nach all den Jahren ... Deine Entscheidung überrascht mich, Sethos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380306
					],
					"speakerTitle": "Bamoun"
				},
				{
					"id": 130380306,
					"content": "Ich weiß, was ich tue, Großvater. Lass mich nur machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380307
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380307,
					"content": "Als Vertreter der Akademie: Die Herausforderer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380308
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380308,
					"content": "Bereit. Wir werden kämpfen, um unseren Stimmen Gehör zu verschaffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380309
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380309,
					"content": "Krieger, nehmt eure Stellungen ein und entscheidet über die Kampfordnung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380310
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380310,
					"content": "Wir sind nicht hier, um die Beweggründe unserer Herausforderer oder das Schicksal der unterlegenen Duellanten zu erörtern. Duellanten, es geht hier um die Macht von Hermanubis selbst. Nun, kämpft, kämpft, bis ein wahrer Sieger gekürt ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380311
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380311,
					"content": "Ich werde die Vorhut sein.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380312
					]
				},
				{
					"id": 130380312,
					"content": "Hä? Bist du sicher?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380313,
					"content": "Ich bin sicher. Wir wollen die Moral hochhalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380314
					]
				},
				{
					"id": 130380314,
					"content": "#Ich bin einverstanden, {NICKNAME} ist sehr stark. {F#Sie}{M#Ihn} zuerst hinauszuschicken wird die gegnerische Seite auf jeden Fall einschüchtern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380315
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380315,
					"content": "Gut, dann gehst du als Zweiter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380316
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380316,
					"content": "Ja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380317
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380317,
					"content": "Wir haben entschieden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380318
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380318,
					"content": "Wir ebenso. Fangen wir an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
		},
