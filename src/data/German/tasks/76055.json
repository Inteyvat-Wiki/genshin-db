						760550305
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550305,
					"content": "Ein kleiner Hund ...? Soll ich dein Rad für dich drehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550306
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760550306,
					"content": "(Hallo, Gast! Du kannst mit mir sprechen! Nun, dann dreh schnell das Rad, sonst gibt es nichts Leckeres zu essen!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550307
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550307,
					"content": "Hast du denn Hunger? Ich habe gerade ein paar Snacks gekauft. Hier, nimm dir etwas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550308
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760550308,
					"content": "(Hm? Du drehst das Rad nicht, aber du willst mir Essen geben ... Hmm, sicher. Ich nehme mir zuerst etwas. Warum nicht?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550309
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550309,
					"content": "(Vielen Dank, Gast. Ich heiße Pavlov – und danke für das Essen. Er war köstlich! Trotzdem hast du das Rad nicht gedreht.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550310
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550310,
					"content": "Diese Snacks sind ziemlich gut. Aber ... dieses Rad, das du erwähnt hast ... was genau macht es?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550311
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760550311,
					"content": "(Wenn das Rad gedreht und dann angehalten wird, fallen gute Dinge nach unten. So ist es immer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550312
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550312,
					"content": "(Willst du nicht das Rad drehen, lieber Gast? Jeder ist glücklich, nachdem er es gedreht hat.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550313
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550313,
					"content": "Wenn ich am Rad drehe ... wirst du dann glücklich sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550314
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760550314,
					"content": "(Aber natürlich! Die Leute spielen mit mir, das Rad spielt mit mir und es gibt leckeres Essen ... Das Essen ist das Beste!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550315
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550315,
					"content": "Verstehe ... Ja, gutes Essen ist wichtig. Hier, nimm den Rest auch noch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550316
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760550316,
					"content": "Ich muss mehr kaufen gehen. Leb wohl, Pavlov.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550317
					],
					"speakerTitle": "„Columbina“"
				},
				{
					"id": 760550317,
					"content": "(Mmm ... lecker, lecker! Auf Wiedersehen, Gast! Komm bald wieder!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pavlov"
				}
