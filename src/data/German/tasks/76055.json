				]
			},
			"dialogs": [
				{
					"id": 760550101,
					"content": "(<color=#FFCC33FF>Lauma</color> scheint etwas gehört zu haben ...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760550102
					]
				},
				{
					"id": 760550102,
					"content": "... Seltsam. Ich bin sicher, ich hätte gerade etwas gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550103,
					"content": "(Ah, ein Gast! Komm! Komm! Dreh das Rad, halt es an und dann gibt es gutes Essen!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550104
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550104,
					"content": "(Hm? Warum drehst du das Rad nicht? Mach schon, dreh es. Gutes Essen wartet!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550105
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550105,
					"content": "Das klingt ... wie ein kleines Hündchen? Dreh das Rad für gutes Essen ... Was soll das bedeuten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550106,
					"content": "(Hallo, Gast! Du kannst mit mir sprechen! Nun, dann dreh schnell das Rad, sonst gibt es nichts Leckeres zu essen!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550107
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550107,
					"content": "Hast du denn Hunger? Ich habe ein paar Kekse mitgebracht. Hier, nimm einen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550108,
					"content": "(Hm? Du drehst das Rad nicht, aber du willst mir Essen geben ... Hmm, sicher. Ich nehme mir zuerst etwas. Warum nicht?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550109
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550109,
					"content": "(Vielen Dank, Gast. Ich heiße Pavlov – und danke für den Keks. Er war köstlich! Trotzdem hast du das Rad nicht gedreht.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550110
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550110,
					"content": "Gern geschehen ... Aber wenn ich fragen darf, was meinst du mit „das Rad drehen“?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550111,
					"content": "(Wenn das Rad gedreht und dann angehalten wird, fallen gute Dinge nach unten. So ist es immer.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550112
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550112,
					"content": "(Willst du nicht das Rad drehen, lieber Gast? Jeder ist glücklich, nachdem er es gedreht hat.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550113
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550113,
					"content": "Ich denke, das werde ich nicht. Es scheint ... du lebst gut hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550114
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550114,
					"content": "(Aber natürlich! Die Leute spielen mit mir, das Rad spielt mit mir, und es gibt gutes Essen.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550115
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550115,
					"content": "Dann ist ja gut. Grüß deinen Besitzer von mir. Ich bin dann mal weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550116,
					"content": "(Oh ... Auf Wiedersehen, lieber Gast! Bis zum nächsten Mal!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pavlov"
				}
			]
		},
