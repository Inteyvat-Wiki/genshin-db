							177.135,
							4.824,
							75.375
						],
						"pointId": 68
					}
				]
			},
			"dialogs": [
				{
					"id": 747160101,
					"content": "Fantastisch ... Damit ist so ziemlich der ganze große Schrott geborgen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160102
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160102,
					"content": "#Danke für eure harte Arbeit, {NICKNAME} und Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160103
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160103,
					"content": "Du musst dich nicht entschuldigen, Fréminet! So wie Paimon das sieht, haben wir gar nicht wirklich „gearbeitet“ – wir haben einfach tolle Sachen aus dem Wasser gefischt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160104,
						747160105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160104,
					"content": "Wir haben geholfen, die Umwelt wieder in ihren ursprünglichen Zustand zurückzuversetzen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				},
				{
					"id": 747160106,
					"content": "Danke ... Ich hatte so eine glückliche und erfüllende Zeit, und das alles nur dank euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160107
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160107,
					"content": "Gern geschehen! Außerdem war es Teamarbeit! Uuuund Paimon findet, dass du echte Fortschritte gemacht hast, Fréminet. Du warst sowohl unter Wasser als auch an Land eine große Hilfe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160108,
					"content": "Kein Grund rot zu werden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160109
					]
				},
				{
					"id": 747160109,
					"content": "G... Gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160110
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160111
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160111,
					"content": "Tut mir leid, außer „Danke“ weiß ich in solchen Momenten wirklich nicht, was ich sonst sagen soll.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160112
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160112,
					"content": "Vielleicht ... brauche ich noch etwas mehr Übung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160113
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160113,
					"content": "Lass dir Zeit, es eilt nicht. Mach einfach in deinem eigenen Tempo weiter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160114,
						747160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160114,
					"content": "Wenn sich die Gelegenheit ergibt, lass uns in Zukunft wieder zusammenarbeiten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160116,
					"content": "Alles klar, abgemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160117
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160117,
					"content": "... Jetzt, wo die Aufräumarbeiten vorbei sind, hatte ich eigentlich vor, wieder unter Wasser zu gehen, um etwas Zeit allein zu verbringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160118
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160118,
					"content": "Aber komischerweise, nachdem ich mit euch geredet habe ... wirkt sogar der Himmel selbst ruhiger. Ich wollte dieses Gefühl einfach ... mit euch teilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160119
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160119,
					"content": "Jedenfalls ... Ich sollte am besten zurückgehen und mich mit Lyney und den anderen treffen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160120
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160120,
					"content": "Ich überlasse euch die restlichen Daten der Unterwasseruntersuchung. Ich hoffe, ihr findet, wonach ihr sucht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160121
					],
					"speakerTitle": "Fréminet"
				},
				{
					"id": 747160121,
					"content": "He, ich konnte euch bis oben an Deck feiern hören. Ist irgendwas Gutes passiert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160122
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160122,
					"content": "Ja! Der ganze Schrott, der die Fischlein gestört hat, ist so gut wie weg. Außerdem haben wir die restlichen Klavierteile gefunden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160123,
					"content": "Wirklich? Lasst mich mal sehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160124
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160124,
					"content": "... Nicht zu fassen. Mit diesen Bauteilen kann ich endlich das Klavier reparieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160125
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160125,
					"content": "Vielleicht wird es nicht mehr genau wie vorher, aber es sollte wieder wunderschöne Musik spielen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160126
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160126,
					"content": "Du klingst richtig glücklich, Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160127,
					"content": "T... Tue ich das? Egal, ich repariere es direkt, es sollte nicht lange dauern. Könntet ihr in der Zwischenzeit diesen Ort ein wenig aufhübschen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160128
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160128,
					"content": "So ein wundervolles Instrument verdient eine passende Bühne, auf der es richtig in Szene gesetzt werden kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160129
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160129,
					"content": "Sie sieht wirklich glücklich aus ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160130,
					"content": "Waah! Was für ein wunderschönes Klavier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160131,
						747160132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160131,
					"content": "Es ist sehr elegant!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160133,
					"content": "Hmpf, natürlich ist es das. Schließlich habe ich es repariert! Außerdem habe ich die mechanischen Verbindungen verstärkt und das Äußere überarbeitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160134
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160134,
					"content": "Ihr zwei habt euch aber auch nicht schlecht geschlagen. Diese Bühne ist dieses Klaviers wirklich würdig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160135
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160135,
					"content": "Hehe, das war doch nichts! Aber genug geplaudert. Willst du uns denn kein Lied vorspielen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160136,
					"content": "... Hm? Jetzt hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160137
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160137,
					"content": "Wann denn sonst? Warum das Klavier reparieren, wenn du nicht darauf spielen willst?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160138,
					"content": "Wie wäre es ... wenn wir den Auftritt erstmal verschieben! Ich habe später noch jede Menge Zeit, um für euch zu spielen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160139,
						747160140
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160139,
					"content": "Hast du deine Noten vergessen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160141,
					"content": "Hmpf ... Absoluter Quatsch! Ich ... Ich will einfach nur eine Weile ruhig damit dasitzen und an die Vergangenheit denken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160142
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160142,
					"content": "Und denkt ja nicht, dass ein paar billige Sticheleien mich zum Spielen bringen. Hmpf, erst wird geübt, und dann kommt der Auftritt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				},
				{
					"id": 747160140,
					"content": "Bist du schüchtern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160132,
					"content": "Es ist wunderschön!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160115,
					"content": "Wenn du Hilfe brauchst, kannst du immer auf uns zählen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160105,
					"content": "Und wir haben jede Menge Schätze gefunden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				}
			]
		}
	]
}