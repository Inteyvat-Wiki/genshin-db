			"dialogs": [
				{
					"id": 751340201,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340202
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340202,
					"content": "Igitt, die Oberfläche ist durch den Abgrund korrodiert und sieht aus, als könnte es jederzeit abfallen. Ist es das, worauf Coco gezeigt hat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340203,
					"content": "Obwohl Paimon keine Ahnung hat, was das ist, ist es bestimmt kein Altar ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340204,
					"content": "„Nur hier zu stehen und zu raten ...“",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340205
					]
				},
				{
					"id": 751340205,
					"content": "Na gut, na gut, Paimon versteht das! ... Hach, Coco hat sich wahrscheinlich wegen dieser abgrundtiefen Korrosion nicht getraut, hereinzukommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340206,
					"content": "Wir müssen etwas gegen den Abgrund unternehmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340207
					]
				},
				{
					"id": 751340207,
					"content": "Ja, und der Abgrund muss der Grund sein, warum Coco nicht reinkommen wollte. Wir müssen ihn loswerden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340208,
					"content": "#Los geht’s, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340209
					]
				},
				{
					"id": 751340209,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340210,
					"content": "Halt, was ist mit Paimon? Ihr zwei seid so gemein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340211,
					"content": "Lasst uns diesen ganzen Dreck loswerden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
