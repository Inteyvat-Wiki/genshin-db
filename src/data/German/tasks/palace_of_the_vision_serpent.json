					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751340405
					]
				},
				{
					"id": 751340405,
					"content": "Was?! Ihr habt ein weiteres Stück Pyrophosphorit gefunden? Boah, und ich dachte, dass der, den ich habe, der einzige auf dieser Welt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340406
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340406,
					"content": "Moment, könnte meiner eine Fälschung sein? Hmm ... das könnte der Grund sein, warum ich all die Jahre nichts Besonderes an ihm bemerkt habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340407
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340407,
					"content": "Das kann nicht sein ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340408
					]
				},
				{
					"id": 751340408,
					"content": "Der, den wir da unten gefunden haben, sieht auch ganz gewöhnlich aus, abgesehen von den Mustern darauf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340409,
					"content": "Wir haben auch ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340410
					]
				},
				{
					"id": 751340410,
					"content": "Ach ja, wir haben auch einige seltsame Notizen gefunden, die ein Abenteurer, der früher hier war, hinterlassen hat. Willst du sie sehen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340411,
					"content": "Notizen eines Abenteurers? Abenteurer, die in diese verfluchte Stadt gekommen sind, sind wahrscheinlich auch wegen der Jade der Rückkehr hier, also ... Ich lese sie lieber nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340412
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340412,
					"content": "Aber warum? Da ist etwas mit dem Pyrophosphorit und dem Altar. Vielleicht könnte das ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340413,
					"content": "Ja, ich weiß. Und deshalb möchte ich mir die Notizen nicht ansehen, bevor ich die Jade der Rückkehr gefunden habe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340414
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340414,
					"content": "Wieso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340415,
					"content": "Im Laufe der Jahre haben sich viele Abenteurer auf den Weg gemacht, um die Tonatiuh und die Jade der Rückkehr zu finden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340416
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340416,
					"content": "Aber sie sind alle gescheitert, und niemand hat die Existenz des Himmelsschiffs beweisen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340417
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340417,
					"content": "Die meisten denken, es sei nur ein illusorischer Traum. Eine Fantasie, in der Menschen, die unter dem Abgrund leiden, Trost finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340418
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340418,
					"content": "Daher wurden ihre Abenteuer nie von Geschichtenerzählern aufgezeichnet, und ihre Taten wurden nie besungen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340419
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340419,
					"content": "Wenn wir die Tonatiuh nicht finden und die Jade der Rückkehr nicht zurückholen können, dann wäre alles, was sie getan haben, umsonst gewesen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340420
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340420,
					"content": "Die Reise selbst hat auch ihren Sinn.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340421
					]
				},
				{
					"id": 751340421,
					"content": "Glaubst du das wirklich? Abenteurer, die Wert auf die Reise selbst legen, sind in Natlan selten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340422
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340422,
					"content": "Zwar gibt es auch Abenteurer, die nichts erreicht haben, doch die meisten Abenteurer brauchen etwas, um sich zu beweisen, nicht wahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340423
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340423,
					"content": "Die Erfahrung ist auch sehr wichtig.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340424
					]
				},
				{
					"id": 751340424,
					"content": "Nur wenn das Schiff wirklich existiert. Was, wenn es gar keine Tonatiuh gibt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340425
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340425,
					"content": "Deshalb müssen wir es finden. Für meinen alten Herrn und für die Abenteurer, die bei der Suche ihr Leben verloren haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340426
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340426,
					"content": "Was die Notizen angeht, die ihr gefunden habt ... Egal, wer ihr Besitzer war, sie werden erst an Wert gewinnen, wenn wir an Bord der Tonatiuh sind.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340427
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340427,
					"content": "#Also, {NICKNAME} und kleine Paimon, wenn wir die Tonatiuh finden und sicher zurückkehren können, müsst ihr allen in dieser Abenteurergilde erzählen, was wir geschafft haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340428
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340428,
					"content": "Überlass das Paimon, sie ist gut darin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340429
					]
				},
				{
					"id": 751340429,
					"content": "Was? Willst du damit sagen, dass Paimon gut im Prahlen ist? Hmpf, wenn wir das legendäre Schiff wirklich finden, dann müssen wir es nur noch Katheryne erzählen, damit ganz Teyvat davon erfährt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340430,
					"content": "Überlasse das mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340431
					]
				},
				{
					"id": 751340431,
					"content": "#Jupp, schließlich sind wir ja legendäre {F#Abenteurerinnen}{M#Abenteurer}. Wir müssen nur einem Reporter unsere Geschichte erzählen und schon sind wir in den Schlagzeilen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340432,
					"content": "#Überlass das {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340433
					]
				},
				{
					"id": 751340433,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340434
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340434,
					"content": "Nun, obwohl er die Aufgabe mit Freude angenommen hat, denkt Paimon, dass er unsere Geschichte nur anderen Saurierabenteurern erzählen kann ... Moment, gibt es denn Abenteurer unter den Sauriern?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340435,
					"content": "Haha, großartig, aber ... ihr habt mir immer noch nicht den Pyrophosphorit gezeigt, den ihr gefunden habt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340436
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340436,
					"content": "#Oh, richtig. {NICKNAME}, zeige ihnen den Pyrophosphorit! Vielleicht wird sich Coco an etwas erinnern, wenn er ihn sieht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340437,
					"content": "*gurr* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340438
					],
					"speakerTitle": "„Cocouik“"
				},
				{
					"id": 751340438,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340439
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340439,
					"content": "W... Was ist denn da los?! Paimon wird blind!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340440,
					"content": "*zwitsch*! *zwitsch*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340441
					],
					"speakerTitle": "„Cocouik“"
				},
				{
					"id": 751340441,
					"content": "Oha! Coco sieht plötzlich so energiegeladen aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340442,
					"content": "Sieht aus, als sei er bereit, den „supergeilen Laser“ abzufeuern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340443
					]
				},
				{
					"id": 751340443,
					"content": "#Hä? {NICKNAME}, du erinnerst dich tatsächlich an diesen komischen Namen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340444
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340444,
					"content": "Und der Pyrophosphorit, könnte er die gleiche Funktion haben wie die Fragmente, die wir früher gefunden haben? Nämlich diese Energie zu speichern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340445,
					"content": "Es sieht so aus, als ob auch Pyrophosphorite diese Energie enthalten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340446
					]
				},
				{
					"id": 751340446,
					"content": "Ja, könnte er die gleiche Funktion haben wie die Fragmente, die wir früher gefunden haben? Nämlich diese Energie zu speichern ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340447,
					"content": "Und Coco, du brauchst diese Energie, um gegen den Abgrund kämpfen zu können, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340448,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340449
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340449,
					"content": "#{NICKNAME}, schau dir das mal an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340450
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340450,
					"content": "Hm, was ist los? Boah! Das Wandgemälde sieht jetzt anders aus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340451,
					"content": "Dieses Wandgemälde wurde also von dem Wandgemälde überdeckt, das wir zuvor gesehen haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340452
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340452,
					"content": "Das haben wir schon bei einem anderen Wandgemälde gesehen ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340453
					]
				},
				{
					"id": 751340453,
					"content": "Ja, ist das nicht der große schwarze Drache auf dem Wandgemälde in den Ruinen, wo wir die erste Goldscheibe des Ultimatums bekommen haben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340454
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340454,
					"content": "Aber auf diesem Bild sieht es so aus, als ob der schwarze Drache der Herrscher dieses Ortes ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340455
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340455,
					"content": "Der Drache verschanzt sich über der Stadt ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340456
					]
				},
				{
					"id": 751340456,
					"content": "Hm, auf diesem Bild sieht es so aus, als ob der böse Drache der Herrscher dieses Ortes ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340457
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340457,
					"content": "*zwitsch*! *zwitsch*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340458
					],
					"speakerTitle": "„Cocouik“"
				},
				{
					"id": 751340458,
					"content": "Coco? Was ist los? Weißt du etwas über dieses Wandgemälde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340459
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340459,
					"content": "Iieeh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340460
					],
					"speakerTitle": "„Cocouik“"
				},
				{
					"id": 751340460,
					"content": "Hm? Diesmal zeigt das Licht in den Himmel ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340461
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340461,
					"content": "*gurr*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340462
					],
					"speakerTitle": "„Cocouik“"
				},
				{
					"id": 751340462,
					"content": "Ja, ja, das kann nicht falsch sein. Der Altar des Urfeuers muss in dieser Richtung liegen, auf dem höchsten Punkt der alten Stadt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340463
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340463,
					"content": "Echt? Du sprichst immer mit so viel Gewissheit und die Dinge stellen sich dann jedes Mal anders dar, dass Paimon sich langsam Sorgen macht ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340464
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340464,
					"content": "Ach, komm schon, vertrau mir einfach noch einmal, ja? Ich habe das Gefühl, dass es dieses Mal nicht falsch sein kann!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340465
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751340465,
					"content": "Verlassen wir uns also jetzt auf dein Gefühl ...? Na ja, wir haben sonst sowieso nichts, worauf wir uns verlassen können, also ... gehen wir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
