			"dialogs": [
				{
					"id": 751340301,
					"content": "Uff ... Endlich vorbei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340302,
					"content": "Und die Automata, die ihn schützen, werden endlich abgeschaltet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340303,
					"content": "Mal sehen, was da drin ist!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340304,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340305
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340305,
					"content": "Bitte enttäusche Paimon nicht ... Was ist das? Noch ein Pyrophosphorit-Brocken? Es gibt also mehr als einen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340306,
					"content": "Moment, die Geweberollen, mit denen er eingewickelt wurde, kommen Paimon auch bekannt vor. Sie sind genau wie die Notizen, die wir in dem Turm außerhalb der Ruinen gefunden haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340307,
					"content": "*brüll* ... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340308,
					"content": "#Das ist ja seltsam! {REALNAME[ID(2)|SHOWHOST(true)]}, du findest das auch, oder? {NICKNAME}, sieh nach, was auf den Geweberollen steht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340309,
					"content": "Oh, das sind wirklich auch Notizen, die dieser Abenteurer hinterlassen hat! „Herz von Chu’ulel“ ... das muss doch hier sein, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340310,
						751340312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340310,
					"content": "Es kann auch andere Möglichkeiten geben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340311
					]
				},
				{
					"id": 751340311,
					"content": "Das stimmt, und wir haben hier auch einen neuen Pyrophosphorit gefunden. Vielleicht gibt es anderswo noch mehr davon zu finden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340312,
					"content": "Wir wissen immer noch zu wenig über diesen Ort.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340313
					]
				},
				{
					"id": 751340313,
					"content": "Das stimmt, und hat Coco uns hierhergeführt, weil er wusste, dass es hier einen Pyrophosphorit gibt und wollte, dass wir ihn holen? Paimon versteht das nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340314,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340315
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340315,
					"content": "Lasst uns zuerst zurückkehren ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340316
					]
				},
				{
					"id": 751340316,
					"content": "Hm, ja, Coco muss etwas wissen. Und wir haben Bona versprochen, dass wir zu ihr zurückkehren, egal, was wir hier unten gefunden haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340317,
					"content": "Lassen wir Bona einen Blick darauf werfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340318
					]
				},
				{
					"id": 751340318,
					"content": "Hm, ja, vielleicht kann sie etwas bemerken, was wir nicht können. Und wir haben ihr schon versprochen, dass wir zu ihr zurückkehren, egal, was wir hier unten gefunden haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340319,
					"content": "Lasst uns so schnell wie möglich rausgehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
