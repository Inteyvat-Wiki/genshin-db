			"dialogs": [
				{
					"id": 750190301,
					"content": "... Gibt es noch Verhandlungsspielraum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190302
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190302,
					"content": "Manqu, sieh mich an. Hast du nicht gehört, was Titu gesagt hat? Seit fast fünfhundert Jahren hat niemand mehr dieses Unterfangen gewagt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190303
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190303,
					"content": "Selbst wenn du behauptest, du hättest einen möglichen Eingang gefunden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190304
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190304,
					"content": "Na und, was ist? Hör gut zu: Kein einziger Mensch oder Saurier, der sich auf diesen Weg gemacht hat, ist jemals zurückgekehrt. Nicht ein Einziger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190305
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190305,
					"content": "Ähm, verzeih mir meine Direktheit, aber ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190306
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190306,
					"content": "Nun, da ist der Typ vom Verein für Saurierrelikte. Und der da drüben ... Ist das das Stammesoberhaupt der Kinder der Echos?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190307,
					"content": "He! Relikten-Typ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190308,
					"content": "#Ah, ihr seid es, {NICKNAME} ... Paimon und {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190309
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190309,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190310
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190310,
					"content": "Hmm, ein Tepetlisaurier mit einem roten Seidenschal! So ein lebhaftes kleines Kerlchen, das sieht echt außergewöhnlich aus! Also gut, noch einmal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190311
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190311,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190312
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190312,
					"content": "#Nicht schlecht! Du bist also {REALNAME[ID(2)|SHOWHOST(true)]}? Und ich nehme an, dann seid ihr beide die, die er ausgewählt hat ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190313
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190313,
					"content": "#Und seid ihr zwei in letzter Zeit nicht das Stadtgespräch, {NICKNAME}, Paimon? Manqu hier hat ständig von euch gemurmelt, und Titu hat euch nach seiner Rückkehr auch erwähnt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190314
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190314,
					"content": "Es wäre nicht übertrieben, eure jüngsten Taten als „legendär“ zu bezeichnen, und ihr seid uns Kindern der Echos bis jetzt gute Freunde gewesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190315,
						750190316
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190315,
					"content": "Kein Grund, mich mit Dank zu überhäufen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				},
				{
					"id": 750190317,
					"content": "Haha, jemanden wie dich trifft man echt nicht alle Tage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190318
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190318,
					"content": "Und in dieser Eigenschaft, Manqu, sage ich dir, dass es nicht unsere Art ist, Gäste in eine feurige Grube zu stoßen, nur um eine Hypothese zu beweisen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190319
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190319,
					"content": "Zumindest ist das nicht „meine“ Art, Gäste zu behandeln. So etwas würde ich nie tun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190320
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190320,
					"content": "*seufz* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190321
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190321,
					"content": "Worum geht es hier eigentlich? Irgendwas mit Gefahr und einer feurigen Grube?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190322,
					"content": "Entschuldigung. Lasst mich das kurz erklären ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190323
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190323,
					"content": "Erinnert ihr euch an das, worüber wir vorhin sprachen? Um die Markierung des Segens des Flammenfürsten zu entfernen, müsst ihr die beiden erforderlichen Abzeichen in den Vulkan bringen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190324
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190324,
					"content": "Eines der Abzeichen befindet sich in den Ruinen außerhalb des Gebiets der Kinder der Echos ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190325
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190325,
					"content": "Allerdings gibt es Bedingungen, um dort hineinzukommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190326
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190326,
					"content": "Laut den alten Bräuchen ... übrigens, diesen Brauch habe ich gerade erst auf einer alten Geweberolle entdeckt, weil schon lange niemand mehr so etwas versucht hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190327
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190327,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190328
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190328,
					"content": "Wenn ihr euren Sauriergefährten zum Vulkan bringen wollt, um eine Taufe zu vollziehen, die den Segen des Flammenfürsten reinigt, müsst ihr von dem entsprechenden Stammesoberhaupt des Sauriers anerkannt werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190329
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190329,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190330
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190330,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190331
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190331,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190332,
					"content": "#Da {REALNAME[ID(2)|SHOWHOST(true)]} ein Tepetlisaurier ist, bedeutet dies, dass er das Oberhaupt der Kinder der Echos ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190333
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190333,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190334,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190335,
					"content": "Aber bist das nicht du?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190336,
					"content": "#Schon, aber ehrlich gesagt, weiß ich nicht, ob diese Regel für Außenstehende gilt. Trotzdem, {NICKNAME} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190337
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190337,
					"content": "Seit Hunderten von Jahren gab es viele Krieger, die versucht haben, ihre Sauriergefährten von diesem Fluch, der eher wie ein Fluch als ein Segen in ihrer Blutlinie liegt, zu befreien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190338
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190338,
					"content": "Aber nicht ein einziger hat es geschafft ... Deshalb gaben die Stämme den Brauch nach und nach auf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190339
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190339,
					"content": "Eine Erfolgsquote von null Prozent, ernsthaft!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190340,
					"content": "Ja, so gefahrvoll ist die Reise. Es heißt auch, dass die Prüfung, bevor man das Abzeichen erhalten kann, nicht nur den Krieger, der hervortritt, auf die Probe stellt, sondern auch den Saurier, der ihn begleitet ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190341
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190341,
					"content": "Ihr gehört zwar nicht zu den Stämmen, aber ich will nicht, dass ihr umsonst sterbt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190342
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190342,
					"content": "#Also bitte, {NICKNAME}, ich schlage vor, dass du {REALNAME[ID(2)|SHOWHOST(true)]} hier bei uns lässt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190343
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190343,
					"content": "Zumindest kann ich dafür sorgen, dass er bis zu dem Tag, an dem er ins Königreich der Nacht muss, gut versorgt ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190344
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190344,
					"content": "Aber ... Wenn wir das tun ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190345,
					"content": "#... Wie gesagt, {REALNAME[ID(2)|SHOWHOST(true)]} wird nicht erwachsen werden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190346
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190346,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190347
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190347,
					"content": "Sieht so aus, als wäre das nicht das, was er will.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190348
					]
				},
				{
					"id": 750190348,
					"content": "Ich werde es trotzdem versuchen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190349
					]
				},
				{
					"id": 750190349,
					"content": "Trotz der immensen Gefahr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190350
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190350,
					"content": "Ja.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190351
					]
				},
				{
					"id": 750190351,
					"content": "Und was ist mit dir, kleines Kerlchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190352
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190352,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190353
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190353,
					"content": "Hahaha! Unnachgiebig, entschlossen und doch leidenschaftlich. Eure Herzen lodern wie feines Phlogiston.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190354
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190354,
					"content": "Also gut. Dann gewähre ich euch das Recht, die vulkanische Pilgerreise anzutreten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190355
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190355,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190356
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190356,
					"content": "Also gut! Dann holen wir uns mal das erste Abzeichen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190357,
					"content": "Nein, noch nicht. Jetzt, da ihr die Berechtigung habt, müsst ihr eine Zeugenprüfung ablegen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190358
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190358,
					"content": "Alte Bräuche schreiben vor, dass der Krieger und der Saurier gemeinsam die Feder eines grünen Quetzals tief im Wald besorgen und eine Stola aus Tierfellen opfern müssen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190359
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190359,
					"content": "Und gemeinsam müsst ihr fünfzig Kämpfe für unseren Stamm gewinnen und sechsundneunzig Edelsteine von hoher Qualität darbringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190360,
						750190361
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190360,
					"content": "Prüfung gescheitert ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190362,
					"content": "Ach komm schon, Manqu, vergiss es. Woher kommen diese Traditionen? Aus einer verlorenen Steinzeit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190363
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190363,
					"content": "Der Zweck dieser Formalitäten war es, die Bindung zwischen Mensch und Saurier zu fördern und ihre Fähigkeiten zu verbessern, und davon habe ich jetzt genug.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190364
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190364,
					"content": "#Und so wie ich das sehe, scheinen weder {NICKNAME} noch {REALNAME[ID(2)|SHOWHOST(true)]} diese Art von Beweis zu benötigen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190365
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190365,
					"content": "#Um es einfach auszudrücken, {NICKNAME}, wir haben hier in Natlan eine super einfache Möglichkeit, mit solchen Situationen umzugehen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190366
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190366,
					"content": "Kämpfe gegen mich und beweise deine Stärke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190367
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190367,
					"content": "Ganz nach meinem Geschmack!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190368
					]
				},
				{
					"id": 750190368,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190369
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190369,
					"content": "Warte? Hier? Oh, du meinst, wir gehen auf die Bühne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190370
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190370,
					"content": "Natürlich nicht, haha, die Bühne ist kein Ort zum Graben ... Unser Duellplatz ist in dem hinteren Berg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190371
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190371,
					"content": "Kommt, lasst uns hingehen, wir werden einen guten Kampf liefern!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190361,
					"content": "Gib mir einfach eine Zahl, wie viel Mora ich zahlen muss.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190362
					]
				},
				{
					"id": 750190316,
					"content": "",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190317
					]
				}
			]
		},
		{
			"id": 7501906,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
