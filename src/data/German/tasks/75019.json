					}
				]
			},
			"dialogs": [
				{
					"id": 750190701,
					"content": "Hehe, toll! Wir haben gewonnen! Gut gemacht!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190702,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190703
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190703,
					"content": "Haha ... Ich schätze, selbst der beste Krieger unseres Stammes könnte dich nicht besiegen ... Das war in der Tat eine herbe Niederlage.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190704
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190704,
					"content": "Was denkst du, Kumpel? Sieht aus, als bräuchten wir mehr Training!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190705
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190705,
					"content": "*keuch* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190706
					],
					"speakerTitle": "Uchu"
				},
				{
					"id": 750190706,
					"content": "Das war wirklich ein fantastischer Kampf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190707
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190707,
					"content": "Hübsche Worte, Manqu, aber ist das alles, was du drauf hast? Willst du dich auch mal versuchen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190708
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190708,
					"content": "Nein, ich danke dir vielmals.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190709
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190709,
					"content": "#Langweilig. Ah, das war ein tolles Duell! {NICKNAME} ... Du bist echt stark.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190710,
						750190712
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190710,
					"content": "Ich habe mich nur aufgewärmt, weißt du ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190711
					]
				},
				{
					"id": 750190711,
					"content": "Hahaha! Auch noch eingebildet! Trotzdem, ich bewundere das. Die Starken sollten ihre Dominanz auch ein bisschen durchsetzen! Ich meine, wozu hat man schließlich die Stärke?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190714,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190715
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190715,
					"content": "#Haha, sieht aus, als wärst du wirklich gut versorgt, {REALNAME[ID(2)|SHOWHOST(true)]} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190716
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190716,
					"content": "#Na klar! {REALNAME[ID(2)|SHOWHOST(true)]} ist unser treuer Kumpel, weißt du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190717,
					"content": "Und das ist gut so.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190718
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190718,
					"content": "Wie versprochen, ist dies der Beweis für eure Leistung von einem Stammesoberhaupt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190719
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190719,
					"content": "Was den offiziellen Namen angeht, nun, Manqu, das ist dein Stichwort ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190720
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190720,
					"content": "Das Amulett von Waxaklahun Ubah Kan ... dem Weisen der Gestohlenen Flamme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190721
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190721,
					"content": "Ja, ich kann mir den Namen nie merken, aber ich erinnere mich, dass nach dem Tod des Pyro-Drachen und nachdem der erste Pyro-Archon aus den Flammen wiederbelebt wurde ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190722
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190722,
					"content": "... der Weise der Gestohlenen Flamme und der Pyro-Archon je ein Abzeichen aus dem Vulkan mitbrachten, und wer beide erhält, kann das reinigende Feuer im Vulkan betreten und alle Flüche und Katastrophen ausräumen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190723
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190723,
					"content": "Doch wie lange lebte dieser Weise überhaupt, Manqu? Ich habe das Gefühl, dass es Geschichten über ihn gibt, die von der Stammeszeit bis zu der von Ochkanatlan reichen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190724
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190724,
					"content": "... Und sogar die Schattennadeln berichten von ihm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190725
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190725,
					"content": "Na ja, er war der erste Mensch, der Phlogiston benutzte ... und wer weiß, welches Schicksal solche legendären Figuren ereilte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190726
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190726,
					"content": "Manche sagen, dass sich sowohl sein Körper als auch sein Geist in Phlogiston verwandelt haben und mit den Winden, dem Boden und den Blumen Natlans eins geworden sind, was ihm die Macht verleiht, alle an ihn gerichteten Hilfsgebete aller Stämme zu erhören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190727
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190727,
					"content": "Manche sagen, dass jede Ära ihren eigenen Nachfolger dieses weisen Titels hervorbrachte und dieser Titel über die Generationen weitergegeben wird. Man munkelt sogar, dass es auch heute noch Nachfolger gibt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190728
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190728,
					"content": "Aber, und entschuldigt meine Unverblümtheit, dies sind meist Spekulationen von Geschichtenerzählern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190729
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190729,
					"content": "Haha, pass auf mit diesen Worten. Du wirst Titu wieder wütend machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190730
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190730,
					"content": "Nun gut. Meine Pflichten sind hiermit erfüllt, oh, Moment, die Tradition verlangt noch etwas ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190731
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190731,
					"content": "#Dass ich {F#der tapferen Reisenden}{M#dem tapferen Reisenden} und {F#ihren}{M#seinen} Begleitern meinen Segen gebe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190732
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190732,
					"content": "*brüll*?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190733
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190733,
					"content": "Oh, es gibt also so ein Ritual?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190734,
					"content": "Das ist nur moralische Unterstützung. Mach dir keine zu großen Hoffnungen, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190735
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190735,
					"content": "#Also gut. {NICKNAME}, {REALNAME[ID(2)|SHOWHOST(true)]} ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190736
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190736,
					"content": "Hier bin ich, Boss.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190737
					]
				},
				{
					"id": 750190737,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190738
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190738,
					"content": "Möget ihr durch die Berge fliegen, wie die Vögel mit den härtesten Flügeln;\\nMöget ihr dem Tosen der wogenden Wellen widerstehen können, wie die stärksten Felsen in der Brandung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190739
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190739,
					"content": "Möget ihr keine Schwierigkeiten fürchten, denn die Welt ist voll davon.\\nMöget ihr einander nie vergessen, denn das Schicksal bringt einen unvermeidlichen Abschied.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190740
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190740,
					"content": "Möget ihr euer Ziel erreichen und das bekommen, was ihr euch wünscht ... Und vor allem hoffe ich, dass ihr sicher zurückkehren werdet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190741
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190741,
					"content": "Das werde ich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190742
					]
				},
				{
					"id": 750190742,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190743
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190743,
					"content": "Was? Moment, bekommt Paimon auch Segen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190744,
					"content": "Haha! Was dich betrifft, kleine Paimon ... Mögest du gut essen und trinken, üppig schlafen und prächtig wachsen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190745,
						750190746
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190745,
					"content": "Das klingt für mich ziemlich gut!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190748
					]
				},
				{
					"id": 750190748,
					"content": "Wie auch immer, Paimon nimmt diesen Segen an, aber nur deinetwegen, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190749
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190749,
					"content": "Super. Damit ist der Ritus der Zeugenschaft beendet. Aber bevor ihr geht, möchte ich noch einmal betonen: Seid vorsichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190750
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190750,
					"content": "Das wissen wir, Pacal. Wir sehen uns! ... Und bis bald, Uchu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190751
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190751,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190752
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190752,
					"content": "*brüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190753
					],
					"speakerTitle": "Uchu"
				},
				{
					"id": 750190753,
					"content": "Viel Glück! Wir sehen uns bald wieder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190746,
					"content": "Kannst du überhaupt noch wachsen, ob prächtig oder nicht, Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190747
					]
				},
				{
					"id": 750190747,
					"content": "Ja, natürlich! Warte nur ab, Paimon wird so groß wie drei Berge sein, bevor du es merkst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190748
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190712,
					"content": "Du warst auch nicht schlecht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190713
					]
				},
				{
					"id": 750190713,
					"content": "Hahaha, spar dir das Mitleid. Nun, wenn ich jünger wäre, wer weiß, wie das gelaufen wäre? Ach, ich wünschte, ich hätte es damals mit dir aufnehmen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "Pacal"
				}
			]
		},
