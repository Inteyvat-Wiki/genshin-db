			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manqu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750190601,
					"content": "Nochmals, verzeih mir meine Direktheit ... Aber obwohl ich mir deiner Stärke bewusst bin, sei trotzdem vorsichtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190602
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190602,
					"content": "Er hat keinen „alten Namen“ erhalten, aber Pacal ist nicht zu unterschätzen ... zumindest, wenn er in den letzten Jahren sein Training nicht vernachlässigt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190603
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190603,
					"content": "Wenn du bereit bist, können wir anfangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				}
			]
		},
		{
			"id": 7501907,
			"completionStepIds": [
				7501907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
