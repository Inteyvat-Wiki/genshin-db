			"dialogs": [
				{
					"id": 742540501,
					"content": "Seymour! Lange nicht gesehen! Und Mamère auch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540502
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540502,
					"content": "Haha, Seymour hat gar nicht mehr aufgehört, mir zu erzählen, wie sehr er dich vermisst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540503
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 742540503,
					"content": "Positiv. Ich habe nie aufgehört, an Fräulein Mary-Ann zu denken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540504
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540504,
					"content": "Und danke, Fräulein Sandrone, dass du diese Teegesellschaft ausgerichtet hast. Es ist so schön, zusammenzukommen und über unsere Reisen zu plaudern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540505
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540505,
					"content": "Gern geschehen. Ich habe das Gefühl, dass wir auf gewisse Weise alle eine Familie sind, mit einer langen, gemeinsamen Geschichte. Ähm, so sehe ich das zumindest. Also spricht nichts dagegen, sich zu treffen, wenn alle Zeit haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540506
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540506,
					"content": "Familie? Ich weiß nicht warum, aber es erfüllt mich mit Freude, das von dir zu hören.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540507
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540507,
					"content": "Heißt das also, Fräulein Sandrone ist unsere ... kleine Schwester?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540508
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540508,
					"content": "Ähm ... Vielleicht können wir die ganze Sache mit „groß“ und „klein“ erst mal überspringen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540509
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540509,
					"content": "Positiv. Da ich der von Herrn Alain erschaffene Prototyp bin, sollte Fräulein Sandrone mich korrekterweise „Großer Bruder“ nennen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540510
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540510,
					"content": "Hmpf ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540511
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540511,
					"content": "Das ist so schön. Kann ich auch ein Mitglied dieser Familie sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540512
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 742540512,
					"content": "Na klar! Wir sind ohnehin keine ganz normale „Familie“. Was schadet es da schon, wenn noch eine Melusine dazukommt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540513
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540513,
					"content": "Positiv. Außerdem ist Fräulein Mamère bereits meine Familie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540514
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540514,
					"content": "Hehe. Das macht mich so glücklich! Wie wäre es, wenn ich uns allen ein Familienporträt male?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540515
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 742540515,
					"content": "Ein Familienporträt? Es ist schon lange her, dass ich für so etwas posiert habe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540516
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540516,
					"content": "Sorg dafür, dass ich beeindruckend aussehe! Wie die große Schwester der Familie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540517
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540517,
					"content": "Geht klar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540518
					],
					"speakerTitle": "Mamère"
				},
				{
					"id": 742540518,
					"content": "Hah ... Warum nicht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marionette"
				}
			]
		},
