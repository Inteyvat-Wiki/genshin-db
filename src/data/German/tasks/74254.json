			"dialogs": [
				{
					"id": 742540601,
					"content": "So ein friedlicher, angenehmer Tag.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540602,
						742540603
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540602,
					"content": "(Lass uns noch ein Weilchen so sitzen bleiben.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "Marionette"
				},
				{
					"id": 742540604,
					"content": "Mmhmm, danke für die Einladung. Sandrone ... Oder sollte ich dich „kleine Schwester“ nennen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540603,
					"content": "Ich glaube, es wird Zeit, dass ich mit dem Aufräumen anfange.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "Marionette"
				}
			]
		}
	]
