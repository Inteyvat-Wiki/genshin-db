				"points": []
			},
			"dialogs": [
				{
					"id": 732181701,
					"content": "„Ich habe euch eure Sünden im Namen des Königs der Zauberflaschen vergeben, aber wer wird unsere Sünden vergeben?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
