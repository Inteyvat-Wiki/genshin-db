					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180101,
					"content": "Als Eingang zu Sumeru ist das Karawanen-Ribat ein kritischer Durchgangsort. Die Ankündigungstafel wird eingerichtet, um Händler und Touristen über wichtige Angelegenheiten zu informieren. Bitte beachte die Aushänge an der Tafel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321802,
			"completionStepIds": [
				7321802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321802",
							"2"
						],
						"stepId": 7321802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180201,
					"content": "„Mein Schatz, du bist zwar weit von mir entfernt, aber mein Herz gehört wie immer dir.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180202
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732180202,
					"content": "„Ich weiß, dass du dich um wichtigere Angelegenheiten kümmern musst. Je höher deine Position, desto mehr Verantwortung lastet auf deinen Schultern.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180203
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732180203,
					"content": "„Aber ich kann mit niemandem meine Sorgen teilen. Ich kann deinen Namen nicht laut aussprechen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180204
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732180204,
					"content": "„Ich hoffe, dass ich eines Tages alle wissen lassen darf, wie gelehrt und weise du bist.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321803,
			"completionStepIds": [
				7321803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321803",
							"2"
						],
						"stepId": 7321803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180301,
					"content": "Hier geht es zum Roten Sandmeer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180302
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732180302,
					"content": "Denjenigen, die den Toten nicht huldigen, ist der Zutritt verboten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321804,
			"completionStepIds": [
				7321804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321804",
							"2"
						],
						"stepId": 7321804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180401,
					"content": "Die Akademie untersagt jegliche Form der Zerstörung des Samiel-Walls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180402
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732180402,
					"content": "Jeglicher Verstoß wird strengstens bestraft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321805,
			"completionStepIds": [
				7321805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321805",
							"2"
						],
						"stepId": 7321805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180501,
					"content": "„Trockenfrüchte, Zutaten für Süßspeisen und andere Wüstenspezialitäten im Angebot.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180502
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732180502,
					"content": "„Große Bestellungen können auch geliefert werden.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180503
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732180503,
					"content": "„Das sieht nicht schlecht aus, ich könnte Dango damit machen. Kannst du es nach Inazuma liefern lassen?“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180504
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732180504,
					"content": "„Ich bitte um Verzeihung. Auslandslieferungen sind bisher nur nach Liyue möglich.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321806,
			"completionStepIds": [
				7321806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321806",
							"2"
						],
						"stepId": 7321806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180601,
					"content": "Auch wenn die „Vergoldete Reise“ keine Werbung machen muss, da es sich um das einzige Gasthaus im Karawanen-Ribat handelt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180602
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732180602,
					"content": "Unser Grillfleisch ist herzhaft und authentisch aus der Wüste. Viel authentischer als in der Stadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180603
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732180603,
					"content": "Selbst nach der anstrengendsten Reise lohnt es sich, vor der Rast etwas zu essen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321807,
			"completionStepIds": [
				7321807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321807",
							"2"
						],
						"stepId": 7321807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180701,
					"content": "„Ich hoffe, der Mahamata zieht die Verschärfung der Zollbeschränkungen im Karawanen-Ribat in Erwägung.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180702
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732180702,
					"content": "„Zurzeit können alle Wüstenbewohner die Grenze passieren, weshalb viele Banditen in den Wald zum Verstecken fliehen und den Menschen in Sumeru die Arbeitsmöglichkeiten wegnehmen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180703
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732180703,
					"content": "„Akasha stand den Wüstenbewohnern bisher nicht zur Verfügung, aber die Missionen der Halle von Regzar decken weit mehr als Söldneraufgaben ab. Wenn das so weitergeht, muss jeder die Aufnahmeprüfung für die Akademie ablegen, und wer sie nicht besteht, wird für immer arbeitslos sein.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180704
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732180704,
					"content": "„Was faselst du da? Die Wüstenbewohner sind eigentlich auch Kinder der Höheren Herrin Rukkhadevata und Menschen von Sumeru. Natürlich dürfen sie die Stadt betreten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180705
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732180705,
					"content": "„Sei vorsichtig, was du hier sagst. Sonst handelst du dir eine Tracht Prügel ein.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321808,
			"completionStepIds": [
				7321808
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321808",
							"2"
						],
						"stepId": 7321808,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180801,
					"content": "Gelehrte, die sich langfristig im Karawanen-Ribat aufhalten, müssen sich vor dem Einchecken im Hotel beim Mahamata registrieren, um Wissensverlusten und anderen unerwarteten Ereignissen zu vorzubeugen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321809,
			"completionStepIds": [
				7321809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321809",
							"2"
						],
						"stepId": 7321809,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180901,
					"content": "Händler und Reisende müssen sich beim Mahamata für eine Zutrittsgenehmigung registrieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180902
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732180902,
					"content": "Die Mitführung von nicht registrierter oder geschmuggelter Ware, deren Im- oder Export verboten ist, ist strengstens untersagt. Jegliche Waren, die gegen die Vorschriften verstoßen, werden beschlagnahmt und die verbundenen Parteien werden in Übereinstimmung mit den Vorschriften in die Wüste ausgewiesen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180903
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732180903,
					"content": "Zudem können die Einwohner des Aaru-Dorfs mit einer von der Akademie ausgestellten Genehmigungsbescheinigung die Grenze passieren.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321810,
			"completionStepIds": [
				7321810
			],
			"beginWay": "TALK_BEGIN_MANUAL",
