				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181001,
					"content": "„Wüstenabenteuerpaket im Angebot! Die beste Wüstenabenteuerlösung für umherziehende Händler und Touristen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181002
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181002,
					"content": "„Wir garantieren allen Käufern, dass ihr wohlbehalten von eurer Reise zurückkehren werdet. Wir haften für einen zehnfachen Schadensersatz, sollten wir unser Versprechen nicht halten. Wenn du jetzt bestellst, erhältst du einen Rabatt!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321811,
			"completionStepIds": [
				7321811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321811",
							"2"
						],
						"stepId": 7321811,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181101,
					"content": "„Ich habe gehört, dass die Akademie früher in der Wüste ein Krankenhaus zur Behandlung von Eleazar eröffnet hat. Aber aus unerfindlichen Gründen wurde es aufgegeben ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181102
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181102,
					"content": "„Die Bewohner des Aaru-Dorfes behaupten sogar, dass geheilte Eleazar-Patienten von dort geflohen sind.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181103
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181103,
					"content": "„Falls dort noch Unterlagen zu finden sind, könnten wir vielleicht ein Heilverfahren für diese Krankheit finden ...“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321812,
			"completionStepIds": [
				7321812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321812",
							"2"
						],
						"stepId": 7321812,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181201,
					"content": "„Es heißt, dass ein Bewohner des Aaru-Dorfs zu einem hohen Beamten in der Akademie aufgestiegen ist. Uns Wüstenbewohnern steht möglicherweise ein besseres Leben bevor.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181202
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181202,
					"content": "„Ich verdiene kaum genug, auch wenn ich den ganzen Tag diese Steine herumschleppe. Aber mit Dingen wie Wissenskonserven bräuchte ich nur ein einziges Geschäft, und ich könnte es mir leisten, in meiner Heimatstadt zu heiraten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181203
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181203,
					"content": "„Aber ich habe gehört, dass der große Beamte für die Bekämpfung des Schmuggels zuständig ist. Ich schätze nicht, dass er sich auf unsere Seite schlagen wird.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181204
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181204,
					"content": "„Tss, so treibt das Schicksal sein Spiel mit uns Wüstenbewohnern, nur weil wir uns nicht zusammentun.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321813,
			"completionStepIds": [
				7321813
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321813",
							"2"
						],
						"stepId": 7321813,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181301,
					"content": "Abenteurer, die sich in die Wüste begeben, beachten bitte, dass alle Abenteuer, die zum Roten Sandmeer führen, gemäß den Vorschriften der Akademie gemeldet werden müssen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181302
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181302,
					"content": "Relikte, die in der Wüste entdeckt werden, gehören grundsätzlich der Akademie. Sie dürfen von niemandem in Besitz genommen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181303
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181303,
					"content": "Aus Sicherheitsgründen wurde ein Zugangsverbot zu Wüstengebieten mit Ausnahme des Roten Sandmeers von der Akademie erlassen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181304
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181304,
					"content": "Die Akademie übernimmt keine Verantwortung für Unfälle in diesen Gebieten, sollte man sich nicht an die Richtlinien halten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321814,
			"completionStepIds": [
				7321814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321814",
							"2"
