			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181401,
					"content": "„Ich habe gehört, dass manche Leute durch den Verkauf von Sandlarvenfett in der Stadt steinreich geworden sind. Jetzt haben sie eine Villa in der Stadt und sind jetzt eine Art „Familie“. Sie verkehren sogar mit der Akademie.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181402
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181402,
					"content": "„Mein Leben lang schleppe ich hier Steine und bin immer noch bettelarm.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181403
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181403,
					"content": "„Was verstehst du schon? Das Geschäft mit Sandlarvenfett bedarf einer Lizenz von der Akademie. Glaub ja nicht, dass du deine Finger im Spiel haben könntest.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181404
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181404,
					"content": "„Wenn du reich werden willst, solltest Bücher mit mir schmuggeln. Wenn es klappt, müssen wir wenigstens keine Steine mehr schleppen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
			"id": 7321815,
			"completionStepIds": [
				7321815
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321815",
							"2"
						],
						"stepId": 7321815,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181501,
					"content": "„Die jungen Menschen machen sich heutzutage viel zu viele Gedanken. Wenn wir Bewohner des Aaru-Dorfs nicht unter dem Schutz der Höheren Herrin Rukkhadevata stünden, wären wir schon längst Tempelruinen begraben.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181502
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181502,
					"content": "„Jemand hat erzählt, dass König Deshret wieder zum Leben erweckt werden könnte. Nicht einmal die Höhere Herrin Rukkhadevata ist nach all den Jahren zurückgekommen, ganz zu schweigen vom trügerischen König Deshret.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181503
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181503,
					"content": "„Am besten gehen wir unserer Arbeit nach. Wir können es uns nicht leisten, den ganzen Monat über nur mit den wenigen Vorräten für das Aaru-Dorf zu leben.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
