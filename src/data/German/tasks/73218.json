	"talks": [
		{
			"id": 7321801,
			"completionStepIds": [
				7321801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321801",
							"2"
						],
						"stepId": 7321801,
