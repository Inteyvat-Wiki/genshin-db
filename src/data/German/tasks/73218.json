				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181801,
					"content": "„Ich hoffe, der Mahamata zieht die Verschärfung der Zollbeschränkungen im Karawanen-Ribat in Erwägung.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181802
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181802,
					"content": "„Zurzeit können alle Wüstenbewohner die Grenze passieren, weshalb viele Banditen in den Wald zum Verstecken fliehen und den Menschen in Sumeru die Arbeitsmöglichkeiten wegnehmen.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181803
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181803,
					"content": "„Akasha stand den Wüstenbewohnern bisher nicht zur Verfügung, aber die von der Halle von Regzar angebotenen Arbeiten decken längst weit mehr als Söldneraufgaben ab. Wenn das so weitergeht, wird jeder irgendwann seinen Job verlieren. Mal sehen, ob die Akademie dann allen eine Stelle geben kann!“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181804
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181804,
					"content": "„Was faselst du da? Die Wüstenbewohner sind eigentlich auch Kinder der Göttin der Pflanzen und Menschen von Sumeru. Natürlich dürfen sie die Stadt betreten.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181805
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181805,
					"content": "„Sei vorsichtig, was du hier sagst. Sonst handelst du dir eine Tracht Prügel ein.“",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
