				{
					"id": 732181601,
					"content": "Fortwährende Anwerbung von Arbeitern für die Instandhaltung des Samiel-Walls.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181602
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181602,
					"content": "Wir bieten ein faires Gehalt mit freier Verpflegung und Unterkunft.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181603
					],
					"speakerTitle": "Ankündigungstafel"
				},
				{
					"id": 732181603,
					"content": "Herausragende Mitarbeiter werden zur Fortbildung an der Akademie empfohlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ankündigungstafel"
				}
			]
		},
		{
