			"dialogs": [
				{
					"id": 191211401,
					"content": "... Du fragst mich, was Thoma tun könnte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211402
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 191211402,
					"content": "Ist Thoma nicht immer sehr beschäftigt? Ihn sieht man nie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211403
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 191211403,
					"content": "Als ich ihn bei der Yashiro-Verwaltung gesehen habe, war er auch immer beschäftigt mit putzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191211404
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 191211404,
					"content": "Ich denke es wäre gut, wenn Thoma so weiter macht wie bisher. Jeder hat seine eigene Art zu leben und Thoma ist da keine Ausnahme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				}
			]
		},
