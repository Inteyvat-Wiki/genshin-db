			"dialogs": [
				{
					"id": 750870501,
					"content": "Da ihr es bis hierher geschafft habt, kann ich ja jetzt aufhören, die nette Händlerin zu spielen, oder? Ich brauche eine Pause von all diesen Idioten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870502
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870502,
					"content": "Du ...! Wie kannst du es wagen, andere Leute für deine Boshaftigkeiten verantwortlich zu machen? Deinetwegen haben uns alle missverstanden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870503,
					"content": "Ich bin ein böser Mensch, natürlich stelle ich auch böse Dinge an. Außerdem, wenn diese drei Idioten euch missverstanden haben, bedeutet das doch, dass ich gut darin bin, böse Dinge zu tun, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870504
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870504,
					"content": "Haha, und jetzt werde ich etwas noch Gemeineres tun! Diesmal entkommt ihr mir nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870505
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870505,
					"content": "Los, Fellknäuel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870506
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870506,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870507
					],
					"speakerTitle": "Fellknäuel"
				},
				{
					"id": 750870507,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870508
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870508,
					"content": "#Los geht’s, {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870509
					]
				},
				{
					"id": 750870509,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}! Du willst dich also wirklich jemandem stellen, der so viel größer ist als du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870510,
					"content": "Uoooh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870511
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870511,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870512,
					"content": "Oberon ist heute nicht so auf der Höhe. Ist er nur besorgt um Taruka, oder hat er zu viele Saurierkekse gegessen ...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870513,
					"content": "#Könnte es sein, dass {REALNAME[ID(2)|SHOWHOST(true)]} ihn aufmuntern will und er deshalb gerade mutig nach vorne getreten ist, um uns zu beschützen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870514,
					"content": "Es gibt vieles in dieser Welt, das Mut allein nicht verändern kann. Im Vergleich zu einer solchen Illusion ist absolute Kontrolle zuverlässiger.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870515
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870515,
					"content": "Angriff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870516
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870516,
					"content": "#Ooh! {REALNAME[ID(2)|SHOWHOST(true)]} ist diesem Angriff tatsächlich ausgewichen! Das ist eine Spezialität der Tepetlisaurier! Nicht einmal der Herrscher des Himmels kann ihm etwas anhaben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870517,
						750870519,
						750870522,
						750870526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870517,
					"content": "Angriff.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870518
					]
				},
				{
					"id": 750870518,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, mach dich bereit zum Angriff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870530,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870531
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870531,
					"content": "Der Angriff hat eingeschlagen! Er hat ... fast keinen Schaden verursacht!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870532,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870533
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870533,
					"content": "Toll, dass wir überhaupt den Gegner getroffen haben! Puh, es ist erst die erste Runde und Paimon ist schon erschöpft. Was ist nur los ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870534,
					"content": "Dann sind wir jetzt dran? Angriff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870535
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870535,
					"content": "#Angesichts des harten Angriffs des Gegners geht {REALNAME[ID(2)|SHOWHOST(true)]} nun schnell in den Verteidigungsmodus! Und hat damit Erfolg!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870536,
					"content": "Du verteidigst dich einfach direkt, nachdem du angegriffen hast! Du niederträchtiger Regelbrecher ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870537
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870537,
					"content": "Das Geheimnis, ein rundenbasiertes Spiel zu gewinnen, besteht darin, sich nicht um die Runden zu kümmern!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870538
					]
				},
				{
					"id": 750870538,
					"content": "Was machen wir als Nächstes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870539,
					"content": "... *brüll!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870540
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870540,
					"content": "Hm? Oberon scheint sich jetzt zusammenzureißen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870541,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870542
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870542,
					"content": "Paimon versteht nicht, was sie sagen, aber es scheint, als hätten sie eine Art stillschweigende Übereinkunft getroffen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870543,
						750870545,
						750870547,
						750870550
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870543,
					"content": "Abgestimmter Angriff.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870544
					]
				},
				{
					"id": 750870544,
					"content": "Auf geht’s! Zeig uns, was der zukünftige Star der Flugschule drauf hat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870552,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870553
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870553,
					"content": "#Oberon hat dem Gegner den Fluchtweg in die Luft versperrt und {REALNAME[ID(2)|SHOWHOST(true)]} greift an! Brillante Koordination!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870554
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870554,
					"content": "Fellknäuel wurde schwer getroffen! Ist sein Fuß verletzt? Fühlt sich wahrscheinlich so an, wie wenn man sich den großen Zeh am Tischbein stößt! Der Gegner scheint nun in Panik zu sein und kann sich nicht mehr bewegen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870555,
						750870557,
						750870560,
						750870562
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870555,
					"content": "#Angriff, aber ich bin {F#diejenige}{M#derjenige}, {F#die}{M#der} angreift.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870556
					]
				},
				{
					"id": 750870556,
					"content": "#Das könntest du tun ... aber komm schon, {REALNAME[ID(2)|SHOWHOST(true)]} hat nicht viele Gelegenheiten, sein Können unter Beweis zu stellen. Also sei nicht so kindisch!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870565,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870566
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870566,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870567
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870567,
					"content": "#Hm? Es sieht so aus, als hätten {REALNAME[ID(2)|SHOWHOST(true)]} und Oberon einen Plan ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870568
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870568,
					"content": "Saurierkekse? Woher kommen diese Saurierkekse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870569
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870569,
					"content": "*brüll* ... *brüüüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870570
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870570,
					"content": "Warte, hattest du sie unter deinen Flügeln versteckt? Was für ein gerissener kleiner Saurier ... Taruka wird es nicht leicht haben mit dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870571
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870571,
					"content": "Uoooh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870572
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870572,
					"content": "Das ist jetzt nicht der richtige Zeitpunkt dafür! He! Aufhören!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870573
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870573,
					"content": "Hm? Fellknäuel hat ihren Befehl ignoriert und ist auf die Saurierkekse zugerannt! Die Aussicht auf 5 Punkte Ausdauer ist einfach zu verlockend!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870574
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870574,
					"content": "Aber er weiß nicht, dass er der Saurier ist, der am Ende gefressen werden wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870575
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870575,
					"content": "#Zusammenfassend bleibt zu sagen, dass der Kampf noch einige Runden andauerte.\\n{REALNAME[ID(2)|SHOWHOST(true)]} handelte natürlich mutig, als wollte er sich beweisen. Auch wenn er nicht zum herausragenden Schüler der Flugschule ernannt werden würde, so konnte er doch seine anderen Fähigkeiten nutzen, um seinen Kameraden zu helfen.\\nÜberraschenderweise war sogar Oberons unerwartete Gewichtszunahme hilfreich. Da er nun größer als ein durchschnittlicher Qucusaurier war, konnte er das Schlachtfeld zur Luft hin abriegeln und Fellknäuel einen schweren Schlag versetzen ...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870576
					]
				},
				{
					"id": 750870576,
					"content": "Quilla selbst erwies sich im Kampf als ziemlich nutzlos und suchte das Weite, nachdem Fellknäuel der Kampfeswille verlassen hatte.\\n„Du verdammter Regelbrecher! Du ... So leicht wirst du das nächste Mal nicht gewinnen! Du wirst schon sehen!“\\nNachdem sie gesagt hatte, was lächerliche Bösewichte eben so sagen, wenn sie Reißaus nehmen, rannte sie mit dem verletzten Fellknäuel davon.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870577
					]
				},
				{
					"id": 750870577,
					"content": "Oh! Paimon hat vergessen, sie zu fragen, wo Taruka ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870578
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870578,
					"content": "Uoooh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870579
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870579,
					"content": "He, Kopf hoch. Taruka ist ein kluges Kind. Paimon ist sicher, dass ihm nichts passieren wird!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870580
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870580,
					"content": "*brüll*! *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870581
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870581,
					"content": "#Siehst du das auch so, {REALNAME[ID(2)|SHOWHOST(true)]}? Bringen wir Oberon erst einmal zurück zur Flugschule!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870557,
					"content": "Den Gegner überzeugen, sich zu ergeben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870558
					]
				},
				{
					"id": 750870558,
					"content": "Wenn Worte alle Probleme lösen könnten, warum gibt es dann noch so viele Konflikte auf der Welt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870559
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870559,
					"content": "Ähm ... Paimon meint nur, dass es wahrscheinlich nicht funktionieren wird.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870560,
					"content": "Ihn mit einem magischen Objekt fangen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870561
					]
				},
				{
					"id": 750870561,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870562,
					"content": "Lass uns jetzt fliehen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870563
					]
				},
				{
					"id": 750870563,
					"content": "*brüll* ... *brüüüll* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870564
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870564,
					"content": "#Ooh, selbst {REALNAME[ID(2)|SHOWHOST(true)]} verlässt jetzt der Mut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870545,
					"content": "Verteidigung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870546
					]
				},
				{
					"id": 750870546,
					"content": "Es ist offensichtlich, dass es hier zwei gegen einen heißt. Unser Gegner kann kaum beide Ziele gleichzeitig angreifen, also wäre das nicht die Verschwendung einer Runde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870547,
					"content": "Objekt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870548
					]
				},
				{
					"id": 750870548,
					"content": "Mit den Saurierkeksen hast du fünf Punkte Ausdauer wiederhergestellt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870549
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870549,
					"content": "... Nicht, dass das notwendig wäre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870550,
					"content": "Fliehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870551
					]
				},
				{
					"id": 750870551,
					"content": "Komm schon, es läuft doch gut. Warum denkst du immer noch ans Weglaufen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870519,
					"content": "Verteidigen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870520
					]
				},
				{
					"id": 750870520,
					"content": "*brüll* ... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870521
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870521,
					"content": "#Für {REALNAME[ID(2)|SHOWHOST(true)]} scheint es unklug zu sein, jetzt in die Defensive zu gehen, da er sonst eine große Chance verpassen würde. Also macht er sich zum Angriff bereit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870522,
					"content": "Objekt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870523
					]
				},
				{
					"id": 750870523,
					"content": "Wir haben im Moment keine Hilfsmittel! Und denkst du nicht, dass es etwas zu spät ist, jetzt noch eine Bestienfalle aufzustellen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870524,
					"content": "*brüll* ... *brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870525,
					"content": "#Ooh! {REALNAME[ID(2)|SHOWHOST(true)]} ist nun im Angriffsmodus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870526,
					"content": "Fliehen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870527
					]
				},
				{
					"id": 750870527,
					"content": "Das ist jetzt nicht der richtige Zeitpunkt, zu fliehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870528,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870529
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870529,
					"content": "#Selbst {REALNAME[ID(2)|SHOWHOST(true)]} weiß das. Schau, er macht sich zum Angriff bereit!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7508707,
