					"nextDialogs": [
						750870303
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870303,
					"content": "Könnte das etwa ... Oberon sein?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870304,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870305
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870305,
					"content": "Ooh ... Du bist ganz schön gewachsen, seit wir uns das letzte Mal gesehen haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870306,
					"content": "Taruka hatte recht, als er sagte, dass du leicht an Gewicht zulegst. Wo ist er denn überhaupt? Warum ist er nicht bei dir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870307,
					"content": "Uoooh ... Uoooh uoooh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870308
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870308,
					"content": "Äh, gehen wir erst mal weg von hier, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870309,
					"content": "Jetzt, da wir Oberon gefunden haben, brauchen wir uns ja nicht mehr zu verstecken, oder? Aber Paimon macht sich wirklich Sorgen um Taruka ... Wir müssen uns beeilen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
