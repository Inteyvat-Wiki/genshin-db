			"dialogs": [
				{
					"id": 750870901,
					"content": "Schon wieder Saurierkekse? Und der Brief daneben ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870902,
					"content": "Es war also tatsächlich Quilla, die hinter alldem steckte! Aber auf dieses Motiv wäre Paimon nie gekommen ... Paran hatte wirklich richtig Pech.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870903,
					"content": "Allein der Gedanke daran, dass Taruka und Oberon in dem Lager da vorne gefangen sein könnten, gibt Paimon ein schlechtes Gewissen, wenn wir nichts tun würden ... Außerdem haben sie ja nichts falsch gemacht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870904,
					"content": "#Hmm, {NICKNAME}, wollen wir uns nicht etwas überlegen, sie zu retten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870905,
					"content": "Wenn wir uns <color=#00E1FFFF>unter die Iktomisaurier-Patrouillen mischen</color> würden, könnten wir uns wahrscheinlich leichter einschleichen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
