					},
					{
						"sceneId": 3,
						"position": [
							-1813.328,
							132.133,
							9749.9
						],
						"pointId": 9633
					}
				]
			},
			"dialogs": [
				{
					"id": 750870701,
					"content": "Hä? Taruka! Du bist ja schon zurück!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870702,
					"content": "#Aah, {M#Herr}{F#Frau} {NICKNAME}, ich bin so froh, dass es dir gut geht! Ich habe meiner Schwester und allen anderen erzählt, was passiert ist. Lamizana ist so ein Dummkopf, genau wie ich dachte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870703
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870703,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870704
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870704,
					"content": "Ja, sogar noch dümmer als du!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870705
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870705,
					"content": "Uoooh ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870706
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870706,
					"content": "#Schon gut, Paimon glaubt, er ist wirklich unruhig, weil er so lange von dir getrennt war. Außerdem hat er gerade super mit {REALNAME[ID(2)|SHOWHOST(true)]} zusammengearbeitet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870707,
					"content": "Da gibt es noch Potenzial zur Verbesserung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870708
					]
				},
				{
					"id": 750870708,
					"content": "Genau, er ist ja immer noch ein kleiner Saurier. Solange du ihn gut behandelst, Taruka, wird er sicher zu einem fabelhaften Qucusaurier heranwachsen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870709,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870710
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870710,
					"content": "Apropos, wie bist du hierher zurückgekommen? Hat dich jemand gefunden und gerettet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870711,
					"content": "Ich bin alleine entkommen. Ich hatte eigentlich vor, Oberon mitzunehmen, aber er wollte lieber Saurierkekse essen und hat sich nicht bewegt, egal, was ich auch versuchte. Daraufhin wurde ich dann ziemlich wütend und bin alleine gegangen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870712
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870712,
					"content": "Hm? Es war also so einfach?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870713,
					"content": "Nachdem ich die Routen der patrouillierenden Wach-Saurier etwas einschätzen konnte, habe ich den richtigen Moment abgepasst und konnte fliehen, ganz ohne Probleme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870714
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870714,
					"content": "Weißt du, wahrscheinlich bist du der Verlässlichste von allen hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870715,
					"content": "Warum seid ihr denn gekommen? Ich war gerade dabei, die Sache mit der Lügnerin zu klären ... und ... und mich natürlich offiziell bei euch entschuldigen ... Ich hab willkürlich Entscheidungen getroffen und dabei fast unschuldige Leute verleumdet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870716,
						750870718
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870716,
					"content": "Zu spät.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870717
					]
				},
				{
					"id": 750870717,
					"content": "Genau! Du bist erst aufgetaucht, als alles vorbei war. Wenn sich da mal jemand nicht mit fremden Federn schmücken will, was?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870720,
					"content": "Mir gehen die Argumente aus. Egal, ob es die versprochene Belohnung ist oder die Entschädigung, die ich dir jetzt schulde – ich werde nicht knauserig sein. Ihr könnt mich verprügeln, wenn ihr euch dann besser fühlt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870721
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870721,
					"content": "Ich bin ein ganzer Kerl, und deswegen werde ich mich auch nicht vor meiner Verantwortung drücken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870722,
						750870724
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870722,
					"content": "#Ich werde {REALNAME[ID(2)|SHOWHOST(true)]} bitten, dir eine zu verpassen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870723
					]
				},
				{
					"id": 750870723,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870726,
					"content": "Aua! Aua! Er hat noch nicht mal zugetreten und es tut schon höllisch weh! Bitte erhebe nicht deine Hände gegen mich, ähm, deine Füße, meine ich!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870727
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870727,
					"content": "Hast du nicht gerade gesagt, dass du ein ganzer Kerl bist, der sich nicht vor seiner Verantwortung drücken wird? Ein Versager bist du, mehr nicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870728,
					"content": "#Egal, das wäre eh unter unserer Würde, oder etwa nicht, {NICKNAME}, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870729,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870730
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870730,
					"content": "Ich danke euch für eure Nachsicht. Die Türen der Flugschule ... Ähm, na ja, sie hat ja nicht wirklich Türen ... Also ihre symbolischen Türen stehen euch immer weit offen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870731
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870731,
					"content": "#Da du und {REALNAME[ID(2)|SHOWHOST(true)]} ein so enges Verhältnis habt, wollte ich dich fragen, was der Trick dabei ist, sich so gut mit kleinen Sauriern zu verstehen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870732
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870732,
					"content": "Hehe, kein Problem. Wir kommen wieder, wenn wir Zeit haben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870724,
					"content": "#Lass dir von {REALNAME[ID(2)|SHOWHOST(true)]} auf die Zehen treten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870725
					]
				},
				{
					"id": 750870725,
					"content": "*brüll*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870718,
					"content": "Ich verlange eine Entschädigung! Und meinen Teilnahmepreis.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870719
					]
				},
				{
					"id": 750870719,
					"content": "Du hast also den Teilnahmepreis noch nicht vergessen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "Paimon"
				}
			]
		},
