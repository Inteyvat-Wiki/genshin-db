			"dialogs": [
				{
					"id": 790000301,
					"content": "Ach, sie ist nicht aufgegangen ... Sieht aus, als hätten wir einen falschen Code eingegeben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000302
					],
					"speakerTitle": "Verschlossene Kiste"
				},
				{
					"id": 790000302,
					"content": "Hören wir den Geräuschen der Muscheln aufmerksam zu. Vielleicht geben sie uns Hinweise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000302
					],
					"speakerTitle": "Verschlossene Kiste"
				}
			]
