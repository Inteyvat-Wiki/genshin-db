			},
			"dialogs": [
				{
					"id": 790000401,
					"content": "Gefunden! Schatz, Schatz ... Ich frage mich, was wir wohl darin finden werden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000402,
					"content": "Hä? Da ist ein Schloss dran ... Sieht aus, als ob wir einen Code benötigen, um es zu öffnen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000403,
						790000404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000403,
					"content": "Wir könnten sie einfach zertrümmern, oder nicht?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000405
					]
				},
				{
					"id": 790000405,
					"content": "Warte! Was, wenn der Inhalt dabei auch kaputtgeht?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000406,
					"content": "Wir sollten einen Weg finden, sie aufzuschließen, in Ordnung?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000410,
					"content": "Aber da sich in der Kiste „Familienerbstücke“ befinden und sie mit einem Nummernschloss gesichert ist ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000411,
					"content": "Das bedeutet, dass die Person, die sie verschlossen hat, denkt, dass der Code einfach genug zu merken ist.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000412,
					"content": "Sieht so aus, als wären diese Schneckenhäuser, die Geräusche aufbewahren, unsere einzige Chance.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000413,
					"content": "Hören wir uns die Geräusche der Schnecken erneut an. Hoffentlich geben sie uns einige Hinweise bezüglich des Codes ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000404,
					"content": "Sieht so aus, als müssten wir einen Weg finden, sie aufzuschließen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000407
					]
				},
				{
					"id": 790000407,
					"content": "Paimon sieht aber gar keine Steintafeln, Malereien, Notizen oder Schnitzereien in der Nähe ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790000408,
					"content": "Auch herrscht hier ein Mangel an Gelehrten, Schatzräubern und Abenteurern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790000409
					]
				},
				{
					"id": 790000409,
					"content": "Ja. Hm ... Dies ist eine unerwartete Herausforderung!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790000410
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}