				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3540401,
					"content": "Möge der Windgott dich beschützen, Fremder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540402,
					"content": "Ich bin Kundschafterin des Ordo Favonius. Mein Name ist Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540403
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540403,
					"content": "Du bist kein Bewohner von Mondstadt, nicht wahr? Sag, woher du kommst!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540404,
					"content": "Beruhige dich bitte! Wir wollen keinen Ärger machen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540405,
					"content": "Das sagen sie alle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540406
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540406,
					"content": "#Ich bin erfreut. Mein Name ist {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540407
					]
				},
				{
					"id": 3540407,
					"content": "Das klingt nicht nach einem hier geläufigen Namen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540408,
					"content": "Und was macht dein Maskottchen hier?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540409,
						3540412
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540409,
					"content": "Wir sind Freunde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540410
					]
				},
				{
					"id": 3540410,
					"content": "Wir kennen uns zwar erst seit zwei Monaten, aber ja ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540411,
					"content": "Wir sind jetzt schon die besten Freunde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540414,
					"content": "Ihr seid also zusammen auf Reisen, ja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540415
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540415,
					"content": "Um Mondstadt herum wurde ein Drache gesichtet. Ihr solltet besser schnell in die Stadt gehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540416
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540416,
					"content": "Wir sind nicht weit entfernt. Ich kann euch dorthin begleiten. Schließlich bin ich ein Ritter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540417
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540417,
					"content": "Ach so? Du bist gar nicht hier, um etwas anderes zu erledigen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540418,
					"content": "Natürlich habe ich noch einen Auftrag auszuführen. Das hindert mich aber nicht daran, euch sicher zur Stadt zu führen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540419
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540419,
					"content": "Außerdem kann ich euch nicht einfach so allein lassen. Ich weiß ja noch gar nichts über euch.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540420,
						3540421
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540420,
					"content": "Du scheinst uns nicht sonderlich zu vertrauen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540422,
					"content": "Oh, das tut mir leid! Als edler Ritter sollte ich nicht so mit euch sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540423
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540423,
					"content": "Ich bitte vielmals um Verzeihung, fremde ... äh ... ehrwürdige Reisende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540424
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540424,
					"content": "Das kam sehr gezwungen rüber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540425,
					"content": "Hast du etwas gegen den Wortgebrauch aus dem Handbuch des Ritterordens?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540421,
					"content": "So sollte man nicht gerade mit seinen Gästen sprechen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540412,
					"content": "Ist nur was zum Knabbern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540413
					]
				},
				{
					"id": 3540413,
					"content": "Hör auf! Das ist ja noch schlimmer als ein Maskottchen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}