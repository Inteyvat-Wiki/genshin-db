				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ekaterina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100201,
					"content": "#Willkommen, {NICKNAME}, Freund des Grafen! Wir hoffen auf eine fruchtbare Zusammenarbeit zwischen dir und den Fatui.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100202,
						10100203
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100202,
					"content": "Ich bin kein Freund des Grafen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				},
				{
					"id": 10100204,
					"content": "Ach, wir sind doch alle nur normale Leute mit Gedanken so fließend wie Wasser, nicht so fest und scharf wie die der Zarin des Eises.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100205
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100205,
					"content": "Aber kommen wir wieder zum Thema. Der Graf meinte, er hätte seinen Teil der Vereinbarung eingehalten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100206
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100206,
					"content": "Vereinbarung? Meint er damit, dass er uns bei der Suche nach jemandem helfen wollte?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100207,
					"content": "Ja, der Graf hat euch versprochen jemanden zu finden, der das Dilemma auflösen kann. Die Elf der Fatui brechen niemals ein Versprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100208
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100208,
					"content": "Aber wo ist er denn jetzt?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100209,
					"content": "Er befindet sich im <color=#00E1FFFF>Liuli-Pavillon</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100210
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100210,
					"content": "Im Liuli-Pavillon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100211
					]
				},
				{
					"id": 10100211,
					"content": "Ah, der Liuli-Pavillon! Von dem habe ich gehört!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100212,
					"content": "Li und Yue, die beiden Küchen von Liyue, stehen schon seit Jahrhunderten in einem Kampf, der bis heute nicht entschieden wurde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100213,
					"content": "Am besten repräsentiert der Liuli-Pavillon die Li-Küche. Der Inhaber hat das Restaurant absichtlich am Feiyun-Hang eröffnet, in direkter Konkurrenz zum „Lokal Xinyue“, das für die Yue-Küche steht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100214,
						10100215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100214,
					"content": "Paimon, in solchen Situationen bist du wirklich nützlich.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100216,
					"content": "#Jetzt sei nicht so! Es geht schließlich ums Essen! {NICKNAME}, wollen wir dem Restaurant einen Besuch abstatten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100215,
					"content": "Sobald es ums Essen geht, legst du los.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100203,
					"content": "Ich habe nicht vor, den Fatui beizutreten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				}
			]
		},
		{
			"id": 101003,
			"completionStepIds": [
				101003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101003",
							"2"
						],
						"stepId": 101003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"„Der Graf“"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100301,
					"content": "Oh, ihr seid hier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100302
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10100302,
					"content": "Ich habe mich an unsere Vereinbarung gehalten und jemanden gefunden, der euch bei eurem Problem, dass die Qixing den Leichnam des Geo-Archons versteckt haben, helfen kann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100303
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10100303,
					"content": "Und wo ist dieser ominöse Jemand? Hier im <color=#00E1FFFF>Liuli-Pavillon</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100304,
					"content": "Genau, folgt mir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100305
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10100305,
					"content": "Ich habe ein Essen arrangiert, wie es sich in Liyue gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Der Graf“"
				}
			]
		},
		{
			"id": 101005,
			"completionStepIds": [
				101005
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101005",
							"2"
						],
						"stepId": 101005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100501,
					"content": "Darf ich vorstellen? Dies ist Zhongli vom Bestattungsunternehmen Wangsheng, er arbeitet mit den Fatui zusammen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100502,
						10100503
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10100502,
					"content": "Mit den Fatui?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				},
				{
					"id": 10100504,
					"content": "Ja, wenn man ein Geschäft wie das Bestattungsunternehmen Wangsheng betreibt, kommt man mit Organisationen dieser Art in Kontakt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100505
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10100505,
					"content": "Und wir Fatui haben die Angewohnheit, mit unseren Kontakten im Dunkeln zusammenzuarbeiten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100506
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10100506,
					"content": "Im Dunkeln also ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100507,
					"content": "Ich bin erfreut. Ich habe von euren Taten in Mondstadt gehört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100508
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100508,
					"content": "Organisationen ... im Dunkeln ... Bestattung ... aaaah! Ist das Bestattungsunternehmen Wangsheng das, was Paimon vermutet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100509,
					"content": "Ja, du liegst richtig.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100510
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100510,
					"content": "Oh nein!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100511,
					"content": "Das Bestattungsunternehmen Wangsheng kümmert sich um Beerdigungen jeder Art, damit die Menschen ihre letzte Ruhestätte finden können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100512
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100512,
					"content": "Ach so?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100513,
					"content": "Hahaha, du hast Zhongli wohl für einen eiskalten Mörder gehalten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100514
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10100514,
					"content": "Unter denen, die mit den Fatui zusammenarbeiten, gibt es zahlreiche Mörder. Das Bestattungsunternehmen Wangsheng hat mit Morden aber nichts zu tun ... jedenfalls nicht in dieser Hinsicht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100515
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10100515,
					"content": "Nicht in dieser Hinsicht ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100516
					]
				},
				{
					"id": 10100516,
					"content": "Schließlich laufen die Geschäfte ... Ach, gehen wir nicht ins Detail. Ich habe euch mit Zhongli bekanntgemacht, weil ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100517
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10100517,
					"content": "Weil ich dafür sorgen kann, dass ihr den Leichnam von Rex Lapis seht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100518
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100518,
					"content": "Was?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100519,
					"content": "Jetzt erschrick doch nicht gleich! Ningguang, der Tianquan, hat den Leichnam des Geo-Archons zwar auf der Stelle verstecken lassen. Ihr solltet euch aber anhören, was Zhongli zu sagen hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100520
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10100520,
					"content": "Rex Lapis ist der Stammvater der Adepten, damit aber selbst auch nur ein Adept. In den Jahrtausenden, in denen die Adepten über Liyue gewacht haben, sind sie einer nach dem anderen von uns gegangen. Das ist ein Fakt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100521
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100521,
					"content": "Die Zeiten ändern sich nun einmal. Das wirst du auch im Jueyun-Karst gesehen haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100522,
						10100523
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100522,
					"content": "Die Adepten halten sich tatsächlich von Liyue fern.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100525
					]
				},
				{
					"id": 10100525,
					"content": "Ganz offensichtlich ist die Zeit der Adepten längst vorüber und die Zeit der Menschen ist gekommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100526
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100526,
					"content": "Immer wenn ein Adept von uns geht, veranstalten wir ein großes Fest zu seinem Gedenken. Das ist Tradition hier in Liyue. Aber dieses Mal haben sich selbst die Qixing nicht an diese Tradition gehalten und das ist nicht akzeptabel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100527
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100527,
					"content": "Schließlich ist dies der „Fall des Gottesmordes“ ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100528
					]
				},
				{
					"id": 10100528,
					"content": "Richtig, wir haben noch nicht einmal den echten Mörder gefunden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100529,
					"content": "Der Fall des Gottesmordes ... Das Bestattungsunternehmen Wangsheng interessiert sich nicht für solche Sachen. Für was es sich aber interessiert, ist, dass sich keiner mehr für die Abschiedszeremonie interessiert, wenn die Adeptenzeremonie schon viel Aufsehen erregt hat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100530
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100530,
					"content": "#{F#Reisende}{M#Reisender}, ich habe vom Grafen von dir gehört. Du scheinst mit dem Anemo-Archon freundschaftlich verbandelt zu sein ... Wärst du gewillt, mit mir gemeinsam die Abschiedszeremonie für den Geo-Archon vorzubereiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100531,
						10100534,
						10100536
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100531,
					"content": "Ich denke noch einmal darüber nach ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100532
					]
				},
				{
					"id": 10100532,
					"content": "#{NICKNAME}, überleg es dir gut, es gibt keine andere Wahl ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100533,
					"content": "Egal wie viel du überlegst, das Ergebnis bleibt dasselbe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10100539,
					"content": "Der Tianquan Ningguang hält jeden davon ab, den göttlichen Leichnam des Geo-Archons zu sehen. Wenn du also dein Ziel, die Sieben zu finden, erreichen willst, ist dies der einzige Weg.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100540
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10100540,
					"content": "Genau, nur durch die Teilnahme am „Adeptenabschied“ kannst du den Geo-Archon ein letztes Mal sehen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100541
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100541,
					"content": "Es scheint keinen anderen Weg zu geben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100542
					]
				},
				{
					"id": 10100542,
					"content": "Nun, wenn du magst, komm mit mir. Wir können dann über die Details sprechen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100543
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100543,
					"content": "(Schwarzer Bildschirm, Zhongli verlässt den Raum.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100544
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100544,
					"content": "Mein Vermittlungsdienst ist hiermit beendet. Es hat sich doch gelohnt, oder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100545
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10100545,
					"content": "Wenn ihr gehen müsst, dann geht, kümmert euch nicht um mich. Ich werde hier wohl noch ein paar Becherchen trinken ... und mache mich mit diesen „Stäbchen“ vertraut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10100534,
					"content": "Eine Einladung zu akzeptieren, da ist doch nichts dabei ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100535
					]
				},
				{
					"id": 10100535,
					"content": "Eine weise Wahl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10100536,
					"content": "Der Graf redet zu viel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100537
					]
				},
				{
					"id": 10100537,
					"content": "Ah? In meinen Kreisen bedeutet dies, dass du mir drohen willst ... Wirklich lustig, zieh dein Schwert, wir kämpfen hier und jetzt!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100538
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10100538,
					"content": "Das war natürlich nur ein Scherz. Lass uns weiter über das Geschäft reden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "„Der Graf“"
				},
				{
					"id": 10100523,
					"content": "Der Geo-Archon, einer der Sieben, ist auch ein Adept?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100524
					]
				},
				{
					"id": 10100524,
					"content": "Dieser Gott hat viele Namen: Gott der Verträge, Gott der Geschäfte, Kriegsgott, Morax, Rex Lapis ... Dazu gehört aber auch Adept.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100525
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100503,
					"content": "Bestattungsunternehmen Wangsheng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				}
			]
		},
		{
			"id": 101006,
			"completionStepIds": [
				101006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101006",
							"2"
						],
						"stepId": 101006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100601,
					"content": "#{F#Reisende}{M#Reisender}, nachdem ihr eine „gottverlassene Stadt“ erlebt habt, wie steht ihr Liyue, der „Stadt der Götter“ gegenüber?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100602,
						10100605
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100602,
					"content": "Mir liegt mehr die Atmosphäre von Mondstadt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100603
					]
				},
				{
					"id": 10100603,
					"content": "So ist das also ... Du bist demnach diese Art von Besucher. Das ist auch nicht schlecht.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100604,
					"content": "Andererseits, du hast wahrscheinlich noch nicht die volle dreitausendsiebenhundertjährige Geschichte der „Stadt der Götter“ aufnehmen können.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100607,
					"content": "Der Prozess der Vorbereitung für den „Adeptenabschied“ wird Teil deiner Reise werden und deinen Horizont erweitern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100608
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100608,
					"content": "Liyue ist die reichste der sieben Städte. In den Jahren zuvor regierten hier unter dem Schutz der Götter noch die Qixing. Daher waren die Einmischungsversuche der „Fatui“ in Liyue bisher immer erfolglos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100609
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100609,
					"content": "Ningguang war bisher die effektivste Waffe der Qixing gegen die Fatui. Das ist wahrscheinlich auch der Grund, wieso der Graf sich gute Beziehungen zum Bestattungsunternehmen Wangsheng aufbauen will.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100610
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100610,
					"content": "Was hat denn der Graf davon, wenn wir den „Adeptenabschied“ vorbereiten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100611,
					"content": "Ich weiß es nicht und ich will es auch gar nicht wissen. Die Fatui leisten hier nur finanzielle Hilfe, sonst nichts, daher hoffe ich, dass Liyues Traditionen nicht von den Menschen vergessen werden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100612
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100612,
					"content": "(Zhongli gibt der Hauptfigur einen Geldbeutel)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100613
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100613,
					"content": "Dies ist die erste Anzahlung des Grafen. Solltest du mehr brauchen, kannst du jederzeit zu ihm für mehr.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100614
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100614,
					"content": "Holla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100615,
					"content": "Lasst uns loslegen. Der erste Schritt zur Vorbereitung der Zeremonie ist, hochwertige Güter zu finden, so wie etwa diese <color=#00E1FFFF>Nachtjade</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100605,
					"content": "Natürlich ist Liyue besser.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100606
					]
				},
				{
					"id": 10100606,
					"content": "Die dreitausendsiebenhundertjährige Geschichte der „Stadt der Götter“ ist unter den sieben Städten die längste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "Zhongli"
				}
			]
		},
