			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230270101,
					"content": "Ich schätze, es bedarf einer ordentlichen Fürsorge ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270102,
					"content": "Was machst du da?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270103
					]
				},
				{
					"id": 230270103,
					"content": "#Du bist ... Oh, wahrscheinlich {F#eine Reisende}{M#ein Reisender}, richtig?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270104,
					"content": "Ich bin Yasmin, eine Studentin des Amurta-Instituts. Ich studiere gerade den „Heiligen Baum“.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270105,
					"content": "Der „Heilige Baum“ hat mehr Jahre auf dem Buckel als alle Reiskörner im Pilaw in Ormos zusammengenommen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270106,
					"content": "Außerdem bildet er die Grundlage der Akademie ... Er ist genauso wichtig wie das Gemüse unter dem Tandoori-Brathähnchen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270107,
						230270108
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270107,
					"content": "Was sind das für Vergleiche ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270110
					]
				},
				{
					"id": 230270110,
					"content": "Aber wenn ihm etwas zustößt, droht ganz Sumeru eine verheerende Katastrophe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270111
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270111,
					"content": "Zum Beispiel, wenn er von Ungeziefer geplagt wird und Heuschrecken, die größer als ein Dach sind, aus dem Inneren dringen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270112,
					"content": "Oder falls seine Zweige in ein frenetisches Wachstum verfallen, kommen die Wurzeln wie Hochwasser aus der Erde hervor und zerstören alle Gebäude.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270113,
					"content": "Oder vielleicht verwittert der „Heilige Baum“ mit rasender Geschwindigkeit und begräbt dabei halb Sumeru unter seinem fallenden Stamm ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270114
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270114,
					"content": "Das ... Das wird nicht passieren, oder?!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270115
					]
				},
				{
					"id": 230270115,
					"content": "Oh, natürlich. Bisher geht es ihm gut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270116
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270116,
					"content": "Andererseits sagen dir Pilzbestien auch nicht vorher Bescheid, wann sie dich angreifen, wenn du Champignons im Wald pflückst.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270117
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270117,
					"content": "Deshalb studiere ich den Baum, um auf alle Zwischenfälle, die auf uns zukommen könnten, gefasst zu sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270118
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270118,
					"content": "Nun, wie du siehst, ist mein Verstand zwar so schnell wie ein Dämmersegler, aber meine Kraft ist so gering wie ein Sternpilz ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270119
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270119,
					"content": "#Also, {F#Reisende}{M#Reisender}, kannst du mir helfen, den Zustand der Wurzeln des „Heiligen Baums“ an einigen Stellen aufzuzeichnen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270120
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270120,
					"content": "Normalerweise stelle ich Abenteurer ein, die mit mir kommen. Aber sie scheinen alle anderweitig beschäftigt zu sein ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270121,
						230270122
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270121,
					"content": "Überlasse es mir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230270122,
					"content": "Sprecht ihr Gelehrten alle so ...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270123
					]
				},
				{
					"id": 230270123,
					"content": "Hm? Meinst du die Vergleiche? Tut mir leid, das ist einfach meine Art zu reden ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270124
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270124,
					"content": "Viele Leute im Institut haben mich auf dieses Problem angesprochen, aber ich kann mich nicht von heute auf morgen ändern.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270125
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270125,
					"content": "Danke. Ich warte hier auf dich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270108,
					"content": "Paimon versteht sie bestimmt.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270109
					]
				},
				{
					"id": 230270109,
					"content": "Wahrlich ein großartiger Baum ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270110
					],
					"speakerTitle": "Paimon"
				}
			]
		},
