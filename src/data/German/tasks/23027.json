			"dialogs": [
				{
					"id": 230271101,
					"content": "Ihr seid wieder da! Wie geht es den Wurzeln des Heiligen Baums?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271102,
					"content": "Du beschreibst Yasmin den Zustand der Wurzeln ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230271103
					]
				},
				{
					"id": 230271103,
					"content": "... Oh, wenn sich Lebewesen dort versammeln, sollte die Erde sehr vital sein.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271104,
					"content": "Die Wurzeln des Heiligen Baums sollten solides Wachstum verspüren, also sollte es für den Moment keine zu großen Probleme geben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271105,
					"content": "Das einzige Problem, mit dem wir uns beschäftigen müssen ... ist die potenzielle Eutrophierung des Wassers in der Umgebung, was noch mehr Pilzbestien nähren könnte ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271106,
					"content": "Oh, hier ist eure Bezahlung. Danke für eure Hilfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271107,
					"content": "Ladep und Pharez sollten die Konzentration der Elemente überwachen ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		}
	]
}