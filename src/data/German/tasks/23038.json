			"dialogs": [
				{
					"id": 230381101,
					"content": "Ei, ei, ei ... An den Ingredienzen dürfte nichts auszusetzen sein und auch meine Zubereitungsmethode war richtig, wie kann dann ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381102
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381102,
					"content": "#Rei... {F#Reisende}{M#Reisender}, was machst du denn hier ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381103
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381103,
					"content": "Ich habe die Medizin von Zakariya gebracht.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381104
					]
				},
				{
					"id": 230381104,
					"content": "Du hast also auch meine Geschichte gehört? Das ist mir so peinlich ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381105
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381105,
					"content": "Trinke erst die Medizin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381106
					]
				},
				{
					"id": 230381106,
					"content": "Oh ... Also gut ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381107
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381107,
					"content": "Maruf trinkt die Medizin ...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230381108
					]
				},
				{
					"id": 230381108,
					"content": "Oh ... Ich fühle mich schon etwas besser. Doktor Zakariya ist wirklich beeindruckend ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381109
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381109,
					"content": "Warum willst du das Rezept ändern?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381110
					]
				},
				{
					"id": 230381110,
					"content": "Erinnerst du dich daran, wie wir zusammen ein Heilmittel zubereitet haben? Ich weiß nicht warum, aber jenes Heilmittel war nicht besonders wirksam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381111
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381111,
					"content": "Ich vermute, dass es ein Problem mit der Zubereitungsweise gab oder dass irgendwelche Ingredienzen gefehlt haben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381112
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381112,
					"content": "Daher habe ich ... Wie soll ich sagen ... Basierend auf meiner eigenen Erfahrung ein neues Heilgebräu zubereitet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381113
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381113,
					"content": "Sicherheitshalber habe ich zuerst selbst davon probiert, und das war das Ergebnis ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381114
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381114,
					"content": "Ich habe jemanden zu Doktor Zakariya gesandt, damit er mir ein Rezept ausstellt. Ich hätte nicht gedacht, dass du so schnell mit dem Heilmittel zurückkommen würdest.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381115
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381115,
					"content": "#Ich danke dir, {F#Reisende}{M#Reisender}. Ich werde mich ein wenig ausruhen, bevor ich mich wieder um meine Patienten kümmere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381116
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381116,
					"content": "Wo ich schon so lange niemanden mehr behandelt habe, gibt es sicher viele Kranke im Dorf, die darauf warten, dass ich ihnen helfe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381117
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381117,
					"content": "*seufz* Aber ich scheine wieder nicht genügend Ingredienzen zu haben ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maruf"
				}
			]
		}
	]
